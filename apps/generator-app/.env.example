# Google Search Console setup: see docs/GSC_SETUP.md for step-by-step verification (meta tag + DNS TXT).

# Site URL (used for sitemap, canonical, OG — must match production domain)
NEXT_PUBLIC_SITE_URL=https://dailyclarity.org
NEXT_PUBLIC_PLATFORM_URL=https://dailyclarity.org
# Server-only environment identity. Use `production`, `staging`, or `development`.
DAILYCLARITY_ENVIRONMENT=development

# Optional generated-site form origin. Leave blank to use NEXT_PUBLIC_SITE_URL.
# Local development may set http://localhost:3000; production must use HTTPS.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_UPLOAD_MAX_SIZE=5242880

# Chatbot / OpenAI configuration
# Required for the generator app Chat API. Obtain an API key from https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna

# Supabase
# Create a project at https://supabase.com/dashboard and run the migrations in supabase/migrations/
# (includes public "customer-images" storage bucket for durable user uploads)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required safety pin: the dedicated DailyClarity project ref from <ref>.supabase.co.
# Checkout remains disabled if this does not match NEXT_PUBLIC_SUPABASE_URL.
DAILYCLARITY_SUPABASE_PROJECT_REF=

# Stripe
# Create products/prices in your Stripe Dashboard and paste the IDs below
# Webhook: add https://dailyclarity.org/api/stripe/webhook and subscribe to:
#   checkout.session.completed, checkout.session.expired,
#   checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#   customer.subscription.created, customer.subscription.updated,
#   customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Private webhook-to-background-worker bearer secret (minimum 32 random bytes).
# Generate independently with: openssl rand -hex 32
STRIPE_FULFILLMENT_WORKER_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_GROWTH=
# Required one-time $500 USD price. The server verifies its amount and type.
STRIPE_PRICE_CUSTOM_BUILD=
# Free trial length (days). Set to 0 to disable trial.
STRIPE_TRIAL_DAYS=7
# Optional: override the return URL after Stripe Customer Portal session (defaults to NEXT_PUBLIC_SITE_URL/dashboard)
STRIPE_CUSTOMER_PORTAL_RETURN_URL=
# Required for subscriptions: use a dedicated active Portal configuration with
# plan switching disabled until plan/service reconciliation is implemented.
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=

# Postmark (transactional email)
# Sign up at https://postmarkapp.com, create a server, and verify your sender domain
POSTMARK_SERVER_TOKEN=
EMAIL_FROM_ADDRESS=

# Netlify (site provisioning & hosting)
# Generate a personal access token at https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_ACCESS_TOKEN=
NETLIFY_TEAM_SLUG=
PLATFORM_DOMAIN=dailyclarity.org
NEXT_PUBLIC_PLATFORM_DOMAIN=dailyclarity.org
# Optional affiliate link shown in portal for BYO domain registration
NEXT_PUBLIC_DOMAIN_AFFILIATE_URL=

# Platform owner notifications (lead captures, alerts)
PLATFORM_OWNER_EMAIL=

# Portal HMAC token secret — used to sign and verify private portal access tokens
# Generate with: openssl rand -hex 32
PORTAL_TOKEN_SECRET=
# Optional dedicated HMAC secrets. When blank, PORTAL_TOKEN_SECRET is used.
UPLOAD_TOKEN_SECRET=
DRAFT_PROFILE_SECRET=

# Internal admin token (protects /api/portal/site, /api/sites/domain, /api/integrations/status, etc.)
# Generate with: openssl rand -hex 32
INTERNAL_ADMIN_TOKEN=

# Test purchase gate (never set to true in production)
ENABLE_TEST_PURCHASE=false
TEST_PURCHASE_ADMIN_SECRET=
# Required only when ENABLE_TEST_PURCHASE=true in isolated staging. The host is
# compared to the incoming request, and both project refs must match the URL.
STAGING_APP_HOST=
STAGING_SUPABASE_PROJECT_REF=

# Google Cloud demo video pipeline (qwen-training-project)
# Three keys — service-bound keys allow ONLY ONE of Gemini API or Agent Platform API per key:
#   GOOGLE_CLOUD_TTS_API_KEY     — standard AIza key, Cloud Text-to-Speech only (voiceover)
#   GOOGLE_GEMINI_API_KEY        — service-bound AQ key, Gemini API restriction (analyze:demos)
#   GOOGLE_VERTEX_API_KEY        — service-bound AQ key, Agent Platform restriction (Veo)
GOOGLE_CLOUD_TTS_API_KEY=
GOOGLE_GEMINI_API_KEY=
GOOGLE_VERTEX_API_KEY=
GOOGLE_CLOUD_PROJECT=qwen-training-project
VERTEX_LOCATION=us-central1
FFMPEG_PATH=

# Google Search Console — HTML meta tag verification token (content value only, not the full tag)
# From GSC → Add property → Domain → dailyclarity.org → HTML tag method → copy the content="..." value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics (all optional — app works without any)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_GA_ID=

# Netlify (used by upload-templates-to-blobs.mjs and server-side Blobs reads)
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
