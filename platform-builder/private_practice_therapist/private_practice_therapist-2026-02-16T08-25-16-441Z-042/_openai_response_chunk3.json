          "text": "BUNDLE_START\n{\"path\":\"fees.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investment — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f0f10;--panel:#fff;--muted:#8a8a8a;--accent:#b98cff;--glass:rgba(255,255,255,0.06);--max:1100px}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--panel);background:linear-gradient(180deg,#0b0b0c 0%,#0f0f10 60%);-webkit-font-smoothing:antialiased}\\n    .wrap{max-width:var(--max);margin:36px auto;padding:28px}\\n    nav{display:flex;gap:18px;align-items:center;margin-bottom:28px}\\n    nav a{color:rgba(255,255,255,0.85);text-decoration:none;padding:8px 12px;border-radius:8px}\\n    nav a.active{background:rgba(255,255,255,0.04)}\\n    header.hero{display:grid;grid-template-columns:1fr 420px;gap:36px;align-items:center;margin-bottom:36px}\\n    .hero-left h1{font-size:clamp(22px,3.6vw,36px);margin:0 0 8px}\\n    .hero-left p{margin:0;color:var(--muted)}\\n    .card{background:var(--glass);padding:20px;border-radius:14px;backdrop-filter:blur(6px);box-shadow:0 6px 30px rgba(0,0,0,0.45)}\\n    .pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:22px 0}\\n    .price{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:18px;border-radius:12px}\\n    .price h3{margin:0 0 8px;font-size:18px}\\n    .price p{margin:0 0 12px;color:var(--muted);font-size:13px}\\n    .price .rate{font-weight:700;font-size:20px}\\n    .muted{color:var(--muted);font-size:14px}\\n    .testimonial{display:flex;gap:12px;align-items:flex-start}\\n    .avatar{width:56px;height:56px;border-radius:12px;flex:0 0 56px;overflow:hidden;background:linear-gradient(135deg,#e8d6ff,#f7f0ff);display:flex;align-items:center;justify-content:center}\\n    .testimonial p{margin:0;color:var(--muted)}\\n    footer{margin-top:30px;color:var(--muted);font-size:13px}\\n    .cta{display:inline-block;margin-top:12px;background:var(--accent);color:#0b0b0c;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:600}\\n    form.inline{display:flex;gap:8px;margin-top:14px}\\n    input,select,textarea{padding:10px;border-radius:8px;border:none;font-size:14px}\\n    input[type=\\\"email\\\"]{flex:1}\\n    .note{font-size:12px;color:var(--muted);margin-top:8px}\\n    @media (max-width:880px){header.hero{grid-template-columns:1fr;}\\n      .pricing-grid{grid-template-columns:1fr}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"specialties.html\\\">Work With Me</a>\\n      <a href=\\\"fees.html\\\" class=\\\"active\\\">Investment</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n\\n    <header class=\\\"hero\\\">\\n      <div class=\\\"hero-left\\\">\\n        <h1>Care you can afford to begin — thoughtful pricing for private practice therapy</h1>\\n        <p>I’m {{THERAPIST_NAME}}, a licensed clinician ({{LICENSE}}) in {{STATE}}. I offer time-limited packages and open-ended therapy depending on your needs. Below are typical investments and options; if you need adjustments, I offer a limited sliding scale and brief consults to find the right fit.</p>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <div class=\\\"muted\\\">Typical modalities</div>\\n          <div style=\\\"font-weight:700;margin-top:6px\\\">{{MODALITIES}}</div>\\n          <a href=\\\"book.html\\\" class=\\\"cta\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <div class=\\\"note\\\">Not a substitute for crisis care. If you are in danger or need immediate help, call local emergency services or a crisis line.</div>\\n        </div>\\n      </div>\\n\\n      <div>\\n        <!-- Unique hero SVG for fees page: geometric gallery tile -->\\n        <svg width=\\\"420\\\" height=\\\"300\\\" viewBox=\\\"0 0 420 300\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-label=\\\"abstract tiles\\\">\\n          <rect width=\\\"420\\\" height=\\\"300\\\" rx=\\\"18\\\" fill=\\\"#0e0e10\\\" />\\n          <g fill-opacity=\\\"0.95\\\">\\n            <rect x=\\\"18\\\" y=\\\"18\\\" width=\\\"180\\\" height=\\\"120\\\" rx=\\\"12\\\" fill=\\\"#1a1a1b\\\" />\\n            <rect x=\\\"222\\\" y=\\\"18\\\" width=\\\"180\\\" height=\\\"120\\\" rx=\\\"12\\\" fill=\\\"#2a1b3a\\\" />\\n            <rect x=\\\"18\\\" y=\\\"162\\\" width=\\\"384\\\" height=\\\"120\\\" rx=\\\"12\\\" fill=\\\"#23192a\\\" />\\n            <circle cx=\\\"312\\\" cy=\\\"222\\\" r=\\\"28\\\" fill=\\\"#b98cff\\\" />\\n            <ellipse cx=\\\"86\\\" cy=\\\"96\\\" rx=\\\"28\\\" ry=\\\"20\\\" fill=\\\"#ffd8ff\\\" opacity=\\\"0.08\\\" />\\n          </g>\\n        </svg>\\n      </div>\\n    </header>\\n\\n    <section class=\\\"card\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Pricing options and what they include</h2>\\n      <p class=\\\"muted\\\" style=\\\"margin:0 0 16px\\\">Packages are designed to support short-term goals, transitions, or ongoing relief. Sessions are 50 minutes unless noted.</p>\\n\\n      <div class=\\\"pricing-grid\\\">\\n        <div class=\\\"price\\\">\\n          <h3>Starter Support Package — \\\"Begin\\\"</h3>\\n          <p class=\\\"muted\\\">4 sessions focused on immediate tools and stabilization.</p>\\n          <div class=\\\"rate\\\">$480 — $560 (package)</div>\\n          <p class=\\\"muted\\\">Includes an intake planning call and a short emailed summary of resources.</p>\\n        </div>\\n\\n        <div class=\\\"price\\\">\\n          <h3>Foundations Therapy Series — \\\"Grow\\\"</h3>\\n          <p class=\\\"muted\\\">8–12 sessions for deeper work on anxiety, life transitions, or relationship patterns.</p>\\n          <div class=\\\"rate\\\">$140 / session or $1,560 prepaid</div>\\n          <p class=\\\"muted\\\">Weekly cadence recommended for sustained progress.</p>\\n        </div>\\n\\n        <div class=\\\"price\\\">\\n          <h3>Deep Work Intensive — \\\"Reconnect\\\"</h3>\\n          <p class=\\\"muted\\\">3-hour focused day for concentrated therapeutic processing and planning.</p>\\n          <div class=\\\"rate\\\">$720 (single session)</div>\\n          <p class=\\\"muted\\\">Useful for focused milestones or when continuity is limited.</p>\\n        </div>\\n      </div>\\n\\n      <p class=\\\"muted\\\">I maintain a small number of reduced-fee slots. If cost is a barrier, please <a href=\\\"contact.html\\\" style=\\\"color:#fff;text-decoration:underline\\\">reach out</a> — we can often craft a short plan that fits your situation. Insurance processing may be possible with superbills; I can provide them but do not bill insurance directly from this practice.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 10px\\\">How sessions and payment work</h3>\\n      <ol class=\\\"muted\\\" style=\\\"margin:0 0 12px;padding-left:18px\\\">\\n        <li>Begin with a 20-minute brief consult to confirm fit (free or low-cost as available).</li>\\n        <li>Intake session to map goals and create a plan.</li>\\n        <li>Packages prepaid save a modest amount and encourage continuity; single sessions billed per appointment.</li>\\n      </ol>\\n      <a href=\\\"book.html\\\" class=\\\"cta\\\">Schedule a consult</a>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 10px\\\">What others have said</h3>\\n      <div class=\\\"testimonial\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"avatar\\\" aria-hidden>\\n          <!-- small avatar svg unique to this page -->\\n          <svg width=\\\"40\\\" height=\\\"40\\\" viewBox=\\\"0 0 40 40\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><rect width=\\\"40\\\" height=\\\"40\\\" rx=\\\"8\\\" fill=\\\"#f4ebff\\\"/><circle cx=\\\"20\\\" cy=\\\"14\\\" r=\\\"7\\\" fill=\\\"#e5c8ff\\\"/><rect x=\\\"8\\\" y=\\\"24\\\" width=\\\"24\\\" height=\\\"8\\\" rx=\\\"4\\\" fill=\\\"#e0bfff\\\"/></svg>\\n        </div>\\n        <div>\\n          <strong style=\\\"display:block\\\">Julia, client</strong>\\n          <p class=\\\"muted\\\">\\\"In three focused sessions I felt seen and left with tools that actually fit my life—gentle, practical, and steady.\\\"</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Quick questions</h3>\\n      <p class=\\\"muted\\\" style=\\\"margin:0\\\">Can I use insurance? I provide superbills on request; currently I do not bill insurance directly. For more, see <a href=\\\"faq.html\\\" style=\\\"color:#fff;text-decoration:underline\\\">full FAQs</a>.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Get the pricing guide</h3>\\n      <p class=\\\"muted\\\">Sign up for a short PDF that outlines what to expect in the first three sessions and how to prepare.</p>\\n      <form class=\\\"inline\\\" action=\\\"\\\" onsubmit=\\\"event.preventDefault();alert('Thanks — a guide will be sent to ' + (document.getElementById('email').value || 'your inbox'))\\\">\\n        <input id=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"your email\\\" required />\\n        <button class=\\\"cta\\\" type=\\\"submit\\\">Send the guide</button>\\n      </form>\\n      <div class=\\\"note\\\">By sharing your email you agree to occasional practice updates. Privacy and confidentiality are respected; see footer for details.</div>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">Confidentiality: Communications through this website are not secure therapy records. Once you become a client, I will review limits to confidentiality, record-keeping, and your rights. Scope: I provide psychotherapy and supportive counseling; I do not provide emergency services. If you are experiencing a crisis, call 911 or your local emergency number, or contact your nearest crisis center.</div>\\n      <div style=\\\"margin-top:8px\\\">Contact: {{EMAIL}} • {{PHONE}} • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Questions & Answers — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--ink:#0e0f11;--muted:#6b6b6b;--accent:#b98cff;--card:#fff;--max:1100px}\\n    body{margin:0;font-family:Georgia,serif;color:var(--ink);background:#fbf9fc}\\n    .wrap{max-width:var(--max);margin:36px auto;padding:28px}\\n    nav{display:flex;gap:14px;align-items:center;margin-bottom:20px}\\n    nav a{color:var(--ink);text-decoration:none;padding:6px 10px;border-radius:7px}\\n    nav a.active{background:rgba(185,140,255,0.06)}\\n    header{display:flex;gap:20px;align-items:center;}\\n    header h1{font-family:Georgia,serif;font-size:28px;margin:0}\\n    header p{margin:6px 0 0;color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:18px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(20,20,20,0.04)}\\n    .faq-item{margin-bottom:12px}\\n    .faq-item h4{margin:0;font-size:16px}\\n    .faq-item p{margin:6px 0 0;color:var(--muted)}\\n    .leadmag{display:flex;flex-direction:column;gap:10px}\\n    .leadmag input{padding:10px;border-radius:8px;border:1px solid #eee}\\n    .btn{background:var(--accent);color:white;padding:10px;border-radius:8px;border:none;font-weight:700}\\n    footer{margin-top:20px;color:var(--muted);font-size:13px}\\n    @media (max-width:900px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"specialties.html\\\">Specialties</a>\\n      <a href=\\\"approach.html\\\">Approach</a>\\n      <a href=\\\"faq.html\\\" class=\\\"active\\\">Questions</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n\\n    <header>\\n      <div>\\n        <h1>Common questions — practical answers</h1>\\n        <p>Clear, direct information to help you decide whether to reach out. If you don’t see your question, email {{EMAIL}} or book a short consult.</p>\\n      </div>\\n      <!-- unique svg for FAQ page: gentle layered waves -->\\n      <div aria-hidden>\\n        <svg width=\\\"120\\\" height=\\\"80\\\" viewBox=\\\"0 0 120 80\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n          <rect width=\\\"120\\\" height=\\\"80\\\" rx=\\\"10\\\" fill=\\\"#fff\\\" />\\n          <path d=\\\"M0 60 Q30 30 60 60 T120 60 L120 80 L0 80 Z\\\" fill=\\\"#f6ebff\\\" />\\n          <circle cx=\\\"30\\\" cy=\\\"20\\\" r=\\\"12\\\" fill=\\\"#b98cff\\\" opacity=\\\"0.14\\\" />\\n        </svg>\\n      </div>\\n    </header>\\n\\n    <div class=\\\"grid\\\">\\n      <main>\\n        <section class=\\\"card\\\">\\n          <div class=\\\"faq-item\\\">\\n            <h4>How do I start? What happens during the first visit?</h4>\\n            <p class=\\\"muted\\\">First we’ll have either a brief consult (10–20 minutes) or a standard intake. The intake focuses on history, immediate concerns, and collaborative goals. We’ll discuss confidentiality, timeframes, and what you can expect from sessions.</p>\\n          </div>\\n\\n          <div class=\\\"faq-item\\\">\\n            <h4>Do you offer remote or in-person sessions?</h4>\\n            <p class=\\\"muted\\\">I offer telehealth across {{STATE}} and limited in-person availability in {{CITY}}. Telehealth is convenient for many clients and remains private and secure. We’ll review technology needs in your intake.</p>\\n          </div>\\n\\n          <div class=\\\"faq-item\\\">\\n            <h4>Can I use insurance?</h4>\\n            <p class=\\\"muted\\\">I provide superbills that you can submit to your insurance for out-of-network reimbursement in many cases. I do not directly bill insurance from this practice. Insurance may require diagnosis and carries its own records; we can discuss what that means for your privacy.</p>\\n          </div>\\n\\n          <div class=\\\"faq-item\\\">\\n            <h4>What if I’m between sessions or need urgent support?</h4>\\n            <p class=\\\"muted\\\">I do not provide crisis services. If you are in immediate danger or feeling suicidal, call 911, your local emergency number, or a crisis hotline. For non-urgent concerns between sessions, message me and I’ll respond when possible; I may suggest resources or a timely check-in.</p>\\n          </div>\\n\\n          <div class=\\\"faq-item\\\">\\n            <h4>Do you accept minors or couples?</h4>\\n            <p class=\\\"muted\\\">My practice primarily serves adults. I sometimes work with couples and families depending on needs and licensing scope. If you’re looking for specialized family work, I’ll discuss appropriate referrals.</p>\\n          </div>\\n\\n          <div class=\\\"faq-item\\\">\\n            <h4>How long does therapy usually last?</h4>\\n            <p class=\\\"muted\\\">Every path is different. Some clients prefer short-term, goal-focused work (6–12 sessions); others benefit from longer-term relational therapy. We’ll review progress regularly and adapt the plan.</p>\\n          </div>\\n        </section>\\n\\n        <section style=\\\"margin-top:16px\\\" class=\\\"card\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Ethics & privacy</h4>\\n          <p class=\\\"muted\\\">Your privacy is central. I will describe limits of confidentiality, record-keeping, and mandatory reporting during intake. Communications outside of sessions (email/text) are not fully secure; I’ll review safer options for sensitive information.</p>\\n        </section>\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"card leadmag\\\">\\n          <h3 style=\\\"margin:0\\\">Free preparation sheet</h3>\\n          <p class=\\\"muted\\\" style=\\\"margin:0\\\">A short one-page checklist to get the most from your first three sessions.</p>\\n          <form onsubmit=\\\"event.preventDefault();alert('Preparation sheet will be emailed to ' + (document.getElementById('faq-email').value || 'your email'))\\\">\\n            <input id=\\\"faq-email\\\" type=\\\"email\\\" placeholder=\\\"your email\\\" required />\\n            <button class=\\\"btn\\\" type=\\\"submit\\\">Send me the sheet</button>\\n          </form>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Need help deciding?</h4>\\n          <p class=\\\"muted\\\" style=\\\"margin:0\\\">Book a 20-minute connection call to see if we’re a good fit: <a href=\\\"book.html\\\" style=\\\"color:var(--accent);text-decoration:underline\\\">Schedule now</a>.</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Quick contact</h4>\\n          <p class=\\\"muted\\\" style=\\\"margin:0\\\">Email: {{EMAIL}}<br/>Phone: {{PHONE}}</p>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">Practice scope: psychotherapy and supportive counseling. Confidentiality and limits will be discussed during intake. If you are in immediate danger, call 911 or go to the nearest emergency room.</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Begin — Book a Session with {{THERAPIST_NAME}}</title>\\n  <style>\\n    :root{--bg:#f8f6fb;--card:#ffffff;--text:#141414;--muted:#6f6f76;--accent:#b98cff;--max:980px}\\n    body{margin:0;font-family:Inter,system-ui,Arial,sans-serif;background:var(--bg);color:var(--text)}\\n    .wrap{max-width:var(--max);margin:36px auto;padding:28px}\\n    nav{display:flex;gap:12px;margin-bottom:20px}\\n    nav a{color:var(--text);text-decoration:none;padding:8px 10px;border-radius:8px}\\n    nav a.active{background:rgba(185,140,255,0.08)}\\n    .grid{display:grid;grid-template-columns:1fr 340px;gap:20px}\\n    .hero{background:linear-gradient(180deg,#fff,#fbf7ff);padding:18px;border-radius:12px;display:flex;gap:14px;align-items:center}\\n    .hero h1{margin:0;font-size:20px}\\n    .hero p{margin:6px 0 0;color:var(--muted)}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 8px 30px rgba(30,20,40,0.04)}\\n    form label{display:block;font-weight:600;margin-top:10px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #eae6f2;margin-top:6px}\\n    button{margin-top:12px;background:var(--accent);border:none;color:white;padding:12px 14px;border-radius:10px;font-weight:700}\\n    .muted{color:var(--muted);font-size:13px}\\n    footer{margin-top:20px;color:var(--muted);font-size:13px}\\n    @media (max-width:960px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"specialties.html\\\">Programs</a>\\n      <a href=\\\"book.html\\\" class=\\\"active\\\">Start</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n\\n    <div class=\\\"grid\\\">\\n      <main>\\n        <div class=\\\"hero\\\">\\n          <div>\\n            <h1>Start a conversation — book a consult or a therapy slot</h1>\\n            <p class=\\\"muted\\\">Choose a brief consult if you need to check fit, or book an intake to begin a plan. I’ll follow up with a short intake form after you book.</p>\\n          </div>\\n\\n          <!-- unique svg for booking page: entrance arch -->\\n          <div aria-hidden>\\n            <svg width=\\\"120\\\" height=\\\"80\\\" viewBox=\\\"0 0 120 80\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n              <rect width=\\\"120\\\" height=\\\"80\\\" rx=\\\"10\\\" fill=\\\"#fff\\\" />\\n              <path d=\\\"M20 70 V40 A30 30 0 0 1 100 40 V70 Z\\\" fill=\\\"#efe6ff\\\" />\\n              <circle cx=\\\"60\\\" cy=\\\"34\\\" r=\\\"6\\\" fill=\\\"#b98cff\\\" opacity=\\\"0.9\\\" />\\n            </svg>\\n          </div>\\n        </div>\\n\\n        <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h2 style=\\\"margin:0 0 8px\\\">How to prepare</h2>\\n          <p class=\\\"muted\\\">Think about what brings you now and one or two goals you’d like to address. If you prefer, jot three things you want help with — we’ll prioritize them together.</p>\\n          <ul class=\\\"muted\\\" style=\\\"margin-top:10px\\\">\\n            <li>Sessions are 50 minutes.</li>\\n            <li>If using out-of-network reimbursement, request a superbill after payment.</li>\\n            <li>Cancellation policy: please give 48 hours notice to avoid full-session fees.</li>\\n          </ul>\\n        </section>\\n\\n        <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h2 style=\\\"margin:0 0 8px\\\">Intake & consent</h2>\\n          <p class=\\\"muted\\\">After booking you will receive a secure intake questionnaire and consent form to review. We will discuss limits of confidentiality and what to expect from services. If you need help with paperwork, we can schedule extra time.</p>\\n        </section>\\n\\n        <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n          <h2 style=\\\"margin:0 0 8px\\\">Small group of typical steps</h2>\\n          <ol class=\\\"muted\\\" style=\\\"margin:0;padding-left:18px\\\">\\n            <li>Quick consult (optional) — determine fit.</li>\\n            <li>Intake session — gather history, set goals.</li>\\n            <li>Regular sessions or a short package — we review progress often.</li>\\n          </ol>\\n        </section>\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">Schedule</h3>\\n          <p class=\\\"muted\\\" style=\\\"margin:0 0 12px\\\">Select a session type and preferred times. You will be contacted with available slots; booking is confirmed after we agree on a time.</p>\\n\\n          <form onsubmit=\\\"event.preventDefault();alert('Booking request received. We will contact ' + (document.getElementById('name').value || 'you') + ' at ' + (document.getElementById('email-book').value || 'your email'))\\\">\\n            <label for=\\\"type\\\">Session type</label>\\n            <select id=\\\"type\\\" required>\\n              <option>20-minute connection call (brief consult)</option>\\n              <option>Intake session (50 min)</option>\\n              <option>Regular therapy session (50 min)</option>\\n              <option>Deep Work Intensive (3 hrs)</option>\\n            </select>\\n\\n            <label for=\\\"name\\\">Full name</label>\\n            <input id=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"Your name\\\" required />\\n\\n            <label for=\\\"email-book\\\">Email</label>\\n            <input id=\\\"email-book\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required />\\n\\n            <label for=\\\"phone\\\">Phone (optional)</label>\\n            <input id=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"(555) 555-5555\\\" />\\n\\n            <label for=\\\"note\\\">Short note — what brings you?</label>\\n            <textarea id=\\\"note\\\" rows=\\\"4\\\" placeholder=\\\"A few words about your reason for booking\\\"></textarea>\\n\\n            <button type=\\\"submit\\\">Request this time</button>\\n          </form>\\n\\n          <p class=\\\"muted\\\" style=\\\"margin-top:12px\\\">If you need to reschedule or have questions before booking, email {{EMAIL}} or call {{PHONE}}.</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Policies & disclaimers</h4>\\n          <p class=\\\"muted\\\" style=\\\"margin:0\\\">I respect your privacy. Communications through this form are not therapy. Confidentiality specifics and mandated reporting will be discussed during intake. If you are in crisis, call 911 or your local emergency number immediately.</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Quick links</h4>\\n          <p class=\\\"muted\\\" style=\\\"margin:0\\\"><a href=\\\"fees.html\\\" style=\\\"color:var(--accent);text-decoration:underline\\\">Fees</a> • <a href=\\\"faq.html\\\" style=\\\"color:var(--accent);text-decoration:underline\\\">FAQs</a></p>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">{{THERAPIST_NAME}}, {{LICENSE}} • {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}<br/>Scope: psychotherapy and counseling for anxiety, trauma, relationships, life transitions, and burnout. If you are in immediate danger, call 911 or your local emergency services.</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
