          "text": "BUNDLE_START\n{\"path\":\"fees.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Fees & Offerings</title>\\n  <style>\\n    :root{--bg:#fff7fb;--card:#ffffff;--accent:#ff6fa3;--muted:#6b6b6b;--ink:#0f1724;--glass:rgba(255,255,255,0.6);--radius:14px}\\n    *{box-sizing:border-box}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:var(--ink);margin:0;background:linear-gradient(180deg,var(--bg),#fff);}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 36px}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:conic-gradient(from 210deg at 50% 50%,#ffd6e8,var(--accent) 60%,#ffecf5);display:flex;align-items:center;justify-content:center;font-weight:700;color:#4b1032}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;padding:48px 36px;align-items:center}\\n    .hero-left{padding:28px;background:var(--card);border-radius:18px;box-shadow:0 10px 30px rgba(15,23,36,0.06)}\\n    h1{margin:0 0 8px;font-size:32px;letter-spacing:-0.02em}\\n    p.lead{margin:0;color:var(--muted)}\\n    .hero-right{display:flex;align-items:center;justify-content:center}\\n    .svg-hero{width:300px;height:220px}\\n\\n    .section{padding:36px;border-radius:12px;margin:18px 36px;background:linear-gradient(180deg,rgba(255,255,255,0.6),#fff);box-shadow:0 8px 20px rgba(15,23,36,0.04)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\\n    .card{background:var(--card);padding:20px;border-radius:12px;border:1px solid rgba(15,23,36,0.03)}\\n    .price{font-size:20px;font-weight:800;color:var(--accent)}\\n    .muted{color:var(--muted)}\\n    .cta{display:inline-block;padding:12px 18px;background:var(--accent);color:white;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    footer{padding:28px 36px;color:var(--muted);font-size:13px}\\n    .notes{margin-top:10px;color:var(--muted);font-size:13px}\\n\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">{{THERAPIST_NAME}}</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Work With Me</a>\\n      <a href=\\\"specialties.html\\\">Specialties</a>\\n      <a href=\\\"approach.html\\\">Approach</a>\\n      <a href=\\\"fees.html\\\" style=\\\"color:var(--ink)\\\">Fees</a>\\n      <a href=\\\"faq.html\\\">FAQ</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <!-- Hero: Pricing frame (different heading than other pages) -->\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-left\\\">\\n        <h1>Investment & Pathways — choose what meets you</h1>\\n        <p class=\\\"lead\\\">I offer cohort-based containers and limited private slots, each designed for sustained growth, not quick fixes. Below are transparent guides to what each pathway includes.</p>\\n        <div style=\\\"margin-top:18px\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n      <div class=\\\"hero-right\\\">\\n        <img class=\\\"svg-hero\\\" src=\\\"assets/img/hero.svg\\\" alt=\\\"Decorative pattern\\\" />\\n      </div>\\n    </section>\\n\\n    <!-- Diagnostic: Intake snapshot -->\\n    <section class=\\\"section\\\">\\n      <h2 style=\\\"margin-top:0\\\">Intake Snapshot</h2>\\n      <p class=\\\"muted\\\">Before placement, every participant completes a brief diagnostic intake — a thoughtful snapshot of your current concerns, strengths, and goals. This helps me align you with the right cohort or private rhythm.</p>\\n      <ul style=\\\"margin-top:12px;color:var(--muted)\\\">\\n        <li>30–45 minute intake questionnaire + optional 20-minute consult</li>\\n        <li>Core focus selection (anxiety, trauma, relationships, transitions, burnout)</li>\\n        <li>Clarifying goals and boundaries, accessibility needs</li>\\n      </ul>\\n    </section>\\n\\n    <!-- Plan: Roadmaps for each offering (different metaphor) -->\\n    <section class=\\\"section\\\">\\n      <h2 style=\\\"margin-top:0\\\">Path Roadmaps</h2>\\n      <p class=\\\"muted\\\">Each offering follows an intentional syllabus: grounding practices, relational experiments, and integration weeks to translate insight into daily life.</p>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:16px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Ember Cohort (8 weeks)</strong>\\n          <p class=\\\"muted\\\">A starter cohort for emotional regulation and clarity.</p>\\n          <div style=\\\"margin-top:8px\\\"><span class=\\\"price\\\">$450 per person</span> — one-time cohort fee</div>\\n          <div style=\\\"margin-top:10px;color:var(--muted)\\\">Includes weekly 90-min group sessions, toolkit emails, two guided micro-practices per week.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Lighthouse Cohort (12 weeks)</strong>\\n          <p class=\\\"muted\\\">Deeper narrative work and relational labs for lasting shifts.</p>\\n          <div style=\\\"margin-top:8px\\\"><span class=\\\"price\\\">$950 per person</span> — cohort tuition</div>\\n          <div style=\\\"margin-top:10px;color:var(--muted)\\\">Includes weekly 2-hr group sessions, small breakout mentorship, recorded materials, and a closing integration session.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Private Continuity</strong>\\n          <p class=\\\"muted\\\">Limited private spaces for focused, ongoing therapy.</p>\\n          <div style=\\\"margin-top:8px\\\"><span class=\\\"price\\\">$160 / 50-min session</span></div>\\n          <div style=\\\"margin-top:10px;color:var(--muted)\\\">Available by application; sliding scale considered; monthly retainer options on request.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Micro Habits: small daily practices included. Different naming. -->\\n    <section class=\\\"section\\\">\\n      <h2 style=\\\"margin-top:0\\\">Daily Rituals Included</h2>\\n      <p class=\\\"muted\\\">Each pathway comes with micro-habits — short, tangible practices you can weave into your day to anchor learning.</p>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-wrap:wrap\\\">\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:180px\\\">Breath & Pause — 3-min grounding led audio</div>\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:180px\\\">Boundary Check — simple journaling prompt</div>\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:180px\\\">Relational Experiment — a weekly practice to try with someone you trust</div>\\n      </div>\\n    </section>\\n\\n    <!-- Pricing details: framing as 'investment' with options and payment policy -->\\n    <section class=\\\"section\\\">\\n      <h2 style=\\\"margin-top:0\\\">Investment Details & Policies</h2>\\n      <p class=\\\"muted\\\">I strive for clarity: fees are listed per person/session. A non-refundable deposit secures cohort placement. Sliding scale limited and considered with documentation.</p>\\n      <ul style=\\\"margin-top:12px;color:var(--muted)\\\">\\n        <li>Deposits: 25% of cohort tuition at time of registration</li>\\n        <li>Cancellations: refunds handled case-by-case; see booking page for policies</li>\\n        <li>Insurance: I provide superbills; I am not an in-network provider for most plans</li>\\n      </ul>\\n      <div style=\\\"margin-top:14px\\\">\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Begin Application</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:flex-start;gap:20px;flex-wrap:wrap\\\">\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"muted\\\">{{THERAPIST_NAME}} • {{LICENSE}} • {{CITY}}, {{STATE}}</div>\\n      </div>\\n      <div style=\\\"text-align:right\\\">\\n        <div><strong>{{PHONE}}</strong> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        <div class=\\\"muted\\\">Sessions are confidential and held within professional ethical boundaries. Records are stored securely.</div>\\n      </div>\\n    </div>\\n    <div class=\\\"notes\\\">\\n      Crisis disclaimer: I am not able to provide crisis services. If you are in immediate danger or experiencing a psychiatric emergency, contact local emergency services or a crisis line right away.\\n      Scope & boundaries: My work is supportive and psychotherapeutic; it is not a substitute for medical or emergency care.\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Frequently Asked</title>\\n  <style>\\n    :root{--bg:#fff;--accent:#7ad8ff;--ink:#07212a;--muted:#536b6f;--card:#fbfeff}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;margin:0;color:var(--ink);background:linear-gradient(180deg,#f9ffff,#ffffff)}\\n    header{display:flex;justify-content:space-between;padding:22px 28px;align-items:center}\\n    header .nav a{margin-left:14px;text-decoration:none;color:var(--muted);font-weight:600}\\n    .hero{padding:40px 28px;background:linear-gradient(90deg,rgba(122,216,255,0.12),#ffffff);border-bottom:1px solid rgba(7,33,42,0.04)}\\n    h1{margin:0;font-size:28px}\\n    .subtitle{color:var(--muted);margin-top:6px}\\n    .container{max-width:1000px;margin:22px auto;padding:0 18px}\\n    .faq-item{background:var(--card);padding:18px;border-radius:12px;margin-bottom:12px;border-left:6px solid var(--accent)}\\n    .muted{color:var(--muted)}\\n    .small{font-size:13px;color:var(--muted)}\\n    .cta{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{padding:20px 28px;color:var(--muted);font-size:13px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"specialties.html\\\">Programs</a>\\n      <a href=\\\"approach.html\\\">How I Work</a>\\n      <a href=\\\"fees.html\\\">Investment</a>\\n      <a href=\\\"faq.html\\\" style=\\\"color:var(--ink)\\\">FAQ</a>\\n      <a href=\\\"book.html\\\">Schedule</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <section class=\\\"hero\\\">\\n    <div class=\\\"container\\\">\\n      <h1>Curiosities & Clarifications</h1>\\n      <p class=\\\"subtitle\\\">A gentle guide to common practical questions — honest answers about process, privacy, and what to expect.</p>\\n    </div>\\n  </section>\\n\\n  <main class=\\\"container\\\">\\n    <!-- Micro habits mention earlier to ripple required pack -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin-bottom:6px\\\">What happens between sessions?</h2>\\n      <div class=\\\"faq-item\\\">\\n        <p class=\\\"small\\\">I offer short, practical micro-habits after each session — brief practices you can do daily. These are optional and meant to support integration rather than create extra pressure.</p>\\n      </div>\\n    </section>\\n\\n    <!-- Diagnostic: how intake works -->\\n    <section style=\\\"margin-top:6px\\\">\\n      <h2 style=\\\"margin-bottom:6px\\\">How do I know which path fits me?</h2>\\n      <div class=\\\"faq-item\\\">\\n        <p class=\\\"small\\\">We begin with a diagnostic intake (questionnaire + brief consult). This helps me recommend the right cohort or a private continuity. If you’re unsure, book the 20-minute consult and we’ll orient together.</p>\\n      </div>\\n    </section>\\n\\n    <!-- Plan: commitment & structure questions, different heading -->\\n    <section style=\\\"margin-top:6px\\\">\\n      <h2 style=\\\"margin-bottom:6px\\\">How long will the work take?</h2>\\n      <div class=\\\"faq-item\\\">\\n        <p class=\\\"small\\\">Cohorts are designed for 8–12 weeks to allow for practice and integration. Private work varies; many clients start with weekly sessions and reassess at three months. Therapy is not time-limited; duration depends on your goals.</p>\\n      </div>\\n    </section>\\n\\n    <!-- Pricing Qs: different from fees page -->\\n    <section style=\\\"margin-top:6px\\\">\\n      <h2 style=\\\"margin-bottom:6px\\\">Do you accept insurance?</h2>\\n      <div class=\\\"faq-item\\\">\\n        <p class=\\\"small\\\">I am typically out-of-network. I provide a superbill you can submit to many insurers for possible reimbursement. I can support clients in exploring options during intake.</p>\\n      </div>\\n    </section>\\n\\n    <!-- Booking logistics Qs -->\\n    <section style=\\\"margin-top:6px\\\">\\n      <h2 style=\\\"margin-bottom:6px\\\">What if I need to cancel or reschedule?</h2>\\n      <div class=\\\"faq-item\\\">\\n        <p class=\\\"small\\\">Please provide 48 hours notice when possible. Late cancellations or no-shows may be charged a fee, except in documented emergencies. Cohort refunds handled per cohort policy; deposits are non-refundable but sometimes transferable with notice.</p>\\n      </div>\\n    </section>\\n\\n    <!-- Ethical boundaries & crisis Qs (therapist realism) -->\\n    <section style=\\\"margin-top:6px\\\">\\n      <h2 style=\\\"margin-bottom:6px\\\">What about confidentiality and emergencies?</h2>\\n      <div class=\\\"faq-item\\\">\\n        <p class=\\\"small\\\">Sessions are confidential and notes are stored securely. Limits to confidentiality include imminent risk of harm to self or others, or situations required by law. I do not provide crisis services; if you are in immediate danger, call emergency services or a crisis line in {{CITY}}, {{STATE}}.</p>\\n      </div>\\n    </section>\\n\\n    <!-- Scope & modalities question -->\\n    <section style=\\\"margin-top:6px\\\">\\n      <h2 style=\\\"margin-bottom:6px\\\">What approaches do you use?</h2>\\n      <div class=\\\"faq-item\\\">\\n        <p class=\\\"small\\\">My work blends several modalities: {{MODALITIES}}. I orient towards relational, somatic, and narrative techniques depending on your needs. This is collaborative and tailored, not prescriptive.</p>\\n      </div>\\n    </section>\\n\\n    <!-- Different FAQ questions unique to this page -->\\n    <section style=\\\"margin-top:6px\\\">\\n      <h2 style=\\\"margin-bottom:6px\\\">Can I join mid-cohort?</h2>\\n      <div class=\\\"faq-item\\\">\\n        <p class=\\\"small\\\">Occasionally I accept mid-cohort placements depending on group dynamics. Please inquire early; some cohorts are intentionally closed after week two to preserve trust and continuity.</p>\\n      </div>\\n    </section>\\n\\n    <div style=\\\"margin-top:18px;display:flex;gap:12px;align-items:center\\\">\\n      <a class=\\\"cta\\\" href=\\\"book.html\\\">Schedule a Consult</a>\\n      <div class=\\\"small muted\\\">Prefer email? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </div>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:1000px;margin:12px auto;padding:0 18px;color:var(--muted)\\\">\\n      <div style=\\\"font-weight:700\\\">{{THERAPIST_NAME}} • {{LICENSE}}</div>\\n      <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Confidentiality: I adhere to professional ethical standards. Privacy practices are discussed at intake. Crisis disclaimer: Not a crisis service — call local emergency resources if in immediate danger.</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff8f1;--accent:#ffb36b;--ink:#2b1f1a;--muted:#75584d}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;margin:0;background:var(--bg);color:var(--ink)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 26px}\\n    nav a{margin-left:12px;text-decoration:none;color:var(--muted)}\\n    .hero{padding:28px 26px;display:flex;gap:20px;align-items:center}\\n    .hero-left{flex:1}\\n    h1{margin:0;font-size:30px}\\n    .note{color:var(--muted);margin-top:6px}\\n    .card{background:white;padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(43,31,26,0.06)}\\n    .columns{display:grid;grid-template-columns:1fr 360px;gap:18px;padding:0 26px;margin-top:18px}\\n    .form-row{display:flex;gap:8px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(0,0,0,0.08)}\\n    button{background:var(--accent);color:white;padding:12px 14px;border-radius:10px;border:none;font-weight:700}\\n    .small{font-size:13px;color:var(--muted)}\\n    footer{padding:22px 26px;color:var(--muted);font-size:13px}\\n    @media (max-width:900px){.columns{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Paths</a>\\n      <a href=\\\"specialties.html\\\">Expertise</a>\\n      <a href=\\\"approach.html\\\">Method</a>\\n      <a href=\\\"fees.html\\\">Fees</a>\\n      <a href=\\\"faq.html\\\">Help</a>\\n      <a href=\\\"book.html\\\" style=\\\"color:var(--ink)\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-left\\\">\\n        <h1>Begin — a kind, practical booking flow</h1>\\n        <p class=\\\"note\\\">Choose a cohort or request a private slot. Please read the scope & policies below before booking. If you need an accessibility accommodation, let me know when you book.</p>\\n      </div>\\n      <div class=\\\"card\\\" style=\\\"width:340px\\\">\\n        <div style=\\\"font-weight:700\\\">Quick options</div>\\n        <div style=\\\"margin-top:8px\\\" class=\\\"small\\\">Cohort seats are reserved with a deposit. Private continuity begins after intake and application review.</div>\\n        <div style=\\\"margin-top:12px;display:flex;gap:8px\\\">\\n          <a href=\\\"#apply\\\" style=\\\"flex:1;text-align:center;padding:10px;background:var(--accent);color:white;border-radius:9px;text-decoration:none;font-weight:700\\\">Apply Now</a>\\n          <a href=\\\"#consult\\\" style=\\\"flex:1;text-align:center;padding:10px;background:white;border-radius:9px;border:1px solid rgba(0,0,0,0.06);text-decoration:none;color:var(--muted);font-weight:700\\\">20-min consult</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"columns\\\">\\n      <div>\\n        <!-- Booking form / application -->\\n        <section class=\\\"card\\\" id=\\\"apply\\\">\\n          <h2 style=\\\"margin-top:0\\\">Application: Cohort or Private</h2>\\n          <p class=\\\"small\\\">This form starts the application process. After review, I’ll email next steps and intake links.</p>\\n          <form style=\\\"margin-top:12px\\\">\\n            <div class=\\\"form-row\\\">\\n              <input type=\\\"text\\\" name=\\\"fullName\\\" placeholder=\\\"Your full name\\\" required />\\n            </div>\\n            <div class=\\\"form-row\\\" style=\\\"margin-top:8px\\\">\\n              <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Email\\\" required />\\n              <input type=\\\"tel\\\" name=\\\"phone\\\" placeholder=\\\"Phone\\\" />\\n            </div>\\n            <div style=\\\"margin-top:8px\\\">\\n              <select name=\\\"path\\\">\\n                <option>I'm interested in: Ember Cohort (8w)</option>\\n                <option>Lighthouse Cohort (12w)</option>\\n                <option>Private continuity / weekly sessions</option>\\n              </select>\\n            </div>\\n            <div style=\\\"margin-top:8px\\\">\\n              <textarea name=\\\"brief\\\" placeholder=\\\"Briefly, what brings you here? (goals / concerns)\\\" rows=\\\"5\\\"></textarea>\\n            </div>\\n            <div style=\\\"margin-top:10px;display:flex;gap:10px;align-items:center\\\">\\n              <button type=\\\"submit\\\">Send Application</button>\\n              <div class=\\\"small muted\\\">We respond within 5–7 business days.</div>\\n            </div>\\n          </form>\\n        </section>\\n\\n        <!-- Diagnostic snapshot + scheduling steps -->\\n        <section class=\\\"card\\\" style=\\\"margin-top:14px\\\" id=\\\"consult\\\">\\n          <h3 style=\\\"margin-top:0\\\">20-minute Orientation</h3>\\n          <p class=\\\"small\\\">A brief conversation to clarify fit. This is recommended if you’re unsure which pathway is right for you.</p>\\n          <div style=\\\"margin-top:10px;display:flex;gap:8px\\\">\\n            <a href=\\\"#\\\" class=\\\"small\\\" style=\\\"background:var(--accent);color:white;padding:10px;border-radius:8px;text-decoration:none\\\">Book 20-min</a>\\n            <a href=\\\"mailto:{{EMAIL}}\\\" class=\\\"small\\\" style=\\\"padding:10px;border-radius:8px;border:1px solid rgba(0,0,0,0.06);text-decoration:none;color:var(--muted)\\\">Email to request</a>\\n          </div>\\n        </section>\\n\\n        <!-- Micro-habits and early plan preview -->\\n        <section class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h3 style=\\\"margin-top:0\\\">What you receive</h3>\\n          <p class=\\\"small\\\">Depending on your path: weekly sessions, recorded practices, micro-habits, and integration prompts. These are designed to be accessible and brief.</p>\\n        </section>\\n      </div>\\n\\n      <aside>\\n        <!-- Pricing snapshot and policies -->\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Pricing Snapshot</h3>\\n          <div class=\\\"small muted\\\">Representative rates — see full fees on the Fees page.</div>\\n          <ul style=\\\"margin-top:10px;line-height:1.6\\\">\\n            <li><strong>Ember Cohort</strong> — $450 per person (8w)</li>\\n            <li><strong>Lighthouse Cohort</strong> — $950 per person (12w)</li>\\n            <li><strong>Private</strong> — $160 / 50-min session (by application)</li>\\n          </ul>\\n          <div style=\\\"margin-top:10px\\\" class=\\\"small\\\">Deposit: 25% to reserve a cohort seat. Sliding scale limited — inquire. I provide superbills; I am not typically an in-network provider.</div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin-top:0\\\">Cancellation & Access</h3>\\n          <div class=\\\"small\\\">Please provide 48 hours notice when possible. If you need accommodations for scheduling or financial access, mention this in your application and we'll explore options.</div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin-top:0\\\">Privacy & Ethics</h3>\\n          <div class=\\\"small\\\">Sessions are confidential. Notes are kept securely. Limits to confidentiality include imminent risk of harm or legal requirements. By booking you agree to respectful participation in group containers.</div>\\n        </div>\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:980px;margin:0 auto;padding:12px 26px;color:var(--muted)\\\">\\n      <div style=\\\"font-weight:700\\\">Contact</div>\\n      <div class=\\\"small\\\">Phone: {{PHONE}} • Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Crisis disclaimer: I do not provide emergency services. If you are in immediate danger, call emergency services in {{CITY}}, {{STATE}}.</div>\\n      <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">{{THERAPIST_NAME}}, {{LICENSE}} — Modalities: {{MODALITIES}}</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
