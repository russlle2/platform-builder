          "text": "BUNDLE_START\n{\"path\":\"fees.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investment — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfaf8;--card:#fff;--ink:#14202b;--muted:#5d6b72;--accent:#7b5cff;--glass:rgba(255,255,255,0.7)}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; background:var(--bg); color:var(--ink); -webkit-font-smoothing:antialiased}\\n    header{position:sticky;top:0;background:linear-gradient(180deg,rgba(255,255,255,0.9),rgba(255,255,255,0.7));backdrop-filter:blur(6px);border-bottom:1px solid rgba(20,32,43,0.06)}\\n    .nav{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:14px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:42px;height:42px;display:flex;align-items:center;justify-content:center;border-radius:8px;background:linear-gradient(135deg,var(--accent),#5cd6ff);color:white;font-weight:700}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-size:15px}\\n    .cta{background:var(--accent);color:white;padding:10px 14px;border-radius:8px;text-decoration:none;font-weight:600}\\n    main{max-width:1100px;margin:28px auto;padding:0 20px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:24px;align-items:start}\\n    .hero .lead{background:linear-gradient(180deg,var(--card),var(--glass));padding:28px;border-radius:12px;box-shadow:0 6px 18px rgba(17,24,32,0.06)}\\n    h1{margin:0 0 8px;font-size:28px}\\n    p.lead-sub{margin:0;color:var(--muted)}\\n    .aside{padding:18px;border-radius:12px;background-image:url('data:image/svg+xml;utf8,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"360\\\" height=\\\"360\\\"><defs><pattern id=\\\"p\\\" width=\\\"20\\\" height=\\\"20\\\" patternUnits=\\\"userSpaceOnUse\\\"><rect width=\\\"20\\\" height=\\\"20\\\" fill=\\\"%23f7f5ff\\\"/><circle cx=\\\"4\\\" cy=\\\"4\\\" r=\\\"1.6\\\" fill=\\\"%23e6dfff\\\"/></pattern></defs><rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(%23p)\\\"/></svg>');}\\n    .packages{display:flex;flex-direction:column;gap:14px;margin-top:18px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;border:1px solid rgba(17,24,32,0.04)}\\n    .pkg-title{display:flex;justify-content:space-between;align-items:center;font-weight:700}\\n    .price{color:var(--accent);font-weight:700}\\n    .notes{color:var(--muted);font-size:14px;margin-top:8px}\\n    .foot{margin-top:18px;color:var(--muted);font-size:13px}\\n    .book-row{display:flex;gap:10px;margin-top:18px}\\n    a.secondary{padding:10px 12px;border-radius:8px;border:1px solid rgba(20,32,43,0.06);text-decoration:none;color:var(--ink)}\\n    footer{max-width:1100px;margin:40px auto;padding:18px 20px;color:var(--muted);font-size:13px}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.aside{order:-1}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">TP</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{CITY}}, {{STATE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">Meet</a>\\n        <a href=\\\"specialties.html\\\">Expertise</a>\\n        <a href=\\\"approach.html\\\">Way I Work</a>\\n        <a href=\\\"fees.html\\\" style=\\\"color:var(--ink);font-weight:600\\\">Investment</a>\\n        <a href=\\\"faq.html\\\">Practicalities</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"lead card\\\">\\n        <h1>How I price meaningful work</h1>\\n        <p class=\\\"lead-sub\\\">Transparent options shaped around typical rhythms: single focus sessions, short guided blocks, and lighter check-ins. Pick what fits your time and attention right now.</p>\\n\\n        <div class=\\\"packages\\\">\\n          <div class=\\\"card\\\">\\n            <div class=\\\"pkg-title\\\"><span>Focus Session</span><span class=\\\"price\\\">$170 — single</span></div>\\n            <div class=\\\"notes\\\">A one-off 50–55 minute appointment to address a specific concern, plan next steps, or reset when things feel stuck.</div>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <div class=\\\"pkg-title\\\"><span>Guided Block (4 sessions)</span><span class=\\\"price\\\">$640 — block</span></div>\\n            <div class=\\\"notes\\\">Four sessions paced over 6–8 weeks. Useful for focused skill practice, short-term transitions, or starting a new habit with steady support.</div>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <div class=\\\"pkg-title\\\"><span>Bridge Package (8 sessions)</span><span class=\\\"price\\\">$1,220 — block</span></div>\\n            <div class=\\\"notes\\\">Longer blocks for deeper pattern work or for people who know they want regular meetings for a season of life.</div>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <div class=\\\"pkg-title\\\"><span>Light Check-ins (flex monthly)</span><span class=\\\"price\\\">starting $90</span></div>\\n            <div class=\\\"notes\\\">Short appointments for maintenance, questions between blocks, or periodic check-ins. Flexible timing and availability vary.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"foot\\\">Insurance: I do not bill insurance directly. I provide superbills you may submit to your carrier. Payment is expected at the time of session unless other arrangements are made in advance.</div>\\n      </div>\\n\\n      <aside class=\\\"aside card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Quick logistics</h3>\\n        <div class=\\\"notes\\\">Session length is typically 50–55 minutes. I offer telehealth and limited in-person appointments. If you have questions about accessibility, sliding scale availability, or workplace-related matters, email me at <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</div>\\n\\n        <div style=\\\"margin-top:14px\\\">\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Find a time that works</a>\\n          <a class=\\\"secondary\\\" href=\\\"contact.html\\\">Ask about sliding scale</a>\\n        </div>\\n\\n        <div style=\\\"margin-top:16px;color:var(--muted);font-size:13px\\\">Cancellation: Please give 48 hours when possible. Late cancellations or missed appointments may be charged the session fee.</div>\\n      </aside>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;padding:0 20px;\\\">\\n      <div>&copy; <span id=\\\"yr\\\"></span> {{BUSINESS_NAME}} — Confidential clinical care in {{CITY}}, {{STATE}}</div>\\n      <div style=\\\"text-align:right\\\">Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> · Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </div>\\n  </footer>\\n  <script>\\n    document.getElementById('yr').textContent = new Date().getFullYear();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Practicalities — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--ink:#0f1720;--muted:#586a73;--accent:#5a9cff}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial;background:linear-gradient(180deg,#fbfdff,#ffffff);color:var(--ink)}\\n    header{padding:14px 20px;border-bottom:1px solid rgba(15,23,32,0.06);position:sticky;top:0;background:#fff}\\n    .nav{max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin:0 8px;color:var(--muted);text-decoration:none}\\n    .nav .cta{background:var(--accent);color:white;padding:8px 12px;border-radius:8px;text-decoration:none}\\n    main{max-width:900px;margin:28px auto;padding:0 20px}\\n    h1{font-size:26px;margin-bottom:6px}\\n    p.lead{color:var(--muted);margin-top:0}\\n    .accordion{margin-top:18px;border-radius:12px;overflow:hidden}\\n    .item{border-top:1px solid rgba(15,23,32,0.06);background:white}\\n    .q{display:flex;justify-content:space-between;align-items:center;padding:16px;cursor:pointer}\\n    .a{padding:0 16px 16px 16px;color:var(--muted);line-height:1.5;display:none}\\n    .open .a{display:block}\\n    .meta{font-size:13px;color:var(--muted);margin-top:12px}\\n    .crisis{margin-top:22px;padding:14px;border-radius:10px;background:linear-gradient(90deg,#fff6f6,#fff);border:1px solid rgba(230,80,80,0.08);color:#6a2525}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <div>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">Meet</a>\\n        <a href=\\\"specialties.html\\\">Expertise</a>\\n        <a href=\\\"approach.html\\\">Way I Work</a>\\n        <a href=\\\"fees.html\\\">Investment</a>\\n        <a href=\\\"faq.html\\\" style=\\\"color:var(--ink)\\\">Practicalities</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n        <a class=\\\"cta\\\" href=\\\"contact.html\\\">Reach Out</a>\\n      </div>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <h1>Practical questions answered</h1>\\n    <p class=\\\"lead\\\">Short, clinician-forward answers about what to expect, confidentiality, and how appointments are handled. If something here doesn’t fit your situation, email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</p>\\n\\n    <section class=\\\"accordion\\\" id=\\\"acc\\\">\\n      <div class=\\\"item\\\" data-key=\\\"1\\\">\\n        <div class=\\\"q\\\">How do I book and pay?<span>+</span></div>\\n        <div class=\\\"a\\\">You can book online at the scheduling link or email to request a time. Payment is taken at the time of service via card. For packages, payment is collected up front for the block so we can hold regular sessions without interruption.</div>\\n      </div>\\n\\n      <div class=\\\"item\\\" data-key=\\\"2\\\">\\n        <div class=\\\"q\\\">What is your cancellation policy?<span>+</span></div>\\n        <div class=\\\"a\\\">Please provide at least 48 hours notice when possible. Late cancellations or missed appointments may be billed the session fee. If difficulty with this policy would create a barrier for you, we can discuss options before booking.</div>\\n      </div>\\n\\n      <div class=\\\"item\\\" data-key=\\\"3\\\">\\n        <div class=\\\"q\\\">Telehealth and location<span>+</span></div>\\n        <div class=\\\"a\\\">Most sessions are offered via secure telehealth. Limited in-person meetings may be available; ask about current availability. We’ll confirm platform details when you schedule.</div>\\n      </div>\\n\\n      <div class=\\\"item open\\\" data-key=\\\"4\\\">\\n        <div class=\\\"q\\\">Confidentiality and scope<span>−</span></div>\\n        <div class=\\\"a\\\">\\n          I treat what we discuss with professional confidentiality. Limits to confidentiality include situations where there is a reasonable concern about imminent harm to yourself or others, known abuse of a child or vulnerable adult, or if I am ordered by a court to release records. I will always try to be transparent about these limits and discuss them with you when they are relevant.\\n\\n          Records: I keep basic clinical records about sessions. If you request copies, I can provide a summary and discuss any concerns about information sharing.\\n\\n          Email and texting: Email and SMS are not fully secure. Use them for scheduling or brief messages only. For sensitive content, we use the secure telehealth platform or discuss during sessions.\\n        </div>\\n      </div>\\n\\n      <div class=\\\"item\\\" data-key=\\\"5\\\">\\n        <div class=\\\"q\\\">Insurance and superbills<span>+</span></div>\\n        <div class=\\\"a\\\">I do not bill insurance directly. I can provide a superbill with the necessary codes so you may submit for out-of-network reimbursement if your plan allows. Coverage and reimbursement are determined by your carrier.</div>\\n      </div>\\n\\n      <div class=\\\"item\\\" data-key=\\\"6\\\">\\n        <div class=\\\"q\\\">What won’t therapy do?<span>+</span></div>\\n        <div class=\\\"a\\\">Therapy is collaborative and often gradual. I cannot guarantee specific outcomes. We work together to clarify goals, test approaches, and notice what helps. If your needs require another type of service (e.g., specialized medical care or an urgent safety plan), I will discuss appropriate referrals.</div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"crisis\\\">\\n      If you are in immediate danger or require urgent medical attention, contact local emergency services right away. If you are having suicidal thoughts or feeling you might harm yourself, please call your local emergency number or the national crisis line. If you are in {{STATE}} and need additional help, reach out to local crisis resources, or call your primary medical emergency number. If you have questions about safety planning, bring them up in the first session or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.\\n    </div>\\n\\n    <div class=\\\"meta\\\">Clinical note: This information describes typical practice procedures and important limits to confidentiality. It is not a substitute for individualized assessment or emergency support. If you have immediate safety concerns, please call for help.</div>\\n  </main>\\n\\n  <script>\\n    document.querySelectorAll('.accordion .item .q').forEach(function(q){\\n      q.addEventListener('click',function(){\\n        var item = q.parentElement;\\n        var open = item.classList.contains('open');\\n        if(open){ item.classList.remove('open'); q.querySelector('span').textContent = '+'; }\\n        else{ item.classList.add('open'); q.querySelector('span').textContent = '−'; }\\n      });\\n    });\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Schedule — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f8fbff;--card:#ffffff;--ink:#0e1b22;--muted:#5c6b74;--accent:#6ab3ff}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial;background:var(--bg);color:var(--ink)}\\n    header{padding:12px 20px;background:linear-gradient(180deg,#fff,#f8fbff);border-bottom:1px solid rgba(14,27,34,0.05);position:sticky;top:0}\\n    .nav{max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin:0 8px;color:var(--muted);text-decoration:none}\\n    .nav .cta{background:var(--accent);color:white;padding:8px 12px;border-radius:8px;text-decoration:none}\\n    main{max-width:980px;margin:28px auto;padding:0 20px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:24px}\\n    .card{background:var(--card);padding:20px;border-radius:12px;border:1px solid rgba(14,27,34,0.04)}\\n    h1{margin-top:0;font-size:26px}\\n    .muted{color:var(--muted)}\\n    .selector{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}\\n    .mood{padding:10px 12px;border-radius:10px;border:1px solid rgba(14,27,34,0.06);background:linear-gradient(180deg,#fff,#fbfdff);cursor:pointer}\\n    .mood.active{outline:3px solid rgba(106,179,255,0.18);transform:translateY(-3px)}\\n    .rec{margin-top:16px;padding:14px;border-radius:10px;background:linear-gradient(90deg,#f7fbff,#ffffff);border:1px solid rgba(106,179,255,0.08)}\\n    form{display:flex;flex-direction:column;gap:10px}\\n    input,select,textarea{padding:10px;border-radius:8px;border:1px solid rgba(14,27,34,0.08)}\\n    .primary{background:var(--accent);color:white;padding:12px;border-radius:10px;border:0;font-weight:700}\\n    .link{color:var(--accent);text-decoration:none}\\n    .small{font-size:13px;color:var(--muted)}\\n    .accordion{margin-top:18px;border-radius:12px}\\n    .item{border-top:1px solid rgba(14,27,34,0.06);background:white}\\n    .q{display:flex;justify-content:space-between;align-items:center;padding:12px;cursor:pointer}\\n    .a{padding:0 12px 12px 12px;color:var(--muted);display:none}\\n    .open .a{display:block}\\n    .crisis{margin-top:14px;padding:10px;border-radius:8px;background:#fff6f6;color:#672b2b;border:1px solid rgba(230,80,80,0.06)}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <div>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">Meet</a>\\n        <a href=\\\"specialties.html\\\">Expertise</a>\\n        <a href=\\\"approach.html\\\">Way I Work</a>\\n        <a href=\\\"fees.html\\\">Investment</a>\\n        <a href=\\\"faq.html\\\">Practicalities</a>\\n        <a href=\\\"book.html\\\" style=\\\"color:var(--ink)\\\">Schedule</a>\\n        <a class=\\\"cta\\\" href=\\\"contact.html\\\">Reach Out</a>\\n      </div>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"grid\\\">\\n      <div class=\\\"card\\\">\\n        <h1>Schedule a session</h1>\\n        <p class=\\\"muted\\\">Start by sharing how you’re feeling. The recommendation updates to match practical approaches I use clinically, and the action button changes to reflect that suggestion.</p>\\n\\n        <div>\\n          <label class=\\\"small\\\">Pick a current state</label>\\n          <div class=\\\"selector\\\" role=\\\"tablist\\\" id=\\\"moods\\\">\\n            <button class=\\\"mood\\\" data-method=\\\"focus\\\">Bruised &amp; Need a Reset</button>\\n            <button class=\\\"mood\\\" data-method=\\\"block\\\">Working Through a Specific Problem</button>\\n            <button class=\\\"mood\\\" data-method=\\\"checkin\\\">Holding Steady, Need Occasional Check-ins</button>\\n            <button class=\\\"mood\\\" data-method=\\\"intensive\\\">A Crunch Moment — Short Intensive</button>\\n            <button class=\\\"mood\\\" data-method=\\\"explore\\\">Curious About Therapy</button>\\n          </div>\\n\\n          <div class=\\\"rec\\\" id=\\\"recommendation\\\">\\n            <strong>Recommendation</strong>\\n            <div id=\\\"rec-body\\\" style=\\\"margin-top:8px\\\" class=\\\"muted\\\">Select how you’re feeling to see a proposed path and the next step.</div>\\n          </div>\\n\\n          <form id=\\\"booking\\\" style=\\\"margin-top:14px\\\">\\n            <input name=\\\"name\\\" placeholder=\\\"Your name\\\" required>\\n            <input name=\\\"email\\\" placeholder=\\\"Email\\\" required>\\n            <input name=\\\"phone\\\" placeholder=\\\"Phone (optional)\\\">\\n            <select name=\\\"format\\\">\\n              <option>Telehealth</option>\\n              <option>In-person (limited)</option>\\n            </select>\\n            <textarea name=\\\"notes\\\" placeholder=\\\"Anything you want the clinician to know (optional)\\\" rows=\\\"3\\\"></textarea>\\n\\n            <div style=\\\"display:flex;gap:10px;align-items:center;margin-top:6px\\\">\\n              <button type=\\\"button\\\" id=\\\"primaryCta\\\" class=\\\"primary\\\">{{PRIMARY_CTA_LABEL}}</button>\\n              <a class=\\\"link\\\" href=\\\"contact.html\\\">Ask a question first</a>\\n            </div>\\n\\n            <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">You’ll receive a confirmation and a short intake form after booking. If you prefer, email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>.</div>\\n          </form>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Session boundaries &amp; confidentiality</h3>\\n        <div class=\\\"accordion\\\" id=\\\"acc\\\">\\n          <div class=\\\"item open\\\">\\n            <div class=\\\"q\\\">What is kept private?<span>−</span></div>\\n            <div class=\\\"a\\\">Clinical conversations are treated as confidential. Limits include imminent risk of harm, suspected abuse, or legal orders. I will aim to discuss any limits with you whenever possible.</div>\\n          </div>\\n          <div class=\\\"item\\\">\\n            <div class=\\\"q\\\">Records and notes<span>+</span></div>\\n            <div class=\\\"a\\\">I keep brief clinical notes that support continuity of care. If you request copies, I will guide you through the process and discuss any privacy concerns.</div>\\n          </div>\\n          <div class=\\\"item\\\">\\n            <div class=\\\"q\\\">Emergency &amp; crisis guidance<span>+</span></div>\\n            <div class=\\\"a\\\">If you are in immediate danger, call local emergency services. For urgent mental health concerns outside sessions, visit the nearest emergency department or call the national crisis line. For non-urgent safety planning, we will address it together during the first meeting or by phone if needed.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"crisis\\\">If you are thinking about harming yourself or someone else, contact emergency services immediately or use your local crisis line. If you are located in {{STATE}} and need help locating resources, email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> and I will assist with referrals.</div>\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <script>\\n    // Mood-to-Method selector\\n    var moods = document.querySelectorAll('.mood');\\n    var recBody = document.getElementById('rec-body');\\n    var primaryCta = document.getElementById('primaryCta');\\n\\n    var recommendations = {\\n      focus: {\\n        title: 'Single Focus Session',\\n        desc: 'A single session for resetting, clarifying immediate next steps, and short-term planning. Often helpful after a difficult week or before an important conversation.',\\n        cta: 'Book a clarity session',\\n        urlSuffix: '?plan=focus'\\n      },\\n      block: {\\n        title: 'Short Guided Block',\\n        desc: 'A series of four sessions paced to tackle a specific problem or change. We build skills, test strategies, and track progress week to week.',\\n        cta: 'Start a short block',\\n        urlSuffix: '?plan=block'\\n      },\\n      checkin: {\\n        title: 'Light Check-ins',\\n        desc: 'Less frequent maintenance sessions for staying grounded, troubleshooting, and preventing drift when life is busy.',\\n        cta: 'Request a check-in',\\n        urlSuffix: '?plan=checkin'\\n      },\\n      intensive: {\\n        title: 'Short Intensive',\\n        desc: 'A concentrated session or pair of extended meetings for a high-demand moment—practical planning and immediate coping strategies.',\\n        cta: 'Book an intensive',\\n        urlSuffix: '?plan=intensive'\\n      },\\n      explore: {\\n        title: 'Exploratory Appointment',\\n        desc: 'A first meeting to see whether the approach fits you, to outline goals, and to decide on next steps without pressure.',\\n        cta: 'Schedule an exploratory visit',\\n        urlSuffix: '?plan=explore'\\n      }\\n    };\\n\\n    function setActive(el){\\n      moods.forEach(function(m){m.classList.remove('active')});\\n      el.classList.add('active');\\n    }\\n\\n    function updateRecommendation(key){\\n      var r = recommendations[key];\\n      recBody.innerHTML = '<div style=\\\"font-weight:700\\\">'+r.title+'</div><div style=\\\"margin-top:8px\\\" class=\\\"muted\\\">'+r.desc+'</div>';\\n      primaryCta.textContent = r.cta;\\n      // update CTA to include a query parameter pointing at the main scheduling path\\n      primaryCta.onclick = function(){\\n        // In a real app this would open a booking modal. Here we redirect to PRIMARY_CTA_URL with a hint.\\n        var target = '{{PRIMARY_CTA_URL}}' + r.urlSuffix;\\n        window.location.href = target;\\n      };\\n    }\\n\\n    moods.forEach(function(btn){\\n      btn.addEventListener('click', function(){\\n        setActive(btn);\\n        var method = btn.getAttribute('data-method');\\n        updateRecommendation(method);\\n      });\\n    });\\n\\n    // default to explore\\n    var defaultBtn = document.querySelector('.mood[data-method=\\\"explore\\\"]');\\n    if(defaultBtn){ defaultBtn.click(); }\\n\\n    // sidebar accordion\\n    document.querySelectorAll('.accordion .item .q').forEach(function(q){\\n      q.addEventListener('click',function(){\\n        var item = q.parentElement;\\n        var open = item.classList.contains('open');\\n        if(open){ item.classList.remove('open'); q.querySelector('span').textContent = '+'; }\\n        else{ item.classList.add('open'); q.querySelector('span').textContent = '−'; }\\n      });\\n    });\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
