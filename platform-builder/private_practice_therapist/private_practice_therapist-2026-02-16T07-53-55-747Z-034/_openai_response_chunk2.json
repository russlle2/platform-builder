          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"About {{THERAPIST_NAME}} — private practice therapy in {{CITY}}, {{STATE}}\\\">\\n  <style>\\n    :root{--bg:#fff;--ink:#0b0b0b;--muted:#6b6b6b;--accent:#2b6cb0;--card:#fafafa}\\n    *{box-sizing:border-box}\\n    body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;line-height:1.5;color:var(--ink);margin:0;background:var(--bg)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 48px;border-bottom:1px solid #eee}\\n    .brand{font-weight:700;letter-spacing:0.2px}\\n    nav a{margin-left:20px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:40px;padding:64px 48px;align-items:center}\\n    .hero .kicker{color:var(--accent);font-weight:700;text-transform:uppercase;font-size:12px}\\n    .hero h1{font-size:34px;margin:12px 0 8px}\\n    .hero p{color:var(--muted);max-width:56ch}\\n    .hero .panel{background:var(--card);padding:28px;border-radius:12px;box-shadow:0 6px 24px rgba(11,11,11,0.04)}\\n    .avatar{display:flex;align-items:center}\\n    .avatar img{width:72px;height:72px;border-radius:8px;margin-right:16px}\\n    .section{padding:48px;display:grid;gap:22px;border-top:1px solid #f2f2f2}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\\n    .card{background:white;padding:18px;border-radius:10px;border:1px solid #f0f0f0}\\n    .methods{display:flex;gap:18px}\\n    .methods .method{flex:1;background:linear-gradient(180deg,#fff,#fbfdff);padding:18px;border-radius:10px;border:1px solid #eef6ff}\\n    .testimonial{background:#f7fbff;padding:18px;border-left:4px solid var(--accent);border-radius:6px}\\n    .leadmag{display:flex;gap:18px;align-items:center}\\n    .leadmag input{flex:1;padding:12px;border:1px solid #e6e6e6;border-radius:8px}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:8px;border:0;font-weight:700;cursor:pointer}\\n    footer{padding:28px 48px;color:var(--muted);font-size:13px;border-top:1px solid #f2f2f2}\\n    @media (max-width:900px){.hero{grid-template-columns:1fr;padding:28px}.grid{grid-template-columns:1fr}.hero .panel{order:2}.hero svg{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"specialties.html\\\">Specialties</a>\\n      <a href=\\\"approach.html\\\">How I Work</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <div class=\\\"kicker\\\">About the practice</div>\\n        <h1>Clinical partnership that meets you where life has brought you</h1>\\n        <p>I work with adults navigating anxiety, trauma, relationship shifts, and professional burnout. My style blends focused evidence-informed interventions with practical coaching so you leave sessions with clearer next steps—not just insight.</p>\\n        <div style=\\\"margin-top:20px;display:flex;gap:12px\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a style=\\\"padding:10px 14px;border-radius:8px;border:1px solid #e6e6e6;text-decoration:none;color:var(--muted)\\\" href=\\\"contact.html\\\">Ask a question</a>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"panel\\\">\\n        <div class=\\\"avatar\\\">\\n          <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"Therapist avatar\\\">\\n          <div>\\n            <strong>{{THERAPIST_NAME}}, {{LICENSE}}</strong>\\n            <div style=\\\"color:var(--muted);font-size:13px\\\">Private practice • {{CITY}}, {{STATE}}</div>\\n          </div>\\n        </div>\\n        <p style=\\\"margin-top:14px;color:var(--muted)\\\">I prioritize clarity, safety, and collaboration. We map goals together and use short-term tools alongside deeper psychological work when needed.</p>\\n        <div style=\\\"margin-top:12px;font-size:13px;color:var(--muted)\\\">Modalities: {{MODALITIES}}</div>\\n      </aside>\\n\\n      <svg style=\\\"grid-column:1/3;margin-top:12px\\\" width=\\\"0\\\" height=\\\"0\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"></svg>\\n    </section>\\n\\n    <section class=\\\"section\\\" aria-labelledby=\\\"values\\\">\\n      <h2 id=\\\"values\\\">Core Commitments</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"card\\\"><strong>Confidential partnership</strong><p style=\\\"color:var(--muted)\\\">Your privacy and comfort guide how sessions are held; I’ll explain limits of confidentiality and documentation practices during intake.</p></div>\\n        <div class=\\\"card\\\"><strong>Evidence-informed</strong><p style=\\\"color:var(--muted)\\\">I draw from CBT, somatic approaches, and relational frameworks to craft interventions that make practical differences.</p></div>\\n        <div class=\\\"card\\\"><strong>Transparent planning</strong><p style=\\\"color:var(--muted)\\\">You’ll get clear session goals and options for short-term work or longer-term therapy depending on need.</p></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\" aria-labelledby=\\\"methods\\\">\\n      <h2 id=\\\"methods\\\">How I guide clients</h2>\\n      <div class=\\\"methods\\\">\\n        <div class=\\\"method\\\"><strong>Assessment & focus</strong><p style=\\\"color:var(--muted)\\\">We identify patterns, strengths, and the immediate problems you want to solve.</p></div>\\n        <div class=\\\"method\\\"><strong>Practical skills</strong><p style=\\\"color:var(--muted)\\\">Tools to manage symptoms between sessions—breath work, grounding, behavior experiments.</p></div>\\n        <div class=\\\"method\\\"><strong>Deeper insight</strong><p style=\\\"color:var(--muted)\\\">Meaning-making and relational work to shift longstanding patterns where helpful.</p></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h2>Common Concerns People Share</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"card\\\"><strong>Will therapy take forever?</strong><p style=\\\"color:var(--muted)\\\">Some goals are short-term and solution-focused; others need more time. We decide pacing together and periodically review progress.</p></div>\\n        <div class=\\\"card\\\"><strong>Is this confidential?</strong><p style=\\\"color:var(--muted)\\\">Yes—except in specific legal or safety situations. I will explain limits of confidentiality before intake.</p></div>\\n        <div class=\\\"card\\\"><strong>What if I don’t feel better right away?</strong><p style=\\\"color:var(--muted)\\\">Early sessions are about building trust and direction. We’ll set realistic milestones and adjust methods as we go.</p></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h2>Client Stories</h2>\\n      <div style=\\\"display:grid;gap:12px\\\">\\n        <div class=\\\"testimonial\\\">\\\"I began only wanting tools for panic; within months I had better relationships with myself and others.\\\" — A. (client)</div>\\n        <div class=\\\"testimonial\\\">\\\"Clear, direct, kind. I appreciated concrete steps and the professional boundary-setting.\\\" — R. (client)</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h2>Free guide</h2>\\n      <div class=\\\"leadmag\\\">\\n        <input aria-label=\\\"Email\\\" placeholder=\\\"Your email\\\" type=\\\"email\\\">\\n        <button class=\\\"btn\\\">Get the 5-step guide</button>\\n      </div>\\n      <p style=\\\"color:var(--muted);margin-top:8px\\\">Receive practical strategies to manage anxiety between sessions. No spam; unsubscribe anytime.</p>\\n    </section>\\n\\n    <section class=\\\"section\\\" style=\\\"text-align:center\\\">\\n      <h2>Ready to schedule?</h2>\\n      <p style=\\\"color:var(--muted)\\\">If you’re ready to explore working together, choose a next step below.</p>\\n      <div style=\\\"margin-top:12px;display:flex;justify-content:center;gap:12px\\\">\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <a href=\\\"contact.html\\\" style=\\\"padding:10px 14px;border-radius:8px;border:1px solid #e6e6e6;text-decoration:none;color:var(--muted)\\\">Email: {{EMAIL}}</a>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — {{TAGLINE}} • {{PHONE}} • {{EMAIL}}</div>\\n    <div style=\\\"margin-top:8px;color:var(--muted);font-size:13px\\\">Confidentiality note: Communications in email or forms are not fully secure; detailed session notes are protected. In case of crisis or danger, call your local emergency services or go to the nearest emergency room. I do not provide emergency services via email. Scope: I provide psychotherapy and coaching for adults. Boundaries and documentation are discussed at intake.</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"specialties.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Specialties — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"What I treat — anxiety, trauma, relationships, burnout in {{CITY}}, {{STATE}}\\\">\\n  <style>\\n    :root{--bg:#fff;--ink:#051628;--muted:#505f6a;--accent:#8b1fff}\\n    body{font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial;color:var(--ink);margin:0;background:var(--bg)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:24px 40px;border-bottom:1px solid #f0f3f6}\\n    .brand{font-weight:800}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none}\\n    .hero{display:flex;align-items:center;gap:30px;padding:56px 40px}\\n    .hero .col{flex:1}\\n    .hero h1{font-size:30px;margin:0}\\n    .tiles{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;padding:20px 40px}\\n    .tile{background:#fff;border-radius:12px;padding:18px;border:1px solid #eef2f5}\\n    .tile h3{margin:0 0 8px}\\n    .methods{padding:20px 40px;display:flex;gap:16px}\\n    .method{flex:1;padding:14px;background:linear-gradient(180deg,#fff,#f9f8ff);border-radius:10px;border:1px solid #f0ebff}\\n    .leadmag{background:linear-gradient(90deg,#fff,#fbf7ff);padding:20px 40px;display:flex;justify-content:space-between;align-items:center}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:8px;border:0;font-weight:700}\\n    .testimonials{padding:20px 40px}\\n    .testimonial{padding:12px;border-left:3px solid #eee;background:#fff;border-radius:6px}\\n    footer{padding:28px 40px;color:var(--muted);font-size:13px;border-top:1px solid #f6f7f9}\\n    @media(max-width:800px){.tiles{grid-template-columns:1fr}.hero{flex-direction:column}.leadmag{flex-direction:column;gap:8px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"approach.html\\\">Work With Me</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"col\\\">\\n        <div style=\\\"color:var(--accent);font-weight:700;text-transform:uppercase;font-size:12px\\\">Focused areas</div>\\n        <h1>Areas I commonly support</h1>\\n        <p style=\\\"color:var(--muted);max-width:60ch\\\">Therapy is tailored to specific struggles. Below are common presenting concerns I work with—each card describes how we typically approach the issue and what a few sessions might focus on.</p>\\n      </div>\\n      <div style=\\\"width:360px;background:#faf7ff;padding:20px;border-radius:12px;border:1px solid #f1e9ff\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"decorative\\\" style=\\\"width:100%;height:auto\\\">\\n      </div>\\n    </section>\\n\\n    <section class=\\\"tiles\\\" aria-labelledby=\\\"specialties\\\">\\n      <div class=\\\"tile\\\">\\n        <h3>Anxiety & Panic</h3>\\n        <p style=\\\"color:var(--muted)\\\">Short-term strategies for panic and generalized anxiety, including behavioral experiments, exposure exercises, and skills to reduce physiological arousal.</p>\\n      </div>\\n      <div class=\\\"tile\\\">\\n        <h3>Trauma Recovery</h3>\\n        <p style=\\\"color:var(--muted)\\\">Stabilization, grounding, and gradual processing using somatic-informed and evidence-based approaches to support integration and safety.</p>\\n      </div>\\n      <div class=\\\"tile\\\">\\n        <h3>Relationship Strain</h3>\\n        <p style=\\\"color:var(--muted)\\\">Work on communication, boundaries, and attachment patterns—either in individual work or collaborative couple sessions when appropriate.</p>\\n      </div>\\n      <div class=\\\"tile\\\">\\n        <h3>Career & Burnout</h3>\\n        <p style=\\\"color:var(--muted)\\\">Strategies to manage overwhelm, set sustainable limits, and realign work with values to prevent burnout.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"methods\\\">\\n      <div class=\\\"method\\\">\\n        <strong>Assess & prioritize</strong>\\n        <p style=\\\"color:var(--muted)\\\">We identify immediate safety, symptom drivers, and what change would look like for you.</p>\\n      </div>\\n      <div class=\\\"method\\\">\\n        <strong>Tailored tools</strong>\\n        <p style=\\\"color:var(--muted)\\\">Techniques are selected from {{MODALITIES}} and adjusted to your needs and pace.</p>\\n      </div>\\n      <div class=\\\"method\\\">\\n        <strong>Relational clarity</strong>\\n        <p style=\\\"color:var(--muted)\\\">We consider how relationships and patterns maintain problems and practice new ways of relating in session.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"padding:20px 40px\\\">\\n      <h2 style=\\\"margin-top:0\\\">Programs & Pathways</h2>\\n      <div style=\\\"display:flex;gap:16px;flex-wrap:wrap\\\">\\n        <div style=\\\"flex:1;min-width:220px;background:#fff;padding:14px;border-radius:10px;border:1px solid #eef2f6\\\">\\n          <strong>Relationship Renewal</strong>\\n          <p style=\\\"color:var(--muted)\\\">A short series (6–8 sessions) to improve communication and rebuild connection.</p>\\n        </div>\\n        <div style=\\\"flex:1;min-width:220px;background:#fff;padding:14px;border-radius:10px;border:1px solid #eef2f6\\\">\\n          <strong>Gentle Trauma Stabilization</strong>\\n          <p style=\\\"color:var(--muted)\\\">Focus on safety, regulation, and pacing before deeper processing when appropriate.</p>\\n        </div>\\n        <div style=\\\"flex:1;min-width:220px;background:#fff;padding:14px;border-radius:10px;border:1px solid #eef2f6\\\">\\n          <strong>Work-Life Reset</strong>\\n          <p style=\\\"color:var(--muted)\\\">A practical coaching-informed package to reduce burnout and clarify next steps for career alignment.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"leadmag\\\">\\n      <div>\\n        <strong>Free handout — Conversation starters for couples</strong>\\n        <p style=\\\"color:var(--muted);margin:4px 0\\\">Simple prompts you can use at home to open difficult topics without escalation.</p>\\n      </div>\\n      <div style=\\\"display:flex;gap:8px;align-items:center\\\">\\n        <input placeholder=\\\"Your email\\\" aria-label=\\\"Email\\\" style=\\\"padding:10px;border:1px solid #e9e9ef;border-radius:8px\\\">\\n        <button class=\\\"btn\\\">Send me the guide</button>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"testimonials\\\">\\n      <h3>Clients report</h3>\\n      <div style=\\\"display:grid;gap:12px\\\">\\n        <div class=\\\"testimonial\\\">\\\"Clear, approachable tools that helped me manage anxiety at work.\\\" — M.</div>\\n        <div class=\\\"testimonial\\\">\\\"A supportive space where I felt understood and supported to try new things.\\\" — L.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"padding:20px 40px;text-align:center\\\">\\n      <h3>Questions before booking?</h3>\\n      <p style=\\\"color:var(--muted)\\\">If you'd like to check availability or suitability for your concern, reach out for a brief consultation.</p>\\n      <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • {{THERAPIST_NAME}}, {{LICENSE}} • {{PHONE}} • {{EMAIL}}</div>\\n    <div style=\\\"margin-top:8px;color:var(--muted)\\\">Privacy & scope: Notes are kept according to professional standards. If you are in crisis or at risk of harm, please call local emergency services or go to the nearest emergency room—this site and email are not monitored for emergencies.</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Approach & Methods — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Therapeutic approach and session structure — {{THERAPIST_NAME}} in {{CITY}}, {{STATE}}\\\">\\n  <style>\\n    :root{--bg:#fbfbfd;--ink:#102229;--muted:#6a7b80;--accent:#1e9a8a}\\n    body{font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial;margin:0;color:var(--ink);background:var(--bg)}\\n    header{display:flex;justify-content:space-between;padding:22px 44px;border-bottom:1px solid #e9eef0}\\n    .brand{font-weight:800}\\n    nav a{margin-left:16px;color:var(--muted);text-decoration:none}\\n    .intro{display:grid;grid-template-columns:1fr 320px;gap:28px;padding:48px 44px;align-items:center}\\n    .intro h1{margin:0;font-size:30px}\\n    .panel{background:white;border-radius:12px;padding:18px;border:1px solid #e6f3ef}\\n    .flow{display:flex;gap:16px;padding:28px 44px}\\n    .step{background:white;padding:16px;border-radius:10px;border:1px solid #eef6f4;flex:1}\\n    .pricing-note{padding:20px 44px;color:var(--muted)}\\n    .cta{padding:28px 44px;text-align:center}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:8px;border:0}\\n    footer{padding:28px 44px;color:var(--muted);font-size:13px;border-top:1px solid #eef2f2}\\n    @media(max-width:880px){.intro{grid-template-columns:1fr}.flow{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"specialties.html\\\">Paths</a>\\n      <a href=\\\"about.html\\\">Who I Am</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"intro\\\">\\n      <div>\\n        <h1>A practical, evidence-informed way of working</h1>\\n        <p style=\\\"color:var(--muted);max-width:60ch\\\">My practice emphasizes clarity, safety, and measurable steps. Below is how a typical course of work is organized and how I choose techniques to fit each person’s needs.</p>\\n        <div style=\\\"margin-top:18px;display:flex;gap:10px\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a href=\\\"contact.html\\\" style=\\\"padding:10px 14px;border-radius:8px;border:1px solid #e6e6e6;text-decoration:none;color:var(--muted)\\\">Message me</a>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"panel\\\">\\n        <strong>Modalities</strong>\\n        <p style=\\\"color:var(--muted);margin-top:8px\\\">I integrate {{MODALITIES}} and tailor approaches to your priorities—balancing symptom relief with longer-term pattern work.</p>\\n        <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"decorative pattern\\\" style=\\\"width:100%;margin-top:12px\\\">\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"flow\\\" aria-labelledby=\\\"process\\\">\\n      <div class=\\\"step\\\">\\n        <strong>1. Intake & Safety</strong>\\n        <p style=\\\"color:var(--muted)\\\">We clarify presenting concerns, assess risk, and outline initial goals. Confidentiality and limits are reviewed.</p>\\n      </div>\\n      <div class=\\\"step\\\">\\n        <strong>2. Skills & Stabilization</strong>\\n        <p style=\\\"color:var(--muted)\\\">Short-term tools to manage distress—sleep, anxiety regulation, grounding, and behavioral experiments.</p>\\n      </div>\\n      <div class=\\\"step\\\">\\n        <strong>3. Deeper integration</strong>\\n        <p style=\\\"color:var(--muted)\\\">When helpful, we work on relational patterns and meaning-making to support sustained change.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"padding:20px 44px\\\">\\n      <h2 style=\\\"margin-top:0\\\">Program examples</h2>\\n      <div style=\\\"display:flex;gap:12px;flex-wrap:wrap\\\">\\n        <div style=\\\"background:white;padding:14px;border-radius:10px;border:1px solid #eef3f2;min-width:200px\\\">\\n          <strong>Resilience Pathway</strong>\\n          <p style=\\\"color:var(--muted)\\\">A 10-week plan focused on building emotional regulation and sustainable coping habits.</p>\\n        </div>\\n        <div style=\\\"background:white;padding:14px;border-radius:10px;border:1px solid #eef3f2;min-width:200px\\\">\\n          <strong>Grounding Series</strong>\\n          <p style=\\\"color:var(--muted)\\\">Five sessions aimed at rapid stabilization for those recovering from recent stress or shock.</p>\\n        </div>\\n        <div style=\\\"background:white;padding:14px;border-radius:10px;border:1px solid #eef3f2;min-width:200px\\\">\\n          <strong>Customized Maintenance</strong>\\n          <p style=\\\"color:var(--muted)\\\">A looser plan for periodic check-ins and ongoing skills refresh as life demands shift.</p>\\n        </div>\\n      </div>\\n      <p class=\\\"pricing-note\\\">Note: Specific session rates and package options are handled on the Fees page and discussed during an initial call. Payment, insurance, and cancellation policies are reviewed before services begin.</p>\\n    </section>\\n\\n    <section style=\\\"padding:20px 44px\\\">\\n      <h2>Addressing common hesitations</h2>\\n      <div style=\\\"display:grid;gap:12px\\\">\\n        <div style=\\\"background:white;padding:12px;border-radius:8px;border:1px solid #eef6f4\\\">\\n          <strong>I'm unsure therapy will help me</strong>\\n          <p style=\\\"color:var(--muted)\\\">We begin with small, testable steps so you can evaluate benefit early and choose whether to continue or change focus.</p>\\n        </div>\\n        <div style=\\\"background:white;padding:12px;border-radius:8px;border:1px solid #eef6f4\\\">\\n          <strong>I don't have time for weekly sessions</strong>\\n          <p style=\\\"color:var(--muted)\\\">Flexible schedules, brief check-ins, or concentrated packages are available to fit different needs.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"padding:28px 44px;text-align:center\\\">\\n      <h2>Client experiences</h2>\\n      <div style=\\\"max-width:720px;margin:12px auto;color:var(--muted)\\\">\\n        \\\"The structure helped me see progress quickly; the therapist balanced challenge with clear support.\\\" — J.\\n      </div>\\n      <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule a consultation</a>\\n    </section>\\n\\n    <section style=\\\"padding:20px 44px\\\">\\n      <h3>Quick sign-up</h3>\\n      <div style=\\\"display:flex;gap:8px;max-width:680px\\\">\\n        <input placeholder=\\\"Email\\\" aria-label=\\\"Email\\\" style=\\\"flex:1;padding:10px;border:1px solid #dfe8e6;border-radius:8px\\\">\\n        <button class=\\\"btn\\\">Send materials</button>\\n      </div>\\n      <p style=\\\"color:var(--muted);margin-top:8px\\\">Materials include an overview of session expectations and a short self-reflection exercise to prepare for your first meeting.</p>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • {{THERAPIST_NAME}}, {{LICENSE}} • {{PHONE}} • {{EMAIL}}</div>\\n    <div style=\\\"margin-top:8px;color:var(--muted)\\\">Privacy: Records are managed per professional standards. Crisis: If you are in immediate danger or need urgent care, call emergency services or go to the nearest emergency department. This site is not monitored for emergencies.</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
