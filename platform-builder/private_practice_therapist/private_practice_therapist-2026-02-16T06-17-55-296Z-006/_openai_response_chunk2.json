          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfaf9;--card:#fff;--muted:#6b6b6b;--accent:#6b4eff;--glass:rgba(255,255,255,0.7);font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial}\\n    body{margin:0;background:linear-gradient(180deg,#fff 0%,var(--bg) 100%);color:#222}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 6vw}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:56px;height:56px;background:var(--card);border-radius:10px;display:grid;place-items:center;box-shadow:0 6px 20px rgba(99,84,255,0.08)}\\n    nav a{margin-left:18px;color:#333;text-decoration:none;font-weight:600}\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:36px;align-items:center;padding:48px 6vw}\\n    .hero h1{font-size:28px;margin:0 0 8px;color:#0f1724}\\n    .hero p{margin:0;color:var(--muted);line-height:1.5}\\n    .hero-visual{background:var(--card);border-radius:16px;padding:28px;box-shadow:0 12px 40px rgba(30,30,60,0.06);display:grid;place-items:center}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;padding:24px 6vw}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 8px 30px rgba(18,18,30,0.04)}\\n    .muted{color:var(--muted);font-size:14px}\\n    .section{padding:28px 6vw}\\n    .testimonials{display:flex;flex-direction:column;gap:12px}\\n    .testimonial{background:linear-gradient(180deg,rgba(107,78,255,0.04),transparent);padding:16px;border-radius:10px}\\n    .leadmag{display:flex;gap:16px;align-items:center}\\n    .pm{background:linear-gradient(90deg,#fff,#fff);padding:14px;border-radius:10px;border:1px solid rgba(0,0,0,0.04)}\\n    footer{padding:28px 6vw;color:var(--muted);font-size:13px}\\n    .cta{display:inline-block;background:var(--accent);color:white;padding:10px 16px;border-radius:9px;text-decoration:none;font-weight:700}\\n    .small{font-size:13px;color:var(--muted)}\\n    @media(max-width:900px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}.hero-visual{order:-1}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\" aria-hidden>\\n        <svg width=\\\"40\\\" height=\\\"40\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><rect x=\\\"1\\\" y=\\\"3\\\" width=\\\"22\\\" height=\\\"18\\\" rx=\\\"4\\\" fill=\\\"url(#g)\\\"/><defs><linearGradient id=\\\"g\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#6B4EFF\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#9B8BFF\\\"/></linearGradient></defs></svg>\\n      </div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"small\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"specialties.html\\\">Areas</a>\\n      <a href=\\\"approach.html\\\">Philosophy</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>I'm {{THERAPIST_NAME}} — a clinician for adults navigating change</h1>\\n        <p>I offer a warm, structured space to make sense of overwhelm, recover from old hurts, and build practical tools for steadying your life. I work with anxiety, relationship patterns, trauma recovery, and life transitions in {{CITY}}, {{STATE}}.</p>\\n\\n        <div style=\\\"margin-top:18px;display:flex;gap:12px;align-items:center\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a href=\\\"book.html\\\" style=\\\"color:var(--muted);text-decoration:none\\\">View availability</a>\\n        </div>\\n\\n        <div style=\\\"margin-top:20px\\\" class=\\\"small\\\">Sessions are confidential. See footer for scope and crisis guidance.</div>\\n      </div>\\n\\n      <div class=\\\"hero-visual\\\" role=\\\"img\\\" aria-label=\\\"Calm abstract illustration\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"calming gallery illustration\\\" style=\\\"width:100%;height:auto;max-width:360px\\\"/>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h2 style=\\\"margin:0 0 12px\\\">A few people who trusted this work</h2>\\n      <div class=\\\"testimonials\\\">\\n        <div class=\\\"testimonial\\\">\\n          <strong>\\\"Grounded and practical.\\\"</strong>\\n          <div class=\\\"muted\\\">I left each session with a tool I could use. — E.</div>\\n        </div>\\n        <div class=\\\"testimonial\\\">\\n          <strong>\\\"Held me without rushing.\\\"</strong>\\n          <div class=\\\"muted\\\">The pace honored what felt safe. — L.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h2 style=\\\"margin:0 0 12px\\\">What I help with</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Anxiety & Worry</strong>\\n          <div class=\\\"muted\\\">Skill-building for reducing physiological reactivity and catastrophic thinking.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Trauma-Informed Care</strong>\\n          <div class=\\\"muted\\\">Stabilization first, then gentle processing when you're ready.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Relationship Patterns</strong>\\n          <div class=\\\"muted\\\">Explore how attachment and expectations shape how you show up.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h2 style=\\\"margin:0 0 12px\\\">How I typically work</h2>\\n      <div class=\\\"grid\\\" style=\\\"grid-template-columns:1fr 1fr\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Intake & Alignment</strong>\\n          <div class=\\\"muted\\\">We clarify goals, discuss boundaries, and identify immediate supports.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Stabilization Phase</strong>\\n          <div class=\\\"muted\\\">Breathing, grounding, sleep, and safety planning when needed.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Skill Integration</strong>\\n          <div class=\\\"muted\\\">Evidence-informed tools tailored to your life context.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Review & Next Steps</strong>\\n          <div class=\\\"muted\\\">We regularly review progress and decide together about pacing and ending.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h2 style=\\\"margin:0 0 12px\\\">Helpful resources</h2>\\n      <div class=\\\"leadmag\\\">\\n        <div class=\\\"pm\\\">\\n          <strong>Free guide:</strong>\\n          <div class=\\\"muted\\\">\\\"5 Grounding Practices to Use When You're Overwhelmed\\\" — a one-page PDF you can save and use between sessions.</div>\\n        </div>\\n        <div>\\n          <a href=\\\"index.html#lead_magnet\\\" class=\\\"cta\\\">Get the guide</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Questions people often ask</h2>\\n      <div style=\\\"display:grid;gap:10px;max-width:760px\\\">\\n        <details>\\n          <summary style=\\\"font-weight:700\\\">What kinds of therapy do you offer?</summary>\\n          <div class=\\\"muted\\\">I draw from trauma-informed CBT, mindfulness-based strategies, and relational therapy. Modalities: {{MODALITIES}}.</div>\\n        </details>\\n        <details>\\n          <summary style=\\\"font-weight:700\\\">How long are sessions and how often?</summary>\\n          <div class=\\\"muted\\\">Standard sessions are 50 minutes. We typically start weekly and then adjust based on needs.</div>\\n        </details>\\n        <details>\\n          <summary style=\\\"font-weight:700\\\">Do you take insurance?</summary>\\n          <div class=\\\"muted\\\">I am a private-pay practice. I can provide superbills for out-of-network reimbursement.</div>\\n        </details>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h2 style=\\\"margin:0 0 12px\\\">Ready to start?</h2>\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      <div style=\\\"margin-top:10px\\\" class=\\\"small\\\">You can also call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"small\\\">{{THERAPIST_NAME}}, {{LICENSE}} — {{BUSINESS_NAME}} | {{CITY}}, {{STATE}}</div>\\n    <div style=\\\"margin-top:8px\\\" class=\\\"small\\\">Confidentiality & privacy: Sessions are private and documented according to professional standards. Scope: I work with adults on issues like anxiety, trauma, relationship concerns, burnout, and life transitions. Crisis: If you are in immediate danger or having thoughts of harming yourself or others call local emergency services or the crisis line in your area.</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"specialties.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Areas of Care — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f7f6fb;--card:#fff;--accent:#2b9f9b;--muted:#606060;font-family:Georgia, 'Times New Roman', serif}\\n    body{margin:0;background:var(--bg);color:#111}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:22px 6vw}\\n    nav a{margin-left:14px;text-decoration:none;color:#111;font-weight:600}\\n    .hero{display:flex;gap:24px;align-items:center;padding:36px 6vw}\\n    .hero-left{max-width:640px}\\n    .hero h1{margin:0;font-size:30px}\\n    .hero p{color:var(--muted);margin-top:8px}\\n    .visual{width:320px;background:var(--card);padding:20px;border-radius:14px;box-shadow:0 12px 36px rgba(20,20,40,0.06)}\\n    .visual img{width:100%}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;padding:20px 6vw}\\n    .spec{background:var(--card);padding:16px;border-radius:12px;border-left:4px solid rgba(43,159,155,0.12)}\\n    .spec h3{margin:0 0 6px}\\n    .small{color:var(--muted);font-size:14px}\\n    .programs{padding:18px 6vw}\\n    .program{background:linear-gradient(180deg,#fff,#fbfbfe);padding:16px;border-radius:12px;display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}\\n    .price{font-weight:700;color:#0f1724}\\n    .cta{background:var(--accent);color:white;padding:10px 14px;border-radius:9px;text-decoration:none;font-weight:700}\\n    footer{padding:24px 6vw;color:var(--muted);font-size:13px}\\n    details{background:var(--card);padding:12px;border-radius:10px}\\n    @media(max-width:860px){.grid{grid-template-columns:1fr}.hero{flex-direction:column}.visual{width:100%}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Work With Me</a>\\n      <a href=\\\"approach.html\\\">Philosophy</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-left\\\">\\n        <h1>Areas I commonly work with</h1>\\n        <p>Below are the clinical areas I have focused experience with. If something feels close but not exact, bring it up—therapy is rarely tidy and I welcome nuanced concerns.</p>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule a consult</a></div>\\n      </div>\\n\\n      <div class=\\\"visual\\\">\\n        <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"therapist avatar illustration\\\"/>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"grid\\\">\\n      <div class=\\\"spec\\\">\\n        <h3>Anxiety & Panic</h3>\\n        <div class=\\\"small\\\">Psychoeducation about bodily responses, exposure-informed practice, and breath-based stabilization.</div>\\n      </div>\\n\\n      <div class=\\\"spec\\\">\\n        <h3>Trauma Recovery</h3>\\n        <div class=\\\"small\\\">Phase-based approach: safety first, then gentle processing using evidence-informed methods.</div>\\n      </div>\\n\\n      <div class=\\\"spec\\\">\\n        <h3>Relationship & Attachment Concerns</h3>\\n        <div class=\\\"small\\\">Work on boundaries, communication patterns, and internalized expectations that shape relationships.</div>\\n      </div>\\n\\n      <div class=\\\"spec\\\">\\n        <h3>Life Transitions & Career Burnout</h3>\\n        <div class=\\\"small\\\">Support with role change, identity shifts, and recovery from chronic stress.</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"programs\\\">\\n      <h2 style=\\\"margin:0 0 10px\\\">Signature pathways</h2>\\n      <p class=\\\"small\\\">Practical pathways people choose depending on their goals. These are examples — we'll co-create an approach that fits your life.</p>\\n\\n      <div style=\\\"margin-top:12px\\\">\\n        <div class=\\\"program\\\">\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Renewal Path — 8 sessions</div>\\n            <div class=\\\"small\\\">Focused work for specific goals (skill-building + review).</div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <div class=\\\"price\\\">8 x 50m</div>\\n            <div class=\\\"small\\\">Investment discussed at consult</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"program\\\">\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Stabilize & Integrate — ongoing</div>\\n            <div class=\\\"small\\\">For layered concerns; pacing varies. Regular reviews every 8–12 sessions.</div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <div class=\\\"price\\\">Flexible cadence</div>\\n            <div class=\\\"small\\\">Payment options discussed</div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"programs\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Practical notes</h2>\\n      <div class=\\\"small\\\">I am licensed as {{LICENSE}}. Modalities I draw from: {{MODALITIES}}. I do not provide emergency services; if you are in crisis call emergency services or your local crisis line. For insurance, I can supply superbills for out-of-network claims.</div>\\n    </section>\\n\\n    <section class=\\\"programs\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">A quick FAQ about fit</h2>\\n      <details>\\n        <summary style=\\\"font-weight:700\\\">How do I know if we should start together?</summary>\\n        <div class=\\\"small\\\">A brief consult helps us decide fit. Good fit includes a sense of safety, shared goals, and an approach that matches your preferences.</div>\\n      </details>\\n\\n      <details>\\n        <summary style=\\\"font-weight:700\\\">What if I need a different specialist?</summary>\\n        <div class=\\\"small\\\">I will provide referrals and coordinate care when a different or additional specialty is recommended.</div>\\n      </details>\\n    </section>\\n\\n    <section style=\\\"padding:24px 6vw\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Want the one-page grounding tool?</h2>\\n      <p class=\\\"small\\\">I share a short guide people use between sessions. It's linked on the home page.</p>\\n      <a class=\\\"cta\\\" href=\\\"index.html#lead_magnet\\\">Download the guide</a>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"small\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> — Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Confidentiality & scope: Sessions are private and governed by professional standards. If you are in immediate danger, call emergency services or your local crisis line.</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Therapeutic Approach — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#ffffff;--ink:#0b1320;--muted:#59606a;--accent:#7b5cff;font-family:Inter,ui-sans-serif,system-ui,Segoe UI,Roboto}\\n    body{margin:0;background:var(--bg);color:var(--ink)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:22px 6vw;border-bottom:1px solid rgba(12,14,20,0.04)}\\n    nav a{margin-left:14px;text-decoration:none;color:var(--ink)}\\n    .hero{display:flex;gap:28px;align-items:center;padding:40px 6vw}\\n    .hero h1{margin:0;font-size:26px}\\n    .sub{color:var(--muted)}\\n    .mosaic{display:grid;grid-template-columns:2fr 1fr;gap:20px;padding:20px 6vw}\\n    .panel{background:linear-gradient(180deg,#fff,#fbf9ff);padding:18px;border-radius:12px;box-shadow:0 10px 30px rgba(120,90,255,0.06)}\\n    .steps{display:flex;flex-direction:column;gap:12px}\\n    .step{display:flex;gap:12px;align-items:flex-start}\\n    .num{width:34px;height:34px;border-radius:8px;background:var(--accent);color:white;display:grid;place-items:center;font-weight:700}\\n    .faq{padding:18px 6vw}\\n    .lead{padding:18px 6vw;display:flex;justify-content:space-between;align-items:center}\\n    .cta{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    footer{padding:28px 6vw;color:var(--muted);font-size:13px}\\n    @media(max-width:900px){.mosaic{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"specialties.html\\\">Areas</a>\\n      <a href=\\\"book.html\\\">Get Started</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Therapeutic philosophy & session flow</h1>\\n        <p class=\\\"sub\\\">My work centers on safety, clarity, and practical change. I combine relational attunement with techniques you can use in daily life.</p>\\n      </div>\\n      <div style=\\\"width:260px\\\">\\n        <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"decorative pattern\\\" style=\\\"width:100%\\\"/>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"mosaic\\\">\\n      <div class=\\\"panel\\\">\\n        <h2 style=\\\"margin:0 0 8px\\\">Core principles</h2>\\n        <ul class=\\\"sub\\\">\\n          <li>Collaborative: we set goals together and check in often.</li>\\n          <li>Trauma-informed: emphasis on safety and pacing.</li>\\n          <li>Skills + reflection: integrate practices into daily life.</li>\\n        </ul>\\n\\n        <div style=\\\"margin-top:14px\\\">\\n          <strong>Modalities:</strong>\\n          <div class=\\\"sub\\\">{{MODALITIES}}</div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"panel\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">Quick note</h3>\\n        <div class=\\\"sub\\\">I am licensed as {{LICENSE}}. I do not provide emergency services—call emergency services if you are in danger.</div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"padding:0 6vw 18px\\\">\\n      <h2 style=\\\"margin:0 0 10px\\\">Session structure</h2>\\n      <div class=\\\"steps\\\">\\n        <div class=\\\"step\\\">\\n          <div class=\\\"num\\\">1</div>\\n          <div>\\n            <strong>Check-in & safety</strong>\\n            <div class=\\\"sub\\\">Brief review of how you've been and any immediate concerns.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"step\\\">\\n          <div class=\\\"num\\\">2</div>\\n          <div>\\n            <strong>Focus work</strong>\\n            <div class=\\\"sub\\\">Skill practice, gentle processing, behavioral experiments, or cognitive work depending on goals.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"step\\\">\\n          <div class=\\\"num\\\">3</div>\\n          <div>\\n            <strong>Integration & plan</strong>\\n            <div class=\\\"sub\\\">Summarize insights and agree on a small practice to try before the next session.</div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h2 style=\\\"margin:0 0 10px\\\">Questions about the approach</h2>\\n      <details>\\n        <summary style=\\\"font-weight:700\\\">How do you track progress?</summary>\\n        <div class=\\\"sub\\\">We set measurable goals and review them regularly. Progress isn't linear; we adapt the work when needed.</div>\\n      </details>\\n\\n      <details>\\n        <summary style=\\\"font-weight:700\\\">Will I be asked to relive trauma?</summary>\\n        <div class=\\\"sub\\\">No. Work is paced to your readiness. If processing feels unsafe, we focus on stabilization and resourcing first.</div>\\n      </details>\\n\\n      <details>\\n        <summary style=\\\"font-weight:700\\\">Can I bring my partner?</summary>\\n        <div class=\\\"sub\\\">Sometimes. I offer individual and occasionally adjunctive sessions when clinically appropriate. We discuss boundaries and goals up front.</div>\\n      </details>\\n    </section>\\n\\n    <section class=\\\"lead\\\">\\n      <div>\\n        <strong>Free resource:</strong>\\n        <div class=\\\"sub\\\">A short grounding exercise you can use between sessions. Available on the home page.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"index.html#lead_magnet\\\">Grab the exercise</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"padding:20px 6vw\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Next steps</h2>\\n      <p class=\\\"sub\\\">If this approach sounds like a fit, schedule a brief consult so we can talk through goals and logistics.</p>\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"sub\\\">{{THERAPIST_NAME}}, {{LICENSE}} — {{BUSINESS_NAME}} | {{CITY}}, {{STATE}}</div>\\n    <div class=\\\"sub\\\" style=\\\"margin-top:8px\\\">Confidentiality note: Clinical records are maintained per professional guidelines. If you are experiencing a crisis, contact emergency services or your local crisis line immediately.</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
