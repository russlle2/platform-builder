          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f1724;--card:#0b1220;--accent:#ffd166;--muted:#9aa4b2;--text:#f7fbff}\\n    body{margin:0;font-family:Georgia, 'Times New Roman', serif;background:var(--bg);color:var(--text);line-height:1.45}\\n    .wrap{max-width:900px;margin:48px auto;padding:36px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    .brand{font-weight:700;letter-spacing:-0.02em}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:14px}\\n    .hero{display:grid;grid-template-columns:1fr 220px;gap:28px;align-items:start;margin-top:28px}\\n    .hero h1{font-size:42px;margin:0 0 12px;color:var(--text)}\\n    .hero p.lead{color:var(--muted);margin:0 0 18px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:22px;border-radius:10px}\\n    .meta{font-size:13px;color:var(--muted);margin-bottom:8px}\\n    .pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:22px}\\n    .pillar{background:rgba(255,255,255,0.02);padding:14px;border-radius:8px}\\n    .case-list{margin-top:20px}\\n    .case{background:var(--card);padding:14px;border-radius:8px;margin-bottom:12px}\\n    .myth{margin-top:26px;padding:18px;background:linear-gradient(90deg,rgba(255,209,102,0.06),transparent);border-radius:10px}\\n    footer{margin-top:34px;color:var(--muted);font-size:13px}\\n    .cta{display:inline-block;margin-top:16px;background:var(--accent);color:#072029;padding:10px 16px;border-radius:8px;text-decoration:none;font-weight:700}\\n    .avatar{width:200px;height:200px;border-radius:10px;background:#07101a;display:flex;align-items:center;justify-content:center}\\n    .avatar svg{width:120px;height:120px;display:block}\\n    small.disclaimer{display:block;margin-top:12px;color:#bfc9d1;font-size:12px}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}} <span style=\\\"color:var(--accent);font-weight:400\\\">—</span> {{TAGLINE}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"specialties.html\\\">Specialties</a>\\n        <a href=\\\"approach.html\\\">How I Work</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"hero\\\">\\n        <div>\\n          <h1>Clinical care with measured curiosity</h1>\\n          <p class=\\\"lead\\\">I blend evidence-informed methods and collaborative inquiry to help people restore balance, clarify values, and manage distress. Therapy is a relationship and a process — I keep both focused and humane.</p>\\n          <div class=\\\"card\\\">\\n            <div class=\\\"meta\\\">Lead clinician</div>\\n            <strong>{{THERAPIST_NAME}}, {{LICENSE}}</strong>\\n            <p style=\\\"margin:10px 0 0;color:var(--muted)\\\">Modalities: {{MODALITIES}}</p>\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          </div>\\n        </div>\\n\\n        <aside class=\\\"avatar card\\\" aria-hidden=\\\"true\\\">\\n          <!-- Inline unique SVG (hero/avatar for about) -->\\n          <svg viewBox=\\\"0 0 100 100\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-label=\\\"avatar\\\">\\n            <defs>\\n              <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n                <stop offset=\\\"0\\\" stop-color=\\\"#ffd166\\\"/>\\n                <stop offset=\\\"1\\\" stop-color=\\\"#ff8fab\\\"/>\\n              </linearGradient>\\n            </defs>\\n            <rect rx=\\\"12\\\" width=\\\"100\\\" height=\\\"100\\\" fill=\\\"#072029\\\" />\\n            <g transform=\\\"translate(18,18)\\\" fill=\\\"none\\\" stroke=\\\"url(#g1)\\\" stroke-width=\\\"3\\\">\\n              <circle r=\\\"18\\\" cx=\\\"32\\\" cy=\\\"20\\\" fill=\\\"#072029\\\" stroke-width=\\\"2\\\"/>\\n              <path d=\\\"M4 68c8-10 28-12 44-12s36 2 44 12\\\" stroke-linecap=\\\"round\\\"/>\\n            </g>\\n          </svg>\\n        </aside>\\n      </section>\\n\\n      <section class=\\\"myth\\\" aria-labelledby=\\\"ethos\\\">\\n        <h2 id=\\\"ethos\\\" style=\\\"margin:0 0 8px;color:var(--text);\\\">Evidence & Ethos</h2>\\n        <p style=\\\"margin:0;color:var(--muted)\\\">My work is informed by research on relational safety and trauma-informed practice. I aim to be transparent about methods, limits, and expected variability in outcomes — therapy is collaborative, not prescriptive.</p>\\n      </section>\\n\\n      <section style=\\\"margin-top:22px\\\">\\n        <h3 style=\\\"margin-bottom:12px\\\">Foundational commitments</h3>\\n        <div class=\\\"pillars\\\">\\n          <div class=\\\"pillar\\\">\\n            <strong>Curiosity with structure</strong>\\n            <p style=\\\"color:var(--muted);margin:8px 0 0\\\">We test hypotheses together about patterns that keep you stuck and what might shift them.</p>\\n          </div>\\n          <div class=\\\"pillar\\\">\\n            <strong>Safety first</strong>\\n            <p style=\\\"color:var(--muted);margin:8px 0 0\\\">Emotional and practical safety are negotiated each step of the way.</p>\\n          </div>\\n          <div class=\\\"pillar\\\">\\n            <strong>Evidence-minded</strong>\\n            <p style=\\\"color:var(--muted);margin:8px 0 0\\\">I choose interventions that align with research and your goals.</p>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"case-list\\\" aria-labelledby=\\\"vignettes\\\">\\n        <h3 id=\\\"vignettes\\\" style=\\\"margin-bottom:12px\\\">Selected vignettes (de-identified)</h3>\\n        <div class=\\\"case\\\">\\n          <strong>Work stress & sleep disruption</strong>\\n          <p style=\\\"color:var(--muted);margin:8px 0 0\\\">A client used brief behavioral experiments and boundary-setting practices over 8 sessions to regain sleep consistency and reduce evening rumination. Progress varied week to week; changes were consolidated by practice and small behavioral adjustments.</p>\\n        </div>\\n        <div class=\\\"case\\\">\\n          <strong>Relationship trust repair</strong>\\n          <p style=\\\"color:var(--muted);margin:8px 0 0\\\">Therapy focused on communication patterns and emotion regulation skills. Sessions included in-session exercises and targeted between-session tasks to support new habits.</p>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:22px\\\">\\n        <h3>Quick answers</h3>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\">\\n          <strong>Who I work with:</strong> Adults across life transitions, relationship challenges, anxiety, burnout, and trauma-reactivity.\\n          <br>\\n          <strong>Where I practice:</strong> {{CITY}}, {{STATE}} — virtual options available within state licensure.\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:20px\\\">\\n        <h3>Questions people often ask</h3>\\n        <div style=\\\"margin-top:10px;color:var(--muted)\\\">\\n          <strong>How long do people usually work together?</strong>\\n          <p style=\\\"margin:6px 0 12px\\\">It varies — some aim for short-term focused work (8–12 sessions), others for longer exploratory therapy. We clarify goals early and revisit them regularly.</p>\\n\\n          <strong>Is what we talk about private?</strong>\\n          <p style=\\\"margin:6px 0 12px\\\">Yes. Sessions are protected by confidentiality with standard legal exceptions (e.g., imminent harm). I can provide a privacy statement before our first meeting.</p>\\n\\n          <strong>What if I’m in crisis?</strong>\\n          <p style=\\\"margin:6px 0 0\\\">If you are at immediate risk, call your local emergency services or a crisis line. I do not provide emergency services via email or text.</p>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:24px\\\">\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Connect with me</a>\\n        <small class=\\\"disclaimer\\\">I hold professional boundaries and operate within defined scope of practice. I will discuss referrals when needs exceed my scope.</small>\\n      </section>\\n    </main>\\n\\n    <footer>\\n      <p>Contact: <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a></p>\\n      <p>Confidentiality note: Records are held securely. Exceptions to confidentiality include clear and imminent risk of harm to self/others and legal mandates.</p>\\n      <p style=\\\"margin-top:8px;color:#7f8a95\\\">Therapy is not a substitute for emergency care. If you are in crisis, contact local emergency services immediately.</p>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"specialties.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Specialties — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071422;--panel:#082530;--accent:#9be7ff;--muted:#b9c7d0;--text:#e8f6fb}\\n    body{font-family:Inter, system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;background:var(--bg);color:var(--text);margin:0}\\n    .container{max-width:980px;margin:48px auto;padding:32px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:14px;font-size:14px}\\n    .lead{background:linear-gradient(90deg,rgba(155,231,255,0.06),transparent);padding:18px;border-radius:10px}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:18px}\\n    .spec{background:var(--panel);padding:16px;border-radius:10px}\\n    .spec h4{margin:0 0 8px}\\n    .case{margin-top:16px;padding:14px;background:rgba(255,255,255,0.02);border-radius:8px}\\n    .cta{margin-top:18px;display:inline-block;background:var(--accent);color:#04232a;padding:10px 14px;border-radius:8px;text-decoration:none;font-weight:700}\\n    .pattern{position:absolute;right:20px;top:20px;opacity:0.06}\\n    footer{margin-top:26px;color:var(--muted);font-size:13px}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">Bio</a>\\n        <a href=\\\"specialties.html\\\">Areas</a>\\n        <a href=\\\"approach.html\\\">Work With Me</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <section style=\\\"margin-top:20px\\\" aria-labelledby=\\\"specialties-title\\\">\\n      <h1 id=\\\"specialties-title\\\" style=\\\"font-size:34px;margin:0 0 8px\\\">Clinical areas I commonly support</h1>\\n      <p class=\\\"lead\\\">I work with adults experiencing emotional overwhelm, relationship strain, and the aftereffects of traumatic stress. Below are core areas and typical starting strategies; treatment is tailored to your needs.</p>\\n\\n      <div class=\\\"grid\\\" style=\\\"margin-top:16px\\\">\\n        <div class=\\\"spec\\\">\\n          <h4>Anxiety & Worry</h4>\\n          <p style=\\\"color:var(--muted);margin:0\\\">Behavioral experiments, cognitive reframing, and focused exposure where appropriate to reduce avoidance and increase confidence.</p>\\n        </div>\\n        <div class=\\\"spec\\\">\\n          <h4>Complex Stress & Burnout</h4>\\n          <p style=\\\"color:var(--muted);margin:0\\\">Practical load-management, boundary setting, and emotion regulation to restore capacity without glossing over systemic factors.</p>\\n        </div>\\n        <div class=\\\"spec\\\">\\n          <h4>Trauma-Related Distress</h4>\\n          <p style=\\\"color:var(--muted);margin:0\\\">Stabilization, psychoeducation, and sensorimotor-informed techniques before deeper processing when ready.</p>\\n        </div>\\n        <div class=\\\"spec\\\">\\n          <h4>Relationship Repair & Communication</h4>\\n          <p style=\\\"color:var(--muted);margin:0\\\">Skill-based work to change interaction patterns, including reflective listening and behavioral shaping exercises.</p>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"grid\\\" style=\\\"margin-top:14px\\\">\\n        <div class=\\\"spec\\\">\\n          <h4>Life Transitions</h4>\\n          <p style=\\\"color:var(--muted);margin:0\\\">Decision-making frameworks and values clarification to navigate career, relational, or identity shifts.</p>\\n        </div>\\n        <div class=\\\"spec\\\">\\n          <h4>Perinatal & Parenting Stress</h4>\\n          <p style=\\\"color:var(--muted);margin:0\\\">Support for the emotional demands of parenting phases and perinatal mood concerns, with respect for medical collaboration when needed.</p>\\n        </div>\\n        <div class=\\\"spec\\\">\\n          <h4>Obsessive Patterns</h4>\\n          <p style=\\\"color:var(--muted);margin:0\\\">Strategy-driven interventions to reduce compulsive behaviors and intrusive thought distress.</p>\\n        </div>\\n        <div class=\\\"spec\\\">\\n          <h4>Depression & Low Motivation</h4>\\n          <p style=\\\"color:var(--muted);margin:0\\\">Activity scheduling, behavioral activation, and compassion-focused strategies to rebuild momentum.</p>\\n        </div>\\n      </div>\\n\\n    </section>\\n\\n    <section style=\\\"margin-top:24px\\\" aria-labelledby=\\\"modalities\\\">\\n      <h2 id=\\\"modalities\\\">Typical methods I use</h2>\\n      <p style=\\\"color:var(--muted);margin-top:6px\\\">I draw from cognitive-behavioral interventions, trauma-sensitive approaches, and relational techniques. Modalities listed in profile: {{MODALITIES}}. Modalities are chosen based on fit and clinical formulation.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h3>De-identified examples</h3>\\n      <div class=\\\"case\\\">\\n        <strong>From avoidance to engagement</strong>\\n        <p style=\\\"color:var(--muted);margin-top:6px\\\">A client who had steadily reduced social activities used graded exposure and values-checks to re-engage with meaningful social roles over 10–14 weeks.</p>\\n      </div>\\n      <div class=\\\"case\\\">\\n        <strong>Managing intrusive memories</strong>\\n        <p style=\\\"color:var(--muted);margin-top:6px\\\">Work emphasized stabilization, grounding strategies, and pacing to create tolerable windows for processing.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h3>Common misconceptions</h3>\\n      <ul style=\\\"color:var(--muted)\\\">\\n        <li>Therapy won’t immediately remove all distress — it creates tools and understanding to manage it better.</li>\\n        <li>Not every pattern needs long-term therapy; some benefits can be achieved through focused short-term work.</li>\\n      </ul>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule a consultation</a>\\n      <p style=\\\"color:var(--muted);margin-top:10px\\\">Location: {{CITY}}, {{STATE}}. Virtual care offered within licensure limits.</p>\\n    </section>\\n\\n    <footer>\\n      <p style=\\\"color:var(--muted)\\\">Privacy: Sessions are confidential. For emergencies call local emergency services. I will make referrals when clinical needs are outside my scope.</p>\\n      <p style=\\\"color:var(--muted)\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{PHONE}}</a></p>\\n    </footer>\\n  </div>\\n\\n  <!-- Decorative unique SVG (pattern) -->\\n  <svg class=\\\"pattern\\\" width=\\\"160\\\" height=\\\"160\\\" viewBox=\\\"0 0 100 100\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"p1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#9be7ff\\\" stop-opacity=\\\"0.6\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#7ae7c7\\\" stop-opacity=\\\"0.4\\\"/></linearGradient>\\n    </defs>\\n    <circle cx=\\\"20\\\" cy=\\\"20\\\" r=\\\"18\\\" fill=\\\"url(#p1)\\\" />\\n    <rect x=\\\"48\\\" y=\\\"48\\\" width=\\\"38\\\" height=\\\"38\\\" rx=\\\"6\\\" fill=\\\"#08333f\\\" />\\n  </svg>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>How I Work — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#ffffff;--ink:#08121a;--muted:#56646f;--accent:#ffb4a2}\\n    body{margin:0;font-family:Georgia, serif;background:var(--bg);color:var(--ink)}\\n    .frame{max-width:920px;margin:40px auto;padding:32px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:16px;color:var(--muted);text-decoration:none}\\n    .hero{display:flex;gap:28px;align-items:center;margin-top:18px}\\n    .hero h1{font-size:40px;margin:0}\\n    .process{margin-top:18px;background:#f7fbff;padding:18px;border-radius:10px}\\n    .steps{display:flex;gap:12px;margin-top:12px}\\n    .step{flex:1;padding:12px;background:white;border-radius:8px;border:1px solid #e6eef5}\\n    .programs{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:18px}\\n    .program{background:#fff7f5;border-radius:10px;padding:14px;border:1px solid #ffe8df}\\n    .faq{margin-top:18px}\\n    .cta{display:inline-block;margin-top:14px;background:var(--accent);padding:10px 14px;border-radius:8px;color:#2b1a16;text-decoration:none;font-weight:700}\\n    footer{margin-top:26px;color:var(--muted);font-size:13px}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"frame\\\">\\n    <header>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"specialties.html\\\">Services</a>\\n        <a href=\\\"fees.html\\\">Fees</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>My practical, transparent process</h1>\\n        <p style=\\\"color:var(--muted);margin-top:8px\\\">I orient therapy around clear questions we test together: what keeps the problem in place, which small changes shift it, and how we sustain gains. Below is how a typical engagement unfolds.</p>\\n\\n        <div class=\\\"process\\\" aria-labelledby=\\\"process-title\\\">\\n          <h3 id=\\\"process-title\\\" style=\\\"margin:0 0 8px\\\">Session flow</h3>\\n          <div class=\\\"steps\\\">\\n            <div class=\\\"step\\\">\\n              <strong>1 • Intake & formulation</strong>\\n              <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">A thorough intake to map history, current stressors, and concrete goals.</p>\\n            </div>\\n            <div class=\\\"step\\\">\\n              <strong>2 • Collaborative plan</strong>\\n              <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">We co-design a plan with measurable targets and between-session tasks.</p>\\n            </div>\\n            <div class=\\\"step\\\">\\n              <strong>3 • Review & adjust</strong>\\n              <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Regular review of progress and adjustments when needed.</p>\\n            </div>\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n      <aside style=\\\"width:260px\\\">\\n        <div style=\\\"background:#fff7f0;padding:14px;border-radius:10px;border:1px solid #ffe2d0\\\">\\n          <strong>{{THERAPIST_NAME}}</strong>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">{{LICENSE}} — {{MODALITIES}}</div>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:block;text-align:center;margin-top:12px\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px;padding:10px;background:#f4fbff;border-radius:8px;border:1px solid #e1f5fb;color:var(--muted)\\\">\\n          <strong>Availability</strong>\\n          <div style=\\\"margin-top:6px\\\">Accepting new clients in {{CITY}}, {{STATE}} and virtual within licensing constraints.</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h2>Programs & membership options</h2>\\n      <p style=\\\"color:var(--muted);margin-top:6px\\\">Different needs call for different structures. Below are three common pathways; we will choose one according to goals and feasibility.</p>\\n\\n      <div class=\\\"programs\\\">\\n        <div class=\\\"program\\\">\\n          <strong>Focused Path (8 sessions)</strong>\\n          <p style=\\\"color:var(--muted);margin-top:8px\\\">Targets a specific problem with measurable steps and between-session experiments. Ideal for skill acquisition and behavioral change.</p>\\n          <p style=\\\"margin-top:8px;color:var(--muted)\\\"><em>Pricing framed as a package</em></p>\\n        </div>\\n        <div class=\\\"program\\\">\\n          <strong>Deep Work (open-ended)</strong>\\n          <p style=\\\"color:var(--muted);margin-top:8px\\\">For complex patterns and relational work. Regular review points to ensure continued benefit.</p>\\n          <p style=\\\"margin-top:8px;color:var(--muted)\\\"><em>Monthly membership available for ongoing care</em></p>\\n        </div>\\n        <div class=\\\"program\\\">\\n          <strong>Check-In Plan</strong>\\n          <p style=\\\"color:var(--muted);margin-top:8px\\\">Short, periodic sessions to maintain gains after concluding intensive work — a lower-intensity option.</p>\\n          <p style=\\\"margin-top:8px;color:var(--muted)\\\"><em>Subscription-style billing offered</em></p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h3>Why measurement matters</h3>\\n      <p style=\\\"color:var(--muted)\\\">We set small, observable targets (e.g., number of social engagements, sleep hours) so progress is trackable. This helps us decide whether an approach is helping and when to pivot.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"faq\\\">\\n      <h3>Frequently asked</h3>\\n      <div style=\\\"margin-top:8px;color:var(--muted)\\\">\\n        <strong>Do you take insurance?</strong>\\n        <p style=\\\"margin:6px 0 10px\\\">I provide superbills for out-of-network reimbursement; please contact for details.</p>\\n\\n        <strong>How quickly can I start?</strong>\\n        <p style=\\\"margin:6px 0 10px\\\">Typical wait varies; I prioritize urgent needs and can often offer a brief consultation within 1–3 weeks.</p>\\n\\n        <strong>How is telehealth handled?</strong>\\n        <p style=\\\"margin:6px 0 0\\\">Telehealth sessions use secure platforms; informed consent and privacy practices will be reviewed at intake.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h3>Core boundaries & safety</h3>\\n      <p style=\\\"color:var(--muted)\\\">I keep clear boundaries around communication (email for scheduling, not clinical emergencies). Confidentiality is maintained except in legal/urgent safety situations. I will discuss limits of confidentiality and answer any questions before starting.</p>\\n      <p style=\\\"color:var(--muted);margin-top:8px\\\">If you are in crisis, contact local emergency services immediately; I do not provide emergency care by email/text.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Request an intake</a>\\n    </section>\\n\\n    <footer>\\n      <p style=\\\"color:var(--muted);margin-top:18px\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--ink)\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--ink)\\\">{{PHONE}}</a></p>\\n      <p style=\\\"color:var(--muted)\\\">I will discuss referrals when needs are outside my scope of practice. Records are stored securely in accordance with professional standards.</p>\\n    </footer>\\n  </div>\\n\\n  <!-- Unique decorative SVG for approach page -->\\n  <svg width=\\\"0\\\" height=\\\"0\\\" style=\\\"position:absolute;left:-9999px\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <symbol id=\\\"approach-pattern\\\" viewBox=\\\"0 0 100 100\\\">\\n      <circle cx=\\\"10\\\" cy=\\\"10\\\" r=\\\"8\\\" fill=\\\"#ffb4a2\\\" />\\n      <rect x=\\\"38\\\" y=\\\"38\\\" width=\\\"24\\\" height=\\\"24\\\" fill=\\\"#ffd6cc\\\" />\\n      <path d=\\\"M2 98c22-18 56-22 96-8\\\" stroke=\\\"#ffe6de\\\" stroke-width=\\\"2\\\" fill=\\\"none\\\"/>\\n    </symbol>\\n  </svg>\\n</body>\\n</html>\"} \nBUNDLE_END"
