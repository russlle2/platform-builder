          "text": "BUNDLE_START\n{\"path\":\"fees.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Rates & Options — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#6b5b95;--muted:#6c6f72;--bg:#f7f7fb;--card:#ffffff}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#222}\\n    header{background:linear-gradient(180deg,rgba(107,91,149,0.08),transparent);padding:18px 24px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:46px;height:46px;background:var(--accent);border-radius:8px;display:grid;place-items:center;color:#fff;font-weight:700}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .hero{padding:36px 24px;background-image:url('assets/img/pattern.svg');background-size:320px;background-repeat:repeat;display:flex;gap:24px;align-items:center}\\n    .hero h1{margin:0;font-size:22px;color:var(--accent)}\\n    .hero p{margin:6px 0 0;color:var(--muted)}\\n    main{padding:24px;display:grid;gap:20px;max-width:980px;margin:0 auto}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:20px}\\n    .card{background:var(--card);border-radius:12px;padding:18px;box-shadow:0 6px 18px rgba(25,25,30,0.04)}\\n    .price{font-size:20px;font-weight:700;color:var(--accent)}\\n    .list{margin:12px 0 0;padding:0;list-style:none}\\n    .list li{padding:10px 0;border-top:1px dashed #eee;color:var(--muted)}\\n    .badge-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}\\n    .badge{background:#f1f5ff;border-radius:6px;padding:6px 8px;font-size:13px;color:var(--accent);cursor:default;position:relative}\\n    .badge[data-tip]:hover::after{content:attr(data-tip);position:absolute;left:50%;transform:translateX(-50%);bottom:calc(100% + 8px);white-space:nowrap;background:#111;color:#fff;padding:6px 8px;border-radius:6px;font-size:12px}\\n    .cta{display:inline-block;margin-top:12px;background:var(--accent);color:#fff;padding:10px 14px;border-radius:8px;text-decoration:none}\\n    .small{font-size:13px;color:var(--muted)}\\n    .testimony{min-height:74px;display:flex;align-items:center;gap:12px}\\n    .testimony p{margin:0;color:#333}\\n    footer{padding:18px 24px;color:var(--muted);font-size:13px;text-align:center}\\n    /* accordion */\\n    .accordion{margin-top:12px}\\n    .acc-item{border-top:1px solid #eee}\\n    .acc-btn{width:100%;padding:12px;background:none;border:0;text-align:left;font-weight:600;display:flex;justify-content:space-between;align-items:center;cursor:pointer}\\n    .acc-panel{padding:12px 12px 18px;display:none;color:var(--muted);font-size:14px}\\n    .show{display:block}\\n    .crisis{margin-top:14px;background:#fff6f6;border-left:4px solid #e65;padding:12px;border-radius:8px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">TP</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Intro</a>\\n      <a href=\\\"about.html\\\">Why I Work</a>\\n      <a href=\\\"specialties.html\\\">Focus Areas</a>\\n      <a href=\\\"approach.html\\\">Method</a>\\n      <a href=\\\"fees.html\\\">Rates</a>\\n      <a href=\\\"faq.html\\\">Questions</a>\\n      <a href=\\\"book.html\\\">Schedule</a>\\n      <a href=\\\"contact.html\\\">Reach</a>\\n    </nav>\\n  </header>\\n\\n  <section class=\\\"hero\\\">\\n    <div>\\n      <h1>Rates & Session Options</h1>\\n      <p>I offer clear, flexible ways to work together—book single sessions, commit to a short course, or add lightweight follow-up support.</p>\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </div>\\n    <div style=\\\"margin-left:auto;text-align:right\\\">\\n      <div class=\\\"small\\\">Phone: {{PHONE}}</div>\\n      <div class=\\\"small\\\">Email: {{EMAIL}}</div>\\n      <div class=\\\"small\\\">Serving {{CITY}}, {{STATE}}</div>\\n    </div>\\n  </section>\\n\\n  <main>\\n    <div class=\\\"grid\\\">\\n      <div>\\n        <div class=\\\"card\\\">\\n          <h3>Single Session — get oriented</h3>\\n          <div class=\\\"price\\\">$160</div>\\n          <p class=\\\"small\\\">A focused 50-minute session for problem-solving, safety planning, or an initial assessment.</p>\\n          <ul class=\\\"list\\\">\\n            <li>50-minute clinical session</li>\\n            <li>Email summary with care suggestions</li>\\n            <li>Self-help resources when helpful</li>\\n          </ul>\\n          <a class=\\\"cta\\\" href=\\\"book.html?type=single\\\">Book a single session</a>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h3>Therapeutic Short Course — steady progress</h3>\\n          <div class=\\\"price\\\">$900 (6 sessions)</div>\\n          <p class=\\\"small\\\">A time-limited set of sessions designed around a clear goal you and I define together.</p>\\n          <ul class=\\\"list\\\">\\n            <li>Six 50-minute sessions</li>\\n            <li>Structured goals and short homework</li>\\n            <li>Summary & next-step plan</li>\\n          </ul>\\n          <a class=\\\"cta\\\" href=\\\"book.html?type=shortcourse\\\">Reserve a short course</a>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h3>Care Continuity Add-on — lightweight support</h3>\\n          <div class=\\\"price\\\">$120 / month</div>\\n          <p class=\\\"small\\\">Monthly check-ins (25-min) and prioritized scheduling between sessions for people who want a touchpoint without weekly therapy.</p>\\n          <ul class=\\\"list\\\">\\n            <li>Monthly 25-minute check-ins</li>\\n            <li>Priority scheduling and brief messages</li>\\n            <li>Cancel anytime</li>\\n          </ul>\\n          <a class=\\\"cta\\\" href=\\\"book.html?type=addon\\\">Add continuity support</a>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4>Proof Gallery</h4>\\n          <div id=\\\"testimonial\\\" class=\\\"testimony\\\">\\n            <svg width=\\\"44\\\" height=\\\"44\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"11\\\" stroke=\\\"#e6e6ea\\\" stroke-width=\\\"2\\\"/><text x=\\\"12\\\" y=\\\"16\\\" text-anchor=\\\"middle\\\" font-size=\\\"10\\\" fill=\\\"#6b5b95\\\" font-family=\\\"sans-serif\\\">A</text></svg>\\n            <div>\\n              <p id=\\\"testimonialText\\\">\\\"Helpful, steady guidance that helped me make manageable changes.\\\"</p>\\n              <div class=\\\"small\\\" id=\\\"testimonialAuthor\\\">— Local client</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"badge-row\\\" style=\\\"margin-top:12px\\\">\\n            <div class=\\\"badge\\\" data-tip=\\\"Licensed clinician, state board verified\\\">LCSW</div>\\n            <div class=\\\"badge\\\" data-tip=\\\"Years of training in evidence-informed approaches\\\">Training</div>\\n            <div class=\\\"badge\\\" data-tip=\\\"Confidential sessions; HIPAA-aligned practice\\\">Confidential</div>\\n            <div class=\\\"badge\\\" data-tip=\\\"Available for select consults and workshops\\\">Consults</div>\\n          </div>\\n\\n          <div style=\\\"display:flex;gap:8px;margin-top:12px\\\">\\n            <button id=\\\"prev\\\" class=\\\"cta\\\" style=\\\"background:#fff;color:var(--accent);border:1px solid #eee\\\">Prev</button>\\n            <button id=\\\"next\\\" class=\\\"cta\\\">Next</button>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h4>Session boundaries & confidentiality</h4>\\n          <div class=\\\"accordion\\\">\\n            <div class=\\\"acc-item\\\">\\n              <button class=\\\"acc-btn\\\">Typical session flow <span aria-hidden>▸</span></button>\\n              <div class=\\\"acc-panel\\\">I structure most 50-minute sessions with check-in, focused work, and a short planning segment. We track measurable steps when helpful.</div>\\n            </div>\\n            <div class=\\\"acc-item\\\">\\n              <button class=\\\"acc-btn\\\">Confidentiality & limits <span aria-hidden>▸</span></button>\\n              <div class=\\\"acc-panel\\\">Sessions are confidential. I will share information only with your permission, except where required by law (e.g., imminent safety risk). We can discuss limits to confidentiality at intake.</div>\\n            </div>\\n            <div class=\\\"acc-item\\\">\\n              <button class=\\\"acc-btn\\\">Cancellations & payment <span aria-hidden>▸</span></button>\\n              <div class=\\\"acc-panel\\\">I request 48 hours notice for cancellations. Fees apply for late cancellations or missed appointments unless we agree otherwise for exceptional circumstances.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"crisis\\\" role=\\\"note\\\">\\n            If you are in immediate danger or experiencing a medical emergency, call local emergency services right now. For urgent mental health crises, use your local crisis line or call the national hotline if available.\\n            <div style=\\\"margin-top:8px;font-weight:700\\\">If it's not an emergency but you need quicker help, call: {{PHONE}}</div>\\n          </div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <div class=\\\"card\\\" style=\\\"text-align:center\\\">\\n      <h4>Payment & insurance</h4>\\n      <p class=\\\"small\\\">I accept private pay and can provide a receipt for out-of-network reimbursement. I do not bill insurance directly. We can talk about options during the first appointment.</p>\\n    </div>\\n\\n  </main>\\n\\n  <footer>\\n    &copy; <span id=\\\"year\\\"></span> {{BUSINESS_NAME}} — <a href=\\\"contact.html\\\">Contact</a>\\n  </footer>\\n\\n  <script>\\n    document.getElementById('year').textContent = new Date().getFullYear();\\n\\n    // Rotating testimonials\\n    const testimonials = [\\n      {text: 'Working with this clinician felt collaborative — I left sessions with small, useful experiments.', author: '— J.'},\\n      {text: 'Clear summaries and practical steps helped me manage an overwhelming phase.', author: '— S.'},\\n      {text: 'I appreciated the balance of empathy and structure; we made steady progress.', author: '— M.'}\\n    ];\\n    let idx = 0;\\n    const txtEl = document.getElementById('testimonialText');\\n    const authEl = document.getElementById('testimonialAuthor');\\n    function showTest(i){ txtEl.textContent = '\\\"' + testimonials[i].text + '\\\"'; authEl.textContent = testimonials[i].author; }\\n    document.getElementById('next').addEventListener('click',()=>{ idx=(idx+1)%testimonials.length; showTest(idx); });\\n    document.getElementById('prev').addEventListener('click',()=>{ idx=(idx-1+testimonials.length)%testimonials.length; showTest(idx); });\\n    setInterval(()=>{ idx=(idx+1)%testimonials.length; showTest(idx); },7000);\\n\\n    // Accordion\\n    document.querySelectorAll('.acc-btn').forEach(btn=>{\\n      btn.addEventListener('click',()=>{\\n        const panel = btn.nextElementSibling;\\n        panel.classList.toggle('show');\\n      });\\n    });\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>FAQ — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#2b8a78;--muted:#5d6568;--bg:#fbfcfd;--card:#fff}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#222;background:var(--bg)}\\n    header{padding:16px 20px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #eee}\\n    header .logo{width:44px;height:44px;border-radius:8px;background:var(--accent);color:#fff;display:grid;place-items:center;font-weight:700}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .container{max-width:960px;margin:22px auto;padding:0 20px}\\n    .hero{background:#fff;padding:18px;border-radius:10px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 6px 18px rgba(10,10,10,0.03)}\\n    .hero h1{margin:0;color:var(--accent);font-size:20px}\\n    .hero p{margin:6px 0 0;color:var(--muted)}\\n    .layout{display:grid;grid-template-columns:1fr 340px;gap:18px;margin-top:18px}\\n    .card{background:var(--card);padding:16px;border-radius:10px}\\n    .faq-list{list-style:none;padding:0;margin:0}\\n    .faq-item{border-top:1px solid #eee}\\n    .q{padding:12px 10px;margin:0;cursor:pointer;font-weight:600}\\n    .a{padding:12px 10px;border-top:1px dashed #f0f0f0;color:var(--muted);display:none}\\n    .show{display:block}\\n    .proof{display:flex;flex-direction:column;gap:12px}\\n    .badge{background:#f0f7f3;color:var(--accent);padding:8px;border-radius:8px;font-weight:600}\\n    .small{font-size:13px;color:var(--muted)}\\n    .book-btn{display:inline-block;margin-top:10px;background:var(--accent);color:#fff;padding:10px 12px;border-radius:8px;text-decoration:none}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">TP</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Intro</a>\\n      <a href=\\\"about.html\\\">Why I Work</a>\\n      <a href=\\\"specialties.html\\\">Focus Areas</a>\\n      <a href=\\\"approach.html\\\">Method</a>\\n      <a href=\\\"fees.html\\\">Rates</a>\\n      <a href=\\\"faq.html\\\">Questions</a>\\n      <a href=\\\"book.html\\\">Schedule</a>\\n      <a href=\\\"contact.html\\\">Reach</a>\\n    </nav>\\n  </header>\\n\\n  <div class=\\\"container\\\">\\n    <div class=\\\"hero\\\">\\n      <div>\\n        <h1>Questions people often ask</h1>\\n        <p class=\\\"small\\\">Concise answers about how I work, boundaries, and what to expect from therapy.</p>\\n      </div>\\n      <div style=\\\"text-align:right\\\">\\n        <div class=\\\"small\\\">{{CITY}}, {{STATE}}</div>\\n        <a class=\\\"book-btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"layout\\\">\\n      <div>\\n        <div class=\\\"card\\\">\\n          <ul class=\\\"faq-list\\\">\\n            <li class=\\\"faq-item\\\">\\n              <div class=\\\"q\\\">How long will I be in therapy?</div>\\n              <div class=\\\"a\\\">There is no set length—for some people a brief, goal-focused series of sessions is right; for others, open-ended work feels better. We will discuss estimated length and review progress regularly.</div>\\n            </li>\\n            <li class=\\\"faq-item\\\">\\n              <div class=\\\"q\\\">Do you accept insurance?</div>\\n              <div class=\\\"a\\\">I operate on a private-pay basis and can provide a receipt for out-of-network reimbursement. We can discuss billing during intake.</div>\\n            </li>\\n            <li class=\\\"faq-item\\\">\\n              <div class=\\\"q\\\">What if I need help between sessions?</div>\\n              <div class=\\\"a\\\">For short, non-urgent questions, the Care Continuity Add-on or brief secure messages may help. For urgent concerns, please follow crisis resources below.</div>\\n            </li>\\n            <li class=\\\"faq-item\\\">\\n              <div class=\\\"q\\\">How do you approach therapy?</div>\\n              <div class=\\\"a\\\">I blend evidence-informed techniques with practical planning, tailoring the approach to the issue at hand and your preferences.</div>\\n            </li>\\n            <li class=\\\"faq-item\\\">\\n              <div class=\\\"q\\\">Can I switch providers later?</div>\\n              <div class=\\\"a\\\">Yes. If you decide to transition, I can offer a summary and transfer notes with your consent.</div>\\n            </li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h4 style=\\\"margin-top:0\\\">Session boundaries & confidentiality</h4>\\n          <div class=\\\"small\\\">Below are clarifying points many clients find helpful. Click to expand each topic.</div>\\n          <div class=\\\"accordion\\\" style=\\\"margin-top:10px\\\">\\n            <div class=\\\"acc-item\\\">\\n              <div class=\\\"q\\\" data-acc>What I keep private</div>\\n              <div class=\\\"a\\\">Notes and communications are treated with confidentiality. I will only disclose information with your permission or when ethically or legally required (e.g., safety concerns).</div>\\n            </div>\\n            <div class=\\\"acc-item\\\">\\n              <div class=\\\"q\\\" data-acc>Recording & telehealth</div>\\n              <div class=\\\"a\\\">Sessions are not recorded without explicit consent. For telehealth, choose a private space and let me know if you have privacy questions.</div>\\n            </div>\\n            <div class=\\\"acc-item\\\">\\n              <div class=\\\"q\\\" data-acc>Emergency guidance</div>\\n              <div class=\\\"a\\\">I am not a 24/7 crisis service. If you are in immediate danger, call local emergency services. See the crisis footer for resources.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"crisis\\\" style=\\\"margin-top:12px;padding:10px;background:#fff7f0;border-left:4px solid #ff7a5a;border-radius:8px\\\">\\n            If you are in immediate risk of harm or medical danger, contact emergency services now. For urgent mental health crises, use your local crisis line or national resources if available.\\n            <div style=\\\"margin-top:8px;font-weight:700\\\">Emergency contact: {{PHONE}}</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card proof\\\">\\n          <h4 style=\\\"margin:0\\\">Proof Gallery</h4>\\n          <div id=\\\"mini-test\\\" style=\\\"padding-top:8px\\\">\\\"Thoughtful, realistic support when life felt scattered.\\\" — K.</div>\\n\\n          <div style=\\\"margin-top:10px;display:flex;gap:8px;flex-wrap:wrap\\\">\\n            <div class=\\\"badge\\\" data-tip=\\\"State licensure verified\\\">Licensed</div>\\n            <div class=\\\"badge\\\" data-tip=\\\"Formal training in trauma-informed care\\\">Trauma-Informed</div>\\n            <div class=\\\"badge\\\" data-tip=\\\"Confidential clinical notes and secure scheduling\\\">Private</div>\\n          </div>\\n\\n          <a href=\\\"book.html\\\" class=\\\"book-btn\\\">Schedule a time</a>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0\\\">Can I ask a question before booking?</h4>\\n          <p class=\\\"small\\\">Yes—email me at {{EMAIL}} or use the contact page. I can answer brief queries about fit and logistics before an appointment.</p>\\n        </div>\\n      </aside>\\n    </div>\\n\\n  </div>\\n\\n  <script>\\n    // FAQ toggles\\n    document.querySelectorAll('[data-acc], .faq-item .q').forEach(q=>{\\n      q.addEventListener('click', ()=>{\\n        const a = q.nextElementSibling || q.parentElement.querySelector('.a');\\n        if(a) a.classList.toggle('show');\\n      });\\n    });\\n\\n    // Small rotating proof for aside\\n    const mini = document.getElementById('mini-test');\\n    const miniPool = [\\n      '\\\"Small steps that fit my week — very practical.\\\" — R.',\\n      '\\\"A steady, quiet presence during a busy season.\\\" — A.',\\n      '\\\"Helpful structure without pressure to be fixed.\\\" — L.'\\n    ];\\n    let mi=0;\\n    setInterval(()=>{ mi=(mi+1)%miniPool.length; mini.textContent = miniPool[mi]; },6000);\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Schedule — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#b03a2e;--muted:#555;--bg:#fffdfa}\\n    body{margin:0;font-family:Georgia,serif;color:#222;background:var(--bg)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid #f0e9e8}\\n    nav a{margin-left:10px;text-decoration:none;color:var(--muted)}\\n    .container{max-width:900px;margin:20px auto;padding:0 18px}\\n    .wrap{display:grid;grid-template-columns:1fr 340px;gap:18px}\\n    .card{background:#fff;padding:16px;border-radius:10px;box-shadow:0 6px 18px rgba(0,0,0,0.03)}\\n    label{display:block;margin-top:10px;font-weight:700}\\n    input[type=text],input[type=email],select,textarea{width:100%;padding:10px;margin-top:6px;border:1px solid #eee;border-radius:8px}\\n    .submit{background:var(--accent);color:#fff;padding:10px 12px;border-radius:8px;border:0;margin-top:12px;cursor:pointer}\\n    .summary{font-size:14px;color:var(--muted)}\\n    .small{font-size:13px;color:var(--muted)}\\n    .test-row{display:flex;gap:10px;align-items:center;margin-top:12px}\\n    .testimonial{background:#fff6f4;border-left:4px solid #ffb3a7;padding:10px;border-radius:8px}\\n    .acc{margin-top:12px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div style=\\\"width:44px;height:44px;background:var(--accent);color:#fff;border-radius:8px;display:grid;place-items:center;font-weight:700\\\">TP</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Intro</a>\\n      <a href=\\\"about.html\\\">Why I Work</a>\\n      <a href=\\\"specialties.html\\\">Focus Areas</a>\\n      <a href=\\\"approach.html\\\">Method</a>\\n      <a href=\\\"fees.html\\\">Rates</a>\\n      <a href=\\\"faq.html\\\">Questions</a>\\n      <a href=\\\"book.html\\\">Schedule</a>\\n      <a href=\\\"contact.html\\\">Reach</a>\\n    </nav>\\n  </header>\\n\\n  <div class=\\\"container\\\">\\n    <div class=\\\"wrap\\\">\\n      <div>\\n        <div class=\\\"card\\\">\\n          <h2 style=\\\"margin-top:0\\\">Request an appointment</h2>\\n          <p class=\\\"summary\\\">Choose a session type and tell me a little about what brought you here. I will follow up by email to confirm time and next steps.</p>\\n\\n          <form id=\\\"bookingForm\\\">\\n            <label for=\\\"name\\\">Full name</label>\\n            <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" required>\\n\\n            <label for=\\\"email\\\">Email</label>\\n            <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required>\\n\\n            <label for=\\\"type\\\">Session type</label>\\n            <select id=\\\"type\\\" name=\\\"type\\\">\\n              <option value=\\\"single\\\">Single Session — 50 minutes</option>\\n              <option value=\\\"shortcourse\\\">Therapeutic Short Course — 6 sessions</option>\\n              <option value=\\\"addon\\\">Care Continuity Add-on — monthly</option>\\n            </select>\\n\\n            <label for=\\\"notes\\\">Brief note (what would you like to work on?)</label>\\n            <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\"></textarea>\\n\\n            <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n              <button class=\\\"submit\\\" type=\\\"submit\\\">Request time</button>\\n              <div class=\\\"small\\\">You will receive a confirmation and next steps by email.</div>\\n            </div>\\n          </form>\\n\\n          <div class=\\\"acc\\\">\\n            <h4 style=\\\"margin-bottom:8px\\\">Session boundaries & confidentiality</h4>\\n            <details>\\n              <summary style=\\\"font-weight:700;cursor:pointer\\\">What to expect about privacy</summary>\\n              <p style=\\\"margin:8px 0 0;color:var(--muted)\\\">Communications and notes are treated confidentially. I will talk with you about limits to confidentiality during intake—these are typically situations involving risk of harm or legal requirements.</p>\\n            </details>\\n            <details style=\\\"margin-top:8px\\\">\\n              <summary style=\\\"font-weight:700;cursor:pointer\\\">If you need urgent help</summary>\\n              <p style=\\\"margin:8px 0 0;color:var(--muted)\\\">If you are in immediate danger, call emergency services. For urgent mental health crises, contact your local crisis hotline or national resources where available.</p>\\n            </details>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h4 style=\\\"margin-top:0\\\">Quick fees summary</h4>\\n          <div class=\\\"small\\\">Single session: $160 • Short course (6): $900 • Continuity add-on: $120/month</div>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0\\\">Proof Gallery</h4>\\n          <div class=\\\"test-row\\\">\\n            <div style=\\\"width:56px;height:56px;border-radius:10px;background:linear-gradient(135deg,#ffd8d0,#fff)\\\" aria-hidden></div>\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Client feedback on short courses</div>\\n              <div class=\\\"small\\\" id=\\\"bookingTest\\\">\\\"Concrete tools that fit my life.\\\" — P.</div>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px;display:flex;gap:8px;flex-wrap:wrap\\\">\\n            <div class=\\\"small\\\" style=\\\"background:#fff6f8;padding:8px;border-radius:8px;color:var(--accent)\\\" data-tip=\\\"Verified training\\\">Licensed</div>\\n            <div class=\\\"small\\\" style=\\\"background:#f3fff7;padding:8px;border-radius:8px;color:#2b8a78\\\" data-tip=\\\"Clinical specialties\\\">Trauma & Life Transitions</div>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <a href=\\\"fees.html\\\" style=\\\"text-decoration:none;color:var(--accent);font-weight:700\\\">View rates & options</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h4 style=\\\"margin-top:0\\\">Need to ask first?</h4>\\n          <p class=\\\"small\\\">Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> — I'll answer brief queries about fit and logistics before booking.</p>\\n        </div>\\n      </aside>\\n    </div>\\n  </div>\\n\\n  <script>\\n    // Simple local booking handler\\n    const form = document.getElementById('bookingForm');\\n    form.addEventListener('submit', (e)=>{\\n      e.preventDefault();\\n      const data = new FormData(form);\\n      const summary = Array.from(data.entries()).map(([k,v])=>`${k}: ${v}`).join('\\\\n');\\n      // Simulate sending and show friendly confirmation\\n      alert('Request sent. I will follow up by email.\\\\n\\\\n' + summary);\\n      form.reset();\\n    });\\n\\n    // Tiny rotating testimonial on aside\\n    const pool = [\\n      '\\\"Concrete tools that fit my week.\\\" — P.',\\n      '\\\"The short course gave structure while staying flexible.\\\" — G.',\\n      '\\\"Follow-up check-ins kept me on track.\\\" — H.'\\n    ];\\n    let i = 0; const el = document.getElementById('bookingTest');\\n    setInterval(()=>{ i=(i+1)%pool.length; el.textContent = pool[i]; },5000);\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
