          "text": "BUNDLE_START\n{\"path\":\"fees.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Rates & Programs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--ink:#0b1320;--muted:#6b7280;--accent:#ff6b6b;--accent-2:#3b82f6;--card:#fff8f8}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:var(--ink);background:linear-gradient(180deg,#fff 0%,#fffefc 100%)}\\n    .container{max-width:980px;margin:40px auto;padding:28px}\\n    nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}\\n    .brand{font-weight:700;letter-spacing:0.4px}\\n    .nav-links{display:flex;gap:14px}\\n    a{color:var(--ink);text-decoration:none}\\n    header.hero{display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:center;margin-bottom:30px}\\n    .hero-card{background:linear-gradient(180deg,rgba(255,107,107,0.06),transparent);padding:22px;border-radius:12px;box-shadow:0 6px 20px rgba(59,130,246,0.06)}\\n    h1{font-size:28px;margin:0 0 8px}\\n    p.lead{color:var(--muted);margin:0 0 14px}\\n    .price-grid{display:flex;flex-direction:column;gap:12px}\\n    .plan{display:flex;justify-content:space-between;align-items:center;padding:14px;border-radius:10px;background:linear-gradient(90deg,rgba(59,130,246,0.04),transparent);border:1px solid rgba(11,19,32,0.04)}\\n    .plan strong{display:block;font-size:16px}\\n    .muted{color:var(--muted);font-size:13px}\\n    .cta{display:inline-block;padding:10px 16px;border-radius:10px;background:var(--accent);color:#fff;font-weight:600;text-decoration:none}\\n    section{margin:26px 0;padding:18px;border-radius:12px}\\n    .values{background:#fffaf9;border:1px solid rgba(255,107,107,0.06)}\\n    .methods{background:#f8fbff;border:1px solid rgba(59,130,246,0.06)}\\n    .objections{background:#fffdf7;border:1px solid rgba(249,115,22,0.06)}\\n    .testimonials{background:linear-gradient(90deg,#f7fff4,transparent);border:1px solid rgba(34,197,94,0.04)}\\n    .lead-magnet{display:flex;gap:12px;align-items:center;background:#eef2ff;border:1px solid rgba(59,130,246,0.06)}\\n    footer{font-size:13px;color:var(--muted);margin-top:28px}\\n    .small{font-size:13px;color:var(--muted)}\\n    /* playful accents */\\n    .badge{background:var(--accent-2);color:#fff;padding:6px 10px;border-radius:999px;font-weight:700}\\n    svg{max-width:100%}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <nav>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"nav-links\\\"><a href=\\\"index.html\\\">Home</a><a href=\\\"about.html\\\">About</a><a href=\\\"specialties.html\\\">Specialties</a><a href=\\\"fees.html\\\" style=\\\"font-weight:700\\\">Rates</a><a href=\\\"book.html\\\">Book</a></div>\\n    </nav>\\n\\n    <header class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <div class=\\\"badge\\\">Rates & Options</div>\\n        <h1>Clear pricing with flexible paths to care</h1>\\n        <p class=\\\"lead\\\">I partner with adults navigating anxiety, relationship shifts, burnout, and life transitions. Below are transparent options so you can choose what fits your life and goals.</p>\\n        <div class=\\\"price-grid\\\" aria-hidden=\\\"false\\\">\\n          <div class=\\\"plan\\\">\\n            <div>\\n              <strong>Foundations — Single Session</strong>\\n              <div class=\\\"muted\\\">45–55 minutes. Short-term needs, planning, urgent work.</div>\\n            </div>\\n            <div style=\\\"text-align:right\\\">\\n              <div style=\\\"font-weight:800\\\">${{PRICE_SESSION}}*</div>\\n              <div class=\\\"muted\\\">Pay per visit</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"plan\\\">\\n            <div>\\n              <strong>Momentum — 6-Session Focus</strong>\\n              <div class=\\\"muted\\\">A structured, short-term program for a clear next step.</div>\\n            </div>\\n            <div style=\\\"text-align:right\\\">\\n              <div style=\\\"font-weight:800\\\">${{PRICE_PACKAGE}} total</div>\\n              <div class=\\\"muted\\\">Package saves time and keeps momentum</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"plan\\\">\\n            <div>\\n              <strong>Reset Intensive — 3-hour deep session</strong>\\n              <div class=\\\"muted\\\">Focused work for transitions or trauma stabilization planning.</div>\\n            </div>\\n            <div style=\\\"text-align:right\\\">\\n              <div style=\\\"font-weight:800\\\">${{PRICE_INTENSIVE}}</div>\\n              <div class=\\\"muted\\\">One-time investment</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <p class=\\\"small\\\" style=\\\"margin-top:12px\\\">I offer a limited number of sliding-scale spots. Insurance is not directly billed; superbills can be provided upon request.</p>\\n        <div style=\\\"margin-top:14px\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n      </div>\\n\\n      <div style=\\\"text-align:center\\\">\\n        <!-- unique SVG hero illustration -->\\n        <svg width=\\\"320\\\" height=\\\"240\\\" viewBox=\\\"0 0 320 240\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-labelledby=\\\"heroTitle\\\">\\n          <title id=\\\"heroTitle\\\">Warm geometric illustration</title>\\n          <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"320\\\" height=\\\"240\\\" rx=\\\"18\\\" fill=\\\"#fff8f8\\\" stroke=\\\"#ffecec\\\"/>\\n          <circle cx=\\\"60\\\" cy=\\\"60\\\" r=\\\"28\\\" fill=\\\"#ff6b6b\\\" opacity=\\\"0.15\\\"/>\\n          <rect x=\\\"110\\\" y=\\\"40\\\" width=\\\"140\\\" height=\\\"28\\\" rx=\\\"8\\\" fill=\\\"#3b82f6\\\" opacity=\\\"0.12\\\"/>\\n          <path d=\\\"M40 180c20-40 80-40 120-12s100 20 120-12\\\" stroke=\\\"#ffdede\\\" stroke-width=\\\"10\\\" fill=\\\"none\\\" opacity=\\\"0.2\\\"/>\\n          <g transform=\\\"translate(20,30)\\\">\\n            <rect x=\\\"0\\\" y=\\\"120\\\" width=\\\"60\\\" height=\\\"70\\\" rx=\\\"10\\\" fill=\\\"#fff\\\" stroke=\\\"#ffb4b4\\\"/>\\n            <rect x=\\\"70\\\" y=\\\"100\\\" width=\\\"140\\\" height=\\\"90\\\" rx=\\\"12\\\" fill=\\\"#fff\\\" stroke=\\\"#cfe3ff\\\"/>\\n          </g>\\n        </svg>\\n      </div>\\n    </header>\\n\\n    <section class=\\\"values\\\">\\n      <h2>How I work — core commitments</h2>\\n      <p class=\\\"muted\\\">I blend practical coaching-style clarity with evidence-informed psychotherapy. My commitments are simple: presence, directness, and collaboration.</p>\\n      <ul class=\\\"small\\\">\\n        <li>We set measurable, realistic goals together.</li>\\n        <li>I provide tailored tools—skills you can use between sessions.</li>\\n        <li>I protect your privacy and bring a nonjudgmental stance to each meeting.</li>\\n      </ul>\\n    </section>\\n\\n    <section class=\\\"methods\\\">\\n      <h2>Approach & Methods</h2>\\n      <p class=\\\"muted\\\">Sessions integrate brief cognitive-behavioral techniques, somatic regulation, and narrative work when helpful. Modalities: {{MODALITIES}}.</p>\\n      <div class=\\\"small\\\">Typical session structure: check-in (10m), focused skill work or processing (30m), plan & experiment (5–10m).</div>\\n    </section>\\n\\n    <section class=\\\"objections\\\">\\n      <h2>Common concerns and real answers</h2>\\n      <ul class=\\\"small\\\">\\n        <li><strong>\\\"I can’t afford regular therapy.\\\"</strong> I keep several sliding-scale openings and offer focused packages to concentrate work when resources are limited.</li>\\n        <li><strong>\\\"What if I don’t click with you?\\\"</strong> Feel free to try one session; if we’re not a fit, I’ll help you find someone better suited to your needs.</li>\\n        <li><strong>\\\"How long will this take?\\\"</strong> That depends on goals. Many clients see meaningful change within 6–12 sessions; others use therapy as ongoing support.</li>\\n      </ul>\\n    </section>\\n\\n    <section class=\\\"testimonials\\\">\\n      <h2>Client reflections</h2>\\n      <blockquote class=\\\"small\\\">\\\"I appreciated the straightforward, action-focused work. I left each week with something to try.\\\" — A, {{CITY}}</blockquote>\\n      <blockquote class=\\\"small\\\">\\\"We made safer space to talk about hard things; that steady pace helped me take risks in life outside therapy.\\\" — M, {{STATE}}</blockquote>\\n    </section>\\n\\n    <section class=\\\"lead-magnet\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h3 style=\\\"margin:0\\\">Free guide: 5 grounding moves you can do in 10 minutes</h3>\\n        <p class=\\\"muted\\\" style=\\\"margin:6px 0 0\\\">Downloadable PDF with brief exercises for moments of overwhelm.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Get the guide</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"padding:18px;border-radius:12px;background:#fff\\\">\\n      <h2>Next steps</h2>\\n      <p class=\\\"muted\\\">If you'd like to start, book a single session or reach out to discuss which option fits your need. I try to respond to messages within 48 hours on business days.</p>\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </section>\\n\\n    <footer>\\n      <div>{{THERAPIST_NAME}} • {{LICENSE}} • {{CITY}}, {{STATE}}</div>\\n      <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Confidentiality: Sessions are confidential except where disclosure is required by law (risk of harm to self or others, abuse). This site and communications are for scheduling and orientation; they are not a substitute for urgent care.</div>\\n      <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Crisis note: If you or someone is in immediate danger, call local emergency services or a crisis line. If you are in the U.S., dial 988 for the Suicide & Crisis Lifeline.</div>\\n      <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Scope & boundaries: I do not provide emergency services or forensic evaluations. If you require those services, I will refer you to appropriate local resources.</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Questions & Answers — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--ink:#071426;--muted:#6b7280;--accent:#ff6b6b;--accent-2:#f59e0b}\\n    body{margin:0;font-family:Inter,Arial,sans-serif;color:var(--ink);background:linear-gradient(180deg,#fff 0%,#fffdf9 100%)}\\n    .wrap{max-width:980px;margin:36px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav{display:flex;gap:14px}\\n    a{color:var(--ink);text-decoration:none}\\n    h1{margin:6px 0 0;font-size:26px}\\n    .intro{color:var(--muted);margin-top:6px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:18px}\\n    .faq-card{background:#fff;border-radius:12px;padding:18px;border:1px solid rgba(11,19,32,0.04)}\\n    .question{font-weight:700;margin:14px 0 6px}\\n    .answer{color:var(--muted);margin:0}\\n    .side{background:linear-gradient(90deg,#fff8f0,transparent);padding:16px;border-radius:12px}\\n    .cta{display:inline-block;padding:10px 14px;border-radius:12px;background:var(--accent);color:#fff;font-weight:700;text-decoration:none}\\n    footer{color:var(--muted);font-size:13px;margin-top:20px}\\n    svg{display:block;margin:0 auto}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"nav\\\"><a href=\\\"index.html\\\">Home</a><a href=\\\"about.html\\\">Who I Am</a><a href=\\\"specialties.html\\\">Paths</a><a href=\\\"approach.html\\\">How I Work</a><a href=\\\"fees.html\\\">Fees</a></div>\\n      </div>\\n      <div><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n    </header>\\n\\n    <main class=\\\"grid\\\">\\n      <div>\\n        <h1>Common questions, answered plainly</h1>\\n        <p class=\\\"intro\\\">Below are practical clarifications I share with people before their first visit. If something you wonder about isn’t here, please reach out.</p>\\n\\n        <div class=\\\"faq-card\\\">\\n          <div class=\\\"question\\\">How quickly can I get in for a first session?</div>\\n          <p class=\\\"answer\\\">Availability varies; I maintain a short waitlist for new clients and reserve a few slots for urgent needs. Email {{EMAIL}} or call {{PHONE}} and include a few times that generally work for you.</p>\\n\\n          <div class=\\\"question\\\">Do you accept insurance?</div>\\n          <p class=\\\"answer\\\">I do not bill insurance directly. Many clients use out-of-network benefits and I can provide a superbill. I also maintain a limited number of reduced-fee slots per month.</p>\\n\\n          <div class=\\\"question\\\">What modalities do you use in sessions?</div>\\n          <p class=\\\"answer\\\">I draw from cognitive-behavioral approaches, somatic regulation practices, and strengths-based coaching. Modalities: {{MODALITIES}}. We tailor work to your needs rather than follow a single manualized treatment.</p>\\n\\n          <div class=\\\"question\\\">How do you handle confidentiality and notes?</div>\\n          <p class=\\\"answer\\\">Notes are kept securely per professional standards. Confidentiality is protected except where disclosure is required by law (risk of harm, abuse). We can discuss how notes are used if you have concerns.</p>\\n\\n          <div class=\\\"question\\\">Can I switch to telehealth or in-person?</div>\\n          <p class=\\\"answer\\\">Yes. I offer both telehealth and limited in-person sessions depending on location and scheduling. We'll discuss what suits your goals and safety preferences.</p>\\n        </div>\\n\\n        <div class=\\\"faq-card\\\" style=\\\"margin-top:16px\\\">\\n          <div class=\\\"question\\\">What if I need crisis support?</div>\\n          <p class=\\\"answer\\\">I do not provide emergency services. If you are in immediate danger, call local emergency services. In the U.S. call 988 for the Suicide & Crisis Lifeline. For urgent needs between sessions, contact your local crisis resources.</p>\\n\\n          <div class=\\\"question\\\">How do we decide goals?</div>\\n          <p class=\\\"answer\\\">We co-create short-term and longer-term goals in early sessions. I prioritize concrete, measurable aims so you can see progress in repeatable ways.</p>\\n\\n          <div class=\\\"question\\\">What are your boundaries around communication?</div>\\n          <p class=\\\"answer\\\">I typically respond to messages during business hours (M–F). For non-urgent matters, allow up to 48 hours for a reply. If you anticipate frequent between-session contact, we’ll discuss expectations and limits in advance.</p>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"side\\\">\\n        <div style=\\\"text-align:center;margin-bottom:12px\\\">\\n          <!-- unique avatar SVG -->\\n          <svg width=\\\"180\\\" height=\\\"140\\\" viewBox=\\\"0 0 180 140\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-labelledby=\\\"av\\\">\\n            <title id=\\\"av\\\">Therapist avatar illustration</title>\\n            <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"180\\\" height=\\\"140\\\" rx=\\\"14\\\" fill=\\\"#fff\\\" stroke=\\\"#fff0f0\\\"/>\\n            <circle cx=\\\"90\\\" cy=\\\"46\\\" r=\\\"28\\\" fill=\\\"#ff6b6b\\\" opacity=\\\"0.12\\\"/>\\n            <rect x=\\\"46\\\" y=\\\"86\\\" width=\\\"88\\\" height=\\\"36\\\" rx=\\\"8\\\" fill=\\\"#fff\\\" stroke=\\\"#fcebea\\\"/>\\n            <path d=\\\"M64 112c8-6 28-6 44 0\\\" stroke=\\\"#ffdede\\\" stroke-width=\\\"6\\\" fill=\\\"none\\\" opacity=\\\"0.6\\\"/>\\n          </svg>\\n        </div>\\n        <div style=\\\"font-weight:700\\\">Need a short consult?</div>\\n        <p class=\\\"muted\\\">I offer a 20-minute inquiry call to see if we're a good fit. It's a low-pressure way to get your questions answered before committing to a session.</p>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule a consult</a></div>\\n      </aside>\\n    </main>\\n\\n    <section style=\\\"margin-top:20px;background:#fffaf2;padding:16px;border-radius:12px;border:1px solid rgba(245,158,11,0.06)\\\">\\n      <h3 style=\\\"margin:0\\\">A note on scope and ethics</h3>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">I practice within an outpatient, non-emergency setting. If your needs require higher-level care (e.g., hospitalization, forensic evaluation), I will help you find appropriate resources. Your privacy is prioritized in all communications.</p>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"margin-top:16px\\\">{{THERAPIST_NAME}} • {{LICENSE}} • {{CITY}}, {{STATE}} • <a href=\\\"contact.html\\\">Contact</a></div>\\n      <div style=\\\"margin-top:6px;color:var(--muted)\\\">Confidentiality & privacy: communications are private but not a substitute for crisis services. If you need emergency help, call local emergency services or 988 (U.S.).</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Start — Book a Session with {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--ink:#081123;--muted:#6b7280;--accent:#ff6b6b;--accent-2:#06b6d4}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:linear-gradient(180deg,#fff 0%,#fbfdff 100%);color:var(--ink)}\\n    .wrap{max-width:920px;margin:36px auto;padding:24px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav{display:flex;gap:12px}\\n    a{color:var(--ink);text-decoration:none}\\n    h1{font-size:28px;margin:8px 0}\\n    .grid{display:grid;grid-template-columns:1fr 340px;gap:20px;margin-top:20px}\\n    .panel{background:#fff;border-radius:12px;padding:18px;border:1px solid rgba(11,19,32,0.04)}\\n    label{display:block;margin:10px 0 6px;font-weight:700}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6e9ee}\\n    .btn{display:inline-block;padding:11px 16px;border-radius:12px;background:var(--accent);color:#fff;font-weight:700;text-decoration:none}\\n    .secondary{background:var(--accent-2);color:#04303b}\\n    .note{font-size:13px;color:var(--muted);margin-top:8px}\\n    footer{margin-top:24px;font-size:13px;color:var(--muted)}\\n    svg{display:block;margin:8px auto}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <nav class=\\\"nav\\\"><a href=\\\"index.html\\\">Home</a><a href=\\\"about.html\\\">About</a><a href=\\\"specialties.html\\\">Services</a><a href=\\\"approach.html\\\">Method</a><a href=\\\"faq.html\\\">FAQs</a></nav>\\n      </div>\\n      <div><a class=\\\"btn\\\" href=\\\"fees.html\\\">View rates</a></div>\\n    </header>\\n\\n    <main class=\\\"grid\\\">\\n      <div>\\n        <h1>Book a session</h1>\\n        <p class=\\\"note\\\">Choose the option that matches your current need. If you're unsure, select a single session and we can plan together.</p>\\n\\n        <section class=\\\"panel\\\">\\n          <h2 style=\\\"margin:0 0 8px\\\">Intake & Scheduling</h2>\\n          <p class=\\\"note\\\">Complete this form to request a time. I will respond within two business days to confirm availability and next steps.</p>\\n\\n          <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" aria-label=\\\"Booking form\\\">\\n            <label for=\\\"name\\\">Full name</label>\\n            <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"Your name\\\" required />\\n\\n            <label for=\\\"email\\\">Email</label>\\n            <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required />\\n\\n            <label for=\\\"phone\\\">Phone (optional)</label>\\n            <input id=\\\"phone\\\" name=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"Preferred contact number\\\" />\\n\\n            <label for=\\\"option\\\">Booking option</label>\\n            <select id=\\\"option\\\" name=\\\"option\\\">\\n              <option>Single Session — 50 min</option>\\n              <option>6-Session Momentum</option>\\n              <option>Reset Intensive — 3 hours</option>\\n              <option>20-min Inquiry Call</option>\\n            </select>\\n\\n            <label for=\\\"goals\\\">What would you like to work on? (brief)</label>\\n            <textarea id=\\\"goals\\\" name=\\\"goals\\\" rows=\\\"4\\\" placeholder=\\\"Anxiety, transitions, relationships, burnout...\\\" required></textarea>\\n\\n            <label for=\\\"insurance\\\">Billing preference</label>\\n            <select id=\\\"insurance\\\" name=\\\"insurance\\\">\\n              <option>Pay privately (credit/debit)</option>\\n              <option>Out-of-network reimbursement (I provide superbill)</option>\\n              <option>Sliding scale request</option>\\n            </select>\\n\\n            <div style=\\\"margin-top:12px\\\">\\n              <button class=\\\"btn\\\" type=\\\"submit\\\">Request appointment</button>\\n              <a class=\\\"btn secondary\\\" href=\\\"mailto:{{EMAIL}}\\\" style=\\\"margin-left:8px\\\">Email directly</a>\\n            </div>\\n          </form>\\n\\n          <p class=\\\"note\\\" style=\\\"margin-top:12px\\\">If you prefer, you can call {{PHONE}}. I schedule new clients weekly and reserve a few urgent slots.</p>\\n        </section>\\n\\n        <section class=\\\"panel\\\" style=\\\"margin-top:14px\\\">\\n          <h3 style=\\\"margin:0\\\">What to expect after you request</h3>\\n          <ol class=\\\"note\\\">\\n            <li>I’ll reply with available times and any intake forms to complete.</li>\\n            <li>We’ll confirm a first session and briefly review goals.</li>\\n            <li>In-session: we’ll orient to priorities and create a tentative plan for next steps.</li>\\n          </ol>\\n        </section>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <h3 style=\\\"margin:0\\\">Why book here</h3>\\n          <p class=\\\"note\\\">I bring a pragmatic, evidence-attentive approach with a coaching lens—helping you translate insight into action. Modalities: {{MODALITIES}}.</p>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <!-- unique pattern SVG -->\\n            <svg width=\\\"280\\\" height=\\\"140\\\" viewBox=\\\"0 0 280 140\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-labelledby=\\\"pat\\\">\\n              <title id=\\\"pat\\\">Decorative pattern</title>\\n              <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"280\\\" height=\\\"140\\\" rx=\\\"12\\\" fill=\\\"#f0fdff\\\" stroke=\\\"#e6fbff\\\"/>\\n              <g fill=\\\"#06b6d4\\\" opacity=\\\"0.08\\\">\\n                <circle cx=\\\"36\\\" cy=\\\"36\\\" r=\\\"20\\\" />\\n                <rect x=\\\"90\\\" y=\\\"16\\\" width=\\\"120\\\" height=\\\"24\\\" rx=\\\"6\\\" />\\n                <circle cx=\\\"230\\\" cy=\\\"100\\\" r=\\\"28\\\" />\\n              </g>\\n            </svg>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <strong>Fees & logistics</strong>\\n            <p class=\\\"note\\\">I do not bill insurance directly; superbills are available. Sliding scale is available by request and offered to a small number of clients each month.</p>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <strong>Privacy</strong>\\n            <p class=\\\"note\\\">All intake information is stored per professional confidentiality standards. Communications are not appropriate for emergencies.</p>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;border-radius:12px;padding:12px;background:linear-gradient(90deg,#fff8f0,transparent);border:1px solid rgba(255,107,107,0.06)\\\">\\n          <strong>Quick links</strong>\\n          <ul class=\\\"note\\\">\\n            <li><a href=\\\"fees.html\\\">See detailed rates</a></li>\\n            <li><a href=\\\"faq.html\\\">FAQ & policies</a></li>\\n            <li><a href=\\\"contact.html\\\">Contact</a></li>\\n          </ul>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <footer>\\n      <div style=\\\"margin-top:20px\\\">{{THERAPIST_NAME}} • {{LICENSE}} • {{CITY}}, {{STATE}}</div>\\n      <div class=\\\"note\\\" style=\\\"margin-top:8px\\\">Confidentiality reminder: Sessions and client information are protected except where required by law. Crisis response: If you are at immediate risk, call local emergency services or 988 (U.S.).</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
