          "text": "BUNDLE_START\n{\"path\":\"contact.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Contact — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{\\n      --bg:#0f1724; --panel:#0b1220; --accent:#ff6b6b; --muted:#9aa6b2; --glass:rgba(255,255,255,0.03);\\n      --card:#071025; --radius:14px; --maxw:980px; --accent-2:#ffd166;\\n      font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;\\n    }\\n    *{box-sizing:border-box}\\n    html,body{height:100%}\\n    body{margin:0;background:linear-gradient(180deg,#071028 0%,#081226 50%);color:#e7eef6;line-height:1.45}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 24px;max-width:1200px;margin:0 auto}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{display:inline-grid;width:44px;height:44px;border-radius:10px;place-items:center;background:linear-gradient(135deg,var(--accent),#ff9faa);font-weight:700;color:#071025}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-weight:600}\\n    nav a.active{color:#fff}\\n    main{max-width:var(--maxw);margin:28px auto;padding:28px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    .hero-card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:28px;border-radius:18px;box-shadow:0 6px 30px rgba(2,6,23,0.6)}\\n    h1{font-size:28px;margin:0 0 8px;color:#fff}\\n    p.lead{color:var(--muted);margin:0 0 18px}\\n    .pill{display:inline-block;background:var(--glass);padding:8px 12px;border-radius:999px;color:var(--accent-2);font-weight:700;margin-bottom:12px}\\n    .contact-info{display:flex;flex-direction:column;gap:10px;margin-top:8px}\\n    .contact-info a{color:#fff;text-decoration:none}\\n    .side{position:relative}\\n    .card-form{background:#041021;padding:18px;border-radius:14px}\\n    label{font-size:13px;color:var(--muted);display:block;margin-bottom:6px}\\n    input[type=text],input[type=email],textarea,select{width:100%;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:#e6f6ff}\\n    textarea{min-height:120px;resize:vertical}\\n    .row{display:flex;gap:10px}\\n    .btn{display:inline-block;background:linear-gradient(90deg,var(--accent),#ff8b8b);border:none;padding:12px 16px;border-radius:12px;color:#071025;font-weight:800;cursor:pointer}\\n    .secondary{background:transparent;border:1px solid rgba(255,255,255,0.06);color:var(--muted);padding:10px 12px;border-radius:10px}\\n    section{margin-top:22px}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}\\n    .values{display:flex;flex-direction:column;gap:12px}\\n    .method{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:14px;border-radius:12px}\\n    .objections{background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);padding:14px;border-radius:12px}\\n    .testimonial{background:linear-gradient(180deg,rgba(255,255,255,0.015),transparent);padding:12px;border-radius:12px;display:flex;gap:12px;align-items:center}\\n    .avatar{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,#ffd166,#ff6b6b);display:grid;place-items:center;color:#071025;font-weight:700}\\n    .lead-magnet{display:flex;gap:12px;align-items:center;background:linear-gradient(90deg,rgba(255,255,255,0.02),transparent);padding:14px;border-radius:12px}\\n    footer{max-width:var(--maxw);margin:28px auto;padding:22px;color:var(--muted);font-size:13px}\\n    .meta{color:var(--muted);font-size:13px}\\n    @media(max-width:900px){\\n      .hero{grid-template-columns:1fr;}\\n      .grid{grid-template-columns:1fr}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"specialties.html\\\">Offerings</a>\\n      <a href=\\\"approach.html\\\">Approach</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\" class=\\\"active\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <!-- HERO (contact-focused, different headline than other pages) -->\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <span class=\\\"pill\\\">Personalized therapy in {{CITY}}, {{STATE}}</span>\\n        <h1>Ready to start a focused phase of change?</h1>\\n        <p class=\\\"lead\\\">I offer short, intensive pathways and ongoing sessions that help professionals and caregivers reduce overwhelm, repair relationships, and move through life transitions with clarity. Use this page to reach out — or book a focused session to bridge where you are and where you want to be.</p>\\n\\n        <div class=\\\"contact-info\\\">\\n          <div><strong>{{THERAPIST_NAME}}</strong> &middot; {{LICENSE}}</div>\\n          <div class=\\\"meta\\\">Modalities: {{MODALITIES}}</div>\\n          <div>Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n          <div>Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        </div>\\n\\n        <section style=\\\"margin-top:18px\\\">\\n          <h3 style=\\\"margin:0 0 10px\\\">Quick options</h3>\\n          <div style=\\\"display:flex;gap:10px;flex-wrap:wrap\\\">\\n            <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n            <a class=\\\"secondary\\\" href=\\\"book.html\\\">View Availability</a>\\n          </div>\\n        </section>\\n\\n        <section>\\n          <h4 style=\\\"margin-top:18px;margin-bottom:8px\\\">Privacy & scope</h4>\\n          <p class=\\\"meta\\\">Conversations are confidential per professional standards, except where disclosure is required by law (risk of harm, court order). This practice provides short-term intensive work and ongoing psychotherapy; if your needs fall outside my scope I will help you find a better fit.</p>\\n        </section>\\n\\n        <section style=\\\"margin-top:18px\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Crisis notice</h4>\\n          <p class=\\\"meta\\\">If you are in immediate danger or experiencing a life-threatening crisis, call emergency services or your local crisis line. Therapy is not a substitute for emergency care.</p>\\n        </section>\\n      </div>\\n\\n      <aside class=\\\"side\\\">\\n        <div class=\\\"card-form\\\">\\n          <form method=\\\"post\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\" aria-label=\\\"Contact form\\\">\\n            <label for=\\\"name\\\">Your name</label>\\n            <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"First & last\\\" required />\\n\\n            <div style=\\\"height:10px\\\"></div>\\n            <label for=\\\"email\\\">Email</label>\\n            <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@domain.com\\\" required />\\n\\n            <div style=\\\"height:10px\\\"></div>\\n            <label for=\\\"phone\\\">Phone (optional)</label>\\n            <input id=\\\"phone\\\" name=\\\"phone\\\" type=\\\"text\\\" placeholder=\\\"Optional\\\" />\\n\\n            <div style=\\\"height:10px\\\"></div>\\n            <label for=\\\"reason\\\">Preferred contact & reason</label>\\n            <select id=\\\"reason\\\" name=\\\"reason\\\">\\n              <option>General inquiry</option>\\n              <option>Book an intake</option>\\n              <option>Intensive (3–6 week)</option>\\n              <option>Couples or relationship work</option>\\n            </select>\\n\\n            <div style=\\\"height:10px\\\"></div>\\n            <label for=\\\"message\\\">A short note</label>\\n            <textarea id=\\\"message\\\" name=\\\"message\\\" placeholder=\\\"What brings you here?\\\" required></textarea>\\n\\n            <div style=\\\"display:flex;gap:10px;margin-top:12px;align-items:center\\\">\\n              <button class=\\\"btn\\\" type=\\\"submit\\\">Send message</button>\\n              <button class=\\\"secondary\\\" type=\\\"button\\\" onclick=\\\"window.location='book.html'\\\">See sessions</button>\\n            </div>\\n\\n            <p class=\\\"meta\\\" style=\\\"margin-top:10px\\\">By submitting you consent to receive replies from {{BUSINESS_NAME}}. See privacy note above for confidentiality limits.</p>\\n          </form>\\n        </div>\\n\\n        <div style=\\\"height:14px\\\"></div>\\n\\n        <!-- Inline unique avatar SVG (local asset alternative) -->\\n        <div class=\\\"testimonial\\\">\\n          <div class=\\\"avatar\\\"><svg width=\\\"36\\\" height=\\\"36\\\" viewBox=\\\"0 0 36 36\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><rect width=\\\"36\\\" height=\\\"36\\\" rx=\\\"8\\\" fill=\\\"#ffd166\\\"/><text x=\\\"50%\\\" y=\\\"55%\\\" dominant-baseline=\\\"middle\\\" text-anchor=\\\"middle\\\" font-family=\\\"Arial\\\" font-weight=\\\"700\\\" font-size=\\\"14\\\" fill=\\\"#071025\\\">T</text></svg></div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Intake snapshot</div>\\n            <div class=\\\"meta\\\">I typically ask about current stressors, coping, and goals; we’ll map a focused plan together.</div>\\n          </div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <!-- METHODS: different phrasing and layout -->\\n    <section>\\n      <h2 style=\\\"margin:0 0 8px\\\">How I work — brief, intensive, and sustainable</h2>\\n      <p class=\\\"meta\\\" style=\\\"margin-top:0\\\">Techniques are tailored; emphasis is on practical change that fits a busy life.</p>\\n\\n      <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"method\\\">\\n          <strong>Focused Intensives</strong>\\n          <p class=\\\"meta\\\">3–6 week blocks for rapid skill-building on a specific issue (e.g., panic, relationship repair, major transition).</p>\\n        </div>\\n        <div class=\\\"method\\\">\\n          <strong>Session-by-session Therapy</strong>\\n          <p class=\\\"meta\\\">Weekly or biweekly appointments for deeper exploration and ongoing support.</p>\\n        </div>\\n        <div class=\\\"method\\\">\\n          <strong>Couples & Relational Work</strong>\\n          <p class=\\\"meta\\\">Sessions for partners to improve communication, manage conflict, and re-establish connection.</p>\\n        </div>\\n        <div class=\\\"method\\\">\\n          <strong>Coaching-style Check-ins</strong>\\n          <p class=\\\"meta\\\">Shorter, goal-oriented meetings for steady accountability and strategy adjustments.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- VALUES (different language) -->\\n    <section>\\n      <h2 style=\\\"margin:12px 0 8px\\\">Core commitments</h2>\\n      <div class=\\\"values\\\">\\n        <div>\\n          <strong>Warm rigor</strong>\\n          <div class=\\\"meta\\\">I hold both compassion and clear expectations: we track progress and adjust what’s not working.</div>\\n        </div>\\n        <div>\\n          <strong>Evidence-informed craft</strong>\\n          <div class=\\\"meta\\\">Interventions draw from trauma-informed therapy, CBT, emotionally-focused methods, and somatic awareness as appropriate.</div>\\n        </div>\\n        <div>\\n          <strong>Collaborative pacing</strong>\\n          <div class=\\\"meta\\\">Treatment is negotiated to fit your goals and life demands, with honest check-ins about fit and next steps.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- OBJECTIONS (addressing common concerns) -->\\n    <section>\\n      <h2 style=\\\"margin:12px 0 8px\\\">Questions people often have</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"objections\\\">\\n          <strong>\\\"I don't have time for therapy.\\\"</strong>\\n          <p class=\\\"meta\\\">Many clients begin with an intensive or with 30–45 minute check-ins that fit a busy schedule. We can design a plan that respects your calendar.</p>\\n        </div>\\n        <div class=\\\"objections\\\">\\n          <strong>\\\"Will this feel like medicine?\\\"</strong>\\n          <p class=\\\"meta\\\">Therapy here is relational and practical. If medication or another medical intervention is relevant, I will discuss options and collaborate with prescribers when appropriate.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- TESTIMONIALS (ethical, anonymized) -->\\n    <section>\\n      <h2 style=\\\"margin:12px 0 8px\\\">Client reflections</h2>\\n      <div style=\\\"display:grid;gap:12px\\\">\\n        <div class=\\\"testimonial\\\">\\n          <div class=\\\"avatar\\\"><svg width=\\\"36\\\" height=\\\"36\\\" viewBox=\\\"0 0 36 36\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><rect width=\\\"36\\\" height=\\\"36\\\" rx=\\\"8\\\" fill=\\\"#ff6b6b\\\"/><text x=\\\"50%\\\" y=\\\"55%\\\" dominant-baseline=\\\"middle\\\" text-anchor=\\\"middle\\\" font-family=\\\"Arial\\\" font-weight=\\\"700\\\" font-size=\\\"14\\\" fill=\\\"#071025\\\">A</text></svg></div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">\\\"A clear plan and real tools\\\"</div>\\n            <div class=\\\"meta\\\">\\\"Short intensives helped me stop avoiding hard conversations and actually practice new habits between sessions.\\\" &nbsp;&mdash; anonymized client</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"testimonial\\\">\\n          <div class=\\\"avatar\\\"><svg width=\\\"36\\\" height=\\\"36\\\" viewBox=\\\"0 0 36 36\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><rect width=\\\"36\\\" height=\\\"36\\\" rx=\\\"8\\\" fill=\\\"#ffd166\\\"/><text x=\\\"50%\\\" y=\\\"55%\\\" dominant-baseline=\\\"middle\\\" text-anchor=\\\"middle\\\" font-family=\\\"Arial\\\" font-weight=\\\"700\\\" font-size=\\\"14\\\" fill=\\\"#071025\\\">B</text></svg></div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">\\\"Confidential and pragmatic\\\"</div>\\n            <div class=\\\"meta\\\">\\\"I appreciated the balance of empathetic listening and practical steps I could use immediately.\\\" &nbsp;&mdash; anonymized client</div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- LEAD MAGNET -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"lead-magnet\\\">\\n        <div style=\\\"flex:1\\\">\\n          <strong>Get a free 2-page guide:</strong>\\n          <div class=\\\"meta\\\">\\\"A short protocol for calming an acute anxiety episode\\\" — downloadable when you reach out.</div>\\n        </div>\\n        <div>\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Request the guide</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- CTA (final nudge) -->\\n    <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center;gap:12px\\\">\\n      <div>\\n        <h3 style=\\\"margin:0\\\">Ready to begin?</h3>\\n        <div class=\\\"meta\\\">Schedule a free 10-minute consult to see if we’re a fit, or book an intake to begin work.</div>\\n      </div>\\n      <div style=\\\"display:flex;gap:10px\\\">\\n        <a class=\\\"btn\\\" href=\\\"book.html\\\">Book a consult</a>\\n        <a class=\\\"secondary\\\" href=\\\"mailto:{{EMAIL}}\\\">Email {{THERAPIST_NAME}}</a>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px\\\">\\n      <div class=\\\"meta\\\">&copy; <span style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</span> &middot; {{CITY}}, {{STATE}} &middot; {{LICENSE}}</div>\\n      <div class=\\\"meta\\\">Sessions by appointment only. Not an emergency service.</div>\\n    </div>\\n  </footer>\\n\\n  <!-- Unique inline SVGs for this template (local assets will be used by other pages) -->\\n  <svg id=\\\"pattern-svg\\\" width=\\\"0\\\" height=\\\"0\\\" style=\\\"position:absolute;left:-9999px;top:-9999px\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <pattern id=\\\"p1\\\" width=\\\"8\\\" height=\\\"8\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"8\\\" height=\\\"8\\\" fill=\\\"#071025\\\" />\\n        <path d=\\\"M0 8 L8 0\\\" stroke=\\\"#07263a\\\" stroke-width=\\\"1\\\" />\\n      </pattern>\\n    </defs>\\n  </svg>\\n</body>\\n</html>\"} \n{\"path\":\"README.md\",\"content\":\"# {{BUSINESS_NAME}} — Contact Page (Chunk 4)\\n\\nThis chunk contains the contact page and a README for the private practice therapist website built with the \\\"bold_playful\\\" layout family and an executive coach voice.\\n\\nFiles in this chunk:\\n- contact.html — Complete contact page with the required sections visible: hero, values, methods, objections, testimonials, lead_magnet, cta. The page uses placeholders such as {{BUSINESS_NAME}}, {{TAGLINE}}, {{PHONE}}, {{EMAIL}}, {{PRIMARY_CTA_LABEL}}, {{PRIMARY_CTA_URL}}, {{THERAPIST_NAME}}, {{LICENSE}}, {{MODALITIES}}, {{CITY}}, {{STATE}}.\\n\\nNotes & instructions:\\n- Replace placeholders with real practice details before publishing.\\n- This page includes privacy and crisis disclaimers, and a note about scope and boundaries per ethical requirements.\\n- There are inline SVGs included to ensure unique vector assets for this template; other chunks may add external SVG files at assets/img/*.svg.\\n- No external fonts or CDNs are referenced — everything is self-contained in the HTML.\\n\\nAccessibility & realistic practice notes:\\n- The contact form uses standard