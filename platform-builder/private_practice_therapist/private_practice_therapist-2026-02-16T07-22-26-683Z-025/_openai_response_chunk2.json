          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfdfc;--muted:#6b7280;--accent:#2f6b60;--card:#ffffff;--radius:12px;font-family:Inter,system-ui,Arial,Helvetica,sans-serif}\\n    body{margin:0;background:var(--bg);color:#0f172a;line-height:1.5}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 36px;background:linear-gradient(90deg,#fff 0%,#f7fbfa 100%);border-bottom:1px solid #e6eef0}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .brand img{width:54px;height:54px;border-radius:10px;background:linear-gradient(180deg,#e6f6f0,#f6fcfb)}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .container{max-width:980px;margin:34px auto;padding:0 20px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    .card{background:var(--card);padding:22px;border-radius:var(--radius);box-shadow:0 6px 20px rgba(18,38,30,0.04)}\\n    h1{margin:0 0 12px;font-size:28px;color:var(--accent)}\\n    p.lead{color:var(--muted);margin:0 0 18px}\\n    .meta{font-size:13px;color:#334155;margin-top:12px}\\n    .list{display:grid;gap:10px;margin-top:14px}\\n    .micro{display:flex;gap:10px;align-items:center}\\n    .btn{display:inline-block;padding:10px 16px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none;font-weight:700}\\n    footer{font-size:12px;color:var(--muted);text-align:center;padding:34px 20px}\\n    .small{font-size:13px;color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\">\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"specialties.html\\\">Areas</a>\\n      <a href=\\\"approach.html\\\">How I Work</a>\\n      <a href=\\\"fees.html\\\">Fees</a>\\n      <a href=\\\"book.html\\\" style=\\\"color:var(--accent);font-weight:800\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <!-- hero (rippled required section) -->\\n    <section id=\\\"hero\\\" class=\\\"card\\\">\\n      <h1>About the Practice</h1>\\n      <p class=\\\"lead\\\">I'm {{THERAPIST_NAME}}, a clinician and guide offering attuned psychotherapy for people navigating transitions, relationships, anxiety and the wounds that linger from trauma. I combine evidence-informed methods with contemplative awareness to meet each person where they are.</p>\\n      <div class=\\\"meta\\\">Licensed: {{LICENSE}} • Location: {{CITY}}, {{STATE}}</div>\\n      <div style=\\\"margin-top:16px\\\">\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <a href=\\\"contact.html\\\" style=\\\"margin-left:12px;color:var(--muted);text-decoration:none\\\">Ask a question</a>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"grid\\\" style=\\\"margin-top:24px\\\">\\n      <div>\\n        <!-- intake snapshot (diagnostic) -->\\n        <section id=\\\"diagnostic\\\" class=\\\"card\\\">\\n          <h2 style=\\\"margin-top:0\\\">Intake snapshot</h2>\\n          <p class=\\\"small\\\">I begin with a focused intake that clarifies your priorities, safety needs, and practical goals. Typical areas I assess:</p>\\n          <ul class=\\\"list small\\\">\\n            <li>Presenting concerns and how they impact daily life</li>\\n            <li>Relational patterns and attachment-related stress</li>\\n            <li>History of trauma or overwhelm and current coping</li>\\n            <li>Values, supports, and readiness for change</li>\\n          </ul>\\n        </section>\\n\\n        <!-- plan (programming) -->\\n        <section id=\\\"plan\\\" class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h2 style=\\\"margin-top:0\\\">Your first path</h2>\\n          <p class=\\\"small\\\">Most people begin with the Foundations Cohort — a 10-week small-group learning container that pairs individual sessions with peer work. For those seeking private work, we create a tailored plan: weekly or biweekly sessions, milestone reviews, and practical exercises between meetings.</p>\\n          <div style=\\\"margin-top:12px\\\"><strong>Program frame:</strong> Foundations Cohort • Private Therapy Tracks • Transitional Intensives</div>\\n        </section>\\n\\n        <!-- micro habits -->\\n        <section id=\\\"micro_habits\\\" class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h2 style=\\\"margin-top:0\\\">Daily micro-practices</h2>\\n          <p class=\\\"small\\\">Sustainable change often comes through small, consistent practices. Examples I teach and adapt:</p>\\n          <ul class=\\\"list small\\\">\\n            <li>2–5 minute grounding breath at the start/end of day</li>\\n            <li>Boundary check: name one need before responding</li>\\n            <li>Curiosity pause: notice a bodily sensation for 30s</li>\\n          </ul>\\n        </section>\\n\\n        <!-- crisis & scope -->\\n        <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h2 style=\\\"margin-top:0\\\">Ethics, confidentiality & scope</h2>\\n          <p class=\\\"small\\\">Sessions are confidential within the limits of law. I do not offer emergency services. If you are in crisis or at immediate risk, call local emergency services or the crisis line in your area. I provide supportive psychotherapy and will refer for specialized care when needed.</p>\\n        </section>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Quick facts</h3>\\n          <div class=\\\"small\\\">\\n            <div style=\\\"margin-bottom:8px\\\"><strong>Modalities:</strong> {{MODALITIES}}</div>\\n            <div style=\\\"margin-bottom:8px\\\"><strong>Sessions:</strong> 45–55 minutes</div>\\n            <div style=\\\"margin-bottom:8px\\\"><strong>Telehealth:</strong> Secure video available</div>\\n          </div>\\n          <div style=\\\"margin-top:12px\\\">\\n            <a class=\\\"btn\\\" href=\\\"book.html\\\">Start a conversation</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h3 style=\\\"margin-top:0\\\">Fees snapshot</h3>\\n          <div class=\\\"small\\\">I offer a limited sliding-scale and a small number of cohort scholarships. Full fee consultation is discussed in first contact. See the Fees page for details.</div>\\n          <div style=\\\"margin-top:12px\\\"><a href=\\\"fees.html\\\" style=\\\"text-decoration:none;color:var(--accent);font-weight:700\\\">View fees</a></div>\\n        </div>\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"small\\\">Confidentiality note: Your information is protected within clinical and legal limits. Crisis disclaimer: This site is not a substitute for emergency care.</div>\\n    <div style=\\\"margin-top:8px\\\">© {{BUSINESS_NAME}} • <a href=\\\"contact.html\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"specialties.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Areas I Support — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#ffffff;--muted:#556069;--accent:#165a50;--card:#f8fffb;--radius:10px;font-family:Inter,system-ui,Arial}\\n    body{margin:0;background:var(--bg);color:#0b1220}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:22px 30px;border-bottom:1px solid #eef3f2}\\n    .logo{font-weight:800;color:var(--accent)}\\n    nav a{margin-left:16px;color:var(--muted);text-decoration:none}\\n    .wrap{max-width:1000px;margin:28px auto;padding:0 20px}\\n    .hero{display:flex;gap:22px;align-items:center;background:#f3fbf8;padding:20px;border-radius:12px}\\n    .hero img{width:140px;height:120px}\\n    h1{margin:0;color:var(--accent)}\\n    p.lead{margin:8px 0;color:var(--muted)}\\n    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:20px}\\n    .card{background:linear-gradient(180deg,#ffffff,#f7fdfa);padding:16px;border-radius:10px;border:1px solid #e6f2ee}\\n    .card h3{margin:0 0 6px;color:#0f2b24}\\n    .card p{margin:0;color:var(--muted);font-size:14px}\\n    .side{margin-top:20px;padding:14px;background:#fff;border-radius:10px;border:1px solid #eef3f2}\\n    .btn{display:inline-block;padding:9px 14px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none;font-weight:700}\\n    footer{font-size:13px;color:var(--muted);text-align:center;padding:30px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Meet</a>\\n      <a href=\\\"approach.html\\\">Approach</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <!-- hero (ripple) -->\\n    <section id=\\\"hero\\\" class=\\\"hero\\\">\\n      <img src=\\\"assets/img/hero.svg\\\" alt=\\\"illustration\\\">\\n      <div>\\n        <h1>Areas I support</h1>\\n        <p class=\\\"lead\\\">I work with adults navigating anxiety, relationship shifts, burnout, and the lingering effects of trauma. My stance is collaborative, non-pathologizing, and oriented toward practical change and inner steadiness.</p>\\n        <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Request a consult</a></div>\\n      </div>\\n    </section>\\n\\n    <!-- diagnostic -->\\n    <section id=\\\"diagnostic\\\" style=\\\"margin-top:22px\\\">\\n      <div class=\\\"side\\\">\\n        <h2 style=\\\"margin:0 0 8px\\\">Where we begin</h2>\\n        <p class=\\\"small\\\" style=\\\"color:var(--muted)\\\">A short assessment helps us identify patterns that maintain distress and the tangible first steps that reduce suffering. Below are the common presenting concerns I see.</p>\\n      </div>\\n    </section>\\n\\n    <!-- specialties cards (unique content) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"cards\\\">\\n        <div class=\\\"card\\\">\\n          <h3>Anxiety & chronic worry</h3>\\n          <p>Practical tools for nervous-system regulation, alongside therapy for underlying beliefs and anticipatory patterns that keep anxiety active.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3>Trauma recovery</h3>\\n          <p>Phase-oriented, paced work focused on safety, stabilization, and incremental integration of difficult memories and sensations.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3>Relationship repair</h3>\\n          <p>Individual and paired work aimed at communication, boundary clarity, and re-establishing secure connection when trust has frayed.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3>Burnout & exhaustion</h3>\\n          <p>Assessment of demands and values, actionable boundary strategies, and restoration practices that fit your life context.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3>Life transitions</h3>\\n          <p>Support for grief, career shifts, parenting changes, and any season demanding new meaning and practical adaptation.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3>Identity & belonging</h3>\\n          <p>Exploration of identity, cultural context, and how to live with greater authenticity in relationships and work.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- plan (cohort mention framed differently) -->\\n    <section id=\\\"plan\\\" style=\\\"margin-top:22px\\\">\\n      <div class=\\\"side\\\">\\n        <h2 style=\\\"margin:0 0 8px\\\">Program options</h2>\\n        <p class=\\\"small\\\" style=\\\"color:var(--muted)\\\">I offer 1:1 therapy, short focused intensives, and cohort learning circles that emphasize peer support and skill-building. The \\\"Sustained Presence\\\" cohort runs quarterly and includes weekly group sessions plus two individual check-ins.</p>\\n        <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Join waitlist</a></div>\\n      </div>\\n    </section>\\n\\n    <!-- micro habits -->\\n    <section id=\\\"micro_habits\\\" style=\\\"margin-top:20px\\\">\\n      <div class=\\\"side\\\">\\n        <h2 style=\\\"margin:0 0 8px\\\">Small practices that matter</h2>\\n        <p class=\\\"small\\\" style=\\\"color:var(--muted)\\\">I teach brief somatic and relational practices you can use each day. These are meant to be feasible, specific, and adapted to your rhythm.</p>\\n        <ul style=\\\"color:var(--muted)\\\">\\n          <li>Signal-and-stop: one boundary phrase to practice</li>\\n          <li>Micro-breaths for transitions</li>\\n          <li>Daily calibration: note one thing that grounded you</li>\\n        </ul>\\n      </div>\\n    </section>\\n\\n    <!-- pricing (framing: packages) -->\\n    <section id=\\\"pricing\\\" style=\\\"margin-top:22px\\\">\\n      <div class=\\\"side\\\">\\n        <h2 style=\\\"margin:0 0 8px\\\">Investments & packages</h2>\\n        <p class=\\\"small\\\" style=\\\"color:var(--muted)\\\">Options include single sessions, 6-session packages, and cohort tuition. I maintain a small sliding-scale pool for those with financial need. Specific rates and package details are discussed during intake.</p>\\n        <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"fees.html\\\">See detailed fees</a></div>\\n      </div>\\n    </section>\\n\\n    <!-- cta -->\\n    <section id=\\\"cta\\\" style=\\\"margin-top:24px;text-align:center\\\">\\n      <div style=\\\"display:inline-block;padding:18px 22px;background:#f0f9f6;border-radius:12px;border:1px solid #e2f3ec\\\">\\n        <div style=\\\"font-weight:800;color:var(--accent)\\\">Ready to begin?</div>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">I offer a short consult to see if we're a good fit — no pressure, just clarity.</div>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:28px;text-align:center;color:var(--muted)\\\">\\n      <div>Confidentiality & limits: communications are protected except where law requires disclosure. This site is not an emergency service. If you are in crisis, please call local emergency services.</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>How I Work — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfffe;--muted:#47585a;--accent:#0f5b4f;--card:#ffffff;--radius:14px;font-family:Inter,system-ui,Arial}\\n    body{margin:0;background:var(--bg);color:#072022}\\n    header{padding:20px 28px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e9f2f1}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .wrap{max-width:980px;margin:36px auto;padding:0 20px}\\n    .top{display:flex;gap:20px;align-items:center}\\n    .top img{width:88px;height:88px;border-radius:12px}\\n    h1{color:var(--accent);margin:0}\\n    .card{background:var(--card);padding:18px;border-radius:var(--radius);box-shadow:0 10px 30px rgba(6,34,28,0.04)}\\n    section{margin-top:18px}\\n    .grid{display:grid;grid-template-columns:1fr 300px;gap:22px}\\n    .micro{display:flex;flex-direction:column;gap:8px}\\n    .btn{background:var(--accent);color:#fff;padding:9px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{margin-top:30px;text-align:center;color:var(--muted);font-size:13px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:800;color:var(--accent)\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Return</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"specialties.html\\\">Paths</a>\\n      <a href=\\\"book.html\\\" style=\\\"font-weight:800;color:var(--accent)\\\">Schedule</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <!-- hero (ripple) -->\\n    <section id=\\\"hero\\\" class=\\\"card top\\\">\\n      <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"decorative\\\">\\n      <div>\\n        <h1>How I accompany you</h1>\\n        <p style=\\\"color:var(--muted);margin-top:8px\\\">My approach is integrative: relational, somatic, and skill-based. I attend to safety first, then to learning new ways of being that reduce reactivity and expand choice.</p>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"grid\\\">\\n      <div>\\n        <!-- diagnostic -->\\n        <section id=\\\"diagnostic\\\" class=\\\"card\\\">\\n          <h2 style=\\\"margin-top:0\\\">A practical diagnostic</h2>\\n          <p style=\\\"color:var(--muted)\\\">In early sessions we map patterns across thoughts, body, and relationships. That map becomes a living plan with measurable short-term steps.</p>\\n          <ol style=\\\"margin-top:10px;color:var(--muted)\\\">\\n            <li>Safety & stabilization</li>\\n            <li>Pattern recognition and experiment design</li>\\n            <li>Skill building integrated into daily life</li>\\n          </ol>\\n        </section>\\n\\n        <!-- plan -->\\n        <section id=\\\"plan\\\" class=\\\"card\\\" style=\\\"margin-top:16px\\\">\\n          <h2 style=\\\"margin-top:0\\\">Pathways & programs</h2>\\n          <p style=\\\"color:var(--muted)\\\">Depending on need we choose one of several paths: the Reflective Cohort (8 weeks), an individual weekly track, or a short-term intensive for concentrated change. Cohorts emphasize shared learning and peer practice.</p>\\n          <div style=\\\"margin-top:12px;font-weight:700;color:var(--accent)\\\">This season: Reflective Cohort (spring enrollment)</div>\\n        </section>\\n\\n        <!-- micro habits -->\\n        <section id=\\\"micro_habits\\\" class=\\\"card\\\" style=\\\"margin-top:16px\\\">\\n          <h2 style=\\\"margin-top:0\\\">Practices between sessions</h2>\\n          <p style=\\\"color:var(--muted)\\\">Therapy expands when what you learn is practiced. I assign short, personalized micro-steps — rarely more than 10 minutes a day.</p>\\n          <ul style=\\\"color:var(--muted)\\\">\\n            <li>Boundary rehearsal (30s scripting)</li>\\n            <li>Regulation anchor (two slow exhales)</li>\\n            <li>Weekly curiosity note (one observation recorded)</li>\\n          </ul>\\n        </section>\\n\\n        <!-- pricing (unique framing: enrollment tiers) -->\\n        <section id=\\\"pricing\\\" class=\\\"card\\\" style=\\\"margin-top:16px\\\">\\n          <h2 style=\\\"margin-top:0\\\">Enrollment & rates</h2>\\n          <p style=\\\"color:var(--muted)\\\">I offer tiered enrollment: Core (individual therapy), Cohort (group plus 2 check-ins), and Intensive (3-session package). I will discuss fit and financial options during our first call.</p>\\n          <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"fees.html\\\">Explore tiers</a></div>\\n        </section>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Therapeutic stance</h3>\\n          <p style=\\\"color:var(--muted)\\\">I work from a relational somatic lens, blending evidence-informed tools with reflective practice. Therapy is collaborative and paced to your readiness.</p>\\n          <div style=\\\"margin-top:12px\\\"><strong>Modalities:</strong> {{MODALITIES}}</div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h3 style=\\\"margin-top:0\\\">Next step</h3>\\n          <p style=\\\"color:var(--muted)\\\">A short intake call clarifies whether I'm a good fit and which pathway serves you best.</p>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <!-- cta -->\\n    <section id=\\\"cta\\\" style=\\\"margin-top:26px;text-align:center\\\">\\n      <div class=\\\"card\\\" style=\\\"display:inline-block;padding:18px 22px\\\">\\n        <div style=\\\"font-weight:800;color:var(--accent)\\\">Begin with a brief consult</div>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">I offer a 20-minute conversation to assess fit, answer questions, and discuss logistics.</div>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Schedule consult</a></div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>Confidentiality & limits: Clinical records are kept private except where law requires disclosure. If you are in crisis, contact emergency services immediately.</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"assets/img/hero.svg\",\"content\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 200 140\\\" preserveAspectRatio=\\\"xMidYMid meet\\\">\\\\n  <defs>\\\\n    <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\\\n      <stop offset=\\\"0\\\" stop-color=\\\"#dff6e