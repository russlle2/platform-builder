          "text": "BUNDLE_START\n{\"path\":\"fees.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investments — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#faf8f6;--card:#ffffff;--muted:#6b6b6b;--accent:#6b4cff;--accent-2:#00b59b;--glass:rgba(255,255,255,0.7);font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;}\\n    *{box-sizing:border-box}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg),#f6f3f9 60%);color:#222;line-height:1.45}\\n    header{position:relative;padding:28px 24px 40px;overflow:hidden}\\n    .nav{display:flex;gap:18px;align-items:center;max-width:1100px;margin:0 auto}\\n    .brand{font-weight:700;color:var(--accent);font-size:18px}\\n    .links{margin-left:auto;display:flex;gap:12px}\\n    .links a{color:#444;text-decoration:none;padding:8px 10px;border-radius:8px}\\n    .links a[href$=\\\"fees.html\\\"]{background:var(--accent);color:#fff}\\n    .hero{max-width:1100px;margin:28px auto 18px;padding:28px;background:linear-gradient(180deg,rgba(107,76,255,0.06),transparent);border-radius:12px;display:flex;gap:20px;align-items:center}\\n    .hero .left{flex:1}\\n    .hero h1{margin:0 0 8px;font-size:24px}\\n    .hero p{margin:0;color:var(--muted)}\\n    .pattern{position:absolute;right:-120px;top:-40px;opacity:.15;width:420px;height:420px}\\n    .grid{max-width:1100px;margin:22px auto;padding:0 24px;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(35,30,60,0.05)}\\n    .price{font-weight:700;font-size:20px;color:var(--accent-2)}\\n    .list{margin:10px 0 0;padding:0 0 0 16px;color:var(--muted)}\\n    .muted{color:var(--muted);font-size:14px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none}\\n\\n    /* Accordion */\\n    .accordion{max-width:900px;margin:28px auto;padding:0 24px}\\n    .acc-item{background:var(--card);border-radius:10px;margin-bottom:12px;overflow:hidden}\\n    .acc-head{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;cursor:pointer}\\n    .acc-body{padding:0 16px 16px;color:var(--muted);display:none}\\n    .crisis{background:#fff3f2;border-left:4px solid #ff6b6b;padding:12px;margin-top:12px;border-radius:8px;color:#7a2a2a}\\n\\n    footer{max-width:1100px;margin:28px auto;padding:22px 24px;color:var(--muted)}\\n    small{display:block;color:var(--muted)}\\n    @media(min-width:720px){.hero h1{font-size:28px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#6b4cff\\\" />\\n          <stop offset=\\\"1\\\" stop-color=\\\"#00b59b\\\" />\\n        </linearGradient>\\n      </defs>\\n      <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"200\\\" height=\\\"200\\\" rx=\\\"24\\\" fill=\\\"url(#g1)\\\" opacity=\\\"0.12\\\"/>\\n      <g fill=\\\"#fff\\\" opacity=\\\"0.06\\\">\\n        <circle cx=\\\"40\\\" cy=\\\"40\\\" r=\\\"6\\\"/>\\n        <circle cx=\\\"80\\\" cy=\\\"80\\\" r=\\\"6\\\"/>\\n        <circle cx=\\\"140\\\" cy=\\\"30\\\" r=\\\"6\\\"/>\\n      </g>\\n    </svg>\\n    <nav class=\\\"nav\\\">\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"links\\\">\\n        <a href=\\\"index.html\\\">Welcome</a>\\n        <a href=\\\"specialties.html\\\">What I Do</a>\\n        <a href=\\\"fees.html\\\">Investments</a>\\n        <a href=\\\"book.html\\\">Book Time</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n        <a href=\\\"about.html\\\">About</a>\\n      </div>\\n    </nav>\\n    <div class=\\\"hero\\\" role=\\\"region\\\" aria-label=\\\"Fees overview\\\">\\n      <div class=\\\"left\\\">\\n        <h1>Flexible options that meet real life — and real budgets.</h1>\\n        <p class=\\\"muted\\\">Sessions and short series designed for clarity, not complexity. Choose what fits your schedule and needs. If cost is a barrier, I’m open to discussing a sliding option.</p>\\n      </div>\\n      <div style=\\\"text-align:right;min-width:180px\\\">\\n        <div class=\\\"muted\\\">Phone</div>\\n        <div style=\\\"font-weight:700\\\">{{PHONE}}</div>\\n      </div>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"grid\\\" aria-label=\\\"service options\\\">\\n      <article class=\\\"card\\\">\\n        <h3>Single Sessions</h3>\\n        <div class=\\\"price\\\">$140–$180</div>\\n        <p class=\\\"muted\\\">One-off appointments to check in, troubleshoot, or make a plan for a specific concern.</p>\\n        <ul class=\\\"list\\\">\\n          <li>50–55 minutes</li>\\n          <li>Evidence-informed clinical approach</li>\\n        </ul>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Book a single session</a>\\n      </article>\\n\\n      <article class=\\\"card\\\">\\n        <h3>Foundations Series</h3>\\n        <div class=\\\"price\\\">3 sessions • $400</div>\\n        <p class=\\\"muted\\\">A short, structured series to build momentum on one focused goal or transition.</p>\\n        <ul class=\\\"list\\\">\\n          <li>3 x 50 minutes</li>\\n          <li>Practical tools and meeting notes</li>\\n        </ul>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve a Foundations slot</a>\\n      </article>\\n\\n      <article class=\\\"card\\\">\\n        <h3>Bridge Package</h3>\\n        <div class=\\\"price\\\">6 sessions • $760</div>\\n        <p class=\\\"muted\\\">For when you want a steadier rhythm for navigating change. Ideal for pacing and follow-through.</p>\\n        <ul class=\\\"list\\\">\\n          <li>6 x 50 minutes</li>\\n          <li>Optional between-session check-ins</li>\\n        </ul>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Start a Bridge Package</a>\\n      </article>\\n\\n      <article class=\\\"card\\\">\\n        <h3>Cohort Group: Seasonal Reset</h3>\\n        <div class=\\\"price\\\">Group rate • sliding scale</div>\\n        <p class=\\\"muted\\\">A small, time-limited cohort that meets weekly for six weeks — skills, reflection, and clinician-guided discussion.</p>\\n        <ul class=\\\"list\\\">\\n          <li>6-week cohort</li>\\n          <li>Limited seats; group participation required</li>\\n        </ul>\\n        <a class=\\\"cta\\\" href=\\\"contact.html\\\">Ask about the next cohort</a>\\n      </article>\\n    </section>\\n\\n    <section class=\\\"accordion\\\" aria-label=\\\"Policy and confidentiality\\\">\\n      <div class=\\\"acc-item\\\">\\n        <button class=\\\"acc-head\\\" aria-expanded=\\\"false\\\">Session boundaries & cancellations <span aria-hidden>▾</span></button>\\n        <div class=\\\"acc-body\\\">\\n          <p class=\\\"muted\\\">Sessions are typically 50–55 minutes. I ask for 48 hours notice for cancellations; late cancellations or missed sessions may be billed at a reduced fee. If you need flexibility, let me know and we can discuss alternatives.</p>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"acc-item\\\">\\n        <button class=\\\"acc-head\\\" aria-expanded=\\\"false\\\">Confidentiality & scope of practice <span aria-hidden>▾</span></button>\\n        <div class=\\\"acc-body\\\">\\n          <p class=\\\"muted\\\">What we discuss in session is confidential except in specific, legally required situations (e.g., concerns about imminent harm to self or others, or instances of abuse). I will always aim to speak with you transparently about limits to confidentiality before taking steps that involve others.</p>\\n          <p class=\\\"muted\\\">I provide psychotherapy and support for life transitions, emotional regulation, and relationship concerns. I do not provide forensic services, emergency response, or medical treatment. If your needs fall outside my scope, I will offer referrals.</p>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"acc-item\\\">\\n        <button class=\\\"acc-head\\\" aria-expanded=\\\"false\\\">Data & records <span aria-hidden>▾</span></button>\\n        <div class=\\\"acc-body\\\">\\n          <p class=\\\"muted\\\">Clinical notes are kept to support continuity of care. You have the right to request access to your records; we can discuss what that looks like and any necessary steps.</p>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"crisis\\\" role=\\\"alert\\\">\\n        If you are in immediate danger or are considering harming yourself, please contact local emergency services or go to the nearest emergency room. If you are in {{STATE}} and need urgent support, call or text your local crisis line or dial 988 (U.S.); if elsewhere, contact the equivalent local emergency resource.\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <small>Email: {{EMAIL}}</small>\\n    <small>Location: {{CITY}}, {{STATE}}</small>\\n    <small>My work follows professional and ethical guidelines. This site does not replace an in-person evaluation. If you have questions about fit or accessibility, please reach out.</small>\\n  </footer>\\n\\n  <script>\\n    // Accordion behavior\\n    document.querySelectorAll('.acc-head').forEach(function(btn){\\n      btn.addEventListener('click',function(){\\n        var expanded = this.getAttribute('aria-expanded') === 'true';\\n        this.setAttribute('aria-expanded', String(!expanded));\\n        var body = this.nextElementSibling;\\n        if(!expanded){ body.style.display = 'block'; } else { body.style.display = 'none'; }\\n      });\\n    });\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>FAQ — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffefc;--card:#ffffff;--muted:#5f6368;--accent:#6b4cff;--glass:rgba(255,255,255,0.8);font-family:Inter,system-ui,Segoe UI,Roboto,Arial}\\n    body{margin:0;background:var(--bg);color:#222}\\n    header{padding:20px 24px;border-bottom:1px solid #f0eef7}\\n    .nav{display:flex;gap:16px;align-items:center;max-width:1100px;margin:0 auto}\\n    .brand{font-weight:700;color:var(--accent)}\\n    .links{margin-left:auto;display:flex;gap:10px}\\n    .links a{padding:8px 10px;text-decoration:none;color:#444;border-radius:8px}\\n    .links a[href$=\\\"faq.html\\\"]{background:var(--accent);color:#fff}\\n    main{max-width:1100px;margin:22px auto;padding:18px}\\n    h1{margin:6px 0 10px}\\n    .qa{display:grid;grid-template-columns:1fr;gap:12px}\\n    .q{background:var(--card);padding:12px;border-radius:10px}\\n    .q summary{font-weight:600;cursor:pointer}\\n    .q p{margin:8px 0 0;color:var(--muted)}\\n    .cta{display:inline-block;margin-top:10px;padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none}\\n    .side{background:linear-gradient(180deg,#fff,#fbfbff);border-radius:10px;padding:14px;margin-top:14px}\\n    .crisis{background:#fff3f2;border-left:4px solid #ff6b6b;padding:12px;margin-top:12px;border-radius:8px;color:#7a2a2a}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <nav class=\\\"nav\\\">\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"links\\\">\\n        <a href=\\\"index.html\\\">Welcome</a>\\n        <a href=\\\"specialties.html\\\">Services</a>\\n        <a href=\\\"fees.html\\\">Investments</a>\\n        <a href=\\\"book.html\\\">Secure Time</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </div>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <h1>Questions people commonly ask</h1>\\n    <p class=\\\"muted\\\">Short answers below. If something matters to you and isn’t listed, please reach out — I’m glad to clarify.</p>\\n\\n    <section class=\\\"qa\\\" aria-label=\\\"Frequently asked questions\\\">\\n      <details class=\\\"q\\\">\\n        <summary>How do I know if we’re a fit?</summary>\\n        <p class=\\\"muted\\\">Fit is often best judged after a first session. We’ll talk about your needs, goals, and what working together would look like. If I’m not the right clinician for your needs, I’ll offer referrals.</p>\\n      </details>\\n\\n      <details class=\\\"q\\\">\\n        <summary>What happens in a first session?</summary>\\n        <p class=\\\"muted\\\">We’ll spend time understanding what’s brought you here, identifying priorities, and co-creating a plan for next steps — whether that’s a few focused meetings or a longer pacing.\\n        </p>\\n      </details>\\n\\n      <details class=\\\"q\\\">\\n        <summary>Insurance and payment</summary>\\n        <p class=\\\"muted\\\">I am currently working with private pay. I can provide a superbill upon request that you may submit to your insurer for possible reimbursement. Payment methods and sliding-fee options can be discussed by email.</p>\\n      </details>\\n\\n      <details class=\\\"q\\\">\\n        <summary>Telehealth or in-person?</summary>\\n        <p class=\\\"muted\\\">I offer telehealth and selected in-person slots. If you have accessibility needs, tell me so I can accommodate or suggest alternatives.</p>\\n      </details>\\n\\n      <details class=\\\"q\\\" id=\\\"confidential\\\">\\n        <summary>Confidentiality and limits — short version</summary>\\n        <p class=\\\"muted\\\">What you share in session stays private, with a few legal exceptions: imminent risk of harm to self or others, and mandatory reporting of abuse. I strive to be transparent; if there are concerns about involving others, we’ll talk about options first.</p>\\n      </details>\\n    </section>\\n\\n    <aside class=\\\"side\\\">\\n      <strong>Need a quick next step?</strong>\\n      <p class=\\\"muted\\\">If you’re ready to try a single appointment, that’s a good way to see if the approach matches your needs.</p>\\n      <a class=\\\"cta\\\" href=\\\"book.html\\\">Schedule a single visit</a>\\n\\n      <div class=\\\"crisis\\\" role=\\\"alert\\\">\\n        If you are at immediate risk, please contact emergency services or your local crisis line. In the U.S., dialing 988 connects you with crisis support. If you’re outside the U.S., contact your local emergency resource.\\n      </div>\\n    </aside>\\n  </main>\\n\\n  <footer style=\\\"max-width:1100px;margin:22px auto;padding:0 18px;color:var(--muted)\\\">\\n    <small>Email: {{EMAIL}} • Phone: {{PHONE}}</small>\\n  </footer>\\n\\n  <script>\\n    // Small accessibility enhancement: expand the confidentiality detail by default\\n    (function(){\\n      var el = document.getElementById('confidential');\\n      if(el){ el.open = false; }\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfdff;--card:#fff;--muted:#5b5b64;--accent:#6b4cff;--accent-2:#00b59b;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto}\\n    *{box-sizing:border-box}\\n    body{margin:0;background:var(--bg);color:#1b1b1b}\\n    header{padding:22px 24px;border-bottom:1px solid rgba(107,76,255,0.06)}\\n    .nav{display:flex;align-items:center;gap:14px;max-width:1100px;margin:0 auto}\\n    .brand{font-weight:700;color:var(--accent)}\\n    .links{margin-left:auto;display:flex;gap:10px}\\n    .links a{padding:8px 10px;border-radius:8px;text-decoration:none;color:#444}\\n    .links a[href$=\\\"book.html\\\"]{background:var(--accent);color:#fff}\\n    main{max-width:1000px;margin:26px auto;padding:18px}\\n    h1{margin:0 0 6px;font-size:24px}\\n    p.lead{color:var(--muted);margin:0 0 18px}\\n    .selector{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:18px}\\n    .mood{padding:14px;border-radius:12px;background:linear-gradient(180deg,#fff,#fbfbff);cursor:pointer;border:1px solid #f0eef7;text-align:center}\\n    .mood.active{box-shadow:0 8px 26px rgba(107,76,255,0.08);transform:translateY(-4px)}\\n    .recommend{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 8px 20px rgba(25,20,50,0.04)}\\n    .recommend h3{margin:0 0 8px}\\n    .recommend p{margin:0;color:var(--muted)}\\n    .book-cta{display:inline-block;margin-top:12px;padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none}\\n    .meta{margin-top:12px;color:var(--muted);font-size:14px}\\n    .conf{margin-top:18px;background:linear-gradient(180deg,#fff,#fbfbff);padding:12px;border-radius:10px}\\n    .crisis{background:#fff3f2;border-left:4px solid #ff6b6b;padding:12px;margin-top:12px;border-radius:8px;color:#7a2a2a}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <nav class=\\\"nav\\\">\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"links\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"specialties.html\\\">Offerings</a>\\n        <a href=\\\"fees.html\\\">Investments</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </div>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <h1>Choose how you'd like to be seen</h1>\\n    <p class=\\\"lead\\\">Select the word that best captures how you’re feeling right now. I’ll suggest an approach that tends to fit that mood and update the booking button to match.</p>\\n\\n    <section aria-label=\\\"Mood selector\\\" class=\\\"selector\\\" id=\\\"moods\\\">\\n      <div class=\\\"mood\\\" data-key=\\\"overwhelmed\\\">Overwhelmed</div>\\n      <div class=\\\"mood\\\" data-key=\\\"stuck\\\">Stuck</div>\\n      <div class=\\\"mood\\\" data-key=\\\"anxious\\\">Worried / Anxious</div>\\n      <div class=\\\"mood\\\" data-key=\\\"grieving\\\">Sad / Grieving</div>\\n      <div class=\\\"mood\\\" data-key=\\\"curious\\\">Curious / Exploring</div>\\n    </section>\\n\\n    <aside class=\\\"recommend\\\" id=\\\"recommend\\\">\\n      <h3 id=\\\"rec-title\\\">Single Sessions — try a focused meeting</h3>\\n      <p id=\\\"rec-copy\\\">A single session is a practical way to sort a pressing concern, make a short plan, or decide if continued work would help. No commitment beyond the appointment.</p>\\n      <a href=\\\"book.html?type=single\\\" id=\\\"book-btn\\\" class=\\\"book-cta\\\">Reserve a single session</a>\\n      <div class=\\\"meta\\\" id=\\\"rec-meta\\\">50–55 minutes • Private pay • Superbills available on request</div>\\n    </aside>\\n\\n    <div class=\\\"conf\\\">\\n      <strong>Notes on privacy & boundaries</strong>\\n      <p class=\\\"muted\\\">Sessions are confidential with few legal exceptions. I maintain secure records for clinical care. If you have concerns about privacy, please mention them before we begin so we can agree on what feels safe for you.</p>\\n      <p class=\\\"muted\\\">Appointments are 50–55 minutes. I ask for 48 hours notice for cancellation; I'll share the cancellation and payment policy when we confirm an appointment.</p>\\n    </div>\\n\\n    <div class=\\\"crisis\\\" role=\\\"alert\\\">\\n      If you are thinking about harm or are in immediate danger, call emergency services or go to your nearest emergency department. In the U.S., you can dial or text 988 for crisis support. If you're outside the U.S., please contact your local emergency resource.\\n    </div>\\n  </main>\\n\\n  <footer style=\\\"max-width:1000px;margin:20px auto;padding:0 18px;color:var(--muted)\\\">\\n    <small>Questions? Email: {{EMAIL}}</small>\\n  </footer>\\n\\n  <script>\\n    (function(){\\n      var mapping = {\\n        overwhelmed: {\\n          title: 'Grounding & Triage — one-step clarity',\\n          copy: 'We will focus on immediate ways to reduce overwhelm and create a short, manageable plan. Often helpful when life feels too full and decisions need quick arranging.',\\n          cta: 'Book a grounding session',\\n          href: 'book.html?type=grounding'\\n        },\\n        stuck: {\\n          title: 'Pacing & Pattern Work — make a plan that moves',\\n          copy: 'A few sessions aimed at identifying patterns that keep you stalled and building practical steps to regain momentum.',\\n          cta: 'Start a short series',\\n          href: 'book.html?type=foundations'\\n        },\\n        anxious: {\\n          title: 'Worry Management — tools for the moment',\\n          copy: 'Learn strategies to settle the nervous system and test small experiments for anxiety that interfere with daily life.',\\n          cta: 'Schedule a coping session',\\n          href: 'book.html?type=single'\\n        },\\n        grieving: {\\n          title: 'Companion Sessions — holding loss and change',\\n          copy: 'A compassionate, paced approach to grief and big feelings. We attend to emotion and daily functioning together.',\\n          cta: 'Reserve a companion session',\\n          href: 'book.html?type=companion'\\n        },\\n        curious: {\\n          title: 'Exploratory Visit — see what fits',\\n          copy: 'A gentle first meeting to name priorities and see if my style and offerings are a match for you.',\\n          cta: 'Book an exploratory visit',\\n          href: 'book.html?type=explore'\\n        }\\n      };\\n\\n      var moods = document.querySelectorAll('.mood');\\n      var recTitle = document.getElementById('rec-title');\\n      var recCopy = document.getElementById('rec-copy');\\n      var bookBtn = document.getElementById('book-btn');\\n\\n      function setActive(key, el){\\n        moods.forEach(function(m){ m.classList.remove('active'); });\\n        if(el) el.classList.add('active');\\n        var v = mapping[key] || mapping['curious'];\\n        recTitle.textContent = v.title;\\n        recCopy.textContent = v.copy;\\n        bookBtn.textContent = v.cta;\\n        bookBtn.href = v.href;\\n      }\\n\\n      moods.forEach(function(m){\\n        m.addEventListener('click',function(){\\n          setActive(this.getAttribute('data-key'), this);\\n        });\\n      });\\n\\n      // initialize to 'curious'\\n      var first = document.querySelector('.mood[data-key=\\\"curious\\\"]');\\n      setActive('curious', first);\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
  "parallel_tool_calls": true,
  "presence_penalty": 0,
  "previous_response_id": null,
