          "text": "BUNDLE_START\n{\"path\":\"fees.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Investment</title>\\n  <style>\\n    :root{--bg:#fff8ef;--card:#fff;--muted:#6b5b4a;--accent:#b86b3a;--accent-2:#e9c7b0;--shadow:rgba(102,84,66,0.08);font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg) 0%,#fff 70%);color:#3e352e}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 36px}\\n    .brand{display:flex;align-items:center;gap:14px}\\n    .brand .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav a{margin-left:16px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .container{max-width:980px;margin:28px auto;padding:24px}\\n    .hero{display:grid;grid-template-columns:1fr 340px;gap:26px;align-items:start}\\n    .hero-card{background:var(--card);padding:26px;border-radius:14px;box-shadow:0 6px 18px var(--shadow)}\\n    .hero h1{margin:0;font-size:22px;color:#312620}\\n    .hero p.lead{margin-top:10px;color:var(--muted);line-height:1.5}\\n    .side{background:linear-gradient(180deg,rgba(184,107,58,0.06),transparent);padding:20px;border-radius:12px}\\n    .price{font-weight:700;color:var(--accent);font-size:20px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:22px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 14px var(--shadow)}\\n    ul.benefits{padding-left:18px;color:var(--muted)}\\n    .process{margin-top:22px;display:flex;gap:12px}\\n    .step{background:linear-gradient(180deg,#fff,#fff);padding:12px;border-radius:10px;border:1px solid #f0e5db;flex:1}\\n    footer{margin-top:36px;padding:26px;border-radius:10px;background:rgba(0,0,0,0.02);color:var(--muted);font-size:13px}\\n    .cta{display:inline-block;margin-top:12px;background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    .testimonial{margin-top:18px;padding:14px;border-left:4px solid var(--accent-2);background:#fffefc;border-radius:8px}\\n    .lead-magnet{display:flex;gap:12px;align-items:center;margin-top:18px}\\n    .pill{background:var(--accent-2);padding:8px 12px;border-radius:999px;color:#5b3f30;font-weight:700}\\n    small.disclaimer{display:block;margin-top:12px;color:#8b7a6b;font-size:12px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">{{THERAPIST_NAME}}</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"specialties.html\\\">Paths</a>\\n      <a href=\\\"approach.html\\\">Approach</a>\\n      <a href=\\\"fees.html\\\">Investment</a>\\n      <a href=\\\"book.html\\\">Work With Me</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <h1>Investment & Session Options</h1>\\n        <p class=\\\"lead\\\">I offer structured, transparent options so we can find a rhythm that fits your needs and schedule. I work with adults around anxiety, relationship shifts, grief, and life transitions. Below are typical options — we’ll tailor them together.</p>\\n        <div class=\\\"grid\\\" aria-hidden=\\\"false\\\">\\n          <div class=\\\"card\\\">\\n            <strong>Drop-in Session</strong>\\n            <div class=\\\"price\\\">$160 / 50 min</div>\\n            <p style=\\\"color:var(--muted);font-size:14px;margin-top:8px\\\">Single sessions for short-term work or a one-off check-in. Best when you need space to process or review progress.</p>\\n          </div>\\n          <div class=\\\"card\\\">\\n            <strong>Essentials Block</strong>\\n            <div class=\\\"price\\\">$900 / 6 sessions</div>\\n            <p style=\\\"color:var(--muted);font-size:14px;margin-top:8px\\\">A shared commitment for focused work (6 sessions). Useful for addressing a specific challenge or transition.</p>\\n          </div>\\n          <div class=\\\"card\\\">\\n            <strong>Growth Continuity</strong>\\n            <div class=\\\"price\\\">$320 / month (weekly)</div>\\n            <p style=\\\"color:var(--muted);font-size:14px;margin-top:8px\\\">Ongoing weekly sessions for deeper, relational work and skills integration. Month-to-month, cancellable with notice.</p>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"process\\\">\\n          <div class=\\\"step\\\">\\n            <strong>1. Quick Call</strong>\\n            <div style=\\\"color:var(--muted);font-size:13px;margin-top:6px\\\">15-minute consult to see if we’re a good fit.</div>\\n          </div>\\n          <div class=\\\"step\\\">\\n            <strong>2. Plan</strong>\\n            <div style=\\\"color:var(--muted);font-size:13px;margin-top:6px\\\">Choose a session type and frequency that supports your goals.</div>\\n          </div>\\n          <div class=\\\"step\\\">\\n            <strong>3. Begin</strong>\\n            <div style=\\\"color:var(--muted);font-size:13px;margin-top:6px\\\">Start sessions and review progress regularly; adjustments welcome.</div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"display:flex;gap:12px;align-items:center;margin-top:18px\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a href=\\\"contact.html\\\" style=\\\"color:var(--muted);text-decoration:none;font-weight:600\\\">Ask a question</a>\\n        </div>\\n\\n      </div>\\n      <aside class=\\\"side\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"warm shapes\\\" style=\\\"width:100%;height:140px;object-fit:cover;border-radius:8px;margin-bottom:12px\\\">\\n        <div style=\\\"font-weight:700\\\">Transparent commitments</div>\\n        <p style=\\\"color:var(--muted);font-size:14px;margin-top:8px\\\">I offer sliding scale on a limited basis. If finances are a barrier, mention it during the consult and we’ll explore options.</p>\\n\\n        <div class=\\\"testimonial\\\">\\n          <strong>Client note</strong>\\n          <blockquote style=\\\"margin:8px 0;color:var(--muted)\\\">\\\"The structure helped me feel safe and see steady progress — small, real shifts.\\\"</blockquote>\\n          <div style=\\\"font-size:13px;color:#8b7a6b\\\">— client, working on anxiety</div>\\n        </div>\\n\\n        <div class=\\\"lead-magnet\\\">\\n          <div class=\\\"pill\\\">Free guide</div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Getting Grounded: 5 First Steps</div>\\n            <p style=\\\"color:var(--muted);margin:6px 0 0;font-size:13px\\\">Download a short PDF to use before your first session.</p>\\n            <a href=\\\"book.html#lead\\\" style=\\\"font-weight:700;color:var(--accent);text-decoration:none\\\">Get it now</a>\\n          </div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2 style=\\\"margin:0 0 8px 0\\\">Who I work with and what I focus on</h2>\\n      <p style=\\\"color:var(--muted);margin:0 0 12px 0\\\">I’m an integrative clinician offering trauma-informed, relational care. I frequently support people with anxiety, burnout, complex transitions, grief, and relationship concerns.</p>\\n      <ul class=\\\"benefits\\\">\\n        <li>Warm, collaborative stance — we set goals together.</li>\\n        <li>Practical skills plus reflective space for long-term change.</li>\\n        <li>Flexible scheduling for busy lives in {{CITY}}, {{STATE}}.</li>\\n      </ul>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2 style=\\\"margin:0 0 8px 0\\\">Policies & practical details</h2>\\n      <p style=\\\"color:var(--muted);margin:0 0 12px 0\\\">Sessions are 50 minutes. Payment is due at the time of service. I accept most major credit cards; sliding scale is limited and discussed during initial consult.</p>\\n      <small class=\\\"disclaimer\\\">Insurance note: I do not bill insurance directly. I can provide a superbill upon request for out-of-network reimbursement. This is not a guarantee of reimbursement.</small>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{THERAPIST_NAME}}, {{LICENSE}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{MODALITIES}} • {{CITY}}, {{STATE}}</div>\\n        </div>\\n        <div style=\\\"text-align:right\\\">\\n          <div style=\\\"font-weight:700\\\">Contact</div>\\n          <div style=\\\"color:var(--muted);font-size:13px\\\">{{PHONE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        </div>\\n      </div>\\n      <small style=\\\"display:block;margin-top:12px;color:#8b7a6b\\\">Confidentiality: Sessions are confidential within legal and ethical limits. Crisis: If you are in immediate danger, call local emergency services or 911. This page is for informational purposes and not clinical advice.</small>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Questions</title>\\n  <style>\\n    :root{--bg:#fffaf6;--muted:#6b5b4a;--accent:#a65b2e;--card:#fff;--shadow:rgba(102,84,66,0.06);font-family:Georgia,serif}\\n    body{margin:0;background:var(--bg);color:#342a23}\\n    header{padding:20px 28px;display:flex;align-items:center;justify-content:space-between}\\n    .nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .wrap{max-width:900px;margin:24px auto;padding:12px}\\n    .hero{background:var(--card);padding:24px;border-radius:12px;box-shadow:0 8px 20px var(--shadow)}\\n    h1{margin:0 0 6px 0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial}\\n    .faq-list{margin-top:18px}\\n    .q{background:#fff;padding:14px;border-radius:10px;margin-bottom:12px;border-left:4px solid var(--accent)}\\n    .q h3{margin:0;font-size:16px}\\n    .q p{margin:8px 0 0 0;color:var(--muted)}\\n    .benefits{display:flex;gap:12px;margin-top:16px}\\n    .benefit{background:linear-gradient(180deg,#fff,#fff);padding:12px;border-radius:10px;flex:1;border:1px solid #f0e5db}\\n    .lead-magnet{margin-top:18px;padding:14px;border-radius:10px;background:linear-gradient(90deg,rgba(166,91,46,0.06),transparent)}\\n    .cta{display:inline-block;margin-top:8px;background:var(--accent);color:#fff;padding:8px 12px;border-radius:8px;text-decoration:none}\\n    footer{margin-top:22px;padding:18px;text-align:center;color:var(--muted);font-size:13px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div style=\\\"width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#f1cdb7);\\\"></div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"specialties.html\\\">Specialties</a>\\n      <a href=\\\"fees.html\\\">Fees</a>\\n      <a href=\\\"book.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <h1>Questions about starting therapy</h1>\\n      <p style=\\\"color:var(--muted);margin-top:8px\\\">Below are practical answers I offer to common questions. If you don’t see what you need, reach out — I’m happy to clarify.</p>\\n\\n      <div class=\\\"benefits\\\">\\n        <div class=\\\"benefit\\\">\\n          <strong>Who I work with</strong>\\n          <p style=\\\"color:var(--muted);margin-top:8px\\\">Adults navigating anxiety, relational shifts, trauma recovery, and life transitions. I use trauma-informed and attachment-aware approaches.</p>\\n        </div>\\n        <div class=\\\"benefit\\\">\\n          <strong>Therapeutic stance</strong>\\n          <p style=\\\"color:var(--muted);margin-top:8px\\\">Practical skills + relational reflection. We set realistic goals and check in together on progress.</p>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"faq-list\\\">\\n        <div class=\\\"q\\\">\\n          <h3>How do I know if we’re a good fit?</h3>\\n          <p>I offer a brief 15-minute consult call. We’ll talk about your goals, logistics, and whether my approach feels like a good match. There’s no obligation to continue.</p>\\n        </div>\\n\\n        <div class=\\\"q\\\">\\n          <h3>What if I need support between sessions?</h3>\\n          <p>I maintain boundaries around direct messaging outside sessions. If you need extra support, we’ll discuss safe options during the session and in crisis follow the emergency resources listed below.</p>\\n        </div>\\n\\n        <div class=\\\"q\\\">\\n          <h3>Do you work with insurance?</h3>\\n          <p>I do not bill insurance directly. I can provide a superbill with necessary codes for out-of-network reimbursement. Insurance policies vary; reimbursement is not guaranteed.</p>\\n        </div>\\n\\n        <div class=\\\"q\\\">\\n          <h3>How long before I see change?</h3>\\n          <p>Therapy timelines are individual. Some clients notice relief after a few sessions; others find deeper shifts over months. We’ll set short-term goals and review progress regularly.</p>\\n        </div>\\n\\n        <div class=\\\"q\\\">\\n          <h3>Are sessions confidential?</h3>\\n          <p>Yes. I keep session content confidential within legal and ethical limits. Mandated reporting, court orders, or imminent safety concerns are exceptions. We’ll review confidentiality in your first session.</p>\\n        </div>\\n\\n        <div class=\\\"q\\\">\\n          <h3>Do you offer telehealth?</h3>\\n          <p>I offer secure video sessions for clients in eligible regions. In-person availability may be limited; we’ll discuss your preference during the consult.</p>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"lead-magnet\\\" id=\\\"lead\\\">\\n        <div style=\\\"flex:1\\\">\\n          <strong>Free: First-Session Checklist</strong>\\n          <p style=\\\"color:var(--muted);margin-top:8px\\\">A short checklist to help you prepare for our first conversation and make the most of it.</p>\\n        </div>\\n        <div style=\\\"text-align:right\\\">\\n          <a class=\\\"cta\\\" href=\\\"book.html#lead\\\">Download</a>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:16px\\\">\\n        <a href=\\\"book.html\\\" class=\\\"cta\\\">Schedule a consult</a>\\n      </div>\\n\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin-bottom:8px\\\">A few important notes</h2>\\n      <p style=\\\"color:var(--muted)\\\">Scope and boundaries: I provide psychotherapy for adults. If you are experiencing active suicidal intent or are in immediate danger, call emergency services or 911. For crisis resources locally, please consult community hotlines.</p>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"font-weight:700\\\">{{THERAPIST_NAME}}, {{LICENSE}}</div>\\n      <div style=\\\"color:var(--muted);margin-top:6px\\\">{{MODALITIES}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <small style=\\\"display:block;margin-top:8px;color:var(--muted)\\\">Confidentiality & privacy: Your information is kept private except where disclosure is required by law. This website provides general information and is not a substitute for clinical care.</small>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff7f0;--accent:#c26a3a;--muted:#6b5b4a;--card:#fff;--shadow:rgba(110,84,66,0.06);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial}\\n    body{margin:0;background:var(--bg);color:#362c25}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 28px}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .wrap{max-width:840px;margin:20px auto;padding:18px}\\n    .hero{display:flex;gap:18px;align-items:center}\\n    .hero .left{flex:1;background:var(--card);padding:18px;border-radius:12px;box-shadow:0 10px 24px var(--shadow)}\\n    .hero h1{margin:0}\\n    .hero p{color:var(--muted);margin-top:8px}\\n    .booking{margin-top:16px;background:#fff;padding:14px;border-radius:10px;border:1px solid #f3e6dc}\\n    label{display:block;margin-top:8px;font-weight:600}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6d6c8;margin-top:6px}\\n    .btn{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;border:none;margin-top:12px;display:inline-block;text-decoration:none}\\n    .aside{width:260px}\\n    .card{background:var(--card);padding:12px;border-radius:10px;box-shadow:0 8px 18px var(--shadow)}\\n    .small{font-size:13px;color:var(--muted)}\\n    footer{margin-top:22px;padding:14px;color:var(--muted);font-size:13px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div style=\\\"width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#f2cdb9)\\\"></div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"specialties.html\\\">Services</a>\\n      <a href=\\\"fees.html\\\">Investment</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\" style=\\\"display:flex;gap:18px\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"left\\\">\\n        <h1>Schedule a first conversation</h1>\\n        <p class=\\\"small\\\">I offer a 15-minute complimentary consult to talk about what brings you here, availability, and next steps. If we decide to move forward, I’ll share intake forms to complete before our first full session.</p>\\n\\n        <div class=\\\"booking\\\">\\n          <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\">\\n            <label for=\\\"name\\\">Your name</label>\\n            <input id=\\\"name\\\" name=\\\"name\\\" required placeholder=\\\"First and last name\\\">\\n\\n            <label for=\\\"email\\\">Email</label>\\n            <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required placeholder=\\\"you@example.com\\\">\\n\\n            <label for=\\\"phone\\\">Phone (optional)</label>\\n            <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"(000) 000-0000\\\">\\n\\n            <label for=\\\"reason\\\">Primary reason for reaching out</label>\\n            <select id=\\\"reason\\\" name=\\\"reason\\\">\\n              <option>General consult</option>\\n              <option>Anxiety</option>\\n              <option>Relationship concerns</option>\\n              <option>Trauma recovery</option>\\n              <option>Life transition / burnout</option>\\n            </select>\\n\\n            <label for=\\\"notes\\\">Anything you'd like me to know before we talk?</label>\\n            <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Feel free to share goals, scheduling constraints, or questions\\\"></textarea>\\n\\n            <div style=\\\"display:flex;gap:10px;align-items:center;margin-top:12px\\\">\\n              <button class=\\\"btn\\\" type=\\\"submit\\\">Request consult</button>\\n              <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"align-self:center;text-decoration:none;color:var(--muted);font-weight:600\\\">Email me</a>\\n            </div>\\n          </form>\\n\\n          <div style=\\\"margin-top:12px\\\" class=\\\"small\\\">After you request a consult, I’ll reply within 48 hours to offer available times. If you are in crisis or immediate danger, call 911 or local emergency services.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:18px\\\">\\n          <h3 style=\\\"margin:0\\\">What to expect at the first appointment</h3>\\n          <ul style=\\\"color:var(--muted);margin-top:8px\\\">\\n            <li>A short intake conversation about history and goals.</li>\\n            <li>Discussion of confidentiality, limits, and administrative details.</li>\\n            <li>Creating an initial, collaborative plan for the next steps.</li>\\n          </ul>\\n        </div>\\n\\n      </div>\\n    </section>\\n\\n    <aside class=\\\"aside\\\">\\n      <div class=\\\"card\\\">\\n        <strong>Quick details</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Session length: 50 minutes • Sessions by video or in-person (select availability applies). Payment: card at time of service. See full fees page for options.</div>\\n        <div style=\\\"margin-top:10px\\\">\\n          <strong>Contact</strong>\\n          <div class=\\\"small\\\">{{PHONE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n        <strong>Lead resource</strong>\\n        <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">Download: \\\"Getting Grounded: 5 First Steps\\\" — a short guide to use before our first call.</p>\\n        <a href=\\\"#lead\\\" class=\\\"btn\\\" style=\\\"display:inline-block;margin-top:8px;background:#8d5a3a\\\">Download</a>\\n      </div>\\n\\n      <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n        <strong>Ethics & scope</strong>\\n        <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">I provide psychotherapy within my licensed scope. If another referral is needed, I will assist you in finding appropriate care.</p>\\n      </div>\\n    </aside>\\n  </main>\\n\\n  <footer style=\\\"max-width:840px;margin:18px auto;padding:12px\\\">\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{THERAPIST_NAME}}, {{LICENSE}}</div>\\n        <div class=\\\"small\\\">{{MODALITIES}} • {{CITY}}, {{STATE}}</div>\\n      </div>\\n      <div style=\\\"text-align:right\\\" class=\\\"small\\\">\\n        <div>Confidentiality & privacy</div>\\n        <div style=\\\"margin-top:6px\\\">Conversations here are confidential within legal and ethical limits. If you are at imminent risk, call 911 or local emergency services.</div>\\n      </div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
