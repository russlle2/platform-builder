          "text": "BUNDLE_START\n{\"path\":\"fees.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investment & Options — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--brand:#2b6cb0;--muted:#6b7280;--bg:#f7fafc;--card:#ffffff;--radius:12px;--max:980px}\\n    html,body{height:100%}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;line-height:1.5;color:#0f172a;background:var(--bg);margin:0;padding:24px;display:flex;justify-content:center}\\n    .wrap{max-width:var(--max);width:100%}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .brand h1{font-size:18px;margin:0;color:var(--brand)}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:14px;font-size:14px}\\n    main{display:grid;grid-template-columns:1fr 320px;gap:24px}\\n    .panel{background:var(--card);border-radius:var(--radius);padding:20px;box-shadow:0 6px 18px rgba(12,15,20,0.06)}\\n    .hero{display:flex;gap:18px;align-items:center}\\n    .hero svg{width:86px;height:86px;flex:0 0 86px}\\n    .hero h2{margin:0;font-size:20px;color:#0b1220}\\n    .muted{color:var(--muted);font-size:14px}\\n    .price-list{margin-top:16px;display:flex;flex-direction:column;gap:12px}\\n    .price{border-radius:10px;padding:14px;background:#f8fafc;border:1px solid #e6eef8}\\n    .price h3{margin:0;font-size:16px}\\n    .price p{margin:6px 0 0;color:var(--muted);font-size:14px}\\n    .cta{display:inline-block;margin-top:14px;padding:10px 14px;background:var(--brand);color:#fff;border-radius:10px;text-decoration:none}\\n    .note{font-size:13px;color:#334155;margin-top:12px}\\n    .sidebar .card{display:flex;flex-direction:column;gap:8px}\\n    footer{margin-top:18px;font-size:13px;color:var(--muted)}\\n    /* small responsive */\\n    @media (max-width:880px){main{grid-template-columns:1fr} .hero svg{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <svg viewBox=\\\"0 0 48 48\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n          <rect x=\\\"2\\\" y=\\\"2\\\" width=\\\"44\\\" height=\\\"44\\\" rx=\\\"10\\\" fill=\\\"#e6f0fb\\\"/>\\n          <path d=\\\"M12 30c2-6 6-10 10-10s8 4 10 10\\\" stroke=\\\"#2b6cb0\\\" stroke-width=\\\"2.5\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/>\\n          <circle cx=\\\"24\\\" cy=\\\"14\\\" r=\\\"3\\\" fill=\\\"#2b6cb0\\\"/>\\n        </svg>\\n        <h1>{{BUSINESS_NAME}}</h1>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"specialties.html\\\">Areas</a>\\n        <a href=\\\"approach.html\\\">Approach</a>\\n        <a href=\\\"fees.html\\\">Invest</a>\\n        <a href=\\\"faq.html\\\">Questions</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"panel\\\">\\n        <div class=\\\"hero\\\">\\n          <!-- unique hero svg for fees page -->\\n          <svg viewBox=\\\"0 0 120 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n            <rect width=\\\"120\\\" height=\\\"120\\\" rx=\\\"16\\\" fill=\\\"#f1f9ff\\\"/>\\n            <path d=\\\"M18 86c8-20 30-36 48-36s40 16 48 36\\\" stroke=\\\"#69a5e0\\\" stroke-width=\\\"4\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/>\\n            <circle cx=\\\"48\\\" cy=\\\"48\\\" r=\\\"10\\\" fill=\\\"#2b6cb0\\\"/>\\n          </svg>\\n          <div>\\n            <h2>Investment & Scheduling — clear options for care</h2>\\n            <div class=\\\"muted\\\">Thoughtfully structured offerings so you can choose what fits your needs and life.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"price-list\\\">\\n          <div class=\\\"price\\\">\\n            <h3>Single Session — \\\"Clarifying Session\\\"</h3>\\n            <p class=\\\"muted\\\">60 minutes. For first-time or intermittent visits. Recommended when you want practical focus for one concern.</p>\\n            <div class=\\\"note\\\">$165 (telehealth or clinic)</div>\\n          </div>\\n\\n          <div class=\\\"price\\\">\\n            <h3>Short Block — \\\"Stability Block\\\" (4 sessions)</h3>\\n            <p class=\\\"muted\\\">An introductory block to work on a targeted pattern or transition. Sessions typically weekly.</p>\\n            <div class=\\\"note\\\">4 sessions — $600 (save $60)</div>\\n          </div>\\n\\n          <div class=\\\"price\\\">\\n            <h3>Focused Intensive — \\\"VIP Day\\\"</h3>\\n            <p class=\\\"muted\\\">An extended, concentrated session for accelerated planning or deeper work in a single day. Includes pre- and post-session coordination.</p>\\n            <div class=\\\"note\\\">6-hour day — $1150 (limited availability)</div>\\n          </div>\\n\\n          <div class=\\\"price\\\">\\n            <h3>Ongoing Therapy — \\\"Continuing Care\\\"</h3>\\n            <p class=\\\"muted\\\">Weekly or every-other-week sessions to support longer-term change and integration.</p>\\n            <div class=\\\"note\\\">$150 per 50-min session | Monthly billing available</div>\\n          </div>\\n        </div>\\n\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n\\n        <p class=\\\"note\\\">Sliding scale available for a limited number of slots. If cost is a barrier, please mention this when you reach out so we can discuss options.</p>\\n\\n        <h4 style=\\\"margin-top:16px\\\">Insurance & Payment</h4>\\n        <p class=\\\"muted\\\">I do not bill insurance directly. I can provide a monthly superbill you may submit to your carrier for potential reimbursement when using out-of-network benefits. Payments accepted: major credit cards, HSA/FSA, and secure invoicing.</p>\\n\\n        <h4 style=\\\"margin-top:12px\\\">Scheduling, Cancellation & Missed Session Policy</h4>\\n        <p class=\\\"muted\\\">Please provide at least 48 hours' notice to cancel or reschedule. Cancellations within 24 hours or missed appointments may be charged 50–100% of the session fee, depending on circumstances. Exceptions are considered for emergencies.</p>\\n\\n        <div class=\\\"note\\\">Licensed clinician: {{THERAPIST_NAME}}, {{LICENSE}}. Practice located in {{CITY}}, {{STATE}}.</div>\\n\\n      </section>\\n\\n      <aside class=\\\"panel sidebar\\\">\\n        <div class=\\\"card\\\">\\n          <strong>What this covers</strong>\\n          <div class=\\\"muted\\\">Anxiety, trauma recovery, relationship challenges, life transitions, burnout, identity & self-esteem work.</div>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <strong>Intro call</strong>\\n          <div class=\\\"muted\\\">A brief 15-minute intake call to see if we’re a fit — no obligation. Use the Book link.</div>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\" style=\\\"display:inline-block;padding:8px 12px;margin-top:8px\\\">Request a call</a>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <strong>Privacy & scope</strong>\\n          <div class=\\\"muted\\\">All sessions are confidential within legal and ethical limits. I do not provide emergency/crisis services. If you are in immediate danger, call emergency services or your local crisis line.</div>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <strong>Contact</strong>\\n          <div class=\\\"muted\\\">Phone: {{PHONE}}<br>Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        </div>\\n\\n      </aside>\\n    </main>\\n\\n    <footer class=\\\"muted\\\">Clinical notes: therapy is supportive and not a guarantee of outcomes. Confidentiality is respected and maintained except where safety or legal requirements apply (duty to warn, risk of harm, abuse reporting).</footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Common Questions — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#2362a3;--soft:#f3f7fb;--text:#0f172a}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--soft);margin:0;padding:28px;color:var(--text)}\\n    .container{max-width:900px;margin:0 auto}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}\\n    nav a{margin-left:12px;color:#475569;text-decoration:none;font-size:14px}\\n    .hero{background:#fff;padding:22px;border-radius:12px;box-shadow:0 8px 20px rgba(10,15,25,0.06);display:flex;gap:16px}\\n    .hero svg{width:72px;height:72px}\\n    .hero h2{margin:0;font-size:20px}\\n    .lead{color:#475569;margin-top:8px}\\n    section.card{margin-top:18px;background:#fff;padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(10,15,25,0.04)}\\n    .q{font-weight:600;margin:0}\\n    .a{margin:8px 0 14px;color:#334155}\\n    .muted{color:#64748b;font-size:13px}\\n    .download{display:flex;gap:12px;align-items:center;margin-top:14px}\\n    .btn{background:var(--accent);color:#fff;padding:10px 12px;border-radius:10px;text-decoration:none}\\n    footer{margin-top:18px;font-size:13px;color:#64748b}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div>\\n        <h1 style=\\\"margin:0\\\">{{BUSINESS_NAME}}</h1>\\n        <div class=\\\"muted\\\">Helping thoughtful people build steadier lives</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">Meet</a>\\n        <a href=\\\"specialties.html\\\">Specialties</a>\\n        <a href=\\\"approach.html\\\">How I Work</a>\\n        <a href=\\\"fees.html\\\">Fees</a>\\n        <a href=\\\"faq.html\\\">FAQ</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n        <a href=\\\"contact.html\\\">Reach</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"hero\\\">\\n      <!-- unique avatar svg for faq page -->\\n      <svg viewBox=\\\"0 0 100 100\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n        <circle cx=\\\"50\\\" cy=\\\"50\\\" r=\\\"48\\\" fill=\\\"#eef6ff\\\"/>\\n        <circle cx=\\\"50\\\" cy=\\\"36\\\" r=\\\"12\\\" fill=\\\"#1f6fb4\\\"/>\\n        <path d=\\\"M28 78c6-10 18-16 22-16s16 6 22 16\\\" stroke=\\\"#7fb0df\\\" stroke-width=\\\"3\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/>\\n      </svg>\\n      <div>\\n        <h2>Questions I often hear</h2>\\n        <p class=\\\"lead\\\">Clear answers about process, privacy, and what to expect. If your question isn't below, reach out — I’m happy to clarify.</p>\\n      </div>\\n    </div>\\n\\n    <section class=\\\"card\\\">\\n      <p class=\\\"q\\\">How do I know therapy is the right step?</p>\\n      <p class=\\\"a\\\">You might consider therapy if longstanding patterns cause distress, relationships are strained, or life transitions feel overwhelming. An initial session is a chance to explore fit and goals; there is no obligation to continue.</p>\\n\\n      <p class=\\\"q\\\">What is a first session like?</p>\\n      <p class=\\\"a\\\">The first visit (50–60 minutes) is an assessment and collaborative planning conversation. We discuss your history, current concerns, and practical goals. If we proceed, we agree on frequency and a tentative plan.</p>\\n\\n      <p class=\\\"q\\\">Do you take insurance?</p>\\n      <p class=\\\"a\\\">I do not bill insurance directly. I can provide a superbill you may submit to your carrier for possible out-of-network reimbursement. Payment methods are listed on the Fees page.</p>\\n\\n      <p class=\\\"q\\\">Are sessions confidential?</p>\\n      <p class=\\\"a\\\">Yes. Notes and communications are kept private except where disclosure is required by law (imminent risk of harm to self/others, child or elder abuse) or a valid court order. We can discuss limits to confidentiality during intake.</p>\\n\\n      <p class=\\\"q\\\">Can I do telehealth?</p>\\n      <p class=\\\"a\\\">Yes. I offer secure telehealth visits and in-person sessions by appointment. Some intensive or assessment work may be recommended in person depending on needs.</p>\\n\\n      <p class=\\\"q\\\">What if I'm in crisis?</p>\\n      <p class=\\\"a\\\">I do not provide emergency services. If you are in immediate danger, call 911 or your local emergency number. For non-immediate crises, local crisis lines and emergency mental health services can provide support. If you disclose serious intent or plan, I will follow applicable safety protocols.</p>\\n\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:16px\\\">\\n      <h3 style=\\\"margin:0\\\">A short guide: Getting the Most From Sessions</h3>\\n      <p class=\\\"muted\\\">A concise one-page guide with practical tips to prepare for your first three sessions: what to bring, how to set goals, and ways to make the work effective.</p>\\n      <div class=\\\"download\\\">\\n        <svg width=\\\"48\\\" height=\\\"48\\\" viewBox=\\\"0 0 48 48\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n          <rect width=\\\"48\\\" height=\\\"48\\\" rx=\\\"8\\\" fill=\\\"#f0f7ff\\\"/>\\n          <path d=\\\"M14 24h20M24 16v16\\\" stroke=\\\"#2b6cb0\\\" stroke-width=\\\"2.5\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/>\\n        </svg>\\n        <div>\\n          <a class=\\\"btn\\\" href=\\\"#\\\" onclick=\\\"alert('Download link placeholder — please contact {{EMAIL}}')\\\">Download the guide</a>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">No spam. Just practical guidance you can use immediately.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer class=\\\"muted\\\">Scope & boundaries: I provide psychotherapy for adults focusing on anxiety, trauma recovery, relationships, life transitions, and burnout. This practice does not offer forensic evaluations or emergency/crisis care.</footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a Session — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--brand:#1f6fb4;--bg:#ffffff;--card:#fbfdff;--muted:#6b7280}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;margin:0;background:#f7fafc;color:#0b1220}\\n    .wrap{max-width:900px;margin:28px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .lead{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 12px 30px rgba(12,15,20,0.04);display:flex;gap:16px;align-items:center;margin-top:18px}\\n    .lead svg{width:84px;height:84px}\\n    .lead h2{margin:0}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:18px}\\n    .panel{background:#fff;padding:18px;border-radius:12px;box-shadow:0 6px 20px rgba(12,15,20,0.04)}\\n    label{display:block;margin-top:10px;font-size:14px}\\n    input,textarea,select{width:100%;padding:10px;border-radius:8px;border:1px solid #e6eef8;margin-top:6px}\\n    .btn{display:inline-block;background:var(--brand);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;margin-top:12px}\\n    .muted{color:var(--muted);font-size:13px}\\n    .small{font-size:13px;color:#475569}\\n    @media (max-width:880px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <h1 style=\\\"margin:0\\\">{{BUSINESS_NAME}}</h1>\\n        <div class=\\\"small\\\">{{TAGLINE}}</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"specialties.html\\\">Paths</a>\\n        <a href=\\\"approach.html\\\">Method</a>\\n        <a href=\\\"fees.html\\\">Invest</a>\\n        <a href=\\\"faq.html\\\">FAQ</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"lead\\\">\\n      <!-- unique pattern svg for booking page -->\\n      <svg viewBox=\\\"0 0 120 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n        <rect x=\\\"4\\\" y=\\\"4\\\" width=\\\"112\\\" height=\\\"112\\\" rx=\\\"14\\\" fill=\\\"#eef9ff\\\"/>\\n        <g fill=\\\"#1f6fb4\\\" opacity=\\\"0.9\\\">\\n          <circle cx=\\\"36\\\" cy=\\\"36\\\" r=\\\"6\\\"/>\\n          <circle cx=\\\"84\\\" cy=\\\"36\\\" r=\\\"5\\\"/>\\n          <circle cx=\\\"60\\\" cy=\\\"78\\\" r=\\\"7\\\"/>\\n        </g>\\n      </svg>\\n      <div>\\n        <h2>Reserve a time — simple next steps</h2>\\n        <div class=\\\"muted\\\">Choose an introductory conversation or schedule an intake. If you’re unsure which option fits, use the short call request.</div>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"grid\\\">\\n      <div class=\\\"panel\\\">\\n        <h3 style=\\\"margin:0\\\">Booking form</h3>\\n        <p class=\\\"muted\\\">I will reply within 48 business hours with availability. This form is used to coordinate scheduling; it does not create a therapeutic relationship until a session is confirmed.</p>\\n\\n        <form id=\\\"booking\\\" onsubmit=\\\"event.preventDefault();alert('Request sent — this is a placeholder. Contact: '+document.getElementById('email').value+'')\\\">\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" required>\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required>\\n\\n          <label for=\\\"phone\\\">Phone</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" type=\\\"tel\\\">\\n\\n          <label for=\\\"service\\\">I am requesting</label>\\n          <select id=\\\"service\\\" name=\\\"service\\\">\\n            <option>Introductory 15-minute phone consult</option>\\n            <option>Initial intake — 60 minutes</option>\\n            <option>Therapy session — 50 minutes</option>\\n            <option>VIP/day intensive (limited availability)</option>\\n          </select>\\n\\n          <label for=\\\"notes\\\">Brief notes (reason for seeking support, preferences, any accessibility needs)</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\"></textarea>\\n\\n          <label><input type=\\\"checkbox\\\" required> I understand this request is for scheduling and is not an emergency service.</label>\\n\\n          <button class=\\\"btn\\\" type=\\\"submit\\\">Request appointment</button>\\n        </form>\\n\\n        <div style=\\\"margin-top:14px\\\" class=\\\"muted\\\">\\n          Typical reply time: within 2 business days. If you need urgent help, call emergency services or your local crisis number. If you are in {{STATE}} or {{CITY}} and seek immediate support, dial your local emergency line.\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"panel\\\">\\n        <h4 style=\\\"margin:0\\\">What to expect next</h4>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">After you request, you'll receive an email confirming options and the next available appointment. The first confirmed appointment includes a brief intake and consent forms to review prior to your session.</div>\\n\\n        <h4 style=\\\"margin-top:12px\\\">Preparing for your intake</h4>\\n        <ul style=\\\"padding-left:18px;color:#334155\\\">\\n          <li>Have a private, comfortable space for telehealth visits.</li>\\n          <li>Think briefly about your goals for therapy (what would feel different?).</li>\\n          <li>List any current medications or providers you want to coordinate with.</li>\\n        </ul>\\n\\n        <h4 style=\\\"margin-top:12px\\\">Payments & paperwork</h4>\\n        <div class=\\\"muted\\\">You will receive a secure invoice for your first session. Paperwork (consent, privacy notice) is handled electronically before the session. If cost is a concern, mention it in your form; limited sliding-scale options exist.</div>\\n\\n        <h4 style=\\\"margin-top:12px\\\">Confidentiality & limits</h4>\\n        <div class=\\\"muted\\\">All clinical communications are confidential except where disclosure is mandated by law (safety concerns, abuse reporting, court order). I will review these limits with you during intake.</div>\\n\\n        <div style=\\\"margin-top:12px\\\"><strong>Contact</strong><div class=\\\"muted\\\">Phone: {{PHONE}}<br>Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div></div>\\n      </aside>\\n    </div>\\n\\n    <div style=\\\"margin-top:18px\\\" class=\\\"panel\\\">\\n      <h4 style=\\\"margin:0\\\">Consent & scope note</h4>\\n      <p class=\\\"muted\\\">By requesting an appointment you acknowledge that therapy is a collaborative process without guaranteed outcomes. I work with adults on anxiety, trauma recovery, relationships, life transitions, and burnout. For immediate danger or crisis, contact emergency services. Licensing: {{THERAPIST_NAME}}, {{LICENSE}}.</p>\\n    </div>\\n\\n    <footer style=\\\"margin-top:14px;color:var(--muted);font-size:13px\\\">If you have questions about accessibility, languages offered, or coordination with other providers, include that in the form. For direct scheduling, call {{PHONE}}.</footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
