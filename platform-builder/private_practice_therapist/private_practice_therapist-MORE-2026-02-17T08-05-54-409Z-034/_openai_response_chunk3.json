          "text": "BUNDLE_START\n{\"path\":\"fees.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Fees — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--brand:#6b46c1;--muted:#6b7280;--card:#fff;--bg:#f7f7fb;--accent:#ffb86b}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:#0f172a}\\n    .wrap{max-width:980px;margin:28px auto;padding:28px}\\n    header{display:flex;align-items:center;gap:18px}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--brand),#b794f4);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav{margin-left:auto}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:12px;font-weight:600}\\n    h1{margin:18px 0 6px;font-size:28px}\\n    .lede{color:var(--muted);margin-bottom:22px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\\n    .card{background:var(--card);border-radius:12px;padding:18px;box-shadow:0 6px 18px rgba(16,24,40,0.06)}\\n    .price{font-size:20px;font-weight:700;color:var(--brand)}\\n    .tag{display:inline-block;margin-top:8px;padding:6px 8px;background:linear-gradient(90deg,var(--accent),#ffd3a5);border-radius:8px;font-weight:700}\\n    .muted{color:var(--muted);font-size:14px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;background:var(--brand);color:#fff;border-radius:10px;text-decoration:none}\\n    .notes{margin-top:14px;font-size:13px;color:var(--muted)}\\n    .accordion{margin-top:22px}\\n    .acc-btn{width:100%;text-align:left;padding:14px;border-radius:10px;border:1px solid #e6e9ef;background:white;display:flex;justify-content:space-between;align-items:center;font-weight:700}\\n    .acc-panel{padding:12px 14px;border-left:1px solid #eee;border-right:1px solid #eee;border-bottom:1px solid #eee;border-radius:0 0 10px 10px;background:#fff;margin-top:6px}\\n    footer{margin-top:28px;padding:18px;border-radius:10px;background:#fff;color:var(--muted)}\\n    .decor{position:fixed;right:8px;bottom:8px;opacity:0.08}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"logo\\\">TP</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"muted\\\">{{TAGLINE}}</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"about.html\\\">My Story</a>\\n        <a href=\\\"specialties.html\\\">Focus Areas</a>\\n        <a href=\\\"approach.html\\\">How I Work</a>\\n        <a href=\\\"fees.html\\\">Fees</a>\\n        <a href=\\\"faq.html\\\">Questions</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a href=\\\"contact.html\\\">Get in Touch</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <h1>Investment & options</h1>\\n      <p class=\\\"lede\\\">Therapy that fits the hours in your day and the rhythms of your life. Below are common ways people book time with me — if none of these feel right, we can design something together.</p>\\n\\n      <section class=\\\"grid\\\">\\n        <div class=\\\"card\\\">\\n          <div style=\\\"font-size:13px;color:var(--muted);font-weight:700\\\">Compass Session</div>\\n          <div class=\\\"price\\\">$160 / 50 min</div>\\n          <div class=\\\"muted\\\">A single session for a clear conversation and practical next steps.</div>\\n          <div class=\\\"tag\\\">Pay per visit</div>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <div style=\\\"font-size:13px;color:var(--muted);font-weight:700\\\">Anchor Series</div>\\n          <div class=\\\"price\\\">$900 / 6 sessions</div>\\n          <div class=\\\"muted\\\">A 6-session plan for steady momentum and reviewable goals.</div>\\n          <div class=\\\"tag\\\">Plan pricing</div>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}?plan=anchor\\\">Start an Anchor</a>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <div style=\\\"font-size:13px;color:var(--muted);font-weight:700\\\">Focused Reset</div>\\n          <div class=\\\"price\\\">$360 / 90 min</div>\\n          <div class=\\\"muted\\\">A longer, concentrated session to reframe a specific challenge.</div>\\n          <div class=\\\"tag\\\">Intensive</div>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}?plan=reset\\\">Book a Reset</a>\\n        </div>\\n      </section>\\n\\n      <div class=\\\"notes\\\">Insurance: I do not bill insurance directly. I can provide a monthly receipt you may submit to your carrier. Sliding scale may be possible in limited circumstances; contact me for a brief consult.</div>\\n\\n      <section class=\\\"accordion\\\" aria-labelledby=\\\"policy\\\">\\n        <h2 id=\\\"policy\\\" style=\\\"margin-top:22px\\\">Session limits, confidentiality, and scope</h2>\\n\\n        <div>\\n          <button class=\\\"acc-btn\\\" aria-expanded=\\\"false\\\" aria-controls=\\\"panel1\\\">What to expect in a session <span class=\\\"muted\\\">▾</span></button>\\n          <div id=\\\"panel1\\\" class=\\\"acc-panel\\\" hidden>\\n            <p class=\\\"muted\\\">Sessions are typically 50 minutes, focused on reflection and practical steps. I work collaboratively; we clarify goals and use evidence-informed approaches suited to your priorities. Therapy is not a guarantee of specific outcomes — progress varies by person and circumstances.</p>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:8px\\\">\\n          <button class=\\\"acc-btn\\\" aria-expanded=\\\"false\\\" aria-controls=\\\"panel2\\\">Confidentiality & limits <span class=\\\"muted\\\">▾</span></button>\\n          <div id=\\\"panel2\\\" class=\\\"acc-panel\\\" hidden>\\n            <p class=\\\"muted\\\">Conversations are confidential within the bounds of law and ethical practice. Exceptions may include imminent risk of harm to self or others, suspicion of abuse of a dependent adult or child, or court order. If you have concerns about privacy or recording, please bring them up before sessions begin.</p>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:8px\\\">\\n          <button class=\\\"acc-btn\\\" aria-expanded=\\\"false\\\" aria-controls=\\\"panel3\\\">Scope of care <span class=\\\"muted\\\">▾</span></button>\\n          <div id=\\\"panel3\\\" class=\\\"acc-panel\\\" hidden>\\n            <p class=\\\"muted\\\">My practice focuses on talk therapy: exploring thoughts, emotions, and behavior patterns and developing practical strategies. I do not provide emergency services, pharmacologic management, or forensic evaluations. If you need immediate medical advice or a medication review, I will help you connect with the appropriate provider.</p>\\n          </div>\\n        </div>\\n\\n      </section>\\n\\n      <footer>\\n        <div style=\\\"font-weight:700\\\">If you are in crisis</div>\\n        <div class=\\\"muted\\\">If you are an immediate danger to yourself or others, call emergency services or your local crisis line. For the U.S., you may dial 988 for the Suicide & Crisis Lifeline. For urgent clinical help, call your primary emergency number. If you are outside {{CITY}}, {{STATE}} please use local emergency resources.</div>\\n        <div style=\\\"margin-top:8px;font-size:13px\\\">Questions about fees or availability? Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</div>\\n      </footer>\\n    </main>\\n  </div>\\n\\n  <svg class=\\\"decor\\\" width=\\\"120\\\" height=\\\"120\\\" viewBox=\\\"0 0 100 100\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <pattern id=\\\"p1\\\" width=\\\"10\\\" height=\\\"10\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"10\\\" height=\\\"10\\\" fill=\\\"#fff\\\" />\\n        <circle cx=\\\"2\\\" cy=\\\"2\\\" r=\\\"1.6\\\" fill=\\\"#e9d8fd\\\" />\\n        <circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"1.6\\\" fill=\\\"#fbd38d\\\" />\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100\\\" height=\\\"100\\\" fill=\\\"url(#p1)\\\" rx=\\\"12\\\" />\\n  </svg>\\n\\n  <script>\\n    // Simple accessible accordion\\n    document.querySelectorAll('.acc-btn').forEach(function(btn){\\n      btn.addEventListener('click', function(){\\n        var expanded = btn.getAttribute('aria-expanded') === 'true';\\n        var panel = document.getElementById(btn.getAttribute('aria-controls'));\\n        btn.setAttribute('aria-expanded', String(!expanded));\\n        if(!expanded){ panel.hidden = false; } else { panel.hidden = true; }\\n      });\\n    });\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>FAQ — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfbfe;--ink:#0f172a;--muted:#64748b;--accent:#6b46c1}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;background:var(--bg);color:var(--ink)}\\n    .wrap{max-width:900px;margin:34px auto;padding:26px}\\n    header{display:flex;gap:16px;align-items:center}\\n    .logo{width:52px;height:52px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#8b5cf6);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav{margin-left:auto}\\n    nav a{color:var(--muted);margin-left:12px;text-decoration:none;font-weight:600}\\n    h1{margin-top:18px}\\n    .q{margin-top:14px}\\n    .qa{background:#fff;padding:14px;border-radius:10px;box-shadow:0 8px 20px rgba(15,23,42,0.04)}\\n    .q button{width:100%;text-align:left;border:0;background:transparent;padding:8px;font-weight:700;cursor:pointer}\\n    .a{color:var(--muted);padding:8px 2px}\\n    .small{font-size:13px;color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"logo\\\">TP</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"small\\\">Care offered in {{CITY}}, {{STATE}}</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"about.html\\\">My Story</a>\\n        <a href=\\\"specialties.html\\\">Focus Areas</a>\\n        <a href=\\\"approach.html\\\">How I Work</a>\\n        <a href=\\\"fees.html\\\">Fees</a>\\n        <a href=\\\"faq.html\\\">Questions</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a href=\\\"contact.html\\\">Get in Touch</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <h1>Frequently asked questions</h1>\\n      <p class=\\\"small\\\">Below you'll find practical answers about sessions, privacy, and how I approach care. If your question isn’t listed, reach out — I welcome short intro calls to see if we’re a good fit.</p>\\n\\n      <section class=\\\"q\\\">\\n        <div class=\\\"qa\\\">\\n          <button aria-expanded=\\\"false\\\" aria-controls=\\\"ans1\\\">How long does a session last?</button>\\n          <div id=\\\"ans1\\\" class=\\\"a\\\" hidden>Most sessions are 50 minutes. Longer sessions (e.g., 90 minutes) are available for a focused reset. We’ll talk about timing on our first visit and adjust as needed.</div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"q\\\">\\n        <div class=\\\"qa\\\">\\n          <button aria-expanded=\\\"false\\\" aria-controls=\\\"ans2\\\">Do you take insurance?</button>\\n          <div id=\\\"ans2\\\" class=\\\"a\\\" hidden>I do not bill insurance directly. I provide a receipt (superbill) you may submit to your insurer. If you’d like help navigating that process, I’ll explain what the receipt includes.</div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"q\\\">\\n        <div class=\\\"qa\\\">\\n          <button aria-expanded=\\\"false\\\" aria-controls=\\\"ans3\\\">What is your approach?</button>\\n          <div id=\\\"ans3\\\" class=\\\"a\\\" hidden>My work blends thoughtful listening with practical tools. I draw from several evidence-informed approaches and tailor them to your situation, always attending to safety, values, and the realities of your life.</div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"q\\\">\\n        <div class=\\\"qa\\\">\\n          <button aria-expanded=\\\"false\\\" aria-controls=\\\"ans4\\\">How do cancellations work?</button>\\n          <div id=\\\"ans4\\\" class=\\\"a\\\" hidden>Generally I appreciate at least 48 hours’ notice. Late cancellations or missed sessions may be billed; if life intervenes, please contact me and we’ll discuss options.</div>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px\\\">\\n        <h2 style=\\\"margin-bottom:8px\\\">Confidentiality, limits, and safety</h2>\\n        <div class=\\\"qa\\\">\\n          <button aria-expanded=\\\"false\\\" aria-controls=\\\"policyA\\\">Privacy and limits of confidentiality</button>\\n          <div id=\\\"policyA\\\" class=\\\"a\\\" hidden>What we discuss is private within the limits required by law and professional ethics. Those limits include situations of imminent danger to self or others, suspected abuse, or court orders. If you have specific privacy concerns, we can address them directly before beginning care.</div>\\n        </div>\\n\\n        <div class=\\\"qa\\\" style=\\\"margin-top:8px\\\">\\n          <button aria-expanded=\\\"false\\\" aria-controls=\\\"policyB\\\">Scope and emergency care</button>\\n          <div id=\\\"policyB\\\" class=\\\"a\\\" hidden>I provide psychotherapy and will help coordinate referrals when appropriate. I do not provide emergency services; if you are in immediate danger, call emergency services or your local crisis line. For U.S. callers, 988 connects you to the Suicide & Crisis Lifeline.</div>\\n        </div>\\n      </section>\\n\\n      <div style=\\\"margin-top:18px;color:var(--muted);font-size:14px\\\">Still have a question? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> for a brief introductory conversation.</div>\\n\\n    </main>\\n  </div>\\n\\n  <script>\\n    document.querySelectorAll('.qa button').forEach(function(btn){\\n      btn.addEventListener('click', function(){\\n        var id = btn.getAttribute('aria-controls');\\n        var panel = document.getElementById(id);\\n        var open = btn.getAttribute('aria-expanded') === 'true';\\n        btn.setAttribute('aria-expanded', String(!open));\\n        panel.hidden = open;\\n      });\\n    });\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff9fb;--brand:#6b46c1;--ink:#0f172a;--muted:#6b7280}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;background:var(--bg);color:var(--ink)}\\n    .wrap{max-width:940px;margin:28px auto;padding:26px}\\n    header{display:flex;gap:16px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--brand),#9f7aea);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav{margin-left:auto}\\n    nav a{color:var(--muted);margin-left:12px;text-decoration:none;font-weight:600}\\n    h1{margin-top:18px}\\n    .lead{color:var(--muted);margin-bottom:18px}\\n\\n    .panel{display:flex;gap:20px}\\n    .left{flex:1}\\n    .right{width:320px;background:#fff;padding:16px;border-radius:12px;box-shadow:0 10px 30px rgba(15,23,42,0.06)}\\n\\n    .mood{display:flex;flex-direction:column;gap:10px}\\n    .mood button{padding:10px;border-radius:10px;border:1px solid #eee;background:white;text-align:left;cursor:pointer}\\n    .mood button.active{border-color:var(--brand);box-shadow:0 6px 18px rgba(107,70,193,0.12)}\\n\\n    .rec{padding:12px;border-radius:10px;background:linear-gradient(180deg,#fff,#fbf8ff);margin-top:12px}\\n    .rec h3{margin:0 0 6px}\\n    .rec p{margin:0;color:var(--muted)}\\n\\n    .book-cta{display:inline-block;margin-top:12px;padding:10px 14px;background:var(--brand);color:#fff;border-radius:10px;text-decoration:none}\\n    .note{font-size:13px;color:var(--muted);margin-top:10px}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"logo\\\">TP</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"lead\\\">{{TAGLINE}}</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"about.html\\\">My Story</a>\\n        <a href=\\\"specialties.html\\\">Focus Areas</a>\\n        <a href=\\\"approach.html\\\">How I Work</a>\\n        <a href=\\\"fees.html\\\">Fees</a>\\n        <a href=\\\"faq.html\\\">Questions</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a href=\\\"contact.html\\\">Get in Touch</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <h1>Find the right first step</h1>\\n      <p class=\\\"lead\\\">Choose the description that fits how you feel right now. The site will suggest a way of working and update the booking button to match that pace.</p>\\n\\n      <div class=\\\"panel\\\">\\n        <div class=\\\"left\\\">\\n          <div class=\\\"mood\\\" role=\\\"list\\\">\\n            <button data-key=\\\"overwhelmed\\\" class=\\\"active\\\" aria-pressed=\\\"true\\\">Overwhelmed — too many things pulling at once</button>\\n            <button data-key=\\\"stuck\\\" aria-pressed=\\\"false\\\">Stuck — repeating patterns that frustrate you</button>\\n            <button data-key=\\\"anxious\\\" aria-pressed=\\\"false\\\">Anxious — frequent worry or tension</button>\\n            <button data-key=\\\"decision\\\" aria-pressed=\\\"false\\\">Decision point — need clarity for a choice</button>\\n            <button data-key=\\\"reset\\\" aria-pressed=\\\"false\\\">Want a focused reset — single concentrated session</button>\\n          </div>\\n\\n          <div class=\\\"rec\\\" id=\\\"recommendation\\\">\\n            <h3>Recommendation</h3>\\n            <p class=\\\"muted\\\">A clear path will appear here when you choose a mood.</p>\\n          </div>\\n\\n          <div style=\\\"margin-top:14px\\\" class=\\\"note\\\">If the choice above doesn't quite fit, pick the nearest one and we'll adapt the first meetings to your needs.</div>\\n        </div>\\n\\n        <aside class=\\\"right\\\">\\n          <div style=\\\"font-weight:700\\\">Booking</div>\\n          <div style=\\\"margin-top:8px;color:var(--muted)\\\">Suggested session and next steps update as you choose a mood. The button will open the same booking link but pre-fills a suggested approach (where supported).</div>\\n\\n          <div id=\\\"side-rec\\\" class=\\\"rec\\\" style=\\\"margin-top:14px\\\">\\n            <h3 id=\\\"side-title\\\">Compass Session</h3>\\n            <p id=\\\"side-desc\\\" class=\\\"muted\\\">Standard 50-minute visit to begin exploring priorities and plan next steps.</p>\\n            <div id=\\\"side-price\\\" style=\\\"margin-top:10px;font-weight:700;color:var(--brand)\\\">$160</div>\\n            <a id=\\\"book-btn\\\" class=\\\"book-cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n            <div class=\\\"note\\\">I do not offer emergency services. If you are in immediate danger, call your local emergency number or your local crisis line.</div>\\n          </div>\\n        </aside>\\n      </div>\\n\\n      <section style=\\\"margin-top:22px\\\">\\n        <h2 style=\\\"margin-bottom:8px\\\">Session boundaries, confidentiality, and safety</h2>\\n        <div class=\\\"rec\\\">\\n          <p class=\\\"muted\\\">My practice maintains confidentiality to the fullest extent permitted by law. Exceptions include suspected abuse, imminent risk of harm to yourself or others, and legal orders. I do not prescribe medications or provide emergency care. If you need immediate medical or emergency help, call your local emergency number.</p>\\n        </div>\\n      </section>\\n\\n    </main>\\n  </div>\\n\\n  <script>\\n    // Mood-to-Method mapping\\n    const map = {\\n      overwhelmed: {\\n        title: 'Short course: Anchor Series',\\n        desc: 'A 6-session plan to create steadier routines, prioritize what matters, and reduce day-to-day overload.',\\n        price: '$900 / 6 sessions',\\n        cta: 'Start an Anchor',\\n        href: '{{PRIMARY_CTA_URL}}?plan=anchor'\\n      },\\n      stuck: {\\n        title: 'Ongoing sessions',\\n        desc: 'Regular 50-minute sessions to notice patterns and practice different responses over time.',\\n        price: '$160 / session',\\n        cta: 'Book Regular Sessions',\\n        href: '{{PRIMARY_CTA_URL}}?plan=regular'\\n      },\\n      anxious: {\\n        title: 'Short tools series',\\n        desc: 'A focused set of meetings to develop practical strategies for managing worry and tension.',\\n        price: '$640 / 4 sessions',\\n        cta: 'Try a Tools Series',\\n        href: '{{PRIMARY_CTA_URL}}?plan=tools'\\n      },\\n      decision: {\\n        title: 'Focused Reset',\\n        desc: 'A 90-minute concentrated session to organize thinking and map options for a decision point.',\\n        price: '$360 / 90 min',\\n        cta: 'Book a Focused Reset',\\n        href: '{{PRIMARY_CTA_URL}}?plan=reset'\\n      },\\n      reset: {\\n        title: 'Focused Reset',\\n        desc: 'A 90-minute concentrated session for a deep, practical check-in and next steps.',\\n        price: '$360 / 90 min',\\n        cta: 'Book a Reset',\\n        href: '{{PRIMARY_CTA_URL}}?plan=reset'\\n      }\\n    };\\n\\n    const buttons = Array.from(document.querySelectorAll('.mood button'));\\n    const sideTitle = document.getElementById('side-title');\\n    const sideDesc = document.getElementById('side-desc');\\n    const sidePrice = document.getElementById('side-price');\\n    const bookBtn = document.getElementById('book-btn');\\n    const recommendation = document.getElementById('recommendation');\\n\\n    function select(key, btn){\\n      // UI states\\n      buttons.forEach(b=>{b.classList.remove('active');b.setAttribute('aria-pressed','false')});\\n      btn.classList.add('active');\\n      btn.setAttribute('aria-pressed','true');\\n\\n      const data = map[key];\\n      sideTitle.textContent = data.title;\\n      sideDesc.textContent = data.desc;\\n      sidePrice.textContent = data.price;\\n      bookBtn.textContent = data.cta;\\n      // Update link (use placeholder base)\\n      bookBtn.setAttribute('href', data.href);\\n\\n      // Recommendation pane\\n      recommendation.innerHTML = '<h3 style=\\\"margin:0 0 6px\\\">Recommendation</h3><p style=\\\"margin:0;color:var(--muted)\\\">'+data.desc+' Suggested booking: '+data.price+'.</p>';\\n    }\\n\\n    // Initialize default\\n    select('overwhelmed', buttons[0]);\\n\\n    buttons.forEach(function(btn){\\n      btn.addEventListener('click', function(){\\n        select(btn.getAttribute('data-key'), btn);\\n      });\\n    });\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
