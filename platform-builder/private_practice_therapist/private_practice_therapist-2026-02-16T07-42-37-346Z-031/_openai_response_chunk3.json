          "text": "BUNDLE_START\n{\"path\":\"fees.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investment — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#ffffff;--muted:#6b6b6b;--accent:#1b6b5a;--card:#f7f7f7;--max:900px}\\n    html,body{height:100%}body{font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#111;line-height:1.5;margin:0;background:var(--bg);}\\n    .wrap{max-width:var(--max);margin:48px auto;padding:24px}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:0.95rem}\\n    .hero{padding:36px 20px;border-radius:10px;background:linear-gradient(180deg,#fff 0%,#fbfbfb 100%);}\\n    .hero h1{margin:0 0 8px;font-weight:600;font-size:1.6rem}\\n    .hero p{margin:0;color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}\\n    .plan{background:var(--card);padding:18px;border-radius:10px;box-shadow:0 1px 0 rgba(0,0,0,0.04)}\\n    .plan h3{margin:0 0 6px}\\n    .price{font-size:1.25rem;color:var(--accent);margin:8px 0}\\n    .muted{color:var(--muted);font-size:0.95rem}\\n    .benefits{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}\\n    .benefit{background:#fff;padding:12px;border-radius:8px;border:1px solid #eee;font-size:0.95rem}\\n    .process{margin-top:26px}\\n    .process ol{padding-left:18px}\\n    .cta{display:flex;gap:12px;margin-top:20px}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:8px;text-decoration:none}\\n    footer{margin-top:34px;color:var(--muted);font-size:0.9rem}\\n    .note{font-size:0.85rem;color:var(--muted);margin-top:14px}\\n    @media(max-width:800px){.grid{grid-template-columns:1fr}.wrap{margin:18px;padding:16px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <strong>{{BUSINESS_NAME}}</strong>\\n        <div class=\\\"muted\\\">{{TAGLINE}}</div>\\n      </div>\\n      <nav aria-label=\\\"Main navigation\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"specialties.html\\\">Specialties</a>\\n        <a href=\\\"approach.html\\\">Approach</a>\\n        <a href=\\\"fees.html\\\">Investment</a>\\n        <a href=\\\"faq.html\\\">FAQ</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\" aria-labelledby=\\\"pricing-heading\\\">\\n      <h1 id=\\\"pricing-heading\\\">Thoughtful investment in short-term and ongoing care</h1>\\n      <p>I offer clear, steady support for anxiety, relationship strain, transitions, burnout, and trauma-informed care. Below are the common pathways clients choose. If you’re unsure, we can start with a brief consult.</p>\\n      <div class=\\\"cta\\\">\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <a href=\\\"contact.html\\\" style=\\\"align-self:center;color:var(--muted);text-decoration:none\\\">Questions before booking</a>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"social_proof\\\" style=\\\"margin-top:18px\\\">\\n      <div style=\\\"font-size:0.95rem;color:var(--muted)\\\">Trusted by people in {{CITY}}, {{STATE}} — verified confidentiality, trauma-informed practice</div>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;align-items:center\\\">\\n        <svg width=\\\"56\\\" height=\\\"56\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" aria-hidden>\\n          <circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"11\\\" stroke=\\\"#e6f2ee\\\" stroke-width=\\\"2\\\" fill=\\\"#f6fffb\\\" />\\n          <path d=\\\"M8 12s1-2 4-2 4 2 4 2\\\" stroke=\\\"#1b6b5a\\\" stroke-width=\\\"1.5\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/>\\n        </svg>\\n        <div>\\n          <div style=\\\"font-weight:600\\\">Care that respects pace</div>\\n          <div class=\\\"muted\\\">\\\"I felt heard and guided without pressure.\\\" — a recent client</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"pricing\\\" style=\\\"margin-top:22px\\\">\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"plan\\\">\\n          <h3>Starter Series — 6 sessions</h3>\\n          <div class=\\\"price\\\">$720 (6 sessions)</div>\\n          <div class=\\\"muted\\\">For short-term focus: symptom relief, skill building, immediate transitions.</div>\\n          <ul class=\\\"muted\\\" style=\\\"margin-top:10px;padding-left:18px\\\">\\n            <li>Weekly 50-minute sessions</li>\\n            <li>Secure telehealth</li>\\n            <li>Guided home practices</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"plan\\\">\\n          <h3>Foundations Path — 12 sessions</h3>\\n          <div class=\\\"price\\\">$1320 (12 sessions)</div>\\n          <div class=\\\"muted\\\">A steady container for patterns, relational work, and trauma-informed processing.</div>\\n          <ul class=\\\"muted\\\" style=\\\"margin-top:10px;padding-left:18px\\\">\\n            <li>Recommended when patterns repeat</li>\\n            <li>Includes check-ins and resources</li>\\n            <li>Flexible scheduling</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"plan\\\">\\n          <h3>Bespoke Support (Ongoing)</h3>\\n          <div class=\\\"price\\\">Month-to-month pricing available</div>\\n          <div class=\\\"muted\\\">An option for continuing care, evolving goals, or deeper psychotherapy.</div>\\n          <ul class=\\\"muted\\\" style=\\\"margin-top:10px;padding-left:18px\\\">\\n            <li>Open-ended rhythm determined together</li>\\n            <li>Session bundles and limited spot sliding scale</li>\\n          </ul>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:18px\\\">\\n        <div class=\\\"benefits\\\">\\n          <div class=\\\"benefit\\\">Insurance: I am out-of-network; I can provide superbills.</div>\\n          <div class=\\\"benefit\\\">Cancellations: 48-hour notice is appreciated.</div>\\n          <div class=\\\"benefit\\\">Payment: Card, bank transfer, or package invoicing.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"process\\\">\\n      <h2 style=\\\"font-size:1.1rem;margin-bottom:6px\\\">How we begin</h2>\\n      <ol>\\n        <li>Reach out via the booking link or phone/Email for a 15-minute consult.</li>\\n        <li>We clarify concerns, goals, and fit; I share scope and boundaries.</li>\\n        <li>Schedule an intake session and choose an initial package that feels right.</li>\\n      </ol>\\n    </section>\\n\\n    <section class=\\\"mini_faq\\\" style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Quick questions</h3>\\n      <div class=\\\"muted\\\">Can I use insurance? — I’m out-of-network but provide superbills for reimbursement.</div>\\n      <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Do you do sliding scale? — I reserve a small number of reduced-fee slots; ask during consult.</div>\\n    </section>\\n\\n    <section class=\\\"lead_magnet\\\" style=\\\"margin-top:22px;padding:16px;border-radius:8px;background:#fbfffd;border:1px solid #eef7f1\\\">\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <svg width=\\\"44\\\" height=\\\"44\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" aria-hidden>\\n          <rect x=\\\"2\\\" y=\\\"4\\\" width=\\\"20\\\" height=\\\"16\\\" rx=\\\"3\\\" stroke=\\\"#dff3ec\\\" fill=\\\"#ffffff\\\" />\\n          <path d=\\\"M6 9h12M6 13h8\\\" stroke=\\\"#1b6b5a\\\" stroke-width=\\\"1.5\\\" stroke-linecap=\\\"round\\\"/>\\n        </svg>\\n        <div>\\n          <div style=\\\"font-weight:600\\\">Free guide: Calming the nervous system</div>\\n          <div class=\\\"muted\\\">Sign up and receive simple practices to use between sessions.</div>\\n        </div>\\n      </div>\\n      <form style=\\\"margin-top:12px;display:flex;gap:8px;flex-wrap:wrap\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\">\\n        <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Your email\\\" required style=\\\"padding:10px;border-radius:8px;border:1px solid #e6e6e6;flex:1\\\" />\\n        <button class=\\\"btn\\\" type=\\\"submit\\\">Get the guide</button>\\n      </form>\\n    </section>\\n\\n    <section class=\\\"policies\\\" style=\\\"margin-top:22px\\\">\\n      <div class=\\\"note\\\">Confidentiality & privacy: Sessions are confidential unless there is risk of harm to self or others, or other legal exceptions. I use secure telehealth and store records in locked systems.</div>\\n      <div class=\\\"note\\\">Scope & boundaries: I provide psychotherapy and supportive counseling. I do not provide emergency services or medical treatment by phone. If you are in crisis, call emergency services or your local crisis line immediately.</div>\\n      <div class=\\\"note\\\">Licensing: {{THERAPIST_NAME}}, {{LICENSE}}</div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap\\\">\\n        <div class=\\\"muted\\\">Phone: {{PHONE}} • Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        <div style=\\\"text-align:right;color:var(--muted)\\\">© {{BUSINESS_NAME}} — Serving {{CITY}}, {{STATE}}</div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Questions — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--muted:#666;--accent:#1b6b5a;--max:920px}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;color:#111;margin:0;background:var(--bg)}\\n    .container{max-width:var(--max);margin:40px auto;padding:24px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:16px;color:var(--muted);text-decoration:none}\\n    .intro{padding:26px 18px;border-radius:10px;background:#fbfbfb;margin-top:18px}\\n    h1{margin:0 0 6px;font-size:1.4rem}\\n    .qa{margin-top:18px}\\n    details{background:#fff;border:1px solid #eef6f2;padding:14px;border-radius:8px;margin-bottom:10px}\\n    summary{font-weight:600;cursor:pointer}\\n    .muted{color:var(--muted)}\\n    .lead{display:flex;gap:12px;align-items:center;margin-top:18px}\\n    .btn{background:var(--accent);color:#fff;padding:9px 12px;border-radius:8px;text-decoration:none}\\n    footer{margin-top:28px;color:var(--muted);font-size:0.9rem}\\n    @media(max-width:700px){.container{padding:16px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div>\\n        <strong>{{BUSINESS_NAME}}</strong>\\n        <div class=\\\"muted\\\">Compassionate, evidence-aware care</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">Who I Am</a>\\n        <a href=\\\"specialties.html\\\">Areas</a>\\n        <a href=\\\"approach.html\\\">How I Work</a>\\n        <a href=\\\"fees.html\\\">Fees</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n        <a href=\\\"contact.html\\\">Reach Out</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"intro\\\" aria-labelledby=\\\"faq-heading\\\">\\n      <h1 id=\\\"faq-heading\\\">Questions I often hear</h1>\\n      <p class=\\\"muted\\\">Below are practical responses about sessions, safety, and what to expect. If your question isn't here, please reach out — I welcome clarifying calls.</p>\\n    </section>\\n\\n    <section class=\\\"social_proof\\\" style=\\\"margin-top:16px;display:flex;gap:12px;align-items:center\\\">\\n      <svg width=\\\"48\\\" height=\\\"48\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" aria-hidden>\\n        <rect x=\\\"2\\\" y=\\\"3\\\" width=\\\"20\\\" height=\\\"18\\\" rx=\\\"3\\\" fill=\\\"#f7fffb\\\" stroke=\\\"#e8f6ef\\\"/>\\n        <path d=\\\"M8 11h8M8 15h5\\\" stroke=\\\"#1b6b5a\\\" stroke-width=\\\"1.5\\\" stroke-linecap=\\\"round\\\"/>\\n      </svg>\\n      <div>\\n        <div style=\\\"font-weight:600\\\">A calm container</div>\\n        <div class=\\\"muted\\\">\\\"Practical tools and thoughtful listening.\\\" — client feedback</div>\\n      </div>\\n    </section>\\n\\n    <main class=\\\"qa\\\">\\n      <details>\\n        <summary>How do I know if therapy is right now?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">People come when stress, relationships, or patterns feel overwhelming, or when a life change feels unclear. A brief consult can help us decide together if now is the best time.</div>\\n      </details>\\n\\n      <details>\\n        <summary>What modalities do you use?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">I blend trauma-informed approaches, relational work, and evidence-based skills (e.g., CBT-informed strategies, mindfulness practices). I center what fits your needs and pace. Modalities: {{MODALITIES}}.</div>\\n      </details>\\n\\n      <details>\\n        <summary>Do you accept insurance?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">I am out-of-network. I provide superbills for many carriers so you can seek reimbursement. I can help answer questions about that process during our first call.</div>\\n      </details>\\n\\n      <details>\\n        <summary>How do cancellations or emergencies work?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">I ask for 48 hours' notice for cancellations when possible. For urgent crises, I am not an emergency service. If you are in immediate danger, please contact local emergency services or your crisis line. In-session limits and boundaries will be discussed in intake.</div>\\n      </details>\\n\\n      <details>\\n        <summary>How long before I notice change?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Change varies. Some people find practical relief after a few sessions; deeper patterns take more time. We'll set goals together and check progress regularly without promising specific outcomes.</div>\\n      </details>\\n\\n      <details>\\n        <summary>Is telehealth available?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Yes. I offer secure video sessions and occasional phone appointments when appropriate. We’ll discuss privacy and technology needs before starting.</div>\\n      </details>\\n\\n      <details>\\n        <summary>What are your boundaries around contact outside sessions?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">I respond to scheduling and administrative messages; for clinical concerns I encourage bringing them to a session. Boundaries are explained clearly in the intake paperwork.</div>\\n      </details>\\n    </main>\\n\\n    <section class=\\\"lead_magnet\\\" style=\\\"margin-top:22px;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px;border-radius:8px;background:#f9fff8;border:1px solid #eef7f1\\\">\\n      <div>\\n        <div style=\\\"font-weight:600\\\">Free resource</div>\\n        <div class=\\\"muted\\\">Simple practices for moments of overwhelm — delivered by email.</div>\\n      </div>\\n      <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" style=\\\"display:flex;gap:8px;align-items:center\\\">\\n        <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Email address\\\" required style=\\\"padding:8px;border-radius:8px;border:1px solid #e6e6e6\\\" />\\n        <button class=\\\"btn\\\" type=\\\"submit\\\">Send me the practices</button>\\n      </form>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule a 15-minute consult</a>\\n      <div class=\\\"muted\\\" style=\\\"margin-top:12px\\\">If you prefer, call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;font-size:0.9rem;color:var(--muted)\\\">\\n      <div>Confidentiality: Information shared in sessions is confidential except for legal exceptions such as imminent risk of harm. Privacy practices are reviewed at intake.</div>\\n      <div style=\\\"margin-top:8px\\\">Licensing: {{THERAPIST_NAME}}, {{LICENSE}}</div>\\n      <div style=\\\"margin-top:8px\\\">Crisis disclaimer: I do not provide emergency services. If you are in crisis, please contact emergency services or your local crisis hotline immediately.</div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"margin-top:20px;color:var(--muted)\\\">© {{BUSINESS_NAME}} • Serving {{CITY}}, {{STATE}} • <a href=\\\"contact.html\\\">Contact</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Start — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--muted:#666;--accent:#1b6b5a;--max:800px}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;color:#111;margin:0;background:var(--bg)}\\n    .shell{max-width:var(--max);margin:40px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .hero{padding:20px;border-radius:10px;background:#fbfbfb;margin-top:18px}\\n    h1{margin:0;font-size:1.4rem}\\n    .muted{color:var(--muted)}\\n    .steps{margin-top:18px}\\n    .step{padding:12px;border-left:3px solid #eef7f1;margin-bottom:10px;border-radius:6px;background:#fff}\\n    form{margin-top:18px;display:grid;gap:10px}\\n    input,textarea,select{padding:10px;border-radius:8px;border:1px solid #e6e6e6}\\n    .btn{background:var(--accent);color:white;padding:10px 12px;border-radius:8px;border:none}\\n    .policies{margin-top:14px;font-size:0.9rem;color:var(--muted)}\\n    footer{margin-top:22px;color:var(--muted)}\\n    @media(max-width:600px){.shell{padding:16px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"shell\\\">\\n    <header>\\n      <div>\\n        <strong>{{BUSINESS_NAME}}</strong>\\n        <div class=\\\"muted\\\">Warm, steady clinical support</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"specialties.html\\\">Specialties</a>\\n        <a href=\\\"approach.html\\\">Approach</a>\\n        <a href=\\\"fees.html\\\">Pricing</a>\\n        <a href=\\\"faq.html\\\">Help</a>\\n        <a href=\\\"book.html\\\">Start</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\" aria-labelledby=\\\"start-heading\\\">\\n      <h1 id=\\\"start-heading\\\">Begin with a brief consult</h1>\\n      <p class=\\\"muted\\\">A 15-minute call helps us clarify needs, confirm fit, and choose a pathway. There’s no pressure — just practical next steps.</p>\\n    </section>\\n\\n    <section class=\\\"social_proof\\\" style=\\\"margin-top:16px;display:flex;gap:12px;align-items:center\\\">\\n      <svg width=\\\"52\\\" height=\\\"52\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" aria-hidden>\\n        <circle cx=\\\"12\\\" cy=\\\"8\\\" r=\\\"3\\\" fill=\\\"#f7fffb\\\" stroke=\\\"#e6f6ee\\\"/>\\n        <path d=\\\"M4 20c1.5-4 6-6 8-6s6.5 2 8 6\\\" stroke=\\\"#1b6b5a\\\" stroke-width=\\\"1.5\\\" fill=\\\"none\\\"/>\\n      </svg>\\n      <div>\\n        <div style=\\\"font-weight:600\\\">A steady first step</div>\\n        <div class=\\\"muted\\\">We focus on fit and clear next steps, not immediate change.</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"steps\\\">\\n      <div class=\\\"step\\\">\\n        <strong>Step 1 — Quick connect</strong>\\n        <div class=\\\"muted\\\">Choose a 15-minute consult via the form below or call {{PHONE}}. We’ll confirm availability and logistics.</div>\\n      </div>\\n      <div class=\\\"step\\\">\\n        <strong>Step 2 — Intake</strong>\\n        <div class=\\\"muted\\\">If we decide to proceed, we schedule an intake session to set goals, review privacy, and discuss scope.</div>\\n      </div>\\n      <div class=\\\"step\\\">\\n        <strong>Step 3 — Ongoing care</strong>\\n        <div class=\\\"muted\\\">We choose a rhythm that supports your needs; payment and cancellation policies are reviewed before the first session.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\">\\n        <input name=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"Your full name\\\" required />\\n        <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Email\\\" required />\\n        <input name=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"Phone (optional)\\\" />\\n        <label for=\\\"reason\\\" class=\\\"muted\\\">Primary reason for seeking support</label>\\n        <select id=\\\"reason\\\" name=\\\"reason\\\" required>\\n          <option value=\\\"\\\">Choose one</option>\\n          <option>Anxiety or stress</option>\\n          <option>Relationship concerns</option>\\n          <option>Life transition</option>\\n          <option>Trauma-related recovery</option>\\n          <option>Burnout / workplace stress</option>\\n        </select>\\n        <label class=\\\"muted\\\">Preferred contact</label>\\n        <div style=\\\"display:flex;gap:8px\\\">\\n          <label style=\\\"font-size:0.95rem\\\"><input type=\\\"radio\\\" name=\\\"contact_pref\\\" value=\\\"email\\\" checked /> Email</label>\\n          <label style=\\\"font-size:0.95rem\\\"><input type=\\\"radio\\\" name=\\\"contact_pref\\\" value=\\\"phone\\\" /> Phone</label>\\n        </div>\\n        <label class=\\\"muted\\\">Anything else you’d like me to know?</label>\\n        <textarea name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Optional notes\\\" style=\\\"min-height:80px\\\"></textarea>\\n\\n        <button class=\\\"btn\\\" type=\\\"submit\\\">Request a consult</button>\\n      </form>\\n    </section>\\n\\n    <section class=\\\"policies\\\" style=\\\"margin-top:16px\\\">\\n      <div class=\\\"muted\\\">Privacy & confidentiality: I maintain confidential records in secure systems. Exceptions to confidentiality (e.g., risk of harm) will be reviewed at intake.</div>\\n      <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Informed consent & scope: Therapy topics may include anxiety, relationship patterns, trauma-informed processing, and life transitions. I am happy to discuss therapeutic approaches: {{MODALITIES}}.</div>\\n      <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Crisis disclaimer: I do not provide emergency services. If you are in immediate danger, please call emergency services or your local crisis line.</div>\\n      <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Licensing and contact: {{THERAPIST_NAME}}, {{LICENSE}} • {{PHONE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"muted\\\">If a faster option is needed, ask about a focused single-session consultation or the \\\"Clarity Session\\\" during booking. Availability is limited.</div>\\n      <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:inline-block;margin-top:10px\\\">Proceed to scheduling</a>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"margin-top:20px;color:var(--muted)\\\">© {{BUSINESS_NAME}} • Serving {{CITY}}, {{STATE}} • Licensed: {{LICENSE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
