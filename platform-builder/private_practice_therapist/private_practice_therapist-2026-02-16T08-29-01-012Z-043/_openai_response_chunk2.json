          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff5f8;--card:#ffffff;--accent:#ff6b8a;--muted:#6b6b6b;--dark:#1f1f1f}\\n    *{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--dark);background:linear-gradient(180deg,var(--bg),#fff);}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:26px 32px;background:transparent}\\n    nav a{margin-left:18px;color:var(--dark);text-decoration:none;font-weight:600}\\n    .wrap{max-width:980px;margin:28px auto;padding:0 20px}\\n    .hero{display:grid;grid-template-columns:1fr 340px;gap:28px;align-items:center;padding:28px;border-radius:14px;background:linear-gradient(135deg,#fff 0%,rgba(255,107,138,0.06) 100%);box-shadow:0 8px 30px rgba(255,107,138,0.08)}\\n    .hero h1{margin:0 0 8px;font-size:28px;line-height:1.05}\\n    .hero p{margin:0;color:var(--muted)}\\n    .cta{display:inline-block;margin-top:18px;padding:12px 18px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none;font-weight:700}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(29,29,29,0.04);}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:18px}\\n    .values li{margin:10px 0}\\n    footer{margin-top:34px;padding:26px 0;color:var(--muted);font-size:13px}\\n    .small{font-size:13px;color:var(--muted)}\\n    .testi{border-left:3px solid rgba(255,107,138,0.16);padding:12px 14px;border-radius:6px;background:linear-gradient(180deg,rgba(255,107,138,0.03),transparent)}\\n    form input{padding:10px;border-radius:8px;border:1px solid #eee;width:70%}\\n    form button{padding:10px 12px;border-radius:8px;background:var(--dark);color:#fff;border:none;margin-left:8px}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div style=\\\"width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#ffc0d0);display:flex;align-items:center;justify-content:center;font-weight:800;color:#fff\\\">{{THERAPIST_NAME}}</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"specialties.html\\\">Work With Me</a>\\n      <a href=\\\"specialties.html#services\\\">Specialties</a>\\n      <a href=\\\"faq.html\\\">FAQ</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero card\\\" aria-label=\\\"Hero\\\">\\n      <div>\\n        <h1>{{THERAPIST_NAME}} — Practical, Compassionate Therapy</h1>\\n        <p>{{TAGLINE}}. I offer focused, evidence-informed therapy for adults navigating anxiety, relationship patterns, grief, and life change.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n\\n        <div style=\\\"margin-top:16px;color:var(--muted);font-size:13px\\\">License: {{LICENSE}} • Modalities: {{MODALITIES}}</div>\\n      </div>\\n\\n      <div style=\\\"display:flex;flex-direction:column;gap:12px;align-items:center\\\">\\n        <!-- Unique local hero SVG for this page -->\\n        <svg width=\\\"280\\\" height=\\\"180\\\" viewBox=\\\"0 0 280 180\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n          <defs>\\n            <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#fff\\\" /><stop offset=\\\"1\\\" stop-color=\\\"#ffd3dd\\\" /></linearGradient>\\n          </defs>\\n          <rect rx=\\\"18\\\" width=\\\"280\\\" height=\\\"180\\\" fill=\\\"url(#g1)\\\" />\\n          <circle cx=\\\"64\\\" cy=\\\"72\\\" r=\\\"28\\\" fill=\\\"#ff6b8a\\\" opacity=\\\"0.94\\\" />\\n          <rect x=\\\"110\\\" y=\\\"48\\\" width=\\\"140\\\" height=\\\"84\\\" rx=\\\"10\\\" fill=\\\"#fff\\\" stroke=\\\"#ff9baa\\\" stroke-opacity=\\\"0.6\\\" />\\n          <path d=\\\"M116 74c22-14 60-12 86 4\\\" stroke=\\\"#ff6b8a\\\" stroke-width=\\\"5\\\" fill=\\\"none\\\" opacity=\\\"0.9\\\" stroke-linecap=\\\"round\\\"/>\\n        </svg>\\n        <div class=\\\"small\\\">A warm, structured practice — sessions are predictable, private, and collaborative.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">Core Values</h3>\\n          <ul class=\\\"values small\\\">\\n            <li><strong>Clarity:</strong> I prioritize clear goals and regular progress checks.</li>\\n            <li><strong>Respect:</strong> therapy that honors your pace, identity, and boundaries.</li>\\n            <li><strong>Practicality:</strong> tools you can use between sessions.</li>\\n            <li><strong>Confidentiality:</strong> protected records and HIPAA-aligned practices.</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">Approach Snapshot</h3>\\n          <p class=\\\"small\\\">I combine CBT, trauma-informed somatic work, and relational coaching to create tailored plans. Sessions are collaborative: we set a short-term focus and review weekly so you retain agency over the work.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Common Concerns I Hear (and how we address them)</h3>\\n      <div style=\\\"display:flex;gap:12px;flex-wrap:wrap\\\">\\n        <div style=\\\"flex:1;min-width:220px\\\">\\n          <strong>\\\"I worry therapy will feel vague.\\\"</strong>\\n          <p class=\\\"small\\\">We build clear goals and short experiments. Progress is measurable and revisited regularly.</p>\\n        </div>\\n        <div style=\\\"flex:1;min-width:220px\\\">\\n          <strong>\\\"I’m unsure if I can afford ongoing care.\\\"</strong>\\n          <p class=\\\"small\\\">I offer a mix of single-session consults, short-term packages, and referrals for sliding-scale care when appropriate.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\" class=\\\"grid\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">What I Work With</h3>\\n        <p class=\\\"small\\\">Anxiety, trauma recovery, life transitions, burnout, relationship repair, grief. I focus on adult clients seeking practical change without minimizing emotions.</p>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">Client Feedback</h3>\\n        <div class=\\\"testi\\\">\\n          <em>\\\"I came in overwhelmed and left with a clear plan — and tools that actually work between sessions.\\\"</em>\\n          <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">— J.M., former client</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Free Guide: 5 Steps to Reduce Daily Anxiety</h3>\\n      <p class=\\\"small\\\">Practical exercises you can try today. Enter your email and I’ll send the guide.</p>\\n      <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" style=\\\"margin-top:12px;display:flex;align-items:center\\\">\\n        <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Your email\\\" required />\\n        <button type=\\\"submit\\\">Get the Guide</button>\\n      </form>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px;text-align:center\\\">\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start with a Consult — {{PRIMARY_CTA_LABEL}}</a>\\n      <div class=\\\"small\\\" style=\\\"margin-top:10px\\\">Sessions available via secure telehealth and in-person by appointment in {{CITY}}, {{STATE}}.</div>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"small\\\">Confidentiality note: Conversations are kept private except where required by law (e.g., risk of harm). I maintain professional records consistent with state regulations.</div>\\n      <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Crisis disclaimer: If you are in immediate danger or experiencing a medical emergency, call emergency services or your local crisis line. Therapy via this practice is not an emergency service.</div>\\n      <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Scope: I provide psychotherapy for adults. If your needs fall outside my scope I will support you in finding appropriate, timely care.</div>\\n      <div style=\\\"margin-top:8px\\\" class=\\\"small\\\">Contact: {{EMAIL}} • {{PHONE}} • License: {{LICENSE}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"specialties.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Specialties — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f8fffb;--card:#ffffff;--accent:#2ec4b6;--muted:#5b5b5b;--dark:#08232f}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--dark);background:var(--bg)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:22px 28px}\\n    nav a{margin-left:16px;color:var(--dark);text-decoration:none;font-weight:700}\\n    .container{max-width:1000px;margin:18px auto;padding:0 20px}\\n    .hero{padding:28px;border-radius:14px;background:linear-gradient(180deg,#ffffff,rgba(46,196,182,0.04));display:flex;gap:20px;align-items:center}\\n    .hero h2{margin:0;font-size:24px}\\n    .services{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .service{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 6px 18px rgba(10,20,20,0.04)}\\n    .muted{color:var(--muted)}\\n    .cta{display:inline-block;margin-top:16px;padding:10px 14px;border-radius:10px;background:var(--accent);color:#003036;text-decoration:none;font-weight:800}\\n    .testi{margin-top:18px}\\n    .lead{display:flex;gap:12px;align-items:center;margin-top:18px;background:#fff;padding:14px;border-radius:10px}\\n    @media(max-width:980px){.services{grid-template-columns:1fr 1fr}.hero{flex-direction:column}}\\n    @media(max-width:580px){.services{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:900\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"approach.html\\\">Programs</a>\\n      <a href=\\\"approach.html#methods\\\">Approach</a>\\n      <a href=\\\"fees.html\\\">Fees</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h2>Areas of focus — focused, practical care</h2>\\n        <p class=\\\"muted\\\">I work with adults who want clear steps toward better regulation, stronger relationships, and more reliable daily functioning.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n\\n      <div style=\\\"width:220px;display:flex;flex-direction:column;align-items:center\\\">\\n        <!-- Unique avatar SVG for specialties page -->\\n        <svg width=\\\"200\\\" height=\\\"200\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n          <rect rx=\\\"20\\\" width=\\\"200\\\" height=\\\"200\\\" fill=\\\"#e8fffb\\\" />\\n          <circle cx=\\\"100\\\" cy=\\\"72\\\" r=\\\"42\\\" fill=\\\"#2ec4b6\\\" opacity=\\\"0.95\\\" />\\n          <rect x=\\\"46\\\" y=\\\"124\\\" width=\\\"108\\\" height=\\\"44\\\" rx=\\\"8\\\" fill=\\\"#fff\\\" stroke=\\\"#bfeee6\\\" />\\n          <path d=\\\"M74 136c8 6 28 6 44 2\\\" stroke=\\\"#2ec4b6\\\" stroke-width=\\\"4\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/>\\n        </svg>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px;font-size:13px\\\">Telehealth + limited in-person</div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"services\\\" style=\\\"margin-top:20px\\\">\\n      <div class=\\\"services\\\">\\n        <div class=\\\"service\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Anxiety & Worry</h4>\\n          <p class=\\\"muted\\\">Skill-based strategies, paced exposure, and daily habit shifts to reduce reactivity and increase choice.</p>\\n        </div>\\n\\n        <div class=\\\"service\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Trauma-Informed Work</h4>\\n          <p class=\\\"muted\\\">Stabilization first, then somatic and narrative interventions. Safety is central; pace is collaborative.</p>\\n        </div>\\n\\n        <div class=\\\"service\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Relationship Patterns</h4>\\n          <p class=\\\"muted\\\">Identify repeating dynamics, strengthen communication, and expand emotional regulation in partnerships.</p>\\n        </div>\\n\\n        <div class=\\\"service\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Burnout & Work Stress</h4>\\n          <p class=\\\"muted\\\">Practical boundary work, values-aligned choices, and micro-habits that reduce overwhelm.</p>\\n        </div>\\n\\n        <div class=\\\"service\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Life Transitions</h4>\\n          <p class=\\\"muted\\\">Decision support, grief-aware planning, and tools for building new routines after change.</p>\\n        </div>\\n\\n        <div class=\\\"service\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Grief & Loss</h4>\\n          <p class=\\\"muted\\\">Space for mourning with structured supports to re-enter daily life and relationships.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Program options — choose a fit</h3>\\n      <p class=\\\"muted\\\">Different rhythms for different needs: single consults, a 6-week skill-track, or a 12-week deep-work series. I will recommend the structure that best supports early wins and long-term change.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Short client story</h3>\\n      <p class=\\\"muted\\\">\\\"After three sessions focused on boundaries and a single practical experiment, I felt less stuck and more able to act in my relationship.\\\"</p>\\n      <div class=\\\"testi muted\\\">— A recent client, anonymized</div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"lead\\\">\\n      <div style=\\\"flex:1\\\">\\n        <strong>Download: How to Choose the Right Therapy Path</strong>\\n        <div class=\\\"muted\\\">A concise worksheet to help you pick between single sessions, short-term packages, or longer work.</div>\\n      </div>\\n      <div>\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\">\\n          <button type=\\\"submit\\\">Send it to me</button>\\n        </form>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Objections & Reality Checks</h3>\\n      <p class=\\\"muted\\\">Common worry: \\\"Therapy will take too long.\\\" I collaborate to set short-term measurable aims and schedule regular reviews. Another worry: \\\"I’ll be judged.\\\" I work from a stance of curiosity and respect.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;text-align:center\\\">\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule a Quick Consult — {{PRIMARY_CTA_LABEL}}</a>\\n    </section>\\n\\n    <footer style=\\\"margin-top:24px;color:var(--muted);font-size:13px\\\">\\n      <div>Confidentiality & privacy: Clinical records are maintained securely and shared only as required by law or with explicit consent.</div>\\n      <div style=\\\"margin-top:8px\\\">If you are an immediate danger to yourself or others, call emergency services. This site does not provide crisis services.</div>\\n      <div style=\\\"margin-top:8px\\\">Licensing: {{LICENSE}} • Contact: {{EMAIL}} • {{PHONE}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>My Approach — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffaf0;--card:#ffffff;--accent:#ffb86b;--muted:#55606c;--dark:#2b2b2b}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;background:var(--bg);color:var(--dark)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px}\\n    nav a{margin-left:14px;text-decoration:none;color:var(--dark);font-weight:700}\\n    .site{max-width:980px;margin:22px auto;padding:0 20px}\\n    .intro{display:flex;gap:18px;align-items:center}\\n    .intro .copy{flex:1}\\n    .pill{display:inline-block;background:#fff;padding:8px 12px;border-radius:999px;font-weight:700;color:var(--accent)}\\n    .methods{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .method{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 8px 18px rgba(0,0,0,0.04)}\\n    .objections{margin-top:18px}\\n    .lead{margin-top:18px;padding:14px;background:#fff;border-radius:12px;display:flex;justify-content:space-between;align-items:center}\\n    .cta{display:inline-block;margin-top:14px;padding:10px 14px;border-radius:10px;background:var(--accent);color:#2b2b2b;text-decoration:none;font-weight:800}\\n    @media(max-width:980px){.methods{grid-template-columns:1fr}.intro{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:900\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Paths</a>\\n      <a href=\\\"specialties.html\\\">Specialties</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"site\\\">\\n    <section class=\\\"intro card\\\">\\n      <div class=\\\"copy\\\">\\n        <div class=\\\"pill\\\">The {{THERAPIST_NAME}} Method</div>\\n        <h2 style=\\\"margin:8px 0\\\">A practical, integrative approach</h2>\\n        <p class=\\\"muted\\\">I blend action-oriented work with attuned relational repair. Sessions are structured to build skills while honoring the emotional context that brought you in.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n\\n      <div style=\\\"width:220px;display:flex;flex-direction:column;align-items:center\\\">\\n        <!-- Unique decorative pattern SVG for approach page -->\\n        <svg width=\\\"200\\\" height=\\\"160\\\" viewBox=\\\"0 0 200 160\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n          <rect rx=\\\"12\\\" width=\\\"200\\\" height=\\\"160\\\" fill=\\\"#fff3e6\\\" />\\n          <g fill=\\\"#ffb86b\\\" opacity=\\\"0.9\\\">\\n            <ellipse cx=\\\"36\\\" cy=\\\"48\\\" rx=\\\"28\\\" ry=\\\"18\\\" />\\n            <ellipse cx=\\\"164\\\" cy=\\\"98\\\" rx=\\\"42\\\" ry=\\\"28\\\" />\\n          </g>\\n          <path d=\\\"M28 110c18-14 60-18 98-6\\\" stroke=\\\"#ff9a3e\\\" stroke-width=\\\"6\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\" />\\n        </svg>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px;font-size:13px\\\">Evidence-informed. Tailored to you.</div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"methods\\\" class=\\\"methods\\\" style=\\\"margin-top:18px\\\">\\n      <div class=\\\"method\\\">\\n        <h4 style=\\\"margin:0 0 8px\\\">Stabilize</h4>\\n        <p class=\\\"muted\\\">We begin with safety: grounding, sleep hygiene, and pacing. Stabilization is the foundation for any deeper work.</p>\\n      </div>\\n\\n      <div class=\\\"method\\\">\\n        <h4 style=\\\"margin:0 0 8px\\\">Skill-Building</h4>\\n        <p class=\\\"muted\\\">Practical tools drawn from CBT, DBT-informed skills, and behavioral activation to shift habitual responses.</p>\\n      </div>\\n\\n      <div class=\\\"method\\\">\\n        <h4 style=\\\"margin:0 0 8px\\\">Integration</h4>\\n        <p class=\\\"muted\\\">Bringing learning into real life through experiments, relationship practice, and reflection to solidify change.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">How sessions flow</h3>\\n      <ol class=\\\"muted\\\">\\n        <li>Check-in and symptom tracking (5–10 minutes).</li>\\n        <li>Work on a focused agenda item (30 minutes).</li>\\n        <li>Collaborative wrap: an experiment or homework and a clear goal for the next session (5–10 minutes).</li>\\n      </ol>\\n    </section>\\n\\n    <section class=\\\"objections card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Questions I get</h3>\\n      <div class=\\\"muted\\\">\\n        <strong>\\\"Will you tell me what to do?\\\"</strong>\\n        <p class=\\\"muted\\\">I offer recommendations and practical steps, but you always choose what fits within your life and values.</p>\\n\\n        <strong>\\\"How long until I see results?\\\"</strong>\\n        <p class=\\\"muted\\\">Many clients notice changes in daily coping within a few sessions; deeper patterns take time. We set review points to gauge progress.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Testimonials</h3>\\n      <div class=\\\"testi\\\">\\n        <blockquote style=\\\"margin:0\\\">\\\"The mixture of clear tasks and a nonjudgmental stance helped me rebuild my confidence at work.\\\"</blockquote>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">— M., client (anonymized)</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"lead\\\">\\n      <div>\\n        <strong>Try a single Session</strong>\\n        <div class=\\\"muted\\\">A focused 50-minute consult to map concerns and plan next steps.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a Single Session</a>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:20px;color:var(--muted);font-size:13px\\\">\\n      <div>Privacy: I keep therapy records confidential and secure. If sharing records becomes necessary, I will explain when and why.</div>\\n      <div style=\\\"margin-top:8px\\\">If you are in crisis, please contact local emergency services or a crisis line. This practice does not provide emergency care.</div>\\n      <div style=\\\"margin-top:8px\\\">Scope & boundaries: I provide therapy for adults. For legal, medical, or urgent psychiatric needs I will coordinate with appropriate professionals.</div>\\n      <div style=\\\"margin-top:8px\\\">Contact: {{EMAIL}} • {{PHONE}} • License: {{LICENSE}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
