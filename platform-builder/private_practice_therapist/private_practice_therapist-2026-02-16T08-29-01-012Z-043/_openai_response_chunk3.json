          "text": "BUNDLE_START\n{\"path\":\"fees.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investment — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#ff6b6b;--muted:#6b6b6b;--bg:#fff;--card:#fff;--radius:12px;--max:1100px}\\n    body{font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Arial; margin:0;color:#111;background:linear-gradient(180deg,#fff 0%,#fff8f8 100%);}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 24px;max-width:var(--max);margin:0 auto}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:conic-gradient(from 180deg at 50% 50%,#ffd1d1, #ff6b6b);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav a{margin:0 10px;color:#333;text-decoration:none;font-weight:600}\\n    .nav-cta{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    main{max-width:var(--max);margin:20px auto;padding:24px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;margin-bottom:18px}\\n    .hero-card{background:#fff;border-radius:16px;padding:28px;box-shadow:0 8px 30px rgba(17,17,17,0.06)}\\n    h1{margin:0;font-size:28px;letter-spacing:-0.02em}\\n    p.lead{color:var(--muted);margin-top:10px}\\n    .price-grid{display:flex;gap:18px;margin-top:18px}\\n    .plan{flex:1;background:linear-gradient(180deg,#fff,#fff);border-radius:12px;padding:18px;border:1px solid #f2e7e7}\\n    .plan h3{margin:0 0 8px 0}\\n    .price{font-size:20px;color:var(--accent);font-weight:700}\\n    .muted{color:var(--muted);font-size:13px}\\n    .disclaimer{font-size:13px;color:#555;margin-top:12px}\\n    footer.cta{background:#fff;margin-top:28px;padding:20px;border-radius:12px;display:flex;justify-content:space-between;align-items:center;border:1px solid #f5e6e6}\\n    .btn-primary{background:var(--accent);color:#fff;padding:12px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .section{margin-top:26px}\\n    .values{display:flex;gap:12px}\\n    .value{background:#fff;padding:14px;border-radius:10px;border:1px solid #f3e6e6}\\n    .methods{display:grid;grid-template-columns:1fr 1fr;gap:12px}\\n    .testimonials{margin-top:12px}\\n    .lead-magnet{background:linear-gradient(90deg,#fff6f6,#fff);padding:16px;border-radius:10px;border:1px solid #fdecec;display:flex;justify-content:space-between;align-items:center}\\n    .small{font-size:13px;color:var(--muted)}\\n    .svg-decor{width:100%;height:80px;margin-top:12px;opacity:0.6}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">{{THERAPIST_NAME}} </div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Work With Me</a>\\n      <a href=\\\"specialties.html\\\">Paths</a>\\n      <a href=\\\"approach.html\\\">Approach</a>\\n      <a href=\\\"fees.html\\\" style=\\\"text-decoration:underline;font-weight:800\\\">Investment</a>\\n      <a href=\\\"faq.html\\\">FAQ</a>\\n      <a class=\\\"nav-cta\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <h1>Transparent fees designed for lasting progress</h1>\\n        <p class=\\\"lead\\\">I offer clear, value-driven options so you can match support to the change you want. Pricing below is practical and intended to help you plan care that fits your life.</p>\\n\\n        <div class=\\\"section\\\">\\n          <h2 style=\\\"font-size:16px;margin-bottom:8px\\\">Three ways to work together</h2>\\n          <div class=\\\"price-grid\\\">\\n            <div class=\\\"plan\\\">\\n              <h3>Starter Session — Clarity Call</h3>\\n              <div class=\\\"price\\\">$175</div>\\n              <div class=\\\"muted\\\">60-minute single session to map concerns and next steps</div>\\n            </div>\\n            <div class=\\\"plan\\\">\\n              <h3>Momentum Package — 8-Session Plan</h3>\\n              <div class=\\\"price\\\">$1,200</div>\\n              <div class=\\\"muted\\\">Eight 50-minute sessions; a commitment to steady change</div>\\n            </div>\\n            <div class=\\\"plan\\\">\\n              <h3>Continuity Care — Monthly</h3>\\n              <div class=\\\"price\\\">$210 / session</div>\\n              <div class=\\\"muted\\\">Ongoing weekly or biweekly sessions billed per session</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"disclaimer\\\">\\n          Insurance: I do not bill insurance directly. I provide superbills you may submit. Sliding scale considerations may be available in limited cases — email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.\\n        </div>\\n\\n      </div>\\n\\n      <aside style=\\\"background:linear-gradient(135deg,#fff6f6,#fff);padding:18px;border-radius:16px;align-self:start\\\">\\n        <div style=\\\"font-weight:800\\\">Why these options?</div>\\n        <p class=\\\"small\\\">These tiers are framed to meet both short-term clarity needs and deeper therapeutic work. Whether you want a single focused session or a paced plan, we’ll choose an approach that honors your goals and schedule.</p>\\n\\n        <svg class=\\\"svg-decor\\\" viewBox=\\\"0 0 400 80\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n          <defs><linearGradient id=\\\"g\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop stop-color=\\\"#ffb6b6\\\" offset=\\\"0\\\"/><stop stop-color=\\\"#ff6b6b\\\" offset=\\\"1\\\"/></linearGradient></defs>\\n          <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"400\\\" height=\\\"80\\\" rx=\\\"12\\\" fill=\\\"url(#g)\\\" />\\n          <g fill=\\\"#fff\\\" opacity=\\\"0.12\\\">\\n            <circle cx=\\\"60\\\" cy=\\\"40\\\" r=\\\"26\\\" />\\n            <circle cx=\\\"130\\\" cy=\\\"24\\\" r=\\\"16\\\" />\\n            <circle cx=\\\"320\\\" cy=\\\"52\\\" r=\\\"20\\\" />\\n          </g>\\n        </svg>\\n\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"btn-primary\\\" href=\\\"book.html\\\">Start with a session</a></div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"section values\\\">\\n      <div class=\\\"value\\\">\\n        <strong>Clarity</strong>\\n        <div class=\\\"muted\\\">We set clear goals so every session moves you forward.</div>\\n      </div>\\n      <div class=\\\"value\\\">\\n        <strong>Practicality</strong>\\n        <div class=\\\"muted\\\">Techniques you can use between sessions to reduce distress.</div>\\n      </div>\\n      <div class=\\\"value\\\">\\n        <strong>Respect</strong>\\n        <div class=\\\"muted\\\">Care that honors your time, identity, and cultural context.</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section methods\\\">\\n      <div style=\\\"background:#fff;padding:14px;border-radius:10px;border:1px solid #f3e6e6\\\">\\n        <h4 style=\\\"margin:0\\\">Methods I draw on</h4>\\n        <p class=\\\"small\\\">CBT-informed strategies, trauma-sensitive modalities, relational work, and evidence-based skills training tailored to your needs.</p>\\n      </div>\\n      <div style=\\\"background:#fff;padding:14px;border-radius:10px;border:1px solid #f3e6e6\\\">\\n        <h4 style=\\\"margin:0\\\">Session structure</h4>\\n        <p class=\\\"small\\\">We start with your top concern, review progress, and leave with 1–2 practical steps you can try before the next meeting.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h3 style=\\\"margin-bottom:8px\\\">Common concerns about cost — and my answers</h3>\\n      <div style=\\\"background:#fff;padding:12px;border-radius:10px;border:1px solid #f3e6e6\\\">\\n        <strong>Is there a lower-cost option?</strong>\\n        <p class=\\\"small\\\">I occasionally reserve a small number of reduced-fee slots. If cost is a barrier, email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> with a brief note and I’ll reply about availability.</p>\\n\\n        <strong>Can I use insurance?</strong>\\n        <p class=\\\"small\\\">I do not bill insurance directly. I provide itemized superbills. Coverage varies by plan — check with your insurer about out-of-network benefits.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section testimonials\\\">\\n      <h3 style=\\\"margin-bottom:8px\\\">Client reflections</h3>\\n      <blockquote style=\\\"background:#fff;padding:12px;border-radius:10px;border:1px solid #f3e6e6\\\">\\\"Working in the 8-session plan gave me measurable momentum. I learned tools I still rely on.\\\" — J., {{CITY}}</blockquote>\\n      <blockquote style=\\\"background:#fff;padding:12px;border-radius:10px;border:1px solid #f3e6e6\\\">\\\"The single session helped me name what I needed and feel less stuck.\\\" — M., {{STATE}}</blockquote>\\n    </section>\\n\\n    <section class=\\\"section lead-magnet\\\">\\n      <div>\\n        <strong>Free guide:</strong>\\n        <div class=\\\"muted\\\">\\\"Preparing for Your First Session\\\" — a one-page checklist to get the most from our first meeting.</div>\\n      </div>\\n      <div>\\n        <a href=\\\"contact.html\\\" class=\\\"btn-primary\\\">Get the checklist</a>\\n      </div>\\n    </section>\\n\\n    <footer class=\\\"cta\\\">\\n      <div>\\n        <div style=\\\"font-weight:800\\\">Ready to schedule?</div>\\n        <div class=\\\"small\\\">Book a clarity call or a full session. Appointments fill; reach out early to secure times that work for you.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"btn-primary\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </footer>\\n\\n    <div style=\\\"font-size:12px;color:#666;margin-top:14px\\\">\\n      <strong>Confidentiality & scope:</strong> Information shared in sessions is confidential and protected except where disclosure is required by law (risk of harm to self/others, court orders). I do not provide emergency services; if you are in crisis, call your local emergency number or contact your nearest crisis line. I practice within my scope as licensed: {{LICENSE}}.\\n    </div>\\n\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Questions — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#6b9bff;--muted:#6b6b6b;--bg:#fff}\\n    body{font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Arial;background:#fbfcff;color:#111;margin:0}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:22px 24px;max-width:1100px;margin:0 auto}\\n    .logo{display:flex;gap:12px;align-items:center}\\n    .logo .mark{width:52px;height:52px;border-radius:12px;background:linear-gradient(135deg,#dfeeff,#6b9bff);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800}\\n    nav a{margin:0 8px;color:#333;text-decoration:none}\\n    nav a.active{font-weight:800;text-decoration:underline}\\n    main{max-width:1100px;margin:18px auto;padding:18px}\\n    .hero{background:#fff;padding:20px;border-radius:14px;display:flex;gap:18px;align-items:center}\\n    h1{margin:0;font-size:26px}\\n    .muted{color:var(--muted)}\\n    .faq-list{margin-top:16px}\\n    .qa{background:#fff;padding:14px;border-radius:10px;margin-bottom:10px;border:1px solid #e6eefc}\\n    .cta-block{background:linear-gradient(90deg,#eef6ff,#fff);padding:16px;border-radius:12px;display:flex;justify-content:space-between;align-items:center}\\n    .btn{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .svg-pattern{opacity:0.12;width:100%;height:70px;margin-top:12px}\\n    footer{max-width:1100px;margin:18px auto;padding:10px 18px;color:#666;font-size:13px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">\\n      <div class=\\\"mark\\\">{{THERAPIST_NAME}}</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"muted\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Stories</a>\\n      <a href=\\\"specialties.html\\\">Programs</a>\\n      <a href=\\\"approach.html\\\">How I Work</a>\\n      <a href=\\\"fees.html\\\">Rates</a>\\n      <a class=\\\"active\\\" href=\\\"faq.html\\\">FAQ</a>\\n      <a href=\\\"book.html\\\">Schedule</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1>Practical answers to common questions</h1>\\n        <p class=\\\"muted\\\">If you don’t see what you need here, email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> and I’ll respond within 48 business hours.</p>\\n      </div>\\n      <div style=\\\"width:240px;padding:8px;border-radius:10px;background:linear-gradient(180deg,#fff,#f7fbff);border:1px solid #e6eefc\\\">\\n        <div style=\\\"font-weight:700\\\">Quick details</div>\\n        <div class=\\\"muted\\\">Sessions: 50 minutes · Telehealth available · Out-of-pocket & superbills</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section faq-list\\\">\\n      <div class=\\\"qa\\\">\\n        <strong>How soon can I get an appointment?</strong>\\n        <p class=\\\"muted\\\">Typical wait varies; first-time appointments are often within 2–4 weeks. If you need something sooner, note that in your message to <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> and I will do my best to accommodate.</p>\\n      </div>\\n\\n      <div class=\\\"qa\\\">\\n        <strong>What should I expect in the first session?</strong>\\n        <p class=\\\"muted\\\">We review concerns, gather relevant history, and identify 1–2 practical steps. The first meeting is collaborative and helps us decide on next steps or a planning package.</p>\\n      </div>\\n\\n      <div class=\\\"qa\\\">\\n        <strong>Do you offer remote sessions?</strong>\\n        <p class=\\\"muted\\\">Yes. I provide secure telehealth for clients in {{STATE}} (and sometimes neighboring states depending on licensure). We’ll confirm eligibility when you book.</p>\\n      </div>\\n\\n      <div class=\\\"qa\\\">\\n        <strong>Do you accept insurance or offer sliding scale?</strong>\\n        <p class=\\\"muted\\\">I do not directly bill insurance. I provide a super-bill you can submit. Sliding scale openings are limited and prioritized for those with significant financial need.</p>\\n      </div>\\n\\n      <div class=\\\"qa\\\">\\n        <strong>How do you handle cancellation?</strong>\\n        <p class=\\\"muted\\\">Appointments canceled with less than 48 hours' notice may incur a fee. If an emergency arises, we discuss options based on the circumstances.</p>\\n      </div>\\n\\n      <div class=\\\"qa\\\">\\n        <strong>What is your confidentiality policy?</strong>\\n        <p class=\\\"muted\\\">Conversations are confidential except when disclosure is legally required (e.g., harm risk, subpoenas). I discuss limits of confidentiality at intake and in writing.</p>\\n      </div>\\n\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h3 style=\\\"margin-bottom:8px\\\">Additional topics</h3>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px\\\">\\n        <div style=\\\"background:#fff;padding:12px;border-radius:10px;border:1px solid #eef6ff\\\">\\n          <strong>Working with trauma?</strong>\\n          <p class=\\\"muted\\\">I use trauma-informed practices and collaborate on pacing and safety. Treatment never re-traumatizes and moves at your comfort level.</p>\\n        </div>\\n        <div style=\\\"background:#fff;padding:12px;border-radius:10px;border:1px solid #eef6ff\\\">\\n          <strong>How do I know therapy is helping?</strong>\\n          <p class=\\\"muted\\\">We set measurable goals and review them regularly. Progress can be steady, non-linear, or gradual; we attend to what is most meaningful to you.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"cta-block\\\">\\n      <div>\\n        <div style=\\\"font-weight:800\\\">Still unsure?</div>\\n        <div class=\\\"muted\\\">Schedule a 20-minute clarity call to see if we’re a fit. No pressure—just information.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"book.html\\\">Book a short call</a>\\n      </div>\\n    </section>\\n\\n    <svg class=\\\"svg-pattern\\\" viewBox=\\\"0 0 800 160\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n      <rect width=\\\"800\\\" height=\\\"160\\\" fill=\\\"#6b9bff\\\" rx=\\\"8\\\"/>\\n      <g fill=\\\"#fff\\\">\\n        <circle cx=\\\"90\\\" cy=\\\"60\\\" r=\\\"28\\\" opacity=\\\"0.12\\\"/>\\n        <circle cx=\\\"220\\\" cy=\\\"40\\\" r=\\\"16\\\" opacity=\\\"0.08\\\"/>\\n        <circle cx=\\\"500\\\" cy=\\\"100\\\" r=\\\"34\\\" opacity=\\\"0.06\\\"/>\\n      </g>\\n    </svg>\\n\\n  </main>\\n\\n  <footer>\\n    <div><strong>Scope & safety:</strong> I practice as a licensed clinician ({{LICENSE}}). I do not provide crisis services. If you are in immediate danger, call emergency services or your local crisis line.</div>\\n    <div style=\\\"margin-top:8px\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> · Phone: {{PHONE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Schedule — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#ff8a5b;--muted:#6b6b6b}\\n    body{font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Arial;margin:0;background:linear-gradient(180deg,#fffaff,#fff);color:#111}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;max-width:1100px;margin:0 auto}\\n    .logo{display:flex;gap:12px;align-items:center}\\n    nav a{margin:0 8px;color:#333;text-decoration:none}\\n    main{max-width:1100px;margin:18px auto;padding:18px}\\n    .hero{display:flex;gap:18px;align-items:center;background:#fff;padding:18px;border-radius:12px;border:1px solid #fdece2}\\n    h1{margin:0;font-size:28px}\\n    .lead{color:var(--muted)}\\n    .steps{display:flex;gap:12px;margin-top:18px}\\n    .step{background:#fff;padding:12px;border-radius:10px;border:1px solid #fde6dc}\\n    form{margin-top:18px;background:#fff;padding:16px;border-radius:12px;border:1px solid #fde6dc}\\n    label{display:block;margin-top:10px;font-weight:600}\\n    input,textarea,select{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid #eee}\\n    .submit{background:var(--accent);color:#fff;padding:12px 14px;border-radius:10px;border:none;font-weight:700;margin-top:12px}\\n    .note{font-size:13px;color:var(--muted);margin-top:8px}\\n    .small{font-size:13px;color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">\\n      <div style=\\\"width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,#ffd9cb,#ff8a5b);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800\\\">{{THERAPIST_NAME}}</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"small\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"specialties.html\\\">Specialties</a>\\n      <a href=\\\"approach.html\\\">Method</a>\\n      <a href=\\\"fees.html\\\">Investment</a>\\n      <a href=\\\"faq.html\\\">FAQ</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1>Schedule a session or a short clarity call</h1>\\n        <p class=\\\"lead\\\">Choose a time that fits your rhythm. If you’re unsure which option to pick, use the clarity call to get oriented.</p>\\n      </div>\\n      <div style=\\\"width:260px;text-align:right\\\">\\n        <div style=\\\"font-weight:800\\\">Phone</div>\\n        <div class=\\\"small\\\">{{PHONE}}</div>\\n        <div style=\\\"margin-top:8px;font-weight:800\\\">Email</div>\\n        <div class=\\\"small\\\">{{EMAIL}}</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"steps\\\">\\n      <div class=\\\"step\\\"><strong>Step 1</strong><div class=\\\"small\\\">Pick the session type that fits your need</div></div>\\n      <div class=\\\"step\\\"><strong>Step 2</strong><div class=\\\"small\\\">Complete the intake details below</div></div>\\n      <div class=\\\"step\\\"><strong>Step 3</strong><div class=\\\"small\\\">Receive scheduling confirmation and forms</div></div>\\n    </section>\\n\\n    <form method=\\\"post\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\">\\n      <label for=\\\"name\\\">Full name</label>\\n      <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"Your name\\\" required />\\n\\n      <label for=\\\"email\\\">Email</label>\\n      <input id=\\\"email\\\" type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"you@example.com\\\" required />\\n\\n      <label for=\\\"phone\\\">Phone (optional)</label>\\n      <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"Optional\\\" />\\n\\n      <label for=\\\"type\\\">I am booking a</label>\\n      <select id=\\\"type\\\" name=\\\"type\\\" required>\\n        <option value=\\\"clarity\\\">20-minute Clarity Call — quick fit check</option>\\n        <option value=\\\"session\\\">50-minute Therapy Session</option>\\n        <option value=\\\"intensive\\\">Initial Intake — 90 minutes</option>\\n      </select>\\n\\n      <label for=\\\"modalities\\\">Primary concerns / goals</label>\\n      <textarea id=\\\"modalities\\\" name=\\\"modalities\\\" placeholder=\\\"E.g., anxiety, relationship strain, work burnout\\\" rows=\\\"4\\\">{{MODALITIES}}</textarea>\\n\\n      <label><input type=\\\"checkbox\\\" name=\\\"consent\\\" required /> I understand the session is not an emergency service and that confidentiality has limits described below.</label>\\n\\n      <div class=\\\"note\\\">By submitting, you consent to receive scheduling emails from {{BUSINESS_NAME}}. I will follow up within 48 business hours to confirm times and provide intake paperwork.</div>\\n\\n      <button class=\\\"submit\\\" type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n\\n      <div style=\\\"margin-top:12px\\\" class=\\\"small\\\">\\n        Payment and cancellation: Payment is collected at the time of service. Cancellations with less than 48 hours' notice may be charged. For fee questions, see <a href=\\\"fees.html\\\">Rates</a> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.\\n      </div>\\n\\n      <div style=\\\"margin-top:10px;font-size:13px;color:var(--muted)\\\">\\n        <strong>Confidentiality & crisis policy:</strong> Conversations are confidential with standard legal exceptions (risk of harm, court orders). If you are in crisis or at imminent risk, contact emergency services or your local crisis line immediately.\\n      </div>\\n    </form>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin-bottom:8px\\\">What happens after you submit?</h3>\\n      <ol class=\\\"small\\\">\\n        <li>I will reply within 48 business hours to confirm a time and send intake forms.</li>\\n        <li>Complete the intake paperwork before our first full session to make best use of the time.</li>\\n        <li>If you have urgent safety concerns, include them in your message or call local emergency services.</li>\\n      </ol>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin-bottom:8px\\\">Helpful note on telehealth</h3>\\n      <p class=\\\"small\\\">If we meet virtually, you will need a private, secure space and a stable internet connection. Telehealth sessions follow the same confidentiality protections as in-person work.</p>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"max-width:1100px;margin:18px auto;padding:10px 18px;color:#666;font-size:13px\\\">\\n    <div>{{BUSINESS_NAME}} · {{CITY}}, {{STATE}} · {{PHONE}} · <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    <div style=\\\"margin-top:8px\\\">Licensed as: {{LICENSE}}. I do not provide emergency services. If you are in immediate danger, call emergency services.</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
