          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbf6f1;--card:#fff6f0;--accent:#8a5a3b;--muted:#6b5a52;--glass:rgba(138,90,59,0.06);font-family:system-ui,-apple-system,\\\"Segoe UI\\\",Roboto,'Helvetica Neue',Arial;}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg),#fff);color:#3d3029;line-height:1.5}\\n    header{padding:28px 20px;display:flex;align-items:center;justify-content:space-between}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .wrap{max-width:980px;margin:0 auto;padding:24px}\\n    .hero{background:var(--card);border-radius:14px;padding:28px;display:flex;gap:20px;align-items:center;box-shadow:0 6px 20px rgba(120,90,70,0.06)}\\n    .hero .copy{flex:1}\\n    h1{margin:0 0 8px;font-size:28px;color:var(--accent)}\\n    p.lead{margin:0;color:var(--muted)}\\n    .avatar{width:120px;height:120px;border-radius:14px;flex-shrink:0;background:linear-gradient(180deg,#fff,#f5efe9);display:flex;align-items:center;justify-content:center}\\n    .avatar svg{width:90%;height:90%}\\n    .section{margin-top:22px}\\n    .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}\\n    .card{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 4px 14px var(--glass)}\\n    .cta{display:inline-block;margin-top:14px;padding:10px 16px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{margin-top:28px;padding:18px 0;color:#836b63;font-size:13px}\\n    small.disclaimer{display:block;margin-top:12px;color:#7b6b63;font-size:12px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div style=\\\"width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,#f6e9de,#efe2d8);display:flex;align-items:center;justify-content:center;font-weight:800;color:var(--accent)\\\">{{BUSINESS_NAME}}</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"specialties.html\\\">Areas</a>\\n      <a href=\\\"approach.html\\\">How I Work</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <!-- HERO: personal scientist-guide intro (unique to About) -->\\n    <section class=\\\"hero\\\" aria-label=\\\"About hero\\\">\\n      <div class=\\\"copy\\\">\\n        <h1>About {{THERAPIST_NAME}} — calm, evidence-informed support</h1>\\n        <p class=\\\"lead\\\">I blend practical, research-grounded tools with compassionate listening. My work is collaborative: we set clear goals, measure small changes, and adapt over time.</p>\\n        <div style=\\\"margin-top:12px\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a style=\\\"margin-left:10px;color:var(--muted);font-weight:600;text-decoration:none\\\" href=\\\"fees.html\\\">Fees &amp; availability</a>\\n        </div>\\n      </div>\\n      <div class=\\\"avatar\\\" aria-hidden=\\\"true\\\">\\n        <!-- inline unique SVG avatar for About page -->\\n        <svg viewBox=\\\"0 0 64 64\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\">\\n          <rect x=\\\"2\\\" y=\\\"10\\\" width=\\\"60\\\" height=\\\"44\\\" rx=\\\"8\\\" fill=\\\"#fff1e6\\\" stroke=\\\"#e7d7cc\\\" />\\n          <circle cx=\\\"32\\\" cy=\\\"24\\\" r=\\\"10\\\" fill=\\\"#f8e7db\\\" stroke=\\\"#e0c6b3\\\" />\\n          <path d=\\\"M15 52c6-8 18-8 30 0\\\" fill=\\\"none\\\" stroke=\\\"#c89a7b\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" />\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <!-- MYTHS VS TRUTH: compassionate corrections -->\\n    <section class=\\\"section\\\">\\n      <h2 style=\\\"margin:0 0 8px;color:var(--accent)\\\">Common myths — and what is actually helpful</h2>\\n      <div class=\\\"cards\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Myth:</strong>\\n          <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Therapy will give you an instant fix.</p>\\n          <hr style=\\\"border:none;border-top:1px solid #f1e6df;margin:10px 0\\\">\\n          <strong>Truth:</strong>\\n          <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Therapy is a process of steady practice. We focus on small, measurable shifts you can rely on.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Myth:</strong>\\n          <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">You must be in crisis to benefit.</p>\\n          <hr style=\\\"border:none;border-top:1px solid #f1e6df;margin:10px 0\\\">\\n          <strong>Truth:</strong>\\n          <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Therapy is helpful at any stage—whether you're navigating transitions, reducing chronic anxiety, or refining relationship skills.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- PILLARS: Core practice values (unique phrasing) -->\\n    <section class=\\\"section\\\">\\n      <h3 style=\\\"color:var(--accent);margin-bottom:10px\\\">Foundations I bring to sessions</h3>\\n      <div class=\\\"cards\\\">\\n        <div class=\\\"card\\\"><strong>Measurement-minded support</strong><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">We pick 1–2 indicators to track progress.</p></div>\\n        <div class=\\\"card\\\"><strong>Practical skills</strong><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Evidence-informed techniques you can use between meetings.</p></div>\\n        <div class=\\\"card\\\"><strong>Contextual thinking</strong><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">We consider environment, relationships, and routines—not just symptoms.</p></div>\\n      </div>\\n    </section>\\n\\n    <!-- CASE STUDIES: anonymized snapshots -->\\n    <section class=\\\"section\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">Client snapshots (anonymized)</h3>\\n      <div class=\\\"cards\\\">\\n        <div class=\\\"card\\\"><strong>Mid-career burnout</strong><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Worked on prioritization, boundary-setting, and sleep habits. Client reported 30% decrease in daily exhaustion after 8 weeks.</p></div>\\n        <div class=\\\"card\\\"><strong>Relationship communication</strong><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">We practiced reflective listening and repair strategies; partners reported clearer conflict resolution skills.</p></div>\\n      </div>\\n    </section>\\n\\n    <!-- FAQ (about-focused, unique questions) -->\\n    <section class=\\\"section\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">Questions I often get</h3>\\n      <div class=\\\"cards\\\">\\n        <div class=\\\"card\\\"><strong>How long do sessions last?</strong><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Standard sessions are 50 minutes. We can discuss longer or focused check-ins as needed.</p></div>\\n        <div class=\\\"card\\\"><strong>Do you accept insurance?</strong><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">I provide superbills for out-of-network reimbursement. Please contact me for current policy details.</p></div>\\n      </div>\\n    </section>\\n\\n    <!-- CTA -->\\n    <section class=\\\"section\\\" style=\\\"display:flex;align-items:center;justify-content:space-between;gap:16px\\\">\\n      <div>\\n        <h3 style=\\\"margin:0;color:var(--accent)\\\">Ready to start?</h3>\\n        <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">If you want a practical, steady approach to change, we can set a first appointment and clarify goals together.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div><strong>{{THERAPIST_NAME}}</strong> — {{LICENSE}}</div>\\n      <small class=\\\"disclaimer\\\">Confidentiality note: Sessions are private and progress notes are stored securely. Crisis disclaimer: If you are in crisis or danger, call local emergency services or a crisis line. Therapy scope: I provide short- and mid-term psychotherapy and referrals when specialized or urgent care is needed.</small>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"specialties.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Areas of Focus — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbf7f4;--card:#fff7f3;--accent:#7a4f36;--muted:#665147;font-family:system-ui,Segoe UI,Roboto,Arial}\\n    body{margin:0;background:var(--bg);color:#3d3029}\\n    header{padding:22px 20px;display:flex;align-items:center;justify-content:space-between}\\n    nav a{margin-left:16px;color:var(--muted);text-decoration:none}\\n    .wrap{max-width:1000px;margin:0 auto;padding:22px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:20px}\\n    .list{background:var(--card);padding:18px;border-radius:12px}\\n    .list h1{margin-top:0;color:var(--accent)}\\n    .specials{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-top:14px}\\n    .spec{padding:12px;background:#fff;border-radius:10px;box-shadow:0 6px 18px rgba(122,79,54,0.06)}\\n    .spec h4{margin:0 0 6px}\\n    .contact{background:linear-gradient(180deg,#fff7f0,#fffbf8);padding:16px;border-radius:12px}\\n    .cta{display:inline-block;margin-top:10px;padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none}\\n    small{color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div style=\\\"width:44px;height:44px;border-radius:10px;background:#fff3ea;display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent)\\\">PP</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Work With Me</a>\\n      <a href=\\\"approach.html\\\">Ways I Work</a>\\n      <a href=\\\"book.html\\\">Schedule</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <div class=\\\"grid\\\">\\n      <div class=\\\"list\\\">\\n        <h1>Areas I commonly help with</h1>\\n        <p style=\\\"margin:0;color:var(--muted)\\\">I draw on cognitive-behavioral, trauma-informed, and relational approaches to support change. Sessions are collaborative and tailored to your needs.</p>\\n\\n        <!-- PILLARS (reframed for specialties) -->\\n        <section style=\\\"margin-top:14px\\\">\\n          <h3 style=\\\"color:var(--accent);margin-bottom:8px\\\">Therapeutic supports</h3>\\n          <div class=\\\"specials\\\">\\n            <div class=\\\"spec\\\"><h4>Anxiety &amp; worry</h4><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Skills to manage worry cycles, attention training, and gradual exposure planning.</p></div>\\n            <div class=\\\"spec\\\"><h4>Trauma recovery</h4><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Stabilization, pacing, and integration—no re-traumatization; we move at your pace.</p></div>\\n            <div class=\\\"spec\\\"><h4>Relationships &amp; communication</h4><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Practiceable tools for conflict navigation, boundaries, and emotional attunement.</p></div>\\n            <div class=\\\"spec\\\"><h4>Life transitions</h4><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Role changes, grief, career shifts—finding steady routines and meaning.</p></div>\\n            <div class=\\\"spec\\\"><h4>Workplace stress &amp; burnout</h4><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Assessing workload, values-aligned decisions, and micro-habits for recovery.</p></div>\\n            <div class=\\\"spec\\\"><h4>Parenting strain</h4><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Short-term coaching for routines, co-parent communication, and stress management.</p></div>\\n          </div>\\n        </section>\\n\\n        <!-- QUICK CASE STUDY (unique) -->\\n        <section style=\\\"margin-top:14px\\\">\\n          <h4 style=\\\"margin:0 0 6px;color:var(--accent)\\\">Snapshot: managing anticipatory anxiety</h4>\\n          <p style=\\\"margin:0;color:var(--muted)\\\">Client learned two attention-shifting exercises and a brief behavioral experiment; within six weeks reported fewer avoidance patterns and improved sleep continuity.</p>\\n        </section>\\n      </div>\\n\\n      <aside class=\\\"contact\\\">\\n        <h4 style=\\\"margin-top:0;color:var(--accent)\\\">Work settings &amp; modalities</h4>\\n        <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">{{MODALITIES}}</p>\\n        <p style=\\\"margin:12px 0 0;color:var(--muted)\\\"><strong>Programs:</strong> I offer short-term focused pathways, ongoing therapy, and single-session consultations.</p>\\n\\n        <!-- MYTHS VS TRUTH (compact) -->\\n        <div style=\\\"margin-top:12px\\\">\\n          <strong style=\\\"color:var(--accent)\\\">Myth vs. reality</strong>\\n          <p style=\\\"margin:6px 0 0;color:var(--muted)\\\"><em>Myth:</em> Therapy is all talking. <br><em>Reality:</em> We practice skills and set measurable goals.</p>\\n        </div>\\n\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a consult</a>\\n        <small style=\\\"display:block;margin-top:10px;color:var(--muted)\\\">Insurance: out-of-network billing available. Ask for a superbill.</small>\\n\\n        <!-- small inline pattern SVG unique to this page -->\\n        <div style=\\\"margin-top:12px;opacity:0.95\\\" aria-hidden=\\\"true\\\">\\n          <svg width=\\\"100%\\\" height=\\\"60\\\" viewBox=\\\"0 0 200 60\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n            <defs><linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#fff5ef\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#fff9f6\\\"/></linearGradient></defs>\\n            <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"200\\\" height=\\\"60\\\" rx=\\\"8\\\" fill=\\\"url(#g1)\\\"/>\\n            <path d=\\\"M0 40 Q50 10 100 40 T200 40\\\" stroke=\\\"#e6d3c7\\\" stroke-width=\\\"2\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/>\\n          </svg>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <!-- FAQ (specialties-focused, different from About) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">Frequently asked — specialties</h3>\\n      <div class=\\\"specials\\\" style=\\\"margin-top:10px\\\">\\n        <div class=\\\"spec\\\"><strong>Can I work on multiple issues?</strong><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Yes. We prioritize what matters most and allocate time accordingly.</p></div>\\n        <div class=\\\"spec\\\"><strong>What if I need medication guidance?</strong><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">I can coordinate with prescribers, and I will provide referrals as appropriate.</p></div>\\n      </div>\\n    </section>\\n\\n    <!-- CTA -->\\n    <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <strong style=\\\"color:var(--accent);display:block\\\">Interested in a focused pathway?</strong>\\n        <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Short-term plans usually run 6–12 sessions, tailored to a measurable aim. Ongoing therapy is available when deeper work is needed.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule a session</a>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:20px;color:var(--muted);font-size:13px\\\">\\n      <div><strong>{{THERAPIST_NAME}}</strong> — {{LICENSE}}</div>\\n      <small>Confidentiality and limits of confidentiality apply. If you are in immediate danger, please call emergency services or a local crisis resource.</small>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>How I Work — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffaf7;--card:#fff6f4;--accent:#8c5b3f;--muted:#6f5b50;font-family:Inter,system-ui,Segoe UI,Roboto}\\n    body{margin:0;background:var(--bg);color:#3b2f28}\\n    header{padding:20px;display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .container{max-width:980px;margin:0 auto;padding:20px}\\n    .hero{background:linear-gradient(180deg,#fff8f3,#fff6f2);padding:18px;border-radius:12px;display:flex;gap:18px;align-items:center}\\n    .hero h1{margin:0;color:var(--accent)}\\n    .flow{display:flex;flex-direction:column;gap:12px;margin-top:18px}\\n    .step{background:var(--card);padding:14px;border-radius:12px;display:flex;gap:12px;align-items:flex-start}\\n    .step .num{width:40px;height:40px;border-radius:10px;background:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent);box-shadow:0 6px 14px rgba(140,91,63,0.06)}\\n    .case{margin-top:16px;display:grid;grid-template-columns:1fr 1fr;gap:12px}\\n    .case div{background:#fff;padding:12px;border-radius:12px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none}\\n    footer{margin-top:20px;color:var(--muted);font-size:13px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div style=\\\"width:44px;height:44px;border-radius:10px;background:#fff4ee;display:flex;align-items:center;justify-content:center;color:var(--accent);font-weight:700\\\">{{THERAPIST_NAME}}</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">Evidence-informed, human-centered</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"specialties.html\\\">Paths</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <!-- HERO (approach-specific visual) -->\\n    <section class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1>My working method — steady experiments, practical gains</h1>\\n        <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">I treat therapy like iterative problem-solving: form a hypothesis, test a small change, review data, and refine. This keeps work focused and time-efficient.</p>\\n      </div>\\n      <div style=\\\"width:140px;flex-shrink:0\\\">\\n        <!-- unique illustrative SVG pattern for approach page -->\\n        <svg viewBox=\\\"0 0 120 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-hidden=\\\"true\\\">\\n          <rect x=\\\"6\\\" y=\\\"6\\\" width=\\\"108\\\" height=\\\"108\\\" rx=\\\"18\\\" fill=\\\"#fff8f4\\\" stroke=\\\"#f0ddd0\\\"/>\\n          <circle cx=\\\"38\\\" cy=\\\"44\\\" r=\\\"10\\\" fill=\\\"#fdeee0\\\" stroke=\\\"#e9d0c0\\\"/>\\n          <path d=\\\"M26 76c14-12 40-12 62 0\\\" stroke=\\\"#e6cab8\\\" stroke-width=\\\"3\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <!-- PROCESS STEPS (unique order/naming) -->\\n    <section class=\\\"flow\\\">\\n      <div class=\\\"step\\\">\\n        <div class=\\\"num\\\">1</div>\\n        <div>\\n          <strong>Clarify an aim</strong>\\n          <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">We choose 1–2 concrete goals and identify how you’ll know they’re improving.</p>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"step\\\">\\n        <div class=\\\"num\\\">2</div>\\n        <div>\\n          <strong>Design small experiments</strong>\\n          <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Short, manageable exercises or shifts you can try between sessions.</p>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"step\\\">\\n        <div class=\\\"num\\\">3</div>\\n        <div>\\n          <strong>Review data &amp; adapt</strong>\\n          <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">We discuss what changed, troubleshoot barriers, and refine the next step.</p>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"step\\\">\\n        <div class=\\\"num\\\">4</div>\\n        <div>\\n          <strong>Consolidate skills</strong>\\n          <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">When progress is steady, we focus on generalizing gains into daily routines.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- CASE STUDIES (approach-specific) -->\\n    <section class=\\\"case\\\">\\n      <div>\\n        <h4 style=\\\"margin:0;color:var(--accent)\\\">Case: reducing evening rumination</h4>\\n        <p style=\\\"margin:8px 0 0;color:var(--muted)\\\">Plan: 3 small nightly experiments (breathing practice, pre-sleep checklist, environmental cue). Outcome: reported fewer intrusive thoughts and better sleep consolidation after 5 weeks.</p>\\n      </div>\\n      <div>\\n        <h4 style=\\\"margin:0;color:var(--accent)\\\">Case: reconnecting after conflict</h4>\\n        <p style=\\\"margin:8px 0 0;color:var(--muted)\\\">Plan: practice short repair scripts and reflective listening in set moments. Outcome: improved capacity to de-escalate and clearer expectations.</p>\\n      </div>\\n    </section>\\n\\n    <!-- MYTHS VS TRUTH (approach-framed) -->\\n    <section style=\\\"margin-top:16px\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">What this approach is — and is not</h3>\\n      <div style=\\\"display:flex;gap:12px;margin-top:10px;flex-wrap:wrap\\\">\\n        <div style=\\\"flex:1;min-width:220px;background:var(--card);padding:12px;border-radius:10px\\\"><strong>Not a therapy of endless talk</strong><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">We balance understanding with concrete practice.</p></div>\\n        <div style=\\\"flex:1;min-width:220px;background:var(--card);padding:12px;border-radius:10px\\\"><strong>Not a promise</strong><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Change is collaborative and varies by context; I cannot guarantee outcomes.</p></div>\\n      </div>\\n    </section>\\n\\n    <!-- FAQ (approach-specific unique questions) -->\\n    <section style=\\\"margin-top:16px\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">Logistics &amp; scope</h3>\\n      <div style=\\\"display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;margin-top:10px\\\">\\n        <div style=\\\"background:#fff;padding:12px;border-radius:10px\\\"><strong>How will progress be tracked?</strong><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">We choose 1–2 brief measures (e.g., frequency of panic thoughts, sleep efficiency) and review them periodically.</p></div>\\n        <div style=\\\"background:#fff;padding:12px;border-radius:10px\\\"><strong>What if my needs change?</strong><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">We revise goals together and I will make referrals if a different level or specialty of care is needed.</p></div>\\n      </div>\\n    </section>\\n\\n    <!-- CTA with pricing framing unique to this page -->\\n    <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <strong style=\\\"display:block;color:var(--accent)\\\">Pathways</strong>\\n        <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">\\\"Focused Pathway\\\": 6 sessions with measurable goals. \\\"Open-Ended\\\" for deeper exploration. Sliding thoughtfully considered on a case-by-case basis.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start a pathway</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"margin-top:18px;color:var(--muted)\\\"><strong>{{THERAPIST_NAME}}</strong> — {{LICENSE}} • {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n      <small style=\\\"display:block;margin-top:8px;color:var(--muted)\\\">Privacy: Records are maintained securely. Limits: If there is risk of harm to self or others, confidentiality may be limited. Crisis: In urgent situations, contact emergency services.</small>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
