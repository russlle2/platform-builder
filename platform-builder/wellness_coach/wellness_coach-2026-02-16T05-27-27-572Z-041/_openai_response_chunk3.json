          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Investment Options</title>\\n  <style>\\n    :root{--bg:#0f1720;--card:#0b1220;--muted:#9aa6b2;--accent:#e6b89c;--glass:rgba(255,255,255,0.04);--maxw:1100px}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,sans-serif;color:#e6eef6;background:linear-gradient(180deg,#071122 0%, #081520 60%)}\\n    .wrap{max-width:var(--maxw);margin:40px auto;padding:28px}\\n    .nav{display:flex;align-items:center;gap:18px;justify-content:space-between}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .brand h1{font-size:18px;margin:0;color:#fff;letter-spacing:0.2px}\\n    .nav a{color:var(--muted);text-decoration:none;padding:8px 12px;border-radius:8px}\\n    .nav a.cta{background:linear-gradient(90deg,#ffb37d,#ef9a8b);color:#071122;font-weight:600}\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:28px;margin-top:28px;align-items:center}\\n    .hero-card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:28px;border-radius:14px;box-shadow:0 6px 30px rgba(2,6,23,0.6)}\\n    .hero h2{margin:0 0 8px 0;font-size:28px;color:#fff}\\n    .hero p.lead{margin:0;color:var(--muted)}\\n    .hero-visual{display:flex;justify-content:center}\\n    .gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:26px}\\n    .tile{background:var(--card);padding:18px;border-radius:12px;min-height:110px;display:flex;flex-direction:column;justify-content:space-between}\\n    .tile h3{margin:0;color:#fff;font-size:16px}\\n    .tile p{margin:8px 0 0 0;color:var(--muted);font-size:13px}\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:26px}\\n    .tier{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:20px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .price{font-size:22px;color:#fff;font-weight:700}\\n    .features{margin:10px 0;color:var(--muted);font-size:13px}\\n    .btn{display:inline-block;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,#ffb37d,#ef9a8b);color:#071122;text-decoration:none;font-weight:700}\\n    .faq{margin-top:30px;background:var(--glass);padding:18px;border-radius:12px;color:var(--muted)}\\n    footer{margin-top:36px;color:var(--muted);font-size:13px}\\n    /* small screens */\\n    @media (max-width:900px){.hero{grid-template-columns:1fr;}.gallery{grid-template-columns:repeat(2,1fr)}.tiers{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav class=\\\"nav\\\">\\n      <div class=\\\"brand\\\">\\n        <svg width=\\\"42\\\" height=\\\"42\\\" viewBox=\\\"0 0 100 100\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n          <rect width=\\\"100\\\" height=\\\"100\\\" rx=\\\"18\\\" fill=\\\"#071722\\\"/>\\n          <circle cx=\\\"40\\\" cy=\\\"42\\\" r=\\\"20\\\" fill=\\\"#e6b89c\\\"/>\\n          <rect x=\\\"60\\\" y=\\\"20\\\" width=\\\"22\\\" height=\\\"60\\\" rx=\\\"6\\\" fill=\\\"#ef9a8b\\\"/>\\n        </svg>\\n        <div>\\n          <h1>{{BUSINESS_NAME}}</h1>\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <div>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">Our Story</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"testimonials.html\\\">Praise</a>\\n        <a href=\\\"contact.html\\\" class=\\\"cta\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </nav>\\n\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <h2>Choose your path to steady wellbeing</h2>\\n        <p class=\\\"lead\\\">Designed for momentum — three distinct structures that translate habits into outcomes. Small, trackable steps. Big, lasting results.</p>\\n        <div style=\\\"margin-top:18px;display:flex;gap:12px;flex-wrap:wrap;\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a style=\\\"padding:10px 14px;border-radius:10px;background:transparent;border:1px solid rgba(255,255,255,0.06);color:var(--muted);text-decoration:none\\\" href=\\\"programs.html\\\">See full curriculum</a>\\n        </div>\\n\\n        <div class=\\\"gallery\\\">\\n          <div class=\\\"tile\\\">\\n            <div>\\n              <h3>Habit-first framework</h3>\\n              <p>Small daily anchors that stack into reliable routines — no willpower gymnastics.</p>\\n            </div>\\n            <div style=\\\"font-size:12px;color:var(--muted)\\\">Includes weekly check-ins</div>\\n          </div>\\n\\n          <div class=\\\"tile\\\">\\n            <div>\\n              <h3>Accountability that fits</h3>\\n              <p>Practical nudges, templates, and a flexible calendar that respects your life.</p>\\n            </div>\\n            <div style=\\\"font-size:12px;color:var(--muted)\\\">Scaled to your goals</div>\\n          </div>\\n\\n          <div class=\\\"tile\\\">\\n            <div>\\n              <h3>Skillful relapse recovery</h3>\\n              <p>Reset strategies so slips become signals not failures.</p>\\n            </div>\\n            <div style=\\\"font-size:12px;color:var(--muted)\\\">Gentle, precise coaching</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"hero-visual\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"decorative gallery illustration\\\" style=\\\"width:100%;max-width:380px;border-radius:12px;box-shadow:0 12px 40px rgba(2,6,23,0.7)\\\">\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px\\\">\\n      <h3 style=\\\"color:#fff;margin:0 0 10px 0\\\">How I work — a practical framework</h3>\\n      <div style=\\\"color:var(--muted);max-width:780px\\\">My coaching uses three simple pillars: Clarify (what matters), Construct (tiny daily habits), Continue (sustainable maintenance). We map goals to weekly behaviors and measure progress in human terms — energy, consistency, and confidence.</div>\\n    </section>\\n\\n    <section class=\\\"tiers\\\" aria-label=\\\"pricing tiers\\\">\\n      <div class=\\\"tier\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:start\\\"><div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">Starter</div>\\n          <div class=\\\"price\\\">Reset Rhythm — $99</div>\\n        </div>\\n        <div style=\\\"font-size:12px;color:var(--muted);text-align:right\\\">/one-time 4-week mini</div></div>\\n        <div class=\\\"features\\\">A focused 4-week reset designed to build two go-to habits. Includes: 2 coaching calls, habit tracker, daily micro-assignments.</div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book Reset</a>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:start\\\"><div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">Core</div>\\n          <div class=\\\"price\\\">Momentum — $375</div>\\n        </div>\\n        <div style=\\\"font-size:12px;color:var(--muted);text-align:right\\\">/month subscription</div></div>\\n        <div class=\\\"features\\\">The most popular. Weekly 1:1s, ongoing habit redesign, email support, and templates to lock routines into real life.</div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start Momentum</a>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:start\\\"><div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">Longgame</div>\\n          <div class=\\\"price\\\">Sustain — $1595</div>\\n        </div>\\n        <div style=\\\"font-size:12px;color:var(--muted);text-align:right\\\">/3-month package</div></div>\\n        <div class=\\\"features\\\">Deep restructuring of habits and identity. Bi-weekly sessions, priority messaging, relapse recovery plans, and lifelong templates.</div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Enroll in Sustain</a>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h4 style=\\\"margin:0 0 8px 0;color:#fff\\\">Questions about investment</h4>\\n      <div style=\\\"margin-top:8px\\\">\\n        <strong>Is there a payment plan?</strong>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">Yes — monthly and split-payment options are available for multi-month packages. Reach out at {{EMAIL}} for custom arrangements.</div>\\n      </div>\\n\\n      <div style=\\\"margin-top:12px\\\">\\n        <strong>What if I need to pause?</strong>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">Plans can be paused with 7 days notice. We design pause-and-reset checkpoints so momentum isn't lost.</div>\\n      </div>\\n\\n      <div style=\\\"margin-top:12px\\\">\\n        <strong>Do you accept insurance?</strong>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">Coaching is a private investment; it is not billed to insurance. I can provide invoices on request.</div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>Questions? Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n      <div style=\\\"margin-top:6px\\\">Based in {{CITY}}, {{STATE}} • © {{BUSINESS_NAME}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Client Stories</title>\\n  <style>\\n    :root{--bg:#faf8f7;--accent:#7a5a48;--muted:#6b6f73;--card:#fff;--maxw:1100px}\\n    html,body{margin:0;height:100%;font-family:Inter,system-ui,Helvetica,Arial;color:#1e2226;background:var(--bg)}\\n    .container{max-width:var(--maxw);margin:36px auto;padding:26px}\\n    .top{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{color:#444;text-decoration:none;margin-left:14px}\\n    .hero{display:flex;gap:20px;align-items:center;margin-top:20px}\\n    .hero .text{max-width:640px}\\n    h1{margin:0;font-size:30px;color:#111}\\n    p.lead{margin:8px 0;color:var(--muted)}\\n    .stories{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:22px}\\n    .story{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 8px 24px rgba(20,20,20,0.06)}\\n    .quote{font-style:italic;color:#222;margin:0 0 12px 0}\\n    .meta{font-size:13px;color:var(--muted)}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none}\\n    .small{font-size:13px;color:var(--muted)}\\n    @media (max-width:900px){.stories{grid-template-columns:1fr}} \\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <div class=\\\"top\\\">\\n      <div>\\n        <strong style=\\\"font-size:18px\\\">{{BUSINESS_NAME}}</strong>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n      <div class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"programs.html\\\">Work With Me</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </div>\\n    </div>\\n\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"text\\\">\\n        <h1>Stories of change and steady progress</h1>\\n        <p class=\\\"lead\\\">Real people. Tangible habits. Practical shifts that last. Below are recent client snapshots — wins that came from thoughtful, repeatable behavior and gentle accountability.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule a discovery call</a>\\n      </div>\\n      <div>\\n        <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"illustrated avatar\\\" style=\\\"width:180px;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,0.08)\\\">\\n      </div>\\n    </section>\\n\\n    <section class=\\\"stories\\\" aria-label=\\\"client stories\\\">\\n      <article class=\\\"story\\\">\\n        <p class=\\\"quote\\\">\\\"I used to start goals strong and fizzle. With {{COACH_NAME}} I learned how to make tiny behaviours non-negotiable. In 12 weeks I slept better and had consistent morning energy.\\\"</p>\\n        <div class=\\\"meta\\\">— Maya, 34, regained routine after maternity leave (Foundations program)</div>\\n      </article>\\n\\n      <article class=\\\"story\\\">\\n        <p class=\\\"quote\\\">\\\"The Momentum plan rebuilt my evenings without overhauling my life. I lost the stress loops and now I have a readable day-to-day plan.\\\"</p>\\n        <div class=\\\"meta\\\">— Jordan, 41, creative director (Deep Habits)\\n        </div>\\n      </article>\\n\\n      <article class=\\\"story\\\">\\n        <p class=\\\"quote\\\">\\\"What surprised me was how small tweaks added up. We mapped triggers and made tiny swaps. The support made consistency simple.\\\"</p>\\n        <div class=\\\"meta\\\">— Rosa, 28, grad student (Maintenance track)</div>\\n      </article>\\n\\n      <article class=\\\"story\\\">\\n        <p class=\\\"quote\\\">\\\"I wasn’t after perfection, just a steady change. The pack of tools, accountability, and simple plans got me there.\\\"</p>\\n        <div class=\\\"meta\\\">— Kam, 50, entrepreneur (Deep Habits)</div>\\n      </article>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px;background:#fff;padding:16px;border-radius:10px;box-shadow:0 8px 20px rgba(20,20,20,0.04)\\\">\\n      <h3 style=\\\"margin:0 0 8px 0\\\">Why stories matter</h3>\\n      <p class=\\\"small\\\">Case notes show that consistent micro-habits plus compassionate accountability produce durable shifts. Coaching focuses on habits rather than quick fixes, and celebrates the everyday wins that compound.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h4 style=\\\"margin:0 0 10px 0\\\">Frequently asked — logistics</h4>\\n      <div style=\\\"color:var(--muted);font-size:14px\\\">How long are sessions? 45 to 60 minutes, depending on package. Are calls recorded? No — notes are summarized instead. What support between sessions? Email check-ins and habit trackers for active packages.</div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:28px;color:var(--muted);font-size:13px\\\">\\n      <div>Ready to explore? <a href=\\\"book.html\\\" style=\\\"color:inherit;text-decoration:underline\\\">Book a discovery call</a> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:inherit;text-decoration:underline\\\">{{EMAIL}}</a></div>\\n      <div style=\\\"margin-top:6px\\\">{{COACH_NAME}}, {{CREDENTIALS}} • Based in {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--muted:#6b7280;--accent:#2b6cb0;--card:#fff;--maxw:900px}\\n    html,body{margin:0;font-family:Inter,system-ui,Helvetica,Arial;background:linear-gradient(180deg,#f7fafc 0%,#ffffff 100%);color:#0f172a}\\n    .wrap{max-width:var(--maxw);margin:34px auto;padding:20px}\\n    .nav{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{color:#334155;text-decoration:none;margin-left:12px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:20px;margin-top:18px;align-items:start}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 12px 30px rgba(15,23,42,0.06)}\\n    h1{margin:0;font-size:26px}\\n    p.lead{margin-top:8px;color:var(--muted)}\\n    form{display:flex;flex-direction:column;gap:12px;margin-top:12px}\\n    input,select,textarea{padding:10px;border-radius:8px;border:1px solid #e6e9ee;font-size:14px}\\n    .row{display:flex;gap:10px}\\n    .btn{padding:10px 14px;border-radius:10px;background:var(--accent);color:#fff;border:none;font-weight:700}\\n    .info{font-size:13px;color:var(--muted)}\\n    .side h4{margin:0 0 8px 0}\\n    @media (max-width:900px){.hero{grid-template-columns:1fr}.row{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav class=\\\"nav\\\">\\n      <div><strong>{{BUSINESS_NAME}}</strong> <span style=\\\"color:var(--muted);margin-left:8px\\\">{{TAGLINE}}</span></div>\\n      <div>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"pricing.html\\\">Investment</a>\\n        <a href=\\\"testimonials.html\\\">Reviews</a>\\n      </div>\\n    </nav>\\n\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <div class=\\\"card\\\">\\n          <h1>Start your first session</h1>\\n          <p class=\\\"lead\\\">Book a discovery call to explore fit and create a tailored path. Choose a program below or leave it to us — we’ll design a plan that honors your life and goals.</p>\\n\\n          <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" novalidate>\\n            <input name=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"Your full name\\\" required>\\n            <div class=\\\"row\\\">\\n              <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Email address\\\" required>\\n              <input name=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"Phone (optional)\\\">\\n            </div>\\n            <label style=\\\"font-size:13px;color:var(--muted)\\\">Select interest</label>\\n            <select name=\\\"program\\\" aria-label=\\\"program select\\\">\\n              <option>Starter Flow — 4-week reset</option>\\n              <option>Growth Track — monthly momentum</option>\\n              <option>Lifetime Habits — deep 3-month plan</option>\\n              <option>Custom — discuss my needs</option>\\n            </select>\\n            <textarea name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"What would you like to focus on? (brief)\\\"></textarea>\\n            <div style=\\\"display:flex;gap:10px;align-items:center;justify-content:space-between\\\">\\n              <div class=\\\"info\\\">You will receive a scheduling link after submission. No insurance billing — coaching is privately paid.</div>\\n              <button class=\\\"btn\\\" type=\\\"submit\\\">Book discovery</button>\\n            </div>\\n          </form>\\n\\n          <div style=\\\"margin-top:12px;font-size:13px;color:var(--muted)\\\">If you prefer, email me at <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"side\\\">\\n        <div class=\\\"card\\\">\\n          <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"decorative pattern\\\" style=\\\"width:100%;border-radius:8px;\\\">\\n          <h4 style=\\\"margin-top:12px\\\">Quick pricing snapshot</h4>\\n          <div class=\\\"info\\\">Reset Flow from $99 • Momentum from $375/mo • Deep packages from $1595. Custom payment plans available.</div>\\n\\n          <h4 style=\\\"margin-top:12px\\\">What to expect</h4>\\n          <div class=\\\"info\\\">A 30–45 minute discovery chat, clarity on focus areas, and an optional starter plan you can begin right away.</div>\\n\\n          <h4 style=\\\"margin-top:12px\\\">Who I work with</h4>\\n          <div class=\\\"info\\\">People who want practical, sustainable habit change without extremes. I prioritize doable systems over motivation-only plans.</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"card\\\">\\n        <h4 style=\\\"margin:0 0 8px 0\\\">Scheduling FAQ</h4>\\n        <div class=\\\"info\\\">How soon can I meet? Typically within 7–14 days depending on package. What timezone? Sessions are scheduled in {{CITY}}, {{STATE}} time. Need a different cadence? Choose Custom and we'll adapt.</div>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:18px;font-size:13px;color:var(--muted)\\\">\\n      <div>{{COACH_NAME}}, {{CREDENTIALS}} — <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
