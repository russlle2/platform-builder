          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f0f10;--card:#0f1720;--accent:#e7cfa3;--muted:#9aa7ab;--glass:rgba(255,255,255,0.04);--radius:14px;--max:1100px}\\n    *{box-sizing:border-box}body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:#eaf6f2;background:linear-gradient(180deg,#081018 0%,#07121a 60%);-webkit-font-smoothing:antialiased}\\n    header{max-width:var(--max);margin:36px auto 24px;padding:0 28px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .brand img{width:64px;height:64px;border-radius:10px;background:var(--glass);padding:10px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-weight:600}\\n    .hero{max-width:var(--max);margin:10px auto 40px;padding:36px;border-radius:18px;background:linear-gradient(135deg,rgba(255,255,255,0.02),transparent);display:grid;grid-template-columns:1fr 420px;gap:28px;padding-right:48px}\\n    .hero .kicker{color:var(--accent);font-weight:700;letter-spacing:0.08em}\\n    .hero h1{margin:8px 0 12px;font-size:34px;line-height:1.05}\\n    .hero p.lead{color:var(--muted);margin:0 0 18px}\\n    .hero .meta{display:flex;gap:12px;align-items:center}\\n    .btn{background:var(--accent);color:#072022;padding:12px 18px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .svg-wrap{display:flex;align-items:center;justify-content:center}\\n    section{max-width:var(--max);margin:18px auto;padding:28px;border-radius:14px;background:rgba(255,255,255,0.01)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\\n    .card{background:var(--card);padding:18px;border-radius:12px}\\n    .small{color:var(--muted);font-size:14px}\\n    .plan{display:flex;gap:14px;align-items:flex-start}\\n    .micro-list{display:flex;flex-direction:column;gap:10px}\\n    footer{max-width:var(--max);margin:28px auto;padding:18px;color:var(--muted);text-align:center}\\n    @media (max-width:900px){.hero{grid-template-columns:1fr;padding-right:24px}.grid{grid-template-columns:1fr}}  \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\"/>\\n      <div>\\n        <div style=\\\"color:var(--accent);font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"color:var(--muted);font-size:13px\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"services.html\\\">Work With Me</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <!-- HERO: A Journey Back to Your Rhythm -->\\n    <section class=\\\"hero\\\" aria-labelledby=\\\"about-hero\\\">\\n      <div>\\n        <div class=\\\"kicker\\\">A gentle invitation</div>\\n        <h1 id=\\\"about-hero\\\">A journey back to your rhythm with {{COACH_NAME}}</h1>\\n        <p class=\\\"lead\\\">I guide soulful professionals to practical routines that restore calm, clarity, and steady energy. Our work is cohort-based, evidence-informed and always heart-led.</p>\\n        <div class=\\\"meta\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <div style=\\\"color:var(--muted);font-size:14px\\\">Or call <strong style=\\\"color:var(--accent)\\\">{{PHONE}}</strong></div>\\n        </div>\\n      </div>\\n      <div class=\\\"svg-wrap\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"illustration\\\" style=\\\"width:100%;max-width:380px\\\"/>\\n      </div>\\n    </section>\\n\\n    <!-- DIAGNOSTIC: Reflective Diagnostic -->\\n    <section aria-labelledby=\\\"diagnostic-title\\\">\\n      <h2 id=\\\"diagnostic-title\\\">Reflective Diagnostic — where you start</h2>\\n      <p class=\\\"small\\\">A short, guided inventory to understand stress patterns, rhythms and pockets of potential. This snapshot informs the cohort placement and personalized plan.</p>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:16px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Time & Energy Map</strong>\\n          <div class=\\\"small\\\">How energy moves through your day — practical checkpoints, no judgment.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Rest-Activation Balance</strong>\\n          <div class=\\\"small\\\">Identify when to pause and when to build momentum.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Community Fit</strong>\\n          <div class=\\\"small\\\">We match you to a cohort with similar rhythms and goals.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- PLAN: My Five-Point Plan -->\\n    <section aria-labelledby=\\\"plan-title\\\">\\n      <h2 id=\\\"plan-title\\\">The Five-Point Plan I Walk With You</h2>\\n      <p class=\\\"small\\\">A gallery-style framework that balances inner work with practical habits. Each point becomes a weekly focus in the cohort.</p>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:16px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Grounding Rituals</strong>\\n          <div class=\\\"small\\\">Morning cues that anchor attention before the day accelerates.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Energy Architecture</strong>\\n          <div class=\\\"small\\\">Structure tasks to honor natural highs and lows.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Boundary Craft</strong>\\n          <div class=\\\"small\\\">Gentle but clear ways to protect focus and restore capacity.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- MICRO_HABITS: Daily Micro-Rituals -->\\n    <section aria-labelledby=\\\"micro-title\\\">\\n      <h2 id=\\\"micro-title\\\">Daily Micro-Rituals to Keep You Rooted</h2>\\n      <p class=\\\"small\\\">Tiny, repeatable actions you can do in 2–8 minutes that compound into lasting calm.</p>\\n      <div style=\\\"display:flex;gap:12px;flex-wrap:wrap;margin-top:12px\\\">\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:220px\\\">\\n          <strong>Two-Minute Arrival</strong>\\n          <div class=\\\"small\\\">A short breath sequence to begin focused work.</div>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:220px\\\">\\n          <strong>Midday Micro-Reset</strong>\\n          <div class=\\\"small\\\">A 5-minute check-in to re-center energy.</div>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:220px\\\">\\n          <strong>Evening Unwind</strong>\\n          <div class=\\\"small\\\">A tactile ritual to close the day with clarity.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- PRICING: Investment & Enrollment -->\\n    <section aria-labelledby=\\\"pricing-title\\\">\\n      <h2 id=\\\"pricing-title\\\">Investment & Enrollment</h2>\\n      <p class=\\\"small\\\">Cohort coaching is priced to reflect the depth of practice, peer accountability, and direct access to me. Sliding options available by application.</p>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:16px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Ember Cohort — 8 weeks</strong>\\n          <div class=\\\"small\\\">$980 — weekly sessions, community hub, journal prompts (limited seats)</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Verdant Path — 16 weeks</strong>\\n          <div class=\\\"small\\\">$1,840 — deeper rhythm work, two live intensives, peer pods</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Lumen Mentorship — Rolling</strong>\\n          <div class=\\\"small\\\">Private small-group mentorship — inquire for tiered pricing</div>\\n        </div>\\n      </div>\\n      <p class=\\\"small\\\" style=\\\"margin-top:12px\\\">Want the workbook before you commit? Request the guide when you <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"color:var(--accent)\\\">{{PRIMARY_CTA_LABEL}}</a>.</p>\\n    </section>\\n\\n    <!-- CTA: Begin Your Cohort Journey -->\\n    <section style=\\\"text-align:center;padding:40px;border-radius:12px;margin-top:18px;background:linear-gradient(90deg,rgba(231,207,163,0.06),transparent)\\\" aria-labelledby=\\\"cta-about\\\">\\n      <h3 id=\\\"cta-about\\\">Begin your cohort journey</h3>\\n      <p class=\\\"small\\\">Apply to the next intake. Cohorts open quarterly and seats are intentionally limited.</p>\\n      <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Apply to a Cohort</a>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"margin-bottom:8px\\\">Led by {{COACH_NAME}}, {{CREDENTIALS}} — based in {{CITY}}, {{STATE}}</div>\\n    <div class=\\\"small\\\">Contact <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent)\\\">{{EMAIL}}</a> · Phone: {{PHONE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfbfb;--card:#ffffff;--accent:#7b5ea8;--muted:#52606d;--soft:#f3eef8;--radius:12px;--max:1100px}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system; background:var(--bg);color:#0b1720;}\\n    header{max-width:var(--max);margin:26px auto;padding:18px 22px;display:flex;justify-content:space-between;align-items:center}\\n    .logo{display:flex;align-items:center;gap:12px}\\n    .logo img{width:56px;height:56px}\\n    nav a{margin-left:14px;color:#345; text-decoration:none;font-weight:600}\\n    .gallery{max-width:var(--max);margin:10px auto;padding:28px;display:grid;grid-template-columns:1fr 420px;gap:22px}\\n    .panel{background:var(--card);padding:22px;border-radius:var(--radius);box-shadow:0 6px 20px rgba(15,20,25,0.05)}\\n    h1{margin:0 0 10px}\\n    .eyebrow{color:var(--accent);font-weight:700}\\n    .list{display:flex;flex-direction:column;gap:12px;margin-top:14px}\\n    .service{border-radius:10px;padding:14px;background:linear-gradient(180deg,#fff,#fbfbff);display:flex;justify-content:space-between;align-items:center}\\n    .muted{color:var(--muted);font-size:14px}\\n    .cta{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    footer{max-width:var(--max);margin:26px auto;padding:18px;color:var(--muted);text-align:center}\\n    @media (max-width:900px){.gallery{grid-template-columns:1fr}}  \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">\\n      <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\"/>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"muted\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"programs.html\\\">Programs</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <!-- HERO: Offerings & Pathways -->\\n    <section class=\\\"gallery\\\" aria-labelledby=\\\"services-hero\\\">\\n      <div class=\\\"panel\\\">\\n        <div class=\\\"eyebrow\\\">Offerings & Pathways</div>\\n        <h1 id=\\\"services-hero\\\">Group cohorts, short courses and guided maintenance</h1>\\n        <p class=\\\"muted\\\">I offer structured cohort programs that pair spiritual resonance with pragmatic practices. All work centers on habit design, resilience and sustainable rhythm.</p>\\n        <div class=\\\"list\\\">\\n          <div class=\\\"service\\\">\\n            <div>\\n              <strong>Ember — Intro Cohort</strong>\\n              <div class=\\\"muted\\\">8 weeks · practice-first · community accountability</div>\\n            </div>\\n            <div><a class=\\\"cta\\\" href=\\\"programs.html#ember\\\">Join</a></div>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <div>\\n              <strong>Verdant — Deep Rhythm</strong>\\n              <div class=\\\"muted\\\">16 weeks · small groups · two live sessions</div>\\n            </div>\\n            <div><a class=\\\"cta\\\" href=\\\"programs.html#verdant\\\">Apply</a></div>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <div>\\n              <strong>Lumen — Peer Mentorship</strong>\\n              <div class=\\\"muted\\\">Ongoing · cohort alumni and advanced practice</div>\\n            </div>\\n            <div><a class=\\\"cta\\\" href=\\\"contact.html\\\">Inquire</a></div>\\n          </div>\\n        </div>\\n      </div>\\n      <div class=\\\"panel\\\">\\n        <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" style=\\\"width:100%;border-radius:10px\\\"/>\\n      </div>\\n    </section>\\n\\n    <!-- DIAGNOSTIC: Clarity Snapshot -->\\n    <section class=\\\"panel\\\" aria-labelledby=\\\"clarity-title\\\" style=\\\"margin:18px auto;max-width:var(--max)\\\">\\n      <h2 id=\\\"clarity-title\\\">Clarity Snapshot</h2>\\n      <p class=\\\"muted\\\">A short form and a 20-minute call to place you in the right cohort. We focus on outcomes, not labels.</p>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-wrap:wrap\\\">\\n        <div style=\\\"flex:1;min-width:220px\\\" class=\\\"service\\\">\\n          <div>\\n            <strong>Quick Intake</strong>\\n            <div class=\\\"muted\\\">15 questions that map to energy and obligations.</div>\\n          </div>\\n          <div><a class=\\\"cta\\\" href=\\\"contact.html\\\">Start</a></div>\\n        </div>\\n        <div style=\\\"flex:1;min-width:220px\\\" class=\\\"service\\\">\\n          <div>\\n            <strong>Match Call</strong>\\n            <div class=\\\"muted\\\">20 minutes to align expectations and fit.</div>\\n          </div>\\n          <div><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book</a></div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- PLAN: Signature Framework -->\\n    <section class=\\\"panel\\\" aria-labelledby=\\\"signature-plan\\\">\\n      <h2 id=\\\"signature-plan\\\">Signature framework: Seasons of Practice</h2>\\n      <p class=\\\"muted\\\">We move through seasons: Seed, Tend, Harvest — a cyclical approach that honors renewal over one-off fixes.</p>\\n      <div style=\\\"display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:12px\\\">\\n        <div class=\\\"card\\\" style=\\\"padding:12px;background:var(--soft);border-radius:10px\\\">\\n          <strong>Seed</strong>\\n          <div class=\\\"muted\\\">Intention & minimal rituals.</div>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"padding:12px;background:var(--soft);border-radius:10px\\\">\\n          <strong>Tend</strong>\\n          <div class=\\\"muted\\\">Scaffolding practice into daily life.</div>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"padding:12px;background:var(--soft);border-radius:10px\\\">\\n          <strong>Harvest</strong>\\n          <div class=\\\"muted\\\">Sustainability and review.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- MICRO_HABITS: Small Practices -->\\n    <section class=\\\"panel\\\" aria-labelledby=\\\"micro-title-2\\\">\\n      <h2 id=\\\"micro-title-2\\\">Small practices that build resilience</h2>\\n      <p class=\\\"muted\\\">These are the micro-habits embedded into every cohort—easy to start, powerful over time.</p>\\n      <ul class=\\\"muted\\\" style=\\\"margin-top:12px\\\">\\n        <li>Begin with breath: 2 minutes to arrive</li>\\n        <li>Transition cues: signal the end of work gently</li>\\n        <li>Reflection prompts: 3 questions before sleep</li>\\n      </ul>\\n    </section>\\n\\n    <!-- PRICING: Tiered Support Options -->\\n    <section class=\\\"panel\\\" aria-labelledby=\\\"pricing-services\\\">\\n      <h2 id=\\\"pricing-services\\\">Tiered support & pricing</h2>\\n      <p class=\\\"muted\\\">Different entry points to suit different commitments.</p>\\n      <div style=\\\"display:flex;gap:12px;flex-wrap:wrap;margin-top:12px\\\">\\n        <div style=\\\"flex:1;min-width:220px;background:#fff;padding:12px;border-radius:10px\\\">\\n          <strong>Self-Paced Kit</strong>\\n          <div class=\\\"muted\\\">$79 — workbook & recorded sessions</div>\\n        </div>\\n        <div style=\\\"flex:1;min-width:220px;background:#fff;padding:12px;border-radius:10px\\\">\\n          <strong>Guided Cohort</strong>\\n          <div class=\\\"muted\\\">$980 — live weekly, community space</div>\\n        </div>\\n        <div style=\\\"flex:1;min-width:220px;background:#fff;padding:12px;border-radius:10px\\\">\\n          <strong>Mentor Circle</strong>\\n          <div class=\\\"muted\\\">$250/mo — ongoing peer mentorship</div>\\n        </div>\\n      </div>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:12px\\\">Need a payment plan? Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent)\\\">{{EMAIL}}</a>.</p>\\n    </section>\\n\\n    <!-- CTA: Schedule a Discovery -->\\n    <section style=\\\"text-align:center;margin:18px auto;max-width:var(--max)\\\">\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule a Discovery Call</a>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Limited spots per cohort — priority for early applicants.</p>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:var(--max);margin:0 auto;padding:14px;text-align:center;color:var(--muted)\\\">Facilitated by {{COACH_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071823;--card:#072a2f;--accent:#ffd6a5;--muted:#bcd7d4;--radius:16px;--max:1100px}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system;background:radial-gradient(1200px 600px at 10% 10%,rgba(255,214,165,0.06),transparent),#0b1316;color:var(--muted)}\\n    header{max-width:var(--max);margin:28px auto;padding:18px 22px;display:flex;justify-content:space-between;align-items:center}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .container{max-width:var(--max);margin:20px auto;padding:16px}\\n    .grid{display:grid;grid-template-columns:2fr 1fr;gap:18px}\\n    .card{background:var(--card);padding:20px;border-radius:var(--radius);box-shadow:0 8px 30px rgba(2,6,8,0.6)}\\n    h1{margin-top:0}\\n    .pill{display:inline-block;padding:8px 12px;border-radius:999px;background:rgba(255,214,165,0.08);color:var(--accent);font-weight:700}\\n    .programs{display:flex;flex-direction:column;gap:12px}\\n    .prog{display:flex;justify-content:space-between;align-items:center;padding:12px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent)}\\n    .muted{color:var(--muted)}\\n    .btn{background:var(--accent);color:#081218;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{max-width:var(--max);margin:28px auto;padding:18px;color:var(--muted);text-align:center}\\n    @media (max-width:900px){.grid{grid-template-columns:1fr}}  \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\" style=\\\"width:60px;height:60px;border-radius:12px;background:rgba(255,255,255,0.02);padding:10px\\\"/>\\n      <div>\\n        <div style=\\\"font-weight:800;color:var(--accent)\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Cohort model — next intakes quarterly</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Our Story</a>\\n      <a href=\\\"services.html\\\">Work With Me</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <!-- HERO: Cohorts & Container -->\\n    <section class=\\\"card\\\" aria-labelledby=\\\"programs-hero\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <span class=\\\"pill\\\">Cohort Model</span>\\n          <h1 id=\\\"programs-hero\\\">Cohorts & Containers — practice with peers</h1>\\n          <p class=\\\"muted\\\">Joining a cohort gives you a rhythm of practice, structure and regular reflection. Each program has a distinct arc and a limited number of seats.</p>\\n        </div>\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"cohort\\\" style=\\\"width:220px;border-radius:12px\\\"/>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"grid\\\" style=\\\"margin-top:18px\\\">\\n      <div>\\n        <!-- DIAGNOSTIC: Where Do You Land? — Diagnostic -->\\n        <section class=\\\"card\\\" aria-labelledby=\\\"where-land\\\">\\n          <h2 id=\\\"where-land\\\">Where do you land? — diagnostic & placement</h2>\\n          <p class=\\\"muted\\\">After a quick intake we place you into the cohort that best supports your goals and season of life. Placement respects capacity and aspiration.</p>\\n\\n          <!-- PROGRAM: Ember -->\\n          <div id=\\\"ember\\\" style=\\\"margin-top:14px\\\">\\n            <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n              <div>\\n                <h3 style=\\\"margin:0\\\">Ember Cohort</h3>\\n                <div class=\\\"muted\\\">8 weeks — best for starting small</div>\\n              </div>\\n              <div style=\\\"text-align:right\\\">\\n                <div class=\\\"muted\\\">$980</div>\\n                <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"margin-top:8px;display:inline-block\\\">Apply</a>\\n              </div>\\n            </div>\\n            <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Weekly live sessions, short daily prompts, and a supportive peer pod. Ideal if you're building a first habit set.</p>\\n          </div>\\n\\n          <!-- PROGRAM: Verdant -->\\n          <div id=\\\"verdant\\\" style=\\\"margin-top:18px\\\">\\n            <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n              <div>\\n                <h3 style=\\\"margin:0\\\">Verdant Path</h3>\\n                <div class=\\\"muted\\\">16 weeks — deeper restructuring</div>\\n              </div>\\n              <div style=\\\"text-align:right\\\">\\n                <div class=\\\"muted\\\">$1,840</div>\\n                <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"margin-top:8px;display:inline-block\\\">Apply</a>\\n              </div>\\n            </div>\\n            <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Two live intensives, peer coaching, and a focus on habit architecture for busy lives.</p>\\n          </div>\\n\\n          <!-- PROGRAM: Lumen -->\\n          <div id=\\\"lumen\\\" style=\\\"margin-top:18px\\\">\\n            <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n              <div>\\n                <h3 style=\\\"margin:0\\\">Lumen Circle</h3>\\n                <div class=\\\"muted\\\">Ongoing — alumni & mentors</div>\\n              </div>\\n              <div style=\\\"text-align:right\\\">\\n                <div class=\\\"muted\\\">$250/mo</div>\\n                <a class=\\\"btn\\\" href=\\\"contact.html\\\" style=\\\"margin-top:8px;display:inline-block\\\">Join Waitlist</a>\\n              </div>\\n            </div>\\n            <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Continued practice, monthly themes and peer-led sessions to sustain progress after cohort completion.</p>\\n          </div>\\n        </section>\\n\\n        <!-- MICRO_HABITS: Tiny Habits Library -->\\n        <section class=\\\"card\\\" aria-labelledby=\\\"habits-title\\\" style=\\\"margin-top:16px\\\">\\n          <h2 id=\\\"habits-title\\\">Tiny Habits Library</h2>\\n          <p class=\\\"muted\\\">A curated library of quick practices included in every program. Pick one to try today.</p>\\n          <ul class=\\\"muted\\\" style=\\\"margin-top:12px\\\">\\n            <li>2-minute arrival breath</li>\\n            <li>Single-question reflection at day's end</li>\\n            <li>Signal rituals for transitions</li>\\n          </ul>\\n        </section>\\n\\n        <!-- PRICING: Pricing & Seats (different framing) -->\\n        <section class=\\\"card\\\" aria-labelledby=\\\"seats-title\\\" style=\\\"margin-top:16px\\\">\\n          <h2 id=\\\"seats-title\\\">Pricing & Seats — invest in rhythm</h2>\\n          <p class=\\\"muted\\\">We price by format and access. Early-bird discounts available for each intake. Scholarships per cohort — contact to discuss.</p>\\n          <div style=\\\"display:flex;gap:12px;margin-top:12px\\\">\\n            <div style=\\\"flex:1;background:linear-gradient(180deg,rgba(255,214,165,0.03),transparent);padding:12px;border-radius:10px\\\">\\n              <strong>Early Bird</strong>\\n              <div class=\\\"muted\\\">10% off (first 10 seats)</div>\\n            </div>\\n            <div style=\\\"flex:1;background:linear-gradient(180deg,rgba(255,214,165,0.03),transparent);padding:12px;border-radius:10px\\\">\\n              <strong>Scholarship</strong>\\n              <div class=\\\"muted\\\">Need-based reductions — apply confidentially</div>\\n            </div>\\n          </div>\\n        </section>\\n      </div>\\n\\n      <aside>\\n        <!-- CTA: Apply to a Cohort -->\\n        <section class=\\\"card\\\" aria-labelledby=\\\"apply-cta\\\">\\n          <h3 id=\\\"apply-cta\\\">Apply to a cohort</h3>\\n          <p class=\\\"muted\\\">Spaces are small. Submit the intake and a short note about your intention.</p>\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start Intake</a>\\n          <div style=\\\"margin-top:16px\\\" class=\\\"muted\\\">\\n            <strong>Next intake:</strong>\\n            <div>Quarterly — limited seats per track</div>\\n          </div>\\n        </section>\\n\\n        <!-- MINI DIAGNOSTIC: Quick Placement -->\\n        <section class=\\\"card\\\" style=\\\"margin-top:12px\\\" aria-labelledby=\\\"mini-dx\\\">\\n          <h4 id=\\\"mini-dx\\\">Quick Placement</h4>\\n          <p class=\\\"muted\\\">Two quick questions to see which program fits best.</p>\\n          <ol class=\\\"muted\\\">\\n            <li>Are you beginning or continuing a practice?</li>\\n            <li>Do you need daily structure or monthly support?</li>\\n          </ol>\\n          <a class=\\\"btn\\\" href=\\\"contact.html\\\" style=\\\"margin-top:10px;display:inline-block\\\">Ask for guidance</a>\\n        </section>\\n\\n        <!-- FAQ: different questions -->\\n        <section class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4>Questions often asked</h4>\\n          <div style=\\\"margin-top:8px\\\" class=\\\"muted\\\">\\n            <strong>How intensive is the cohort?</strong>\\n            <div>Weekly live sessions + daily micro-practices — balanced for busy lives.</div>\\n            <strong style=\\\"margin-top:8px;display:block\\\">Can I join mid-cohort?</strong>\\n            <div>Usually we enroll at the start to preserve the arc, but contact us for exceptions.</div>\\n          </div>\\n        </section>\\n\\n        <section class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" style=\\\"width:100%;border-radius:10px\\\"/>\\n        </section>\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:var(--max);margin:0 auto;padding:18px;color:var(--muted);text-align:center\\\">Facilitated by {{COACH_NAME}} • {{CREDENTIALS}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent)\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
