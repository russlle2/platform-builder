          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f1020;--card:#0f1724;--accent:#c9a96d;--muted:#9aa3b2;--glass:rgba(255,255,255,0.04);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial}\\n    html,body{height:100%}body{margin:0;background:linear-gradient(180deg,#07101a 0%,#08121b 60%);color:#e6eef6}\\n    .wrap{max-width:1100px;margin:48px auto;padding:36px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:12px;box-shadow:0 10px 30px rgba(2,6,23,0.6)}\\n    header{display:flex;align-items:center;justify-content:space-between;gap:24px}\\n    nav a{color:#dce8f7;text-decoration:none;margin:0 12px;font-weight:600;font-size:14px;opacity:.9}\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:28px;align-items:center;margin-top:28px}\\n    .hero h1{font-size:28px;line-height:1.05;margin:0 0 12px;color:#fff}\\n    .hero p.lead{margin:0;color:var(--muted);font-size:15px}\\n    .card{background:var(--glass);padding:20px;border-radius:10px}\\n    .avatar{width:96px;height:96px;border-radius:12px;overflow:hidden;background:#081025;display:flex;align-items:center;justify-content:center}\\n    .meta{display:flex;gap:12px;align-items:center}\\n    .values{display:flex;gap:12px;margin-top:22px}\\n    .value{flex:1;background:linear-gradient(180deg,rgba(201,169,109,0.06),transparent);padding:18px;border-radius:10px}\\n    .value h4{margin:0 0 6px;color:#fff}\\n    .methods{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:20px}\\n    .method{background:rgba(255,255,255,0.02);padding:14px;border-radius:8px}\\n    .objections{margin-top:28px}\\n    .faq{margin-top:12px;background:rgba(255,255,255,0.02);padding:14px;border-radius:8px}\\n    .lead-magnet{display:flex;gap:12px;align-items:center;margin-top:24px}\\n    .cta{margin-top:26px}\\n    .btn{background:var(--accent);color:#08202a;padding:12px 18px;border-radius:8px;text-decoration:none;font-weight:700}\\n    footer{margin-top:36px;color:var(--muted);font-size:13px;text-align:center}\\n    /* gallery accents */\\n    .gallery{margin-top:24px;display:flex;gap:12px}\\n    .panel{flex:1;border-radius:10px;padding:18px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent)}\\n    small{color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:14px\\\">\\n        <div style=\\\"width:44px;height:44px;background:linear-gradient(135deg,var(--accent),#e6cfa1);border-radius:10px\\\"></div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"programs.html\\\">Work With Me</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Portrait of Progress: why deliberate habit design wins</h1>\\n        <p class=\\\"lead\\\">I’m {{COACH_NAME}}, {{CREDENTIALS}}. I partner with busy professionals in {{CITY}}, {{STATE}} to build practical, measurable habits that increase resilience, clarity, and energy — without burnout.</p>\\n\\n        <div class=\\\"values\\\">\\n          <div class=\\\"value\\\">\\n            <h4>Outcome-first</h4>\\n            <small>Every session maps to a concrete behavior you can test this week.</small>\\n          </div>\\n          <div class=\\\"value\\\">\\n            <h4>Evidence-aligned</h4>\\n            <small>We use behavioral science techniques tailored to your rhythm.</small>\\n          </div>\\n          <div class=\\\"value\\\">\\n            <h4>Human-forward</h4>\\n            <small>Tools fit life. Not the other way around.</small>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"methods\\\">\\n          <div class=\\\"method\\\">\\n            <strong>Micro-commitments</strong>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Short, daily actions that compound.</div>\\n          </div>\\n          <div class=\\\"method\\\">\\n            <strong>Time-blocking with boundaries</strong>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Design your day so your priorities win.</div>\\n          </div>\\n          <div class=\\\"method\\\">\\n            <strong>Reflect-and-adapt</strong>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Fast feedback cycles that preserve momentum.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"objections\\\">\\n          <h3 style=\\\"margin:12px 0 8px\\\">Common reservations</h3>\\n          <div class=\\\"faq\\\">\\n            <strong>Will this take hours every day?</strong>\\n            <p style=\\\"margin:6px 0;color:var(--muted)\\\">No. Plans start with 5–15 minute daily practices and scale only as needed.</p>\\n          </div>\\n          <div class=\\\"faq\\\" style=\\\"margin-top:8px\\\">\\n            <strong>Is this another \\\"motivation\\\" program?</strong>\\n            <p style=\\\"margin:6px 0;color:var(--muted)\\\">Motivation is unreliable. We engineer context and cues so action becomes automatic.</p>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"lead-magnet\\\">\\n          <div class=\\\"card\\\" style=\\\"flex:1\\\">\\n            <strong>Free resource — The Weekly Reset Blueprint</strong>\\n            <p style=\\\"margin:6px 0;color:var(--muted)\\\">A one-page framework to reclaim focus each Sunday. Immediate, tactical, repeatable.</p>\\n          </div>\\n          <div>\\n            <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"cta\\\">\\n          <a class=\\\"btn\\\" href=\\\"book.html\\\">Start a conversation</a>\\n          <div style=\\\"margin-top:8px;color:var(--muted);font-size:13px\\\">Or call <strong>{{PHONE}}</strong> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#dfeaf6\\\">{{EMAIL}}</a></div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\" style=\\\"display:flex;flex-direction:column;align-items:stretch;gap:16px\\\">\\n        <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n          <div class=\\\"avatar\\\"><img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\" style=\\\"width:100%;height:100%\\\"></div>\\n          <div>\\n            <div style=\\\"font-weight:800\\\">{{COACH_NAME}}</div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">{{CREDENTIALS}}</div>\\n          </div>\\n        </div>\\n        <div>\\n          <strong>Signature approach</strong>\\n          <p style=\\\"margin:8px 0 0;color:var(--muted)\\\">I combine practical habit architecture, accountability design, and portfolio-style experiments so progress is visible and sustainable.</p>\\n        </div>\\n\\n        <div class=\\\"gallery\\\">\\n          <div class=\\\"panel\\\">\\n            <small>Short term wins</small>\\n            <div style=\\\"font-weight:700;margin-top:8px\\\">Fewer decision drains</div>\\n          </div>\\n          <div class=\\\"panel\\\">\\n            <small>Medium term</small>\\n            <div style=\\\"font-weight:700;margin-top:8px\\\">Higher baseline energy</div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:auto\\\">\\n          <a class=\\\"btn\\\" href=\\\"programs.html\\\">Explore programs</a>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:inherit\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Offerings — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fafafc;--ink:#072026;--accent:#b8702f;--muted:#4b5563}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial;background:var(--bg);color:var(--ink)}\\n    .page{max-width:1100px;margin:36px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    nav a{margin-left:14px;color:var(--ink);text-decoration:none;font-weight:600}\\n    .hero{display:flex;gap:20px;align-items:center;margin-top:18px}\\n    .hero-visual{width:360px;height:240px;border-radius:12px;background:linear-gradient(180deg,#fff,#f6f7fb);display:flex;align-items:center;justify-content:center;box-shadow:0 8px 24px rgba(11,20,30,0.06)}\\n    .hero-visual img{width:92%;height:92%}\\n    .offer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:20px}\\n    .offer{background:#fff;border-radius:10px;padding:18px;border:1px solid rgba(11,20,30,0.04)}\\n    .offer h3{margin:0 0 8px}\\n    .inline{display:flex;gap:12px;align-items:center}\\n    .muted{color:var(--muted);font-size:14px}\\n    .small{font-size:13px;color:var(--muted)}\\n    .cta{margin-top:20px}\\n    .btn{background:var(--accent);color:#fff;padding:10px 14px;border-radius:8px;text-decoration:none;font-weight:700}\\n    .testimony{margin-top:20px;background:#fff;padding:14px;border-radius:10px;border:1px solid rgba(11,20,30,0.04)}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"page\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"width:44px;height:44px;background:linear-gradient(135deg,var(--accent),#f3c887);border-radius:10px\\\"></div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div class=\\\"small\\\">Practical coaching for sustained performance</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Main</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"pricing.html\\\">Rates</a>\\n        <a href=\\\"contact.html\\\">Get in touch</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1 style=\\\"margin:0 0 6px;font-size:26px\\\">Structured offerings to shift daily capacity</h1>\\n        <p class=\\\"muted\\\">Choose a delivery format that fits your schedule. Each offering uses the same core framework: Identify, Prototype, Scale.</p>\\n\\n        <div class=\\\"offer-grid\\\">\\n          <div class=\\\"offer\\\">\\n            <h3>Weekly Tune-up</h3>\\n            <p class=\\\"small\\\">30-minute sessions focused on troubleshooting habits and rapid experiments. Ideal for professionals with limited bandwidth.</p>\\n            <div style=\\\"margin-top:10px;display:flex;justify-content:space-between;align-items:center\\\">\\n              <span class=\\\"muted\\\">Subscription available</span>\\n              <a class=\\\"btn\\\" href=\\\"book.html\\\">Book a trial</a>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"offer\\\">\\n            <h3>Monthly Strategy Intensive</h3>\\n            <p class=\\\"small\\\">A 90-minute monthly planning session plus check-ins. Build and iterate a 30/60/90 day growth roadmap.</p>\\n            <div style=\\\"margin-top:10px;display:flex;justify-content:space-between;align-items:center\\\">\\n              <span class=\\\"muted\\\">Includes workbook</span>\\n              <a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve slot</a>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"offer\\\">\\n            <h3>Team Wellness Labs</h3>\\n            <p class=\\\"small\\\">Group formats that teach habit architecture and accountability rituals for small teams and leaders.</p>\\n            <div style=\\\"margin-top:10px;display:flex;justify-content:space-between;align-items:center\\\">\\n              <span class=\\\"muted\\\">Tailored pricing</span>\\n              <a class=\\\"btn\\\" href=\\\"contact.html\\\">Inquire</a>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:18px;display:flex;gap:12px;align-items:center\\\">\\n          <a class=\\\"btn\\\" href=\\\"programs.html\\\">Explore full programs</a>\\n          <a style=\\\"background:transparent;border:1px solid rgba(0,0,0,0.06);padding:10px 12px;border-radius:8px;text-decoration:none;color:var(--ink)\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"hero-visual\\\">\\n        <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\">\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">How we structure sessions</h2>\\n      <p class=\\\"small\\\">Every session follows a concise framework so you leave with a testable action: Clarify → Design → Implement → Review.</p>\\n\\n      <div class=\\\"testimony\\\">\\n        <strong>Client snapshot</strong>\\n        <p class=\\\"small\\\" style=\\\"margin-top:6px;color:var(--muted)\\\">\\\"The weekly cadence made changes stick. Small commitments, big compounding results.\\\" — Senior Product Manager</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h3 style=\\\"margin-bottom:8px\\\">Questions I often hear</h3>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px\\\">\\n        <div class=\\\"card\\\" style=\\\"background:#fff;padding:14px;border-radius:10px\\\">\\n          <strong>Will you track my sleep or diet?</strong>\\n          <p class=\\\"small\\\" style=\\\"margin-top:6px;color:var(--muted)\\\">Only when useful. We prioritize behaviors you can implement without invasive monitoring.</p>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"background:#fff;padding:14px;border-radius:10px\\\">\\n          <strong>What if I miss sessions?</strong>\\n          <p class=\\\"small\\\" style=\\\"margin-top:6px;color:var(--muted)\\\">Plans include low-friction recovery steps so backslides are reversible and not demoralizing.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:30px;color:var(--muted)\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>{{BUSINESS_NAME}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n        <div style=\\\"font-size:13px\\\">© {{BUSINESS_NAME}}</div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial;background:#f1f5f8;color:#0b1a1f}\\n    .container{max-width:1100px;margin:40px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:12px;text-decoration:none;color:#0b1a1f;font-weight:700}\\n    .intro{display:flex;gap:22px;align-items:center;margin-top:18px}\\n    .intro-text{flex:1}\\n    h1{margin:0;font-size:28px}\\n    .grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-top:20px}\\n    .tier{background:white;border-radius:12px;padding:18px;border:1px solid rgba(13,26,30,0.04)}\\n    .price{font-size:20px;font-weight:800;color:#15323a}\\n    .benefit{font-size:13px;color:#53656a;margin-top:8px}\\n    .cta{margin-top:14px}\\n    .btn{display:inline-block;padding:10px 12px;border-radius:9px;background:#15323a;color:#fff;text-decoration:none;font-weight:700}\\n    .notes{margin-top:12px;color:#54656b;font-size:13px}\\n    .faq{margin-top:20px}\\n    .faq-item{background:#fff;padding:12px;border-radius:10px;border:1px solid rgba(13,26,30,0.04);margin-bottom:10px}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"width:46px;height:46px;background:linear-gradient(135deg,#d7b27a,#f6e1c6);border-radius:10px\\\"></div>\\n        <div>\\n          <div style=\\\"font-weight:900\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:#596a6f\\\">Programs tailored to professional life</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"intro\\\">\\n      <div class=\\\"intro-text\\\">\\n        <h1>Paths: modular programs that build resilient habits</h1>\\n        <p style=\\\"margin-top:8px;color:#52686d\\\">Each path combines coaching touchpoints, a behavior plan, and a measurable milestone schedule. Pick the cadence and support intensity that fits your test phase.</p>\\n        <div style=\\\"margin-top:12px\\\">\\n          <a class=\\\"btn\\\" href=\\\"book.html\\\">Discuss which path fits</a>\\n          <a style=\\\"margin-left:10px;text-decoration:none;padding:10px 12px;border-radius:9px;background:transparent;border:1px solid #dfe7e9;color:#15323a\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n      <div style=\\\"width:320px;background:white;border-radius:12px;padding:16px;box-shadow:0 8px 24px rgba(9,18,22,0.04)\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"visual\\\" style=\\\"width:100%;border-radius:8px\\\">\\n      </div>\\n    </section>\\n\\n    <section class=\\\"grid\\\">\\n      <div class=\\\"tier\\\">\\n        <h3>Starter Track</h3>\\n        <div class=\\\"price\\\">$95 / session</div>\\n        <div class=\\\"benefit\\\">Weekly micro-coaching + habit checklist</div>\\n        <div class=\\\"notes\\\">Best for testing new routines and quick recovery planning.</div>\\n        <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Start with a trial</a></div>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <h3>Growth Track</h3>\\n        <div class=\\\"price\\\">$540 / month (4 sessions)</div>\\n        <div class=\\\"benefit\\\">Monthly planning + weekly check-ins + private notes</div>\\n        <div class=\\\"notes\\\">Designed for measurable improvement over 12 weeks.</div>\\n        <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve your spot</a></div>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <h3>Leadership Cohort</h3>\\n        <div class=\\\"price\\\">Custom pricing</div>\\n        <div class=\\\"benefit\\\">Group facilitation + team habit architecture</div>\\n        <div class=\\\"notes\\\">For leaders wanting to embed healthier rhythms across teams.</div>\\n        <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"contact.html\\\">Request proposal</a></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h2 style=\\\"margin-bottom:10px\\\">Practical questions</h2>\\n      <div class=\\\"faq-item\\\">\\n        <strong>How long until I see progress?</strong>\\n        <p style=\\\"margin-top:8px;color:#53656a\\\">You’ll notice small wins within 1–3 weeks and stabilizing improvements in 8–12 weeks if you follow the behavioral experiments we design together.</p>\\n      </div>\\n      <div class=\\\"faq-item\\\">\\n        <strong>Do you work with shift workers or irregular schedules?</strong>\\n        <p style=\\\"margin-top:8px;color:#53656a\\\">Yes. Plans are adapted to your temporal constraints — the point is serviceable, not perfect.</p>\\n      </div>\\n      <div class=\\\"faq-item\\\">\\n        <strong>What does ongoing support look like?</strong>\\n        <p style=\\\"margin-top:8px;color:#53656a\\\">Between sessions you get concise action notes and prioritized next steps so momentum remains high without extra meetings.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px;background:#fff;padding:14px;border-radius:10px;border:1px solid rgba(13,26,30,0.04)\\\">\\n      <strong>Lead magnet</strong>\\n      <p style=\\\"margin-top:8px;color:#53656a\\\">Download the 7-day Habit Sprint — a guided plan to test a single habit with measurable indicators.</p>\\n      <div style=\\\"margin-top:8px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Get the sprint</a></div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:24px;color:#52686d\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>{{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}}</div>\\n        <div>Serving {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
