          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investment — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f3efe8;--accent:#7b5e3a;--muted:#927a5a;--card:#fff;--glass:rgba(255,255,255,0.6)}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--accent);background-color:var(--bg);}\\n    .site{min-height:100%;display:flex;flex-direction:column;background-image:url(\\\"assets/img/pattern.svg\\\");background-repeat:repeat;}\\n    header{padding:20px 24px;background:linear-gradient(180deg,rgba(123,94,58,0.08),transparent);}\\n    nav{display:flex;gap:18px;align-items:center;flex-wrap:wrap}\\n    nav a{color:var(--accent);text-decoration:none;font-weight:600}\\n    .brand{font-weight:700;font-size:18px}\\n    main{padding:28px;max-width:980px;margin:0 auto;flex:1}\\n    .hero{background:var(--card);padding:22px;border-radius:12px;box-shadow:0 6px 18px rgba(115,85,56,0.08);margin-bottom:20px}\\n    h1{margin:0 0 6px 0;font-size:24px}\\n    p.lead{margin:0;color:var(--muted)}\\n    .tiers{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-top:18px}\\n    .tier{background:var(--card);padding:18px;border-radius:10px;border:1px solid rgba(123,94,58,0.06)}\\n    .tier h3{margin:0 0 8px 0}\\n    .price{font-size:20px;color:var(--accent);font-weight:700}\\n    .features{margin:12px 0 0 0;padding:0;list-style:none;color:var(--muted);font-size:14px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:8px;background:var(--accent);color:white;text-decoration:none}\\n    footer{padding:18px;text-align:center;color:var(--muted);font-size:13px}\\n    .note{font-size:13px;color:var(--muted);margin-top:12px}\\n    .addon{background:linear-gradient(180deg,rgba(123,94,58,0.04),transparent);padding:12px;border-radius:8px;margin-top:12px}\\n    @media(print){nav,footer,.brand{display:none}body{background:white}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <header>\\n      <nav>\\n        <div class=\\\"brand\\\"><a href=\\\"index.html\\\">{{BUSINESS_NAME}}</a></div>\\n        <a href=\\\"about.html\\\">Meet</a>\\n        <a href=\\\"services.html\\\">Work</a>\\n        <a href=\\\"programs.html\\\">Journeys</a>\\n        <a href=\\\"pricing.html\\\" aria-current=\\\"page\\\">Investment</a>\\n        <a href=\\\"testimonials.html\\\">Kind Words</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"hero\\\">\\n        <h1>Thoughtful packages, practical add-ons</h1>\\n        <p class=\\\"lead\\\">Choose a core path and tailor it. Sessions, short intensives, and supportive add-ons designed to help you shape practices that stick rather than promise overnight change.</p>\\n        <div class=\\\"note\\\">All work centers on habits, daily frameworks, and simple repeatable steps — no medical claims. Local calls and remote options available in {{CITY}}, {{STATE}}.</div>\\n      </section>\\n\\n      <section class=\\\"tiers\\\">\\n        <div class=\\\"tier\\\">\\n          <h3>Starter Series</h3>\\n          <div class=\\\"price\\\">3 sessions — $375</div>\\n          <ul class=\\\"features\\\">\\n            <li>Initial clarity session + two follow-ups</li>\\n            <li>Practical habit micro-plan</li>\\n            <li>Email check-ins (2 weeks)</li>\\n          </ul>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Begin with a Starter</a>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <h3>Foundations Program</h3>\\n          <div class=\\\"price\\\">6 sessions — $690</div>\\n          <ul class=\\\"features\\\">\\n            <li>Deeper routine building</li>\\n            <li>7-day challenge template</li>\\n            <li>Personal session planner export</li>\\n          </ul>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve Foundations</a>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <h3>Seasonal Reset</h3>\\n          <div class=\\\"price\\\">Short intensive — $220</div>\\n          <ul class=\\\"features\\\">\\n            <li>Focused 90-minute workshop</li>\\n            <li>One-week follow-up checklist</li>\\n            <li>Printable plan</li>\\n          </ul>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Book a Reset</a>\\n        </div>\\n      </section>\\n\\n      <aside class=\\\"addon\\\">\\n        <strong>Add-ons:</strong>\\n        <ul style=\\\"margin:8px 0 0 18px;color:var(--muted)\\\">\\n          <li>Meal-pattern notes — $45</li>\\n          <li>Guided journaling template — $30</li>\\n          <li>SMS reminders (2 weeks) — $35</li>\\n        </ul>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\">Add any of these when you <a href=\\\"book.html\\\">reserve a session</a>.</div>\\n      </aside>\\n\\n      <section style=\\\"margin-top:18px;background:var(--card);padding:14px;border-radius:10px\\\">\\n        <h3 style=\\\"margin:0 0 8px 0\\\">Why the pricing is shaped this way</h3>\\n        <p style=\\\"margin:0;color:var(--muted)\\\">Plans are framed as tools: a brief set of coordinated choices you can try, iterate, and keep. If you want a custom pathway beyond the listed packages, reach out and we'll design a tailored series.</p>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px;padding:14px;background:linear-gradient(180deg,rgba(123,94,58,0.03),transparent);border-radius:10px\\\">\\n        <h3 style=\\\"margin-top:0\\\">Next steps</h3>\\n        <p style=\\\"margin:0 0 8px 0;color:var(--muted)\\\">Curious? Use the Reserve link to open an intake and try the free Session Planner there to sketch what a first meeting might produce for you.</p>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Open Reservation</a>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div style=\\\"margin-top:6px\\\">Serving the area around {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Kind Words — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbf8f3;--accent:#6b4f36;--muted:#8b745f;--card:#fff}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;background:var(--bg);color:var(--accent)}\\n    .wrap{max-width:980px;margin:0 auto;padding:24px;background-image:url('assets/img/pattern.svg')}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:12px;color:var(--accent);text-decoration:none;font-weight:600}\\n    h1{margin:6px 0 2px 0}\\n    .grid{display:grid;grid-template-columns:1fr;gap:12px;margin-top:18px}\\n    .card{background:var(--card);padding:16px;border-radius:10px;box-shadow:0 6px 18px rgba(107,79,54,0.06)}\\n    .quote{font-size:15px;color:var(--muted);margin:8px 0}\\n    .by{font-weight:700;color:var(--accent)}\\n    .small{font-size:13px;color:var(--muted)}\\n    .cta{display:inline-block;margin-top:14px;padding:10px 12px;border-radius:8px;background:var(--accent);color:white;text-decoration:none}\\n    .widget-tease{margin-top:12px;padding:12px;background:linear-gradient(180deg,rgba(107,79,54,0.05),transparent);border-radius:8px}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <a href=\\\"index.html\\\" class=\\\"brand\\\">{{BUSINESS_NAME}}</a>\\n      </div>\\n      <nav>\\n        <a href=\\\"about.html\\\">Meet</a>\\n        <a href=\\\"services.html\\\">Work</a>\\n        <a href=\\\"programs.html\\\">Journeys</a>\\n        <a href=\\\"pricing.html\\\">Investment</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <h1>Kind words from people who carved small routines</h1>\\n      <p class=\\\"small\\\">Stories about steady shifts, clearer evenings, and habits that felt possible. Names withheld where requested.</p>\\n\\n      <section class=\\\"grid\\\">\\n        <article class=\\\"card\\\">\\n          <div class=\\\"quote\\\">\\\"I stopped trying to overhaul everything. Instead we set three tiny moves each morning that actually fit my life. Months later, the days feel quieter and more ordered.\\\"</div>\\n          <div class=\\\"by\\\">— A local client</div>\\n        </article>\\n\\n        <article class=\\\"card\\\">\\n          <div class=\\\"quote\\\">\\\"The session planner helped me see what two practical sessions could look like. I downloaded the summary and used it as my weekly checklist.\\\"</div>\\n          <div class=\\\"by\\\">— A returning participant</div>\\n        </article>\\n\\n        <article class=\\\"card\\\">\\n          <div class=\\\"quote\\\">\\\"We tried a 7-day challenge suggested during coaching. It wasn't dramatic, but it was steady — and I kept at it beyond the week.\\\"</div>\\n          <div class=\\\"by\\\">— Workshop attendee</div>\\n        </article>\\n\\n      </section>\\n\\n      <section class=\\\"widget-tease\\\">\\n        <strong>Try a quick plan</strong>\\n        <p class=\\\"small\\\" style=\\\"margin:8px 0 0 0\\\">Curious how a first meeting or short series might be structured? The Reserve page includes a lightweight Session Planner and a printable 7-day challenge you can generate and take away.</p>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Open Session Planner</a>\\n      </section>\\n\\n    </main>\\n\\n    <footer style=\\\"margin-top:18px;text-align:center;color:var(--muted)\\\">\\n      <div>{{BUSINESS_NAME}} — <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> — <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f8f4ee;--accent:#6f4b2e;--muted:#8b6f58;--card:#fff}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--accent);background:var(--bg)}\\n    .wrap{max-width:1100px;margin:0 auto;padding:20px;background-image:url('assets/img/pattern.svg');}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}\\n    nav a{margin-left:12px;color:var(--accent);text-decoration:none;font-weight:600}\\n    .intro{background:linear-gradient(180deg,rgba(111,75,46,0.03),transparent);padding:16px;border-radius:10px}\\n    h1{margin:0 0 6px 0}\\n    .cols{display:grid;grid-template-columns:1fr 420px;gap:18px;margin-top:16px}\\n    .panel{background:var(--card);padding:14px;border-radius:10px;box-shadow:0 8px 20px rgba(111,75,46,0.06)}\\n    label{display:block;font-weight:700;margin-top:8px}\\n    input[type=text],select,textarea{width:100%;padding:8px;border-radius:8px;border:1px solid rgba(111,75,46,0.12);margin-top:6px}\\n    button{background:var(--accent);color:white;padding:10px 12px;border-radius:8px;border:0;margin-top:10px}\\n    .summary{white-space:pre-wrap;background:#fbf7f1;padding:12px;border-radius:8px;border:1px dashed rgba(111,75,46,0.06);min-height:120px}\\n    .small{font-size:13px;color:var(--muted)}\\n    .habit-list{list-style:none;padding:0;margin:10px 0}\\n    .habit-list li{padding:8px;border-radius:6px;border:1px solid rgba(111,75,46,0.06);margin-bottom:6px;background:linear-gradient(180deg,rgba(111,75,46,0.02),transparent)}\\n    .print-area{display:none}\\n    @media print{body *{visibility:hidden} .print-area, .print-area *{visibility:visible} .print-area{position:fixed;left:0;top:0;width:100%}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\"><a href=\\\"index.html\\\">{{BUSINESS_NAME}}</a></div>\\n      <nav>\\n        <a href=\\\"about.html\\\">Meet</a>\\n        <a href=\\\"services.html\\\">Work</a>\\n        <a href=\\\"programs.html\\\">Journeys</a>\\n        <a href=\\\"pricing.html\\\">Investment</a>\\n        <a href=\\\"testimonials.html\\\">Kind Words</a>\\n        <a href=\\\"book.html\\\" aria-current=\\\"page\\\">Reserve</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"intro\\\">\\n        <h1>Reserve and plan, in the same sitting</h1>\\n        <p class=\\\"small\\\">Use the tools below to sketch a session plan and create a 7-day habit challenge you can print or copy into a note app. When you're ready, use the Reserve button to request a time.</p>\\n      </section>\\n\\n      <div class=\\\"cols\\\">\\n        <div>\\n          <section class=\\\"panel\\\">\\n            <h2 style=\\\"margin-top:0\\\">Session Planner</h2>\\n            <p class=\\\"small\\\">Draft a single session or a short series. The planner creates a plaintext summary you can copy and paste into an email or your notes.</p>\\n\\n            <label for=\\\"clientName\\\">Name or nickname</label>\\n            <input id=\\\"clientName\\\" type=\\\"text\\\" placeholder=\\\"Your name\\\">\\n\\n            <label for=\\\"goal\\\">Primary goal for sessions</label>\\n            <input id=\\\"goal\\\" type=\\\"text\\\" placeholder=\\\"Example: Better sleep rhythm, steadier mornings\\\">\\n\\n            <label for=\\\"focus\\\">Focus areas</label>\\n            <select id=\\\"focus\\\" multiple size=\\\"4\\\">\\n              <option>Morning routine</option>\\n              <option>Evening wind-down</option>\\n              <option>Nutrition patterns</option>\\n              <option>Movement & micro-exercises</option>\\n              <option>Stress-handling steps</option>\\n            </select>\\n\\n            <label for=\\\"length\\\">Session length</label>\\n            <select id=\\\"length\\\">\\n              <option>30 minutes</option>\\n              <option selected>60 minutes</option>\\n              <option>90 minutes</option>\\n            </select>\\n\\n            <label for=\\\"freq\\\">Suggested cadence</label>\\n            <select id=\\\"freq\\\">\\n              <option>One-off</option>\\n              <option>Weekly</option>\\n              <option>Bi-weekly</option>\\n              <option>Intensive: twice in a week</option>\\n            </select>\\n\\n            <label for=\\\"notes\\\">Notes or constraints</label>\\n            <textarea id=\\\"notes\\\" rows=\\\"3\\\" placeholder=\\\"Times you prefer, mobility notes, support needed...\\\"></textarea>\\n\\n            <button id=\\\"buildPlan\\\">Build plan summary</button>\\n            <button id=\\\"copyPlan\\\" style=\\\"margin-left:8px;background:#4b7a58\\\">Copy summary</button>\\n\\n            <h3 style=\\\"margin-top:12px\\\">Plan summary</h3>\\n            <div id=\\\"planOutput\\\" class=\\\"summary\\\">Use the form above and choose Build plan summary.</div>\\n          </section>\\n\\n          <section class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n            <h2 style=\\\"margin-top:0\\\">Reserve a session</h2>\\n            <p class=\\\"small\\\">When you're ready, click Reserve to open an email template with the plan attached.</p>\\n            <button id=\\\"openEmail\\\">Reserve — open email</button>\\n            <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Or reach directly: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n          </section>\\n        </div>\\n\\n        <aside>\\n          <section class=\\\"panel\\\">\\n            <h2 style=\\\"margin-top:0\\\">7-day Habit Challenge</h2>\\n            <p class=\\\"small\\\">Generate a focused seven-day habit with a printable checklist. Pick a theme and tune intensity.</p>\\n\\n            <label for=\\\"theme\\\">Theme</label>\\n            <select id=\\\"theme\\\">\\n              <option>Gentle mornings</option>\\n              <option>Sleep wind-down</option>\\n              <option>Micro-movement</option>\\n              <option>Mindful meals</option>\\n              <option>Calm check-ins</option>\\n            </select>\\n\\n            <label for=\\\"intensity\\\">Intensity</label>\\n            <select id=\\\"intensity\\\">\\n              <option value=\\\"low\\\">Low — 1 small step/day</option>\\n              <option value=\\\"med\\\" selected>Medium — 2 small steps/day</option>\\n              <option value=\\\"high\\\">High — 3 small steps/day</option>\\n            </select>\\n\\n            <button id=\\\"genHabit\\\">Generate challenge</button>\\n            <button id=\\\"printHabit\\\" style=\\\"margin-left:8px;background:#4b7a58\\\">Print checklist</button>\\n\\n            <div id=\\\"habitArea\\\" style=\\\"margin-top:12px\\\">\\n              <div class=\\\"small\\\">No challenge generated yet.</div>\\n            </div>\\n          </section>\\n\\n          <section class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n            <h3 style=\\\"margin-top:0\\\">Quick tips</h3>\\n            <ul class=\\\"small\\\" style=\\\"margin:8px 0 0 18px;color:var(--muted)\\\">\\n              <li>Keep tasks tiny — consistency > intensity.</li>\\n              <li>Pair habits with an anchor (coffee, commute, bedtime).</li>\\n              <li>Use the printable checklist to track wins.</li>\\n            </ul>\\n          </section>\\n        </aside>\\n      </div>\\n\\n    </main>\\n\\n    <footer style=\\\"margin-top:18px;text-align:center;color:var(--muted)\\\">\\n      <div>{{BUSINESS_NAME}} — <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> — <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </footer>\\n\\n    <!-- Printable area for habit checklist -->\\n    <div id=\\\"printable\\\" class=\\\"print-area\\\" aria-hidden=\\\"true\\\"></div>\\n\\n  </div>\\n\\n  <script>\\n    // Session Planner logic\\n    function getSelectedOptions(select){const s=[];for(const o of select.options) if(o.selected) s.push(o.value);return s.join(', ')}\\n    function buildSummary(){\\n      const name=document.getElementById('clientName').value.trim()||'Participant';\\n      const goal=document.getElementById('goal').value.trim()||'N/A';\\n      const focus=getSelectedOptions(document.getElementById('focus'))||'General practices';\\n      const length=document.getElementById('length').value;\\n      const freq=document.getElementById('freq').value;\\n      const notes=document.getElementById('notes').value.trim()||'None';\\n\\n      const lines=[];\\n      lines.push('Session plan for: '+name);\\n      lines.push('Primary goal: '+goal);\\n      lines.push('Focus areas: '+focus);\\n      lines.push('Session length: '+length+' | Cadence: '+freq);\\n      lines.push('Notes: '+notes);\\n      lines.push('\\\\nSuggested outline:');\\n      lines.push('- Opening check-in (5–10m)');\\n      lines.push('- Brief review of recent practice (5–10m)');\\n      lines.push('- Focused technique or micro-habit setup (20–40m)');\\n      lines.push('- Concrete practice to try before next meeting (3–5 items)');\\n      lines.push('\\\\nFollow-up: Email summary and a 7-day checklist where useful.');\\n\\n      return lines.join('\\\\n');\\n    }\\n\\n    document.getElementById('buildPlan').addEventListener('click',function(){\\n      const txt=buildSummary();\\n      document.getElementById('planOutput').textContent=txt;\\n    });\\n\\n    document.getElementById('copyPlan').addEventListener('click',async function(){\\n      const txt=document.getElementById('planOutput').textContent;\\n      try{await navigator.clipboard.writeText(txt);alert('Plan copied to clipboard');}\\n      catch(e){const ta=document.createElement('textarea');ta.value=txt;document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);alert('Plan copied (fallback)');}\\n    });\\n\\n    document.getElementById('openEmail').addEventListener('click',function(){\\n      const subject=encodeURIComponent('Request to reserve a session');\\n      const body=encodeURIComponent(document.getElementById('planOutput').textContent + '\\\\n\\\\nPreferred times: ');\\n      window.location.href='mailto:{{EMAIL}}?subject='+subject+'&body='+body;\\n    });\\n\\n    // Habit builder logic\\n    const themes={\\n      'Gentle mornings':['Open curtains for light','Drink a glass of water','Stand and stretch 90s','Write one gratitude line','Set one small intention','Prep clothes for tomorrow','Pause for 60s breath'],\\n      'Sleep wind-down':['Dim lights 60m before bed','Phone-free 30m before bed','Warm drink (non-caffeinated)','Light stretch or progressive relax','Journal one thought','Set a 7-hour target','Turn off bright screens'],\\n      'Micro-movement':['2-minute walking breaks hourly','Desk stretches at noon','10 squats mid-day','Short walk after dinner','Standing while on calls','Calf raises while waiting','Wind-down stretch'],\\n      'Mindful meals':['Eat without screens once daily','Chew slowly 20 times','Notice fullness midway','Intentional portion on plate','Hydrate before meal','Describe flavors for 30s','Finish with a breath'],\\n      'Calm check-ins':['3-point body scan','Label an emotion','Breathe 4-4-4','One small pause before reply','Notice posture check','List 3 micro-wins','Reset with a short walk']\\n    };\\n\\n    function pickSteps(theme,intensity){\\n      const pool=themes[theme]||themes['Calm check-ins'];\\n      const per={'low':1,'med':2,'high':3}[intensity]||2;\\n      // Rotate slices: create each day's list\\n      const days=[];\\n      for(let d=0;d<7;d++){\\n        const start=(d*per) % pool.length;\\n        const items=[];\\n        for(let i=0;i<per;i++) items.push(pool[(start+i)%pool.length]);\\n        days.push(items);\\n      }\\n      return days;\\n    }\\n\\n    function renderHabit(theme,intensity){\\n      const days=pickSteps(theme,intensity);\\n      const container=document.getElementById('habitArea');\\n      container.innerHTML='';\\n      const title=document.createElement('div');title.innerHTML='<strong>7-day: '+theme+' ('+(intensity==='low'?'Low':intensity==='med'?'Medium':'High')+')</strong>';container.appendChild(title);\\n      const ul=document.createElement('ul');ul.className='habit-list';\\n      for(let i=0;i<7;i++){\\n        const li=document.createElement('li');\\n        li.innerHTML='<strong>Day '+(i+1)+':</strong> '+days[i].join(' • ');\\n        ul.appendChild(li);\\n      }\\n      container.appendChild(ul);\\n\\n      // prepare printable area\\n      const printDiv=document.getElementById('printable');\\n      printDiv.innerHTML='';\\n      const pTitle=document.createElement('h2');pTitle.textContent='7-day checklist: '+theme;printDiv.appendChild(pTitle);\\n      const pList=document.createElement('ol');\\n      for(let i=0;i<7;i++){\\n        const li=document.createElement('li');\\n        li.style.marginBottom='8px';\\n        const box=document.createElement('div');box.textContent=days[i].join(' | ');\\n        li.appendChild(box);pList.appendChild(li);\\n      }\\n      printDiv.appendChild(pList);\\n      document.getElementById('printable').setAttribute('aria-hidden','false');\\n    }\\n\\n    document.getElementById('genHabit').addEventListener('click',function(){\\n      const theme=document.getElementById('theme').value;\\n      const intensity=document.getElementById('intensity').value;\\n      renderHabit(theme,intensity);\\n    });\\n\\n    document.getElementById('printHabit').addEventListener('click',function(){\\n      // Ensure printable content exists\\n      if(!document.getElementById('printable').innerHTML.trim()){alert('Generate a challenge first');return}\\n      window.print();\\n    });\\n\\n    // Small accessibility: prefill plan output on load with template\\n    document.addEventListener('DOMContentLoaded',function(){\\n      document.getElementById('planOutput').textContent='Fill the fields and press \\\"Build plan summary\\\" to craft a concise plan you can copy or include in a reservation message.';\\n    });\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
