          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About • {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"A modern approach to steady, sustainable habit design for busy lives.\\\" />\\n  <style>\\n    :root{--bg:#f7fbf9;--card:#ffffff;--accent:#4a8c6f;--muted:#6b6b6b;--glass:rgba(255,255,255,0.7)}\\n    html,body{height:100%;margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,\\\"Segoe UI\\\",Roboto,Helvetica,Arial; color:#222}\\n    body{background-image: url('/assets/img/pattern.svg');background-size:460px;background-repeat:repeat; background-color:var(--bg)}\\n    .site{max-width:1100px;margin:32px auto;padding:24px}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#8fd6b0);display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n    nav a{margin-left:14px;color:#32513f;text-decoration:none;font-weight:600}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:22px;align-items:start}\\n    .card{background:var(--card);border-radius:12px;padding:22px;box-shadow:0 6px 30px rgba(66,77,67,0.06)}\\n    h1{margin:0 0 8px 0;font-size:26px}\\n    p.lead{margin:0;color:var(--muted)}\\n    .story{margin-top:18px;line-height:1.55}\\n    .list{display:flex;flex-direction:column;gap:10px;margin-top:12px}\\n    .pill{display:inline-block;background:linear-gradient(90deg,rgba(74,140,111,0.12),rgba(143,214,176,0.08));padding:8px 12px;border-radius:999px;color:var(--accent);font-weight:700}\\n    .framework{margin-top:18px;display:grid;grid-template-columns:repeat(3,1fr);gap:12px}\\n    .fw-item{background:linear-gradient(180deg,rgba(255,255,255,0.8),var(--glass));padding:16px;border-radius:10px}\\n    footer{margin-top:28px;display:flex;justify-content:space-between;align-items:center}\\n    .cta{background:var(--accent);color:white;padding:12px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    small{color:var(--muted)}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr}.framework{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">W</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Welcome</a>\\n        <a href=\\\"about.html\\\">Who I Am</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"programs.html\\\">Journeys</a>\\n        <a href=\\\"contact.html\\\">Reach</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"card\\\">\\n        <h1>Designing gentle momentum for busier days</h1>\\n        <p class=\\\"lead\\\">I build small, sensible habits you actually keep. No oversized commitments—just clear steps and tidy measurements that fit how your week already flows.</p>\\n\\n        <div class=\\\"story\\\">\\n          <p>I’ve coached groups and individuals for years, blending behavioral tools, rhythm-setting, and a little structure to protect the things that matter: sleep, movement, quiet focus, and meaningful rest. My work is cohort-based—participants move through a guided arc with checkpoints, accountability, and a framework that turns intention into reliable action.</p>\\n\\n          <div class=\\\"list\\\">\\n            <div class=\\\"pill\\\">Outcomes-first planning</div>\\n            <div class=\\\"pill\\\">Habits you can sustain</div>\\n            <div class=\\\"pill\\\">Cohort learning & peer rhythm</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"framework\\\">\\n          <div class=\\\"fw-item\\\">\\n            <strong>Anchor</strong>\\n            <p style=\\\"margin:8px 0 0;color:var(--muted);\\\">We pick stable touchpoints—like morning coffee or evening wind-down—to attach a tiny habit.</p>\\n          </div>\\n\\n          <div class=\\\"fw-item\\\">\\n            <strong>Micro-step</strong>\\n            <p style=\\\"margin:8px 0 0;color:var(--muted);\\\">Actions broken to their simplest form so they happen even when you’re busy.</p>\\n          </div>\\n\\n          <div class=\\\"fw-item\\\">\\n            <strong>Measure & Adjust</strong>\\n            <p style=\\\"margin:8px 0 0;color:var(--muted);\\\">A short checkpoint each week keeps the plan honest but flexible.</p>\\n          </div>\\n        </div>\\n\\n        <footer>\\n          <div>\\n            <small>Phone: {{PHONE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></small>\\n          </div>\\n          <a class=\\\"cta\\\" href=\\\"programs.html\\\">Join the next cohort</a>\\n        </footer>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Quick snapshot</h3>\\n        <p style=\\\"color:var(--muted);font-size:14px\\\">If your week feels scattered, choose 3 tiny anchors to test for 14 days. Keep what moves the needle. Drop the rest.</p>\\n\\n        <div style=\\\"margin-top:12px;display:flex;gap:10px;flex-direction:column\\\">\\n          <button onclick=\\\"location.href='book.html'\\\" style=\\\"padding:10px;border-radius:8px;border:2px solid var(--accent);background:white;font-weight:700\\\">Reserve a discovery slot</button>\\n          <button onclick=\\\"location.href='services.html'\\\" style=\\\"padding:10px;border-radius:8px;border:0;background:transparent;color:var(--accent);font-weight:700\\\">Explore offerings</button>\\n        </div>\\n\\n        <hr style=\\\"margin:16px 0;border:none;border-top:1px solid #eef5ef\\\" />\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">\\n          <strong>Who I work with</strong>\\n          <p style=\\\"margin:6px 0 0\\\">Professionals, caretakers, and people who want dependable habits without doubling their workload.</p>\\n        </div>\\n      </aside>\\n    </section>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Offerings • {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Services: 1:1 sessions, micro-cohorts, and hands-on tools to build reliable habits.\\\" />\\n  <style>\\n    :root{--bg:#fffdfa;--card:#ffffff;--accent:#6b9b7a;--muted:#5a5a5a}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;color:#1f2d28;background:var(--bg);background-image:url('/assets/img/pattern.svg');background-size:420px}\\n    .wrap{max-width:1100px;margin:28px auto;padding:22px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,#6b9b7a,#c3ebd3);display:flex;justify-content:center;align-items:center;color:white;font-weight:800}\\n    nav a{margin-left:14px;text-decoration:none;color:var(--muted);font-weight:600}\\n    main{display:grid;grid-template-columns:1fr 380px;gap:20px;margin-top:20px}\\n    .service-list{display:flex;flex-direction:column;gap:14px}\\n    .service{background:var(--card);border-radius:12px;padding:16px;box-shadow:0 8px 30px rgba(35,45,35,0.06)}\\n    .service h3{margin:0 0 6px 0}\\n    .muted{color:var(--muted)}\\n    .tool{background:#f1fbf4;border-radius:10px;padding:12px;margin-top:12px}\\n    .session-planner{margin-top:12px}\\n    label{display:block;font-size:13px;margin-top:8px}\\n    input,select,textarea{width:100%;padding:8px;margin-top:6px;border-radius:8px;border:1px solid #e6efe6}\\n    .row{display:flex;gap:10px}\\n    button{background:var(--accent);color:white;padding:10px 12px;border-radius:10px;border:0;font-weight:700}\\n    .secondary{background:transparent;border:2px solid var(--accent);color:var(--accent)}\\n    footer{margin-top:22px;color:var(--muted);font-size:13px}\\n    @media(max-width:980px){main{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">W</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n\\n      <nav>\\n        <a href=\\\"index.html\\\">Welcome</a>\\n        <a href=\\\"about.html\\\">Who I Am</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"programs.html\\\">Journeys</a>\\n        <a href=\\\"contact.html\\\">Reach</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section>\\n        <h2 style=\\\"margin-top:0\\\">Offerings tuned for real weeks</h2>\\n        <p class=\\\"muted\\\">Short engagements, multi-week cohorts, and tools you can use right away. The aim: simple wins that last.</p>\\n\\n        <div class=\\\"service-list\\\">\\n          <div class=\\\"service\\\">\\n            <h3>Navigator Session — 60 min</h3>\\n            <p class=\\\"muted\\\">A focused planning session. We clarify one outcome, map anchors, and leave with a 7-day starter plan.</p>\\n            <div style=\\\"margin-top:10px;display:flex;gap:10px\\\"><a class=\\\"secondary\\\" href=\\\"book.html\\\">Book a slot</a><a href=\\\"programs.html\\\" style=\\\"text-decoration:none;padding:10px 12px;border-radius:10px;background:var(--accent);color:white;font-weight:700\\\">See cohorts</a></div>\\n          </div>\\n\\n          <div class=\\\"service\\\">\\n            <h3>Mini Cohort — 6 weeks</h3>\\n            <p class=\\\"muted\\\">Group-based learning with weekly check-ins, short lessons, and shared accountability. Small groups, focused work.</p>\\n            <div style=\\\"margin-top:10px\\\">Starting soon: <strong>Spring Rhythm</strong></div>\\n          </div>\\n\\n          <div class=\\\"service\\\">\\n            <h3>Toolkit & Follow-up</h3>\\n            <p class=\\\"muted\\\">Exportable session plans, printable checklists, and a follow-up touchpoint to keep momentum after the cohort ends.</p>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"service card tool\\\">\\n          <h3 style=\\\"margin:0\\\">Session Planner</h3>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Craft a short session plan and export a plain-text summary you can copy into notes or send to teammates.</p>\\n\\n          <div class=\\\"session-planner\\\">\\n            <label>Focus (what you'd like to change)</label>\\n            <input id=\\\"focus\\\" placeholder=\\\"e.g., more steady energy afternoons\\\" />\\n\\n            <label>Primary anchor</label>\\n            <select id=\\\"anchor\\\">\\n              <option>Morning coffee</option>\\n              <option>Right after lunch</option>\\n              <option>Before bed</option>\\n              <option>During commute</option>\\n            </select>\\n\\n            <label>Tiny step (one action)</label>\\n            <input id=\\\"step\\\" placeholder=\\\"e.g., 5-minute walk, 2-minute breath work\\\" />\\n\\n            <label>Weekly checkpoint</label>\\n            <select id=\\\"checkpoint\\\">\\n              <option>Sunday planning</option>\\n              <option>Midweek check-in</option>\\n              <option>End-of-week reflection</option>\\n            </select>\\n\\n            <label>Length (minutes for weekly check-in)</label>\\n            <input id=\\\"length\\\" type=\\\"number\\\" min=\\\"5\\\" value=\\\"10\\\" />\\n\\n            <div style=\\\"display:flex;gap:10px;margin-top:12px\\\">\\n              <button id=\\\"buildPlan\\\">Build plan</button>\\n              <button id=\\\"copyPlan\\\" class=\\\"secondary\\\">Copy summary</button>\\n            </div>\\n\\n            <pre id=\\\"planOutput\\\" style=\\\"white-space:pre-wrap;margin-top:12px;padding:12px;border-radius:8px;background:#f6fdf6;border:1px solid #e6efe6\\\"></pre>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin-top:0\\\">Quick tools</h4>\\n          <p class=\\\"muted\\\">Small utilities to make habit experiments less messy.</p>\\n          <ul style=\\\"padding-left:18px;margin-top:6px;color:var(--muted)\\\">\\n            <li>7-day challenge templates</li>\\n            <li>Checklist PDF (print-friendly)</li>\\n            <li>Group onboarding packet</li>\\n          </ul>\\n\\n          <div style=\\\"margin-top:14px;display:flex;gap:8px\\\">\\n            <a href=\\\"programs.html\\\" style=\\\"text-decoration:none;padding:10px 12px;border-radius:8px;background:var(--accent);color:white;font-weight:700\\\">Browse journeys</a>\\n            <a href=\\\"contact.html\\\" style=\\\"text-decoration:none;padding:10px 12px;border-radius:8px;border:2px solid var(--accent);color:var(--accent);background:transparent\\\">Ask a question</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin-top:0\\\">Contact</h4>\\n          <p class=\\\"muted\\\">Curious about custom cohorts? Send a note.</p>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a><br/>Phone: {{PHONE}}</div>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <footer style=\\\"margin-top:20px;color:var(--muted);font-size:13px\\\">Serving clients in {{CITY}}, {{STATE}} • Copyright © <span id=\\\"year\\\"></span></footer>\\n  </div>\\n\\n  <script>\\n    document.getElementById('year').textContent = new Date().getFullYear();\\n\\n    // Session Planner logic\\n    function buildPlanText(){\\n      var focus = document.getElementById('focus').value.trim();\\n      var anchor = document.getElementById('anchor').value;\\n      var step = document.getElementById('step').value.trim();\\n      var checkpoint = document.getElementById('checkpoint').value;\\n      var length = document.getElementById('length').value;\\n      if(!focus) focus = '[your focus]';\\n      if(!step) step = '[tiny step]';\\n      var text = \\\"Session Plan:\\\\n\\\"+\\n                 \\\"Focus: \\\"+focus+\\\"\\\\n\\\"+\\n                 \\\"Anchor: \\\"+anchor+\\\"\\\\n\\\"+\\n                 \\\"Tiny step: \\\"+step+\\\"\\\\n\\\"+\\n                 \\\"Weekly checkpoint: \\\"+checkpoint+\\\" (\\\"+length+\\\" min)\\\\n\\\\n\\\"+\\n                 \\\"Suggested 7-day starter:\\\\n\\\"+\\n                 \\\"Day 1: Try the tiny step at the anchor, note how it felt.\\\\n\\\"+\\n                 \\\"Day 2-3: Repeat and keep notes in a single sentence.\\\\n\\\"+\\n                 \\\"Day 4: Short checkpoint—did it fit your flow?\\\\n\\\"+\\n                 \\\"Day 5-6: Tweak timing by 15 minutes if needed.\\\\n\\\"+\\n                 \\\"Day 7: Reflect at the weekly checkpoint and decide next micro-adjustment.\\\";\\n      return text;\\n    }\\n\\n    document.getElementById('buildPlan').addEventListener('click',function(){\\n      var out = buildPlanText();\\n      document.getElementById('planOutput').textContent = out;\\n    });\\n\\n    document.getElementById('copyPlan').addEventListener('click',function(){\\n      var text = document.getElementById('planOutput').textContent;\\n      if(!text) { alert('Build a plan first'); return; }\\n      navigator.clipboard.writeText(text).then(function(){\\n        var old = document.getElementById('copyPlan').textContent;\\n        document.getElementById('copyPlan').textContent = 'Copied!';\\n        setTimeout(function(){document.getElementById('copyPlan').textContent = old;},1600);\\n      });\\n    });\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Journeys • {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Cohort journeys and 7-day challenge generator to start practical habit experiments.\\\" />\\n  <style>\\n    :root{--bg:#fbfffd;--accent:#2f7f64;--muted:#5b6b63}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:var(--bg);background-image:url('/assets/img/pattern.svg');background-size:360px}\\n    .container{max-width:1100px;margin:28px auto;padding:18px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .logo{width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#2f7f64,#7fd6b3);display:flex;align-items:center;justify-content:center;color:white;font-weight:800}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .grid{display:grid;grid-template-columns:1fr 380px;gap:18px;margin-top:18px}\\n    .card{background:white;border-radius:12px;padding:16px;box-shadow:0 10px 30px rgba(40,55,45,0.06)}\\n    .programs{display:flex;flex-direction:column;gap:12px}\\n    .prog{padding:12px;border-radius:10px;border:1px solid #eef6ef}\\n    .muted{color:var(--muted)}\\n    .challenge{margin-top:12px;background:#f4fff8;padding:12px;border-radius:10px}\\n    label{display:block;margin-top:8px;font-size:13px}\\n    input,select{width:100%;padding:8px;margin-top:6px;border-radius:8px;border:1px solid #e6efe6}\\n    .controls{display:flex;gap:8px;margin-top:10px}\\n    button{background:var(--accent);color:white;padding:10px 12px;border-radius:8px;border:0;font-weight:700}\\n    .outline{background:transparent;border:2px solid var(--accent);color:var(--accent)}\\n    .checklist{margin-top:10px}\\n    .day{display:flex;align-items:center;gap:10px;padding:6px;border-radius:8px}\\n    .day input[type=checkbox]{width:18px;height:18px}\\n    @media(max-width:960px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n        <div class=\\\"logo\\\">W</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n\\n      <nav>\\n        <a href=\\\"index.html\\\">Welcome</a>\\n        <a href=\\\"about.html\\\">Who I Am</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"programs.html\\\">Journeys</a>\\n        <a href=\\\"pricing.html\\\">Investment</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"grid\\\">\\n      <main>\\n        <h2 style=\\\"margin-top:0\\\">Journeys (cohort model)</h2>\\n        <p class=\\\"muted\\\">Small cohorts, weekly prompts, and a focus on practical habit experiments. Each journey is structured to support experimentation and group reflection.</p>\\n\\n        <div class=\\\"programs\\\">\\n          <div class=\\\"card prog\\\">\\n            <h3 style=\\\"margin:0\\\">Week-by-week Reset — 6 sessions</h3>\\n            <p class=\\\"muted\\\">A guided arc to redesign daily anchors and test three micro-habits. Peer reflection and simple metrics included.</p>\\n          </div>\\n\\n          <div class=\\\"card prog\\\">\\n            <h3 style=\\\"margin:0\\\">Stability Sprint — 4 sessions</h3>\\n            <p class=\\\"muted\\\">A tighter, practical sprint for people who want structure and an easy continuation plan afterward.</p>\\n          </div>\\n\\n          <div class=\\\"card prog\\\">\\n            <h3 style=\\\"margin:0\\\">Habit Lab (mini-group)</h3>\\n            <p class=\\\"muted\\\">Hands-on experiments: we design variations, test them for one week, then scale what works.</p>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px;display:flex;gap:8px\\\">\\n          <a href=\\\"book.html\\\" style=\\\"text-decoration:none;padding:10px 12px;border-radius:8px;background:var(--accent);color:white;font-weight:700\\\">Join a cohort</a>\\n          <a href=\\\"contact.html\\\" style=\\\"text-decoration:none;padding:10px 12px;border-radius:8px;border:2px solid var(--accent);color:var(--accent);background:transparent\\\">Ask about custom dates</a>\\n        </div>\\n\\n        <section class=\\\"card challenge\\\">\\n          <h3 style=\\\"margin-top:0\\\">7-Day Challenge Generator</h3>\\n          <p class=\\\"muted\\\">Create a printable checklist for a focused week of practice. Use it for yourself or hand it out to your cohort.</p>\\n\\n          <label>Habit to try</label>\\n          <input id=\\\"habitName\\\" placeholder=\\\"e.g., 5-minute stretch after lunch\\\" />\\n\\n          <label>Intensity</label>\\n          <select id=\\\"intensity\\\">\\n            <option value=\\\"low\\\">Low (easy, shorter)</option>\\n            <option value=\\\"medium\\\" selected>Medium (practical)</option>\\n            <option value=\\\"high\\\">High (ambitious)</option>\\n          </select>\\n\\n          <label>Public name for checklist (optional)</label>\\n          <input id=\\\"title\\\" placeholder=\\\"e.g., Afternoon Reset\\\" />\\n\\n          <div class=\\\"controls\\\">\\n            <button id=\\\"generate\\\">Generate checklist</button>\\n            <button id=\\\"print\\\" class=\\\"outline\\\">Print checklist</button>\\n            <button id=\\\"copySummary\\\" class=\\\"outline\\\">Copy summary</button>\\n          </div>\\n\\n          <div id=\\\"checklistArea\\\" class=\\\"checklist\\\" style=\\\"display:none\\\">\\n            <h4 id=\\\"checkTitle\\\"></h4>\\n            <div id=\\\"days\\\"></div>\\n            <p style=\\\"margin-top:10px;color:var(--muted);font-size:13px\\\">Tip: put this on the fridge or add to your cohort welcome packet.</p>\\n          </div>\\n        </section>\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin-top:0\\\">Why cohorts?</h4>\\n          <p class=\\\"muted\\\">Cohorts turn experiments into communal learning. You get peer examples, timely adjustments, and a gentle accountability loop.</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin-top:0\\\">Next start dates</h4>\\n          <ul style=\\\"padding-left:18px;color:var(--muted)\\\">\\n            <li>May cohort: Enrollment open</li>\\n            <li>July cohort: Early-bird pricing</li>\\n          </ul>\\n          <div style=\\\"margin-top:10px\\\"><a href=\\\"pricing.html\\\" style=\\\"text-decoration:none;padding:8px 10px;border-radius:8px;background:var(--accent);color:white;font-weight:700\\\">See investment</a></div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted);font-size:13px\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • Serving {{CITY}}, {{STATE}}</footer>\\n  </div>\\n\\n  <script>\\n    // 7-day Challenge generator\\n    function generateChecklist(){\\n      var habit = document.getElementById('habitName').value.trim();\\n      var intensity = document.getElementById('intensity').value;\\n      var title = document.getElementById('title').value.trim();\\n      if(!habit) { alert('Please enter a habit to try.'); return; }\\n      var verb = 'Do';\\n      if(intensity === 'low') verb = 'Try';\\n      if(intensity === 'high') verb = 'Commit to';\\n      var checkTitle = title || (verb + ' — ' + habit);\\n      document.getElementById('checkTitle').textContent = checkTitle;\\n\\n      var days = document.getElementById('days');\\n      days.innerHTML = '';\\n      for(var i=1;i<=7;i++){\\n        var div = document.createElement('div');\\n        div.className = 'day';\\n        var chk = document.createElement('input'); chk.type='checkbox'; chk.id='d'+i;\\n        var lbl = document.createElement('label'); lbl.setAttribute('for','d'+i);\\n        lbl.style.flex='1';\\n        var suggestion = '';\\n        if(i===1) suggestion = ' — gentle experiment: observe how it feels.';\\n        if(i===4) suggestion = ' — half-week note: tweak the time if needed.';\\n        if(i===7) suggestion = ' — reflect at your checkpoint and choose next step.';\\n        lbl.textContent = 'Day '+i+': '+habit + suggestion;\\n        div.appendChild(chk); div.appendChild(lbl);\\n        days.appendChild(div);\\n      }\\n\\n      document.getElementById('checklistArea').style.display = 'block';\\n    }\\n\\n    document.getElementById('generate').addEventListener('click',generateChecklist);\\n\\n    document.getElementById('print').addEventListener('click',function(){\\n      if(document.getElementById('checklistArea').style.display==='none'){ alert('Generate the checklist first'); return; }\\n      var w = window.open('','Print','width=600,height=800');\\n      var titleHtml = document.getElementById('checkTitle').outerHTML;\\n      var bodyHtml = document.getElementById('days').outerHTML;\\n      w.document.write('<html><head><title>Checklist</title><style>body{font-family:Arial,Helvetica,sans-serif;padding:20px}h4{margin-top:0} .day{margin:8px 0}</style></head><body>'+titleHtml+bodyHtml+'<p style=\\\"margin-top:20px;color:#666;font-size:13px\\\">Generated from {{BUSINESS_NAME}}</p></body></html>');\\n      w.document.close();\\n      w.print();\\n    });\\n\\n    document.getElementById('copySummary').addEventListener('click',function(){\\n      if(document.getElementById('checklistArea').style.display==='none'){ alert('Generate the checklist first'); return; }\\n      var title = document.getElementById('checkTitle').textContent;\\n      var lines = [title,''];\\n      for(var i=1;i<=7;i++){\\n        lines.push('Day '+i+': '+document.querySelector('#days label[for=\\\"d'+i+'\\\"]').textContent.replace('Day '+i+': ','') );\\n      }\\n      var text = lines.join('\\\\n');\\n      navigator.clipboard.writeText(text).then(function(){\\n        alert('Checklist copied to clipboard');\\n      });\\n    });\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
