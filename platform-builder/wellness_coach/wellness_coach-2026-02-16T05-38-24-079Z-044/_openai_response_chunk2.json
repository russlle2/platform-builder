          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Executive wellness coaching for measurable habits, sustainable energy, and leadership clarity.\\\" />\\n  <style>\\n    :root{--bg:#0f0f10;--card:#0f1012;--accent:#c8a97e;--muted:#bfc7cc;--glass:rgba(255,255,255,0.03);--white:#f6f6f5}\\n    *{box-sizing:border-box}\\n    body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;margin:0;background:linear-gradient(180deg,#081018 0%,#0b0b0c 100%);color:var(--white);-webkit-font-smoothing:antialiased}\\n    .wrap{max-width:1100px;margin:48px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between;gap:24px}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .brand h1{font-size:18px;margin:0;letter-spacing:0.6px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:14px}\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:32px;align-items:center;margin-top:28px}\\n    .hero-card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:36px;border-radius:12px;box-shadow:0 6px 30px rgba(2,6,23,0.6)}\\n    .hero h2{font-size:30px;margin:0 0 10px}\\n    .hero p.lead{color:var(--muted);margin:0 0 18px}\\n    .avatar{display:flex;align-items:center;gap:12px}\\n    .avatar img{width:72px;height:72px;border-radius:10px;object-fit:cover;background:var(--glass);padding:8px}\\n    .pill{background:rgba(255,255,255,0.03);padding:8px 12px;border-radius:999px;font-size:13px;color:var(--muted);display:inline-block;margin-top:12px}\\n    .gallery{margin-top:42px;display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:22px;border-radius:10px}\\n    h3{margin:0 0 10px}\\n    p{margin:0 0 12px;color:var(--muted)}\\n    .cta{margin-top:18px}\\n    .btn{background:var(--accent);color:#061116;padding:12px 18px;border-radius:8px;text-decoration:none;font-weight:600}\\n    footer{margin-top:48px;color:var(--muted);font-size:13px}\\n    /* responsive */\\n    @media (max-width:900px){.hero{grid-template-columns:1fr;}.gallery{grid-template-columns:1fr}} \\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <svg width=\\\"44\\\" height=\\\"44\\\" viewBox=\\\"0 0 44 44\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n          <rect width=\\\"44\\\" height=\\\"44\\\" rx=\\\"10\\\" fill=\\\"#0b0b0c\\\"/>\\n          <path d=\\\"M8 28C12 22 20 14 30 12\\\" stroke=\\\"#c8a97e\\\" stroke-width=\\\"2.2\\\" stroke-linecap=\\\"round\\\"/>\\n        </svg>\\n        <h1>{{BUSINESS_NAME}}</h1>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"services.html\\\">Work With Me</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <!-- HERO: executive narrative, gallery style image -->\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <span class=\\\"pill\\\">Executive Wellness • {{CITY}}, {{STATE}}</span>\\n        <h2>Design your energy, lead with intent</h2>\\n        <p class=\\\"lead\\\">I help high-performing leaders translate small, repeatable habits into measurable gains in focus, resilience and sustainable productivity. No fads — frameworks that scale with your calendar and role.</p>\\n\\n        <div class=\\\"avatar\\\">\\n          <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"{{COACH_NAME}}\\\">\\n          <div>\\n            <div style=\\\"font-weight:700\\\">{{COACH_NAME}}, {{CREDENTIALS}}</div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Executive Coach • {{BUSINESS_NAME}}</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"cta\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"display:flex;align-items:center;justify-content:center\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"Hero image\\\" style=\\\"width:100%;max-width:420px;border-radius:12px;box-shadow:0 20px 50px rgba(0,0,0,0.6)\\\">\\n      </div>\\n    </section>\\n\\n    <!-- VALUES: pillars -->\\n    <section style=\\\"margin-top:36px\\\">\\n      <h3>Core commitments</h3>\\n      <div class=\\\"gallery\\\" role=\\\"list\\\">\\n        <div class=\\\"card\\\" role=\\\"listitem\\\">\\n          <h4 style=\\\"margin:0 0 6px\\\">Outcome-driven</h4>\\n          <p>Every session ties to a measurable behavior — focus blocks, sleep anchors, delegation rituals — so progress is visible and repeatable.</p>\\n        </div>\\n        <div class=\\\"card\\\" role=\\\"listitem\\\">\\n          <h4 style=\\\"margin:0 0 6px\\\">Evidence-forward</h4>\\n          <p>Practical behavioral science and leadership strategy inform frameworks without making medical claims.</p>\\n        </div>\\n        <div class=\\\"card\\\" role=\\\"listitem\\\">\\n          <h4 style=\\\"margin:0 0 6px\\\">Sustainable pace</h4>\\n          <p>Intensive work, delivered with cadence and checkpoints to avoid burnout and create durable change.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- METHODS: frameworks -->\\n    <section style=\\\"margin-top:36px\\\">\\n      <h3>How I work — frameworks you’ll use</h3>\\n      <div class=\\\"gallery\\\">\\n        <div class=\\\"card\\\">\\n          <h4>Anchor-Week Planning</h4>\\n          <p>Weekly micro-rituals that stabilize energy and clear decision fatigue. You get templates and an accountability loop.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h4>Behavior Bundles</h4>\\n          <p>Chainable habits designed to slot into your existing routines — small investment, compounding return.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h4>Delegation Architecture</h4>\\n          <p>Frameworks to redistribute cognitive load across your team so your attention works where it matters most.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- OBJECTIONS: common concerns addressed -->\\n    <section style=\\\"margin-top:36px;background:rgba(255,255,255,0.02);padding:18px;border-radius:10px\\\">\\n      <h3>Common concerns — answered</h3>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:10px\\\">\\n        <div>\\n          <strong>\\\"I don’t have time for coaching.\\\"</strong>\\n          <p style=\\\"color:var(--muted)\\\">Short, focused sessions and weekly micro-assignments that compound without adding meetings.</p>\\n        </div>\\n        <div>\\n          <strong>\\\"Is this a quick fix?\\\"</strong>\\n          <p style=\\\"color:var(--muted)\\\">No. Programs are intensive and designed to build lasting systems, not temporary spikes.</p>\\n        </div>\\n        <div>\\n          <strong>\\\"Will this fit my executive schedule?\\\"</strong>\\n          <p style=\\\"color:var(--muted)\\\">Yes. Timelines are co-created and include asynchronous check-ins to keep momentum.</p>\\n        </div>\\n        <div>\\n          <strong>\\\"What about privacy and confidentiality?\\\"</strong>\\n          <p style=\\\"color:var(--muted)\\\">All engagements follow a strict confidentiality agreement. You remain in control of disclosures.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- TESTIMONIALS: small set -->\\n    <section style=\\\"margin-top:36px\\\">\\n      <h3>What leaders report</h3>\\n      <div class=\\\"gallery\\\">\\n        <div class=\\\"card\\\">\\n          <p>\\\"A year of planning condensed into 12 weeks. My calendar is clearer and my team runs smoother.\\\"</p>\\n          <div style=\\\"font-size:13px;color:var(--muted);margin-top:8px\\\">— VP, Technology</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <p>\\\"The Behavior Bundles cut through indecision. I sleep better and make sharper calls in the morning.\\\"</p>\\n          <div style=\\\"font-size:13px;color:var(--muted);margin-top:8px\\\">— CEO, Scale-stage startup</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <p>\\\"Tangible practices that fit into a busy schedule — the most practical coaching I’ve experienced.\\\"</p>\\n          <div style=\\\"font-size:13px;color:var(--muted);margin-top:8px\\\">— Director, Finance</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- LEAD_MAGNET: downloadable guide -->\\n    <section style=\\\"margin-top:36px;padding:22px;border-radius:12px;background:linear-gradient(90deg,rgba(200,169,126,0.06),transparent)\\\">\\n      <h3>Get the Executive Reset — free guide</h3>\\n      <p style=\\\"color:var(--muted)\\\">A practical 6-step reset to reclaim focus in a two-week sprint. Download and implement before our first call.</p>\\n      <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" style=\\\"display:flex;gap:8px;margin-top:12px;flex-wrap:wrap\\\">\\n        <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Work email\\\" required style=\\\"padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.06);background:transparent;color:var(--white);min-width:240px\\\">\\n        <button class=\\\"btn\\\" type=\\\"submit\\\">Send me the guide</button>\\n      </form>\\n    </section>\\n\\n    <!-- CTA -->\\n    <section style=\\\"margin-top:36px;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:20px;border-radius:10px;background:rgba(255,255,255,0.02)\\\">\\n      <div>\\n        <strong style=\\\"display:block;font-size:16px\\\">Ready for an intensive reset?</strong>\\n        <div style=\\\"color:var(--muted);font-size:13px;margin-top:6px\\\">Book a discovery conversation to map your first 90 days.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:28px\\\">\\n        <div>© {{BUSINESS_NAME}} — {{CITY}}, {{STATE}}</div>\\n        <div style=\\\"color:var(--muted)\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:underline\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:underline\\\">{{PHONE}}</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Focused coaching offerings: 1:1, team integration, and executive intensives.\\\" />\\n  <style>\\n    :root{--bg:#faf9f8;--ink:#0b0b0c;--accent:#8b5e3c;--muted:#6b6f72}\\n    body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;background:var(--bg);color:var(--ink);margin:0}\\n    .container{max-width:1100px;margin:40px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    nav a{margin-left:16px;color:var(--muted);text-decoration:none}\\n    .hero{display:flex;gap:20px;align-items:center;margin-top:18px}\\n    .hero-left{flex:1}\\n    .hero-right img{width:360px;border-radius:12px}\\n    h1{margin:0;font-size:26px}\\n    p.lead{color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:20px}\\n    .service{background:white;padding:20px;border-radius:10px;box-shadow:0 6px 20px rgba(11,11,12,0.06)}\\n    .service h3{margin-top:0}\\n    .muted{color:var(--muted)}\\n    .cta{margin-top:12px}\\n    .btn{background:var(--accent);color:#fff;padding:10px 14px;border-radius:8px;text-decoration:none}\\n    footer{margin-top:30px;color:var(--muted);font-size:13px}\\n    @media (max-width:900px){.grid{grid-template-columns:1fr}.hero{flex-direction:column}.hero-right img{width:100%}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <svg width=\\\"40\\\" height=\\\"40\\\" viewBox=\\\"0 0 40 40\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n          <circle cx=\\\"20\\\" cy=\\\"20\\\" r=\\\"18\\\" stroke=\\\"#8b5e3c\\\" stroke-width=\\\"2\\\"/>\\n          <path d=\\\"M12 24c6-6 12-8 16-12\\\" stroke=\\\"#8b5e3c\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\"/>\\n        </svg>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">The Coach</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <!-- HERO: opposite layout to about, different heading -->\\n    <main class=\\\"hero\\\">\\n      <div class=\\\"hero-left\\\">\\n        <h1>Focused offerings for leaders who need transformation at pace</h1>\\n        <p class=\\\"lead\\\">Select between tailored 1:1 coaching, team integration, or concentrated intensives. All are built around behavior-first change and clear KPI tracking.</p>\\n\\n        <div style=\\\"display:flex;gap:10px;margin-top:12px\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start with a discovery</a>\\n          <a href=\\\"contact.html\\\" style=\\\"padding:10px 14px;border-radius:8px;background:transparent;border:1px solid #e6d6c7;color:var(--ink);text-decoration:none\\\">Request a brief</a>\\n        </div>\\n      </div>\\n      <div class=\\\"hero-right\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"Services visual\\\">\\n      </div>\\n    </main>\\n\\n    <!-- METHODS: service delivery model first -->\\n    <section style=\\\"margin-top:30px\\\">\\n      <h2 style=\\\"margin:0\\\">Delivery model</h2>\\n      <p class=\\\"muted\\\">A consistent cadence, measurable check-ins, and a compact toolkit you keep. Sessions are calendar-friendly and include asynchronous accountability.</p>\\n\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"service\\\">\\n          <h3>1:1 Executive Coaching</h3>\\n          <p class=\\\"muted\\\">Personalized session planning, habit design, and leadership rituals. Ideal for leaders transitioning roles or scaling operations.</p>\\n          <ul style=\\\"color:var(--muted)\\\">\\n            <li>Weekly 60-minute sessions</li>\\n            <li>Custom behavior plan + templates</li>\\n            <li>Email check-ins and progress dossier</li>\\n          </ul>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Book 1:1</a></div>\\n        </div>\\n\\n        <div class=\\\"service\\\">\\n          <h3>Team Integration</h3>\\n          <p class=\\\"muted\\\">Embed practical habits across leadership teams: delegation frameworks, meeting etiquette, and energy mapping for critical roles.</p>\\n          <ul style=\\\"color:var(--muted)\\\">\\n            <li>Leadership workshops</li>\\n            <li>Team habit blueprints</li>\\n            <li>90-day integration sprints</li>\\n          </ul>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"contact.html\\\">Design a workshop</a></div>\\n        </div>\\n\\n        <div class=\\\"service\\\">\\n          <h3>Intensive Sprint</h3>\\n          <p class=\\\"muted\\\">A compact, high-impact engagement focused on rapid habit formation and strategic offload. Designed for leaders needing immediate runway.</p>\\n          <ul style=\\\"color:var(--muted)\\\">\\n            <li>Four-week intensive with two coaching calls per week</li>\\n            <li>Daily micro-assignments</li>\\n            <li>End-of-sprint strategy map</li>\\n          </ul>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"programs.html\\\">See Intensives</a></div>\\n        </div>\\n\\n        <div class=\\\"service\\\">\\n          <h3>Advisory Retainer</h3>\\n          <p class=\\\"muted\\\">Ongoing strategic counsel with on-demand availability to address emergent leadership decisions and scaling challenges.</p>\\n          <ul style=\\\"color:var(--muted)\\\">\\n            <li>Monthly blocks of time</li>\\n            <li>Priority scheduling</li>\\n            <li>Quarterly impact reviews</li>\\n          </ul>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"contact.html\\\">Enquire</a></div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- VALUES: reassured on outcomes -->\\n    <section style=\\\"margin-top:30px;display:flex;gap:18px\\\">\\n      <div style=\\\"flex:1;background:white;padding:18px;border-radius:10px;box-shadow:0 6px 20px rgba(11,11,12,0.04)\\\">\\n        <h3 style=\\\"margin-top:0\\\">What you take away</h3>\\n        <p class=\\\"muted\\\">Clear decision protocols, an energy-first weekly plan, and a delegation architecture you can scale.</p>\\n      </div>\\n      <div style=\\\"width:360px;background:linear-gradient(180deg,#fff, #f6f3ef);padding:18px;border-radius:10px;display:flex;flex-direction:column;justify-content:center\\\">\\n        <strong>Free resource</strong>\\n        <p class=\\\"muted\\\">Immediate access to the \\\"Executive Reset\\\" guide when you enquire.</p>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Get the guide</a>\\n      </div>\\n    </section>\\n\\n    <!-- OBJECTIONS: service-specific FAQs -->\\n    <section style=\\\"margin-top:28px\\\">\\n      <h2 style=\\\"margin:0\\\">Questions before you commit</h2>\\n      <div style=\\\"margin-top:8px;color:var(--muted)\\\">\\n        <details style=\\\"margin-bottom:8px\\\"><summary style=\\\"cursor:pointer\\\">How soon can we start?</summary><div style=\\\"padding-top:8px\\\">Typical onboarding within 2 weeks; intensives can start on shorter notice depending on availability.</div></details>\\n        <details style=\\\"margin-bottom:8px\\\"><summary style=\\\"cursor:pointer\\\">How is success measured?</summary><div style=\\\"padding-top:8px\\\">We set 2-3 outcome metrics at the start (focus hours, decision latency, team throughput) and review them weekly.</div></details>\\n        <details style=\\\"margin-bottom:8px\\\"><summary style=\\\"cursor:pointer\\\">Is this confidential?</summary><div style=\\\"padding-top:8px\\\">Yes — all engagements are protected by a confidentiality agreement.</div></details>\\n      </div>\\n    </section>\\n\\n    <!-- TESTIMONIALS: different ordering and quotes -->\\n    <section style=\\\"margin-top:28px\\\">\\n      <h2 style=\\\"margin:0\\\">Client feedback</h2>\\n      <div style=\\\"display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:12px\\\">\\n        <div style=\\\"background:white;padding:12px;border-radius:8px;color:var(--muted)\\\">\\\"My 90-day roadmap was built in week one — that clarity changed everything.\\\"<div style=\\\"font-size:12px;color:#333;margin-top:8px\\\">— COO, Services Firm</div></div>\\n        <div style=\\\"background:white;padding:12px;border-radius:8px;color:var(--muted)\\\">\\\"Workshops landed practical shifts, not theory. Uptake from leaders was immediate.\\\"<div style=\\\"font-size:12px;color:#333;margin-top:8px\\\">— Head of People</div></div>\\n        <div style=\\\"background:white;padding:12px;border-radius:8px;color:var(--muted)\\\">\\\"The sprint gave us runway and better prioritization habits across the exec team.\\\"<div style=\\\"font-size:12px;color:#333;margin-top:8px\\\">— Founder</div></div>\\n      </div>\\n    </section>\\n\\n    <!-- LEAD_MAGNET: quick form -->\\n    <section style=\\\"margin-top:28px;display:flex;justify-content:space-between;gap:12px;align-items:center\\\">\\n      <div>\\n        <h3 style=\\\"margin:0\\\">Claim your Executive Reset</h3>\\n        <p class=\\\"muted\\\">Practical two-week plan to stabilize focus and begin habit compounding.</p>\\n      </div>\\n      <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" style=\\\"display:flex;gap:8px\\\">\\n        <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Email\\\" required style=\\\"padding:10px;border-radius:8px;border:1px solid #e5dbcf\\\">\\n        <button class=\\\"btn\\\" type=\\\"submit\\\">Send</button>\\n      </form>\\n    </section>\\n\\n    <!-- CTA: final prompt with contact -->\\n    <section style=\\\"margin-top:28px;padding:16px;background:rgba(139,94,60,0.06);border-radius:10px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <strong>Interested in a tailored plan?</strong>\\n        <div class=\\\"muted\\\">Schedule a short conversation to scope an intensive or retainer.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule discovery</a>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:30px;color:var(--muted)\\\">\\n      © {{BUSINESS_NAME}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:underline\\\">{{EMAIL}}</a> • {{PHONE}}\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Intensive, outcome-focused coaching programs for executives.\\\" />\\n  <style>\\n    :root{--bg:#081018;--card:#0f1316;--accent:#c7b08a;--muted:#9aa4a8;--white:#f7f7f6}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;background:linear-gradient(180deg,#071018 0%,#0b0b0c 100%);color:var(--white)}\\n    .wrap{max-width:1100px;margin:36px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:14px;font-size:14px}\\n    .hero{display:flex;align-items:center;gap:22px;margin-top:18px}\\n    .hero .copy{flex:1}\\n    .hero h1{margin:0;font-size:28px}\\n    .hero p{color:var(--muted)}\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:22px}\\n    .tier{background:linear-gradient(180deg,rgba(199,176,138,0.06),transparent);padding:20px;border-radius:12px}\\n    .price{font-size:22px;color:var(--accent);font-weight:700}\\n    .features{color:var(--muted);margin-top:8px}\\n    .btn{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:8px;background:var(--accent);color:#061116;text-decoration:none;font-weight:600}\\n    .faq{margin-top:18px;background:rgba(255,255,255,0.02);padding:14px;border-radius:10px}\\n    footer{margin-top:30px;color:var(--muted);font-size:13px}\\n    @media (max-width:900px){.tiers{grid-template-columns:1fr}.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:10px\\\">\\n        <svg width=\\\"44\\\" height=\\\"44\\\" viewBox=\\\"0 0 44 44\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n          <rect width=\\\"44\\\" height=\\\"44\\\" rx=\\\"10\\\" fill=\\\"#071018\\\"/>\\n          <path d=\\\"M10 26c8-10 22-12 24-14\\\" stroke=\\\"#c7b08a\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\"/>\\n        </svg>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">Intensive programs • {{CITY}}, {{STATE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <!-- HERO: program framing -->\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"copy\\\">\\n        <h1>Programs built for rapid, measurable change</h1>\\n        <p class=\\\"muted\\\">Each path is an intensive, focused engagement: defined outcomes, a compact playbook, and weekly measurement checkpoints.</p>\\n      </div>\\n      <div>\\n        <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"Pattern\\\" style=\\\"width:220px;border-radius:12px;box-shadow:0 20px 50px rgba(0,0,0,0.6)\\\">\\n      </div>\\n    </section>\\n\\n    <!-- PROGRAM TIERS: unique names and pricing framing -->\\n    <section class=\\\"tiers\\\">\\n      <div class=\\\"tier\\\">\\n        <h3>Launch Sprint</h3>\\n        <div class=\\\"price\\\">Four-week intensive</div>\\n        <p class=\\\"features\\\">Best for leaders needing immediate runway: 8 coaching hours, daily micro-assignments, and a sprint map.</p>\\n        <ul class=\\\"features\\\">\\n          <li>2 calls/week</li>\\n          <li>Action plan + templates</li>\\n          <li>End-of-sprint roadmap</li>\\n        </ul>\\n        <a class=\\\"btn\\\" href=\\\"book.html\\\">Apply for sprint</a>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <h3>90-Day Accelerator</h3>\\n        <div class=\\\"price\\\">Quarterly intensive</div>\\n        <p class=\\\"features\\\">An intensive with measurable KPIs and a coaching cadence that embeds habit architecture.</p>\\n        <ul class=\\\"features\\\">\\n          <li>Weekly 1:1 sessions</li>\\n          <li>Asynchronous accountability</li>\\n          <li>Quarterly outcome review</li>\\n        </ul>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start application</a>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <h3>Leadership Relayer</h3>\\n        <div class=\\\"price\\\">Custom engagement</div>\\n        <p class=\\\"features\\\">A bespoke program for teams and CXOs that includes workshops, team playbooks, and retention of behavior change.</p>\\n        <ul class=\\\"features\\\">\\n          <li>Team workshops</li>\\n          <li>Implementation playbook</li>\\n          <li>Quarterly check-ins</li>\\n        </ul>\\n        <a class=\\\"btn\\\" href=\\\"contact.html\\\">Request proposal</a>\\n      </div>\\n    </section>\\n\\n    <!-- VALUES/METHODS RIPPLE -->\\n    <section style=\\\"margin-top:22px;display:flex;gap:14px\\\">\\n      <div style=\\\"flex:1;background:linear-gradient(180deg,rgba(199,176,138,0.04),transparent);padding:16px;border-radius:10px\\\">\\n        <h3 style=\\\"margin:0\\\">Frameworks you’ll use</h3>\\n        <p class=\\\"muted\\\">Anchor-Week planning, Behavior Bundles, and Delegation Architecture are included as practical toolkits in every program.</p>\\n      </div>\\n      <div style=\\\"width:320px;background:rgba(255,255,255,0.02);padding:16px;border-radius:10px\\\">\\n        <h4 style=\\\"margin:0\\\">What we measure</h4>\\n        <p class=\\\"muted\\\">Focus hours, meeting efficiency, and decision latency with weekly progress reports.</p>\\n      </div>\\n    </section>\\n\\n    <!-- OBJECTIONS: different FAQ entries -->\\n    <section class=\\\"faq\\\" style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0\\\">Before you apply</h3>\\n      <div style=\\\"margin-top:10px;color:var(--muted)\\\">\\n        <details style=\\\"margin-bottom:8px\\\"><summary style=\\\"cursor:pointer\\\">Can a program really change habits quickly?</summary><div style=\\\"padding-top:8px\\\">Yes — intensives focus on frequency, context, and immediate reinforcement so new behaviors stick faster than ad-hoc efforts.</div></details>\\n        <details style=\\\"margin-bottom:8px\\\"><summary style=\\\"cursor:pointer\\\">How much time is required?</summary><div style=\\\"padding-top:8px\\\">Intensives increase touchpoints temporarily; weekly time commitment is defined up-front and designed to minimize disruption.</div></details>\\n        <details style=\\\"margin-bottom:8px\\\"><summary style=\\\"cursor:pointer\\\">What outcomes are realistic?</summary><div style=\\\"padding-top:8px\\\">Better focus windows, clearer delegation, and predictable weekly planning. We avoid medical promises and stick to behavioral outcomes.</div></details>\\n      </div>\\n    </section>\\n\\n    <!-- TESTIMONIALS: another set -->\\n    <section style=\\\"margin-top:22px\\\">\\n      <h3 style=\\\"margin:0\\\">Results clients track</h3>\\n      <div style=\\\"display:flex;gap:12px;margin-top:10px;flex-wrap:wrap\\\">\\n        <div style=\\\"background:rgba(255,255,255,0.03);padding:12px;border-radius:8px;min-width:260px\\\">\\n          \\\"A condensed program that accelerated our leadership rhythm. We saved 10 hours/week in meeting time.\\\"<div style=\\\"font-size:12px;color:var(--muted);margin-top:8px\\\">— COO</div>\\n        </div>\\n        <div style=\\\"background:rgba(255,255,255,0.03);padding:12px;border-radius:8px;min-width:260px\\\">\\n          \\\"Practical, measurable, and aligned with real-world calendars. The application process was clear.\\\"<div style=\\\"font-size:12px;color:var(--muted);margin-top:8px\\\">— Head of Product</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- LEAD_MAGNET: sign up CTA -->\\n    <section style=\\\"margin-top:22px;padding:16px;border-radius:10px;background:linear-gradient(90deg,rgba(199,176,138,0.04),transparent)\\\">\\n      <h3 style=\\\"margin:0\\\">Download: Program Brief</h3>\\n      <p class=\\\"muted\\\">A concise brief outlining deliverables, timeline, and success metrics for each program.</p>\\n      <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" style=\\\"display:flex;gap:8px;margin-top:8px\\\">\\n        <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Email\\\" required style=\\\"padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:var(--white)\\\">\\n        <button class=\\\"btn\\\" type=\\\"submit\\\">Get the brief</button>\\n      </form>\\n    </section>\\n\\n    <!-- FINAL CTA -->\\n    <section style=\\\"margin-top:22px;display:flex;justify-content:space-between;align-items:center;padding:14px;border-radius:10px;background:rgba(199,176,138,0.04)\\\">\\n      <div>\\n        <strong>Apply for an intensive</strong>\\n        <div class=\\\"muted\\\">Limited cohorts — applications reviewed on arrival.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"margin-top:20px;color:var(--muted)\\\">Contact <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:underline\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
