          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Pricing — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Investment tiers and commitments for transformative habit-based coaching.\\\">\\n  <style>\\n    :root{--bg:#0f0f10;--card:#0b0b0c;--muted:#9aa0a6;--accent:#e7b34a;--glass:rgba(255,255,255,0.03);--max:1100px}\\n    html,body{height:100%}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#fff;background:linear-gradient(180deg,#070708 0%, #0f1112 60%);-webkit-font-smoothing:antialiased}\\n    header{max-width:var(--max);margin:28px auto;display:flex;align-items:center;justify-content:space-between;padding:0 20px}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .brand img{width:56px;height:56px}\\n    nav a{color:var(--muted);margin-left:18px;text-decoration:none;font-weight:600}\\n    .hero{max-width:var(--max);margin:28px auto;padding:40px 20px;display:grid;grid-template-columns:1fr 420px;gap:32px;align-items:center}\\n    .hero .left h1{font-size:36px;margin:0 0 12px 0;letter-spacing:-0.02em}\\n    .eyebrow{color:var(--accent);font-weight:700;letter-spacing:0.08em}\\n    .hero p{color:var(--muted);margin:0 0 18px}\\n    .hero .cta{display:flex;gap:12px}\\n    .btn{background:var(--accent);color:#0b0b0c;padding:12px 18px;border-radius:8px;text-decoration:none;font-weight:700}\\n    .btn.ghost{background:transparent;border:1px solid rgba(255,255,255,0.06);color:var(--muted)}\\n    .gallery-visual{background:var(--glass);border-radius:14px;padding:22px;display:flex;align-items:center;justify-content:center}\\n    .tiers{max-width:var(--max);margin:18px auto;padding:20px;display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\\n    .tier{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:22px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .tier h3{margin:0 0 8px}\\n    .price{font-weight:800;font-size:22px;margin:6px 0;color:var(--accent)}\\n    .features{color:var(--muted);font-size:14px}\\n    .grid-section{max-width:var(--max);margin:28px auto;padding:20px;display:grid;grid-template-columns:1fr 360px;gap:28px}\\n    .panel{background:var(--card);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.02)}\\n    .faq dt{font-weight:700;margin-top:12px}\\n    footer{max-width:var(--max);margin:40px auto;padding:20px;color:var(--muted);display:flex;justify-content:space-between}\\n    @media (max-width:900px){.hero{grid-template-columns:1fr;}.grid-section{grid-template-columns:1fr}.tiers{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <img src=\\\"assets/img/hero.svg\\\" alt=\\\"hero\\\" />\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"pricing.html\\\">Work With Me</a>\\n      <a href=\\\"testimonials.html\\\">Praise</a>\\n      <a href=\\\"book.html\\\">Start</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <section class=\\\"hero\\\">\\n    <div class=\\\"left\\\">\\n      <div class=\\\"eyebrow\\\">INVESTMENT</div>\\n      <h1>Clear commitments, predictable outcomes</h1>\\n      <p>I design coaching engagements to move habits into velocity. Choose the structure that fits your schedule and ambition — from tactical habit sprints to strategic leadership renewal.</p>\\n      <div class=\\\"cta\\\">\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <a class=\\\"btn ghost\\\" href=\\\"#compare\\\">Compare tiers</a>\\n      </div>\\n    </div>\\n    <aside class=\\\"gallery-visual\\\">\\n      <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" style=\\\"width:100%;max-width:300px;display:block\\\">\\n    </aside>\\n  </section>\\n\\n  <section class=\\\"tiers\\\" id=\\\"compare\\\" aria-label=\\\"Coaching tiers\\\">\\n    <article class=\\\"tier\\\">\\n      <h3>Foundations Path</h3>\\n      <div class=\\\"price\\\">$850 — 6 weeks</div>\\n      <div class=\\\"features\\\">\\n        - Weekly 50-minute sessions\\n        - Habit audit + 3-week starter plan\\n        - Email check-ins\\n        <p style=\\\"margin-top:10px;color:var(--muted);font-size:13px\\\">Ideal for busy professionals who want high-leverage habit wins.</p>\\n      </div>\\n      <div style=\\\"margin-top:12px\\\"> <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Enroll in Foundations</a></div>\\n    </article>\\n\\n    <article class=\\\"tier\\\">\\n      <h3>Momentum Intensive</h3>\\n      <div class=\\\"price\\\">$2,800 — 12 weeks</div>\\n      <div class=\\\"features\\\">\\n        - Bi-weekly 60-minute sessions\\n        - Personal framework (RIT: Routines, Intentions, Tracking)\\n        - Weekly micro-assignments + metrics\\n        <p style=\\\"margin-top:10px;color:var(--muted);font-size:13px\\\">A focused accelerator for rapid, measurable habit change.</p>\\n      </div>\\n      <div style=\\\"margin-top:12px\\\"> <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start Momentum</a></div>\\n    </article>\\n\\n    <article class=\\\"tier\\\">\\n      <h3>Executive Renewal</h3>\\n      <div class=\\\"price\\\">$6,500 — 6 months</div>\\n      <div class=\\\"features\\\">\\n        - Custom program cadence\\n        - Leadership habit design + delegation planning\\n        - Priority access, planning retreats\\n        <p style=\\\"margin-top:10px;color:var(--muted);font-size:13px\\\">For leaders investing in sustainable cognitive and behavioral capacity.</p>\\n      </div>\\n      <div style=\\\"margin-top:12px\\\"> <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Request Executive</a></div>\\n    </article>\\n  </section>\\n\\n  <section class=\\\"grid-section\\\">\\n    <div class=\\\"panel\\\">\\n      <h2>What differentiates these tiers</h2>\\n      <p style=\\\"color:var(--muted)\\\">Programs are framed by rhythm and accountability rather than time alone. Each tier defines expected outputs, observation windows, and a discipline of small wins that compound.</p>\\n      <h4 style=\\\"margin-top:18px\\\">Core deliverables</h4>\\n      <ul style=\\\"color:var(--muted)\\\">\\n        <li>Actionable habit maps</li>\\n        <li>Weekly micro-goals with measurement</li>\\n        <li>One-page maintenance plan at completion</li>\\n      </ul>\\n    </div>\\n\\n    <aside class=\\\"panel\\\">\\n      <h3>Pricing notes & FAQs</h3>\\n      <dl class=\\\"faq\\\" style=\\\"color:var(--muted)\\\">\\n        <dt>How do payments work?</dt>\\n        <dd>Flexible: single-payment discounts available; monthly installments by request.</dd>\\n        <dt>Do you guarantee results?</dt>\\n        <dd>Coaching supports behavior change; outcomes depend on participant engagement and follow-through.</dd>\\n        <dt>Can programs be customized?</dt>\\n        <dd>Yes — Executive engagements are tailored and scoped by discovery.</dd>\\n      </dl>\\n    </aside>\\n  </section>\\n\\n  <section style=\\\"max-width:var(--max);margin:20px auto;padding:20px;text-align:center\\\">\\n    <div style=\\\"background:var(--glass);padding:18px;border-radius:12px;display:inline-block\\\">\\n      <strong>Lead resource:</strong> Get the \\\"7-Point Habit Audit\\\" — a concise checklist used in the Foundations Path. <a href=\\\"#lead\\\" style=\\\"color:var(--accent);text-decoration:none\\\">Claim it free</a>\\n    </div>\\n  </section>\\n\\n  <section id=\\\"lead\\\" style=\\\"max-width:var(--max);margin:10px auto;padding:20px;display:flex;justify-content:center\\\">\\n    <form style=\\\"display:flex;gap:8px;background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;border:1px solid rgba(255,255,255,0.03)\\\">\\n      <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Email to receive the audit\\\" required style=\\\"padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:#fff\\\">\\n      <button class=\\\"btn\\\" type=\\\"submit\\\">Send me the audit</button>\\n    </form>\\n  </section>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n    <div style=\\\"text-align:right;color:var(--muted)\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:underline\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:underline\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Client Stories — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Verified client outcomes and testimonials for {{COACH_NAME}} ({{CREDENTIALS}}).\\\">\\n  <style>\\n    :root{--bg:#fafafa;--card:#ffffff;--ink:#0b0b0c;--muted:#6b7176;--accent:#b46be7;--max:1100px}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased}\\n    header{max-width:var(--max);margin:28px auto;padding:0 20px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .brand img{width:52px}\\n    nav a{color:var(--muted);margin-left:14px;text-decoration:none}\\n    .hero{max-width:var(--max);margin:16px auto;padding:36px 20px;display:flex;gap:28px;align-items:center}\\n    .hero .copy h1{font-size:32px;margin:0}\\n    .hero p{color:var(--muted);margin-top:8px}\\n    .gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;max-width:var(--max);margin:18px auto;padding:0 20px}\\n    .card{background:var(--card);border-radius:12px;padding:18px;box-shadow:0 6px 20px rgba(15,15,15,0.06)}\\n    .quote{font-style:italic;color:var(--ink);margin:12px 0}\\n    .meta{display:flex;gap:12px;align-items:center}\\n    .meta img{width:48px;height:48px;border-radius:50%;background:#eee}\\n    .meta .who{font-weight:700}\\n    .more{max-width:var(--max);margin:10px auto;padding:20px;text-align:center;color:var(--muted)}\\n    .leadmag{max-width:var(--max);margin:28px auto;padding:18px;display:flex;justify-content:space-between;gap:12px}\\n    .cta{background:linear-gradient(90deg,var(--accent),#6fd3ff);color:#fff;padding:12px 18px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{max-width:var(--max);margin:30px auto;padding:20px;color:var(--muted);display:flex;justify-content:space-between}\\n    @media (max-width:900px){.gallery{grid-template-columns:1fr}.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\"/>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{COACH_NAME}} • {{CREDENTIALS}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Expertise</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"testimonials.html\\\">Praise</a>\\n      <a href=\\\"book.html\\\">Start</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <section class=\\\"hero\\\">\\n    <div class=\\\"copy\\\">\\n      <h1>Real change: stories organized by outcome</h1>\\n      <p>Short case notes and client reflections focused on sustainable habit shifts, clarity, and time reclaimed.</p>\\n    </div>\\n    <div style=\\\"margin-left:auto;display:flex;align-items:center;gap:12px\\\">\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a discovery</a>\\n    </div>\\n  </section>\\n\\n  <main class=\\\"gallery\\\">\\n    <article class=\\\"card\\\">\\n      <div class=\\\"meta\\\">\\n        <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"client\\\" />\\n        <div>\\n          <div class=\\\"who\\\">A.M. — Senior Product Lead</div>\\n          <div style=\\\"color:var(--muted);font-size:13px\\\">6 months • Momentum Intensive</div>\\n        </div>\\n      </div>\\n      <div class=\\\"quote\\\">\\\"Within 12 weeks my calendar has fewer friction meetings and I reclaimed mornings for focused work. The micro-habit system is deceptively simple — and it scales.\\\"</div>\\n      <div style=\\\"color:var(--muted);font-size:13px\\\">Key outcome: 2 extra hours weekly of deep work; consistent morning routine.</div>\\n    </article>\\n\\n    <article class=\\\"card\\\">\\n      <div class=\\\"meta\\\">\\n        <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"client\\\" />\\n        <div>\\n          <div class=\\\"who\\\">R.S. — Founder</div>\\n          <div style=\\\"color:var(--muted);font-size:13px\\\">3 months • Foundations Path</div>\\n        </div>\\n      </div>\\n      <div class=\\\"quote\\\">\\\"We built a 'no-decision' evening sequence that reduced decision fatigue. My team noticed I showed up calmer and clearer.\\\"</div>\\n      <div style=\\\"color:var(--muted);font-size:13px\\\">Key outcome: sustainable evening routine; improved sleep consistency.</div>\\n    </article>\\n\\n    <article class=\\\"card\\\">\\n      <div class=\\\"meta\\\">\\n        <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"client\\\" />\\n        <div>\\n          <div class=\\\"who\\\">P.T. — Executive Director</div>\\n          <div style=\\\"color:var(--muted);font-size:13px\\\">6 months • Executive Renewal</div>\\n        </div>\\n      </div>\\n      <div class=\\\"quote\\\">\\\"The coaching helped me delegate deliberately and rebuild a rhythm that respects energy. This was about restructuring days, not adding tasks.\\\"</div>\\n      <div style=\\\"color:var(--muted);font-size:13px\\\">Key outcome: 30% fewer direct reports' meetings; clearer leadership time.</div>\\n    </article>\\n  </main>\\n\\n  <section class=\\\"more\\\">\\n    <div style=\\\"max-width:800px;margin:0 auto\\\">\\n      <h3 style=\\\"margin:0\\\">Why stories matter</h3>\\n      <p style=\\\"margin-top:8px;color:var(--muted)\\\">These testimonials focus on mechanisms: what changed, how habits were built, and the practical signals clients used to measure success.</p>\\n    </div>\\n  </section>\\n\\n  <section class=\\\"leadmag\\\" style=\\\"max-width:var(--max);padding:0 20px\\\">\\n    <div style=\\\"background:linear-gradient(180deg,#fff,#f8f5ff);padding:18px;border-radius:12px;flex:1\\\">\\n      <strong>Free resource:</strong>\\n      <p style=\\\"margin:8px 0;color:var(--muted)\\\">Download the 'Three-Month Habit Roadmap'—the exact template many clients use to track progress.</p>\\n    </div>\\n    <div style=\\\"display:flex;align-items:center\\\">\\n      <form style=\\\"display:flex;gap:8px\\\">\\n        <input placeholder=\\\"Your email\\\" type=\\\"email\\\" required style=\\\"padding:10px;border-radius:8px;border:1px solid rgba(11,11,12,0.06)\\\">\\n        <button class=\\\"cta\\\" type=\\\"submit\\\">Get roadmap</button>\\n      </form>\\n    </div>\\n  </section>\\n\\n  <section style=\\\"max-width:var(--max);margin:28px auto;padding:0 20px\\\">\\n    <div class=\\\"card\\\" style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <strong>Prefer a quick sample?</strong>\\n        <div style=\\\"color:var(--muted);font-size:14px\\\">I offer a complimentary 20-minute clarity call to discuss your priorities and assess fit.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule clarity call</a>\\n      </div>\\n    </div>\\n  </section>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n    <div style=\\\"text-align:right;color:var(--muted)\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:underline\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Reserve a discovery session with {{COACH_NAME}} to explore your habit strategy and next steps.\\\">\\n  <style>\\n    :root{--bg:#fff;--muted:#64707a;--ink:#081016;--accent:#2ab7a9;--max:980px}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased}\\n    header{max-width:var(--max);margin:28px auto;padding:0 20px;display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);margin-left:14px;text-decoration:none}\\n    .hero{max-width:var(--max);margin:18px auto;padding:28px 20px;display:grid;grid-template-columns:1fr 380px;gap:22px;align-items:start}\\n    .hero h1{margin:0;font-size:28px}\\n    .hero p{color:var(--muted);margin-top:8px}\\n    .booking{background:linear-gradient(180deg,#fbfffd,#f2f9f7);padding:18px;border-radius:12px;border:1px solid rgba(10,10,10,0.04)}\\n    label{display:block;font-size:13px;margin-top:12px;color:var(--muted)}\\n    input,textarea,select{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(10,10,10,0.06);margin-top:6px}\\n    .btn{background:var(--accent);color:#fff;padding:12px 16px;border-radius:8px;text-decoration:none;border:none;font-weight:700}\\n    .aside-list{background:#fff;padding:16px;border-radius:12px;border:1px solid rgba(10,10,10,0.04)}\\n    .method{display:flex;gap:10px;align-items:flex-start;margin-top:12px}\\n    .method strong{color:var(--accent)}\\n    footer{max-width:var(--max);margin:28px auto;padding:20px;color:var(--muted);display:flex;justify-content:space-between}\\n    @media (max-width:900px){.hero{grid-template-columns:1fr}.booking{order:2}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Why I coach</a>\\n      <a href=\\\"programs.html\\\">Work With Me</a>\\n      <a href=\\\"pricing.html\\\">Investments</a>\\n      <a href=\\\"testimonials.html\\\">Stories</a>\\n      <a href=\\\"book.html\\\">Start</a>\\n    </nav>\\n  </header>\\n\\n  <section class=\\\"hero\\\">\\n    <div>\\n      <h1>Reserve a discovery session</h1>\\n      <p>Start with a 30-minute discovery to define a focused, three-step plan. No pressure — just clarity and a recommended next step aligned to your calendar and capacity.</p>\\n\\n      <div style=\\\"margin-top:18px\\\">\\n        <h3 style=\\\"margin:0\\\">What you'll get on the call</h3>\\n        <ul style=\\\"color:var(--muted);margin-top:8px\\\">\\n          <li>Clear next-step habit priorities</li>\\n          <li>A short assessment of readiness and constraints</li>\\n          <li>Recommended program fit and timeline</li>\\n        </ul>\\n      </div>\\n\\n      <div style=\\\"margin-top:18px\\\">\\n        <h3 style=\\\"margin:0\\\">Common hesitations</h3>\\n        <ol style=\\\"color:var(--muted);margin-top:8px\\\">\\n          <li>\\\"I don't have time.\\\" — We design micro-habits that slot into existing anchors.</li>\\n          <li>\\\"Will this stick?\\\" — We build measurement and small wins to create momentum.</li>\\n          <li>\\\"Is it worth the investment?\\\" — The call clarifies ROI in terms you track: time, clarity, energy.</li>\\n        </ol>\\n      </div>\\n    </div>\\n\\n    <aside>\\n      <div class=\\\"booking\\\">\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\">\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"Your name\\\" required>\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@company.com\\\" required>\\n\\n          <label for=\\\"focus\\\">Primary focus for the session</label>\\n          <select id=\\\"focus\\\" name=\\\"focus\\\" required>\\n            <option>Productivity & Focus</option>\\n            <option>Leadership & Delegation</option>\\n            <option>Energy & Routine Design</option>\\n            <option>Other</option>\\n          </select>\\n\\n          <label for=\\\"note\\\">One-line context (optional)</label>\\n          <textarea id=\\\"note\\\" name=\\\"note\\\" rows=\\\"3\\\" placeholder=\\\"What outcome matters most?\\\"></textarea>\\n\\n          <div style=\\\"margin-top:12px;display:flex;gap:8px\\\">\\n            <button class=\\\"btn\\\" type=\\\"submit\\\">Book discovery — 30 min</button>\\n            <a href=\\\"#lead\\\" style=\\\"padding:12px 16px;border-radius:8px;background:transparent;color:var(--muted);text-decoration:none;border:1px solid rgba(10,10,10,0.06);display:inline-flex;align-items:center\\\">Send me the audit</a>\\n          </div>\\n        </form>\\n      </div>\\n\\n      <div style=\\\"margin-top:12px\\\" class=\\\"aside-list\\\">\\n        <h4 style=\\\"margin:0\\\">Coaching approach</h4>\\n        <div class=\\\"method\\\"><div style=\\\"font-size:20px;color:var(--accent)\\\">1</div><div><strong>Habit-first framing</strong><div style=\\\"color:var(--muted);font-size:13px\\\">Start with one keystone, not twenty new tasks.</div></div></div>\\n        <div class=\\\"method\\\"><div style=\\\"font-size:20px;color:var(--accent)\\\">2</div><div><strong>Measure what matters</strong><div style=\\\"color:var(--muted);font-size:13px\\\">Define simple, weekly signals you can observe quickly.</div></div></div>\\n        <div class=\\\"method\\\"><div style=\\\"font-size:20px;color:var(--accent)\\\">3</div><div><strong>Design for context</strong><div style=\\\"color:var(--muted);font-size:13px\\\">Change the environment before the willpower.</div></div></div>\\n      </div>\\n    </aside>\\n  </section>\\n\\n  <section id=\\\"lead\\\" style=\\\"max-width:var(--max);margin:10px auto;padding:18px\\\">\\n    <div style=\\\"background:#f6fffb;padding:14px;border-radius:12px;border:1px solid rgba(42,183,169,0.08);display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <strong>Free lead magnet:</strong>\\n        <div style=\\\"color:var(--muted);font-size:14px\\\">Download the Habit Audit — a compact checklist to identify two leverage points in your daily routine.</div>\\n      </div>\\n      <form style=\\\"display:flex;gap:8px\\\">\\n        <input type=\\\"email\\\" placeholder=\\\"Email\\\" required style=\\\"padding:10px;border-radius:8px;border:1px solid rgba(10,10,10,0.06)\\\">\\n        <button class=\\\"btn\\\" type=\\\"submit\\\">Send the audit</button>\\n      </form>\\n    </div>\\n  </section>\\n\\n  <section style=\\\"max-width:var(--max);margin:18px auto;padding:0 20px\\\">\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" style=\\\"width:84px;border-radius:10px\\\">\\n      <div>\\n        <strong>Need a different cadence?</strong>\\n        <div style=\\\"color:var(--muted);font-size:14px\\\">Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>. I work with individuals and small leadership teams.</div>\\n      </div>\\n    </div>\\n  </section>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n    <div style=\\\"text-align:right;color:var(--muted)\\\">© {{BUSINESS_NAME}}</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
