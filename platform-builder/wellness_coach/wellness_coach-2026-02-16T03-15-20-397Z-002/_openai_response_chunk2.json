          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Practical coaching to build durable habits and measurable wellbeing outcomes.\\\">\\n  <style>\\n    :root{--bg:#f8fbfa;--fg:#0b1720;--muted:#526066;--accent:#0b6b56;--radius:10px}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:var(--fg);background:var(--bg);}\\n    .wrap{max-width:860px;margin:48px auto;padding:36px;background:white;border-radius:var(--radius);box-shadow:0 6px 30px rgba(11,23,32,0.06)}\\n    nav{display:flex;gap:16px;align-items:center;justify-content:space-between}\\n    .nav-links a{color:var(--muted);text-decoration:none;padding:6px 10px;border-radius:8px}\\n    .nav-links a[href$=\\\"about.html\\\"]{font-weight:600;color:var(--fg)}\\n    header .brand{font-weight:700}\\n    .hero{display:flex;gap:36px;align-items:center;margin-top:28px}\\n    .hero-text h1{margin:0;font-size:28px;letter-spacing:-0.02em}\\n    .hero-text p{color:var(--muted);margin:10px 0 0}\\n    .avatar{width:120px;height:120px;flex:0 0 120px;border-radius:14px;overflow:hidden;background:linear-gradient(180deg,#eef7f3,#fff)}\\n    section{margin-top:28px}\\n    .grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}\\n    .card{background:#fcfffe;padding:14px;border-radius:12px;border:1px solid rgba(11,23,32,0.04)}\\n    .muted{color:var(--muted);font-size:15px}\\n    .cta{display:inline-block;margin-top:12px;background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    footer{margin-top:28px;color:var(--muted);font-size:13px}\\n    @media(max-width:720px){.hero{flex-direction:column}.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <main class=\\\"wrap\\\">\\n    <nav>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"nav-links\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">Approach</a>\\n        <a href=\\\"services.html\\\">Work With Me</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </div>\\n    </nav>\\n\\n    <!-- Hero: about-focused -->\\n    <section class=\\\"hero\\\" aria-label=\\\"About hero\\\">\\n      <div class=\\\"hero-text\\\">\\n        <h1>Evidence-informed coaching for sustainable wellbeing</h1>\\n        <p class=\\\"muted\\\">I translate behavioural science into daily practices that produce measurable gains — not quick fixes, but durable changes in energy, sleep, and routine.</p>\\n        <div style=\\\"margin-top:12px\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n      <div class=\\\"avatar\\\" role=\\\"img\\\" aria-label=\\\"Photo illustration of coach\\\">\\n        <!-- Unique inline SVG avatar for about.html -->\\n        <svg width=\\\"120\\\" height=\\\"120\\\" viewBox=\\\"0 0 120 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n          <defs>\\n            <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"1\\\" y2=\\\"1\\\">\\n              <stop offset=\\\"0\\\" stop-color=\\\"#e6fbf6\\\" />\\n              <stop offset=\\\"1\\\" stop-color=\\\"#ffffff\\\" />\\n            </linearGradient>\\n          </defs>\\n          <rect width=\\\"120\\\" height=\\\"120\\\" rx=\\\"14\\\" fill=\\\"url(#g1)\\\" />\\n          <g transform=\\\"translate(20,18)\\\" fill=\\\"#0b6b56\\\">\\n            <circle cx=\\\"40\\\" cy=\\\"24\\\" r=\\\"18\\\" fill=\\\"#0b6b56\\\" opacity=\\\"0.12\\\" />\\n            <circle cx=\\\"40\\\" cy=\\\"24\\\" r=\\\"8\\\" fill=\\\"#0b6b56\\\" />\\n            <rect x=\\\"10\\\" y=\\\"56\\\" width=\\\"60\\\" height=\\\"8\\\" rx=\\\"4\\\" fill=\\\"#0b6b56\\\" opacity=\\\"0.08\\\" />\\n          </g>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <!-- Measured Myth/Truths -->\\n    <section aria-labelledby=\\\"myths-heading\\\">\\n      <h2 id=\\\"myths-heading\\\" style=\\\"margin:0;font-size:18px\\\">Common myths vs. what the data actually shows</h2>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Myth</strong>\\n          <p class=\\\"muted\\\" style=\\\"margin:6px 0 0\\\">You need big motivation bursts to change habits.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Reality</strong>\\n          <p class=\\\"muted\\\" style=\\\"margin:6px 0 0\\\">Small, consistent adjustments compounded over weeks are a more reliable path to lasting change.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Pillars (frameworks) -->\\n    <section aria-labelledby=\\\"pillars-heading\\\">\\n      <h2 id=\\\"pillars-heading\\\" style=\\\"font-size:18px;margin:0\\\">Core frameworks I use</h2>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 6px 0\\\">Signal → Routine → Feedback</h3>\\n          <p class=\\\"muted\\\">Design environmental signals, build a compact habit routine, use simple feedback loops to iterate.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 6px 0\\\">Process over milestones</h3>\\n          <p class=\\\"muted\\\">Focus on repeatable behaviours instead of distant outcomes; success is frequency and fidelity.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Case studies (short) -->\\n    <section aria-labelledby=\\\"cases-heading\\\">\\n      <h2 id=\\\"cases-heading\\\" style=\\\"margin:0;font-size:18px\\\">Outcome stories</h2>\\n      <div style=\\\"margin-top:12px\\\">\\n        <div class=\\\"card\\\" style=\\\"margin-bottom:10px\\\">\\n          <strong>Client: mid-career professional</strong>\\n          <p class=\\\"muted\\\">Built a 4-step evening routine that increased restorative sleep blocks and reduced morning decision fatigue within 6 weeks.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Client: new parent</strong>\\n          <p class=\\\"muted\\\">Shifted priorities and micro-habits to regain 45 minutes daily for restorative activity across a month-long plan.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- FAQ (unique questions) -->\\n    <section aria-labelledby=\\\"faq-heading\\\">\\n      <h2 id=\\\"faq-heading\\\" style=\\\"margin:0;font-size:18px\\\">Questions I often address</h2>\\n      <div style=\\\"margin-top:12px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>How do you measure progress?</strong>\\n          <p class=\\\"muted\\\">We track habit frequency, perceived energy, and one behavioural KPI aligned to your goal, reviewed weekly.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Will I get prescriptive plans?</strong>\\n          <p class=\\\"muted\\\">Yes — plans are structured experiments you test and adapt. They’re specific, short, and measurable.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- CTA -->\\n    <section style=\\\"margin-top:20px\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin:0\\\">Start with a 20-minute diagnostic</h3>\\n        <p class=\\\"muted\\\">A focused session to map your routines, identify friction points, and outline a pragmatic 4-week experiment.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule a diagnostic</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>{{COACH_NAME}}, {{CREDENTIALS}} — {{CITY}}, {{STATE}} &nbsp;•&nbsp; <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> &nbsp;•&nbsp; <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Coaching services and support models for habit-first wellbeing.\\\">\\n  <style>\\n    :root{--bg:#fbfdfc;--fg:#082028;--muted:#4b5b61;--accent:#0a6b59}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:var(--fg);background:var(--bg)}\\n    .sheet{max-width:880px;margin:44px auto;padding:32px;background:white;border-radius:12px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{color:var(--muted);text-decoration:none;margin-left:14px}\\n    .hero{padding:18px 0;display:flex;align-items:center;gap:22px}\\n    .illustration{width:180px;height:120px}\\n    h1{margin:0;font-size:24px}\\n    p.lead{color:var(--muted);margin-top:8px}\\n    .services{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .service{padding:14px;border-radius:10px;background:#fbfffc;border:1px solid rgba(10,107,89,0.04)}\\n    .muted{color:var(--muted)}\\n    .cta{display:inline-block;margin-top:12px;background:var(--accent);color:white;padding:9px 12px;border-radius:9px;text-decoration:none}\\n    .faq{margin-top:20px}\\n    @media(max-width:840px){.services{grid-template-columns:1fr}.hero{flex-direction:column}.illustration{width:100%;height:120px}}\\n  </style>\\n</head>\\n<body>\\n  <main class=\\\"sheet\\\">\\n    <header>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <!-- Hero: services focused -->\\n    <section class=\\\"hero\\\" aria-label=\\\"Services hero\\\">\\n      <div>\\n        <h1>Offerings tailored to steady behaviour change</h1>\\n        <p class=\\\"lead\\\">Short engagements, ongoing membership, and team workshops — each built to prioritize habits that scale.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Get started</a>\\n      </div>\\n      <div class=\\\"illustration\\\" aria-hidden=\\\"true\\\">\\n        <!-- Unique inline SVG pattern for services.html -->\\n        <svg viewBox=\\\"0 0 180 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"180\\\" height=\\\"120\\\">\\n          <rect width=\\\"180\\\" height=\\\"120\\\" rx=\\\"10\\\" fill=\\\"#f1fbf8\\\" />\\n          <g fill=\\\"#0a6b59\\\" opacity=\\\"0.08\\\">\\n            <rect x=\\\"12\\\" y=\\\"18\\\" width=\\\"44\\\" height=\\\"12\\\" rx=\\\"6\\\" />\\n            <rect x=\\\"72\\\" y=\\\"48\\\" width=\\\"92\\\" height=\\\"10\\\" rx=\\\"5\\\" />\\n            <rect x=\\\"12\\\" y=\\\"78\\\" width=\\\"156\\\" height=\\\"8\\\" rx=\\\"4\\\" />\\n          </g>\\n          <circle cx=\\\"36\\\" cy=\\\"36\\\" r=\\\"8\\\" fill=\\\"#0a6b59\\\" opacity=\\\"0.12\\\" />\\n          <circle cx=\\\"120\\\" cy=\\\"78\\\" r=\\\"10\\\" fill=\\\"#0a6b59\\\" opacity=\\\"0.06\\\" />\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <!-- Service offerings grid (three distinct services) -->\\n    <section aria-labelledby=\\\"offerings-heading\\\">\\n      <h2 id=\\\"offerings-heading\\\" style=\\\"font-size:16px;margin:0\\\">How we work together</h2>\\n      <div class=\\\"services\\\">\\n        <div class=\\\"service\\\">\\n          <strong>Habit Sprint (6 weeks)</strong>\\n          <p class=\\\"muted\\\">A focused, coached experiment to introduce 1–2 critical habits and track fidelity with weekly adjustments.</p>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Includes: 3 coaching calls, check-ins, habit tracker templates.</p>\\n        </div>\\n        <div class=\\\"service\\\">\\n          <strong>Hybrid Coaching</strong>\\n          <p class=\\\"muted\\\">Monthly rhythm of planning + accountability. Best for people who want continuous refinement and peer practice.</p>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Includes: Weekly micro-tasks, two live strategy sessions/month, messaging support.</p>\\n        </div>\\n        <div class=\\\"service\\\">\\n          <strong>Team Wellbeing Lab</strong>\\n          <p class=\\\"muted\\\">A structured cohort for small teams: frameworks, shared experiments, and outcome tracking across 8 weeks.</p>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Includes: Workshop kit, facilitator guide, team progress dashboard.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Pillars: quick frameworks (different heading) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0;font-size:16px\\\">Methodical building blocks</h3>\\n      <div style=\\\"margin-top:10px;display:grid;grid-template-columns:1fr 1fr;gap:12px\\\">\\n        <div class=\\\"service\\\">\\n          <strong>Cue design</strong>\\n          <p class=\\\"muted\\\">We shape contexts so behaviours become easier to start.</p>\\n        </div>\\n        <div class=\\\"service\\\">\\n          <strong>Micro-commitments</strong>\\n          <p class=\\\"muted\\\">Tiny, repeatable steps that lower resistance and reveal leverage.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Myth vs truth (brief, different phrasing) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0;font-size:16px\\\">Quick calibration: myths I refute</h3>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-wrap:wrap\\\">\\n        <div class=\\\"service\\\" style=\\\"flex:1 1 220px\\\">\\n          <strong>Myth</strong>\\n          <p class=\\\"muted\\\">More willpower beats system design.</p>\\n        </div>\\n        <div class=\\\"service\\\" style=\\\"flex:1 1 220px\\\">\\n          <strong>Truth</strong>\\n          <p class=\\\"muted\\\">Design + small wins outperform willpower alone.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Short case studies -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0;font-size:16px\\\">Representative outcomes</h3>\\n      <div style=\\\"margin-top:10px;display:grid;grid-template-columns:1fr 1fr;gap:12px\\\">\\n        <div class=\\\"card service\\\">\\n          <strong>8-week cohort</strong>\\n          <p class=\\\"muted\\\">Participants improved daily restorative time by 28% through shared accountability practices.</p>\\n        </div>\\n        <div class=\\\"card service\\\">\\n          <strong>One-on-one</strong>\\n          <p class=\\\"muted\\\">Single habit adoption with 85% adherence after structured cueing and measurement.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- FAQ (different Qs) -->\\n    <section class=\\\"faq\\\">\\n      <h3 style=\\\"margin:0;font-size:16px\\\">Service questions</h3>\\n      <div style=\\\"margin-top:10px;display:grid;gap:10px\\\">\\n        <div class=\\\"service\\\">\\n          <strong>Can I switch from a sprint to membership?</strong>\\n          <p class=\\\"muted\\\">Yes. The sprint is designed as a transition into longer-term membership when outcomes are promising.</p>\\n        </div>\\n        <div class=\\\"service\\\">\\n          <strong>Are materials included?</strong>\\n          <p class=\\\"muted\\\">Templates and simple trackers are included. Workbooks are downloadable and adaptable.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- CTA -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <div style=\\\"padding:14px;border-radius:10px;background:#fbfffb;border:1px solid rgba(10,107,89,0.04)\\\">\\n        <strong>Not sure which model fits?</strong>\\n        <p class=\\\"muted\\\" style=\\\"margin:6px 0\\\">Book a complimentary call and we’ll identify the right entry point for your goals.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a complimentary call</a>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:20px;color:var(--muted);font-size:13px\\\">{{COACH_NAME}}, {{CREDENTIALS}} — <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> &nbsp;•&nbsp; {{CITY}}, {{STATE}}</footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Programs & Membership — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Membership tracks and program options for steady habit change.\\\">\\n  <style>\\n    :root{--bg:#fbfdfc;--fg:#07161a;--muted:#4f6066;--accent:#0b6b56}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:var(--fg);background:var(--bg)}\\n    .container{max-width:920px;margin:48px auto;padding:36px;background:white;border-radius:12px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    header nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .intro{margin-top:18px}\\n    h1{margin:0;font-size:26px}\\n    .tracks{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .track{padding:16px;border-radius:12px;background:#fbfffb;border:1px solid rgba(11,107,86,0.04)}\\n    .price{font-weight:700;margin-top:10px}\\n    .muted{color:var(--muted)}\\n    .cta{display:inline-block;margin-top:10px;background:var(--accent);color:white;padding:9px 12px;border-radius:9px;text-decoration:none}\\n    .faq{margin-top:20px}\\n    @media(max-width:880px){.tracks{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <main class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"services.html\\\">Work</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n      </nav>\\n    </header>\\n\\n    <!-- Hero: programs member-focused with a unique inline SVG -->\\n    <section class=\\\"intro\\\">\\n      <div style=\\\"display:flex;align-items:center;gap:20px;flex-wrap:wrap\\\">\\n        <div>\\n          <h1>Membership tracks built for sustained progress</h1>\\n          <p class=\\\"muted\\\">Choose a path that matches how much support you want. Membership focuses on habit systems, not one-off advice.</p>\\n        </div>\\n        <div aria-hidden=\\\"true\\\" style=\\\"width:96px;height:64px\\\">\\n          <!-- Unique inline SVG pattern for programs.html -->\\n          <svg viewBox=\\\"0 0 96 64\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"96\\\" height=\\\"64\\\">\\n            <rect width=\\\"96\\\" height=\\\"64\\\" rx=\\\"8\\\" fill=\\\"#f6fffb\\\" />\\n            <g fill=\\\"#0b6b56\\\" opacity=\\\"0.08\\\">\\n              <rect x=\\\"8\\\" y=\\\"10\\\" width=\\\"80\\\" height=\\\"8\\\" rx=\\\"4\\\" />\\n              <rect x=\\\"8\\\" y=\\\"30\\\" width=\\\"56\\\" height=\\\"8\\\" rx=\\\"4\\\" />\\n            </g>\\n            <circle cx=\\\"76\\\" cy=\\\"48\\\" r=\\\"6\\\" fill=\\\"#0b6b56\\\" opacity=\\\"0.06\\\" />\\n          </svg>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Membership Tracks (use different program names) -->\\n    <section style=\\\"margin-top:18px\\\" aria-labelledby=\\\"tracks-heading\\\">\\n      <h2 id=\\\"tracks-heading\\\" style=\\\"margin:0;font-size:16px\\\">Choose a path</h2>\\n      <div class=\\\"tracks\\\">\\n        <div class=\\\"track\\\">\\n          <strong>Foundations Track</strong>\\n          <p class=\\\"muted\\\">For people who want a clear, evidence-based starter plan: focused habit sequencing and weekly coaching.</p>\\n          <div class=\\\"price\\\">Monthly membership: introductory tier</div>\\n          <p class=\\\"muted\\\">Includes: 1 coaching session/month, habit templates, weekly check-ins.</p>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Join Foundations</a>\\n        </div>\\n        <div class=\\\"track\\\">\\n          <strong>Momentum Membership</strong>\\n          <p class=\\\"muted\\\">A steady rhythm for sustained behavioural gains: active coaching, targeted experiments, and accountability.</p>\\n          <div class=\\\"price\\\">Monthly membership: core tier</div>\\n          <p class=\\\"muted\\\">Includes: two sessions/month, personalized trackers, priority messaging.</p>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Join Momentum</a>\\n        </div>\\n        <div class=\\\"track\\\">\\n          <strong>Steward Circle</strong>\\n          <p class=\\\"muted\\\">A small cohort model emphasizing community experiments, data review, and peer learning.</p>\\n          <div class=\\\"price\\\">Monthly membership: cohort tier</div>\\n          <p class=\\\"muted\\\">Includes: weekly cohort sessions, progress dashboards, facilitator support.</p>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Apply to Steward</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Lead magnet / onboarding offer (different phrasing) -->\\n    <section style=\\\"margin-top:20px\\\">\\n      <div style=\\\"padding:14px;border-radius:10px;background:#fbfffb;border:1px solid rgba(11,107,86,0.04)\\\">\\n        <strong>Download: 7-day habit calibration</strong>\\n        <p class=\\\"muted\\\" style=\\\"margin:6px 0\\\">A concise checklist and short experiments to test which adjustments yield the largest lift. Available when you sign up for the Foundations Track.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Get the 7-day calibration</a>\\n      </div>\\n    </section>\\n\\n    <!-- Case studies with membership emphasis -->\\n    <section style=\\\"margin-top:20px\\\">\\n      <h3 style=\\\"margin:0;font-size:16px\\\">Membership outcomes</h3>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px\\\">\\n        <div class=\\\"track\\\">\\n          <strong>Momentum cohort — 12 weeks</strong>\\n          <p class=\\\"muted\\\">Members reported consistent energy improvements and shorter time-to-habit adoption compared to ad hoc approaches.</p>\\n        </div>\\n        <div class=\\\"track\\\">\\n          <strong>Steward Circle — cohort study</strong>\\n          <p class=\\\"muted\\\">Collective experiments increased adherence through social accountability and shared cues.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- FAQ (unique to programs) -->\\n    <section class=\\\"faq\\\">\\n      <h3 style=\\\"margin:0;font-size:16px\\\">Membership questions</h3>\\n      <div style=\\\"margin-top:10px;display:grid;gap:10px\\\">\\n        <div class=\\\"track\\\">\\n          <strong>How long should I stay in membership?</strong>\\n          <p class=\\\"muted\\\">Stay until behaviours reliably fit your life. Many members assess at 3 months and continue if they value the coaching rhythm.</p>\\n        </div>\\n        <div class=\\\"track\\\">\\n          <strong>Is there a trial?</strong>\\n          <p class=\\\"muted\\\">We offer an initial diagnostic call that orients your plan; membership billing and terms are explained during onboarding.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Final CTA -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <div style=\\\"padding:14px;border-radius:10px;background:#fff;display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid rgba(11,23,32,0.04)\\\">\\n        <div>\\n          <strong>Ready to pick a path?</strong>\\n          <p class=\\\"muted\\\" style=\\\"margin:4px 0\\\">Start with a 20-minute diagnostic to map a plan for your specific routines.</p>\\n        </div>\\n        <div>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule your diagnostic</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted);font-size:13px\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> &nbsp;•&nbsp; {{PHONE}} — {{COACH_NAME}}, {{CREDENTIALS}}</footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
