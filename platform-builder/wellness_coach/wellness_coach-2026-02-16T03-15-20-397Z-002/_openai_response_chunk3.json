          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Plans — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfcfb;--text:#0b1620;--muted:#52606a;--accent:#0b8a72;--card:#ffffff}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:var(--text);background:var(--bg);}\\n    .container{max-width:920px;margin:48px auto;padding:32px}\\n    nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}\\n    a.logo{font-weight:600;text-decoration:none;color:var(--text)}\\n    .navlinks a{margin-left:18px;color:var(--muted);text-decoration:none;font-size:15px}\\n    header.hero{padding:40px 32px;background:linear-gradient(180deg,rgba(11,138,114,0.05),transparent);border-radius:12px}\\n    header.hero h1{margin:0 0 8px 0;font-size:28px;letter-spacing:-0.02em}\\n    header.hero p{margin:0;color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:26px}\\n    .card{background:var(--card);padding:20px;border-radius:10px;box-shadow:0 6px 18px rgba(9,18,20,0.04)}\\n    .price{font-weight:700;font-size:22px;color:var(--accent)}\\n    .meta{color:var(--muted);font-size:14px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;background:var(--accent);color:white;border-radius:8px;text-decoration:none}\\n    section.half{display:flex;gap:18px;margin-top:32px}\\n    .list{margin:0;padding:0;list-style:none}\\n    footer{margin-top:42px;padding-top:18px;border-top:1px solid rgba(9,18,20,0.04);color:var(--muted);font-size:14px}\\n    /* subtle layout for minimal aesthetic */\\n    .muted-sm{color:var(--muted);font-size:13px}\\n    .pill{display:inline-block;background:rgba(11,138,114,0.08);color:var(--accent);padding:6px 8px;border-radius:999px;font-weight:600;font-size:13px}\\n    .faq dt{font-weight:600;margin-top:12px}\\n    .case{display:flex;gap:14px;align-items:flex-start}\\n    .avatar{width:56px;height:56px;border-radius:8px;background:linear-gradient(135deg,#e6fbf6,#f6fffb);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent)}\\n    form.pricing-table{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}\\n    @media (max-width:820px){.grid{grid-template-columns:1fr}.form.pricing-table{grid-template-columns:1fr}.container{padding:18px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <nav>\\n      <a class=\\\"logo\\\" href=\\\"index.html\\\">{{BUSINESS_NAME}}</a>\\n      <div class=\\\"navlinks\\\">\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"testimonials.html\\\">Stories</a>\\n        <a href=\\\"book.html\\\">Work With Me</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </div>\\n    </nav>\\n\\n    <header class=\\\"hero\\\">\\n      <!-- inline decorative SVG (unique hero for pricing) -->\\n      <svg width=\\\"0\\\" height=\\\"0\\\" style=\\\"position:absolute;left:-9999px;\\\">\\n        <defs>\\n          <linearGradient id=\\\"g-pricing\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n            <stop offset=\\\"0\\\" stop-color=\\\"#E8FBF6\\\"/>\\n            <stop offset=\\\"1\\\" stop-color=\\\"#FFFFFF\\\"/>\\n          </linearGradient>\\n        </defs>\\n      </svg>\\n      <h1>Choose a steady plan for lasting habits</h1>\\n      <p>Simple membership tiers built around outcomes, frameworks, and weekly accountability — rooted in habit science and pragmatic steps.</p>\\n    </header>\\n\\n    <main>\\n      <section style=\\\"margin-top:22px\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div>\\n            <span class=\\\"pill\\\">Membership</span>\\n            <h2 style=\\\"margin:8px 0 4px 0\\\">Three ways to commit</h2>\\n            <p class=\\\"muted-sm\\\">Pick a cadence that fits your life. All plans emphasize measurable habit change, not quick fixes.</p>\\n          </div>\\n          <div class=\\\"muted-sm\\\">Questions? Call {{PHONE}} or <a href=\\\"mailto:{{EMAIL}}\\\">email</a>.</div>\\n        </div>\\n\\n        <form class=\\\"pricing-table\\\" aria-label=\\\"pricing plans\\\" style=\\\"margin-top:18px\\\">\\n          <div class=\\\"card\\\">\\n            <div class=\\\"meta\\\">Starter — Monthly Rhythm</div>\\n            <div class=\\\"price\\\">$39 / month</div>\\n            <p class=\\\"muted-sm\\\">For individuals wanting structure: weekly habit checklist, monthly group session, resource library.</p>\\n            <ul class=\\\"list\\\" style=\\\"margin-top:10px\\\">\\n              <li class=\\\"muted-sm\\\">Weekly micro-goals</li>\\n              <li class=\\\"muted-sm\\\">Access to habit templates</li>\\n              <li class=\\\"muted-sm\\\">Monthly community Q&amp;A</li>\\n            </ul>\\n            <a class=\\\"cta\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <div class=\\\"meta\\\">Core — Sustained Foundations</div>\\n            <div class=\\\"price\\\">$129 / month</div>\\n            <p class=\\\"muted-sm\\\">A guided membership with regular 1:1 check-ins, habit audits, and personalized frameworks.</p>\\n            <ul class=\\\"list\\\" style=\\\"margin-top:10px\\\">\\n              <li class=\\\"muted-sm\\\">Bi-weekly coaching calls</li>\\n              <li class=\\\"muted-sm\\\">Customized habit plan</li>\\n              <li class=\\\"muted-sm\\\">Priority messaging</li>\\n            </ul>\\n            <a class=\\\"cta\\\" href=\\\"book.html\\\">Start Core</a>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <div class=\\\"meta\\\">Circle — Elevate Cohort</div>\\n            <div class=\\\"price\\\">$950 / quarter</div>\\n            <p class=\\\"muted-sm\\\">Cohort-based deep work: 12-week cycles with peer feedback and workshop days — best for accelerated, sustained change.</p>\\n            <ul class=\\\"list\\\" style=\\\"margin-top:10px\\\">\\n              <li class=\\\"muted-sm\\\">Weekly workshops</li>\\n              <li class=\\\"muted-sm\\\">Group accountability pods</li>\\n              <li class=\\\"muted-sm\\\">Framework toolkits</li>\\n            </ul>\\n            <a class=\\\"cta\\\" href=\\\"programs.html\\\">Join a Cohort</a>\\n          </div>\\n        </form>\\n      </section>\\n\\n      <section class=\\\"grid\\\" style=\\\"margin-top:28px\\\">\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Common Misconceptions</h3>\\n          <div class=\\\"muted-sm\\\">Myth vs. truth about change</div>\\n          <dl style=\\\"margin-top:12px\\\">\\n            <dt style=\\\"margin-top:8px\\\">Myth: Willpower is enough.</dt>\\n            <dd class=\\\"muted-sm\\\">Truth: Habit systems reduce reliance on willpower. We design environmental cues and routines that support consistent action.</dd>\\n            <dt style=\\\"margin-top:8px\\\">Myth: One-size-fits-all plans work.</dt>\\n            <dd class=\\\"muted-sm\\\">Truth: Frameworks are adapted to your context — small experiments guide personalization.</dd>\\n          </dl>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Core Habits I Teach</h3>\\n          <ul style=\\\"margin-top:12px\\\">\\n            <li class=\\\"muted-sm\\\">Anchor routines (morning/evening)</li>\\n            <li class=\\\"muted-sm\\\">Micro-habit layering for consistency</li>\\n            <li class=\\\"muted-sm\\\">Weekly review and signal-based adjustments</li>\\n          </ul>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:28px\\\">\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Case Study — Habit Growth</h3>\\n          <div class=\\\"case\\\" style=\\\"margin-top:10px\\\">\\n            <div class=\\\"avatar\\\">AB</div>\\n            <div>\\n              <strong>Client A (mid-career professional)</strong>\\n              <p class=\\\"muted-sm\\\" style=\\\"margin:6px 0 0 0\\\">Outcome: Rebuilt sleep and movement routines across 16 weeks using cue-based habit stacks. Reported improved energy and consistent morning practice.</p>\\n            </div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:28px\\\" class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Frequently asked questions</h3>\\n        <div class=\\\"faq\\\" style=\\\"margin-top:12px\\\">\\n          <dl>\\n            <dt>How do I choose a plan?</dt>\\n            <dd class=\\\"muted-sm\\\">Start with the time you can reliably commit. Core is a common first step for 1:1 support; Circle is for focused deep work with peers.</dd>\\n            <dt>Is there a trial?</dt>\\n            <dd class=\\\"muted-sm\\\">We offer a 14-day low-commitment starter pathway for new members to test the framework.</dd>\\n            <dt>What outcomes are realistic?</dt>\\n            <dd class=\\\"muted-sm\\\">Sustainable habit shifts across weeks to months. We track behavior change and adjust based on small experiments.</dd>\\n          </dl>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:28px;display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <h3 style=\\\"margin:0\\\">Ready to begin?</h3>\\n          <p class=\\\"muted-sm\\\" style=\\\"margin:6px 0 0 0\\\">Choose a plan that respects your schedule; we’ll design the mechanics for daily action.</p>\\n        </div>\\n        <div>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </section>\\n    </main>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} — {{TAGLINE}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Stories & Evidence — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#ffffff;--text:#0b1620;--muted:#4b5b66;--accent:#0b8a72}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;background:var(--bg);color:var(--text)}\\n    .wrap{max-width:920px;margin:48px auto;padding:28px}\\n    nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}\\n    a.logo{text-decoration:none;color:var(--text);font-weight:600}\\n    .navlinks a{margin-left:18px;color:var(--muted);text-decoration:none}\\n    header{padding:28px;border-radius:10px;background:linear-gradient(0deg,rgba(11,138,114,0.03),transparent)}\\n    header h1{margin:0 0 6px 0}\\n    .quote{font-style:italic;color:var(--muted)}\\n    .test-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:20px}\\n    .card{padding:18px;border-radius:10px;background:#fff;box-shadow:0 8px 20px rgba(11,16,18,0.04)}\\n    .meta{color:var(--muted);font-size:13px}\\n    .case-study{margin-top:18px;border-left:3px solid rgba(11,138,114,0.06);padding-left:12px}\\n    .cta{display:inline-block;padding:10px 14px;background:var(--accent);color:#fff;border-radius:8px;text-decoration:none}\\n    .faq dt{font-weight:700;margin-top:10px}\\n    .avatar{width:44px;height:44px;border-radius:8px;background:linear-gradient(135deg,#fbfff9,#f3fef8);display:inline-flex;align-items:center;justify-content:center;color:var(--accent);font-weight:700}\\n    @media (max-width:820px){.test-grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav>\\n      <a class=\\\"logo\\\" href=\\\"index.html\\\">{{BUSINESS_NAME}}</a>\\n      <div class=\\\"navlinks\\\">\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </div>\\n    </nav>\\n\\n    <header>\\n      <h1>Real change: client stories</h1>\\n      <p class=\\\"quote\\\">\\\"A practical, science-first approach that made small habits stick — not hype.\\\" — former client</p>\\n    </header>\\n\\n    <main>\\n      <section style=\\\"margin-top:20px\\\">\\n        <div class=\\\"test-grid\\\">\\n          <div class=\\\"card\\\">\\n            <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n              <div class=\\\"avatar\\\">JS</div>\\n              <div>\\n                <strong>J. S., Product Lead</strong>\\n                <div class=\\\"meta\\\">Sustained Foundations member</div>\\n              </div>\\n            </div>\\n            <p style=\\\"margin-top:12px\\\" class=\\\"meta\\\">\\\"Within 8 weeks I had an anchored morning routine and a weekly review. I track actions rather than willpower now; progress feels repeatable.\\\"</p>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n              <div class=\\\"avatar\\\">MK</div>\\n              <div>\\n                <strong>M. K., Teacher</strong>\\n                <div class=\\\"meta\\\">Monthly Rhythm starter</div>\\n              </div>\\n            </div>\\n            <p style=\\\"margin-top:12px\\\" class=\\\"meta\\\">\\\"The micro-habit approach removed friction. I now exercise three times a week and haven’t missed two weeks in a row.\\\"</p>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"card case-study\\\" style=\\\"margin-top:22px\\\">\\n        <h3 style=\\\"margin-top:0\\\">Case study — building a sustainable practice</h3>\\n        <p class=\\\"meta\\\">Client profile: early-career professional with inconsistent routines, limited time for change. Intervention: 10-week habit stacking plus environmental redesign.</p>\\n        <ol style=\\\"margin-top:12px\\\" class=\\\"muted-sm\\\">\\n          <li>Week 1–2: baseline tracking and micro-goal selection.</li>\\n          <li>Week 3–6: anchor routine formation, two tiny wins per day.</li>\\n          <li>Week 7–10: review, scale-up of successful micro-habits, relapse planning.</li>\\n        </ol>\\n        <p class=\\\"meta\\\" style=\\\"margin-top:10px\\\">Measured outcome: consistent execution of daily anchors increased from 12% to 78% across 10 weeks; client reported improved focus and less decision fatigue.</p>\\n      </section>\\n\\n      <section style=\\\"margin-top:22px\\\">\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">What clients value most</h3>\\n          <ul style=\\\"margin-top:10px\\\" class=\\\"meta\\\">\\n            <li>Practical tools for predictable behavior change</li>\\n            <li>Frameworks that fit real lives</li>\\n            <li>Accountability without pressure</li>\\n          </ul>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"card\\\" style=\\\"margin-top:22px\\\">\\n        <h3 style=\\\"margin-top:0\\\">Questions often asked by new clients</h3>\\n        <div class=\\\"faq\\\">\\n          <dl>\\n            <dt>How quickly will I see progress?</dt>\\n            <dd class=\\\"meta\\\">Progress is visible within weeks for micro-habits; larger behavioral patterns take 8–12 weeks of consistent application and iterative tweaks.</dd>\\n            <dt>Do you track outcomes?</dt>\\n            <dd class=\\\"meta\\\">Yes — we emphasize measurable behavior indicators rather than subjective promises.</dd>\\n            <dt>Can I move between plans?</dt>\\n            <dd class=\\\"meta\\\">Absolutely. Many clients start in a lighter plan and scale up when they want deeper support.</dd>\\n          </dl>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:22px;display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <h4 style=\\\"margin:0\\\">Ready to try a focused approach?</h4>\\n          <p class=\\\"meta\\\" style=\\\"margin:6px 0 0 0\\\">Book a free discovery call to explore fit and next steps.</p>\\n        </div>\\n        <div>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Schedule a Call</a>\\n        </div>\\n      </section>\\n\\n    </main>\\n\\n    <footer style=\\\"margin-top:28px;color:var(--muted);font-size:13px\\\">\\n      {{BUSINESS_NAME}} — {{COACH_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}} • {{PHONE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a Discovery — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfefe;--text:#0b1620;--muted:#5a6a70;--accent:#0b8a72}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;background:var(--bg);color:var(--text)}\\n    .wrap{max-width:760px;margin:48px auto;padding:28px}\\n    nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:26px}\\n    a.logo{font-weight:600;text-decoration:none;color:var(--text)}\\n    .navlinks a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .hero{padding:26px;border-radius:12px;background:linear-gradient(180deg,rgba(11,138,114,0.04),transparent)}\\n    h1{margin:0 0 6px 0}\\n    p.lead{color:var(--muted);margin:0}\\n    form{margin-top:20px;background:#fff;border-radius:10px;padding:18px;box-shadow:0 10px 24px rgba(9,18,20,0.04)}\\n    label{display:block;font-weight:600;margin-top:12px}\\n    input,textarea,select{width:100%;padding:10px;border-radius:8px;border:1px solid #e6eef0;margin-top:6px;font-size:15px}\\n    .row{display:grid;grid-template-columns:1fr 1fr;gap:12px}\\n    .note{font-size:13px;color:var(--muted);margin-top:10px}\\n    .btn{margin-top:14px;padding:10px 14px;background:var(--accent);color:#fff;border-radius:8px;border:none;cursor:pointer}\\n    .pill{display:inline-block;background:rgba(11,138,114,0.08);color:var(--accent);padding:6px 8px;border-radius:999px;font-weight:600}\\n    .myth{margin-top:18px;padding:14px;border-radius:8px;background:#fff}\\n    .case{margin-top:12px;padding:12px;background:#fff;border-radius:8px}\\n    @media (max-width:700px){.row{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav>\\n      <a class=\\\"logo\\\" href=\\\"index.html\\\">{{BUSINESS_NAME}}</a>\\n      <div class=\\\"navlinks\\\">\\n        <a href=\\\"services.html\\\">Work With Me</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"testimonials.html\\\">Stories</a>\\n      </div>\\n    </nav>\\n\\n    <section class=\\\"hero\\\">\\n      <span class=\\\"pill\\\">Discovery</span>\\n      <h1>Reserve a short diagnostic conversation</h1>\\n      <p class=\\\"lead\\\">A 30-minute clarity call to define goals, constraints, and an initial habit experiment. No pressure, only practical next steps.</p>\\n    </section>\\n\\n    <main>\\n      <section style=\\\"margin-top:18px\\\">\\n        <div class=\\\"myth\\\">\\n          <strong>Quick myth check</strong>\\n          <p class=\\\"note\\\" style=\\\"margin-top:8px\\\">Myth: Coaching fixes everything quickly. Reality: Coaching is a structured process for designing repeatable behavior — we measure and iterate. The discovery call clarifies the first reliable micro-experiment.</p>\\n        </div>\\n\\n        <form id=\\\"bookForm\\\" novalidate>\\n          <label for=\\\"name\\\">Your name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" required placeholder=\\\"First and last name\\\">\\n\\n          <div class=\\\"row\\\">\\n            <div>\\n              <label for=\\\"email\\\">Email</label>\\n              <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required placeholder=\\\"you@example.com\\\">\\n            </div>\\n            <div>\\n              <label for=\\\"phone\\\">Phone (optional)</label>\\n              <input id=\\\"phone\\\" name=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"(555) 555-5555\\\">\\n            </div>\\n          </div>\\n\\n          <label for=\\\"focus\\\">Primary focus for coaching</label>\\n          <select id=\\\"focus\\\" name=\\\"focus\\\">\\n            <option>Sleep & Routine</option>\\n            <option>Daily Movement</option>\\n            <option>Work-Life Rhythm</option>\\n            <option>Stress and Recovery</option>\\n            <option>Other</option>\\n          </select>\\n\\n          <label for=\\\"notes\\\">Brief context (current routines, constraints, goals)</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"A few sentences is fine\\\"></textarea>\\n\\n          <p class=\\\"note\\\">By booking you agree to receive scheduling communications from {{BUSINESS_NAME}}. If you need an invoice or accessibility accommodations, email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</p>\\n\\n          <button type=\\\"submit\\\" class=\\\"btn\\\">Request a Discovery Call</button>\\n          <div id=\\\"formMessage\\\" class=\\\"note\\\" aria-live=\\\"polite\\\"></div>\\n        </form>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px\\\">\\n        <div class=\\\"case\\\">\\n          <h4 style=\\\"margin:0\\\">What to expect in 30 minutes</h4>\\n          <ol style=\\\"margin-top:8px\\\" class=\\\"note\\\">\\n            <li>Clear articulation of the problem and constraints.</li>\\n            <li>One micro-experiment you can start immediately.</li>\\n            <li>Recommendations for an appropriate program path (if fit).</li>\\n          </ol>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px\\\" class=\\\"case\\\">\\n        <h4 style=\\\"margin:0\\\">Refunds & rescheduling</h4>\\n        <p class=\\\"note\\\" style=\\\"margin-top:8px\\\">If you need to reschedule, please notify at least 24 hours in advance by emailing {{EMAIL}}. Discovery calls are complimentary; paid programs have standard terms discussed upon contracting.</p>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <strong>{{COACH_NAME}}, {{CREDENTIALS}}</strong>\\n          <div class=\\\"note\\\">Based in {{CITY}}, {{STATE}} — evidence-informed coaching and behavior design.</div>\\n        </div>\\n        <div>\\n          <a class=\\\"btn\\\" href=\\\"mailto:{{EMAIL}}\\\">Contact via Email</a>\\n        </div>\\n      </section>\\n\\n    </main>\\n\\n    <footer style=\\\"margin-top:22px;color:var(--muted);font-size:13px\\\">{{BUSINESS_NAME}} • {{TAGLINE}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></footer>\\n  </div>\\n\\n  <script>\\n    (function(){\\n      var form=document.getElementById('bookForm');\\n      var msg=document.getElementById('formMessage');\\n      form.addEventListener('submit',function(e){\\n        e.preventDefault();\\n        var name=form.name.value.trim();\\n        var email=form.email.value.trim();\\n        if(!name||!email){ msg.textContent='Please provide your name and email.'; msg.style.color='crimson'; return; }\\n        msg.style.color=''; msg.textContent='Thanks — a scheduling link will be sent to ' + email + ' shortly.';\\n        // graceful local redirect to booking confirmation (placeholder)\\n        setTimeout(function(){ window.location.href='thank-you.html'; },1200);\\n      });\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
