          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Investment & Pathways</title>\\n  <style>\\n    :root{--bg:#fbfbfb;--card:#fff;--muted:#6b6b6b;--accent:#7a6bff;--accent-2:#ff8fa3;--radius:12px;--pad:22px}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#222;background:var(--bg)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 40px;background:linear-gradient(180deg,rgba(255,255,255,0.6),transparent);position:sticky;top:0}\\n    nav a{margin:0 10px;color:#444;text-decoration:none;font-weight:600}\\n    nav a.active{color:var(--accent)}\\n    .container{max-width:1100px;margin:40px auto;padding:0 24px}\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:36px;align-items:center}\\n    .hero .panel{background:var(--card);border-radius:var(--radius);padding:34px;box-shadow:0 8px 30px rgba(20,20,60,0.06)}\\n    h1{margin:0 0 12px;font-size:28px;line-height:1.05;color:#111}\\n    p.lead{margin:0 0 18px;color:var(--muted)}\\n    .btn{display:inline-block;padding:12px 18px;border-radius:10px;background:linear-gradient(90deg,var(--accent),var(--accent-2));color:#fff;text-decoration:none;font-weight:700}\\n    .gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:28px}\\n    .card{background:var(--card);padding:20px;border-radius:12px;box-shadow:0 6px 24px rgba(17,17,35,0.04)}\\n    .price{font-size:20px;font-weight:800;color:#111}\\n    .muted{color:var(--muted);font-size:14px}\\n    .metrics{display:flex;gap:18px;align-items:center}\\n    .metric{background:linear-gradient(180deg,#fff, #fbfbff);padding:12px;border-radius:10px;text-align:center;flex:1}\\n    .faq{margin-top:30px}\\n    .faq summary{cursor:pointer;padding:12px;background:var(--card);border-radius:10px;margin-bottom:8px}\\n    .lead-magnet{display:flex;gap:16px;align-items:center;margin-top:26px}\\n    footer{padding:40px 24px;color:var(--muted);font-size:14px;text-align:center}\\n    @media(max-width:900px){.hero{grid-template-columns:1fr;}.gallery{grid-template-columns:1fr 1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:14px\\\">\\n      <strong>{{BUSINESS_NAME}}</strong>\\n      <small style=\\\"color:var(--muted)\\\">— {{TAGLINE}}</small>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"programs.html\\\">Programs</a>\\n      <a href=\\\"services.html\\\">Work With Me</a>\\n      <a href=\\\"pricing.html\\\" class=\\\"active\\\">Pricing</a>\\n      <a href=\\\"testimonials.html\\\">Stories</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"panel\\\">\\n        <h1>Investment & Pathways for sustainable wellbeing</h1>\\n        <p class=\\\"lead\\\">Choose a practical structure that meets you where you are — short resets, steady momentum, or an immersive clarity day designed to change how you move forward with lasting habits.</p>\\n        <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a href=\\\"contact.html\\\" style=\\\"color:var(--muted);font-weight:700;text-decoration:none\\\">Ask a question</a>\\n        </div>\\n\\n        <div class=\\\"metrics\\\" style=\\\"margin-top:22px\\\">\\n          <div class=\\\"metric\\\"><div style=\\\"font-weight:800\\\">92%</div><div class=\\\"muted\\\" style=\\\"font-size:13px\\\">report new daily habits</div></div>\\n          <div class=\\\"metric\\\"><div style=\\\"font-weight:800\\\">45+ hrs</div><div class=\\\"muted\\\" style=\\\"font-size:13px\\\">average weekly momentum created</div></div>\\n          <div class=\\\"metric\\\"><div style=\\\"font-weight:800\\\">VIP</div><div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Signature 1:1 experiences</div></div>\\n        </div>\\n      </div>\\n\\n      <div>\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"illustration\\\" style=\\\"width:100%;border-radius:14px;display:block;box-shadow:0 18px 40px rgba(20,20,50,0.08)\\\">\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:30px\\\">\\n      <h2 style=\\\"margin:0 0 14px\\\">What these investments unlock</h2>\\n      <div class=\\\"gallery\\\">\\n        <div class=\\\"card\\\"><strong>Daily Rituals that stick</strong><p class=\\\"muted\\\">Small wins that compound — systems for mornings and nights.</p></div>\\n        <div class=\\\"card\\\"><strong>Clear decision frameworks</strong><p class=\\\"muted\\\">Reduce friction with prompts, rules, and accountability.</p></div>\\n        <div class=\\\"card\\\"><strong>Gentle momentum</strong><p class=\\\"muted\\\">Habit architecture without willpower shame.</p></div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:30px\\\">\\n      <h2 style=\\\"margin:0 0 14px\\\">How the experience flows</h2>\\n      <div style=\\\"display:flex;gap:14px;flex-wrap:wrap\\\">\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:220px\\\"><strong>1 — Discovery</strong><p class=\\\"muted\\\">Brief intake + priority setting.</p></div>\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:220px\\\"><strong>2 — Strategy</strong><p class=\\\"muted\\\">Personalized habit pathways and tiny experiments.</p></div>\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:220px\\\"><strong>3 — Integration</strong><p class=\\\"muted\\\">Daily templates, check-ins, and adjustments.</p></div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:30px\\\">\\n      <h2 style=\\\"margin:0 0 14px\\\">Choose a path — transparent investments</h2>\\n      <div class=\\\"gallery\\\">\\n        <div class=\\\"card\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div class=\\\"muted\\\">Starter Ritual</div>\\n              <div class=\\\"price\\\">Starting at $650</div>\\n            </div>\\n            <div><small class=\\\"muted\\\">3 weeks</small></div>\\n          </div>\\n          <p class=\\\"muted\\\">A focused reset to establish two core habits, with two coaching calls and templates.</p>\\n          <a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve Starter</a>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div class=\\\"muted\\\">Momentum Path</div>\\n              <div class=\\\"price\\\">Starting at $2,400</div>\\n            </div>\\n            <div><small class=\\\"muted\\\">90 days</small></div>\\n          </div>\\n          <p class=\\\"muted\\\">Three months of guided habit design, weekly check-ins, and habit tracking systems.</p>\\n          <a class=\\\"btn\\\" href=\\\"book.html\\\">Begin Momentum</a>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div class=\\\"muted\\\">Signature VIP Day</div>\\n              <div class=\\\"price\\\">Starting at $1,200</div>\\n            </div>\\n            <div><small class=\\\"muted\\\">1 full day</small></div>\\n          </div>\\n          <p class=\\\"muted\\\">A focused, immersive session for immediate clarity and a practical action map you can implement on day one.</p>\\n          <a class=\\\"btn\\\" href=\\\"book.html\\\">Book a VIP Day</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"lead-magnet\\\">\\n      <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\" style=\\\"width:74px;height:74px;border-radius:10px;box-shadow:0 8px 20px rgba(0,0,0,0.06)\\\">\\n      <div style=\\\"flex:1\\\">\\n        <strong>Free Habit Reset Checklist</strong>\\n        <p class=\\\"muted\\\" style=\\\"margin:6px 0\\\">Download a simple, science-informed checklist to reframe your routines this week.</p>\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" onsubmit=\\\"return false;\\\" style=\\\"display:flex;gap:8px\\\">\\n          <input placeholder=\\\"Email\\\" aria-label=\\\"email\\\" required style=\\\"flex:1;padding:10px;border-radius:10px;border:1px solid #e6e6f0\\\">\\n          <button class=\\\"btn\\\">Get the Checklist</button>\\n        </form>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3 style=\\\"margin-top:18px\\\">Questions people often ask</h3>\\n      <details>\\n        <summary>How do I know which path fits me?</summary>\\n        <div style=\\\"padding:10px 12px;color:var(--muted)\\\">We start with a short intake so I can recommend the best starting point based on what you want to prioritize.</div>\\n      </details>\\n      <details>\\n        <summary>Are sessions virtual or in-person?</summary>\\n        <div style=\\\"padding:10px 12px;color:var(--muted)\\\">Primarily virtual; in-person options available in {{CITY}}, {{STATE}} for VIP experiences.</div>\\n      </details>\\n      <details>\\n        <summary>What if I need more support after a program?</summary>\\n        <div style=\\\"padding:10px 12px;color:var(--muted)\\\">There are extension options and a light-touch maintenance plan available.</div>\\n      </details>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px\\\">\\n      <div style=\\\"background:linear-gradient(90deg,#fff,#fbf7ff);padding:22px;border-radius:14px;display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <strong>Ready to pick a path?</strong>\\n          <div class=\\\"muted\\\">Book a quick call and we’ll map the shortest route to better daily habits.</div>\\n        </div>\\n        <div>\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    <div style=\\\"margin-top:8px\\\">© <span id=\\\"year\\\"></span> {{BUSINESS_NAME}} — Guided habit design & compassionate coaching</div>\\n  </footer>\\n\\n  <script>document.getElementById('year').textContent=new Date().getFullYear();</script>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Stories — Transformations with {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--muted:#666;--accent:#6b8eff;--radius:14px}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;background:var(--bg);margin:0;color:#111}\\n    header{display:flex;justify-content:space-between;padding:18px 36px;border-bottom:1px solid #f0f0f6}\\n    nav a{margin:0 8px;color:#444;text-decoration:none}\\n    nav a.active{color:var(--accent);font-weight:700}\\n    .wrap{max-width:1100px;margin:34px auto;padding:0 20px}\\n    .hero{display:flex;gap:24px;align-items:center}\\n    .hero .copy{flex:1}\\n    h1{margin:0 0 8px;font-size:26px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}\\n    .tile{background:#fff;border-radius:12px;padding:18px;box-shadow:0 8px 26px rgba(18,20,40,0.04)}\\n    .quote{font-style:italic;color:#222}\\n    .meta{display:flex;align-items:center;gap:12px;margin-top:12px}\\n    .meta img{width:48px;height:48px;border-radius:10px}\\n    .lead-magnet{margin-top:28px;display:flex;justify-content:space-between;gap:14px}\\n    .faq{margin-top:26px}\\n    details summary{padding:12px;background:#fff;border-radius:10px;margin-bottom:8px;cursor:pointer}\\n    footer{padding:26px;text-align:center;color:var(--muted)}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <strong>{{BUSINESS_NAME}}</strong>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Who I Am</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"services.html\\\">Results</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"testimonials.html\\\" class=\\\"active\\\">Stories</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Reach Out</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"copy\\\">\\n        <h1>Real people. Gentle shifts. Lasting results.</h1>\\n        <p class=\\\"muted\\\">Read short stories from people who moved past overwhelm and built daily systems that support calmer, clearer lives.</p>\\n        <a href=\\\"book.html\\\" class=\\\"btn\\\" style=\\\"display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,#6b8eff,#ff8fa3);color:white;text-decoration:none;font-weight:700\\\">Start your story</a>\\n      </div>\\n      <div style=\\\"width:340px\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"gallery\\\" style=\\\"width:100%;border-radius:12px\\\">\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:26px\\\">\\n      <div class=\\\"grid\\\">\\n        <article class=\\\"tile\\\">\\n          <div class=\\\"quote\\\">\\\"I used to think habit change meant harsh rules. Instead, I learned small, humane experiments that actually stuck.\\\"</div>\\n          <div class=\\\"meta\\\"><img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\"><div><strong>Alex P.</strong><div class=\\\"muted\\\">Graphic designer — Habit Reset Program</div></div></div>\\n        </article>\\n\\n        <article class=\\\"tile\\\">\\n          <div class=\\\"quote\\\">\\\"The VIP day clarified my priorities and I left with a plan I could use immediately — no overwhelm.\\\"</div>\\n          <div class=\\\"meta\\\"><img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\"><div><strong>Priya K.</strong><div class=\\\"muted\\\">Founder — Signature Clarity Day</div></div></div>\\n        </article>\\n\\n        <article class=\\\"tile\\\">\\n          <div class=\\\"quote\\\">\\\"Three months felt doable. Coaching calls and tiny nudges helped me finish habits I'd been postponing for years.\\\"</div>\\n          <div class=\\\"meta\\\"><img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\"><div><strong>Marco L.</strong><div class=\\\"muted\\\">Teacher — Momentum Path</div></div></div>\\n        </article>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:26px\\\">\\n      <h3>Why people share their stories</h3>\\n      <p class=\\\"muted\\\">Stories focus on outcomes: clearer choices, kinder self-talk, and daily structures that fit real life. I center small experiments and celebrate slow progress.</p>\\n      <div style=\\\"display:flex;gap:12px;margin-top:14px\\\">\\n        <div style=\\\"flex:1;background:#fff;padding:14px;border-radius:12px;box-shadow:0 6px 20px rgba(18,20,40,0.04)\\\"><strong>Number of clients</strong><div class=\\\"muted\\\">250+ supported since program started</div></div>\\n        <div style=\\\"flex:1;background:#fff;padding:14px;border-radius:12px;box-shadow:0 6px 20px rgba(18,20,40,0.04)\\\"><strong>Average adherence</strong><div class=\\\"muted\\\">8/10 on weekly check-ins</div></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"lead-magnet\\\">\\n      <div style=\\\"flex:2;background:#fff;padding:18px;border-radius:12px;box-shadow:0 8px 28px rgba(10,10,30,0.04)\\\">\\n        <strong>Free Guide — The Three-Minute Habit Tracker</strong>\\n        <p class=\\\"muted\\\">A printable tracker and simple prompts to see immediate progress in one week.</p>\\n        <form style=\\\"display:flex;gap:8px\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" onsubmit=\\\"return false;\\\">\\n          <input placeholder=\\\"Email address\\\" style=\\\"flex:1;padding:10px;border-radius:10px;border:1px solid #eee\\\">\\n          <button style=\\\"padding:10px 12px;border-radius:10px;background:linear-gradient(90deg,#6b8eff,#ff8fa3);color:#fff;border:0;font-weight:700\\\">Send me the guide</button>\\n        </form>\\n      </div>\\n\\n      <div style=\\\"flex:1;display:flex;flex-direction:column;gap:12px\\\">\\n        <div style=\\\"background:linear-gradient(180deg,#fff,#f7f8ff);padding:14px;border-radius:12px;text-align:center\\\"><strong>10–12 min</strong><div class=\\\"muted\\\">Average read time</div></div>\\n        <div style=\\\"background:linear-gradient(180deg,#fff,#fff6f7);padding:14px;border-radius:12px;text-align:center\\\"><strong>100% private</strong><div class=\\\"muted\\\">No spam, ever</div></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3 style=\\\"margin-top:18px\\\">A few helpful answers</h3>\\n      <details>\\n        <summary>How are stories selected?</summary>\\n        <div style=\\\"padding:10px 12px;color:var(--muted)\\\">Stories are shared with client permission and focus on process and practices rather than medical outcomes.</div>\\n      </details>\\n      <details>\\n        <summary>Can I speak with a past client?</summary>\\n        <div style=\\\"padding:10px 12px;color:var(--muted)\\\">I can sometimes connect you with former clients for a brief conversation when agreed upon.</div>\\n      </details>\\n      <details>\\n        <summary>Do transformations require long programs?</summary>\\n        <div style=\\\"padding:10px 12px;color:var(--muted)\\\">No — some clients see meaningful shifts after a VIP day; others prefer gradual momentum over months.</div>\\n      </details>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px;text-align:center\\\">\\n      <a href=\\\"book.html\\\" style=\\\"padding:12px 18px;border-radius:12px;background:linear-gradient(90deg,#6b8eff,#ff8fa3);color:#fff;text-decoration:none;font-weight:700\\\">Reserve a conversation</a>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    <div style=\\\"margin-top:8px;color:var(--muted)\\\">Located in {{CITY}}, {{STATE}} — Gentle coaching for steady habit change</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}} Sessions</title>\\n  <style>\\n    :root{--bg:#fcfbff;--card:#fff;--muted:#6c6c80;--accent:#8b6bff;--radius:12px}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;background:var(--bg);margin:0;color:#111}\\n    header{display:flex;justify-content:space-between;padding:18px 28px}\\n    nav a{margin:0 8px;color:#444;text-decoration:none}\\n    nav a.active{color:var(--accent);font-weight:700}\\n    .wrap{max-width:980px;margin:28px auto;padding:0 20px}\\n    .hero{display:grid;grid-template-columns:1fr 300px;gap:20px;align-items:start}\\n    .panel{background:var(--card);padding:20px;border-radius:14px;box-shadow:0 14px 40px rgba(10,10,30,0.06)}\\n    label{display:block;font-weight:700;margin-bottom:6px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:10px;border:1px solid #eef}\\n    .muted{color:var(--muted)}\\n    .steps{display:flex;gap:12px;margin-top:12px}\\n    .step{background:linear-gradient(180deg,#fff,#fbfbff);padding:12px;border-radius:10px;flex:1}\\n    .faq{margin-top:18px}\\n    footer{padding:26px;text-align:center;color:var(--muted)}\\n    @media(max-width:900px){.hero{grid-template-columns:1fr}} \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <strong>{{BUSINESS_NAME}}</strong>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Meet</a>\\n      <a href=\\\"programs.html\\\">Work</a>\\n      <a href=\\\"services.html\\\">Options</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"testimonials.html\\\">Feedback</a>\\n      <a href=\\\"book.html\\\" class=\\\"active\\\">Get Started</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"panel\\\">\\n        <h1 style=\\\"margin:0 0 8px\\\">Reserve a Signature Clarity Day or a short program</h1>\\n        <p class=\\\"muted\\\">Choose an immersive VIP day for rapid clarity, or select a Starter/Momentum path. I’ll meet you where you are with practical, evidence-informed coaching.</p>\\n\\n        <div class=\\\"steps\\\">\\n          <div class=\\\"step\\\"><strong>1. Pick a format</strong><div class=\\\"muted\\\">VIP day, 6-week reset, or 3-month Momentum</div></div>\\n          <div class=\\\"step\\\"><strong>2. Intake</strong><div class=\\\"muted\\\">Pre-session questionnaire to set priorities</div></div>\\n          <div class=\\\"step\\\"><strong>3. Implementation</strong><div class=\\\"muted\\\">Actionable plan and follow-up </div></div>\\n        </div>\\n\\n        <div style=\\\"margin-top:16px\\\">\\n          <strong>Availability</strong>\\n          <p class=\\\"muted\\\">I offer a limited number of VIP days each month to ensure focused attention. Book early to secure your preferred date.</p>\\n        </div>\\n\\n      </div>\\n\\n      <aside style=\\\"display:flex;flex-direction:column;gap:12px\\\">\\n        <div class=\\\"panel\\\">\\n          <strong>Book now</strong>\\n          <form id=\\\"bookingForm\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" onsubmit=\\\"return handleSubmit(event)\\\" style=\\\"margin-top:10px;display:grid;gap:10px\\\">\\n            <label for=\\\"name\\\">Your name</label>\\n            <input id=\\\"name\\\" name=\\\"name\\\" required>\\n            <label for=\\\"email\\\">Email</label>\\n            <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required>\\n            <label for=\\\"type\\\">I am booking</label>\\n            <select id=\\\"type\\\" name=\\\"type\\\">\\n              <option>Signature Clarity Day (VIP)</option>\\n              <option>Starter Ritual — 3 weeks</option>\\n              <option>Momentum Path — 90 days</option>\\n              <option>Intro call (30 min)</option>\\n            </select>\\n            <label for=\\\"notes\\\">A few notes (optional)</label>\\n            <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"3\\\"></textarea>\\n            <button type=\\\"submit\\\" style=\\\"padding:10px;border-radius:10px;background:linear-gradient(90deg,#8b6bff,#ff8fa3);color:white;border:0;font-weight:700\\\">Request time</button>\\n          </form>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"text-align:center\\\">\\n          <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"coach\\\" style=\\\"width:84px;height:84px;border-radius:12px;margin-bottom:10px\\\">\\n          <div><strong>{{COACH_NAME}}, {{CREDENTIALS}}</strong></div>\\n          <div class=\\\"muted\\\">Based in {{CITY}}, {{STATE}} — Gentle, results-oriented coaching</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px;display:grid;grid-template-columns:1fr 300px;gap:20px;align-items:start\\\">\\n      <div>\\n        <h3>What to expect from a VIP day</h3>\\n        <p class=\\\"muted\\\">An intentional, focused day that yields a clear playbook — routines, priorities, and a practical first-week plan. You’ll come away with the kind of structure that removes decision fatigue.</p>\\n\\n        <div style=\\\"display:flex;gap:10px;margin-top:12px\\\">\\n          <div style=\\\"flex:1;background:#fff;padding:12px;border-radius:10px;box-shadow:0 8px 24px rgba(10,10,30,0.04)\\\"><strong>Pre-Work</strong><div class=\\\"muted\\\">Questionnaire & brief call</div></div>\\n          <div style=\\\"flex:1;background:#fff;padding:12px;border-radius:10px;box-shadow:0 8px 24px rgba(10,10,30,0.04)\\\"><strong>The Day</strong><div class=\\\"muted\\\">Deep mapping, decisions, and hands-on templates</div></div>\\n          <div style=\\\"flex:1;background:#fff;padding:12px;border-radius:10px;box-shadow:0 8px 24px rgba(10,10,30,0.04)\\\"><strong>Follow-up</strong><div class=\\\"muted\\\">Summarized plan + a 30m check-in</div></div>\\n        </div>\\n\\n        <section style=\\\"margin-top:18px\\\">\\n          <h4>Frequently asked</h4>\\n          <div class=\\\"faq\\\">\\n            <details>\\n              <summary>How long is the VIP day?</summary>\\n              <div style=\\\"padding:10px 12px;color:var(--muted)\\\">Typically 5–6 hours, scheduled around your energy and commitments.</div>\\n            </details>\\n            <details>\\n              <summary>Is there payment support?</summary>\\n              <div style=\\\"padding:10px 12px;color:var(--muted)\\\">Yes — payment plans are available for multi-session packages. Please ask during booking.</div>\\n            </details>\\n            <details>\\n              <summary>Do you work with medical conditions?</summary>\\n              <div style=\\\"padding:10px 12px;color:var(--muted)\\\">I focus on habits and wellbeing frameworks, not medical treatment. If you have medical concerns, please consult a licensed professional.</div>\\n            </details>\\n          </div>\\n        </section>\\n      </div>\\n\\n      <aside style=\\\"background:linear-gradient(180deg,#fff,#fbfbff);padding:18px;border-radius:12px;box-shadow:0 8px 26px rgba(10,10,30,0.04)\\\">\\n        <strong>Need help choosing?</strong>\\n        <p class=\\\"muted\\\">If you'd like a short chat to figure out the right fit, choose \\\"Intro call (30 min)\\\" above — it's the easiest way to get tailored guidance.</p>\\n        <div style=\\\"margin-top:10px;text-align:center\\\"><a href=\\\"contact.html\\\" style=\\\"padding:10px 12px;border-radius:10px;background:var(--accent);color:white;text-decoration:none;font-weight:700\\\">Request a quick call</a></div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px;background:var(--card);padding:16px;border-radius:12px;box-shadow:0 8px 26px rgba(10,10,30,0.04)\\\">\\n      <strong>Lead Magnet — Quick Start Guide</strong>\\n      <p class=\\\"muted\\\">Grab the 7-step Quick Start Guide to begin reshaping one habit in seven days. Instant download after you request time.</p>\\n      <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" onsubmit=\\\"return false\\\" style=\\\"display:flex;gap:8px;margin-top:10px\\\">\\n        <input placeholder=\\\"Email address\\\" style=\\\"flex:1;padding:10px;border-radius:10px;border:1px solid #eef\\\">\\n        <button style=\\\"padding:10px 12px;border-radius:10px;background:linear-gradient(90deg,#8b6bff,#ff8fa3);color:white;border:0;font-weight:700\\\">Send the guide</button>\\n      </form>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    <div style=\\\"margin-top:8px;color:var(--muted)\\\">Privacy respected — your details stay between us.</div>\\n  </footer>\\n\\n  <script>\\n    function handleSubmit(e){\\n      e.preventDefault();\\n      var form=document.getElementById('bookingForm');\\n      // simple confirmation flow (no backend)\\n      alert('Thanks — your request has been noted. You will receive a follow-up at the email provided.');\\n      form.reset();\\n      return false;\\n    }\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
