          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Membership Pricing</title>\\n  <style>\\n    :root{--bg:#fff;--muted:#6b7280;--accent:#0f1724;--card:#f8fafc;--glass:rgba(15,23,36,0.04);--radius:12px}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:var(--accent);background:var(--bg);-webkit-font-smoothing:antialiased}\\n    .site{max-width:900px;margin:56px auto;padding:32px}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:40px}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 12px;font-size:15px}\\n    .brand{font-weight:700;letter-spacing:0.2px}\\n    .hero{display:flex;gap:28px;align-items:center}\\n    .hero .copy{flex:1}\\n    h1{margin:0;font-size:28px}\\n    p.lead{color:var(--muted);margin-top:10px}\\n    .visual{width:160px;height:120px;border-radius:10px;background:var(--glass);display:flex;align-items:center;justify-content:center}\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:28px}\\n    .card{background:var(--card);padding:20px;border-radius:12px;box-shadow:0 6px 18px rgba(10,12,15,0.04)}\\n    .price{font-weight:700;font-size:20px;margin-top:8px}\\n    ul.features{color:var(--muted);margin:12px 0 18px 0;padding-left:18px}\\n    .cta{display:inline-block;background:#061028;color:#fff;padding:10px 16px;border-radius:10px;text-decoration:none}\\n    .note{font-size:13px;color:var(--muted);margin-top:10px}\\n    footer{margin-top:40px;color:var(--muted);font-size:14px}\\n    @media(max-width:820px){.tiers{grid-template-columns:1fr}.hero{flex-direction:column;align-items:flex-start}.visual{width:100%;height:120px;border-radius:10px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <header>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"pricing.html\\\">Membership</a>\\n        <a href=\\\"testimonials.html\\\">Stories</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\" aria-label=\\\"Pricing overview\\\">\\n      <div class=\\\"copy\\\">\\n        <h1>Subscription tiers designed around sustainable change</h1>\\n        <p class=\\\"lead\\\">A membership model that privileges practice, measurement, and simple habits. Choose the rhythm that fits your life and commit to repeatable progress — not quick fixes.</p>\\n        <div style=\\\"margin-top:18px\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <span class=\\\"note\\\"> &nbsp;• Flexible billing • Cancel anytime</span>\\n        </div>\\n      </div>\\n      <div class=\\\"visual\\\" role=\\\"img\\\" aria-hidden=\\\"true\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"abstract growth\\\" style=\\\"width:120px;height:90px\\\"/>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"tiers\\\" aria-label=\\\"Membership tiers\\\">\\n      <div class=\\\"card\\\">\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Foundations (Monthly)</div>\\n        <div class=\\\"price\\\">$29 / month</div>\\n        <ul class=\\\"features\\\">\\n          <li>Weekly habit checklist</li>\\n          <li>Monthly group coaching Q&amp;A</li>\\n          <li>Guided micro-practices</li>\\n        </ul>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}?tier=foundations\\\">Join Foundations</a>\\n        <div class=\\\"note\\\">Perfect for building consistent routines.</div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Momentum (Quarterly)</div>\\n        <div class=\\\"price\\\">$75 / 3 months <span style=\\\"font-weight:400;font-size:13px;color:var(--muted)\\\">($25/mo)</span></div>\\n        <ul class=\\\"features\\\">\\n          <li>Everything in Foundations</li>\\n          <li>Fortnightly group labs</li>\\n          <li>Progress dashboard &amp; checkpoints</li>\\n        </ul>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}?tier=momentum\\\">Start Momentum</a>\\n        <div class=\\\"note\\\">Best for noticeable habit consolidation.</div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Mastery (Annual)</div>\\n        <div class=\\\"price\\\">$240 / year <span style=\\\"font-weight:400;font-size:13px;color:var(--muted)\\\">($20/mo)</span></div>\\n        <ul class=\\\"features\\\">\\n          <li>Priority coaching review</li>\\n          <li>Monthly 1:1 strategy session</li>\\n          <li>Custom frameworks &amp; templates</li>\\n        </ul>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}?tier=mastery\\\">Enroll in Mastery</a>\\n        <div class=\\\"note\\\">Designed for sustained transformation and accountability.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:32px\\\">\\n      <h2 style=\\\"margin:0;font-size:16px\\\">What membership actually provides</h2>\\n      <p class=\\\"lead\\\">We measure behavior, not promises. Members receive a repeatable framework — assess, plan, practice — and tools to track micro-wins every week. No medical advice; results center on habits, energy management, and resilience practices.</p>\\n\\n      <dl style=\\\"display:flex;gap:24px;margin-top:18px;flex-wrap:wrap\\\">\\n        <div style=\\\"min-width:220px\\\"><strong>Frameworks</strong><div class=\\\"note\\\">Simple decision trees for daily choices.</div></div>\\n        <div style=\\\"min-width:220px\\\"><strong>Measurement</strong><div class=\\\"note\\\">Behavior logs and short reflections.</div></div>\\n        <div style=\\\"min-width:220px\\\"><strong>Community</strong><div class=\\\"note\\\">Live labs and member discussions.</div></div>\\n      </dl>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px;background:var(--glass);padding:18px;border-radius:10px\\\">\\n      <strong>Lead magnet</strong>\\n      <p class=\\\"note\\\" style=\\\"margin:8px 0 0\\\">Grab the 7-day Habit Starter kit when you join — a concise playbook with repeatable micro-practices to kickstart progress.</p>\\n    </section>\\n\\n    <footer>\\n      <div>Questions? Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div style=\\\"margin-top:8px\\\">© {{COACH_NAME}} {{CREDENTIALS}} — {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Stories — Real Outcomes | {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--muted:#6b7280;--accent:#09121a;--soft:#f6f8fa}\\n    body{margin:0;font-family:system-ui,Segoe UI,Roboto,Arial;background:var(--bg);color:var(--accent)}\\n    .wrap{max-width:920px;margin:48px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:14px}\\n    h1{margin:0;font-size:26px}\\n    .lead{color:var(--muted);margin-top:8px}\\n    .grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:22px}\\n    .case{background:var(--soft);padding:18px;border-radius:12px}\\n    .quote{font-style:italic;color:#0f1724}\\n    .meta{display:flex;align-items:center;gap:12px;margin-top:14px}\\n    .avatar{width:52px;height:52px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center}\\n    .cta{display:inline-block;margin-top:14px;padding:10px 14px;background:#081127;color:#fff;border-radius:10px;text-decoration:none}\\n    @media(max-width:820px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">The Coach</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"testimonials.html\\\">Stories</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n      </nav>\\n    </header>\\n\\n    <section aria-label=\\\"Client stories\\\">\\n      <h1>Case studies and member reports</h1>\\n      <p class=\\\"lead\\\">Short, evidence-minded narratives: how small changes in routine led to measurable improvements in energy, focus, and daily coherence. No absolutes — just repeatable habits and documented outcomes.</p>\\n    </section>\\n\\n    <section class=\\\"grid\\\" aria-live=\\\"polite\\\">\\n      <article class=\\\"case\\\">\\n        <div class=\\\"quote\\\">“The 6-week shaping framework helped me turn two tiny practices into a morning ritual. My workflow became steadier and I avoided afternoon crashes.”</div>\\n        <div class=\\\"meta\\\">\\n          <div class=\\\"avatar\\\"><img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\" width=\\\"36\\\" height=\\\"36\\\"></div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">A.N.</div>\\n            <div style=\\\"color:var(--muted);font-size:13px\\\">Marketing lead — monthly member</div>\\n          </div>\\n        </div>\\n      </article>\\n\\n      <article class=\\\"case\\\">\\n        <div class=\\\"quote\\\">“Tracking three simple inputs each day made coaching concrete. After 10 weeks I had a data pattern I could act on. We adjusted only what the data suggested.\\\"</div>\\n        <div class=\\\"meta\\\">\\n          <div class=\\\"avatar\\\"><img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\" width=\\\"36\\\" height=\\\"36\\\"></div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">R.S.</div>\\n            <div style=\\\"color:var(--muted);font-size:13px\\\">Teacher — annual member</div>\\n          </div>\\n        </div>\\n      </article>\\n\\n      <article class=\\\"case\\\">\\n        <div class=\\\"quote\\\">“This wasn’t about motivation. It was about tiny experiments that stacked into reliable habits. The templates alone were worth joining.”</div>\\n        <div class=\\\"meta\\\">\\n          <div class=\\\"avatar\\\"><img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\" width=\\\"36\\\" height=\\\"36\\\"></div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">M.T.</div>\\n            <div style=\\\"color:var(--muted);font-size:13px\\\">Entrepreneur — quarterly plan</div>\\n          </div>\\n        </div>\\n      </article>\\n\\n      <article class=\\\"case\\\">\\n        <div class=\\\"quote\\\">“The coach’s approach felt scientific: hypothesis, micro-test, measure. Small wins became predictable, and that consistency mattered more than big leaps.”</div>\\n        <div class=\\\"meta\\\">\\n          <div class=\\\"avatar\\\"><img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\" width=\\\"36\\\" height=\\\"36\\\"></div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">L.K.</div>\\n            <div style=\\\"color:var(--muted);font-size:13px\\\">Engineer — foundations</div>\\n          </div>\\n        </div>\\n      </article>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2 style=\\\"margin:0\\\">Selected summaries</h2>\\n      <p class=\\\"lead\\\">Each case study pairs an initial behavior log with an intervention and a 6- to 12-week follow-up. If you’d like a sample report, request a concise anonymized summary.</p>\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}?request=case-study\\\">Request a sample report</a>\\n    </section>\\n\\n    <section style=\\\"margin-top:26px\\\">\\n      <h3 style=\\\"margin:0\\\">Frequently asked (short answers)</h3>\\n      <div style=\\\"margin-top:12px;color:var(--muted)\\\">\\n        <strong>How quickly will I see change?</strong>\\n        <div style=\\\"margin-top:6px\\\">Look for pattern shifts within 4–8 weeks when practices are consistent; the goal is stability, not speed.</div>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:30px;color:var(--muted)\\\">\\n      <div>Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n      <div style=\\\"margin-top:6px\\\">© {{COACH_NAME}} {{CREDENTIALS}} — {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Reserve a Session — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--muted:#6b7280;--accent:#061024;--glass:rgba(6,16,36,0.04);--radius:12px}\\n    body{margin:0;font-family:system-ui,system-ui,-apple-system,Segoe UI,Roboto,Arial;color:var(--accent);background:var(--bg)}\\n    .container{max-width:760px;margin:48px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:12px}\\n    h1{font-size:24px;margin:6px 0}\\n    .lead{color:var(--muted);margin-bottom:18px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px}\\n    .panel{background:var(--glass);padding:18px;border-radius:12px}\\n    label{display:block;margin-top:12px;font-size:13px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6eef5;margin-top:6px}\\n    .submit{display:inline-block;margin-top:14px;padding:10px 14px;background:#07122a;color:#fff;border-radius:10px;text-decoration:none}\\n    .philosophy{background:#fff;padding:18px;border-radius:12px;border:1px solid #eef2f6}\\n    .faq{margin-top:18px;color:var(--muted)}\\n    @media(max-width:860px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">Who I Am</a>\\n        <a href=\\\"programs.html\\\">Work With Me</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <main style=\\\"margin-top:18px\\\">\\n      <h1>Book a discovery session</h1>\\n      <p class=\\\"lead\\\">A 20-minute, evidence-oriented conversation to get clear on goals, constraints, and the smallest meaningful next steps. No pressure — this is a focused planning call.</p>\\n\\n      <div class=\\\"grid\\\">\\n        <div>\\n          <div class=\\\"panel\\\">\\n            <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"GET\\\" aria-label=\\\"Booking form\\\">\\n              <label for=\\\"name\\\">Your name</label>\\n              <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"First &amp; last\\\" required>\\n\\n              <label for=\\\"email\\\">Email</label>\\n              <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n\\n              <label for=\\\"goal\\\">Primary goal</label>\\n              <select id=\\\"goal\\\" name=\\\"goal\\\">\\n                <option>Improve daily routine</option>\\n                <option>Increase focus &amp; energy</option>\\n                <option>Build consistent habits</option>\\n                <option>Other / exploratory</option>\\n              </select>\\n\\n              <label for=\\\"notes\\\">Brief context (optional)</label>\\n              <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"What have you tried? What matters most?\\\"></textarea>\\n\\n              <input type=\\\"hidden\\\" name=\\\"source\\\" value=\\\"discovery\\\">\\n              <button class=\\\"submit\\\" type=\\\"submit\\\">Reserve discovery session</button>\\n            </form>\\n          </div>\\n\\n          <section class=\\\"faq\\\">\\n            <h3 style=\\\"margin:10px 0\\\">Quick FAQs</h3>\\n            <div><strong>Do you offer ongoing coaching?</strong>\\n              <div style=\\\"margin-top:6px\\\">Yes — membership tiers focus on habit formation and accountability. Discovery calls are free and low-commitment.</div>\\n            </div>\\n            <div style=\\\"margin-top:8px\\\"><strong>What should I prepare?</strong>\\n              <div style=\\\"margin-top:6px\\\">Bring a recent week of routines and one or two outcomes you want to measure. That makes the session efficient.</div>\\n            </div>\\n          </section>\\n        </div>\\n\\n        <aside class=\\\"philosophy\\\">\\n          <h3 style=\\\"margin-top:0\\\">The coaching approach</h3>\\n          <p class=\\\"lead\\\">I use a reproducible three-step cycle: Observe (collect simple metrics), Hypothesize (small targeted changes), Test (2-week micro-experiments). The aim is predictability and compact interventions. No medical claims; just structured behavioral practice.</p>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <strong>Lead magnet</strong>\\n            <p class=\\\"note\\\" style=\\\"margin:6px 0;color:var(--muted)\\\">Book now and receive the \\\"5 Minimal Practices\\\" PDF — a practical starting pack to apply before our conversation.</p>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <strong>Location</strong>\\n            <p class=\\\"note\\\" style=\\\"margin:6px 0;color:var(--muted)\\\">{{CITY}}, {{STATE}} (remote sessions available)</p>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"decorative pattern\\\" style=\\\"width:100%;height:auto;border-radius:8px\\\">\\n          </div>\\n        </aside>\\n      </div>\\n\\n    </main>\\n\\n    <footer style=\\\"margin-top:26px;color:var(--muted)\\\">\\n      <div>Need help? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}}</div>\\n      <div style=\\\"margin-top:8px\\\">© {{COACH_NAME}} {{CREDENTIALS}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"assets/img/hero.svg\",\"content\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 240 160\\\" preserveAspectRatio=\\\"xMidYMid meet\\\">\\n  <defs>\\n    <linearGradient id=\\\"g\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n      <stop offset=\\\"0\\\" stop-color=\\\"#dbeafe\\\"/>\\n      <stop offset=\\\"1\\\" stop-color=\\\"#f0fdf4\\\"/>\\n    </linearGradient>\\n  </defs>\\n  <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g)\\\" rx=\\\"12\\\"/>\\n  <g transform=\\\"translate(20,20)\\\">\\n    <rect x=\\\"0\\\" y=\\\"40\\\" width=\\\"52\\\" height=\\\"12\\\" fill=\\\"#e6f0ff\\\" rx=\\\"6\\\" />\\n    <rect x=\\\"0\\\" y=\\\"20\\\" width=\\\"84\\\" height=\\\"12\\\" fill=\\\"#cfe8ff\\\" rx=\\\"6\\\" />\\n    <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"120\\\" height=\\\"12\\\" fill=\\\"#b7ddff\\\" rx=\\\"6\\\" />\\n    <circle cx=\\\"160\\\" cy=\\\"60\\\" r=\\\"34\\\" fill=\\\"#fff\\\" opacity=\\\"0.9\\\"/>\\n    <path d=\\\"M144 46c8 10 20 10 28 0\\\" stroke=\\\"#9cc5ff\\\" stroke-width=\\\"6\\\" stroke-linecap=\\\"round\\\" fill=\\\"none\\\"/>\\n    <g transform=\\\"translate(120,12)\\\">\\n      <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"36\\\" height=\\\"36\\\" rx=\\\"6\\\" fill=\\\"#f8fafc\\\"/>\\n      <path d=\\\"M6 20h24M6 12h16\\\" stroke=\\\"#9fbbe6\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\"/>\\n    </g>\\n  </g>\\n</svg>\"} \n{\"path\":\"assets/img/avatar.svg\",\"content\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 64 64\\\" width=\\\"64\\\" height=\\\"64\\\">\\n  <rect width=\\\"100%\\\" height=\\\"100%\\\" rx=\\\"12\\\" fill=\\\"#eef6fb\\\"/>\\n  <g transform=\\\"translate(12,10)\\\">\\n    <circle cx=\\\"20\\\" cy=\\\"12\\\" r=\\\"10\\\" fill=\\\"#fff\\\" stroke=\\\"#cfe8ff\\\" stroke-width=\\\"2\\\"/>\\n    <path d=\\\"M4 38c4-6 12-8 16-8s12 2 16 8\\\" fill=\\\"#fff\\\" stroke=\\\"#dbeefe\\\" stroke-width=\\\"2\\\"/>\\n  </g>\\n</svg>\"} \n{\"path\":\"assets/img/pattern.svg\",\"content\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 300 160\\\">\\n  <defs>\\n    <pattern id=\\\"p\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n      <circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"3\\\" fill=\\\"#e8f7ef\\\"/>\\n      <circle cx=\\\"28\\\" cy=\\\"28\\\" r=\\\"3\\\" fill=\\\"#eef6fb\\\"/>\\n    </pattern>\\n  </defs>\\n  <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p)\\\"/>\\n  <g fill=\\\"#e6f6ff\\\" opacity=\\\"0.6\\\">\\n    <ellipse cx=\\\"60\\\" cy=\\\"40\\\" rx=\\\"48\\\" ry=\\\"28\\\"/>\\n    <ellipse cx=\\\"220\\\" cy=\\\"120\\\" rx=\\\"68\\\" ry=\\\"36\\\"/>\\n  </g>\\n</svg>\"} \nBUNDLE_END"
