          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Evidence-centered wellness coaching with {{COACH_NAME}}. Practical frameworks, measurable habits, and calm momentum.\\\">\\n  <style>\\n    :root{--bg:#fafafa;--muted:#667085;--accent:#0b7285;--card:#fff;--radius:12px;--max:960px}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#0f1724;background:var(--bg)}\\n    .wrap{max-width:var(--max);margin:48px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:52px;height:52px;border-radius:10px;background:linear-gradient(135deg,#f8fafc,#e6fffa);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent)}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:15px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;margin-bottom:36px}\\n    .hero h1{margin:0;font-size:28px;color:#031124}\\n    .lead{color:var(--muted);line-height:1.5;margin-top:10px}\\n    .card{background:var(--card);padding:20px;border-radius:var(--radius);box-shadow:0 4px 18px rgba(10,15,25,0.04)}\\n    .meta{font-size:13px;color:var(--muted);margin-top:12px}\\n    .btn{display:inline-block;padding:10px 14px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none;font-weight:600}\\n    section{margin-bottom:28px}\\n    h2{font-size:18px;margin:0 0 12px 0;color:#03212a}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}\\n    .pill{background:#fff;padding:16px;border-radius:12px;border:1px solid rgba(2,6,23,0.04)}\\n    .small{font-size:13px;color:var(--muted)}\\n    .case{display:flex;gap:12px;align-items:flex-start}\\n    .avatar{width:64px;height:64px;border-radius:10px;background:linear-gradient(135deg,#fff4e6,#fff);display:flex;align-items:center;justify-content:center}\\n    footer{padding:24px 0;color:var(--muted);font-size:14px;text-align:center}\\n    /* minimal responsive */\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}.avatar{width:56px;height:56px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">WC</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <!-- HERO: thoughtful, evidence-first intro -->\\n    <main class=\\\"hero\\\">\\n      <div>\\n        <h1>Small, measurable changes. Lasting improvements.</h1>\\n        <p class=\\\"lead\\\">I combine behavioral frameworks with simple habit design so you make steady progress toward the kinds of wellbeing that matter to you — energy, focus, sleep quality, and sustainable routines. No panic, no extremes — just experiments that accumulate.</p>\\n        <div style=\\\"margin-top:16px\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <span class=\\\"meta\\\">or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{PHONE}}</a></span>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <!-- inline avatar svg unique to this page -->\\n        <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n          <div class=\\\"avatar\\\" aria-hidden=\\\"true\\\">\\n            <svg width=\\\"48\\\" height=\\\"48\\\" viewBox=\\\"0 0 48 48\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n              <rect rx=\\\"8\\\" width=\\\"48\\\" height=\\\"48\\\" fill=\\\"#e6fffa\\\"/>\\n              <g transform=\\\"translate(8 7)\\\" fill=\\\"none\\\" stroke=\\\"#0b7285\\\" stroke-width=\\\"1.8\\\">\\n                <circle cx=\\\"16\\\" cy=\\\"7\\\" r=\\\"6\\\" fill=\\\"#fff\\\"/>\\n                <path d=\\\"M0 30c4-8 24-8 32 0\\\" stroke-linecap=\\\"round\\\"/>\\n              </g>\\n            </svg>\\n          </div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">{{COACH_NAME}}</div>\\n            <div class=\\\"small\\\">{{CREDENTIALS}} • {{CITY}}, {{STATE}}</div>\\n            <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Evidence-focused coaching: frameworks you can test and track.</div>\\n          </div>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <!-- PILLARS: core methods, called \\\"Frameworks\\\" here -->\\n    <section>\\n      <h2>The frameworks I rely on</h2>\\n      <p class=\\\"small\\\">Three interlocking approaches you’ll notice in every plan: measurement, micro-habits, and context design.</p>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"pill\\\">\\n          <strong>Measure & Iterate</strong>\\n          <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Set one clear metric, test two small changes for two weeks, review outcomes.</div>\\n        </div>\\n        <div class=\\\"pill\\\">\\n          <strong>Micro-habit Engineering</strong>\\n          <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Break goals into <em>tiny</em> actions that build reliability without friction.</div>\\n        </div>\\n        <div class=\\\"pill\\\">\\n          <strong>Context Sculpting</strong>\\n          <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Shape the environment so better choices are effortless.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- MYTH VS TRUTH: brief analytic debunking -->\\n    <section>\\n      <h2>Common beliefs, re-evaluated</h2>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px\\\">\\n        <div class=\\\"card\\\" style=\\\"padding:14px\\\">\\n          <strong>Myth</strong>\\n          <p class=\\\"small\\\" style=\\\"margin-top:6px\\\">You must overhaul everything to see results.</p>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"padding:14px\\\">\\n          <strong>Truth</strong>\\n          <p class=\\\"small\\\" style=\\\"margin-top:6px\\\">Small, consistent experiments yield compounding gains — and they’re easier to sustain.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- CASE STUDIES: concise, results-focused -->\\n    <section>\\n      <h2>Concise case notes</h2>\\n      <div style=\\\"display:grid;grid-template-columns:1fr;gap:12px;margin-top:12px\\\">\\n        <div class=\\\"card case\\\">\\n          <div style=\\\"flex:0 0 64px\\\">\\n            <svg width=\\\"64\\\" height=\\\"64\\\" viewBox=\\\"0 0 64 64\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n              <rect rx=\\\"10\\\" width=\\\"64\\\" height=\\\"64\\\" fill=\\\"#fff\\\" stroke=\\\"#e6f6f7\\\"/>\\n              <path d=\\\"M16 36c4-6 24-6 32 0\\\" stroke=\\\"#0b7285\\\" stroke-width=\\\"2\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/>\\n            </svg>\\n          </div>\\n          <div>\\n            <strong>Executive, age 38 — regained morning focus</strong>\\n            <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Targeted sleep-window adjustment + two micro-routines increased morning focus by measurable 25% within 4 weeks (self-reported metric).</div>\\n          </div>\\n        </div>\\n        <div class=\\\"card case\\\">\\n          <div style=\\\"flex:0 0 64px\\\">\\n            <svg width=\\\"64\\\" height=\\\"64\\\" viewBox=\\\"0 0 64 64\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n              <rect rx=\\\"10\\\" width=\\\"64\\\" height=\\\"64\\\" fill=\\\"#fff\\\" stroke=\\\"#f0fdf4\\\"/>\\n              <circle cx=\\\"32\\\" cy=\\\"24\\\" r=\\\"10\\\" stroke=\\\"#059669\\\" stroke-width=\\\"2\\\" fill=\\\"none\\\"/>\\n            </svg>\\n          </div>\\n          <div>\\n            <strong>Parent, age 42 — consistent short workouts</strong>\\n            <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Habit stacking and 7-minute volume led to 12 consistent sessions in one month, sustainable without schedule conflict.</div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- FAQ: distinctive Qs -->\\n    <section>\\n      <h2>Questions people ask first</h2>\\n      <div style=\\\"display:grid;gap:10px;margin-top:12px\\\">\\n        <details class=\\\"card\\\" style=\\\"padding:12px\\\"><summary style=\\\"font-weight:700\\\">How do you measure progress?</summary><div class=\\\"small\\\" style=\\\"margin-top:8px\\\">We pick 1–2 simple indicators (sleep hours, mood rating, focused work blocks) and track them weekly. Adjustments follow the data.</div></details>\\n        <details class=\\\"card\\\" style=\\\"padding:12px\\\"><summary style=\\\"font-weight:700\\\">How long before I notice change?</summary><div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Small behaviour experiments typically show effects within 2–6 weeks. The goal is reliable, repeatable improvements.</div></details>\\n      </div>\\n    </section>\\n\\n    <!-- CTA: measured invitation -->\\n    <section class=\\\"card\\\" style=\\\"text-align:center;padding:20px\\\">\\n      <h2 style=\\\"margin:0 0 8px 0\\\">Ready for an experiment that moves the needle?</h2>\\n      <p class=\\\"small\\\" style=\\\"margin-bottom:12px\\\">Start with a complimentary 20-minute clarity call. We’ll define one metric and a micro-action you can try this week.</p>\\n      <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Offerings — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Coaching services and practical habit design from {{COACH_NAME}}.\\\">\\n  <style>\\n    :root{--bg:#fff;--muted:#586273;--accent:#006f6f;--card:#fbffff;--radius:14px;--max:980px}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:var(--bg);color:#051427}\\n    .wrap{max-width:var(--max);margin:40px auto;padding:26px}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:26px}\\n    .logo{font-weight:800;color:var(--accent)}\\n    nav a{color:var(--muted);margin-left:16px;text-decoration:none}\\n    .hero{padding:28px;border-radius:16px;background:linear-gradient(180deg,#f8fdfd,#ffffff);display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}\\n    .hero h1{margin:0;font-size:24px}\\n    .lead{color:var(--muted)}\\n    .services{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-bottom:20px}\\n    .service{background:var(--card);padding:18px;border-radius:12px;border:1px solid rgba(2,6,23,0.04)}\\n    .service h3{margin:0 0 8px 0}\\n    .footnote{font-size:13px;color:var(--muted)}\\n    .cta{display:flex;gap:10px;align-items:center}\\n    .btn{padding:10px 14px;background:var(--accent);color:white;border-radius:10px;text-decoration:none;font-weight:600}\\n    .faq{margin-top:10px}\\n    .pattern{opacity:0.06;position:absolute;right:24px;top:24px}\\n    @media (max-width:820px){.services{grid-template-columns:1fr}.hero{flex-direction:column;align-items:flex-start}.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"book.html\\\">Book a Session</a>\\n      </nav>\\n    </header>\\n\\n    <!-- HERO: precise intro to services -->\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Structured support for daily habits</h1>\\n        <p class=\\\"lead\\\">I offer time-limited engagements and ongoing support designed to change the inputs that most reliably influence wellbeing.</p>\\n        <div style=\\\"margin-top:12px\\\" class=\\\"footnote\\\">Small experiments, clear measurements, weekly reflections.</div>\\n      </div>\\n      <div class=\\\"cta\\\">\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent)\\\">{{EMAIL}}</a></div>\\n      </div>\\n      <!-- inline pattern svg unique -->\\n      <svg class=\\\"pattern\\\" width=\\\"160\\\" height=\\\"160\\\" viewBox=\\\"0 0 160 160\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n        <defs>\\n          <pattern id=\\\"p1\\\" width=\\\"20\\\" height=\\\"20\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n            <rect width=\\\"10\\\" height=\\\"10\\\" fill=\\\"#e6fffb\\\"/>\\n          </pattern>\\n        </defs>\\n        <rect width=\\\"160\\\" height=\\\"160\\\" fill=\\\"url(#p1)\\\" rx=\\\"18\\\"/>\\n      </svg>\\n    </section>\\n\\n    <!-- CASE STUDIES first here to foreground outcomes -->\\n    <section>\\n      <h2 style=\\\"font-size:17px;margin-bottom:8px\\\">Outcomes you can expect</h2>\\n      <div style=\\\"display:grid;gap:12px\\\">\\n        <div class=\\\"service\\\">\\n          <strong>Short-term reset (4 weeks)</strong>\\n          <div class=\\\"footnote\\\" style=\\\"margin-top:8px\\\">Pick one habit; we run two micro-experiments and select the more scalable change. Ideal if you want targeted momentum.</div>\\n        </div>\\n        <div class=\\\"service\\\">\\n          <strong>Routine architecture (12 weeks)</strong>\\n          <div class=\\\"footnote\\\" style=\\\"margin-top:8px\\\">Build a 3-component morning or evening routine with environment-adjusted cues and monitoring systems.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- PILLARS: service components -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"font-size:17px\\\">What each engagement includes</h2>\\n      <div class=\\\"services\\\" style=\\\"margin-top:10px\\\">\\n        <div class=\\\"service\\\">\\n          <h3>Assessment</h3>\\n          <div class=\\\"footnote\\\">Baseline measures, time-use maps, and a hypothesis that directs the first experiment.</div>\\n        </div>\\n        <div class=\\\"service\\\">\\n          <h3>Micro-experiments</h3>\\n          <div class=\\\"footnote\\\">Short tests with predefined success criteria and lightweight logging.</div>\\n        </div>\\n        <div class=\\\"service\\\">\\n          <h3>Design & Environment</h3>\\n          <div class=\\\"footnote\\\">Concrete adjustments to your context so decisions require less willpower.</div>\\n        </div>\\n        <div class=\\\"service\\\">\\n          <h3>Ongoing calibration</h3>\\n          <div class=\\\"footnote\\\">Weekly checkpoints, data review, and plan tweaks to preserve gains.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- MYTH VS TRUTH: in services, framed as expectations -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"font-size:17px\\\">What to expect vs. what you might fear</h2>\\n      <div style=\\\"display:flex;gap:12px;margin-top:10px;flex-wrap:wrap\\\">\\n        <div class=\\\"service\\\" style=\\\"flex:1\\\">\\n          <strong>Expectation</strong>\\n          <div class=\\\"footnote\\\" style=\\\"margin-top:8px\\\">Small, measurable change in your chosen focus area within a month.</div>\\n        </div>\\n        <div class=\\\"service\\\" style=\\\"flex:1\\\">\\n          <strong>Fear</strong>\\n          <div class=\\\"footnote\\\" style=\\\"margin-top:8px\\\">That you’ll be asked to radically change your life. You won’t — we prioritize feasibility.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- FAQ: service-centered questions (distinct) -->\\n    <section class=\\\"faq\\\" style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"font-size:17px\\\">Service details you may wonder about</h2>\\n      <div style=\\\"display:grid;gap:8px;margin-top:8px\\\">\\n        <details class=\\\"service\\\" style=\\\"padding:12px\\\"><summary style=\\\"font-weight:700\\\">Do you offer corporate or team consultations?</summary><div class=\\\"footnote\\\" style=\\\"margin-top:8px\\\">Yes — custom brief engagements focus on group habits and shared rituals. Contact for a tailored scope and estimate.</div></details>\\n        <details class=\\\"service\\\" style=\\\"padding:12px\\\"><summary style=\\\"font-weight:700\\\">How do sessions work?</summary><div class=\\\"footnote\\\" style=\\\"margin-top:8px\\\">Sessions are 45 minutes, remote, and oriented to set clear experiments and review data together.</div></details>\\n      </div>\\n    </section>\\n\\n    <!-- CTA: succinct prompt -->\\n    <section style=\\\"margin-top:18px;padding:18px;border-radius:12px;background:#f7fffe;border:1px solid rgba(3,115,115,0.06)\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap\\\">\\n        <div>\\n          <strong style=\\\"display:block\\\">Interested in a short reset?</strong>\\n          <div class=\\\"footnote\\\" style=\\\"margin-top:6px\\\">Start with a 20-minute clarity call to pick a single, testable experiment.</div>\\n        </div>\\n        <div>\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start a clarity call</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:28px;color:var(--muted);text-align:center;font-size:14px\\\">\\n      <div>{{BUSINESS_NAME}} — {{COACH_NAME}}, {{CREDENTIALS}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Programs and tiered coaching paths that prioritize reproducible habits and measurable progress.\\\">\\n  <style>\\n    :root{--bg:#fbfcfd;--muted:#55616a;--accent:#0f6b5a;--card:#ffffff;--radius:12px;--max:980px}\\n    body{margin:0;font-family:Inter,system-ui,Roboto,Arial;background:var(--bg);color:#042027}\\n    .wrap{max-width:var(--max);margin:44px auto;padding:24px}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:26px}\\n    nav a{color:var(--muted);margin-left:16px;text-decoration:none}\\n    .hero{margin-bottom:20px}\\n    h1{margin:0;font-size:26px}\\n    .intro{color:var(--muted);margin-top:8px}\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:16px}\\n    .tier{background:var(--card);padding:18px;border-radius:12px;border:1px solid rgba(2,6,23,0.04)}\\n    .price{font-weight:800;color:var(--accent);font-size:18px;margin-top:8px}\\n    .features{margin-top:10px;font-size:14px;color:var(--muted)}\\n    .cta{margin-top:16px}\\n    .btn{padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none;font-weight:600}\\n    .faq{margin-top:18px}\\n    @media (max-width:920px){.tiers{grid-template-columns:1fr}.hero{padding-bottom:10px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <!-- HERO: program framing with scientist tone -->\\n    <section class=\\\"hero\\\">\\n      <h1>Paths built around reproducible change</h1>\\n      <p class=\\\"intro\\\">Select the structure that matches your need: a focused sprint, a guided build, or an ongoing partnership that emphasizes data and adjustment.</p>\\n    </section>\\n\\n    <!-- PILLARS: emphasize structure and measurement differently -->\\n    <section>\\n      <h2 style=\\\"font-size:18px;margin-bottom:8px\\\">Program principles</h2>\\n      <div style=\\\"display:flex;gap:12px;flex-wrap:wrap;margin-bottom:12px\\\">\\n        <div style=\\\"background:#fff;padding:12px;border-radius:10px;border:1px solid rgba(2,6,23,0.04);flex:1;min-width:180px\\\">\\n          <strong>Clarity</strong>\\n          <div class=\\\"features\\\" style=\\\"margin-top:6px\\\">Define one measurable target per cycle.</div>\\n        </div>\\n        <div style=\\\"background:#fff;padding:12px;border-radius:10px;border:1px solid rgba(2,6,23,0.04);flex:1;min-width:180px\\\">\\n          <strong>Feasibility</strong>\\n          <div class=\\\"features\\\" style=\\\"margin-top:6px\\\">Design steps that fit your life and constraints.</div>\\n        </div>\\n        <div style=\\\"background:#fff;padding:12px;border-radius:10px;border:1px solid rgba(2,6,23,0.04);flex:1;min-width:180px\\\">\\n          <strong>Iteration</strong>\\n          <div class=\\\"features\\\" style=\\\"margin-top:6px\\\">Short cycles, measured reviews, and course corrections.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- PROGRAM TIERS: different program names and pricing framing -->\\n    <section>\\n      <h2 style=\\\"font-size:18px;margin-top:6px\\\">Available paths</h2>\\n      <div class=\\\"tiers\\\">\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"font-weight:700\\\">Pilot — 4-week experiment</div>\\n          <div class=\\\"price\\\">$399 one-time</div>\\n          <div class=\\\"features\\\">- 2 coaching sessions<br>- One focused habit, two micro-experiments<br>- Simple tracking template</div>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Enroll in Pilot</a></div>\\n        </div>\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"font-weight:700\\\">Build — 12-week architecture</div>\\n          <div class=\\\"price\\\">$1,150 (or 3 x $390)</div>\\n          <div class=\\\"features\\\">- Weekly 45m sessions<br>- Routine design + environment plan<br>- Data review and adjustments</div>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start Build</a></div>\\n        </div>\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"font-weight:700\\\">Sustain — ongoing coaching</div>\\n          <div class=\\\"price\\\">Monthly subscription: $320/month</div>\\n          <div class=\\\"features\\\">- Bi-weekly sessions<br>- Priority messaging support<br>- Quarterly outcome reviews</div>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Join Sustain</a></div>\\n        </div>\\n      </div>\\n      <div style=\\\"margin-top:10px;font-size:13px;color:var(--muted)\\\">All programs include a short intake dossier and a starter playbook that you keep.</div>\\n    </section>\\n\\n    <!-- CASE STUDIES: short bullets tied to programs -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"font-size:18px\\\">Representative notes</h2>\\n      <div style=\\\"display:grid;gap:10px;margin-top:10px\\\">\\n        <div style=\\\"background:#fff;padding:12px;border-radius:10px;border:1px solid rgba(2,6,23,0.04)\\\"><strong>Pilot</strong> — Client reported a single-week improvement in target metric and kept the new micro-habit after four weeks.</div>\\n        <div style=\\\"background:#fff;padding:12px;border-radius:10px;border:1px solid rgba(2,6,23,0.04)\\\"><strong>Build</strong> — A 12-week program that consolidated a morning routine and reduced decision fatigue for weekday mornings.</div>\\n        <div style=\\\"background:#fff;padding:12px;border-radius:10px;border:1px solid rgba(2,6,23,0.04)\\\"><strong>Sustain</strong> — Ongoing clients report better long-term adherence and cumulative improvements across metrics after six months.</div>\\n      </div>\\n    </section>\\n\\n    <!-- MYTH VS TRUTH: distinct Qs for programs -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"font-size:18px\\\">Assumptions to challenge</h2>\\n      <div style=\\\"display:flex;gap:12px;flex-wrap:wrap;margin-top:10px\\\">\\n        <div style=\\\"background:#fff;padding:12px;border-radius:10px;border:1px solid rgba(2,6,23,0.04);flex:1;min-width:200px\\\">\\n          <strong>Myth</strong>\\n          <div class=\\\"features\\\" style=\\\"margin-top:6px\\\">Long programs are the only route to habit change.</div>\\n        </div>\\n        <div style=\\\"background:#fff;padding:12px;border-radius:10px;border:1px solid rgba(2,6,23,0.04);flex:1;min-width:200px\\\">\\n          <strong>Truth</strong>\\n          <div class=\\\"features\\\" style=\\\"margin-top:6px\\\">Short, tactical runs can create durable shifts if followed by proper scaffolding.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- FAQ: program-specific questions -->\\n    <section class=\\\"faq\\\">\\n      <h2 style=\\\"font-size:18px;margin-top:18px\\\">Program questions</h2>\\n      <div style=\\\"display:grid;gap:8px;margin-top:8px\\\">\\n        <details style=\\\"background:#fff;padding:12px;border-radius:10px;border:1px solid rgba(2,6,23,0.04)\\\"><summary style=\\\"font-weight:700\\\">Can I switch paths mid-program?</summary><div class=\\\"features\\\" style=\\\"margin-top:8px\\\">Yes. We reassess after each cycle and can migrate your plan to a different path if priorities change.</div></details>\\n        <details style=\\\"background:#fff;padding:12px;border-radius:10px;border:1px solid rgba(2,6,23,0.04)\\\"><summary style=\\\"font-weight:700\\\">Do you include materials?</summary><div class=\\\"features\\\" style=\\\"margin-top:8px\\\">Every enrollment includes a starter playbook and simple tracking sheets you can keep or adapt.</div></details>\\n      </div>\\n    </section>\\n\\n    <!-- CTA: targeted conversion for programs -->\\n    <section style=\\\"margin-top:18px;padding:16px;border-radius:12px;background:linear-gradient(180deg,#ffffff,#f6fffb);border:1px solid rgba(11,107,90,0.06);text-align:center\\\">\\n      <strong style=\\\"display:block\\\">Choose a path and run an experiment</strong>\\n      <div class=\\\"features\\\" style=\\\"margin-top:8px;color:var(--muted)\\\">Book a free clarity call to pick the right path for your current priorities.</div>\\n      <div style=\\\"margin-top:12px\\\"> <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:26px;color:var(--muted);text-align:center;font-size:14px\\\">{{BUSINESS_NAME}} • {{COACH_NAME}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
