          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — About</title>\\n  <meta name=\\\"description\\\" content=\\\"Evidence-informed wellness coaching focused on habits, measurements, and sustainable routines.\\\" />\\n  <style>\\n    :root{--bg:#0f0f10;--card:#0b0b0c;--muted:#9aa3a8;--accent:#d4af7f;--glass:rgba(255,255,255,0.03);--white:#f7f7f7}\\n    *{box-sizing:border-box}\\n    body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:linear-gradient(180deg,#0b0b0c 0%,#0f1011 100%);color:var(--white);margin:0;line-height:1.45}\\n    .wrap{max-width:1100px;margin:32px auto;padding:28px}\\n    nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}\\n    .brand{font-weight:700;letter-spacing:0.6px}\\n    .menu{display:flex;gap:18px;font-size:14px}\\n    a{color:var(--muted);text-decoration:none}\\n    a:hover{color:var(--white)}\\n    header.hero{display:grid;grid-template-columns:1fr 460px;gap:28px;align-items:center;padding:28px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:10px}\\n    .hero-copy h1{font-size:30px;margin:0 0 10px}\\n    .hero-copy p{color:var(--muted);margin:0 0 18px}\\n    .meta{display:flex;gap:12px;align-items:center}\\n    .avatar{width:64px;height:64px;border-radius:12px;overflow:hidden;background:var(--glass);display:flex;align-items:center;justify-content:center}\\n    .btn{background:linear-gradient(90deg,var(--accent),#e9c79f);color:#111;padding:10px 14px;border-radius:8px;font-weight:600;text-decoration:none}\\n    .side-svg{background:linear-gradient(180deg,rgba(212,175,127,0.06),transparent);padding:20px;border-radius:10px}\\n    section{margin-top:28px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}\\n    .pillar{background:var(--card);padding:18px;border-radius:8px}\\n    .case-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}\\n    .case{background:var(--glass);padding:14px;border-radius:8px}\\n    .faq{background:linear-gradient(90deg,rgba(255,255,255,0.02),transparent);padding:16px;border-radius:8px}\\n    footer{display:flex;justify-content:space-between;align-items:center;margin-top:30px;color:var(--muted);font-size:13px}\\n    @media(max-width:880px){header.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}.case-grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"menu\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"programs.html\\\">Work With Me</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </div>\\n    </nav>\\n\\n    <header class=\\\"hero\\\" id=\\\"hero\\\">\\n      <div class=\\\"hero-copy\\\">\\n        <h1>Systems-first wellness coaching for measurable change</h1>\\n        <p>I blend behavioral science, simple metrics, and small-repeatable habits so you shift routines without extreme willpower. Ideal if you value clarity, progress, and evidence-backed frameworks.</p>\\n        <div class=\\\"meta\\\">\\n          <div class=\\\"avatar\\\" aria-hidden=\\\"true\\\">\\n            <!-- assets/img/avatar.svg (inline unique SVG for about.html) -->\\n            <svg width=\\\"56\\\" height=\\\"56\\\" viewBox=\\\"0 0 64 64\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-label=\\\"avatar\\\">\\n              <defs><linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#d4af7f\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#9b7a5a\\\"/></linearGradient></defs>\\n              <rect rx=\\\"10\\\" width=\\\"64\\\" height=\\\"64\\\" fill=\\\"#0f1011\\\"/>\\n              <g transform=\\\"translate(6,8)\\\" fill=\\\"none\\\" stroke=\\\"url(#g1)\\\" stroke-width=\\\"2\\\">\\n                <circle cx=\\\"26\\\" cy=\\\"18\\\" r=\\\"10\\\" opacity=\\\"0.95\\\"/>\\n                <path d=\\\"M4 48c6-10 20-12 36 0\\\" stroke-linecap=\\\"round\\\"/>\\n              </g>\\n            </svg>\\n          </div>\\n          <div style=\\\"color:var(--muted)\\\"><strong>{{COACH_NAME}}</strong><br/><span>{{CREDENTIALS}} • {{CITY}}, {{STATE}}</span></div>\\n        </div>\\n        <p style=\\\"margin-top:14px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a> <a href=\\\"book.html\\\" style=\\\"margin-left:12px;color:var(--muted)\\\">Schedule a peek call</a></p>\\n      </div>\\n\\n      <div class=\\\"side-svg\\\">\\n        <!-- assets/img/hero.svg (inline unique SVG for about.html) -->\\n        <svg width=\\\"420\\\" height=\\\"260\\\" viewBox=\\\"0 0 420 260\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-label=\\\"hero-graphic\\\">\\n          <defs>\\n            <linearGradient id=\\\"hA\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#d4af7f\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#b88f63\\\"/></linearGradient>\\n          </defs>\\n          <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"#071012\\\" rx=\\\"10\\\"/>\\n          <g transform=\\\"translate(24,20)\\\" stroke=\\\"url(#hA)\\\" stroke-width=\\\"2\\\" fill=\\\"none\\\">\\n            <path d=\\\"M0 40 C80 0,160 80,240 40 C320 0,360 60,396 34\\\" opacity=\\\"0.85\\\"/>\\n            <circle cx=\\\"84\\\" cy=\\\"46\\\" r=\\\"26\\\" fill=\\\"#071012\\\" stroke-width=\\\"3\\\"/>\\n            <circle cx=\\\"228\\\" cy=\\\"38\\\" r=\\\"30\\\" fill=\\\"#071012\\\" stroke-width=\\\"3\\\"/>\\n          </g>\\n        </svg>\\n      </div>\\n    </header>\\n\\n    <section id=\\\"myth_vs_truth\\\" aria-labelledby=\\\"mvt-heading\\\">\\n      <h2 id=\\\"mvt-heading\\\">Quick myths I correct first</h2>\\n      <p style=\\\"color:var(--muted)\\\">I use a short diagnostic and evidence-based coaching to replace long-standing myths with practical truths.</p>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"pillar\\\">\\n          <h3>Myth: Willpower fixes everything</h3>\\n          <p style=\\\"color:var(--muted)\\\">Truth: Systems and micro-habits reduce reliance on raw willpower. We design triggers and feedback that make desired actions obvious.</p>\\n        </div>\\n        <div class=\\\"pillar\\\">\\n          <h3>Myth: Quick fixes are sustainable</h3>\\n          <p style=\\\"color:var(--muted)\\\">Truth: Repetition, measurement, and progressive overload produce long-term retention — we focus on incremental dosing.</p>\\n        </div>\\n        <div class=\\\"pillar\\\">\\n          <h3>Myth: One-size coaching fits all</h3>\\n          <p style=\\\"color:var(--muted)\\\">Truth: You get a modular framework tuned to your schedule, biology-friendly routines, and measurable milestones.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"pillars\\\">\\n      <h2>Three pillars of the method</h2>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"pillar\\\">\\n          <h4>Assessment</h4>\\n          <p style=\\\"color:var(--muted)\\\">Baseline metrics + contextual behavior mapping to find the 2–3 levers with the highest expected return.</p>\\n        </div>\\n        <div class=\\\"pillar\\\">\\n          <h4>Micro-routines</h4>\\n          <p style=\\\"color:var(--muted)\\\">Tiny, repeatable actions calibrated to your day so the habit becomes frictionless and trackable.</p>\\n        </div>\\n        <div class=\\\"pillar\\\">\\n          <h4>Adaptive feedback</h4>\\n          <p style=\\\"color:var(--muted)\\\">Weekly data reviews and protocol adjustments — you learn what scales and what stalls.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"case_studies\\\">\\n      <h2>Gallery of outcomes</h2>\\n      <p style=\\\"color:var(--muted)\\\">Snapshots from membership cohorts — short case notes anonymized to highlight patterns of progress.</p>\\n      <div class=\\\"case-grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"case\\\">\\n          <strong>Startup PM, 38</strong>\\n          <p style=\\\"color:var(--muted)\\\">Shifted bedtime routine and morning cue system. Improved energy consistency across weeks, reduced afternoon dips.</p>\\n        </div>\\n        <div class=\\\"case\\\">\\n          <strong>Designer, 29</strong>\\n          <p style=\\\"color:var(--muted)\\\">Built a 10-minute evening wind-down that reduced late-night screen use and improved sleep regularity.</p>\\n        </div>\\n        <div class=\\\"case\\\">\\n          <div style=\\\"display:flex;gap:12px;align-items:center\\\"><strong>Busy Parent, 45</strong><span style=\\\"color:var(--muted)\\\">•</span></div>\\n          <p style=\\\"color:var(--muted)\\\">Micro-walks and meal prep protocol saved decision energy and increased weekly exercise consistency.</p>\\n        </div>\\n        <div class=\\\"case\\\">\\n          <strong>Engineer, 33</strong>\\n          <p style=\\\"color:var(--muted)\\\">Introduced bite-sized focus blocks and recovery micro-routines, improving cognitive stamina for deep work.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"faq\\\">\\n      <h2>Questions I hear most</h2>\\n      <div class=\\\"faq\\\" style=\\\"margin-top:8px\\\">\\n        <details>\\n          <summary style=\\\"cursor:pointer\\\">How quickly will I see changes?</summary>\\n          <p style=\\\"color:var(--muted)\\\">Many clients notice habit stability within 3–6 weeks; measurable performance shifts are often visible by 8–12 weeks depending on the target.</p>\\n        </details>\\n        <details>\\n          <summary style=\\\"cursor:pointer\\\">Is this medical advice?</summary>\\n          <p style=\\\"color:var(--muted)\\\">No — coaching is behavioral and educational. I do not diagnose or treat medical conditions; I coordinate with healthcare providers when relevant.</p>\\n        </details>\\n        <details>\\n          <summary style=\\\"cursor:pointer\\\">What tools do you use?</summary>\\n          <p style=\\\"color:var(--muted)\\\">Simple tracking (journals, habit apps, or spreadsheet metrics), brief weekly check-ins, and a modular playbook we iterate together.</p>\\n        </details>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"cta\\\">\\n      <h2>Ready to test a small intervention?</h2>\\n      <p style=\\\"color:var(--muted)\\\">Start with a free 7-day Habit Starter — a pragmatic worksheet and two micro-routines you can implement this week. No fluff, just experiments.</p>\\n      <p><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></p>\\n    </section>\\n\\n    <footer>\\n      <div>© <strong>{{BUSINESS_NAME}}</strong> • {{COACH_NAME}}, {{CREDENTIALS}}</div>\\n      <div style=\\\"text-align:right;color:var(--muted)\\\">{{PHONE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Offerings</title>\\n  <meta name=\\\"description\\\" content=\\\"Structured coaching services, labs, and workshops focused on durable habit change and scalable routines.\\\" />\\n  <style>\\n    :root{--bg:#fcfbf8;--ink:#0c0c0e;--muted:#55616a;--accent:#b88658}\\n    body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:var(--ink);margin:0}\\n    .container{max-width:1100px;margin:28px auto;padding:28px}\\n    nav{display:flex;justify-content:space-between;align-items:center}\\n    .menu{display:flex;gap:16px}\\n    a{color:var(--muted);text-decoration:none}\\n    header{display:flex;gap:20px;align-items:center;margin-top:18px}\\n    .hero-viz{width:360px;height:200px;background:#fff;border-radius:10px;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(0,0,0,0.06)}\\n    h1{margin:0;font-size:26px}\\n    .lead{color:var(--muted);margin-top:6px}\\n    .services-list{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}\\n    .card{background:#fff;padding:16px;border-radius:10px;box-shadow:0 4px 12px rgba(18,18,18,0.04)}\\n    .pillars{display:flex;gap:12px;margin-top:16px}\\n    .pill{background:linear-gradient(90deg,rgba(184,134,88,0.06),transparent);padding:12px;border-radius:8px}\\n    .case-row{display:flex;gap:10px;margin-top:14px}\\n    .case-small{background:linear-gradient(90deg,#fff,transparent);padding:10px;border-radius:8px;flex:1}\\n    .faq{margin-top:18px}\\n    .cta{margin-top:20px;background:linear-gradient(90deg,rgba(184,134,88,0.08),transparent);padding:16px;border-radius:10px;display:flex;justify-content:space-between;align-items:center}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:8px;text-decoration:none}\\n    @media(max-width:780px){.services-list{grid-template-columns:1fr}.pillars{flex-direction:column}.case-row{flex-direction:column}.hero-viz{width:100%;height:160px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <nav>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"menu\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"testimonials.html\\\">Testimonials</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </div>\\n    </nav>\\n\\n    <header>\\n      <div>\\n        <h1>Offerings — practical services, staged for progress</h1>\\n        <p class=\\\"lead\\\">Each service is a modular layer you can adopt independently or combine into an ongoing membership. Emphasis on measurement, replicable routines, and incremental load.</p>\\n      </div>\\n\\n      <div class=\\\"hero-viz\\\" aria-hidden=\\\"true\\\">\\n        <!-- assets/img/hero.svg (inline unique SVG for services.html) -->\\n        <svg width=\\\"320\\\" height=\\\"160\\\" viewBox=\\\"0 0 320 160\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n          <defs><linearGradient id=\\\"s1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#b88658\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#d1b089\\\"/></linearGradient></defs>\\n          <rect width=\\\"320\\\" height=\\\"160\\\" rx=\\\"12\\\" fill=\\\"#fff\\\"/>\\n          <g transform=\\\"translate(20,24)\\\" fill=\\\"none\\\" stroke=\\\"url(#s1)\\\" stroke-width=\\\"3\\\">\\n            <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"90\\\" height=\\\"56\\\" rx=\\\"8\\\"/>\\n            <rect x=\\\"110\\\" y=\\\"12\\\" width=\\\"90\\\" height=\\\"56\\\" rx=\\\"8\\\"/>\\n            <rect x=\\\"220\\\" y=\\\"28\\\" width=\\\"70\\\" height=\\\"36\\\" rx=\\\"8\\\"/>\\n          </g>\\n        </svg>\\n      </div>\\n    </header>\\n\\n    <section id=\\\"pillars\\\">\\n      <h2>Services framed as experiments</h2>\\n      <div class=\\\"pillars\\\">\\n        <div class=\\\"pill\\\"><strong>Diagnostic Lab</strong><div style=\\\"color:var(--muted)\\\">60-min assessment with measurable baselines</div></div>\\n        <div class=\\\"pill\\\"><strong>Subscription Coaching</strong><div style=\\\"color:var(--muted)\\\">Weekly small adjustments and data reviews (membership model)</div></div>\\n        <div class=\\\"pill\\\"><strong>Short Intensives</strong><div style=\\\"color:var(--muted)\\\">4-week rapid trials for a single habit</div></div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"services_list\\\">\\n      <h2 style=\\\"margin-top:14px\\\">Service catalog</h2>\\n      <div class=\\\"services-list\\\">\\n        <div class=\\\"card\\\">\\n          <h3>Diagnostic Lab — 90m</h3>\\n          <p style=\\\"color:var(--muted)\\\">A structured intake, baseline metrics, and a tailor-made 2-week trial protocol you can implement immediately.</p>\\n          <p style=\\\"margin-top:8px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Book Lab</a></p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3>Foundations Package (4 weeks)</h3>\\n          <p style=\\\"color:var(--muted)\\\">Three coaching calls, habit scripts, and daily micro-assignments to embed a new routine.</p>\\n          <p style=\\\"margin-top:8px\\\"><a class=\\\"btn\\\" href=\\\"programs.html\\\">See Programs</a></p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3>Performance Maintenance (membership)</h3>\\n          <p style=\\\"color:var(--muted)\\\">Ongoing weekly check-ins, progressive plans, and live troubleshooting to sustain gains.</p>\\n          <p style=\\\"margin-top:8px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Join Membership</a></p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3>Workshops</h3>\\n          <p style=\\\"color:var(--muted)\\\">Custom half-day labs for teams: habit architecture, micro-productivity, and habit design sprints.</p>\\n          <p style=\\\"margin-top:8px\\\"><a class=\\\"btn\\\" href=\\\"contact.html\\\">Inquire</a></p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"myth_vs_truth\\\" style=\\\"margin-top:18px\\\">\\n      <h2>What I don't do (so you know the limits)</h2>\\n      <div class=\\\"case-row\\\">\\n        <div class=\\\"case-small\\\">\\n          <strong>No quick-fix detoxes</strong>\\n          <p style=\\\"color:var(--muted)\\\">We avoid extreme resets; the focus is sustainable tilts in behavior, not dramatic swings.</p>\\n        </div>\\n        <div class=\\\"case-small\\\">\\n          <strong>No one-off inspiration</strong>\\n          <p style=\\\"color:var(--muted)\\\">Work here is iterative: we test, measure, and iterate rather than rely on pep talks alone.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"case_studies\\\">\\n      <h2 style=\\\"margin-top:18px\\\">Service snapshots</h2>\\n      <div class=\\\"case-row\\\">\\n        <div class=\\\"case-small\\\">\\n          <strong>Lab + 4-week follow-up</strong>\\n          <p style=\\\"color:var(--muted)\\\">Rapid baseline led to a 30% increase in consistent morning routines within 6 weeks.</p>\\n        </div>\\n        <div class=\\\"case-small\\\">\\n          <strong>Membership retention</strong>\\n          <p style=\\\"color:var(--muted)\\\">Clients who stayed in the membership for 6 months reported sustained habit carryover and fewer relapses.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"faq\\\" class=\\\"faq\\\">\\n      <h2>Operational FAQ</h2>\\n      <details>\\n        <summary style=\\\"cursor:pointer\\\">How does the membership work?</summary>\\n        <p style=\\\"color:var(--muted)\\\">Monthly subscription with weekly micro-planning, an asynchronous check-in, and a monthly synthesis call to update the plan.</p>\\n      </details>\\n      <details>\\n        <summary style=\\\"cursor:pointer\\\">Can I combine services?</summary>\\n        <p style=\\\"color:var(--muted)\\\">Yes — we often pair a Diagnostic Lab with a short intensive, then transition to membership for maintenance.</p>\\n      </details>\\n      <details>\\n        <summary style=\\\"cursor:pointer\\\">Do you offer corporate pricing?</summary>\\n        <p style=\\\"color:var(--muted)\\\">Yes — email {{EMAIL}} for a tailored workshop or team package.</p>\\n      </details>\\n    </section>\\n\\n    <section id=\\\"cta\\\" class=\\\"cta\\\">\\n      <div>\\n        <strong>Start with a Diagnostic Lab</strong>\\n        <div style=\\\"color:var(--muted)\\\">A focused session that produces an actionable trial — often the fastest path to measurable improvement.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:22px;color:var(--muted);font-size:13px\\\">Questions? Call {{PHONE}} or <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Programs & Membership</title>\\n  <meta name=\\\"description\\\" content=\\\"Tiered program paths and membership options tailored to habit formation and durable routine change.\\\" />\\n  <style>\\n    :root{--bg:#071018;--panel:#0a171b;--muted:#9fb0b6;--accent:#d4af7f}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:#eaf0ef}\\n    .site{max-width:1100px;margin:24px auto;padding:24px}\\n    nav{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:14px}\\n    .hero{padding:26px;background:linear-gradient(180deg,rgba(212,175,127,0.04),transparent);border-radius:12px;display:flex;gap:18px;align-items:center}\\n    .programs{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .plan{background:var(--panel);padding:18px;border-radius:10px}\\n    h1{margin:0 0 6px}\\n    .lead{color:var(--muted)}\\n    .price{font-weight:700;color:var(--accent);font-size:20px}\\n    .features{color:var(--muted);margin-top:8px}\\n    .faq{margin-top:18px}\\n    .cta{margin-top:18px;padding:14px;background:linear-gradient(90deg,rgba(212,175,127,0.04),transparent);border-radius:10px;display:flex;justify-content:space-between;align-items:center}\\n    .btn{background:var(--accent);color:#071018;padding:10px 12px;border-radius:8px;text-decoration:none}\\n    @media(max-width:900px){.programs{grid-template-columns:1fr}.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <nav>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <div>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </div>\\n    </nav>\\n\\n    <section class=\\\"hero\\\" id=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1>Programs & Membership — pick a practical path</h1>\\n        <p class=\\\"lead\\\">Membership-first model with clear program progressions. Each path contains measurable milestones, habit scripts, and weekly feedback loops.</p>\\n        <p style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></p>\\n      </div>\\n      <div style=\\\"width:380px\\\">\\n        <!-- assets/img/pattern.svg (inline unique SVG for programs.html) -->\\n        <svg width=\\\"360\\\" height=\\\"140\\\" viewBox=\\\"0 0 360 140\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-label=\\\"program-pattern\\\">\\n          <defs>\\n            <linearGradient id=\\\"p1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#d4af7f\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#b88f63\\\"/></linearGradient>\\n          </defs>\\n          <rect width=\\\"100%\\\" height=\\\"100%\\\" rx=\\\"10\\\" fill=\\\"#071018\\\"/>\\n          <g transform=\\\"translate(18,20)\\\" stroke=\\\"url(#p1)\\\" stroke-width=\\\"2\\\" fill=\\\"none\\\">\\n            <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"120\\\" height=\\\"80\\\" rx=\\\"10\\\" opacity=\\\"0.9\\\"/>\\n            <path d=\\\"M140 10 l80 40\\\" stroke-linecap=\\\"round\\\"/>\\n            <circle cx=\\\"260\\\" cy=\\\"60\\\" r=\\\"18\\\" opacity=\\\"0.9\\\"/>\\n          </g>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"myth_vs_truth\\\" style=\\\"margin-top:18px\\\">\\n      <h2>Clarifying expectations</h2>\\n      <p class=\\\"lead\\\">Programs emphasize dosage over drama — we quantify inputs and expected outputs so progress is predictable and repeatable.</p>\\n    </section>\\n\\n    <section id=\\\"programs\\\" class=\\\"programs\\\">\\n      <div class=\\\"plan\\\">\\n        <h3>Path A — Habit Launch</h3>\\n        <div class=\\\"price\\\">Launch (one-time)</div>\\n        <div class=\\\"features\\\">\\n          - Diagnostic + 4-week micro-protocol<br/>\\n          - Two 30-min coaching calls<br/>\\n          - Habit script + daily prompts\\n        </div>\\n        <p style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Start Launch</a></p>\\n      </div>\\n\\n      <div class=\\\"plan\\\">\\n        <h3>Path B — Momentum (membership)</h3>\\n        <div class=\\\"price\\\">Monthly subscription</div>\\n        <div class=\\\"features\\\">\\n          - Weekly micro-planning and asynchronous check-ins<br/>\\n          - Monthly strategy synthesis<br/>\\n          - Priority booking and template library\\n        </div>\\n        <p style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Join Momentum</a></p>\\n      </div>\\n\\n      <div class=\\\"plan\\\">\\n        <h3>Path C — Deep Adaptation</h3>\\n        <div class=\\\"price\\\">Quarterly cohort</div>\\n        <div class=\\\"features\\\">\\n          - 12-week structured curriculum<br/>\\n          - Peer accountability + data reviews<br/>\\n          - Focused habit stacking plan\\n        </div>\\n        <p style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"contact.html\\\">Apply</a></p>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"pillars\\\" style=\\\"margin-top:18px\\\">\\n      <h2>What membership includes</h2>\\n      <p class=\\\"lead\\\">Think of the membership as a practice-lab: short experiments, consistent measurement, and monthly protocol updates.</p>\\n      <ul style=\\\"color:var(--muted);margin-top:8px\\\">\\n        <li>Weekly 15-min check-ins</li>\\n        <li>Access to the Habit Playbook</li>\\n        <li>Priority lab bookings</li>\\n      </ul>\\n    </section>\\n\\n    <section id=\\\"case_studies\\\" style=\\\"margin-top:18px\\\">\\n      <h2>Program outcomes — brief notes</h2>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px\\\">\\n        <div style=\\\"background:var(--panel);padding:10px;border-radius:8px\\\">\\n          <strong>12-week cohort</strong>\\n          <p style=\\\"color:var(--muted)\\\">Participants reported clearer routines and a high probability of maintaining two new habits after the cohort.</p>\\n        </div>\\n        <div style=\\\"background:var(--panel);padding:10px;border-radius:8px\\\">\\n          <strong>Membership</strong>\\n          <p style=\\\"color:var(--muted)\\\">Members sustain micro-routines with fewer relapses versus short experiments alone.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"faq\\\" class=\\\"faq\\\">\\n      <h2>Program FAQs</h2>\\n      <details>\\n        <summary style=\\\"cursor:pointer\\\">Can I upgrade between paths?</summary>\\n        <p style=\\\"color:var(--muted)\\\">Yes — members often start with a Launch then transition to Momentum. We map credits and previous work so nothing is lost.</p>\\n      </details>\\n      <details>\\n        <summary style=\\\"cursor:pointer\\\">What’s the expected time commitment?</summary>\\n        <p style=\\\"color:var(--muted)\\\">Launch: ~2–4 hours/week during the first month. Momentum: ~30–60 minutes/week in total for reflections and micro-assignments.</p>\\n      </details>\\n      <details>\\n        <summary style=\\\"cursor:pointer\\\">Is there a trial?</summary>\\n        <p style=\\\"color:var(--muted)\\\">I offer a short trial protocol (7-day Habit Starter) to evaluate fit before committing.</p>\\n      </details>\\n    </section>\\n\\n    <section id=\\\"cta\\\" class=\\\"cta\\\">\\n      <div>\\n        <strong>Ready to pick a path?</strong>\\n        <div style=\\\"color:var(--muted)\\\">Start with a Launch session or join Momentum to embed lasting routines.</div>\\n      </div>\\n      <div><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:20px;color:var(--muted);font-size:13px\\\">Contact {{COACH_NAME}} at <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
