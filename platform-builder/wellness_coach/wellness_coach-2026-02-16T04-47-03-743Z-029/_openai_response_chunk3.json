          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investment — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Programs and pricing for {{BUSINESS_NAME}} — habit-focused coaching backed by clear frameworks.\\\">\\n  <style>\\n    :root{--bg:#0f0f10;--panel:#0b0b0c;--muted:#9aa3a8;--accent:#ffd6a5;--white:#f7f7f8;--glass:rgba(255,255,255,0.04);font-family:Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;}\\n    *{box-sizing:border-box}\\n    body{margin:0;background:linear-gradient(180deg,#070708 0%, #0f0f10 60%);color:var(--white);line-height:1.45}\\n    .max{max-width:1100px;margin:0 auto;padding:32px}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 0}\\n    .brand{font-weight:700;letter-spacing:0.4px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:14px}\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:36px;align-items:center;padding:42px 0}\\n    .hero .copy h1{font-size:36px;margin:0 0 10px}\\n    .hero p{color:var(--muted);margin:0 0 18px}\\n    .card{background:var(--panel);padding:18px;border-radius:12px;box-shadow:0 6px 30px rgba(0,0,0,0.6)}\\n    .tier{display:flex;flex-direction:column;padding:18px;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);}\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .price{font-weight:700;font-size:22px;color:var(--accent)}\\n    .features{color:var(--muted);font-size:14px;margin:10px 0}\\n    .cta{display:inline-block;background:var(--accent);color:#0b0b0c;padding:10px 14px;border-radius:8px;text-decoration:none;font-weight:600}\\n    .grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:28px}\\n    .case{background:var(--glass);padding:16px;border-radius:10px}\\n    .faq dt{font-weight:600}\\n    footer{margin-top:40px;color:var(--muted);font-size:13px;text-align:center}\\n    /* gallery-style SVG showcase */\\n    .svg-wrap{display:flex;align-items:center;justify-content:center}\\n    svg{width:100%;height:auto;display:block}\\n    @media(max-width:900px){.hero{grid-template-columns:1fr;}.tiers{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"max\\\">\\n    <header>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}} — <span style=\\\"font-weight:400;color:var(--muted)\\\">{{TAGLINE}}</span></div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"programs.html\\\">Work With Me</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a href=\\\"testimonials.html\\\">Stories</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <!-- HERO: Investment & Pathways -->\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"copy\\\">\\n        <h1>Investment & Pathways — practical tiers, measurable progress</h1>\\n        <p>Choose a program framed around habit change and scalable accountability. Each tier maps to a clear sequence of behaviors, checkpoints, and short-cycle experiments so progress is visible every week.</p>\\n        <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a style=\\\"color:var(--muted);text-decoration:underline;font-size:13px\\\" href=\\\"contact.html\\\">Ask about a custom path</a>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card svg-wrap\\\" aria-hidden=\\\"true\\\">\\n        <!-- assets/img/hero.svg (unique to pricing page) -->\\n        <svg viewBox=\\\"0 0 400 300\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-label=\\\"stylized pathways diagram\\\">\\n          <defs>\\n            <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n              <stop offset=\\\"0\\\" stop-color=\\\"#ffd6a5\\\"/>\\n              <stop offset=\\\"1\\\" stop-color=\\\"#ffb4a2\\\"/>\\n            </linearGradient>\\n          </defs>\\n          <rect rx=\\\"16\\\" x=\\\"2\\\" y=\\\"2\\\" width=\\\"396\\\" height=\\\"296\\\" fill=\\\"#071017\\\" opacity=\\\"0.6\\\"/>\\n          <g transform=\\\"translate(20,24)\\\" fill=\\\"none\\\" stroke=\\\"url(#g1)\\\" stroke-width=\\\"8\\\">\\n            <path d=\\\"M0,40 C80,0 120,80 200,40\\\" stroke-linecap=\\\"round\\\"/>\\n            <path d=\\\"M10,130 C90,90 140,170 220,130\\\" stroke-linecap=\\\"round\\\" stroke-opacity=\\\"0.9\\\"/>\\n            <path d=\\\"M30,210 C100,170 220,250 360,210\\\" stroke-linecap=\\\"round\\\" stroke-opacity=\\\"0.7\\\"/>\\n          </g>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <!-- FRAMEWORK PILLARS (different label than other pages) -->\\n    <section class=\\\"card\\\" style=\\\"margin-top:22px\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Core Frameworks that Shape Pricing</h2>\\n      <p style=\\\"color:var(--muted);margin:0 0 12px\\\">Each tier centers around a reproducible framework: micro-habits, measurement cadence, and adaptive planning. Pricing aligns with session cadence and included tools.</p>\\n      <div class=\\\"grid\\\">\\n        <div>\\n          <h3 style=\\\"margin:0 0 6px\\\">Micro Habit Protocol</h3>\\n          <p class=\\\"features\\\">Small behavior steps + daily micro-checks to build consistency without overwhelm.</p>\\n        </div>\\n        <div>\\n          <h3 style=\\\"margin:0 0 6px\\\">Data & Reflection Loop</h3>\\n          <p class=\\\"features\\\">Weekly logs, quick metrics, and structured reflection to refine what works.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- PRICING TIERS (unique program names & framing) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin:0 0 12px\\\">Programs & Pricing — choose by rhythm</h2>\\n      <p style=\\\"color:var(--muted);margin:0 0 12px\\\">Not all clients need the same intensity. Pick by how fast you want habits to take hold and how much contact you prefer.</p>\\n      <div class=\\\"tiers\\\">\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <strong>Starter Habit</strong>\\n              <div class=\\\"features\\\">8-week guided plan — solo practice + bi-weekly check-ins</div>\\n            </div>\\n            <div class=\\\"price\\\">$497</div>\\n          </div>\\n          <div style=\\\"margin-top:auto;display:flex;justify-content:space-between;align-items:center\\\">\\n            <a class=\\\"cta\\\" href=\\\"book.html\\\">Enroll</a>\\n            <span style=\\\"color:var(--muted);font-size:13px\\\">best for exploration</span>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <strong>Momentum Path</strong>\\n              <div class=\\\"features\\\">12-week coaching — weekly sessions, tracking dashboard, habit lab</div>\\n            </div>\\n            <div class=\\\"price\\\">$1,200</div>\\n          </div>\\n          <div style=\\\"margin-top:auto;display:flex;justify-content:space-between;align-items:center\\\">\\n            <a class=\\\"cta\\\" href=\\\"book.html\\\">Start</a>\\n            <span style=\\\"color:var(--muted);font-size:13px\\\">structured & supported</span>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <strong>Transformation Lab</strong>\\n              <div class=\\\"features\\\">6-month intensive — fortnightly sessions, bespoke experiments, priority access</div>\\n            </div>\\n            <div class=\\\"price\\\">$4,800</div>\\n          </div>\\n          <div style=\\\"margin-top:auto;display:flex;justify-content:space-between;align-items:center\\\">\\n            <a class=\\\"cta\\\" href=\\\"contact.html\\\">Discuss</a>\\n            <span style=\\\"color:var(--muted);font-size:13px\\\">for deep change</span>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- CASE STUDIES (compact) -->\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2 style=\\\"margin:0 0 10px\\\">Selected client outcomes</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"case card\\\">\\n          <strong>Habit consolidation in 10 weeks</strong>\\n          <p class=\\\"features\\\">Client A moved from inconsistent attempts to a daily 20-minute practice using tiny triggers and a 3-question end-of-day log.</p>\\n        </div>\\n        <div class=\\\"case card\\\">\\n          <strong>Energy & schedule alignment</strong>\\n          <p class=\\\"features\\\">Client B reorganized morning routines, freeing two hours weekly and reducing decision fatigue via a simplified framework.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- MYTHS VS TRUTHS (pricing-focused) -->\\n    <section style=\\\"margin-top:22px\\\" class=\\\"card\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Common misconceptions about coaching investment</h2>\\n      <dl class=\\\"faq\\\" style=\\\"margin:0\\\">\\n        <dt>\\\"Expensive means better results\\\"</dt>\\n        <dd style=\\\"color:var(--muted)\\\">Price signals intensity and features, not guaranteed progress. The right match and disciplined practice matter most.</dd>\\n        <dt>\\\"Short programs can't change habits\\\"</dt>\\n        <dd style=\\\"color:var(--muted)\\\">Short, high-focus cycles with clear metrics often outpace long, unfocused support. Duration should fit the goal.</dd>\\n      </dl>\\n    </section>\\n\\n    <!-- CTA -->\\n    <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <h3 style=\\\"margin:0\\\">Ready to pick a path?</h3>\\n        <p style=\\\"color:var(--muted);margin:6px 0\\\">If you want specific guidance, schedule a 20-minute clarity call — we'll map a practical next step.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>© {{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Success Stories — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Client stories and case studies for {{BUSINESS_NAME}} — habits, small wins, measurable shifts.\\\">\\n  <style>\\n    :root{--bg:#fff9f6;--ink:#1b1b1b;--muted:#6c6f72;--accent:#ffb4a2;--card:#fff;font-family:Inter,system-ui,Segoe UI,Roboto,Arial}\\n    body{margin:0;background:linear-gradient(180deg,#fff 0%,#fff9f6 70%);color:var(--ink)}\\n    .wrap{max-width:1000px;margin:0 auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);margin-left:14px;text-decoration:none}\\n    .hero{display:flex;gap:24px;align-items:center;margin-top:22px}\\n    .hero .title{max-width:620px}\\n    h1{margin:0;font-size:34px}\\n    p{margin:6px 0;color:var(--muted)}\\n    .gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .testimonial{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 8px 30px rgba(20,20,20,0.06)}\\n    .quote{font-style:italic;color:#2b2b2b}\\n    .meta{font-size:13px;color:var(--muted);margin-top:8px}\\n    .pillars{display:flex;gap:12px;margin-top:18px}\\n    .pill{background:linear-gradient(90deg,#ffd6a5,#ffb4a2);padding:12px;border-radius:10px;color:#141414;font-weight:600}\\n    .faq dt{font-weight:700;margin-top:12px}\\n    .cta{display:inline-block;background:var(--accent);padding:10px 16px;border-radius:10px;color:#111;text-decoration:none;font-weight:700}\\n    svg{width:100%;height:auto}\\n    @media(max-width:900px){.gallery{grid-template-columns:1fr}.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <!-- HERO: Proof & Perspectives (unique heading) -->\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"title\\\">\\n        <h1>Proof, not promises — real shifts in routine and resilience</h1>\\n        <p>Short case studies that highlight methods and measurable changes: how tiny experiments accumulate into durable habits.</p>\\n        <div style=\\\"margin-top:12px\\\">\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Book a clarity call</a>\\n          <a href=\\\"pricing.html\\\" style=\\\"margin-left:12px;color:var(--muted);text-decoration:underline;font-size:13px\\\">See programs</a>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"width:300px\\\">\\n        <!-- assets/img/hero.svg (unique to testimonials page) -->\\n        <svg viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-label=\\\"collage of client progress\\\">\\n          <rect width=\\\"200\\\" height=\\\"200\\\" rx=\\\"18\\\" fill=\\\"#fff5f2\\\"/>\\n          <circle cx=\\\"60\\\" cy=\\\"60\\\" r=\\\"28\\\" fill=\\\"#ffd6a5\\\" opacity=\\\"0.95\\\"/>\\n          <rect x=\\\"110\\\" y=\\\"30\\\" width=\\\"68\\\" height=\\\"40\\\" rx=\\\"8\\\" fill=\\\"#ffb4a2\\\"/>\\n          <path d=\\\"M20 150 L180 150\\\" stroke=\\\"#ffd6a5\\\" stroke-width=\\\"8\\\" stroke-linecap=\\\"round\\\"/>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <!-- CASE STUDIES (primary focus here) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Deep Dives — what changed and how</h2>\\n      <div class=\\\"gallery\\\">\\n        <div class=\\\"testimonial\\\">\\n          <div class=\\\"quote\\\">\\\"I went from inconsistent to automatically practicing a 15-minute routine every morning. The smallest intervention — a single trigger — made the difference.\\\"</div>\\n          <div class=\\\"meta\\\">Client M • 10 weeks • Momentum Path</div>\\n        </div>\\n\\n        <div class=\\\"testimonial\\\">\\n          <div class=\\\"quote\\\">\\\"We designed micro-experiments and measured the output. Within eight weeks task avoidance dropped by half and decision clarity improved.\\\"</div>\\n          <div class=\\\"meta\\\">Client R • 8 weeks • Starter Habit</div>\\n        </div>\\n\\n        <div class=\\\"testimonial\\\">\\n          <div class=\\\"quote\\\">\\\"The Transformation Lab gave me a way to design routines around energy windows instead of arbitrary schedules. It changed my month-to-month productivity.\\\"</div>\\n          <div class=\\\"meta\\\">Client S • 6 months • Transformation Lab</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- MYTH VS TRUTH (reframed) -->\\n    <section style=\\\"margin-top:20px\\\" class=\\\"pillars\\\">\\n      <div class=\\\"pill\\\">Myth: Motivation is the lever</div>\\n      <div class=\\\"pill\\\">Truth: Systems are the lever</div>\\n    </section>\\n    <p style=\\\"color:var(--muted);margin-top:8px\\\">Our work converts intentions into systems — small, repeatable operations that survive low motivation.</p>\\n\\n    <!-- PILLARS (short) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Principles behind the results</h3>\\n      <ul style=\\\"color:var(--muted);margin:0 0 12px;padding-left:18px\\\">\\n        <li>Incremental experiments with rapid feedback</li>\\n        <li>Quantified reflection guided by simple metrics</li>\\n        <li>Trigger engineering and environmental design</li>\\n      </ul>\\n    </section>\\n\\n    <!-- FAQ (unique) -->\\n    <section style=\\\"margin-top:12px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Questions clients often ask</h3>\\n      <dl class=\\\"faq\\\">\\n        <dt>How soon will I notice change?</dt>\\n        <dd style=\\\"color:var(--muted)\\\">Many clients see micro-shifts in 2–3 weeks; durable habits typically require iterative work over several cycles.</dd>\\n        <dt>Do I need to track metrics?</dt>\\n        <dd style=\\\"color:var(--muted)\\\">Tracking is lightweight and optional, but it accelerates learning by clarifying what specifically moved the outcome.</dd>\\n      </dl>\\n    </section>\\n\\n    <!-- CTA: Lead magnet mention + book -->\\n    <section style=\\\"margin-top:16px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <strong>Free resource:</strong> Download the 7-question daily reflection worksheet to accelerate habit formation.\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"contact.html\\\">Get the worksheet</a>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\" style=\\\"margin-left:10px\\\">Talk to a coach</a>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:36px;color:var(--muted);font-size:13px\\\">© {{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a Session — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Schedule a clarity call or coaching session with {{COACH_NAME}} — evidence-informed, habit-first coaching.\\\">\\n  <style>\\n    :root{--bg:#f6fbfb;--ink:#0b1a1a;--muted:#476161;--accent:#7de3c7;--card:#ffffff;--glass:rgba(11,26,26,0.04);font-family:Inter,system-ui,Segoe UI,Roboto,Arial}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg) 0%, #eef9f8 70%);color:var(--ink)}\\n    .wrap{max-width:920px;margin:0 auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);margin-left:14px;text-decoration:none}\\n    .hero{display:grid;grid-template-columns:1fr 320px;gap:20px;align-items:center;margin-top:18px}\\n    h1{margin:0;font-size:32px}\\n    p{margin:8px 0;color:var(--muted)}\\n    .form{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 12px 40px rgba(3,18,18,0.06)}\\n    label{display:block;margin-top:10px;font-weight:600}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6f0ee;margin-top:6px}\\n    button{background:var(--accent);border:none;padding:10px 14px;border-radius:10px;font-weight:700;margin-top:12px}\\n    .info{background:var(--glass);padding:12px;border-radius:10px;color:var(--muted);margin-top:12px}\\n    .svg-fig{display:block}\\n    .faq dt{font-weight:700;margin-top:10px}\\n    footer{margin-top:36px;color:var(--muted);font-size:13px;text-align:center}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"testimonials.html\\\">Testimonials</a>\\n        <a href=\\\"pricing.html\\\">Packages</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <!-- HERO: Reserve a Session (booking-focused) -->\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Reserve a session — clarity calls & coaching blocks</h1>\\n        <p>Book a 20-minute clarity call to map a next step, or schedule a full-length session. Calls focus on rapid diagnosis and a practical first experiment.</p>\\n        <div style=\\\"display:flex;gap:12px;margin-top:12px\\\">\\n          <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"background:var(--accent);padding:10px 14px;border-radius:10px;color:#042522;font-weight:700;text-decoration:none\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a href=\\\"pricing.html\\\" style=\\\"align-self:center;color:var(--muted);text-decoration:underline\\\">See packages</a>\\n        </div>\\n\\n        <div class=\\\"info\\\">\\n          <strong>Lead magnet:</strong> Receive the 7-question reflection worksheet after your clarity call to accelerate your first week.\\n        </div>\\n      </div>\\n\\n      <div class=\\\"svg-fig form\\\" aria-hidden=\\\"true\\\">\\n        <!-- assets/img/hero.svg (unique to book page) -->\\n        <svg viewBox=\\\"0 0 300 220\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-label=\\\"booking abstract\\\">\\n          <rect width=\\\"300\\\" height=\\\"220\\\" rx=\\\"16\\\" fill=\\\"#e8f9f3\\\"/>\\n          <g fill=\\\"#7de3c7\\\" opacity=\\\"0.95\\\">\\n            <rect x=\\\"18\\\" y=\\\"26\\\" width=\\\"120\\\" height=\\\"18\\\" rx=\\\"6\\\"/>\\n            <rect x=\\\"18\\\" y=\\\"56\\\" width=\\\"240\\\" height=\\\"12\\\" rx=\\\"6\\\"/>\\n            <rect x=\\\"18\\\" y=\\\"86\\\" width=\\\"180\\\" height=\\\"12\\\" rx=\\\"6\\\"/>\\n            <circle cx=\\\"240\\\" cy=\\\"160\\\" r=\\\"28\\\"/>\\n          </g>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <!-- BOOKING FORM (primary CTA here) -->\\n    <section style=\\\"margin-top:18px\\\" class=\\\"form\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Book now — clarity call (20 min) or full session</h2>\\n      <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\">\\n        <label for=\\\"name\\\">Your name</label>\\n        <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"First & last\\\" required>\\n\\n        <label for=\\\"email\\\">Email</label>\\n        <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n\\n        <label for=\\\"type\\\">I am interested in</label>\\n        <select id=\\\"type\\\" name=\\\"type\\\">\\n          <option>20-minute clarity call</option>\\n          <option>60-minute coaching session</option>\\n          <option>Program inquiry (Starter / Momentum / Transformation)</option>\\n        </select>\\n\\n        <label for=\\\"note\\\">Brief note</label>\\n        <textarea id=\\\"note\\\" name=\\\"note\\\" rows=\\\"4\\\" placeholder=\\\"What brings you here?\\\"> </textarea>\\n\\n        <button type=\\\"submit\\\">Request booking</button>\\n      </form>\\n\\n      <div class=\\\"info\\\" style=\\\"margin-top:12px\\\">Prefer to reach out directly? Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:inherit;text-decoration:underline\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:inherit;text-decoration:underline\\\">{{EMAIL}}</a>.</div>\\n    </section>\\n\\n    <!-- PILLARS (reordered here) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">What to expect from a session</h3>\\n      <ul style=\\\"color:var(--muted);margin:0 0 12px;padding-left:18px\\\">\\n        <li>Clear behavioral objective for the next week</li>\\n        <li>A compact experiment with precise measurement</li>\\n        <li>Coaching notes and a short follow-up plan</li>\\n      </ul>\\n    </section>\\n\\n    <!-- MYTH VS TRUTH (booking-centric) -->\\n    <section style=\\\"margin-top:12px\\\" class=\\\"form\\\">\\n      <h3 style=\\\"margin:0 0 6px\\\">Common booking questions</h3>\\n      <dl class=\\\"faq\\\">\\n        <dt>Is a clarity call free?</dt>\\n        <dd style=\\\"color:var(--muted)\\\">Yes — the 20-minute clarity call is complementary and helps determine the most efficient next step.</dd>\\n        <dt>Can I switch session types after booking?</dt>\\n        <dd style=\\\"color:var(--muted)\\\">Yes — adjustments are possible with advance notice; we aim to match session intensity to your needs.</dd>\\n      </dl>\\n    </section>\\n\\n    <!-- CASE STUDIES (short wins) -->\\n    <section style=\\\"margin-top:14px\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Short wins you can expect</h3>\\n      <div style=\\\"display:flex;gap:12px\\\">\\n        <div style=\\\"background:var(--card);padding:12px;border-radius:10px;box-shadow:0 6px 18px rgba(3,18,18,0.04);flex:1\\\">\\n          <strong>One-week schedule clarity</strong>\\n          <div style=\\\"color:var(--muted);font-size:14px\\\">A single experiment to reclaim 90 minutes per week.</div>\\n        </div>\\n        <div style=\\\"background:var(--card);padding:12px;border-radius:10px;box-shadow:0 6px 18px rgba(3,18,18,0.04);flex:1\\\">\\n          <strong>Daily micro-habit</strong>\\n          <div style=\\\"color:var(--muted);font-size:14px\\\">A repeatable practice that anchors your day without friction.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- FINAL CTA -->\\n    <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <strong>Not sure where to start?</strong>\\n        <div style=\\\"color:var(--muted);font-size:14px\\\">Book a free clarity call — we'll sketch a focused experiment you can start immediately.</div>\\n      </div>\\n      <div>\\n        <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"background:var(--accent);padding:10px 14px;border-radius:10px;color:#042522;font-weight:700;text-decoration:none\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"color:var(--muted);margin-top:28px\\\">© {{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
