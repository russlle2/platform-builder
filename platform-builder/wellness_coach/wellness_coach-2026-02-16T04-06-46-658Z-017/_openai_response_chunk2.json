          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0b0b0b;--card:#0f1720;--accent:#ff6b6b;--muted:#9aa4b2;--glass:rgba(255,255,255,0.03);--max:1100px}\\n    html,body{height:100%}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial; background:linear-gradient(180deg,#030307 0%,#0b0b0b 60%);color:#fff;line-height:1.5}\\n    .container{max-width:var(--max);margin:48px auto;padding:32px}\\n    nav{display:flex;gap:18px;align-items:center;justify-content:space-between}\\n    .brand{font-weight:700;letter-spacing:0.6px}\\n    .nav-links a{color:#cbd5e1;text-decoration:none;margin-left:18px;font-size:14px}\\n    header.hero{display:grid;grid-template-columns:1fr 420px;gap:40px;align-items:center;padding:48px 0}\\n    .hero h1{font-size:44px;margin:0 0 12px 0;line-height:1.02}\\n    .hero p.lead{color:var(--muted);margin:0 0 18px 0}\\n    .cta{display:inline-block;background:var(--accent);color:#111;padding:12px 18px;border-radius:8px;text-decoration:none;font-weight:600}\\n    .card{background:var(--card);padding:22px;border-radius:12px;box-shadow:0 6px 24px rgba(2,6,23,0.6)}\\n    .values{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:28px}\\n    .value h4{margin:0 0 8px 0}\\n    .methods{display:flex;flex-direction:column;gap:12px;margin-top:28px}\\n    .method{display:flex;gap:14px;align-items:flex-start}\\n    .method strong{display:block}\\n    .faq{margin-top:28px}\\n    .testimonial{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:16px;border-radius:10px}\\n    footer{margin-top:38px;display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:13px}\\n    /* editorial accents */\\n    .accent-line{height:4px;width:72px;background:linear-gradient(90deg,var(--accent),#ff9a9a);border-radius:6px;margin-bottom:16px}\\n    .avatar{width:100%;height:100%;display:block}\\n    @media (max-width:880px){header.hero{grid-template-columns:1fr;gap:22px}.values{grid-template-columns:1fr}.container{padding:20px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <nav>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"nav-links\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </div>\\n    </nav>\\n\\n    <header class=\\\"hero\\\">\\n      <div>\\n        <div class=\\\"accent-line\\\"></div>\\n        <h1>Human systems design for steady energy and clear days</h1>\\n        <p class=\\\"lead\\\">I help busy professionals turn movement, sleep and micro-habits into predictable wellbeing—so you can perform without burnout.</p>\\n        <p><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></p>\\n\\n        <section class=\\\"card\\\" aria-labelledby=\\\"why-heading\\\">\\n          <h3 id=\\\"why-heading\\\">Who I work with</h3>\\n          <p class=\\\"muted\\\">Focused leaders in {{CITY}}, {{STATE}} who want sustainable routines, measurable progress, and less decision fatigue.</p>\\n\\n          <div class=\\\"values\\\" aria-hidden=\\\"false\\\">\\n            <div class=\\\"value\\\">\\n              <h4>Outcome-led</h4>\\n              <p class=\\\"muted\\\">Goals are translated into weekly habits that compound.</p>\\n            </div>\\n            <div class=\\\"value\\\">\\n              <h4>Evidence-forward</h4>\\n              <p class=\\\"muted\\\">We use practical frameworks—no fads, no extremes.</p>\\n            </div>\\n            <div class=\\\"value\\\">\\n              <h4>Accountable</h4>\\n              <p class=\\\"muted\\\">Short, consistent check-ins are the core of coaching.</p>\\n            </div>\\n          </div>\\n        </section>\\n\\n      </div>\\n\\n      <aside class=\\\"card\\\" aria-hidden=\\\"false\\\">\\n        <!-- Inline avatar SVG (unique) -->\\n        <svg class=\\\"avatar\\\" viewBox=\\\"0 0 420 540\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-label=\\\"Coach avatar\\\">\\n          <rect width=\\\"100%\\\" height=\\\"100%\\\" rx=\\\"12\\\" fill=\\\"#071028\\\" />\\n          <g transform=\\\"translate(40,60)\\\">\\n            <circle cx=\\\"150\\\" cy=\\\"80\\\" r=\\\"58\\\" fill=\\\"#ff6b6b\\\" opacity=\\\"0.12\\\" />\\n            <circle cx=\\\"150\\\" cy=\\\"78\\\" r=\\\"52\\\" fill=\\\"#fff\\\" opacity=\\\"0.06\\\" />\\n            <circle cx=\\\"150\\\" cy=\\\"78\\\" r=\\\"46\\\" fill=\\\"#ffdede\\\" />\\n            <rect x=\\\"40\\\" y=\\\"160\\\" width=\\\"220\\\" height=\\\"120\\\" rx=\\\"14\\\" fill=\\\"#0f1720\\\" stroke=\\\"#12202b\\\" />\\n            <path d=\\\"M10 320c40-18 140-18 200 0\\\" stroke=\\\"#ff6b6b\\\" stroke-width=\\\"6\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\" opacity=\\\"0.9\\\" />\\n            <text x=\\\"20\\\" y=\\\"40\\\" fill=\\\"#fff\\\" font-size=\\\"18\\\" font-weight=\\\"700\\\">{{COACH_NAME}}, {{CREDENTIALS}}</text>\\n            <text x=\\\"20\\\" y=\\\"64\\\" fill=\\\"#9aa4b2\\\" font-size=\\\"12\\\">Wellness Coach — {{CITY}}, {{STATE}}</text>\\n          </g>\\n        </svg>\\n        <div style=\\\"margin-top:12px\\\">\\n          <strong>Meet {{COACH_NAME}}</strong>\\n          <p class=\\\"muted\\\" style=\\\"margin:6px 0 0 0\\\">An executive-minded coach who builds habit systems that align with your work rhythm.</p>\\n        </div>\\n      </aside>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"methods card\\\" aria-labelledby=\\\"philosophy\\\">\\n        <h3 id=\\\"philosophy\\\">My coaching philosophy</h3>\\n        <p class=\\\"muted\\\">We set a north star, and build a predictable route. The three-part framework I use focuses on routine, recovery, and revision.</p>\\n\\n        <div class=\\\"method\\\">\\n          <div style=\\\"width:56px;height:56px;border-radius:10px;background:linear-gradient(180deg,#1f2937,#0b1220);display:grid;place-items:center\\\">1</div>\\n          <div>\\n            <strong>Routine: Micro actions with macro results</strong>\\n            <p class=\\\"muted\\\">Daily anchor rituals that require low willpower but shift trajectory over weeks.</p>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"method\\\">\\n          <div style=\\\"width:56px;height:56px;border-radius:10px;background:linear-gradient(180deg,#1f2937,#0b1220);display:grid;place-items:center\\\">2</div>\\n          <div>\\n            <strong>Recovery: Make rest strategic</strong>\\n            <p class=\\\"muted\\\">We plan recovery intentionally so performance isn't a surprise cost.</p>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"method\\\">\\n          <div style=\\\"width:56px;height:56px;border-radius:10px;background:linear-gradient(180deg,#1f2937,#0b1220);display:grid;place-items:center\\\">3</div>\\n          <div>\\n            <strong>Revision: Data-informed iteration</strong>\\n            <p class=\\\"muted\\\">Short feedback loops to tweak habits until they fit your life.</p>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"faq card\\\" aria-labelledby=\\\"faq-heading\\\">\\n        <h3 id=\\\"faq-heading\\\">Common questions</h3>\\n        <details style=\\\"margin-top:10px\\\"><summary>How quickly will I see results?</summary><p class=\\\"muted\\\" style=\\\"margin:8px 0 0 0\\\">Clients typically notice improved energy within 2–4 weeks when they commit to the anchoring practices we set together.</p></details>\\n        <details style=\\\"margin-top:10px\\\"><summary>Is this medical advice?</summary><p class=\\\"muted\\\" style=\\\"margin:8px 0 0 0\\\">No. Coaching focuses on habits and performance strategies—not clinical diagnosis or treatments.</p></details>\\n        <details style=\\\"margin-top:10px\\\"><summary>What if my schedule is unpredictable?</summary><p class=\\\"muted\\\" style=\\\"margin:8px 0 0 0\\\">We build flexible protocols and minimum viable routines that survive travel and odd weeks.</p></details>\\n      </section>\\n\\n      <section class=\\\"testimonial card\\\" aria-labelledby=\\\"test-heading\\\" style=\\\"margin-top:20px\\\">\\n        <h3 id=\\\"test-heading\\\">A recent outcome</h3>\\n        <p style=\\\"margin:8px 0 12px 0;\\\">\\\"After eight weeks, my executive energy is consistent and my evenings are mine again. The small habit changes made the business of life easier.\\\"</p>\\n        <p class=\\\"muted\\\">— Senior Manager, {{CITY}}</p>\\n      </section>\\n\\n      <section class=\\\"card\\\" style=\\\"margin-top:22px\\\">\\n        <h3>Free guide: The 7-day Reset</h3>\\n        <p class=\\\"muted\\\">A concise planner that brings structure to your first week of new habits. Includes simple templates, checklists and a 7-day accountability email sequence.</p>\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" style=\\\"margin-top:12px;display:flex;gap:8px;flex-wrap:wrap\\\">\\n          <input name=\\\"email\\\" placeholder=\\\"Email\\\" style=\\\"flex:1;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.06);background:transparent;color:#fff\\\">\\n          <button class=\\\"cta\\\" type=\\\"submit\\\">Get the guide</button>\\n        </form>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a></div>\\n      <div style=\\\"font-size:12px;color:var(--muted)\\\">© {{BUSINESS_NAME}} — Built for steady progress</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--ink:#091421;--muted:#6b7280;--accent:#0ea5a4;--card:#f8fafc;--max:1100px}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;background:var(--bg);color:var(--ink)}\\n    .wrap{max-width:var(--max);margin:40px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .logo{font-weight:700}\\n    nav a{margin-left:16px;color:var(--muted);text-decoration:none;font-size:14px}\\n    .lead-hero{display:flex;gap:28px;align-items:center;margin-top:28px}\\n    .lead-hero h1{font-size:36px;margin:0}\\n    .grid{display:grid;grid-template-columns:1fr 340px;gap:24px;margin-top:20px}\\n    .services-list{display:grid;gap:12px}\\n    .service{background:var(--card);padding:18px;border-radius:10px;border:1px solid rgba(9,20,33,0.04)}\\n    .service h3{margin:0 0 6px 0}\\n    .pill{display:inline-block;padding:6px 10px;background:linear-gradient(90deg,var(--accent),#34d399);color:white;border-radius:999px;font-size:13px}\\n    .aside{position:relative;padding:18px;background:linear-gradient(180deg,#e6fffb,white);border-radius:10px}\\n    .cta{display:inline-block;background:var(--accent);color:white;padding:10px 14px;border-radius:8px;text-decoration:none}\\n    footer{margin-top:28px;color:var(--muted);font-size:13px}\\n    @media (max-width:880px){.grid{grid-template-columns:1fr}.lead-hero{flex-direction:column;align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n      <div>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">Who</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </div>\\n    </header>\\n\\n    <section class=\\\"lead-hero\\\">\\n      <div>\\n        <h1>Services designed around your workweek</h1>\\n        <p style=\\\"color:var(--muted);margin-top:8px\\\">Short, tactical offerings that land quickly and integrate with an executive schedule.</p>\\n      </div>\\n      <div style=\\\"margin-left:auto\\\">\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"grid\\\">\\n      <main>\\n        <section style=\\\"margin-top:18px\\\">\\n          <div class=\\\"services-list\\\">\\n            <article class=\\\"service\\\">\\n              <h3>Rapid Reset — 2-week intensive</h3>\\n              <p class=\\\"muted\\\">A focused kickoff to stabilize sleep, energy and morning anchors. Ideal for leaders in transition.</p>\\n              <p style=\\\"margin-top:8px\\\"><span class=\\\"pill\\\">Starting at $499</span></p>\\n            </article>\\n\\n            <article class=\\\"service\\\">\\n              <h3>Habit Design — 8-week plan</h3>\\n              <p class=\\\"muted\\\">Build a set of micro-habits tailored to your priorities with weekly accountability and simple metrics.</p>\\n              <p style=\\\"margin-top:8px\\\"><span class=\\\"pill\\\">Cohort &amp; private options</span></p>\\n            </article>\\n\\n            <article class=\\\"service\\\">\\n              <h3>One-off Strategy Session</h3>\\n              <p class=\\\"muted\\\">60 minutes of structured planning: we map your next 90 days and leave with a pilot routine.</p>\\n              <p style=\\\"margin-top:8px\\\"><span class=\\\"pill\\\">Session fee applies</span></p>\\n            </article>\\n\\n            <article class=\\\"service\\\">\\n              <h3>Team Wellness Workshop</h3>\\n              <p class=\\\"muted\\\">Workshops for leadership teams focused on sustainable productivity practices and energy awareness.</p>\\n              <p style=\\\"margin-top:8px\\\"><span class=\\\"pill\\\">Custom pricing</span></p>\\n            </article>\\n\\n          </div>\\n        </section>\\n\\n        <section style=\\\"margin-top:18px\\\" class=\\\"service\\\">\\n          <h3>Methods I bring</h3>\\n          <ul style=\\\"margin:8px 0 0 16px;color:var(--muted)\\\">\\n            <li>Micro-habit engineering</li>\\n            <li>Weekly accountability loops</li>\\n            <li>High-leverage recovery planning</li>\\n            <li>Simple progress metrics</li>\\n          </ul>\\n        </section>\\n\\n        <section style=\\\"margin-top:18px\\\" class=\\\"service\\\">\\n          <h3>Objections I address</h3>\\n          <details style=\\\"margin-top:10px\\\"><summary>I don’t have time</summary><p style=\\\"margin-top:8px;color:var(--muted)\\\">We prioritize minute-sized actions that protect your margins, not add to them.</p></details>\\n          <details style=\\\"margin-top:10px\\\"><summary>Will this disrupt my work?</summary><p style=\\\"margin-top:8px;color:var(--muted)\\\">No. Plans are tested against your calendar before anything becomes required.</p></details>\\n        </section>\\n\\n      </main>\\n\\n      <aside class=\\\"aside\\\">\\n        <h4>Quick start lead magnet</h4>\\n        <p style=\\\"color:var(--muted)\\\">Download the 5-minute Energy Audit: a checklist you can use right away to identify two leverage points.</p>\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" style=\\\"margin-top:12px;display:flex;gap:8px\\\">\\n          <input name=\\\"email\\\" placeholder=\\\"Email\\\" style=\\\"flex:1;padding:8px;border-radius:8px;border:1px solid rgba(9,20,33,0.06);background:white\\\">\\n          <button class=\\\"cta\\\" type=\\\"submit\\\">Get it</button>\\n        </form>\\n\\n        <div style=\\\"margin-top:18px\\\">\\n          <h5 style=\\\"margin:0\\\">Testimonial</h5>\\n          <p style=\\\"color:var(--muted);margin-top:8px\\\">\\\"Simple changes, big stability. The Rapid Reset saved a quarter for our VP.\\\"</p>\\n          <p style=\\\"font-size:13px;color:var(--muted);margin-top:6px\\\">— Director, {{CITY}}</p>\\n        </div>\\n\\n        <div style=\\\"margin-top:20px;font-size:13px;color:var(--muted)\\\">\\n          <strong>Ready to start?</strong>\\n          <p style=\\\"margin:6px 0 0 0\\\"><a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"cta\\\">{{PRIMARY_CTA_LABEL}}</a></p>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer>\\n      <p style=\\\"color:var(--muted);\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:underline\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:underline\\\">{{PHONE}}</a></p>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0b0f17;--paper:#071022;--glass:rgba(255,255,255,0.03);--accent:#f59e0b;--muted:#9fb0bf;--max:1100px}\\n    body{margin:0;background:var(--bg);color:#fff;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial}\\n    .wrap{max-width:var(--max);margin:36px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{color:var(--muted);text-decoration:none;margin-left:14px}\\n    .hero{margin-top:22px;padding:26px;background:linear-gradient(180deg,rgba(245,158,11,0.06),transparent);border-radius:12px}\\n    .hero h1{margin:0;font-size:36px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:20px}\\n    .tier{background:var(--paper);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.04)}\\n    .tier h3{margin:0 0 6px 0}\\n    .price{font-size:22px;color:var(--accent);margin-top:8px}\\n    .features{color:var(--muted);margin-top:12px}\\n    .lead-magnet{margin-top:20px;padding:16px;background:linear-gradient(90deg,rgba(245,158,11,0.08),rgba(14,165,164,0.03));border-radius:12px}\\n    .cta{display:inline-block;background:var(--accent);color:#081219;padding:10px 12px;border-radius:8px;text-decoration:none;font-weight:600}\\n    footer{margin-top:28px;color:var(--muted);font-size:13px}\\n    @media (max-width:960px){.grid{grid-template-columns:1fr}.hero h1{font-size:28px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </div>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <h1>Structured pathways to measurable wellbeing</h1>\\n      <p style=\\\"color:var(--muted);margin-top:8px\\\">Choose a path that fits your calendar and long-term goals. Each program includes frameworks, check-ins and an exit plan for maintenance.</p>\\n    </section>\\n\\n    <main>\\n      <section class=\\\"grid\\\" aria-label=\\\"program tiers\\\">\\n        <article class=\\\"tier\\\">\\n          <h3>Starter Path — Momentum Builder</h3>\\n          <p class=\\\"price\\\">$299 — 6 weeks</p>\\n          <p class=\\\"features\\\">Perfect for executives who want a concise, guided set of habits: weekly templates, two 30-minute check-ins, and a week-by-week tracker.</p>\\n          <p style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}?plan=starter\\\">Join Starter</a></p>\\n        </article>\\n\\n        <article class=\\\"tier\\\">\\n          <h3>Core Path — Sustainable Practice</h3>\\n          <p class=\\\"price\\\">$1,899 — 12 weeks</p>\\n          <p class=\\\"features\\\">A coaching rhythm with behavioral design: weekly 45-minute coaching, habit lab, sleep & recovery audit, and measurable milestones.</p>\\n          <p style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}?plan=core\\\">Enroll Core</a></p>\\n        </article>\\n\\n        <article class=\\\"tier\\\">\\n          <h3>Executive Path — Long Game</h3>\\n          <p class=\\\"price\\\">Custom — 6+ months</p>\\n          <p class=\\\"features\\\">An ongoing partnership with quarterly strategy sessions, team integration and priority access. Ideal for senior leaders and teams.</p>\\n          <p style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}?plan=exec\\\">Start Conversation</a></p>\\n        </article>\\n      </section>\\n\\n      <section class=\\\"lead-magnet\\\" style=\\\"margin-top:18px\\\">\\n        <h4 style=\\\"margin:0\\\">Free Resource — The Weekly Rhythm Matrix</h4>\\n        <p style=\\\"color:var(--muted);margin-top:8px\\\">A one-page tool to visualize your work and recovery windows so you can place habits where they’ll stick.</p>\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" style=\\\"margin-top:10px;display:flex;gap:8px;max-width:560px\\\">\\n          <input name=\\\"email\\\" placeholder=\\\"Work email\\\" style=\\\"flex:1;padding:8px;border-radius:8px;border:1px solid rgba(255,255,255,0.06);background:transparent;color:#fff\\\">\\n          <button class=\\\"cta\\\" type=\\\"submit\\\">Send me the matrix</button>\\n        </form>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px\\\" class=\\\"tier\\\" aria-labelledby=\\\"faq-2\\\">\\n        <h4 id=\\\"faq-2\\\">Frequently raised concerns</h4>\\n        <details style=\\\"margin-top:10px\\\"><summary>What kind of commitment is required?</summary><p style=\\\"margin-top:8px;color:var(--muted)\\\">Programs are designed as time-efficient practices—most work is focused on 10–30 minutes/day of high-leverage activity.</p></details>\\n        <details style=\\\"margin-top:10px\\\"><summary>Can this adapt to travel?</summary><p style=\\\"margin-top:8px;color:var(--muted)\\\">Yes. Each path includes travel-ready protocols that maintain momentum without strict routines.</p></details>\\n        <details style=\\\"margin-top:10px\\\"><summary>Are there refunds?</summary><p style=\\\"margin-top:8px;color:var(--muted)\\\">Terms vary by program; we discuss expectations up front so you commit with clarity.</p></details>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px\\\" class=\\\"tier\\\">\\n        <h4>Client story</h4>\\n        <p style=\\\"margin-top:8px;color:var(--muted)\\\">\\\"The Core Path reorganized my calendar and energy. I kept my workload but gained consistent evenings and sharper focus.\\\" — VP, {{CITY}}</p>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap\\\">\\n        <div style=\\\"color:var(--muted)\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted)\\\">{{PHONE}}</a></div>\\n        <div><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
