          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#FFF8F2;--card:#FEF6EE;--accent:#A65A2A;--muted:#7A5A44;--text:#3E2F2A;--glass:rgba(255,255,255,0.6)}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--text);background:linear-gradient(180deg,var(--bg),#FFF6F0);margin:0}\\n    .nav{display:flex;justify-content:space-between;align-items:center;padding:20px 28px}\\n    .brand{font-weight:700;color:var(--accent)}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .container{max-width:980px;margin:24px auto;padding:28px}\\n    .hero{display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:center;background:var(--card);padding:28px;border-radius:14px;box-shadow:0 8px 30px rgba(166,90,42,0.08)}\\n    .hero h1{margin:0 0 12px;font-size:28px;color:var(--accent)}\\n    .hero p{margin:0;color:var(--muted);line-height:1.5}\\n    .avatar{display:flex;align-items:center;gap:12px}\\n    .avatar svg{width:84px;height:84px;border-radius:12px;background:var(--glass);padding:8px}\\n    .card-row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:22px}\\n    .card{background:linear-gradient(180deg,#FFF,#FFF8F5);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(62,47,42,0.04)}\\n    .section{margin-top:28px}\\n    .section h2{color:var(--accent);margin-bottom:10px}\\n    .list{display:flex;flex-direction:column;gap:10px}\\n    .pill{background:#FFF2EB;padding:10px;border-radius:10px;color:var(--muted)}\\n    .cta{display:inline-block;margin-top:14px;padding:12px 18px;background:var(--accent);color:#FFF;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{margin-top:40px;color:var(--muted);font-size:14px;text-align:center}\\n    @media(max-width:800px){.hero{grid-template-columns:1fr;margin:12px}.card-row{grid-template-columns:1fr}}  \\n  </style>\\n</head>\\n<body>\\n  <header class='nav'>\\n    <div class='brand'>{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='about.html'>Who I Am</a>\\n      <a href='services.html'>Work With Me</a>\\n      <a href='programs.html'>Paths</a>\\n      <a href='pricing.html'>Pricing</a>\\n      <a href='testimonials.html'>Stories</a>\\n      <a href='book.html'>Book</a>\\n      <a href='contact.html'>Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class='container'>\\n    <!-- HERO: Roots & Reach -->\\n    <section class='hero' aria-label='Hero - Roots and Reach'>\\n      <div>\\n        <h1>Rooted clarity. Reachable change.</h1>\\n        <p>I’m {{COACH_NAME}}, {{CREDENTIALS}}. I help busy professionals in {{CITY}}, {{STATE}} convert scattered intentions into reliable daily systems that compound into wellbeing.\\n        My approach is practical, evidence-minded, and built for executives who need progress without overwhelm.</p>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n      <aside class='avatar'>\\n        <!-- avatar SVG reference -->\\n        <img src='assets/img/avatar.svg' alt='Avatar' width='84' height='84'>\\n        <div>\\n          <strong style='color:var(--accent)'>{{COACH_NAME}}</strong>\\n          <div style='color:var(--muted)'>{{CREDENTIALS}} — {{CITY}}, {{STATE}}</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <!-- VALUES: The Compass -->\\n    <section class='section' aria-label='Values - The Compass'>\\n      <h2>The compass that guides our work</h2>\\n      <div class='card-row'>\\n        <div class='card'>\\n          <strong>Practicality</strong>\\n          <p style='color:var(--muted)'>Tools you can use today — not theory you'll forget.</p>\\n        </div>\\n        <div class='card'>\\n          <strong>Clarity</strong>\\n          <p style='color:var(--muted)'>Metrics and rituals that show progress week to week.</p>\\n        </div>\\n        <div class='card'>\\n          <strong>Durability</strong>\\n          <p style='color:var(--muted)'>Habits built for a busy schedule, scaled over months.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- METHODS: Frameworks -->\\n    <section class='section' aria-label='Methods - Frameworks'>\\n      <h2>How we get there: frameworks, not fads</h2>\\n      <div class='list'>\\n        <div class='pill'><strong>Micro-commitments</strong> — Tiny, measurable actions that stack into daily change.</div>\\n        <div class='pill'><strong>Weekly Sprint Rituals</strong> — Short planning sessions that keep momentum high.</div>\\n        <div class='pill'><strong>Accountability Loops</strong> — Fast feedback to correct drift before it grows.</div>\\n      </div>\\n    </section>\\n\\n    <!-- TESTIMONIALS: Stories of Shift (ripple) -->\\n    <section class='section' aria-label='Testimonials - Stories of Shift'>\\n      <h2>Stories of shift</h2>\\n      <div class='card-row'>\\n        <div class='card'>\\n          \\\"In 10 weeks I reduced decision fatigue and reclaimed an hour every morning.\\\" — M., VP\\n        </div>\\n        <div class='card'>\\n          \\\"A practical roadmap — not a motivational pep talk.\\\" — S., Founder\\n        </div>\\n        <div class='card'>\\n          \\\"Sustainable routines, measurable results.\\\" — L., Director\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- OBJECTIONS: Common Concerns -->\\n    <section class='section' aria-label='Objections - Common Concerns'>\\n      <h2>Will this fit your schedule?</h2>\\n      <p style='color:var(--muted)'>Short answer: yes. Programs are designed as 10–60 minute weekly commitments. The first month focuses on habit scaffolding so the work becomes lighter, not heavier.</p>\\n    </section>\\n\\n    <!-- LEAD MAGNET -->\\n    <section class='section' aria-label='Lead Magnet'>\\n      <h2>Free guide: The 7-Day Momentum Reset</h2>\\n      <p style='color:var(--muted)'>Download a compact checklist and three morning rituals you can adopt within a week to reduce decision load and increase clarity.</p>\\n      <form action='#' method='post' onsubmit='event.preventDefault();alert(\\\"Download sent to {{EMAIL}}\\\");' style='display:flex;gap:8px;align-items:center'>\\n        <input type='email' name='email' placeholder='Your email' style='padding:10px;border-radius:8px;border:1px solid #E9DDD3' required>\\n        <button class='cta' type='submit'>Get the guide</button>\\n      </form>\\n    </section>\\n\\n    <!-- CTA -->\\n    <section class='section' aria-label='Final CTA'>\\n      <h2 style='margin-bottom:8px'>Ready to design reliable progress?</h2>\\n      <p style='color:var(--muted)'>Book a discovery call to map a focused plan for the next 90 days.</p>\\n      <a class='cta' href='{{PRIMARY_CTA_URL}}'>Start your plan</a>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} — Questions? Call {{PHONE}} or email {{EMAIL}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#FFF7F0;--card:#FFF4EE;--accent:#6B4A2E;--muted:#81614E;--text:#33221C}\\n    body{font-family:Georgia,serif;color:var(--text);background:var(--bg);margin:0}\\n    .top{display:flex;justify-content:space-between;padding:18px 28px;align-items:center}\\n    .logo{font-weight:800;color:var(--accent)}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .wrap{max-width:1100px;margin:18px auto;padding:28px}\\n    .hero{background:linear-gradient(180deg,#FFF,#FFF7F2);padding:22px;border-radius:14px;display:flex;gap:18px;align-items:center}\\n    .hero h1{margin:0;color:var(--accent)}\\n    .methods{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:22px}\\n    .method{background:var(--card);padding:14px;border-radius:12px}\\n    .lead{background:#FEF6ED;padding:14px;border-radius:10px;margin-top:22px}\\n    .cta{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .faq{margin-top:20px}\\n    .faq details{background:#FFF;padding:12px;border-radius:10px;margin-bottom:8px}\\n    @media(max-width:780px){.methods{grid-template-columns:1fr}.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header class='top'>\\n    <div class='logo'>{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='about.html'>About</a>\\n      <a href='services.html'>Work With Me</a>\\n      <a href='programs.html'>Programs</a>\\n      <a href='pricing.html'>Costs</a>\\n      <a href='testimonials.html'>Testimonials</a>\\n      <a href='book.html'>Book</a>\\n      <a href='contact.html'>Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class='wrap'>\\n    <!-- HERO: The Services Map -->\\n    <section class='hero'>\\n      <div>\\n        <h1>Practical services for sustained performance</h1>\\n        <p style='color:var(--muted)'>Short-term interventions and longer-term partnerships that focus on habits, energy, and predictable routines.</p>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n      <div>\\n        <img src='assets/img/hero.svg' alt='Organic shapes' width='220' style='display:block'>\\n      </div>\\n    </section>\\n\\n    <!-- METHODS: Journey Maps (first to set tone) -->\\n    <section class='methods' aria-label='Methods - Journey Maps'>\\n      <div class='method'>\\n        <strong>Baseline Audit</strong>\\n        <p style='color:var(--muted)'>A focused review of routines, decision points and energy drains that create the highest leverage opportunities.</p>\\n      </div>\\n      <div class='method'>\\n        <strong>Habit Design</strong>\\n        <p style='color:var(--muted)'>Design routines that require minimal willpower and align with your schedule.</p>\\n      </div>\\n      <div class='method'>\\n        <strong>Weekly Coaching</strong>\\n        <p style='color:var(--muted)'>Fast cycles of planning, execution and adjustment to keep momentum.</p>\\n      </div>\\n      <div class='method'>\\n        <strong>On-demand Strategy</strong>\\n        <p style='color:var(--muted)'>Short consults to troubleshoot leaks and adapt plans for travel, transition, or a busy quarter.</p>\\n      </div>\\n    </section>\\n\\n    <!-- OBJECTIONS: Quick Reassurances -->\\n    <section class='lead' aria-label='Objections - Quick Reassurances'>\\n      <h3 style='margin:0;color:var(--accent)'>Too busy? Here’s what people ask.</h3>\\n      <p style='margin:8px 0 0;color:var(--muted)'>We start with micro-actions so the program reduces time-sink, not adds to it. Work is scheduled around your calendar, not the other way round.</p>\\n    </section>\\n\\n    <!-- VALUES: What I Prioritize (ripple) -->\\n    <section style='margin-top:20px'>\\n      <h2 style='color:var(--accent)'>What matters most in my work</h2>\\n      <ul style='color:var(--muted)'>\\n        <li>Transferable skills you can keep forever</li>\\n        <li>Systems that scale with your role</li>\\n        <li>Evidence-informed adjustments</li>\\n      </ul>\\n    </section>\\n\\n    <!-- LEAD MAGNET -->\\n    <section style='margin-top:18px'>\\n      <h3>Free checklist: 5 evening rituals that improve morning output</h3>\\n      <form onsubmit='event.preventDefault();alert(\\\"Checklist will be emailed to the address you entered.\\\")'>\\n        <input type='email' placeholder='Email' required style='padding:10px;border-radius:8px;border:1px solid #E9DDD3'>\\n        <button class='cta' style='margin-left:8px'>Send checklist</button>\\n      </form>\\n    </section>\\n\\n    <!-- TESTIMONIALS: Client Notes -->\\n    <section style='margin-top:22px'>\\n      <h2 style='color:var(--accent)'>Client notes</h2>\\n      <div style='display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:12px'>\\n        <div style='background:#FFF;padding:12px;border-radius:10px'>\\\"Short, tactical & effective.\\\" — A., COO</div>\\n        <div style='background:#FFF;padding:12px;border-radius:10px'>\\\"Kept me practical when everything else felt chaotic.\\\" — R., CEO</div>\\n      </div>\\n    </section>\\n\\n    <!-- FAQ: unique questions -->\\n    <section class='faq' aria-label='FAQ'>\\n      <h2 style='color:var(--accent)'>Questions I get</h2>\\n      <details>\\n        <summary>How quickly will I see improvement?</summary>\\n        <p style='color:var(--muted)'>Most clients notice clarity within 2–3 weeks due to focus shifts and routine tweaks.</p>\\n      </details>\\n      <details>\\n        <summary>Is there a trial session?</summary>\\n        <p style='color:var(--muted)'>Yes — a 30-minute discovery call to align on goals before committing to a program.</p>\\n      </details>\\n    </section>\\n\\n    <!-- FINAL CTA -->\\n    <section style='margin-top:22px'>\\n      <a class='cta' href='{{PRIMARY_CTA_URL}}'>Schedule a discovery call</a>\\n      <p style='color:var(--muted);margin-top:8px'>Or email {{EMAIL}} and we’ll find a time that fits your schedule.</p>\\n    </section>\\n\\n    <footer style='margin-top:28px;color:var(--muted)'>\\n      {{BUSINESS_NAME}} — {{CITY}}, {{STATE}} — {{PHONE}}\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#FFF9F6;--accent:#8A4B32;--card:#FFF5EE;--muted:#6F5847;--text:#2E231F}\\n    body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;background:var(--bg);color:var(--text);margin:0}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:16px 24px}\\n    header .nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .wrap{max-width:1100px;margin:18px auto;padding:20px}\\n    .intro{background:var(--card);padding:18px;border-radius:12px;display:flex;justify-content:space-between;align-items:center}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:18px}\\n    .plan{background:#fff;padding:16px;border-radius:12px;border:1px solid #F0E3DA}\\n    .plan h3{color:var(--accent);margin-top:0}\\n    .price{font-size:20px;font-weight:800;color:var(--accent)}\\n    .methods{margin-top:12px;color:var(--muted)}\\n    .objections{margin-top:14px;background:#FFF6F1;padding:12px;border-radius:10px}\\n    .leadmag{display:flex;gap:10px;margin-top:18px}\\n    .leadmag input{padding:10px;border-radius:8px;border:1px solid #E9DDD3}\\n    .cta{background:var(--accent);color:#fff;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .faq{margin-top:18px}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}.intro{flex-direction:column;gap:12px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style='font-weight:800;color:var(--accent)'>{{BUSINESS_NAME}}</div>\\n    <nav class='nav'>\\n      <a href='index.html'>Home</a>\\n      <a href='about.html'>About</a>\\n      <a href='services.html'>Work With Me</a>\\n      <a href='programs.html'>Programs</a>\\n      <a href='pricing.html'>Pricing</a>\\n      <a href='book.html'>Book</a>\\n      <a href='contact.html'>Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class='wrap'>\\n    <!-- HERO: Paths overview -->\\n    <section class='intro'>\\n      <div>\\n        <h1 style='margin:0;color:var(--accent)'>Focused intensives for measurable change</h1>\\n        <p style='color:var(--muted);margin:6px 0 0'>Programs are designed as intensive, outcome-driven experiences with clear timelines and checkpoints.</p>\\n      </div>\\n      <div>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}'>Start with discovery</a>\\n      </div>\\n    </section>\\n\\n    <!-- PROGRAMS: Distinct names & pricing framing -->\\n    <section class='grid' aria-label='Programs'>\\n      <article class='plan'>\\n        <h3>6-Week Sprint: Momentum Accelerator</h3>\\n        <div class='price'>$3,200 one-time</div>\\n        <p class='methods'>Intensive weekly sessions, two short check-ins per week, and a focus on creating a reliable morning routine that frees 60+ minutes per week.</p>\\n        <ul style='color:var(--muted)'>\\n          <li>6 coaching sessions</li>\\n          <li>Daily micro-commitment plan</li>\\n          <li>Accountability messages</li>\\n        </ul>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}' style='display:inline-block;margin-top:10px'>Apply to sprint</a>\\n      </article>\\n\\n      <article class='plan'>\\n        <h3>12-Week Executive Reset</h3>\\n        <div class='price'>$7,500 — installment option</div>\\n        <p class='methods'>A three-month transformation that restructures habits, creates sustainable planning rituals and integrates performance guardrails for high-demand roles.</p>\\n        <ul style='color:var(--muted)'>\\n          <li>12 coaching sessions</li>\\n          <li>Quarterly planning toolkit</li>\\n          <li>Email support</li>\\n        </ul>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}' style='display:inline-block;margin-top:10px'>Request details</a>\\n      </article>\\n\\n      <article class='plan'>\\n        <h3>90-Day Momentum Partnership</h3>\\n        <div class='price'>Custom pricing</div>\\n        <p class='methods'>A concierge-tier partnership combining coaching, habit design, and implementation support for sustained organizational or role-based change.</p>\\n        <ul style='color:var(--muted)'>\\n          <li>Weekly strategy + execution sessions</li>\\n          <li>On-call adjustments</li>\\n          <li>Team adaptions available</li>\\n        </ul>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}' style='display:inline-block;margin-top:10px'>Discuss partnership</a>\\n      </article>\\n    </section>\\n\\n    <!-- METHODS: How intensives work (ripple) -->\\n    <section style='margin-top:18px'>\\n      <h2 style='color:var(--accent)'>What an intensive looks like</h2>\\n      <p style='color:var(--muted)'>Every program is structured into short cycles: diagnose, implement, stabilize. We emphasize small wins early and use quantitative checks to ensure the work is productive.</p>\\n    </section>\\n\\n    <!-- OBJECTIONS: Pricing & value -->\\n    <section class='objections' aria-label='Objections - Pricing and Value'>\\n      <h3 style='margin:0;color:var(--accent)'>Is this worth the investment?</h3>\\n      <p style='color:var(--muted);margin-top:8px'>Clients regularly report time reclaimed, reduced stress and clearer priorities that compound into career gains. If you need an ROI conversation, the discovery call is the right place to map expected returns.</p>\\n    </section>\\n\\n    <!-- VALUES: Outcome Focus -->\\n    <section style='margin-top:18px'>\\n      <h2 style='color:var(--accent)'>Outcomes I commit to</h2>\\n      <ol style='color:var(--muted)'>\\n        <li>Clear week-to-week progress markers</li>\\n        <li>Daily routines that free cognitive bandwidth</li>\\n        <li>Transferable systems for long-term resilience</li>\\n      </ol>\\n    </section>\\n\\n    <!-- TESTIMONIALS: Focused wins -->\\n    <section style='margin-top:18px'>\\n      <h2 style='color:var(--accent)'>Selected client wins</h2>\\n      <div style='display:flex;gap:12px;margin-top:12px;flex-wrap:wrap'>\\n        <div style='background:#FFF;padding:12px;border-radius:10px'>\\\"Recovered 90 minutes per week.\\\" — D., Head of Product</div>\\n        <div style='background:#FFF;padding:12px;border-radius:10px'>\\\"Simpler decisions, stronger focus.\\\" — E., Founder</div>\\n      </div>\\n    </section>\\n\\n    <!-- LEAD MAGNET -->\\n    <section class='leadmag' aria-label='Lead Magnet'>\\n      <input type='email' placeholder='Email for program guide' required>\\n      <button class='cta' onclick='alert(\\\"Program guide sent to the email entered\\\")'>Send me the guide</button>\\n    </section>\\n\\n    <!-- FAQ: Unique questions -->\\n    <section class='faq' aria-label='Faq - program questions'>\\n      <h2 style='color:var(--accent)'>Program FAQs</h2>\\n      <details>\\n        <summary>Do you accept corporate billing?</summary>\\n        <p style='color:var(--muted)'>Yes. We can invoice organizations and create tailored scopes for team leads.</p>\\n      </details>\\n      <details>\\n        <summary>Can I join mid-cycle?</summary>\\n        <p style='color:var(--muted)'>We recommend starting at the beginning of a cycle, but in some cases a tailored entry plan can be created.</p>\\n      </details>\\n      <details>\\n        <summary>What does success measurement look like?</summary>\\n        <p style='color:var(--muted)'>We track weekly habit completion, time reclaimed, and a self-rated focus metric to ensure concrete improvement.</p>\\n      </details>\\n    </section>\\n\\n    <!-- FINAL CTA -->\\n    <section style='margin-top:18px'>\\n      <a class='cta' href='{{PRIMARY_CTA_URL}}'>Book a discovery call</a>\\n      <p style='color:var(--muted);margin-top:8px'>Prefer email? Contact {{EMAIL}} or call {{PHONE}}.</p>\\n    </section>\\n\\n    <footer style='margin-top:28px;color:var(--muted)'>\\n      {{BUSINESS_NAME}} — {{CITY}}, {{STATE}}\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
