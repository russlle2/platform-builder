          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Investment & Pathways</title>\\n  <style>\\n    :root{--bg:#fff7f0;--card:#fff;--accent:#c56f2b;--muted:#7a5a44;--soft:#f3e8e1;--radius:14px;font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg),#fff);color:var(--muted)}\\n    .nav{display:flex;justify-content:space-between;align-items:center;padding:18px 32px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .brand .logo{width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,#ffd3b3,#f5b07a);display:flex;align-items:center;justify-content:center;font-weight:700;color:#7a3f0f}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .wrap{max-width:980px;margin:28px auto;padding:28px}\\n    .hero{display:flex;gap:28px;background:var(--card);padding:28px;border-radius:18px;align-items:center}\\n    .hero .copy{flex:1}\\n    .eyebrow{color:var(--accent);font-weight:700;font-size:13px}\\n    h1{margin:6px 0 10px;font-size:28px;color:#54311f}\\n    p.lead{margin:0 0 16px;color:#6b4f3f}\\n    .hero .cta{display:inline-block;background:var(--accent);color:#fff;padding:12px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:20px}\\n    .card{background:var(--soft);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(125,85,57,0.06)}\\n    .card h3{margin:0 0 8px;color:#5a3824}\\n    .price{font-size:20px;font-weight:800;color:#2e150a}\\n    ul{padding-left:18px}\\n    .meta{font-size:13px;color:#6f5446}\\n    .divider{height:1px;background:#f1e4dc;margin:26px 0;border-radius:2px}\\n    .faq{margin-top:16px}\\n    .leadmag{display:flex;gap:16px;align-items:center;background:#fff4ec;padding:16px;border-radius:12px}\\n    .leadmag .btn{background:#6b3b21;color:#fff;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{margin-top:28px;text-align:center;color:#92705b;font-size:14px}\\n    @media(max-width:880px){.tiers{grid-template-columns:1fr}.hero{flex-direction:column}.nav{padding:12px}}\\n  </style>\\n</head>\\n<body>\\n  <header class=\\\"nav\\\">\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">WC</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:#8b6a54\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"testimonials.html\\\">Stories</a>\\n      <a href=\\\"book.html\\\">Work with me</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"copy\\\">\\n        <div class=\\\"eyebrow\\\">Investment & Clarity</div>\\n        <h1>Investment designed around measurable habits and rhythms</h1>\\n        <p class=\\\"lead\\\">Choose a pathway that matches where you are and where you want to land. Each option blends habit architecture, weekly accountability, and a clear framework for sustainable change — no quick fixes, only reliable progress.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n      <div style=\\\"width:260px;text-align:center\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"organic hero\\\" style=\\\"width:100%\\\">\\n        <div style=\\\"font-size:13px;color:#8b6a54;margin-top:8px\\\">Guided rhythm, crafted outcomes</div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"divider\\\"></div>\\n\\n    <section aria-labelledby=\\\"how-title\\\">\\n      <h2 id=\\\"how-title\\\" style=\\\"color:#5b3c2b\\\">How I guide change</h2>\\n      <p class=\\\"meta\\\">A short, repeatable methodology used across all pathways.</p>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-wrap:wrap\\\">\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:200px\\\">\\n          <h3>Structure Habits</h3>\\n          <p class=\\\"meta\\\">Micro-practices tied to daily cues and weekly review.</p>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:200px\\\">\\n          <h3>Design Environment</h3>\\n          <p class=\\\"meta\\\">Small context shifts that make better choices easier.</p>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:200px\\\">\\n          <h3>Measure Progress</h3>\\n          <p class=\\\"meta\\\">Frameworks to quantify behavior, not just feelings.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"divider\\\"></div>\\n\\n    <section>\\n      <h2 style=\\\"color:#5b3c2b\\\">Paths & Pricing</h2>\\n      <p class=\\\"meta\\\">Three ways to work together — pick the time frame and intensity that suits your season.</p>\\n      <div class=\\\"tiers\\\">\\n        <div class=\\\"card\\\">\\n          <h3>Foundations Path</h3>\\n          <div class=\\\"price\\\">$850 — 6 weeks</div>\\n          <p class=\\\"meta\\\">For people starting to build consistent routines. Weekly 45-minute sessions + habit toolkit.</p>\\n          <ul>\\n            <li>Core habit map</li>\\n            <li>Weekly check-ins</li>\\n            <li>Email support between sessions</li>\\n          </ul>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3>Momentum Intensive</h3>\\n          <div class=\\\"price\\\">$2,400 — 3 months</div>\\n          <p class=\\\"meta\\\">Focused work to shift several routines at once. Bi-weekly coaching and progress framework.</p>\\n          <ul>\\n            <li>Custom framework</li>\\n            <li>Accountability & habit audits</li>\\n            <li>Priority messaging</li>\\n          </ul>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3>Transformation Residency</h3>\\n          <div class=\\\"price\\\">$6,900 — 9 months</div>\\n          <p class=\\\"meta\\\">For people seeking sustained identity-level change. Ongoing design, implementation, and leadership of your habits.</p>\\n          <ul>\\n            <li>Full behavioral redesign</li>\\n            <li>Monthly live workshops</li>\\n            <li>Priority booking & renewal option</li>\\n          </ul>\\n        </div>\\n      </div>\\n      <p style=\\\"margin-top:12px;color:#6b5446\\\">All pathways include a results-focused roadmap and decision checkpoints at 30/90/180 days.</p>\\n    </section>\\n\\n    <div class=\\\"divider\\\"></div>\\n\\n    <section>\\n      <h2 style=\\\"color:#5b3c2b\\\">What clients notice first</h2>\\n      <div style=\\\"display:flex;gap:12px;flex-wrap:wrap;margin-top:12px\\\">\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:220px\\\">\\n          <h3>Clearer daily rhythms</h3>\\n          <p class=\\\"meta\\\">Less friction in the mornings and evenings — small wins compound.</p>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:220px\\\">\\n          <h3>Decision confidence</h3>\\n          <p class=\\\"meta\\\">A repeatable way to choose what to prioritize every week.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"divider\\\"></div>\\n\\n    <section>\\n      <h2 style=\\\"color:#5b3c2b\\\">Common questions about investment</h2>\\n      <div class=\\\"faq\\\">\\n        <details style=\\\"margin-bottom:8px\\\"><summary style=\\\"font-weight:700\\\">Can I pay in installments?</summary><div style=\\\"padding:8px 6px;color:#6b5446\\\">Yes — two or three installments are available for Momentum and Residency on request. Contact {{EMAIL}} to set it up.</div></details>\\n        <details style=\\\"margin-bottom:8px\\\"><summary style=\\\"font-weight:700\\\">Is there a guarantee?</summary><div style=\\\"padding:8px 6px;color:#6b5446\\\">Coaching focuses on habit change and measurable steps. If you complete the program and implement the framework but still feel stalled, we’ll design a corrective plan at no extra coaching cost.</div></details>\\n        <details style=\\\"margin-bottom:8px\\\"><summary style=\\\"font-weight:700\\\">When can I start?</summary><div style=\\\"padding:8px 6px;color:#6b5446\\\">New clients are onboarded every two weeks. Book an intro call to reserve your slot.</div></details>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"divider\\\"></div>\\n\\n    <section style=\\\"display:flex;gap:14px;align-items:center\\\">\\n      <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" style=\\\"width:88px;height:88px;border-radius:10px\\\">\\n      <div style=\\\"flex:1\\\">\\n        <div style=\\\"font-weight:700;color:#5b3c2b\\\">Free Guide: The 7-Day Habit Reset</div>\\n        <p class=\\\"meta\\\" style=\\\"margin:6px 0\\\">A short sequence you can implement immediately to start tracking progress and shifting daily decisions.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"leadmag btn\\\" href=\\\"/lead-magnet.pdf\\\">Get the Guide</a>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"divider\\\"></div>\\n\\n    <section style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <div style=\\\"font-weight:800;color:#5b3c2b\\\">Ready to choose a pathway?</div>\\n        <div class=\\\"meta\\\">Book a 20-minute strategy call to find the right match.</div>\\n      </div>\\n      <div>\\n        <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"cta\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>{{COACH_NAME}}, {{CREDENTIALS}} — {{CITY}}, {{STATE}}</div>\\n      <div style=\\\"margin-top:6px\\\">Call: {{PHONE}} • Email: {{EMAIL}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Client Stories</title>\\n  <style>\\n    :root{--bg:#fff8f2;--accent:#a65a2b;--dark:#4f3528;--card:#fff;--soft:#f7eae0;font-family:Georgia, serif}\\n    body{margin:0;background:var(--bg);color:var(--dark)}\\n    header{display:flex;justify-content:space-between;padding:18px 28px;align-items:center}\\n    .nav a{margin-left:16px;text-decoration:none;color:var(--dark);font-weight:600}\\n    .container{max-width:980px;margin:18px auto;padding:18px}\\n    .hero{padding:22px;border-radius:14px;background:linear-gradient(180deg,var(--card),var(--soft));display:flex;align-items:center;gap:18px}\\n    .hero img{width:96px;height:96px;border-radius:12px}\\n    h1{margin:0 0 6px;font-family:Georgia, serif}\\n    .subtitle{color:#724f3b}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .test{background:#fff;padding:14px;border-radius:12px;box-shadow:0 6px 12px rgba(120,84,61,0.06)}\\n    .quote{font-style:italic;color:#5b4133}\\n    .meta{font-size:13px;color:#7b5a46;margin-top:10px}\\n    .methods{display:flex;gap:12px;margin-top:16px}\\n    .method{background:var(--soft);padding:12px;border-radius:10px}\\n    .leadmag{margin-top:18px;display:flex;justify-content:space-between;align-items:center;background:#fff4ec;padding:12px;border-radius:10px}\\n    footer{margin-top:24px;text-align:center;color:#7b5a46}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}.hero{flex-direction:column;align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div style=\\\"width:44px;height:44px;background:linear-gradient(135deg,#ffd9bf,#f0b48d);border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:700\\\">WC</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:#8b6a54\\\">Coaching built on habit architecture</div>\\n      </div>\\n    </div>\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Work With Me</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"book.html\\\">Begin</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\">\\n      <div>\\n        <h1>Client outcomes that look like steady progress</h1>\\n        <div class=\\\"subtitle\\\">Real stories: routine shifts, regained time, reliable energy management — framed as habits, not hacks.</div>\\n        <div style=\\\"margin-top:8px\\\"><a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700\\\">Schedule a Call</a></div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin:0 0 8px;color:#5b3c2b\\\">Stories of steady change</h2>\\n      <div class=\\\"grid\\\">\\n        <article class=\\\"test\\\">\\n          <div class=\\\"quote\\\">\\\"I finally have a system for mornings. I accomplish more before noon than I did all day before.\\\"</div>\\n          <div class=\\\"meta\\\">— L., project manager — 3 months</div>\\n        </article>\\n        <article class=\\\"test\\\">\\n          <div class=\\\"quote\\\">\\\"We redesigned my evening habits and my sleep is deeper — I feel more clarity every week.\\\"</div>\\n          <div class=\\\"meta\\\">— M., entrepreneur — 6 months</div>\\n        </article>\\n        <article class=\\\"test\\\">\\n          <div class=\\\"quote\\\">\\\"The coaching replaced chaos with a repeatable framework. My to-do completion rate doubled.\\\"</div>\\n          <div class=\\\"meta\\\">— S., designer — 4 months</div>\\n        </article>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"methods\\\">\\n      <div class=\\\"method\\\"><strong>Behavior map</strong><div style=\\\"font-size:13px;color:#6b5446\\\">Visualize what supports and blocks habits.</div></div>\\n      <div class=\\\"method\\\"><strong>Choice scaffolding</strong><div style=\\\"font-size:13px;color:#6b5446\\\">Design the environment so good choices feel natural.</div></div>\\n      <div class=\\\"method\\\"><strong>Progress loops</strong><div style=\\\"font-size:13px;color:#6b5446\\\">Weekly reviews that produce predictable change.</div></div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0 0 6px;color:#5b3c2b\\\">Addressing common doubts</h3>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:10px\\\">\\n        <div class=\\\"test\\\"><strong>\\\"I don’t have time.\\\"</strong><div class=\\\"meta\\\">We focus on 1–3 micro-habits and remove low-value tasks so small actions compound.</div></div>\\n        <div class=\\\"test\\\"><strong>\\\"I’ve tried coaching before.\\\"</strong><div class=\\\"meta\\\">This program centers on reproducible frameworks with measurable checkpoints, so progress is visible and controllable.</div></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"leadmag\\\">\\n      <div>\\n        <div style=\\\"font-weight:700\\\">Free: Weekly Habit Planner</div>\\n        <div style=\\\"color:#6b5446\\\">A downloadable planner to structure seven days of intentional habits.</div>\\n      </div>\\n      <div><a href=\\\"/lead-magnet.pdf\\\" style=\\\"background:#6b3b21;color:#fff;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:700\\\">Download</a></div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <div style=\\\"font-weight:800\\\">Ready to join this group of steady movers?</div>\\n        <div style=\\\"color:#6b5446\\\">Book a brief consultation to explore goals and fit.</div>\\n      </div>\\n      <div>\\n        <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"background:var(--accent);color:#fff;padding:12px 16px;border-radius:10px;text-decoration:none;font-weight:800\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"margin-top:18px\\\">Confidentiality and respect for your process are central. For questions: {{EMAIL}} • {{PHONE}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffaf5;--accent:#b55b2e;--muted:#6b4f3f;--card:#fff;--radius:12px;font-family:Arial, Helvetica, sans-serif}\\n    body{margin:0;background:var(--bg);color:var(--muted)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:16px 22px}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none;font-weight:700}\\n    .container{max-width:880px;margin:20px auto;padding:18px}\\n    .hero{background:linear-gradient(180deg,#fff,#fff4ec);padding:20px;border-radius:14px;display:flex;gap:16px;align-items:center}\\n    .hero h1{margin:0;color:#503423}\\n    .muted{color:#7a5a44}\\n    .scheduler{display:flex;gap:16px;margin-top:18px}\\n    .left{flex:1}\\n    .right{width:320px}\\n    .form{background:#fff;padding:12px;border-radius:10px}\\n    label{display:block;font-weight:700;margin-top:8px;font-size:13px}\\n    input,select,textarea{width:100%;padding:10px;border:1px solid #e8d9d1;border-radius:8px;margin-top:6px}\\n    .btn{background:var(--accent);color:#fff;padding:12px 14px;border-radius:10px;text-decoration:none;display:inline-block;margin-top:12px;font-weight:800}\\n    .mini{font-size:13px;color:#7a5a44}\\n    .testimonials{margin-top:14px;display:flex;flex-direction:column;gap:10px}\\n    .card{background:#fff;padding:12px;border-radius:10px}\\n    footer{margin-top:18px;text-align:center;color:#8b6a54}\\n    @media(max-width:880px){.scheduler{flex-direction:column}.right{width:100%}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div style=\\\"width:40px;height:40px;background:linear-gradient(135deg,#ffd9bf,#f0b48d);display:flex;align-items:center;justify-content:center;border-radius:8px;font-weight:800\\\">WC</div>\\n      <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Programs</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1>Reserve a strategy session</h1>\\n        <div class=\\\"muted\\\">A clear, time-boxed conversation to map priority habits and next steps. No pressure — just clarity.</div>\\n      </div>\\n      <div style=\\\"width:120px\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"book\\\" style=\\\"width:100%\\\">\\n      </div>\\n    </section>\\n\\n    <section class=\\\"scheduler\\\">\\n      <div class=\\\"left\\\">\\n        <div class=\\\"form\\\">\\n          <div style=\\\"font-weight:800\\\">Book your 20-minute session</div>\\n          <div class=\\\"mini\\\">Select a time and tell me a little about your focus.</div>\\n          <label for=\\\"name\\\">Name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"Your name\\\">\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"you@example.com\\\">\\n          <label for=\\\"focus\\\">Primary focus</label>\\n          <select id=\\\"focus\\\" name=\\\"focus\\\">\\n            <option>Design a morning routine</option>\\n            <option>Improve weekly productivity</option>\\n            <option>Build consistent movement habits</option>\\n            <option>Other</option>\\n          </select>\\n          <label for=\\\"notes\\\">Notes (optional)</label>\\n          <textarea id=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"A few lines about your current routine\\\"></textarea>\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <div class=\\\"mini\\\" style=\\\"margin-top:10px\\\">You will receive a confirmation email from {{EMAIL}}. Slots fill quickly — if none are available, reply to that email and we'll prioritize you.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px\\\">\\n          <h3 style=\\\"margin:0 0 8px;color:#5b3c2b\\\">Quick program primer</h3>\\n          <div style=\\\"display:flex;gap:10px;flex-wrap:wrap\\\">\\n            <div class=\\\"card\\\" style=\\\"flex:1;min-width:200px\\\">\\n              <strong>Starter Sprint</strong>\\n              <div class=\\\"mini\\\">4 weeks — focus on one habit at a time</div>\\n            </div>\\n            <div class=\\\"card\\\" style=\\\"flex:1;min-width:200px\\\">\\n              <strong>Quarterly Momentum</strong>\\n              <div class=\\\"mini\\\">12 weeks — 2–3 habits, layered review</div>\\n            </div>\\n            <div class=\\\"card\\\" style=\\\"flex:1;min-width:200px\\\">\\n              <strong>Annual Stewardship</strong>\\n              <div class=\\\"mini\\\">Ongoing support for identity-level change</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"right\\\">\\n        <div class=\\\"card\\\">\\n          <div style=\\\"font-weight:800\\\">Before our call</div>\\n          <ul style=\\\"margin-top:8px;color:#6b5446\\\">\\n            <li>Bring one current habit you want to change.</li>\\n            <li>Be ready to describe what success looks like in 90 days.</li>\\n            <li>Expect a recommended next step and timeline.</li>\\n          </ul>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0 0 8px;color:#5b3c2b\\\">Client snapshots</h4>\\n          <div class=\\\"testimonials\\\">\\n            <div class=\\\"card\\\"><div style=\\\"font-style:italic\\\">\\\"That conversation saved me weeks of trial-and-error.\\\"</div><div class=\\\"mini\\\">— K., 2 months in</div></div>\\n            <div class=\\\"card\\\"><div style=\\\"font-style:italic\\\">\\\"We left with a plan and a checklist I could use immediately.\\\"</div><div class=\\\"mini\\\">— R., 6 weeks</div></div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px;padding:10px;background:#fff4ec;border-radius:10px\\\">\\n          <strong>Need to reschedule?</strong>\\n          <div class=\\\"mini\\\">Please reply to your confirmation email or contact {{EMAIL}}.</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"color:#5b3c2b\\\">Concerns I often hear</h3>\\n      <div style=\\\"display:flex;gap:10px;flex-wrap:wrap;margin-top:10px\\\">\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:220px\\\"><strong>\\\"I’m not sure coaching will fit my life.\\\"</strong><div class=\\\"mini\\\">We match cadence to your reality. Short, consistent practices often work better than long sessions.</div></div>\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:220px\\\"><strong>\\\"What if it doesn’t stick?\\\"</strong><div class=\\\"mini\\\">We build maintenance rituals into every program to prevent slip-back and enable recovery cycles.</div></div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <div style=\\\"font-weight:800\\\">Not ready to book?</div>\\n        <div class=\\\"mini\\\">Download the 7-Day Habit Reset and try a practice this week.</div>\\n      </div>\\n      <div>\\n        <a href=\\\"/lead-magnet.pdf\\\" style=\\\"background:var(--accent);color:#fff;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:800\\\">Get the 7-Day Reset</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"margin-top:18px\\\">Questions: {{EMAIL}} • Phone: {{PHONE}} — {{COACH_NAME}}, {{CREDENTIALS}} — {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
