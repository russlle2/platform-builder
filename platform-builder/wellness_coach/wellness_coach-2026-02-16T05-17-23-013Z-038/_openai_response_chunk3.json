          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Investment — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Cohort-based wellness paths, habit frameworks, and community guidance from {{COACH_NAME}}.\\\" />\\n  <style>\\n    :root{--bg:#fbf7f1;--card:#fff7f0;--accent:#7a5c3a;--accent-2:#cbb59b;--muted:#6b6b6b;--green:#6a8a68;--radius:14px}\\n    *{box-sizing:border-box}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;color:#2b2b2b;margin:0;background:var(--bg);line-height:1.45}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 36px}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:54px;height:54px;border-radius:12px;background:linear-gradient(135deg,var(--accent-2),var(--accent));display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none}\\n    .container{max-width:1100px;margin:28px auto;padding:0 24px}\\n    .hero{display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:center;background:linear-gradient(180deg,rgba(250,246,242,0.9),rgba(255,255,255,0));padding:36px;border-radius:18px}\\n    .hero h1{margin:0;font-size:28px;color:var(--accent)}\\n    .hero p{margin:12px 0;color:#45413c}\\n    .svg-hero{width:100%;height:220px;background:url('assets/img/hero.svg') no-repeat right/contain}\\n    .card-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;margin-top:20px}\\n    .plan-card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(122,92,58,0.08)}\\n    .plan-card h3{margin:0;color:var(--accent)}\\n    .price{font-size:22px;font-weight:700;color:var(--green);margin:10px 0}\\n    .features{font-size:14px;color:var(--muted);margin:8px 0 14px}\\n    .btn{display:inline-block;padding:10px 16px;border-radius:10px;background:var(--accent);color:white;text-decoration:none}\\n    .muted-small{font-size:13px;color:var(--muted)}\\n    .micro{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}\\n    .micro .chip{background:#fff3ea;padding:8px 10px;border-radius:999px;color:var(--accent-2);font-weight:600}\\n    footer{margin:36px 0;padding:24px;text-align:center;color:var(--muted)}\\n    .faq{margin-top:22px;background:transparent;padding:14px;border-radius:12px}\\n    .cta-strip{margin-top:22px;background:linear-gradient(90deg,rgba(122,92,58,0.06),rgba(107,138,104,0.04));padding:16px;border-radius:12px;display:flex;align-items:center;justify-content:space-between}\\n    @media(max-width:820px){.hero{grid-template-columns:1fr;}.svg-hero{height:160px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">{{COACH_NAME}}</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Philosophy</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"testimonials.html\\\">Stories</a>\\n      <a href=\\\"book.html\\\">Start</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Choose the right path — hold gentle momentum</h1>\\n        <p>Our cohort-style offerings blend ritual, science-aligned habit design, and small-group accountability. Select a rhythm that fits your life and commitment level — every path is built to create lasting micro-habit change.</p>\\n        <div class=\\\"micro\\\">\\n          <span class=\\\"chip\\\">12-week cohort</span>\\n          <span class=\\\"chip\\\">Weekly live sessions</span>\\n          <span class=\\\"chip\\\">Habit toolkit</span>\\n          <span class=\\\"chip\\\">Community circle</span>\\n        </div>\\n        <div style=\\\"margin-top:16px\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a style=\\\"margin-left:12px;color:var(--muted);text-decoration:none\\\" href=\\\"contact.html\\\">Contact</a>\\n        </div>\\n      </div>\\n      <div class=\\\"svg-hero\\\" aria-hidden=\\\"true\\\"></div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2 style=\\\"margin:0 0 8px;color:var(--accent)\\\">Investment tiers framed as growth</h2>\\n      <p class=\\\"muted-small\\\">Think of each tier as a stage of cultivation — from early seedling practices to a communal sanctuary for deep transformation.</p>\\n\\n      <div class=\\\"card-grid\\\">\\n        <div class=\\\"plan-card\\\">\\n          <h3>Seedling — Group Path</h3>\\n          <div class=\\\"price\\\">$499 — cohort</div>\\n          <div class=\\\"features\\\">For busy starters: live group calls, habit checklist, community forum.</div>\\n          <div class=\\\"muted-small\\\">Ideal if you want structure and shared rhythm without 1:1 time.</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Join Seedling</a></div>\\n        </div>\\n\\n        <div class=\\\"plan-card\\\">\\n          <h3>Grove — Guided Track</h3>\\n          <div class=\\\"price\\\">$1,200 — cohort</div>\\n          <div class=\\\"features\\\">Smaller cohort, two live deep-dive workshops, weekly habit audits, guided meditations.</div>\\n          <div class=\\\"muted-small\\\">Best for those ready to build sustainable rituals and receive more personalized feedback.</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve Grove</a></div>\\n        </div>\\n\\n        <div class=\\\"plan-card\\\">\\n          <h3>Sanctuary — Small Cohort + Mentoring</h3>\\n          <div class=\\\"price\\\">$2,800 — cohort</div>\\n          <div class=\\\"features\\\">Tiny cohort, individualized habit plan, two 1:1 mentorships, lifetime check-ins.</div>\\n          <div class=\\\"muted-small\\\">For people building lifestyle-level change with guided accountability.</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Apply to Sanctuary</a></div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"cta-strip\\\">\\n        <div>\\n          <div style=\\\"font-weight:700\\\">Not sure which path?</div>\\n          <div class=\\\"muted-small\\\">Take our 3-minute discovery diagnostic when you book a free call — we’ll recommend a right-sized path.</div>\\n        </div>\\n        <div>\\n          <a class=\\\"btn\\\" href=\\\"book.html\\\">Start the diagnostic</a>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:18px\\\">\\n        <h3 style=\\\"margin:6px 0;color:var(--accent)\\\">What’s included in every cohort</h3>\\n        <ul class=\\\"muted-small\\\">\\n          <li>Habit-first curriculum with weekly micro-goals</li>\\n          <li>Implementation rituals & accountability buddies</li>\\n          <li>Guided meditations and reflective prompts</li>\\n          <li>Access to an alumni circle and resources</li>\\n        </ul>\\n      </div>\\n\\n      <div style=\\\"margin-top:18px\\\" class=\\\"faq\\\">\\n        <h4 style=\\\"margin:0;color:var(--accent)\\\">Common pricing questions</h4>\\n        <div style=\\\"margin-top:8px\\\">\\n          <strong>How do payment plans work?</strong>\\n          <div class=\\\"muted-small\\\">We offer 3-month or 6-month installment options for Grove and Sanctuary. Apply during booking to see available plans.</div>\\n        </div>\\n        <div style=\\\"margin-top:8px\\\">\\n          <strong>Can I switch cohorts?</strong>\\n          <div class=\\\"muted-small\\\">Yes — within the first two weeks we can transition you to a different cohort if a schedule or level feels mismatched.</div>\\n        </div>\\n      </div>\\n\\n    </section>\\n\\n    <section style=\\\"margin-top:26px;padding:18px;background:linear-gradient(180deg,#fff,#fff8f2);border-radius:12px;display:flex;align-items:center;justify-content:space-between\\\">\\n      <div>\\n        <div style=\\\"font-weight:700\\\">Ready to plant roots?</div>\\n        <div class=\\\"muted-small\\\">Join a cohort and begin with a clear micro-habit framework that fits your life. Limited seats each season.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"muted-small\\\">© {{BUSINESS_NAME}} — {{COACH_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Stories — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Community stories and outcomes from cohort programs led by {{COACH_NAME}}.\\\" />\\n  <style>\\n    :root{--bg:#fbf7f1;--accent:#7a5c3a;--soft:#efe6dc;--muted:#6b6b6b}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--bg);color:#2b2b2b}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 26px}\\n    .brand{font-weight:700}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .container{max-width:980px;margin:18px auto;padding:0 20px}\\n    .hero{padding:26px;border-radius:12px;background:linear-gradient(180deg,#fff,#fff7f2);display:flex;gap:18px;align-items:center}\\n    .avatar{width:88px;height:88px;border-radius:18px;background:url('assets/img/avatar.svg') center/cover no-repeat}\\n    .hero h1{margin:0;color:var(--accent)}\\n    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;margin-top:18px}\\n    .testimonial{background:white;padding:16px;border-radius:12px;box-shadow:0 8px 20px rgba(122,92,58,0.06)}\\n    .quote{font-style:italic;color:#444}\\n    .meta{margin-top:10px;font-size:13px;color:var(--muted)}\\n    .small{font-size:13px;color:var(--muted)}\\n    .micro-habits{margin-top:14px;background:linear-gradient(90deg,rgba(122,92,58,0.03),transparent);padding:12px;border-radius:10px}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    footer{margin:34px 0;text-align:center;color:var(--muted);font-size:13px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"programs.html\\\">Work With Me</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"book.html\\\">Begin</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"avatar\\\" aria-hidden=\\\"true\\\"></div>\\n      <div>\\n        <h1>Real rhythms. Real small wins.</h1>\\n        <p class=\\\"small\\\">Stories from people who practiced daily micro-habits, supported by a cohort and {{COACH_NAME}}’s frameworks. The work isn’t perfect — it’s steady.</p>\\n      </div>\\n      <div style=\\\"margin-left:auto\\\">\\n        <a class=\\\"btn\\\" href=\\\"book.html\\\">Book a discovery</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin:0 0 8px;color:var(--accent)\\\">Accounts from recent cohorts</h2>\\n      <div class=\\\"grid\\\">\\n        <article class=\\\"testimonial\\\">\\n          <div class=\\\"quote\\\">\\\"I began with one 3-minute habit and built five. The cohort cheered me on — accountability made the difference.\\\"</div>\\n          <div class=\\\"meta\\\">— Mariana, Seedling cohort</div>\\n          <div class=\\\"micro-habits\\\"><strong>Micro-habit:</strong> 3-minute morning breath & stretch; tracked daily.</div>\\n        </article>\\n\\n        <article class=\\\"testimonial\\\">\\n          <div class=\\\"quote\\\">\\\"I used to start and stop; this program reframed progress as systems rather than perfection.\\\"</div>\\n          <div class=\\\"meta\\\">— Ramesh, Grove group</div>\\n          <div class=\\\"micro-habits\\\"><strong>Micro-habit:</strong> One reflective question each evening; paired with a ritual walk.</div>\\n        </article>\\n\\n        <article class=\\\"testimonial\\\">\\n          <div class=\\\"quote\\\">\\\"The small cohort allowed deeper mentoring. I feel more present and consistent in daily care.\\\"</div>\\n          <div class=\\\"meta\\\">— Claire, Sanctuary</div>\\n          <div class=\\\"micro-habits\\\"><strong>Micro-habit:</strong> Weekly 20-minute design session to plan the coming week’s habits.</div>\\n        </article>\\n\\n        <article class=\\\"testimonial\\\">\\n          <div class=\\\"quote\\\">\\\"It was the first time I didn’t feel shamed for slipping. The frameworks helped me return with curiosity.\\\"</div>\\n          <div class=\\\"meta\\\">— Jamal, alum</div>\\n          <div class=\\\"micro-habits\\\"><strong>Micro-habit:</strong> Mindful hand-washing ritual as a prompt for a reset.</div>\\n        </article>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px;display:flex;gap:18px;align-items:flex-start\\\">\\n      <div style=\\\"flex:1;background:#fff;padding:16px;border-radius:12px;box-shadow:0 6px 18px rgba(122,92,58,0.04)}\\\">\\n        <h3 style=\\\"margin-top:0;color:var(--accent)\\\">How our cohort maps to outcomes</h3>\\n        <p class=\\\"small\\\">We track small weekly indicators: habit consistency, reflective practice, social practice. Over 12 weeks these compound into durable rhythms.</p>\\n        <ul class=\\\"small\\\">\\n          <li>Weekly micro-goals + check-ins</li>\\n          <li>Community reflection sessions</li>\\n          <li>Two guided ritual workshops</li>\\n        </ul>\\n      </div>\\n\\n      <aside style=\\\"width:320px;background:linear-gradient(180deg,#fff,#fff7f2);padding:16px;border-radius:12px\\\">\\n        <h4 style=\\\"margin:0;color:var(--accent)\\\">Quick skeptic FAQ</h4>\\n        <div style=\\\"margin-top:8px\\\" class=\\\"small\\\"><strong>Will this fit into a busy schedule?</strong>\\n          <div class=\\\"small\\\">Yes — the program is built around micro-habits that require minutes, not hours. Cohorts meet weekly for 75 minutes.</div>\\n        </div>\\n        <div style=\\\"margin-top:8px\\\" class=\\\"small\\\"><strong>Is this for beginners?</strong>\\n          <div class=\\\"small\\\">All levels welcome. You’ll be matched to a path that fits your experience and goals.</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px;background:linear-gradient(90deg,#fff8f1,#f8f6f4);padding:16px;border-radius:12px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <div style=\\\"font-weight:700\\\">Hear more over a quick call</div>\\n        <div class=\\\"small\\\">I offer a complimentary discovery diagnostic to align a path to your life. Seats fill each season.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"book.html\\\">Start your diagnostic</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"small\\\">{{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Start — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Book a discovery diagnostic and join a cohort with {{COACH_NAME}}. Cohort model, habit-based plans, spiritual-informed guidance.\\\" />\\n  <style>\\n    :root{--bg:#fbf7f1;--accent:#7a5c3a;--card:#fff7f0;--muted:#6b6b6b}\\n    body{margin:0;font-family:system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial;background:var(--bg);color:#222}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 24px}\\n    .logo{font-weight:700}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .container{max-width:840px;margin:20px auto;padding:0 18px}\\n    .hero{padding:22px;border-radius:12px;background:linear-gradient(180deg,#fff,#fff7f2);display:flex;gap:18px;align-items:center}\\n    .hero svg{width:120px;height:120px}\\n    h1{margin:0;color:var(--accent)}\\n    .diagnostic{margin-top:18px;background:white;padding:16px;border-radius:12px;box-shadow:0 8px 18px rgba(122,92,58,0.05)}\\n    form{display:grid;gap:10px;margin-top:12px}\\n    label{font-size:14px;color:var(--muted)}\\n    input,select,textarea{padding:10px;border-radius:10px;border:1px solid #e6dcd0}\\n    .row{display:flex;gap:10px}\\n    .row .col{flex:1}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;border:none}\\n    .micro-habits{margin-top:14px;padding:12px;border-radius:10px;background:linear-gradient(90deg,rgba(122,92,58,0.03),transparent)}\\n    .muted-small{font-size:13px;color:var(--muted)}\\n    footer{margin:28px 0;text-align:center;color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Programs</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Book your discovery diagnostic</h1>\\n        <p class=\\\"muted-small\\\">A 20-minute conversation and a 3-minute questionnaire that helps us place you in the right cohort and design your first micro-habit plan.</p>\\n      </div>\\n      <div aria-hidden=\\\"true\\\">\\n        <svg viewBox=\\\"0 0 120 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n          <rect x=\\\"6\\\" y=\\\"6\\\" width=\\\"108\\\" height=\\\"108\\\" rx=\\\"18\\\" fill=\\\"#f3eae0\\\"/>\\n          <circle cx=\\\"60\\\" cy=\\\"44\\\" r=\\\"22\\\" fill=\\\"#7a5c3a\\\"/>\\n          <path d=\\\"M22 90c18-20 58-20 76 0\\\" stroke=\\\"#cbb59b\\\" stroke-width=\\\"6\\\" stroke-linecap=\\\"round\\\" fill=\\\"none\\\"/>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"diagnostic\\\">\\n      <h2 style=\\\"margin:0 0 8px;color:var(--accent)\\\">Quick details</h2>\\n      <p class=\\\"muted-small\\\">Complete this form and choose a time. We’ll send a short diagnostic questionnaire to refine your plan before our call.</p>\\n\\n      <form id=\\\"bookingForm\\\" action=\\\"#\\\" method=\\\"post\\\" onsubmit=\\\"return handleSubmit(event)\\\">\\n        <div class=\\\"row\\\">\\n          <div class=\\\"col\\\">\\n            <label for=\\\"name\\\">Full name</label>\\n            <input id=\\\"name\\\" name=\\\"name\\\" required placeholder=\\\"Your full name\\\" />\\n          </div>\\n          <div class=\\\"col\\\">\\n            <label for=\\\"email\\\">Email</label>\\n            <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required placeholder=\\\"you@example.com\\\" />\\n          </div>\\n        </div>\\n\\n        <div>\\n          <label for=\\\"phone\\\">Phone (optional)</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"{{PHONE}}\\\" />\\n        </div>\\n\\n        <div>\\n          <label for=\\\"goal\\\">Primary goal</label>\\n          <select id=\\\"goal\\\" name=\\\"goal\\\">\\n            <option>Build consistent energy rituals</option>\\n            <option>Reduce reactive stress patterns</option>\\n            <option>Design a daily reflective practice</option>\\n            <option>Other</option>\\n          </select>\\n        </div>\\n\\n        <div>\\n          <label for=\\\"experience\\\">Experience with habits/coaching</label>\\n          <select id=\\\"experience\\\" name=\\\"experience\\\">\\n            <option>New to habit work</option>\\n            <option>Some practice (inconsistent)</option>\\n            <option>Seasoned, seeking depth</option>\\n          </select>\\n        </div>\\n\\n        <div>\\n          <label for=\\\"note\\\">Anything you'd like me to know?</label>\\n          <textarea id=\\\"note\\\" name=\\\"note\\\" rows=\\\"3\\\" placeholder=\\\"A few lines about your current rhythm\\\"></textarea>\\n        </div>\\n\\n        <div style=\\\"display:flex;gap:10px;align-items:center;margin-top:8px\\\">\\n          <button class=\\\"btn\\\" type=\\\"submit\\\">Schedule discovery</button>\\n          <div class=\\\"muted-small\\\">We’ll follow up at <strong>{{EMAIL}}</strong> with available slots.</div>\\n        </div>\\n      </form>\\n\\n      <script>\\n        function handleSubmit(e){\\n          e.preventDefault();\\n          var btn = document.querySelector('.btn');\\n          btn.disabled = true;\\n          btn.innerText = 'Sending...';\\n          setTimeout(function(){\\n            btn.innerText = 'Scheduled — check your email';\\n            alert('Thank you. We will email {{EMAIL}} with a short diagnostic and available times.');\\n          },900);\\n          return false;\\n        }\\n      </script>\\n\\n      <div class=\\\"micro-habits\\\">\\n        <strong>Starter micro-habit</strong>\\n        <div class=\\\"muted-small\\\">Try a 60-second arrival ritual for three mornings this week: stand at the window, breathe for 30s, set one intention. Small signals anchor daily practice.</div>\\n      </div>\\n\\n      <div style=\\\"margin-top:14px\\\" class=\\\"muted-small\\\">\\n        <strong>Refund & scheduling note:</strong> Cohorts are limited and seats are reserved on payment. Discovery calls are complementary and help us align a path for you.\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"muted-small\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}} • {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
