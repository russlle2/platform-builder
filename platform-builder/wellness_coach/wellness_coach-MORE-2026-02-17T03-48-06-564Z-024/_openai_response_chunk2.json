          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfcfb;--muted:#67707a;--accent:#2b816f;--card:#ffffff;--glass:rgba(255,255,255,0.7)}\\n    html,body{height:100%;margin:0;font-family:system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#0f1720;background:var(--bg)}\\n    body{display:flex;flex-direction:column}\\n    header{background:linear-gradient(180deg,rgba(43,129,111,0.06),transparent),url('assets/img/pattern.svg');padding:28px 20px;border-bottom:1px solid rgba(15,23,32,0.04)}\\n    .nav{display:flex;gap:18px;align-items:center;max-width:1100px;margin:0 auto}\\n    .brand{font-weight:700;color:var(--accent)}\\n    .nav a{color:var(--muted);text-decoration:none;font-weight:600}\\n    main{max-width:1100px;margin:28px auto;padding:0 20px;display:grid;grid-template-columns:1fr 340px;gap:28px}\\n    .panel{background:var(--card);border-radius:12px;padding:22px;box-shadow:0 6px 20px rgba(11,18,16,0.04)}\\n    h1{margin:0 0 8px 0;font-size:22px}\\n    .muted{color:var(--muted);font-size:14px}\\n    .lead{font-size:15px;line-height:1.5;color:#0f1720;margin:12px 0}\\n    .list{display:grid;gap:12px;margin-top:12px}\\n    .benefit{display:flex;gap:12px;align-items:flex-start}\\n    .badge{width:44px;height:44px;border-radius:8px;background:linear-gradient(135deg,var(--accent),#6bb89b);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    footer{max-width:1100px;margin:18px auto 48px;padding:0 20px;color:var(--muted);font-size:13px}\\n    .cta{display:inline-block;margin-top:14px;background:var(--accent);color:#fff;padding:10px 14px;border-radius:8px;text-decoration:none;font-weight:700}\\n    /* small utility */\\n    .meta{font-size:13px;color:var(--muted)}\\n    .member-snapshot{display:flex;flex-direction:column;gap:12px}\\n    .tier{display:flex;justify-content:space-between;align-items:center;padding:12px;border-radius:10px;background:linear-gradient(180deg,rgba(43,129,111,0.04),transparent)}\\n    .faq{margin-top:12px}\\n    .faq summary{cursor:pointer;padding:10px;border-radius:8px}\\n    .footnote{font-size:12px;color:#55656b}\\n    @media (max-width:900px){main{grid-template-columns:1fr;padding:0 16px}header{padding:18px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <nav class=\\\"nav\\\" aria-label=\\\"primary\\\">\\n      <div style=\\\"flex:1;display:flex;gap:18px;align-items:center\\\">\\n        <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"services.html\\\">Ways</a>\\n        <a href=\\\"programs.html\\\">Tracks</a>\\n      </div>\\n      <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </div>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"panel\\\">\\n      <h1>How this practice supports steady routines</h1>\\n      <div class=\\\"muted\\\">A membership-led approach to shaping dependable days in {{CITY}}, {{STATE}}</div>\\n      <p class=\\\"lead\\\">We work with outcomes, sequences, and repeatable micro-actions—no miracle fixes, no medical advice. Members get frameworks tailored to where they start and the small changes that add up over weeks.\\n      </p>\\n\\n      <div class=\\\"list\\\">\\n        <div class=\\\"benefit\\\"><div class=\\\"badge\\\">1</div><div><strong>Outcome focus</strong><div class=\\\"muted\\\">Clear goals first — then a short sequence of habits that support that goal.</div></div></div>\\n        <div class=\\\"benefit\\\"><div class=\\\"badge\\\">2</div><div><strong>Weekly rhythms</strong><div class=\\\"muted\\\">A repeatable micro-plan you can test and adapt across 30 days.</div></div></div>\\n        <div class=\\\"benefit\\\"><div class=\\\"badge\\\">3</div><div><strong>Membership continuity</strong><div class=\\\"muted\\\">An evolving plan, regular check-ins, and new short tracks each month.</div></div></div>\\n      </div>\\n\\n      <div style=\\\"margin-top:18px\\\">\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <aside class=\\\"panel\\\">\\n      <div class=\\\"member-snapshot\\\">\\n        <div>\\n          <div class=\\\"meta\\\">Membership snapshot</div>\\n          <div class=\\\"tier\\\"><div><strong>Core Membership</strong><div class=\\\"muted\\\">Weekly templates + monthly check-in</div></div><div class=\\\"meta\\\">Included</div></div>\\n          <div class=\\\"tier\\\"><div><strong>Focused Track</strong><div class=\\\"muted\\\">4-week concentrated modules</div></div><div class=\\\"meta\\\">Optional</div></div>\\n        </div>\\n\\n        <div>\\n          <div class=\\\"meta\\\">Quick FAQ</div>\\n          <details class=\\\"faq\\\"><summary>Who is this for?</summary><div class=\\\"muted\\\">Adults wanting predictable habit steps and measurable improvement in daily rhythms.</div></details>\\n          <details class=\\\"faq\\\"><summary>How do check-ins work?</summary><div class=\\\"muted\\\">Short progress reviews, adjustments to sequences, and new micro-tasks to try.</div></details>\\n        </div>\\n\\n        <div>\\n          <div class=\\\"meta\\\">Contact</div>\\n          <div class=\\\"muted\\\">Call: {{PHONE}}<br>Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        </div>\\n      </div>\\n    </aside>\\n\\n    <section style=\\\"grid-column:1/-1;margin-top:18px\\\" class=\\\"panel\\\">\\n      <h2 style=\\\"margin-bottom:6px\\\">Our approach in three short steps</h2>\\n      <div class=\\\"muted\\\">Set a single outcome, apply a compact daily sequence, reflect weekly.</div>\\n      <ol style=\\\"margin-top:12px;color:var(--muted)\\\">\\n        <li>Choose one measurable outcome (sleep, steady energy, focused work).</li>\\n        <li>Follow a targeted micro-sequence each day for a week and track a single metric.</li>\\n        <li>Adjust the sequence; keep what works, discard what doesn’t.</li>\\n      </ol>\\n      <p class=\\\"footnote\\\">Outcomes, habits, and frameworks are the focus. Not a substitute for medical care.</p>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:1100px;margin:0 auto;padding:0 20px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div class=\\\"muted\\\">© <span id=\\\"yr\\\"></span> {{BUSINESS_NAME}} — Serving {{CITY}}, {{STATE}}</div>\\n      <div class=\\\"muted\\\">Phone: {{PHONE}} · <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </div>\\n  </footer>\\n\\n  <script>\\n    document.getElementById('yr').textContent = new Date().getFullYear();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Approaches — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f8fbfa;--muted:#58656a;--accent:#1f6d58;--card:#ffffff}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;color:#0b1313;background:var(--bg)}\\n    header{background:url('assets/img/pattern.svg') center/cover no-repeat;padding:18px 20px;border-bottom:1px solid rgba(11,19,17,0.04)}\\n    .nav{max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;align-items:center}\\n    .brand{font-weight:700;color:var(--accent)}\\n    .nav a{color:var(--muted);text-decoration:none;margin-left:14px}\\n    main{max-width:1100px;margin:28px auto;padding:0 20px}\\n    .hero{display:flex;gap:28px;align-items:center}\\n    .hero .left{flex:1}\\n    h1{margin:0 0 6px 0;font-size:22px}\\n    .muted{color:var(--muted)}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 8px 28px rgba(12,18,16,0.04);margin-top:18px}\\n    .controls{display:flex;gap:12px;align-items:center;margin-top:14px}\\n    select{padding:10px 12px;border-radius:10px;border:1px solid rgba(11,18,16,0.06);font-weight:600}\\n    .recommend{margin-top:14px;padding:14px;border-radius:10px;background:linear-gradient(180deg,rgba(31,109,88,0.04),transparent)}\\n    .cta{display:inline-block;margin-top:12px;background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .methods{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-top:18px}\\n    .method{padding:12px;border-radius:10px;background:#fff;border:1px solid rgba(11,18,16,0.04)}\\n    .muted-small{font-size:13px;color:var(--muted)}\\n    footer{max-width:1100px;margin:28px auto;padding:0 20px;color:var(--muted);font-size:13px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div style=\\\"display:flex;align-items:center;gap:18px\\\">\\n        <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n        <a href=\\\"index.html\\\">Begin</a>\\n        <a href=\\\"about.html\\\">Who I Help</a>\\n        <a href=\\\"services.html\\\">Approaches</a>\\n        <a href=\\\"programs.html\\\">Tracks</a>\\n      </div>\\n      <div>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"testimonials.html\\\">Stories</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </div>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"left\\\">\\n        <h1>Choose how you feel. Get a short method mapped to that state.</h1>\\n        <div class=\\\"muted\\\">Quick selection -> tailored micro-plan. Select a mood to see a recommended approach and an immediate next step.</div>\\n\\n        <div class=\\\"card\\\" aria-labelledby=\\\"mood-heading\\\">\\n          <div id=\\\"mood-heading\\\" style=\\\"font-weight:700\\\">Mood-to-Method selector</div>\\n          <div class=\\\"muted-small\\\">Tell the system how your energy and focus feel right now.</div>\\n\\n          <div class=\\\"controls\\\" role=\\\"group\\\" aria-label=\\\"mood\\\">\\n            <label for=\\\"mood\\\" class=\\\"muted-small\\\">I'm feeling</label>\\n            <select id=\\\"mood\\\" aria-describedby=\\\"mood-desc\\\">\\n              <option value=\\\"flat\\\">Flat / Low energy</option>\\n              <option value=\\\"wired\\\">Wired / Anxious</option>\\n              <option value=\\\"overwhelmed\\\">Overwhelmed</option>\\n              <option value=\\\"peppy\\\">Alert / Productive</option>\\n              <option value=\\\"sleepy\\\">Sleepy / Foggy</option>\\n            </select>\\n            <button id=\\\"sample\\\" class=\\\"cta\\\">{{PRIMARY_CTA_LABEL}}</button>\\n          </div>\\n\\n          <div id=\\\"mood-desc\\\" class=\\\"recommend\\\" aria-live=\\\"polite\\\">\\n            <strong id=\\\"method-title\\\">Micro-sequence</strong>\\n            <div id=\\\"method-copy\\\" class=\\\"muted-small\\\" style=\\\"margin-top:8px\\\">Select your current state to reveal a short method and the best next step for the next 24–72 hours.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"muted-small\\\" style=\\\"margin-top:10px\\\">Each method is short and testable — members iterate weekly and keep what helps.</div>\\n      </div>\\n\\n      <aside style=\\\"width:320px\\\">\\n        <div class=\\\"card\\\">\\n          <div style=\\\"font-weight:700\\\">Quick approaches</div>\\n          <div class=\\\"methods\\\" style=\\\"margin-top:12px\\\">\\n            <div class=\\\"method\\\"><strong>Rhythm Reset</strong><div class=\\\"muted-small\\\">Small anchor actions for 7 days.</div></div>\\n            <div class=\\\"method\\\"><strong>Micro-Breaks</strong><div class=\\\"muted-small\\\">Planned, short interruptions to reset energy.</div></div>\\n            <div class=\\\"method\\\"><strong>Slow Wind-down</strong><div class=\\\"muted-small\\\">Evening sequence to improve sleep onset.</div></div>\\n            <div class=\\\"method\\\"><strong>Focused Sprints</strong><div class=\\\"muted-small\\\">Compact work windows and recovery loops.</div></div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <div class=\\\"muted-small\\\">Need a direct start? Book a short orientation and we’ll map a 30‑day micro-plan with your first week pre-filled.</div>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\" style=\\\"display:inline-block;margin-top:10px\\\">Book an orientation</a>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"card\\\">\\n        <h2 style=\\\"margin:0 0 6px 0\\\">What the selector changes</h2>\\n        <div class=\\\"muted-small\\\">The page updates a suggested micro‑sequence, the headline CTA copy, and the landing link so the first steps match the approach.</div>\\n\\n        <div style=\\\"margin-top:12px;display:flex;gap:12px;flex-wrap:wrap\\\">\\n          <div style=\\\"padding:12px;border-radius:10px;background:#fff;border:1px solid rgba(11,18,16,0.04);flex:1\\\">Personalized short tasks</div>\\n          <div style=\\\"padding:12px;border-radius:10px;background:#fff;border:1px solid rgba(11,18,16,0.04);flex:1\\\">An immediate next step to try</div>\\n          <div style=\\\"padding:12px;border-radius:10px;background:#fff;border:1px solid rgba(11,18,16,0.04);flex:1\\\">Option to join a track based on results</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:1100px;margin:20px auto;padding:0 20px;color:var(--muted)\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> · {{PHONE}}</div>\\n  </footer>\\n\\n  <script>\\n    (function(){\\n      const mood = document.getElementById('mood');\\n      const title = document.getElementById('method-title');\\n      const copy = document.getElementById('method-copy');\\n      const cta = document.getElementById('sample');\\n\\n      const map = {\\n        flat: {name:'Energy Micro-Boost',desc:'Three small actions to raise baseline energy across the day: a light movement sequence on wake, a midday anchor, and a short evening pause. Try 7 days.',ctaText: '{{PRIMARY_CTA_LABEL}}: Try Micro-Boost',slug:'micro-boost'},\\n        wired: {name:'Calm Anchor',desc:'A compact breathing + pause sequence to lower reactivity and help re-focus. Practice at two natural breaks today and record a short note.',ctaText: '{{PRIMARY_CTA_LABEL}}: Start Calm Anchor',slug:'calm-anchor'},\\n        overwhelmed: {name:'Sort-and-Shorten',desc:'A 48‑hour triage: pick the top three priorities and use 25‑minute focused work blocks with recovery rituals between each.',ctaText: '{{PRIMARY_CTA_LABEL}}: Begin Triage',slug:'triage'},\\n        peppy: {name:'Focused Sprint',desc:'Channel higher energy into purposeful sprints: 45 minute work blocks, clearer breaks, and brief post-sprint reflection.',ctaText: '{{PRIMARY_CTA_LABEL}}: Launch Sprint',slug:'sprint'},\\n        sleepy: {name:'Evening Setdown',desc:'A short wind-down routine to cue sleep onset: dim lights, a 12-minute sequence of low-activation tasks, and a 10-minute reflection.',ctaText: '{{PRIMARY_CTA_LABEL}}: Prep for Rest',slug:'setdown'}\\n      };\\n\\n      function update(){\\n        const m = mood.value;\\n        const item = map[m];\\n        title.textContent = item.name;\\n        copy.textContent = item.desc;\\n        cta.textContent = item.ctaText;\\n        cta.href = '{{PRIMARY_CTA_URL}}?method=' + encodeURIComponent(item.slug);\\n      }\\n\\n      mood.addEventListener('change', update);\\n      // initialize\\n      update();\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Tracks — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#ffffff;--muted:#4b5a57;--accent:#256a56;--card:#fbfffd}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto;background:var(--bg);color:#081014}\\n    header{padding:16px 20px;border-bottom:1px solid rgba(8,16,20,0.04);background:linear-gradient(180deg,rgba(37,106,86,0.03),transparent),url('assets/img/pattern.svg')}\\n    .nav{max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    main{max-width:1100px;margin:28px auto;padding:0 20px}\\n    .grid{display:grid;grid-template-columns:1fr 340px;gap:22px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 8px 26px rgba(10,16,14,0.04)}\\n    h1{margin:0 0 8px 0;font-size:22px}\\n    .muted{color:var(--muted)}\\n    .goals{display:flex;flex-direction:column;gap:8px;margin-top:10px}\\n    label{display:flex;gap:10px;align-items:center}\\n    .meter{height:12px;background:#e9f6f2;border-radius:8px;overflow:hidden;margin-top:12px}\\n    .meter > i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),#56a78f);width:0}\\n    .path{margin-top:14px;display:grid;grid-template-columns:repeat(6,1fr);gap:8px}\\n    .step{background:#fff;padding:10px;border-radius:8px;border:1px solid rgba(11,18,16,0.04);text-align:center}\\n    .cta{display:inline-block;margin-top:12px;background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{max-width:1100px;margin:26px auto;padding:0 20px;color:var(--muted);font-size:13px}\\n    @media (max-width:900px){.grid{grid-template-columns:1fr}} \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div style=\\\"display:flex;gap:18px;align-items:center\\\">\\n        <div style=\\\"font-weight:700;color:var(--accent)\\\">{{BUSINESS_NAME}}</div>\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"services.html\\\">Methods</a>\\n        <a href=\\\"programs.html\\\">Tracks</a>\\n        <a href=\\\"pricing.html\\\">Membership</a>\\n      </div>\\n      <div>\\n        <a href=\\\"testimonials.html\\\">Stories</a>\\n        <a href=\\\"book.html\\\">Quick Book</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </div>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"grid\\\">\\n      <section class=\\\"card\\\">\\n        <h1>Build a focused 30‑day path</h1>\\n        <div class=\\\"muted\\\">Select the goals you want to work toward and see a simple week-by-week path designed to be tested and adjusted.</div>\\n\\n        <form id=\\\"goalsForm\\\" style=\\\"margin-top:12px\\\">\\n          <div class=\\\"goals\\\">\\n            <label><input type=\\\"checkbox\\\" name=\\\"goals\\\" value=\\\"sleep\\\"> Improve sleep timing</label>\\n            <label><input type=\\\"checkbox\\\" name=\\\"goals\\\" value=\\\"energy\\\"> More steady daytime energy</label>\\n            <label><input type=\\\"checkbox\\\" name=\\\"goals\\\" value=\\\"focus\\\"> Stronger focused work blocks</label>\\n            <label><input type=\\\"checkbox\\\" name=\\\"goals\\\" value=\\\"movement\\\"> Consistent short movement\\n            </label>\\n            <label><input type=\\\"checkbox\\\" name=\\\"goals\\\" value=\\\"habits\\\"> Lock a new small habit</label>\\n          </div>\\n\\n          <div style=\\\"display:flex;gap:10px;margin-top:12px\\\">\\n            <button type=\\\"button\\\" id=\\\"previewBtn\\\" class=\\\"cta\\\">Preview 30-day path</button>\\n            <a id=\\\"joinLink\\\" class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"background:#fff;color:var(--accent);border:1px solid rgba(37,106,86,0.12)\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          </div>\\n        </form>\\n\\n        <div class=\\\"meter\\\" aria-hidden=\\\"true\\\" style=\\\"margin-top:12px\\\"><i id=\\\"meterFill\\\" style=\\\"width:0%\\\"></i></div>\\n        <div id=\\\"summary\\\" class=\\\"muted\\\" style=\\\"margin-top:10px\\\">Select goals to see a tailored 30‑day track and estimated adoption score.</div>\\n\\n        <div id=\\\"pathContainer\\\" class=\\\"path\\\" role=\\\"list\\\" aria-label=\\\"30 day path\\\" style=\\\"margin-top:12px\\\"></div>\\n\\n      </section>\\n\\n      <aside class=\\\"card\\\">\\n        <div style=\\\"font-weight:700\\\">Focused Tracks — membership framing</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Tracks are included in membership; this page plans the first 30 days. Choose a track to add it to your plan.</div>\\n\\n        <div style=\\\"margin-top:12px;display:grid;gap:10px\\\">\\n          <div style=\\\"padding:12px;border-radius:10px;background:#fff;border:1px solid rgba(11,18,16,0.04)\\\"><strong>Steady Energy Track</strong><div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Micro-sequences for daytime balance.</div></div>\\n          <div style=\\\"padding:12px;border-radius:10px;background:#fff;border:1px solid rgba(11,18,16,0.04)\\\"><strong>Sleep Onset Track</strong><div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Evening rituals and light exposure cues.</div></div>\\n          <div style=\\\"padding:12px;border-radius:10px;background:#fff;border:1px solid rgba(11,18,16,0.04)\\\"><strong>Focus & Recovery</strong><div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Sprints and restorative breaks for deeper work.</div></div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px\\\">\\n          <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:1100px;margin:18px auto;padding:0 20px;color:var(--muted)\\\">Serving {{CITY}}, {{STATE}} · {{PHONE}}</div>\\n  </footer>\\n\\n  <script>\\n    (function(){\\n      const preview = document.getElementById('previewBtn');\\n      const meterFill = document.getElementById('meterFill');\\n      const path = document.getElementById('pathContainer');\\n      const summary = document.getElementById('summary');\\n      const joinLink = document.getElementById('joinLink');\\n\\n      function generatePath(selected){\\n        // produce 6 milestones (roughly weekly) for a 30-day outline\\n        const seeds = [];\\n        if(selected.includes('sleep')) seeds.push('Evening setdown','Consistent bedtime','Optimize light','Reduce caffeine','Sleep review','Stabilize sleep');\\n        if(selected.includes('energy')) seeds.push('Morning anchor','Midday pause','Light movement','Hydration plan','Energy review','Rhythm refine');\\n        if(selected.includes('focus')) seeds.push('Sprint plan','Clear task list','Two focus blocks','Recovery habit','Focus review','Sustain practice');\\n        if(selected.includes('movement')) seeds.push('Daily 7-min','Add short walk','Strength mini-loop','Stretch routine','Movement review','Routine steady');\\n        if(selected.includes('habits')) seeds.push('Tiny habit start','Repeat & cue','Stack habit','Track small wins','Habit review','Habit steady');\\n\\n        // if nothing selected, fallback\\n        if(seeds.length===0) seeds.push('Pick a goal to start','Define a tiny next step','Try a 5-minute action','Record one outcome','Reflect on progress','Decide next move');\\n\\n        // reduce to six items\\n        const out = [];\\n        for(let i=0;i<6;i++){\\n          out.push(seeds[i % seeds.length]);\\n        }\\n        return out;\\n      }\\n\\n      preview.addEventListener('click', function(){\\n        const checked = Array.from(document.querySelectorAll('input[name=\\\"goals\\\"]:checked')).map(i=>i.value);\\n        const pathItems = generatePath(checked);\\n\\n        // meter: compute coverage score\\n        const score = Math.min(100, Math.max(12, 20 * checked.length + (checked.includes('habits')?10:0)));\\n        meterFill.style.width = score + '%';\\n\\n        // summary text\\n        summary.textContent = checked.length ? ('A '+score+'% adoption estimate based on selected goals: '+checked.join(', ')) : 'No goals selected. Choose one to generate a 30-day track.';\\n\\n        // render path\\n        path.innerHTML = '';\\n        pathItems.forEach(function(text,idx){\\n          const el = document.createElement('div');\\n          el.className = 'step';\\n          el.setAttribute('role','listitem');\\n          el.innerHTML = '<div style=\\\"font-weight:700\\\">Week '+(idx+1)+'</div><div style=\\\"margin-top:6px;font-size:13px;color:var(--muted)\\\">'+text+'</div>';\\n          path.appendChild(el);\\n        });\\n\\n        // update join link with query\\n        joinLink.href = '{{PRIMARY_CTA_URL}}?goals=' + encodeURIComponent(checked.join(','));\\n        joinLink.textContent = checked.length ? ('Join & start ('+checked.length+' goals)') : '{{PRIMARY_CTA_LABEL}}';\\n      });\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
