          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About • {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfcfb;--ink:#0b0d0c;--muted:#6b6f6b;--accent:#6aa84f;--radius:10px;font-family:Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;}\\n    html,body{height:100%}body{margin:0;background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 44px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:20px;font-weight:600}\\n    .container{max-width:980px;margin:48px auto;padding:0 28px}\\n    .hero{display:grid;grid-template-columns:1fr 320px;gap:36px;align-items:center}\\n    .eyebrow{color:var(--accent);font-weight:700;margin-bottom:8px}\\n    h1{font-size:30px;line-height:1.05;margin:0 0 12px}\\n    p.lead{color:var(--muted);margin:0 0 18px}\\n    .card{background:#fff;border-radius:var(--radius);padding:22px;box-shadow:0 6px 22px rgba(15,18,16,0.04)}\\n    .avatar{display:flex;align-items:center;gap:14px}\\n    .avatar svg{width:72px;height:72px;border-radius:10px;background:linear-gradient(180deg,#f4fbf1 0%, #e9f6e0 100%);padding:10px}\\n    .cta{display:inline-block;margin-top:16px;padding:12px 18px;background:var(--accent);color:white;border-radius:8px;text-decoration:none;font-weight:700}\\n    section{margin-top:28px}\\n    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18px}\\n    .muted{color:var(--muted)}\\n    footer{padding:40px 44px;color:var(--muted);font-size:14px}\\n    .micro{display:flex;gap:12px;flex-wrap:wrap}\\n    .pill{background:#fff;padding:10px 12px;border-radius:999px;box-shadow:0 4px 14px rgba(12,16,12,0.03)}\\n    .faq{margin-top:18px}\\n    /* Minimal responsive */\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.grid-2{grid-template-columns:1fr}.avatar svg{width:56px;height:56px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:14px\\\">\\n      <div style=\\\"width:44px;height:44px;border-radius:8px;background:linear-gradient(90deg,#eef8ee,#f7fff7);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent)\\\">W</div>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Pathways</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <div class=\\\"eyebrow\\\">About • {{BUSINESS_NAME}}</div>\\n        <h1>Thoughtful coaching for a calmer, steadier life</h1>\\n        <p class=\\\"lead\\\">I blend gentle spiritual guidance with practical habit design. Expect rituals that settle the nervous system and clear frameworks that shape everyday choices—no fad diets, no miracle promises, just measurable shifts.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n\\n        <section style=\\\"margin-top:22px\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">My coaching lens</h3>\\n          <p class=\\\"muted\\\">I work from a three-part framework: presence, pattern, practice. Presence refines attention; pattern reveals what’s running in the background; practice rewires the habits that matter most. Each conversation centers dignity and agency.</p>\\n        </section>\\n\\n        <section class=\\\"card\\\" style=\\\"margin-top:22px\\\">\\n          <strong>Lead magnet</strong>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Grab the 7-day Rest Rhythm — a short guide to reframe sleep, movement, and micro-rest. Download when you book a free clarity call.</p>\\n        </section>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <div class=\\\"avatar\\\">\\n          <!-- avatar svg embedded (unique to this template) -->\\n          <svg viewBox=\\\"0 0 120 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n            <rect rx=\\\"16\\\" width=\\\"120\\\" height=\\\"120\\\" fill=\\\"#f4fbf1\\\" />\\n            <g transform=\\\"translate(16,14)\\\" fill=\\\"none\\\" stroke=\\\"#6aa84f\\\" stroke-width=\\\"3\\\">\\n              <ellipse cx=\\\"44\\\" cy=\\\"34\\\" rx=\\\"24\\\" ry=\\\"18\\\" fill=\\\"#fff\\\" stroke=\\\"none\\\" />\\n              <path d=\\\"M12 88c18-18 56-18 74 0\\\" stroke-linecap=\\\"round\\\" opacity=\\\"0.9\\\" />\\n            </g>\\n          </svg>\\n          <div>\\n            <div style=\\\"font-weight:800\\\">{{COACH_NAME}}</div>\\n            <div class=\\\"muted\\\">{{CREDENTIALS}}</div>\\n            <div style=\\\"margin-top:8px\\\"><a href=\\\"book.html\\\" class=\\\"cta\\\" style=\\\"background:transparent;color:var(--accent);border:1px solid rgba(106,168,79,0.12);\\\">Schedule a clarity call</a></div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px\\\" class=\\\"muted\\\">Based in {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </aside>\\n    </section>\\n\\n    <section>\\n      <h3 style=\\\"margin-bottom:8px\\\">Quick diagnostic — where to begin</h3>\\n      <p class=\\\"muted\\\">A simple three-question check to orient our first session. This is reflective, not clinical.</p>\\n      <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n        <ol style=\\\"margin:0;padding-left:18px;color:var(--muted)\\\">\\n          <li>What drains you most in a typical week?</li>\\n          <li>Which small change would feel like relief this month?</li>\\n          <li>On a scale of 1–10, how steady is your daily rhythm?</li>\\n        </ol>\\n        <a href=\\\"book.html\\\" class=\\\"cta\\\" style=\\\"display:inline-block;margin-top:12px\\\">Request a diagnostic call</a>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"grid-2\\\">\\n      <div>\\n        <h3 style=\\\"margin-bottom:8px\\\">Microscopic habits that matter</h3>\\n        <p class=\\\"muted\\\">Tiny, repeatable choices compound. We start with micro-habits—30–90 second rituals that anchor transitions and reduce decision friction.</p>\\n        <div class=\\\"micro\\\" style=\\\"margin-top:12px\\\">\\n          <div class=\\\"pill\\\">Wake pause: 60s breath</div>\\n          <div class=\\\"pill\\\">Pre-meal mindful chew</div>\\n          <div class=\\\"pill\\\">Evening 3-min unwind</div>\\n          <div class=\\\"pill\\\">Phone-off ritual</div>\\n        </div>\\n      </div>\\n\\n      <div>\\n        <h3 style=\\\"margin-bottom:8px\\\">Your first plan</h3>\\n        <p class=\\\"muted\\\">A four-week introduction: rhythm mapping, two micro-habits to practice, and a weekly reflection. We track progress with simple prompts, not relentless metrics.</p>\\n        <div style=\\\"margin-top:12px\\\"><a href=\\\"programs.html\\\" class=\\\"cta\\\" style=\\\"background:#fff;color:var(--accent);border:1px solid rgba(106,168,79,0.12);\\\">Explore introductory path</a></div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px\\\">\\n      <h3 style=\\\"margin-bottom:8px\\\">Investment (framed as an invitation)</h3>\\n      <div class=\\\"card\\\">\\n        <p class=\\\"muted\\\">I offer tiered support to match how bold you want to be. Coaching is an investment in the structures that hold your life—time, attention, and tiny rituals.</p>\\n        <ul class=\\\"muted\\\" style=\\\"margin-top:10px\\\">\\n          <li>Intro Path: 4 weeks, focused habit set — starting at $450</li>\\n          <li>Deep Tone: 3 months, weekly coaching — starting at $1,650</li>\\n          <li>Sustained Way: 6 months, personalized rhythm design — inquire for bespoke pricing</li>\\n        </ul>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px;text-align:center\\\">\\n      <div class=\\\"card\\\" style=\\\"display:inline-block;text-align:left;max-width:640px\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">Ready to begin?</h3>\\n        <p class=\\\"muted\\\" style=\\\"margin:0 0 12px\\\">Book a free clarity conversation and receive the 7-day Rest Rhythm guide.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"container\\\">© {{BUSINESS_NAME}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Services • {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#ffffff;--ink:#06110f;--muted:#5e635e;--accent:#4b9a6a;--glass:rgba(11,13,12,0.04);--radius:12px;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto}\\n    body{margin:0;background:var(--bg);color:var(--ink);}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:26px 40px}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .wrap{max-width:1040px;margin:36px auto;padding:0 24px}\\n    .hero{padding:44px;background:linear-gradient(180deg,#fbfff9 0%,#ffffff 100%);border-radius:14px;display:flex;gap:28px;align-items:center}\\n    .hero .left{flex:1}\\n    h1{margin:0;font-size:28px}\\n    .lead{color:var(--muted);margin-top:8px}\\n    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:20px}\\n    .card{background:var(--glass);padding:18px;border-radius:12px}\\n    .price{font-weight:800;color:var(--accent);margin-top:10px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;background:var(--accent);color:white;border-radius:10px;text-decoration:none}\\n    .faq{margin-top:22px;background:#fff;padding:18px;border-radius:12px}\\n    @media (max-width:920px){.cards{grid-template-columns:1fr}.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div style=\\\"width:42px;height:42px;border-radius:10px;background:linear-gradient(180deg,#f7fff7,#ecf8ee);display:flex;align-items:center;justify-content:center;color:var(--accent);font-weight:800\\\">{{BUSINESS_NAME|slice:0:1}}</div>\\n      <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Programs</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"left\\\">\\n        <div style=\\\"color:var(--accent);font-weight:800\\\">Offerings</div>\\n        <h1>Practical containers for lasting ease</h1>\\n        <p class=\\\"lead\\\">Each service is a luminous frame for practice: clear intentions, tiny habits, and reflective checkpoints. Rooted in compassion and steady routine.</p>\\n\\n        <div style=\\\"margin-top:14px\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start with a clarity call</a>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"width:260px;text-align:center\\\">\\n        <!-- unique pattern svg for this template -->\\n        <svg viewBox=\\\"0 0 100 100\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\" style=\\\"width:160px;height:160px\\\">\\n          <rect width=\\\"100\\\" height=\\\"100\\\" rx=\\\"18\\\" fill=\\\"#f6fdf6\\\" />\\n          <g fill=\\\"none\\\" stroke=\\\"#cbeed0\\\" stroke-width=\\\"2\\\">\\n            <circle cx=\\\"50\\\" cy=\\\"36\\\" r=\\\"16\\\" opacity=\\\"0.9\\\" />\\n            <path d=\\\"M18 74c18-14 56-14 64 0\\\" stroke-linecap=\\\"round\\\" />\\n          </g>\\n        </svg>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Sessions are remote + flexible</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Core services</h2>\\n      <p class=\\\"lead\\\">Choose a shape of support. Each service includes a habit blueprint and accountability prompts.</p>\\n\\n      <div class=\\\"cards\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Clarity Session</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">A single ninety-minute mapping session to identify pressure points and one micro-habit to begin with.</div>\\n          <div class=\\\"price\\\">$225</div>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Book a session</a>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <strong>Monthly Support</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Four 50-minute sessions, mid-week check-ins, and habit scaffolds for steady practice.</div>\\n          <div class=\\\"price\\\">$650 / month</div>\\n          <a class=\\\"cta\\\" href=\\\"programs.html\\\">View Programs</a>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <strong>Short Course — Rhythm Reset</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">A 6-week group cohort that teaches ritual design and daily micro-habits for energy management.</div>\\n          <div class=\\\"price\\\">$360 cohort</div>\\n          <a class=\\\"cta\\\" href=\\\"programs.html\\\">Join next cohort</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px\\\" class=\\\"faq\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Questions people ask</h3>\\n      <div style=\\\"color:var(--muted)\\\">\\n        <strong>Do you use assessments?</strong>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Yes — brief reflective prompts and a rhythm map. No medical tests.</div>\\n        <strong style=\\\"margin-top:10px;display:block\\\">How often will I get homework?</strong>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Short, actionable practices—usually under five minutes per day.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px;display:flex;gap:18px;align-items:center;justify-content:space-between\\\">\\n      <div>\\n        <h3 style=\\\"margin:0\\\">Micro-habits & frameworks</h3>\\n        <p class=\\\"muted\\\" style=\\\"margin:6px 0 0\\\">We teach three micro-habit families: transition anchors, energy valves, and restorative rituals.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px\\\">\\n      <h3 style=\\\"margin:0\\\">Investment framing</h3>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Think of coaching as structural support: it helps create dependable conditions so you can do your life better, not harder.</p>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"padding:30px 40px;color:var(--muted)\\\">\\n    <div style=\\\"max-width:1040px;margin:0 auto\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}} • {{CITY}}, {{STATE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Programs • {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfdfb;--ink:#08110f;--muted:#58605a;--accent:#7abf77;--card:#ffffff;--radius:14px;font-family:Inter, system-ui, -apple-system, 'Segoe UI'}\\n    body{margin:0;background:var(--bg);color:var(--ink)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:22px 36px}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none}\\n    .wrap{max-width:980px;margin:36px auto;padding:0 22px}\\n    .intro{display:flex;gap:24px;align-items:center}\\n    h1{margin:0;font-size:30px}\\n    .muted{color:var(--muted)}\\n    .menu{display:flex;gap:12px;margin-top:12px}\\n    .btn{padding:10px 14px;border-radius:10px;background:var(--card);box-shadow:0 6px 20px rgba(12,16,12,0.04);text-decoration:none;color:var(--ink)}\\n    .paths{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:22px}\\n    .path{background:var(--card);padding:18px;border-radius:var(--radius)}\\n    .price{color:var(--accent);font-weight:800;margin-top:8px}\\n    .micro{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}\\n    .micro .chip{background:#f6fff7;padding:8px 10px;border-radius:999px;color:var(--accent);font-weight:700}\\n    footer{padding:36px 36px;color:var(--muted)}\\n    @media (max-width:780px){.paths{grid-template-columns:1fr}.intro{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div style=\\\"width:44px;height:44px;border-radius:10px;background:linear-gradient(180deg,#f1fbf0,#fefefc);display:flex;align-items:center;justify-content:center;font-weight:800;color:var(--accent)\\\">WC</div>\\n      <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Work With Me</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"intro\\\">\\n      <div>\\n        <div style=\\\"color:var(--accent);font-weight:800\\\">Programs</div>\\n        <h1>Paths for steady change</h1>\\n        <p class=\\\"muted\\\">Choose a path that meets you where you are—short-term resets to long-term containers for practice. All paths emphasize tiny habits, reflective tools, and weekly checkpoints.</p>\\n        <div class=\\\"menu\\\">\\n          <a class=\\\"btn\\\" href=\\\"#starter\\\">Starter</a>\\n          <a class=\\\"btn\\\" href=\\\"#deep\\\">Deep Tone</a>\\n          <a class=\\\"btn\\\" href=\\\"#cohort\\\">Cohort</a>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"width:220px;text-align:center\\\">\\n        <!-- unique hero svg for this template -->\\n        <svg viewBox=\\\"0 0 120 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\" style=\\\"width:140px;height:140px\\\">\\n          <rect width=\\\"120\\\" height=\\\"120\\\" rx=\\\"18\\\" fill=\\\"#f8fff8\\\" />\\n          <g fill=\\\"none\\\" stroke=\\\"#7abf77\\\" stroke-width=\\\"3\\\" transform=\\\"translate(8,8)\\\">\\n            <path d=\\\"M12 44c10-18 56-20 76 0\\\" stroke-linecap=\\\"round\\\" />\\n            <circle cx=\\\"42\\\" cy=\\\"38\\\" r=\\\"22\\\" opacity=\\\"0.85\\\" />\\n          </g>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"starter\\\" style=\\\"margin-top:30px\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <h2 style=\\\"margin:0\\\">Starter Path — Rhythm Map</h2>\\n        <div class=\\\"price\\\">$450</div>\\n      </div>\\n      <p class=\\\"muted\\\">A gentle 4-week container for mapping daily rhythms and introducing two micro-habits tailored to your life.</p>\\n      <div class=\\\"paths\\\">\\n        <div class=\\\"path\\\">\\n          <strong>What's included</strong>\\n          <ul class=\\\"muted\\\" style=\\\"margin-top:8px\\\">\\n            <li>1 mapping session (90 min)</li>\\n            <li>Two micro-habits with prompts</li>\\n            <li>Email support for 4 weeks</li>\\n          </ul>\\n          <div class=\\\"micro\\\">\\n            <div class=\\\"chip\\\">Wake Pause</div>\\n            <div class=\\\"chip\\\">Transition Anchor</div>\\n          </div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Enroll</a></div>\\n        </div>\\n\\n        <div class=\\\"path\\\">\\n          <strong>Outcomes</strong>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Clearer daily structure, lowered friction for rest, and a startable set of rituals you can keep indefinitely.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"deep\\\" style=\\\"margin-top:28px\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <h2 style=\\\"margin:0\\\">Deep Tone — Monthly Container</h2>\\n        <div class=\\\"price\\\">$1,650 / 3mo</div>\\n      </div>\\n      <p class=\\\"muted\\\">A three-month, live coaching container for re-patterning habits and building dependable systems that protect energy and focus.</p>\\n      <div style=\\\"margin-top:12px;display:flex;gap:12px;flex-wrap:wrap\\\">\\n        <div class=\\\"btn\\\">Weekly 50-min sessions</div>\\n        <div class=\\\"btn\\\">Weekly accountability</div>\\n        <div class=\\\"btn\\\">Momentum check-ins</div>\\n      </div>\\n      <div style=\\\"margin-top:12px;color:var(--muted)\\\">Payment plans available. Includes habit templates and a private message channel.</div>\\n    </section>\\n\\n    <section id=\\\"cohort\\\" style=\\\"margin-top:28px\\\">\\n      <h2 style=\\\"margin:0\\\">Group Cohort — Rhythm Reset</h2>\\n      <p class=\\\"muted\\\">A six-week guided cohort for ritual design. Great if you want community-held practice without full private coaching.</p>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px\\\">\\n        <div class=\\\"path\\\" style=\\\"flex:1\\\">\\n          <strong>Format</strong>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Weekly workshops, short daily prompts, and small-group breakout support.</p>\\n          <div class=\\\"price\\\">$360</div>\\n          <a class=\\\"btn\\\" href=\\\"contact.html\\\">Apply</a>\\n        </div>\\n        <div class=\\\"path\\\" style=\\\"flex:1\\\">\\n          <strong>Who it's for</strong>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">People ready to commit to steady small practices and mutual accountability.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px\\\">\\n      <h3 style=\\\"margin:0\\\">A short diagnostic to orient your path</h3>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Before we begin, you answer three short prompts. This helps place you in the right container quickly.</p>\\n      <div class=\\\"card\\\" style=\\\"background:#fff;padding:14px;border-radius:12px;margin-top:12px\\\">\\n        <ol style=\\\"margin:0;padding-left:18px;color:var(--muted)\\\">\\n          <li>What pattern do you want to shift most?</li>\\n          <li>What small practice could you sustain for 21 days?</li>\\n          <li>What feels most urgent right now?</li>\\n        </ol>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Start the diagnostic</a></div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px;display:flex;align-items:center;justify-content:space-between\\\">\\n      <div>\\n        <h3 style=\\\"margin:0\\\">Micro-habits spotlight</h3>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Each path centers on one micro-habit family that supports the wider change you want.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"pricing.html\\\">See full pricing</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:30px;background:linear-gradient(180deg,#f8fff8,transparent);padding:18px;border-radius:12px\\\">\\n      <h3 style=\\\"margin:0\\\">Ready to choose a path?</h3>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Book a clarity conversation so we can place you in the right container. The conversation is generous and practical.</p>\\n      <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:980px;margin:0 auto;padding:24px;color:var(--muted)\\\">Questions: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}} • Serving {{CITY}}, {{STATE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
