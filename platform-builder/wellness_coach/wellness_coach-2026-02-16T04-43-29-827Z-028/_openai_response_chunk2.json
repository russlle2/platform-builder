          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f1724;--card:#0b1220;--accent:#ff7a59;--muted:#9aa7bf;--glass:rgba(255,255,255,0.04);--radius:14px}\\n    *{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,Arial,sans-serif;background:linear-gradient(180deg,#071026 0%,#071827 60%);color:#e6eef8;-webkit-font-smoothing:antialiased}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:28px 36px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:54px;height:54px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#ffbf91);display:flex;align-items:center;justify-content:center;font-weight:700;color:#081022}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 12px;font-weight:600}\\n    nav a.primary{color:#081022;background:var(--accent);padding:10px 14px;border-radius:10px}\\n    main{padding:36px;max-width:1100px;margin:0 auto}\\n    .hero{display:flex;gap:28px;align-items:center;background:linear-gradient(90deg,rgba(255,255,255,0.03),transparent);padding:34px;border-radius:18px}\\n    .hero .left{flex:1}\\n    h1{margin:0 0 8px;font-size:32px;letter-spacing:-0.02em}\\n    p.lead{margin:0;color:var(--muted);line-height:1.45}\\n    .meta{margin-top:18px;display:flex;gap:12px;align-items:center}\\n    .cta{background:var(--accent);color:#081022;padding:10px 16px;border-radius:12px;text-decoration:none;font-weight:700}\\n    .card{background:var(--card);padding:18px;border-radius:14px;margin-top:18px}\\n    .values{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .value{background:var(--glass);padding:14px;border-radius:12px}\\n    .methods{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:22px}\\n    .faq{margin-top:20px}\\n    .testimonials{display:flex;flex-direction:column;gap:12px;margin-top:20px}\\n    footer{display:flex;justify-content:space-between;align-items:center;padding:24px 36px;margin-top:28px}\\n    .leadmag{display:flex;gap:8px}\\n    input[type=\\\"email\\\"]{padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,0.06);background:transparent;color:#eaf2ff}\\n    button{background:#12293a;color:#dff3ff;border:0;padding:10px 12px;border-radius:10px}\\n    /* playful decorative avatar */\\n    .avatar{width:240px;height:240px;border-radius:20px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#0b2b3a, #073241);box-shadow:0 8px 30px rgba(2,6,23,0.6)}\\n    .byline{font-weight:700;color:var(--accent);font-size:13px;margin-top:10px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">WC</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Work With Me</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"testimonials.html\\\">Stories</a>\\n      <a class=\\\"primary\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\" aria-labelledby=\\\"about-hero\\\">\\n      <div class=\\\"left\\\">\\n        <h1 id=\\\"about-hero\\\">Clarity, routines, and measurable wellbeing — built for busy people</h1>\\n        <p class=\\\"lead\\\">I'm {{COACH_NAME}} ({{CREDENTIALS}}). I help professionals in {{CITY}}, {{STATE}} translate intention into tiny daily wins so energy, focus, and calm compound over weeks — not months.</p>\\n        <div class=\\\"meta\\\">\\n          <a href=\\\"book.html\\\" class=\\\"cta\\\">Start a Conversation</a>\\n          <div style=\\\"color:var(--muted);font-weight:700\\\">or call <span style=\\\"color:#dff3ff\\\">{{PHONE}}</span></div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Philosophy</strong>\\n          <p style=\\\"margin:8px 0 0;color:var(--muted)\\\">We design daily systems around what you actually do, not perfect behaviors. Small shifts in habit architecture produce outsized outcomes.</p>\\n        </div>\\n      </div>\\n      <aside class=\\\"avatar\\\" aria-hidden=\\\"true\\\">\\n        <!-- unique inline avatar SVG for about.html -->\\n        <svg width=\\\"180\\\" height=\\\"180\\\" viewBox=\\\"0 0 120 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\">\\n          <defs>\\n            <linearGradient id=\\\"gA\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n              <stop offset=\\\"0\\\" stop-color=\\\"#ffd0ba\\\"/>\\n              <stop offset=\\\"1\\\" stop-color=\\\"#ff7a59\\\"/>\\n            </linearGradient>\\n          </defs>\\n          <rect x=\\\"6\\\" y=\\\"6\\\" width=\\\"108\\\" height=\\\"108\\\" rx=\\\"18\\\" fill=\\\"url(#gA)\\\" />\\n          <circle cx=\\\"60\\\" cy=\\\"46\\\" r=\\\"18\\\" fill=\\\"#081022\\\" opacity=\\\"0.9\\\" />\\n          <rect x=\\\"36\\\" y=\\\"72\\\" width=\\\"48\\\" height=\\\"18\\\" rx=\\\"6\\\" fill=\\\"#081022\\\" opacity=\\\"0.9\\\" />\\n        </svg>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"values\\\" aria-labelledby=\\\"values-title\\\">\\n      <h2 id=\\\"values-title\\\" style=\\\"grid-column:1/-1;margin:0 0 8px\\\">Core commitments</h2>\\n      <div class=\\\"value\\\"><strong>Action over analysis</strong><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">We ship one change and measure impact — then iterate.</p></div>\\n      <div class=\\\"value\\\"><strong>Context-first</strong><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Your schedule, energy cycles, and constraints are the design inputs.</p></div>\\n      <div class=\\\"value\\\"><strong>Evidence-light</strong><p style=\\\"margin:6px 0 0;color:var(--muted)\\\">We track behaviors and outcomes without medical promises; progress is practical.</p></div>\\n    </section>\\n\\n    <section class=\\\"methods\\\" aria-labelledby=\\\"methods-title\\\">\\n      <div>\\n        <h3 id=\\\"methods-title\\\">How coaching actually works</h3>\\n        <ol style=\\\"color:var(--muted);margin-top:10px\\\">\\n          <li><strong>Baseline mapping</strong> — we log 7 days to reveal leverage points.</li>\\n          <li><strong>Micro-habit design</strong> — 3 tiny experiments you can do today.</li>\\n          <li><strong>Weekly focus sprints</strong> — short cycles to build momentum.</li>\\n          <li><strong>Outcome review</strong> — data + reflection to refine the next sprint.</li>\\n        </ol>\\n        <div style=\\\"margin-top:12px\\\" class=\\\"card\\\">\\n          <strong>Tools I use</strong>\\n          <p style=\\\"margin:8px 0 0;color:var(--muted)\\\">Daily habit trackers, short surveys, brief voice reflections, and calendar architecture.</p>\\n        </div>\\n      </div>\\n      <aside>\\n        <h4 style=\\\"margin:0 0 10px\\\">Quick reassurance</h4>\\n        <div style=\\\"background:var(--glass);padding:12px;border-radius:10px;color:var(--muted)\\\">Coaching is confidential, non-judgmental, and focused on habits. We won’t replace medical advice — we support reliable routines.</div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"faq card\\\" aria-labelledby=\\\"faq-title\\\">\\n      <h4 id=\\\"faq-title\\\">Common questions</h4>\\n      <details style=\\\"margin-top:8px;color:var(--muted)\\\"><summary style=\\\"cursor:pointer\\\">Will this take hours each week?</summary><div style=\\\"margin-top:8px\\\">No — typical weekly commitments are 30–60 minutes plus micro-actions that take 2–10 minutes daily.</div></details>\\n      <details style=\\\"margin-top:8px;color:var(--muted)\\\"><summary style=\\\"cursor:pointer\\\">What if my schedule is irregular?</summary><div style=\\\"margin-top:8px\\\">We design windows that fit unpredictable days and make momentum resilient to interruptions.</div></details>\\n    </section>\\n\\n    <section class=\\\"testimonials\\\">\\n      <h4 style=\\\"margin:8px 0 4px\\\">Client outcomes</h4>\\n      <div style=\\\"background:linear-gradient(90deg,rgba(255,255,255,0.02),transparent);padding:12px;border-radius:10px\\\">“I gained two extra focused hours each week and finally sleep through the night on workdays.” — Senior PM</div>\\n      <div style=\\\"background:linear-gradient(90deg,rgba(255,255,255,0.02),transparent);padding:12px;border-radius:10px\\\">“My energy spikes feel engineered, not accidental.” — Founder</div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:20px\\\" aria-labelledby=\\\"lead-title\\\">\\n      <h4 id=\\\"lead-title\\\">Free guide: 7-Day Reset for Busy People</h4>\\n      <p style=\\\"color:var(--muted);margin:8px 0\\\">A concise workbook and 7 micro-actions to reset routine and focus. Delivered as a PDF and two follow-up prompts via email.</p>\\n      <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" style=\\\"display:flex;gap:8px;align-items:center\\\">\\n        <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Your email\\\" aria-label=\\\"email\\\" required />\\n        <button type=\\\"submit\\\">Send the Guide</button>\\n      </form>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"color:var(--muted)\\\">© <span style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</span> — {{CITY}}, {{STATE}}</div>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <a href=\\\"contact.html\\\" style=\\\"color:var(--muted)\\\">Contact</a>\\n      <a href=\\\"book.html\\\" class=\\\"cta\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff7f4;--ink:#081022;--accent:#ff8a5b;--muted:#6b7888;--card:#fff;padding:0}\\n    body{margin:0;font-family:Inter,system-ui,Arial,sans-serif;background:var(--bg);color:var(--ink)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:22px 28px}\\n    .brand{font-weight:900}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 10px}\\n    nav a.work{color:var(--ink);font-weight:700}\\n    main{max-width:1100px;margin:0 auto;padding:28px}\\n    .intro{display:flex;gap:24px;align-items:center}\\n    h1{margin:0;font-size:30px}\\n    .sub{color:var(--muted);margin-top:6px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:20px}\\n    .services-list{display:grid;gap:12px}\\n    .service{background:linear-gradient(180deg,#fff,#fff7f0);padding:16px;border-radius:12px;border:1px solid rgba(8,16,34,0.04)}\\n    .aside-card{background:#fff;padding:16px;border-radius:12px;border:1px solid rgba(8,16,34,0.06)}\\n    .btn{background:var(--accent);border-radius:10px;padding:10px 12px;color:white;text-decoration:none;font-weight:700}\\n    .pattern{opacity:0.08}\\n    .methods small{display:block;color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a class=\\\"work\\\" href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"intro\\\">\\n      <div>\\n        <h1>Services built around reliable habits</h1>\\n        <p class=\\\"sub\\\">Short-term and ongoing support to build small, repeatable actions that stack into lasting change.</p>\\n      </div>\\n      <div style=\\\"margin-left:auto;text-align:right;color:var(--muted)\\\">\\n        <div style=\\\"font-weight:800\\\">{{COACH_NAME}}, {{CREDENTIALS}}</div>\\n        <div style=\\\"font-size:13px\\\">Serving {{CITY}}, {{STATE}}</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"grid\\\">\\n      <div>\\n        <div class=\\\"services-list\\\" aria-label=\\\"services offerings\\\">\\n          <div class=\\\"service\\\">\\n            <h3 style=\\\"margin:0\\\">Rapid Reset Session</h3>\\n            <p style=\\\"margin:6px 0;color:var(--muted)\\\">A focused 60-minute session to unblock your week and create three immediate habits to try for seven days.</p>\\n            <div style=\\\"margin-top:8px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Book a Reset</a></div>\\n          </div>\\n\\n          <div class=\\\"service\\\">\\n            <h3 style=\\\"margin:0\\\">Habit Architecture Review</h3>\\n            <p style=\\\"margin:6px 0;color:var(--muted)\\\">We audit your calendar, sleep, and energy windows to place leverage behaviors where they stick.</p>\\n            <div style=\\\"margin-top:8px\\\"><a class=\\\"btn\\\" href=\\\"contact.html\\\">Request Audit</a></div>\\n          </div>\\n\\n          <div class=\\\"service\\\">\\n            <h3 style=\\\"margin:0\\\">Micro-Accountability Blocks</h3>\\n            <p style=\\\"margin:6px 0;color:var(--muted)\\\">Short, recurring check-ins and habit nudges to keep momentum between sessions.</p>\\n            <div style=\\\"margin-top:8px\\\"><a class=\\\"btn\\\" href=\\\"programs.html\\\">Explore Blocks</a></div>\\n          </div>\\n        </div>\\n\\n        <section class=\\\"methods card\\\" style=\\\"margin-top:18px;padding:14px;border-radius:10px;background:linear-gradient(180deg,#fff, #fff9f7);\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Our approach</h4>\\n          <small>Practical frameworks you can start today</small>\\n          <ul style=\\\"color:var(--muted);margin-top:10px;line-height:1.5\\\">\\n            <li><strong>Leverage Sculpting</strong> — find the smallest behavior that unlocks the biggest return.</li>\\n            <li><strong>Time-Boxing</strong> — schedule moments, not vague intentions.</li>\\n            <li><strong>Signal Stacking</strong> — pair new habits with reliable cues.</li>\\n          </ul>\\n        </section>\\n\\n      </div>\\n\\n      <aside class=\\\"aside-card\\\">\\n        <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n          <!-- unique decorative pattern SVG for services.html -->\\n          <svg width=\\\"64\\\" height=\\\"64\\\" viewBox=\\\"0 0 64 64\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"pattern\\\" aria-hidden=\\\"true\\\">\\n            <rect x=\\\"4\\\" y=\\\"4\\\" width=\\\"56\\\" height=\\\"56\\\" rx=\\\"12\\\" fill=\\\"#ff8a5b\\\"/>\\n            <circle cx=\\\"20\\\" cy=\\\"20\\\" r=\\\"6\\\" fill=\\\"#fff\\\" opacity=\\\"0.9\\\"/>\\n            <circle cx=\\\"44\\\" cy=\\\"44\\\" r=\\\"6\\\" fill=\\\"#fff\\\" opacity=\\\"0.9\\\"/>\\n          </svg>\\n          <div>\\n            <strong>Lead Magnet</strong>\\n            <div style=\\\"color:var(--muted);font-size:13px;margin-top:6px\\\">Download the 10-minute habit planner — a quick template to identify one weekly focus.</div>\\n          </div>\\n        </div>\\n\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" style=\\\"margin-top:12px;display:flex;gap:6px\\\">\\n          <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Email\\\" style=\\\"flex:1;padding:8px;border-radius:8px;border:1px solid #e6e6e6\\\" required />\\n          <button style=\\\"background:var(--accent);color:#fff;border:0;padding:8px 10px;border-radius:8px\\\">Get It</button>\\n        </form>\\n\\n        <div style=\\\"margin-top:14px;border-top:1px solid #f1e9e6;padding-top:12px\\\">\\n          <strong style=\\\"display:block\\\">Objections (quick answers)</strong>\\n          <p style=\\\"margin:8px 0 0;color:var(--muted)\\\"><strong>Too busy?</strong> Micro-actions are designed to fit in gaps, not replace days. <a href=\\\"programs.html\\\">See paths</a>.</p>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h4 style=\\\"margin:0 0 10px\\\">Client note</h4>\\n      <div style=\\\"background:#fff;padding:12px;border-radius:10px;border:1px solid rgba(8,16,34,0.04);color:var(--muted)\\\">\\\"After a single reset my weekly focus doubled — I finally said no to busywork.\\\" — Product Lead</div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px;padding:14px;border-radius:12px;background:#fff;border:1px solid rgba(8,16,34,0.04)\\\">\\n      <h4 style=\\\"margin:0 0 8px\\\">Next step</h4>\\n      <p style=\\\"color:var(--muted);margin:0 0 10px\\\">Not sure which service? Book a 15-minute clarifying call so we can match you to the right format.</p>\\n      <a class=\\\"btn\\\" href=\\\"book.html\\\">Book a 15-minute Call</a>\\n    </section>\\n\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071225;--card:#081828;--accent:#ffb86b;--muted:#9fb3c8}\\n    body{margin:0;font-family:Inter,system-ui,Arial,sans-serif;background:linear-gradient(180deg,#061820 0%,#071827 100%);color:#eaf6ff}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:24px 32px}\\n    .brand{font-weight:900}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 8px}\\n    nav a.paths{color:var(--accent);font-weight:800}\\n    main{max-width:1100px;margin:0 auto;padding:28px}\\n    .hero{padding:22px;border-radius:16px;background:linear-gradient(90deg,rgba(255,184,107,0.06),transparent)}\\n    h1{margin:0;font-size:30px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    .tier{background:linear-gradient(180deg,#071828,#082033);padding:16px;border-radius:12px;border:1px solid rgba(255,184,107,0.06)}\\n    .price{font-size:20px;color:var(--accent);font-weight:800}\\n    .cta{background:var(--accent);color:#071225;padding:8px 12px;border-radius:10px;text-decoration:none;font-weight:800}\\n    .faq{background:rgba(255,255,255,0.03);padding:12px;border-radius:10px;margin-top:12px}\\n    .ripple{opacity:0.06}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Who I Am</a>\\n      <a class=\\\"paths\\\" href=\\\"programs.html\\\">Programs</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\" aria-labelledby=\\\"prog-hero\\\">\\n      <h1 id=\\\"prog-hero\\\">Structured paths to sustainable habits</h1>\\n      <p style=\\\"color:var(--muted);margin-top:8px\\\">Choose a path based on the time you have and the velocity you want. All paths emphasize measurable habit wins and weekly review cycles.</p>\\n    </section>\\n\\n    <section class=\\\"grid\\\">\\n      <div>\\n        <div class=\\\"tier\\\">\\n          <h3 style=\\\"margin:0\\\">Foundations Sprint — 4 weeks</h3>\\n          <div class=\\\"price\\\">$599</div>\\n          <p style=\\\"color:var(--muted);margin-top:8px\\\">Ideal for someone who needs immediate structure: baseline mapping, three micro-habit experiments, and two coaching sessions.</p>\\n          <ul style=\\\"color:var(--muted);margin-top:8px\\\">\\n            <li>7-day baseline</li>\\n            <li>Single-week sprint planning</li>\\n            <li>Email support for 4 weeks</li>\\n          </ul>\\n          <div style=\\\"margin-top:10px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve a spot</a></div>\\n        </div>\\n\\n        <div class=\\\"tier\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin:0\\\">Momentum Path — 3 months</h3>\\n          <div class=\\\"price\\\">$1,750 (3 payments of $600)</div>\\n          <p style=\\\"color:var(--muted);margin-top:8px\\\">For compounding change: monthly review sessions, bi-weekly check-ins, and habit tracking templates to sustain growth.</p>\\n          <ul style=\\\"color:var(--muted);margin-top:8px\\\">\\n            <li>Monthly planning & review</li>\\n            <li>Bi-weekly 30-minute check-ins</li>\\n            <li>Priority messaging support</li>\\n          </ul>\\n          <div style=\\\"margin-top:10px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Apply now</a></div>\\n        </div>\\n\\n        <div class=\\\"tier\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin:0\\\">Executive Intensive — 6 months</h3>\\n          <div class=\\\"price\\\">Custom pricing</div>\\n          <p style=\\\"color:var(--muted);margin-top:8px\\\">Tailored program for leaders balancing high-load schedules. Includes calendar redesign, custom habit architecture, and high-touch accountability.</p>\\n          <div style=\\\"margin-top:10px\\\"><a class=\\\"cta\\\" href=\\\"contact.html\\\">Request a proposal</a></div>\\n        </div>\\n\\n      </div>\\n\\n      <aside>\\n        <div style=\\\"background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:14px;border-radius:12px\\\">\\n          <h4 style=\\\"margin:0\\\">How pricing works</h4>\\n          <p style=\\\"color:var(--muted);margin-top:8px\\\">Pricing reflects coaching time, templates, and support cadence. Foundations is a short, tactical engagement; Momentum is about compounding; Intensive is a bespoke partnership.</p>\\n        </div>\\n\\n        <div class=\\\"faq\\\" style=\\\"margin-top:12px\\\">\\n          <h5 style=\\\"margin:0 0 8px\\\">Questions people ask</h5>\\n          <details style=\\\"color:var(--muted)\\\"><summary>Do I get a refund if it doesn't work?</summary><div style=\\\"margin-top:8px\\\">We focus on early wins; if the approach isn't a fit, we discuss pro-rated options. Transparency is core to our process.</div></details>\\n          <details style=\\\"margin-top:8px;color:var(--muted)\\\"><summary>Can sessions be remote?</summary><div style=\\\"margin-top:8px\\\">Yes — all programs are designed for remote delivery with asynchronous touchpoints.</div></details>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px;padding:12px;border-radius:12px;background:rgba(255,255,255,0.02)\\\">\\n          <strong>Lead magnet</strong>\\n          <p style=\\\"color:var(--muted);margin-top:6px\\\">Grab the Habit Velocity Checklist — a simple diagnostic to choose the right path.</p>\\n          <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" style=\\\"display:flex;gap:8px;margin-top:8px\\\">\\n            <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Email\\\" style=\\\"flex:1;padding:8px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:#eaf6ff\\\" required />\\n            <button style=\\\"background:var(--accent);border:0;padding:8px 10px;border-radius:8px;color:#071225;font-weight:800\\\">Send</button>\\n          </form>\\n        </div>\\n\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h4 style=\\\"margin:0 0 8px\\\">What clients worry about</h4>\\n      <div style=\\\"display:flex;gap:10px\\\">\\n        <div style=\\\"flex:1;background:rgba(255,255,255,0.03);padding:12px;border-radius:10px;color:var(--muted)\\\"><strong>Time</strong><p style=\\\"margin:8px 0 0\\\">Most work happens in 10-minute actions; coaching sessions are short and outcome-focused.</p></div>\\n        <div style=\\\"flex:1;background:rgba(255,255,255,0.03);padding:12px;border-radius:10px;color:var(--muted)\\\"><strong>Consistency</strong><p style=\\\"margin:8px 0 0\\\">We build rituals that fit your calendar and require minimal motivation.</p></div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;padding:14px;border-radius:12px;background:linear-gradient(90deg,rgba(255,184,107,0.04),transparent)\\\">\\n      <h4 style=\\\"margin:0 0 6px\\\">Ready to begin?</h4>\\n      <p style=\\\"color:var(--muted);margin:0 0 10px\\\">Apply for Momentum or request a proposal for Intensive. If you want a fast start, Foundations Sprint is the quickest way to get moving.</p>\\n      <a class=\\\"cta\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </section>\\n\\n  </main>\\n\\n  <!-- unique pattern SVG used decoratively in page background -->\\n  <svg width=\\\"0\\\" height=\\\"0\\\" style=\\\"position:absolute;left:-9999px;top:-9999px;\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <pattern id=\\\"p1\\\" patternUnits=\\\"userSpaceOnUse\\\" width=\\\"40\\\" height=\\\"40\\\">\\n        <rect width=\\\"40\\\" height=\\\"40\\\" fill=\\\"transparent\\\" />\\n        <circle cx=\\\"6\\\" cy=\\\"6\\\" r=\\\"3\\\" fill=\\\"#ffb86b\\\" opacity=\\\"0.12\\\"/>\\n        <circle cx=\\\"34\\\" cy=\\\"34\\\" r=\\\"3\\\" fill=\\\"#ffb86b\\\" opacity=\\\"0.12\\\"/>\\n      </pattern>\\n    </defs>\\n  </svg>\\n</body>\\n</html>\"} \nBUNDLE_END"
