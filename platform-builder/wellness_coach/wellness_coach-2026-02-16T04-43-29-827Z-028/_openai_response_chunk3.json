          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Pricing & Investment</title>\\n  <style>\\n    :root{--bg:#fff;--accent:#ff6b6b;--muted:#6b7280;--card:#0f1724;--glass:rgba(15,23,36,0.05);--radius:14px;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,#fff 0%,#fffaf0 100%);color:#0b1020}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 40px}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#ffb86b);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:18px}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:36px;padding:48px 40px;align-items:center}\\n    .hero-card{background:var(--glass);padding:28px;border-radius:18px}\\n    h1{font-size:34px;margin:0 0 10px;letter-spacing:-0.02em}\\n    p.lead{color:var(--muted);margin:0 0 18px}\\n    .kicker{display:inline-block;background:#fff6f6;color:var(--accent);padding:6px 12px;border-radius:999px;font-weight:700;margin-bottom:14px}\\n    .tiers{display:flex;gap:18px;margin-top:20px}\\n    .tier{background:#fff;border-radius:14px;padding:18px;box-shadow:0 6px 20px rgba(12,18,30,0.06);flex:1;border:1px solid rgba(10,12,18,0.04)}\\n    .tier.gold{border:2px solid var(--accent);transform:scale(1.02)}\\n    .price{font-size:22px;font-weight:800;margin:8px 0}\\n    ul.features{margin:10px 0 18px;padding:0 0 0 18px;color:var(--muted)}\\n    .cta{display:inline-block;background:var(--accent);color:#fff;padding:12px 18px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .small{font-size:13px;color:var(--muted)}\\n    footer{padding:36px 40px;color:var(--muted);display:flex;justify-content:space-between}\\n    .faq{margin-top:18px;background:#fff;border-radius:12px;padding:16px}\\n    .lead-magnet{display:flex;gap:12px;align-items:center;margin-top:22px}\\n    .lead-input{padding:12px 14px;border-radius:10px;border:1px solid rgba(10,12,18,0.06);flex:1}\\n    .pattern{width:100%;height:120px;margin-top:18px;border-radius:12px;background:linear-gradient(90deg,#fff,#fff4f0);display:flex;align-items:center;justify-content:center;color:#fff}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">WC</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Programs</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"testimonials.html\\\">Stories</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <span class=\\\"kicker\\\">Intensive coaching</span>\\n        <h1>Invest in the habits that change the season of your life</h1>\\n        <p class=\\\"lead\\\">High-impact routines, accountability frameworks, and a fast-paced plan to move results forward in 8–12 weeks. Designed for busy professionals who want clarity and repeatable momentum.</p>\\n\\n        <div class=\\\"hero-card\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div style=\\\"font-weight:800\\\">Popular path: Momentum Intensive</div>\\n              <div class=\\\"small\\\">12 weeks | Weekly coaching + daily habit architecture</div>\\n            </div>\\n            <div>\\n              <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"tiers\\\">\\n            <div class=\\\"tier\\\">\\n              <div style=\\\"font-weight:700\\\">Starter Sprint</div>\\n              <div class=\\\"price\\\">$1,200 — 6 weeks</div>\\n              <ul class=\\\"features\\\">\\n                <li>One 60‑minute session/week</li>\\n                <li>Weekly habit plan</li>\\n                <li>Email support between sessions</li>\\n              </ul>\\n              <a href=\\\"book.html\\\" class=\\\"small\\\">Book Starter</a>\\n            </div>\\n\\n            <div class=\\\"tier gold\\\">\\n              <div style=\\\"font-weight:700\\\">Momentum Intensive</div>\\n              <div class=\\\"price\\\">$3,900 — 12 weeks</div>\\n              <ul class=\\\"features\\\">\\n                <li>Weekly 60‑minute coaching</li>\\n                <li>Daily micro‑habits & tracking</li>\\n                <li>Priority messaging + two mid‑week check-ins</li>\\n              </ul>\\n              <a href=\\\"book.html\\\" class=\\\"small\\\">Reserve a seat</a>\\n            </div>\\n\\n            <div class=\\\"tier\\\">\\n              <div style=\\\"font-weight:700\\\">Foundations Track</div>\\n              <div class=\\\"price\\\">$2,400 — 10 weeks</div>\\n              <ul class=\\\"features\\\">\\n                <li>Bi‑weekly sessions</li>\\n                <li>Custom framework to build sustainable systems</li>\\n                <li>Template library + 1 follow‑up session</li>\\n              </ul>\\n              <a href=\\\"book.html\\\" class=\\\"small\\\">Start Foundations</a>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:14px;color:var(--muted);font-size:13px\\\">Payment plans available. All programs require an initial clarity call to confirm fit.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:20px;display:flex;gap:12px;align-items:center\\\">\\n          <div class=\\\"lead-magnet\\\">\\n            <input class=\\\"lead-input\\\" placeholder=\\\"Get the 7‑Step Reset Checklist (PDF)\\\" aria-label=\\\"email\\\" />\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Get the Checklist</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"faq\\\">\\n          <div style=\\\"font-weight:800\\\">Common concerns I hear</div>\\n          <div style=\\\"margin-top:10px;color:var(--muted)\\\">\\n            <div style=\\\"margin-bottom:8px\\\"><strong>Will coaching work with my schedule?</strong> — Programs are structured around compact, actionable weekly priorities; we craft micro‑habits that fit your calendar.</div>\\n            <div><strong>What if I can’t keep up?</strong> — Building habits is iterative. We measure progress in habits, not perfection. Sessions adapt to momentum and constraints.</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div style=\\\"background:#fff;border-radius:16px;padding:20px;box-shadow:0 12px 40px rgba(12,18,30,0.06)\\\">\\n          <img src=\\\"assets/img/hero.svg\\\" alt=\\\"abstract performance illustration\\\" style=\\\"width:100%;border-radius:12px\\\" />\\n          <div style=\\\"margin-top:14px\\\">\\n            <div style=\\\"font-weight:800\\\">Need a custom plan?</div>\\n            <div class=\\\"small\\\">We can design a one‑off intensive or an ongoing cadence tailored to your targets.</div>\\n            <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"contact.html\\\">Request a proposal</a></div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:18px;background:linear-gradient(180deg,#fff8f6,#fff);padding:14px;border-radius:12px\\\">\\n          <div style=\\\"font-weight:800\\\">Quick ROI</div>\\n          <div class=\\\"small\\\">Clients report improved focus, better sleep routines, and measurable time reclaimed for priorities — not promises, but repeatable methods.</div>\\n        </div>\\n      </aside>\\n\\n    </section>\\n\\n    <section style=\\\"padding:0 40px 40px\\\">\\n      <div style=\\\"display:flex;gap:18px;align-items:center\\\">\\n        <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" style=\\\"width:84px;height:84px;border-radius:12px\\\" />\\n        <div>\\n          <div style=\\\"font-weight:900\\\">What's included with every coaching path</div>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">An outcomes-first agenda, clear weekly tasks, and a repeatable accountability routine you can run without me.</div>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"display:flex;gap:18px;margin-top:18px\\\">\\n        <div style=\\\"flex:1;background:#fff;padding:18px;border-radius:12px;box-shadow:0 8px 30px rgba(12,18,30,0.04)\\\">\\n          <div style=\\\"font-weight:800\\\">Habit Architecture</div>\\n          <div class=\\\"small\\\">We build small, composable habits that stack into 90‑day outcomes.</div>\\n        </div>\\n        <div style=\\\"flex:1;background:#fff;padding:18px;border-radius:12px;box-shadow:0 8px 30px rgba(12,18,30,0.04)\\\">\\n          <div style=\\\"font-weight:800\\\">Accountability Design</div>\\n          <div class=\\\"small\\\">Clear metrics, weekly reviews, and course corrections so progress is visible and reliable.</div>\\n        </div>\\n        <div style=\\\"flex:1;background:#fff;padding:18px;border-radius:12px;box-shadow:0 8px 30px rgba(12,18,30,0.04)\\\">\\n          <div style=\\\"font-weight:800\\\">Sustainable Systems</div>\\n          <div class=\\\"small\\\">Practical templates for routines, time blocks, and energy management — not theoretical checklists.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>\\n      <div style=\\\"font-weight:700\\\">Ready to start?</div>\\n      <div class=\\\"small\\\">Schedule a clarity call — we'll confirm fit and the fastest path forward.</div>\\n    </div>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <a class=\\\"cta\\\" href=\\\"book.html\\\">Book your clarity call</a>\\n      <div class=\\\"small\\\">Or call {{PHONE}}</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Client Stories</title>\\n  <style>\\n    :root{--bg:#fff;--accent:#2dd4bf;--muted:#475569;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif}\\n    body{margin:0;background:linear-gradient(180deg,#f9fffd,#fff);color:#071135}\\n    header{display:flex;justify-content:space-between;padding:26px 34px;align-items:center}\\n    .logo{font-weight:900;color:var(--accent)}\\n    nav a{margin-left:16px;color:var(--muted);text-decoration:none}\\n    .hero{padding:34px;background:linear-gradient(90deg,rgba(45,212,191,0.06),transparent);display:flex;gap:20px;align-items:center}\\n    .avatar{width:96px;height:96px;border-radius:18px;background:linear-gradient(135deg,#fff,#f0fdfa);display:flex;align-items:center;justify-content:center}\\n    h1{margin:0;font-size:28px}\\n    p.lead{color:var(--muted);margin-top:6px}\\n    .stories{display:grid;grid-template-columns:1fr 1fr;gap:18px;padding:28px 34px}\\n    .card{background:#fff;border-radius:12px;padding:18px;box-shadow:0 18px 40px rgba(10,12,18,0.04)}\\n    .quote{font-style:italic;color:#0b1220}\\n    .meta{color:var(--muted);font-size:13px;margin-top:8px}\\n    .case{display:flex;gap:14px;align-items:flex-start}\\n    .case svg{flex:0 0 72px}\\n    .lead-magnet{background:#ffffff;border-radius:12px;padding:18px;margin:28px 34px;display:flex;justify-content:space-between;align-items:center}\\n    .cta{background:var(--accent);color:#042023;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{padding:24px 34px;color:var(--muted);display:flex;justify-content:space-between}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n      <div style=\\\"color:var(--muted);font-weight:700\\\">Client Stories</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"pricing.html\\\">Invest</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <section class=\\\"hero\\\">\\n    <div class=\\\"avatar\\\">\\n      <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"coach avatar\\\" style=\\\"width:72px;height:72px;border-radius:12px\\\" />\\n    </div>\\n    <div>\\n      <h1>Real shifts. Practical wins.</h1>\\n      <p class=\\\"lead\\\">Short case studies and client reflections from busy leaders, creatives, and professionals who created measurable routines without overwhelm.</p>\\n    </div>\\n  </section>\\n\\n  <main>\\n    <section class=\\\"stories\\\">\\n      <div class=\\\"card\\\">\\n        <div class=\\\"case\\\">\\n          <svg width=\\\"72\\\" height=\\\"72\\\" viewBox=\\\"0 0 72 72\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n            <rect width=\\\"72\\\" height=\\\"72\\\" rx=\\\"12\\\" fill=\\\"#f0fdfa\\\"/>\\n            <path d=\\\"M18 44c6-10 30-20 36-24\\\" stroke=\\\"#2dd4bf\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/>\\n          </svg>\\n          <div>\\n            <div style=\\\"font-weight:800\\\">Sustained focus for a scaling founder</div>\\n            <div class=\\\"meta\\\">\\\"In 10 weeks I reclaimed 6 hours/week for strategy work. The micro‑habit plan was the lever.\\\" — A.M., Founder</div>\\n          </div>\\n        </div>\\n        <div style=\\\"margin-top:12px;color:var(--muted)\\\" class=\\\"quote\\\">\\\"We replaced chaotic urgency with a simple 4‑step morning routine. It removed decision fatigue and created consistent output.\\\"</div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div class=\\\"case\\\">\\n          <svg width=\\\"72\\\" height=\\\"72\\\" viewBox=\\\"0 0 72 72\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n            <rect width=\\\"72\\\" height=\\\"72\\\" rx=\\\"12\\\" fill=\\\"#fff7ed\\\"/>\\n            <circle cx=\\\"36\\\" cy=\\\"36\\\" r=\\\"18\\\" stroke=\\\"#ffb86b\\\" stroke-width=\\\"3\\\"/>\\n          </svg>\\n          <div>\\n            <div style=\\\"font-weight:800\\\">Reset after burnout</div>\\n            <div class=\\\"meta\\\">\\\"The 8‑week Reset Sprint helped me rebuild energy in ways that fit my calendar and my life.\\\" — R.T., Consultant</div>\\n          </div>\\n        </div>\\n        <div style=\\\"margin-top:12px;color:var(--muted)\\\" class=\\\"quote\\\">\\\"No guilt, just clear actions. I now have systems that scale with my workload.\\\"</div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div class=\\\"case\\\">\\n          <svg width=\\\"72\\\" height=\\\"72\\\" viewBox=\\\"0 0 72 72\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n            <rect width=\\\"72\\\" height=\\\"72\\\" rx=\\\"12\\\" fill=\\\"#f8faff\\\"/>\\n            <path d=\\\"M18 28c10 8 30 6 36 4\\\" stroke=\\\"#60a5fa\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/>\\n          </svg>\\n          <div>\\n            <div style=\\\"font-weight:800\\\">Team habits for a small leadership team</div>\\n            <div class=\\\"meta\\\">\\\"We used the framework to align weekly cadences — less meeting noise, more clarity.\\\" — V.S., Ops Lead</div>\\n          </div>\\n        </div>\\n        <div style=\\\"margin-top:12px;color:var(--muted)\\\" class=\\\"quote\\\">\\\"The coaching approach scales: same structure, different actors. That was powerful for our team.\\\"</div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div class=\\\"case\\\">\\n          <svg width=\\\"72\\\" height=\\\"72\\\" viewBox=\\\"0 0 72 72\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n            <rect width=\\\"72\\\" height=\\\"72\\\" rx=\\\"12\\\" fill=\\\"#fff8ff\\\"/>\\n            <path d=\\\"M20 44c8-8 24-20 32-24\\\" stroke=\\\"#ff6b6b\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/>\\n          </svg>\\n          <div>\\n            <div style=\\\"font-weight:800\\\">A measurable performance lift</div>\\n            <div class=\\\"meta\\\">\\\"I could see productivity metrics shift after week four. Small wins compound.\\\" — H.L., Product Manager</div>\\n          </div>\\n        </div>\\n        <div style=\\\"margin-top:12px;color:var(--muted)\\\" class=\\\"quote\\\">\\\"Practical and optimistic — coaching that stops being a lecture and becomes work you can do.\\\"</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"padding:0 34px 34px;display:flex;gap:18px;align-items:center\\\">\\n      <div style=\\\"flex:1;background:#ffffff;padding:18px;border-radius:12px;box-shadow:0 8px 30px rgba(10,12,18,0.04)\\\">\\n        <div style=\\\"font-weight:900\\\">Client metrics</div>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Average time reclaimed: 4–8 hours/week. Habit adherence at 30 days: 72%. These are averages from structured cohorts and depend on engagement and context.</div>\\n      </div>\\n\\n      <div style=\\\"width:320px;background:linear-gradient(180deg,#fff,#f3fffb);padding:16px;border-radius:12px;text-align:center\\\">\\n        <div style=\\\"font-weight:800\\\">Want these outcomes?</div>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Download a short case study pack with step‑by‑step artifacts.</div>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Send me the pack</a></div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"padding:0 34px 60px\\\">\\n      <div style=\\\"display:flex;gap:18px;align-items:center\\\">\\n        <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" style=\\\"width:72px;height:72px;border-radius:12px\\\" />\\n        <div>\\n          <div style=\\\"font-weight:900\\\">What clients most appreciate</div>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">Clear language, measurable tasks, and a coach who treats time as the resource it is.</div>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:16px;display:flex;gap:12px\\\">\\n        <div style=\\\"flex:1;background:#fff;padding:16px;border-radius:12px;box-shadow:0 8px 30px rgba(10,12,18,0.04)\\\">\\n          <div style=\\\"font-weight:800\\\">Directness</div>\\n          <div class=\\\"meta\\\">Coaching that quickly identifies leverage points.</div>\\n        </div>\\n        <div style=\\\"flex:1;background:#fff;padding:16px;border-radius:12px;box-shadow:0 8px 30px rgba(10,12,18,0.04)\\\">\\n          <div style=\\\"font-weight:800\\\">Templates & Tools</div>\\n          <div class=\\\"meta\\\">Turnkey frameworks you can repeat without me.</div>\\n        </div>\\n      </div>\\n\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>\\n      <div style=\\\"font-weight:800\\\">Curious how it could work for you?</div>\\n      <div style=\\\"color:var(--muted)\\\">Schedule a short clarity call with {{COACH_NAME}}, {{CREDENTIALS}} in {{CITY}}, {{STATE}}</div>\\n    </div>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <a class=\\\"cta\\\" href=\\\"book.html\\\">Book a clarity call</a>\\n      <div style=\\\"color:var(--muted)\\\">{{EMAIL}} · {{PHONE}}</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#ff6b6b;--muted:#6b7280;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif}\\n    body{margin:0;background:linear-gradient(180deg,#fff,#fff8f7);color:#07112b}\\n    header{display:flex;justify-content:space-between;padding:22px 36px;align-items:center}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .wrap{display:flex;gap:26px;padding:26px 36px}\\n    .form{flex:1;background:#fff;padding:20px;border-radius:14px;box-shadow:0 14px 40px rgba(12,18,30,0.06)}\\n    .sidebar{width:360px}\\n    label{display:block;font-weight:700;margin-top:12px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:10px;border:1px solid rgba(10,12,18,0.06);margin-top:6px}\\n    .btn{background:var(--accent);color:#fff;padding:12px 16px;border-radius:10px;border:none;font-weight:800;margin-top:12px}\\n    .note{color:var(--muted);font-size:13px;margin-top:8px}\\n    .section{background:#fff;padding:14px;border-radius:12px;margin-bottom:12px}\\n    .pill{display:inline-block;background:#fff6f6;color:var(--accent);padding:6px 10px;border-radius:999px;font-weight:700}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:900\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Work With Me</a>\\n      <a href=\\\"testimonials.html\\\">Stories</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <form class=\\\"form\\\" action=\\\"#\\\" method=\\\"post\\\" onsubmit=\\\"alert('This demo form does not submit. Replace with your scheduler.');return false;\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <div style=\\\"font-weight:900;font-size:20px\\\">Book a clarity call</div>\\n          <div class=\\\"note\\\">30 minutes to diagnose the highest-impact next step. No obligation.</div>\\n        </div>\\n        <div class=\\\"pill\\\">{{COACH_NAME}}, {{CREDENTIALS}}</div>\\n      </div>\\n\\n      <label for=\\\"name\\\">Your full name</label>\\n      <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"Jane Doe\\\" required />\\n\\n      <label for=\\\"email\\\">Email</label>\\n      <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@company.com\\\" required />\\n\\n      <label for=\\\"phone\\\">Phone (optional)</label>\\n      <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"(555) 555-5555\\\" />\\n\\n      <label for=\\\"goal\\\">Primary goal for coaching</label>\\n      <select id=\\\"goal\\\" name=\\\"goal\\\">\\n        <option>Increase deep work time</option>\\n        <option>Recover energy & routine</option>\\n        <option>Build leadership habits</option>\\n        <option>Other</option>\\n      </select>\\n\\n      <label for=\\\"slot\\\">Choose a time window</label>\\n      <select id=\\\"slot\\\" name=\\\"slot\\\">\\n        <option>Weekday mornings (7–9am)</option>\\n        <option>Weekday afternoons (12–3pm)</option>\\n        <option>Weekday evenings (6–8pm)</option>\\n        <option>Flexible — contact me</option>\\n      </select>\\n\\n      <label for=\\\"message\\\">Brief context (one paragraph)</label>\\n      <textarea id=\\\"message\\\" name=\\\"message\\\" rows=\\\"4\\\" placeholder=\\\"What's the friction? What have you tried?\\\" ></textarea>\\n\\n      <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n        <button class=\\\"btn\\\" type=\\\"submit\\\">Schedule clarity call</button>\\n        <div class=\\\"note\\\">Or call <strong>{{PHONE}}</strong></div>\\n      </div>\\n\\n      <div style=\\\"margin-top:18px;color:var(--muted);font-size:13px\\\">By booking you agree to receive scheduling emails. All coaching is outcome-focused and does not replace medical advice.</div>\\n    </form>\\n\\n    <aside class=\\\"sidebar\\\">\\n      <div class=\\\"section\\\">\\n        <div style=\\\"font-weight:800\\\">Why a clarity call?</div>\\n        <div class=\\\"note\\\">We surface the highest-leverage next step, confirm fit, and map a short timeline. Most clients walk away with a 3-step plan even if they don't continue.</div>\\n      </div>\\n\\n      <div class=\\\"section\\\">\\n        <div style=\\\"font-weight:800\\\">Available intensives</div>\\n        <div style=\\\"margin-top:8px\\\" class=\\\"note\\\">\\n          <strong>Starter Sprint</strong> — Fast habit reset, 6 weeks. <br/>\\n          <strong>Momentum Intensive</strong> — Deep architecture, 12 weeks. <br/>\\n          <strong>Foundations Track</strong> — Systems for scale, 10 weeks.\\n        </div>\\n      </div>\\n\\n      <div class=\\\"section\\\">\\n        <div style=\\\"font-weight:800\\\">Common early objections</div>\\n        <div class=\\\"note\\\" style=\\\"margin-top:8px\\\">\\n          \\\"I don't have time\\\" — We build 10–15 minute micro‑habits. <br/>\\n          \\\"I've tried coaching before\\\" — This is a framework + templates approach with immediate tasks.\\n        </div>\\n      </div>\\n\\n      <div class=\\\"section\\\">\\n        <div style=\\\"font-weight:800\\\">Need a fast resource?</div>\\n        <div style=\\\"margin-top:8px\\\" class=\\\"note\\\">Download the 7‑Step Reset Checklist. Practical habits to implement today.</div>\\n        <div style=\\\"margin-top:10px\\\"><a style=\\\"display:inline-block;background:var(--accent);color:#fff;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:800\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Get the Checklist</a></div>\\n      </div>\\n\\n      <div class=\\\"section\\\">\\n        <div style=\\\"font-weight:800\\\">Contact</div>\\n        <div class=\\\"note\\\">Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a><br/>Phone: {{PHONE}}<br/>Serving {{CITY}}, {{STATE}}</div>\\n      </div>\\n\\n    </aside>\\n  </main>\\n\\n  <footer style=\\\"padding:20px 36px;color:var(--muted);display:flex;justify-content:space-between\\\">\\n    <div>&copy; {{BUSINESS_NAME}}</div>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <a style=\\\"color:var(--muted);text-decoration:none\\\" href=\\\"privacy.html\\\">Privacy</a>\\n      <a style=\\\"color:var(--muted);text-decoration:none\\\" href=\\\"terms.html\\\">Terms</a>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
