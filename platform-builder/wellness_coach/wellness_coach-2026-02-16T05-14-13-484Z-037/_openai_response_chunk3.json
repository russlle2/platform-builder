          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investments — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbf6f2;--card:#fff;--accent:#c0733c;--muted:#6b584d;--accent-2:#e9a87a;--radius:14px;--max:1100px}\\n    body{font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; background:var(--bg); color:#2b2b2b; margin:0; -webkit-font-smoothing:antialiased}\\n    .wrap{max-width:var(--max); margin:40px auto; padding:28px}\\n    nav{display:flex; gap:18px; align-items:center; margin-bottom:28px}\\n    nav a{color:var(--muted); text-decoration:none; font-weight:600}\\n    header.hero{display:grid; grid-template-columns:1fr 360px; gap:28px; align-items:center; margin-bottom:28px}\\n    .hero-card{background:linear-gradient(180deg, rgba(255,255,255,0.9), rgba(255,255,255,0.85)); border-radius:20px; padding:28px; box-shadow:0 6px 30px rgba(44,33,29,0.06)}\\n    .kicker{color:var(--accent); font-weight:700; letter-spacing:0.6px}\\n    h1{margin:8px 0 10px; font-size:28px}\\n    p.lead{color:var(--muted); margin:0 0 14px}\\n    .badge{display:inline-flex; gap:8px; align-items:center; padding:8px 12px; background:rgba(192,115,60,0.08); border-radius:999px; color:var(--accent)}\\n    .tiers{display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:18px}\\n    .tier{background:var(--card); border-radius:12px; padding:18px; box-shadow:0 8px 24px rgba(34,28,24,0.06)}\\n    .tier h3{margin:0 0 6px}\\n    .price{font-size:20px; color:var(--accent); font-weight:700}\\n    ul.features{margin:12px 0 14px; padding-left:18px; color:var(--muted)}\\n    .cta-row{display:flex; gap:12px}\\n    .btn{background:var(--accent); color:white; padding:10px 14px; border-radius:10px; text-decoration:none; font-weight:700}\\n    .btn.ghost{background:transparent; border:1px solid rgba(100,80,70,0.12); color:var(--muted)}\\n    section{margin:28px 0}\\n    .values-grid{display:flex; gap:12px; flex-wrap:wrap}\\n    .value{background:linear-gradient(180deg,#fff 0%, #fffaf7 100%); padding:14px; border-radius:12px; flex:1 1 220px; box-shadow:0 6px 18px rgba(40,30,26,0.05)}\\n    .methods{display:grid; grid-template-columns:1fr 1fr; gap:12px}\\n    .faq{background:var(--card); padding:18px; border-radius:12px}\\n    .leadmagnet{display:flex; gap:12px; align-items:center; background:#fff7ef; padding:16px; border-radius:12px}\\n    footer{margin:28px 0; display:flex; justify-content:space-between; align-items:center; color:var(--muted)}\\n    @media(max-width:880px){header.hero{grid-template-columns:1fr;}\\n      .tiers{grid-template-columns:1fr}\\n      .methods{grid-template-columns:1fr}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"services.html\\\">Intensive</a>\\n      <strong style=\\\"color:var(--accent)\\\">Pricing</strong>\\n      <a href=\\\"testimonials.html\\\">Stories</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n\\n    <header class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <div class=\\\"kicker\\\">INVESTMENT</div>\\n        <h1>Investment Tiers for Lasting Habit Change</h1>\\n        <p class=\\\"lead\\\">Designed for executives and high-performers who want an intensive, measurable shift in daily habits, stress resilience, and clarity. Transparent tiers — clear commitments.</p>\\n        <div class=\\\"badge\\\">Led by {{COACH_NAME}}, {{CREDENTIALS}}</div>\\n\\n        <div class=\\\"tiers\\\">\\n          <div class=\\\"tier\\\">\\n            <h3>Focus Sprint — 6 weeks</h3>\\n            <div class=\\\"price\\\">$2,800 fixed</div>\\n            <ul class=\\\"features\\\">\\n              <li>Weekly 1:1 strategy sessions</li>\\n              <li>Behavioral tracking framework</li>\\n              <li>Priority messaging</li>\\n            </ul>\\n            <div class=\\\"cta-row\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a><a class=\\\"btn ghost\\\" href=\\\"#questions\\\">Questions</a></div>\\n          </div>\\n          <div class=\\\"tier\\\">\\n            <h3>Deep Reset — 8 weeks</h3>\\n            <div class=\\\"price\\\">$4,500 fixed</div>\\n            <ul class=\\\"features\\\">\\n              <li>Bi-weekly intensive sessions</li>\\n              <li>Custom habit architecture</li>\\n              <li>On-demand check-ins</li>\\n            </ul>\\n            <div class=\\\"cta-row\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve Slot</a><a class=\\\"btn ghost\\\" href=\\\"#faq\\\">Details</a></div>\\n          </div>\\n          <div class=\\\"tier\\\">\\n            <h3>Sustain Plan — 12 weeks</h3>\\n            <div class=\\\"price\\\">$7,900 fixed</div>\\n            <ul class=\\\"features\\\">\\n              <li>Full framework build + transfer</li>\\n              <li>Leadership & habit coaching</li>\\n              <li>Performance metrics dashboard</li>\\n            </ul>\\n            <div class=\\\"cta-row\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start Now</a><a class=\\\"btn ghost\\\" href=\\\"#lead\\\">Download Guide</a></div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <!-- Inline organic hero SVG (unique) -->\\n      <div aria-hidden=\\\"true\\\">\\n        <svg width=\\\"360\\\" height=\\\"360\\\" viewBox=\\\"0 0 360 360\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\">\\n          <defs>\\n            <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"1\\\" y2=\\\"1\\\">\\n              <stop offset=\\\"0%\\\" stop-color=\\\"#f7efe6\\\"/>\\n              <stop offset=\\\"100%\\\" stop-color=\\\"#e9a87a\\\"/>\\n            </linearGradient>\\n          </defs>\\n          <rect width=\\\"360\\\" height=\\\"360\\\" rx=\\\"32\\\" fill=\\\"url(#g1)\\\"/>\\n          <g transform=\\\"translate(30,30)\\\">\\n            <path d=\\\"M20 180 C 40 40, 220 20, 280 140 C 340 260, 120 300, 20 180 Z\\\" fill=\\\"#c0733c\\\" opacity=\\\"0.08\\\"/>\\n            <path d=\\\"M10 200 C 80 320, 260 300, 310 200 C 360 100, 220 40, 10 200 Z\\\" fill=\\\"#c0733c\\\" opacity=\\\"0.06\\\"/>\\n            <circle cx=\\\"240\\\" cy=\\\"80\\\" r=\\\"36\\\" fill=\\\"#fff\\\" opacity=\\\"0.9\\\"/>\\n            <text x=\\\"24\\\" y=\\\"220\\\" font-size=\\\"14\\\" fill=\\\"#6b584d\\\" font-weight=\\\"700\\\">{{BUSINESS_NAME}}</text>\\n          </g>\\n        </svg>\\n      </div>\\n    </header>\\n\\n    <section class=\\\"values\\\">\\n      <h2>Core Commitments</h2>\\n      <div class=\\\"values-grid\\\">\\n        <div class=\\\"value\\\"><strong>Clarity over Busyness</strong><div style=\\\"color:var(--muted);margin-top:8px\\\">We build one high-leverage habit at a time to create surgical focus.</div></div>\\n        <div class=\\\"value\\\"><strong>Habit Architecture</strong><div style=\\\"color:var(--muted);margin-top:8px\\\">Frameworks you can sustain beyond the program — not one-off fixes.</div></div>\\n        <div class=\\\"value\\\"><strong>Data-Informed Progress</strong><div style=\\\"color:var(--muted);margin-top:8px\\\">We measure signals that matter: energy, consistency, and execution.</div></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"methods\\\">\\n      <div class=\\\"faq\\\">\\n        <h3>How this intensive works</h3>\\n        <p style=\\\"color:var(--muted); margin-top:6px\\\">A compact cadence of strategy + accountability. Expect weekly deliverables, short experiments, and decision rules that reduce willpower reliance.</p>\\n        <ul style=\\\"margin-top:10px; color:var(--muted)\\\">\\n          <li>Behavioral audits & clear KPI set</li>\\n          <li>Micro-habits with built-in triggers</li>\\n          <li>Time-blocked performance routines</li>\\n        </ul>\\n      </div>\\n      <div class=\\\"faq\\\" id=\\\"questions\\\">\\n        <h3>Common Hesitations</h3>\\n        <p style=\\\"color:var(--muted); margin-top:6px\\\">Before you book, here are concerns I hear and how we handle them.</p>\\n        <ol style=\\\"color:var(--muted); margin-top:10px\\\">\\n          <li><strong>Too busy?</strong> The program fronts effort into short bursts with predictable maintenance plans.</li>\\n          <li><strong>Will it stick?</strong> Every plan ends with a transfer session so you own the tools.</li>\\n          <li><strong>Privacy?</strong> We use secure notes and agreed communication windows.</li>\\n        </ol>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"lead\\\" class=\\\"leadmagnet\\\">\\n      <div style=\\\"flex:1\\\">\\n        <strong>Free Habit Reset Guide</strong>\\n        <div style=\\\"color:var(--muted); margin-top:6px\\\">A concise 8-step PDF that teaches the first week of the Deep Reset program — actionable and immediate.</div>\\n      </div>\\n      <div>\\n        <form action=\\\"#\\\" onsubmit=\\\"alert('Download link sent (placeholder)');return false;\\\">\\n          <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Your email\\\" style=\\\"padding:8px;border-radius:8px;border:1px solid rgba(80,60,50,0.08)\\\" required>\\n          <button type=\\\"submit\\\" class=\\\"btn\\\" style=\\\"margin-left:8px\\\">Get the Guide</button>\\n        </form>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"faq\\\" class=\\\"faq\\\">\\n      <h3>Practical Questions</h3>\\n      <div style=\\\"color:var(--muted); margin-top:8px\\\">\\n        <strong>What outcome should I expect?</strong>\\n        <p style=\\\"margin:6px 0\\\">A repeatable daily routine that shifts your energy and decision bandwidth within the program window.</p>\\n        <strong>How is coaching delivered?</strong>\\n        <p style=\\\"margin:6px 0\\\">Secure video calls, weekly homework, and focused accountability checkpoints.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"testimonial-sample\\\">\\n      <h3>Client Snapshot</h3>\\n      <blockquote style=\\\"background:var(--card); padding:14px; border-radius:10px; color:var(--muted)\\\">\\\"I reclaimed two hours of focused work and a predictable morning routine in six weeks.\\\" — Director, Technology</blockquote>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"color:var(--muted)\\\">Questions? Call {{PHONE}} or <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Stories & Outcomes — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fcf8f6;--muted:#6b584d;--accent:#b35b2b;--card:#fff;--radius:12px;--max:1100px}\\n    body{font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto; background:var(--bg); color:#2b2b2b; margin:0}\\n    .wrap{max-width:var(--max); margin:36px auto; padding:24px}\\n    nav{display:flex; gap:16px; align-items:center; margin-bottom:22px}\\n    nav a{color:var(--muted); text-decoration:none; font-weight:600}\\n    .hero{display:flex; gap:20px; align-items:center; margin-bottom:18px}\\n    .hero .lead{flex:1}\\n    h1{margin:0 0 8px}\\n    .avatar{width:120px; height:120px; border-radius:16px; background:linear-gradient(180deg,#fff 0%,#fffaf7 100%); box-shadow:0 8px 30px rgba(40,30,26,0.06); display:flex; align-items:center; justify-content:center}\\n    .grid{display:grid; grid-template-columns:repeat(3,1fr); gap:14px}\\n    .card{background:var(--card); padding:14px; border-radius:12px; box-shadow:0 6px 20px rgba(36,28,24,0.05)}\\n    blockquote{margin:0; font-style:italic; color:var(--muted)}\\n    .meta{margin-top:8px; color:#7a665b; font-size:13px}\\n    .leadmagnet{display:flex; justify-content:space-between; align-items:center; background:#fff3ea; padding:14px; border-radius:12px; margin-top:18px}\\n    .cta{display:flex; gap:10px; margin-top:14px}\\n    .btn{padding:10px 12px; border-radius:10px; background:var(--accent); color:#fff; text-decoration:none; font-weight:700}\\n    .secondary{background:transparent; border:1px solid rgba(110,80,65,0.12); color:var(--muted)}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}\\n      .hero{flex-direction:column; align-items:flex-start}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Meet</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"programs.html\\\">Programs</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <strong style=\\\"color:var(--accent)\\\">Praise</strong>\\n      <a href=\\\"book.html\\\">Book a Call</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"lead\\\">\\n        <h1>Real Outcomes — Real People</h1>\\n        <p style=\\\"color:var(--muted); margin-top:6px\\\">Stories from busy leaders who changed daily systems, reclaimed clarity, and moved measurable metrics in weeks.</p>\\n        <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a><a class=\\\"btn secondary\\\" href=\\\"#lead\\\">Get the Guide</a></div>\\n      </div>\\n\\n      <div class=\\\"avatar\\\" aria-hidden=\\\"true\\\">\\n        <!-- Inline avatar SVG (unique) -->\\n        <svg width=\\\"88\\\" height=\\\"88\\\" viewBox=\\\"0 0 88 88\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n          <rect width=\\\"88\\\" height=\\\"88\\\" rx=\\\"14\\\" fill=\\\"#fffefb\\\"/>\\n          <circle cx=\\\"44\\\" cy=\\\"30\\\" r=\\\"16\\\" fill=\\\"#e9a87a\\\" />\\n          <path d=\\\"M16 70c10-12 46-12 56 0\\\" stroke=\\\"#c0733c\\\" stroke-width=\\\"6\\\" stroke-linecap=\\\"round\\\" fill=\\\"none\\\" />\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"values\\\">\\n      <h2>What clients value most</h2>\\n      <div style=\\\"display:flex; gap:10px; flex-wrap:wrap; margin-top:10px\\\">\\n        <div style=\\\"background:var(--card); padding:12px; border-radius:10px; min-width:180px\\\">Sustained energy & focus</div>\\n        <div style=\\\"background:var(--card); padding:12px; border-radius:10px; min-width:180px\\\">Decision clarity & time regained</div>\\n        <div style=\\\"background:var(--card); padding:12px; border-radius:10px; min-width:180px\\\">Practical frameworks, not theory</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"testimonials\\\">\\n      <h2>Selected client stories</h2>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"card\\\">\\n          <blockquote>\\\"In eight weeks our exec team established a morning architecture that defended deep work. Revenue projects moved faster because people had uninterrupted focus blocks.\\\"</blockquote>\\n          <div class=\\\"meta\\\">VP, Operations — implemented company-wide</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <blockquote>\\\"I went from reactive to proactive. The habits stuck because we measured simple signals and iterated weekly.\\\"</blockquote>\\n          <div class=\\\"meta\\\">Head of Product — 1:1 coaching</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <blockquote>\\\"This program doesn't ask more of your willpower; it redesigns the context. The result: habits that feel automatic.\\\"</blockquote>\\n          <div class=\\\"meta\\\">Founder — 12-week path</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <blockquote>\\\"The intensive model got results faster than anything I've tried — clear experiments, short cycles, and ruthless prioritization.\\\"</blockquote>\\n          <div class=\\\"meta\\\">Director, Marketing</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <blockquote>\\\"My energy and sleep improved without any medical claims — just simple, repeatable routines.\\\"</blockquote>\\n          <div class=\\\"meta\\\">Chief of Staff</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <blockquote>\\\"Measurable improvement in focus and fewer context switches. The handoff plan made it sustainable.\\\"</blockquote>\\n          <div class=\\\"meta\\\">Lead Engineer</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"methods\\\" style=\\\"margin-top:18px\\\">\\n      <h2>How results are created</h2>\\n      <div style=\\\"display:flex; gap:10px; flex-wrap:wrap; margin-top:8px\\\">\\n        <div style=\\\"background:var(--card); padding:12px; border-radius:10px; flex:1\\\">Small experiments + fast feedback</div>\\n        <div style=\\\"background:var(--card); padding:12px; border-radius:10px; flex:1\\\">Trigger-based habit design</div>\\n        <div style=\\\"background:var(--card); padding:12px; border-radius:10px; flex:1\\\">Accountability with deliverables</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"objections\\\" style=\\\"margin-top:18px\\\">\\n      <h2>Questions I often get</h2>\\n      <div style=\\\"color:var(--muted); margin-top:8px\\\">\\n        <strong>Will this conflict with my schedule?</strong>\\n        <p style=\\\"margin:6px 0\\\">We design around your calendar and protect time for habit practice. Sessions are efficient and outcome-oriented.</p>\\n        <strong>Is coaching confidential?</strong>\\n        <p style=\\\"margin:6px 0\\\">Yes — we agree on boundaries and secure communication methods at the outset.</p>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"lead\\\" class=\\\"leadmagnet\\\">\\n      <div>\\n        <strong>Lead Magnet: The First-Week Habit Blueprint</strong>\\n        <div style=\\\"color:var(--muted); margin-top:6px\\\">A practical checklist and mini-experiments you can start tomorrow.</div>\\n      </div>\\n      <div>\\n        <form onsubmit=\\\"alert('Guide sent — placeholder');return false;\\\">\\n          <input type=\\\"email\\\" placeholder=\\\"Email\\\" required style=\\\"padding:8px;border-radius:8px;border:1px solid rgba(110,80,65,0.08)\\\">\\n          <button class=\\\"btn\\\" style=\\\"margin-left:8px\\\">Send me the blueprint</button>\\n        </form>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2>Featured testimonial</h2>\\n      <div style=\\\"display:flex; gap:12px; align-items:center; margin-top:10px\\\">\\n        <div style=\\\"width:64px;height:64px;border-radius:10px;background:#fff;display:flex;align-items:center;justify-content:center\\\">\\n          <!-- small inline pattern SVG (unique) -->\\n          <svg width=\\\"44\\\" height=\\\"44\\\" viewBox=\\\"0 0 44 44\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n            <circle cx=\\\"22\\\" cy=\\\"22\\\" r=\\\"20\\\" fill=\\\"#e9a87a\\\" opacity=\\\"0.9\\\" />\\n            <path d=\\\"M12 28c6-8 20-8 24 0\\\" stroke=\\\"#c0733c\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" fill=\\\"none\\\"/>\\n          </svg>\\n        </div>\\n        <div>\\n          <blockquote style=\\\"margin:0\\\">\\\"After three months we replaced firefighting with a predictable execution cadence. The transfer session ensured the team could run it without me.\\\"</blockquote>\\n          <div class=\\\"meta\\\">COO — Enterprise rollout</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px; display:flex; justify-content:space-between; align-items:center\\\">\\n      <div style=\\\"color:var(--muted)\\\">Ready to discuss your next intensive? Call {{PHONE}} or <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule a discovery</a>\\n        <a class=\\\"btn secondary\\\" href=\\\"book.html\\\" style=\\\"margin-left:8px\\\">Reserve a slot</a>\\n      </div>\\n    </section>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbf7f4;--accent:#c46a37;--muted:#6b584d;--card:#fff;--max:900px}\\n    body{font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto; background:var(--bg); margin:0; color:#2b2b2b}\\n    .wrap{max-width:var(--max); margin:34px auto; padding:22px}\\n    nav{display:flex; gap:12px; margin-bottom:18px}\\n    nav a{color:var(--muted); text-decoration:none}\\n    .hero{background:linear-gradient(180deg,#fff 0%,#fff7f2 100%); padding:18px; border-radius:14px; display:flex; gap:16px; align-items:center}\\n    .hero h1{margin:0 0 6px}\\n    .panel{margin-top:18px; display:grid; grid-template-columns:1fr 380px; gap:16px}\\n    .card{background:var(--card); padding:16px; border-radius:12px; box-shadow:0 8px 28px rgba(40,30,26,0.06)}\\n    form{display:flex; flex-direction:column; gap:10px}\\n    input, select, textarea{padding:10px; border-radius:8px; border:1px solid rgba(110,80,65,0.08)}\\n    .btn{background:var(--accent); color:#fff; padding:10px 12px; border-radius:10px; text-decoration:none; font-weight:700; border:none}\\n    .note{color:var(--muted); font-size:14px}\\n    .faq{margin-top:12px}\\n    @media(max-width:880px){.panel{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav>\\n      <a href=\\\"index.html\\\">Overview</a>\\n      <a href=\\\"about.html\\\">The Coach</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"pricing.html\\\">Investments</a>\\n      <a href=\\\"testimonials.html\\\">Feedback</a>\\n      <strong style=\\\"color:var(--accent)\\\">Reserve</strong>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Reserve Your Intensive Strategy Session</h1>\\n        <p class=\\\"note\\\">A focused planning session to map an intensive that fits your goals and calendar. Sessions are 60–90 minutes.</p>\\n      </div>\\n\\n      <!-- inline pattern SVG (unique) -->\\n      <div aria-hidden=\\\"true\\\">\\n        <svg width=\\\"120\\\" height=\\\"120\\\" viewBox=\\\"0 0 120 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n          <rect width=\\\"120\\\" height=\\\"120\\\" rx=\\\"20\\\" fill=\\\"#fffefb\\\"/>\\n          <path d=\\\"M20 80 C40 20, 80 20, 100 80\\\" stroke=\\\"#e9a87a\\\" stroke-width=\\\"10\\\" stroke-linecap=\\\"round\\\" fill=\\\"none\\\" opacity=\\\"0.9\\\"/>\\n          <circle cx=\\\"36\\\" cy=\\\"44\\\" r=\\\"8\\\" fill=\\\"#c0733c\\\"/>\\n          <circle cx=\\\"84\\\" cy=\\\"60\\\" r=\\\"10\\\" fill=\\\"#e9a87a\\\"/>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"panel\\\">\\n      <div class=\\\"card\\\">\\n        <h2>Book a discovery</h2>\\n        <p class=\\\"note\\\">Choose a time and tell us the primary outcome you want from this intensive. We'll send a brief pre-session questionnaire.</p>\\n\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" onsubmit=\\\"alert('Booking sent (placeholder)');return false;\\\">\\n          <label>Full name</label>\\n          <input type=\\\"text\\\" name=\\\"name\\\" placeholder=\\\"Your name\\\" required>\\n\\n          <label>Email</label>\\n          <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"you@company.com\\\" required>\\n\\n          <label>Phone</label>\\n          <input type=\\\"tel\\\" name=\\\"phone\\\" placeholder=\\\"{{PHONE}}\\\">\\n\\n          <label>Desired session (local)</label>\\n          <input type=\\\"datetime-local\\\" name=\\\"date\\\" required>\\n\\n          <label>Primary outcome</label>\\n          <select name=\\\"outcome\\\">\\n            <option>Improve daily focus</option>\\n            <option>Design sustainable routines</option>\\n            <option>Reduce decision fatigue</option>\\n            <option>Other</option>\\n          </select>\\n\\n          <label>Brief context (one line)</label>\\n          <input type=\\\"text\\\" name=\\\"context\\\" placeholder=\\\"Your role and main constraint\\\">\\n\\n          <button class=\\\"btn\\\" type=\\\"submit\\\">Schedule session</button>\\n        </form>\\n\\n        <div class=\\\"faq\\\">\\n          <h3 style=\\\"margin:12px 0 6px\\\">Before you book — quick answers</h3>\\n          <div class=\\\"note\\\"><strong>How long until we start?</strong> I typically schedule discovery sessions within 1–2 weeks of inquiry.\\n          <br><strong>Where are sessions held?</strong> Secure video call; we agree on a platform during confirmation.\\n          <br><strong>Do you work with teams?</strong> Yes — I design team intensives and transfer plans at leadership scale.</div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <h3>What to expect</h3>\\n        <ol style=\\\"color:var(--muted)\\\">\\n          <li>Rapid intake & clarity on the primary constraint</li>\\n          <li>Suggested 6–12 week intensive outline</li>\\n          <li>Clear next steps and investment options</li>\\n        </ol>\\n\\n        <h3 style=\\\"margin-top:14px\\\">Why the intensive model?</h3>\\n        <p style=\\\"color:var(--muted)\\\">Compressed attention + focused experiments speed learning. You get results faster and a handoff plan for lasting change.</p>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <strong>Need a free taste?</strong>\\n          <p style=\\\"color:var(--muted); margin-top:6px\\\">Download the First-Week Habit Blueprint and try the first micro-experiment.</p>\\n          <form onsubmit=\\\"alert('Guide sent — placeholder');return false;\\\">\\n            <input type=\\\"email\\\" placeholder=\\\"Email\\\" required style=\\\"width:100%; padding:8px; border-radius:8px; border:1px solid rgba(100,80,65,0.08)\\\">\\n            <button class=\\\"btn\\\" style=\\\"width:100%; margin-top:8px\\\">Get the blueprint</button>\\n          </form>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px; color:var(--muted)\\\">\\n          Questions? Call <strong>{{PHONE}}</strong> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>Short objections guide</h3>\\n      <div style=\\\"color:var(--muted); margin-top:8px\\\">\\n        <strong>Too expensive?</strong>\\n        <p style=\\\"margin:6px 0\\\">Consider the time reclaimed and sustained performance gains — many clients see ROI in productivity gains within weeks.</p>\\n        <strong>Not sure it's the right fit?</strong>\\n        <p style=\\\"margin:6px 0\\\">The discovery clarifies fit before any further commitment.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>Client note</h3>\\n      <blockquote style=\\\"background:var(--card); padding:12px; border-radius:10px; color:var(--muted)\\\">\\\"The discovery itself was transformational — we left with a 30-day plan and clear success markers.\\\" — Executive, Finance</blockquote>\\n    </section>\\n\\n    <footer style=\\\"margin-top:22px; color:var(--muted)\\\">\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
