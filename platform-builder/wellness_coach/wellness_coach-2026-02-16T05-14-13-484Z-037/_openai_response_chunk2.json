          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff8f2;--accent:#b85b2a;--muted:#6b4f3a;--card:#fff2ea;--accent-2:#c78a5a;--radius:14px;--max:1100px}\\n    body{font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Arial; color:var(--muted);background:var(--bg);margin:0;padding:0}\\n    .wrap{max-width:var(--max);margin:36px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between;gap:16px}\\n    .brand{display:flex;align-items:center;gap:14px}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-weight:600}\\n    .hero{display:flex;gap:28px;align-items:center;margin-top:28px}\\n    .hero-card{background:linear-gradient(180deg,rgba(255,255,255,0.8),rgba(255,255,255,0.6));border-radius:18px;padding:26px;flex:1;box-shadow:0 8px 30px rgba(107,79,58,0.08)}\\n    .hero h1{margin:0;color:#3f2f23;font-size:28px}\\n    .hero p{subtle:color:var(--muted);margin-top:10px;line-height:1.5}\\n    .hero-visual{width:260px;flex-shrink:0}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:28px}\\n    .card{background:var(--card);padding:18px;border-radius:12px}\\n    .section-title{font-size:16px;color:#3b2f26;margin-bottom:10px;font-weight:700}\\n    .values-list{display:flex;flex-direction:column;gap:12px}\\n    .pill{display:inline-block;background:#ffece0;color:var(--accent);padding:6px 10px;border-radius:999px;font-weight:700}\\n    .methods ul{padding-left:18px}\\n    footer{margin-top:36px;padding-top:18px;border-top:1px solid rgba(101,79,64,0.06);display:flex;justify-content:space-between;align-items:center}\\n    .cta{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .testimonial{font-style:italic;color:#50392e}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}.hero{flex-direction:column}.hero-visual{width:100%}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">WC</div>\\n        <div>\\n          <div style=\\\"font-weight:800;color:#3b2f26\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:#7a5b49\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"testimonials.html\\\">Praise</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"hero\\\">\\n        <div class=\\\"hero-card\\\">\\n          <div class=\\\"pill\\\">Executive Wellness</div>\\n          <h1>Our approach to sustainable change</h1>\\n          <p>I help busy leaders build habits that stick — practical rhythm, measurable outcomes, and a framework you can use after the program ends. Work with {{COACH_NAME}}, {{CREDENTIALS}}, based in {{CITY}}, {{STATE}}.</p>\\n          <p style=\\\"margin-top:14px\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></p>\\n        </div>\\n        <div class=\\\"hero-visual\\\">\\n          <img src=\\\"assets/img/hero.svg\\\" alt=\\\"organic hero\\\" style=\\\"width:100%;border-radius:12px;display:block\\\">\\n        </div>\\n      </section>\\n\\n      <section class=\\\"grid\\\" aria-labelledby=\\\"values\\\">\\n        <div class=\\\"card\\\">\\n          <div class=\\\"section-title\\\" id=\\\"values\\\">Core values that guide our work</div>\\n          <div class=\\\"values-list\\\">\\n            <div><strong>Clarity over perfection</strong> — start with one behavior and scale gradually.</div>\\n            <div><strong>Actionable frameworks</strong> — tools you use every week, not theory you shelve.</div>\\n            <div><strong>Evidence-forward design</strong> — habits, checkpoints, and feedback loops.</div>\\n          </div>\\n        </div>\\n        <div class=\\\"card methods\\\">\\n          <div class=\\\"section-title\\\">How we get results</div>\\n          <ul>\\n            <li>Baseline mapping — a practical audit of current routines.</li>\\n            <li>Micro-habit architecture — 2–3 high-leverage behaviors per month.</li>\\n            <li>Accountability cadence — weekly check-ins and adaptive adjustments.</li>\\n          </ul>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:20px\\\">\\n        <div class=\\\"card\\\">\\n          <div class=\\\"section-title\\\">Common concerns (and how we address them)</div>\\n          <div>\\n            <strong>\\\"I don’t have time\\\"</strong>\\n            <div>We prioritize 10–20 minute practices that compound. The plan fits your existing calendar.\\n            </div>\\n            <strong style=\\\"display:block;margin-top:10px\\\">\\\"I tried coaching before and it didn't stick\\\"</strong>\\n            <div>We build small, measurable wins and tailor accountability to your decision environment.</div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:20px\\\" class=\\\"card\\\">\\n        <div class=\\\"section-title\\\">What clients say</div>\\n        <div class=\\\"testimonial\\\">\\\"Within six weeks I stopped reacting to work stressors and started leading with steady routines.\\\" — Senior Leader, Technology</div>\\n        <div style=\\\"margin-top:8px;font-size:13px;color:#5b4333\\\">Want more stories? Visit <a href=\\\"testimonials.html\\\">Praise</a>.</div>\\n      </section>\\n\\n      <section style=\\\"margin-top:20px\\\" class=\\\"card\\\">\\n        <div class=\\\"section-title\\\">Free guide: 7-day Habit Reset</div>\\n        <p>Grab a concise workbook that primes your week for sustainable change. It’s the first step of my intensive model.</p>\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\">\\n          <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Your email\\\" style=\\\"padding:10px;border-radius:8px;border:1px solid #e6cdbf;width:60%\\\">\\n          <button class=\\\"cta\\\" style=\\\"border:none;margin-left:8px\\\">Get the guide</button>\\n        </form>\\n      </section>\\n\\n      <section style=\\\"margin-top:20px;background:transparent;padding:0\\\">\\n        <div class=\\\"card\\\">\\n          <div class=\\\"section-title\\\">Meet {{COACH_NAME}}</div>\\n          <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n            <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\" style=\\\"width:72px;height:72px;border-radius:12px;flex-shrink:0\\\">\\n            <div>\\n              <div style=\\\"font-weight:700;color:#3b2f26\\\">{{COACH_NAME}}, {{CREDENTIALS}}</div>\\n              <div style=\\\"font-size:13px;color:#6b4f3a\\\">I partner with high-performing professionals to build resourcing habits that improve focus, sleep, and energy management without adding to their load.</div>\\n            </div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <footer>\\n        <div style=\\\"font-size:14px\\\">Questions? <a href=\\\"contact.html\\\">Contact</a> or call <strong>{{PHONE}}</strong></div>\\n        <div>&copy; <span id=\\\"year\\\">2026</span> {{BUSINESS_NAME}}</div>\\n      </footer>\\n    </main>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffaf6;--accent:#8a4826;--muted:#5a4133;--card:#fff3ec;--soft:#f3e7de}\\n    body{margin:0;font-family:Inter,system-ui,Arial;color:var(--muted);background:var(--bg)}\\n    .container{max-width:1100px;margin:30px auto;padding:24px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:16px;text-decoration:none;color:var(--muted);font-weight:600}\\n    .lead{display:flex;gap:20px;align-items:center;margin-top:22px}\\n    .lead h1{margin:0;color:#402b21;font-size:26px}\\n    .lead p{margin-top:10px}\\n    .offerings{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}\\n    .service{background:var(--card);padding:18px;border-radius:14px;box-shadow:0 6px 22px rgba(138,72,38,0.06)}\\n    .service h3{margin:0;color:#3f2f26}\\n    .service p{margin-top:8px;font-size:14px}\\n    .badge{display:inline-block;background:var(--soft);color:var(--accent);padding:6px 8px;border-radius:999px;font-weight:700}\\n    .methods{margin-top:16px;display:flex;flex-direction:column;gap:12px}\\n    .faq{margin-top:20px}\\n    footer{margin-top:26px;border-top:1px solid rgba(101,79,64,0.06);padding-top:16px;display:flex;justify-content:space-between}\\n    @media(max-width:900px){.offerings{grid-template-columns:1fr}.lead{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#b36a45);display:flex;align-items:center;justify-content:center;color:white;font-weight:800\\\">{{COACH_NAME}}</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:#7a5b49\\\">Wellness for high-impact people</div>\\n        </div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"book.html\\\">Start</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"lead\\\">\\n        <div style=\\\"flex:1\\\">\\n          <div class=\\\"badge\\\">Designed for leaders</div>\\n          <h1>Offerings: targeted support, measurable gains</h1>\\n          <p>Sessions, short intensives, and team workshops — each one centered on habit architecture, decision design, and measurable progressions.</p>\\n        </div>\\n        <div style=\\\"flex-basis:260px;\\\"> \\n          <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" style=\\\"width:100%;border-radius:10px\\\">\\n        </div>\\n      </section>\\n\\n      <section class=\\\"offerings\\\" aria-label=\\\"services\\\">\\n        <div class=\\\"service\\\">\\n          <h3>Focused 1:1 Coaching</h3>\\n          <p>Weekly sessions with accountability, habit sprints, and a tailored objective roadmap. Best for executives needing tactical shifts fast.</p>\\n          <div style=\\\"margin-top:12px;font-weight:700;color:var(--accent)\\\">Session blocks available</div>\\n        </div>\\n\\n        <div class=\\\"service\\\">\\n          <h3>Hybrid Intensive</h3>\\n          <p>Four-week concentrated program with daily micro-actions, midweek pulse checks, and an implementation workbook.</p>\\n          <div style=\\\"margin-top:12px;color:#6b4f3a\\\">Includes the 7-day Habit Reset guide</div>\\n        </div>\\n\\n        <div class=\\\"service\\\">\\n          <h3>Leadership Team Labs</h3>\\n          <p>Half-day or full-day sessions to embed resourcing practices across teams — practical rituals and accountability systems that scale.</p>\\n          <div style=\\\"margin-top:12px;color:#6b4f3a\\\">Custom pricing</div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"methods card\\\" style=\\\"margin-top:20px;padding:18px;border-radius:12px;background:linear-gradient(180deg,#fff6f0,#fff2ea)\\\">\\n        <div style=\\\"font-weight:800;color:#3b2f26\\\">Methods & tools</div>\\n        <div style=\\\"margin-top:8px\\\">We combine habit stacking, environment edits, and a simple metric set to track momentum. Every plan ends with a 90-day roadmap you own.</div>\\n        <ul style=\\\"margin-top:10px;padding-left:18px\\\">\\n          <li>Micro-experiments (7–14 day)</li>\\n          <li>Weekly accountability playbook</li>\\n          <li>Adaptive checkpoints — decisions change as you progress</li>\\n        </ul>\\n      </section>\\n\\n      <section class=\\\"faq\\\" style=\\\"margin-top:20px\\\">\\n        <div style=\\\"font-weight:800;color:#3b2f26\\\">Questions people often ask</div>\\n        <div style=\\\"margin-top:10px\\\">\\n          <strong>How quickly can I expect to feel different?</strong>\\n          <div style=\\\"margin-top:6px\\\">Many clients notice improvements within 2–4 weeks when they consistently apply the micro-habit plan.</div>\\n          <strong style=\\\"display:block;margin-top:10px\\\">Do you provide notes and follow-ups?</strong>\\n          <div style=\\\"margin-top:6px\\\">Yes — every session includes a brief implementation summary and action items.</div>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:20px;padding:18px;border-radius:12px;background:var(--card)\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px\\\">\\n          <div>\\n            <div style=\\\"font-weight:800;color:#3b2f26\\\">Grab the Habit Reset</div>\\n            <div style=\\\"margin-top:8px\\\">A quick workbook to prime your first week. Useful before any program.</div>\\n          </div>\\n          <div>\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:800\\\">Get the workbook</a>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <footer>\\n        <div>Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <strong>{{PHONE}}</strong></div>\\n        <div>&copy; 2026 {{BUSINESS_NAME}}</div>\\n      </footer>\\n    </main>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffaf4;--accent:#9a4b28;--muted:#5a4335;--card:#fff4ec}\\n    body{margin:0;font-family:Inter, system-ui, Arial;background:var(--bg);color:var(--muted)}\\n    .site{max-width:1100px;margin:28px auto;padding:22px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    header nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .mast{display:flex;gap:18px;align-items:center;margin-top:18px}\\n    .mast h1{margin:0;color:#3a2d23}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:20px}\\n    .program{background:var(--card);padding:18px;border-radius:12px}\\n    .program h2{margin:0;color:#3b2f26}\\n    .price{margin-top:10px;font-weight:800;color:var(--accent)}\\n    .features{margin-top:10px;font-size:14px}\\n    .cta{display:inline-block;background:var(--accent);color:#fff;padding:8px 12px;border-radius:10px;text-decoration:none;margin-top:12px}\\n    .objections{margin-top:18px}\\n    .testimonials{margin-top:18px;background:linear-gradient(180deg,#fff8f2,#fff3ea);padding:14px;border-radius:12px}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <header>\\n      <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"mast\\\">\\n        <div style=\\\"flex:1\\\">\\n          <h1>Intensive paths for measurable change</h1>\\n          <p>Short, focused programs designed to shift routines and produce tangible progress in 4–12 weeks. Each path includes a clear success metric and an implementation playbook.</p>\\n        </div>\\n        <div style=\\\"width:220px\\\">\\n          <img src=\\\"assets/img/hero.svg\\\" alt=\\\"program visual\\\" style=\\\"width:100%;border-radius:12px\\\">\\n        </div>\\n      </section>\\n\\n      <section class=\\\"grid\\\" aria-label=\\\"program-list\\\">\\n        <div class=\\\"program\\\">\\n          <h2>Momentum Sprint — 4 weeks</h2>\\n          <div class=\\\"price\\\">Investment: Outcome-focused block</div>\\n          <div class=\\\"features\\\">\\n            <ul>\\n              <li>Weekly 50-min sessions</li>\\n              <li>Daily micro-actions (2–3 behaviors)</li>\\n              <li>Progress dashboard and weekly check-ins</li>\\n            </ul>\\n          </div>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Apply for the Sprint</a>\\n        </div>\\n\\n        <div class=\\\"program\\\">\\n          <h2>Resilience Intensive — 8 weeks</h2>\\n          <div class=\\\"price\\\">Investment: Premium, cohort-limited</div>\\n          <div class=\\\"features\\\">\\n            <ul>\\n              <li>Twice-weekly touchpoints first month, then weekly</li>\\n              <li>Sleep and energy architecture</li>\\n              <li>90-day personalized roadmap</li>\\n            </ul>\\n          </div>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve a spot</a>\\n        </div>\\n\\n        <div class=\\\"program\\\">\\n          <h2>Leadership Reset — 12 weeks</h2>\\n          <div class=\\\"price\\\">Investment: Executive-tier engagement</div>\\n          <div class=\\\"features\\\">\\n            <ul>\\n              <li>Onboarding audit and team alignment session</li>\\n              <li>Bi-weekly coaching + team lab</li>\\n              <li>Systems to scale healthy habits across teams</li>\\n            </ul>\\n          </div>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Discuss with the coach</a>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"objections\\\">\\n        <div style=\\\"background:#fff;padding:14px;border-radius:12px\\\">\\n          <div style=\\\"font-weight:800;color:#3b2f26\\\">A few pragmatic answers</div>\\n          <div style=\\\"margin-top:8px\\\">\\n            <strong>\\\"Will this fit my schedule?\\\"</strong>\\n            <div style=\\\"margin-top:6px\\\">Programs are structured to overlay existing commitments. We map your calendar at intake and protect your limited time by creating 10–30 minute daily practices.</div>\\n            <strong style=\\\"display:block;margin-top:10px\\\">\\\"What if I miss a week?\\\"</strong>\\n            <div style=\\\"margin-top:6px\\\">Plans include recovery steps and shorter catch-up sessions — momentum is what we measure, not perfection.</div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"testimonials\\\">\\n        <div style=\\\"font-weight:800\\\">Select client outcomes</div>\\n        <div style=\\\"margin-top:8px\\\">\\\"The Resilience Intensive gave me a reproducible routine that reduced late-afternoon crashes and improved my decision clarity.\\\" — VP, Finance</div>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px;background:linear-gradient(180deg,#fff7f1,#fff3ea);padding:14px;border-radius:12px\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div>\\n            <div style=\\\"font-weight:800\\\">Start with the Habit Reset guide</div>\\n            <div style=\\\"margin-top:6px\\\">A complimentary resource that prepares you for an intensive path.</div>\\n          </div>\\n          <div>\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Get the guide</a>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <footer style=\\\"margin-top:18px;border-top:1px solid rgba(101,79,64,0.06);padding-top:12px;display:flex;justify-content:space-between\\\">\\n        <div>Questions? <a href=\\\"contact.html\\\">Contact us</a> or call <strong>{{PHONE}}</strong></div>\\n        <div>&copy; 2026 {{BUSINESS_NAME}}</div>\\n      </footer>\\n    </main>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
