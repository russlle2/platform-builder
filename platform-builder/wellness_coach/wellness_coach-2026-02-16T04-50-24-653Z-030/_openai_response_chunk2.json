          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff8f2;--card:#fff6f0;--accent:#b86b3a;--muted:#7a5a46;--glass:rgba(255,255,255,0.6)}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--muted);background:linear-gradient(180deg,#fffdfa 0%,#fff7f0 100%)}\\n    .site{max-width:980px;margin:36px auto;padding:28px}\\n    nav{display:flex;gap:18px;align-items:center;margin-bottom:18px}\\n    nav a{color:var(--muted);text-decoration:none;font-weight:600}\\n    header.hero{display:grid;grid-template-columns:1fr 320px;gap:28px;align-items:center;background:var(--card);padding:28px;border-radius:14px;box-shadow:0 6px 22px rgba(120,84,60,0.08)}\\n    .hero h1{margin:0 0 10px;font-size:28px;color:#4b3426}\\n    .hero p{margin:0 0 18px;line-height:1.5}\\n    .cta{display:inline-block;background:var(--accent);color:#fff;padding:12px 18px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .meta{font-size:13px;color:#8a6f5b}\\n    .card{background:var(--glass);padding:18px;border-radius:12px}\\n    .values{display:flex;gap:12px;margin-top:20px}\\n    .value{flex:1;background:#fff;padding:14px;border-radius:10px;box-shadow:inset 0 1px 0 rgba(255,255,255,0.6)}\\n    .methods{margin-top:26px}\\n    .methods li{margin-bottom:10px}\\n    .objections{background:#fff6f4;padding:16px;border-radius:10px;margin-top:18px}\\n    .lead{display:flex;gap:14px;align-items:center;margin-top:24px;padding:16px;background:#fff;border-radius:12px}\\n    .lead input{flex:1;padding:10px;border-radius:8px;border:1px solid #edd9cd}\\n    footer{margin-top:28px;text-align:center;color:#8a6f5b}\\n    img.avatar{width:100%;height:auto;border-radius:10px}\\n    .testimonials{margin-top:20px}\\n    .quote{background:#fff;padding:12px;border-radius:10px;margin-bottom:10px}\\n    @media(max-width:820px){header.hero{grid-template-columns:1fr;padding:18px}nav{flex-wrap:wrap}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"services.html\\\">Work With Me</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n\\n    <header class=\\\"hero\\\" aria-labelledby=\\\"about-hero\\\">\\n      <div>\\n        <h1 id=\\\"about-hero\\\">Meet your strategic wellness partner — {{COACH_NAME}}, {{CREDENTIALS}}</h1>\\n        <p class=\\\"meta\\\">I work with ambitious professionals in {{CITY}}, {{STATE}} to translate clarity into daily rituals that stick. My focus: practical frameworks, measurable habits, and accountability that respects a busy life.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n\\n        <div class=\\\"values\\\" aria-label=\\\"Core values\\\">\\n          <div class=\\\"value\\\">\\n            <strong>Practicality</strong>\\n            <div class=\\\"meta\\\">Real steps you can use tomorrow.</div>\\n          </div>\\n          <div class=\\\"value\\\">\\n            <strong>Evidence-Informed</strong>\\n            <div class=\\\"meta\\\">Structures drawn from habit science and coaching practice.</div>\\n          </div>\\n          <div class=\\\"value\\\">\\n            <strong>Sustainable Change</strong>\\n            <div class=\\\"meta\\\">Small investments with long-term lift.</div>\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"{{COACH_NAME}} avatar\\\" class=\\\"avatar\\\">\\n        <div style=\\\"margin-top:12px\\\">\\n          <div style=\\\"font-weight:700;color:#4b3426\\\">{{COACH_NAME}}</div>\\n          <div class=\\\"meta\\\">{{CREDENTIALS}} • {{CITY}}, {{STATE}}</div>\\n        </div>\\n      </aside>\\n    </header>\\n\\n    <section class=\\\"testimonials\\\" aria-labelledby=\\\"about-glow\\\">\\n      <h2 id=\\\"about-glow\\\">Client progress — what success looks like</h2>\\n      <div class=\\\"quote\\\">\\\"I cut afternoon overwhelm by 70% and finally built a morning routine that lasts.\\\" — A. R.</div>\\n      <div class=\\\"quote\\\">\\\"More energy at 4pm and real clarity on priorities. The frameworks are concrete and doable.\\\" — M. K.</div>\\n    </section>\\n\\n    <section class=\\\"methods\\\" aria-labelledby=\\\"about-methods\\\">\\n      <h2 id=\\\"about-methods\\\">How I work — a clear method</h2>\\n      <ol>\\n        <li><strong>Audit</strong> — We map routines, friction points, and measurable goals.</li>\\n        <li><strong>Architect</strong> — I design a simple, personalized habit system you can pilot for 21 days.</li>\\n        <li><strong>Anchor</strong> — Weekly coaching to troubleshoot, scale, and embed behavior.</li>\\n      </ol>\\n    </section>\\n\\n    <section class=\\\"objections\\\" aria-labelledby=\\\"about-objections\\\">\\n      <h3 id=\\\"about-objections\\\">Common concerns I address</h3>\\n      <p><strong>\\\"I don't have time.\\\"</strong> — We reframe your calendar and create 10–20 minute rituals that compound.</p>\\n      <p><strong>\\\"Will this fit my schedule?\\\"</strong> — Every plan starts with your existing habits and slowly replaces pain points.</p>\\n    </section>\\n\\n    <section class=\\\"lead\\\" aria-label=\\\"Lead magnet\\\">\\n      <svg width=\\\"56\\\" height=\\\"56\\\" aria-hidden=\\\"true\\\"><rect rx=\\\"10\\\" width=\\\"56\\\" height=\\\"56\\\" fill=\\\"#f2e6de\\\"/></svg>\\n      <div>\\n        <strong>Free guide: The 7-Day Reset for Busy Leaders</strong>\\n        <div class=\\\"meta\\\">A one-week plan to reclaim focus and steady energy. Enter email — I’ll send it right away.</div>\\n      </div>\\n      <form action=\\\"#\\\" method=\\\"post\\\" style=\\\"display:flex;gap:8px;\\\">\\n        <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Email address\\\" aria-label=\\\"Email for guide\\\">\\n        <button class=\\\"cta\\\" type=\\\"submit\\\">Send the guide</button>\\n      </form>\\n    </section>\\n\\n    <footer>\\n      <p>Ready for a focused next step? <a href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a> or call {{PHONE}}</p>\\n      <small>{{BUSINESS_NAME}} • <a href=\\\"contact.html\\\">{{EMAIL}}</a></small>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff9f5;--card:#fffdfb;--accent:#9b4f2f;--muted:#6b4e3e}\\n    body{margin:0;font-family:Inter,system-ui, -apple-system, 'Segoe UI', Roboto, Arial;background:var(--bg);color:var(--muted)}\\n    .wrap{max-width:1000px;margin:34px auto;padding:26px}\\n    nav{display:flex;gap:20px;margin-bottom:18px}\\n    nav a{text-decoration:none;color:var(--muted);font-weight:600}\\n    .hero{background:linear-gradient(135deg,#fffaf6 0%,#fff5ef 100%);padding:22px;border-radius:14px;display:flex;gap:20px;align-items:center}\\n    .hero h1{margin:0;font-size:26px;color:#442b20}\\n    .services{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .service{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 6px 18px rgba(155,79,47,0.06)}\\n    .service h3{margin:0 0 8px}\\n    .service p{margin:0 0 10px;font-size:14px}\\n    .price{font-weight:800;color:#5a3526}\\n    .methods{margin-top:18px;padding:14px;background:#fff6f2;border-radius:10px}\\n    .faq{margin-top:18px}\\n    .lead{display:flex;gap:14px;align-items:center;margin-top:20px}\\n    .lead input{flex:1;padding:10px;border-radius:8px;border:1px solid #edd9cd}\\n    .cta{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{margin-top:28px;text-align:center;color:#8a6f5b}\\n    @media(max-width:900px){.services{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Programs</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n\\n    <section class=\\\"hero\\\" aria-labelledby=\\\"services-hero\\\">\\n      <div>\\n        <h1 id=\\\"services-hero\\\">Focused offerings designed for rapid traction</h1>\\n        <p class=\\\"meta\\\">Short, sharp engagements and ongoing partnerships. Each service is anchored in routines, measurement, and weekly accountability.</p>\\n      </div>\\n      <div style=\\\"min-width:220px;text-align:right\\\">\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <div style=\\\"font-size:13px;color:#8d6b59;margin-top:8px\\\">Call to discuss: {{PHONE}}</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"services\\\" aria-labelledby=\\\"offerings\\\">\\n      <article class=\\\"service\\\">\\n        <h3>Momentum Intensive</h3>\\n        <p>A 6-week focused sprint: goal mapping, habit architecture, and twice-weekly tactical sessions to embed new routines.</p>\\n        <div class=\\\"price\\\">Investment: $2,400</div>\\n      </article>\\n\\n      <article class=\\\"service\\\">\\n        <h3>Ritual Design Session</h3>\\n        <p>Single deep-dive (90 minutes) to design a personalised daily structure you can pilot immediately.</p>\\n        <div class=\\\"price\\\">Investment: $450</div>\\n      </article>\\n\\n      <article class=\\\"service\\\">\\n        <h3>Accountability Partner</h3>\\n        <p>Ongoing weekly check-ins and monthly progress reviews — for leaders who need disciplined follow-through.</p>\\n        <div class=\\\"price\\\">Monthly retainer from $650</div>\\n      </article>\\n    </section>\\n\\n    <section class=\\\"methods\\\" aria-labelledby=\\\"service-methods\\\">\\n      <h2 id=\\\"service-methods\\\">Practical structure — what to expect</h2>\\n      <ul>\\n        <li>Initial diagnostics and a simple measurement plan.</li>\\n        <li>Design of micro-routines that fit 10–30 minutes into your day.</li>\\n        <li>Iterative testing and weekly adjustment until the habit lands.</li>\\n      </ul>\\n    </section>\\n\\n    <section class=\\\"faq\\\" aria-labelledby=\\\"service-faq\\\">\\n      <h3 id=\\\"service-faq\\\">Questions people often ask</h3>\\n      <p><strong>How quickly will I notice change?</strong> Most clients report clearer focus and small wins in 2–3 weeks; deeper habit stability in 6–12 weeks.</p>\\n      <p><strong>Is this one-size-fits-all?</strong> No — every plan is adapted to your schedule, priorities, and constraints.</p>\\n      <p><strong>Can coaching be remote?</strong> Yes — most clients meet by video and use simple tracking tools we agree on together.</p>\\n    </section>\\n\\n    <section class=\\\"lead\\\" aria-label=\\\"Lead magnet\\\">\\n      <svg width=\\\"56\\\" height=\\\"56\\\" aria-hidden=\\\"true\\\"><circle cx=\\\"28\\\" cy=\\\"28\\\" r=\\\"28\\\" fill=\\\"#f4e8e0\\\"/></svg>\\n      <div>\\n        <strong>Free checklist: The 5-Min Habit Builder</strong>\\n        <div class=\\\"meta\\\">A concise checklist to create habits that survive meetings, travel, and long weeks.</div>\\n      </div>\\n      <form action=\\\"#\\\" method=\\\"post\\\" style=\\\"display:flex;gap:8px;\\\">\\n        <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Your best email\\\">\\n        <button class=\\\"cta\\\" type=\\\"submit\\\">Get the checklist</button>\\n      </form>\\n    </section>\\n\\n    <section class=\\\"testimonials\\\" aria-labelledby=\\\"service-live\\\">\\n      <h3 id=\\\"service-live\\\">Select client notes</h3>\\n      <div class=\\\"quote\\\" style=\\\"background:#fff;padding:12px;border-radius:10px\\\">\\\"The Momentum Intensive reset my mornings and made meetings productive, not draining.\\\" — S. L.</div>\\n      <div class=\\\"quote\\\" style=\\\"background:#fff;padding:12px;border-radius:10px\\\">\\\"Accountability that is firm but not harsh — exactly what I needed to complete projects.\\\" — J. P.</div>\\n    </section>\\n\\n    <footer>\\n      <p>Ready to choose a path? <a href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a> • Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></p>\\n      <small>{{BUSINESS_NAME}} • {{COACH_NAME}}</small>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff7f1;--panel:#fffefc;--accent:#a85a33;--muted:#5d4136}\\n    body{margin:0;font-family:Georgia, 'Times New Roman', serif;background:var(--bg);color:var(--muted)}\\n    .container{max-width:1040px;margin:34px auto;padding:26px}\\n    nav{display:flex;gap:18px;margin-bottom:18px}\\n    nav a{color:var(--muted);text-decoration:none;font-weight:600}\\n    .intro{display:flex;gap:22px;align-items:flex-start}\\n    .intro h1{margin:0;font-size:30px;color:#3e271f}\\n    .grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:20px}\\n    .plan{background:var(--panel);padding:18px;border-radius:12px;box-shadow:0 8px 22px rgba(168,90,51,0.06)}\\n    .title{font-weight:800;color:#4b2f24}\\n    .features{margin-top:10px}\\n    .price{font-size:18px;font-weight:800;color:#7a4128;margin-top:12px}\\n    .cta{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;display:inline-block;margin-top:12px}\\n    .objections{margin-top:18px;padding:14px;background:#fff6f3;border-radius:10px}\\n    .lead{margin-top:20px;display:flex;gap:12px;align-items:center}\\n    .lead input{flex:1;padding:10px;border-radius:8px;border:1px solid #edd9cd}\\n    footer{margin-top:28px;text-align:center;color:#8a6f5b}\\n    @media(max-width:760px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Work With Me</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n\\n    <section class=\\\"intro\\\">\\n      <div>\\n        <h1>Intensive pathways — choose the pace you need</h1>\\n        <p class=\\\"meta\\\">Programs designed for executives who want measurable outcomes: clarity, consistent energy, and better decision bandwidth.</p>\\n      </div>\\n      <div style=\\\"margin-left:auto;text-align:right;color:#8b6a55\\\">\\n        <div style=\\\"font-weight:700\\\">{{COACH_NAME}}, {{CREDENTIALS}}</div>\\n        <div class=\\\"meta\\\">Serving clients in {{CITY}}, {{STATE}}</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"grid\\\" aria-labelledby=\\\"program-grid\\\">\\n      <article class=\\\"plan\\\" aria-labelledby=\\\"plan-ignite\\\">\\n        <div class=\\\"title\\\" id=\\\"plan-ignite\\\">Ignite — 4 week sprint</div>\\n        <p class=\\\"meta\\\">Rapid baseline, two coaching sessions per week, and habit pilots that create immediate wins.</p>\\n        <div class=\\\"features\\\">\\n          <ul>\\n            <li>2x 45min sessions weekly</li>\\n            <li>Daily micro-assignments</li>\\n            <li>Progress dashboard</li>\\n          </ul>\\n        </div>\\n        <div class=\\\"price\\\">Investment: $1,700</div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Enroll in Ignite</a>\\n      </article>\\n\\n      <article class=\\\"plan\\\" aria-labelledby=\\\"plan-reset\\\">\\n        <div class=\\\"title\\\" id=\\\"plan-reset\\\">Reset & Scale — 12 week intensive</div>\\n        <p class=\\\"meta\\\">A full cycle to redesign routines, consolidate learning, and scale wins into leadership habits.</p>\\n        <div class=\\\"features\\\">\\n          <ul>\\n            <li>Weekly 60min coaching</li>\\n            <li>Mid-program review and adjustment</li>\\n            <li>Priority scheduling and check-ins</li>\\n          </ul>\\n        </div>\\n        <div class=\\\"price\\\">Investment: $6,400 (payment plans available)</div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve Reset & Scale</a>\\n      </article>\\n\\n      <article class=\\\"plan\\\" aria-labelledby=\\\"plan-anchor\\\">\\n        <div class=\\\"title\\\" id=\\\"plan-anchor\\\">Anchor — ongoing partnership</div>\\n        <p class=\\\"meta\\\">For sustained performance: weekly coaching, quarterly strategy reviews, and adaptive habit support.</p>\\n        <div class=\\\"features\\\">\\n          <ul>\\n            <li>Weekly 45min sessions</li>\\n            <li>Quarterly goal planning</li>\\n            <li>Direct messaging support</li>\\n          </ul>\\n        </div>\\n        <div class=\\\"price\\\">Monthly retainer starting at $1,200</div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start Anchor</a>\\n      </article>\\n\\n      <article class=\\\"plan\\\" aria-labelledby=\\\"plan-team\\\">\\n        <div class=\\\"title\\\" id=\\\"plan-team\\\">Leadership Cohort — small group</div>\\n        <p class=\\\"meta\\\">A cohort model for leadership teams: frameworks, peer accountability, and measurable team rituals.</p>\\n        <div class=\\\"features\\\">\\n          <ul>\\n            <li>6-session cohort cycle</li>\\n            <li>Team diagnostic + playbook</li>\\n            <li>Facilitated group workshops</li>\\n          </ul>\\n        </div>\\n        <div class=\\\"price\\\">Custom pricing — inquire for details</div>\\n        <a class=\\\"cta\\\" href=\\\"contact.html\\\">Inquire</a>\\n      </article>\\n    </section>\\n\\n    <section class=\\\"objections\\\" aria-labelledby=\\\"program-objections\\\">\\n      <h3 id=\\\"program-objections\\\">How to know which program fits</h3>\\n      <p><strong>Need fast relapse prevention?</strong> Choose Ignite to create small, reliable anchors for your day.</p>\\n      <p><strong>Need sustainable change?</strong> Reset & Scale builds depth and resilience over 12 weeks.</p>\\n    </section>\\n\\n    <section class=\\\"lead\\\" aria-label=\\\"Lead magnet\\\">\\n      <svg width=\\\"56\\\" height=\\\"56\\\" aria-hidden=\\\"true\\\"><rect rx=\\\"8\\\" width=\\\"56\\\" height=\\\"56\\\" fill=\\\"#f3e6dd\\\"/></svg>\\n      <div>\\n        <strong>Download: Program comparison worksheet</strong>\\n        <div class=\\\"meta\\\">Simple prompts to choose the program that matches your calendar and goals.</div>\\n      </div>\\n      <form action=\\\"#\\\" method=\\\"post\\\" style=\\\"display:flex;gap:8px;\\\">\\n        <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Email for worksheet\\\">\\n        <button class=\\\"cta\\\" type=\\\"submit\\\">Send worksheet</button>\\n      </form>\\n    </section>\\n\\n    <footer>\\n      <p>Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}}. Ready to start? <a href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></p>\\n      <small>{{BUSINESS_NAME}} • {{COACH_NAME}}</small>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
