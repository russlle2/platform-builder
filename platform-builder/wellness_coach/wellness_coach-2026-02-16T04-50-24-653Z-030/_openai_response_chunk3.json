          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investment — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff6f0;--card:#fff;--accent:#b85b2f;--muted:#7a5a47;--soft:#f3e7e2;--radius:14px;--max:1100px}\\n    *{box-sizing:border-box}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;line-height:1.45;color:#3b2f2a;background:linear-gradient(180deg,var(--bg),#fff);margin:0}\\n    .wrap{max-width:var(--max);margin:36px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between;gap:20px}\\n    .brand{display:flex;align-items:center;gap:14px}\\n    .logo{width:56px;height:56px;background:var(--soft);border-radius:12px;display:grid;place-items:center;font-weight:700;color:var(--accent)}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px}\\n    .hero{display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:center;margin-top:28px}\\n    .hero-card{background:var(--card);padding:28px;border-radius:var(--radius);box-shadow:0 8px 30px rgba(56,40,32,0.06)}\\n    .tag{font-size:13px;color:var(--accent);font-weight:700}\\n    h1{margin:8px 0 10px;font-size:26px;color:#3b2f2a}\\n    p.lead{color:var(--muted);margin:0 0 18px}\\n    .price-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .tier{background:linear-gradient(180deg,#fff,var(--soft));padding:18px;border-radius:12px;border:1px solid rgba(184,91,47,0.06)}\\n    .tier h3{margin:0 0 6px;color:var(--accent)}\\n    .tier .price{font-size:20px;font-weight:700;color:#2f1f17}\\n    ul.benefits{margin:10px 0 0;padding-left:18px;color:var(--muted)}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none}\\n    .lead-magnet{margin-top:22px;background:#fffbe9;padding:16px;border-radius:12px;border:1px solid #f0d8c8}\\n    .values, .methods, .objections, .testimonials, .faq, .final-cta{margin-top:28px}\\n    .values .grid, .methods .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}\\n    .card{background:var(--card);padding:14px;border-radius:10px;border:1px solid rgba(0,0,0,0.03)}\\n    footer{margin-top:36px;color:var(--muted);font-size:13px}\\n    .muted{color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">WC</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav aria-label=\\\"Primary\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"pricing.html\\\" style=\\\"font-weight:700;color:var(--accent)\\\">Investment</a>\\n        <a href=\\\"testimonials.html\\\">Stories</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <div class=\\\"tag\\\">Investment & Commitment</div>\\n        <h1>Strategic coaching to build reliable routines and real momentum</h1>\\n        <p class=\\\"lead\\\">With focused, intensive frameworks I help executives restore daily energy, prioritize foundational habits, and translate clarity into consistent action without overwhelm.</p>\\n        <div class=\\\"price-grid\\\">\\n          <div class=\\\"tier\\\">\\n            <h3>Foundations Path</h3>\\n            <div class=\\\"price\\\">$950 / 8 weeks</div>\\n            <ul class=\\\"benefits\\\"><li>Weekly 50-min sessions</li><li>Habit blueprint</li><li>Email check-ins</li></ul>\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          </div>\\n          <div class=\\\"tier\\\">\\n            <h3>Momentum Package</h3>\\n            <div class=\\\"price\\\">$2,500 / 12 weeks</div>\\n            <ul class=\\\"benefits\\\"><li>Twice-weekly touchpoints</li><li>Accountability systems</li><li>Priority scheduling</li></ul>\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start Momentum</a>\\n          </div>\\n          <div class=\\\"tier\\\">\\n            <h3>Accelerator Intensive</h3>\\n            <div class=\\\"price\\\">$5,900 / 6 months</div>\\n            <ul class=\\\"benefits\\\"><li>Full program model: intensive</li><li>Tools + team alignment</li><li>Monthly strategy audits</li></ul>\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Apply Now</a>\\n          </div>\\n        </div>\\n        <div class=\\\"lead-magnet\\\">\\n          <strong>Free guide:</strong> \\\"7 Daily Rituals for Sustainable Energy\\\" — immediate download when you book a consult. <a href=\\\"{{PRIMARY_CTA_URL}}\\\">Claim it</a>\\n        </div>\\n      </div>\\n      <aside style=\\\"padding:18px;border-radius:14px;background:var(--soft);height:100%\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"organic pattern\\\" style=\\\"width:100%;height:auto;border-radius:10px\\\">\\n        <div style=\\\"margin-top:12px;color:var(--muted);font-size:13px\\\">With {{COACH_NAME}}, {{CREDENTIALS}} — serving leaders in {{CITY}}, {{STATE}}</div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"values\\\" aria-labelledby=\\\"values-title\\\">\\n      <h2 id=\\\"values-title\\\">Core commitments</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"card\\\"><strong>Clarity before intensity</strong><div class=\\\"muted\\\">Define the objective then design the cadence.</div></div>\\n        <div class=\\\"card\\\"><strong>Systems > willpower</strong><div class=\\\"muted\\\">Small environment and habit shifts that compound.</div></div>\\n        <div class=\\\"card\\\"><strong>Accountable but humane</strong><div class=\\\"muted\\\">Progress with flexibility, no punitive measures.</div></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"methods\\\" aria-labelledby=\\\"methods-title\\\">\\n      <h2 id=\\\"methods-title\\\">How the work unfolds</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"card\\\"><strong>Discovery sprint</strong><div class=\\\"muted\\\">Assess routines, calendar, energy drains.</div></div>\\n        <div class=\\\"card\\\"><strong>Blueprinting</strong><div class=\\\"muted\\\">A personalized weekly architecture for habits.</div></div>\\n        <div class=\\\"card\\\"><strong>Scaled accountability</strong><div class=\\\"muted\\\">Milestone checks and adaptive coaching.</div></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"objections\\\" aria-labelledby=\\\"objections-title\\\">\\n      <h2 id=\\\"objections-title\\\">Common concerns</h2>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px\\\">\\n        <div class=\\\"card\\\"><strong>I don’t have the time</strong><div class=\\\"muted\\\">We redesign small daily windows; 10–20 minutes of structured change is far more effective than sporadic effort.</div></div>\\n        <div class=\\\"card\\\"><strong>Will this fit my corporate demands?</strong><div class=\\\"muted\\\">Yes — programs are built to work around travel and intense weeks with adaptable micro-habits.</div></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"testimonials\\\" aria-labelledby=\\\"test-title\\\">\\n      <h2 id=\\\"test-title\\\">What clients report</h2>\\n      <div style=\\\"display:grid;grid-template-columns:repeat(2,1fr);gap:12px\\\">\\n        <div class=\\\"card\\\">“I reclaimed my mornings and stopped burning out midweek. {{COACH_NAME}}'s structure is surgical.” — A Senior Director</div>\\n        <div class=\\\"card\\\">“Better sleep and clearer priorities; I was surprised how consistent small changes were.” — C-suite Executive</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\" aria-labelledby=\\\"faq-title\\\">\\n      <h2 id=\\\"faq-title\\\">Pricing & commitment questions</h2>\\n      <div class=\\\"card\\\">\\n        <strong>Is there a payment plan?</strong>\\n        <div class=\\\"muted\\\">Yes. We offer monthly installments on all packages—details on application.</div>\\n      </div>\\n      <div class=\\\"card\\\" style=\\\"margin-top:10px\\\">\\n        <strong>How quickly will I see change?</strong>\\n        <div class=\\\"muted\\\">Many clients notice improved clarity in 2–3 weeks when they apply the blueprint consistently.</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"final-cta\\\">\\n      <div class=\\\"card\\\">\\n        <h3>Ready to invest in reliable routines?</h3>\\n        <p class=\\\"muted\\\">Apply for a short discovery call — limited spots per month to keep the work high-impact.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • <span class=\\\"muted\\\">{{PHONE}} • {{EMAIL}}</span></div>\\n      <div style=\\\"margin-top:8px;font-size:12px;color:var(--muted)\\\">© <span id=\\\"year\\\"></span> {{BUSINESS_NAME}} — Coaching by {{COACH_NAME}}, {{CREDENTIALS}}</div>\\n    </footer>\\n  </div>\\n  <script>document.getElementById('year').textContent=new Date().getFullYear()</script>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Client Stories — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff6f5;--accent:#8b531a;--muted:#6b5446;--card:#fff;--radius:12px;--max:1100px}\\n    body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;color:#3d2b23;background:var(--bg);margin:0}\\n    .container{max-width:var(--max);margin:28px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .lead{margin-top:16px;color:var(--muted)}\\n    .stories{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:20px}\\n    .left{display:grid;gap:12px}\\n    .story{background:var(--card);padding:16px;border-radius:var(--radius);box-shadow:0 6px 24px rgba(0,0,0,0.04)}\\n    .quote{font-style:italic;color:#2f1f16}\\n    .meta{margin-top:10px;font-size:13px;color:var(--muted)}\\n    .aside{position:relative;padding:18px;border-radius:var(--radius);background:#fff9f6}\\n    .lead-magnet{margin-top:12px;padding:12px;border-radius:10px;border:1px solid rgba(139,83,26,0.06)}\\n    .values, .methods, .objections{margin-top:18px;display:flex;gap:12px}\\n    .mini{background:var(--card);padding:12px;border-radius:10px}\\n    .cta{display:inline-block;margin-top:14px;padding:10px 12px;background:var(--accent);color:#fff;border-radius:8px;text-decoration:none}\\n    footer{margin-top:28px;color:var(--muted);font-size:13px}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"width:52px;height:52px;background:#fff border-radius:10px;display:grid;place-items:center;border-radius:12px\\\">{{COACH_NAME}}</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">Profile</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <main class=\\\"stories\\\">\\n      <section class=\\\"left\\\">\\n        <h1>Evidence of change</h1>\\n        <p class=\\\"lead\\\">Outcomes-focused feedback from leaders who transformed fragmented effort into sustainable habits.</p>\\n\\n        <article class=\\\"story\\\">\\n          <div class=\\\"quote\\\">“After 10 weeks I had a clear decision rhythm and regained two hours of focused work each morning. My team noticed the difference.”</div>\\n          <div class=\\\"meta\\\">— Director, Tech • reduced rework, improved weekly planning</div>\\n        </article>\\n\\n        <article class=\\\"story\\\">\\n          <div class=\\\"quote\\\">“The Accelerator Intensive compressed clarity and execution. We built a small set of routines that made big strategic moves possible.”</div>\\n          <div class=\\\"meta\\\">— VP Operations • launched a new initiative ahead of schedule</div>\\n        </article>\\n\\n        <article class=\\\"story\\\">\\n          <div class=\\\"quote\\\">“No jargon. Straightforward frameworks and accountability that fit my travel schedule.”</div>\\n          <div class=\\\"meta\\\">— Entrepreneur • consistent energy, better decisions</div>\\n        </article>\\n\\n        <section style=\\\"margin-top:10px\\\">\\n          <h3>Share your story</h3>\\n          <p class=\\\"lead\\\">If you've experienced change through coaching with {{COACH_NAME}}, let's add your voice. Submissions help refine the work.</p>\\n          <form action=\\\"contact.html\\\" method=\\\"get\\\">\\n            <input name=\\\"name\\\" placeholder=\\\"Your name\\\" style=\\\"padding:10px;border-radius:8px;border:1px solid #e6d6c9;width:100%\\\"><div style=\\\"height:8px\\\"></div>\\n            <textarea name=\\\"story\\\" placeholder=\\\"Short note (100 words)\\\" style=\\\"padding:10px;border-radius:8px;border:1px solid #e6d6c9;width:100%\\\"></textarea>\\n            <div style=\\\"height:8px\\\"></div>\\n            <button class=\\\"cta\\\" type=\\\"submit\\\">Share</button>\\n          </form>\\n        </section>\\n      </section>\\n\\n      <aside class=\\\"aside\\\">\\n        <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"coach avatar\\\" style=\\\"width:100%;height:auto;border-radius:8px\\\">\\n        <div style=\\\"margin-top:12px\\\"><strong>Featured case</strong></div>\\n        <div class=\\\"lead-magnet\\\">\\n          <strong>Lead magnet:</strong> Case study — \\\"Leadership Energy Architecture\\\" — get the one-page roadmap when you book an intro.\\n        </div>\\n\\n        <div class=\\\"values\\\" style=\\\"margin-top:14px\\\">\\n          <div class=\\\"mini\\\"><strong>Philosophy</strong><div class=\\\"muted\\\">Structure first, then scale.</div></div>\\n          <div class=\\\"mini\\\"><strong>Approach</strong><div class=\\\"muted\\\">Short cycles, transparent metrics.</div></div>\\n        </div>\\n\\n        <div class=\\\"methods\\\">\\n          <div class=\\\"mini\\\"><strong>Method</strong><div class=\\\"muted\\\">Weekly scaffolding + quarterly audits.</div></div>\\n          <div class=\\\"mini\\\"><strong>Tools</strong><div class=\\\"muted\\\">Calendaring, commitment contracts, micro-habits.</div></div>\\n        </div>\\n\\n        <div class=\\\"objections\\\">\\n          <div class=\\\"mini\\\"><strong>Not sure it's for me?</strong><div class=\\\"muted\\\">Book a discovery to test fit.</div></div>\\n        </div>\\n\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:block;text-align:center;margin-top:12px\\\">Book an Intro</a>\\n\\n      </aside>\\n    </main>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h3>Verification & privacy</h3>\\n      <p class=\\\"lead\\\">All testimonials are published with permission. Personal details are anonymized when requested.</p>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"margin-top:18px;color:var(--muted)\\\">{{BUSINESS_NAME}} • {{PHONE}} • {{EMAIL}} • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff8f3;--accent:#a05a2e;--muted:#6a5346;--card:#fff;--radius:14px;--max:980px}\\n    body{font-family:Georgia,serif,system-ui;color:#3b2b23;background:var(--bg);margin:0}\\n    .page{max-width:var(--max);margin:28px auto;padding:22px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .hero{background:linear-gradient(180deg,#fff, #fff8f0);padding:18px;border-radius:var(--radius);display:flex;gap:20px;align-items:center;margin-top:18px}\\n    .hero img{width:220px;border-radius:12px}\\n    .hero h1{margin:0;font-size:22px}\\n    .muted{color:var(--muted)}\\n    form{margin-top:18px;background:var(--card);padding:16px;border-radius:12px;border:1px solid rgba(0,0,0,0.03)}\\n    label{display:block;margin-top:10px;font-size:14px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e7d6c9;margin-top:6px}\\n    .row{display:grid;grid-template-columns:1fr 1fr;gap:12px}\\n    .cta{margin-top:12px;padding:10px 12px;background:var(--accent);color:#fff;border-radius:10px;border:none}\\n    .sections{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    .card{background:var(--card);padding:12px;border-radius:10px}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"page\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"width:52px;height:52px;background:#fff;border-radius:12px;display:grid;place-items:center;font-weight:700\\\">{{COACH_NAME}}</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div class=\\\"muted\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"programs.html\\\">Work With Me</a>\\n        <a href=\\\"pricing.html\\\">Investment</a>\\n        <a href=\\\"testimonials.html\\\">Stories</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <div style=\\\"font-size:13px;color:var(--accent);font-weight:700\\\">Schedule an intro</div>\\n        <h1>Book a focused discovery with {{COACH_NAME}}</h1>\\n        <p class=\\\"muted\\\">A 30–45 minute conversation to map priorities, assess fit, and clarify next steps for an intensive coaching plan.</p>\\n      </div>\\n      <div style=\\\"width:100%\\\">\\n        <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" />\\n      </div>\\n    </section>\\n\\n    <div class=\\\"sections\\\">\\n      <main>\\n        <form action=\\\"thankyou.html\\\" method=\\\"post\\\">\\n          <div class=\\\"row\\\">\\n            <div>\\n              <label for=\\\"name\\\">Name</label>\\n              <input id=\\\"name\\\" name=\\\"name\\\" required>\\n            </div>\\n            <div>\\n              <label for=\\\"email\\\">Email</label>\\n              <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required>\\n            </div>\\n          </div>\\n\\n          <label for=\\\"phone\\\">Phone</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"{{PHONE}}\\\">\\n\\n          <label for=\\\"program\\\">Which offering interests you?</label>\\n          <select id=\\\"program\\\" name=\\\"program\\\">\\n            <option>Foundations Path — 8 weeks</option>\\n            <option>Momentum Package — 12 weeks</option>\\n            <option>Accelerator Intensive — 6 months</option>\\n            <option>Custom executive design</option>\\n          </select>\\n\\n          <label for=\\\"notes\\\">Current priorities or constraints (brief)</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\"></textarea>\\n\\n          <label for=\\\"time\\\">Preferred intro times</label>\\n          <input id=\\\"time\\\" name=\\\"time\\\" placeholder=\\\"Weekdays, mornings preferred\\\">\\n\\n          <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n            <button class=\\\"cta\\\" type=\\\"submit\\\">Schedule</button>\\n            <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"text-decoration:none;color:var(--accent)\\\">Or {{\" + \\\"PRIMARY_CTA_LABEL}}\"} </a>\\n          </div>\\n        </form>\\n\\n        <section style=\\\"margin-top:14px\\\">\\n          <h3>Booking philosophy</h3>\\n          <p class=\\\"muted\\\">Short, strategic conversations create clear first steps. We prioritize timeframes and alignment over quick fixes.</p>\\n        </section>\\n\\n        <section style=\\\"margin-top:12px\\\">\\n          <h3>Obstacles & expectations</h3>\\n          <div class=\\\"card\\\">\\n            <strong>Will this be prescriptive?</strong>\\n            <div class=\\\"muted\\\">Only enough structure to anchor your goals; you get tools that fit your context, not a one-size routine.</div>\\n          </div>\\n        </section>\\n\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <strong>Quick facts</strong>\\n          <div class=\\\"muted\\\">Sessions are virtual. There is space for in-person intensives by request in {{CITY}}, {{STATE}}.</div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <strong>Values</strong>\\n          <div class=\\\"muted\\\">Practical clarity, incremental change, measurable traction.</div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <strong>What to prepare</strong>\\n          <div class=\\\"muted\\\">Bring 2–3 pain points and a typical week calendar — we’ll use that to design the first 14 days.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted)\\\">\\n      <div>{{BUSINESS_NAME}} • {{PHONE}} • {{EMAIL}} • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
