          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Pricing</title>\\n  <style>\\n    :root{--bg:#0f0f10;--card:#0f1720;--muted:#98a2b3;--accent:#ffd7a8;--glass:rgba(255,255,255,0.03);--white:#fff}\\n    body{font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Arial; color:var(--white);background:linear-gradient(180deg,#07101a 0%, #09131a 60%);margin:0;-webkit-font-smoothing:antialiased}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:28px 40px}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .brand h1{font-size:18px;margin:0;letter-spacing:0.6px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:14px}\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:40px;padding:48px 40px}\\n    .hero .intro{max-width:720px}\\n    .kicker{color:var(--accent);font-weight:600;font-size:13px}\\n    h2{font-size:36px;margin:8px 0 12px;line-height:1.02}\\n    p.lead{color:var(--muted);margin:0 0 18px}\\n    .hero-visual{background:var(--glass);border-radius:14px;padding:26px;display:flex;align-items:center;justify-content:center}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;padding:28px 40px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02), transparent);border-radius:12px;padding:20px}\\n    .price{font-size:22px;font-weight:700;color:var(--white)}\\n    .muted{color:var(--muted);font-size:14px}\\n    footer{padding:32px 40px;border-top:1px solid rgba(255,255,255,0.03);display:flex;justify-content:space-between}\\n    .cta{background:var(--accent);color:#0c0c0c;padding:12px 18px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .section-title{font-size:18px;margin:0 0 12px}\\n    .mini{font-size:13px;color:var(--muted)}\\n    .features{margin-top:12px;font-size:14px;color:var(--muted)}\\n    .pill{display:inline-block;background:rgba(255,255,255,0.04);padding:6px 10px;border-radius:999px;font-size:12px;margin-right:8px}\\n    .testi-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}\\n    .faq{background:rgba(255,255,255,0.02);padding:18px;border-radius:10px}\\n    @media(max-width:900px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}}  \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <svg width=\\\"40\\\" height=\\\"40\\\" viewBox=\\\"0 0 48 48\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><rect width=\\\"48\\\" height=\\\"48\\\" rx=\\\"10\\\" fill=\\\"#111827\\\"/><path d=\\\"M12 28c6-8 24-6 24-6\\\" stroke=\\\"#FFD7A8\\\" stroke-width=\\\"2.2\\\" stroke-linecap=\\\"round\\\"/></svg>\\n      <div>\\n        <h1>{{BUSINESS_NAME}}</h1>\\n        <div class=\\\"mini\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Who I Am</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"testimonials.html\\\">Stories</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <!-- Hero: Pricing as clarity -->\\n  <section class=\\\"hero\\\" aria-label=\\\"Pricing hero\\\">\\n    <div class=\\\"intro\\\">\\n      <div class=\\\"kicker\\\">Transparent support</div>\\n      <h2>Investment tiers built for progress — not perfection</h2>\\n      <p class=\\\"lead\\\">Choose how you want to grow. Small wins, steady habits, and a clear framework to make results predictable. Each tier includes a complimentary resource pack and a 15-minute orientation call.</p>\\n      <div style=\\\"display:flex;gap:12px;margin-top:18px;align-items:center\\\">\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <a href=\\\"contact.html\\\" style=\\\"color:var(--muted);text-decoration:none\\\">Questions? {{EMAIL}}</a>\\n      </div>\\n    </div>\\n    <div class=\\\"hero-visual\\\">\\n      <img src=\\\"assets/img/hero.svg\\\" alt=\\\"layered wellness illustration\\\" style=\\\"width:320px;height:auto\\\"/>\\n    </div>\\n  </section>\\n\\n  <!-- Story snapshot -->\\n  <section style=\\\"padding:24px 40px;display:flex;gap:20px;align-items:flex-start\\\">\\n    <div style=\\\"flex:1\\\">\\n      <h3 class=\\\"section-title\\\">Why I coach this way</h3>\\n      <p class=\\\"muted\\\">I built coaching around habits you can actually keep. My background is in applied behavior + lifestyle design — I translate intention into small, measurable actions so you feel steadier each month. No gimmicks, just practical rhythm.</p>\\n    </div>\\n    <div style=\\\"width:220px\\\">\\n      <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"coach avatar\\\" style=\\\"width:100%;border-radius:8px;background:#07151c;padding:8px\\\"/>\\n      <div style=\\\"margin-top:10px;font-size:14px\\\">{{COACH_NAME}}, {{CREDENTIALS}} — {{CITY}}, {{STATE}}</div>\\n    </div>\\n  </section>\\n\\n  <!-- Framework: The method -->\\n  <section style=\\\"padding:12px 40px\\\">\\n    <h4 class=\\\"section-title\\\">The 4-Phase Habit Framework</h4>\\n    <div style=\\\"display:flex;gap:12px;margin-top:12px\\\">\\n      <div class=\\\"card\\\" style=\\\"flex:1\\\">\\n        <div style=\\\"font-weight:700\\\">Foundations</div>\\n        <div class=\\\"muted\\\">Set a sustainable baseline: sleep, hydration, and movement anchors.</div>\\n      </div>\\n      <div class=\\\"card\\\" style=\\\"flex:1\\\">\\n        <div style=\\\"font-weight:700\\\">Micro-Progress</div>\\n        <div class=\\\"muted\\\">Tiny experiments you can repeat, so wins compound.</div>\\n      </div>\\n      <div class=\\\"card\\\" style=\\\"flex:1\\\">\\n        <div style=\\\"font-weight:700\\\">Rhythm</div>\\n        <div class=\\\"muted\\\">Routines that support energy and priorities every week.</div>\\n      </div>\\n    </div>\\n  </section>\\n\\n  <!-- Programs overview (compact) -->\\n  <section class=\\\"grid\\\" aria-label=\\\"Program tiles\\\">\\n    <div class=\\\"card\\\">\\n      <div style=\\\"font-weight:700\\\">Starter Compass</div>\\n      <div class=\\\"muted\\\">4-week onboarding to habits and clarity</div>\\n      <div class=\\\"features\\\">Weekly check-ins · Habit tracker · Resource pack</div>\\n    </div>\\n    <div class=\\\"card\\\">\\n      <div style=\\\"font-weight:700\\\">Momentum Path</div>\\n      <div class=\\\"muted\\\">12-week guided behavior change for steady results</div>\\n      <div class=\\\"features\\\">Bi-weekly coaching · Personalized plan · Email support</div>\\n    </div>\\n    <div class=\\\"card\\\">\\n      <div style=\\\"font-weight:700\\\">Sustained Change</div>\\n      <div class=\\\"muted\\\">6-month partnership to shift identity and routine</div>\\n      <div class=\\\"features\\\">Weekly sessions · Accountability system · Priority planning</div>\\n    </div>\\n  </section>\\n\\n  <!-- Pricing matrix -->\\n  <section style=\\\"padding:28px 40px\\\">\\n    <h3 class=\\\"section-title\\\">Packages & Investments</h3>\\n    <div style=\\\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px;margin-top:18px\\\">\\n      <div class=\\\"card\\\" style=\\\"border:1px solid rgba(255,255,255,0.03)\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><div style=\\\"font-weight:800\\\">Compass</div><div class=\\\"pill\\\">Entry</div></div>\\n        <div class=\\\"price\\\">$295 / one-time</div>\\n        <div class=\\\"muted\\\">4 weeks — orientation + habit setup</div>\\n        <div class=\\\"features\\\">Orientation call · Habit template · Email follow-up</div>\\n        <div style=\\\"margin-top:14px\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start Compass</a></div>\\n      </div>\\n\\n      <div class=\\\"card\\\" style=\\\"background:linear-gradient(180deg,rgba(255,215,168,0.06),transparent);border:1px solid rgba(255,215,168,0.06)\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><div style=\\\"font-weight:800\\\">Momentum</div><div class=\\\"pill\\\">Popular</div></div>\\n        <div class=\\\"price\\\">$850 / 12 weeks</div>\\n        <div class=\\\"muted\\\">Structured change with accountability</div>\\n        <div class=\\\"features\\\">6 coaching sessions · Messaging support · Habit dashboard</div>\\n        <div style=\\\"margin-top:14px\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Claim Momentum</a></div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><div style=\\\"font-weight:800\\\">Sustained Change</div><div class=\\\"pill\\\">Deep</div></div>\\n        <div class=\\\"price\\\">$4,800 / 6 months</div>\\n        <div class=\\\"muted\\\">Long-term rewiring with priority management</div>\\n        <div class=\\\"features\\\">Weekly sessions · Full plan · Priority support</div>\\n        <div style=\\\"margin-top:14px\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Apply</a></div>\\n      </div>\\n    </div>\\n\\n    <div style=\\\"margin-top:18px;color:var(--muted);font-size:13px\\\">Need a custom plan or sliding scale? Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a> or call <span style=\\\"color:var(--accent)\\\">{{PHONE}}</span>.</div>\\n  </section>\\n\\n  <!-- Testimonials strip -->\\n  <section style=\\\"padding:22px 40px;background:linear-gradient(180deg,transparent,rgba(255,255,255,0.01))\\\">\\n    <h4 class=\\\"section-title\\\">Client outcomes</h4>\\n    <div class=\\\"testi-grid\\\" style=\\\"margin-top:12px\\\">\\n      <div class=\\\"card\\\">\\n        <div style=\\\"font-weight:700\\\">\\\"Built habits that stuck\\\"</div>\\n        <div class=\\\"muted\\\">I went from overwhelmed to weekly routines that actually stick. — A.M.</div>\\n      </div>\\n      <div class=\\\"card\\\">\\n        <div style=\\\"font-weight:700\\\">\\\"Sustainable energy and boundaries\\\"</div>\\n        <div class=\\\"muted\\\">More energy, less reactive decisions. Worth every session. — R.T.</div>\\n      </div>\\n    </div>\\n  </section>\\n\\n  <!-- FAQ & final CTA -->\\n  <section style=\\\"padding:24px 40px;display:flex;gap:20px;align-items:flex-start\\\">\\n    <div style=\\\"flex:2\\\">\\n      <h4 class=\\\"section-title\\\">Quick questions</h4>\\n      <div class=\\\"faq\\\">\\n        <strong>How do I know which tier fits me?</strong>\\n        <div class=\\\"muted\\\">If you want structure and accountability, Momentum is a great middle ground. Choose Compass if you want a short, focused start.</div>\\n      </div>\\n    </div>\\n    <div style=\\\"flex:1\\\">\\n      <h4 class=\\\"section-title\\\">Ready to begin?</h4>\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book your orientation</a>\\n    </div>\\n  </section>\\n\\n  <footer>\\n    <div class=\\\"mini\\\">© {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n    <div class=\\\"mini\\\">Phone: {{PHONE}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Stories — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fafafa;--ink:#0b1720;--muted:#55606a;--accent:#8fd3c7}\\n    body{font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Arial;background:var(--bg);color:var(--ink);margin:0}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:26px 36px}\\n    .nav a{color:var(--muted);text-decoration:none;margin-left:16px}\\n    .gallery{display:grid;grid-template-columns:1fr 420px;gap:28px;padding:20px 36px}\\n    .stories{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}\\n    .story{background:white;border-radius:12px;padding:18px;box-shadow:0 6px 18px rgba(11,23,32,0.06)}\\n    .quote{font-size:16px;color:var(--ink);font-weight:600}\\n    .meta{color:var(--muted);font-size:13px;margin-top:8px}\\n    .aside{background:linear-gradient(180deg,#fff,#f3fffb);padding:18px;border-radius:12px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:var(--accent);color:#063029;text-decoration:none;font-weight:700}\\n    footer{padding:26px 36px;color:var(--muted)}\\n    @media(max-width:900px){.gallery{grid-template-columns:1fr}}  \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:14px;align-items:center\\\">\\n      <svg width=\\\"44\\\" height=\\\"44\\\" viewBox=\\\"0 0 48 48\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><rect width=\\\"48\\\" height=\\\"48\\\" rx=\\\"12\\\" fill=\\\"#e6f7f0\\\"/><path d=\\\"M14 30c6-7 20-7 26-6\\\" stroke=\\\"#8FD3C7\\\" stroke-width=\\\"2.2\\\" stroke-linecap=\\\"round\\\"/></svg>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"programs.html\\\">Programs</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <!-- Visual + stories -->\\n  <main class=\\\"gallery\\\">\\n    <div>\\n      <h2 style=\\\"margin:6px 0 12px\\\">Real changes, month by month</h2>\\n      <p style=\\\"color:var(--muted);margin:0 0 16px\\\">Short narratives that show the process — not theatrics. Read how small habits create outsized shifts.</p>\\n\\n      <div class=\\\"stories\\\">\\n        <article class=\\\"story\\\">\\n          <div class=\\\"quote\\\">\\\"Within eight weeks I had daily energy again.\\\"</div>\\n          <div class=\\\"meta\\\">Client: Jenna — Program: Momentum Path • Started with sleep and micro-workouts.</div>\\n        </article>\\n\\n        <article class=\\\"story\\\">\\n          <div class=\\\"quote\\\">\\\"I stopped spinning and learned to protect my afternoons.\\\"</div>\\n          <div class=\\\"meta\\\">Client: Marco — Program: Sustained Change • Focus on boundaries and priority mapping.</div>\\n        </article>\\n\\n        <article class=\\\"story\\\">\\n          <div class=\\\"quote\\\">\\\"Small rituals helped me stop decision fatigue.\\\"</div>\\n          <div class=\\\"meta\\\">Client: S. — Program: Starter Compass • 4-week reset with templates.</div>\\n        </article>\\n\\n        <article class=\\\"story\\\">\\n          <div class=\\\"quote\\\">\\\"I finally understand how to set up my weeks.\\\"</div>\\n          <div class=\\\"meta\\\">Client: Priya — Program: Momentum Path • Built a weekly rhythm and review.</div>\\n        </article>\\n      </div>\\n    </div>\\n\\n    <aside class=\\\"aside\\\">\\n      <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" style=\\\"width:100%;border-radius:8px;\\\"/>\\n      <h4 style=\\\"margin-top:12px\\\">Why stories matter</h4>\\n      <p style=\\\"color:var(--muted);font-size:14px;margin:0\\\">Stories make systems visible. They show which small changes were paired with accountability and which ones failed — and why. I include a short reflection with every case study so you can borrow what fits.</p>\\n      <a class=\\\"cta\\\" href=\\\"book.html\\\">Start your story</a>\\n    </aside>\\n  </main>\\n\\n  <!-- Framework cameo -->\\n  <section style=\\\"padding:18px 36px;display:flex;gap:16px;align-items:flex-start\\\">\\n    <div style=\\\"flex:1\\\">\\n      <h4 style=\\\"margin:0 0 8px\\\">Our approach, in brief</h4>\\n      <div style=\\\"color:var(--muted)\\\">Intake → Micro-habits → Weekly rhythm → Reflection. Each step is timed and measurable so you never wonder what to do next.</div>\\n    </div>\\n    <div style=\\\"width:260px\\\">\\n      <div style=\\\"background:white;border-radius:10px;padding:12px;box-shadow:0 8px 22px rgba(11,23,32,0.04)\\\">\\n        <div style=\\\"font-weight:800\\\">Free resource</div>\\n        <div style=\\\"color:var(--muted);font-size:13px;margin-top:8px\\\">Download a one-page Weekly Reset template when you book an intro.</div>\\n        <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"cta\\\" style=\\\"display:inline-block;margin-top:12px\\\">Get the template</a>\\n      </div>\\n    </div>\\n  </section>\\n\\n  <!-- Testimonials deeper with different heading -->\\n  <section style=\\\"padding:20px 36px\\\">\\n    <h3 style=\\\"margin:0 0 10px\\\">Voices from the process</h3>\\n    <div style=\\\"display:grid;grid-template-columns:repeat(3,1fr);gap:14px\\\">\\n      <div class=\\\"story\\\" style=\\\"background:#fff\\\">\\n        <div class=\\\"quote\\\">\\\"My mornings are no longer chaotic.\\\"</div>\\n        <div class=\\\"meta\\\">— K., Starter Compass</div>\\n      </div>\\n      <div class=\\\"story\\\" style=\\\"background:#fff\\\">\\n        <div class=\\\"quote\\\">\\\"I have systems for energy and boundaries.\\\"</div>\\n        <div class=\\\"meta\\\">— L., Sustained Change</div>\\n      </div>\\n      <div class=\\\"story\\\" style=\\\"background:#fff\\\">\\n        <div class=\\\"quote\\\">\\\"The weekly review changed my relationship to work.\\\"</div>\\n        <div class=\\\"meta\\\">— D., Momentum Path</div>\\n      </div>\\n    </div>\\n  </section>\\n\\n  <!-- Call to action -->\\n  <section style=\\\"padding:18px 36px;background:linear-gradient(90deg,transparent,rgba(143,211,199,0.06));display:flex;justify-content:space-between;align-items:center\\\">\\n    <div>\\n      <div style=\\\"font-weight:800\\\">Ready to craft your next chapter?</div>\\n      <div style=\\\"color:var(--muted);font-size:14px\\\">Book a 20-minute clarity call and get the Weekly Reset template.</div>\\n    </div>\\n    <div>\\n      <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"cta\\\">Book clarity call</a>\\n    </div>\\n  </section>\\n\\n  <footer>\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;padding-top:18px\\\">\\n      <div style=\\\"color:var(--muted);font-size:13px\\\">© {{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}}</div>\\n      <div style=\\\"color:var(--muted);font-size:13px\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--ink:#0b1720;--muted:#6b7280;--accent:#ffd7a8}\\n    body{font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Arial;background:var(--bg);color:var(--ink);margin:0}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 34px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:16px}\\n    .wrap{max-width:980px;margin:28px auto;padding:0 20px}\\n    .split{display:grid;grid-template-columns:1fr 360px;gap:22px}\\n    .panel{background:linear-gradient(180deg,#fff,#fff);padding:20px;border-radius:12px;box-shadow:0 10px 30px rgba(2,6,23,0.04)}\\n    label{display:block;font-size:13px;margin-bottom:6px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6e9ee;font-size:14px}\\n    .btn{background:var(--accent);border:none;padding:12px 16px;border-radius:10px;font-weight:700;cursor:pointer}\\n    .note{color:var(--muted);font-size:13px}\\n    .small{font-size:13px;color:var(--muted)}\\n    footer{padding:28px 34px;color:var(--muted)}\\n    @media(max-width:900px){.split{grid-template-columns:1fr}}  \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <svg width=\\\"40\\\" height=\\\"40\\\" viewBox=\\\"0 0 48 48\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><rect width=\\\"48\\\" height=\\\"48\\\" rx=\\\"8\\\" fill=\\\"#fff6e8\\\"/><path d=\\\"M14 26c5-7 22-6 26-5\\\" stroke=\\\"#FFD7A8\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\"/></svg>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"small\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Work With Me</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <h1 style=\\\"margin:6px 0 12px\\\">Book an intro — 20 minutes</h1>\\n    <p class=\\\"small\\\" style=\\\"margin:0 0 18px\\\">A short call to clarify goals and match you to a program. You will also receive the Weekly Reset template after booking.</p>\\n\\n    <div class=\\\"split\\\">\\n      <div class=\\\"panel\\\">\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\">\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" required placeholder=\\\"Your name\\\" />\\n\\n          <label for=\\\"email\\\" style=\\\"margin-top:12px\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required placeholder=\\\"you@domain.com\\\" />\\n\\n          <label for=\\\"program\\\" style=\\\"margin-top:12px\\\">I'm interested in</label>\\n          <select id=\\\"program\\\" name=\\\"program\\\">\\n            <option>Starter Compass — 4 weeks</option>\\n            <option>Momentum Path — 12 weeks</option>\\n            <option>Sustained Change — 6 months</option>\\n            <option>Custom plan</option>\\n          </select>\\n\\n          <label for=\\\"notes\\\" style=\\\"margin-top:12px\\\">Brief goals (one sentence)</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"What's the most important change you'd like to make?\\\"></textarea>\\n\\n          <div style=\\\"display:flex;gap:10px;margin-top:14px;align-items:center\\\">\\n            <button class=\\\"btn\\\" type=\\\"submit\\\">Book clarity call</button>\\n            <div class=\\\"note\\\">Or call: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n          </div>\\n        </form>\\n\\n        <div style=\\\"margin-top:16px\\\" class=\\\"small\\\">After you book, you will receive a short intake form to prepare and the Weekly Reset template. If you need a different time length, email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</div>\\n      </div>\\n\\n      <aside class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0\\\">What to expect</h3>\\n        <ol style=\\\"color:var(--muted);padding-left:18px\\\">\\n          <li><strong>20-minute clarity</strong> — We map one focused objective.</li>\\n          <li><strong>Plan suggestion</strong> — I recommend a path and next steps.</li>\\n          <li><strong>Decision ready</strong> — You'll know whether to begin Compass, Momentum, or Sustained Change.</li>\\n        </ol>\\n        <div style=\\\"margin-top:12px\\\"><img src=\\\"assets/img/avatar.svg\\\" alt=\\\"coach\\\" style=\\\"width:100%;border-radius:8px;background:#fff;padding:6px\\\"/></div>\\n        <div style=\\\"margin-top:12px\\\" class=\\\"small\\\">If you're booking on behalf of someone, please include context in the notes. Sessions are virtual; timezone coordination will occur in follow-up.</div>\\n      </aside>\\n    </div>\\n\\n    <!-- Pricing summary cameo for convenience -->\\n    <section style=\\\"margin-top:20px;display:flex;gap:12px;flex-wrap:wrap\\\">\\n      <div style=\\\"flex:1;min-width:220px\\\" class=\\\"panel\\\">\\n        <strong>Compass</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">$295 — ideal for a focused reset. Includes 15-minute orientation and resource pack.</div>\\n      </div>\\n      <div style=\\\"flex:1;min-width:220px\\\" class=\\\"panel\\\">\\n        <strong>Momentum</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">$850 — 12 weeks with accountability and progress tracking.</div>\\n      </div>\\n      <div style=\\\"flex:1;min-width:220px\\\" class=\\\"panel\\\">\\n        <strong>Sustained Change</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">$4,800 — six months of hands-on partnership.</div>\\n      </div>\\n    </section>\\n\\n    <!-- Testimonials short list with a unique heading -->\\n    <section style=\\\"margin-top:20px\\\">\\n      <h4 style=\\\"margin:0 0 10px\\\">Clients who've booked and sped up progress</h4>\\n      <div style=\\\"display:flex;gap:12px;flex-wrap:wrap\\\">\\n        <div style=\\\"background:#fff;padding:12px;border-radius:10px;min-width:220px\\\">\\\"Quick clarity — saved me months.\\\" — T.</div>\\n        <div style=\\\"background:#fff;padding:12px;border-radius:10px;min-width:220px\\\">\\\"The orientation call set the right pace.\\\" — S.</div>\\n      </div>\\n    </section>\\n\\n    <!-- Final FAQ, different question set -->\\n    <section style=\\\"margin-top:20px\\\" class=\\\"panel\\\">\\n      <h4 style=\\\"margin-top:0\\\">Notes people ask</h4>\\n      <div style=\\\"color:var(--muted);font-size:14px\\\">\\n        <strong>Can I reschedule?</strong>\\n        <div style=\\\"margin-bottom:8px\\\">Yes — reschedule up to 24 hours in advance via the confirmation email.</div>\\n        <strong>Are sessions recorded?</strong>\\n        <div style=\\\"margin-bottom:8px\\\">We can record if you prefer, recorded sessions are private and for your use only.</div>\\n        <strong>Do you accept sliding scale?</strong>\\n        <div>Occasionally. Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> to inquire.</div>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:980px;margin:18px auto;padding:0 20px;color:var(--muted)\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}} • © {{BUSINESS_NAME}}</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
