          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Investment Pathways</title>\\n  <style>\\n    :root{--bg:#FBF7F2;--muted:#7A5A3C;--accent:#A67C52;--card:#FFF8F3;--deep:#4A2F1E;--glass:rgba(77,55,39,0.06);font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;}\\n    *{box-sizing:border-box}\\n    body{margin:0;background:var(--bg);color:var(--deep);-webkit-font-smoothing:antialiased}\\n    .site{max-width:1100px;margin:36px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#C99A64);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;box-shadow:0 6px 18px rgba(102,66,38,0.15)}\\n    nav{display:flex;gap:18px;font-weight:600}\\n    nav a{color:var(--muted);text-decoration:none}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:22px;margin-bottom:26px}\\n    .hero-card{background:linear-gradient(180deg,#FFFDF9, #FEFBF6);padding:26px;border-radius:14px;box-shadow:0 8px 30px rgba(106,74,48,0.07)}\\n    h1{margin:0 0 8px;font-family:Georgia, serif;color:var(--deep);font-size:28px}\\n    p.lead{margin:0;color:var(--muted)}\\n    .diagnostic{background:var(--card);padding:18px;border-radius:10px;border:1px solid var(--glass)}\\n    .tiers{display:flex;gap:16px;margin-top:18px}\\n    .tier{flex:1;padding:18px;background:white;border-radius:12px;border:1px solid var(--glass);box-shadow:0 6px 18px rgba(95,62,36,0.06)}\\n    .tier h3{margin:0 0 6px;color:var(--accent)}\\n    .price{font-size:20px;color:var(--deep);font-weight:700}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:var(--accent);color:white;text-decoration:none}\\n    .features{margin-top:12px;font-size:14px;color:var(--muted)}\\n    .micro{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}\\n    .habit{background:linear-gradient(180deg,#FFF3E6,#FFF8F2);padding:10px 12px;border-radius:10px;font-size:13px;color:var(--muted);border:1px solid rgba(166,124,82,0.08)}\\n    footer{margin-top:34px;padding-top:18px;border-top:1px dashed rgba(74,47,25,0.06);display:flex;justify-content:space-between;align-items:center}\\n    .faq{margin-top:20px;padding:18px;background:#FFF8F7;border-radius:12px}\\n    .faq h4{margin:0 0 12px}\\n    .faq p{margin:6px 0;color:var(--muted)}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr}.tiers{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">WC</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted);\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"pricing.html\\\">Investment</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <h1>Investment Pathways — thoughtful, human-aligned coaching</h1>\\n        <p class=\\\"lead\\\">Choose a tier designed for cohort rhythm and sustainable habit change. Each pathway centers on outcomes: clarity, energy, and steady progress — delivered with soulful structure.</p>\\n\\n        <div class=\\\"micro\\\">\\n          <div class=\\\"habit\\\">Diagnostic tool included</div>\\n          <div class=\\\"habit\\\">Weekly small habit sprints</div>\\n          <div class=\\\"habit\\\">Live group circles</div>\\n          <div class=\\\"habit\\\">Private coaching touchpoints</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:18px;display:flex;gap:10px;align-items:center\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--deep);text-decoration:none\\\">{{PHONE}}</a></div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"diagnostic\\\">\\n        <strong style=\\\"display:block;margin-bottom:8px\\\">Quick Diagnostic</strong>\\n        <p style=\\\"margin:0 0 12px;color:var(--muted)\\\">Not sure which pathway fits? Answer three brief questions and receive a recommended starting tier and a 7-day micro-habit plan.</p>\\n        <a href=\\\"book.html\\\" class=\\\"cta\\\" style=\\\"background:#6B4F2B\\\">Start the Diagnostic</a>\\n      </aside>\\n    </section>\\n\\n    <section>\\n      <div style=\\\"display:flex;align-items:center;justify-content:space-between\\\">\\n        <div>\\n          <h2 style=\\\"margin:0;font-family:Georgia, serif;color:var(--deep)\\\">Our Cohort Tiers</h2>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">Designed for the cohort rhythm: steady learning, shared accountability, and personal check-ins.</div>\\n        </div>\\n        <div style=\\\"color:var(--muted);font-size:13px\\\">Program Model: cohort</div>\\n      </div>\\n\\n      <div class=\\\"tiers\\\">\\n        <div class=\\\"tier\\\">\\n          <h3>Seed — Intro Cohort</h3>\\n          <div class=\\\"price\\\">$297 one-time</div>\\n          <div class=\\\"features\\\">6-week guided program • Group workshops • Habit kickoff</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve a Seat</a></div>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <h3>Grow — Deep Integration</h3>\\n          <div class=\\\"price\\\">$79 / month</div>\\n          <div class=\\\"features\\\">3-month cohort • Weekly circles • 1:1 quarterly review</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Join Grow</a></div>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <h3>Flourish — Intensive Container</h3>\\n          <div class=\\\"price\\\">$1,800 / cohort</div>\\n          <div class=\\\"features\\\">6-month deep container • Limited seats • Personalized ritual map</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Apply to Flourish</a></div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h3 style=\\\"margin:0 0 8px;font-family:Georgia, serif;color:var(--deep)\\\">Framework: Root → Rhythm → Ritual</h3>\\n      <p style=\\\"margin:0;color:var(--muted)\\\">A three-stage framework: stabilize fundamentals, build daily rhythm, and anchor sustainable rituals. Pricing aligns with the depth of support in each stage.</p>\\n\\n      <div class=\\\"faq\\\">\\n        <h4>Common questions</h4>\\n        <p><strong>How many people are in a cohort?</strong><br/>Seed 20–30 • Grow 10–18 • Flourish 8–12</p>\\n        <p><strong>Do you offer refunds?</strong><br/>We outline a clear refund & transfer policy on enrollment; partial refunds are considered within the first two weeks of a cohort.</p>\\n        <p><strong>Is this clinical care?</strong><br/>No. Our coaching focuses on habits and outcomes and does not replace medical or mental health treatment.</p>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"font-size:14px;color:var(--muted)\\\">Ready to begin your path? <a href=\\\"book.html\\\" style=\\\"color:var(--deep);text-decoration:none\\\">Reserve a spot</a> or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--deep);text-decoration:none\\\">{{PHONE}}</a></div>\\n      <div style=\\\"font-size:13px;color:var(--muted)\\\">{{COACH_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Voices of Change — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#FEF9F6;--earth:#7B5232;--soft:#DAB78A;--card:#FFFFFF;--text:#432A1A}\\n    body{margin:0;background:var(--bg);font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:var(--text)}\\n    .wrap{max-width:980px;margin:28px auto;padding:22px}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}\\n    .nav a{margin-left:16px;color:var(--earth);text-decoration:none;font-weight:600}\\n    .title{background:linear-gradient(90deg, rgba(186,140,92,0.08), rgba(243,233,221,0.06));padding:22px;border-radius:12px;display:flex;justify-content:space-between;align-items:center}\\n    .title h1{margin:0;font-family:Georgia, serif;color:var(--earth)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .card{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 10px 30px rgba(120,84,58,0.06);border:1px solid rgba(123,82,50,0.04)}\\n    .quote{font-style:italic;color:#5b3b2a}\\n    .meta{margin-top:10px;font-size:13px;color:var(--earth);font-weight:600}\\n    .case{grid-column:span 3;padding:18px;background:linear-gradient(180deg,#fffdfc,#fff6ef);border-radius:12px;margin-top:14px}\\n    .small-pricing{margin-top:14px;padding:12px;border-radius:10px;background:rgba(166,124,82,0.06);display:flex;justify-content:space-between}\\n    .cta{background:var(--earth);color:white;padding:10px 12px;border-radius:10px;text-decoration:none}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}.case{grid-column:1}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"width:52px;height:52px;border-radius:10px;background:linear-gradient(135deg,#C99A64,#8C5A34);display:flex;align-items:center;justify-content:center;color:white;font-weight:700\\\">WC</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:#7b5232\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">Story</a>\\n        <a href=\\\"programs.html\\\">Work With Me</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"title\\\">\\n      <div>\\n        <h1>Voices of Change</h1>\\n        <div style=\\\"color:#6f4b33;margin-top:8px\\\">Stories from cohort members who found steadiness through small shifts.</div>\\n      </div>\\n      <div style=\\\"text-align:right\\\">\\n        <div style=\\\"color:#6f4b33;font-size:13px\\\">Want similar results?</div>\\n        <a class=\\\"cta\\\" href=\\\"pricing.html\\\">See Investment Options</a>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"grid\\\">\\n      <div class=\\\"card\\\">\\n        <div class=\\\"quote\\\">\\\"I reclaimed my mornings without pressure. The micro-habit approach made it possible.\\\"</div>\\n        <div class=\\\"meta\\\">— Maya, Seed cohort</div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div class=\\\"quote\\\">\\\"The rhythm of the group kept me accountable. I built a 10-minute ritual that lasts.\\\"</div>\\n        <div class=\\\"meta\\\">— Tomas, Grow cohort</div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div class=\\\"quote\\\">\\\"A deep container that respects pace and tenderness. I feel energetically aligned again.\\\"</div>\\n        <div class=\\\"meta\\\">— Noor, Flourish alumni</div>\\n      </div>\\n\\n      <div class=\\\"case\\\">\\n        <h3 style=\\\"margin:0 0 8px;font-family:Georgia, serif;color:var(--earth)\\\">Case Study — Rebuilding Energy Without Overwhelm</h3>\\n        <p style=\\\"margin:0;color:#6f4b33\\\">A four-month Grow participant reported a 40% increase in weekly restorative time by adopting three micro-habits: a 7-minute evening ritual, 5-minute mid-day reset, and a weekly planning circle. The cohort container offered shared accountability and a place to iterate practices.</p>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"small-pricing\\\">\\n      <div>\\n        <strong>Snapshot:</strong> Seed — $297 • Grow — $79/mo • Flourish — apply\\n        <div style=\\\"color:#6f4b33;font-size:13px;margin-top:6px\\\">All cohorts begin with a diagnostic and a 7-day micro-habit plan.</div>\\n      </div>\\n      <div style=\\\"display:flex;flex-direction:column;gap:8px;align-items:flex-end\\\">\\n        <a class=\\\"cta\\\" href=\\\"pricing.html\\\">Investment</a>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\" style=\\\"background:#8C5A34\\\">Book a Discovery</a>\\n      </div>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0 0 8px;font-family:Georgia, serif;color:var(--earth)\\\">Micro-habit Wins</h3>\\n      <p style=\\\"margin:0;color:#6f4b33\\\">Participants report momentum from tiny, consistent actions. Below are common first-month practices used across cohorts.</p>\\n      <ul style=\\\"margin-top:8px;color:#6f4b33\\\">\\n        <li>Morning anchor (3–7 min)</li>\\n        <li>Midday recalibration (2–5 min)</li>\\n        <li>Weekly reflecting circle (20 min)</li>\\n      </ul>\\n    </section>\\n\\n    <footer style=\\\"margin-top:26px;color:#6f4b33;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>Want to share your story? Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--earth);text-decoration:none\\\">{{EMAIL}}</a></div>\\n      <div>{{COACH_NAME}}, {{CREDENTIALS}} — {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#FFF8F3;--olive:#6B4F2B;--tan:#EBDCC8;--text:#472E1E}\\n    body{margin:0;background:var(--bg);font-family:Inter,system-ui,Arial;color:var(--text)}\\n    .container{max-width:920px;margin:30px auto;padding:22px}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}\\n    nav a{margin-left:14px;color:var(--olive);text-decoration:none;font-weight:600}\\n    .split{display:grid;grid-template-columns:1fr 380px;gap:18px}\\n    .panel{background:white;padding:18px;border-radius:12px;box-shadow:0 8px 26px rgba(107,79,51,0.06)}\\n    .form-group{margin-bottom:12px}\\n    label{display:block;font-size:13px;margin-bottom:6px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(107,79,51,0.08)}\\n    .btn{background:var(--olive);color:white;padding:10px 12px;border-radius:10px;text-decoration:none;display:inline-block}\\n    .note{font-size:13px;color:#6f4b33}\\n    .policies{font-size:13px;color:#6f4b33;margin-top:12px}\\n    .slots{display:flex;flex-direction:column;gap:8px}\\n    .slot{padding:10px;border-radius:8px;background:linear-gradient(180deg,#fff7ef,#fffefc);border:1px solid rgba(107,79,51,0.06)}\\n    .diagnostic{margin-top:12px;padding:12px;background:rgba(107,79,51,0.06);border-radius:8px}\\n    @media(max-width:900px){.split{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"width:50px;height:50px;border-radius:10px;background:linear-gradient(135deg,#C99A64,#8C5A34);display:flex;align-items:center;justify-content:center;color:white;font-weight:700\\\">WC</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--olive)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <main class=\\\"split\\\">\\n      <section class=\\\"panel\\\">\\n        <h2 style=\\\"margin-top:0;font-family:Georgia, serif;color:var(--text)\\\">Reserve Your Space</h2>\\n        <p class=\\\"note\\\">Choose a time for a brief discovery call. This 20-minute session helps us place you in the right cohort and gives you a starter micro-habit plan.</p>\\n\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\">\\n          <div class=\\\"form-group\\\">\\n            <label for=\\\"name\\\">Full name</label>\\n            <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"Your name\\\" required />\\n          </div>\\n\\n          <div class=\\\"form-group\\\">\\n            <label for=\\\"email\\\">Email</label>\\n            <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required />\\n          </div>\\n\\n          <div class=\\\"form-group\\\">\\n            <label for=\\\"phone\\\">Phone</label>\\n            <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"Optional\\\" />\\n          </div>\\n\\n          <div class=\\\"form-group\\\">\\n            <label for=\\\"service\\\">I'm interested in</label>\\n            <select id=\\\"service\\\" name=\\\"service\\\">\\n              <option>Seed — 6-week cohort</option>\\n              <option>Grow — 3-month cohort</option>\\n              <option>Flourish — 6-month container</option>\\n            </select>\\n          </div>\\n\\n          <div class=\\\"form-group\\\">\\n            <label for=\\\"note\\\">A short note (what you hope to change)</label>\\n            <textarea id=\\\"note\\\" name=\\\"note\\\" rows=\\\"4\\\" placeholder=\\\"A few sentences\\\"></textarea>\\n          </div>\\n\\n          <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n            <button class=\\\"btn\\\" type=\\\"submit\\\">Book Discovery</button>\\n            <div style=\\\"font-size:13px;color:var(--olive)\\\">Or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--text);text-decoration:none\\\">{{PHONE}}</a></div>\\n          </div>\\n        </form>\\n\\n        <div class=\\\"policies\\\">\\n          <strong>Policy:</strong> A short confirmation email will include a pre-session questionnaire. Cancellations accepted up to 48 hours before the call.\\n        </div>\\n      </section>\\n\\n      <aside class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0;color:var(--text)\\\">Available Discovery Slots</h3>\\n        <div class=\\\"slots\\\">\\n          <div class=\\\"slot\\\">Mon 10:00 — 10:20 AM</div>\\n          <div class=\\\"slot\\\">Wed 2:30 — 2:50 PM</div>\\n          <div class=\\\"slot\\\">Fri 9:00 — 9:20 AM</div>\\n        </div>\\n\\n        <div class=\\\"diagnostic\\\">\\n          <strong>Quick Diagnostic</strong>\\n          <p style=\\\"margin:6px 0;color:var(--olive)\\\">Complete a 3-question check before your call to unlock a tailored 7-day micro-habit plan.</p>\\n          <a class=\\\"btn\\\" href=\\\"pricing.html\\\" style=\\\"background:var(--text);margin-top:6px;display:inline-block;text-decoration:none\\\">Complete Diagnostic</a>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <strong>Investment note</strong>\\n          <p style=\\\"margin:6px 0;color:var(--olive)\\\">Discovery calls are complimentary. Program fees vary — see <a href=\\\"pricing.html\\\" style=\\\"color:var(--text);text-decoration:none\\\">Investment Pathways</a>.</p>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px;font-size:13px;color:var(--olive)\\\">\\n          <div>Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--text);text-decoration:none\\\">{{EMAIL}}</a></div>\\n          <div style=\\\"margin-top:6px\\\">{{COACH_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}}</div>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <section style=\\\"max-width:920px;margin:22px auto\\\">\\n      <h3 style=\\\"font-family:Georgia, serif;color:var(--text)\\\">What to expect in your discovery</h3>\\n      <ul style=\\\"color:var(--olive)\\\">\\n        <li>20 minutes: clarifying goals and current routines</li>\\n        <li>Receive a recommended cohort and 7-day micro-habit plan</li>\\n        <li>Opportunity to enroll in the upcoming cohort or apply to an intensive container</li>\\n      </ul>\\n    </section>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
