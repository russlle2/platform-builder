          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — About</title>\\n  <style>\\n    :root{--bg:#FFFBF6;--card:#FFF6EE;--accent:#B76E4B;--muted:#6B5B4A;--soft:#EBD9C9;--glass:rgba(255,255,255,0.7)}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;line-height:1.45;color:var(--muted);background:var(--bg);margin:0}\\n    .container{max-width:980px;margin:28px auto;padding:24px}\\n    nav{display:flex;gap:16px;align-items:center;justify-content:space-between}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .brand h1{font-size:18px;margin:0;color:var(--accent)}\\n    .nav-links a{color:var(--muted);text-decoration:none;margin-left:14px;font-weight:600}\\n    header.hero{display:grid;grid-template-columns:1fr 360px;gap:22px;align-items:center;padding:28px;background:linear-gradient(180deg,var(--soft),transparent);border-radius:14px}\\n    .hero-copy h2{font-size:28px;margin:0 0 12px;color:#462E27}\\n    .hero-copy p{margin:0 0 16px}\\n    .hero-visual{display:flex;align-items:center;justify-content:center}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(103,70,57,0.06)}\\n    section{margin-top:20px}\\n    .section-title{font-size:16px;color:#3E2C25;margin:0 0 10px}\\n    .philosophy{display:flex;gap:16px;align-items:flex-start}\\n    .philosophy p{margin:0}\\n    ul.habits{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;padding:0;list-style:none}\\n    .habit{background:var(--glass);padding:12px;border-radius:10px}\\n    .cta{display:flex;gap:12px;margin-top:18px}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .muted{color:#8A7667;font-size:14px}\\n    footer{margin-top:36px;text-align:center;font-size:13px;color:#9A8778}\\n    .diagnostic{display:flex;gap:12px;flex-direction:column}\\n    .diag-q{background:white;padding:12px;border-radius:10px}\\n    .plan-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}\\n    .plan-item{background:linear-gradient(180deg,white,var(--soft));padding:12px;border-radius:10px}\\n    @media (max-width:900px){header.hero{grid-template-columns:1fr;}\\n      .plan-grid{grid-template-columns:1fr}\\n      ul.habits{grid-template-columns:1fr}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <nav>\\n      <div class=\\\"brand\\\"><img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\" width=\\\"44\\\" height=\\\"44\\\"><h1>{{BUSINESS_NAME}}</h1></div>\\n      <div class=\\\"nav-links\\\"><a href=\\\"index.html\\\">Home</a><a href=\\\"programs.html\\\">Work With Me</a><a href=\\\"services.html\\\">Offerings</a><a href=\\\"contact.html\\\">Contact</a></div>\\n    </nav>\\n\\n    <header class=\\\"hero card\\\">\\n      <div class=\\\"hero-copy\\\">\\n        <h2>Rooted wellbeing: a grounded approach to lasting change</h2>\\n        <p class=\\\"muted\\\">I\\u2019m {{COACH_NAME}} ({{CREDENTIALS}}). My work is practical, spiritual, and bespoke\\u2014helping busy people build slow, steady systems that hold over time.</p>\\n        <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a><a class=\\\"muted\\\" href=\\\"book.html\\\">Schedule a free consult</a></div>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:12px\\\">Phone: {{PHONE}} • Email: {{EMAIL}} • {{CITY}}, {{STATE}}</p>\\n      </div>\\n      <div class=\\\"hero-visual\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"organic shapes\\\" width=\\\"320\\\" height=\\\"220\\\">\\n      </div>\\n    </header>\\n\\n    <section id=\\\"philosophy\\\">\\n      <h3 class=\\\"section-title\\\">My coaching philosophy</h3>\\n      <div class=\\\"philosophy card\\\">\\n        <div>\\n          <p class=\\\"muted\\\">I favor frameworks over prescriptions. We co-design simple rituals, small thresholds, and reflective moments so growth is sustainable not spectacular. There\\u2019s room for tenderness and discipline.</p>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:12px\\\">Outcomes I support: steady energy, clearer priorities, resilient sleep, and renewed joy — all through habit architecture and inquiry.</p>\\n        </div>\\n        <div style=\\\"min-width:160px;text-align:center\\\">\\n          <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"coach avatar\\\" width=\\\"110\\\">\\n          <p style=\\\"margin:8px 0 0;font-weight:700\\\">{{COACH_NAME}}, {{CREDENTIALS}}</p>\\n          <p class=\\\"muted\\\">Based in {{CITY}}, {{STATE}}</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"diagnostic\\\">\\n      <h3 class=\\\"section-title\\\">Quick wellness diagnostic</h3>\\n      <div class=\\\"card diagnostic\\\">\\n        <div class=\\\"diag-q\\\">1) Are you satisfied with your daily energy? <select id=\\\"q1\\\"><option value=\\\"2\\\">Yes</option><option value=\\\"1\\\">Sometimes</option><option value=\\\"0\\\">Rarely</option></select></div>\\n        <div class=\\\"diag-q\\\">2) Do you have a nightly ritual that supports sleep? <select id=\\\"q2\\\"><option value=\\\"2\\\">Yes</option><option value=\\\"1\\\">Partial</option><option value=\\\"0\\\">No</option></select></div>\\n        <div class=\\\"diag-q\\\">3) Do you practice a short daily pause for clarity? <select id=\\\"q3\\\"><option value=\\\"2\\\">Yes</option><option value=\\\"1\\\">Occasionally</option><option value=\\\"0\\\">Not at all</option></select></div>\\n        <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n          <button class=\\\"btn\\\" onclick=\\\"runDiag()\\\">See insights</button>\\n          <div id=\\\"diag-result\\\" class=\\\"muted\\\">Your quick result will appear here.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"framework\\\">\\n      <h3 class=\\\"section-title\\\">Framework I use</h3>\\n      <div class=\\\"card plan-grid\\\">\\n        <div class=\\\"plan-item\\\"><strong>Anchor</strong><p class=\\\"muted\\\">Daily micro-rituals that ground your day.</p></div>\\n        <div class=\\\"plan-item\\\"><strong>Pulse</strong><p class=\\\"muted\\\">Weekly check-ins to tune momentum.</p></div>\\n        <div class=\\\"plan-item\\\"><strong>Contour</strong><p class=\\\"muted\\\">Boundaries and environment shifts that support habits.</p></div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"micro_habits\\\">\\n      <h3 class=\\\"section-title\\\">Micro-habits to try this week</h3>\\n      <ul class=\\\"habits card\\\">\\n        <li class=\\\"habit\\\"><strong>Two-minute mindful start</strong><div class=\\\"muted\\\">Set an intention for the day.</div></li>\\n        <li class=\\\"habit\\\"><strong>Post-lunch walk</strong><div class=\\\"muted\\\">10 minutes to reset energy.</div></li>\\n        <li class=\\\"habit\\\"><strong>Evening single-task</strong><div class=\\\"muted\\\">One simple task before bed to close the day.</div></li>\\n        <li class=\\\"habit\\\"><strong>Weekly reflection</strong><div class=\\\"muted\\\">Short note on what worked.</div></li>\\n      </ul>\\n    </section>\\n\\n    <section id=\\\"pricing\\\">\\n      <h3 class=\\\"section-title\\\">Investment snapshot</h3>\\n      <div class=\\\"card\\\">\\n        <p class=\\\"muted\\\">I offer cohort programs and private coaching. Typical commitments begin at 8 weeks for habit formation. Explore full tiers on the Programs page.</p>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"programs.html\\\">Explore programs</a></div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"get-started\\\">\\n      <h3 class=\\\"section-title\\\">Ready to begin?</h3>\\n      <div class=\\\"card\\\" style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px\\\">\\n        <div>\\n          <p style=\\\"margin:0 0 8px;font-weight:700\\\">Start with a guided intake and plan</p>\\n          <p class=\\\"muted\\\" style=\\\"margin:0\\\">I\\u2019ll meet you where you are and design one small step to move forward this week.</p>\\n        </div>\\n        <div>\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <p>&copy; {{BUSINESS_NAME}} — {{COACH_NAME}} • <a href=\\\"privacy.html\\\" style=\\\"color:inherit;text-decoration:underline\\\">Privacy</a></p>\\n    </footer>\\n  </div>\\n\\n  <script>\\n    function runDiag(){\\n      let s = parseInt(document.getElementById('q1').value)+parseInt(document.getElementById('q2').value)+parseInt(document.getElementById('q3').value);\\n      let el = document.getElementById('diag-result');\\n      if(s>=5) el.textContent = 'Energy steady — focus on refinement: add one small ritual for deeper rest.';\\n      else if(s>=3) el.textContent = 'Mixed signals — prioritize one habit and test for 21 days.';\\n      else el.textContent = 'Early stage — start with tiny anchors: 2 minutes, once a day.';\\n    }\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Offerings</title>\\n  <style>\\n    :root{--bg:#FFF8F2;--tone:#5A3B2C;--warm:#DCA78B;--card:#FFF2EC;--accent:#9B5A3A}\\n    body{font-family:Inter,system-ui,Segoe UI,Roboto,Arial;margin:0;background:var(--bg);color:var(--tone)}\\n    .wrap{max-width:1000px;margin:28px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    header h1{margin:0;color:var(--accent)}\\n    nav a{margin-left:12px;text-decoration:none;color:var(--tone);font-weight:600}\\n    .hero{display:flex;gap:20px;margin-top:18px;padding:18px;border-radius:14px;background:linear-gradient(90deg,white,var(--card));align-items:center}\\n    .hero img{border-radius:10px}\\n    .offer-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px}\\n    .offer{background:white;padding:14px;border-radius:12px;box-shadow:0 8px 20px rgba(155,90,58,0.06)}\\n    .offer h3{margin:0 0 8px;color:#3F2B24}\\n    .muted{color:#8F7C70}\\n    .diagnostic-inline{margin-top:14px}\\n    .micro{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}\\n    .micro span{background:var(--card);padding:8px;border-radius:10px}\\n    .price-band{display:flex;gap:8px;align-items:center;margin-top:12px}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{margin-top:30px;text-align:center;color:#9B7F6F}\\n    @media (max-width:800px){.offer-grid{grid-template-columns:1fr}}\\n  </style>\\head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div><h1>{{BUSINESS_NAME}}</h1><div class=\\\"muted\\\">Holistic coaching with grounded rituals</div></div>\\n      <div><a href=\\\"index.html\\\">Home</a><a href=\\\"programs.html\\\">Programs</a><a href=\\\"about.html\\\">About</a><a href=\\\"pricing.html\\\">Pricing</a></div>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h2 style=\\\"margin:0\\\">Tailored services for steady wellbeing</h2>\\n        <p class=\\\"muted\\\">From single-session clarity calls to ongoing rhythm design, choose the support that fits your life.</p>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n      </div>\\n      <div><img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" width=\\\"180\\\"></div>\\n    </section>\\n\\n    <section id=\\\"services-list\\\" style=\\\"margin-top:20px\\\">\\n      <h3 style=\\\"margin:0 0 12px\\\">Offerings</h3>\\n      <div class=\\\"offer-grid\\\">\\n        <div class=\\\"offer\\\">\\n          <h3>Clarity Session — 60 min</h3>\\n          <p class=\\\"muted\\\">A focused call to identify your next intentional step and practical first habit.</p>\\n          <div class=\\\"price-band\\\"><strong>$149</strong><span class=\\\"muted\\\">one-off</span></div>\\n        </div>\\n\\n        <div class=\\\"offer\\\">\\n          <h3>Brand-New Rhythm — 6-week container</h3>\\n          <p class=\\\"muted\\\">Weekly coaching + habit micro-design. Ideal for reestablishing energy and sleep patterns.</p>\\n          <div class=\\\"price-band\\\"><strong>$895</strong><span class=\\\"muted\\\">group option available</span></div>\\n        </div>\\n\\n        <div class=\\\"offer\\\">\\n          <h3>Private Coaching — 3 months</h3>\\n          <p class=\\\"muted\\\">Bi-weekly private sessions, custom habit scaffolding, email support for accountability.</p>\\n          <div class=\\\"price-band\\\"><strong>$2400</strong><span class=\\\"muted\\\">custom payment plans</span></div>\\n        </div>\\n\\n        <div class=\\\"offer\\\">\\n          <h3>Team Wellness Workshop</h3>\\n          <p class=\\\"muted\\\">Half-day interactive workshop for teams to learn micro-habits and reset team norms.</p>\\n          <div class=\\\"price-band\\\"><strong>Contact for quote</strong></div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"diagnostic\\\" class=\\\"diagnostic-inline\\\">\\n      <h4 style=\\\"margin:10px 0\\\">Mini check: where to start?</h4>\\n      <p class=\\\"muted\\\">Pick the area you want clearer: <select id=\\\"focus\\\"><option value=\\\"sleep\\\">Sleep</option><option value=\\\"energy\\\">Energy</option><option value=\\\"boundaries\\\">Boundaries</option></select>\\n      <button class=\\\"btn\\\" style=\\\"margin-left:8px\\\" onclick=\\\"diagFocus()\\\">Recommend</button></p>\\n      <div id=\\\"focus-result\\\" class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Recommendation appears here.</div>\\n    </section>\\n\\n    <section id=\\\"micro_habits\\\" style=\\\"margin-top:18px\\\">\\n      <h4 style=\\\"margin:0 0 8px\\\">Small practices we teach</h4>\\n      <div class=\\\"micro\\\">\\n        <span>Two-minute morning centering</span>\\n        <span>Evening screen buffer (30m)</span>\\n        <span>Single priority for the day</span>\\n        <span>Weekly 15-min reflection</span>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"pricing-summary\\\" style=\\\"margin-top:18px\\\">\\n      <h4 style=\\\"margin:0 0 8px\\\">Pricing philosophy</h4>\\n      <p class=\\\"muted\\\">I price for results and access. There\\u2019s a cohort path for community and a private path for individualized change. You can preview cohorts on the Programs page.</p>\\n    </section>\\n\\n    <section id=\\\"cta\\\" style=\\\"margin-top:18px\\\">\\n      <div class=\\\"offer\\\" style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div><strong>Ready to choose a path?</strong><div class=\\\"muted\\\">Start with a clarity session to define your plan.</div></div>\\n        <div><a class=\\\"btn\\\" href=\\\"book.html\\\">Book a clarity session</a></div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <p class=\\\"muted\\\">Questions? Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></p>\\n    </footer>\\n  </div>\\n\\n  <script>\\n    function diagFocus(){\\n      const f=document.getElementById('focus').value;let r=document.getElementById('focus-result');\\n      if(f==='sleep') r.textContent='Try a 30-minute evening buffer and a single bedtime ritual for 14 nights.';\\n      if(f==='energy') r.textContent='Add two 10-minute movement breaks and a midday walk for 7 days.';\\n      if(f==='boundaries') r.textContent='Practice a 15-minute planning ritual each morning to defend priorities.';\\n    }\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Programs</title>\\n  <style>\\n    :root{--bg:#FFF7F1;--primary:#8A5A3A;--card:#FFF1E8;--muted:#6E584A;--accent:#C38968}\\n    body{font-family:Georgia,serif;margin:0;background:var(--bg);color:var(--muted)}\\n    .site{max-width:1100px;margin:26px auto;padding:18px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    header h1{margin:0;color:var(--primary)}\\n    nav a{margin-left:12px;text-decoration:none;color:var(--muted)}\\n    .intro{background:linear-gradient(180deg,white,var(--card));padding:18px;border-radius:14px;margin-top:14px}\\n    .programs{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:16px}\\n    .program{background:white;padding:16px;border-radius:12px;box-shadow:0 10px 30px rgba(138,90,58,0.06)}\\n    .program h3{margin:0 0 8px}\\n    .price{font-weight:800;color:var(--primary);font-size:18px}\\n    .micro-list{margin-top:10px}\\n    .faq{margin-top:18px;background:var(--card);padding:12px;border-radius:10px}\\n    .cta{margin-top:16px;text-align:center}\\n    .btn{background:var(--primary);color:white;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    @media(max-width:900px){.programs{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <header>\\n      <div><h1>{{BUSINESS_NAME}}</h1><div class=\\\"muted\\\">Cohort calendar & private paths</div></div>\\n      <div><a href=\\\"index.html\\\">Home</a><a href=\\\"services.html\\\">Offerings</a><a href=\\\"about.html\\\">About</a><a href=\\\"pricing.html\\\">Pricing</a></div>\\n    </header>\\n\\n    <section class=\\\"intro\\\">\\n      <div style=\\\"display:flex;gap:16px;align-items:center\\\">\\n        <div style=\\\"flex:1\\\">\\n          <h2 style=\\\"margin:0\\\">Cohorts and private pathways that build habits</h2>\\n          <p class=\\\"muted\\\">Cohorts are cyclical, social, and structured for accountability. Private pathways are individualized and flexible. Both emphasize micro-habits and ritual design.</p>\\n        </div>\\n        <div><img src=\\\"assets/img/hero.svg\\\" alt=\\\"programs\\\" width=\\\"160\\\"></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"programs\\\" aria-label=\\\"program tiers\\\">\\n      <div class=\\\"program\\\">\\n        <h3>Seed Cohort — 6 weeks</h3>\\n        <p class=\\\"muted\\\">Small group, weekly teachings, shared reflection prompts. Designed to plant new daily practices.</p>\\n        <div class=\\\"price\\\">$495 / cohort</div>\\n        <div class=\\\"micro-list\\\">\\n          <ul class=\\\"muted\\\"><li>Weekly live session</li><li>Small group breakout</li><li>Daily micro-habit prompts</li></ul>\\n        </div>\\n        <p style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Join next cohort</a></p>\\n      </div>\\n\\n      <div class=\\\"program\\\">\\n        <h3>Root Course — 12 weeks</h3>\\n        <p class=\\\"muted\\\">A deeper container: monthly 1:1 check-ins paired with cohort learning for sustained transformation.</p>\\n        <div class=\\\"price\\\">$1250 / cohort</div>\\n        <div class=\\\"micro-list\\\">\\n          <ul class=\\\"muted\\\"><li>Bi-weekly group calls</li><li>2 private sessions</li><li>Accountability framework</li></ul>\\n        </div>\\n        <p style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve a spot</a></p>\\n      </div>\\n\\n      <div class=\\\"program\\\">\\n        <h3>Private Path — bespoke</h3>\\n        <p class=\\\"muted\\\">For those needing tailored scaffolding. Includes weekly coaching and ongoing message support.</p>\\n        <div class=\\\"price\\\">From $2200</div>\\n        <div class=\\\"micro-list\\\">\\n          <ul class=\\\"muted\\\"><li>Weekly sessions</li><li>Customized habit plan</li><li>Email support between sessions</li></ul>\\n        </div>\\n        <p style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"contact.html\\\">Inquire</a></p>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"diagnostic\\\" style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0 0 10px\\\">Which path fits you?</h3>\\n      <div class=\\\"faq\\\">\\n        <p class=\\\"muted\\\">Answer two quick prompts and get a suggestion.</p>\\n        <div style=\\\"display:flex;gap:8px;margin-top:8px\\\">\\n          <select id=\\\"need\\\"><option value=\\\"accountability\\\">I need accountability</option><option value=\\\"structure\\\">I need structure</option><option value=\\\"tailored\\\">I need tailored support</option></select>\\n          <select id=\\\"time\\\"><option value=\\\"6\\\">6-8 weeks</option><option value=\\\"12\\\">3 months</option><option value=\\\"ongoing\\\">Ongoing</option></select>\\n          <button class=\\\"btn\\\" onclick=\\\"suggest()\\\">Suggest</button>\\n        </div>\\n        <div id=\\\"suggestion\\\" class=\\\"muted\\\" style=\\\"margin-top:10px\\\">Recommendation shows here.</div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"micro_habits\\\" style=\\\"margin-top:16px\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">A sample micro-habit plan</h3>\\n      <div class=\\\"program\\\" style=\\\"display:flex;flex-direction:column\\\">\\n        <ol class=\\\"muted\\\">\\n          <li>Week 1: 2-minute morning centering</li>\\n          <li>Week 2: Post-lunch reset (10 minutes)</li>\\n          <li>Week 3: Evening closure ritual (single task)</li>\\n        </ol>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:10px\\\">These small tilts compound into durable shifts.</p>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"pricing\\\" style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Pricing notes</h3>\\n      <p class=\\\"muted\\\">Cohort pricing includes teaching, group coaching, and written material. Private work is priced for access and customization. Payment plans available on request.</p>\\n    </section>\\n\\n    <section id=\\\"faq\\\" style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Common questions</h3>\\n      <div class=\\\"faq\\\">\\n        <p><strong>How big are cohorts?</strong><br><span class=\\\"muted\\\">Usually 8\\u201312 people to keep intimacy.</span></p>\\n        <p><strong>Do cohorts include 1:1 time?</strong><br><span class=\\\"muted\\\">Some tiers do; Root Course includes two private check-ins.</span></p>\\n        <p><strong>What outcomes can I expect?</strong><br><span class=\\\"muted\\\">Clearer daily energy, practical rituals, and a sustainable check-in routine. No medical claims are made.</span></p>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"cta\\\">\\n      <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </div>\\n\\n    <footer style=\\\"margin-top:20px;text-align:center;color:#A0897A\\\">Contact {{COACH_NAME}} at <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}}</footer>\\n  </div>\\n\\n  <script>\\n    function suggest(){\\n      const n=document.getElementById('need').value,t=document.getElementById('time').value;let out=document.getElementById('suggestion');\\n      if(n==='accountability' && t!=='ongoing') out.textContent='Seed Cohort is a great first step for accountability and momentum.';\\n      else if(n==='structure' && t==='12') out.textContent='Root Course pairs structure with periodic 1:1 support and is ideal for durable change.';\\n      else out.textContent='Private Path would suit ongoing, tailored support. Reach out to discuss a custom plan.';\\n    }\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"assets/img/hero.svg\",\"content\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 600 360\\\"><defs><linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#F6E7DF\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#FFEFE0\\\"/></linearGradient></defs><rect width=\\\"600\\\" height=\\\"360\\\" fill=\\\"url(#g1)\\\" rx=\\\"18\\\"/><g transform=\\\"translate(40,30)\\\"><ellipse cx=\\\"220\\\" cy=\\\"200\\\" rx=\\\"180\\\" ry=\\\"90\\\" fill=\\\"#EAD5C7\\\" opacity=\\\"0.9\\\"/><path d=\\\"M40 220 C 60 160, 160 120, 260 140 C 360 160, 420 210, 520 200\\\" fill=\\\"none\\\" stroke=\\\"#C38968\\\" stroke-width=\\\"8\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" opacity=\\\"0.6\\\"/></g><g transform=\\\"translate(420,10)\\\"><circle cx=\\\"40\\\" cy=\\\"40\\\" r=\\\"36\\\" fill=\\\"#B76E4B\\\" opacity=\\\"0.9\\\"/><path d=\\\"M10 80 C 30 60, 60 60, 80 80\\\" fill=\\\"none\\\" stroke=\\\"#F8EAE1\\\" stroke-width=\\\"6\\\" stroke-linecap=\\\"round\\\"/></g></svg>\"} \n{\"path\":\"assets/img/avatar.svg\",\"content\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 160 160\\\"><defs><linearGradient id=\\\"a\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#FFDCC5\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#FFD6B8\\\"/></linearGradient></defs><rect width=\\\"160\\\" height=\\\"160\\\" rx=\\\"20\\\" fill=\\\"#FFF7F2\\\"/><g transform=\\\"translate(24,22)\\\"><circle cx=\\\"56\\\" cy=\\\"36\\\" r=\\\"28\\\" fill=\\\"url(#a)\\\" stroke=\\\"#C38B6C\\\" stroke-width=\\\"3\\\"/><path d=\\\"M16 118c8-22 92-22 104 0\\\" fill=\\\"#EED7C8\\\" stroke=\\\"#C38B6C\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/></g></svg>\"} \n{\"path\":\"assets/img/pattern.svg\",\"content\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"200\\\" height=\\\"120\\\" viewBox=\\\"0 0 200 120\\\"><rect width=\\\"200\\\" height=\\\"120\\\" rx=\\\"10\\\" fill=\\\"#FFF3EC\\\"/><g fill=\\\"#E6CBB8\\\" opacity=\\\"0.9\\\"><path d=\\\"M20 30c18-12 36-12 54 0s36 12 54 0 36-12 54 0v60c-18 12-36 12-54