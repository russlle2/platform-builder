          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f1720;--card:#0b1220;--text:#e6eef6;--muted:#9fb1c6;--accent:#ffb86b}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;background:linear-gradient(180deg,var(--bg),#071023);color:var(--text);line-height:1.5}\\n    a{color:var(--accent);text-decoration:none}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 40px;border-bottom:1px solid rgba(255,255,255,0.03)}\\n    .brand{font-weight:700;letter-spacing:0.6px}\\n    nav a{margin-left:18px;color:var(--muted);font-size:15px}\\n    .container{max-width:980px;margin:40px auto;padding:0 24px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;margin-bottom:28px}\\n    .hero h1{font-family:Georgia,serif;font-size:48px;margin:0 0 10px;color:var(--text);line-height:1.02}\\n    .hero p{color:var(--muted);font-size:18px;margin:0 0 18px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:22px;border-radius:12px;border:1px solid rgba(255,255,255,0.04)}\\n    .meta{color:var(--muted);font-size:14px;margin-top:12px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:18px}\\n    h2{font-family:Georgia,serif;margin:0 0 12px;font-size:22px}\\n    ul{padding-left:20px;color:var(--muted)}\\n    .programs .item{padding:16px;background:rgba(255,255,255,0.02);border-radius:8px}\\n    .pricing{display:flex;gap:14px;margin-top:16px}\\n    .price{flex:1;padding:18px;border-radius:10px;background:linear-gradient(180deg,rgba(255,200,120,0.04),transparent);border:1px solid rgba(255,255,255,0.03)}\\n    .cta{display:flex;gap:12px;margin-top:20px}\\n    .btn-primary{background:var(--accent);color:#041021;padding:12px 18px;border-radius:8px;font-weight:700}\\n    .btn-ghost{border:1px solid rgba(255,255,255,0.06);padding:12px 18px;border-radius:8px;color:var(--text)}\\n    footer{padding:28px 40px;color:var(--muted);font-size:14px;border-top:1px solid rgba(255,255,255,0.03);margin-top:48px}\\n    .testi{margin-top:18px}\\n    .avatar{width:56px;height:56px;border-radius:50%;background:#092033;display:inline-block;vertical-align:middle;margin-right:12px}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Work With Me</a>\\n      <a href=\\\"services.html\\\">Support</a>\\n      <a href=\\\"testimonials.html\\\">Testimonials</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n  <main class=\\\"container\\\">\\n    <section id=\\\"hero\\\" class=\\\"hero\\\">\\n      <div>\\n        <h1>Meet {{COACH_NAME}} — Practical change without the drama</h1>\\n        <p>A coach-focused editorial approach to sustainable wellbeing: small habits, clear systems, realistic progress. I coach clients in {{CITY}}, {{STATE}} toward daily routines that build energy, focus, and resilience.</p>\\n        <div class=\\\"cta\\\">\\n          <a class=\\\"btn-primary\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a class=\\\"btn-ghost\\\" href=\\\"contact.html\\\">Contact — {{EMAIL}}</a>\\n        </div>\\n        <div class=\\\"meta\\\">Credentials: {{CREDENTIALS}} • Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n      </div>\\n      <div class=\\\"card\\\" aria-hidden=\\\"true\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"decorative\\\" style=\\\"width:100%;height:240px;object-fit:cover;border-radius:8px\\\" />\\n        <div style=\\\"margin-top:14px\\\">\\n          <strong style=\\\"display:block\\\">Lead magnet</strong>\\n          <p class=\\\"meta\\\">Download my 7-day habit tune-up — a short playbook to stabilize sleep, movement, and focus. Delivered instantly after you book a discovery call.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"story\\\" class=\\\"card\\\">\\n      <h2>Why habits matter (my story)</h2>\\n      <p style=\\\"color:var(--muted)\\\">I began coaching after years of testing systems on myself: short morning routines, micro-checklists, and weekly reviews. What stuck were tiny rituals that compounded. My coaching philosophy centers on habit architecture, not one-size-fits-all rules.</p>\\n      <p style=\\\"color:var(--muted)\\\">I work with busy professionals and parents who want practical structure and a friendly, accountable guide.</p>\\n    </section>\\n\\n    <section id=\\\"framework\\\" style=\\\"margin-top:20px\\\">\\n      <h2>My 3-Phase Path</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Phase 1 — Reset</strong>\\n          <p class=\\\"meta\\\">Simplify the day: sleep stabilizers, movement anchors, and a 3-task focus system.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Phase 2 — Build</strong>\\n          <p class=\\\"meta\\\">Create momentum through habit stacking and weekly rhythm design.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Phase 3 — Keep</strong>\\n          <p class=\\\"meta\\\">Sustain with monthly checkpoints and relapse-proofing tools.</p>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"programs\\\" class=\\\"programs\\\" style=\\\"margin-top:22px\\\">\\n      <h2>Signature Offerings</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"item\\\">\\n          <strong>Foundations Reset</strong>\\n          <p class=\\\"meta\\\">4-week focused plan — ideal for clients starting from a noisy schedule. Includes weekly check-ins and a personalized micro-plan.</p>\\n        </div>\\n        <div class=\\\"item\\\">\\n          <strong>Momentum Coaching</strong>\\n          <p class=\\\"meta\\\">3-month program for building compound habits and time-block mastery with mid-week accountability.</p>\\n        </div>\\n        <div class=\\\"item\\\">\\n          <strong>Maintenance Circle</strong>\\n          <p class=\\\"meta\\\">Ongoing monthly support to refine life rhythms and guard against burnout.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"pricing\\\" style=\\\"margin-top:22px\\\">\\n      <h2>Investment & Value</h2>\\n      <div class=\\\"pricing\\\">\\n        <div class=\\\"price\\\">\\n          <strong>Starter Tune — $450</strong>\\n          <p class=\\\"meta\\\">One-month reset + 2 coaching sessions. Great for a focused beginning.</p>\\n        </div>\\n        <div class=\\\"price\\\">\\n          <strong>Momentum Path — $1250</strong>\\n          <p class=\\\"meta\\\">Three months of weekly coaching, habit trackers, and email support.</p>\\n        </div>\\n        <div class=\\\"price\\\">\\n          <strong>Steady Care — $225/month</strong>\\n          <p class=\\\"meta\\\">Subscription for ongoing maintenance with monthly strategy sessions and priority booking.</p>\\n        </div>\\n      </div>\\n      <p class=\\\"meta\\\" style=\\\"margin-top:12px\\\">All programs include my 7-day habit tune-up and a 20-minute planning call. Custom payment plans available.</p>\\n    </section>\\n\\n    <section id=\\\"testimonials\\\" class=\\\"card testi\\\" style=\\\"margin-top:22px\\\">\\n      <h2>Voices from Clients</h2>\\n      <div style=\\\"display:flex;gap:12px;align-items:center;margin-top:12px\\\">\\n        <span class=\\\"avatar\\\" aria-hidden=\\\"true\\\"><img src=\\\"assets/img/avatar.svg\\\" alt=\\\"\\\" style=\\\"width:56px;height:56px;border-radius:50%\\\" /></span>\\n        <div>\\n          <strong>\\\"More energy without extreme changes\\\"</strong>\\n          <p class=\\\"meta\\\">\\\"{{COACH_NAME}} helped me find small wins every day. The progress felt real and sustainable.\\\" — A client in {{CITY}}</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"cta\\\" class=\\\"card\\\" style=\\\"margin-top:22px\\\">\\n      <h2>Ready to Begin?</h2>\\n      <p class=\\\"meta\\\">Book a 20-minute discovery call to see which path fits you. No pressure, just clarity.</p>\\n      <div class=\\\"cta\\\">\\n        <a class=\\\"btn-primary\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <a class=\\\"btn-ghost\\\" href=\\\"book.html\\\">Schedule</a>\\n      </div>\\n    </section>\\n  </main>\\n  <footer>\\n    <div style=\\\"max-width:980px;margin:0 auto;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n      <div>Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfbfd;--ink:#071122;--muted:#3b556b;--accent:#2b8a78}\\n    body{margin:0;font-family:Inter,system-ui,Arial,Helvetica,sans-serif;background:var(--bg);color:var(--ink)}\\n    header{display:flex;justify-content:space-between;padding:22px 34px;border-bottom:1px solid rgba(7,17,34,0.06)}\\n    .logo{font-weight:700}\\n    nav a{margin-left:16px;color:var(--muted);font-size:15px}\\n    .wrap{max-width:1100px;margin:36px auto;padding:0 20px}\\n    .hero{background:#fff;padding:28px;border-radius:12px;display:flex;gap:24px;align-items:center}\\n    .hero h1{margin:0;font-size:34px}\\n    .hero p{margin:8px 0;color:var(--muted)}\\n    .two{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:20px}\\n    .panel{background:#fff;padding:18px;border-radius:10px;border:1px solid rgba(7,17,34,0.04)}\\n    .services-list{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}\\n    .service{padding:12px;border-radius:8px;background:linear-gradient(180deg,rgba(43,138,120,0.03),transparent)}\\n    .faq{margin-top:12px;color:var(--muted)}\\n    .btn{display:inline-block;padding:10px 14px;background:var(--accent);color:#fff;border-radius:8px;text-decoration:none}\\n    footer{padding:26px 34px;color:var(--muted);margin-top:28px;border-top:1px solid rgba(7,17,34,0.06)}\\n    @media(max-width:860px){.two{grid-template-columns:1fr}.services-list{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Story</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Services & Support designed for real life</h1>\\n        <p>Strategic coaching, short intensives, and habit micro-courses. Each offering is built to fit around your schedule and deliver measurable routines.</p>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n      <div class=\\\"panel\\\" aria-hidden=\\\"true\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"\\\" style=\\\"width:100%;height:160px;object-fit:cover;border-radius:8px\\\" />\\n        <p style=\\\"margin-top:12px;color:var(--muted)\\\">Not sure where to start? Book a discovery call and we'll map a 6-week trial plan.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"two\\\">\\n      <div>\\n        <div class=\\\"panel\\\">\\n          <h2>Coaching Philosophy</h2>\\n          <p class=\\\"faq\\\">I use a strengths-based, evidence-informed approach: set clear thresholds, design tiny rituals, and track weekly wins. Coaching focuses on identity-based habits and pragmatic accountability.</p>\\n          <h3 style=\\\"margin-top:12px\\\">What I don't do</h3>\\n          <p class=\\\"faq\\\">No fad diets, no quick fixes. We avoid medical claims and focus on behaviors you can control.</p>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:14px\\\">\\n          <h2>Core Framework</h2>\\n          <ul class=\\\"faq\\\">\\n            <li>Anchor Habits — morning/evening rituals</li>\\n            <li>Micro-Goals — 2-3 focus tasks per day</li>\\n            <li>Weekly Rituals — planning and reflection</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:14px\\\">\\n          <h2>Tailored Sessions</h2>\\n          <div class=\\\"services-list\\\" style=\\\"margin-top:8px\\\">\\n            <div class=\\\"service\\\">\\n              <strong>90-Minute Strategy Deep-Dive</strong>\\n              <p class=\\\"faq\\\">Create a 6-week blueprint and immediate next steps.</p>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <strong>Weekly Accountability</strong>\\n              <p class=\\\"faq\\\">Short 30-min weekly check-ins, habit review, and adjustments.</p>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <strong>Corporate Workshop</strong>\\n              <p class=\\\"faq\\\">Team rhythm design and micro-habit training (virtual).</p>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <strong>Micro-Course</strong>\\n              <p class=\\\"faq\\\">Self-paced modules: Sleep, Focus, Movement.</p>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <h2>Packages & Pricing</h2>\\n          <p class=\\\"faq\\\"><strong>Starter Session</strong> — $150 (90 minutes)</p>\\n          <p class=\\\"faq\\\"><strong>Focused Sprint</strong> — $790 (6-week program)</p>\\n          <p class=\\\"faq\\\"><strong>Ongoing Support</strong> — $300/month</p>\\n          <a class=\\\"btn\\\" href=\\\"pricing.html\\\" style=\\\"display:inline-block;margin-top:10px\\\">See full pricing</a>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h2>FAQ</h2>\\n          <p class=\\\"faq\\\"><strong>How soon will I see changes?</strong> Clients typically notice small wins in 7–14 days when they commit to two anchor habits.</p>\\n          <p class=\\\"faq\\\"><strong>Is this medical advice?</strong> No. I provide coaching for behaviors and routines, not medical diagnosis.</p>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h2>Contact</h2>\\n          <p class=\\\"faq\\\">Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></p>\\n          <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" style=\\\"width:100%;margin-top:10px;border-radius:6px\\\" />\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px;display:grid;grid-template-columns:1fr 1fr;gap:12px\\\">\\n      <div class=\\\"panel\\\">\\n        <h2>Client Feedback</h2>\\n        <p class=\\\"faq\\\">\\\"I finally sleep better and get more focused work done before noon.\\\" — Client, marketing director</p>\\n      </div>\\n      <div class=\\\"panel\\\">\\n        <h2>Quick Start Offer</h2>\\n        <p class=\\\"faq\\\">Sign up for the 6-week Focused Sprint and receive a companion habit tracker workbook.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\" class=\\\"panel\\\">\\n      <h2>Start a Conversation</h2>\\n      <p class=\\\"faq\\\">Not ready to commit? Book a free 20-minute chat to explore options.</p>\\n      <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n      <div><a href=\\\"contact.html\\\">Contact</a> • <a href=\\\"privacy.html\\\">Privacy</a></div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071229;--card:#081827;--muted:#9fb3c9;--accent:#ffd166}\\n    body{margin:0;font-family:Georgia,serif;color:var(--muted);background:linear-gradient(180deg,#071229 0%,#041626 100%)}\\n    header{display:flex;justify-content:space-between;padding:26px 36px;border-bottom:1px solid rgba(255,255,255,0.03);color:var(--muted)}\\n    nav a{margin-left:16px;color:var(--muted)}\\n    .wrap{max-width:1000px;margin:30px auto;padding:0 20px}\\n    .intro{display:flex;gap:20px;align-items:flex-start}\\n    .intro h1{color:#fff;margin:0;font-size:40px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .card{background:linear-gradient(180deg,rgba(255,209,102,0.04),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .card h3{color:#fff;margin:0 0 8px;font-family:Georgia,serif}\\n    .price{font-weight:700;color:var(--accent);margin-top:8px}\\n    .micro{margin-top:12px;background:rgba(255,255,255,0.02);padding:12px;border-radius:8px}\\n    .subscribe{display:flex;gap:10px;margin-top:16px}\\n    .btn{background:var(--accent);color:#071229;padding:10px 14px;border-radius:8px;font-weight:700;text-decoration:none}\\n    .faq{background:rgba(255,255,255,0.02);padding:12px;border-radius:8px;margin-top:16px}\\n    footer{margin-top:28px;padding:22px;color:var(--muted);border-top:1px solid rgba(255,255,255,0.03)}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}.intro{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div>{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"intro\\\">\\n      <div>\\n        <h1>Paths to Sustainable Wellness</h1>\\n        <p style=\\\"color:var(--muted);max-width:620px\\\">Select a path designed around outcomes: sleep stabilization, daily energy, or consistent fitness. Each path combines coaching, micro-courses, and a practical toolkit.</p>\\n        <div style=\\\"margin-top:12px\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start with a call</a>\\n        </div>\\n      </div>\\n      <div style=\\\"width:320px\\\">\\n        <div class=\\\"card\\\">\\n          <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" style=\\\"width:100%;height:140px;object-fit:cover;border-radius:8px\\\" />\\n          <p style=\\\"color:var(--muted);margin-top:10px\\\">Free resource: The 7-day habit tune-up for all program sign-ups.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h2 style=\\\"color:#fff\\\">Outcome-Focused Roadmaps</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"card\\\">\\n          <h3>The Sleep Steward Path</h3>\\n          <p class=\\\"micro\\\">4-week blueprint that targets sleep regularity and evening routines. Includes sleep journal and two coaching sessions.</p>\\n          <div class=\\\"price\\\">$390</div>\\n          <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Join Sleep Steward</a></div>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <h3>Energy Architecture</h3>\\n          <p class=\\\"micro\\\">12-week plan to rebuild daily energy through movement anchors, nutrient timing, and focused breaks.</p>\\n          <div class=\\\"price\\\">$1290</div>\\n          <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Join Energy Path</a></div>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <h3>Focus & Flow Sprint</h3>\\n          <p class=\\\"micro\\\">6-week sprint for people who want to regain focused work windows and reduce distractions.</p>\\n          <div class=\\\"price\\\">$690</div>\\n          <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Join Flow Sprint</a></div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h2 style=\\\"color:#fff\\\">Micro-Course Catalog</h2>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-wrap:wrap\\\">\\n        <div class=\\\"card\\\" style=\\\"flex:1 1 300px\\\">\\n          <strong>30-min Sleep Reset</strong>\\n          <p class=\\\"micro\\\">Short guided module + checklist.</p>\\n          <div class=\\\"price\\\">$29</div>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"flex:1 1 300px\\\">\\n          <strong>Movement Without the Gym</strong>\\n          <p class=\\\"micro\\\">Daily 10-minute anchors to build consistency.</p>\\n          <div class=\\\"price\\\">$39</div>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"flex:1 1 300px\\\">\\n          <strong>Weekly Planning Template</strong>\\n          <p class=\\\"micro\\\">A guided planner to protect your most important hours.</p>\\n          <div class=\\\"price\\\">$19</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"m