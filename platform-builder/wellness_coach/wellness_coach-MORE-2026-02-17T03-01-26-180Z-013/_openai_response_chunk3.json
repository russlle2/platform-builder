          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Membership Pricing — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfdfc;--muted:#6b7280;--accent:#2b8a7a;--card:#ffffff;--glass:rgba(255,255,255,0.65);--shadow:0 6px 20px rgba(16,24,40,0.08)}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:#0f172a;background:var(--bg);}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px;background:linear-gradient(180deg, rgba(43,138,122,0.06), transparent);backdrop-filter: blur(6px);}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:52px;height:52px;border-radius:10px;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),#5bb39f);color:white;font-weight:700}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-size:14px}\\n    .nav-right a{background:var(--accent);color:white;padding:8px 14px;border-radius:8px;text-decoration:none;font-weight:600}\\n    main{max-width:1100px;margin:34px auto;padding:0 24px}\\n    .hero{display:flex;gap:28px;align-items:center;padding:28px;border-radius:14px;background:linear-gradient(90deg, rgba(43,138,122,0.06), rgba(43,138,122,0.02));box-shadow:var(--shadow)}\\n    .hero h1{margin:0;font-size:28px;color:#052f2a}\\n    .hero p{margin:6px 0 0;color:var(--muted)}\\n    .cards{display:flex;gap:18px;margin-top:22px}\\n    .card{flex:1;background:var(--card);padding:20px;border-radius:12px;box-shadow:var(--shadow);border:1px solid rgba(11,14,16,0.04)}\\n    .card h3{margin:0 0 8px}\\n    .price{font-size:20px;color:var(--accent);font-weight:700}\\n    ul.features{list-style:none;padding:0;margin:12px 0 18px;color:var(--muted)}\\n    ul.features li{margin:8px 0}\\n    .cta{display:inline-block;background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:600}\\n    .footnote{font-size:13px;color:var(--muted);margin-top:8px}\\n    .compare{margin-top:24px;background:linear-gradient(180deg,white, #fbfbfd);border-radius:12px;padding:14px;border:1px solid rgba(11,14,16,0.04)}\\n    table{width:100%;border-collapse:collapse}\\n    th,td{padding:10px;text-align:left;border-bottom:1px dashed rgba(11,14,16,0.04)}\\n    th{color:var(--muted);font-weight:600}\\n    .inline-help{font-size:13px;color:var(--muted)}\\n    footer{max-width:1100px;margin:28px auto;padding:20px 24px;color:var(--muted)}\\n    /* subtle patterned background using embedded SVG */\\n    body::before{content:\\\"\\\";position:fixed;inset:0;background-image:url('data:image/svg+xml;utf8,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"200\\\" height=\\\"200\\\"><defs><linearGradient id=\\\"g\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"%232b8a7a\\\" stop-opacity=\\\"0.05\\\"/><stop offset=\\\"1\\\" stop-color=\\\"%238bd3c5\\\" stop-opacity=\\\"0.02\\\"/></linearGradient></defs><rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"transparent\\\"/><g fill=\\\"url(%23g)\\\"><circle cx=\\\"30\\\" cy=\\\"30\\\" r=\\\"2\\\"/><circle cx=\\\"70\\\" cy=\\\"90\\\" r=\\\"2\\\"/><circle cx=\\\"140\\\" cy=\\\"50\\\" r=\\\"2\\\"/></g></svg>');opacity:1;pointer-events:none;mix-blend-mode:overlay}\\n    @media(max-width:880px){.cards{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">W</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <div>\\n      <nav class=\\\"nav-main\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"programs.html\\\">Offerings</a>\\n        <a href=\\\"services.html\\\">Sessions</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"testimonials.html\\\">Stories</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a class=\\\"nav-right\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1>Memberships designed around steady progress</h1>\\n        <p>Flexible tiers for habit-led change, with checkpoints and a curated plan each month. No jargon — just practical routines that fit your life.</p>\\n      </div>\\n      <div style=\\\"width:320px;text-align:right\\\">\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Start with a reflection call</div>\\n        <a href=\\\"book.html\\\" class=\\\"cta\\\" style=\\\"margin-top:8px;display:inline-block\\\">Schedule your starter session</a>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"cards\\\" aria-label=\\\"pricing tiers\\\">\\n      <div class=\\\"card\\\">\\n        <h3>Starter Membership</h3>\\n        <div class=\\\"price\\\">$29 / month</div>\\n        <ul class=\\\"features\\\">\\n          <li>Monthly 30-minute alignment session</li>\\n          <li>One focused habit cycle (7-day challenge)</li>\\n          <li>Email check-ins and a simple dashboard</li>\\n        </ul>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Join Starter</a>\\n        <div class=\\\"footnote\\\">Best for testing new rhythms and building one lasting habit.</div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <h3>Steady Arc</h3>\\n        <div class=\\\"price\\\">$79 / month</div>\\n        <ul class=\\\"features\\\">\\n          <li>Bi-weekly coaching sessions</li>\\n          <li>Personal session planner and habit toolkit</li>\\n          <li>Priority scheduling + printable weekly checklists</li>\\n        </ul>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Enroll in Steady Arc</a>\\n        <div class=\\\"footnote\\\">A practical package for people building a repeatable system.</div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <h3>Guided Membership</h3>\\n        <div class=\\\"price\\\">$149 / month</div>\\n        <ul class=\\\"features\\\">\\n          <li>Weekly sessions and bespoke plans</li>\\n          <li>Priority support, habit labs, and progress reviews</li>\\n          <li>Quarterly intensive & planning session</li>\\n        </ul>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Apply for Guided</a>\\n        <div class=\\\"footnote\\\">For people ready to reframe multiple routines and anchor them into daily life.</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"compare\\\" aria-label=\\\"compare features\\\">\\n      <h4 style=\\\"margin-top:0\\\">What you get</h4>\\n      <table>\\n        <thead>\\n          <tr><th>Feature</th><th>Starter</th><th>Steady Arc</th><th>Guided</th></tr>\\n        </thead>\\n        <tbody>\\n          <tr><td>Weekly plan</td><td>—</td><td>Yes</td><td>Yes</td></tr>\\n          <tr><td>7-day challenge generator</td><td>Yes</td><td>Yes</td><td>Yes</td></tr>\\n          <tr><td>Session Planner tool</td><td>—</td><td>Yes</td><td>Priority</td></tr>\\n          <tr><td>Printable checklist</td><td>Yes</td><td>Yes</td><td>Yes</td></tr>\\n          <tr><td>Email follow-ups</td><td>Standard</td><td>Priority</td><td>Rapid</td></tr>\\n        </tbody>\\n      </table>\\n      <div style=\\\"margin-top:12px\\\" class=\\\"inline-help\\\">All memberships include practical habit templates and outcome-focused frameworks (no medical advice).</div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px;padding:18px;background:linear-gradient(180deg, rgba(43,138,122,0.03), transparent);border-radius:12px;\\\"> \\n      <h4 style=\\\"margin:0 0 8px\\\">Not sure which fits?</h4>\\n      <p style=\\\"margin:0 0 12px;color:var(--muted)\\\">Try a 20-minute discovery call — we can create a short session plan and a 7-day action you can start immediately.</p>\\n      <a href=\\\"book.html\\\" class=\\\"cta\\\">Book a discovery</a>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>Questions? Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    <div style=\\\"margin-top:8px;color:var(--muted)\\\">Membership billing is month-to-month. Cancel anytime.</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Stories — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--muted:#6b7280;--accent:#196f60}\\n    body{font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial;margin:0;background:var(--bg);color:#0b1220}\\n    header{display:flex;justify-content:space-between;padding:18px 24px;border-bottom:1px solid rgba(11,14,16,0.04)}\\n    .logo{font-weight:700}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none}\\n    main{max-width:1000px;margin:28px auto;padding:0 20px}\\n    .intro{background:linear-gradient(90deg, rgba(25,111,96,0.04), transparent);padding:20px;border-radius:12px}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:18px}\\n    .quote{padding:18px;border-radius:12px;background:white;box-shadow:0 8px 20px rgba(12,17,23,0.06)}\\n    .quote p{margin:6px 0;color:var(--muted)}\\n    .meta{font-size:13px;color:#0b6c55;font-weight:600}\\n    .small-tools{margin-top:18px;display:flex;gap:12px;flex-wrap:wrap}\\n    .card{padding:12px;border-radius:10px;background:linear-gradient(180deg, #ffffff, #fbfffe);border:1px solid rgba(11,14,16,0.04)}\\n    .cta{background:var(--accent);color:white;padding:8px 12px;border-radius:8px;text-decoration:none}\\n    @media(max-width:800px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"programs.html\\\">Offerings</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"book.html\\\">Schedule</a>\\n    </nav>\\n  </header>\\n  <main>\\n    <section class=\\\"intro\\\">\\n      <h1 style=\\\"margin:0\\\">Client notes & progress</h1>\\n      <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Short reflections from people who've moved a few priorities into daily life. Outcomes-oriented, habit-focused, and steady.</p>\\n    </section>\\n\\n    <section class=\\\"grid\\\" aria-label=\\\"testimonials\\\">\\n      <div class=\\\"quote\\\">\\n        <div class=\\\"meta\\\">S.M. — project lead</div>\\n        <p>\\\"We set one habit at a time. Over three months I reclaimed my mornings and my energy. Practical, steady guidance that actually fit my calendar.\\\"</p>\\n      </div>\\n\\n      <div class=\\\"quote\\\">\\n        <div class=\\\"meta\\\">R.K. — designer</div>\\n        <p>\\\"The planner sessions helped me outline simple weekly priorities. The 7-day challenge made it easy to test things without pressure.\\\"</p>\\n      </div>\\n\\n      <div class=\\\"quote\\\">\\n        <div class=\\\"meta\\\">L.T. — entrepreneur</div>\\n        <p>\\\"Accountability that felt like coaching, not policing. My focus and sleep improved from shifts I could maintain.\\\"</p>\\n      </div>\\n\\n      <div class=\\\"quote\\\">\\n        <div class=\\\"meta\\\">H.D. — educator</div>\\n        <p>\\\"I appreciated the printable checklist and the clear session recaps. Small steps compounded quickly.\\\"</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px;\\\">\\n      <h3 style=\\\"margin-bottom:8px\\\">Tools highlighted by clients</h3>\\n      <div class=\\\"small-tools\\\">\\n        <div class=\\\"card\\\">\\n          <strong>7-day Habit Challenge</strong>\\n          <p style=\\\"margin:8px 0 0;color:var(--muted)\\\">A low-friction challenge to test a single habit for a week.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Session Planner</strong>\\n          <p style=\\\"margin:8px 0 0;color:var(--muted)\\\">A short guided worksheet used live to create a clear next-step plan.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Printable Checklist</strong>\\n          <p style=\\\"margin:8px 0 0;color:var(--muted)\\\">Daily boxes you can tick — simple reinforcement for new routines.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px;padding:18px;border-radius:10px;background:#f8fdfb;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <h4 style=\\\"margin:0\\\">Ready to try a short plan?</h4>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">Book a discovery session and we’ll produce a brief, printable plan you can use right away.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Book a discovery</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a Session — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f8fff9;--muted:#55636b;--accent:#1f7f6a;--card:#ffffff}\\n    body{font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial;margin:0;background:var(--bg);color:#062626}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 22px}\\n    .logo{font-weight:700}\\n    nav a{margin:0 10px;text-decoration:none;color:var(--muted)}\\n    main{max-width:980px;margin:28px auto;padding:0 20px}\\n    .grid{display:grid;grid-template-columns:2fr 1fr;gap:18px}\\n    .panel{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 10px 30px rgba(12,18,20,0.06)}\\n    h1{margin:0 0 8px}\\n    label{display:block;margin-top:12px;font-weight:600;color:#0b3b34}\\n    input[type=text],textarea,select{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid rgba(11,14,16,0.06)}\\n    button{background:var(--accent);color:white;padding:10px 12px;border-radius:8px;border:0;font-weight:700}\\n    .muted{color:var(--muted);font-size:14px}\\n    .tool-area{display:flex;flex-direction:column;gap:12px}\\n    .session-output, .challenge-output{white-space:pre-wrap;background:#f7fffb;padding:12px;border-radius:8px;border:1px dashed rgba(11,14,16,0.04)}\\n    .inline-row{display:flex;gap:8px}\\n    .checkbox-grid{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}\\n    .chip{padding:8px 10px;border-radius:999px;background:#f0fff8;border:1px solid rgba(11,14,16,0.04);cursor:pointer}\\n    .chip.active{background:var(--accent);color:white}\\n    .printable{margin-top:8px}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Sessions</a>\\n      <a href=\\\"programs.html\\\">Offerings</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"testimonials.html\\\">Stories</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"grid\\\">\\n      <section class=\\\"panel\\\">\\n        <h1>Book a discovery & co-create a plan</h1>\\n        <p class=\\\"muted\\\">Start with a short call. Use the Session Planner below during the meeting to capture a clear, exportable plan.</p>\\n\\n        <form id=\\\"bookingForm\\\" onsubmit=\\\"return false\\\" style=\\\"margin-top:12px\\\">\\n          <label>Name</label>\\n          <input type=\\\"text\\\" id=\\\"name\\\" placeholder=\\\"Your name\\\">\\n\\n          <label>Email</label>\\n          <input type=\\\"text\\\" id=\\\"email\\\" placeholder=\\\"you@example.com\\\">\\n\\n          <label>Preferred time / notes</label>\\n          <textarea id=\\\"notes\\\" rows=\\\"3\\\" placeholder=\\\"Best times, a short context, or priorities\\\"></textarea>\\n\\n          <div style=\\\"margin-top:12px;display:flex;gap:8px\\\">\\n            <button id=\\\"bookBtn\\\">Request a slot</button>\\n            <a href=\\\"tel:{{PHONE}}\\\" style=\\\"align-self:center;color:var(--muted);text-decoration:none\\\">Or call <strong>{{PHONE}}</strong></a>\\n          </div>\\n        </form>\\n\\n        <hr style=\\\"margin:18px 0;border:none;border-top:1px solid rgba(11,14,16,0.04)\\\">\\n\\n        <h3 style=\\\"margin:0 0 8px\\\">Session Planner (live)</h3>\\n        <div class=\\\"tool-area\\\">\\n          <label>Primary outcome for the next 30 days</label>\\n          <input type=\\\"text\\\" id=\\\"outcome\\\" placeholder=\\\"e.g., steady morning routine, clearer evening wind-down\\\">\\n\\n          <label>Focus areas (pick up to 3)</label>\\n          <div class=\\\"checkbox-grid\\\" id=\\\"focusGrid\\\">\\n            <div class=\\\"chip\\\" data-val=\\\"Movement\\\">Movement</div>\\n            <div class=\\\"chip\\\" data-val=\\\"Sleep\\\">Sleep</div>\\n            <div class=\\\"chip\\\" data-val=\\\"Nutrition\\\">Nutrition</div>\\n            <div class=\\\"chip\\\" data-val=\\\"Mindfulness\\\">Mindfulness</div>\\n            <div class=\\\"chip\\\" data-val=\\\"Boundaries\\\">Boundaries</div>\\n            <div class=\\\"chip\\\" data-val=\\\"Energy\\\">Energy management</div>\\n          </div>\\n\\n          <label>Weekly commitment</label>\\n          <div class=\\\"inline-row\\\">\\n            <select id=\\\"daysPerWeek\\\" style=\\\"width:140px\\\">\\n              <option value=\\\"1\\\">1 day / week</option>\\n              <option value=\\\"2\\\">2 days / week</option>\\n              <option value=\\\"3\\\" selected>3 days / week</option>\\n              <option value=\\\"4\\\">4 days / week</option>\\n              <option value=\\\"5\\\">5 days / week</option>\\n            </select>\\n            <select id=\\\"sessionLength\\\" style=\\\"width:140px\\\">\\n              <option value=\\\"15\\\">15 minutes</option>\\n              <option value=\\\"30\\\" selected>30 minutes</option>\\n              <option value=\\\"45\\\">45 minutes</option>\\n              <option value=\\\"60\\\">60 minutes</option>\\n            </select>\\n          </div>\\n\\n          <label>Concrete next steps (3 max)</label>\\n          <textarea id=\\\"steps\\\" rows=\\\"3\\\" placeholder=\\\"List short, specific actions separated by line breaks\\\"></textarea>\\n\\n          <div style=\\\"display:flex;gap:8px\\\">\\n            <button id=\\\"buildPlan\\\">Build plan</button>\\n            <button id=\\\"copyPlan\\\" style=\\\"background:#333\\\">Copy plan</button>\\n            <button id=\\\"saveDraft\\\" style=\\\"background:#e6f6ef;color:#064\\\">Save locally</button>\\n          </div>\\n\\n          <div style=\\\"margin-top:8px\\\">\\n            <div class=\\\"session-output\\\" id=\\\"planOutput\\\">Your session plan will appear here after you click \\\"Build plan\\\".</div>\\n          </div>\\n        </div>\\n\\n      </section>\\n\\n      <aside class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0\\\">7-day Habit Challenge builder</h3>\\n        <p class=\\\"muted\\\">Create a concise weekly habit and print a checklist you can use immediately.</p>\\n\\n        <label>Habit to test</label>\\n        <input type=\\\"text\\\" id=\\\"habitName\\\" placeholder=\\\"e.g., 10 minutes movement before breakfast\\\">\\n\\n        <label>Intensity</label>\\n        <select id=\\\"habitIntensity\\\">\\n          <option value=\\\"easy\\\">Easy (daily, low time commitment)</option>\\n          <option value=\\\"moderate\\\" selected>Moderate (more consistent attention)</option>\\n          <option value=\\\"stretch\\\">Stretch (challenge yourself)</option>\\n        </select>\\n\\n        <label>Start day</label>\\n        <select id=\\\"startDay\\\">\\n          <option>Monday</option>\\n          <option>Tuesday</option>\\n          <option>Wednesday</option>\\n          <option>Thursday</option>\\n          <option>Friday</option>\\n          <option>Saturday</option>\\n          <option>Sunday</option>\\n        </select>\\n\\n        <div style=\\\"margin-top:10px;display:flex;gap:8px\\\">\\n          <button id=\\\"generateChallenge\\\">Generate checklist</button>\\n          <button id=\\\"printChallenge\\\" style=\\\"background:#fff;color:var(--accent);border:1px solid var(--accent)\\\">Print</button>\\n        </div>\\n\\n        <div class=\\\"printable\\\" id=\\\"challengeBox\\\" style=\\\"margin-top:12px\\\">\\n          <div style=\\\"font-weight:700;margin-bottom:6px\\\" id=\\\"challengeTitle\\\">No challenge generated yet</div>\\n          <div id=\\\"checklistArea\\\" style=\\\"color:var(--muted)\\\">The checklist will appear here once you generate it.</div>\\n        </div>\\n\\n        <hr style=\\\"margin:16px 0;border:none;border-top:1px solid rgba(11,14,16,0.04)\\\">\\n\\n        <h4 style=\\\"margin:0 0 6px\\\">Quick booking</h4>\\n        <p class=\\\"muted\\\" style=\\\"margin:0 0 6px\\\">If you'd like to reserve a time now, share a preferred slot and we'll confirm.</p>\\n        <label>Preferred time</label>\\n        <input type=\\\"text\\\" id=\\\"preferredSlot\\\" placeholder=\\\"e.g., Tuesday AM\\\">\\n        <div style=\\\"margin-top:10px\\\">\\n          <button id=\\\"quickRequest\\\">Send request</button>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;color:var(--muted);font-size:13px\\\">Or contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"max-width:980px;margin:20px auto;padding:18px;background:#fff;border-radius:12px;box-shadow:0 10px 30px rgba(12,18,20,0.04)\\\">\\n      <h3 style=\\\"margin-top:0\\\">Session record export</h3>\\n      <p class=\\\"muted\\\">Every session plan you build can be exported as plain text for notes, your calendar, or journaling.</p>\\n      <div style=\\\"margin-top:10px\\\">\\n        <button id=\\\"exportAll\\\" style=\\\"background:#0b6f55\\\">Export last plan as text</button>\\n        <button id=\\\"downloadTxt\\\" style=\\\"background:#fff;color:var(--accent);border:1px solid var(--accent)\\\">Download .txt</button>\\n      </div>\\n      <div id=\\\"exportArea\\\" style=\\\"margin-top:12px;color:var(--muted)\\\">No exported content yet.</div>\\n    </section>\\n  </main>\\n\\n  <script>\\n    // Simple DOM helpers\\n    const qs = s=>document.querySelector(s);\\n    const qsa = s=>document.querySelectorAll(s);\\n\\n    // Focus chips logic (max 3)\\n    const chips = qsa('.chip');\\n    chips.forEach(c=>c.addEventListener('click',()=>{\\n      const act = c.classList.toggle('active');\\n      const active = [...qsa('.chip.active')];\\n      if(active.length>3){ c.classList.remove('active'); }\\n    }));\\n\\n    // Build Session Plan\\n    const buildBtn = qs('#buildPlan');\\n    const planOutput = qs('#planOutput');\\n    const copyPlan = qs('#copyPlan');\\n    const saveDraft = qs('#saveDraft');\\n\\n    function gatherPlan(){\\n      const name = qs('#name').value || 'Client';\\n      const outcome = qs('#outcome').value || 'Clarify a short-term aim';\\n      const focus = [...qsa('.chip.active')].map(n=>n.dataset.val);\\n      const days = qs('#daysPerWeek').value;\\n      const length = qs('#sessionLength').value;\\n      const steps = (qs('#steps').value||'').split('\\\\n').map(s=>s.trim()).filter(s=>s);\\n\\n      const planLines = [];\\n      planLines.push(`Plan for: ${name}`);\\n      planLines.push(`Primary aim (30 days): ${outcome}`);\\n      if(focus.length) planLines.push(`Focus areas: ${focus.join(', ')}`);\\n      planLines.push(`Weekly commitment: ${days} days @ ${length} minutes`);\\n      planLines.push('Next steps:');\\n      if(steps.length){ steps.forEach((st,i)=>planLines.push(`${i+1}. ${st}`)); }\\n      else { planLines.push('- Draft 3 tiny actions during session'); }\\n      planLines.push('Accountability: short check-in next week');\\n      planLines.push(`Built: ${new Date().toLocaleString()}`);\\n      return planLines.join('\\\\n');\\n    }\\n\\n    buildBtn.addEventListener('click',()=>{\\n      const text = gatherPlan();\\n      planOutput.textContent = text;\\n      qs('#exportArea').textContent = 'Last plan ready to export.';\\n    });\\n\\n    // Copy plan text\\n    copyPlan.addEventListener('click',async()=>{\\n      try{\\n        const text = planOutput.textContent || gatherPlan();\\n        await navigator.clipboard.writeText(text);\\n        copyPlan.textContent = 'Copied ✓';\\n        setTimeout(()=>copyPlan.textContent='Copy plan',1200);\\n      }catch(e){\\n        alert('Unable to copy directly — select the text and copy.');\\n      }\\n    });\\n\\n    // Save draft locally (localStorage)\\n    saveDraft.addEventListener('click',()=>{\\n      const text = planOutput.textContent || gatherPlan();\\n      localStorage.setItem('lastPlan',text);\\n      saveDraft.textContent='Saved';\\n      setTimeout(()=>saveDraft.textContent='Save locally',1200);\\n    });\\n\\n    // Export / download simple txt\\n    qs('#exportAll').addEventListener('click',()=>{\\n      const text = planOutput.textContent || localStorage.getItem('lastPlan') || 'No plan available.';\\n      qs('#exportArea').textContent = text;\\n    });\\n    qs('#downloadTxt').addEventListener('click',()=>{\\n      const text = planOutput.textContent || localStorage.getItem('lastPlan') || 'No plan available.';\\n      const blob = new Blob([text],{type:'text/plain'});\\n      const url = URL.createObjectURL(blob);\\n      const a = document.createElement('a');\\n      a.href=url;a.download='session-plan.txt';document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);\\n    });\\n\\n    // Quick request (simulated)\\n    qs('#quickRequest').addEventListener('click',()=>{\\n      const slot = qs('#preferredSlot').value || 'No preference';\\n      alert('Request sent: ' + slot + '\\\\nWe will confirm via email.');\\n    });\\n\\n    // Habit challenge generator\\n    const genBtn = qs('#generateChallenge');\\n    const printBtn = qs('#printChallenge');\\n    const challengeBox = qs('#challengeBox');\\n    const challengeTitle = qs('#challengeTitle');\\n    const checklistArea = qs('#checklistArea');\\n\\n    function weekdaySequence(start){\\n      const days=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];\\n      const idx = days.indexOf(start); if(idx<0) return days;\\n      return days.slice(idx).concat(days.slice(0,idx));\\n    }\\n\\n    genBtn.addEventListener('click',()=>{\\n      const name = qs('#habitName').value || 'New habit';\\n      const intensity = qs('#habitIntensity').value;\\n      const start = qs('#startDay').value;\\n      const seq = weekdaySequence(start);\\n      const instructions = intensity==='easy'? 'Aim for consistency. Keep it short and friction-free.' : intensity==='moderate'? 'Keep the habit daily and notice cues. Adjust as needed.' : 'Push an extra step on days 4–6 to test capacity.';\\n\\n      challengeTitle.textContent = `${name} — 7-day checklist`;\\n      const items = seq.slice(0,7).map((d,i)=>`${d}: [ ] ${name}`);\\n      const html = `<div style=\\\\\\\"font-size:14px;color:#0b6f55;margin-bottom:8px\\\\\\\">${instructions}</div><ol>` + items.map(it=>`<li style=\\\\\\\"margin:6px 0;\\\\\\\">${it}</li>`).join('') + '</ol>';\\n      checklistArea.innerHTML = html;\\n      // Save the raw text for print\\n      checklistArea.dataset.text = `${name}\\\\n${instructions}\\\\n\\\\n` + items.join('\\\\n');\\n    });\\n\\n    printBtn.addEventListener('click',()=>{\\n      const text = checklistArea.dataset.text || 'No challenge generated yet.';\\n      const win = window.open('','PRINT','height=600,width=500');\\n      win.document.write('<pre style=\\\"font-family:Inter,system-ui;white-space:pre-wrap\\\">'+text+'</pre>');\\n      win.document.close();\\n      win.focus();\\n      win.print();\\n      win.close();\\n    });\\n\\n    // Booking form simulated action\\n    qs('#bookBtn').addEventListener('click',()=>{\\n      const n = qs('#name').value || 'Guest';\\n      const e = qs('#email').value || '{{EMAIL}}';\\n      alert('Thank you, '+n+'. We received your request and will reach out at '+e+'.');\\n    });\\n\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
