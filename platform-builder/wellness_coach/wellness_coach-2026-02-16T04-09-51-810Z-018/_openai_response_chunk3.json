          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Investment & Plans — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fcfcfb;--muted:#6b6b6b;--accent:#0b6b5a;--card:#ffffff;--glass:rgba(11,107,90,0.06);font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;}\\n    *{box-sizing:border-box}\\n    body{margin:0;background:var(--bg);color:#111;line-height:1.45}\\n    .wrap{max-width:980px;margin:48px auto;padding:32px}\\n    nav{display:flex;justify-content:space-between;align-items:center;padding-bottom:24px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:14px}\\n    .brand{font-weight:700;color:#0b6b5a}\\n    header.hero{display:grid;grid-template-columns:1fr 340px;gap:32px;align-items:center;margin-bottom:28px}\\n    .hero-copy h1{margin:0 0 12px 0;font-size:28px}\\n    .hero-copy p{margin:0;color:var(--muted)}\\n    .hero-art{padding:28px;background:var(--card);border-radius:12px;box-shadow:0 6px 20px rgba(20,20,20,0.04)}\\n    .plans{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:26px}\\n    .plan{background:var(--card);padding:22px;border-radius:12px;border:1px solid #eef2ef}\\n    .plan.primary{box-shadow:0 10px 30px rgba(11,107,90,0.06);transform:translateY(-4px);border-color:transparent}\\n    .plan h3{margin:0 0 8px 0;font-size:18px}\\n    .price{font-size:22px;color:var(--accent);margin:10px 0}\\n    .features{margin:12px 0;color:var(--muted);font-size:14px}\\n    .btn{display:inline-block;padding:10px 14px;background:var(--accent);color:#fff;border-radius:8px;text-decoration:none}\\n    .ghost{background:transparent;border:1px solid #e6e6e6;color:var(--muted)}\\n    .faq{margin-top:30px;padding:22px;background:var(--glass);border-radius:10px}\\n    footer{margin-top:36px;color:var(--muted);font-size:14px}\\n    @media(max-width:880px){header.hero{grid-template-columns:1fr;}\\n      .plans{grid-template-columns:1fr}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <div class='wrap'>\\n    <nav>\\n      <div class='brand'>{{BUSINESS_NAME}}</div>\\n      <div>\\n        <a href='index.html'>Home</a>\\n        <a href='programs.html'>Programs</a>\\n        <a href='book.html'>Book a Call</a>\\n      </div>\\n    </nav>\\n\\n    <header class='hero'>\\n      <div class='hero-copy'>\\n        <h1>Transparent pricing for lasting habits</h1>\\n        <p>{{TAGLINE}} — coaching that favors simple routines, steady wins, and measurable momentum.</p>\\n        <p style='margin-top:14px;color:var(--muted)'>Each tier is organized around outcomes, not just hours. Choose the rhythm that fits your life.</p>\\n      </div>\\n\\n      <figure class='hero-art' aria-hidden='true'>\\n        <!-- unique SVG visually representing steady growth; local asset concept: assets/img/hero.svg -->\\n        <svg width='300' height='180' viewBox='0 0 300 180' fill='none' xmlns='http://www.w3.org/2000/svg'>\\n          <rect rx='12' width='300' height='180' fill='#f7fbf9'/>\\n          <g transform='translate(24,20)'>\\n            <path d='M0 112 L36 88 L72 70 L108 48 L144 68 L180 40 L216 56' stroke='#0b6b5a' stroke-width='6' stroke-linecap='round' stroke-linejoin='round' fill='none' opacity='0.98'/>\\n            <circle cx='216' cy='56' r='8' fill='#0b6b5a'/>\\n            <g transform='translate(0,120)'>\\n              <rect x='0' y='0' width='240' height='6' rx='3' fill='#e6f3ef'/>\\n            </g>\\n          </g>\\n        </svg>\\n      </figure>\\n\\n    </header>\\n\\n    <section class='plans' aria-label='Plans'>\\n      <div class='plan'>\\n        <h3>Starter Habit</h3>\\n        <div class='price'>$149 / month</div>\\n        <div class='features'>Ideal for building two sustainable habits. Weekly check-in, habit tracker, micro-goals.</div>\\n        <p style='margin-top:12px'><a class='btn' href='book.html'>Start with a Discovery</a></p>\\n      </div>\\n\\n      <div class='plan primary'>\\n        <h3>Momentum Path</h3>\\n        <div class='price'>$349 / month</div>\\n        <div class='features'>A focused 3-month path: habit stacking, accountability, and a personalized framework that fits your routine.</div>\\n        <p style='margin-top:12px'><a class='btn' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a></p>\\n      </div>\\n\\n      <div class='plan'>\\n        <h3>Transform Ritual</h3>\\n        <div class='price'>Custom + 1:1</div>\\n        <div class='features'>For clients ready for a full lifestyle redesign — includes deep-dive sessions, weekly coaching, and email support.</div>\\n        <p style='margin-top:12px'><a class='btn ghost' href='contact.html'>Request Pricing</a></p>\\n      </div>\\n    </section>\\n\\n    <section class='faq' aria-label='FAQ'>\\n      <h4 style='margin:0 0 12px 0'>Questions people ask</h4>\\n      <dl>\\n        <dt style='font-weight:600'>How long until I notice change?</dt>\\n        <dd style='margin:6px 0 12px 0;color:var(--muted)'>Most clients see behavior shifts within 3–6 weeks; deeper routines form over months. Your plan is paced to keep progress sustainable.</dd>\\n        <dt style='font-weight:600'>Do I have to commit to a year?</dt>\\n        <dd style='margin:6px 0 12px 0;color:var(--muted)'>No. Monthly options are available; the Momentum Path is recommended for 3 months to build repeatable systems.</dd>\\n        <dt style='font-weight:600'>Is this medical advice?</dt>\\n        <dd style='margin:6px 0 12px 0;color:var(--muted)'>No. Coaching focuses on habits, mindset, and practical tools. We do not diagnose or prescribe medical treatment.</dd>\\n      </dl>\\n    </section>\\n\\n    <footer>\\n      <div style='display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap'>\\n        <div>\\n          <strong>{{BUSINESS_NAME}}</strong> — {{TAGLINE}}<br>\\n          {{COACH_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}}\\n        </div>\\n        <div style='text-align:right'>\\n          <div>Call: <a href='tel:{{PHONE}}' style='color:var(--muted);text-decoration:none'>{{PHONE}}</a></div>\\n          <div>Email: <a href='mailto:{{EMAIL}}' style='color:var(--muted);text-decoration:none'>{{EMAIL}}</a></div>\\n        </div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Client Stories — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#ffffff;--muted:#666;--accent:#0b6b5a}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto;background:var(--bg);color:#111}\\n    .container{max-width:900px;margin:48px auto;padding:24px}\\n    header{display:flex;justify-content:space-between;align-items:center;padding-bottom:18px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:14px}\\n    h1{margin:0 0 6px 0;font-size:26px}\\n    .lead{color:var(--muted);margin-bottom:22px}\\n    .grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}\\n    .card{padding:18px;border-radius:12px;background:#fcfcfb;border:1px solid #f1f3f2}\\n    .quote{font-size:15px;color:#222;margin:8px 0}\\n    .meta{font-size:13px;color:var(--muted)}\\n    .cta{display:block;margin-top:20px;text-decoration:none;background:var(--accent);color:#fff;padding:10px 12px;border-radius:8px;width:max-content}\\n    .avatar{width:56px;height:56px;border-radius:10px;display:inline-block;vertical-align:middle;margin-right:10px}\\n    footer{margin-top:26px;color:var(--muted);font-size:13px}\\n    @media(max-width:760px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class='container'>\\n    <header>\\n      <div>\\n        <div style='font-weight:700;color:var(--accent)'>{{BUSINESS_NAME}}</div>\\n        <nav>\\n          <a href='index.html'>Home</a>\\n          <a href='about.html'>About</a>\\n          <a href='programs.html'>Paths</a>\\n        </nav>\\n      </div>\\n      <div>\\n        <a class='cta' href='book.html'>Schedule a Conversation</a>\\n      </div>\\n    </header>\\n\\n    <main>\\n      <h1>Client wins & voices</h1>\\n      <p class='lead'>Real changes come from tiny, repeatable habits. Below are short snapshots from people who've built momentum and kept it.</p>\\n\\n      <section class='grid' aria-label='Testimonials'>\\n        <article class='card'>\\n          <div>\\n            <!-- unique small avatar svg: assets/img/avatar.svg reference -->\\n            <svg class='avatar' viewBox='0 0 64 64' xmlns='http://www.w3.org/2000/svg' role='img' aria-hidden='true'>\\n              <rect width='64' height='64' rx='10' fill='#f2fbf8'/>\\n              <circle cx='32' cy='24' r='10' fill='#0b6b5a'/>\\n              <rect x='14' y='40' width='36' height='10' rx='4' fill='#dff3ec'/>\\n            </svg>\\n            <strong>R. — Project Manager</strong>\\n            <div class='meta'>Loss of overwhelm • built 3 daily anchors</div>\\n          </div>\\n          <p class='quote'>\\\"I started with one 5-minute ritual and it scaled into consistent evenings that actually energize me. {{COACH_NAME}} helped me keep it tiny and honest.\\\"</p>\\n        </article>\\n\\n        <article class='card'>\\n          <div>\\n            <svg class='avatar' viewBox='0 0 64 64' xmlns='http://www.w3.org/2000/svg' role='img' aria-hidden='true'>\\n              <rect width='64' height='64' rx='10' fill='#fffaf6'/>\\n              <circle cx='32' cy='22' r='10' fill='#ff8a65'/>\\n              <rect x='12' y='38' width='40' height='12' rx='6' fill='#fff2ea'/>\\n            </svg>\\n            <strong>K. — Designer</strong>\\n            <div class='meta'>Consistency • creative restoration</div>\\n          </div>\\n          <p class='quote'>\\\"I used to start strong and fizzle. The frameworks made it obvious what to keep and what to drop. Small rituals, big clarity.\\\"</p>\\n        </article>\\n\\n        <article class='card'>\\n          <div>\\n            <svg class='avatar' viewBox='0 0 64 64' xmlns='http://www.w3.org/2000/svg' role='img' aria-hidden='true'>\\n              <rect width='64' height='64' rx='10' fill='#f7f8ff'/>\\n              <circle cx='32' cy='24' r='10' fill='#6b7aff'/>\\n              <rect x='14' y='40' width='36' height='10' rx='4' fill='#eef2ff'/>\\n            </svg>\\n            <strong>M. — Educator</strong>\\n            <div class='meta'>Energy management • sustainable schedule</div>\\n          </div>\\n          <p class='quote'>\\\"We redesigned my calendar in a way that honors my energy. The result: fewer late nights and clearer boundaries.\\\"</p>\\n        </article>\\n\\n        <article class='card'>\\n          <div>\\n            <svg class='avatar' viewBox='0 0 64 64' xmlns='http://www.w3.org/2000/svg' role='img' aria-hidden='true'>\\n              <rect width='64' height='64' rx='10' fill='#f4f7f9'/>\\n              <circle cx='32' cy='22' r='10' fill='#00a896'/>\\n              <rect x='12' y='38' width='40' height='12' rx='6' fill='#e8fbf6'/>\\n            </svg>\\n            <strong>S. — Entrepreneur</strong>\\n            <div class='meta'>Focus • fewer distractions</div>\\n          </div>\\n          <p class='quote'>\\\"I reclaimed two hours a day by simplifying decisions. I feel more in control — that's the real win.\\\"</p>\\n        </article>\\n      </section>\\n\\n      <section style='margin-top:22px;padding:18px;border-radius:10px;background:#fbfffb;border:1px solid #eef6ef'>\\n        <h3 style='margin:0 0 8px 0'>Want to hear more?</h3>\\n        <p style='margin:0;color:var(--muted)'>Download a short collection of case studies and a 1-page habit checklist to try this week. Email <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a> or <a href='book.html'>book a quick intro</a>.</p>\\n      </section>\\n\\n    </main>\\n\\n    <footer style='margin-top:26px;color:var(--muted)'>\\n      <div>{{COACH_NAME}}, {{CREDENTIALS}} • {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n      <div>Phone: <a href='tel:{{PHONE}}' style='color:var(--muted);text-decoration:none'>{{PHONE}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Book a Conversation — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfdfb;--muted:#666;--accent:#0b6b5a}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto;background:var(--bg);color:#111}\\n    .frame{max-width:760px;margin:48px auto;padding:32px}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    h1{margin:0 0 8px 0;font-size:24px}\\n    p.lead{color:var(--muted);margin:0 0 22px 0}\\n    .two-col{display:grid;grid-template-columns:1fr 320px;gap:20px}\\n    .card{background:#fff;padding:20px;border-radius:12px;border:1px solid #eef3ef}\\n    label{display:block;font-size:13px;margin-bottom:6px}\\n    input,textarea,select{width:100%;padding:10px;border-radius:8px;border:1px solid #e8eee8;font-size:14px}\\n    button{background:var(--accent);color:#fff;padding:10px 14px;border-radius:8px;border:none;margin-top:12px}\\n    .note{font-size:13px;color:var(--muted);margin-top:12px}\\n    .small-visual{display:block;margin-bottom:12px}\\n    @media(max-width:840px){.two-col{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class='frame'>\\n    <header>\\n      <div>\\n        <div style='font-weight:700;color:var(--accent)'>{{BUSINESS_NAME}}</div>\\n        <nav>\\n          <a href='index.html'>Main</a>\\n          <a href='testimonials.html'>Wins</a>\\n          <a href='pricing.html'>Rates</a>\\n        </nav>\\n      </div>\\n      <div style='text-align:right;color:var(--muted)'>Questions? <a href='mailto:{{EMAIL}}' style='color:var(--muted);text-decoration:none'>{{EMAIL}}</a></div>\\n    </header>\\n\\n    <main>\\n      <h1>Book a 20-minute clarity call</h1>\\n      <p class='lead'>No hard sell — a short conversation to explore fit, timeline, and simple next steps. Bring one challenge you'd like to solve.</p>\\n\\n      <div class='two-col'>\\n        <section class='card'>\\n          <div class='small-visual' aria-hidden='true'>\\n            <!-- abstract pattern svg (unique) concept: assets/img/pattern.svg -->\\n            <svg width='280' height='80' viewBox='0 0 280 80' xmlns='http://www.w3.org/2000/svg'>\\n              <rect width='280' height='80' rx='10' fill='#f5fff9'/>\\n              <g fill='none' stroke='#aeead6' stroke-width='3' stroke-linecap='round'>\\n                <path d='M12 60 C56 20 112 28 156 38 C200 48 244 18 268 12' opacity='0.9'/>\\n              </g>\\n            </svg>\\n          </div>\\n\\n          <form action='contact.html' method='post' onsubmit='event.preventDefault();alert(\\\"Thanks — we'll follow up at the email you entered.\\\")' aria-label='Booking form'>\\n            <label for='name'>Your name</label>\\n            <input id='name' name='name' placeholder='First and last' required>\\n\\n            <label for='email'>Email</label>\\n            <input id='email' name='email' type='email' placeholder='you@domain.com' required>\\n\\n            <label for='phone'>Phone</label>\\n            <input id='phone' name='phone' placeholder='Optional' >\\n\\n            <label for='focus'>What would you like to focus on?</label>\\n            <select id='focus' name='focus'>\\n              <option>Building a daily routine</option>\\n              <option>Managing energy & time</option>\\n              <option>Changing a stubborn behavior</option>\\n              <option>Other</option>\\n            </select>\\n\\n            <label for='msg'>Brief note (one sentence)</label>\\n            <textarea id='msg' name='message' rows='3' placeholder='A short sentence about your current challenge'></textarea>\\n\\n            <button type='submit'>Book the intro</button>\\n            <p class='note'>After you book, you'll receive a short pre-call form and a Zoom link. If you'd rather email, reach me at <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a>.</p>\\n          </form>\\n        </section>\\n\\n        <aside class='card'>\\n          <h3 style='margin-top:0'>What to expect</h3>\\n          <ul style='color:var(--muted);padding-left:18px;margin-top:10px'>\\n            <li>20 minutes: clarity and next steps</li>\\n            <li>Concrete tiny experiments you can try</li>\\n            <li>Clear recommendation of next tier if there's a fit</li>\\n          </ul>\\n\\n          <h4 style='margin-top:14px'>Investment snapshot</h4>\\n          <p style='margin:6px 0;color:var(--muted)'>Starter Habit — $149/mo • Momentum Path — $349/mo • Transform Ritual — custom</p>\\n\\n          <div style='margin-top:18px;'>\\n            <strong>{{COACH_NAME}}</strong><br>\\n            {{CREDENTIALS}} • Based in {{CITY}}, {{STATE}}<br>\\n            <div style='margin-top:8px'>Call: <a href='tel:{{PHONE}}'>{{PHONE}}</a></div>\\n          </div>\\n        </aside>\\n      </div>\\n\\n    </main>\\n\\n    <footer style='margin-top:22px;color:var(--muted)'>\\n      <div>Thank you for considering {{BUSINESS_NAME}}. If this is urgent, call <a href='tel:{{PHONE}}'>{{PHONE}}</a>.</div>\\n      <div style='margin-top:6px'>By booking you agree to a friendly, goal-focused conversation. We do not provide medical advice.</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
