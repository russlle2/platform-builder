          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#ff6b6b;--muted:#6b7280;--bg:#fff;--card:#f8fafc;--radius:14px}\\n    *{box-sizing:border-box}body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;color:#0f172a;margin:0;background:linear-gradient(180deg,#fff 0%,#fffaf8 100%)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:28px 36px}\\n    a.nav{margin:0 10px;color:#0f172a;text-decoration:none;font-weight:600}\\n    .brand{display:flex;align-items:center;gap:12px;font-weight:800}\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:32px;padding:36px;align-items:center}\\n    .kicker{display:inline-block;background:linear-gradient(90deg,var(--accent),#ff9a8b);color:#fff;padding:6px 10px;border-radius:999px;font-weight:700}\\n    h1{font-size:36px;margin:12px 0;color:#0b1220}\\n    p.lead{color:var(--muted);line-height:1.5}\\n    .card{background:var(--card);border-radius:var(--radius);padding:18px}\\n    .avatar{display:flex;align-items:center;gap:12px}\\n    .avatar img{width:64px;height:64px;border-radius:12px}\\n    .cta{display:inline-block;background:var(--accent);color:#fff;padding:12px 18px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .sections{padding:0 36px 80px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:20px}\\n    .benefit{background:#fff;border-radius:12px;padding:18px;box-shadow:0 6px 18px rgba(11,18,32,0.06)}\\n    .process{display:flex;gap:12px;margin-top:22px}\\n    .step{flex:1;background:#fff;padding:14px;border-radius:12px}\\n    .social-proof{display:flex;gap:12px;margin-top:24px}\\n    .testimonial{background:linear-gradient(180deg,#fff,#fffefc);padding:14px;border-radius:12px}\\n    footer{padding:28px 36px;border-top:1px solid #eef2f7;color:var(--muted)}\\n    .lead-magnet{display:flex;gap:12px;align-items:center;margin-top:20px}\\n    .magnet-input{padding:12px;border-radius:10px;border:1px solid #e6e9ef;width:300px}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;padding:20px}.grid{grid-template-columns:1fr}}\\n  </style>\\head>\\n<body>\\n<header>\\n  <div class=\\\"brand\\\"><img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" width=\\\"42\\\" height=\\\"42\\\"/><div>{{BUSINESS_NAME}}</div></div>\\n  <nav>\\n    <a class=\\\"nav\\\" href=\\\"index.html\\\">Home</a>\\n    <a class=\\\"nav\\\" href=\\\"programs.html\\\">Work With Me</a>\\n    <a class=\\\"nav\\\" href=\\\"services.html\\\">Services</a>\\n    <a class=\\\"nav\\\" href=\\\"testimonials.html\\\">Stories</a>\\n    <a class=\\\"nav\\\" href=\\\"contact.html\\\">Contact</a>\\n  </nav>\\n</header>\\n<main>\\n  <section class=\\\"hero\\\">\\n    <div>\\n      <span class=\\\"kicker\\\">Gentle guidance</span>\\n      <h1>Hi — I\\u2019m {{COACH_NAME}}. I help people build resilient daily habits that lift energy and reduce overwhelm.</h1>\\n      <p class=\\\"lead\\\">As a {{CREDENTIALS}} based in {{CITY}}, {{STATE}}, I blend proven habit frameworks with compassionate support. My work is about steady, realistic change\\u2014not quick fixes.</p>\\n      <div style=\\\"margin-top:16px\\\">\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <a style=\\\"margin-left:12px;color:var(--muted);text-decoration:none\\\" href=\\\"book.html\\\">Book a discovery call</a>\\n      </div>\\n      <div class=\\\"lead-magnet\\\">\\n        <div class=\\\"card\\\">\\n          <div style=\\\"font-weight:700\\\">Free guide: 7 Small Habits for Big Calm</div>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">Download a short, actionable PDF to start today.</div>\\n        </div>\\n        <form action=\\\"#\\\" onsubmit=\\\"alert('Thanks! Check your inbox.')\\\">\\n          <input class=\\\"magnet-input\\\" placeholder=\\\"Your email\\\" aria-label=\\\"email\\\" />\\n          <button class=\\\"cta\\\" style=\\\"margin-left:8px\\\">Get the guide</button>\\n        </form>\\n      </div>\\n    </div>\\n    <aside>\\n      <div class=\\\"card avatar\\\">\\n        <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\" />\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{COACH_NAME}}, {{CREDENTIALS}}</div>\\n          <div style=\\\"color:var(--muted)\\\">Wellness Coach • {{CITY}}, {{STATE}}</div>\\n        </div>\\n      </div>\\n      <img src=\\\"assets/img/hero.svg\\\" alt=\\\"illustration\\\" style=\\\"width:100%;margin-top:18px;border-radius:10px;\\\" />\\n    </aside>\\n  </section>\\n\\n  <section class=\\\"sections\\\">\\n    <h2 style=\\\"margin-top:18px\\\">How clients change</h2>\\n    <div class=\\\"grid\\\">\\n      <div class=\\\"benefit\\\">\\n        <strong>Anchored routines</strong>\\n        <p style=\\\"color:var(--muted)\\\">Create repeatable micro-habits that stack into calmer days.</p>\\n      </div>\\n      <div class=\\\"benefit\\\">\\n        <strong>Energy-first approach</strong>\\n        <p style=\\\"color:var(--muted)\\\">Practical shifts to improve sleep, movement, and focused work without burnout.</p>\\n      </div>\\n      <div class=\\\"benefit\\\">\\n        <strong>Compassionate accountability</strong>\\n        <p style=\\\"color:var(--muted)\\\">Kind, structured check-ins that keep momentum without shame.</p>\\n      </div>\\n    </div>\\n\\n    <h3 style=\\\"margin-top:28px\\\">My coaching path</h3>\\n    <div class=\\\"process\\\">\\n      <div class=\\\"step\\\">\\n        <strong>1. Clarity</strong>\\n        <p style=\\\"color:var(--muted)\\\">We map your values and energy patterns.</p>\\n      </div>\\n      <div class=\\\"step\\\">\\n        <strong>2. Design</strong>\\n        <p style=\\\"color:var(--muted)\\\">Create a small set of practical habits to try for two weeks.</p>\\n      </div>\\n      <div class=\\\"step\\\">\\n        <strong>3. Embed</strong>\\n        <p style=\\\"color:var(--muted)\\\">Support to make habits stick and adjust for life\\u2019s curveballs.</p>\\n      </div>\\n    </div>\\n\\n    <h3 style=\\\"margin-top:28px\\\">A few kind words</h3>\\n    <div class=\\\"social-proof\\\">\\n      <div class=\\\"testimonial\\\">\\n        <strong>\\\"I sleep deeper and have more consistent mornings.\\\"</strong>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">— S., working parent</div>\\n      </div>\\n      <div class=\\\"testimonial\\\">\\n        <strong>\\\"I finally sustained a gentle routine I enjoy.\\\"</strong>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">— R., entrepreneur</div>\\n      </div>\\n    </div>\\n\\n    <h3 style=\\\"margin-top:28px\\\">Questions people ask</h3>\\n    <div style=\\\"margin-top:12px\\\">\\n      <details>\\n        <summary style=\\\"font-weight:700\\\">How long are sessions?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Sessions are typically 50 minutes. VIP intensives are full-day experiences. We tailor based on goals.</div>\\n      </details>\\n      <details style=\\\"margin-top:8px\\\">\\n        <summary style=\\\"font-weight:700\\\">Do you offer a money-back guarantee?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Because change is a partnership, I offer a satisfaction conversation after the first month to adjust the plan.</div>\\n      </details>\\n    </div>\\n\\n    <div style=\\\"margin-top:32px\\\" class=\\\"card\\\">\\n      <strong>Ready for a gentle reset?</strong>\\n      <div style=\\\"display:flex;align-items:center;justify-content:space-between;margin-top:12px\\\">\\n        <div style=\\\"color:var(--muted)\\\">Start with a short discovery call and a custom habit plan.</div>\\n        <div>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n    </div>\\n  </section>\\n</main>\\n<footer>\\n  <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n    <div>© {{BUSINESS_NAME}} • <span style=\\\"color:var(--muted)\\\">{{CITY}}, {{STATE}}</span></div>\\n    <div style=\\\"color:var(--muted)\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </div>\\n</footer>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#2dd4bf;--muted:#5b6770;--bg:#fff;--card:#fcfffe;--radius:12px}\\n    body{font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#fff,#f7fffd);margin:0;color:#071023}\\n    header{display:flex;justify-content:space-between;padding:22px 34px;align-items:center}\\n    nav a{margin:0 10px;color:#071023;text-decoration:none;font-weight:600}\\n    .layout{max-width:1100px;margin:18px auto;padding:0 20px}\\n    .hero{display:flex;gap:20px;align-items:center;background:linear-gradient(90deg,rgba(45,212,191,0.08),transparent);padding:22px;border-radius:16px}\\n    .hero img{width:220px;border-radius:12px}\\n    h1{margin:4px 0;font-size:30px}\\n    .mini{display:inline-block;background:var(--accent);color:#003b34;padding:6px 10px;border-radius:999px;font-weight:700}\\n    .services-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}\\n    .service{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 8px 20px rgba(2,6,23,0.04)}\\n    .price{font-weight:800;color:#071023}\\n    .muted{color:var(--muted)}\\n    .lead-magnet{margin-top:18px;display:flex;gap:12px;align-items:center}\\n    .cta{background:#0f172a;color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .process{display:flex;flex-direction:column;gap:10px;margin-top:12px}\\n    footer{padding:28px 34px;color:var(--muted)}\\n    @media(max-width:820px){.services-grid{grid-template-columns:1fr}.hero{flex-direction:column;align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n<header>\\n  <div style=\\\"font-weight:900;display:flex;gap:12px;align-items:center\\\"><img src=\\\"assets/img/pattern.svg\\\" width=\\\"36\\\" height=\\\"36\\\" alt=\\\"logo\\\"/>{{BUSINESS_NAME}}</div>\\n  <nav>\\n    <a href=\\\"index.html\\\" class=\\\"nav\\\">Home</a>\\n    <a href=\\\"programs.html\\\" class=\\\"nav\\\">Programs</a>\\n    <a href=\\\"about.html\\\" class=\\\"nav\\\">Meet the Coach</a>\\n    <a href=\\\"book.html\\\" class=\\\"nav\\\">Book</a>\\n  </nav>\\n</header>\\n<main class=\\\"layout\\\">\\n  <section class=\\\"hero\\\">\\n    <div>\\n      <span class=\\\"mini\\\">Services</span>\\n      <h1>Tailored coaching that fits your life</h1>\\n      <p class=\\\"muted\\\">Small experiments. Real momentum. We focus on sustainable rhythms for energy, sleep, and stress resilience.</p>\\n      <div style=\\\"margin-top:12px\\\">\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start with a consult</a>\\n      </div>\\n    </div>\\n    <img src=\\\"assets/img/hero.svg\\\" alt=\\\"illustration\\\" />\\n  </section>\\n\\n  <section style=\\\"margin-top:18px\\\">\\n    <h2 style=\\\"margin-bottom:10px\\\">Offerings</h2>\\n    <div class=\\\"services-grid\\\">\\n      <div class=\\\"service\\\">\\n        <strong>Weekly Coaching</strong>\\n        <p class=\\\"muted\\\">A coaching container for steady progress: weekly 50-minute sessions, habit prescription, and check-ins.</p>\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:12px\\\">\\n          <div class=\\\"price\\\">Monthly plan</div>\\n          <div style=\\\"color:var(--muted)\\\">Billed monthly</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"service\\\">\\n        <strong>VIP Day — Focus Reset</strong>\\n        <p class=\\\"muted\\\">One intensive day (virtual or in-person) to redesign your routines and leave with an actionable 30-day plan.</p>\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:12px\\\">\\n          <div class=\\\"price\\\">Single investment</div>\\n          <div style=\\\"color:var(--muted)\\\">Includes follow-up session</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"service\\\">\\n        <strong>Mini Boost (4 weeks)</strong>\\n        <p class=\\\"muted\\\">Four focused sessions to anchor one or two new habits quickly.</p>\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:12px\\\">\\n          <div class=\\\"price\\\">4-week package</div>\\n          <div style=\\\"color:var(--muted)\\\">Short-term commitment</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"service\\\">\\n        <strong>Team Wellbeing Workshops</strong>\\n        <p class=\\\"muted\\\">Interactive sessions for small teams: practical habits, micro-routines, and simple rituals to boost focus.</p>\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:12px\\\">\\n          <div class=\\\"price\\\">Per workshop</div>\\n          <div style=\\\"color:var(--muted)\\\">Custom pricing</div>\\n        </div>\\n      </div>\\n    </div>\\n  </section>\\n\\n  <section style=\\\"margin-top:22px\\\" class=\\\"card\\\">\\n    <h3>How we work together</h3>\\n    <div class=\\\"process\\\">\\n      <div><strong>Discovery</strong> \\u2014 A warm first call to map what matters most and identify 1\\u20132 leverage habits.</div>\\n      <div><strong>Design</strong> \\u2014 We co-create a manageable, enjoyable plan you can actually keep.</div>\\n      <div><strong>Support</strong> \\u2014 Check-ins, adjustments, and accountability without pressure.</div>\\n    </div>\\n  </section>\\n\\n  <section style=\\\"margin-top:18px\\\">\\n    <h3>Quick proof</h3>\\n    <div style=\\\"display:flex;gap:12px;flex-wrap:wrap;margin-top:8px\\\">\\n      <div class=\\\"card\\\" style=\\\"flex:1;min-width:220px\\\">\\n        <strong>85% of clients</strong>\\n        <div class=\\\"muted\\\">report improved sleep patterns after 6 weeks of guided habit practice.</div>\\n      </div>\\n      <div class=\\\"card\\\" style=\\\"flex:1;min-width:220px\\\">\\n        <strong>VIP outcomes</strong>\\n        <div class=\\\"muted\\\">Clients leave with a clear plan and daily rituals that feel easy to keep.</div>\\n      </div>\\n    </div>\\n  </section>\\n\\n  <section style=\\\"margin-top:22px\\\">\\n    <h3>Frequently asked</h3>\\n    <details>\\n      <summary style=\\\"font-weight:700\\\">Will this feel rigid?</summary>\\n      <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">No. I design flexible routines that bend with your life. The goal is consistency, not perfection.</div>\\n    </details>\\n    <details style=\\\"margin-top:8px\\\">\\n      <summary style=\\\"font-weight:700\\\">Is coaching confidential?</summary>\\n      <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Yes. Our conversations are private and focused on your wellbeing and goals.</div>\\n    </details>\\n  </section>\\n\\n  <section style=\\\"margin-top:22px;padding:16px;background:linear-gradient(90deg,#f9fffb,transparent);border-radius:12px;display:flex;justify-content:space-between;align-items:center\\\">\\n    <div>\\n      <strong>Download: Simple Morning Rituals</strong>\\n      <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">A one-page checklist to craft a calmer morning.</div>\\n    </div>\\n    <div>\\n      <a class=\\\"cta\\\" href=\\\"#\\\">Get the checklist</a>\\n    </div>\\n  </section>\\n\\n</main>\\n<footer>\\n  <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n    <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n    <div class=\\\"muted\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </div>\\n</footer>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#ff8c42;--muted:#55636a;--bg:#fff;--card:#fff7f5;--radius:14px}\\n    body{font-family:Inter,system-ui,Segoe UI,Roboto,Arial;margin:0;color:#081226;background:linear-gradient(180deg,#fff,#fffdfc)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 34px}\\n    nav a{margin:0 10px;color:#081226;text-decoration:none;font-weight:700}\\n    .wrap{max-width:1100px;margin:18px auto;padding:0 20px}\\n    .hero{background:linear-gradient(90deg,rgba(255,140,66,0.06),transparent);padding:18px;border-radius:12px;display:flex;justify-content:space-between;align-items:center}\\n    h1{margin:6px 0}\\n    .programs{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .pkg{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 10px 30px rgba(8,18,38,0.05)}\\n    .price{font-size:20px;font-weight:900;color:#081226}\\n    .muted{color:var(--muted)}\\n    .cta{background:var(--accent);color:#fff;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:800}\\n    .faq{margin-top:18px}\\n    footer{padding:28px 34px;color:var(--muted)}\\n    @media(max-width:980px){.programs{grid-template-columns:1fr}.hero{flex-direction:column;align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n<header>\\n  <div style=\\\"font-weight:900;display:flex;gap:12px;align-items:center\\\"><img src=\\\"assets/img/pattern.svg\\\" alt=\\\"mark\\\" width=\\\"36\\\" height=\\\"36\\\"/>{{BUSINESS_NAME}}</div>\\n  <nav>\\n    <a href=\\\"index.html\\\">Home</a>\\n    <a href=\\\"services.html\\\">Packages</a>\\n    <a href=\\\"about.html\\\">About</a>\\n    <a href=\\\"book.html\\\">Book</a>\\n  </nav>\\n</header>\\n<main class=\\\"wrap\\\">\\n  <section class=\\\"hero\\\">\\n    <div>\\n      <div style=\\\"font-weight:800;\\\">Programs</div>\\n      <h1>Paths designed for steady, sustainable change</h1>\\n      <p class=\\\"muted\\\">Pick a rhythm that fits your goals. Every path centers on practical habits, measurable progress, and compassionate support.</p>\\n    </div>\\n    <img src=\\\"assets/img/hero.svg\\\" alt=\\\"illustration\\\" width=\\\"220\\\" />\\n  </section>\\n\\n  <section class=\\\"programs\\\">\\n    <div class=\\\"pkg\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <div style=\\\"font-weight:800\\\">Starter Path</div>\\n          <div class=\\\"muted\\\">4-week habit accelerator</div>\\n        </div>\\n        <div class=\\\"price\\\">$499</div>\\n      </div>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:10px\\\">Best for testing one new routine with guidance: includes weekly 50-minute sessions, habit checklist, and two short check-ins.</p>\\n      <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Join Starter</a></div>\\n    </div>\\n\\n    <div class=\\\"pkg\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <div style=\\\"font-weight:800\\\">Momentum Plan</div>\\n          <div class=\\\"muted\\\">3-month coaching container</div>\\n        </div>\\n        <div class=\\\"price\\\">$1699</div>\\n      </div>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:10px\\\">Monthly rhythm, ongoing adjustments, habit analytics, and mid-month check-ins for steady change that lasts.</p>\\n      <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Start Momentum</a></div>\\n    </div>\\n\\n    <div class=\\\"pkg\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <div style=\\\"font-weight:800\\\">VIP Day + 30</div>\\n          <div class=\\\"muted\\\">One full-day intensive + 30 days follow-up</div>\\n        </div>\\n        <div class=\\\"price\\\">$2399</div>\\n      </div>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:10px\\\">A condensed, powerful reset: design your ideal routines in a focused day and receive weekly check-ins for 30 days to embed them.</p>\\n      <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Book a VIP Day</a></div>\\n    </div>\\n  </section>\\n\\n  <section style=\\\"margin-top:20px\\\">\\n    <h2>Why the tiered approach?</h2>\\n    <p class=\\\"muted\\\">Different rhythms work for different seasons of life. The Starter Path limits scope so you can win small. Momentum supports ongoing shifts. VIP Day accelerates change when you need concentrated clarity.</p>\\n  </section>\\n\\n  <section style=\\\"margin-top:20px\\\">\\n    <h3>Program flow</h3>\\n    <ol class=\\\"muted\\\" style=\\\"margin-top:8px\\\">\\n      <li><strong>Intake & goal clarity</strong> \\u2014 Understand patterns and pick high-leverage habits.</li>\\n      <li><strong>Micro-experiments</strong> \\u2014 Short, repeatable tests for 1\\u20132 weeks.</li>\\n      <li><strong>Iterate</strong> \\u2014 Tune the plan based on real-life feedback.</li>\\n      <li><strong>Embed</strong> \\u2014 Tools and rituals to keep what works.</li>\\n    </ol>\\n  </section>\\n\\n  <section class=\\\"faq\\\">\\n    <h3>Common questions</h3>\\n    <details>\\n      <summary style=\\\"font-weight:700\\\">Do you provide materials between sessions?</summary>\\n      <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Yes. Expect short worksheets, habit trackers, and tailored micro-tasks you can do between sessions.</div>\\n    </details>\\n    <details style=\\\"margin-top:8px\\\">\\n      <summary style=\\\"font-weight:700\\\">Can I upgrade from Starter to Momentum?</summary>\\n      <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Absolutely. Many clients begin with Starter and move to Momentum if they want longer-term support.</div>\\n    </details>\\n    <details style=\\\"margin-top:8px\\\">\\n      <summary style=\\\"font-weight:700\\\">Is the VIP Day refundable?</summary>\\n      <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">VIP Day deposits are transferable with 14 days notice; full details are included in the booking agreement.</div>\\n    </details>\\n  </section>\\n\\n  <section style=\\\"margin-top:22px;padding:18px;background:#fff3ed;border-radius:12px;display:flex;justify-content:space-between;align-items:center\\\">\\n    <div>\\n      <strong>Free resource: A simple evening ritual</strong>\\n      <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Small steps that help mornings start easier. Perfect if you're unsure which path to pick.</div>\\n    </div>\\n    <div>\\n      <a class=\\\"cta\\\" href=\\\"#\\\">Send me the ritual</a>\\n    </div>\\n  </section>\\n\\n  <section style=\\\"margin-top:22px;display:flex;justify-content:space-between;align-items:center\\\">\\n    <div>\\n      <strong>Ready to choose a path?</strong>\\n      <div class=\\\"muted\\\">Schedule a brief discovery call and we\\u2019ll pick the best fit for your life and goals.</div>\\n    </div>\\n    <div><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n  </section>\\n\\n</main>\\n<footer>\\n  <div style=\\\"display:flex;justify-content:space-between;align-items:center;padding:18px 34px\\\">\\n    <div>© {{BUSINESS_NAME}}</div>\\n    <div class=\\\"muted\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a><