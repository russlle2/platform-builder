          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Investment & Packages</title>\\n  <style>\\n    :root{--bg:#0f0f12;--card:#0f1220;--muted:#aeb3bd;--accent:#e7c07a;--glass:rgba(255,255,255,0.04);--accent-2:#f0d9b3}\\n    html,body{height:100%;margin:0;font-family:Inter, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial; background:linear-gradient(180deg,#070709 0%, #0f0f12 100%);color:#fff}\\n    .wrap{max-width:1100px;margin:36px auto;padding:36px;}\\n    nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}\\n    nav .brand{font-weight:700;letter-spacing:0.6px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:0.95rem}\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:28px;align-items:center;margin-bottom:34px}\\n    .hero .intro{padding:28px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);backdrop-filter:blur(6px)}\\n    .kicker{color:var(--accent);font-weight:600;margin-bottom:8px}\\n    h1{font-size:2.1rem;margin:0 0 10px}\\n    p.lead{color:var(--muted);margin:0 0 18px;line-height:1.5}\\n    .cta-row{display:flex;gap:12px}\\n    .btn{background:var(--accent);color:#051014;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .ghost{border:1px solid rgba(255,255,255,0.06);padding:10px 14px;border-radius:10px;color:var(--muted);text-decoration:none}\\n    .visual{border-radius:12px;padding:18px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));display:flex;align-items:center;justify-content:center}\\n    /* Pricing grid */\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:26px 0}\\n    .card{background:var(--card);padding:20px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .price{font-size:1.6rem;color:var(--accent-2);font-weight:700;margin:10px 0}\\n    .benefit{color:var(--muted);font-size:0.95rem;margin:8px 0}\\n    .tiny{font-size:0.85rem;color:var(--muted)}\\n    footer{margin-top:40px;color:var(--muted);font-size:0.9rem}\\n    /* testimonials preview */\\n    .test-preview{display:flex;gap:12px;margin-top:18px}\\n    .test{background:var(--glass);padding:12px;border-radius:10px;font-size:0.95rem}\\n    /* responsive */\\n    @media (max-width:900px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}} \\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <div>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">Story</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"book.html\\\">Start</a>\\n      </div>\\n    </nav>\\n\\n    <section class=\\\"hero\\\" aria-label=\\\"Pricing hero\\\">\\n      <div class=\\\"intro\\\">\\n        <div class=\\\"kicker\\\">INVESTMENT</div>\\n        <h1>Investment & Packages tuned to habit change</h1>\\n        <p class=\\\"lead\\\">Choose the level of guidance that fits your life rhythm. Each package is built around a clear habit-focused plan, measurable checkpoints, and personalized feedback from {{COACH_NAME}} ({ {CREDENTIALS} }).</p>\\n        <div class=\\\"cta-row\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a class=\\\"ghost\\\" href=\\\"book.html\\\">Book a clarity call</a>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"visual\\\" role=\\\"img\\\" aria-label=\\\"abstract gallery art\\\">\\n        <!-- unique inline SVG for this template: assets/img/hero.svg (crafted inline) -->\\n        <svg width=\\\"360\\\" height=\\\"220\\\" viewBox=\\\"0 0 360 220\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n          <defs>\\n            <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n              <stop offset=\\\"0\\\" stop-color=\\\"#f4e4c4\\\" stop-opacity=\\\"0.9\\\"/>\\n              <stop offset=\\\"1\\\" stop-color=\\\"#e7c07a\\\" stop-opacity=\\\"0.85\\\"/>\\n            </linearGradient>\\n            <filter id=\\\"blur\\\"><feGaussianBlur stdDeviation=\\\"18\\\"/></filter>\\n          </defs>\\n          <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"360\\\" height=\\\"220\\\" rx=\\\"14\\\" fill=\\\"#071018\\\" />\\n          <g filter=\\\"url(#blur)\\\">\\n            <circle cx=\\\"70\\\" cy=\\\"60\\\" r=\\\"60\\\" fill=\\\"url(#g1)\\\" />\\n            <rect x=\\\"180\\\" y=\\\"40\\\" rx=\\\"22\\\" width=\\\"140\\\" height=\\\"120\\\" fill=\\\"#122025\\\" opacity=\\\"0.7\\\" />\\n            <path d=\\\"M40 170c40-30 120-36 200-14\\\" stroke=\\\"#d9b884\\\" stroke-width=\\\"6\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\" />\\n          </g>\\n          <g opacity=\\\"0.95\\\">\\n            <circle cx=\\\"260\\\" cy=\\\"120\\\" r=\\\"48\\\" fill=\\\"#f8e9d0\\\" />\\n            <circle cx=\\\"260\\\" cy=\\\"120\\\" r=\\\"18\\\" fill=\\\"#0b1d20\\\" />\\n          </g>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <section aria-label=\\\"Packages\\\" class=\\\"packages\\\">\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"card\\\">\\n          <div class=\\\"tiny\\\">Starter</div>\\n          <h3>Foundations</h3>\\n          <div class=\\\"price\\\">$297 one-time</div>\\n          <div class=\\\"benefit\\\">4 weeks of guided habit-building: weekly 30-min check-ins, daily habit tracker, email support.</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve Foundations</a></div>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"border:2px solid rgba(231,192,122,0.14)\\\">\\n          <div class=\\\"tiny\\\">Most popular</div>\\n          <h3>Momentum</h3>\\n          <div class=\\\"price\\\">$129/mo (min 3 months)</div>\\n          <div class=\\\"benefit\\\">Weekly coaching calls, tailored habit sprints, accountability, habit audits every month.</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Join Momentum</a></div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <div class=\\\"tiny\\\">Deep work</div>\\n          <h3>90-Day Deep Shift</h3>\\n          <div class=\\\"price\\\">$2497 one-time</div>\\n          <div class=\\\"benefit\\\">90-day immersive: weekly sessions, daily micro-practices, personalized toolkit, priority messaging.</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Apply for Deep Shift</a></div>\\n        </div>\\n      </div>\\n\\n      <p class=\\\"tiny\\\">All packages include a starter assessment, a tailored habit map, and resources to sustain gains after the program ends. No medical claims — change comes from consistent, evidence-informed habits.</p>\\n    </section>\\n\\n    <section aria-label=\\\"Method\\\" style=\\\"margin-top:26px\\\">\\n      <h2 style=\\\"margin:0 0 12px\\\">How I work — the G.R.O.W. routine</h2>\\n      <p class=\\\"lead\\\" style=\\\"margin-top:0;color:var(--muted)\\\">My framework focuses on Goals, Routines, Obstacles, and Wins — a rhythm that makes small choices compound into meaningful outcomes. Sessions are short, targeted, and paired with daily micro-habits you can follow easily.</p>\\n\\n      <div class=\\\"test-preview\\\">\\n        <div class=\\\"test\\\">Goal planning + 2-week pilot habits</div>\\n        <div class=\\\"test\\\">Weekly accountability & habit tracker</div>\\n        <div class=\\\"test\\\">Progress ritual & reflection prompts</div>\\n      </div>\\n    </section>\\n\\n    <section aria-label=\\\"Coach story\\\" style=\\\"margin-top:26px\\\">\\n      <h3 style=\\\"margin-bottom:6px\\\">Why this matters to me</h3>\\n      <p class=\\\"tiny\\\" style=\\\"margin:0;color:var(--muted)\\\">I started as a counselor and shifted to coaching to focus on daily routines that actually move the needle. My clients see steady behavior change because we prioritize doable steps over dramatic promises.</p>\\n    </section>\\n\\n    <section aria-label=\\\"Testimonials\\\" style=\\\"margin-top:22px\\\">\\n      <h3>Client highlights</h3>\\n      <div class=\\\"test-preview\\\">\\n        <div class=\\\"test\\\">\\\"I finally have a morning rhythm that sticks — small wins every day.\\\" — A., {{CITY}}</div>\\n        <div class=\\\"test\\\">\\\"Consistent accountability helped me finish a long project.\\\" — R., {{STATE}}</div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap\\\">\\n        <div>{{BUSINESS_NAME}} • {{TAGLINE}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a></div>\\n        <div style=\\\"margin-top:8px\\\">Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted)\\\">{{PHONE}}</a> • <a href=\\\"book.html\\\">Start with a free consult</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Client Voices — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--muted:#6b6f76;--accent:#2b6b5a;--card:#f7fbf9}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto; background:linear-gradient(180deg,#fffdfb,#f7fbfb);color:#0b1720}\\n    .wrap{max-width:980px;margin:36px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    header .nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .hero{display:flex;gap:20px;align-items:center;margin:22px 0}\\n    .hero .text h1{margin:0;font-size:1.9rem}\\n    .hero .text p{margin:8px 0 0;color:var(--muted)}\\n    .gallery{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px}\\n    .quote{background:var(--card);padding:18px;border-radius:10px;border-left:6px solid rgba(43,107,90,0.12)}\\n    .by{margin-top:10px;font-weight:700;color:#0b1720}\\n    .meta{color:var(--muted);font-size:0.92rem}\\n    .grid-sml{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:20px}\\n    .mini{background:#fff;padding:12px;border-radius:10px;border:1px solid #eef2f1;font-size:0.95rem}\\n    .cta{margin-top:28px}\\n    footer{margin-top:34px;color:var(--muted);font-size:0.95rem}\\n    @media (max-width:800px){.gallery{grid-template-columns:1fr}.grid-sml{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">The Story</a>\\n        <a href=\\\"programs.html\\\">Work With Me</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"text\\\">\\n        <h1>Client voices — progress told in habits</h1>\\n        <p>Real outcomes that are tracked and repeated: small routines that stack into dependable results. Read a selection of client journeys.</p>\\n      </div>\\n\\n      <div style=\\\"width:200px\\\">\\n        <!-- unique avatar svg for this page: assets/img/avatar.svg (inline) -->\\n        <svg width=\\\"200\\\" height=\\\"200\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n          <defs>\\n            <linearGradient id=\\\"a2\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n              <stop offset=\\\"0\\\" stop-color=\\\"#bfeadf\\\"/>\\n              <stop offset=\\\"1\\\" stop-color=\\\"#89c9b7\\\"/>\\n            </linearGradient>\\n          </defs>\\n          <rect width=\\\"200\\\" height=\\\"200\\\" rx=\\\"20\\\" fill=\\\"#f0fbf7\\\"/>\\n          <circle cx=\\\"100\\\" cy=\\\"70\\\" r=\\\"36\\\" fill=\\\"url(#a2)\\\" />\\n          <rect x=\\\"46\\\" y=\\\"120\\\" width=\\\"108\\\" height=\\\"52\\\" rx=\\\"12\\\" fill=\\\"#dff6ef\\\"/>\\n          <path d=\\\"M60 132c12-6 36-6 60 0\\\" stroke=\\\"#0b2b25\\\" stroke-width=\\\"2\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\" />\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <section aria-label=\\\"testimonial gallery\\\">\\n      <div class=\\\"gallery\\\">\\n        <div class=\\\"quote\\\">\\n          <div class=\\\"meta\\\">\\\"The weekly micro-steps were the secret — small, consistent actions created momentum.\\\"</div>\\n          <div class=\\\"by\\\">— Jasmine, {{CITY}}</div>\\n        </div>\\n        <div class=\\\"quote\\\">\\n          <div class=\\\"meta\\\">\\\"I replaced an all-or-nothing habit with a 5-minute daily ritual. Months later it feels effortless.\\\"</div>\\n          <div class=\\\"by\\\">— Mark, {{STATE}}</div>\\n        </div>\\n        <div class=\\\"quote\\\">\\n          <div class=\\\"meta\\\">\\\"The tracking and weekly reflection stopped my cycle of starting over.\\\"</div>\\n          <div class=\\\"by\\\">— S., Product Manager</div>\\n        </div>\\n        <div class=\\\"quote\\\">\\n          <div class=\\\"meta\\\">\\\"Accountability was steady and kind — exactly what I needed to make a change stick.\\\"</div>\\n          <div class=\\\"by\\\">— R., Entrepreneur</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"grid-sml\\\">\\n        <div class=\\\"mini\\\"><strong>Snapshot:</strong> 78% of clients keep at least one new daily habit after 12 weeks (self-reported).</div>\\n        <div class=\\\"mini\\\"><strong>Lead magnet:</strong> Download the 7-day Habit Reset (free) — link on the contact page.</div>\\n        <div class=\\\"mini\\\"><strong>Method:</strong> Weekly check-in + micro-practice journal.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h3 style=\\\"margin-bottom:8px\\\">Coach perspective</h3>\\n      <p class=\\\"meta\\\" style=\\\"margin:0\\\">{{COACH_NAME}}, {{CREDENTIALS}} — I focus on making practices tiny, trackable, and pleasurable so they are more likely to endure. No miracle fixes — just steady, designed behavior change.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h4>What clients ask before they start</h4>\\n      <ul style=\\\"color:var(--muted)\\\">\\n        <li>How much time will I need each week?</li>\\n        <li>Can I try a single month before committing?</li>\\n        <li>What if I travel or miss a week?</li>\\n      </ul>\\n    </section>\\n\\n    <div class=\\\"cta\\\">\\n      <a href=\\\"book.html\\\" style=\\\"background:#2b6b5a;color:#fff;padding:12px 16px;border-radius:10px;text-decoration:none;font-weight:700\\\">Schedule a kinder conversation</a>\\n    </div>\\n\\n    <footer>\\n      <div style=\\\"margin-top:20px;color:var(--muted)\\\">Want to read more? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfbfd;--card:#ffffff;--muted:#55606a;--accent:#c27a4a}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto;background:var(--bg);color:#0e1416}\\n    .wrap{max-width:880px;margin:28px auto;padding:28px}\\n    nav{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:12px}\\n    .layout{display:grid;grid-template-columns:1fr 360px;gap:20px;margin-top:20px}\\n    .panel{background:var(--card);padding:20px;border-radius:12px;box-shadow:0 6px 20px rgba(15,20,24,0.06)}\\n    h1{margin:0 0 6px}\\n    p.lead{color:var(--muted);margin-top:0}\\n    form{display:flex;flex-direction:column;gap:10px}\\n    input,textarea,select{padding:10px;border-radius:8px;border:1px solid #e7e9eb;font-size:0.95rem}\\n    .submit{background:var(--accent);color:#fff;padding:10px;border-radius:8px;border:none;font-weight:700}\\n    .sessions{display:grid;grid-template-columns:1fr;gap:10px;margin-top:12px}\\n    .pkg{border:1px dashed #efe6df;padding:12px;border-radius:8px}\\n    .faq{margin-top:16px;color:var(--muted);font-size:0.95rem}\\n    footer{margin-top:22px;color:var(--muted);font-size:0.9rem}\\n    @media (max-width:900px){.layout{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <div>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"pricing.html\\\">Investment</a>\\n      </div>\\n    </nav>\\n\\n    <main class=\\\"layout\\\">\\n      <section class=\\\"panel\\\">\\n        <h1>Schedule a conversation</h1>\\n        <p class=\\\"lead\\\">Pick a time for a 20-minute exploratory call. We’ll map where you are, outline simple next steps, and see which pathway aligns with your life.</p>\\n\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\">\\n          <label>\\n            Full name\\n            <input name=\\\"name\\\" placeholder=\\\"Your name\\\" required />\\n          </label>\\n\\n          <label>\\n            Email\\n            <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required />\\n          </label>\\n\\n          <label>\\n            Phone\\n            <input name=\\\"phone\\\" placeholder=\\\"Optional\\\" />\\n          </label>\\n\\n          <label>\\n            Which focus feels most urgent?\\n            <select name=\\\"focus\\\">\\n              <option>Energy & rhythm</option>\\n              <option>Daily productivity</option>\\n              <option>Stress & rest practices</option>\\n              <option>Other</option>\\n            </select>\\n          </label>\\n\\n          <label>\\n            Preferred time / note\\n            <textarea name=\\\"note\\\" rows=\\\"3\\\" placeholder=\\\"Add any context (time zone, schedule)\\\" ></textarea>\\n          </label>\\n\\n          <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n            <button class=\\\"submit\\\" type=\\\"submit\\\">Request a call</button>\\n            <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">Or email me</a>\\n          </div>\\n        </form>\\n\\n        <div class=\\\"faq\\\">\\n          <h4 style=\\\"margin:10px 0 6px\\\">Quick answers</h4>\\n          <div><strong>How long is the intro?</strong> ~20 minutes — we keep it focused and practical.</div>\\n          <div style=\\\"margin-top:6px\\\"><strong>Do you work remotely?</strong> Yes — sessions by video or phone, depending on your preference.</div>\\n        </div>\\n      </section>\\n\\n      <aside class=\\\"panel\\\">\\n        <h3>Paths you can choose</h3>\\n        <div class=\\\"sessions\\\">\\n          <div class=\\\"pkg\\\">\\n            <strong>Starter Cycle</strong>\\n            <div style=\\\"color:var(--muted);font-size:0.95rem\\\">4-week short course — $297. Perfect for a focused habit reset.</div>\\n          </div>\\n          <div class=\\\"pkg\\\">\\n            <strong>Accountability Duo</strong>\\n            <div style=\\\"color:var(--muted);font-size:0.95rem\\\">8 weeks, two weekly check-ins — $89/week billed monthly. Built for busy schedules.</div>\\n          </div>\\n          <div class=\\\"pkg\\\">\\n            <strong>90-Day Deep Dive</strong>\\n            <div style=\\\"color:var(--muted);font-size:0.95rem\\\">Intensive support, tailored habits, and a toolkit for long-term change — from $2497.</div>\\n          </div>\\n        </div>\\n\\n        <h4 style=\\\"margin-top:14px\\\">What to expect next</h4>\\n        <p style=\\\"color:var(--muted);margin:6px 0\\\">After you request a call you’ll receive a short intake and a calendar link. The call is exploratory — no obligation.</p>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <a href=\\\"pricing.html\\\" style=\\\"background:var(--accent);color:#fff;padding:10px 14px;border-radius:8px;text-decoration:none;font-weight:700\\\">View Packages</a>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"panel\\\">\\n      <h4 style=\\\"margin:0 0 8px\\\">Philosophy & lead magnet</h4>\\n      <p style=\\\"margin:0;color:var(--muted)\\\">I believe pacesetter habits are small, consistent, and pleasurable. If you sign up for a call you'll also get the 7-day Habit Reset guide — a concise workbook to start right away.</p>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"margin-top:18px;color:var(--muted)\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or phone <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>. {{BUSINESS_NAME}} — {{TAGLINE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
