          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Pricing & Plans</title>\\n  <style>\\n    :root{--bg:#f7faf9;--card:#fff;--muted:#6b7280;--accent:#0f766e;--glass:rgba(15,118,110,0.06);--radius:12px}\\n    *{box-sizing:border-box;font-family:Inter,system-ui,-apple-system,Segoe UI,Helvetica,Arial,sans-serif}\\n    body{margin:0;background:var(--bg);color:#0f172a;line-height:1.4}\\n    .wrap{max-width:1100px;margin:36px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 6px}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 12px;font-weight:600}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;background:linear-gradient(180deg,#ffffff 0%,#f8fafb 100%);padding:28px;border-radius:14px}\\n    .hero h1{margin:0 0 8px;font-size:28px;color:#042f2e}\\n    .hero p{margin:0;color:var(--muted)}\\n    .card{background:var(--card);border-radius:12px;padding:18px;box-shadow:0 6px 18px rgba(12,17,23,0.06)}\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:18px}\\n    .tier{padding:20px;border-radius:10px;border:1px solid rgba(7,16,15,0.04)}\\n    .tier.best{border-color:rgba(15,118,110,0.14);box-shadow:0 8px 28px rgba(15,118,110,0.06)}\\n    .price{font-size:20px;font-weight:700;color:#063f3b;margin:10px 0}\\n    .btn{display:inline-block;padding:10px 14px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none;font-weight:700}\\n    .muted{color:var(--muted);font-size:14px}\\n    .grid-2{display:grid;grid-template-columns:1fr 300px;gap:18px;margin-top:18px}\\n    ul{padding-left:18px;margin:8px 0}\\n    footer{margin-top:26px;padding:18px;text-align:center;color:var(--muted)}\\n    .mini-proof{display:flex;gap:12px;align-items:center}\\n    .chip{background:var(--glass);padding:6px 10px;border-radius:999px;font-weight:700;color:#054442}\\n    .faq dt{font-weight:700;margin-top:12px}\\n    .lead{display:flex;gap:12px;align-items:center}\\n    .input{padding:10px;border-radius:8px;border:1px solid #e6eef0;width:100%}\\n    /* Inline SVG placeholders styling */\\n    .svg-hero{width:100%;height:120px}\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.tiers{grid-template-columns:1fr}.grid-2{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"width:48px;height:48px;border-radius:10px;background:var(--accent);display:grid;place-items:center;color:#fff;font-weight:800\\\">WC</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <!-- Hero (concise) -->\\n    <section class=\\\"hero card\\\">\\n      <div>\\n        <h1>Transparent, outcome-focused pricing for lasting habits</h1>\\n        <p class=\\\"muted\\\">Choose a structure that fits your rhythm — monthly guidance, focused intensives, or a dedicated VIP Day with {{COACH_NAME}} {{CREDENTIALS}} in {{CITY}}, {{STATE}}.</p>\\n        <div style=\\\"margin-top:14px;display:flex;gap:12px;align-items:center\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <span class=\\\"muted\\\">Or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{PHONE}}</a></span>\\n        </div>\\n        <div style=\\\"margin-top:16px;display:flex;gap:8px;align-items:center\\\">\\n          <div class=\\\"chip\\\">Framework-led</div>\\n          <div class=\\\"chip\\\">Habit-first</div>\\n          <div class=\\\"chip\\\">Evidence-based routines</div>\\n        </div>\\n      </div>\\n\\n      <div>\\n        <!-- hero svg (unique, inline) -->\\n        <svg class=\\\"svg-hero\\\" viewBox=\\\"0 0 240 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-label=\\\"abstract growth illustration\\\">\\n          <defs>\\n            <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n              <stop offset=\\\"0\\\" stop-color=\\\"#a7f3d0\\\"/>\\n              <stop offset=\\\"1\\\" stop-color=\\\"#0f766e\\\"/>\\n            </linearGradient>\\n          </defs>\\n          <rect x=\\\"6\\\" y=\\\"18\\\" rx=\\\"16\\\" width=\\\"88\\\" height=\\\"84\\\" fill=\\\"#e6fffb\\\"/>\\n          <path d=\\\"M110 100 C130 40, 200 40, 220 100\\\" stroke=\\\"url(#g1)\\\" stroke-width=\\\"8\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/>\\n          <circle cx=\\\"62\\\" cy=\\\"60\\\" r=\\\"8\\\" fill=\\\"#0f766e\\\"/>\\n          <rect x=\\\"18\\\" y=\\\"28\\\" width=\\\"52\\\" height=\\\"8\\\" rx=\\\"4\\\" fill=\\\"#34d399\\\"/>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <!-- Social proof (compact) -->\\n    <section style=\\\"display:flex;gap:12px;margin-top:18px;align-items:center\\\">\\n      <div class=\\\"card mini-proof\\\" style=\\\"padding:12px\\\">\\n        <div style=\\\"font-size:18px;font-weight:800\\\">98%</div>\\n        <div class=\\\"muted\\\">of clients report clearer daily routines</div>\\n      </div>\\n      <div class=\\\"card mini-proof muted\\\" style=\\\"padding:12px\\\">Trusted by individuals across {{CITY}} • Featured in local wellness circles</div>\\n    </section>\\n\\n    <!-- Pricing tiers -->\\n    <main class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Choose the structure that helps you build the habit</h2>\\n      <p class=\\\"muted\\\" style=\\\"margin:0 0 16px\\\">Each option centers measurable micro-goals and a simple weekly framework so progress stacks over time.</p>\\n\\n      <div class=\\\"tiers\\\">\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"font-weight:700\\\">Foundations Monthly</div>\\n          <div class=\\\"price\\\">$295 / month</div>\\n          <div class=\\\"muted\\\">Best for steady habit formation</div>\\n          <ul>\\n            <li>2 coaching calls / month (30 min)</li>\\n            <li>Weekly habit checks & accountability</li>\\n            <li>Access to habit workbook</li>\\n          </ul>\\n          <a class=\\\"btn\\\" href=\\\"book.html?plan=foundations\\\">Start Foundations</a>\\n        </div>\\n\\n        <div class=\\\"tier best\\\">\\n          <div style=\\\"font-weight:700\\\">Momentum Program</div>\\n          <div class=\\\"price\\\">$1,800 — 12 weeks</div>\\n          <div class=\\\"muted\\\">For focused change with weekly structure</div>\\n          <ul>\\n            <li>Weekly 50-min sessions</li>\\n            <li>Personalized habit map + morning/evening rituals</li>\\n            <li>Messaging support & checkpoint session</li>\\n          </ul>\\n          <a class=\\\"btn\\\" href=\\\"book.html?plan=momentum\\\">Reserve Momentum</a>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"font-weight:700\\\">VIP Day Intensive</div>\\n          <div class=\\\"price\\\">$950 — one day</div>\\n          <div class=\\\"muted\\\">Deep reset and a concrete 90-day plan</div>\\n          <ul>\\n            <li>6-hour focused session with {{COACH_NAME}}</li>\\n            <li>90-day habit blueprint</li>\\n            <li>Two follow-up 30-min check-ins</li>\\n          </ul>\\n          <a class=\\\"btn\\\" href=\\\"book.html?plan=vipday\\\">Book VIP Day</a>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"grid-2\\\" style=\\\"margin-top:18px\\\">\\n        <div>\\n          <h3 style=\\\"margin:0 0 8px\\\">How pricing supports outcomes</h3>\\n          <p class=\\\"muted\\\">Structures are designed to prioritize consistency over intensity. You’ll get a repeatable framework, small habit wins, and measurable checkpoints instead of one-off fixes.</p>\\n          <h4 style=\\\"margin-top:12px\\\">Add-ons</h4>\\n          <ul class=\\\"muted\\\">\\n            <li>Personalized meal rhythm guide — $120</li>\\n            <li>Sleep routine audit + plan — $150</li>\\n            <li>Custom habit cards (printable) — $35</li>\\n          </ul>\\n        </div>\\n\\n        <aside class=\\\"card\\\">\\n          <div style=\\\"font-weight:800\\\">Download the pricing & roadmap PDF</div>\\n          <p class=\\\"muted\\\">Get a one-page planner that maps the first 30, 60, and 90 days of change.</p>\\n          <form action=\\\"/lead\\\" method=\\\"post\\\">\\n            <label class=\\\"muted\\\">Email</label>\\n            <input class=\\\"input\\\" type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n            <div style=\\\"margin-top:10px;display:flex;gap:8px\\\">\\n              <button class=\\\"btn\\\" type=\\\"submit\\\">Get the PDF</button>\\n              <a class=\\\"muted\\\" href=\\\"contact.html\\\">Questions?</a>\\n            </div>\\n          </form>\\n        </aside>\\n      </div>\\n\\n      <!-- FAQ (unique to pricing page) -->\\n      <section style=\\\"margin-top:18px\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">Common pricing questions</h3>\\n        <dl class=\\\"faq muted\\\">\\n          <dt>Do you offer sliding scale or scholarships?</dt>\\n          <dd>Yes. Limited spots are available for reduced rates — please reach out via <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"color:var(--accent)\\\">contact</a> to inquire.</dd>\\n\\n          <dt>What’s the cancellation policy for VIP Day?</dt>\\n          <dd>We require 14 days notice for a full refund. Within 14 days a partial credit may be issued to reschedule.</dd>\\n\\n          <dt>Can I switch programs mid-way?</dt>\\n          <dd>Absolutely. We’ll assess progress at checkpoints and recommend adjustments that align with your goals.</dd>\\n        </dl>\\n      </section>\\n    </main>\\n\\n    <!-- Small CTA + contact -->\\n    <section style=\\\"display:flex;gap:12px;margin-top:18px;align-items:center\\\">\\n      <div class=\\\"card\\\" style=\\\"flex:1\\\">\\n        <h4 style=\\\"margin:0 0 6px\\\">Ready to pick a plan?</h4>\\n        <p class=\\\"muted\\\" style=\\\"margin:0 0 8px\\\">Start with a 20-minute clarity call so we can match a plan to your life rhythm.</p>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule a clarity call</a>\\n      </div>\\n      <div class=\\\"card muted\\\" style=\\\"padding:12px\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent)\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent)\\\">{{PHONE}}</a>.</div>\\n    </section>\\n\\n    <footer>\\n      © {{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"privacy.html\\\">Privacy</a>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Stories — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfdfe;--card:#fff;--accent:#065f5a;--muted:#556073}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Arial;color:#072022;background:var(--bg)}\\n    .container{max-width:1000px;margin:36px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .lead{background:var(--card);padding:22px;border-radius:12px;display:flex;gap:18px;align-items:center;box-shadow:0 6px 20px rgba(7,18,20,0.06)}\\n    .avatar{width:84px;height:84px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(180deg,#e6fffb,#bff1e6)}\\n    .avatar svg{width:56px;height:56px}\\n    h1{margin:0;font-size:22px}\\n    .muted{color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:18px}\\n    .testimonial{background:var(--card);padding:16px;border-radius:10px;min-height:140px;display:flex;flex-direction:column;justify-content:space-between}\\n    .quote{font-style:italic;color:#083333}\\n    .meta{display:flex;gap:10px;align-items:center;margin-top:12px}\\n    .btn{background:var(--accent);color:#fff;padding:8px 12px;border-radius:8px;text-decoration:none;font-weight:700}\\n    .lead-magnet{margin-top:18px;display:flex;gap:12px}\\n    .faq{margin-top:18px;background:var(--card);padding:12px;border-radius:10px}\\n    footer{margin-top:24px;color:var(--muted);text-align:center}\\n    @media(max-width:980px){.grid{grid-template-columns:1fr}.lead{flex-direction:column;align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"muted\\\">| {{TAGLINE}}</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"lead\\\">\\n      <div class=\\\"avatar card\\\">\\n        <!-- avatar svg unique to testimonials -->\\n        <svg viewBox=\\\"0 0 64 64\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\">\\n          <circle cx=\\\"32\\\" cy=\\\"20\\\" r=\\\"12\\\" fill=\\\"#0f766e\\\"/>\\n          <rect x=\\\"12\\\" y=\\\"36\\\" width=\\\"40\\\" height=\\\"16\\\" rx=\\\"6\\\" fill=\\\"#34d399\\\"/>\\n        </svg>\\n      </div>\\n      <div>\\n        <h1>Real clients, real shifts — short stories</h1>\\n        <p class=\\\"muted\\\">How small habit pivots created calmer mornings, steadier energy, and more clarity. No hype — just structured change led by {{COACH_NAME}}.</p>\\n      </div>\\n      <div style=\\\"margin-left:auto;text-align:right\\\">\\n        <div style=\\\"font-weight:800\\\">Book a clarity call</div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <!-- Testimonials grid -->\\n    <section class=\\\"grid\\\">\\n      <article class=\\\"testimonial\\\">\\n        <div>\\n          <div class=\\\"quote\\\">“I stopped relying on willpower and started building a short, doable morning routine. Within 6 weeks I felt more focused at work.”</div>\\n          <div class=\\\"meta muted\\\">— Sarah R., teacher • {{CITY}}</div>\\n        </div>\\n        <div style=\\\"display:flex;gap:10px;align-items:center;justify-content:flex-end\\\">\\n          <a class=\\\"btn\\\" href=\\\"book.html?story=sarah\\\">Read the plan</a>\\n        </div>\\n      </article>\\n\\n      <article class=\\\"testimonial\\\">\\n        <div>\\n          <div class=\\\"quote\\\">“The Momentum Program helped me stop starting and actually keep going. The accountability and micro-goals were life-changing.”</div>\\n          <div class=\\\"meta muted\\\">— Marcus D., engineer</div>\\n        </div>\\n        <div style=\\\"display:flex;gap:10px;align-items:center;justify-content:flex-end\\\">\\n          <a class=\\\"btn\\\" href=\\\"book.html?story=marcus\\\">See his schedule</a>\\n        </div>\\n      </article>\\n\\n      <article class=\\\"testimonial\\\">\\n        <div>\\n          <div class=\\\"quote\\\">“Our VIP Day was practical and calm. By afternoon I had a 90-day blueprint I could actually follow.”</div>\\n          <div class=\\\"meta muted\\\">— Lena K., entrepreneur</div>\\n        </div>\\n        <div style=\\\"display:flex;gap:10px;align-items:center;justify-content:flex-end\\\">\\n          <a class=\\\"btn\\\" href=\\\"book.html?plan=vipday\\\">Book a VIP Day</a>\\n        </div>\\n      </article>\\n    </section>\\n\\n    <!-- Social proof / metrics -->\\n    <section style=\\\"display:flex;gap:12px;margin-top:18px\\\">\\n      <div class=\\\"card\\\" style=\\\"flex:1;padding:14px\\\">\\n        <div style=\\\"font-size:20px;font-weight:800\\\">250+</div>\\n        <div class=\\\"muted\\\">coaching hours delivered this year</div>\\n      </div>\\n      <div class=\\\"card\\\" style=\\\"flex:1;padding:14px\\\">\\n        <div style=\\\"font-size:20px;font-weight:800\\\">4.9</div>\\n        <div class=\\\"muted\\\">average client satisfaction</div>\\n      </div>\\n    </section>\\n\\n    <!-- Benefits snapshot -->\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">What clients gain</h3>\\n      <ul class=\\\"muted\\\">\\n        <li>Practical daily rhythms that stick</li>\\n        <li>Simple frameworks for decision fatigue</li>\\n        <li>Accountability without pressure</li>\\n      </ul>\\n    </section>\\n\\n    <!-- Lead magnet -->\\n    <section class=\\\"lead-magnet\\\" style=\\\"margin-top:18px\\\">\\n      <aside class=\\\"card\\\" style=\\\"flex:1\\\">\\n        <div style=\\\"font-weight:800\\\">Free: 7-day habit reboot</div>\\n        <p class=\\\"muted\\\">A short email sequence with small, achievable steps you can implement today.</p>\\n        <form action=\\\"/lead\\\" method=\\\"post\\\">\\n          <input class=\\\"input\\\" name=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n          <div style=\\\"margin-top:8px\\\"><button class=\\\"btn\\\" type=\\\"submit\\\">Send me the 7-day reboot</button></div>\\n        </form>\\n      </aside>\\n\\n      <aside class=\\\"card\\\" style=\\\"width:320px;padding:12px\\\">\\n        <div style=\\\"font-weight:800\\\">Want a case study?</div>\\n        <p class=\\\"muted\\\">Download a 1-page case study on the Momentum Program.</p>\\n        <a class=\\\"btn\\\" href=\\\"pricing.html\\\">Download</a>\\n      </aside>\\n    </section>\\n\\n    <!-- Process (how change happens) -->\\n    <section class=\\\"faq\\\" aria-labelledby=\\\"process\\\">\\n      <h3 id=\\\"process\\\">How change is built — our three-phase approach</h3>\\n      <ol class=\\\"muted\\\">\\n        <li>Clarify: Identify the single highest-impact habit.</li>\\n        <li>Structure: Build repeatable micro-steps and cues.</li>\\n        <li>Scale: Layer additional habits and review metrics weekly.</li>\\n      </ol>\\n    </section>\\n\\n    <!-- FAQ unique to testimonials page -->\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px;padding:12px\\\">\\n      <h4 style=\\\"margin:0 0 8px\\\">Questions from clients</h4>\\n      <div class=\\\"muted\\\">\\n        <strong>How long before I see change?</strong>\\n        <p>Many clients notice small wins in 2–3 weeks; meaningful, stable shifts typically by 8–12 weeks when the framework is followed.</p>\\n\\n        <strong>Do you share templates?</strong>\\n        <p>Yes — habit maps, checklists, and morning/evening templates are included in the Momentum and VIP options.</p>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">Contact {{COACH_NAME}} at <a class=\\\"muted\\\" href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"book.html\\\">Book a call</a></div>\\n      <div style=\\\"margin-top:8px;color:var(--muted)\\\">© {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a Session — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f4f9f8;--card:#fff;--accent:#0b6b63;--muted:#5b6b70}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Arial;background:var(--bg);color:#042926}\\n    .container{max-width:980px;margin:32px auto;padding:18px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:18px;margin-top:18px}\\n    .card{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 6px 20px rgba(7,18,20,0.04)}\\n    form label{display:block;margin-top:8px;font-weight:700}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e9f2f0}\\n    .btn{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;border:none;font-weight:700}\\n    .muted{color:var(--muted)}\\n    .process{display:flex;gap:8px;margin-top:12px}\\n    .step{background:linear-gradient(180deg,#fff,#f8fffb);padding:10px;border-radius:8px;flex:1}\\n    footer{margin-top:18px;color:var(--muted);text-align:center}\\n    .svgb{width:100%;height:140px}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"width:46px;height:46px;border-radius:10px;background:var(--accent);display:grid;place-items:center;color:#fff;font-weight:800\\\">WC</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div class=\\\"muted\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"programs.html\\\">Work With Me</a>\\n        <a href=\\\"testimonials.html\\\">Stories</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <main class=\\\"grid\\\">\\n      <section>\\n        <div class=\\\"card\\\">\\n          <h2 style=\\\"margin:0 0 6px\\\">Book a session with {{COACH_NAME}}</h2>\\n          <p class=\\\"muted\\\">Choose a time and tell us a bit about what you want to work on. Sessions are focused on sustainable habits and clear next steps.</p>\\n\\n          <!-- Booking form -->\\n          <form action=\\\"/bookings\\\" method=\\\"post\\\" style=\\\"margin-top:12px\\\">\\n            <label>Full name</label>\\n            <input type=\\\"text\\\" name=\\\"name\\\" placeholder=\\\"Your name\\\" required>\\n\\n            <label>Email</label>\\n            <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n\\n            <label>Phone (optional)</label>\\n            <input type=\\\"tel\\\" name=\\\"phone\\\" placeholder=\\\"(555) 555-5555\\\">\\n\\n            <label>Which offering?</label>\\n            <select name=\\\"plan\\\">\\n              <option value=\\\"foundations\\\">Foundations Monthly — $295/mo</option>\\n              <option value=\\\"momentum\\\">Momentum — 12 weeks ($1,800)</option>\\n              <option value=\\\"vipday\\\">VIP Day — $950</option>\\n            </select>\\n\\n            <label>Preferred dates / notes</label>\\n            <textarea name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"A few lines about what you want to focus on\\\"></textarea>\\n\\n            <div style=\\\"margin-top:12px;display:flex;gap:10px;align-items:center\\\">\\n              <button class=\\\"btn\\\" type=\\\"submit\\\">Request booking</button>\\n              <a class=\\\"muted\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Need help choosing?</a>\\n            </div>\\n          </form>\\n\\n          <!-- Process snippet -->\\n          <div style=\\\"margin-top:16px\\\">\\n            <h4 style=\\\"margin:0 0 8px\\\">What happens after you book</h4>\\n            <div class=\\\"process muted\\\">\\n              <div class=\\\"step\\\"><strong>1.</strong> Clarity call to align goals</div>\\n              <div class=\\\"step\\\"><strong>2.</strong> Personalized habit blueprint</div>\\n              <div class=\\\"step\\\"><strong>3.</strong> Check-ins and adjustments</div>\\n            </div>\\n          </div>\\n\\n          <!-- FAQ (booking specific) -->\\n          <div style=\\\"margin-top:14px\\\" class=\\\"muted\\\">\\n            <strong>Do you accept clients remotely?</strong>\\n            <p>Yes — sessions are offered virtually and in-person in {{CITY}} by appointment.</p>\\n\\n            <strong>How do payments work?</strong>\\n            <p>Payments are taken via secure payment link after booking. For programs, we offer installment plans.</p>\\n          </div>\\n\\n        </div>\\n\\n        <!-- Lead magnet compact -->\\n        <div style=\\\"margin-top:12px\\\" class=\\\"card muted\\\">\\n          <strong>Free resource</strong>\\n          <p class=\\\"muted\\\">Grab the Habit Starter Kit — a three-page planner for the first 30 days.</p>\\n          <form action=\\\"/lead\\\" method=\\\"post\\\">\\n            <input name=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n            <div style=\\\"margin-top:8px\\\"><button class=\\\"btn\\\" type=\\\"submit\\\">Send me the kit</button></div>\\n          </form>\\n        </div>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">VIP Day — what to expect</h4>\\n          <p class=\\\"muted\\\">A full-day focused session to map your 90-day rhythm, refine routines, and craft key micro-habits. Includes two follow-ups and the 90-day blueprint.</p>\\n          <div style=\\\"margin-top:12px;font-weight:800\\\">Investment: $950</div>\\n          <a class=\\\"btn\\\" href=\\\"book.html?plan=vipday\\\" style=\\\"display:inline-block;margin-top:12px\\\">Request VIP Day</a>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Need a gift card?</h4>\\n          <p class=\\\"muted\\\">Gift cards for sessions make meaningful presents — email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> to request one.</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Quick contact</h4>\\n          <div class=\\\"muted\\\">Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        </div>\\n\\n        <!-- pattern svg unique to book page (inline) -->\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px;padding:12px;text-align:center\\\">\\n          <svg class=\\\"svgb\\\" viewBox=\\\"0 0 200 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-label=\\\"decorative pattern\\\">\\n            <defs>\\n              <linearGradient id=\\\"p1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n                <stop offset=\\\"0\\\" stop-color=\\\"#e6fff8\\\"/>\\n                <stop offset=\\\"1\\\" stop-color=\\\"#c6f3e6\\\"/>\\n              </linearGradient>\\n            </defs>\\n            <rect width=\\\"200\\\" height=\\\"120\\\" rx=\\\"12\\\" fill=\\\"url(#p1)\\\"/>\\n            <g fill=\\\"#0b6b63\\\" opacity=\\\"0.08\\\">\\n              <circle cx=\\\"36\\\" cy=\\\"28\\\" r=\\\"6\\\"/>\\n              <circle cx=\\\"72\\\" cy=\\\"54\\\" r=\\\"8\\\"/>\\n              <rect x=\\\"120\\\" y=\\\"20\\\" width=\\\"18\\\" height=\\\"18\\\" rx=\\\"4\\\"/>\\n              <rect x=\\\"150\\\" y=\\\"70\\\" width=\\\"28\\\" height=\\\"10\\\" rx=\\\"4\\\"/>\\n            </g>\\n          </svg>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">Cancellation: Please provide 24 hours notice to reschedule. For full terms see <a href=\\\"terms.html\\\">terms</a>.</div>\\n      <div style=\\\"margin-top:8px;color:var(--muted)\\\">© {{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"contact.html\\\">Contact</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
