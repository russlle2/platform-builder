          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f7faf9;--card:#fff;--muted:#6b7280;--accent:#0f766e;--radius:12px;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial}\\n    body{margin:0;background:var(--bg);color:#0f172a}\\n    .wrap{max-width:1100px;margin:36px auto;padding:32px}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}\\n    nav a{color:var(--accent);margin-left:18px;text-decoration:none;font-weight:600}\\n    .grid{display:grid;grid-template-columns:1fr 340px;gap:28px}\\n    .hero{background:linear-gradient(180deg,#ffffff 0%,#f2fbfa 100%);padding:28px;border-radius:var(--radius);box-shadow:0 6px 20px rgba(15,118,110,0.06)}\\n    h1{margin:0 0 10px 0;font-size:28px}\\n    p.lead{margin:6px 0 18px;color:var(--muted)}\\n    .card{background:var(--card);padding:20px;border-radius:12px;box-shadow:0 8px 24px rgba(12,34,44,0.04)}\\n    .meta{display:flex;gap:14px;align-items:center}\\n    .avatar{width:68px;height:68px;border-radius:12px;overflow:hidden;flex:0 0 68px}\\n    .avatar svg{width:100%;height:100%;display:block}\\n    .kpis{display:flex;gap:12px;margin-top:16px}\\n    .kpi{background:#f8fffe;padding:10px;border-radius:10px;font-weight:700;color:var(--accent)}\\n    .section{margin-top:22px}\\n    ul.benefits{padding-left:18px;color:#0f172a}\\n    .process{display:flex;flex-direction:column;gap:12px}\\n    .step{padding:12px;border-radius:10px;background:#fff;border:1px solid #eef6f5}\\n    .leadmag{margin-top:18px;display:flex;gap:8px}\\n    input[type=email]{flex:1;padding:12px;border-radius:10px;border:1px solid #e6f0ef}\\n    button.cta{background:var(--accent);color:white;padding:12px 16px;border-radius:10px;border:none;font-weight:700}\\n    footer{margin-top:28px;color:var(--muted);font-size:13px;text-align:center}\\n    .social{display:flex;gap:8px;margin-top:12px}\\n    .faq dt{font-weight:700;margin-top:12px}\\n    .faq dd{margin:6px 0 14px 0;color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div><strong>{{BUSINESS_NAME}}</strong></div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"programs.html\\\">Work With Me</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"grid\\\">\\n      <main>\\n        <section class=\\\"hero card\\\">\\n          <div class=\\\"meta\\\">\\n            <div style=\\\"flex:1\\\">\\n              <h1>Meet {{COACH_NAME}} — Your Practical Wellness Guide</h1>\\n              <p class=\\\"lead\\\">A gentle, evidence-informed approach to build sustainable habits so you feel steadier, clearer, and more energized. No fads — just a repeatable framework that fits real life.</p>\\n              <div class=\\\"kpis\\\">\\n                <div class=\\\"kpi\\\">6-week frameworks</div>\\n                <div class=\\\"kpi\\\">Custom habit plans</div>\\n                <div class=\\\"kpi\\\">VIP single-day options</div>\\n              </div>\\n            </div>\\n            <div class=\\\"avatar card\\\">\\n              <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"{{COACH_NAME}}\\\" style=\\\"width:100%;height:100%\\\"/>\\n            </div>\\n          </div>\\n        </section>\\n\\n        <section class=\\\"section card\\\">\\n          <h2>Why this approach works</h2>\\n          <p class=\\\"lead\\\">I combine practical habit design, gentle accountability, and measurable goals. The aim: create small daily shifts that add up to meaningful change without overwhelm.</p>\\n\\n          <ul class=\\\"benefits\\\">\\n            <li><strong>Clarity over chaos.</strong> A simple morning and evening routine to anchor your day.</li>\\n            <li><strong>Small experiments.</strong> Try low-risk tweaks and keep what works.</li>\\n            <li><strong>Support to stick.</strong> Weekly check-ins and tools to remove friction.</li>\\n          </ul>\\n        </section>\\n\\n        <section class=\\\"section card\\\">\\n          <h2>My coaching framework</h2>\\n          <div class=\\\"process\\\">\\n            <div class=\\\"step\\\"><strong>1 — Assess</strong>: map your rhythms and identify friction points.</div>\\n            <div class=\\\"step\\\"><strong>2 — Design</strong>: build a tailored habit plan you can actually do.</div>\\n            <div class=\\\"step\\\"><strong>3 — Practice</strong>: short daily practices, immediate adjustments.</div>\\n            <div class=\\\"step\\\"><strong>4 — Embed</strong>: graduation plan and tools to maintain gains long-term.</div>\\n          </div>\\n        </section>\\n\\n        <section class=\\\"section card\\\">\\n          <h2>Praise from clients</h2>\\n          <p class=\\\"lead\\\">\\\"{{COACH_NAME}} helped me stop starting over and finally keep routines that stick.\\\" — A satisfied client</p>\\n          <div class=\\\"social\\\">\\n            <a href=\\\"testimonials.html\\\">Read more stories</a>\\n            <a href=\\\"book.html\\\">Book a discovery call</a>\\n          </div>\\n        </section>\\n\\n        <section class=\\\"section card\\\">\\n          <h2>FAQ — Quick answers</h2>\\n          <dl class=\\\"faq\\\">\\n            <dt>How long before I notice change?</dt>\\n            <dd>Most clients see shifts in energy and focus within 2–4 weeks when they consistently practice the plan.</dd>\\n            <dt>Do you offer virtual sessions?</dt>\\n            <dd>Yes — all work is remote-friendly, with recorded sessions and simple habit trackers.</dd>\\n          </dl>\\n        </section>\\n\\n        <section class=\\\"section card\\\">\\n          <h2>Get the starter kit</h2>\\n          <p class=\\\"lead\\\">Download a free 5-day habit starter designed to create momentum in one week.</p>\\n          <form class=\\\"leadmag\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\">\\n            <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Your best email\\\" aria-label=\\\"Email\\\" required>\\n            <button class=\\\"cta\\\" type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n          </form>\\n        </section>\\n\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3>Quick contact</h3>\\n          <p class=\\\"lead\\\">Schedule a short call to explore what will work for you.</p>\\n          <p style=\\\"margin:10px 0\\\"><strong>{{PHONE}}</strong><br><a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></p>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\" style=\\\"display:inline-block;text-decoration:none;margin-top:8px;padding:10px 14px\\\">Book a call</a>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h4>Credentials</h4>\\n          <p class=\\\"lead\\\">{{CREDENTIALS}}</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h4>Location</h4>\\n          <p class=\\\"lead\\\">Based in {{CITY}}, {{STATE}} • Remote worldwide</p>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer>\\n      © <span id=\\\"year\\\"></span> {{BUSINESS_NAME}} • <a href=\\\"privacy.html\\\">Privacy</a>\\n    </footer>\\n  </div>\\n  <script>document.getElementById('year').textContent=new Date().getFullYear();</script>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#ffffff;--muted:#5b6b73;--accent:#04605f;--card:#fbffff;--radius:14px;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto}\\n    body{margin:0;background:linear-gradient(180deg,#fbffff 0%,#f6faf9 100%);color:#022628}\\n    .container{max-width:1100px;margin:36px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:16px;color:var(--accent);text-decoration:none;font-weight:600}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:26px}\\n    .service{background:var(--card);padding:20px;border-radius:var(--radius);box-shadow:0 8px 24px rgba(3,36,34,0.04);min-height:180px}\\n    h1{font-size:26px;margin:0}\\n    p.lead{color:var(--muted)}\\n    .pill{display:inline-block;background:#e8f6f5;color:var(--accent);padding:6px 10px;border-radius:999px;font-weight:700;margin-top:10px}\\n    .benefits{margin-top:14px}\\n    .benefits li{margin:8px 0;color:#043536}\\n    .cta{margin-top:12px;background:var(--accent);color:white;border:none;padding:10px 14px;border-radius:10px;font-weight:700}\\n    .proof{margin-top:22px;padding:18px;border-radius:12px;background:#fff;border:1px solid #eff6f5}\\n    .leadmag{margin-top:18px;display:flex;gap:8px}\\n    input[type=email]{flex:1;padding:10px;border-radius:10px;border:1px solid #eaf3f2}\\n    footer{margin-top:28px;color:var(--muted);text-align:center}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div><strong>{{BUSINESS_NAME}}</strong></div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:18px\\\">\\n        <div>\\n          <h1>Structured support for lasting habits</h1>\\n          <p class=\\\"lead\\\">Clear services designed to meet you where you are—busy professionals, parents, and anyone ready to build sustainable routines.</p>\\n        </div>\\n        <div style=\\\"text-align:right\\\">\\n          <img src=\\\"assets/img/hero.svg\\\" alt=\\\"wellness\\\" style=\\\"width:180px;height:auto;\\\"/>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"grid\\\">\\n        <div class=\\\"service\\\">\\n          <div class=\\\"pill\\\">Short-term clarity</div>\\n          <h3>Discovery & Habit Map</h3>\\n          <p class=\\\"lead\\\">A focused assessment session plus a 2-week personalized habit map you can start tomorrow.</p>\\n          <ul class=\\\"benefits\\\">\\n            <li>60-minute deep-dive</li>\\n            <li>Personalized 14-day plan</li>\\n            <li>Follow-up note with next steps</li>\\n          </ul>\\n          <button class=\\\"cta\\\" onclick=\\\"location.href='book.html'\\\">Book Discovery</button>\\n        </div>\\n\\n        <div class=\\\"service\\\">\\n          <div class=\\\"pill\\\">Consistency & coaching</div>\\n          <h3>12-Week Momentum Package</h3>\\n          <p class=\\\"lead\\\">Weekly coaching, habit tracking, and small-step plans to anchor practices that last.</p>\\n          <ul class=\\\"benefits\\\">\\n            <li>Weekly 45-min sessions</li>\\n            <li>Accountability check-ins</li>\\n            <li>Tools to measure progress</li>\\n          </ul>\\n          <button class=\\\"cta\\\" onclick=\\\"location.href='programs.html'\\\">Explore Programs</button>\\n        </div>\\n\\n        <div class=\\\"service\\\">\\n          <div class=\\\"pill\\\">Fast reset</div>\\n          <h3>VIP Reset Day</h3>\\n          <p class=\\\"lead\\\">A single intensive day to clarify priorities, create a tactical plan, and leave with a ready-to-use routine.</p>\\n          <ul class=\\\"benefits\\\">\\n            <li>Pre-work and a full-day session</li>\\n            <li>Immediate plan & tools</li>\\n            <li>2-week support follow-up</li>\\n          </ul>\\n          <button class=\\\"cta\\\" onclick=\\\"location.href='book.html'\\\">Book VIP Day</button>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"proof card\\\" style=\\\"margin-top:22px\\\">\\n        <h3>How results show up</h3>\\n        <p class=\\\"lead\\\">Clients report clearer mornings, more predictable energy, and better sleep patterns through disciplined, small habit shifts.</p>\\n        <p style=\\\"margin-top:10px\\\"><strong>Real example:</strong> A prioritized 20-minute morning routine replaced scattered screen-checking and improved focus across the day.</p>\\n      </section>\\n\\n      <section style=\\\"margin-top:22px;display:flex;gap:20px;align-items:flex-start\\\">\\n        <div style=\\\"flex:1\\\" class=\\\"card\\\">\\n          <h3>Process — What to expect</h3>\\n          <ol style=\\\"padding-left:18px;color:#043536\\\">\\n            <li>Clarify the outcome you want.</li>\\n            <li>Design micro-habits to remove friction.</li>\\n            <li>Test, adjust, and scale the wins.</li>\\n          </ol>\\n        </div>\\n\\n        <div style=\\\"width:320px\\\" class=\\\"card\\\">\\n          <h3>Free starter guide</h3>\\n          <p class=\\\"lead\\\">Get the 5-day Momentum Guide — practical prompts and sample routines.</p>\\n          <form class=\\\"leadmag\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\">\\n            <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Email\\\" required>\\n            <button class=\\\"cta\\\" type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n          </form>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:22px\\\" class=\\\"card\\\">\\n        <h3>Questions people often ask</h3>\\n        <dl>\\n          <dt>Will this work if I have an unpredictable schedule?</dt>\\n          <dd class=\\\"lead\\\">Yes — plans are designed to be flexible. We focus on anchor habits that survive schedule changes.</dd>\\n          <dt>Do you provide written plans?</dt>\\n          <dd class=\\\"lead\\\">Every coaching plan includes a practical written roadmap and quick-check templates to keep you on track.</dd>\\n        </dl>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <p style=\\\"margin-top:26px\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"contact.html\\\">More ways to connect</a></p>\\n      <p style=\\\"color:var(--muted)\\\">© {{BUSINESS_NAME}} — {{CITY}}, {{STATE}}</p>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f3fbfa;--card:#ffffff;--accent:#0b6b63;--muted:#51676a;--radius:12px;font-family:Inter, system-ui, -apple-system, 'Segoe UI'}\\n    body{margin:0;background:var(--bg);color:#053233}\\n    .site{max-width:1080px;margin:36px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:14px;color:var(--accent);text-decoration:none;font-weight:600}\\n    .intro{display:flex;gap:20px;align-items:center;margin-top:18px}\\n    .cards{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:18px}\\n    .pkg{background:var(--card);padding:20px;border-radius:var(--radius);box-shadow:0 10px 30px rgba(6,60,56,0.05)}\\n    h1{margin:0}\\n    .price{font-weight:800;color:var(--accent);margin-top:8px}\\n    .features{margin-top:12px;color:#063a36}\\n    .cta{margin-top:14px;background:var(--accent);color:#fff;padding:10px 12px;border:none;border-radius:10px;font-weight:700}\\n    .faq{margin-top:20px;padding:18px;border-radius:12px;background:#fff;border:1px solid #e6f6f4}\\n    .leadmag{margin-top:18px;display:flex;gap:8px}\\n    input[type=email]{flex:1;padding:10px;border-radius:10px;border:1px solid #eaf3f2}\\n    footer{margin-top:22px;color:var(--muted);text-align:center}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <header>\\n      <div><strong>{{BUSINESS_NAME}}</strong></div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"intro\\\">\\n        <div style=\\\"flex:1\\\">\\n          <h1>Coaching tracks that meet you where you are</h1>\\n          <p class=\\\"lead\\\">Choose a focused path or a deeper tier. Each program centers on small, measurable habit changes and clear milestones.</p>\\n        </div>\\n        <div style=\\\"width:160px\\\">\\n          <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" style=\\\"width:100%\\\">\\n        </div>\\n      </section>\\n\\n      <section class=\\\"cards\\\">\\n        <div class=\\\"pkg\\\">\\n          <h3>Foundations Path</h3>\\n          <p class=\\\"price\\\">Complimentary + Add-on</p>\\n          <p class=\\\"lead\\\">A self-guided kit with optional one-off coaching to set the plan in motion.</p>\\n          <ul class=\\\"features\\\">\\n            <li>Starter workbook</li>\\n            <li>Sample 5-day routine</li>\\n            <li>Optional 60-min setup call</li>\\n          </ul>\\n          <button class=\\\"cta\\\" onclick=\\\"location.href='contact.html'\\\">Get the Starter Kit</button>\\n        </div>\\n\\n        <div class=\\\"pkg\\\">\\n          <h3>Momentum Package — 12 weeks</h3>\\n          <p class=\\\"price\\\">Investment: cohort & private options</p>\\n          <p class=\\\"lead\\\">An action-focused program with weekly coaching to build durable routines.</p>\\n          <ul class=\\\"features\\\">\\n            <li>Weekly 45-min sessions</li>\\n            <li>Progress dashboard</li>\\n            <li>Accountability checkpoints</li>\\n          </ul>\\n          <button class=\\\"cta\\\" onclick=\\\"location.href='pricing.html'\\\">See Pricing</button>\\n        </div>\\n\\n        <div class=\\\"pkg\\\">\\n          <h3>VIP Reset Day</h3>\\n          <p class=\\\"price\\\">Premium flat fee</p>\\n          <p class=\\\"lead\\\">One intensive day of strategy, habit-build, and an immediate custom routine to implement the next morning.</p>\\n          <ul class=\\\"features\\\">\\n            <li>Pre-work + full-day session</li>\\n            <li>Ready-to-use morning & evening plan</li>\\n            <li>10 days of follow-up support</li>\\n          </ul>\\n          <button class=\\\"cta\\\" onclick=\\\"location.href='book.html'\\\">Reserve VIP Day</button>\\n        </div>\\n\\n        <div class=\\\"pkg\\\">\\n          <h3>Accountability Partner — Monthly</h3>\\n          <p class=\\\"price\\\">Subscription model</p>\\n          <p class=\\\"lead\\\">Short weekly check-ins and micro-adjustments to keep your wins rolling.</p>\\n          <ul class=\\\"features\\\">\\n            <li>Two 25-min check-ins/month</li>\\n            <li>Quick wins and habit micro-adjustments</li>\\n            <li>Flexible pause/cancel</li>\\n          </ul>\\n          <button class=\\\"cta\\\" onclick=\\\"location.href='pricing.html'\\\">View Plans</button>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"faq\\\">\\n        <h3>Program questions</h3>\\n        <dl>\\n          <dt>How do I choose the right program?</dt>\\n          <dd class=\\\"lead\\\">Start with the outcome you want. If you need a fast reset, the VIP Day fits. If you want sustained change, pick the Momentum Package.</dd>\\n\\n          <dt>Are there payment plans?</dt>\\n          <dd class=\\\"lead\\\">Yes — we offer installment options for longer programs. See the pricing page for details.</dd>\\n\\n          <dt>What if my schedule is irregular?</dt>\\n          <dd class=\\\"lead\\\">We design anchor habits and flexible check-ins so routines survive varying days.</dd>\\n        </dl>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px;padding:18px;border-radius:12px;background:#fff;border:1px solid #e9f6f4\\\">\\n        <h3>Lead magnet — Quick win</h3>\\n        <p class=\\\"lead\\\">Sign up to get the 5-day Momentum Guide and sample micro-habits you can try this week.</p>\\n        <form class=\\\"leadmag\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\">\\n          <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Enter email\\\" required>\\n          <button class=\\\"cta\\\" type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n        </form>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px;text-align:center\\\">\\n        <p style=\\\"margin:6px 0\\\">Ready to begin? <a href=\\\"book.html\\\" style=\\\"color:var(--accent);font-weight:700\\\">Schedule a discovery call</a> to choose the right path.</p>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <p style=\\\"color:var(--muted)\\\">Questions: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{BUSINESS_NAME}} — {{CITY}}, {{STATE}}</p>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
