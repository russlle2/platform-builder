          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} — Investment</title>\\n  <style>\\n    :root{--bg:#f6fbfb;--card:#ffffff;--muted:#6b7280;--accent:#1f7a73;--accent-2:#c6efe9;--glass:rgba(255,255,255,0.7);--radius:12px}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial;color:#072023;background:var(--bg);}\\n    .container{max-width:1100px;margin:36px auto;padding:28px;}\\n    nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}\\n    .brand{font-weight:700;color:var(--accent)}\\n    .navlinks{display:flex;gap:14px}\\n    a{color:inherit;text-decoration:none}\\n    header.hero{background:linear-gradient(180deg,var(--accent-2),transparent);border-radius:var(--radius);padding:28px;display:grid;grid-template-columns:1fr 320px;gap:20px;align-items:center}\\n    header.hero h1{margin:0;font-size:26px}\\n    header.hero p{color:var(--muted);margin:8px 0 0}\\n    .summary{background:var(--card);padding:18px;border-radius:10px;box-shadow:0 6px 18px rgba(7,32,35,0.06)}\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:20px}\\n    .tier{background:var(--card);padding:18px;border-radius:12px;border:1px solid rgba(7,32,35,0.04)}\\n    .popular{border:2px solid var(--accent);transform:translateY(-6px);box-shadow:0 10px 30px rgba(31,122,115,0.06)}\\n    .price{font-size:20px;font-weight:700;color:var(--accent)}\\n    ul.benefits{padding-left:18px;color:var(--muted);margin:12px 0}\\n    .cta-row{display:flex;gap:10px;margin-top:12px}\\n    .btn{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    .ghost{background:transparent;border:1px solid rgba(7,32,35,0.06);padding:10px 12px;border-radius:10px}\\n    section{margin-top:22px}\\n    .faq{display:grid;grid-template-columns:1fr 1fr;gap:12px}\\n    .faq-item{background:var(--card);padding:14px;border-radius:10px}\\n    footer{margin-top:28px;color:var(--muted);font-size:13px}\\n    @media(max-width:880px){header.hero{grid-template-columns:1fr;padding:18px} .tiers{grid-template-columns:1fr;}}\\n  </style>\\n</head>\\n<body>\\n  <div class='container'>\\n    <nav>\\n      <div class='brand'>{{BUSINESS_NAME}}</div>\\n      <div class='navlinks'>\\n        <a href='index.html'>Home</a>\\n        <a href='programs.html'>Work With Me</a>\\n        <a href='services.html'>Services</a>\\n        <a href='book.html'>Book</a>\\n        <a href='contact.html'>Contact</a>\\n      </div>\\n    </nav>\\n\\n    <header id='hero' class='hero'>\\n      <div>\\n        <h1>Choose an investment that supports sustained change — not quick fixes</h1>\\n        <p>{{TAGLINE}} with a clear, science-informed ritual approach designed for real life. Options for individuals and small cohorts.</p>\\n        <div class='cta-row'>\\n          <a class='btn' href='book.html'>{{PRIMARY_CTA_LABEL}}</a>\\n          <a class='ghost' href='#pricing'>See tiers</a>\\n        </div>\\n      </div>\\n      <aside class='summary'>\\n        <strong>{{COACH_NAME}}, {{CREDENTIALS}}</strong>\\n        <p style='margin:8px 0;color:var(--muted)'>I guide clients through diagnostic tools, personalized plans, and micro-habits that compound weekly. Start with a clarity call.</p>\\n        <div style='margin-top:12px;color:var(--muted);font-size:14px'>Contact: <a href='tel:{{PHONE}}'>{{PHONE}}</a> • <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a></div>\\n      </aside>\\n    </header>\\n\\n    <section id='pricing'>\\n      <h2 style='margin:0 0 8px'>Investment tiers</h2>\\n      <p style='color:var(--muted);margin:0 0 16px'>Transparent pricing tailored to outcomes — weekly accountability, shared cohort learning, and an immersive reset option.</p>\\n\\n      <div class='tiers'>\\n        <div class='tier'>\\n          <div style='display:flex;justify-content:space-between;align-items:center'>\\n            <div>\\n              <div style='font-weight:700'>Foundation Flow</div>\\n              <div style='color:var(--muted);font-size:13px'>Self-paced starter with coaching check-ins</div>\\n            </div>\\n            <div class='price'>$199/mo</div>\\n          </div>\\n          <ul class='benefits'>\\n            <li>4 weekly lessons + habit prompts</li>\\n            <li>Monthly group Q&A</li>\\n            <li>Access to guided library</li>\\n          </ul>\\n          <div class='cta-row'>\\n            <a class='btn' href='book.html'>Enroll</a>\\n            <a class='ghost' href='#diagnostic'>Take the diagnostic</a>\\n          </div>\\n        </div>\\n\\n        <div class='tier popular'>\\n          <div style='display:flex;justify-content:space-between;align-items:center'>\\n            <div>\\n              <div style='font-weight:700'>Momentum Cohort</div>\\n              <div style='color:var(--muted);font-size:13px'>12-week guided program with small cohort support</div>\\n            </div>\\n            <div class='price'>$949 one-time</div>\\n          </div>\\n          <ul class='benefits'>\\n            <li>Weekly live sessions + guided practices</li>\\n            <li>Personalized plan & micro-habit prescription</li>\\n            <li>Paced accountability & community</li>\\n          </ul>\\n          <div class='cta-row'>\\n            <a class='btn' href='book.html'>Reserve spot</a>\\n            <a class='ghost' href='#plan'>See plan</a>\\n          </div>\\n        </div>\\n\\n        <div class='tier'>\\n          <div style='display:flex;justify-content:space-between;align-items:center'>\\n            <div>\\n              <div style='font-weight:700'>Alchemy Intensive</div>\\n              <div style='color:var(--muted);font-size:13px'>A concentrated private pathway for deep change</div>\\n            </div>\\n            <div class='price'>From $2,400</div>\\n          </div>\\n          <ul class='benefits'>\\n            <li>Private coaching + intake review</li>\\n            <li>Custom ritual map & follow-ups</li>\\n            <li>Flexible scheduling</li>\\n          </ul>\\n          <div class='cta-row'>\\n            <a class='btn' href='contact.html'>Apply</a>\\n            <a class='ghost' href='#micro-habits'>Sample micro-habits</a>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id='plan'>\\n      <h3 style='margin-bottom:8px'>How a cohort unfolds</h3>\\n      <p style='color:var(--muted)'>Each cohort follows a pattern of assessment, personalized planning, small weekly practices, and reflection — built so small wins stack.</p>\\n      <div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px'>\\n        <div class='tier'><strong>Week 1</strong><p style='color:var(--muted)'>Clarity + diagnostic</p></div>\\n        <div class='tier'><strong>Weeks 2–10</strong><p style='color:var(--muted)'>Habits + coaching</p></div>\\n        <div class='tier'><strong>Week 11–12</strong><p style='color:var(--muted)'>Integration + next steps</p></div>\\n      </div>\\n    </section>\\n\\n    <section id='micro-habits'>\\n      <h3>Micro-habits that compound</h3>\\n      <p style='color:var(--muted)'>Small, repeatable actions that require little energy but shift momentum. Examples included with every plan.</p>\\n      <ul class='benefits'>\\n        <li>1-minute morning alignment ritual</li>\\n        <li>Evening check-in (5 minutes)</li>\\n        <li>Weekly reflection prompt</li>\\n      </ul>\\n    </section>\\n\\n    <section id='faq'>\\n      <h3>Common questions</h3>\\n      <div class='faq'>\\n        <div class='faq-item'>\\n          <strong>How do cohorts differ from private coaching?</strong>\\n          <p style='color:var(--muted)'>Cohorts emphasize shared learning and rhythm; private coaching is fully individualized and flexible.</p>\\n        </div>\\n        <div class='faq-item'>\\n          <strong>What if I need to pause the program?</strong>\\n          <p style='color:var(--muted)'>We design checkpoints and can offer a pause with a short reintegration session to keep momentum gentle.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id='cta'>\\n      <div style='display:flex;justify-content:space-between;align-items:center;margin-top:18px;padding:16px;border-radius:12px;background:linear-gradient(90deg,rgba(198,239,233,0.6),transparent)}'>\\n        <div>\\n          <strong style='display:block'>Ready to commit to sustainable rituals?</strong>\\n          <div style='color:var(--muted)'>Book a clarity call to pick the right tier for your life.</div>\\n        </div>\\n        <div style='display:flex;gap:10px'>\\n          <a class='btn' href='book.html'>{{PRIMARY_CTA_LABEL}}</a>\\n          <a class='ghost' href='contact.html'>Ask a question</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Stories — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#ffffff;--muted:#5b6967;--accent:#12544f;--card:#fbffff}\\n    body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;color:#042a29;background:var(--bg);margin:0}\\n    .wrap{max-width:980px;margin:34px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .brand{font-weight:700;color:var(--accent)}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .lead{background:linear-gradient(180deg,rgba(18,84,79,0.06),transparent);padding:18px;border-radius:10px;margin-top:16px}\\n    .testi-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:16px}\\n    .card{background:var(--card);padding:16px;border-radius:12px;border:1px solid rgba(6,30,28,0.04)}\\n    .quote{font-size:15px;margin:8px 0;color:#093230}\\n    .meta{display:flex;align-items:center;gap:10px;color:var(--muted);font-size:13px}\\n    .avatar{width:44px;height:44px;border-radius:8px;background:#e6f7f5;display:flex;align-items:center;justify-content:center}\\n    .cta{display:flex;justify-content:space-between;align-items:center;margin-top:18px}\\n    .btn{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    footer{margin-top:22px;color:var(--muted);font-size:13px}\\n    @media(max-width:820px){.testi-grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class='wrap'>\\n    <header>\\n      <div class='brand'>{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href='index.html'>Home</a>\\n        <a href='programs.html'>Paths</a>\\n        <a href='pricing.html'>Investments</a>\\n        <a href='book.html'>Book</a>\\n      </nav>\\n    </header>\\n\\n    <section id='hero' class='lead'>\\n      <h1 style='margin:0'>Real people, real steps — outcomes that last</h1>\\n      <p style='margin:8px 0 0;color:var(--muted)'>Short quotes and measurable shifts: reflections from people who committed to tiny practices and saw ripple effects in months.</p>\\n    </section>\\n\\n    <section id='social-proof' class='testi-grid'>\\n      <div class='card'>\\n        <div class='meta'><div class='avatar'><img src='assets/img/avatar.svg' alt='avatar' style='width:36px;height:36px'></div><div><strong>R.S., Brooklyn</strong><div style='color:var(--muted)'>Joined a cohort</div></div></div>\\n        <p class='quote'>\\\"I used to feel stuck on weekends. The micro-habit rhythm shifted my energy — small rituals, big relief.\\\"</p>\\n        <div style='color:var(--muted);font-size:13px'>Lost the weekend anxiety loop; gained a sustainable reset practice.</div>\\n      </div>\\n\\n      <div class='card'>\\n        <div class='meta'><div class='avatar'><img src='assets/img/avatar.svg' alt='avatar' style='width:36px;height:36px'></div><div><strong>M.T., {{CITY}}</strong><div style='color:var(--muted)'>Private coaching</div></div></div>\\n        <p class='quote'>\\\"The diagnostic revealed simple friction points; the plan was compassionate and clear.\\\"</p>\\n        <div style='color:var(--muted);font-size:13px'>Clearer sleep cues and a 5-minute evening ritual improved daily focus.</div>\\n      </div>\\n\\n      <div class='card'>\\n        <div class='meta'><div class='avatar'><img src='assets/img/avatar.svg' alt='avatar' style='width:36px;height:36px'></div><div><strong>A.E., Remote</strong><div style='color:var(--muted)'>Cohort alumni</div></div></div>\\n        <p class='quote'>\\\"Learning alongside others mattered — we held each other accountable with kindness.\\\"</p>\\n        <div style='color:var(--muted);font-size:13px'>Sustained momentum through accountability circles; reduced decision fatigue.</div>\\n      </div>\\n\\n      <div class='card'>\\n        <div class='meta'><div class='avatar'><img src='assets/img/avatar.svg' alt='avatar' style='width:36px;height:36px'></div><div><strong>S.K., {{STATE}}</strong><div style='color:var(--muted)'>Intensive participant</div></div></div>\\n        <p class='quote'>\\\"The retreat-like intensive helped me reprioritize in a week what I'd struggled with for years.\\\"</p>\\n        <div style='color:var(--muted);font-size:13px'>Reset momentum and a concise plan for follow-through.</div>\\n      </div>\\n    </section>\\n\\n    <section id='diagnostic' style='margin-top:18px'>\\n      <h3 style='margin-bottom:6px'>How testimonials connect to the process</h3>\\n      <p style='color:var(--muted)'>Each story references three consistent elements: an initial diagnostic, a clear stepwise plan, and small daily habits that compound. You can experience the same framework in a cohort or private path.</p>\\n      <div style='display:flex;gap:10px;margin-top:10px'>\\n        <a class='btn' href='programs.html'>Explore paths</a>\\n        <a class='btn' href='pricing.html' style='background:#0b5b55'>See investments</a>\\n      </div>\\n    </section>\\n\\n    <section id='cta' style='margin-top:18px;padding:14px;border-radius:10px;background:#f3fbfa;display:flex;justify-content:space-between;align-items:center'>\\n      <div>\\n        <strong>Want to be featured?</strong>\\n        <div style='color:var(--muted)'>Share your experience and help others choose a path that fits.</div>\\n      </div>\\n      <div>\\n        <a class='btn' href='book.html'>Share your story</a>\\n      </div>\\n    </section>\\n\\n    <footer style='margin-top:20px;color:var(--muted)'>\\n      <div>{{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}} • <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Book a Clarity Call — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f8fdfc;--card:#ffffff;--accent:#166a63;--muted:#5a6a67}\\n    body{margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial;background:var(--bg);color:#052423}\\n    .wrap{max-width:860px;margin:28px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .brand{font-weight:700;color:var(--accent)}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:18px;margin-top:16px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;border:1px solid rgba(7,32,35,0.04)}\\n    form label{display:block;margin-top:10px;font-size:13px;color:var(--muted)}\\n    input,textarea,select{width:100%;padding:10px;border-radius:8px;border:1px solid #e6efec;margin-top:6px}\\n    .btn{background:var(--accent);color:#fff;padding:11px 14px;border-radius:10px;border:none;cursor:pointer;margin-top:12px}\\n    .aside .avatar{width:100%;height:180px;border-radius:10px;background:linear-gradient(180deg,rgba(22,106,99,0.08),transparent);display:flex;align-items:center;justify-content:center}\\n    .plan-list{margin-top:12px}\\n    .micro{background:#f2fbfa;padding:10px;border-radius:8px;margin-top:10px}\\n    footer{margin-top:18px;color:var(--muted);font-size:13px}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class='wrap'>\\n    <header>\\n      <div class='brand'>{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href='index.html'>Home</a>\\n        <a href='programs.html'>Work With Me</a>\\n        <a href='pricing.html'>Pricing</a>\\n      </nav>\\n    </header>\\n\\n    <main class='grid'>\\n      <section id='hero' class='card'>\\n        <h1 style='margin:0'>Book a clarity call</h1>\\n        <p style='color:var(--muted);margin-top:6px'>A 30-minute conversation to map priorities, run the diagnostic, and choose the right next step — cohort or private path.</p>\\n\\n        <form id='booking' action='thank-you.html' method='post' style='margin-top:12px'>\\n          <label for='name'>Your name</label>\\n          <input id='name' name='name' placeholder='Your full name' required>\\n\\n          <label for='email'>Email</label>\\n          <input id='email' name='email' type='email' placeholder='you@example.com' required>\\n\\n          <label for='phone'>Phone</label>\\n          <input id='phone' name='phone' placeholder='Optional'>\\n\\n          <label for='goal'>Primary goal</label>\\n          <select id='goal' name='goal'>\\n            <option>Improve daily energy</option>\\n            <option>Reduce overwhelm</option>\\n            <option>Build a sustainable routine</option>\\n            <option>Other</option>\\n          </select>\\n\\n          <label for='notes'>Brief context (what's felt hard?)</label>\\n          <textarea id='notes' name='notes' rows='4' placeholder='A few lines helps us prepare'></textarea>\\n\\n          <div style='display:flex;gap:10px;align-items:center'>\\n            <button class='btn' type='submit'>{{PRIMARY_CTA_LABEL}}</button>\\n            <a href='contact.html' style='color:var(--muted);text-decoration:none'>Ask a question</a>\\n          </div>\\n        </form>\\n\\n        <section id='diagnostic' style='margin-top:16px'>\\n          <h3 style='margin:0 0 6px'>What we assess</h3>\\n          <p style='color:var(--muted);margin:0 0 8px'>The diagnostic evaluates rhythm, energy drains, decision load, and existing supports — not medical conditions.</p>\\n        </section>\\n\\n        <section id='plan' style='margin-top:12px'>\\n          <h3 style='margin:0 0 6px'>Your clarity call includes</h3>\\n          <ul style='color:var(--muted);margin:0;padding-left:18px'>\\n            <li>20-minute guided intake</li>\\n            <li>7-point diagnostic review</li>\\n            <li>Practical next-step plan & micro-habit starter</li>\\n          </ul>\\n        </section>\\n      </section>\\n\\n      <aside class='aside'>\\n        <div class='card'>\\n          <div class='avatar'><img src='assets/img/hero.svg' alt='hero' style='width:160px;height:120px'></div>\\n          <h4 style='margin-top:12px'>Before the call</h4>\\n          <p style='color:var(--muted);margin:6px 0 0'>Complete the short intake that arrives after booking to get the most from our time.</p>\\n          <div class='plan-list'>\\n            <strong>Starter micro-habits</strong>\\n            <div class='micro'>Morning centering — 60s</div>\\n            <div class='micro'>2-minute midday check-in</div>\\n            <div class='micro'>Weekly reflection prompt</div>\\n          </div>\\n        </div>\\n\\n        <div class='card' style='margin-top:12px'>\\n          <h4 style='margin:0'>What to expect</h4>\\n          <p style='color:var(--muted);margin-top:8px'>A practical conversation rooted in routines, not willpower. You leave with 1–3 actions to try immediately.</p>\\n          <div style='margin-top:10px'><a class='btn' href='pricing.html'>See investments</a></div>\\n        </div>\\n\\n        <div class='card' style='margin-top:12px'>\\n          <h4 style='margin:0'>Contact</h4>\\n          <p style='color:var(--muted);margin-top:8px'>Questions? Email <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a> or call <a href='tel:{{PHONE}}'>{{PHONE}}</a></p>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <section id='micro-habits' class='card' style='max-width:860px;margin:18px auto;padding:16px'>\\n      <h3 style='margin:0 0 6px'>Tiny habits to start today</h3>\\n      <p style='color:var(--muted);margin:0 0 8px'>These are examples you'll get as a starter after your clarity call.</p>\\n      <div style='display:flex;gap:10px;flex-wrap:wrap'>\\n        <div style='background:#eef9f7;padding:8px;border-radius:8px'>1-min morning anchor</div>\\n        <div style='background:#eef9f7;padding:8px;border-radius:8px'>2-min gratitude jot</div>\\n        <div style='background:#eef9f7;padding:8px;border-radius:8px'>Weekly 'done' list</div>\\n      </div>\\n    </section>\\n\\n    <section id='cta' style='max-width:860px;margin:12px auto;display:flex;justify-content:space-between;align-items:center'>\\n      <div style='color:var(--muted)'>Prefer a different time zone or accessibility need? Let us know and we'll accommodate.</div>\\n      <a class='btn' href='contact.html'>Contact support</a>\\n    </section>\\n\\n    <footer>\\n      <div style='text-align:center;color:var(--muted);margin-top:18px'>© {{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
