          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Investment & Tiers</title>\\n  <meta name=\\\"description\\\" content=\\\"Programs and tiered support from {{COACH_NAME}} — sustainable habits, clear frameworks, compassionate coaching.\\\" />\\n  <style>\\n    :root{--bg:#0f0f10;--card:#111214;--muted:#9aa0a6;--accent:#e8d7b7;--glass:rgba(255,255,255,0.04);--radius:14px;--max:1080px}\\n    *{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:#fff;background:linear-gradient(180deg,#070708 0%,#0b0b0c 60%);-webkit-font-smoothing:antialiased}\\n    header{max-width:var(--max);margin:28px auto 40px;padding:0 24px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .brand img{width:68px;height:68px;border-radius:10px;object-fit:cover;background:var(--glass);padding:8px}\\n    .brand h1{font-size:18px;margin:0;color:var(--accent)}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:20px;font-size:14px}\\n    .hero{max-width:var(--max);margin:0 auto;background:transparent;padding:30px 24px 40px;display:grid;grid-template-columns:1fr 420px;gap:32px;align-items:center}\\n    .hero .lead{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:28px;border-radius:16px}\\n    .lead h2{margin:0 0 12px;font-family:serif;font-size:28px;color:#fff}\\n    .lead p{color:var(--muted);margin:0 0 18px;line-height:1.5}\\n    .cta-row{display:flex;gap:12px}\\n    .btn{background:var(--accent);color:#000;padding:12px 16px;border-radius:10px;font-weight:600;text-decoration:none}\\n    .ghost{border:1px solid rgba(255,255,255,0.06);padding:12px 16px;border-radius:10px;color:var(--muted);text-decoration:none}\\n    .gallery-card{background:var(--card);border-radius:16px;padding:18px;display:flex;flex-direction:column;gap:12px}\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:28px 24px;max-width:var(--max)}\\n    .tier{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:20px;border-radius:14px}\\n    .tier h3{margin:0 0 6px;color:var(--accent)}\\n    .price{font-size:22px;font-weight:700;margin:6px 0;color:#fff}\\n    .features{color:var(--muted);font-size:14px;line-height:1.5}\\n    .note{font-size:13px;color:var(--muted);margin-top:10px}\\n    .faq{max-width:var(--max);margin:26px auto;padding:0 24px;color:var(--muted)}\\n    footer{margin:40px auto 80px;max-width:var(--max);padding:0 24px;display:flex;justify-content:space-between;align-items:center;color:var(--muted)}\\n    .small{font-size:13px}\\n    @media(max-width:920px){.hero{grid-template-columns:1fr;padding:20px}.tiers{grid-template-columns:1fr}.brand img{width:56px;height:56px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\" />\\n      <div>\\n        <h1>{{BUSINESS_NAME}}</h1>\\n        <div class=\\\"small\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Pathways</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"pricing.html\\\" aria-current=\\\"page\\\">Rates</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"lead\\\">\\n        <h2>Investment designed for lasting change — choose a sustainable path</h2>\\n        <p>Each tier is a container for steady, practical habit shifts and reflective frameworks. No quick fixes — just tools you can use for life. Transparent pricing, clear outcomes.</p>\\n        <div class=\\\"cta-row\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a class=\\\"ghost\\\" href=\\\"contact.html\\\">Ask a question</a>\\n        </div>\\n        <div class=\\\"note\\\">Speaking sessions are confidential. I use coaching frameworks to support behavior change; not medical advice.</div>\\n      </div>\\n\\n      <div class=\\\"gallery-card\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"abstract gallery\\\" style=\\\"width:100%;border-radius:10px;display:block\\\" />\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div style=\\\"color:var(--muted);font-size:13px\\\">Next cohort start date: rolling</div>\\n          <div style=\\\"color:var(--muted);font-size:13px\\\">Timezone: {{CITY}}, {{STATE}}</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"tiers\\\" aria-label=\\\"pricing tiers\\\">\\n      <div class=\\\"tier\\\">\\n        <h3>Seed — Foundations</h3>\\n        <div class=\\\"price\\\">$297 / 6 weeks</div>\\n        <div class=\\\"features\\\">\\n          - Welcome workbook & 3 micro-habits\\n          <br>- Two 45-minute strategy sessions\\n          <br>- Weekly email check-ins\\n        </div>\\n        <div class=\\\"note\\\">A short container to learn the framework and start momentum.</div>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <h3>Root — Growth Cohort</h3>\\n        <div class=\\\"price\\\">$899 / cohort</div>\\n        <div class=\\\"features\\\">\\n          - 8-week cohort with group calls\\n          <br>- Habit scaffolding & accountability\\n          <br>- Lifetime access to guided practices\\n        </div>\\n        <div class=\\\"note\\\">Group energy for sustainable behavior change; best for steady progress.</div>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <h3>Bloom — One-to-One Path</h3>\\n        <div class=\\\"price\\\">$2,400 / 3 months</div>\\n        <div class=\\\"features\\\">\\n          - Weekly 1:1 coaching\\n          <br>- Personalized habit architecture\\n          <br>- Priority booking + resource curation\\n        </div>\\n        <div class=\\\"note\\\">Deep, personalized support that adapts to your life and work rhythms.</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h4 style=\\\"color:var(--accent);margin:0 0 12px;font-size:16px\\\">Practical questions</h4>\\n      <details style=\\\"background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;margin-bottom:8px\\\">\\n        <summary style=\\\"cursor:pointer;color:#fff\\\">How flexible are the session times?</summary>\\n        <div style=\\\"padding-top:8px;color:var(--muted)\\\">I offer morning and evening slots across multiple weekdays. Timezone noted in the booking calendar.</div>\\n      </details>\\n      <details style=\\\"background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;margin-bottom:8px\\\">\\n        <summary style=\\\"cursor:pointer;color:#fff\\\">Is there a refund or transfer policy?</summary>\\n        <div style=\\\"padding-top:8px;color:var(--muted)\\\">We prioritize fit. Transfers are possible up to 14 days before the start of a cohort; 30-day partial credit for one-to-one packages if unused.</div>\\n      </details>\\n      <details style=\\\"background:rgba(255,255,255,0.02);padding:12px;border-radius:10px\\\">\\n        <summary style=\\\"cursor:pointer;color:#fff\\\">Can I switch tiers later?</summary>\\n        <div style=\\\"padding-top:8px;color:var(--muted)\\\">Yes — you can upgrade at any point. We'll prorate the difference and align the plan to your current needs.</div>\\n      </details>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>\\n      <div style=\\\"font-weight:600\\\">Ready to begin?</div>\\n      <div class=\\\"small\\\">Book a free 15-minute clarity call to see fit.</div>\\n    </div>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve a call</a>\\n      <div class=\\\"small\\\">Contact: <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a></div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Stories & Results — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Real clients share what shifted: clarity, rhythm, and small habits that stuck. Testimonials for {{COACH_NAME}}.\\\" />\\n  <style>\\n    :root{--bg:#fff;--ink:#111;--muted:#6b6f75;--accent:#5a3d2e;--panel:#fbfaf8;--radius:12px;--max:1040px}\\n    body{margin:0;font-family:Georgia,serif;background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased}\\n    header{max-width:var(--max);margin:28px auto;padding:0 20px;display:flex;justify-content:space-between;align-items:center}\\n    .logo{display:flex;align-items:center;gap:14px}\\n    .logo img{width:64px;height:64px;border-radius:10px}\\n    nav a{margin-left:18px;text-decoration:none;color:var(--muted)}\\n    .showcase{max-width:var(--max);margin:10px auto;padding:22px 20px 40px;display:grid;grid-template-columns:460px 1fr;gap:28px}\\n    .profile{background:var(--panel);padding:22px;border-radius:16px}\\n    .profile h2{margin:0 0 6px;color:var(--accent);font-family:serif}\\n    .quote-list{display:grid;gap:16px}\\n    .quote{background:white;border-radius:12px;padding:18px;box-shadow:0 8px 30px rgba(46,46,50,0.06)}\\n    .quote p{margin:0;color:var(--muted);line-height:1.6}\\n    .meta{font-size:13px;color:var(--muted);margin-top:8px}\\n    .banner{display:flex;gap:14px;align-items:center}\\n    footer{max-width:var(--max);margin:40px auto;padding:0 20px;display:flex;justify-content:space-between;align-items:center;color:var(--muted)}\\n    @media(max-width:900px){.showcase{grid-template-columns:1fr;padding:16px}.logo img{width:56px;height:56px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">\\n      <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\" />\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Nest</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"services.html\\\">Sessions</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"showcase\\\">\\n      <aside class=\\\"profile\\\">\\n        <h2>What shifts for people who commit</h2>\\n        <div style=\\\"color:var(--muted);margin-bottom:12px\\\">Clients often speak about rhythm, clarity, and kinder self-talk — outcomes born from small, repeatable practices.</div>\\n        <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n          <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" style=\\\"width:72px;height:72px;border-radius:8px;object-fit:cover;\\\" />\\n          <div>\\n            <div style=\\\"font-weight:700\\\">{{COACH_NAME}}, {{CREDENTIALS}}</div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Coach • Facilitator • Guide</div>\\n          </div>\\n        </div>\\n        <div style=\\\"margin-top:14px\\\">\\n          <a href=\\\"book.html\\\" style=\\\"background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none\\\">Start a conversation</a>\\n        </div>\\n      </aside>\\n\\n      <div>\\n        <div class=\\\"quote-list\\\">\\n          <article class=\\\"quote\\\">\\n            <p>\\\"I moved from constant willpower to gentle structure. The micro-habits made big months feel smaller and manageable.\\\"</p>\\n            <div class=\\\"meta\\\">— A., Product Lead — completed the Root cohort</div>\\n          </article>\\n\\n          <article class=\\\"quote\\\">\\n            <p>\\\"Working with {{COACH_NAME}} I learned how to design my day instead of reacting to it. My energy and focus improved without 'doing more.'\\\"</p>\\n            <div class=\\\"meta\\\">— S., Nurse — 1:1 Bloom client</div>\\n          </article>\\n\\n          <article class=\\\"quote\\\">\\n            <p>\\\"The diagnostic helped me see where my habits were leaking. Small experiments, clear tracking — and I could feel the nervousness ease.\\\"</p>\\n            <div class=\\\"meta\\\">— R., Entrepreneur — Seed program</div>\\n          </article>\\n        </div>\\n\\n        <div style=\\\"margin-top:22px;display:flex;gap:12px;align-items:center\\\">\\n          <a href=\\\"pricing.html\\\" style=\\\"padding:10px 14px;border-radius:10px;background:#fff;color:var(--ink);text-decoration:none\\\">View investment</a>\\n          <a href=\\\"book.html\\\" style=\\\"padding:10px 14px;border-radius:10px;border:1px solid rgba(17,17,17,0.06);text-decoration:none;color:var(--muted)\\\">Book a clarity call</a>\\n        </div>\\n\\n        <section style=\\\"margin-top:26px;background:linear-gradient(180deg,#fff,#fbfbfb);padding:16px;border-radius:12px\\\">\\n          <h4 style=\\\"margin:0 0 8px;color:var(--accent)\\\">Voices from the cohort</h4>\\n          <div style=\\\"display:flex;gap:12px;flex-wrap:wrap\\\">\\n            <div style=\\\"background:white;padding:12px;border-radius:10px;box-shadow:0 6px 20px rgba(20,20,20,0.04);min-width:220px\\\">\\\"I stopped starting over.\\\"<div style=\\\"font-size:12px;color:var(--muted)\\\">— M.</div></div>\\n            <div style=\\\"background:white;padding:12px;border-radius:10px;box-shadow:0 6px 20px rgba(20,20,20,0.04);min-width:220px\\\">\\\"Small wins, steady results.\\\"<div style=\\\"font-size:12px;color:var(--muted)\\\">— L.</div></div>\\n            <div style=\\\"background:white;padding:12px;border-radius:10px;box-shadow:0 6px 20px rgba(20,20,20,0.04);min-width:220px\\\">\\\"The practices fit my life.\\\"<div style=\\\"font-size:12px;color:var(--muted)\\\">— H.</div></div>\\n          </div>\\n        </section>\\n\\n      </div>\\n    </section>\\n\\n    <section style=\\\"max-width:var(--max);margin:18px auto;padding:0 20px;color:var(--muted)\\\">\\n      <h4 style=\\\"color:var(--accent);margin:0 0 10px\\\">Frequently asked</h4>\\n      <details style=\\\"padding:12px;border-radius:10px;background:var(--panel);margin-bottom:8px\\\">\\n        <summary style=\\\"cursor:pointer\\\">Do testimonials reflect typical results?</summary>\\n        <div style=\\\"padding-top:8px\\\">They reflect individual journeys — many clients experience better consistency and calmer decision-making when they practice the micro-habit architecture consistently.</div>\\n      </details>\\n      <details style=\\\"padding:12px;border-radius:10px;background:var(--panel);margin-bottom:8px\\\">\\n        <summary style=\\\"cursor:pointer\\\">Can I speak with a past participant?</summary>\\n        <div style=\\\"padding-top:8px\\\">With permission, I can share anonymized success stories or arrange a brief conversation with an alum from a cohort.</div>\\n      </details>\\n      <details style=\\\"padding:12px;border-radius:10px;background:var(--panel)\\\">\\n        <summary style=\\\"cursor:pointer\\\">What if I need private support after a cohort?</summary>\\n        <div style=\\\"padding-top:8px\\\">We design a transition plan: recommended micro-habits, check-in cadence, and optional 1:1 follow-up packages.</div>\\n      </details>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"font-size:13px\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    <div>\\n      <a href=\\\"book.html\\\" style=\\\"background:var(--accent);color:#fff;padding:10px 12px;border-radius:10px;text-decoration:none\\\">Book a Clarity Call</a>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Reserve a clarity call or enroll in a pathway with {{COACH_NAME}}. Simple intake and diagnostic to start your plan.\\\" />\\n  <style>\\n    :root{--white:#fff;--ink:#0d1112;--muted:#667076;--accent:#2b5a4a;--soft:#f7fbfa;--radius:12px;--max:980px}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--soft);color:var(--ink)}\\n    header{max-width:var(--max);margin:26px auto;padding:0 18px;display:flex;justify-content:space-between;align-items:center}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .brand img{width:56px;height:56px;border-radius:10px}\\n    nav a{margin-left:16px;text-decoration:none;color:var(--muted)}\\n    .container{max-width:var(--max);margin:20px auto;padding:18px}\\n    .grid{display:grid;grid-template-columns:1fr 380px;gap:22px}\\n    .card{background:var(--white);padding:18px;border-radius:14px;box-shadow:0 10px 30px rgba(30,40,40,0.06)}\\n    .card h2{margin:0 0 8px}\\n    form{display:flex;flex-direction:column;gap:12px}\\n    input,textarea,select{padding:12px;border-radius:10px;border:1px solid #e6eaeb;font-size:14px}\\n    .btn{background:var(--accent);color:var(--white);padding:12px;border-radius:10px;border:none;font-weight:600;text-decoration:none;display:inline-block;text-align:center}\\n    .micro{background:linear-gradient(180deg,rgba(43,90,74,0.06),transparent);padding:12px;border-radius:10px}\\n    .diagnostic{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px}\\n    .chip{background:#f2f6f5;padding:8px 10px;border-radius:999px;font-size:13px;color:var(--muted)}\\n    footer{max-width:var(--max);margin:36px auto;padding:0 18px;color:var(--muted);display:flex;justify-content:space-between}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}.brand img{width:48px;height:48px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\" />\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Programs</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <div class=\\\"container\\\">\\n    <div class=\\\"grid\\\">\\n      <section class=\\\"card\\\">\\n        <h2>Reserve a clarity call</h2>\\n        <p style=\\\"color:var(--muted);margin:0 0 12px\\\">A 15-minute conversation to clarify fit, goals, and the right pathway. No pressure — just clarity.</p>\\n\\n        <form action=\\\"/book\\\" method=\\\"post\\\">\\n          <label class=\\\"small\\\">Your full name</label>\\n          <input type=\\\"text\\\" name=\\\"name\\\" placeholder=\\\"Your name\\\" required />\\n\\n          <label class=\\\"small\\\">Email</label>\\n          <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"you@email.com\\\" required />\\n\\n          <label class=\\\"small\\\">Phone (optional)</label>\\n          <input type=\\\"tel\\\" name=\\\"phone\\\" placeholder=\\\"{{PHONE}}\\\" />\\n\\n          <label class=\\\"small\\\">Which pathway feels right?</label>\\n          <select name=\\\"pathway\\\">\\n            <option>Seed — Foundations (6 weeks)</option>\\n            <option>Root — Growth Cohort (8 weeks)</option>\\n            <option>Bloom — 1:1 Support (3 months)</option>\\n          </select>\\n\\n          <label class=\\\"small\\\">Quick diagnostic: what matters most right now?</label>\\n          <div class=\\\"diagnostic\\\">\\n            <div class=\\\"chip\\\">Sleep / Rhythm</div>\\n            <div class=\\\"chip\\\">Energy / Focus</div>\\n            <div class=\\\"chip\\\">Boundaries</div>\\n            <div class=\\\"chip\\\">Stress Management</div>\\n          </div>\\n\\n          <label class=\\\"small\\\">A short note (what you hope to change)</label>\\n          <textarea name=\\\"note\\\" rows=\\\"4\\\" placeholder=\\\"Two sentences is perfect\\\"></textarea>\\n\\n          <div style=\\\"display:flex;gap:10px;align-items:center;margin-top:6px\\\">\\n            <button class=\\\"btn\\\" type=\\\"submit\\\">Request my call</button>\\n            <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"btn\\\" style=\\\"background:#fff;color:var(--accent);border:1px solid #e6eaeb\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          </div>\\n        </form>\\n\\n        <div style=\\\"margin-top:12px;color:var(--muted);font-size:13px\\\">Appointments are scheduled within 3 business days. For urgent scheduling, call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>.</div>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"card micro\\\">\\n          <h3 style=\\\"margin:0 0 6px\\\">A simple diagnostic</h3>\\n          <p style=\\\"margin:0;color:var(--muted)\\\">Before our conversation you'll receive a brief intake that maps your current habits, energy, and what you want to prioritize. That helps us co-design a realistic plan.</p>\\n          <div style=\\\"margin-top:10px;display:flex;gap:8px\\\">\\n            <div style=\\\"background:white;padding:10px;border-radius:10px;min-width:120px\\\">Time to focus: 30–60 min</div>\\n            <div style=\\\"background:white;padding:10px;border-radius:10px;min-width:120px\\\">Tools you'll get: 3 micro-habits</div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"height:16px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 6px\\\">A taste of the plan</h3>\\n          <p style=\\\"color:var(--muted);margin:0 0 12px\\\">I use simple frameworks: diagnostic → micro-experiments → reflective practice. The design is iterative and built around your life rhythm.</p>\\n          <ul style=\\\"margin:0 0 12px 18px;color:var(--muted)\\\">\\n            <li>Diagnostic session & habit map</li>\\n            <li>3 micro-habits tailored to you</li>\\n            <li>Weekly check-ins & progress adjustments</li>\\n          </ul>\\n          <a href=\\\"pricing.html\\\" style=\\\"text-decoration:none;color:var(--accent);font-weight:600\\\">See pricing options</a>\\n        </div>\\n\\n        <div style=\\\"height:16px\\\"></div>\\n\\n        <div class=\\\"card\\\" style=\\\"text-align:center\\\">\\n          <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" style=\\\"width:140px;height:88px;display:block;margin:0 auto 10px\\\" />\\n          <div style=\\\"font-weight:700\\\">Not sure yet?</div>\\n          <div style=\\\"color:var(--muted);font-size:13px;margin-bottom:10px\\\">Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> with a short note and I’ll reply within 48 hours.</div>\\n          <a href=\\\"contact.html\\\" class=\\\"btn\\\" style=\\\"background:var(--accent);color:#fff;padding:8px 12px;text-decoration:none\\\">Reach out</a>\\n        </div>\\n      </aside>\\n    </div>\\n  </div>\\n\\n  <footer>\\n    <div style=\\\"font-size:13px\\\">© {{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}}</div>\\n    <div><a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
