          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f6efe6;--card:#fff6ee;--accent:#8a5a3b;--muted:#89766b;--glass:rgba(255,255,255,0.6);--radius:14px;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,#fbf6f1 0%,var(--bg) 100%);color:#332820}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 36px}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:radial-gradient(circle at 30% 30%,#ffe9d6, #f1d6c0);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent);box-shadow:0 6px 18px rgba(138,90,59,0.12)}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 10px;font-weight:600}\\n    nav a.primary{background:transparent;border:1px solid rgba(51,40,32,0.06);padding:10px 14px;border-radius:10px;color:var(--accent)}\\n    main{max-width:1100px;margin:28px auto;padding:28px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;background:linear-gradient(180deg,rgba(255,255,255,0.6),transparent);padding:36px;border-radius:18px;box-shadow:0 8px 30px rgba(51,40,32,0.06)}\\n    .hero h1{margin:0;font-size:34px;line-height:1.05;color:var(--accent)}\\n    .hero p{margin:12px 0;color:var(--muted)}\\n    .meta{display:flex;gap:12px;align-items:center;margin-top:18px}\\n    .cta{background:var(--accent);color:#fff;padding:12px 16px;border-radius:12px;text-decoration:none;font-weight:700}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(51,40,32,0.04)}\\n    .rows{display:flex;flex-direction:column;gap:18px}\\n    .section{margin-top:28px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\\n    .benefit{padding:16px;border-radius:12px;background:linear-gradient(180deg,#fff,#fff8f3)}\\n    .process{display:flex;gap:12px;align-items:flex-start}\\n    .step{background:var(--glass);padding:12px;border-radius:12px;flex:1}\\n    footer{margin-top:36px;padding:20px;text-align:center;color:var(--muted)}\\n    /* small screens */\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr 1fr}.rows{gap:12px}}\\n    @media (max-width:520px){.grid{grid-template-columns:1fr}}    \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">W</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Work With Me</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a class=\\\"primary\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <!-- HERO (unique inline SVG avatar for this page) -->\\n    <section class=\\\"hero\\\" aria-label=\\\"About hero\\\">\\n      <div>\\n        <h1>Hi, I’m {{COACH_NAME}} — a gentle guide to sustainable wellbeing.</h1>\\n        <p>I blend simple daily habits with proven frameworks to help busy people in {{CITY}}, {{STATE}} feel more grounded, energized, and capable — without burnout or fads.</p>\\n        <div class=\\\"meta\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <div style=\\\"color:var(--muted)\\\">or call <strong>{{PHONE}}</strong></div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card\\\" style=\\\"display:flex;flex-direction:column;align-items:center;gap:12px\\\">\\n        <!-- unique avatar SVG -->\\n        <svg width=\\\"160\\\" height=\\\"160\\\" viewBox=\\\"0 0 160 160\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-label=\\\"Coach avatar\\\">\\n          <defs>\\n            <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n              <stop offset=\\\"0\\\" stop-color=\\\"#ffe9d6\\\"/>\\n              <stop offset=\\\"1\\\" stop-color=\\\"#f1d6c0\\\"/>\\n            </linearGradient>\\n          </defs>\\n          <rect width=\\\"160\\\" height=\\\"160\\\" rx=\\\"20\\\" fill=\\\"#fff\\\"/>\\n          <circle cx=\\\"80\\\" cy=\\\"60\\\" r=\\\"34\\\" fill=\\\"url(#g1)\\\" stroke=\\\"#e6c9b3\\\" stroke-width=\\\"4\\\"/>\\n          <path d=\\\"M80 98c-28 0-44 12-44 24v6h88v-6c0-12-16-24-44-24z\\\" fill=\\\"#f5e6dc\\\" stroke=\\\"#ecd6c8\\\"/>\\n          <g fill=\\\"#8a5a3b\\\" opacity=\\\"0.9\\\">\\n            <circle cx=\\\"72\\\" cy=\\\"56\\\" r=\\\"4\\\"/>\\n            <circle cx=\\\"88\\\" cy=\\\"56\\\" r=\\\"4\\\"/>\\n            <path d=\\\"M70 70c4 4 16 4 20 0\\\" stroke=\\\"#8a5a3b\\\" stroke-width=\\\"2\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/>\\n          </g>\\n        </svg>\\n        <div style=\\\"text-align:center\\\">\\n          <div style=\\\"font-weight:700\\\">{{COACH_NAME}} <span style=\\\"font-weight:400;color:var(--muted)\\\">|</span> {{CREDENTIALS}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">Coaching in {{CITY}}, {{STATE}}</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- BENEFITS (unique headings) -->\\n    <section class=\\\"section\\\">\\n      <h2 style=\\\"color:var(--accent)\\\">Small changes. Lasting rhythm.</h2>\\n      <p style=\\\"color:var(--muted)\\\">I focus on tiny daily actions that compound into greater energy, calmer mornings, and clearer focus. Typical outcomes my clients celebrate:</p>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:14px\\\">\\n        <div class=\\\"benefit\\\">\\n          <strong>Predictable mornings</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">A simple routine you can actually sustain, not another overhaul.</div>\\n        </div>\\n        <div class=\\\"benefit\\\">\\n          <strong>Manageable energy</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Practical habits to reduce afternoon crashes and build steady cadence.</div>\\n        </div>\\n        <div class=\\\"benefit\\\">\\n          <strong>Clarity of priorities</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Decide with ease what matters and create space for it each week.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- PROCESS (unique metaphor: garden) -->\\n    <section class=\\\"section\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">How we grow your wellbeing</h3>\\n      <div class=\\\"process\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"step\\\">\\n          <strong>1. Soil & intention — Intake</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">We map your current rhythm and pick one anchor habit to start.</div>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <strong>2. Nurture — Weekly coaching</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Practical mini-experiments and supportive reflection to build momentum.</div>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <strong>3. Harvest — Sustainable change</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Refine routines so they fit your life long-term, not just a season.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- SOCIAL PROOF (testimonials snippet) -->\\n    <section class=\\\"section\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">Where clients notice the difference</h3>\\n      <div class=\\\"rows\\\">\\n        <div class=\\\"card\\\">\\n          <strong>\\\"Gentle guidance that actually fits my schedule.\\\"</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">— M., entrepreneur in {{CITY}}</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>\\\"I sleep better and my mornings are calm again.\\\"</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">— L., parent and teacher</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- LEAD MAGNET -->\\n    <section class=\\\"section card\\\" style=\\\"display:flex;align-items:center;justify-content:space-between;gap:16px\\\">\\n      <div>\\n        <strong style=\\\"font-size:16px;color:var(--accent)\\\">Free guide: The 7-Minute Morning Reset</strong>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Simple, research-informed steps you can do first thing to set an intentional tone for your day.</div>\\n      </div>\\n      <div>\\n        <form action=\\\"#\\\" onsubmit=\\\"alert('Thank you — please check your inbox.');return false;\\\">\\n          <input aria-label=\\\"Email\\\" type=\\\"email\\\" placeholder=\\\"Enter your email\\\" style=\\\"padding:10px;border-radius:10px;border:1px solid #eaded6;margin-right:8px\\\">\\n          <button class=\\\"cta\\\" type=\\\"submit\\\">Send me the guide</button>\\n        </form>\\n      </div>\\n    </section>\\n\\n    <!-- FAQ (unique questions) -->\\n    <section class=\\\"section\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">Questions people ask</h3>\\n      <div style=\\\"margin-top:12px;display:flex;flex-direction:column;gap:12px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>How long are sessions?</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Most sessions are 50 minutes — focused, actionable, and paced to your life.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Do you provide plans?</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">I favor micro-experiments and simple trackers over rigid plans so change sticks.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- CTA FOOTER -->\\n    <section class=\\\"section\\\" style=\\\"display:flex;gap:12px;align-items:center;justify-content:space-between\\\">\\n      <div>\\n        <div style=\\\"font-weight:700;font-size:18px;color:var(--accent)\\\">Ready to try a gentle approach to lasting habits?</div>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">Book a complimentary discovery session and we’ll design a clear first month together.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} — {{COACH_NAME}}, {{CREDENTIALS}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Offerings — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbf8f5;--panel:#fffaf6;--accent:#7b4f38;--muted:#7a6a62;--radius:12px;font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial}\\n    body{margin:0;background:var(--bg);color:#342a24}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:22px 28px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .mark{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,#fdebd8,#f3d6bf);display:flex;align-items:center;justify-content:center;color:var(--accent);font-weight:800}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    main{max-width:1100px;margin:18px auto;padding:18px}\\n    .hero{padding:26px;border-radius:16px;background:linear-gradient(180deg,#fff,#fff8f3);display:flex;gap:20px;align-items:center}\\n    .hero h1{margin:0;color:var(--accent)}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:18px}\\n    .service{background:var(--panel);padding:18px;border-radius:14px;box-shadow:0 8px 24px rgba(120,90,72,0.06)}\\n    .service h4{margin:0;color:var(--accent)}\\n    .attrs{display:flex;gap:8px;margin-top:12px}\\n    .pill{background:#fff;border-radius:999px;padding:6px 10px;font-size:13px;color:var(--muted)}\\n    .lead{display:flex;align-items:center;justify-content:space-between;margin-top:18px;padding:12px;border-radius:12px;background:linear-gradient(180deg,#fff,#fff8f3)}\\n    footer{margin-top:26px;padding:20px;text-align:center;color:var(--muted)}\\n    @media (max-width:720px){.grid{grid-template-columns:1fr}.hero{flex-direction:column;align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"mark\\\">{{BUSINESS_NAME.charAt(0)}}</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <!-- HERO with pattern SVG unique to this page -->\\n    <section class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1>Thoughtful services for daily wellbeing</h1>\\n        <p style=\\\"color:var(--muted)\\\">Tailored coaching, short consults, and focused workshops — all built around realistic habit change and sustainable routines.</p>\\n      </div>\\n      <div style=\\\"width:180px;text-align:right\\\">\\n        <!-- decorative pattern SVG -->\\n        <svg width=\\\"160\\\" height=\\\"120\\\" viewBox=\\\"0 0 160 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n          <defs>\\n            <linearGradient id=\\\"p1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#fff1e6\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#fde3d0\\\"/></linearGradient>\\n          </defs>\\n          <rect width=\\\"160\\\" height=\\\"120\\\" rx=\\\"14\\\" fill=\\\"url(#p1)\\\" />\\n          <g fill=\\\"#e9cdbd\\\" opacity=\\\"0.9\\\">\\n            <circle cx=\\\"30\\\" cy=\\\"30\\\" r=\\\"16\\\"/>\\n            <circle cx=\\\"60\\\" cy=\\\"60\\\" r=\\\"10\\\"/>\\n            <ellipse cx=\\\"110\\\" cy=\\\"40\\\" rx=\\\"28\\\" ry=\\\"18\\\"/>\\n          </g>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <!-- SERVICES LIST (different metaphor: toolkit) -->\\n    <section class=\\\"section\\\" style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"color:var(--accent)\\\">Your coaching toolkit</h2>\\n      <p style=\\\"color:var(--muted)\\\">Pick the format that fits your rhythm. Each option emphasizes habit scaffolding, small experiments, and clear measures of progress.</p>\\n\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"service\\\">\\n          <h4>One-on-One Coaching</h4>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Personal sessions tailored to your life and constraints. Weekly or biweekly check-ins available.</div>\\n          <div class=\\\"attrs\\\">\\n            <div class=\\\"pill\\\">50 min</div>\\n            <div class=\\\"pill\\\">Action-focused</div>\\n            <div class=\\\"pill\\\">Habit architecture</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"service\\\">\\n          <h4>Short Consult — 30 min</h4>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">A focused session to reset a routine or troubleshoot a specific challenge.</div>\\n          <div class=\\\"attrs\\\">\\n            <div class=\\\"pill\\\">30 min</div>\\n            <div class=\\\"pill\\\">Quick plan</div>\\n            <div class=\\\"pill\\\">Ideal for busy weeks</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"service\\\">\\n          <h4>Group Workshop</h4>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">A 90-minute, interactive workshop on sustainable mornings, sleep-friendly evenings, or energy pacing.</div>\\n          <div class=\\\"attrs\\\">\\n            <div class=\\\"pill\\\">90 min</div>\\n            <div class=\\\"pill\\\">Interactive</div>\\n            <div class=\\\"pill\\\">Small groups</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"service\\\">\\n          <h4>Corporate Wellness Session</h4>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Tailored sessions for teams emphasizing productivity rhythms and burnout prevention.</div>\\n          <div class=\\\"attrs\\\">\\n            <div class=\\\"pill\\\">Custom</div>\\n            <div class=\\\"pill\\\">Team-focused</div>\\n            <div class=\\\"pill\\\">Outcome-driven</div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- PROCESS (unique order: Assess -> Design -> Implement -> Reflect) -->\\n    <section class=\\\"section\\\" style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">How a session unfolds</h3>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-wrap:wrap\\\">\\n        <div class=\\\"service\\\" style=\\\"flex:1;min-width:220px\\\">\\n          <strong>Assess</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">We look at your current patterns with curiosity, not judgment.</div>\\n        </div>\\n        <div class=\\\"service\\\" style=\\\"flex:1;min-width:220px\\\">\\n          <strong>Design</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Co-create a few tiny experiments aligned to your values and schedule.</div>\\n        </div>\\n        <div class=\\\"service\\\" style=\\\"flex:1;min-width:220px\\\">\\n          <strong>Implement</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Practice the habit with accountability and simple tracking.</div>\\n        </div>\\n        <div class=\\\"service\\\" style=\\\"flex:1;min-width:220px\\\">\\n          <strong>Reflect</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Tune the approach so it lasts beyond the coaching container.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- SOCIAL PROOF (different phrasing) -->\\n    <section class=\\\"section\\\" style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">Trusted by people who needed practical change</h3>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-wrap:wrap\\\">\\n        <div class=\\\"card\\\" style=\\\"padding:12px;background:#fff;min-width:250px\\\">\\n          <strong>\\\"I finally have a simple plan that I can do every day.\\\"</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">— R., product manager</div>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"padding:12px;background:#fff;min-width:250px\\\">\\n          <strong>\\\"Practical, warm, and sensible.\\\"</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">— A., nonprofit director</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- LEAD MAGNET (different CTA) -->\\n    <section class=\\\"lead\\\" style=\\\"margin-top:18px\\\">\\n      <div>\\n        <strong style=\\\"color:var(--accent)\\\">Free checklist: Daily 5 — a bite-sized routine to reclaim your day</strong>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">Download the checklist and get a short email series to implement it over two weeks.</div>\\n      </div>\\n      <div>\\n        <form onsubmit=\\\"alert('Check your email for the checklist');return false;\\\">\\n          <input type=\\\"email\\\" placeholder=\\\"Your email\\\" aria-label=\\\"Email\\\" style=\\\"padding:10px;border-radius:10px;border:1px solid #eaded6;margin-right:8px\\\">\\n          <button class=\\\"cta\\\" style=\\\"background:var(--accent);color:#fff;padding:10px 12px;border-radius:10px;border:0\\\">Get the checklist</button>\\n        </form>\\n      </div>\\n    </section>\\n\\n    <!-- FAQ (unique Qs) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">Common questions</h3>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-direction:column\\\">\\n        <div class=\\\"service\\\">\\n          <strong>Can coaching replace medical advice?</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Coaching supports habits and wellbeing; I don’t provide medical diagnosis or treatment.</div>\\n        </div>\\n        <div class=\\\"service\\\">\\n          <strong>How do I prepare for a first session?</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Bring a recent typical week and one small change you’d like to test.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- FINAL CTA -->\\n    <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <div style=\\\"font-weight:700;color:var(--accent)\\\">Curious to try a short consult?</div>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">Book a 30-minute session to get a concise plan you can use this week.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"background:var(--accent);color:#fff;padding:12px 16px;border-radius:12px;text-decoration:none;font-weight:700\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"color:var(--muted);margin-top:22px\\\">{{BUSINESS_NAME}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f8efe6;--card:#fffaf4;--accent:#6b432d;--muted:#79645b;--radius:16px;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto}\\n    body{margin:0;background:var(--bg);color:#332820}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 26px}\\n    .brand{display:flex;align-items:center;gap:10px}\\n    .nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    main{max-width:1100px;margin:20px auto;padding:16px}\\n    .hero{padding:30px;border-radius:18px;background:linear-gradient(180deg,#fff,#fff7f0);display:flex;gap:20px;align-items:center}\\n    .hero h1{margin:0;color:var(--accent)}\\n    .programs{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .tier{background:var(--card);padding:18px;border-radius:14px;box-shadow:0 10px 30px rgba(102,72,56,0.06);display:flex;flex-direction:column;gap:12px}\\n    .tier h4{margin:0;color:var(--accent)}\\n    .price{font-weight:800;color:var(--accent);font-size:20px}\\n    .features{color:var(--muted);font-size:14px}\\n    .leadmag{margin-top:18px;padding:16px;border-radius:12px;background:linear-gradient(180deg,#fff,#fff7f0)}\\n    .cta{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{margin-top:22px;color:var(--muted);text-align:center;padding:18px}\\n    @media (max-width:900px){.programs{grid-template-columns:1fr 1fr}}@media (max-width:600px){.programs{grid-template-columns:1fr}}\\n  </style>\\head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div style=\\\"width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#fdeedd,#f3d4bf);display:flex;align-items:center;justify-content:center;color:var(--accent);font-weight:800\\\">{{BUSINESS_NAME.charAt(0)}}</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Story</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <!-- HERO with unique svg (hero-like sun) -->\\n    <section class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1>Programs — guided paths for steady progress</h1>\\n        <p style=\\\"color:var(--muted)\\\">Choose a supported timeframe and framework to build lasting habits without overwhelm.</p>\\n      </div>\\n      <div style=\\\"width:160px\\\">\\n        <svg width=\\\"160\\\" height=\\\"120\\\" viewBox=\\\"0 0 160 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n          <rect width=\\\"160\\\" height=\\\"120\\\" rx=\\\"14\\\" fill=\\\"#fff\\\"/>\\n          <g transform=\\\"translate(10,10)\\\" fill=\\\"none\\\" stroke=\\\"#f3d6bf\\\" stroke-width=\\\"10\\\">\\n            <circle cx=\\\"60\\\" cy=\\\"40\\\" r=\\\"28\\\" stroke=\\\"#fde3cf\\\" fill=\\\"#fff6ef\\\"/>\\n          </g>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <!-- LEAD MAGNET early on (different placement) -->\\n    <section class=\\\"leadmag\\\">\\n      <strong style=\\\"color:var(--accent)\\\">Free mini-course: Build One Habit in 21 Days</strong>\\n      <div style=\\\"color:var(--muted);margin-top:8px\\\">A short, guided email course with micro-tasks and reflection prompts — designed for real-life schedules.</div>\\n      <div style=\\\"margin-top:12px\\\">\\n        <form onsubmit=\\\"alert('You will receive the mini-course via email.');return false;\\\">\\n          <input type=\\\"email\\\" placeholder=\\\"Your email\\\" aria-label=\\\"Email\\\" style=\\\"padding:10px;border-radius:10px;border:1px solid #eaded6;margin-right:8px\\\">\\n          <button class=\\\"cta\\\" type=\\\"submit\\\">Join the mini-course</button>\\n        </form>\\n      </div>\\n    </section>\\n\\n    <!-- BENEFITS (different heading) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">Why choose a program?</h3>\\n      <p style=\\\"color:var(--muted)\\\">Structured support helps habits move from novel to natural. Programs combine coaching, check-ins, and habit design so you keep the gains.</p>\\n    </section>\\n\\n    <!-- PROGRAM TIERS (unique names & pricing framing) -->\\n    <section class=\\\"programs\\\" aria-label=\\\"Program tiers\\\">\\n      <div class=\\\"tier\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <h4>Starter Rhythm</h4>\\n          <div class=\\\"price\\\">$297 / month</div>\\n        </div>\\n        <div class=\\\"features\\\">Best for beginning a single habit: weekly 30-min check-ins + simple tracker.</div>\\n        <ul style=\\\"color:var(--muted);margin-top:8px\\\">\\n          <li>Four 30-min sessions / month</li>\\n          <li>Email support between sessions</li>\\n          <li>One prioritized habit focus</li>\\n        </ul>\\n        <div style=\\\"margin-top:auto\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Enroll — Starter</a></div>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <h4>Foundations</h4>\\n          <div class=\\\"price\\\">$547 / month</div>\\n        </div>\\n        <div class=\\\"features\\\">A monthly container for steady improvements: weekly 50-min sessions + habit architecture.</div>\\n        <ul style=\\\"color:var(--muted);margin-top:8px\\\">\\n          <li>Weekly 50-min coaching</li>\\n          <li>Personalized habit plan</li>\\n          <li>Progress reviews & adjustments</li>\\n        </ul>\\n        <div style=\\\"margin-top:auto\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Join Foundations</a></div>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <h4>Deep Work Path</h4>\\n          <div class=\\\"price\\\">$999 / month</div>\\n        </div>\\n        <div class=\\\"features\\\">For meaningful shifts across health, focus, and energy: higher touch coaching + frameworks.</div>\\n        <ul style=\\\"color:var(--muted);margin-top:8px\\\">\\n          <li>Weekly 1:1 + monthly planning session</li>\\n          <li>Structured frameworks and tracking</li>\\n          <li>Priority booking & bespoke resources</li>\\n        </ul>\\n        <div style=\\\"margin-top:auto\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Apply — Deep Work</a></div>\\n      </div>\\n    </section>\\n\\n    <!-- PROCESS (different presentation: timeline) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">What a month looks like</h3>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-wrap:wrap\\\">\\n        <div class=\\\"tier\\\" style=\\\"min-width:220px\\\">\\n          <strong>Week 1 — Setup</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Discover a clear anchor habit and design the smallest possible experiment.</div>\\n        </div>\\n        <div class=\\\"tier\\\" style=\\\"min-width:220px\\\">\\n          <strong>Week 2 — Practice</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Implement the habit with short check-ins and adjustments.</div>\\n        </div>\\n        <div class=\\\"tier\\\" style=\\\"min-width:220px\\\">\\n          <strong>Week 3 — Embed</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Add gentle supports to make the habit resilient to real-life stressors.</div>\\n        </div>\\n        <div class=\\\"tier\\\" style=\\\"min-width:220px\\\">\\n          <strong>Week 4 — Review</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Reflect on wins and plan the next small step so progress continues.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- SOCIAL PROOF (short quotes) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">Client highlights</h3>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-wrap:wrap\\\">\\n        <div class=\\\"tier\\\" style=\\\"min-width:220px;padding:12px\\\">\\n          <strong>\\\"After a month I had a routine that stuck.\\\"</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">— S., designer</div>\\n        </div>\\n        <div class=\\\"tier\\\" style=\\\"min-width:220px;padding:12px\\\">\\n          <strong>\\\"The frameworks made difficult choices simple.\\\"</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">— T., engineer</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- FAQ (unique Qs for programs) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">Program FAQs</h3>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-direction:column\\\">\\n        <div class=\\\"tier\\\" style=\\\"padding:12px\\\">\\n          <strong>How long should I commit?</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">I recommend a minimum of three months to create durable habits, though one-month sprint options are available.</div>\\n        </div>\\n        <div class=\\\"tier\\\" style=\\\"padding:12px\\\">\\n          <strong>Is there a trial?</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">A discovery session is complimentary so we can see if the program fits your needs.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- CTA -->\\n    <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center;padding:14px;border-radius:12px;background:linear-gradient(180deg,#fff,#fff7f0)\\\">\\n      <div>\\n        <div style=\\\"font-weight:700;color:var(--accent)\\\">Ready to pick a path?</div>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">Start with a free discovery call and we’ll find the right fit for your life.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"color:var(--muted);margin-top:18px\\\">Contact {{COACH_NAME}} — {{CREDENTIALS}} at <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
