          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Investment & Programs</title>\\n  <meta name=\\\"description\\\" content=\\\"Clear, intensive coaching paths designed to produce sustainable habits and measurable wellbeing gains.\\\">\\n  <style>\\n    :root{--bg:#fff;--text:#0b1220;--muted:#6b7280;--accent:#0f766e;--card:#f8fafb;--radius:12px}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--text);background:var(--bg);}\\n    .container{max-width:920px;margin:64px auto;padding:40px;}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:32px}\\n    .brand{font-weight:700;letter-spacing:0.2px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:20px;font-size:14px}\\n    .hero{display:grid;grid-template-columns:1fr 320px;gap:28px;align-items:center;margin-bottom:36px}\\n    .hero h1{margin:0;font-size:28px}\\n    .hero p{color:var(--muted);margin-top:12px}\\n    .card{background:var(--card);padding:22px;border-radius:var(--radius);box-shadow:0 6px 20px rgba(10,10,10,0.04)}\\n    .tier{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}\\n    .tier h3{margin:0;font-size:16px}\\n    .price{font-weight:700;color:var(--accent)}\\n    .features{color:var(--muted);font-size:14px;margin-top:8px}\\n    .cta{display:inline-block;margin-top:14px;background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    .section{margin-top:36px}\\n    .grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}\\n    footer{margin-top:48px;color:var(--muted);font-size:13px}\\n    /* minimal responsive */\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.container{padding:24px;margin:24px auto}}\\n    .svg-wrap{display:block;width:100%;height:100%;}\\n    .muted{color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"programs.html\\\">Work</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Investment designed for accelerated habit change</h1>\\n        <p class=\\\"muted\\\">Choose a focused path built for busy professionals who want measurable routines, resilience habits, and a dependable framework to maintain gains.</p>\\n        <div class=\\\"section\\\">\\n          <div class=\\\"card\\\">\\n            <div class=\\\"tier\\\">\\n              <div>\\n                <h3>Foundations Intensive</h3>\\n                <div class=\\\"features\\\">6 weeks • weekly 1:1s • habit tracking</div>\\n              </div>\\n              <div class=\\\"price\\\">$1,800</div>\\n            </div>\\n            <div class=\\\"tier\\\">\\n              <div>\\n                <h3>Momentum Lab</h3>\\n                <div class=\\\"features\\\">3 months • bi-weekly coaching • accountability sprints</div>\\n              </div>\\n              <div class=\\\"price\\\">$3,900</div>\\n            </div>\\n            <div class=\\\"tier\\\">\\n              <div>\\n                <h3>Transformation Residency</h3>\\n                <div class=\\\"features\\\">6 months • deep frameworks • on-call support</div>\\n              </div>\\n              <div class=\\\"price\\\">$7,500</div>\\n            </div>\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <div>\\n        <!-- Inline unique hero SVG (local asset reference kept for structure) -->\\n        <svg class=\\\"svg-wrap\\\" viewBox=\\\"0 0 400 300\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-label=\\\"abstract wellness curve\\\">\\n          <defs>\\n            <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n              <stop offset=\\\"0\\\" stop-color=\\\"#e6fffb\\\" />\\n              <stop offset=\\\"1\\\" stop-color=\\\"#f0fdfa\\\" />\\n            </linearGradient>\\n          </defs>\\n          <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g1)\\\" rx=\\\"16\\\"/>\\n          <path d=\\\"M18 220 C 90 100, 150 260, 240 120 C320 0, 380 200, 390 210\\\" stroke=\\\"#0f766e\\\" stroke-width=\\\"6\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/>\\n          <circle cx=\\\"240\\\" cy=\\\"120\\\" r=\\\"10\\\" fill=\\\"#0f766e\\\"/>\\n        </svg>\\n        <!-- developer hint: assets/img/hero.svg -->\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h2>What you get — clear outcomes, not vague promises</h2>\\n      <p class=\\\"muted\\\">Each path focuses on three pillars: daily habit architecture, decision frameworks, and measurable progress checkpoints. You leave with routines that fit your week and a practical plan to sustain them.</p>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:18px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Values</strong>\\n          <p class=\\\"muted\\\">Practicality, evidence-informed habits, and iterative improvement over perfection.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Methods</strong>\\n          <p class=\\\"muted\\\">Short daily rituals, weekly reflection sprints, and compact systems for energy renewal.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h2>Objections I hear (and how we handle them)</h2>\\n      <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n        <p><strong>\\\"I don’t have time.\\\"</strong> — We start by identifying 10 minutes that already exist in your day and build there.</p>\\n        <p><strong>\\\"I’ve tried coaching before.\\\"</strong> — This is not ongoing advice; it’s an intensive structure with clear milestones and exit strategies.</p>\\n        <p><strong>\\\"Will it work for my schedule?\\\"</strong> — Programs are engineered to fit shift work, travel, and high-travel roles; adaptions are standard.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h2>Real feedback from leaders</h2>\\n      <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n        <p class=\\\"muted\\\">\\\"After three months I reclaimed my mornings and doubled the time I spend on focused work.\\\" — A. R., VP</p>\\n        <p class=\\\"muted\\\">\\\"Practical tools that don’t feel like another task list.\\\" — M. L., Founder</p>\\n        <a class=\\\"cta\\\" href=\\\"testimonials.html\\\">Read more success stories</a>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h2>Lead resource — Habit Architecture Guide</h2>\\n      <div class=\\\"card\\\" style=\\\"display:flex;justify-content:space-between;align-items:center;\\\">\\n        <div>\\n          <strong>Download a concise 8-page framework to build durable habits.</strong>\\n          <p class=\\\"muted\\\">Instant PDF with actionable templates you can use this week.</p>\\n        </div>\\n        <div>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Get the guide</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>Questions? Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div style=\\\"margin-top:8px\\\">© {{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • {{COACH_NAME}}, {{CREDENTIALS}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Results — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Client outcomes, case notes, and short stories of change—focused on habits and frameworks.\\\">\\n  <style>\\n    :root{--bg:#fff;--text:#071126;--muted:#657386;--accent:#0b6b59}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;margin:0;background:var(--bg);color:var(--text)}\\n    .wrap{max-width:920px;margin:60px auto;padding:32px}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none}\\n    h1{font-size:26px;margin:0}\\n    .lead{color:var(--muted);margin-top:10px}\\n    .test-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:22px}\\n    .result{border-radius:12px;padding:18px;background:#fbfdfc;border:1px solid #eef6f5}\\n    .quote{font-style:italic;color:var(--text)}\\n    .meta{color:var(--muted);font-size:13px;margin-top:8px}\\n    .avatar{width:56px;height:56px;border-radius:10px;overflow:hidden}\\n    .download{display:inline-block;margin-top:12px;background:var(--accent);color:#fff;padding:10px 12px;border-radius:10px;text-decoration:none}\\n    .section{margin-top:28px}\\n    footer{margin-top:40px;color:var(--muted);font-size:13px}\\n    @media (max-width:800px){.test-grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">Philosophy</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"testimonials.html\\\">Testimonials</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <h1>Stories of practical change</h1>\\n      <p class=\\\"lead\\\">Short case notes that show how small structural shifts created consistent results. Focus is on routines, decision points, and measurable milestones.</p>\\n\\n      <section class=\\\"section\\\">\\n        <div class=\\\"test-grid\\\">\\n          <div class=\\\"result\\\">\\n            <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n              <div class=\\\"avatar\\\">\\n                <!-- unique avatar SVG -->\\n                <svg viewBox=\\\"0 0 80 80\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"80\\\" height=\\\"80\\\">\\n                  <rect width=\\\"80\\\" height=\\\"80\\\" rx=\\\"12\\\" fill=\\\"#eafdf8\\\"/>\\n                  <circle cx=\\\"40\\\" cy=\\\"30\\\" r=\\\"14\\\" fill=\\\"#0b6b59\\\"/>\\n                  <rect x=\\\"18\\\" y=\\\"48\\\" width=\\\"44\\\" height=\\\"14\\\" rx=\\\"6\\\" fill=\\\"#dff8f1\\\"/>\\n                </svg>\\n              </div>\\n              <div>\\n                <div class=\\\"quote\\\">\\\"I reclaimed two hours a week for deep work without changing my calendar.\\\"</div>\\n                <div class=\\\"meta\\\">S. — Director, Tech</div>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"result\\\">\\n            <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n              <div class=\\\"avatar\\\">\\n                <svg viewBox=\\\"0 0 80 80\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"80\\\" height=\\\"80\\\">\\n                  <rect width=\\\"80\\\" height=\\\"80\\\" rx=\\\"12\\\" fill=\\\"#fff7ed\\\"/>\\n                  <path d=\\\"M20 28c8-10 32-10 40 0v18H20z\\\" fill=\\\"#f59e0b\\\"/>\\n                </svg>\\n              </div>\\n              <div>\\n                <div class=\\\"quote\\\">\\\"Fast frameworks, clear checkpoints — I stayed accountable and scaled the wins.\\\"</div>\\n                <div class=\\\"meta\\\">L. — Founder</div>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"result\\\">\\n            <div class=\\\"quote\\\">\\\"The tailored habit plan fit travel and long days; the weekly playbook kept progress visible.\\\"</div>\\n            <div class=\\\"meta\\\">K. — Consultant</div>\\n          </div>\\n\\n          <div class=\\\"result\\\">\\n            <div class=\\\"quote\\\">\\\"Months in, I still use the simple morning anchor we designed. It’s been transformational for energy management.\\\"</div>\\n            <div class=\\\"meta\\\">N. — Executive</div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"section\\\">\\n        <h2>Why these stories matter</h2>\\n        <p class=\\\"lead\\\">They show repeatable systems: anchor, micro-habits, and weekly calibration. We avoid one-off tactics and instead embed predictable rhythms.</p>\\n      </section>\\n\\n      <section class=\\\"section\\\">\\n        <h2>Lead magnet — The Weekly Calibration Template</h2>\\n        <div style=\\\"display:flex;gap:12px;align-items:center;margin-top:12px\\\">\\n          <div class=\\\"card\\\" style=\\\"padding:12px;border-radius:10px;background:#f7fdfb;border:1px solid #e6f6f1\\\">\\n            <p class=\\\"muted\\\">A single-page template to review wins, obstacles, and next-week intentions.</p>\\n          </div>\\n          <a class=\\\"download\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Download now</a>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"section\\\">\\n        <h2>Objections & clarity</h2>\\n        <div style=\\\"margin-top:10px\\\">\\n          <p><strong>Q: How quickly do people see change?</strong> — Most clients report behavioral shifts inside 3–6 weeks; measurable habits by the end of the first 12 weeks.</p>\\n          <p><strong>Q: Is this prescriptive?</strong> — It’s collaborative. We map your constraints and build systems that fit your life.</p>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"section\\\">\\n        <a class=\\\"download\\\" href=\\\"book.html\\\">Book a discovery session</a>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div>Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n      <div style=\\\"margin-top:8px\\\">© {{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a Discovery — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Schedule a focused discovery call to assess fit and map an intensive coaching plan.\\\">\\n  <style>\\n    :root{--bg:#fff;--text:#081426;--muted:#67748a;--accent:#0e6b5d}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;margin:0;background:var(--bg);color:var(--text)}\\n    .frame{max-width:760px;margin:48px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:16px;text-decoration:none;color:var(--muted)}\\n    h1{font-size:24px;margin-top:18px}\\n    p{color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:1fr 300px;gap:20px;margin-top:20px}\\n    form{background:#fbfeff;border-radius:12px;padding:18px;border:1px solid #eaf6f3}\\n    label{display:block;font-size:13px;margin-top:12px;color:var(--muted)}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6eff0;margin-top:6px}\\n    button{margin-top:12px;background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;border:none}\\n    .summary{background:#fff;border-radius:12px;padding:18px;border:1px solid #eef6f8}\\n    .small{font-size:13px;color:var(--muted)}\\n    footer{margin-top:28px;color:var(--muted);font-size:13px}\\n    @media (max-width:860px){.grid{grid-template-columns:1fr}}\\n    .pattern{width:100%;height:80px;margin-top:10px}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"frame\\\">\\n    <header>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"pricing.html\\\">Investment</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <h1>Book a focused discovery session</h1>\\n    <p class=\\\"small\\\">A 30-minute conversation to assess fit, clarify outcomes, and map an intensive plan tailored to your schedule.</p>\\n\\n    <div class=\\\"grid\\\">\\n      <div>\\n        <form id=\\\"bookForm\\\">\\n          <label for=\\\"name\\\">Name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" required>\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required>\\n\\n          <label for=\\\"phone\\\">Phone</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" type=\\\"tel\\\">\\n\\n          <label for=\\\"program\\\">Program of interest</label>\\n          <select id=\\\"program\\\" name=\\\"program\\\">\\n            <option>Foundations Intensive — 6 weeks</option>\\n            <option>Momentum Lab — 3 months</option>\\n            <option>Transformation Residency — 6 months</option>\\n          </select>\\n\\n          <label for=\\\"note\\\">Brief priority or challenge</label>\\n          <textarea id=\\\"note\\\" name=\\\"note\\\" rows=\\\"4\\\" placeholder=\\\"What would you like to accomplish?\\\" ></textarea>\\n\\n          <button type=\\\"submit\\\">Request a time</button>\\n\\n          <p class=\\\"small\\\">After you submit, we’ll reply with available times and next steps. Or call: {{PHONE}}</p>\\n        </form>\\n      </div>\\n\\n      <aside class=\\\"summary\\\">\\n        <h3>What the session covers</h3>\\n        <ul class=\\\"small\\\">\\n          <li>Focused intake — current routine and constraints</li>\\n          <li>One immediate habit to implement this week</li>\\n          <li>Recommended path and timing</li>\\n        </ul>\\n\\n        <h3 style=\\\"margin-top:12px\\\">Lead resource</h3>\\n        <p class=\\\"small\\\">Receive the Habit Architecture Guide after booking to start immediately.</p>\\n\\n        <div class=\\\"pattern\\\" aria-hidden=\\\"true\\\">\\n          <!-- unique decorative pattern SVG -->\\n          <svg viewBox=\\\"0 0 320 80\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"100%\\\" height=\\\"80\\\">\\n            <defs>\\n              <pattern id=\\\"p1\\\" width=\\\"16\\\" height=\\\"16\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n                <rect width=\\\"8\\\" height=\\\"8\\\" fill=\\\"#f1fbf9\\\"></rect>\\n                <rect x=\\\"8\\\" y=\\\"8\\\" width=\\\"8\\\" height=\\\"8\\\" fill=\\\"#f1fbf9\\\"></rect>\\n              </pattern>\\n            </defs>\\n            <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\"></rect>\\n            <path d=\\\"M10 60 C70 10, 140 70, 300 20\\\" stroke=\\\"#0e6b5d\\\" stroke-width=\\\"3\\\" fill=\\\"none\\\" opacity=\\\"0.12\\\"/>\\n          </svg>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:inline-block;background:var(--accent);color:#fff;padding:8px 12px;border-radius:8px;text-decoration:none\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:28px\\\">\\n      <h3>Common questions before booking</h3>\\n      <div class=\\\"small\\\">\\n        <p><strong>How long is the commitment?</strong> — The discovery call is 30 minutes. Program lengths vary per path; we recommend beginning with a short intensive to build momentum.</p>\\n        <p><strong>Can I reschedule?</strong> — Yes; we handle changes via email. We’ll confirm a few options after you request a time.</p>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"small\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}} • {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n\\n  <script>\\n    (function(){\\n      var form = document.getElementById('bookForm');\\n      form.addEventListener('submit', function(e){\\n        e.preventDefault();\\n        var name = encodeURIComponent(document.getElementById('name').value || '');\\n        var email = encodeURIComponent(document.getElementById('email').value || '');\\n        var phone = encodeURIComponent(document.getElementById('phone').value || '');\\n        var program = encodeURIComponent(document.getElementById('program').value || '');\\n        var note = encodeURIComponent(document.getElementById('note').value || '');\\n        var subject = encodeURIComponent('Discovery request — ' + name);\\n        var body = encodeURIComponent('Name: ')+name+'%0D%0A'+encodeURIComponent('Email: ')+email+'%0D%0A'+encodeURIComponent('Phone: ')+phone+'%0D%0A'+encodeURIComponent('Program: ')+program+'%0D%0A%0D%0A'+encodeURIComponent('Notes: ')+note;\\n        var mailto = 'mailto:{{EMAIL}}?subject='+subject+'&body='+body;\\n        window.location.href = mailto;\\n      });\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
