          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Pricing & Plans</title>\\n  <style>\\n    :root{--bg:#0f1724;--card:#ffffff;--accent:#ff6b6b;--muted:#94a3b8;--glass:rgba(255,255,255,0.06)}\\n    *{box-sizing:border-box;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial}\\n    body{margin:0;background:linear-gradient(180deg,#071029 0%,#0f1724 100%);color:var(--card);-webkit-font-smoothing:antialiased}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:24px 32px}\\n    .brand{font-weight:800;letter-spacing:0.6px}\\n    nav a{color:var(--muted);margin-left:18px;text-decoration:none;font-weight:600}\\n    .container{max-width:1100px;margin:0 auto;padding:28px}\\n    .hero{display:flex;align-items:center;gap:28px;padding:36px;background:linear-gradient(90deg,rgba(255,107,107,0.06),rgba(255,166,126,0.03));border-radius:14px}\\n    .hero .text h1{font-size:28px;margin:0 0 10px;color:#fff}\\n    .hero .text p{margin:0;color:var(--muted)}\\n    .btn{display:inline-block;margin-top:14px;background:var(--accent);color:#fff;padding:12px 18px;border-radius:12px;text-decoration:none;font-weight:700}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.03),rgba(255,255,255,0.01));padding:20px;border-radius:12px;border:1px solid rgba(255,255,255,0.04)}\\n    .card h3{margin:0 0 8px;color:#fff}\\n    .price{font-size:22px;font-weight:800}\\n    .features{color:var(--muted);margin-top:10px}\\n    .small{font-size:13px;color:var(--muted)}\\n    .myth{display:flex;gap:14px;margin-top:28px}\\n    .myth .item{flex:1;background:var(--glass);padding:14px;border-radius:10px}\\n    .pillars{display:flex;gap:14px;margin-top:24px}\\n    .pillars .p{flex:1;padding:14px;background:rgba(255,255,255,0.02);border-radius:10px}\\n    footer{padding:28px 0;color:var(--muted);font-size:13px}\\n    /* playful shape */\\n    .svg-blob{width:140px;height:140px;flex-shrink:0}\\n    @media(max-width:860px){.grid{grid-template-columns:1fr}.hero{flex-direction:column;align-items:flex-start}.svg-blob{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Approach</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"svg-blob\\\" aria-hidden>\\n        <!-- unique inline hero svg for pricing -->\\n        <svg viewBox=\\\"0 0 120 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-label=\\\"abstract pricing blob\\\">\\n          <defs>\\n            <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\" y1=\\\"0\\\" y2=\\\"1\\\">\\n              <stop offset=\\\"0\\\" stop-color=\\\"#ff8a80\\\"/>\\n              <stop offset=\\\"1\\\" stop-color=\\\"#ff6b6b\\\"/>\\n            </linearGradient>\\n          </defs>\\n          <rect width=\\\"120\\\" height=\\\"120\\\" rx=\\\"20\\\" fill=\\\"url(#g1)\\\" opacity=\\\"0.12\\\" />\\n          <circle cx=\\\"36\\\" cy=\\\"36\\\" r=\\\"18\\\" fill=\\\"#ff6b6b\\\" opacity=\\\"0.18\\\"/>\\n          <path d=\\\"M20 90 C40 70,80 110,100 88\\\" stroke=\\\"#ff8a80\\\" stroke-width=\\\"2\\\" fill=\\\"none\\\" opacity=\\\"0.9\\\"/>\\n        </svg>\\n      </div>\\n\\n      <div class=\\\"text\\\">\\n        <h1>Investment plans for steady habit change — transparent and outcome-focused</h1>\\n        <p class=\\\"small\\\">Choose a plan built around measurable behaviors, weekly habits, and a reproducible framework. Includes a practical starter guide and an evidence-backed habit checklist.</p>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"pricing-grid\\\">\\n      <div style=\\\"display:block;margin-top:18px\\\">\\n        <div class=\\\"grid\\\">\\n          <div class=\\\"card\\\">\\n            <h3>Foundations — Starter Pack</h3>\\n            <div class=\\\"price\\\">$299 / one-time</div>\\n            <div class=\\\"features\\\">\\n              4 focused sessions • Habit blueprint • Email check-ins for 2 weeks • Starter guide\\n            </div>\\n            <div style=\\\"margin-top:12px\\\"><span class=\\\"small\\\">Best if you want a short, tactical reset.</span></div>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <h3>Momentum — Monthly Accelerator</h3>\\n            <div class=\\\"price\\\">$149 / month</div>\\n            <div class=\\\"features\\\">\\n              Weekly 45-min coaching • Habit labs & tracking templates • Priority email support • Quarterly review\\n            </div>\\n            <div style=\\\"margin-top:12px\\\"><span class=\\\"small\\\">Designed to build consistent routines for 3+ months.</span></div>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <h3>Integration — 6‑Month Steward</h3>\\n            <div class=\\\"price\\\">$1,999 / program</div>\\n            <div class=\\\"features\\\">\\n              Bi-weekly sessions • Full behavior protocol • Habit automation plan • Access to group workshops\\n            </div>\\n            <div style=\\\"margin-top:12px\\\"><span class=\\\"small\\\">For sustained systems change and long-term maintenance.</span></div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"myth\\\" aria-labelledby=\\\"myth-title\\\">\\n      <div class=\\\"item\\\">\\n        <strong id=\\\"myth-title\\\">Myth — Willpower wins</strong>\\n        <p class=\\\"small\\\">People assume motivation alone sustains change.</p>\\n        <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">Truth: durable change is engineered by small, repeated practice, environment design, and measurement.</p>\\n      </div>\\n      <div class=\\\"item\\\">\\n        <strong>Myth — One-size coaching</strong>\\n        <p class=\\\"small\\\">Coaching that copies a template rarely lasts.</p>\\n        <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">Truth: personalized habit micro-experiments produce replicable outcomes across contexts.</p>\\n      </div>\\n      <div class=\\\"item\\\">\\n        <strong>Myth — Quick fixes</strong>\\n        <p class=\\\"small\\\">Rapid fad solutions produce temporary wins.</p>\\n        <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">Truth: incremental systems beat short-term hacks for long-term resilience.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"pillars\\\" aria-labelledby=\\\"pillars-title\\\">\\n      <div class=\\\"p\\\"><strong id=\\\"pillars-title\\\">Framework: 4 Pillars I Use</strong>\\n        <ol class=\\\"small\\\" style=\\\"margin:8px 0 0;padding-left:16px;color:var(--muted)\\\">\\n          <li>Baseline mapping — measure current routines</li>\\n          <li>Micro-experimentation — 1 variable at a time</li>\\n          <li>Environmental scaffolding — reduce friction</li>\\n          <li>Review & adjustment — data-informed cadence</li>\\n        </ol>\\n      </div>\\n      <div class=\\\"p\\\">\\n        <strong>What you get</strong>\\n        <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">Templates, a habit tracker, and a reproducible review workflow that you can carry forward after the program ends.</p>\\n      </div>\\n      <div class=\\\"p\\\">\\n        <strong>Guarantee</strong>\\n        <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">If you complete the recommended plan and the process is followed, we rework the plan for one month at no additional charge to better align outcomes.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px;padding:18px;background:rgba(255,255,255,0.02);border-radius:12px\\\">\\n      <h3 style=\\\"margin:0 0 8px;color:#fff\\\">Want a shorter primer first?</h3>\\n      <p class=\\\"small\\\" style=\\\"margin:0 0 12px\\\">Grab the \\\"7 Evidence-Based Habits Starter Pack\\\" — a concise PDF to begin shaping routines today.</p>\\n      <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Get the Starter Pack</a>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:26px\\\">\\n        <div class=\\\"small\\\">© {{BUSINESS_NAME}} · {{CITY}}, {{STATE}} · <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n        <div class=\\\"small\\\">Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a></div>\\n      </div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Stories & Case Studies</title>\\n  <style>\\n    :root{--bg:#fff;--ink:#0b1220;--accent:#ff8a00;--muted:#6b7280}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:var(--ink);background:#fbfbfd}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 32px}\\n    .brand{font-weight:900;color:var(--ink)}\\n    nav a{color:var(--muted);margin-left:16px;text-decoration:none;font-weight:700}\\n    .wrap{max-width:1000px;margin:0 auto;padding:24px}\\n    .hero{padding:28px;background:linear-gradient(90deg,#fff7ed,#fffdf8);border-radius:12px;display:flex;gap:18px;align-items:center}\\n    .hero h1{margin:0 0 6px;font-size:26px}\\n    .hero p{margin:0;color:var(--muted)}\\n    .case-list{display:grid;grid-template-columns:1fr;gap:14px;margin-top:18px}\\n    .case{background:#fff;padding:16px;border-radius:10px;border:1px solid rgba(11,18,32,0.04);display:flex;gap:12px}\\n    .av{width:68px;height:68px;border-radius:10px;flex-shrink:0;display:grid;place-items:center;background:linear-gradient(180deg,#ffe3c7,#ffd9a8)}\\n    .case h3{margin:0;font-size:16px}\\n    .meta{color:var(--muted);font-size:13px}\\n    .metrics{margin-top:8px;color:#0b1220;font-weight:700}\\n    .quote{margin-top:10px;color:var(--muted)}\\n    .faq{margin-top:22px}\\n    .faq h4{margin:0 0 8px}\\n    .faq p{margin:0 0 12px;color:var(--muted)}\\n    .pillars{display:flex;gap:10px;margin-top:18px}\\n    .pillars .p{background:#fff;padding:12px;border-radius:8px;border:1px solid rgba(11,18,32,0.04)}\\n    .cta{margin-top:20px}\\n    @media(min-width:880px){.case-list{grid-template-columns:repeat(2,1fr)}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Philosophy</a>\\n      <a href=\\\"programs.html\\\">Programs</a>\\n      <a href=\\\"pricing.html\\\">Plans</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1>Real shifts, observed over measurable timeframes</h1>\\n        <p>Evidence-based coaching that tracks small behaviors until they become reliably automatic. Below: concise case studies and client reflections.</p>\\n      </div>\\n      <div style=\\\"width:120px;flex-shrink:0\\\">\\n        <!-- unique avatar svg for testimonials -->\\n        <svg viewBox=\\\"0 0 120 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n          <rect width=\\\"120\\\" height=\\\"120\\\" rx=\\\"20\\\" fill=\\\"#fff9f0\\\" />\\n          <g transform=\\\"translate(20,18)\\\">\\n            <circle cx=\\\"40\\\" cy=\\\"28\\\" r=\\\"18\\\" fill=\\\"#ffb380\\\" />\\n            <rect x=\\\"8\\\" y=\\\"58\\\" width=\\\"64\\\" height=\\\"22\\\" rx=\\\"8\\\" fill=\\\"#ffd9a8\\\" />\\n            <path d=\\\"M0 104 Q40 60 80 104\\\" stroke=\\\"#ffb380\\\" stroke-width=\\\"4\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/>\\n          </g>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"case-list\\\" aria-label=\\\"Case studies\\\">\\n      <article class=\\\"case\\\">\\n        <div class=\\\"av\\\" aria-hidden>\\n          <svg width=\\\"40\\\" height=\\\"40\\\" viewBox=\\\"0 0 40 40\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n            <circle cx=\\\"20\\\" cy=\\\"16\\\" r=\\\"8\\\" fill=\\\"#ff8a80\\\"/>\\n            <rect x=\\\"6\\\" y=\\\"26\\\" width=\\\"28\\\" height=\\\"8\\\" rx=\\\"4\\\" fill=\\\"#ffd9a8\\\"/>\\n          </svg>\\n        </div>\\n        <div>\\n          <h3>Case A — Focused Sleep Routine</h3>\\n          <div class=\\\"meta\\\">Client: young professional · 12 weeks</div>\\n          <div class=\\\"metrics\\\">Outcome: +35 min nightly sleep consistency • 3x fewer late-night device checks</div>\\n          <div class=\\\"quote\\\">\\\"We measured small wins each week and scaled what worked. It felt systematic, not ad-hoc.\\\"</div>\\n        </div>\\n      </article>\\n\\n      <article class=\\\"case\\\">\\n        <div class=\\\"av\\\">\\n          <svg width=\\\"40\\\" height=\\\"40\\\" viewBox=\\\"0 0 40 40\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n            <rect x=\\\"6\\\" y=\\\"6\\\" width=\\\"28\\\" height=\\\"28\\\" rx=\\\"6\\\" fill=\\\"#ffd7b5\\\"/>\\n            <circle cx=\\\"20\\\" cy=\\\"18\\\" r=\\\"6\\\" fill=\\\"#ff8a80\\\"/>\\n          </svg>\\n        </div>\\n        <div>\\n          <h3>Case B — Energy Management</h3>\\n          <div class=\\\"meta\\\">Client: parent & entrepreneur · 16 weeks</div>\\n          <div class=\\\"metrics\\\">Outcome: 22% increase in mid-week energy blocks • Streamlined 4 habits into one routine</div>\\n          <div class=\\\"quote\\\">\\\"The habit lab approach made trade-offs visible. Decisions became faster.\\\"</div>\\n        </div>\\n      </article>\\n\\n      <article class=\\\"case\\\">\\n        <div class=\\\"av\\\">\\n          <svg width=\\\"40\\\" height=\\\"40\\\" viewBox=\\\"0 0 40 40\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n            <circle cx=\\\"20\\\" cy=\\\"12\\\" r=\\\"10\\\" fill=\\\"#ffd9a8\\\" />\\n            <path d=\\\"M6 34 Q20 18 34 34\\\" stroke=\\\"#ff8a80\\\" stroke-width=\\\"3\\\" fill=\\\"none\\\"/>\\n          </svg>\\n        </div>\\n        <div>\\n          <h3>Case C — Midday Productivity</h3>\\n          <div class=\\\"meta\\\">Client: creative professional · 8 weeks</div>\\n          <div class=\\\"metrics\\\">Outcome: +2 focused hours per day • 50% reduction in context switching</div>\\n          <div class=\\\"quote\\\">\\\"The quantitative check-ins removed guesswork — we tracked what actually changed.\\\"</div>\\n        </div>\\n      </article>\\n\\n    </section>\\n\\n    <section class=\\\"pillars\\\" aria-label=\\\"Method pillars\\\">\\n      <div class=\\\"p\\\"><strong>Measurement-first</strong><p class=\\\"meta\\\">Start with a baseline and weekly micro-metrics.</p></div>\\n      <div class=\\\"p\\\"><strong>Low-friction experiments</strong><p class=\\\"meta\\\">Changes are small, reversible, and prioritized.</p></div>\\n      <div class=\\\"p\\\"><strong>Contextual design</strong><p class=\\\"meta\\\">Adjustments fit your schedule and environment.</p></div>\\n    </section>\\n\\n    <section class=\\\"faq\\\" aria-labelledby=\\\"faq-heading\\\">\\n      <h3 id=\\\"faq-heading\\\">Common questions from clients</h3>\\n      <div>\\n        <h4>How do you quantify progress?</h4>\\n        <p class=\\\"small\\\">We use simple, repeatable measures (minutes of consistent behavior, number of successful repetitions, and qualitative check-ins) to track trends, not absolutes.</p>\\n      </div>\\n      <div>\\n        <h4>Can I combine coaching with therapy?</h4>\\n        <p class=\\\"small\\\">Yes. Coaching here focuses on habits, structure, and behavior. Where deeper therapeutic work is needed, we coordinate with licensed professionals.</p>\\n      </div>\\n      <div>\\n        <h4>What kind of clients see the biggest gains?</h4>\\n        <p class=\\\"small\\\">People committed to small experiments and consistent measurement—professionals, caregivers, and creatives—report steady, compounding results.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"cta\\\">\\n      <p class=\\\"small\\\">Ready to test a habit lab in your life? Book a short discovery chat to outline a 30-day experiment.</p>\\n      <a style=\\\"display:inline-block;margin-top:8px;padding:10px 16px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none;font-weight:800\\\" href=\\\"book.html\\\">Book a Discovery Session</a>\\n    </section>\\n\\n    <footer style=\\\"margin-top:28px;color:var(--muted);font-size:13px\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> · {{BUSINESS_NAME}} · {{CITY}}, {{STATE}}</footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Book · {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0b1220;--card:#fff;--accent:#22c55e;--muted:#94a3b8}\\n    body{margin:0;background:linear-gradient(180deg,#071019,#0b1220);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:var(--card)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 28px}\\n    .brand{font-weight:900}\\n    nav a{color:var(--muted);margin-left:14px;text-decoration:none}\\n    .wrap{max-width:900px;margin:24px auto;padding:20px}\\n    .panel{background:rgba(255,255,255,0.03);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.04)}\\n    h1{margin:0 0 6px;font-size:22px}\\n    p.lead{margin:0 0 12px;color:var(--muted)}\\n    form{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}\\n    label{font-size:13px;color:var(--muted)}\\n    input,textarea,select{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.06);background:transparent;color:var(--card)}\\n    textarea{grid-column:1 / -1;min-height:120px}\\n    .submit{grid-column:1 / -1;margin-top:8px;background:var(--accent);color:#062018;padding:12px;border-radius:10px;border:none;font-weight:800}\\n    .meta{margin-top:14px;color:var(--muted);font-size:13px}\\n    .mini-sections{display:flex;gap:12px;margin-top:16px}\\n    .mini{flex:1;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:12px;border-radius:10px}\\n    .hesitations{margin-top:14px;display:flex;gap:10px}\\n    .hesitations .item{flex:1;padding:10px;border-radius:8px;background:rgba(255,255,255,0.02)}\\n    .svg-cal{width:120px;height:120px}\\n    @media(max-width:720px){form{grid-template-columns:1fr}textarea{min-height:100px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Overview</a>\\n      <a href=\\\"programs.html\\\">Work With Me</a>\\n      <a href=\\\"testimonials.html\\\">Stories</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"panel\\\">\\n      <div style=\\\"display:flex;gap:16px;align-items:center\\\">\\n        <div style=\\\"flex:1\\\">\\n          <h1>Book a 30-minute discovery session</h1>\\n          <p class=\\\"lead\\\">A focused, data-oriented conversation to outline a first micro-experiment and measurement plan with {{COACH_NAME}}, {{CREDENTIALS}}.</p>\\n          <p class=\\\"meta\\\">We respect your time: the session includes a short preparatory worksheet and a follow-up summary with next steps.</p>\\n        </div>\\n\\n        <div>\\n          <!-- unique pattern svg for booking -->\\n          <svg class=\\\"svg-cal\\\" viewBox=\\\"0 0 120 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n            <rect width=\\\"120\\\" height=\\\"120\\\" rx=\\\"18\\\" fill=\\\"#08321a\\\" />\\n            <g fill=\\\"#065f33\\\">\\n              <rect x=\\\"14\\\" y=\\\"18\\\" width=\\\"92\\\" height=\\\"74\\\" rx=\\\"8\\\" />\\n              <rect x=\\\"22\\\" y=\\\"28\\\" width=\\\"12\\\" height=\\\"8\\\" rx=\\\"2\\\" fill=\\\"#07a05b\\\" />\\n              <rect x=\\\"86\\\" y=\\\"28\\\" width=\\\"12\\\" height=\\\"8\\\" rx=\\\"2\\\" fill=\\\"#07a05b\\\" />\\n            </g>\\n            <g fill=\\\"#0bdc78\\\">\\n              <circle cx=\\\"34\\\" cy=\\\"62\\\" r=\\\"6\\\" />\\n              <circle cx=\\\"60\\\" cy=\\\"62\\\" r=\\\"6\\\" />\\n              <circle cx=\\\"86\\\" cy=\\\"62\\\" r=\\\"6\\\" />\\n            </g>\\n          </svg>\\n        </div>\\n      </div>\\n\\n      <form id=\\\"booking-form\\\" onsubmit=\\\"handleSubmit(event)\\\">\\n        <div>\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" required />\\n        </div>\\n        <div>\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required />\\n        </div>\\n        <div>\\n          <label for=\\\"phone\\\">Phone (optional)</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" />\\n        </div>\\n        <div>\\n          <label for=\\\"goal\\\">Priority to discuss</label>\\n          <select id=\\\"goal\\\" name=\\\"goal\\\">\\n            <option>Improve daily energy & focus</option>\\n            <option>Build a lasting morning routine</option>\\n            <option>Reduce decision fatigue</option>\\n            <option>Other: specify below</option>\\n          </select>\\n        </div>\\n        <textarea id=\\\"notes\\\" name=\\\"notes\\\" placeholder=\\\"Any context or constraints to share (work hours, caregiving, travel)...\\\"></textarea>\\n        <button class=\\\"submit\\\" type=\\\"submit\\\">Reserve my slot</button>\\n      </form>\\n\\n      <div class=\\\"mini-sections\\\">\\n        <div class=\\\"mini\\\">\\n          <strong>Session flow</strong>\\n          <p class=\\\"meta\\\" style=\\\"margin-top:8px\\\">10-min baseline review • 15-min targeted plan • 5-min next-step checklist and metrics.</p>\\n        </div>\\n        <div class=\\\"mini\\\">\\n          <strong>What I prepare</strong>\\n          <p class=\\\"meta\\\" style=\\\"margin-top:8px\\\">A concise worksheet and a suggested 7-day micro-experiment tailored to your context.</p>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"hesitations\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"item\\\">\\n          <strong>Concern: \\\"I don't have time\\\"</strong>\\n          <p class=\\\"meta\\\">We design the experiment to fit within your existing day — often 5–15 minutes per task.</p>\\n        </div>\\n        <div class=\\\"item\\\">\\n          <strong>Concern: \\\"Will this be science-y?\\\"</strong>\\n          <p class=\\\"meta\\\">Yes. We favor small samples and weekly measurements, not vague commitments.</p>\\n        </div>\\n      </div>\\n\\n      <p class=\\\"meta\\\" style=\\\"margin-top:12px\\\">If you'd rather schedule by phone, call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--card);text-decoration:underline\\\">{{EMAIL}}</a>.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:16px;display:flex;gap:12px;align-items:flex-start\\\">\\n      <div style=\\\"flex:1\\\" class=\\\"panel\\\">\\n        <h3 style=\\\"margin:0 0 6px\\\">Preparation worksheet (sent after booking)</h3>\\n        <p class=\\\"meta\\\">A one-page baseline tracker, a short habit clarity exercise, and a 7-day activity log to start measurement immediately.</p>\\n      </div>\\n\\n      <div style=\\\"width:260px\\\" class=\\\"panel\\\">\\n        <h4 style=\\\"margin:0 0 6px\\\">Refund & reschedule</h4>\\n        <p class=\\\"meta\\\">You may reschedule up to 24 hours before. If the session is unused and the plan was followed, we'll offer a one-time rework session.</p>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <script>\\n    function handleSubmit(e){\\n      e.preventDefault();\\n      // lightweight client-side confirmation (no external services)\\n      var name = document.getElementById('name').value || 'there';\\n      alert('Thanks, ' + name + '. We received your request and will follow up at the email you provided.');\\n      document.getElementById('booking-form').reset();\\n      location.href = \\\"{{PRIMARY_CTA_URL}}\\\";\\n    }\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
