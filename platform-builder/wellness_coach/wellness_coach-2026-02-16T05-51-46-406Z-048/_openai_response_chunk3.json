          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Investment & Pathways</title>\\n  <style>\\n    :root{--bg:#fff8f2;--muted:#7a5a3c;--accent:#c07a4b;--card:#fff4eb;--glass:rgba(255,255,255,0.6);--radius:14px;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg),#fff);color:var(--muted);-webkit-font-smoothing:antialiased}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 36px}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 10px;font-weight:600}\\n    .wrap{max-width:980px;margin:30px auto;padding:0 24px}\\n    .hero{display:flex;gap:28px;align-items:center;background:var(--card);padding:32px;border-radius:18px;box-shadow:0 6px 24px rgba(0,0,0,0.06)}\\n    .hero .left{flex:1}\\n    h1{margin:0 0 8px;font-size:28px;color:#4b2f1f}\\n    p.lead{margin:0 0 18px;color:#6b4e3b}\\n    .hero img{width:220px;height:auto;border-radius:12px}\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}\\n    .card{background:linear-gradient(180deg,#fff,#fff9f2);padding:18px;border-radius:12px;border:1px solid rgba(120,90,60,0.06)}\\n    .price{font-size:20px;color:var(--accent);font-weight:700}\\n    .list{margin:10px 0 14px;padding-left:18px;color:#5c432f}\\n    .cta{display:inline-block;margin-top:8px;padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none}\\n    .small{font-size:13px;color:#8a6f5a}\\n    footer{padding:28px 36px;text-align:center;color:#8a6f5a}\\n    .meta{display:flex;gap:12px;align-items:center;font-size:14px}\\n    .grid{display:grid;grid-template-columns:1fr 340px;gap:20px;margin-top:26px}\\n    .faq{background:var(--glass);padding:16px;border-radius:12px}\\n    .programs .prog{background:linear-gradient(180deg,#fff8f3,#fff2ea);padding:12px;border-radius:12px;margin-bottom:12px}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}.tiers{grid-template-columns:1fr}.hero{flex-direction:column}.hero img{width:100%}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"logo\\\" style=\\\"width:48px;height:48px;border-radius:10px\\\">\\n      <div style=\\\"font-weight:800;color:#5b3a2a\\\">{{BUSINESS_NAME}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"about.html\\\">Who I Am</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"testimonials.html\\\">Stories</a>\\n      <a href=\\\"book.html\\\" style=\\\"background:var(--accent);color:#fff;padding:8px 12px;border-radius:10px;text-decoration:none\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\" aria-label=\\\"Investment hero\\\">\\n      <div class=\\\"left\\\">\\n        <h1>Investment & Pathways</h1>\\n        <p class=\\\"lead\\\">Choose a coaching track designed to shift daily habits into lasting wellbeing. Clear outcomes, steady steps, hybrid support (live + digital).</p>\\n        <div class=\\\"meta\\\"><span class=\\\"small\\\">Lead coach:</span><strong style=\\\"color:#4b2f1f\\\">{{COACH_NAME}}, {{CREDENTIALS}}</strong></div>\\n      </div>\\n      <img src=\\\"assets/img/hero.svg\\\" alt=\\\"organic hero illustration\\\">\\n    </section>\\n\\n    <div class=\\\"grid\\\">\\n      <div>\\n        <section style=\\\"margin-top:20px\\\">\\n          <h2 style=\\\"color:#4b2f1f\\\">Pathways built around habits</h2>\\n          <p class=\\\"small\\\">Each pathway blends habit design, accountability, and gentle systems so you leave with tools — not just motivation. Sessions combine video calls, short weekly check-ins, and a personalized habit roadmap.</p>\\n\\n          <div class=\\\"tiers\\\" role=\\\"list\\\">\\n            <div class=\\\"card\\\" role=\\\"listitem\\\">\\n              <h3 style=\\\"margin:0 0 6px;color:#603a29\\\">Seed Plan — Start Smart</h3>\\n              <div class=\\\"price\\\">$250 / month</div>\\n              <ul class=\\\"list\\\">\\n                <li>4x 30-min check-ins / month</li>\\n                <li>Weekly habit tracker + 1 micro-goal</li>\\n                <li>Email support</li>\\n              </ul>\\n              <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Begin with Seed</a>\\n            </div>\\n\\n            <div class=\\\"card\\\">\\n              <h3 style=\\\"margin:0 0 6px;color:#603a29\\\">Bloom Plan — Momentum</h3>\\n              <div class=\\\"price\\\">$650 / month</div>\\n              <ul class=\\\"list\\\">\\n                <li>2x 60-min sessions + 2 check-ins</li>\\n                <li>Custom habit framework & guides</li>\\n                <li>Priority messaging</li>\\n              </ul>\\n              <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Create Momentum</a>\\n            </div>\\n\\n            <div class=\\\"card\\\">\\n              <h3 style=\\\"margin:0 0 6px;color:#603a29\\\">Thrive Immersion — Deep Reset</h3>\\n              <div class=\\\"price\\\">$3,000 (3 months)</div>\\n              <ul class=\\\"list\\\">\\n                <li>Weekly 75-min sessions + daily check-ins</li>\\n                <li>Retreat-style 2-day workshop (virtual or local)</li>\\n                <li>Full habit + routine redesign</li>\\n              </ul>\\n              <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Apply for Thrive</a>\\n            </div>\\n          </div>\\n        </section>\\n\\n        <section style=\\\"margin-top:22px\\\">\\n          <h3 style=\\\"color:#4b2f1f\\\">What's included across plans</h3>\\n          <ul class=\\\"small\\\" style=\\\"padding-left:18px\\\">\\n            <li>Practical habit templates and micro-actions</li>\\n            <li>Weekly reflection prompts to build awareness</li>\\n            <li>Access to a resource library and worksheets</li>\\n          </ul>\\n        </section>\\n\\n        <section style=\\\"margin-top:22px\\\">\\n          <h3 style=\\\"color:#4b2f1f\\\">Funding & flexible options</h3>\\n          <p class=\\\"small\\\">Sliding scale and payment plans are available for the Bloom Plan. Scholarships are selectively offered for the Thrive Immersion. Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> to inquire.</p>\\n        </section>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"faq\\\">\\n          <h4 style=\\\"margin-top:0;color:#4b2f1f\\\">Common investment questions</h4>\\n          <details style=\\\"margin-top:8px\\\"><summary style=\\\"cursor:pointer\\\">How do I know which plan fits me?</summary><p class=\\\"small\\\">We start with a 20-minute clarity call to match your goals to a path. That call is complimentary — book below.</p></details>\\n          <details style=\\\"margin-top:8px\\\"><summary style=\\\"cursor:pointer\\\">Can I switch plans mid-way?</summary><p class=\\\"small\\\">Yes. Most clients move from Seed to Bloom after 6–8 weeks when habits stabilize.</p></details>\\n          <details style=\\\"margin-top:8px\\\"><summary style=\\\"cursor:pointer\\\">Do you offer corporate or group rates?</summary><p class=\\\"small\\\">I offer small-group cohort pricing for teams — contact <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> for a proposal.</p></details>\\n        </div>\\n\\n        <div style=\\\"margin-top:16px;background:linear-gradient(180deg,#fffefb,#fff7f0);padding:14px;border-radius:12px\\\">\\n          <h4 style=\\\"margin:0 0 6px;color:#4b2f1f\\\">Sample week — Bloom Plan</h4>\\n          <p class=\\\"small\\\">A 60-min session (goal-setting) + mid-week check-in + short reflection prompts. Micro-actions to practice each day.</p>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a Clarity Call</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:28px\\\">\\n      <h2 style=\\\"color:#4b2f1f\\\">Tiny experiments, steady change</h2>\\n      <p class=\\\"small\\\">All pathways use a simple three-part framework: Notice → Design → Repeat. We translate big intentions into bite-sized habits you can keep.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"color:#4b2f1f\\\">A few program snapshots</h3>\\n      <div class=\\\"programs\\\" style=\\\"margin-top:10px\\\">\\n        <div class=\\\"prog\\\"><strong>Roots Path</strong> — 8-week foundation for daily rhythms and energy design.</div>\\n        <div class=\\\"prog\\\"><strong>Growth Path</strong> — 12-week accountability track with priority messaging and weekly sessions.</div>\\n        <div class=\\\"prog\\\"><strong>Harbor Sessions</strong> — Single-session resets to clarify a habit cycle and re-center routines.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h3 style=\\\"color:#4b2f1f\\\">Still deciding? Get the quick guide</h3>\\n      <p class=\\\"small\\\">Download the free \\\"7 Micro-Habits for Sustainable Energy\\\" guide when you book a clarity call. A simple, practical lead magnet that previews my approach.</p>\\n      <a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve your clarity call</a>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"small\\\">Questions? Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    <div style=\\\"margin-top:8px;color:#b68e6b\\\">Serving {{CITY}}, {{STATE}} — {{COACH_NAME}}, {{CREDENTIALS}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Client Wins — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff9f5;--text:#5a3f2e;--accent:#b86f45;--card:#fff6ef}\\n    body{margin:0;background:var(--bg);font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--text)}\\n    header{padding:22px 28px;display:flex;justify-content:space-between;align-items:center}\\n    header nav a{margin:0 10px;text-decoration:none;color:var(--text);font-weight:600}\\n    .container{max-width:1000px;margin:18px auto;padding:0 20px}\\n    .lead{background:linear-gradient(180deg,#fff,#fff4ec);padding:18px;border-radius:16px;display:flex;gap:18px;align-items:center}\\n    .lead img{width:88px;height:88px;border-radius:14px}\\n    h1{margin:0;font-size:26px}\\n    .masonry{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:18px}\\n    .story{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 6px 18px rgba(0,0,0,0.04)}\\n    .quote{font-style:italic;color:#3f2a20}\\n    .meta{font-size:13px;color:#8b6b55}\\n    .cta{display:inline-block;padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none;margin-top:10px}\\n    footer{padding:22px;text-align:center;color:#8b6b55}\\n    @media(max-width:880px){.masonry{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"logo\\\" style=\\\"width:44px;height:44px;border-radius:10px\\\">\\n      <strong style=\\\"color:#5b3a2a\\\">{{BUSINESS_NAME}}</strong>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Welcome</a>\\n      <a href=\\\"about.html\\\">My Story</a>\\n      <a href=\\\"programs.html\\\">Programs</a>\\n      <a href=\\\"testimonials.html\\\">Praise</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"lead\\\">\\n      <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"coach avatar\\\">\\n      <div>\\n        <h1>Client Wins & Stories</h1>\\n        <p class=\\\"meta\\\">Real habits. Real days changed. Honest notes from people who built sustainable routines with my hybrid coaching approach.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin:0 0 8px;color:#5b3a2a\\\">Small experiments, big impact</h2>\\n      <p class=\\\"meta\\\">Below are condensed snapshots — what the challenge was, the micro-habit we tested, and the measurable difference over 6–12 weeks.</p>\\n    </section>\\n\\n    <div class=\\\"masonry\\\">\\n      <article class=\\\"story\\\">\\n        <p class=\\\"quote\\\">\\\"I used to hit snooze four times. We swapped one big goal for a single tiny ritual. Three weeks later I’m up before my kids and actually have time for tea — and I'm less rushed all day.\\\"</p>\\n        <div class=\\\"meta\\\">— Maya, 34 • Seed Plan → Roots Path</div>\\n      </article>\\n\\n      <article class=\\\"story\\\">\\n        <p class=\\\"quote\\\">\\\"After struggling with afternoon energy slumps, the Growth Path gave me a three-step reset I can do at my desk. My weekly productivity rose and I actually enjoy afternoons now.\\\"</p>\\n        <div class=\\\"meta\\\">— Daniel, 42 • Bloom Plan</div>\\n      </article>\\n\\n      <article class=\\\"story\\\">\\n        <p class=\\\"quote\\\">\\\"The Thrive Immersion helped me redesign my evenings. Less decision fatigue, better sleep. The best part: the system feels realistic for my family.\\\"</p>\\n        <div class=\\\"meta\\\">— Priya, 29 • Thrive Immersion</div>\\n      </article>\\n\\n      <article class=\\\"story\\\">\\n        <p class=\\\"quote\\\">\\\"Practical templates and short weekly check-ins kept me honest. Small commitments, steady wins — my stress is lower and my routines actually stick.\\\"</p>\\n        <div class=\\\"meta\\\">— Jorge, 37 • Harbor Sessions + Bloom follow-up</div>\\n      </article>\\n    </div>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h3 style=\\\"color:#5b3a2a\\\">Snapshot case: Anna</h3>\\n      <p class=\\\"meta\\\">Challenge: Overwhelm and inconsistent meals. Micro-solution: 14-day meal rhythm + 3 easy grocery swaps. Outcome: Improved energy variance and fewer skipped meals in 6 weeks.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"color:#5b3a2a\\\">Want stories relevant to your goals?</h3>\\n      <p class=\\\"meta\\\">Tell me what you’re aiming for and I’ll send three client stories that match your priorities: energy, sleep, or routine design.</p>\\n      <a class=\\\"cta\\\" href=\\\"book.html\\\">Send me relevant wins</a>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>Curious about the approach? Call <strong>{{PHONE}}</strong> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    <div style=\\\"margin-top:8px\\\">Serving {{CITY}}, {{STATE}} — {{COACH_NAME}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffaf6;--text:#5a3d2b;--accent:#c5774e}\\n    body{margin:0;background:var(--bg);font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--text)}\\n    header{padding:20px 26px;display:flex;justify-content:space-between;align-items:center}\\n    header a{color:var(--text);text-decoration:none;font-weight:700}\\n    .wrap{max-width:860px;margin:18px auto;padding:0 20px}\\n    .hero{background:linear-gradient(180deg,#fff9f3,#fff4eb);padding:16px;border-radius:14px;display:flex;gap:14px;align-items:center}\\n    .hero img{width:96px;height:96px;border-radius:12px}\\n    h1{margin:0;font-size:24px}\\n    .form{margin-top:16px;background:#fff;padding:16px;border-radius:12px;box-shadow:0 8px 28px rgba(0,0,0,0.06)}\\n    label{display:block;margin:10px 0 6px;font-weight:600}\\n    input,textarea,select{width:100%;padding:10px;border-radius:8px;border:1px solid #edd3bc}\\n    button{background:var(--accent);color:#fff;border:none;padding:10px 14px;border-radius:10px;font-weight:700;margin-top:12px}\\n    .note{font-size:13px;color:#7a5a44;margin-top:6px}\\n    .mini{display:flex;gap:12px;margin-top:12px}\\n    .mini a{background:#fff;border-radius:10px;padding:8px 12px;text-decoration:none;color:var(--text);border:1px solid rgba(180,120,80,0.12)}\\n    footer{padding:18px;text-align:center;color:#8b6b55}\\n    @media(max-width:720px){.hero{flex-direction:column;align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"logo\\\" style=\\\"width:44px;height:44px;border-radius:10px\\\">\\n      <a href=\\\"index.html\\\">{{BUSINESS_NAME}}</a>\\n    </div>\\n    <nav>\\n      <a href=\\\"programs.html\\\">Programs</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"testimonials.html\\\">Stories</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"coach avatar\\\">\\n      <div>\\n        <h1>Reserve Your Breakthrough Session</h1>\\n        <p class=\\\"note\\\">Start with a 20-minute clarity call to map a realistic first month. No pressure — practical next steps and a free guide when you book.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"form\\\" aria-labelledby=\\\"booking-form\\\">\\n      <h2 id=\\\"booking-form\\\" style=\\\"margin-top:0;color:#5b3a2a\\\">Book a clarity call</h2>\\n      <form action=\\\"mailto:{{EMAIL}}\\\" method=\\\"post\\\" enctype=\\\"text/plain\\\">\\n        <label for=\\\"name\\\">Your name</label>\\n        <input id=\\\"name\\\" name=\\\"name\\\" required>\\n\\n        <label for=\\\"email\\\">Email</label>\\n        <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required>\\n\\n        <label for=\\\"phone\\\">Phone (optional)</label>\\n        <input id=\\\"phone\\\" name=\\\"phone\\\">\\n\\n        <label for=\\\"goal\\\">What would you like to change in the next 6 weeks?</label>\\n        <textarea id=\\\"goal\\\" name=\\\"goal\\\" rows=\\\"4\\\" placeholder=\\\"Energy, sleep, daily routine...\\\" required></textarea>\\n\\n        <label for=\\\"session\\\">Choose session type</label>\\n        <select id=\\\"session\\\" name=\\\"session\\\">\\n          <option>20-min Clarity Call (complimentary)</option>\\n          <option>Starter Session — 45 min</option>\\n          <option>Deep Reset — 75 min</option>\\n        </select>\\n\\n        <button type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n        <p class=\\\"note\\\">By booking you consent to short email follow-ups. Your info stays private.</p>\\n      </form>\\n\\n      <div class=\\\"mini\\\">\\n        <a href=\\\"pricing.html\\\">See Investment Options</a>\\n        <a href=\\\"testimonials.html\\\">Read Client Stories</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"color:#5b3a2a\\\">What to expect</h3>\\n      <p class=\\\"note\\\">In the clarity call we’ll map one micro-habit and a 3-step plan. You’ll leave with a small experiment to try for a week and a clear next step — a Starter Session or the Bloom track, if you want continued support.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:12px\\\">\\n      <h3 style=\\\"color:#5b3a2a\\\">Quick FAQ</h3>\\n      <details style=\\\"margin-top:8px\\\"><summary style=\\\"cursor:pointer\\\">Is the call really free?</summary><p class=\\\"note\\\">Yes — the 20-minute clarity call is complimentary and a chance to see if we’re a good fit.</p></details>\\n      <details style=\\\"margin-top:8px\\\"><summary style=\\\"cursor:pointer\\\">How soon can we start?</summary><p class=\\\"note\\\">Most clarity calls are scheduled within 3–10 days. If you need something sooner, email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</p></details>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>Questions? Call {{PHONE}} — or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    <div style=\\\"margin-top:8px\\\">Proudly serving {{CITY}}, {{STATE}} — {{COACH_NAME}}</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
