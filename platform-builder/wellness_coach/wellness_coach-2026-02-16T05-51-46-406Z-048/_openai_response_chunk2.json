          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} — About</title>\\n  <style>\\n    :root{--bg:#F6EFE8;--earth:#6B4226;--warm:#DFAE8D;--leaf:#8CA68C;--muted:#7B6B5A;--card:#FFFFFF}\\n    *{box-sizing:border-box}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--earth);margin:0;background:var(--bg);line-height:1.5}\\n    .container{max-width:980px;margin:40px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:54px;height:54px;border-radius:12px;background:linear-gradient(135deg,var(--warm),var(--leaf));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    .hero{display:grid;grid-template-columns:1fr 320px;gap:28px;margin-top:28px;align-items:center}\\n    .hero-card{background:var(--card);padding:24px;border-radius:14px;box-shadow:0 6px 18px rgba(107,66,38,0.08)}\\n    .hero h1{margin:0 0 10px;font-size:28px}\\n    .hero p{margin:0 0 18px;color:var(--muted)}\\n    .cta{display:inline-block;background:var(--earth);color:#fff;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .aside{background:linear-gradient(180deg,rgba(140,166,140,0.08),transparent);padding:20px;border-radius:12px}\\n    .meta{font-size:13px;color:var(--muted);margin-top:8px}\\n    section{margin-top:28px}\\n    .split{display:grid;grid-template-columns:1fr 1fr;gap:18px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 14px rgba(107,66,38,0.06)}\\n    .framework-list{display:flex;flex-direction:column;gap:12px;margin-top:12px}\\n    .pill{display:inline-block;padding:6px 10px;border-radius:999px;background:var(--warm);color:#fff;font-weight:700}\\n    footer{margin-top:40px;padding:18px;text-align:center;color:var(--muted)}\\n    .testimonials{display:flex;gap:12px;flex-wrap:wrap}\\n    .testimonial{flex:1 1 280px;padding:14px;border-radius:10px;background:linear-gradient(180deg,#fff, #FBF7F4)}\\n    .contact-cta{display:flex;gap:12px;align-items:center;justify-content:center;margin-top:20px}\\n    .small{font-size:13px}\\n  </style>\\n</head>\\n<body>\\n  <div class='container'>\\n    <header>\\n      <div class='brand'>\\n        <div class='logo'>WC</div>\\n        <div>\\n          <div style='font-weight:800'>{{BUSINESS_NAME}}</div>\\n          <div class='small' style='color:var(--muted)'>{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href='index.html'>Home</a>\\n        <a href='services.html'>Work With Me</a>\\n        <a href='programs.html'>Paths</a>\\n        <a href='pricing.html'>Pricing</a>\\n        <a href='testimonials.html'>Praise</a>\\n        <a href='book.html'>Book</a>\\n        <a href='contact.html'>Contact</a>\\n      </nav>\\n    </header>\\n\\n    <!-- Hero (About variant) -->\\n    <div class='hero'>\\n      <div class='hero-card'>\\n        <h1>Meet {{COACH_NAME}} — a practical guide to steady change</h1>\\n        <p>I combine habit design, gentle accountability, and realistic routines to help you create energy, clarity and sustainable daily rhythms. Hybrid coaching: online tools + local sessions in {{CITY}}, {{STATE}}.</p>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n        <div class='meta'>Credentials: {{CREDENTIALS}} • <a href='tel:{{PHONE}}'>{{PHONE}}</a> • <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a></div>\\n      </div>\\n      <aside class='aside'>\\n        <svg width='100%' height='120' viewBox='0 0 200 120' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n          <defs><linearGradient id='g' x1='0' x2='1'><stop offset='0' stop-color='#DFAE8D'/><stop offset='1' stop-color='#8CA68C'/></linearGradient></defs>\\n          <rect rx='16' width='200' height='120' fill='url(#g)' />\\n          <g fill='rgba(255,255,255,0.9)'>\\n            <circle cx='40' cy='40' r='10'/>\\n            <circle cx='80' cy='70' r='6'/>\\n            <rect x='110' y='30' width='60' height='14' rx='6'/>\\n          </g>\\n        </svg>\\n        <div style='margin-top:12px;font-weight:700'>Local + Remote</div>\\n        <div class='small' style='color:var(--muted);margin-top:8px'>Tailored session plans and a private habit-tracker. Works alongside your calendar, not against it.</div>\\n      </aside>\\n    </div>\\n\\n    <!-- Personal Story -->\\n    <section>\\n      <h2>Why this work matters — a personal arc</h2>\\n      <div class='split'>\\n        <div class='card'>\\n          <p style='margin-top:0'>I started coaching because I saw smart, busy people trade joy for busyness. My approach grew from experimenting with small habits, which led to better sleep, clearer focus, and more reliable energy — without extreme routines.</p>\\n          <p class='small' style='color:var(--muted)'>This journey led to a hybrid method: digital tools for consistency + in-person rhythm checks.</p>\\n        </div>\\n        <div class='card'>\\n          <h3 style='margin-top:0'>Background</h3>\\n          <ul style='margin:6px 0 0 18px;color:var(--muted)'>\\n            <li>{{CREDENTIALS}}</li>\\n            <li>Years of coaching across workplace and wellness groups</li>\\n            <li>Sessions in {{CITY}}, {{STATE}} and virtual globally</li>\\n          </ul>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Framework -->\\n    <section>\\n      <h2>My HABIT-FOCUSED Framework</h2>\\n      <div class='framework-list'>\\n        <div class='card'>\\n          <div style='display:flex;justify-content:space-between;align-items:center'>\\n            <div>\\n              <div class='pill'>ROOT</div>\\n              <h4 style='margin:8px 0 4px'>Start with a single meaningful habit</h4>\\n              <div class='small' style='color:var(--muted)'>Pick one anchor that moves the needle. We scaffold from there.</div>\\n            </div>\\n          </div>\\n        </div>\\n        <div class='card'>\\n          <div class='pill'>RHYTHM</div>\\n          <h4 style='margin:8px 0 4px'>Build weekly rhythms, not daily perfection</h4>\\n          <div class='small' style='color:var(--muted)'>Small wins compound when the schedule supports them.</div>\\n        </div>\\n        <div class='card'>\\n          <div class='pill'>REFLECT</div>\\n          <h4 style='margin:8px 0 4px'>Measure progress, then iterate</h4>\\n          <div class='small' style='color:var(--muted)'>Weekly check-ins and simple metrics keep momentum honest and kind.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Programs teaser -->\\n    <section>\\n      <h2>Programs — a quick tour</h2>\\n      <div style='display:flex;gap:12px;flex-wrap:wrap;margin-top:12px'>\\n        <div class='card' style='flex:1 1 280px'>\\n          <strong>Foundations</strong>\\n          <div class='small' style='color:var(--muted)'>6-week starter plan for reclaiming baseline energy.</div>\\n        </div>\\n        <div class='card' style='flex:1 1 280px'>\\n          <strong>Momentum</strong>\\n          <div class='small' style='color:var(--muted)'>12-week hybrid coaching with weekly planning and monthly local meet-ups.</div>\\n        </div>\\n        <div class='card' style='flex:1 1 280px'>\\n          <strong>Sustain</strong>\\n          <div class='small' style='color:var(--muted)'>Ongoing monthly support for steady long-term gains.</div>\\n        </div>\\n      </div>\\n      <div style='margin-top:12px'><a href='programs.html' class='cta'>Explore full Paths</a></div>\\n    </section>\\n\\n    <!-- Pricing snapshot -->\\n    <section>\\n      <h2>Investment & value</h2>\\n      <div class='split'>\\n        <div class='card'>\\n          <strong>One-time Audit</strong>\\n          <p class='small' style='color:var(--muted)'>60-minute focused session to map priorities — ideal first step.</p>\\n        </div>\\n        <div class='card'>\\n          <strong>Packages</strong>\\n          <p class='small' style='color:var(--muted)'>See pricing page for per-program breakdown and payment options.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Testimonials snippet -->\\n    <section>\\n      <h2>Short notes from clients</h2>\\n      <div class='testimonials'>\\n        <div class='testimonial'>“I finally stopped bouncing between plans and built a week that works.” — A.</div>\\n        <div class='testimonial'>“Small nudges that add up. Realistic and compassionate.” — M.</div>\\n      </div>\\n    </section>\\n\\n    <!-- Call to Action -->\\n    <section>\\n      <div class='card' style='text-align:center'>\\n        <h3 style='margin-top:0'>Ready to try a different kind of progress?</h3>\\n        <div class='contact-cta'>\\n          <a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n          <a href='contact.html' style='color:var(--muted);text-decoration:none'>Ask a question</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}} • <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} — Services</title>\\n  <style>\\n    :root{--bg:#FFF8F2;--accent:#A46A44;--warm:#E7BBA3;--green:#7CA88A;--muted:#6C5B50}\\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;color:var(--accent);margin:0;background:var(--bg)}\\n    .wrap{max-width:1080px;margin:28px auto;padding:26px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .hero{background:linear-gradient(180deg,#fff, #FFF1E8);padding:22px;border-radius:16px;display:flex;gap:18px;align-items:center;margin-top:18px}\\n    .hero-left{flex:1}\\n    .hero h1{margin:0;font-size:26px}\\n    .hero p{color:var(--muted);margin-top:8px}\\n    .hero-right{width:160px}\\n    .service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:20px}\\n    .service{background:#fff;padding:14px;border-radius:12px;box-shadow:0 8px 18px rgba(164,106,68,0.06)}\\n    .service h3{margin:0 0 8px}\\n    .tag{display:inline-block;padding:6px 10px;border-radius:999px;background:var(--warm);color:#fff;font-weight:700}\\n    .framework{display:flex;gap:12px;align-items:center;margin-top:18px}\\n    .framework svg{width:68px;height:68px}\\n    .testimonial{margin-top:18px;padding:12px;background:linear-gradient(180deg,#FFF,#FFF6F0);border-radius:10px}\\n    .cta{display:inline-block;margin-top:12px;padding:8px 12px;background:var(--accent);color:#fff;border-radius:8px;text-decoration:none;font-weight:700}\\n    footer{margin-top:40px;text-align:center;color:var(--muted)}\\n    .small{font-size:13px;color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <div class='wrap'>\\n    <header>\\n      <div style='font-weight:800'>{{BUSINESS_NAME}}</div>\\n      <nav class='nav'>\\n        <a href='index.html'>Home</a>\\n        <a href='about.html'>Our Story</a>\\n        <a href='programs.html'>Paths</a>\\n        <a href='pricing.html'>Pricing</a>\\n        <a href='book.html'>Book</a>\\n        <a href='contact.html'>Contact</a>\\n      </nav>\\n    </header>\\n\\n    <!-- Hero (Services variant) -->\\n    <div class='hero'>\\n      <div class='hero-left'>\\n        <h1>Work With Me — practical packages for steady progress</h1>\\n        <p>Choose a coaching format that fits your life: private coaching, small group cohorts, or intensive workshops. Hybrid delivery—digital support plus in-person options in {{CITY}}, {{STATE}}.</p>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}'>Start a conversation</a>\\n        <div class='small' style='margin-top:8px'>Questions? <a href='mailto:{{EMAIL}}' style='color:var(--accent)'>{{EMAIL}}</a> • <a href='tel:{{PHONE}}' style='color:var(--accent)'>{{PHONE}}</a></div>\\n      </div>\\n      <div class='hero-right'>\\n        <svg viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n          <rect x='0' y='0' width='120' height='120' rx='18' fill='url(#s)' />\\n          <defs>\\n            <linearGradient id='s' x1='0' x2='1'><stop offset='0' stop-color='#E7BBA3'/><stop offset='1' stop-color='#7CA88A'/></linearGradient>\\n          </defs>\\n          <g fill='#fff' opacity='0.95'>\\n            <circle cx='36' cy='40' r='8'/>\\n            <rect x='56' y='30' rx='6' width='46' height='12'/>\\n            <rect x='24' y='68' width='72' height='18' rx='8'/>\\n          </g>\\n        </svg>\\n      </div>\\n    </div>\\n\\n    <!-- Services list -->\\n    <section>\\n      <h2 style='margin-top:22px'>Service formats</h2>\\n      <div class='service-grid'>\\n        <div class='service'>\\n          <div class='tag'>ONE-ON-ONE</div>\\n          <h3>Personal Coaching</h3>\\n          <p class='small'>Weekly or biweekly sessions. Custom habit plans, accountability and adaptive goal-setting. Best for focused life changes.</p>\\n        </div>\\n        <div class='service'>\\n          <div class='tag'>GROUP</div>\\n          <h3>Cohort Experience</h3>\\n          <p class='small'>6-10 people, structured curriculum, peer accountability. Great for launching new routines with social momentum.</p>\\n        </div>\\n        <div class='service'>\\n          <div class='tag'>INTENSIVE</div>\\n          <h3>Weekend Workshop</h3>\\n          <p class='small'>Concentrated planning retreat to create a 6-week starter plan and immediate next steps.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Framework deep dive -->\\n    <section>\\n      <h2 style='margin-top:22px'>How sessions unfold</h2>\\n      <div class='framework'>\\n        <svg viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'>\\n          <circle cx='40' cy='40' r='36' fill='#fff' stroke='#E7BBA3' stroke-width='4'/>\\n          <path d='M22 44c6-10 14-14 28-14' fill='none' stroke='#7CA88A' stroke-width='4' stroke-linecap='round' stroke-linejoin='round'/>\\n        </svg>\\n        <div>\\n          <h3 style='margin:0'>Mindful, measurable, and modular</h3>\\n          <p class='small' style='margin-top:6px;color:var(--muted)'>Sessions are practical: plan, practice, reflect. You leave with micro-actions and a way to track progress between meetings.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Programs crosslinking -->\\n    <section>\\n      <h2 style='margin-top:22px'>Program matchmaker</h2>\\n      <div style='display:flex;gap:12px;margin-top:12px'>\\n        <div class='service' style='flex:1'>\\n          <strong>Starter Sprint</strong>\\n          <p class='small' style='color:var(--muted)'>Quick wins over 6 weeks. Best for starting a new habit.</p>\\n        </div>\\n        <div class='service' style='flex:1'>\\n          <strong>Habit Builder</strong>\\n          <p class='small' style='color:var(--muted)'>12-week blended plan for sustained improvement.</p>\\n        </div>\\n        <div class='service' style='flex:1'>\\n          <strong>Steady Support</strong>\\n          <p class='small' style='color:var(--muted)'>Monthly check-ins and adaptive planning for long-term maintenance.</p>\\n        </div>\\n      </div>\\n      <div style='margin-top:12px'><a class='cta' href='programs.html'>See Paths & schedules</a></div>\\n    </section>\\n\\n    <!-- Pricing framing (service-oriented) -->\\n    <section>\\n      <h2 style='margin-top:22px'>Pricing philosophy</h2>\\n      <div class='small' style='color:var(--muted)'>I package services to maximize clarity and support. Transparent add-ons: extra check-ins, assessment audits, and small-group pricing. Detailed numbers are on the Pricing page.</div>\\n    </section>\\n\\n    <!-- Testimonials -->\\n    <section>\\n      <h2 style='margin-top:22px'>Client snapshots</h2>\\n      <div class='testimonial'>\\n        \\\"Practical, compassionate, and steady. I built habits that stuck without feeling rigid.\\\" — B.\\n      </div>\\n    </section>\\n\\n    <!-- CTA -->\\n    <section>\\n      <div style='margin-top:20px;padding:14px;border-radius:12px;background:#fff;box-shadow:0 10px 24px rgba(164,106,68,0.06);text-align:center'>\\n        <h3 style='margin:0'>Ready to pick a format?</h3>\\n        <div class='small' style='margin-top:8px;color:var(--muted)'>Free discovery call to find the right path.</div>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}' style='margin-top:12px;display:inline-block'>{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div class='small' style='margin-top:28px'>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href='mailto:{{EMAIL}}' style='color:var(--accent)'>{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} — Programs</title>\\n  <style>\\n    :root{--bg:#F9F7F5;--deep:#5A3727;--soft:#D9A98F;--highlight:#8FAF92;--muted:#6E5C50}\\n    body{font-family:Inter,ui-sans-serif,system-ui,Arial;color:var(--deep);margin:0;background:var(--bg)}\\n    .site{max-width:1100px;margin:36px auto;padding:24px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .hero{padding:18px;border-radius:14px;background:linear-gradient(180deg,#fff,#FFF7F2);display:flex;gap:18px;margin-top:18px}\\n    .hero h1{margin:0}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:20px}\\n    .path{background:#fff;padding:16px;border-radius:12px;box-shadow:0 8px 22px rgba(90,55,39,0.06)}\\n    .path h3{margin:0 0 8px}\\n    .attr{font-weight:700;color:var(--highlight);display:inline-block;padding:6px 10px;border-radius:999px}\\n    .features{margin-top:10px;color:var(--muted)}\\n    .pricing{margin-top:12px;font-size:20px;font-weight:800}\\n    .faq{margin-top:22px}\\n    .faq-item{background:#fff;padding:12px;border-radius:10px;margin-top:8px}\\n    .cta{display:inline-block;padding:9px 14px;background:var(--deep);color:#fff;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{margin-top:36px;text-align:center;color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <div class='site'>\\n    <header>\\n      <div style='font-weight:800'>{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href='index.html'>Home</a>\\n        <a href='about.html'>About</a>\\n        <a href='services.html'>Work With Me</a>\\n        <a href='pricing.html'>Pricing</a>\\n        <a href='book.html'>Book</a>\\n      </nav>\\n    </header>\\n\\n    <!-- Hero (Programs variant) -->\\n    <div class='hero'>\\n      <div style='flex:1'>\\n        <h1>Paths — curated programs for habit-first change</h1>\\n        <p style='margin:8px 0;color:var(--muted)'>Each Path combines weekly coaching, habit design tools, and group check-ins. Choose the rhythm that fits your life.</p>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n      <div style='width:140px'>\\n        <svg viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n          <rect rx='16' width='120' height='120' fill='url(#p)' />\\n          <defs><linearGradient id='p' x1='0' x2='1'><stop offset='0' stop-color='#D9A98F'/><stop offset='1' stop-color='#8FAF92'/></linearGradient></defs>\\n        </svg>\\n      </div>\\n    </div>\\n\\n    <!-- Programs list (unique names and structure) -->\\n    <section>\\n      <h2 style='margin-top:18px'>Choose your Path</h2>\\n      <div class='grid'>\\n        <div class='path'>\\n          <span class='attr'>Starter Sprint</span>\\n          <h3 style='margin-top:8px'>6-week launch</h3>\\n          <div class='features'>Weekly 45-min coaching • Habit tracker templates • Email check-ins</div>\\n          <div class='pricing'>$495 one-time</div>\\n          <div style='margin-top:10px'><a class='cta' href='book.html'>Reserve Starter</a></div>\\n        </div>\\n\\n        <div class='path'>\\n          <span class='attr'>Habit Builder</span>\\n          <h3 style='margin-top:8px'>12-week blended plan</h3>\\n          <div class='features'>Weekly 50-min sessions • Group follow-up calls • Personalized habit roadmap</div>\\n          <div class='pricing'>$1,150 (payment plans available)</div>\\n          <div style='margin-top:10px'><a class='cta' href='book.html'>Join Builder</a></div>\\n        </div>\\n\\n        <div class='path'>\\n          <span class='attr'>Sustain Plan</span>\\n          <h3 style='margin-top:8px'>Ongoing support</h3>\\n          <div class='features'>Monthly coaching • Quarterly audit sessions • Priority messaging</div>\\n          <div class='pricing'>$220 / month</div>\\n          <div style='margin-top:10px'><a class='cta' href='book.html'>Start Sustain</a></div>\\n        </div>\\n      </div>\\n\\n      <div style='display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:16px'>\\n        <div class='path'>\\n          <span class='attr'>Weekend Reset</span>\\n          <h3 style='margin-top:8px'>2-day workshop</h3>\\n          <div class='features'>Group retreat • Plan + practice • Accountability partners</div>\\n          <div class='pricing'>$380</div>\\n          <div style='margin-top:10px'><a class='cta' href='book.html'>Book Weekend</a></div>\\n        </div>\\n        <div class='path'>\\n          <span class='attr'>Audit</span>\\n          <h3 style='margin-top:8px'>Deep assessment</h3>\\n          <div class='features'>90-min values and routines audit • Actionable next 30 days</div>\\n          <div class='pricing'>$140 one-time</div>\\n          <div style='margin-top:10px'><a class='cta' href='book.html'>Schedule Audit</a></div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Framework explanation (Hybrid model) -->\\n    <section>\\n      <h2 style='margin-top:22px'>Hybrid model — why it works</h2>\\n      <p class='small' style='color:var(--muted)'>The hybrid approach balances structure and flexibility: digital habit cues keep daily momentum, coaching sessions adjust behavior weekly, and local meet-ups reinforce the social aspect.</p>\\n      <div style='display:flex;gap:12px;margin-top:12px'>\\n        <div style='flex:1;background:#fff;padding:12px;border-radius:10px'>\\n          <strong>Digital</strong>\\n          <div class='small' style='color:var(--muted)'>Templates, reminders, and a private tracker.</div>\\n        </div>\\n        <div style='flex:1;background:#fff;padding:12px;border-radius:10px'>\\n          <strong>Coaching</strong>\\n          <div class='small' style='color:var(--muted)'>Weekly planning and accountability.</div>\\n        </div>\\n        <div style='flex:1;background:#fff;padding:12px;border-radius:10px'>\\n          <strong>Community</strong>\\n          <div class='small' style='color:var(--muted)'>Optional cohorts and local check-ins in {{CITY}}.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Pricing microcopy (program-specific) -->\\n    <section>\\n      <h2 style='margin-top:22px'>Notes on pricing</h2>\\n      <p class='small' style='color:var(--muted)'>Packages include materials and digital supports. Payment plans, sliding scale spots, and employer-sponsored options available on request.</p>\\n    </section>\\n\\n    <!-- Testimonials (different question set) -->\\n    <section>\\n      <h2 style='margin-top:22px'>What people gained</h2>\\n      <div class='faq'>\\n        <div class='faq-item'>\\n          <strong>How quickly did results show?</strong>\\n          <div class='small' style='color:var(--muted)'>Most clients notice clearer mornings within 2–3 weeks when they pair a single anchor habit with a simple evening routine.</div>\\n        </div>\\n        <div class='faq-item'>\\n          <strong>Can I switch Paths mid-course?</strong>\\n          <div class='small' style='color:var(--muted)'>Yes. We reassess and move you to the plan that supports your changing goals.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- CTA -->\\n    <section style='margin-top:22px;text-align:center'>\\n      <h3 style='margin:0'>Pick a Path — let's make it practical</h3>\\n      <div class='small' style='color:var(--muted);margin-top:8px'>Free 20-minute clarity call helps match you to the right program.</div>\\n      <div style='margin-top:12px'><a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a></div>\\n    </section>\\n\\n    <footer>\\n      <div style='margin-top:28px' class='small'>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href='mailto:{{EMAIL}}' style='color:var(--deep)'>{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
