          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Pricing</title>\\n  <style>\\n    :root{--bg:#f7fafc;--card:#ffffff;--muted:#6b7280;--accent:#0f766e;--glass:rgba(15,118,110,0.06);--radius:12px}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#0f172a;background:var(--bg)}\\n    .container{max-width:1100px;margin:36px auto;padding:28px;display:grid;grid-template-columns:1fr;gap:24px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-weight:600}\\n    .hero{background:linear-gradient(180deg,rgba(15,118,110,0.06),transparent);border-radius:var(--radius);padding:28px;display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:center}\\n    .hero h1{margin:0;font-size:26px;color:#072227}\\n    .hero p{color:var(--muted);margin-top:8px}\\n    .hero .cta{margin-top:16px}\\n    .cta a{background:var(--accent);color:white;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .card{background:var(--card);border-radius:10px;padding:18px;box-shadow:0 4px 18px rgba(2,6,23,0.06)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\\n    .price{border:1px solid var(--glass);padding:18px;border-radius:10px}\\n    .price h3{margin:0 0 6px 0}\\n    .price p{color:var(--muted);margin:0 0 12px}\\n    .price .amount{font-size:20px;color:#042f2c;font-weight:800}\\n    .muted{color:var(--muted)}\\n    .process{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}\\n    .faq{display:grid;gap:12px}\\n    footer{display:flex;justify-content:space-between;color:var(--muted);font-size:14px;padding-top:18px}\\n    .testimonial-strip{display:flex;gap:12px;overflow:auto;padding:8px}\\n    .testimonial{min-width:220px;background:linear-gradient(180deg,white, #fbffff);padding:12px;border-radius:10px;border:1px solid var(--glass)}\\n    @media(max-width:900px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}.process{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div>\\n        <strong>{{BUSINESS_NAME}}</strong>\\n        <div class=\\\"muted\\\">{{TAGLINE}}</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <!-- Hero (Pricing-specific framing) -->\\n    <section class=\\\"hero card\\\" aria-labelledby=\\\"hero-pricing\\\">\\n      <div>\\n        <h1 id=\\\"hero-pricing\\\">Investment & Packages — choose the pace that fits your life</h1>\\n        <p>Structured coaching and a proven rhythm to build small habits that compound into steadier energy, calmer days, and clear priorities. No fads—just frameworks you can keep.</p>\\n        <div class=\\\"cta\\\"><a href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n      </div>\\n      <div class=\\\"card\\\">\\n        <h4 style=\\\"margin:0\\\">Quick contact</h4>\\n        <p class=\\\"muted\\\" style=\\\"margin:8px 0\\\">Call or text: {{PHONE}}</p>\\n        <p class=\\\"muted\\\">Or email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></p>\\n        <div style=\\\"margin-top:12px\\\"><a href=\\\"book.html\\\" style=\\\"text-decoration:none;background:#e6fffb;color:#04504c;padding:8px 12px;border-radius:8px;font-weight:700\\\">Book a 15‑min consult</a></div>\\n      </div>\\n    </section>\\n\\n    <!-- Social proof strip -->\\n    <section class=\\\"card\\\">\\n      <h2 style=\\\"margin:0 0 8px 0\\\">Trusted by people who needed clarity</h2>\\n      <div class=\\\"testimonial-strip\\\">\\n        <div class=\\\"testimonial\\\"><strong>\\\"I sleep again.\\\"</strong><div class=\\\"muted\\\"> — J, project manager</div></div>\\n        <div class=\\\"testimonial\\\"><strong>\\\"A realistic routine that stuck.\\\"</strong><div class=\\\"muted\\\"> — K, artist</div></div>\\n        <div class=\\\"testimonial\\\"><strong>\\\"Small changes, big results.\\\"</strong><div class=\\\"muted\\\"> — M, entrepreneur</div></div>\\n      </div>\\n    </section>\\n\\n    <!-- Benefits -->\\n    <section class=\\\"card\\\">\\n      <h2>How coaching helps</h2>\\n      <div class=\\\"grid\\\" style=\\\"grid-template-columns:repeat(3,1fr)\\\">\\n        <div>\\n          <h3 style=\\\"margin:8px 0\\\">Steady habits</h3>\\n          <p class=\\\"muted\\\">Build daily practices that are simple, sustainable, and tailored to your life.</p>\\n        </div>\\n        <div>\\n          <h3 style=\\\"margin:8px 0\\\">Clear boundaries</h3>\\n          <p class=\\\"muted\\\">Learn to protect your time and energy without guilt or burnout.</p>\\n        </div>\\n        <div>\\n          <h3 style=\\\"margin:8px 0\\\">Repeatable frameworks</h3>\\n          <p class=\\\"muted\\\">A repeatable 4‑step approach you can apply to work, sleep, and transitions.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Pricing tiers (distinct program names) -->\\n    <section class=\\\"card\\\">\\n      <h2>Packages for steady progress</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"price\\\">\\n          <h3>Foundations Path</h3>\\n          <p class=\\\"muted\\\">Great for establishing reliable routines.</p>\\n          <div class=\\\"amount\\\">$395 / month</div>\\n          <p class=\\\"muted\\\">Includes: 1×60min coaching, weekly check-ins, habit plan</p>\\n          <div style=\\\"margin-top:12px\\\"><a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"text-decoration:none;padding:8px 12px;background:var(--accent);color:white;border-radius:8px;font-weight:700\\\">Start Foundations</a></div>\\n        </div>\\n        <div class=\\\"price\\\">\\n          <h3>Momentum Package</h3>\\n          <p class=\\\"muted\\\">For people ready to accelerate new habits.</p>\\n          <div class=\\\"amount\\\">$950 / 3 months</div>\\n          <p class=\\\"muted\\\">Includes: bi‑weekly 60min sessions, habit lab, email support</p>\\n          <div style=\\\"margin-top:12px\\\"><a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"text-decoration:none;padding:8px 12px;background:#0b635e;color:white;border-radius:8px;font-weight:700\\\">Secure Momentum</a></div>\\n        </div>\\n        <div class=\\\"price\\\">\\n          <h3>Clarity VIP Day</h3>\\n          <p class=\\\"muted\\\">A focused one‑day intensive to reset your routine and plan next steps.</p>\\n          <div class=\\\"amount\\\">$1,900 — one day</div>\\n          <p class=\\\"muted\\\">Includes: pre‑work, 6h session, personalized roadmap, two follow‑ups</p>\\n          <div style=\\\"margin-top:12px\\\"><a href=\\\"book.html\\\" style=\\\"text-decoration:none;padding:8px 12px;background:#0f766e;color:white;border-radius:8px;font-weight:700\\\">Book VIP Day</a></div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Process -->\\n    <section class=\\\"card\\\">\\n      <h2>How we'll work together</h2>\\n      <div class=\\\"process\\\">\\n        <div><strong>1. Discover</strong><div class=\\\"muted\\\">Assess priorities and realistic constraints.</div></div>\\n        <div><strong>2. Design</strong><div class=\\\"muted\\\">Create a practical habit plan tailored to you.</div></div>\\n        <div><strong>3. Practice</strong><div class=\\\"muted\\\">Short, consistent steps and weekly adjustments.</div></div>\\n      </div>\\n    </section>\\n\\n    <!-- FAQ (pricing-specific questions) -->\\n    <section class=\\\"card\\\">\\n      <h2>Questions about investment</h2>\\n      <div class=\\\"faq\\\">\\n        <details><summary>Do you offer payment plans?</summary><div class=\\\"muted\\\">Yes—monthly options and split payments are available for most packages. We'll clear this in your consultation.</div></details>\\n        <details><summary>Is the VIP day refundable?</summary><div class=\\\"muted\\\">VIP Day deposits hold your date. We discuss rescheduling and credit policies during booking.</div></details>\\n        <details><summary>What if I need less support?</summary><div class=\\\"muted\\\">We can scale back sessions to focus on maintenance or switch to a short series after a VIP Day.</div></details>\\n      </div>\\n    </section>\\n\\n    <!-- Lead magnet -->\\n    <section class=\\\"card\\\" style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <h3>Free guide: The 7‑minute reset</h3>\\n        <p class=\\\"muted\\\">A concise habit refresh you can use any morning or afternoon to regain focus.</p>\\n      </div>\\n      <div>\\n        <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"background:#e6fffb;color:#04504c;padding:10px 14px;border-radius:9px;text-decoration:none;font-weight:700\\\">Get the guide</a>\\n      </div>\\n    </section>\\n\\n    <!-- CTA -->\\n    <section class=\\\"card\\\" style=\\\"text-align:center\\\">\\n      <h2 style=\\\"margin:0\\\">Ready to invest in steady change?</h2>\\n      <p class=\\\"muted\\\" style=\\\"margin:6px 0\\\">Schedule a short consult to find the right package.</p>\\n      <div style=\\\"margin-top:12px\\\"><a href=\\\"book.html\\\" style=\\\"background:var(--accent);color:white;padding:12px 18px;border-radius:10px;text-decoration:none;font-weight:800\\\">Schedule your consult</a></div>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} — {{COACH_NAME}}, {{CREDENTIALS}}</div>\\n      <div class=\\\"muted\\\">{{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Stories — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f8fbfb;--card:#ffffff;--muted:#64748b;--accent:#0f766e;--glass:rgba(15,118,110,0.06);--radius:12px}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--bg);color:#052328}\\n    .wrap{max-width:1000px;margin:36px auto;padding:20px;display:grid;gap:18px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:16px}\\n    .hero{padding:26px;border-radius:14px;background:var(--card);display:flex;gap:18px;align-items:center}\\n    .hero img{width:120px;height:120px;border-radius:12px;background:#e6fffb}\\n    .hero h1{margin:0;font-size:24px}\\n    .social{display:grid;grid-template-columns:1fr 1fr;gap:12px}\\n    .note{background:linear-gradient(180deg,#fff,#f6fffd);padding:14px;border-radius:12px;border:1px solid var(--glass)}\\n    .kv{display:flex;gap:12px}\\n    .testimonial{background:var(--card);padding:14px;border-radius:12px;border:1px solid var(--glass)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}\\n    .lead{display:flex;justify-content:space-between;align-items:center}\\n    .lead a{background:var(--accent);color:white;padding:10px 12px;border-radius:10px;text-decoration:none}\\n    footer{color:var(--muted);padding-top:12px}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}.social{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <strong>{{BUSINESS_NAME}}</strong>\\n        <div class=\\\"muted\\\">Gentle, practical coaching</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"programs.html\\\">Work With Me</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <!-- Hero (testimonial-focused) -->\\n    <section class=\\\"hero\\\">\\n      <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar illustration\\\">\\n      <div>\\n        <h1>Stories of change</h1>\\n        <p class=\\\"muted\\\">Real people. Practical changes. Small steps that rearranged days for more rest and purpose.</p>\\n      </div>\\n    </section>\\n\\n    <!-- Social proof large -->\\n    <section class=\\\"note\\\">\\n      <h3 style=\\\"margin:0 0 8px 0\\\">A snapshot</h3>\\n      <div class=\\\"kv\\\">\\n        <div><strong>3–6 weeks</strong><div class=\\\"muted\\\">Common timeline to notice a new rhythm</div></div>\\n        <div><strong>94%</strong><div class=\\\"muted\\\">Report improved sleep or focus within two months</div></div>\\n      </div>\\n    </section>\\n\\n    <!-- Testimonial grid (unique voice) -->\\n    <section>\\n      <h2 style=\\\"margin:0 0 12px 0\\\">Client stories</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"testimonial\\\">\\n          <strong>\\\"The VIP Day changed my calendar.\\\"</strong>\\n          <p class=\\\"muted\\\">We created a daily flow I actually use. I feel less reactive.</p>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">— L, teacher</div>\\n        </div>\\n        <div class=\\\"testimonial\\\">\\n          <strong>\\\"I stopped waiting for motivation.\\\"</strong>\\n          <p class=\\\"muted\\\">Small, consistent prompts replaced all-or-nothing thinking.</p>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">— S, parent</div>\\n        </div>\\n        <div class=\\\"testimonial\\\">\\n          <strong>\\\"A practical plan, not platitudes.\\\"</strong>\\n          <p class=\\\"muted\\\">The steps were clear and doable in a busy schedule.</p>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">— R, designer</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Benefits (reframed) -->\\n    <section class=\\\"note\\\">\\n      <h3 style=\\\"margin:0 0 8px 0\\\">What clients gain</h3>\\n      <ul class=\\\"muted\\\" style=\\\"margin:0 0 0 18px\\\">\\n        <li>Less decision fatigue</li>\\n        <li>Systems for energy, sleep, and boundaries</li>\\n        <li>Clarity on what actually moves the needle</li>\\n      </ul>\\n    </section>\\n\\n    <!-- Process (client journey, different order) -->\\n    <section class=\\\"card\\\">\\n      <h3>Client journey</h3>\\n      <ol class=\\\"muted\\\">\\n        <li>Intro call to align outcomes</li>\\n        <li>VIP Day or short series to build the framework</li>\\n        <li>Follow-ups and habit tracking for upkeep</li>\\n      </ol>\\n    </section>\\n\\n    <!-- Lead magnet (different copy) -->\\n    <section class=\\\"lead card\\\">\\n      <div>\\n        <h3 style=\\\"margin:0\\\">Download: A weekly reset template</h3>\\n        <p class=\\\"muted\\\" style=\\\"margin:6px 0\\\">A simple checklist to prepare your week in 20 minutes.</p>\\n      </div>\\n      <div>\\n        <a href=\\\"{{PRIMARY_CTA_URL}}\\\">Get the template</a>\\n      </div>\\n    </section>\\n\\n    <!-- FAQ (unique questions) -->\\n    <section class=\\\"card\\\">\\n      <h3>Common questions</h3>\\n      <details><summary>How long are typical engagements?</summary><div class=\\\"muted\\\">From a single VIP Day to 3–6 month partnerships, depending on goals.</div></details>\\n      <details><summary>Do you offer corporate or group sessions?</summary><div class=\\\"muted\\\">Yes—team rhythms and workshop formats are available. Contact for details.</div></details>\\n      <details><summary>Will I get worksheets?</summary><div class=\\\"muted\\\">Yes—every program includes practical resources you keep and reuse.</div></details>\\n    </section>\\n\\n    <!-- CTA -->\\n    <section style=\\\"text-align:center\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0\\\">Ready to start your story?</h3>\\n      <p class=\\\"muted\\\" style=\\\"margin:8px 0\\\">Book a short consult to see which path fits.</p>\\n      <a href=\\\"book.html\\\" style=\\\"background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700\\\">Book a consult</a>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div class=\\\"muted\\\">{{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}}</div>\\n        <div class=\\\"muted\\\">{{CITY}}, {{STATE}} • {{PHONE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfdfb;--card:#ffffff;--muted:#6b7280;--accent:#0f766e;--radius:12px}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--bg);color:#052328}\\n    .site{max-width:920px;margin:36px auto;padding:20px;display:grid;gap:18px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:14px}\\n    .hero{background:linear-gradient(180deg,#fff,#f6fffb);padding:22px;border-radius:14px;display:grid;grid-template-columns:1fr 280px;gap:18px}\\n    .hero h1{margin:0}\\n    .card{background:var(--card);padding:16px;border-radius:12px;border:1px solid rgba(2,6,23,0.04)}\\n    form{display:grid;gap:10px}\\n    input,select,textarea{padding:10px;border:1px solid #e6eef0;border-radius:8px;width:100%;box-sizing:border-box}\\n    button{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;border:0;font-weight:700}\\n    .two{display:grid;grid-template-columns:1fr 1fr;gap:10px}\\n    .faq{margin-top:8px}\\n    footer{color:var(--muted);font-size:14px}\\n    @media(max-width:900px){.hero{grid-template-columns:1fr}.two{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <header>\\n      <div>\\n        <strong>{{BUSINESS_NAME}}</strong>\\n        <div class=\\\"muted\\\">Booking & availability</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"testimonials.html\\\">Testimonials</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <!-- Hero (booking focus) -->\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Schedule a consult or VIP Day</h1>\\n        <p class=\\\"muted\\\">Choose a short consult to clarify goals, or book a full Clarity VIP Day to map a practical plan in one focused session.</p>\\n        <ul class=\\\"muted\\\" style=\\\"margin-top:12px\\\">\\n          <li>15‑minute clarity call (free)</li>\\n          <li>Clarity VIP Day — one focused session</li>\\n          <li>Short series for steady change</li>\\n        </ul>\\n      </div>\\n      <div class=\\\"card\\\">\\n        <h4 style=\\\"margin:0 0 8px 0\\\">Quick contact</h4>\\n        <div class=\\\"muted\\\">{ {PHONE} }</div>\\n        <div style=\\\"margin-top:10px\\\"><a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </section>\\n\\n    <!-- Booking form (CTA-focused) -->\\n    <section class=\\\"card\\\">\\n      <h2 style=\\\"margin:0 0 12px 0\\\">Book now</h2>\\n      <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\">\\n        <div class=\\\"two\\\">\\n          <input name=\\\"name\\\" placeholder=\\\"Your name\\\" required>\\n          <input name=\\\"email\\\" placeholder=\\\"Email\\\" required>\\n        </div>\\n        <div class=\\\"two\\\">\\n          <input name=\\\"phone\\\" placeholder=\\\"Phone (optional)\\\">\\n          <select name=\\\"service\\\">\\n            <option value=\\\"consult\\\">15‑minute consult (free)</option>\\n            <option value=\\\"vip\\\">Clarity VIP Day — one day intensive</option>\\n            <option value=\\\"series\\\">Momentum series (3 months)</option>\\n          </select>\\n        </div>\\n        <textarea name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Brief note about what you'd like to focus on\\\"></textarea>\\n        <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n          <button type=\\\"submit\\\">Request booking</button>\\n          <div class=\\\"muted\\\">Or call <strong>{{PHONE}}</strong></div>\\n        </div>\\n      </form>\\n    </section>\\n\\n    <!-- Social proof small -->\\n    <section class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 10px 0\\\">Client highlights</h3>\\n      <div class=\\\"muted\\\">People book a VIP Day to clear routines, redesign an evening rhythm, or create a sustainable workday that protects energy. Hear more on the <a href=\\\"testimonials.html\\\">Stories</a> page.</div>\\n    </section>\\n\\n    <!-- Benefits (VIP Day oriented) -->\\n    <section class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 10px 0\\\">What the VIP Day delivers</h3>\\n      <ul class=\\\"muted\\\" style=\\\"margin:0 0 0 18px\\\">\\n        <li>Full-day focus to audit current routines</li>\\n        <li>Personalized rhythm and fallback habits</li>\\n        <li>Clear roadmap and two follow-up sessions</li>\\n      </ul>\\n    </section>\\n\\n    <!-- Process (detailed flow for booking) -->\\n    <section class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 10px 0\\\">Before & after booking</h3>\\n      <ol class=\\\"muted\\\">\\n        <li>You request a date via this form or consult link.</li>\\n        <li>We complete short pre‑work to prepare.</li>\\n        <li>VIP Day: focused session + a written roadmap.</li>\\n        <li>Two follow-ups (30min) in the following month for adjustments.</li>\\n      </ol>\\n    </section>\\n\\n    <!-- Pricing summary (compact) -->\\n    <section class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 10px 0\\\">Pricing snapshot</h3>\\n      <div class=\\\"muted\\\">Consult: free · VIP Day: $1,900 · Momentum Package: $950/quarter. Exact options and payment plans discussed during booking.</div>\\n    </section>\\n\\n    <!-- FAQ (booking-specific) -->\\n    <section class=\\\"card faq\\\">\\n      <h3 style=\\\"margin:0 0 10px 0\\\">Booking FAQ</h3>\\n      <details><summary>How do you prepare me for the VIP Day?</summary><div class=\\\"muted\\\">You receive a short pre‑work packet to clarify priorities and current patterns so our time is focused and productive.</div></details>\\n      <details><summary>Can I reschedule?</summary><div class=\\\"muted\\\">Yes. Rescheduling policies and deposits are clarified at booking. We aim to be flexible when possible.</div></details>\\n      <details><summary>What if I need follow-up support?</summary><div class=\\\"muted\\\">Follow‑ups are included with the VIP Day; longer engagements are available if you want ongoing rhythm coaching.</div></details>\\n    </section>\\n\\n    <!-- Lead magnet & final CTA -->\\n    <section class=\\\"card\\\" style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <h4 style=\\\"margin:0\\\">Free download — 10-minute end-of-day routine</h4>\\n        <p class=\\\"muted\\\" style=\\\"margin:6px 0\\\">A simple checklist to close your day and protect tomorrow's energy.</p>\\n      </div>\\n      <div>\\n        <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"text-decoration:none;background:#e6fffb;color:#04504c;padding:10px 14px;border-radius:9px;font-weight:700\\\">Download</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">{{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
