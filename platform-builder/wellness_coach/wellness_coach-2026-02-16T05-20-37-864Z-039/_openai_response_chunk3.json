          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Pricing — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f7f9fb;--card:#ffffff;--muted:#60707a;--accent:#2b7a78;--glass:rgba(255,255,255,0.85);font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial}\\n    body{margin:0;background:var(--bg);color:#083344}\\n    .wrap{max-width:980px;margin:40px auto;padding:32px}\\n    header{display:flex;align-items:center;justify-content:space-between;gap:20px}\\n    .brand{display:flex;align-items:center;gap:14px}\\n    .logo{width:52px;height:52px;background:linear-gradient(135deg,#e6f7f6,#dff0ef);border-radius:12px;display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent)}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .hero{display:grid;grid-template-columns:1fr 320px;gap:28px;align-items:center;margin-top:28px}\\n    .hero-card{background:var(--card);padding:28px;border-radius:12px;box-shadow:0 6px 18px rgba(8,51,68,0.06)}\\n    h1{margin:0 0 8px;font-size:24px}\\n    p.lead{margin:0;color:var(--muted)}\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:20px}\\n    .tier{background:var(--glass);padding:20px;border-radius:10px;border:1px solid rgba(11,55,59,0.06)}\\n    .tier h3{margin:0 0 6px;color:var(--accent)}\\n    .price{font-size:20px;font-weight:700;margin:8px 0}\\n    ul{padding-left:18px;color:var(--muted)}\\n    .primary{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:8px;background:var(--accent);color:white;text-decoration:none;font-weight:700}\\n    .note{font-size:13px;color:#496568;margin-top:8px}\\n    .lead-magnet{display:flex;gap:14px;align-items:center;padding:18px;margin-top:28px;background:linear-gradient(180deg,#ffffff,#f4fbfa);border-radius:12px;border:1px solid rgba(43,122,120,0.06)}\\n    .faq{margin-top:28px}\\n    .faq h4{margin:10px 0}\\n    footer{margin-top:36px;padding-top:18px;border-top:1px solid rgba(8,51,68,0.04);display:flex;justify-content:space-between;color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <div class='wrap'>\\n    <header>\\n      <div class='brand'>\\n        <div class='logo'>WC</div>\\n        <div>\\n          <div style='font-weight:800'>{{BUSINESS_NAME}}</div>\\n          <div style='font-size:12px;color:var(--muted)'>{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href='index.html'>Home</a>\\n        <a href='about.html'>About</a>\\n        <a href='programs.html'>Paths</a>\\n        <a href='services.html'>Services</a>\\n        <a href='pricing.html' style='color:var(--accent)'>Pricing</a>\\n        <a href='contact.html'>Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class='hero'>\\n      <div class='hero-card'>\\n        <h1>Transparent pricing, designed for steady change</h1>\\n        <p class='lead'>Choose a structure that meets your momentum — from monthly momentum work to a focused VIP Day with {{COACH_NAME}}.</p>\\n\\n        <div class='tiers'>\\n          <div class='tier'>\\n            <h3>Momentum Track</h3>\\n            <div class='price'>$450 / month</div>\\n            <ul>\\n              <li>Bi-weekly 50-minute sessions</li>\\n              <li>Simple habit frameworks</li>\\n              <li>Progress checks + email support</li>\\n            </ul>\\n            <a class='primary' href='book.html'>Start Momentum</a>\\n          </div>\\n\\n          <div class='tier'>\\n            <h3>Sustained Care</h3>\\n            <div class='price'>$1,200 / 3 months</div>\\n            <ul>\\n              <li>Weekly 45-minute sessions</li>\\n              <li>Custom habit library</li>\\n              <li>Phone check-ins and worksheets</li>\\n            </ul>\\n            <a class='primary' href='book.html'>Begin 3-Month</a>\\n          </div>\\n\\n          <div class='tier'>\\n            <h3>VIP Day: Focus Reset</h3>\\n            <div class='price'>$2,400 one-time</div>\\n            <ul>\\n              <li>Full-day intensive with {{COACH_NAME}}</li>\\n              <li>Personalized rhythm plan</li>\\n              <li>Follow-up + implementation guide</li>\\n            </ul>\\n            <a class='primary' href='book.html'>Book VIP Day</a>\\n          </div>\\n        </div>\\n\\n        <div class='note'>All programs focus on habits, actionable routines and measurable outcomes. No medical advice is offered.</div>\\n      </div>\\n\\n      <aside style='background:var(--card);padding:20px;border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center'>\\n        <img src='assets/img/avatar.svg' alt='Coach' style='width:120px;height:120px;margin-bottom:12px'>\\n        <div style='text-align:center'>\\n          <div style='font-weight:700'>{{COACH_NAME}}, {{CREDENTIALS}}</div>\\n          <div style='font-size:13px;color:var(--muted)'>Based in {{CITY}}, {{STATE}}</div>\\n          <a href='book.html' class='primary' style='margin-top:10px'>{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class='lead-magnet'>\\n      <div style='flex:1'>\\n        <strong>Free guide:</strong>\\n        <div style='color:var(--muted)'>7 Small Routines That Shift Your Day — a practical PDF to start building the first 14 days of reliable habits.</div>\\n      </div>\\n      <div>\\n        <a href='contact.html' class='primary' style='background:#0f6f6d'>Get the Guide</a>\\n      </div>\\n    </section>\\n\\n    <section class='faq'>\\n      <h2 style='margin:16px 0 8px'>Common questions about investing in coaching</h2>\\n      <div>\\n        <h4>How quickly will I see results?</h4>\\n        <p style='color:var(--muted)'>Most clients report improved routines within 2–6 weeks when they commit to the habit steps and short daily practices we design together.</p>\\n      </div>\\n      <div>\\n        <h4>Is the VIP Day a replacement for ongoing coaching?</h4>\\n        <p style='color:var(--muted)'>The VIP Day is a strategic intensive to accelerate clarity and habits — it's ideal as a jumpstart and pairs well with follow-up sessions for long-term change.</p>\\n      </div>\\n      <div>\\n        <h4>What is your cancellation policy?</h4>\\n        <p style='color:var(--muted)'>Sessions rescheduled with 48 hours' notice are accommodated. For details, please contact {{EMAIL}}.</p>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>Questions? Call <strong>{{PHONE}}</strong> or email <a href='mailto:{{EMAIL}}' style='color:var(--muted)'>{{EMAIL}}</a></div>\\n      <div style='text-align:right'>\\n        <div style='font-weight:700'>{{BUSINESS_NAME}}</div>\\n        <div style='font-size:13px;color:var(--muted)'>{{TAGLINE}}</div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Stories — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#ffffff;--muted:#6b7c82;--accent:#1f645f;--glass:rgba(31,100,95,0.05);font-family:Inter, system-ui, -apple-system}\\n    body{margin:0;background:linear-gradient(180deg,#f8fafb,#ffffff)}\\n    .container{max-width:1100px;margin:36px auto;padding:32px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:16px;color:var(--muted);text-decoration:none}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:22px;margin-top:22px}\\n    .list{display:grid;gap:14px}\\n    .card{background:var(--bg);padding:18px;border-radius:12px;box-shadow:0 8px 24px rgba(30,60,70,0.06);border:1px solid var(--glass)}\\n    .quote{font-style:italic;color:#05272a;margin:0}\\n    .meta{font-size:13px;color:var(--muted);margin-top:8px}\\n    .aside{display:flex;flex-direction:column;gap:12px}\\n    .cta{display:block;padding:12px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none;text-align:center;font-weight:700}\\n    .leadmag{background:#eaf8f6;padding:14px;border-radius:10px}\\n  </style>\\n</head>\\n<body>\\n  <div class='container'>\\n    <header>\\n      <div style='font-weight:800'>{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href='index.html'>Start</a>\\n        <a href='about.html'>About</a>\\n        <a href='programs.html'>Programs</a>\\n        <a href='testimonials.html' style='color:var(--accent)'>Stories</a>\\n        <a href='book.html'>Book</a>\\n      </nav>\\n    </header>\\n\\n    <main class='grid'>\\n      <section>\\n        <h1 style='margin:0 0 8px'>Client stories: real rhythms, steady outcomes</h1>\\n        <p style='color:var(--muted);margin:0 0 18px'>Snapshots from people who rebuilt daily structure without overwhelm.</p>\\n\\n        <div class='list'>\\n          <article class='card'>\\n            <p class='quote'>\\\"After three sessions I slept better and kept the morning routine 80% of the week. The simple trackers made all the difference.\\\"</p>\\n            <div class='meta'>— A. / Teacher, 42</div>\\n          </article>\\n\\n          <article class='card'>\\n            <p class='quote'>\\\"The VIP Day reshaped my priorities. We left with a 6-week plan I could actually follow.\\\"</p>\\n            <div class='meta'>— L. / Founder, 36</div>\\n          </article>\\n\\n          <article class='card'>\\n            <p class='quote'>\\\"I was skeptical about coaching. The tools felt practical, not spiritual — measurable wins in sleep and energy.\\\"</p>\\n            <div class='meta'>— M. / Nurse, 29</div>\\n          </article>\\n\\n          <article class='card'>\\n            <p class='quote'>\\\"Weekly check-ins kept me accountable and gave momentum to the small wins. Long-term habits stuck.\\\"</p>\\n            <div class='meta'>— S. / Designer, 33</div>\\n          </article>\\n        </div>\\n      </section>\\n\\n      <aside class='aside'>\\n        <div class='card' style='text-align:center'>\\n          <img src='assets/img/avatar.svg' alt='Coach avatar' style='width:88px;height:88px;border-radius:12px;margin-bottom:10px'>\\n          <div style='font-weight:700'>{{COACH_NAME}}, {{CREDENTIALS}}</div>\\n          <div style='color:var(--muted);font-size:13px'>Practical habit coaching in {{CITY}}, {{STATE}}</div>\\n          <a href='book.html' class='cta' style='margin-top:12px'>Schedule a consult</a>\\n        </div>\\n\\n        <div class='leadmag card'>\\n          <div style='font-weight:700'>Get the starter checklist</div>\\n          <div style='color:var(--muted);margin-top:8px'>A one-page routine checklist: morning, midday reset, evening. Immediate actions you can test this week.</div>\\n          <a href='contact.html' class='cta' style='margin-top:10px;background:#145c59'>Send me the checklist</a>\\n        </div>\\n\\n        <div class='card'>\\n          <h4 style='margin:0 0 8px'>Quick FAQ</h4>\\n          <div style='color:var(--muted);font-size:13px'>\\n            Q: What kind of clients do you work with?<br>\\n            A: People building sustainable daily practices — professionals, caregivers, founders.\\n          </div>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <section style='max-width:960px;margin:28px auto;text-align:center'>\\n      <h3 style='margin:0 0 8px'>Want to hear more stories?</h3>\\n      <p style='color:var(--muted);margin:0 0 12px'>We share case studies and short client interviews in our newsletter.</p>\\n      <a href='contact.html' class='cta' style='display:inline-block;padding:12px 18px'>Join the list</a>\\n    </section>\\n\\n    <footer style='text-align:center;color:var(--muted);margin-top:36px;padding-bottom:24px'>\\n      <div>{{BUSINESS_NAME}} • <a href='mailto:{{EMAIL}}' style='color:var(--muted)'>{{EMAIL}}</a> • {{PHONE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Book a Session — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f4f8f8;--card:#ffffff;--accent:#13615f;--muted:#5b6c6f;font-family:Inter,system-ui}\\n    body{margin:0;background:var(--bg);color:#062a2a}\\n    .shell{max-width:920px;margin:36px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:22px;margin-top:20px}\\n    .panel{background:var(--card);padding:20px;border-radius:12px;box-shadow:0 10px 30px rgba(9,40,40,0.04)}\\n    .section-title{display:flex;align-items:center;justify-content:space-between}\\n    .step{display:flex;gap:12px;align-items:flex-start;margin-top:12px}\\n    .dot{width:36px;height:36px;border-radius:8px;background:linear-gradient(180deg,#e9f6f5,#dff0ee);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent)}\\n    label{display:block;margin-top:10px;font-weight:700}\\n    input,select,textarea{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid rgba(5,60,60,0.08)}\\n    .btn{display:inline-block;padding:12px 16px;background:var(--accent);color:white;border-radius:10px;text-decoration:none;font-weight:700}\\n    .small{font-size:13px;color:var(--muted)}\\n    .faq{margin-top:18px}\\n  </style>\\n</head>\\n<body>\\n  <div class='shell'>\\n    <header>\\n      <div style='font-weight:800'>{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href='index.html'>Home</a>\\n        <a href='services.html'>Work With Me</a>\\n        <a href='pricing.html'>Packages</a>\\n        <a href='book.html' style='color:var(--accent)'>Book</a>\\n      </nav>\\n    </header>\\n\\n    <main class='grid'>\\n      <section class='panel'>\\n        <div class='section-title'>\\n          <div>\\n            <h1 style='margin:0;font-size:20px'>Book a session with {{COACH_NAME}}</h1>\\n            <div class='small'>Select a format: VIP Day, Multi-Week Package, or Intro Consult</div>\\n          </div>\\n        </div>\\n\\n        <div class='step'>\\n          <div class='dot'>1</div>\\n          <div>\\n            <strong>Choose your path</strong>\\n            <div class='small'>VIP Day — one focused day to redesign routines; Packages — guided 3-month work; Intro — 30-minute clarity call.</div>\\n          </div>\\n        </div>\\n\\n        <div class='step'>\\n          <div class='dot'>2</div>\\n          <div>\\n            <strong>Share a few details</strong>\\n            <form action='https://example.invalid/submit' method='post' style='margin-top:10px'>\\n              <label for='name'>Full name</label>\\n              <input id='name' name='name' placeholder='Your name' required>\\n\\n              <label for='email'>Email</label>\\n              <input id='email' name='email' type='email' placeholder='you@email.com' required>\\n\\n              <label for='package'>I am interested in</label>\\n              <select id='package' name='package'>\\n                <option>Intro Consult — 30 mins</option>\\n                <option>Momentum Track — monthly</option>\\n                <option>3-Month Sustained Care</option>\\n                <option>VIP Day — Focus Reset</option>\\n              </select>\\n\\n              <label for='notes'>Quick note (goals, schedule)</label>\\n              <textarea id='notes' name='notes' rows='4' placeholder='What would you most like to change?'></textarea>\\n\\n              <div style='margin-top:12px'>\\n                <button type='submit' class='btn'>Request booking</button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n\\n        <div class='step' style='margin-top:18px'>\\n          <div class='dot'>3</div>\\n          <div>\\n            <strong>What happens next</strong>\\n            <div class='small'>You will receive a scheduling link and a short intake form. Sessions include practical habit steps and a written plan.</div>\\n          </div>\\n        </div>\\n\\n        <div class='faq'>\\n          <h3 style='margin:12px 0 6px'>Booking questions</h3>\\n          <div class='small'>\\n            Q: Do you accept sliding scale? A: Limited spots are available — contact {{EMAIL}} to inquire.<br>\\n            Q: Can I pay per session? A: Yes for Momentum Track; packages require full payment for the term.\\n          </div>\\n        </div>\\n      </section>\\n\\n      <aside>\\n        <div class='panel' style='text-align:center'>\\n          <img src='assets/img/avatar.svg' alt='Coach' style='width:96px;height:96px;border-radius:12px;margin-bottom:10px'>\\n          <div style='font-weight:700'>{{COACH_NAME}}, {{CREDENTIALS}}</div>\\n          <div class='small' style='margin-top:6px'>Focused habit coaching in {{CITY}}, {{STATE}}</div>\\n          <div style='margin-top:12px'>\\n            <a href='pricing.html' class='btn' style='background:#114e4b'>See packages</a>\\n          </div>\\n        </div>\\n\\n        <div class='panel' style='margin-top:14px'>\\n          <h4 style='margin:0 0 8px'>Why a VIP Day?</h4>\\n          <div class='small'>The VIP Day concentrates clarity, strategy and an executable routine into one collaborative day — ideal when you need rapid momentum.</div>\\n        </div>\\n\\n        <div class='panel' style='margin-top:14px'>\\n          <h4 style='margin:0 0 8px'>Free starter resource</h4>\\n          <div class='small'>Download the 5-minute morning baseline to map current habits and quick wins. <a href='contact.html' style='color:var(--accent);text-decoration:none'>Get it now</a></div>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <footer style='margin-top:24px;text-align:center;color:var(--muted)'>\\n      <div>Need help? Email <a href='mailto:{{EMAIL}}' style='color:var(--muted)'>{{EMAIL}}</a> or call {{PHONE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
