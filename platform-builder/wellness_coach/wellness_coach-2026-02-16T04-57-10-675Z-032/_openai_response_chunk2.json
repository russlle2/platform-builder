          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0b0b0c;--ink:#f7f7f8;--muted:#9aa0a6;--accent:#c7a87b;--glass:rgba(255,255,255,0.04);font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;color-scheme:dark}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,#070708 0%, #0f0f10 70%);}\\n    .container{max-width:980px;margin:48px auto;padding:32px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:14px;box-shadow:0 10px 30px rgba(2,2,2,0.6)}\\n    header{display:flex;align-items:center;justify-content:space-between;gap:20px}\\n    .brand{display:flex;align-items:center;gap:14px}\\n    .logo{width:54px;height:54px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#6b5b3b);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--bg)}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:14px}\\n    .hero{display:grid;grid-template-columns:1fr 340px;gap:32px;margin-top:28px;align-items:start}\\n    h1{margin:0;font-size:34px;line-height:1.05;color:var(--ink);letter-spacing:-0.02em}\\n    p.lead{color:var(--muted);margin-top:12px}\\n    .card{background:var(--glass);padding:20px;border-radius:12px}\\n    .avatar{width:100%;height:220px;border-radius:10px;background:linear-gradient(180deg,#121213,#1b1b1c);display:flex;align-items:center;justify-content:center;color:var(--accent)}\\n    .stack{display:flex;flex-direction:column;gap:12px}\\n    .kpis{display:flex;gap:12px;margin-top:18px}\\n    .kpi{background:rgba(255,255,255,0.03);padding:12px;border-radius:10px;flex:1;text-align:center}\\n    .kpi strong{display:block;color:var(--ink);font-size:18px}\\n    .btn{display:inline-block;padding:10px 16px;border-radius:10px;background:var(--accent);color:#070708;text-decoration:none;font-weight:600}\\n    section{margin-top:28px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}\\n    .benefit{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:14px;border-radius:10px}\\n    footer{display:flex;justify-content:space-between;align-items:center;margin-top:28px;color:var(--muted);font-size:13px}\\n    .small{font-size:13px;color:var(--muted)}\\n    .sprinkle{opacity:0.06;position:absolute;right:24px;top:24px;width:220px}\\n    /* responsive */\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr 1fr}.kpis{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">WC</div>\\n        <div>\\n          <div style=\\\"font-weight:700;color:var(--ink)\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"programs.html\\\">Work With Me</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"hero\\\">\\n      <div>\\n        <h1>A compassionate path to steady wellbeing</h1>\\n        <p class=\\\"lead\\\">Hi, I’m {{COACH_NAME}} {{CREDENTIALS}}. I guide busy people in {{CITY}}, {{STATE}} to build routines that feel gentle and actually stick — without hype or willpower traps.</p>\\n\\n        <div class=\\\"kpis\\\">\\n          <div class=\\\"kpi\\\"><strong>6–12 weeks</strong><span class=\\\"small\\\">Most clients see measurable routine shifts</span></div>\\n          <div class=\\\"kpi\\\"><strong>4 pillars</strong><span class=\\\"small\\\">Sleep, movement, nourishment, rhythm</span></div>\\n          <div class=\\\"kpi\\\"><strong>100% outcomes</strong><span class=\\\"small\\\">Focus on habit change, not advice overload</span></div>\\n        </div>\\n\\n        <section aria-labelledby=\\\"social-proof\\\" id=\\\"social-proof\\\">\\n          <h2 id=\\\"social-proof\\\" style=\\\"font-size:18px;color:var(--accent);margin-top:22px\\\">What clients say</h2>\\n          <div class=\\\"card\\\" style=\\\"margin-top:10px\\\">\\n            <blockquote style=\\\"margin:0;color:var(--ink)\\\">\\\"I reclaimed calm mornings and consistent sleep in three months. Practical, steady coaching — no pressure.\\\"</blockquote>\\n            <div class=\\\"small\\\" style=\\\"margin-top:10px\\\">— A. R., {{CITY}}</div>\\n          </div>\\n        </section>\\n\\n        <section id=\\\"lead_magnet\\\">\\n          <h3 style=\\\"margin-top:20px;color:var(--ink)\\\">Grab a simple starter: \\\"3 Gentle Habits for Better Days\\\"</h3>\\n          <p class=\\\"small\\\">A one-page checklist you can use tonight. No jargon — just doable steps.</p>\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </section>\\n\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <div class=\\\"avatar\\\"> <!-- placeholder for assets/img/avatar.svg -->\\n            <div style=\\\"text-align:center\\\">\\n              <div style=\\\"font-weight:700\\\">{{COACH_NAME}}</div>\\n              <div class=\\\"small\\\">{{CREDENTIALS}}</div>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <div style=\\\"font-weight:600;color:var(--ink)\\\">My approach</div>\\n            <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">I blend habit frameworks with compassionate accountability so change feels possible and gentle.</div>\\n          </div>\\n\\n          <div style=\\\"margin-top:16px;display:flex;gap:8px\\\">\\n            <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start the conversation</a>\\n            <a href=\\\"contact.html\\\" style=\\\"align-self:center;color:var(--muted);text-decoration:none\\\">Ask a question</a>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;padding:12px;border-radius:12px;background:rgba(255,255,255,0.02)\\\">\\n          <div style=\\\"font-weight:700;color:var(--ink)\\\">How we typically work</div>\\n          <ol class=\\\"small\\\" style=\\\"margin-top:6px;padding-left:16px\\\">\\n            <li>We clarify a single, meaningful goal.</li>\\n            <li>Choose 3 micro-habits to practice for 4 weeks.</li>\\n            <li>Weekly check-ins with adaptable steps.</li>\\n          </ol>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section id=\\\"benefits\\\">\\n      <h2 style=\\\"color:var(--accent)\\\">Results you can expect</h2>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"benefit\\\"><strong>More restful nights</strong><p class=\\\"small\\\">Simple sleep anchors, not rigid schedules.</p></div>\\n        <div class=\\\"benefit\\\"><strong>Clearer mornings</strong><p class=\\\"small\\\">Small rituals that set a calm tone.</p></div>\\n        <div class=\\\"benefit\\\"><strong>Less churn</strong><p class=\\\"small\\\">Tools to reduce decision fatigue during the day.</p></div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"process\\\">\\n      <h2 style=\\\"color:var(--ink)\\\">How we move forward</h2>\\n      <div style=\\\"display:flex;gap:12px;margin-top:10px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Step 1</strong>\\n          <div class=\\\"small\\\">Intro call to map priorities</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Step 2</strong>\\n          <div class=\\\"small\\\">Design micro-habits & experiment</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Step 3</strong>\\n          <div class=\\\"small\\\">Weekly reflection & adjust</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"faq\\\">\\n      <h2 style=\\\"color:var(--accent)\\\">Questions people often ask</h2>\\n      <details style=\\\"margin-top:8px;color:var(--muted)\\\"><summary style=\\\"cursor:pointer\\\">Is this therapy?</summary><div style=\\\"margin-top:8px\\\">No. Coaching focuses on practical habits and forward action, not diagnosis or clinical treatment.</div></details>\\n      <details style=\\\"margin-top:6px;color:var(--muted)\\\"><summary style=\\\"cursor:pointer\\\">How long do sessions last?</summary><div style=\\\"margin-top:8px\\\">Usually 45 minutes for an intake, then 30–45 minutes for follow-ups.</div></details>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"small\\\">Ready to begin? <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n      <div class=\\\"small\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffdf9;--ink:#111;--muted:#5b6267;--accent:#7b5aa3;font-family:Georgia, 'Times New Roman', serif}\\n    body{margin:0;background:linear-gradient(180deg,#fffdf9 0%, #f6f3f0 100%);color:var(--ink)}\\n    .wrap{max-width:980px;margin:48px auto;padding:36px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none}\\n    .hero{background:linear-gradient(90deg,rgba(123,90,163,0.08),transparent);padding:28px;border-radius:12px;margin-top:18px}\\n    .hero h1{margin:0;font-size:32px}\\n    .intro{color:var(--muted);margin-top:8px}\\n    .services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:20px}\\n    .service{padding:18px;border-radius:10px;background:#fff;box-shadow:0 6px 18px rgba(18,16,25,0.04)}\\n    .service h3{margin:0 0 8px 0}\\n    .small{font-size:14px;color:var(--muted)}\\n    .cta-row{display:flex;gap:12px;margin-top:18px}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:8px;text-decoration:none}\\n    .testimonial{margin-top:18px;padding:14px;border-left:4px solid rgba(123,90,163,0.12);background:linear-gradient(180deg,rgba(255,255,255,0.6),transparent)}\\n    section{margin-top:22px}\\n    .process-row{display:flex;gap:12px}\\n    .faq details{margin-top:8px}\\n    @media (max-width:900px){.services-grid{grid-template-columns:1fr}.process-row{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700;font-size:18px\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"hero\\\">\\n      <h1>Guided habits. Sustainable changes.</h1>\\n      <p class=\\\"intro\\\">Services designed to help you build life-supporting routines — informed by thoughtful frameworks and gentle accountability.</p>\\n      <div class=\\\"cta-row\\\">\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <a href=\\\"contact.html\\\" style=\\\"align-self:center;color:var(--muted);text-decoration:none\\\">Ask about a custom plan</a>\\n      </div>\\n    </div>\\n\\n    <section id=\\\"benefits\\\">\\n      <h2 style=\\\"margin-top:18px\\\">What you gain</h2>\\n      <div class=\\\"services-grid\\\">\\n        <div class=\\\"service\\\">\\n          <h3>Foundations Lab</h3>\\n          <div class=\\\"small\\\">4-week habit reset focused on sleep anchors and morning rhythm.</div>\\n        </div>\\n        <div class=\\\"service\\\">\\n          <h3>Momentum Sessions</h3>\\n          <div class=\\\"small\\\">8-week coaching for sustained progress and accountability.</div>\\n        </div>\\n        <div class=\\\"service\\\">\\n          <h3>Maintenance Support</h3>\\n          <div class=\\\"small\\\">Monthly check-ins to keep your practice steady without overwhelm.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"process\\\">\\n      <h2 style=\\\"margin-top:22px\\\">How a typical engagement flows</h2>\\n      <div class=\\\"process-row\\\">\\n        <div style=\\\"flex:1\\\" class=\\\"service\\\">\\n          <strong>Start</strong>\\n          <p class=\\\"small\\\">A 30–45 minute clarity call to outline goals and constraints.</p>\\n        </div>\\n        <div style=\\\"flex:1\\\" class=\\\"service\\\">\\n          <strong>Design</strong>\\n          <p class=\\\"small\\\">We pick 2–4 micro-habits. Each week, we test and adapt.</p>\\n        </div>\\n        <div style=\\\"flex:1\\\" class=\\\"service\\\">\\n          <strong>Embed</strong>\\n          <p class=\\\"small\\\">Transition to maintenance with simple, repeatable practices.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"social_proof\\\">\\n      <h2 style=\\\"margin-top:22px\\\">A few voices</h2>\\n      <div class=\\\"testimonial\\\">\\n        <div style=\\\"font-weight:700\\\">\\\"Calm, practical, and deeply supportive — a coach who understands life’s messiness.\\\"</div>\\n        <div class=\\\"small\\\">— K. P., {{STATE}}</div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"lead_magnet\\\">\\n      <h2 style=\\\"margin-top:22px\\\">Free guide: \\\"Evening Reset for Better Mornings\\\"</h2>\\n      <p class=\\\"small\\\">Short checklist to wind down and wake up with intention. Instant download.</p>\\n      <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Get the guide</a>\\n    </section>\\n\\n    <section id=\\\"faq\\\">\\n      <h2 style=\\\"margin-top:22px\\\">Service questions</h2>\\n      <div class=\\\"faq\\\">\\n        <details><summary>Do you offer single sessions?</summary><div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Yes. Single sessions are great for focused troubleshooting or planning a short-term experiment.</div></details>\\n        <details><summary>Can I switch programs?</summary><div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Absolutely. We tailor the path as your needs evolve.</div></details>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:26px;color:var(--muted)\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>Questions? <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">Email us</a> • {{PHONE}}</div>\\n        <div><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start now</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071017;--ink:#eef3f6;--muted:#99a3ad;--accent:#ffb86b;font-family:Inter,system-ui, -apple-system}\\n    body{margin:0;background:radial-gradient(circle at 10% 10%,#09202b 0%,#071017 40%);color:var(--ink)}\\n    .shell{max-width:1060px;margin:36px auto;padding:32px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:14px}\\n    .hero{padding:28px;border-radius:12px;background:linear-gradient(180deg,rgba(255,184,107,0.06),transparent);margin-top:18px}\\n    .hero h1{margin:0;font-size:30px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .tier{background:rgba(255,255,255,0.02);padding:16px;border-radius:12px}\\n    .tier h3{margin:0}\\n    .price{font-weight:700;color:var(--accent);margin-top:8px}\\n    .features{margin-top:8px;color:var(--muted)}\\n    .cta{margin-top:12px}\\n    .faq{margin-top:22px}\\n    .process{margin-top:22px;display:flex;gap:12px}\\n    .process .step{background:rgba(255,255,255,0.02);padding:12px;border-radius:8px}\\n    .lead{margin-top:22px;padding:18px;border-radius:10px;background:linear-gradient(90deg,rgba(255,184,107,0.06),transparent)}\\n    footer{margin-top:22px;color:var(--muted)}\\n    @media (max-width:980px){.grid{grid-template-columns:1fr}.process{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"shell\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"color:var(--muted);font-size:13px\\\">Programs shaped around lasting habits</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"hero\\\">\\n      <h1>Choose a sustainable path</h1>\\n      <p style=\\\"color:var(--muted);margin-top:8px\\\">Each program is grounded in habit experiments, short cycles of practice, and compassionate reflection.</p>\\n    </div>\\n\\n    <section id=\\\"program-list\\\">\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"tier\\\">\\n          <h3>Starter Path — \\\"Evening & Morning Reset\\\"</h3>\\n          <div class=\\\"price\\\">From $295 (one-time)</div>\\n          <div class=\\\"features\\\">2 sessions • one simple habit set • checklist</div>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" style=\\\"background:var(--accent);padding:8px 12px;border-radius:8px;color:#071017;text-decoration:none\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Begin Starter</a></div>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <h3>Growth Path — \\\"Momentum Builder\\\"</h3>\\n          <div class=\\\"price\\\">8-week plan • $1,150</div>\\n          <div class=\\\"features\\\">Weekly 30-min coaching, habit framework, progress workbook</div>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" style=\\\"background:var(--accent);padding:8px 12px;border-radius:8px;color:#071017;text-decoration:none\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Join Momentum</a></div>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <h3>Steady Path — \\\"Sustain & Flow\\\"</h3>\\n          <div class=\\\"price\\\">Monthly support • $320 / month</div>\\n          <div class=\\\"features\\\">Bi-weekly check-ins, priority messaging, quarterly review</div>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" style=\\\"background:var(--accent);padding:8px 12px;border-radius:8px;color:#071017;text-decoration:none\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start Sustaining</a></div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"process\\\" class=\\\"process\\\">\\n      <div class=\\\"step\\\">\\n        <strong>1. Clarity Call</strong>\\n        <div class=\\\"small\\\">30 minutes to focus your intention</div>\\n      </div>\\n      <div class=\\\"step\\\">\\n        <strong>2. Micro-habit Design</strong>\\n        <div class=\\\"small\\\">We pick the smallest useful actions and support practice.</div>\\n      </div>\\n      <div class=\\\"step\\\">\\n        <strong>3. Review & Transition</strong>\\n        <div class=\\\"small\\\">Embed wins and simplify for long-term upkeep.</div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"social_proof\\\" style=\\\"margin-top:22px\\\">\\n      <h2 style=\\\"color:var(--accent)\\\">Stories of change</h2>\\n      <div style=\\\"margin-top:8px;color:var(--muted)\\\">\\\"I stopped feeling like I needed a new strategy every week. Small experiments built trust in myself again.\\\" — M. G.</div>\\n    </section>\\n\\n    <section id=\\\"lead_magnet\\\" class=\\\"lead\\\">\\n      <h3>Free worksheet: \\\"Plan a 7-day habit experiment\\\"</h3>\\n      <p class=\\\"small\\\">A guided worksheet to map one habit, set measurement, and note adjustments.</p>\\n      <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"background:#fff;color:#071017;text-decoration:none;padding:8px 12px;border-radius:8px\\\">Get worksheet</a>\\n    </section>\\n\\n    <section id=\\\"faq\\\" class=\\\"faq\\\">\\n      <h2 style=\\\"margin-top:20px\\\">Program questions</h2>\\n      <details style=\\\"margin-top:8px\\\"><summary>How do you measure progress?</summary><div class=\\\"small\\\" style=\\\"margin-top:8px\\\">We track small, observable behaviors (did the habit happen?) and subjective ratings like energy and clarity.</div></details>\\n      <details style=\\\"margin-top:8px\\\"><summary>Do you work virtually?</summary><div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Yes — sessions are remote, with materials shared digitally.</div></details>\\n      <details style=\\\"margin-top:8px\\\"><summary>Are there refunds?</summary><div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Refunds are handled case-by-case; we aim for clarity up front about expectations.</div></details>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"small\\\">Ready to pick a path? <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{PRIMARY_CTA_LABEL}}</a> • Contact <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
