          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — About</title>\\n  <style>\\n    :root{--bg:#fbfbfb;--muted:#64707a;--accent:#6aa84f;--ink:#0b1720}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,Segoe UI,Helvetica,Arial; color:var(--ink);background:var(--bg)}\\n    .container{max-width:980px;margin:48px auto;padding:32px}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:8px 0}\\n    .brand{font-weight:600;letter-spacing:0.2px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:15px}\\n    .hero{display:grid;grid-template-columns:1fr 320px;gap:32px;align-items:center;padding:48px 0}\\n    .kicker{color:var(--muted);font-size:14px}\\n    h1{margin:8px 0 12px;font-size:36px;line-height:1.08}\\n    p.lead{margin:0;color:var(--muted);font-size:16px}\\n    .avatar{background:#fff;border-radius:12px;padding:24px;display:flex;align-items:center;justify-content:center}\\n    .card{background:#fff;padding:22px;border-radius:12px;box-shadow:0 6px 18px rgba(12,20,24,0.04)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:22px}\\n    .benefit{padding:18px;border-radius:10px;background:linear-gradient(180deg,#fff, #fbffef);border:1px solid rgba(106,168,79,0.06)}\\n    .muted{color:var(--muted)}\\n    .process{margin-top:28px}\\n    .step{display:flex;gap:12px;align-items:flex-start}\\n    .step .num{width:36px;height:36px;border-radius:10px;background:var(--accent);color:white;display:flex;align-items:center;justify-content:center;font-weight:600}\\n    .lead-magnet{display:flex;gap:12px;align-items:center;margin-top:28px}\\n    .input{padding:12px;border-radius:10px;border:1px solid #e6eef0;min-width:0;flex:1}\\n    .btn{background:var(--accent);color:white;border:none;padding:12px 16px;border-radius:10px;font-weight:600}\\n    footer{margin-top:48px;padding-top:24px;border-top:1px solid #eef2f3;color:var(--muted)}\\n    .faq{margin-top:28px}\\n    .q{margin-bottom:12px}\\n    /* small screens */\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}.container{padding:20px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <!-- Hero: who you are and the outcome -->\\n    <section class=\\\"hero\\\" aria-label=\\\"About hero\\\">\\n      <div>\\n        <div class=\\\"kicker\\\">Meet your guide</div>\\n        <h1>Gentle structure for lasting wellbeing</h1>\\n        <p class=\\\"lead\\\">I’m {{COACH_NAME}} ({{CREDENTIALS}}). I help people in {{CITY}}, {{STATE}} build small daily habits that reshape energy, sleep, and focus — without overwhelm or fad diets.</p>\\n\\n        <div style=\\\"margin-top:18px;display:flex;gap:12px\\\">\\n          <a href=\\\"book.html\\\" class=\\\"btn\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a href=\\\"contact.html\\\" style=\\\"padding:12px 16px;border-radius:10px;border:1px solid #e6eef0;color:var(--muted);text-decoration:none\\\">Ask a question</a>\\n        </div>\\n\\n        <!-- Social proof compact -->\\n        <div style=\\\"margin-top:18px;color:var(--muted);font-size:14px\\\">Trusted by local professionals and busy parents — average 4.8/5 satisfaction</div>\\n      </div>\\n\\n      <aside class=\\\"avatar card\\\">\\n        <!-- avatar svg unique to about.html -->\\n        <svg width=\\\"220\\\" height=\\\"220\\\" viewBox=\\\"0 0 220 220\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n          <rect rx=\\\"20\\\" width=\\\"220\\\" height=\\\"220\\\" fill=\\\"#fff\\\"/>\\n          <defs>\\n            <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n              <stop offset=\\\"0\\\" stop-color=\\\"#dff0d8\\\"/>\\n              <stop offset=\\\"1\\\" stop-color=\\\"#a9d79b\\\"/>\\n            </linearGradient>\\n          </defs>\\n          <circle cx=\\\"110\\\" cy=\\\"80\\\" r=\\\"36\\\" fill=\\\"url(#g1)\\\" />\\n          <rect x=\\\"56\\\" y=\\\"130\\\" width=\\\"108\\\" height=\\\"60\\\" rx=\\\"12\\\" fill=\\\"#f7fff2\\\" stroke=\\\"#e6f4d9\\\"/>\\n          <path d=\\\"M72 150c14 8 36 8 58 0\\\" stroke=\\\"#9fcf72\\\" stroke-width=\\\"4\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/>\\n        </svg>\\n      </aside>\\n    </section>\\n\\n    <!-- Benefits: outcomes-focused -->\\n    <section class=\\\"card\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">What clients gain</h2>\\n      <p class=\\\"muted\\\" style=\\\"margin:0 0 16px\\\">Clear, practical shifts you can keep.</p>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"benefit\\\">\\n          <strong>Consistent energy</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Simple routines to reduce mid-day crashes and steady motivation.</div>\\n        </div>\\n        <div class=\\\"benefit\\\">\\n          <strong>Better sleep habits</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Sleep-friendly evenings without heavy prescriptions or extreme curfews.</div>\\n        </div>\\n        <div class=\\\"benefit\\\">\\n          <strong>Manageable momentum</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Small, repeatable wins that compound into real change.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Process: coaching framework -->\\n    <section class=\\\"process card\\\">\\n      <h3 style=\\\"margin:0 0 12px\\\">How we work together</h3>\\n      <div class=\\\"step\\\"><div class=\\\"num\\\">1</div><div><strong>Map</strong><div class=\\\"muted\\\">We clarify what matters and realistic starting points.</div></div></div>\\n      <div class=\\\"step\\\" style=\\\"margin-top:12px\\\"><div class=\\\"num\\\">2</div><div><strong>Practice</strong><div class=\\\"muted\\\">We build micro-habits, one at a time, tracking what actually fits your life.</div></div></div>\\n      <div class=\\\"step\\\" style=\\\"margin-top:12px\\\"><div class=\\\"num\\\">3</div><div><strong>Anchor</strong><div class=\\\"muted\\\">We connect habits into daily rituals so benefits last past the program.</div></div></div>\\n    </section>\\n\\n    <!-- Lead magnet: simple free guide -->\\n    <section class=\\\"lead-magnet card\\\">\\n      <div style=\\\"flex:1\\\">\\n        <strong>Free guide: 7 evening rituals to sleep easier</strong>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Quick, evidence-informed habits that calm your nervous system before bed.</div>\\n      </div>\\n      <form style=\\\"display:flex;gap:8px;align-items:center\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\">\\n        <input class=\\\"input\\\" name=\\\"email\\\" placeholder=\\\"Your email\\\" aria-label=\\\"Email for guide\\\" />\\n        <button class=\\\"btn\\\">Get the guide</button>\\n      </form>\\n    </section>\\n\\n    <!-- FAQ: distinctive questions -->\\n    <section class=\\\"faq card\\\">\\n      <h4 style=\\\"margin:0 0 8px\\\">Common questions</h4>\\n      <div class=\\\"q\\\"><strong>Who is this for?</strong>\\n        <div class=\\\"muted\\\">People wanting steady, practical shifts — not quick fixes or extreme plans.</div></div>\\n      <div class=\\\"q\\\"><strong>Do you provide meal plans?</strong>\\n        <div class=\\\"muted\\\">We focus on routines and choices; specific medical or dietary therapy is referred out.</div></div>\\n      <div class=\\\"q\\\"><strong>How long until I notice a change?</strong>\\n        <div class=\\\"muted\\\">Clients report small wins in 2–3 weeks and clearer patterns in 8–12 weeks.</div></div>\\n    </section>\\n\\n    <!-- CTA footer -->\\n    <section style=\\\"margin-top:22px;display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"muted\\\">Ready to start a gentle plan?</div>\\n      <a href=\\\"book.html\\\" class=\\\"btn\\\">Work with {{COACH_NAME}}</a>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div class=\\\"muted\\\">© {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n        <div class=\\\"muted\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Offerings</title>\\n  <style>\\n    :root{--bg:#ffffff;--ink:#091217;--muted:#6b757a;--accent:#7aaed1}\\n    body{margin:0;background:var(--bg);font-family:Inter,system-ui,Segoe UI,Helvetica,Arial;color:var(--ink)}\\n    .wrap{max-width:980px;margin:48px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{color:var(--muted);text-decoration:none;margin-left:16px}\\n    .hero{padding:40px 0;border-bottom:1px solid #f2f4f6}\\n    h1{font-size:30px;margin:6px 0}\\n    .subtitle{color:var(--muted);margin-bottom:18px}\\n    .cards{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:18px}\\n    .offering{background:#f9fdff;padding:20px;border-radius:12px;border:1px solid rgba(122,174,209,0.08)}\\n    .offering h3{margin:0 0 6px}\\n    .meta{color:var(--muted);font-size:14px}\\n    .process{display:flex;gap:12px;margin-top:16px}\\n    .small{font-size:13px;color:var(--muted)}\\n    .lead{display:flex;gap:8px;margin-top:20px}\\n    .input{padding:10px;border-radius:10px;border:1px solid #e7eef5;flex:1}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;border:none}\\n    .social{margin-top:20px;color:var(--muted);font-size:14px}\\n    .faq{margin-top:22px}\\n    @media (max-width:880px){.cards{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"font-weight:600\\\">{{BUSINESS_NAME}}</div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n      </nav>\\n    </header>\\n\\n    <!-- Hero: Offering lens -->\\n    <section class=\\\"hero\\\">\\n      <h1>Structured support — tailored to your day</h1>\\n      <div class=\\\"subtitle\\\">Short-term sessions and ongoing coaching focused on habit change, restful routines, and clear energy practices.</div>\\n\\n      <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n        <a class=\\\"btn\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <a href=\\\"contact.html\\\" style=\\\"color:var(--muted);text-decoration:none\\\">Custom plans</a>\\n      </div>\\n    </section>\\n\\n    <!-- Social proof: testimonials highlight -->\\n    <section style=\\\"margin-top:20px\\\">\\n      <div class=\\\"small\\\">What people say</div>\\n      <div style=\\\"display:flex;gap:12px;margin-top:8px;flex-wrap:wrap\\\">\\n        <div style=\\\"background:#fff;border-radius:10px;padding:12px;min-width:220px;box-shadow:0 6px 18px rgba(9,18,23,0.04)\\\">\\n          <div style=\\\"font-weight:600\\\">\\\"Sustainable shifts\\\"</div>\\n          <div class=\\\"small\\\">\\\"After 6 weeks I finally wake rested without caffeine.\\\" — L.</div>\\n        </div>\\n        <div style=\\\"background:#fff;border-radius:10px;padding:12px;min-width:220px;box-shadow:0 6px 18px rgba(9,18,23,0.04)\\\">\\n          <div style=\\\"font-weight:600\\\">\\\"Real tools\\\"</div>\\n          <div class=\\\"small\\\">\\\"Practical prompts that actually fit my schedule.\\\" — A.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Services: list of offerings (benefits-focused) -->\\n    <section class=\\\"cards\\\" aria-label=\\\"Services list\\\">\\n      <div class=\\\"offering\\\">\\n        <h3>One-on-one coaching</h3>\\n        <div class=\\\"meta\\\">Personalized habit design and accountability. Remote sessions.</div>\\n        <div class=\\\"process\\\">\\n          <div style=\\\"font-weight:600\\\">Focus</div>\\n          <div class=\\\"small\\\">Energy, sleep, routines</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"offering\\\">\\n        <h3>Short-term Reset</h3>\\n        <div class=\\\"meta\\\">A 4-week intensive to break stagnation and create new anchors.</div>\\n        <div class=\\\"process\\\">\\n          <div style=\\\"font-weight:600\\\">Includes</div>\\n          <div class=\\\"small\\\">Weekly check-ins, habit tracker, micro-tasks</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"offering\\\">\\n        <h3>Workplace wellbeing consult</h3>\\n        <div class=\\\"meta\\\">Team workshops and compact frameworks to support employee stress resilience.</div>\\n        <div class=\\\"process\\\">\\n          <div style=\\\"font-weight:600\\\">Format</div>\\n          <div class=\\\"small\\\">Workshop + follow-up plan</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"offering\\\">\\n        <h3>Self-guided tools</h3>\\n        <div class=\\\"meta\\\">Downloadable frameworks and habit worksheets for independent use.</div>\\n        <div class=\\\"process\\\">\\n          <div style=\\\"font-weight:600\\\">Good for</div>\\n          <div class=\\\"small\\\">Busy schedules, budget-conscious clients</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Lead magnet inline (different metaphor) -->\\n    <section style=\\\"margin-top:22px;padding:18px;border-radius:12px;background:linear-gradient(180deg,#f8fbff,#ffffff);border:1px solid #e9f3fb\\\">\\n      <strong>Quick workbook: The 5-minute daily reset</strong>\\n      <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">A printable checklist and three tiny rituals to reclaim a calm hour each day.</div>\\n      <form style=\\\"display:flex;gap:8px;margin-top:12px\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\">\\n        <input class=\\\"input\\\" placeholder=\\\"Email\\\" name=\\\"email\\\" />\\n        <button class=\\\"btn\\\">Send me the workbook</button>\\n      </form>\\n    </section>\\n\\n    <!-- FAQ (distinct) -->\\n    <section class=\\\"faq\\\">\\n      <h4 style=\\\"margin:10px 0\\\">Questions people ask before booking</h4>\\n      <div class=\\\"small\\\">Do you offer sliding scale?</div>\\n      <div class=\\\"muted\\\" style=\\\"margin-bottom:12px\\\">Occasionally; reach out at {{EMAIL}} to discuss options.</div>\\n      <div class=\\\"small\\\">Are sessions virtual?</div>\\n      <div class=\\\"muted\\\" style=\\\"margin-bottom:12px\\\">Yes — video and phone options available.</div>\\n      <div class=\\\"small\\\">How often do we meet?</div>\\n      <div class=\\\"muted\\\">Weekly or biweekly, based on the program and needs.</div>\\n    </section>\\n\\n    <!-- CTA block -->\\n    <section style=\\\"margin-top:20px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div class=\\\"muted\\\">Ready for a simple, effective plan?</div>\\n      <a class=\\\"btn\\\" href=\\\"book.html\\\">Start a conversation</a>\\n    </section>\\n\\n    <footer style=\\\"margin-top:36px;color:var(--muted)\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n        <div>Call: <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Programs</title>\\n  <style>\\n    :root{--bg:#fbfcfd;--ink:#071018;--muted:#5f6a6f;--accent:#c67fbf}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Helvetica,Arial;background:var(--bg);color:var(--ink)}\\n    .wrap{max-width:980px;margin:40px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:14px}\\n    .hero{padding:26px 0}\\n    h1{margin:6px 0;font-size:30px}\\n    .description{color:var(--muted);margin-bottom:14px}\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\\n    .tier{background:#fff;padding:18px;border-radius:12px;border:1px solid rgba(198,127,191,0.08)}\\n    .tier h3{margin:0}\\n    .price{font-weight:700;margin-top:10px}\\n    .features{color:var(--muted);margin-top:10px;font-size:14px}\\n    .lead{display:flex;gap:8px;align-items:center;margin-top:18px}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;border:none}\\n    .faq{margin-top:22px}\\n    @media (max-width:980px){.tiers{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"font-weight:600\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">Story</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <!-- Hero: Programs introduced with metaphor of pathways -->\\n    <section class=\\\"hero\\\">\\n      <h1>Choose a path that fits your life</h1>\\n      <div class=\\\"description\\\">Three ways to work together: a focused jumpstart, steady coaching, or a guided independent track.</div>\\n    </section>\\n\\n    <!-- Unique pattern svg (inline) -->\\n    <div aria-hidden=\\\"true\\\" style=\\\"margin-bottom:18px\\\">\\n      <!-- assets/img/pattern.svg (unique to programs.html) -->\\n      <svg width=\\\"100%\\\" height=\\\"48\\\" viewBox=\\\"0 0 600 48\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" preserveAspectRatio=\\\"none\\\">\\n        <rect width=\\\"600\\\" height=\\\"48\\\" fill=\\\"#fff\\\"/>\\n        <g fill=\\\"none\\\" stroke=\\\"#f1d8f0\\\" stroke-width=\\\"16\\\" stroke-linecap=\\\"round\\\">\\n          <path d=\\\"M0 24 C120 0 240 48 360 24 C480 0 600 48 720 24\\\" transform=\\\"translate(-60,0)\\\"/>\\n        </g>\\n      </svg>\\n    </div>\\n\\n    <!-- Tiers: different program names and pricing framing -->\\n    <section class=\\\"tiers\\\">\\n      <div class=\\\"tier\\\">\\n        <h3>Starter Arc</h3>\\n        <div class=\\\"price\\\">$290 — 4 weeks</div>\\n        <div class=\\\"features\\\">\\n          2 coaching sessions, habit tracker, email check-ins. Ideal for quick changes and building momentum.\\n        </div>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Begin Starter Arc</a></div>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <h3>Nurture Program</h3>\\n        <div class=\\\"price\\\">$950 — 12 weeks</div>\\n        <div class=\\\"features\\\">Weekly sessions, tailored habit plan, sleep and energy modules, priority messaging.</div>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Join Nurture</a></div>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <h3>Independent Toolkit</h3>\\n        <div class=\\\"price\\\">$79 — self-paced</div>\\n        <div class=\\\"features\\\">Downloadable guides, evening and morning rituals, printable trackers for 90 days.</div>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"services.html\\\">Get the toolkit</a></div>\\n      </div>\\n    </section>\\n\\n    <!-- Social proof: short stats -->\\n    <section style=\\\"margin-top:18px;display:flex;gap:16px;align-items:center\\\">\\n      <div style=\\\"background:#fff;padding:12px;border-radius:10px;box-shadow:0 6px 18px rgba(7,16,24,0.04)\\\">\\n        <div style=\\\"font-weight:700\\\">4.8/5</div>\\n        <div class=\\\"small\\\" style=\\\"color:var(--muted)\\\">Average client rating</div>\\n      </div>\\n      <div style=\\\"background:#fff;padding:12px;border-radius:10px;box-shadow:0 6px 18px rgba(7,16,24,0.04)\\\">\\n        <div style=\\\"font-weight:700\\\">83%</div>\\n        <div class=\\\"small\\\" style=\\\"color:var(--muted)\\\">Report improved sleep within 8 weeks</div>\\n      </div>\\n    </section>\\n\\n    <!-- Lead magnet: different phrasing -->\\n    <section style=\\\"margin-top:20px;padding:16px;border-radius:12px;background:#fff;border:1px solid #f0e6f2\\\">\\n      <strong>Free checklist: The 10-minute morning reset</strong>\\n      <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">A short routine you can do on even the busiest mornings to set a calm tone for the day.</div>\\n      <form style=\\\"display:flex;gap:8px;margin-top:10px\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\">\\n        <input class=\\\"input\\\" name=\\\"email\\\" placeholder=\\\"Email address\\\" />\\n        <button class=\\\"btn\\\">Send checklist</button>\\n      </form>\\n    </section>\\n\\n    <!-- FAQ: fresh questions -->\\n    <section class=\\\"faq\\\" style=\\\"margin-top:20px\\\">\\n      <h4 style=\\\"margin:6px 0\\\">Program questions</h4>\\n      <div class=\\\"small\\\"><strong>Is there homework?</strong><