          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff9f2;--accent:#ff6b6b;--muted:#6b6b6b;--card:#fff;--radius:14px;--fw-bold:700}\\n    body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;line-height:1.45;margin:0;background:var(--bg);color:#1b1b1b}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:28px 36px}\\n    nav a{margin:0 12px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .brand h1{margin:0;font-size:18px;font-weight:var(--fw-bold);letter-spacing:0.4px}\\n    .container{max-width:1100px;margin:28px auto;padding:24px}\\n    .hero{background:linear-gradient(135deg,#fff 60%,rgba(255,107,107,0.06));border-radius:var(--radius);display:grid;grid-template-columns:1fr 360px;gap:28px;padding:34px;align-items:center}\\n    .hero h2{margin:0;font-size:28px;color:#222}\\n    .lead{color:var(--muted);margin-top:10px}\\n    .pill{display:inline-block;background:#fff;border-radius:999px;padding:8px 12px;font-weight:700;color:var(--accent);margin-top:14px}\\n    .card{background:var(--card);border-radius:12px;padding:18px;margin-top:18px;box-shadow:0 6px 24px rgba(11,12,14,0.06)}\\n    .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:18px}\\n    .micro{display:flex;gap:12px;align-items:center}\\n    footer{padding:40px;text-align:center;color:var(--muted)}\\n    .cta{display:inline-block;margin-top:18px;background:var(--accent);color:#fff;padding:12px 18px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .nav-ghost{font-size:13px;color:var(--muted)}\\n    /* playful accents */\\n    .accent-ring{width:140px;height:140px;border-radius:18px;background:linear-gradient(180deg,#ffdede,#fff);display:flex;align-items:center;justify-content:center}\\n    .muted-small{font-size:13px;color:var(--muted)}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.grid-3{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <svg width=\\\"48\\\" height=\\\"48\\\" viewBox=\\\"0 0 48 48\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n        <rect width=\\\"48\\\" height=\\\"48\\\" rx=\\\"12\\\" fill=\\\"#FFEBE8\\\"/>\\n        <path d=\\\"M12 30c4-6 10-10 16-8\\\" stroke=\\\"#FF6B6B\\\" stroke-width=\\\"2.5\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/>\\n        <circle cx=\\\"34\\\" cy=\\\"14\\\" r=\\\"6\\\" fill=\\\"#FFD7D7\\\" stroke=\\\"#FF6B6B\\\" stroke-width=\\\"1.5\\\"/>\\n      </svg>\\n      <h1>{{BUSINESS_NAME}}</h1>\\n    </div>\\n    <nav class=\\\"nav-ghost\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <div class=\\\"pill\\\">Guidance with a gentle edge</div>\\n        <h2>About the way I guide — a practical spirituality for daily living</h2>\\n        <p class=\\\"lead\\\">I\\u2019m {{COACH_NAME}} {{CREDENTIALS}} — I blend somatic awareness, simple habit design, and soulful frameworks so you can come back to balance without burnout. My work is outcome-focused: steady energy, clearer days, and rituals that hold.</p>\\n\\n        <div class=\\\"card\\\">\\n          <strong>My promise</strong>\\n          <p class=\\\"muted-small\\\">No quick fixes. Tools you can use in ten minutes or less that add up, weeks after week.</p>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"display:flex;flex-direction:column;align-items:center;gap:14px;\\\">\\n        <!-- Inline unique SVG acting as avatar/hero art -->\\n        <svg width=\\\"100%\\\" height=\\\"100%\\\" viewBox=\\\"0 0 360 220\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" role=\\\"img\\\" aria-label=\\\"hero image\\\">\\n          <rect width=\\\"360\\\" height=\\\"220\\\" rx=\\\"18\\\" fill=\\\"url(#g)\\\" />\\n          <defs>\\n            <linearGradient id=\\\"g\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n              <stop offset=\\\"0\\\" stop-color=\\\"#fff0ef\\\"/>\\n              <stop offset=\\\"1\\\" stop-color=\\\"#fff\\\"/>\\n            </linearGradient>\\n          </defs>\\n          <g transform=\\\"translate(28,24)\\\">\\n            <ellipse cx=\\\"120\\\" cy=\\\"80\\\" rx=\\\"80\\\" ry=\\\"60\\\" fill=\\\"#FFF1F0\\\"/>\\n            <path d=\\\"M40 110c30-18 70-18 110 0\\\" stroke=\\\"#FF6B6B\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/>\\n            <circle cx=\\\"220\\\" cy=\\\"30\\\" r=\\\"18\\\" fill=\\\"#FFD7D7\\\"/>\\n            <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"60\\\" height=\\\"60\\\" rx=\\\"12\\\" fill=\\\"#FFEDED\\\"/>\\n          </g>\\n        </svg>\\n\\n        <div class=\\\"accent-ring card\\\">\\n          <div style=\\\"text-align:center\\\">\\n            <div style=\\\"font-weight:800;color:#FF6B6B\\\">Free Snapshot</div>\\n            <div class=\\\"muted-small\\\">Receive a quick 7-question diagnostic to map what's working.</div>\\n            <a href=\\\"services.html#diagnostic\\\" class=\\\"cta\\\" style=\\\"background:#ff8b8b;margin-top:10px;display:inline-block\\\">Take the Snapshot</a>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:28px;\\\">\\n      <h3>The Wellness Snapshot (diagnostic)</h3>\\n      <p class=\\\"muted-small\\\">A short reflective tool I use with all new clients. It surfaces patterns in energy, sleep, boundaries, and pleasure. You can try a version on the Offerings page.</p>\\n      <div class=\\\"grid-3\\\">\\n        <div>\\n          <strong>Energy</strong>\\n          <p class=\\\"muted-small\\\">Small wins to stabilize afternoons without caffeine spikes.</p>\\n        </div>\\n        <div>\\n          <strong>Rhythm</strong>\\n          <p class=\\\"muted-small\\\">Daily micro-habits that build natural momentum.</p>\\n        </div>\\n        <div>\\n          <strong>Clarity</strong>\\n          <p class=\\\"muted-small\\\">Simple frameworks to translate feeling into action.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:22px;\\\">\\n      <h3>The 3-Phase Ritual (plan)</h3>\\n      <ol class=\\\"muted-small\\\">\\n        <li><strong>Anchor</strong> \\u2014 Gentle morning reset: breath + intention (5\\u201310 min).</li>\\n        <li><strong>Design</strong> \\u2014 Daily micro-habit pairing: attach one new practice to an existing routine.</li>\\n        <li><strong>Collect</strong> \\u2014 Weekly reflection: short ritual to review signals and adjust.</li>\\n      </ol>\\n      <p class=\\\"muted-small\\\">This scaffold appears across all programs as a living blueprint. It\\u2019s how small acts compound into steady change.</p>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:22px;\\\">\\n      <h3>Micro-habits I teach</h3>\\n      <ul class=\\\"muted-small\\\">\\n        <li>One mindful sip: turn one beverage pause into a grounding breath.</li>\\n        <li>Two-minute tidy: reset a single surface to clear the mind.</li>\\n        <li>Evening inbox ritual: three quick triage steps to end the day with calm.</li>\\n      </ul>\\n      <p class=\\\"muted-small\\\">These small practices create the conditions for larger shifts without extra friction.</p>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:22px;\\\">\\n      <h3>Investment (pricing ripple)</h3>\\n      <p class=\\\"muted-small\\\">I offer one-on-one mentorship, small cohorts, and short intensives. See the full breakdown on the Pricing page. Scholarships available; I believe access matters.</p>\\n      <a href=\\\"pricing.html\\\" class=\\\"cta\\\">View Pricing Options</a>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:22px;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;\\\">\\n      <div>\\n        <h3>Ready to begin?</h3>\\n        <p class=\\\"muted-small\\\">Start with the Snapshot and get a personalized short plan within 48 hours.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n      <div style=\\\"min-width:220px;text-align:right;\\\" class=\\\"muted-small\\\">Or call <strong>{{PHONE}}</strong> — local to {{CITY}}, {{STATE}}.</div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"muted-small\\\">© {{BUSINESS_NAME}} • {{COACH_NAME}} {{CREDENTIALS}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Offerings — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--accent:#2b9d8f;--muted:#586068;--card:#fbfffe;--radius:12px}\\n    body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;margin:0;background:var(--bg);color:#0b0b0b}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:22px 34px;border-bottom:1px solid #f3f4f6}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none}\\n    .logo{display:flex;align-items:center;gap:10px}\\n    .container{max-width:1040px;margin:26px auto;padding:20px}\\n    .hero{border-radius:16px;padding:28px;background:linear-gradient(90deg,#f8fffd 0%,#fbfff6 100%);display:flex;gap:22px;align-items:center}\\n    .hero-text h2{margin:0;font-size:26px}\\n    .muted{color:var(--muted)}\\n    .list{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:18px}\\n    .item{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 10px 30px rgba(43,157,143,0.04)}\\n    .meta{font-size:13px;color:var(--muted);margin-top:8px}\\n    .cta{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{padding:32px;text-align:center;color:var(--muted)}\\n    @media(max-width:800px){.list{grid-template-columns:1fr}.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">\\n      <svg width=\\\"44\\\" height=\\\"44\\\" viewBox=\\\"0 0 44 44\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n        <rect width=\\\"44\\\" height=\\\"44\\\" rx=\\\"10\\\" fill=\\\"#E6FFFB\\\"/>\\n        <path d=\\\"M12 30c12-14 20-12 26-18\\\" stroke=\\\"#2B9D8F\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/>\\n      </svg>\\n      <strong>{{BUSINESS_NAME}}</strong>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Work With Me</a>\\n      <a href=\\\"programs.html\\\">Programs</a>\\n      <a href=\\\"testimonials.html\\\">Praise</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-text\\\">\\n        <div style=\\\"font-size:13px;color:var(--muted);font-weight:700;letter-spacing:0.6px\\\">Offerings</div>\\n        <h2>Modalities tuned for lasting ease</h2>\\n        <p class=\\\"muted\\\">Choose a format that fits your life rhythm: solo mentorship, cohort learning, or bite-sized intensives. Every offering integrates a short diagnostic, a practical plan, and tiny daily practices you can keep.</p>\\n        <a class=\\\"cta\\\" href=\\\"#offerings\\\">See formats</a>\\n      </div>\\n\\n      <div style=\\\"width:220px\\\">\\n        <!-- unique small pattern SVG -->\\n        <svg viewBox=\\\"0 0 220 220\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n          <rect width=\\\"220\\\" height=\\\"220\\\" rx=\\\"22\\\" fill=\\\"#F1FFFB\\\"/>\\n          <g transform=\\\"translate(18,18)\\\">\\n            <circle cx=\\\"40\\\" cy=\\\"40\\\" r=\\\"36\\\" fill=\\\"#DFFBF6\\\"/>\\n            <path d=\\\"M12 120c22-28 62-28 88-2\\\" stroke=\\\"#2B9D8F\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/>\\n            <rect x=\\\"120\\\" y=\\\"12\\\" width=\\\"56\\\" height=\\\"56\\\" rx=\\\"10\\\" fill=\\\"#E6FFFB\\\"/>\\n          </g>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"offerings\\\" style=\\\"margin-top:18px;\\\">\\n      <div class=\\\"list\\\">\\n        <div class=\\\"item\\\">\\n          <h4>One-on-One Mentoring</h4>\\n          <p class=\\\"muted\\\">Tailored weekly sessions. We build a pocket-sized framework that maps to your life and obligations.</p>\\n          <div class=\\\"meta\\\">Includes diagnostic, habit plan, and weekly accountability.\\n            <div style=\\\"margin-top:10px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Book a consult</a></div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"item\\\">\\n          <h4>Small Cohorts</h4>\\n          <p class=\\\"muted\\\">Group learning with intentional sharing. Learn the same frameworks together and practice habits in a supported setting.</p>\\n          <div class=\\\"meta\\\">Limited seats per cohort. Cohorts run quarterly.\\n            <div style=\\\"margin-top:10px\\\"><a class=\\\"cta\\\" href=\\\"programs.html\\\">Explore cohorts</a></div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"item\\\">\\n          <h4>Intensives &amp; Mini-Retreats</h4>\\n          <p class=\\\"muted\\\">Focused 1-3 day experiences to reset rhythm and leave with a customized micro-plan.</p>\\n          <div class=\\\"meta\\\">Ideal for transitions: career shifts, seasonal resets.\\n            <div style=\\\"margin-top:10px\\\"><a class=\\\"cta\\\" href=\\\"contact.html\\\">Inquire</a></div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"item\\\">\\n          <h4>Digital Guides + Mini-Courses</h4>\\n          <p class=\\\"muted\\\">Self-paced modules that introduce the structures I use most: anchor, design, collect.</p>\\n          <div class=\\\"meta\\\">Starts with a free guide: \\\"Seven Tiny Habits to Reclaim Your Day.\\\" <a href=\\\"book.html\\\" style=\\\"text-decoration:none;color:var(--accent);font-weight:700\\\">Get the guide</a></div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:22px;padding:18px;border-radius:12px;background:#FBFFFE;\\\">\\n      <h3>Clarity Scan (diagnostic)</h3>\\n      <p class=\\\"muted\\\">A quick set of prompts that map energy, responsibility load, and capacity. It\\u2019s part data, part narrative: we use it to speak clearly about what will actually stick.</p>\\n      <a class=\\\"cta\\\" href=\\\"#clarity\\\">Try the scan</a>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;display:grid;grid-template-columns:1fr 320px;gap:18px;align-items:start\\\">\\n      <div class=\\\"card\\\">\\n        <h3>Frameworks I use (plan)</h3>\\n        <p class=\\\"muted\\\">Across formats I return to three practical frames:</p>\\n        <ul class=\\\"muted\\\">\\n          <li><strong>Anchor</strong> \\u2014 Start-of-day practices that orient attention.</li>\\n          <li><strong>Pairing</strong> \\u2014 Attach new habits to existing routines to reduce friction.</li>\\n          <li><strong>Weekly Triage</strong> \\u2014 Short reviews that keep the system alive and adaptive.</li>\\n        </ul>\\n        <p class=\\\"muted\\\">Every program leans into these; the difference is pacing and social support.</p>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <h4>Micro-habits spotlight</h4>\\n        <p class=\\\"muted\\\">A sample practice I share with clients: \\\"The 60-second reset\\\" \\u2014 close your eyes, soften your jaw, identify one next action. Repeat whenever overwhelm spikes.</p>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"programs.html\\\">See Programs</a></div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;\\\">\\n      <div class=\\\"card\\\">\\n        <h3>Investment tiers (pricing)</h3>\\n        <p class=\\\"muted\\\">I frame pricing around time, access, and support. On the Pricing page you\\u2019ll see tiered options: Self-Guided, Mentor, and Cohort. Sliding scale is available for select offerings.</p>\\n        <a class=\\\"cta\\\" href=\\\"pricing.html\\\">View full breakdown</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;\\\" class=\\\"card\\\">\\n      <h3>Want a sample plan?</h3>\\n      <p class=\\\"muted\\\">Sign up and I\\u2019ll send a one-page starter plan that outlines three micro-habits tailored to your Snapshot results.</p>\\n      <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" style=\\\"display:flex;gap:8px;margin-top:8px;flex-wrap:wrap\\\">\\n        <input name=\\\"email\\\" placeholder=\\\"Your email\\\" style=\\\"flex:1;padding:10px;border-radius:8px;border:1px solid #e6f2ef\\\" />\\n        <button class=\\\"cta\\\" type=\\\"submit\\\">Send starter</button>\\n      </form>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px;\\\">\\n      <h3>Common questions</h3>\\n      <details style=\\\"margin-top:8px\\\"><summary class=\\\"muted\\\">How quickly do clients feel change?</summary><div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Many notice subtle shifts within 7-14 days when daily mini-practices are consistent; larger effects follow months in. Experiences vary.</div></details>\\n      <details style=\\\"margin-top:8px\\\"><summary class=\\\"muted\\\">Do you offer sliding scale?</summary><div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Yes. A limited number of spots per offering are reserved for sliding scale applicants. Inquire via the Contact page.</div></details>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"muted\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • Call <strong>{{PHONE}}</strong> • Based in {{CITY}}, {{STATE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff8ff;--accent:#7b61ff;--muted:#666;--card:#fff;--radius:16px}\\n    body{font-family:Inter,system-ui,Segoe UI,Roboto,Arial;color:#111;margin:0;background:var(--bg)}\\n    header{display:flex;justify-content:space-between;padding:20px 30px;align-items:center}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none}\\n    .container{max-width:1100px;margin:26px auto;padding:18px}\\n    .hero{display:flex;gap:22px;align-items:center;background:linear-gradient(90deg,#fff8ff,#fbf6ff);padding:28px;border-radius:18px}\\n    .hero h1{margin:0;font-size:28px}\\n    .programs{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:18px}\\n    .prog{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 14px 30px rgba(123,97,255,0.06)}\\n    .muted{color:var(--muted)}\\n    .cta{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .faq{margin-top:18px}\\n    footer{padding:34px;text-align:center;color:var(--muted)}\\n    @media(max-width:980px){.programs{grid-template-columns:1fr 1fr}.hero{flex-direction:column}}\\n    @media(max-width:640px){.programs{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <svg width=\\\"46\\\" height=\\\"46\\\" viewBox=\\\"0 0 46 46\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n        <rect width=\\\"46\\\" height=\\\"46\\\" rx=\\\"10\\\" fill=\\\"#F3EEFF\\\"/>\\n        <path d=\\\"M10 34c18-20 28-14 30-24\\\" stroke=\\\"#7B61FF\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/>\\n      </svg>\\n      <strong>{{BUSINESS_NAME}}</strong>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Programs</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Curated cohorts and guided paths</h1>\\n        <p class=\\\"muted\\\">I design programs as lived experiments: clear start, reproducible habits, and community momentum. Each program begins with a diagnostic and ends with a personalized micro-habit map.</p>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Enquire for next cohort</a>\\n      </div>\\n\\n      <div style=\\\"width:220px\\\">\\n        <!-- unique program pattern SVG -->\\n        <svg viewBox=\\\"0 0 220 140\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n          <rect width=\\\"220\\\" height=\\\"140\\\" rx=\\\"16\\\" fill=\\\"#F7F3FF\\\"/>\\n          <g transform=\\\"translate(16,16)\\\">\\n            <circle cx=\\\"40\\\" cy=\\\"48\\\" r=\\\"34\\\" fill=\\\"#EFE9FF\\\"/>\\n            <rect x=\\\"92\\\" y=\\\"10\\\" width=\\\"96\\\" height=\\\"96\\\" rx=\\\"12\\\" fill=\\\"#F0E8FF\\\"/>\\n            <path d=\\\"M0 120c36-30 72-20 140-40\\\" stroke=\\\"#7B61FF\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/>\\n          </g>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;\\\">\\n      <div class=\\\"programs\\\">\\n        <article class=\\\"prog\\\">\\n          <h4>Foundations Path</h4>\\n          <p class=\\\"muted\\\">A 12-week guided path for cultivating day-to-day steadiness. Weekly lessons, a short diagnostic, and practical micro-habits to anchor progress.</p>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:10px\\\"><strong>Format:</strong> Small group + one short 1:1 setup call.</p>\\n          <div style=\\\"margin-top:12px;display:flex;gap:8px;align-items:center;justify-content:space-between\\\">\\n            <div class=\\\"muted\\\">Contribution starts at <strong>$</strong> (see pricing)</div>\\n            <a class=\\\"cta\\\" href=\\\"programs.html#foundations\\\">Learn more</a>\\n          </div>\\n        </article>\\n\\n        <article class=\\\"prog\\\">\\n          <h4>Seasonal Circle (cohort)</h4>\\n          <p class=\\\"muted\\\">Quarterly cohort that focuses on rhythm, reflection, and social accountability. Includes weekly live sessions and a shared practice workbook.</p>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:10px\\\"><strong>Format:</strong> 8-week live cohort with peer pods.</p>\\n          <div style=\\\"margin-top:12px;display:flex;gap:8px;align-items:center;justify-content:space-between\\\">\\n            <div class=\\\"muted\\\">Sliding scale and scholarships available</div>\\n            <a class=\\\"cta\\\" href=\\\"programs.html#circle\\\">Apply</a>\\n          </div>\\n        </article>\\n\\n        <article class=\\\"prog\\\">\\n          <h4>Soulful Sprint (intensive)</h4>\\n          <p class=\\\"muted\\\">A focused 3-week sprint to reboot specific habits (sleep, boundaries, or creative practice). High-touch, practical, immediate tools.</p>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:10px\\\"><strong>Format:</strong> 3 weeks, 2 live sessions, daily micro-assignments.</p>\\n          <div style=\\\"margin-top:12px;display:flex;gap:8px;align-items:center;justify-content:space-between\\\">\\n            <div class=\\\"muted\\\">One-time cohort fee</div>\\n            <a class=\\\"cta\\\" href=\\\"programs.html#sprint\\\">Apply</a>\\n          </div>\\n        </article>\\n\\n      </div>\\n    </section>\\n\\n    <section id=\\\"foundations\\\" style=\\\"margin-top:18px;\\\" class=\\\"card\\\">\\n      <h3>What you receive (plan + micro_habits)</h3>\\n      <ul class=\\\"muted\\\">\\n        <li>Initial diagnostic and a compact 7-day starter plan tailored to your results.</li>\\n        <li>Micro-habit prescriptions: 3 tiny habits tied to your current rhythms.</li>\\n        <li>Weekly prompts and short reflections to keep momentum without overwhelm.</li>\\n      </ul>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;display:flex;gap:18px;align-items:flex-start;flex-wrap:wrap\\\">\\n      <div class=\\\"card\\\" style=\\\"flex:1;min-width:320px;\\\">\\n        <h3>Pricing framing</h3>\\n        <p class=\\\"muted\\\">Because these are cohort-based, I frame contribution as a collective commitment. You choose a contribution tier during enrollment. There\\u2019s also an option to spread payments or request a scholarship.</p>\\n        <a class=\\\"cta\\\" href=\\\"pricing.html\\\">See payment options</a>\\n      </div>\\n\\n      <aside class=\\\"card\\\" style=\\\"width:320px;\\\">\\n        <h4>Free lead magnet</h4>\\n        <p class=\\\"muted\\\">Download my \\\"Seven Tiny Habits to Reclaim Your Day\\\" and receive a one-page checklist you can use immediately.</p>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Get the checklist</a>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"faq card\\\" style=\\\"margin-top:18px;padding:16px;border-radius:12px;\\\">\\n      <h3>Questions people often ask</h3>\\n      <details style=\\\"margin-top:8px\\\"><summary class=\\\"muted\\\">Will this work if I have an unpredictable schedule?</summary><div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Yes. Programs emphasize micro-habits that adapt to variable days; the cohort structure also shares creative adaptations from others with similar constraints.</div></details>\\n      <details style=\\\"margin-top:8px\\\"><summary class=\\\"muted\\\">How much time per week?</summary><div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Most cohorts ask for 30\\u201360 minutes of focused engagement weekly, plus small daily micro-practices (often 2-10 minutes).</div></details>\\n      <details style=\\\"margin-top:8px\\\"><summary class=\\\"muted\\\">Are sessions recorded?</summary><div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Yes, all live content is recorded. Group work and live exchanges are best experienced in real time but recordings cover lessons and prompts.</div></details>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;\\\" class=\\\"card\\\">\\n      <h3>Ready to join a cohort?</h3>\\n      <p class=\\\"muted\\\">Apply to the next Seasonal Circle or request a consult to find the best path for you.</p>\\n      <div style=\\\"display:flex;gap:12px;flex-wrap:wrap\\\">\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Request consult</a>\\n        <a class=\\\"cta\\\" href=\\\"contact.html\\\" style=\\\"background:#5e4bff\\\">Apply to cohort</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"muted\\\">{{BUSINESS_NAME}} • {{COACH_NAME}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}} • Based in {{CITY}}, {{STATE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
