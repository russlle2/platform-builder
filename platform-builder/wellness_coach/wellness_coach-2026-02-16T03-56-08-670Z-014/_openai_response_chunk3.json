          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Investment Options</title>\\n  <style>\\n    :root{--bg:#fff7fb;--accent:#ff6fb5;--muted:#6b6b76;--card:#ffffff;--glass:rgba(255,255,255,0.6);--radius:16px}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:#2b2b35;background:linear-gradient(180deg,var(--bg),#fff);}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 40px}\\n    nav a{margin:0 12px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .logo{display:flex;gap:12px;align-items:center}\\n    .logo svg{width:56px;height:56px}\\n    .wrap{max-width:1100px;margin:32px auto;padding:28px}\\n    .hero{display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:center;background:linear-gradient(135deg,#fff,#fff9ff);padding:30px;border-radius:18px;box-shadow:0 8px 30px rgba(0,0,0,0.06)}\\n    .eyebrow{color:var(--accent);font-weight:800;letter-spacing:0.6px}\\n    h1{margin:8px 0 12px;font-size:28px}\\n    p.lead{color:var(--muted);margin:0 0 20px}\\n    .card{background:var(--card);padding:20px;border-radius:14px;box-shadow:0 6px 18px rgba(17,12,34,0.06)}\\n    .tiers{display:flex;gap:18px}\\n    .tier{flex:1;padding:18px;border-radius:12px;background:linear-gradient(180deg,#fff,#fffefc);border:1px solid rgba(16,12,24,0.04)}\\n    .price{font-size:22px;font-weight:800;color:#111}\\n    .btn{display:inline-block;background:var(--accent);color:white;padding:12px 18px;border-radius:12px;text-decoration:none;font-weight:700;margin-top:12px}\\n    .muted{color:var(--muted);font-size:13px}\\n    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:20px}\\n    footer{padding:28px 40px;text-align:center;color:var(--muted);font-size:13px}\\n    .pill{background:linear-gradient(90deg,#ffeaf6,#fff3f9);padding:8px 12px;border-radius:999px;font-weight:700;color:#b20066}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">\\n      <svg viewBox=\\\"0 0 60 60\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\"><defs/><circle cx=\\\"30\\\" cy=\\\"30\\\" r=\\\"28\\\" fill=\\\"#fff0f7\\\"/><path d=\\\"M15 35c6-10 18-10 24 0\\\" stroke=\\\"#ff6fb5\\\" stroke-width=\\\"3\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/></svg>\\n      <div>\\n        <div style=\\\"font-weight:900\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted);margin-top:4px\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Paths</a>\\n      <a href=\\\"services.html\\\">Offers</a>\\n      <a href=\\\"pricing.html\\\" style=\\\"color:var(--accent)\\\">Investment</a>\\n      <a href=\\\"book.html\\\">Start</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <div class=\\\"eyebrow\\\">INVEST IN RITUALS</div>\\n        <h1>Pricing designed for real transformation — cohort-style guidance</h1>\\n        <p class=\\\"lead\\\">Join a paced, community-backed cohort where we simplify habits into doable practices. No fads, just frameworks that shift energy and routine.</p>\\n        <div class=\\\"card\\\">\\n          <strong>Diagnostic & Guided Plan</strong>\\n          <p class=\\\"muted\\\" style=\\\"margin:8px 0 0\\\">Every enrollment includes a 60-minute diagnostic session that maps your current habits, energy rhythms, and friction points.</p>\\n          <a class=\\\"btn\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div>\\n            <div style=\\\"font-size:12px;color:var(--muted);font-weight:700\\\">Upcoming Cohort</div>\\n            <div style=\\\"font-weight:900;margin-top:6px\\\">Moonlight Cohort — 8 weeks</div>\\n            <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Starts: next month • Limited to 12 people</div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <div style=\\\"font-size:12px;color:var(--muted)\\\">Spiral</div>\\n            <div style=\\\"font-weight:800;color:#ff6fb5\\\">Group-led + 1:1 check-ins</div>\\n          </div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px\\\">\\n      <div class=\\\"card\\\">\\n        <h2 style=\\\"margin:0 0 8px\\\">How the pricing works</h2>\\n        <p class=\\\"muted\\\">We frame investment around outcomes and pacing. Each tier includes the diagnostic, weekly cohort session, and a habit blueprint with micro-practices you can start today.</p>\\n\\n        <div class=\\\"tiers\\\" style=\\\"margin-top:16px\\\">\\n          <div class=\\\"tier\\\">\\n            <div style=\\\"font-size:13px;color:var(--muted);font-weight:700\\\">Essentials (Cohort)</div>\\n            <div class=\\\"price\\\">$497</div>\\n            <p class=\\\"muted\\\">8 weeks • Weekly group calls • Habit blueprint • Community Slack</p>\\n            <a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve spot</a>\\n          </div>\\n\\n          <div class=\\\"tier\\\">\\n            <div style=\\\"font-size:13px;color:var(--muted);font-weight:700\\\">Guided Path (Cohort + 1:1)</div>\\n            <div class=\\\"price\\\">$997</div>\\n            <p class=\\\"muted\\\">Everything in Essentials + three 1:1 strategy sessions and personalized micro-habit map.</p>\\n            <a class=\\\"btn\\\" href=\\\"book.html\\\">Join Guided Path</a>\\n          </div>\\n\\n          <div class=\\\"tier\\\">\\n            <div style=\\\"font-size:13px;color:var(--muted);font-weight:700\\\">Nurture (VIP Cohort)</div>\\n            <div class=\\\"price\\\">$2,400</div>\\n            <p class=\\\"muted\\\">All Guided Path benefits, weekly check-ins, priority support, and a bespoke ritual design.</p>\\n            <a class=\\\"btn\\\" href=\\\"contact.html\\\">Inquiry</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"grid-2\\\" style=\\\"margin-top:18px\\\">\\n          <div>\\n            <h3 style=\\\"margin:0\\\">Micro-habits included</h3>\\n            <p class=\\\"muted\\\" style=\\\"margin:6px 0 0\\\">Each cohort centers on 6 micro-habits you can layer into your day — breath anchors, mini-reflections, energy resets, movement bursts, sleep cues, and gratitude practices.</p>\\n          </div>\\n          <div>\\n            <h3 style=\\\"margin:0\\\">Diagnostic snapshot</h3>\\n            <p class=\\\"muted\\\" style=\\\"margin:6px 0 0\\\">Your diagnostic creates a visual habit map. We prioritize 3 leverage habits for the first 4 weeks and iterate based on cohort learning.</p>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:16px\\\" class=\\\"muted\\\">All payments processed securely. Refund policy: full refund within 7 days of enrollment if no materials accessed.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:24px\\\">\\n      <div class=\\\"card\\\">\\n        <h2 style=\\\"margin:0 0 8px\\\">Common questions before you commit</h2>\\n        <div style=\\\"display:grid;gap:10px;margin-top:8px\\\">\\n          <div>\\n            <strong>How big are the cohorts?</strong>\\n            <div class=\\\"muted\\\">Usually 8–12 participants to keep the experience intimate and supportive.</div>\\n          </div>\\n          <div>\\n            <strong>Do I need prior practice?</strong>\\n            <div class=\\\"muted\\\">No—cohorts are paced for beginners and seasoned practitioners. The diagnostic meets you where you are.</div>\\n          </div>\\n          <div>\\n            <strong>What if I miss a session?</strong>\\n            <div class=\\\"muted\\\">All sessions are recorded and paired with a short practice to keep momentum.</div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <div class=\\\"pill\\\">Cohort Model • Shared ascent</div>\\n        <h3 style=\\\"margin:8px 0\\\">Ready to choose your path?</h3>\\n        <p class=\\\"muted\\\">Pick a tier that fits your capacity and commitment. Most clients start with Guided Path.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Stories — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--accent:#6df0c4;--dark:#132226;--soft:#7b7b81}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;background:linear-gradient(180deg,#f7fff9,#ffffff);color:var(--dark)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:26px 36px}\\n    nav a{margin-left:14px;color:var(--soft);text-decoration:none}\\n    .hero{max-width:1000px;margin:22px auto;padding:24px;border-radius:16px;display:grid;grid-template-columns:1fr 300px;gap:20px}\\n    .quote{font-size:20px;font-weight:800;color:#0c2b24}\\n    .muted{color:var(--soft)}\\n    .card{background:#fff;padding:18px;border-radius:12px;box-shadow:0 8px 30px rgba(4,12,12,0.04)}\\n    .test-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:18px}\\n    .testimonial{padding:14px;border-radius:12px;background:linear-gradient(180deg,#ffffff,#f7fffb);border:1px solid rgba(15,40,35,0.04)}\\n    .avatar{width:48px;height:48px;border-radius:50%;background:#eafff4;display:inline-flex;align-items:center;justify-content:center;font-weight:800;color:#007a58}\\n    footer{padding:28px;text-align:center;color:var(--soft)}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <a href=\\\"index.html\\\" style=\\\"font-weight:900\\\">{{BUSINESS_NAME}}</a>\\n      <nav>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"pricing.html\\\">Investment</a>\\n      </nav>\\n    </div>\\n    <div>\\n      <a href=\\\"book.html\\\" style=\\\"text-decoration:none;padding:10px 14px;border-radius:12px;background:var(--accent);color:#023331;font-weight:800\\\">Begin</a>\\n    </div>\\n  </header>\\n\\n  <main style=\\\"max-width:1000px;margin:18px auto\\\">\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <div class=\\\"quote\\\">\\\"I found rhythm again — not perfection, but presence.\\\"</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Read intimate reports from recent cohorts and see the small practices that moved people forward.</div>\\n\\n        <div class=\\\"test-grid\\\">\\n          <div class=\\\"testimonial card\\\">\\n            <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n              <div class=\\\"avatar\\\">A</div>\\n              <div>\\n                <strong>Amaya • Designer</strong>\\n                <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Completed Moonlight Cohort</div>\\n              </div>\\n            </div>\\n            <p class=\\\"muted\\\" style=\\\"margin-top:12px\\\">I went from scattered to steady. The micro-habit nudges were tiny but stacked into a huge change: better sleep and a calmer morning ritual.</p>\\n          </div>\\n\\n          <div class=\\\"testimonial card\\\">\\n            <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n              <div class=\\\"avatar\\\">J</div>\\n              <div>\\n                <strong>João • Entrepreneur</strong>\\n                <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Guided Path graduate</div>\\n              </div>\\n            </div>\\n            <p class=\\\"muted\\\" style=\\\"margin-top:12px\\\">The diagnostic was illuminating. The cohort gave structure and the 1:1 sessions kept me accountable without pressure.</p>\\n          </div>\\n\\n          <div class=\\\"testimonial card\\\">\\n            <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n              <div class=\\\"avatar\\\">E</div>\\n              <div>\\n                <strong>Elena • Parent</strong>\\n                <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Essentials cohort</div>\\n              </div>\\n            </div>\\n            <p class=\\\"muted\\\" style=\\\"margin-top:12px\\\">I learned to insert 3-minute resets into a busy day. Small rituals that lasted felt like radical compassion.</p>\\n          </div>\\n\\n          <div class=\\\"testimonial card\\\">\\n            <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n              <div class=\\\"avatar\\\">S</div>\\n              <div>\\n                <strong>Samuel • Teacher</strong>\\n                <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">VIP Nurture</div>\\n              </div>\\n            </div>\\n            <p class=\\\"muted\\\" style=\\\"margin-top:12px\\\">Deep work: ritual design helped me structure evenings so mornings are less reactive and more creative.</p>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <h3 style=\\\"margin:0\\\">Why stories matter</h3>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:10px\\\">These testimonials focus on process, not perfection. They highlight habit shifts, sustainable pacing, and community support.</p>\\n        <div style=\\\"margin-top:12px\\\">\\n          <a href=\\\"book.html\\\" style=\\\"background:#eafff4;padding:10px 12px;border-radius:10px;text-decoration:none;color:#007a58;font-weight:700\\\">Start a conversation</a>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin:0\\\">A peek into cohort rituals</h3>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Each cohort follows a framework: calibrate (diagnostic), commit (micro-habit adoption), and celebrate (integration). Members share wins and small setbacks in a held space.</p>\\n\\n        <div style=\\\"display:flex;gap:12px;margin-top:12px\\\">\\n          <div style=\\\"flex:1\\\">\\n            <strong>Micro-practice:</strong>\\n            <div class=\\\"muted\\\">3-breath centerings at mid-day.</div>\\n          </div>\\n          <div style=\\\"flex:1\\\">\\n            <strong>Framework:</strong>\\n            <div class=\\\"muted\\\">Weekly themes with tiny, repeatable commitments.</div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0\\\">Questions people ask</h3>\\n      <div style=\\\"margin-top:8px;color:var(--soft)\\\">\\n        <strong>Will I change overnight?</strong>\\n        <div>Change comes from consistent small acts — we design for momentum, not sudden conversions.</div>\\n        <strong style=\\\"margin-top:8px\\\">Is this spiritual coaching?</strong>\\n        <div>Yes, in the sense that we honor inner rhythms and meaning — always practical and trauma-informed.</div>\\n      </div>\\n    </section>\\n\\n    <div style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <div style=\\\"font-weight:900\\\">Ready to join a cohort of peers?</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Secure your spot; spaces fill quickly.</div>\\n      </div>\\n      <div>\\n        <a href=\\\"book.html\\\" style=\\\"padding:12px 16px;background:#007a58;color:#fff;border-radius:12px;text-decoration:none;font-weight:800\\\">Hold a seat</a>\\n      </div>\\n    </div>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"padding:18px;text-align:center;color:var(--soft)\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Begin — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff6f9;--accent:#ff8fb8;--ink:#2b2730}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;background:var(--bg);color:var(--ink)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:22px 36px}\\n    nav a{margin-left:12px;color:#6b6b76;text-decoration:none}\\n    .container{max-width:880px;margin:20px auto;padding:18px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:20px}\\n    .panel{background:#fff;padding:18px;border-radius:14px;box-shadow:0 10px 30px rgba(12,8,20,0.06)}\\n    label{display:block;margin-top:10px;font-weight:700}\\n    input,select,textarea{width:100%;padding:10px;margin-top:6px;border-radius:10px;border:1px solid #efe7ef}\\n    .cta{background:var(--accent);color:white;padding:12px 16px;border-radius:12px;text-decoration:none;display:inline-block;margin-top:12px;font-weight:800}\\n    .micro{background:linear-gradient(90deg,#fff4fb,#fff);padding:10px;border-radius:10px;margin-top:12px}\\n    .muted{color:#7b7b81;font-size:14px}\\n    footer{padding:24px;text-align:center;color:#7b7b81}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:900\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"programs.html\\\">Work With Me</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <div class=\\\"grid\\\">\\n      <div>\\n        <div class=\\\"panel\\\">\\n          <h2 style=\\\"margin:0\\\">Start your enrollment</h2>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Choose a cohort, book your diagnostic, and we'll send a short intake to customize your first micro-habit map.</p>\\n\\n          <form action=\\\"/submit\\\" method=\\\"post\\\" style=\\\"margin-top:12px\\\">\\n            <label for=\\\"name\\\">Full name</label>\\n            <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"Your name\\\" required>\\n\\n            <label for=\\\"email\\\">Email</label>\\n            <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@domain.com\\\" required>\\n\\n            <label for=\\\"phone\\\">Phone</label>\\n            <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"Optional\\\" >\\n\\n            <label for=\\\"program\\\">Choose a path</label>\\n            <select id=\\\"program\\\" name=\\\"program\\\">\\n              <option>Essentials — Cohort (8 weeks) — $497</option>\\n              <option>Guided Path — Cohort + 1:1 — $997</option>\\n              <option>Nurture — VIP — $2400 (inquiry required)</option>\\n            </select>\\n\\n            <label for=\\\"intent\\\">What are you hoping to shift?</label>\\n            <textarea id=\\\"intent\\\" name=\\\"intent\\\" rows=\\\"4\\\" placeholder=\\\"Be brief — a line or two is perfect.\\\"></textarea>\\n\\n            <div style=\\\"display:flex;gap:12px;align-items:center;margin-top:12px\\\">\\n              <button class=\\\"cta\\\" type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n              <div class=\\\"muted\\\">Or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n            </div>\\n          </form>\\n\\n          <div style=\\\"margin-top:14px\\\" class=\\\"micro\\\">\\n            <strong>Mini-diagnostic on arrival</strong>\\n            <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">You’ll receive a short questionnaire and a 60-minute diagnostic session to map leverage points. Think of it as a compass, not a verdict.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:14px\\\">\\n          <h3 style=\\\"margin:0\\\">Micro-habits — examples you'll encounter</h3>\\n          <ul class=\\\"muted\\\" style=\\\"margin-top:8px\\\">\\n            <li>Two-minute breath anchor when you sit at your desk.</li>\\n            <li>Evening wind-down: a 3-step ritual for sleep readiness.</li>\\n            <li>Midday micro-movement to reset energy and focus.</li>\\n          </ul>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <h4 style=\\\"margin:0\\\">Need guidance?</h4>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Book a free 15-minute consult to see which cohort fits your rhythm.</p>\\n          <a href=\\\"contact.html\\\" class=\\\"cta\\\" style=\\\"background:#2b2730\\\">Schedule consult</a>\\n\\n          <div style=\\\"margin-top:12px;font-size:13px;color:#5f5b64\\\">\\n            <strong>{{COACH_NAME}}, {{CREDENTIALS}}</strong>\\n            <div style=\\\"margin-top:6px\\\">I design pragmatic rituals that align with your life. We co-create steady progress, using small acts and gentle accountability.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:14px\\\">\\n          <h4 style=\\\"margin:0\\\">What happens after you sign up</h4>\\n          <ol class=\\\"muted\\\" style=\\\"margin-top:8px\\\">\\n            <li>Complete intake questionnaire.</li>\\n            <li>Attend 60-min diagnostic.</li>\\n            <li>Receive micro-habit map and weekly cohort schedule.</li>\\n          </ol>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"panel\\\">\\n        <h4 style=\\\"margin:0\\\">Policies & logistics</h4>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Cohorts run on a schedule; please review dates before booking. Payment plans are available for Guided Path and Nurture — contact <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> for details.</p>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"muted\\\">Questions? Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>. {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"assets/img/hero.svg\",\"content\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 600 200\\\" preserveAspectRatio=\\\"xMidYMid meet\\\"><defs><linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#fff0f7\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#fff8fb\\\"/></linearGradient></defs><rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g1)\\\" rx=\\\"16\\\"/><g transform=\\\"translate(40,20)\\\"><path d=\\\"M30 120 C80 40 160 40 220 120 S340 200 420 120\\\" fill=\\\"none\\\" stroke=\\\"#ff6fb5\\\" stroke-width=\\\"8\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" opacity=\\\"0.95\\\"/></g><g transform=\\\"translate(480,40)\\\"><circle cx=\\\"0\\\" cy=\\\"0\\\" r=\\\"36\\\" fill=\\\"#fff\\\" stroke=\\\"#ffcedf\\\" stroke-width=\\\"6\\\"/><path d=\\\"M-10 6c4-6 18-8 26 2\\\" stroke=\\\"#ff6fb5\\\" stroke-width=\\\"3\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/></g></svg>\"} \n{\"path\":\"assets/img/avatar.svg\",\"content\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 120 120\\\"><rect width=\\\"100%\\\" height=\\\"100%\\\" rx=\\\"20\\\" fill=\\\"#fffafc\\\"/><g transform=\\\"translate(20,14)\\\"><circle cx=\\\"40\\\" cy=\\\"28\\\" r=\\\"20\\\" fill=\\\"#eafff4\\\"/><path d=\\\"M12 86c8-18 56-18 72 0\\\" stroke=\\\"#007a58\\\" stroke-width=\\\"6\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/></g></svg>\"} \n{\"path\":\"assets/img/pattern.svg\",\"content\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 200 200\\\"><defs><pattern id=\\\"p\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\"><rect width=\\\"40\\\" height=\\\"40\\\" fill=\\\"#fff4fb\\\"/><circle cx=\\\"20\\\" cy=\\\"20\\\" r=\\\"6\\\" fill=\\\"#ffeef7\\\"/></pattern></defs><rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p)\\\"/></svg>\"} \nBUNDLE_END"
