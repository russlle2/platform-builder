          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <style>\\n    :root{--bg:#0f0f10;--card:#0f1720;--muted:#aab3b8;--accent:#caa77f;--glass:rgba(255,255,255,0.03);--radius:14px}\\n    html,body{height:100%;margin:0;font-family:inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:#eef2f3;background:linear-gradient(180deg,#071018 0%, #0b1316 60%)}\\n    .wrap{max-width:1100px;margin:40px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between;gap:16px}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 10px;font-weight:600}\\n    .brand{display:flex;align-items:center;gap:14px}\\n    .brand .logo{width:56px;height:56px;border-radius:12px;background:var(--glass);display:flex;align-items:center;justify-content:center}\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:32px;align-items:center;margin-top:28px}\\n    .panel{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:28px;border-radius:16px;backdrop-filter:blur(6px)}\\n    h1{font-size:30px;margin:0 0 12px 0;color:#fff;letter-spacing:0.2px}\\n    p.lead{color:var(--muted);margin:0 0 18px 0}\\n    .meta{display:flex;gap:10px;align-items:center;margin-top:8px}\\n    .meta .pill{background:rgba(202,167,127,0.12);color:var(--accent);padding:6px 10px;border-radius:999px;font-weight:700}\\n    .avatar{width:96px;height:96px;border-radius:12px;overflow:hidden;border:1px solid rgba(255,255,255,0.04)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:20px}\\n    .card{background:var(--card);padding:18px;border-radius:12px}\\n    ul.simple{padding-left:18px;color:var(--muted)}\\n    .cta{display:inline-block;margin-top:18px;padding:12px 18px;background:var(--accent);color:#072026;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{margin-top:40px;color:var(--muted);font-size:13px}\\n    .tiny{font-size:13px;color:var(--muted)}\\n    .section-title{font-weight:800;color:#fff;margin:0 0 10px 0}\\n    .diagnostic, .map, .habits, .pricing, .apply{margin-top:22px}\\n    .pricing-grid{display:flex;gap:12px}\\n    .price-card{flex:1;padding:16px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent)}\\n    a.link{color:var(--accent);text-decoration:none;font-weight:700}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\"><img src=\\\"assets/img/avatar.svg\\\" alt=\\\"avatar\\\" width=\\\"40\\\" height=\\\"40\\\"></div>\\n        <div>\\n          <div style=\\\"font-weight:800;color:#fff\\\">{{BUSINESS_NAME}}</div>\\n          <div class=\\\"tiny\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"programs.html\\\">Paths</a>\\n        <a href=\\\"services.html\\\">Work With Me</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <!-- HERO (unique heading) -->\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"panel\\\">\\n        <h1>Sanctuary & Strategy — Meet the Work</h1>\\n        <p class=\\\"lead\\\">I am {{COACH_NAME}} {{CREDENTIALS}}. I design soul-aligned practices and frameworks so you move from friction to ease — month by month. Our work centers outcomes you can measure and rituals you actually enjoy.</p>\\n        <div class=\\\"meta\\\">\\n          <div class=\\\"pill\\\">Spiritual Teacher</div>\\n          <div class=\\\"tiny\\\">Cohort model • Community-led • {{CITY}}, {{STATE}}</div>\\n        </div>\\n\\n        <div style=\\\"display:flex;gap:12px;margin-top:20px;align-items:center\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a class=\\\"link\\\" href=\\\"#philosophy\\\">My Philosophy</a>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"panel\\\" style=\\\"display:flex;flex-direction:column;gap:12px;align-items:center\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"hero art\\\" style=\\\"width:100%;border-radius:10px;\\\">\\n        <div style=\\\"width:100%\\\">\\n          <div class=\\\"section-title\\\">Quick Connector</div>\\n          <p class=\\\"tiny\\\">Download the 7-day \\\"Small Shifts\\\" bundle — a compact lead magnet for layering ease into your week. Delivered immediately via email.</p>\\n          <form style=\\\"display:flex;gap:8px;margin-top:10px\\\" action=\\\"#\\\" onsubmit=\\\"alert('Lead magnet sign-up placeholder')\\\">\\n            <input placeholder=\\\"Email\\\" aria-label=\\\"email\\\" style=\\\"flex:1;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:#fff\\\">\\n            <button class=\\\"cta\\\" type=\\\"submit\\\">Get the Guide</button>\\n          </form>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <!-- DIAGNOSTIC (renamed: Inner Inventory) -->\\n    <section id=\\\"diagnostic\\\" class=\\\"diagnostic\\\">\\n      <div class=\\\"section-title\\\">Inner Inventory — A Gentle Diagnostic</div>\\n      <p class=\\\"tiny\\\">Start with a five-minute inventory to clarify where energy is flowing and where it’s leaking. No judgment — just map. This diagnostic informs the cohort roadmap we design together.</p>\\n      <div class=\\\"grid\\\" style=\\\"grid-template-columns:repeat(3,1fr);margin-top:12px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Energy</strong>\\n          <p class=\\\"tiny\\\">How you show up each day.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Rituals</strong>\\n          <p class=\\\"tiny\\\">What repeats and why it matters.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Relationships</strong>\\n          <p class=\\\"tiny\\\">Where you receive support.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- PLAN (renamed: The Map) -->\\n    <section class=\\\"map\\\">\\n      <div class=\\\"section-title\\\">The 5-Phase Map</div>\\n      <p class=\\\"tiny\\\">I translate your diagnostic into a five-phase map: Clear, Align, Build, Anchor, and Integrate. Each phase has a weekly focus and an intentional habit set.</p>\\n      <ol class=\\\"simple\\\">\\n        <li>Clear: clarify values and commitments</li>\\n        <li>Align: match actions to values</li>\\n        <li>Build: install micro-habits</li>\\n        <li>Anchor: ritualize and scale</li>\\n        <li>Integrate: sustain with community</li>\\n      </ol>\\n    </section>\\n\\n    <!-- MICRO_HABITS (renamed: Daily Seeds) -->\\n    <section class=\\\"habits\\\">\\n      <div class=\\\"section-title\\\">Daily Seeds</div>\\n      <p class=\\\"tiny\\\">Micro-habits are small, non-negotiable practices planted into your day. They compound. Examples we teach in cohorts:</p>\\n      <ul class=\\\"simple\\\">\\n        <li>Morning 5: two breaths + one intentional action</li>\\n        <li>Pause Check: 60-second alignment before a meeting</li>\\n        <li>Evening Note: one line of gratitude or learning</li>\\n      </ul>\\n    </section>\\n\\n    <!-- PRICING (renamed: Investment & Tiers overview) -->\\n    <section class=\\\"pricing\\\">\\n      <div class=\\\"section-title\\\">Investment — Choose Your Container</div>\\n      <p class=\\\"tiny\\\">Cohorts are priced to reflect facilitation, curriculum, and peer accountability. Each period includes weekly sessions, guided practices, and recorded lessons.</p>\\n      <div class=\\\"pricing-grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"price-card\\\">\\n          <strong>Seed Cohort</strong>\\n          <p class=\\\"tiny\\\">6 weeks • small circle • foundation work</p>\\n          <div style=\\\"margin-top:8px;font-weight:800;color:#fff\\\">$597</div>\\n        </div>\\n        <div class=\\\"price-card\\\">\\n          <strong>Harvest Cohort</strong>\\n          <p class=\\\"tiny\\\">12 weeks • deep practice • peer mentorship</p>\\n          <div style=\\\"margin-top:8px;font-weight:800;color:#fff\\\">$1397</div>\\n        </div>\\n        <div class=\\\"price-card\\\">\\n          <strong>Alchemist Circle</strong>\\n          <p class=\\\"tiny\\\">Rolling • alumni-led • higher touch</p>\\n          <div style=\\\"margin-top:8px;font-weight:800;color:#fff\\\">Apply</div>\\n        </div>\\n      </div>\\n      <p class=\\\"tiny\\\" style=\\\"margin-top:10px\\\">Details and payment plans on <a class=\\\"link\\\" href=\\\"pricing.html\\\">the pricing page</a>.</p>\\n    </section>\\n\\n    <!-- CTA (renamed: Join the Circle) -->\\n    <section class=\\\"apply\\\">\\n      <div class=\\\"panel\\\">\\n        <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n          <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"coach\\\" class=\\\"avatar\\\">\\n          <div>\\n            <div style=\\\"font-weight:800;color:#fff\\\">Ready to begin?</div>\\n            <div class=\\\"tiny\\\">Apply for the next cohort or schedule a clarity call.</div>\\n          </div>\\n        </div>\\n        <div style=\\\"margin-top:12px;display:flex;gap:10px\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a class=\\\"link\\\" href=\\\"book.html\\\">Schedule a Call</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px\\\">\\n        <div class=\\\"tiny\\\">&copy; {{BUSINESS_NAME}} — {{COACH_NAME}} {{CREDENTIALS}} • {{CITY}}, {{STATE}}</div>\\n        <div class=\\\"tiny\\\">Contact: <a class=\\\"link\\\" href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a class=\\\"link\\\" href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <style>\\n    :root{--bg:#fff;--ink:#071418;--muted:#4a5b5f;--accent:#9b6f4a}\\n    html,body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;background:linear-gradient(180deg,#fbfbfb,#fff);color:var(--ink)}\\n    .container{max-width:1100px;margin:36px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:14px;text-decoration:none;color:var(--muted);font-weight:700}\\n    .hero{display:flex;gap:26px;align-items:center;margin-top:18px}\\n    .hero .left{flex:1}\\n    h1{font-size:28px;margin:0;color:var(--ink)}\\n    .subtitle{color:var(--muted);margin-top:6px}\\n    .offerings{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}\\n    .card{background:#fff;border-radius:12px;padding:18px;border:1px solid rgba(7,20,24,0.05)}\\n    .pill{background:rgba(155,111,74,0.08);color:var(--accent);padding:6px 10px;border-radius:999px;font-weight:700}\\n    .plan{margin-top:16px}\\n    .habit-list{display:flex;flex-direction:column;gap:8px;margin-top:8px}\\n    .footer-cta{margin-top:20px}\\n    .btn{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:800}\\n    .muted{color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <img src=\\\"assets/img/avatar.svg\\\" alt=\\\"logo\\\" width=\\\"48\\\" height=\\\"48\\\" style=\\\"border-radius:10px\\\">\\n        <div>\\n          <div style=\\\"font-weight:900\\\">{{BUSINESS_NAME}}</div>\\n          <div class=\\\"muted\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Landing</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"programs.html\\\">Programs</a>\\n        <a href=\\\"pricing.html\\\">Investment</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </nav>\\n    </header>\\n\\n    <!-- HERO (different heading) -->\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"left\\\">\\n        <h1>Offerings — Containers for Care</h1>\\n        <p class=\\\"subtitle\\\">Cohorts, short intensives, and 1:1 mentoring designed to shift patterns and grow capacity. Each service uses the cohort model to hold accountability and soulful guidance.</p>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n      </div>\\n      <div style=\\\"width:360px\\\">\\n        <img src=\\\"assets/img/hero.svg\\\" alt=\\\"services art\\\" style=\\\"width:100%;border-radius:12px;box-shadow:0 8px 30px rgba(15,20,20,0.08)\\\">\\n      </div>\\n    </section>\\n\\n    <!-- PLAN (renamed: Pathways) placed earlier here -->\\n    <section class=\\\"plan\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div style=\\\"font-weight:900\\\">Pathways — How we structure a cycle</div>\\n        <div class=\\\"muted\\\">Designed as 6–12 week cycles</div>\\n      </div>\\n      <div class=\\\"offerings\\\">\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0\\\">Seed: Starter Cohort</h3>\\n          <p class=\\\"muted\\\">A 6-week guided introduction to daily practice and alignment.</p>\\n          <ul class=\\\"habit-list\\\">\\n            <li>Weekly group teaching</li>\\n            <li>Accountability pairs</li>\\n            <li>Homework & journaling</li>\\n          </ul>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0\\\">Deepen: Transformative Cohort</h3>\\n          <p class=\\\"muted\\\">12 weeks of immersive practice, alumni mentorship, and ritual design.</p>\\n          <ul class=\\\"habit-list\\\">\\n            <li>Weekly live coaching</li>\\n            <li>Guided micro-habits</li>\\n            <li>Integration workshops</li>\\n          </ul>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0\\\">Alchemy: Small Group Mentoring</h3>\\n          <p class=\\\"muted\\\">Higher touch facilitation for three months; includes private review sessions.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0\\\">1:1 & Bespoke</h3>\\n          <p class=\\\"muted\\\">Tailored pathways for specific seasons — applied by application only.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- MICRO_HABITS (renamed: Ritual Menu) -->\\n    <section style=\\\"margin-top:20px\\\">\\n      <div style=\\\"font-weight:900\\\">Ritual Menu — Habits We Teach</div>\\n      <p class=\\\"muted\\\">Small practices with big returns. We seed these across every program as the foundational thread.</p>\\n      <div style=\\\"display:flex;gap:12px;margin-top:10px\\\">\\n        <div class=\\\"card\\\" style=\\\"flex:1\\\">\\n          <strong>Pulse Pause</strong>\\n          <p class=\\\"muted\\\">A 60-second centering before reactive moments.</p>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"flex:1\\\">\\n          <strong>Morning Line</strong>\\n          <p class=\\\"muted\\\">One sentence intention-setting to start the day.</p>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"flex:1\\\">\\n          <strong>Evening Note</strong>\\n          <p class=\\\"muted\\\">A short reflection to close the day and cement learning.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- DIAGNOSTIC (renamed: Service Audit) -->\\n    <section style=\\\"margin-top:20px\\\">\\n      <div style=\\\"font-weight:900\\\">Service Audit</div>\\n      <p class=\\\"muted\\\">Free 10-minute clarity call to map your best next container. We bring a short diagnostic so you leave with a clear next step, whether you join a cohort or take the free guide.</p>\\n      <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Book a Clarity Call</a></div>\\n    </section>\\n\\n    <!-- PRICING (renamed: Value & Exchange) -->\\n    <section style=\\\"margin-top:20px\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div style=\\\"font-weight:900\\\">Value & Exchange</div>\\n        <div class=\\\"muted\\\">Transparent tiers • payment plans available</div>\\n      </div>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Seed</strong>\\n          <p class=\\\"muted\\\">One-time payment — $597</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Deepen</strong>\\n          <p class=\\\"muted\\\">$1397 or 3x payments</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Alchemy</strong>\\n          <p class=\\\"muted\\\">Apply for pricing</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- CTA (renamed: Begin a Cycle) -->\\n    <section class=\\\"footer-cta\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <div style=\\\"font-weight:900\\\">Begin a Cycle</div>\\n          <div class=\\\"muted\\\">Join the next cohort or secure a spot in a small mentoring circle.</div>\\n        </div>\\n        <div style=\\\"display:flex;gap:8px\\\">\\n          <a class=\\\"btn\\\" href=\\\"programs.html\\\">Explore Programs</a>\\n          <a style=\\\"padding:10px 14px;border-radius:10px;background:transparent;border:2px solid var(--accent);color:var(--accent);text-decoration:none;font-weight:800\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:32px;color:var(--muted);font-size:13px\\\">\\n      <div>&copy; {{BUSINESS_NAME}} • Contact <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a> • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"programs.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <style>\\n    :root{--bg:#031018;--card:#072126;--muted:#9fb3b6;--accent:#d9b38b}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;background:linear-gradient(180deg,#021217,#041920);color:#e6f0f0}\\n    .shell{max-width:1100px;margin:28px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:12px;font-weight:700}\\n    .hero{display:grid;grid-template-columns:1fr 340px;gap:22px;align-items:center;margin-top:18px}\\n    h1{margin:0;font-size:30px}\\n    .subtitle{color:var(--muted);margin-top:6px}\\n    .list{margin-top:18px;display:grid;grid-template-columns:repeat(3,1fr);gap:12px}\\n    .prog{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:16px;border-radius:12px}\\n    .prog h3{margin:0}\\n    .meta{margin-top:8px;color:var(--muted)}\\n    .cta{margin-top:14px;padding:10px 12px;background:var(--accent);color:#051617;border-radius:10px;text-decoration:none;font-weight:800;display:inline-block}\\n    .faq{margin-top:18px;background:var(--card);padding:14px;border-radius:12px}\\n    .small{font-size:13px;color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"shell\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <img src=\\\"assets/img/avatar.svg\\\" width=\\\"50\\\" height=\\\"50\\\" alt=\\\"avatar\\\" style=\\\"border-radius:10px\\\">\\n        <div>\\n          <div style=\\\"font-weight:900\\\">{{BUSINESS_NAME}}</div>\\n          <div class=\\\"small\\\">Programs • Cohort Model • {{CITY}}, {{STATE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">Who</a>\\n        <a href=\\\"services.html\\\">Work</a>\\n        <a href=\\\"pricing.html\\\">Fees</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <!-- HERO (different heading) -->\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Program Paths — Cohorts & Circles</h1>\\n        <p class=\\\"subtitle\\\">Our programs are seasonal cohorts framed around leaning into sustainable habits and group practice. Each path combines teaching, lived practice, and peer accountability.</p>\\n\\n        <div style=\\\"display:flex;gap:10px;margin-top:12px\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a class=\\\"small\\\" href=\\\"book.html\\\" style=\\\"align-self:center;color:var(--muted);text-decoration:none\\\">Book a Clarity Call</a>\\n        </div>\\n      </div>\\n      <div>\\n        <img src=\\\"assets/img/pattern.svg\\\" alt=\\\"pattern\\\" style=\\\"width:100%;border-radius:12px\\\">\\n      </div>\\n    </section>\\n\\n    <!-- PRICING (placed earlier on this page as unique ordering) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div style=\\\"font-weight:900\\\">Current Investment Overview</div>\\n        <div class=\\\"small\\\">Transparent pricing • Apply for scholarships</div>\\n      </div>\\n      <div class=\\\"list\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"prog\\\">\\n          <h3>Moon Cycle — Starter Cohort</h3>\\n          <div class=\\\"meta\\\">6 weeks • live group • $597</div>\\n          <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">Ideal if you want a focused, achievable rhythm-building container.</p>\\n        </div>\\n        <div class=\\\"prog\\\">\\n          <h3>Seasonal Path — Deep Work</h3>\\n          <div class=\\\"meta\\\">12 weeks • deep practice • $1397</div>\\n          <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">For people committed to changing patterns across a whole season.</p>\\n        </div>\\n        <div class=\\\"prog\\\">\\n          <h3>Alchemical Cohort</h3>\\n          <div class=\\\"meta\\\">Rolling • small cohort • apply for pricing</div>\\n          <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">A curated container with limited seats and higher facilitation touch.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- PLAN (renamed: Curriculum) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <div style=\\\"font-weight:900\\\">Curriculum Structure</div>\\n      <p class=\\\"small\\\">Every program follows a clear curriculum arc: Clarify → Practice → Stabilize → Expand. Sessions alternate between teaching and practice labs.</p>\\n      <ol class=\\\"small\\\" style=\\\"margin-top:8px;color:var(--muted)\\\">\\n        <li>Week: teaching + reflection</li>\\n        <li>Midweek: practice labs in small groups</li>\\n        <li>Integration: journaling + peer feedback</li>\\n      </ol>\\n    </section>\\n\\n    <!-- DIAGNOSTIC (renamed: Entry Check) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <div style=\\\"font-weight:900\\\">Entry Check</div>\\n      <p class=\\\"small\\\">Before you join, we do a three-question entry check: what matters most, what's blocking you, and what kind of support you thrive with. This keeps cohorts aligned.</p>\\n      <div style=\\\"margin-top:10px\\\"><a class=\\\"cta\\\" href=\\\"contact.html\\\">Start Entry Check</a></div>\\n    </section>\\n\\n    <!-- MICRO_HABITS (renamed: Habit Toolkit) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <div style=\\\"font-weight:900\\\">Habit Toolkit</div>\\n      <p class=\\\"small\\\">Examples that reappear in all cohorts — taught as adaptable rituals so you personalize them rather than adopt them wholesale.</p>\\n      <div style=\\\"display:flex;gap:10px;margin-top:8px\\\">\\n        <div class=\\\"prog\\\" style=\\\"flex:1\\\">\\n          <strong>Two-Minute Reset</strong>\\n          <div class=\\\"small\\\">Short breath + focus practice.</div>\\n        </div>\\n        <div class=\\\"prog\\\" style=\\\"flex:1\\\">\\n          <strong>Intent Line</strong>\\n          <div class=\\\"small\\\">Daily one-line intention.</div>\\n        </div>\\n        <div class=\\\"prog\\\" style=\\\"flex:1\\\">\\n          <strong>Thank You Note</strong>\\n          <div class=\\\"small\\\">Habit of gratitude to end the day.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- CTA (renamed: Apply or Join) -->\\n    <section style=\\\"margin-top:20px\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:16px;border-radius:12px\\\">\\n        <div>\\n          <div style=\\\"font-weight:900\\\">Apply or Join</div>\\n          <div class=\\\"small\\\">Apply to the Alchemical Cohort or reserve a seat in the next Moon Cycle.</div>\\n        </div>\\n        <div style=\\\"display:flex;gap:10px\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a class=\\\"small\\\" href=\\\"pricing.html\\\" style=\\\"align-self:center;color:var(--muted);text-decoration:none\\\">See full fees</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- FAQ (unique questions) -->\\n    <section class=\\\"faq\\\" style=\\\"margin-top:18px\\\">\\n      <div style=\\\"font-weight:900\\\">Questions People Ask</div>\\n      <div style=\\\"margin-top:8px\\\">\\n        <strong>How does a cohort differ from 1:1?</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:6px;color:var(--muted)\\\">Cohorts emphasize peer practice and shared accountability; 1:1 is tailored deep work. Both are complementary.</div>\\n      </div>\\n      <div style=\\\"margin-top:8px\\\">\\n        <strong>What if I miss a session?</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:6px;color:var(--muted)\\\">Recordings and practice notes are available; live participation is encouraged for best results.</div>\\n      </div>\\n      <div style=\\\"margin-top:8px\\\">\\n        <strong>Is this spiritual coaching?</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:6px;color:var(--muted)\\\">Yes — the work is spiritually informed and focused on embodied habits and ethical practice without medical claims.</div>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:20px;color:var(--muted);font-size:13px\\\">\\n      <div>&copy; {{BUSINESS_NAME}} • {{COACH_NAME}} {{CREDENTIALS}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a> • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
