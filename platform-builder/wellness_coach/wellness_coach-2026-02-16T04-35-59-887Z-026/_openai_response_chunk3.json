          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width, initial-scale=1'>\\n  <title>Investment — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f1113;--card:#0f1720;--accent:#b08cff;--muted:#9aa4b2;--glass:rgba(255,255,255,0.04);--max:1100px}\\n    *{box-sizing:border-box;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,'Noto Sans',sans-serif}\\n    body{margin:0;background:linear-gradient(180deg,#071018 0%,#0f1113 60%);color:#e6eef8;line-height:1.45}\\n    header{max-width:var(--max);margin:28px auto;display:flex;align-items:center;justify-content:space-between;padding:0 20px}\\n    nav a{color:#cbd7e6;text-decoration:none;margin:0 12px;font-weight:600;font-size:14px}\\n    .container{max-width:var(--max);margin:24px auto;padding:24px}\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:32px;align-items:center;padding:40px;background:linear-gradient(135deg,rgba(176,140,255,0.08),transparent);border-radius:14px}\\n    .hero h1{font-size:36px;margin:0 0 12px 0;color:#fff}\\n    .hero p{color:var(--muted);margin:0 0 18px 0}\\n    .hero .meta{display:flex;gap:12px;align-items:center}\\n    .btn{background:linear-gradient(90deg,var(--accent),#7ec8ff);color:#071018;padding:12px 18px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .hero svg{width:100%;height:auto;border-radius:10px;background:var(--glass);padding:18px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:28px;margin-top:28px}\\n    .card{background:rgba(255,255,255,0.02);padding:18px;border-radius:12px}\\n    .tiers{display:flex;flex-direction:column;gap:14px}\\n    .tier{display:flex;justify-content:space-between;align-items:center;padding:14px;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent)}\\n    .tier h3{margin:0;font-size:16px}\\n    .price{font-weight:800;color:var(--accent)}\\n    footer{max-width:var(--max);margin:48px auto;padding:20px;color:var(--muted);font-size:13px;text-align:center}\\n    .faq{margin-top:18px}\\n    .micro{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}\\n    .chip{background:rgba(255,255,255,0.03);padding:8px 12px;border-radius:999px;font-size:13px;color:var(--muted)}\\n    @media(max-width:900px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style='display:flex;align-items:center;gap:14px'>\\n      <img src='assets/img/avatar.svg' alt='avatar' style='width:56px;height:56px;border-radius:12px;background:rgba(255,255,255,0.03);padding:8px'>\\n      <div>\\n        <div style='font-weight:800'>{{BUSINESS_NAME}}</div>\\n        <div style='font-size:13px;color:var(--muted)'>{‌{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='about.html'>About</a>\\n      <a href='programs.html'>Paths</a>\\n      <a href='pricing.html' style='color:#fff'>Investment</a>\\n      <a href='testimonials.html'>Praise</a>\\n      <a href='book.html' class='btn' style='padding:10px 14px;text-decoration:none'>{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main class='container'>\\n    <section class='hero'>\\n      <div>\\n        <h1>Investment & Paths to Flourishing</h1>\\n        <p>Choose consistent, spiritually centered coaching that translates inner clarity into daily habits. Pricing is structured around outcomes, accountability, and community resonance.</p>\\n        <div class='meta'>\\n          <a class='btn' href='book.html'>Book a clarity call</a>\\n          <a style='color:var(--muted);text-decoration:none;padding:10px 12px;border-radius:8px;background:rgba(255,255,255,0.02);' href='programs.html'>See program outlines</a>\\n        </div>\\n        <div class='micro' style='margin-top:18px'>\\n          <div class='chip'>Diagnostic available</div>\\n          <div class='chip'>Includes micro-habit plan</div>\\n          <div class='chip'>Cohort & private options</div>\\n        </div>\\n      </div>\\n      <div>\\n        <img src='assets/img/hero.svg' alt='hero' />\\n      </div>\\n    </section>\\n\\n    <div class='grid'>\\n      <div>\\n        <section class='card'>\\n          <h2 style='margin:0 0 10px 0'>What the investment unlocks</h2>\\n          <p style='color:var(--muted);margin:0 0 14px 0'>Each tier bundles weekly structure, short diagnostic checkpoints, and personalized micro-habit blueprints so transformation is measurable and gentle.</p>\\n\\n          <div class='tiers'>\\n            <div class='tier'>\\n              <div>\\n                <h3>Wayfarer — Single Path</h3>\\n                <div style='color:var(--muted);font-size:13px'>8 sessions · self-paced practices</div>\\n              </div>\\n              <div class='price'>$950</div>\\n            </div>\\n\\n            <div class='tier'>\\n              <div>\\n                <h3>Luminary — Guided Cohort</h3>\\n                <div style='color:var(--muted);font-size:13px'>12 weeks · weekly group + 1:1 checkpoint</div>\\n              </div>\\n              <div class='price'>$2,700</div>\\n            </div>\\n\\n            <div class='tier'>\\n              <div>\\n                <h3>Sanctum — Private Deepwork</h3>\\n                <div style='color:var(--muted);font-size:13px'>6 months · bespoke framework + priority booking</div>\\n              </div>\\n              <div class='price'>$7,500</div>\\n            </div>\\n          </div>\\n\\n          <div style='margin-top:14px;color:var(--muted);font-size:13px'>Payment plans available; sliding-scale scholarships for those in genuine financial need — email {{EMAIL}} to inquire.</div>\\n        </section>\\n\\n        <section class='card' style='margin-top:18px'>\\n          <h3 style='margin:0 0 8px 0'>A short diagnostic (ripple)</h3>\\n          <p style='color:var(--muted);margin:0 0 12px 0'>Unsure which path fits? Complete the 8-question diagnostic to reveal a recommended track and 3 micro-habits to start today.</p>\\n          <a href='book.html' class='btn'>Start diagnostic</a>\\n        </section>\\n\\n        <section class='card' style='margin-top:18px'>\\n          <h3 style='margin:0 0 8px 0'>Micro-habit preview</h3>\\n          <p style='color:var(--muted);margin:0 0 10px 0'>Samples of daily, 5–12 minute practices that anchor change.</p>\\n          <ul style='color:var(--muted);margin:0 0 0 18px;padding:0'>\\n            <li>Morning grounding breath (3 mins)</li>\\n            <li>Evening reflection (5 mins)</li>\\n            <li>Tiny movement ritual (7 mins)</li>\\n          </ul>\\n        </section>\\n      </div>\\n\\n      <aside>\\n        <div class='card'>\\n          <h4 style='margin:0 0 8px 0'>Why choose a cohort?</h4>\\n          <p style='color:var(--muted);margin:0 0 12px 0'>Cohorts offer synchronized practice, peer reflection, and lowered friction for habit adoption.</p>\\n          <a href='programs.html' style='display:inline-block;text-decoration:none' class='btn'>Explore cohorts</a>\\n        </div>\\n\\n        <div class='card' style='margin-top:18px'>\\n          <h4 style='margin:0 0 8px 0'>Frequently asked</h4>\\n          <div class='faq'>\\n            <details style='color:var(--muted)'><summary style='cursor:pointer'>Can I switch tiers mid-program?</summary>\\n              <div style='margin-top:8px'>Yes — transitions are accommodated, pro-rated as needed, and designed to keep momentum steady.</div>\\n            </details>\\n            <details style='color:var(--muted);margin-top:8px'><summary style='cursor:pointer'>Do you accept insurance?</summary>\\n              <div style='margin-top:8px'>Coaching is non-medical and typically not covered by insurance; ask about receipts for out-of-pocket reimbursement.</div>\\n            </details>\\n          </div>\\n        </div>\\n\\n        <div class='card' style='margin-top:18px;text-align:center'>\\n          <h4 style='margin:0 0 8px 0'>Ready to begin?</h4>\\n          <a href='book.html' class='btn'>Reserve an intro</a>\\n          <div style='color:var(--muted);font-size:13px;margin-top:10px'>Or call {{PHONE}} • {{EMAIL}}</div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style='margin-top:28px' class='card'>\\n      <h3 style='margin:0 0 8px 0'>Investment philosophy</h3>\\n      <p style='color:var(--muted);margin:0'>I price for the time, curated frameworks, and the accountability container that reliably yields habit formation. Scholarships and payment plans keep access flexible.</p>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    © {{BUSINESS_NAME}} — Coaching by {{COACH_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}} • <a href='contact.html' style='color:var(--muted);text-decoration:none'>Contact</a>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"testimonials.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width, initial-scale=1'>\\n  <title>Praise & Stories — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfbfc;--ink:#081018;--accent:#b08cff;--card:#ffffff;--muted:#5b6b78;--max:1200px}\\n    body{margin:0;background:linear-gradient(180deg,#fff 0%,#f3f7fa 100%);color:var(--ink);font-family:Georgia,serif}\\n    header{max-width:var(--max);margin:30px auto;padding:0 20px;display:flex;align-items:center;justify-content:space-between}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-weight:700}\\n    .wrap{max-width:var(--max);margin:0 auto;padding:28px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:20px;align-items:center}\\n    .hero h1{font-size:34px;margin:0;color:var(--ink)}\\n    .hero p{color:var(--muted);margin:8px 0 0 0}\\n    .gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;margin-top:20px}\\n    .tile{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(9,22,36,0.06)}\\n    .quote{font-style:italic;color:#0f1720;margin:6px 0}\\n    .meta{color:var(--muted);font-size:13px}\\n    .micro{margin-top:12px}\\n    .cta{display:inline-block;margin-top:16px;padding:10px 14px;background:var(--accent);color:white;border-radius:10px;text-decoration:none}\\n    footer{max-width:var(--max);margin:36px auto;padding:18px;color:var(--muted);text-align:center}\\n    @media(max-width:900px){.hero{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style='display:flex;align-items:center;gap:12px'>\\n      <img src='assets/img/avatar.svg' alt='coach' style='width:52px;height:52px;border-radius:10px'>\\n      <div>\\n        <div style='font-weight:800'>{{BUSINESS_NAME}}</div>\\n        <div style='font-size:13px;color:var(--muted)'>{‌{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='about.html'>Story</a>\\n      <a href='programs.html'>Work With Me</a>\\n      <a href='pricing.html'>Investment</a>\\n      <a href='testimonials.html' style='color:var(--ink)'>Stories</a>\\n      <a href='book.html' class='cta' style='background:#7ec8ff;color:#042128'>Book</a>\\n    </nav>\\n  </header>\\n\\n  <main class='wrap'>\\n    <section class='hero'>\\n      <div>\\n        <h1>Client Stories that keep coming back</h1>\\n        <p>Gently radical shifts accumulate when small habits meet held containers. Below are reflections from recent cohort and private clients.</p>\\n        <div class='micro'>\\n          <strong style='display:block'>Quick ripple: diagnostic & micro-habit seed</strong>\\n          <p style='color:var(--muted)'>Each story links a short diagnostic result and the tiny practice that started the change.</p>\\n        </div>\\n      </div>\\n      <div>\\n        <img src='assets/img/pattern.svg' alt='pattern' style='width:100%;border-radius:12px;background:white;padding:18px' />\\n      </div>\\n    </section>\\n\\n    <section class='gallery'>\\n      <article class='tile'>\\n        <div style='font-weight:700'>A.M. — Riverkeeper (cohort)</div>\\n        <div class='quote'>“The cohort rhythm rewired my mornings. The 5-minute grounding and the weekly check-in made my boundaries feel natural.”</div>\\n        <div class='meta'>Recommended path: Liminal Cohort · Start habit: morning breath (3 mins)</div>\\n      </article>\\n\\n      <article class='tile'>\\n        <div style='font-weight:700'>S.R. — Busy parent (private)</div>\\n        <div class='quote'>“I wanted practical movement, not another to-do. The micro-plan fit into roast time and slowly aligned my days.”</div>\\n        <div class='meta'>Recommended path: Bespoke Private · Start habit: 7-minute movement ritual</div>\\n      </article>\\n\\n      <article class='tile'>\\n        <div style='font-weight:700'>K.L. — Entrepreneur (cohort)</div>\\n        <div class='quote'>“The diagnostic pinpointed a tiny pivot in my PM routine that improved focus and sleep. The collective held me accountable.”</div>\\n        <div class='meta'>Recommended path: Luminescent Cohort · Start habit: nightly reflection (5 mins)</div>\\n      </article>\\n\\n      <article class='tile'>\\n        <div style='font-weight:700'>M.N. — Mid-career reboot</div>\\n        <div class='quote'>“I was skeptical about anything labeled spiritual. What actually shifted was everyday clarity — and fewer reactive moments.”</div>\\n        <div class='meta'>Recommended path: Solo Wayfinder · Start habit: midday pause (2 mins)</div>\\n      </article>\\n    </section>\\n\\n    <section style='margin-top:22px;display:flex;gap:18px;align-items:center'>\\n      <a href='book.html' class='cta'>Reserve a discovery session</a>\\n      <a href='programs.html' style='color:var(--muted);text-decoration:none'>Explore program frameworks</a>\\n    </section>\\n\\n    <section style='margin-top:28px'>\\n      <div style='display:flex;gap:18px;flex-wrap:wrap'>\\n        <div style='flex:1;min-width:260px' class='tile'>\\n          <h4 style='margin:0 0 8px 0'>How to read these stories</h4>\\n          <p style='color:var(--muted);margin:0'>Look for the diagnostic snapshot and the micro-habit listed — that pairing shows the leverage point we prioritized.</p>\\n        </div>\\n\\n        <div style='flex:1;min-width:260px' class='tile'>\\n          <h4 style='margin:0 0 8px 0'>Privacy & participation</h4>\\n          <p style='color:var(--muted);margin:0'>Names are initials; stories shared with consent. If you prefer private references, request them when booking.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style='margin-top:22px' class='tile'>\\n      <h4 style='margin:0 0 8px 0'>Question corner</h4>\\n      <details style='color:var(--muted)'><summary style='cursor:pointer'>How do cohorts compare to private sessions?</summary>\\n        <div style='margin-top:8px'>Cohorts create shared momentum and affordability; private work targets more bespoke blocks and faster cadence.</div>\\n      </details>\\n      <details style='color:var(--muted);margin-top:8px'><summary style='cursor:pointer'>Will I be pressured to change my beliefs?</summary>\\n        <div style='margin-top:8px'>No. Coaching is values-aligned and invitational; practices are offered, never enforced.</div>\\n      </details>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    © {{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}} • Reach: {{PHONE}} • <a href='contact.html' style='color:var(--muted);text-decoration:none'>{{EMAIL}}</a>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width, initial-scale=1'>\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--ink:#072028;--accent:#7ec8ff;--muted:#6c7b86;--max:980px}\\n    body{margin:0;background:#fbfdfe;color:var(--ink);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,'Noto Sans',sans-serif}\\n    header{max-width:var(--max);margin:28px auto;padding:0 20px;display:flex;align-items:center;justify-content:space-between}\\n    nav a{margin:0 8px;color:var(--muted);text-decoration:none;font-weight:700}\\n    .page{max-width:var(--max);margin:20px auto;padding:28px}\\n    .hero{display:flex;gap:24px;align-items:center}\\n    .hero h1{margin:0;font-size:32px}\\n    .card{background:white;padding:18px;border-radius:12px;box-shadow:0 8px 30px rgba(5,20,30,0.06)}\\n    form{display:grid;grid-template-columns:1fr 320px;gap:20px}\\n    label{display:block;font-size:13px;margin-bottom:6px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6eef8}\\n    .submit{background:var(--accent);color:#042028;padding:12px 14px;border-radius:10px;border:none;font-weight:700}\\n    .note{color:var(--muted);font-size:13px}\\n    .prep{margin-top:14px}\\n    .small{font-size:13px;color:var(--muted)}\\n    @media(max-width:900px){form{grid-template-columns:1fr}.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style='display:flex;align-items:center;gap:12px'>\\n      <img src='assets/img/avatar.svg' alt='avatar' style='width:52px;height:52px;border-radius:10px'>\\n      <div>\\n        <strong>{{BUSINESS_NAME}}</strong>\\n        <div style='color:var(--muted);font-size:13px'>{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href='index.html'>Welcome</a>\\n      <a href='about.html'>Journey</a>\\n      <a href='programs.html'>Paths</a>\\n      <a href='pricing.html'>Prices</a>\\n      <a href='testimonials.html'>Stories</a>\\n      <a href='contact.html'>Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class='page'>\\n    <section class='hero'>\\n      <div style='flex:1'>\\n        <h1>Reserve your first session</h1>\\n        <p style='color:var(--muted)'>Begin with a 45-minute discovery where we map priorities, take a short diagnostic, and leave with three immediate micro-habits.</p>\\n        <div style='margin-top:12px'>\\n          <a href='pricing.html' style='text-decoration:none;padding:10px 14px;background:var(--accent);color:#042128;border-radius:10px;font-weight:700'>View investment</a>\\n        </div>\\n      </div>\\n      <div style='width:320px'>\\n        <img src='assets/img/pattern.svg' alt='pattern' style='width:100%;border-radius:10px;background:white;padding:12px' />\\n      </div>\\n    </section>\\n\\n    <section style='margin-top:24px'>\\n      <div class='card'>\\n        <h3 style='margin:0 0 10px 0'>Book a discovery (45 min)</h3>\\n        <form action='https://example.com/submit' method='post'>\\n          <div>\\n            <label for='name'>Full name</label>\\n            <input id='name' name='name' placeholder='Your name' required />\\n\\n            <label for='email' style='margin-top:12px'>Email</label>\\n            <input id='email' name='email' type='email' placeholder='you@example.com' required />\\n\\n            <label for='phone' style='margin-top:12px'>Phone (optional)</label>\\n            <input id='phone' name='phone' placeholder='{{PHONE}}' />\\n\\n            <label for='intent' style='margin-top:12px'>What would you like to focus on?</label>\\n            <textarea id='intent' name='intent' rows='4' placeholder='A sentence or two'></textarea>\\n\\n            <div style='margin-top:12px'>\\n              <label for='when'>Preferred time</label>\\n              <select id='when' name='when'>\\n                <option>Morning</option>\\n                <option>Afternoon</option>\\n                <option>Evening</option>\\n              </select>\\n            </div>\\n\\n            <div style='margin-top:14px'>\\n              <button type='submit' class='submit'>{{PRIMARY_CTA_LABEL}}</button>\\n            </div>\\n\\n            <div class='small' style='margin-top:10px'>By booking, you consent to a short email diagnostic and pre-session micro-habit suggestions. For cancellations, please notify 48 hours in advance.</div>\\n          </div>\\n\\n          <aside style='padding:12px;background:linear-gradient(180deg,#f7fbfd,#ffffff);border-radius:10px'>\\n            <h4 style='margin:0 0 8px 0'>Quick prep</h4>\\n            <ol style='color:var(--muted);margin:0 0 8px 18px'>\\n              <li>Bring one desire for change.</li>\\n              <li>Note current morning/evening routines.</li>\\n              <li>Be ready for a 5-min diagnostic at start.</li>\\n            </ol>\\n            <div style='margin-top:8px'><strong>Price:</strong> Discovery included with first program enrollment. Single discovery session $125.</div>\\n            <div style='margin-top:10px'><a href='pricing.html' style='color:var(--muted);text-decoration:none'>See full investment options</a></div>\\n          </aside>\\n        </form>\\n      </div>\\n    </section>\\n\\n    <section class='card prep' style='margin-top:18px'>\\n      <h4 style='margin:0 0 8px 0'>Before we meet — micro-habits to try</h4>\\n      <p style='color:var(--muted);margin:0 0 12px 0'>These are optional. Try one to arrive with a small anchor.</p>\\n      <ul style='color:var(--muted);margin:0 0 0 18px'>\\n        <li>One deep breath on waking (3 breaths)</li>\\n        <li>Write one thing you want more of today (30 sec)</li>\\n        <li>Stand and stretch for 60 seconds midday</li>\\n      </ul>\\n    </section>\\n\\n    <section style='margin-top:18px;text-align:center'>\\n      <a href='contact.html' style='text-decoration:none;color:var(--muted)'>Questions? Email {{EMAIL}}</a>\\n    </section>\\n\\n  </main>\\n\\n  <footer style='text-align:center;padding:24px;color:var(--muted)'>\\n    {{BUSINESS_NAME}} • {{COACH_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}} • Phone: {{PHONE}}\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
