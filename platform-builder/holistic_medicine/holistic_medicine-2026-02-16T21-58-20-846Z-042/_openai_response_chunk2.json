          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Integrative, whole-person care: personalized plans, VIP Day deep dives, and practical micro-habits to improve resilience.\\\" />\\n  <style>\\n    :root{\\n      --bg1: linear-gradient(135deg,#e6fffb 0%,#f0f7ff 50%,#eef6ff 100%);\\n      --glass: rgba(255,255,255,0.42);\\n      --card: rgba(255,255,255,0.6);\\n      --accent:#0f766e;\\n      --muted:#55636f;\\n      --radius:14px;\\n      --maxw:1100px;\\n      font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;\\n    }\\n    html,body{height:100%;margin:0;background:var(--bg1);color:#072126}\\n    /* unique SVG pattern is inlined below and referenced as background-image */\\n    .canvas{\\n      position:fixed;inset:0;z-index:-1;opacity:0.9;pointer-events:none;background-image:url('data:image/svg+xml;utf8,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"800\\\" height=\\\"600\\\"><defs><linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"%2300bfa5\\\" stop-opacity=\\\"0.08\\\"/><stop offset=\\\"1\\\" stop-color=\\\"%23007a63\\\" stop-opacity=\\\"0.06\\\"/></linearGradient><pattern id=\\\"p1\\\" width=\\\"80\\\" height=\\\"80\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(18)\\\"><rect width=\\\"80\\\" height=\\\"80\\\" fill=\\\"transparent\\\"/><circle cx=\\\"10\\\" cy=\\\"10\\\" r=\\\"2\\\" fill=\\\"%23007a63\\\" fill-opacity=\\\"0.14\\\"/></pattern></defs><rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(%23g1)\\\"/><rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(%23p1)\\\" opacity=\\\"0.8\\\"/></svg>');background-repeat:repeat;filter:blur(12px) saturate(110%);\\n    }\\n    header{max-width:var(--maxw);margin:28px auto 12px;padding:18px 22px;display:flex;align-items:center;gap:18px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.6),rgba(255,255,255,0.48));backdrop-filter:blur(8px) saturate(1.05);box-shadow:0 6px 30px rgba(3,15,18,0.06)}\\n    .brand{display:flex;flex-direction:column}\\n    .brand .name{font-weight:700;color:var(--accent)}\\n    nav{margin-left:auto}\\n    nav a{margin:0 8px;color:var(--muted);text-decoration:none;font-weight:600}\\n    main{max-width:var(--maxw);margin:28px auto;padding:28px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:20px;align-items:stretch}\\n    .hero .lead{padding:28px;border-radius:var(--radius);background:linear-gradient(180deg,rgba(255,255,255,0.6),rgba(255,255,255,0.5));backdrop-filter:blur(8px);box-shadow:0 8px 30px rgba(2,10,12,0.06)}\\n    .hero h1{margin:0 0 8px 0;font-size:28px;color:#053f3a}\\n    .hero p{margin:0;color:var(--muted);line-height:1.45}\\n    .cta-card{padding:18px;border-radius:12px;background:var(--card);display:flex;flex-direction:column;gap:10px;align-items:stretch}\\n    .btn{display:inline-block;padding:10px 12px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none;font-weight:700;text-align:center}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:20px}\\n    .card{padding:16px;border-radius:14px;background:rgba(255,255,255,0.52);backdrop-filter:blur(6px);box-shadow:0 6px 24px rgba(4,10,12,0.04)}\\n    .small{font-size:13px;color:var(--muted)}\\n    section h2{margin:0 0 12px 0;color:#0a4440}\\n    .diagnostic .cards{display:flex;gap:12px}\\n    .habit-list{display:flex;flex-direction:column;gap:8px}\\n    footer{max-width:var(--maxw);margin:28px auto;padding:18px;border-radius:12px;background:transparent;color:var(--muted);display:flex;justify-content:space-between;align-items:center}\\n    @media (max-width:880px){.hero{grid-template-columns:1fr} .grid{grid-template-columns:1fr 1fr} nav{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"canvas\\\" aria-hidden=\\\"true\\\"></div>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"name\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"small\\\">Whole-person, evidence-informed care — {{CITY}}, {{STATE}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Treatments</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"approach.html\\\">How We Work</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n    </nav>\\n  </header>\\n  <main>\\n    <!-- HERO -->\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"lead\\\">\\n        <h1>Practical integrative care you can use today</h1>\\n        <p>We combine traditional wisdom with current research to craft individualized plans that support sleep, energy, digestion, and resilience. Book a focused session or choose a VIP Day for concentrated work on a single priority.</p>\\n        <div style=\\\"margin-top:14px;display:flex;gap:10px\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a style=\\\"align-self:center;color:var(--muted);font-weight:700;text-decoration:none\\\" href=\\\"contact.html\\\">Call: {{PHONE}}</a>\\n        </div>\\n      </div>\\n      <aside class=\\\"cta-card\\\" aria-labelledby=\\\"quick-label\\\">\\n        <div id=\\\"quick-label\\\" style=\\\"font-weight:700;color:#044\\\">Book a VIP Day</div>\\n        <div class=\\\"small\\\">Intensive single-day deep dive to reset and map your plan. Includes pre-visit intake and a 90-day follow-up outline.</div>\\n        <div style=\\\"display:flex;gap:8px;margin-top:12px\\\">\\n          <a class=\\\"btn\\\" href=\\\"book.html\\\">Schedule VIP Day</a>\\n          <a style=\\\"padding:10px 12px;border-radius:10px;background:transparent;border:1px solid rgba(4,71,66,0.12);text-decoration:none;color:var(--accent);font-weight:700\\\" href=\\\"contact.html\\\">Ask a question</a>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <!-- PLAN: bespoke services -->\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2>What we offer — clear, prioritized steps</h2>\\n      <p class=\\\"small\\\">Choose the level of engagement that fits your life. Each service centers on education, measurable goals, and gentle progress tracking.</p>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Initial Integrative Visit</strong>\\n          <p class=\\\"small\\\">90 minutes. Comprehensive intake, review of systems, lifestyle patterns, and baseline plan with prioritized next steps.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Follow-up Consultations</strong>\\n          <p class=\\\"small\\\">45 minutes. Adjust the plan, review progress, refine labs or therapies as needed. Practical homework included.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>VIP Day</strong>\\n          <p class=\\\"small\\\">A focused, immersive day to synthesize history, set an actionable roadmap, and leave with a written stepwise plan and micro-habit toolkit.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- DIAGNOSTIC: assessments and optional labs -->\\n    <section class=\\\"diagnostic\\\" style=\\\"margin-top:22px;display:block\\\">\\n      <h2>Evaluation & educational testing</h2>\\n      <p class=\\\"small\\\">Evaluations are tailored. Tests, when used, are educational tools to help clarify areas to prioritize — they are optional and discussed collaboratively.</p>\\n      <div class=\\\"cards\\\" style=\\\"margin-top:10px\\\">\\n        <div class=\\\"card\\\" style=\\\"margin-bottom:10px\\\">\\n          <strong>Clinical review</strong>\\n          <p class=\\\"small\\\">Symptom mapping, medication review, lifestyle assessment, and targeted functional inquiries to inform the plan.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Optional labs & interpretation</strong>\\n          <p class=\\\"small\\\">From basic metabolic panels to targeted nutrient or inflammation markers — labs are used selectively to guide care and education.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- MICRO_HABITS: small actions -->\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2>Micro-habits for immediate improvement</h2>\\n      <p class=\\\"small\\\">Sustainable change is built from doable, measurable habits. Here are examples often introduced in early visits.</p>\\n      <div class=\\\"habit-list\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"card\\\">Morning micro-routine: 5 minutes of breath work + 10 minutes of sunlight exposure when possible.</div>\\n        <div class=\\\"card\\\">Digestive cue: eat mindfully for first 20 minutes of a meal, chew slowly, and pause between bites.</div>\\n        <div class=\\\"card\\\">Sleep anchor: consistent wake time with a 30-minute evening wind-down; reduce screens 60 minutes before bed.</div>\\n      </div>\\n    </section>\\n\\n    <!-- PRICING -->\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2>Investment & flexible options</h2>\\n      <p class=\\\"small\\\">We offer individual sessions, packages, and the VIP Day. Financial conversations are practical and transparent; we’ll match level of support to your goals.</p>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Initial Visit</strong>\\n          <p class=\\\"small\\\">Comprehensive: includes care plan and 2 weeks of follow-up messaging.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Follow-ups</strong>\\n          <p class=\\\"small\\\">Short, focused visits to accelerate progress and troubleshoot barriers.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>VIP Day</strong>\\n          <p class=\\\"small\\\">One-day intensive: extensive intake, full day of planning, take-home materials, and a 90-day framework. (Ideal for those who want a concentrated, efficient path.)</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- CTA -->\\n    <section style=\\\"margin-top:28px;display:flex;gap:14px;align-items:center;justify-content:space-between\\\">\\n      <div>\\n        <h2 style=\\\"margin:0\\\">Ready to choose a path forward?</h2>\\n        <p class=\\\"small\\\" style=\\\"margin-top:6px\\\">Start with a focused plan that emphasizes education and practical steps. No quick fixes — just systematic support.</p>\\n      </div>\\n      <div style=\\\"display:flex;gap:8px\\\">\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <a style=\\\"padding:10px 12px;border-radius:10px;background:transparent;border:1px solid rgba(4,71,66,0.12);text-decoration:none;color:var(--accent);font-weight:700\\\" href=\\\"book.html\\\">Book a VIP Day</a>\\n      </div>\\n    </section>\\n  </main>\\n  <footer>\\n    <div class=\\\"small\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}} — {{BUSINESS_NAME}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    <div class=\\\"small\\\">Serving {{CITY}}, {{STATE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Concerns & Common Issues — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Common health concerns we see and the educational, whole-person approaches used to address them. Focus on symptom management and resilience.\\\" />\\n  <style>\\n    :root{--bg:linear-gradient(180deg,#fffaf8 0%,#f3fff9 100%);--accent:#6b2e2e;--card:rgba(255,255,255,0.64);--muted:#5b4b4b;--radius:12px;--maxw:1100px;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial}\\n    html,body{height:100%;margin:0;background:var(--bg);color:#2b1f1f}\\n    .pattern{position:fixed;inset:0;z-index:-1;opacity:0.88;background-image:url('data:image/svg+xml;utf8,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"700\\\" height=\\\"500\\\"><defs><linearGradient id=\\\"g2\\\" x1=\\\"0\\\" x2=\\\"0\\\"><stop offset=\\\"0\\\" stop-color=\\\"%23ffd1d1\\\" stop-opacity=\\\"0.08\\\"/><stop offset=\\\"1\\\" stop-color=\\\"%23ffd7e0\\\" stop-opacity=\\\"0.06\\\"/></linearGradient><pattern id=\\\"p2\\\" width=\\\"100\\\" height=\\\"100\\\" patternUnits=\\\"userSpaceOnUse\\\"><rect width=\\\"100\\\" height=\\\"100\\\" fill=\\\"transparent\\\"/><path d=\\\"M0 50 L50 0\\\" stroke=\\\"%23b84f4f\\\" stroke-opacity=\\\"0.08\\\" stroke-width=\\\"1\\\"/></pattern></defs><rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(%23g2)\\\"/><rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(%23p2)\\\" opacity=\\\"0.9\\\"/></svg>');filter:blur(10px)'}\\n    header{max-width:var(--maxw);margin:22px auto;padding:16px;border-radius:12px;background:rgba(255,255,255,0.6);display:flex;align-items:center}\\n    header .title{font-weight:800;color:var(--accent)}\\n    nav{margin-left:auto}\\n    nav a{margin:0 8px;color:var(--muted);text-decoration:none}\\n    main{max-width:var(--maxw);margin:18px auto;padding:18px}\\n    .lead{padding:18px;border-radius:var(--radius);background:linear-gradient(180deg,rgba(255,255,255,0.66),rgba(255,255,255,0.5));backdrop-filter:blur(6px)}\\n    section{margin-top:18px}\\n    .list{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:10px}\\n    .item{padding:14px;border-radius:12px;background:var(--card);box-shadow:0 6px 18px rgba(20,10,10,0.03)}\\n    .item h3{margin:0 0 8px 0}\\n    .muted{color:var(--muted);font-size:14px}\\n    .micro{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}\\n    .micro a{background:rgba(255,255,255,0.7);padding:8px 10px;border-radius:10px;text-decoration:none;color:var(--accent);font-weight:700}\\n    footer{max-width:var(--maxw);margin:28px auto;padding:18px;color:var(--muted);display:flex;justify-content:space-between}\\n    @media (max-width:900px){.list{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern\\\" aria-hidden=\\\"true\\\"></div>\\n  <header>\\n    <div>\\n      <div class=\\\"title\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"muted\\\">Practical strategies for daily health</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"conditions.html\\\">Issues</a>\\n      <a href=\\\"approach.html\\\">Approach</a>\\n    </nav>\\n  </header>\\n  <main>\\n    <div class=\\\"lead\\\">\\n      <h1 style=\\\"margin:0\\\">Common concerns we support</h1>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Below are areas frequently addressed in visits. Each entry emphasizes education, symptom understanding, and stepwise strategies. Nothing listed is a guaranteed cure; care is individualized.</p>\\n    </div>\\n\\n    <section>\\n      <h2 style=\\\"margin-top:18px\\\">Concerns and how we approach them</h2>\\n      <div class=\\\"list\\\">\\n        <div class=\\\"item\\\">\\n          <h3>Stress & overwhelm</h3>\\n          <p class=\\\"muted\\\">Practical stress mapping, pacing, and resilience-building practices. We prioritize low-burden interventions you can keep.</p>\\n        </div>\\n        <div class=\\\"item\\\">\\n          <h3>Sleep difficulties</h3>\\n          <p class=\\\"muted\\\">Behavioral sleep anchors, circadian-friendly routines, and environmental tweaks before considering medications or supplements.</p>\\n        </div>\\n        <div class=\\\"item\\\">\\n          <h3>Digestive symptoms</h3>\\n          <p class=\\\"muted\\\">We review patterns, diet context, and gentle strategies—when appropriate, targeted testing is discussed as an educational tool.</p>\\n        </div>\\n        <div class=\\\"item\\\">\\n          <h3>Chronic inflammation & pain</h3>\\n          <p class=\\\"muted\\\">Lifestyle, nutrition, and movement strategies that reduce inflammatory drivers. Focus is on function and comfort, not miracle cures.</p>\\n        </div>\\n        <div class=\\\"item\\\">\\n          <h3>Low energy & fatigue</h3>\\n          <p class=\\\"muted\\\">We look at sleep, nutrition, stress load, and relevant labs selectively. The goal is to identify modifiable contributors and support sustained energy.</p>\\n        </div>\\n        <div class=\\\"item\\\">\\n          <h3>Hormonal shifts</h3>\\n          <p class=\\\"muted\\\">Educational review of hormonal patterns and symptoms, with options for monitoring and non-invasive support strategies.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2>Diagnostic thinking — what to expect</h2>\\n      <p class=\\\"muted\\\">We prioritize listening, pattern recognition, and only ordering tests when they will change the plan. Testing is framed as educational and optional.</p>\\n      <div class=\\\"micro\\\">\\n        <a href=\\\"approach.html\\\">Intake process</a>\\n        <a href=\\\"services.html\\\">Available services</a>\\n        <a href=\\\"book.html\\\">Book an initial visit</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2>Small steps people often start with</h2>\\n      <div class=\\\"list\\\">\\n        <div class=\\\"item\\\">\\n          <strong>5-minute breathing practice</strong>\\n          <p class=\\\"muted\\\">Daily anchor to reduce sympathetic activation and improve focus.</p>\\n        </div>\\n        <div class=\\\"item\\\">\\n          <strong>Meal rhythm</strong>\\n          <p class=\\\"muted\\\">Consistent timing and mindful eating to support digestion and energy.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2>Important disclaimers</h2>\\n      <p class=\\\"muted\\\">This page lists common concerns and general approaches. Individual results vary. We do not promise cures. Treatments and tests are shared as educational options to inform individualized care.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px;padding:16px;border-radius:12px;background:rgba(255,255,255,0.7);\\\">\\n      <h2 style=\\\"margin:0\\\">Interested in addressing one of these concerns?</h2>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Start with an initial visit to map priorities and choose practical next steps. For focused work, a VIP Day can accelerate progress.</p>\\n      <div style=\\\"margin-top:12px\\\"><a style=\\\"padding:10px 12px;border-radius:10px;background:#7b2d2d;color:#fff;text-decoration:none;font-weight:700\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n    </section>\\n\\n  </main>\\n  <footer>\\n    <div class=\\\"muted\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}} • {{BUSINESS_NAME}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    <div class=\\\"muted\\\">Phone: {{PHONE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>How We Work — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Our stepwise intake, collaborative planning, and follow-up structure — educational labs and focused VIP Days available.\\\" />\\n  <style>\\n    :root{--bg:linear-gradient(180deg,#f7fbff 0%,#fffdf7 100%);--accent:#154360;--card:rgba(255,255,255,0.55);--muted:#466d7f;--radius:16px;--maxw:1100px;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial}\\n    html,body{height:100%;margin:0;background:var(--bg);color:#072433}\\n    .bg-pattern{position:fixed;inset:0;z-index:-1;opacity:0.92;background-image:url('data:image/svg+xml;utf8,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"800\\\" height=\\\"600\\\"><defs><linearGradient id=\\\"g3\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"%2300a2ff\\\" stop-opacity=\\\"0.06\\\"/><stop offset=\\\"1\\\" stop-color=\\\"%23007ab8\\\" stop-opacity=\\\"0.04\\\"/></linearGradient><pattern id=\\\"p3\\\" width=\\\"120\\\" height=\\\"120\\\" patternUnits=\\\"userSpaceOnUse\\\"><rect width=\\\"120\\\" height=\\\"120\\\" fill=\\\"transparent\\\"/><circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"3\\\" fill=\\\"%230072a6\\\" fill-opacity=\\\"0.08\\\"/></pattern></defs><rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(%23g3)\\\"/><rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(%23p3)\\\" opacity=\\\"0.85\\\"/></svg>');filter:blur(14px)'}\\n    header{max-width:var(--maxw);margin:22px auto;padding:18px;border-radius:14px;background:rgba(255,255,255,0.6);display:flex;align-items:center}\\n    nav{margin-left:auto}\\n    nav a{margin:0 8px;color:var(--muted);text-decoration:none}\\n    main{max-width:var(--maxw);margin:20px auto;padding:22px}\\n    .intro{display:flex;gap:18px;align-items:flex-start}\\n    .intro .box{padding:18px;border-radius:var(--radius);background:var(--card);backdrop-filter:blur(6px)}\\n    .steps{margin-top:18px;display:grid;grid-template-columns:repeat(4,1fr);gap:12px}\\n    .step{padding:14px;border-radius:12px;background:rgba(255,255,255,0.68);box-shadow:0 6px 18px rgba(6,20,24,0.04)}\\n    .micro{margin-top:14px;display:flex;gap:10px;flex-wrap:wrap}\\n    .micro .pill{background:rgba(255,255,255,0.8);padding:8px 10px;border-radius:999px;color:var(--accent);font-weight:700}\\n    .note{margin-top:12px;color:var(--muted)}\\n    footer{max-width:var(--maxw);margin:28px auto;padding:18px;color:var(--muted);display:flex;justify-content:space-between}\\n    @media (max-width:1000px){.steps{grid-template-columns:repeat(2,1fr)} .intro{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"bg-pattern\\\" aria-hidden=\\\"true\\\"></div>\\n  <header>\\n    <div style=\\\"font-weight:800;color:var(--accent)\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n    </nav>\\n  </header>\\n  <main>\\n    <div class=\\\"intro\\\">\\n      <div class=\\\"box\\\" style=\\\"flex:1\\\">\\n        <h1 style=\\\"margin:0\\\">A practical, phased approach to care</h1>\\n        <p class=\\\"note\\\">We frame visits around learning, prioritizing, and measurable next steps. Optional diagnostics are educational and used selectively to reduce guesswork.</p>\\n      </div>\\n      <div class=\\\"box\\\" style=\\\"width:360px\\\">\\n        <strong>Quick options</strong>\\n        <p class=\\\"note\\\" style=\\\"margin-top:6px\\\">Choose an Initial Visit for a paced start or a VIP Day for one-day intensive mapping and planning.</p>\\n        <div style=\\\"margin-top:10px\\\"><a style=\\\"padding:10px 12px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none;font-weight:700\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n      </div>\\n    </div>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h2 style=\\\"margin:0 0 8px 0\\\">Stepwise care</h2>\\n      <p class=\\\"note\\\">Each step is collaborative. We track small wins and adapt the plan as we learn what works for you.</p>\\n      <div class=\\\"steps\\\">\\n        <div class=\\\"step\\\">\\n          <strong>1. Intake & story</strong>\\n          <p class=\\\"note\\\">A thorough review of medical history, lifestyle, and priorities. This informs a hypothesis-driven plan.</p>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <strong>2. Prioritized plan</strong>\\n          <p class=\\\"note\\\">Clear, time-bound actions with realistic micro-habits and education to support change.</p>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <strong>3. Optional testing</strong>\\n          <p class=\\\"note\\\">When helpful, targeted labs are discussed as tools to refine the plan; not every case needs testing.</p>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <strong>4. Follow-up & adjustment</strong>\\n          <p class=\\\"note\\\">Regular check-ins to measure progress, troubleshoot barriers, and step up or down interventions as needed.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2 style=\\\"margin:0 0 8px 0\\\">How labs and tests are used</h2>\\n      <p class=\\\"note\\\">Labs are educational: they help us prioritize and tailor interventions. Tests are only recommended when results are likely to change the care plan.</p>\\n      <ul style=\\\"color:var(--muted)\\\">\\n        <li>Basic metabolic and screening labs to rule out reversible contributors.</li>\\n        <li>Targeted nutrient or inflammation markers when clinically indicated.</li>\\n        <li>Functional panels only when interpretation will meaningfully alter next steps.</li>\\n      </ul>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2 style=\\\"margin:0 0 8px 0\\\">Micro-habits we introduce early</h2>\\n      <div class=\\\"micro\\\">\\n        <div class=\\\"pill\\\">2-minute breath reset</div>\\n        <div class=\\\"pill\\\">Consistent wake time</div>\\n        <div class=\\\"pill\\\">Slow first bite at meals</div>\\n        <div class=\\\"pill\\\">5-minute movement break</div>\\n      </div>\\n      <p class=\\\"note\\\">These small, repeatable actions create the foundation for larger change. They are customized to be achievable in your daily routine.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2 style=\\\"margin:0 0 8px 0\\\">Follow-up cadence</h2>\\n      <p class=\\\"note\\\">Follow-ups vary by need: many start with 4–8 week intervals, with messaging support between visits. For concentrated change, a 90-day framework after a VIP Day helps sustain momentum.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:24px;padding:16px;border-radius:14px;background:rgba(255,255,255,0.7)\\\">\\n      <h2 style=\\\"margin:0\\\">Next steps</h2>\\n      <p class=\\\"note\\\" style=\\\"margin-top:8px\\\">If you want a guided, efficient path: schedule an Initial Visit. If you want to compress several visits into one working session: consider the VIP Day.</p>\\n      <div style=\\\"margin-top:12px;display:flex;gap:10px\\\">\\n        <a style=\\\"padding:10px 12px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none;font-weight:700\\\" href=\\\"book.html\\\">Book a visit</a>\\n        <a style=\\\"padding:10px 12px;border-radius:10px;background:transparent;border:1px solid rgba(21,67,96,0.12);text-decoration:none;color:var(--accent);font-weight:700\\\" href=\\\"contact.html\\\">Ask about VIP Day</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n  <footer>\\n    <div style=\\\"color:var(--muted)\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}} • {{BUSINESS_NAME}}</div>\\n    <div style=\\\"color:var(--muted)\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
