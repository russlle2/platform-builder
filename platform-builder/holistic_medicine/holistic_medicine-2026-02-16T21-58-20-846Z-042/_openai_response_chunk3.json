          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Investment — {{BUSINESS_NAME}}</title>\\n  <meta name='description' content='Transparent, practical pricing for whole-person care and VIP Day planning.'>\\n  <style>\\n    :root{--glass-bg: rgba(255,255,255,0.08);--glass-border: rgba(255,255,255,0.12);--accent: #7bd389;--muted:#dfeef1;--glass-blur:10px;--card-radius:14px}\\n    *{box-sizing:border-box;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial}\\n    html,body{height:100%;margin:0;background-color:#0f1724;color:#e6f3f2}\\n    /* unique svg pattern via data URI (soft organic grid + seed 1850042780) */\\n    body{background-image:url('data:image/svg+xml;utf8,<svg xmlns=%27http://www.w3.org/2000/svg%27 width=%27120%27 height=%27120%27 viewBox=%270 0 120 120%27><defs><linearGradient id=%27g%27 x1=%270%27 x2=%271%27 y1=%270%27 y2=%271%27><stop offset=%270%27 stop-color=%27%2372c7a3%27 stop-opacity=%270.08%27/><stop offset=%271%27 stop-color=%27%235aaea0%27 stop-opacity=%270.06%27/></linearGradient></defs><rect width=%27120%27 height=%27120%27 fill=%27%230b1220%27/><g fill=%27none%27 stroke=%27url(%23g)%27 stroke-opacity=%270.22%27 stroke-width=%271.2%27><path d=%27M0 30c20-8 40 8 60 6s40-22 60-14v98H0V30z%27/></g><g fill=%27%23ffffff%27 fill-opacity=%270.03%27><circle cx=%2720%27 cy=%2720%27 r=%2716%27/><circle cx=%2780%27 cy=%2780%27 r=%2720%27/></g></svg>');background-size:520px}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 36px}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:46px;height:46px;border-radius:12px;background:linear-gradient(135deg,rgba(255,255,255,0.06),rgba(255,255,255,0.02));box-shadow:inset 0 1px 0 rgba(255,255,255,0.03);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--muted)}\\n    nav a{color:rgba(230,243,242,0.9);text-decoration:none;margin:0 10px;padding:8px 10px;border-radius:10px;font-size:14px}\\n    nav a.primary{background:linear-gradient(90deg,rgba(123,211,137,0.16),rgba(90,174,160,0.08));border:1px solid rgba(123,211,137,0.12)}\\n    main{padding:28px;display:grid;grid-template-columns:1fr 420px;gap:22px;align-items:start}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border:1px solid var(--glass-border);backdrop-filter:blur(var(--glass-blur));border-radius:var(--card-radius);padding:22px}\\n    .hero{padding:34px;border-radius:16px;background:linear-gradient(180deg,rgba(123,211,137,0.06),transparent);display:flex;flex-direction:column;gap:12px}\\n    .hero h1{margin:0;font-size:28px;color:#eafff5}\\n    .hero p{margin:0;color:#d8efea}\\n    .kicker{font-size:13px;color:var(--muted);letter-spacing:0.6px}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:12px}\\n    .price{padding:18px;border-radius:12px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.03)}\\n    .price h3{margin:0;font-size:16px}\\n    .price .cost{font-weight:700;font-size:20px;color:var(--accent);margin-top:8px}\\n    .muted{color:rgba(230,243,242,0.7);font-size:13px}\\n    .features{list-style:none;padding:0;margin:0}\\n    .features li{padding:8px 0;border-top:1px dashed rgba(255,255,255,0.03);font-size:14px}\\n    .cta{display:inline-block;margin-top:14px;padding:10px 16px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#5fb0a4);color:#05231e;text-decoration:none;font-weight:700}\\n    aside .card{position:sticky;top:32px}\\n    .note{font-size:13px;color:rgba(230,243,242,0.7);margin-top:8px}\\n    footer{padding:20px;text-align:center;color:rgba(230,243,242,0.6);font-size:13px}\\n    @media (max-width:900px){main{grid-template-columns:1fr}aside{order:2}} \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class='brand'>\\n      <div class='logo'>HM</div>\\n      <div>\\n        <div style='font-weight:700'>{{BUSINESS_NAME}}</div>\\n        <div style='font-size:12px;color:var(--muted)'>{{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href='index.html'>Welcome</a>\\n      <a href='services.html'>Offerings</a>\\n      <a href='conditions.html'>Concerns</a>\\n      <a href='approach.html'>How I Work</a>\\n      <a href='pricing.html' class='primary'>Investment</a>\\n      <a href='about.html'>Meet</a>\\n      <a href='book.html'>Schedule</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class='card hero'>\\n      <div class='kicker'>Transparent, practical packages</div>\\n      <h1>Choose the pathway that supports your whole health goals</h1>\\n      <p>We center education, lifestyle tools, and evidence-informed options. Pricing is structured to help you get actionable results — including a VIP Day for focused transformation.</p>\\n\\n      <div class='grid'>\\n        <div class='price'>\\n          <h3>Initial Consultation</h3>\\n          <div class='cost'>$240</div>\\n          <div class='muted'>90 minutes — intake, focused history, and next steps</div>\\n          <ul class='features'>\\n            <li>Full-person review (sleep, stress, digestion, energy)</li>\\n            <li>Baseline wellness plan and 2-week micro-habits</li>\\n            <li>Personalized education and resources</li>\\n          </ul>\\n        </div>\\n\\n        <div class='price'>\\n          <h3>Follow-up Visit</h3>\\n          <div class='cost'>$120</div>\\n          <div class='muted'>45 minutes — progress review and plan adjustments</div>\\n          <ul class='features'>\\n            <li>Refine habits and targeted supports</li>\\n            <li>Optional lab review (educational)</li>\\n          </ul>\\n        </div>\\n\\n        <div class='price'>\\n          <h3>Package: 3 Visits</h3>\\n          <div class='cost'>$420</div>\\n          <div class='muted'>Best for early momentum and ongoing coaching</div>\\n          <ul class='features'>\\n            <li>Initial + two follow-ups</li>\\n            <li>Email support between visits</li>\\n          </ul>\\n        </div>\\n\\n        <div class='price'>\\n          <h3>VIP Day (Focused Intensive)</h3>\\n          <div class='cost'>$1,750</div>\\n          <div class='muted'>6–8 hours of concentrated work: assessment, planning, and immediate tools</div>\\n          <ul class='features'>\\n            <li>Deep-dive intake and personalized roadmap</li>\\n            <li>Hands-on lifestyle strategy, meal & movement ideas</li>\\n            <li>Follow-up 30-min check-in within 2 weeks</li>\\n          </ul>\\n        </div>\\n      </div>\\n\\n      <div style='display:flex;gap:12px;margin-top:12px;align-items:center'>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n        <div class='note'>Need a tailored package? Ask about sliding options and bundled savings.</div>\\n      </div>\\n    </section>\\n\\n    <aside>\\n      <div class='card'>\\n        <h3 style='margin-top:0'>What to expect</h3>\\n        <p class='muted'>Care is collaborative. There are no guaranteed cures — only education, tools, and compassionate support for whole-person change.</p>\\n        <hr style='border:none;border-top:1px solid rgba(255,255,255,0.03);margin:12px 0'>\\n        <h4 style='margin:0'>Micro-habits to start</h4>\\n        <ul class='features' style='margin-top:10px'>\\n          <li>2-minute breathing routine morning & evening</li>\\n          <li>Consistent 7–9 hour sleep window, 15-min wind-down</li>\\n          <li>Small protein at breakfast to stabilize energy</li>\\n        </ul>\\n        <a class='cta' href='book.html' style='display:inline-block;margin-top:12px'>Book a VIP Day</a>\\n        <p class='note' style='margin-top:10px'>Questions? Call {{PHONE}} or email <a href='mailto:{{EMAIL}}' style='color:var(--muted)'>{{EMAIL}}</a></p>\\n      </div>\\n    </aside>\\n  </main>\\n\\n  <footer>\\n    <div>{{PRACTITIONER_NAME}}, {{CREDENTIALS}} — {{BUSINESS_NAME}} • <a href='mailto:{{EMAIL}}' style='color:inherit;text-decoration:underline'>{{EMAIL}}</a> • {{PHONE}}</div>\\n    <div style='margin-top:6px;color:rgba(230,243,242,0.5)'>Policies, scheduling windows, and insurance info available on request.</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name='description' content='Meet the practitioner and learn the philosophy that guides our integrative, whole-person care.'>\\n  <style>\\n    :root{--bg:#071025;--glass:rgba(255,255,255,0.06);--accent:#8bd2c0}\\n    *{box-sizing:border-box;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial}\\n    body{margin:0;min-height:100vh;background:linear-gradient(180deg,#05101a 0%, #071025 60%);color:#def3ee}\\n    /* diagonal wave pattern unique to about page */\\n    header{padding:28px 36px;display:flex;justify-content:space-between;align-items:center;background-image:url('data:image/svg+xml;utf8,<svg xmlns=%27http://www.w3.org/2000/svg%27 width=%27160%27 height=%27160%27 viewBox=%270 0 160 160%27><rect width=%27160%27 height=%27160%27 fill=%27%23040b14%27/><g stroke=%27%23aee7d8%27 stroke-opacity=%270.08%27 stroke-width=%272%27><path d=%27M-20 40C20 10 60 90 100 70s90-80 140-60v160H-20V40z%27/></g></svg>');\\n    }\\n    .nav a{color:#cfeee6;text-decoration:none;margin-left:14px}\\n    main{padding:34px;display:flex;gap:22px}\\n    .left{flex:1}\\n    .right{width:340px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border:1px solid rgba(255,255,255,0.06);backdrop-filter:blur(8px);border-radius:14px;padding:20px}\\n    .portrait{height:120px;width:120px;border-radius:16px;background:linear-gradient(135deg,#baf0d8, #6fd4b7);display:flex;align-items:center;justify-content:center;font-weight:700;color:#05231e}\\n    h1{margin-top:6px}\\n    .lead{color:#cfeee6}\\n    .section{margin-top:16px}\\n    .pill{display:inline-block;background:rgba(255,255,255,0.03);padding:6px 10px;border-radius:999px;color:#e6f7f0;font-size:13px}\\n    .list{margin:0;padding:0;list-style:none}\\n    .list li{padding:8px 0;border-top:1px dashed rgba(255,255,255,0.04)}\\n    footer{padding:20px;text-align:center;color:rgba(230,243,242,0.5)}\\n    @media (max-width:900px){main{flex-direction:column}.right{width:auto}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style='display:flex;align-items:center;gap:14px'>\\n      <div style='width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#8bd2c0,#5fb8a8);display:flex;align-items:center;justify-content:center;color:#03302b;font-weight:800'>HM</div>\\n      <div>\\n        <div style='font-weight:700'>{{BUSINESS_NAME}}</div>\\n        <div style='font-size:12px;color:#a6e7dc'>Holistic care in {{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <div class='nav'>\\n      <a href='index.html'>Home</a>\\n      <a href='services.html'>Services</a>\\n      <a href='approach.html'>How I Work</a>\\n      <a href='pricing.html'>Investment</a>\\n      <a href='book.html'>Reserve</a>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <section class='left'>\\n      <div class='card'>\\n        <div style='display:flex;gap:16px;align-items:center'>\\n          <div class='portrait'>{{PRACTITIONER_NAME}}</div>\\n          <div>\\n            <div style='font-size:20px;font-weight:700'>{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n            <div class='pill' style='margin-top:6px'>Integrative · Evidence-informed · Practical</div>\\n          </div>\\n        </div>\\n\\n        <div class='section'>\\n          <h1>Why a whole-person approach matters</h1>\\n          <p class='lead'>My practice focuses on connecting symptoms to daily patterns—sleep, stress, movement, and nutrition—so you can make changes that stick. I combine behavioral strategies with educational resources and, when appropriate, targeted tests to clarify next steps.</p>\\n        </div>\\n\\n        <div class='section'>\\n          <h3>Background & orientation</h3>\\n          <p>I trained in both conventional and integrative frameworks and bring a systems-minded, practical stance. My goal is to translate complex information into manageable next steps you can implement this week. Expect clear takeaways, short experiments, and measured progress.</p>\\n        </div>\\n\\n        <div class='section'>\\n          <h3>Clinical focus areas</h3>\\n          <ul class='list'>\\n            <li>Stress resilience and nervous system regulation</li>\\n            <li>Sleep optimization and restorative routines</li>\\n            <li>Digestive wellness and meal structure</li>\\n            <li>Chronic low-level inflammation and energy stabilization</li>\\n          </ul>\\n        </div>\\n\\n        <div class='section'>\\n          <h3>What I do not promise</h3>\\n          <p class='lead'>I do not offer guaranteed cures. My responsibility is to educate, co-create practical plans, and monitor progress. Some conditions may require collaboration with other clinicians or specialist testing; I help coordinate that when needed.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <aside class='right'>\\n      <div class='card'>\\n        <h3 style='margin-top:0'>Quick intake snapshot</h3>\\n        <p class='muted' style='color:#cfeee6'>A concise diagnostic framework I use during intake to guide individualized plans.</p>\\n        <ol style='padding-left:16px;margin-top:10px'>\\n          <li><strong>Sleep:</strong> timing, quality, routines</li>\\n          <li><strong>Stress:</strong> triggers, coping strategies, nervous system balance</li>\\n          <li><strong>Nutrition:</strong> meal timing, stabilization, digestion</li>\\n          <li><strong>Movement:</strong> consistency and restorative practices</li>\\n          <li><strong>Labs (optional):</strong> used only to clarify educational next steps</li>\\n        </ol>\\n\\n        <div style='margin-top:12px;'>\\n          <h4 style='margin:0'>Starter micro-habits</h4>\\n          <ul class='list' style='margin-top:8px'>\\n            <li>3-minute diaphragmatic breathing twice daily</li>\\n            <li>Two meals with balanced protein in the morning and midday</li>\\n            <li>15 minutes of natural light within 60 minutes of waking</li>\\n          </ul>\\n        </div>\\n\\n        <a href='book.html' class='cta' style='display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:#8bd2c0;color:#05231e;text-decoration:none;font-weight:700'>Reserve a Consult</a>\\n        <p style='font-size:13px;color:#bfeee2;margin-top:10px'>Questions? Call <strong>{{PHONE}}</strong> or email <a href='mailto:{{EMAIL}}' style='color:#cfeee6'>{{EMAIL}}</a>.</p>\\n      </div>\\n\\n      <div style='height:18px'></div>\\n\\n      <div class='card'>\\n        <h4 style='margin-top:0'>Philosophy in one line</h4>\\n        <p class='lead'>Small, consistent changes rooted in understanding your unique context produce lasting shifts.</p>\\n      </div>\\n    </aside>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href='mailto:{{EMAIL}}' style='color:inherit;text-decoration:underline'>{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <meta name='description' content='Schedule an initial consult or book the VIP Day focused intensive.'>\\n  <style>\\n    :root{--bg:#08121a;--glass:rgba(255,255,255,0.05);--accent:#6bd0a9}\\n    *{box-sizing:border-box;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial}\\n    body{margin:0;min-height:100vh;background:linear-gradient(180deg,#03101a,#071722);color:#e8fbf5}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 28px}\\n    header .links a{color:#cfeee6;text-decoration:none;margin-left:12px}\\n    main{display:flex;gap:20px;padding:22px}\\n    .left{flex:1}\\n    .right{width:360px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border:1px solid rgba(255,255,255,0.06);backdrop-filter:blur(8px);border-radius:14px;padding:20px}\\n    .form-row{display:flex;gap:10px;margin-bottom:10px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,0.06);background:transparent;color:#dff9f0}\\n    label{font-size:13px;color:#bfeee3}\\n    .btn{display:inline-block;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#4fb29a);color:#042b23;font-weight:800;text-decoration:none}\\n    .hint{font-size:13px;color:#bfeee3}\\n    footer{padding:18px;text-align:center;color:rgba(230,243,242,0.5)}\\n    /* dotted organic pattern unique to booking */\\n    body:before{content:'';position:fixed;inset:0;background-image:url('data:image/svg+xml;utf8,<svg xmlns=%27http://www.w3.org/2000/svg%27 width=%27100%27 height=%27100%27 viewBox=%270 0 100 100%27><rect width=%27100%27 height=%27100%27 fill=%27060d12%27/><g fill=%27%23aee7d8%27 fill-opacity=%270.06%27><circle cx=%2720%27 cy=%2720%27 r=%279%27/><circle cx=%2750%27 cy=%2750%27 r=%275.5%27/><circle cx=%2785%27 cy=%2785%27 r=%279%27/></g></svg>');pointer-events:none;mix-blend-mode:overlay}\\n    @media (max-width:900px){main{flex-direction:column}.right{width:auto}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style='font-weight:700'>{{BUSINESS_NAME}}</div>\\n    <div class='links'>\\n      <a href='index.html'>Start</a>\\n      <a href='services.html'>Services</a>\\n      <a href='contact.html'>Contact</a>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <section class='left'>\\n      <div class='card'>\\n        <h2 style='margin-top:0'>Schedule an appointment</h2>\\n        <p class='hint'>Select a visit type, pick a preferred time, and tell us briefly what you're hoping to address. We prioritize clear next steps and practical support.</p>\\n\\n        <form action='{{PRIMARY_CTA_URL}}' method='get' style='margin-top:12px'>\\n          <label for='visit'>Visit type</label>\\n          <select id='visit' name='visit'>\\n            <option>Initial Consultation — 90 min</option>\\n            <option>Follow-up — 45 min</option>\\n            <option>VIP Day — full intensive</option>\\n          </select>\\n\\n          <div class='form-row'>\\n            <div style='flex:1'>\\n              <label for='name'>Full name</label>\\n              <input id='name' name='name' placeholder='First Last' required>\\n            </div>\\n            <div style='width:160px'>\\n              <label for='phone'>Phone</label>\\n              <input id='phone' name='phone' placeholder='###-###-####'>\\n            </div>\\n          </div>\\n\\n          <label for='email'>Email</label>\\n          <input id='email' name='email' type='email' placeholder='you@example.com' required>\\n\\n          <label for='notes'>Brief reason for visit (2–3 lines)</label>\\n          <textarea id='notes' name='notes' rows='4' placeholder='e.g., sleep pattern changes, digestion, persistent fatigue'></textarea>\\n\\n          <div style='display:flex;gap:10px;align-items:center;margin-top:12px'>\\n            <button class='btn' type='submit'>Book appointment</button>\\n            <div class='hint'>Or call <strong>{{PHONE}}</strong> to schedule directly.</div>\\n          </div>\\n\\n          <p class='hint' style='margin-top:10px'>By booking you consent to an educational, integrative consult. This is not a substitute for emergency care.</p>\\n        </form>\\n      </div>\\n\\n      <div style='height:16px'></div>\\n\\n      <div class='card'>\\n        <h3 style='margin-top:0'>VIP Day details</h3>\\n        <p class='hint'>The VIP Day is an immersive, practical session designed to map a personalized roadmap and create achievable experiments you can begin immediately.</p>\\n        <ul style='margin-top:10px'>\\n          <li>Comprehensive intake + focused testing conversation</li>\\n          <li>Hands-on planning (meals, sleep, activity, stress tools)</li>\\n          <li>30-minute follow-up within two weeks</li>\\n        </ul>\\n        <a class='btn' href='{{PRIMARY_CTA_URL}}?visit=vip' style='display:inline-block;margin-top:12px'>Reserve a VIP Day</a>\\n      </div>\\n    </section>\\n\\n    <aside class='right'>\\n      <div class='card'>\\n        <h4 style='margin-top:0'>Before your visit</h4>\\n        <ol style='padding-left:16px'>\\n          <li>Gather a short timeline of your symptoms</li>\\n          <li>Note sleep and energy patterns for a typical week</li>\\n          <li>List medications, supplements, and recent labs</li>\\n        </ol>\\n        <p class='hint' style='margin-top:10px'>If labs are needed, they will be discussed as an educational tool to inform the plan—not as a guaranteed diagnostic conclusion.</p>\\n      </div>\\n\\n      <div style='height:16px'></div>\\n\\n      <div class='card'>\\n        <h4 style='margin-top:0'>Need help?</h4>\\n        <p class='hint'>Email <a href='mailto:{{EMAIL}}' style='color:inherit;text-decoration:underline'>{{EMAIL}}</a> or call <strong>{{PHONE}}</strong>. We aim to respond within 48 business hours.</p>\\n      </div>\\n    </aside>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — {{PRACTITIONER_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
