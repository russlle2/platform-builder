          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Fees &amp; Packages — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#f6fbf9;--bg2:#eef7f3;--accent:#2b7a6b;--muted:#55606a;--card:#ffffff}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial; color:var(--muted);background:linear-gradient(180deg,var(--bg1),var(--bg2));}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 36px;position:relative;z-index:4}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#4fa88a);display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-weight:600}\\n    nav a[href$=\\\"pricing.html\\\"]{color:var(--accent)}\\n    main{max-width:1100px;margin:28px auto;padding:36px}\\n\\n    /* floating decorative SVG */\\n    .bg-svg{position:fixed;right:-120px;top:-80px;width:520px;height:520px;opacity:0.14;pointer-events:none;filter:blur(10px);z-index:0}\\n\\n    .hero{display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:start;margin-bottom:22px;position:relative;z-index:2}\\n    .panel{background:var(--card);padding:28px;border-radius:14px;box-shadow:0 8px 30px rgba(50,60,70,0.06)}\\n    h1{margin:0 0 8px 0;color:#16342b}\\n    p.lead{margin:0;color:#38524a}\\n\\n    .price-list{display:flex;flex-direction:column;gap:14px}\\n    .plan{display:flex;justify-content:space-between;align-items:center;padding:18px;border-radius:10px;border:1px solid rgba(22,52,43,0.06)}\\n    .plan .desc{max-width:62%}\\n    .badge{background:linear-gradient(90deg,#e6f7f1,#dff4ee);color:var(--accent);padding:8px 12px;border-radius:999px;font-weight:700}\\n    .muted{color:#6c7a73;font-size:0.95rem}\\n\\n    .note{font-size:0.9rem;color:#6b7a73;margin-top:12px}\\n    .cta-row{display:flex;gap:12px;align-items:center;margin-top:18px}\\n    .btn{background:var(--accent);color:white;padding:12px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .btn.ghost{background:transparent;color:var(--accent);border:1px solid rgba(43,122,107,0.12)}\\n\\n    .info-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}\\n    .info{background:linear-gradient(180deg,#fff,#fbfffe);padding:12px;border-radius:10px;font-size:0.95rem}\\n\\n    footer{max-width:1100px;margin:28px auto;padding:18px 36px;color:#87958f;font-size:0.95rem}\\n\\n    /* responsive */\\n    @media (max-width:900px){\\n      .hero{grid-template-columns:1fr;}\\n      nav a{display:none}\\n      header{padding:18px}\\n      main{padding:18px}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#e7fbf7\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#dff6f0\\\"/></linearGradient>\\n      <pattern id=\\\"p1\\\" width=\\\"20\\\" height=\\\"20\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"20\\\" height=\\\"20\\\" fill=\\\"transparent\\\"/>\\n        <circle cx=\\\"6\\\" cy=\\\"6\\\" r=\\\"1.5\\\" fill=\\\"#bfeee1\\\"/>\\n        <circle cx=\\\"14\\\" cy=\\\"14\\\" r=\\\"1.5\\\" fill=\\\"#c9f2e6\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g1)\\\"/>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\" opacity=\\\"0.9\\\"/>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:0.9rem;color:#6b7a73\\\">Integrative care — whole-person focus</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Care</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"approach.html\\\">Our Approach</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\">Schedule</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"panel\\\">\\n        <h1>Transparent fees, flexible support</h1>\\n        <p class=\\\"lead\\\">We structure care to match your needs — from single visits to guided plans. Financial conversations are part of care; we make pricing clear so you can focus on health.</p>\\n\\n        <div class=\\\"price-list\\\" style=\\\"margin-top:18px\\\">\\n          <div class=\\\"plan\\\">\\n            <div class=\\\"desc\\\">\\n              <div style=\\\"font-weight:800\\\">Initial Comprehensive Visit</div>\\n              <div class=\\\"muted\\\">90 minutes intake — full review of history, lifestyle, goals, initial recommendations</div>\\n            </div>\\n            <div style=\\\"text-align:right\\\">\\n              <div class=\\\"badge\\\">$240</div>\\n              <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Telehealth or in-person</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"plan\\\">\\n            <div class=\\\"desc\\\">\\n              <div style=\\\"font-weight:800\\\">Follow-up Session</div>\\n              <div class=\\\"muted\\\">30–45 minutes to refine your plan and review progress</div>\\n            </div>\\n            <div style=\\\"text-align:right\\\">\\n              <div class=\\\"badge\\\">$90</div>\\n              <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Short, focused support</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"plan\\\">\\n            <div class=\\\"desc\\\">\\n              <div style=\\\"font-weight:800\\\">Therapeutic Package (3 months)</div>\\n              <div class=\\\"muted\\\">Includes intake, two follow-ups, email support and a personalized plan</div>\\n            </div>\\n            <div style=\\\"text-align:right\\\">\\n              <div class=\\\"badge\\\">$580</div>\\n              <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Savings vs individual visits</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"note\\\">All prices are educational. Lab testing, supplements, and specialty referrals are priced separately. Insurance coverage varies; we can provide a superbill on request.</div>\\n\\n        <div class=\\\"cta-row\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a class=\\\"btn ghost\\\" href=\\\"contact.html\\\">Ask about insurance</a>\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"panel\\\">\\n        <div style=\\\"font-weight:800;margin-bottom:8px\\\">Payment &amp; Options</div>\\n        <div class=\\\"muted\\\">We accept card payments and offer sliding-scale based on need. Packages can be split across several payments; please discuss during booking.</div>\\n\\n        <div style=\\\"margin-top:14px\\\">\\n          <div style=\\\"font-weight:700\\\">Optional lab services</div>\\n          <div class=\\\"muted\\\">Educational lab options include functional panels for hormones, digestion, micronutrients. Labs are ordered for diagnostics and patient education — cost depends on the panel and lab partner.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px\\\">\\n          <div style=\\\"font-weight:700\\\">Cancellation &amp; rescheduling</div>\\n          <div class=\\\"muted\\\">Please provide 48 hours notice to avoid a fee. Emergencies are handled with compassion; contact {{PHONE}}.</div>\\n        </div>\\n\\n        <div class=\\\"info-grid\\\">\\n          <div class=\\\"info\\\"><strong>Superbills</strong><div class=\\\"muted\\\">Available on request for out-of-network reimbursement.</div></div>\\n          <div class=\\\"info\\\"><strong>Sliding scale</strong><div class=\\\"muted\\\">Limited openings for reduced-fee care; confidentiality respected.</div></div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"panel\\\" style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin-top:0\\\">Packages are plans, not promises</h2>\\n      <p class=\\\"muted\\\">Holistic care focuses on education, lifestyle change, and whole-person support. While we aim to improve symptoms and quality of life, we do not promise cures. Clinical decisions are collaborative and evidence-informed.</p>\\n\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-wrap:wrap\\\">\\n        <div style=\\\"flex:1;min-width:220px\\\">\\n          <strong>What’s included</strong>\\n          <p class=\\\"muted\\\">Individualized recommendations, care coordination, and educational resources to help you make informed choices.</p>\\n        </div>\\n        <div style=\\\"flex:1;min-width:220px\\\">\\n          <strong>What’s not included</strong>\\n          <p class=\\\"muted\\\">Costs for external labs, imaging, or specialist fees are billed separately and are the responsibility of the patient.</p>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n        <div class=\\\"muted\\\">Questions about insurance or eligibility? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}}.</div>\\n        <div>\\n          <a class=\\\"btn\\\" href=\\\"book.html\\\">Schedule a visit</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap\\\">\\n      <div>© {{BUSINESS_NAME}} — serving {{CITY}}, {{STATE}}. Not a substitute for medical care.</div>\\n      <div style=\\\"margin-top:8px\\\">Provided by {{PRACTITIONER_NAME}}, {{CREDENTIALS}} • <a href=\\\"contact.html\\\">Contact</a></div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfdfc;--accent:#37685b;--muted:#4f615b}\\n    html,body{margin:0;padding:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;color:var(--muted);background:linear-gradient(180deg,#fbfdfc,#f2fbf8)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:22px 34px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#5aa187);display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n    nav a{margin:0 8px;color:var(--muted);text-decoration:none}\\n    nav a[href$=\\\"about.html\\\"]{color:var(--accent);font-weight:700}\\n\\n    main{max-width:980px;margin:20px auto;padding:20px}\\n    .hero-card{background:white;border-radius:14px;padding:22px;box-shadow:0 14px 40px rgba(27,40,38,0.06);display:flex;gap:18px;align-items:center}\\n    .avatar{width:110px;height:110px;border-radius:12px;background:linear-gradient(135deg,#fff,#fafefb);display:flex;align-items:center;justify-content:center;font-weight:800;color:var(--accent);font-size:28px}\\n    h1{margin:0;color:#18332b}\\n    .tag{color:#5a7268}\\n\\n    .sections{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    .card{background:white;border-radius:12px;padding:16px}\\n    .pillars{display:flex;flex-direction:column;gap:10px}\\n    .pillar{padding:10px;border-radius:10px;border-left:4px solid rgba(55,104,91,0.12)}\\n    .quote{font-style:italic;color:#6a7a73}\\n\\n    .cta{display:flex;align-items:center;gap:12px;margin-top:12px}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    footer{max-width:980px;margin:18px auto;padding:12px;color:#8b9b95;font-size:0.95rem}\\n    @media (max-width:900px){.sections{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:0.9rem;color:#6a7a73\\\">Care that considers the whole person</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Overview</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"approach.html\\\">How we work</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n      <a href=\\\"about.html\\\">Team</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero-card\\\">\\n      <div class=\\\"avatar\\\">{{PRACTITIONER_NAME.split(' ')[0].charAt(0)}}{{PRACTITIONER_NAME.split(' ')[1] ? PRACTITIONER_NAME.split(' ')[1].charAt(0) : ''}}</div>\\n      <div>\\n        <h1>Meet {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</h1>\\n        <div class=\\\"tag\\\">Clinical curiosity + compassionate guidance</div>\\n        <p style=\\\"margin-top:10px;color:#536a63;max-width:600px\\\">{{PRACTITIONER_NAME}} brings integrative training and years of clinical experience to help patients translate evidence into practical, sustainable steps. Care emphasizes nutrition, movement, sleep, stress regulation, and appropriate testing.</p>\\n\\n        <div class=\\\"cta\\\">\\n          <a class=\\\"btn\\\" href=\\\"book.html\\\">Start an intake</a>\\n          <a class=\\\"btn\\\" style=\\\"background:transparent;color:var(--accent);border:1px solid rgba(55,104,91,0.12)\\\" href=\\\"contact.html\\\">Ask a question</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"sections\\\">\\n      <div>\\n        <div class=\\\"card\\\">\\n          <h2 style=\\\"margin-top:0\\\">Philosophy &amp; method</h2>\\n          <p class=\\\"quote\\\">\\\"Health emerges from the interactions between biology, environment, and behavior.\\\"</p>\\n          <p class=\\\"muted\\\">We blend conventional medicine with lifestyle and evidence-based complementary approaches. Our role is to educate, coordinate care, and support gradual, measurable change.</p>\\n          <div style=\\\"margin-top:12px\\\" class=\\\"pillars\\\">\\n            <div class=\\\"pillar\\\"><strong>Personalization</strong><div class=\\\"muted\\\">Plans are tailored to goals, tests, and context.</div></div>\\n            <div class=\\\"pillar\\\"><strong>Education</strong><div class=\\\"muted\\\">We teach patients to interpret results and options.</div></div>\\n            <div class=\\\"pillar\\\"><strong>Collaboration</strong><div class=\\\"muted\\\">We work with your other clinicians when needed.</div></div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin:0 0 8px 0\\\">Background &amp; training</h3>\\n          <p class=\\\"muted\\\">{{PRACTITIONER_NAME}} completed training in integrative approaches and maintains continuing education in nutrition, stress physiology, and functional testing. Clinical practice adheres to best-practice guidelines and informed consent.</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin:0 0 8px 0\\\">A note on expectations</h3>\\n          <p class=\\\"muted\\\">Our services focus on improving symptoms and resilience through education and practical plans. We do not promise cures. Results vary with adherence, context, and medical complexity.</p>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Quick facts</h3>\\n          <ul style=\\\"padding-left:18px;color:#596d65\\\">\\n            <li>Telehealth and in-person options</li>\\n            <li>Superbills provided for out-of-network billing</li>\\n            <li>Sliding scale available for limited need-based spots</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0\\\">Community focus</h4>\\n          <p class=\\\"muted\\\">We teach sustainable habits rather than quick fixes. Education sessions and group workshops are offered periodically — sign up for updates.</p>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px;background:white;padding:16px;border-radius:12px\\\">\\n      <h3 style=\\\"margin-top:0\\\">Common misunderstandings</h3>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px\\\">\\n        <div><strong>Myth:</strong> Holistic means anti-medicine.<div class=\\\"muted\\\">Truth: We use conventional tests and collaborate with specialists; the approach is integrative.</div></div>\\n        <div><strong>Myth:</strong> One supplement fixes everything.<div class=\\\"muted\\\">Truth: Supplements may help but should be used thoughtfully as part of a plan.</div></div>\\n      </div>\\n\\n      <div style=\\\"margin-top:12px;display:flex;justify-content:flex-end\\\">\\n        <a class=\\\"btn\\\" href=\\\"services.html\\\">See services</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:980px;margin:20px auto;color:#8a9b96;font-size:0.95rem;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}}</div>\\n      <div>Serving {{CITY}}, {{STATE}} • © {{BUSINESS_NAME}}</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book an Appointment — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#2f6e5b;--bg:#f8fdfb;--card:#ffffff;--muted:#51635c}\\n    html,body{margin:0;padding:0;height:100%;font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial;color:var(--muted);background:linear-gradient(180deg,var(--bg),#f1fbf7)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 28px}\\n    .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#55a081);display:flex;align-items:center;justify-content:center;color:white;font-weight:800}\\n    nav a{margin-left:10px;text-decoration:none;color:var(--muted)}\\n    nav a[href$=\\\"book.html\\\"]{color:var(--accent);font-weight:700}\\n\\n    main{max-width:980px;margin:18px auto;padding:18px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:18px}\\n    .card{background:var(--card);border-radius:12px;padding:16px;box-shadow:0 10px 30px rgba(24,40,36,0.05)}\\n    h1{margin:0;color:#113329}\\n    .muted{color:#59716a}\\n\\n    .form-row{display:flex;gap:8px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(80,97,92,0.12);font-size:1rem}\\n    label{font-size:0.92rem;color:#425251}\\n    .submit{background:var(--accent);color:white;padding:12px 14px;border-radius:10px;text-decoration:none;border:none;font-weight:700}\\n\\n    .note{font-size:0.9rem;color:#6b7a73}\\n    .faq{margin-top:12px}\\n    .faq details{margin-bottom:8px}\\n\\n    footer{max-width:980px;margin:18px auto;padding:12px;color:#8c9b95}\\n    @media (max-width:900px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"conditions.html\\\">Conditions</a>\\n      <a href=\\\"approach.html\\\">Approach</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"grid\\\">\\n      <section class=\\\"card\\\">\\n        <h1>Schedule your visit</h1>\\n        <p class=\\\"muted\\\">Choose the appointment type that aligns with your needs. We’ll follow up with intake forms and, if appropriate, educational lab options.</p>\\n\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" style=\\\"margin-top:12px\\\">\\n          <div style=\\\"margin-bottom:10px\\\">\\n            <label>Appointment type</label>\\n            <select name=\\\"type\\\">\\n              <option>Initial Comprehensive Visit — 90 min</option>\\n              <option>Follow-up — 45 min</option>\\n              <option>Brief Check-in — 20 min</option>\\n              <option>Telehealth visit</option>\\n            </select>\\n          </div>\\n\\n          <div class=\\\"form-row\\\" style=\\\"margin-bottom:10px\\\">\\n            <div style=\\\"flex:1\\\">\\n              <label>First name</label>\\n              <input name=\\\"first\\\" required>\\n            </div>\\n            <div style=\\\"flex:1\\\">\\n              <label>Last name</label>\\n              <input name=\\\"last\\\" required>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-bottom:10px\\\">\\n            <label>Email</label>\\n            <input name=\\\"email\\\" type=\\\"email\\\" required>\\n          </div>\\n\\n          <div style=\\\"margin-bottom:10px\\\">\\n            <label>Phone</label>\\n            <input name=\\\"phone\\\" type=\\\"tel\\\">\\n          </div>\\n\\n          <div style=\\\"margin-bottom:10px\\\">\\n            <label>Brief reason for visit (symptoms / goals)</label>\\n            <textarea name=\\\"reason\\\" rows=\\\"3\\\"></textarea>\\n          </div>\\n\\n          <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n            <button class=\\\"submit\\\" type=\\\"submit\\\">Request appointment</button>\\n            <div class=\\\"note\\\">Or call <strong>{{PHONE}}</strong></div>\\n          </div>\\n        </form>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px;background:#fbfffc\\\">\\n          <h3 style=\\\"margin-top:0\\\">What to expect after booking</h3>\\n          <ol style=\\\"margin:0;color:#556a62\\\">\\n            <li>We send an intake packet and consent form.</li>\\n            <li>Optional labs may be discussed; ordering is shared decision-making.</li>\\n            <li>Follow-up plan is scheduled in collaboration with you.</li>\\n          </ol>\\n        </div>\\n\\n        <div class=\\\"faq\\\">\\n          <h4 style=\\\"margin-bottom:6px\\\">Booking FAQs</h4>\\n          <details><summary>Do you accept insurance?</summary><div class=\\\"muted\\\">We are often out-of-network. Superbills are available for reimbursement; coverage depends on your plan.</div></details>\\n          <details><summary>Can I switch to telehealth?</summary><div class=\\\"muted\\\">Yes. Telehealth is available for most visits unless in-person evaluation is recommended.</div></details>\\n          <details><summary>What if I need urgent care?</summary><div class=\\\"muted\\\">This practice is not for emergencies. For urgent issues, contact local emergency services or your primary care provider.</div></details>\\n        </div>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Visit options &amp; fees</h3>\\n          <div style=\\\"display:flex;flex-direction:column;gap:8px;margin-top:8px\\\">\\n            <div><strong>Initial (90 min)</strong><div class=\\\"muted\\\">Comprehensive intake — $240</div></div>\\n            <div><strong>Follow-up (45 min)</strong><div class=\\\"muted\\\">$90</div></div>\\n            <div><strong>Brief (20 min)</strong><div class=\\\"muted\\\">$50</div></div>\\n          </div>\\n          <div style=\\\"margin-top:12px\\\" class=\\\"note\\\">Lab fees not included. We recommend tests only when they will change care decisions.</div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0\\\">Important notes</h4>\\n          <p class=\\\"muted\\\">Holistic care emphasizes education and gradual change. We will not represent unproven or guaranteed cures. Clinical decisions are individualized, evidence-informed, and made collaboratively.</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0\\\">Need help?</h4>\\n          <p class=\\\"muted\\\">Contact <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}}. For cancellations, please notify us 48 hours in advance.</p>\\n        </div>\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:980px;margin:14px auto;color:#8d9c97;text-align:center\\\">Appointments are educational and supportive — not emergency medical care. For urgent conditions, contact local emergency services. © {{BUSINESS_NAME}} • {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
