          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Services</title>\\n  <meta name=\\\"description\\\" content=\\\"Integrative services focused on whole-person health — nutrition, herbs, mind-body and functional assessments.\\\">\\n  <style>\\n    :root{\\n      --bg:#f6fbf9; --card:#ffffff; --accent:#2b6f61; --muted:#6b7b76; --glass:rgba(255,255,255,0.65);\\n      --radius:14px; --shadow:0 6px 30px rgba(38,56,48,0.08);\\n      font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;\\n    }\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg, #f6fbf9 0%, #f0f6f4 100%);color:#16332b}\\n    .wrap{max-width:1100px;margin:48px auto;padding:28px;position:relative}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,#c9efe6,#9fe7d2);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent)}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600}\\n    nav a.active{color:var(--accent)}\\n\\n    .hero{display:grid;grid-template-columns:1fr 340px;gap:22px;align-items:start;margin-bottom:22px}\\n    .card{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:22px}\\n    .hero h1{margin:0 0 8px 0;font-size:28px;color:var(--accent)}\\n    .hero p{margin:0;color:var(--muted)}\\n\\n    .services-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:18px}\\n    .service{padding:18px;border-radius:12px;background:linear-gradient(180deg,#ffffff,#fbfffd);border:1px solid rgba(33,58,50,0.04)}\\n    .service h3{margin:0 0 6px 0;color:#17493f}\\n    .service p{margin:0;color:var(--muted);font-size:14px}\\n\\n    .aside-note{background:linear-gradient(90deg,#e9faf5,#f6fffb);padding:16px;border-radius:12px;border:1px solid rgba(39,86,73,0.06)}\\n\\n    footer{margin-top:28px;display:flex;justify-content:space-between;align-items:center}\\n    .cta{background:linear-gradient(90deg,var(--accent),#1f8b70);color:white;padding:12px 18px;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    blockquote{margin:18px 0;padding:16px;border-left:4px solid #cdebe2;background:linear-gradient(90deg,#fcfffe,#fbfffd);border-radius:8px;color:#164235}\\n\\n    .faq{margin-top:14px}\\n    .q{cursor:pointer;padding:12px;border-radius:10px;border:1px solid rgba(20,50,40,0.04);background:linear-gradient(180deg,#fff,#fcfffe);margin-bottom:8px}\\n    .q h4{margin:0;font-size:15px;color:#144c3f}\\n    .a{display:none;padding-top:8px;color:var(--muted);font-size:14px}\\n\\n    /* decorative svg background */\\n    .bg-svg{position:fixed;right:-120px;top:-60px;opacity:0.65;pointer-events:none;transform:rotate(8deg);width:520px;height:520px}\\n\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.services-grid{grid-template-columns:1fr}.bg-svg{display:none}.wrap{margin:18px}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#dff7ef\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#bff0da\\\"/>\\n      </linearGradient>\\n      <pattern id=\\\"p-services\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(15)\\\">\\n        <rect width=\\\"20\\\" height=\\\"20\\\" fill=\\\"rgba(255,255,255,0.07)\\\"/>\\n        <circle cx=\\\"14\\\" cy=\\\"14\\\" r=\\\"2\\\" fill=\\\"#c9efe6\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"200\\\" height=\\\"200\\\" fill=\\\"url(#g1)\\\" rx=\\\"20\\\"/>\\n    <rect width=\\\"200\\\" height=\\\"200\\\" fill=\\\"url(#p-services)\\\" rx=\\\"20\\\" />\\n    <g fill=\\\"#9fe7d2\\\" opacity=\\\"0.9\\\">\\n      <circle cx=\\\"30\\\" cy=\\\"40\\\" r=\\\"18\\\"/>\\n      <circle cx=\\\"70\\\" cy=\\\"120\\\" r=\\\"26\\\"/>\\n      <circle cx=\\\"150\\\" cy=\\\"60\\\" r=\\\"12\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">HM</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Welcome</a>\\n        <a href=\\\"services.html\\\" class=\\\"active\\\">Care Offerings</a>\\n        <a href=\\\"conditions.html\\\">Health Library</a>\\n        <a href=\\\"approach.html\\\">How We Work</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"hero\\\">\\n      <div class=\\\"card\\\">\\n        <h1>Integrative services to support whole-person health</h1>\\n        <p>We combine evidence-informed therapies with personal context — creating plans that fit your life, values, and goals. Care is educational, collaborative and tailored.</p>\\n\\n        <div class=\\\"services-grid\\\">\\n          <div class=\\\"service\\\">\\n            <h3>Functional Nutrition</h3>\\n            <p>Personalized nutrition planning focused on digestion, energy, metabolic balance and long-term sustainability.</p>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h3>Herbal & Botanical Support</h3>\\n            <p>Safely selected botanicals to support resilience, sleep, and inflammation — discussed openly with other medications.</p>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h3>Mind–Body Therapies</h3>\\n            <p>Breathwork coaching, stress reduction, guided imagery and cognitive approaches to reduce symptom burden and improve coping.</p>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h3>Targeted Assessments</h3>\\n            <p>Non-invasive functional assessments and optional lab reviews used as educational tools to inform individualized plans.</p>\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"card aside-note\\\">\\n        <strong style=\\\"color:var(--accent)\\\">Book a consultation</strong>\\n        <p style=\\\"margin:8px 0;color:var(--muted);font-size:14px\\\">A 60–90 minute first visit allows time to explore your history, current concerns, and priorities. We emphasize shared decision-making.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n\\n        <blockquote>\\n          \\\"I finally felt heard — the plan was practical and fit into my life. Gradual changes added up.\\\" — a client\\n        </blockquote>\\n\\n        <div class=\\\"faq\\\">\\n          <div class=\\\"q\\\" onclick=\\\"toggle(this)\\\">\\n            <h4>Do you take insurance?</h4>\\n            <div class=\\\"a\\\">We offer superbills and can work with many plans; direct billing varies. Contact us at {{PHONE}} or {{EMAIL}} for details.</div>\\n          </div>\\n          <div class=\\\"q\\\" onclick=\\\"toggle(this)\\\">\\n            <h4>Are visits safe with other medications?</h4>\\n            <div class=\\\"a\\\">We review prescriptions and coordinate with your providers. Herbal suggestions are made cautiously and transparently.</div>\\n          </div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:8px\\\">\\n      <h3 style=\\\"margin-top:0\\\">How we frame care</h3>\\n      <p style=\\\"color:var(--muted)\\\">We focus on measurable goals, practical steps, and ongoing education. No single approach fits everyone — we prioritize safety and evidence-informed options.</p>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"color:var(--muted)\\\">Questions? Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule a visit</a>\\n    </footer>\\n  </div>\\n\\n  <script>\\n    function toggle(el){\\n      var a = el.querySelector('.a');\\n      if(!a) return; a.style.display = a.style.display === 'block' ? 'none' : 'block';\\n    }\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Concerns We Address</title>\\n  <meta name=\\\"description\\\" content=\\\"Educational summaries of common concerns: stress, sleep, digestion, inflammation and fatigue.\\\">\\n  <style>\\n    :root{--bg:#fffefb;--soft:#f4fbf9;--ink:#17332b;--accent:#1f6f5f;--muted:#586c66}\\n    body{margin:0;font-family:Inter,system-ui,Arial;background:var(--bg);color:var(--ink)}\\n    .container{max-width:980px;margin:42px auto;padding:26px}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}\\n    .brand{font-weight:800}\\n    nav a{margin-left:16px;color:var(--muted);text-decoration:none}\\n    nav a.active{color:var(--accent)}\\n\\n    .hero{background:linear-gradient(90deg,#effcf7,#f9fffe);padding:18px;border-radius:12px;display:flex;align-items:center;gap:12px;margin-bottom:18px}\\n    .hero svg{width:72px;height:72px}\\n    .hero h1{margin:0;font-size:20px;color:var(--accent)}\\n    .hero p{margin:6px 0 0 0;color:var(--muted)}\\n\\n    .grid{display:grid;grid-template-columns:1fr 280px;gap:18px}\\n    .list{background:white;padding:18px;border-radius:12px;box-shadow:0 8px 28px rgba(16,35,30,0.06)}\\n    .item{padding:12px;border-radius:10px;border:1px solid rgba(24,59,48,0.04);margin-bottom:12px}\\n    .item h3{margin:0 0 6px 0;color:#164236}\\n    .item p{margin:0;color:var(--muted);font-size:14px}\\n    .disclaimer{font-size:13px;color:#6b6b6b;margin-top:8px;padding:12px;background:linear-gradient(180deg,#fffaf8,#fffefc);border-radius:8px}\\n\\n    aside.card{background:linear-gradient(180deg,#ffffff,#fbfffd);padding:16px;border-radius:12px}\\n    .cta{display:inline-block;margin-top:10px;background:linear-gradient(90deg,var(--accent),#2c8b73);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    .pattern{position:fixed;left:-160px;bottom:-100px;opacity:0.6;transform:rotate(-12deg);width:480px;height:480px}\\n\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g2\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#fff9f0\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#eafff3\\\"/>\\n      </linearGradient>\\n      <pattern id=\\\"p-cond\\\" width=\\\"30\\\" height=\\\"30\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <path d=\\\"M0 15h30\\\" stroke=\\\"#dff3ea\\\" stroke-width=\\\"2\\\"/>\\n        <circle cx=\\\"6\\\" cy=\\\"6\\\" r=\\\"1.6\\\" fill=\\\"#d1efe2\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"200\\\" height=\\\"200\\\" rx=\\\"28\\\" fill=\\\"url(#g2)\\\"/>\\n    <rect width=\\\"200\\\" height=\\\"200\\\" rx=\\\"28\\\" fill=\\\"url(#p-cond)\\\"/>\\n    <g fill=\\\"#c8f0df\\\" opacity=\\\"0.9\\\">\\n      <circle cx=\\\"40\\\" cy=\\\"60\\\" r=\\\"22\\\"/>\\n      <circle cx=\\\"130\\\" cy=\\\"20\\\" r=\\\"14\\\"/>\\n      <circle cx=\\\"160\\\" cy=\\\"140\\\" r=\\\"28\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"conditions.html\\\" class=\\\"active\\\">What We Treat</a>\\n        <a href=\\\"approach.html\\\">Our Process</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"hero\\\">\\n      <svg viewBox=\\\"0 0 24 24\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"10\\\" fill=\\\"#dff7ef\\\"/><path d=\\\"M7 12c1.5-2 4-2 5 0 1.1 1.7 3.8 1.8 5 0\\\" stroke=\\\"#1f6f5f\\\" stroke-width=\\\"1.2\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/></svg>\\n      <div>\\n        <h1>Common concerns people bring to integrative care</h1>\\n        <p style=\\\"margin-top:6px;color:var(--muted)\\\">Below are frequent areas we address through education, lifestyle strategies, targeted therapies and optional assessments. This information is educational and does not replace individualized medical advice.</p>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"grid\\\">\\n      <div class=\\\"list\\\">\\n\\n        <div class=\\\"item\\\">\\n          <h3>Stress & Anxiety</h3>\\n          <p>Mind–body techniques, lifestyle adjustments, and thoughtful pacing can reduce the daily burden of stress and improve coping. We teach skills and supportive habits rather than offering quick fixes.</p>\\n        </div>\\n\\n        <div class=\\\"item\\\">\\n          <h3>Sleep Difficulties</h3>\\n          <p>Behavioral strategies, circadian support, and targeted supplements may be offered as tools to improve sleep quality. Sleep depends on many factors — we explore routines, environment and medical contributors.</p>\\n        </div>\\n\\n        <div class=\\\"item\\\">\\n          <h3>Digestive Concerns</h3>\\n          <p>From bloating to irregularity, we use nutrition-focused approaches, elimination trials, and non-invasive testing where helpful to identify supporting steps for digestion.</p>\\n        </div>\\n\\n        <div class=\\\"item\\\">\\n          <h3>Chronic Inflammation & Pain</h3>\\n          <p>We emphasize lifestyle, anti-inflammatory nutrition patterns, movement practices, and adjunctive botanical options when appropriate; medication changes are coordinated with your prescriber.</p>\\n        </div>\\n\\n        <div class=\\\"item\\\">\\n          <h3>Low Energy & Fatigue</h3>\\n          <p>Energy concerns are explored holistically — sleep, nutrition, mood, endocrine and lifestyle contributors are reviewed. Testing may be discussed as an educational step.</p>\\n        </div>\\n\\n        <div class=\\\"disclaimer\\\">\\n          Note: This page provides common educational themes. Individual evaluation is needed to identify underlying causes and safe, personalized options. We do not promise cures — we focus on sustainable improvement and informed choices.\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <h4 style=\\\"margin-top:0;color:#114f42\\\">Getting started</h4>\\n        <p style=\\\"color:var(--muted)\\\">A first visit typically includes a detailed history, review of current tests, and conversation about priorities. From there an individualized plan is co-created.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a consult</a>\\n\\n        <div style=\\\"margin-top:12px;font-size:13px;color:var(--muted)\\\">\\n          Questions? Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>\\n        </div>\\n      </aside>\\n\\n    </div>\\n\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Our Approach</title>\\n  <meta name=\\\"description\\\" content=\\\"How we work: intake, assessment, collaborative plan, follow-ups, and optional educational lab reviews.\\\">\\n  <style>\\n    :root{--bg:#fbfff9;--card:#ffffff;--accent:#1e6b56;--soft:#eaf7f1;--muted:#5f706b}\\n    body{margin:0;font-family:Inter,system-ui,Arial;background:var(--bg);color:#12332a}\\n    .shell{max-width:1020px;margin:40px auto;padding:22px}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:14px}\\n    nav a.active{color:var(--accent)}\\n\\n    .intro{display:flex;gap:18px;align-items:center;margin-bottom:18px}\\n    .intro .text{flex:1}\\n    .intro h1{margin:0;color:var(--accent)}\\n    .intro p{margin:6px 0 0 0;color:var(--muted)}\\n\\n    .timeline{display:flex;gap:12px;align-items:flex-start;margin-top:18px}\\n    .step{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 10px 30px rgba(22,46,38,0.06);flex:1;border:1px solid rgba(22,46,38,0.04)}\\n    .step h3{margin:0 0 6px 0;color:#143f33}\\n    .step p{margin:0;color:var(--muted);font-size:14px}\\n\\n    .note{margin-top:18px;padding:14px;border-radius:10px;background:linear-gradient(90deg,#f4fffb,#fffefc);border:1px solid rgba(24,80,62,0.04);color:var(--muted)}\\n\\n    .graphic{margin-top:22px;height:120px;border-radius:14px;background:linear-gradient(90deg,#e6fbf3,#fbfff8);display:flex;align-items:center;justify-content:center;border:1px solid rgba(34,86,67,0.03)}\\n    .cta{display:inline-block;margin-top:12px;background:linear-gradient(90deg,var(--accent),#27876b);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    .pattern-approach{position:fixed;right:-90px;bottom:60px;opacity:0.6;width:420px;height:420px;transform:rotate(6deg)}\\n\\n    @media(max-width:880px){.timeline{flex-direction:column}.pattern-approach{display:none}}\\n  </style>\\n</head>\\n<body>\\n\\n  <svg class=\\\"pattern-approach\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g3\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#f2fff7\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#e9fff0\\\"/></linearGradient>\\n      <pattern id=\\\"p-approach\\\" width=\\\"50\\\" height=\\\"50\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"25\\\" height=\\\"25\\\" fill=\\\"#f8fff9\\\"/>\\n        <circle cx=\\\"38\\\" cy=\\\"12\\\" r=\\\"2\\\" fill=\\\"#d8f2e6\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"200\\\" height=\\\"200\\\" rx=\\\"20\\\" fill=\\\"url(#g3)\\\"/>\\n    <rect width=\\\"200\\\" height=\\\"200\\\" rx=\\\"20\\\" fill=\\\"url(#p-approach)\\\"/>\\n    <g fill=\\\"#bff0da\\\" opacity=\\\"0.9\\\">\\n      <circle cx=\\\"40\\\" cy=\\\"40\\\" r=\\\"18\\\"/>\\n      <rect x=\\\"110\\\" y=\\\"90\\\" width=\\\"60\\\" height=\\\"60\\\" rx=\\\"30\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"shell\\\">\\n    <header>\\n      <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"conditions.html\\\">Concerns</a>\\n        <a href=\\\"approach.html\\\" class=\\\"active\\\">Our Way</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"intro\\\">\\n      <div class=\\\"text\\\">\\n        <h1>Our care pathway: collaborative, educational, personalized</h1>\\n        <p>We use a structured yet flexible process: listening first, then assessing, learning together and adjusting as you progress. Options like labs are discussed as educational tools — not requirements.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule an intake</a>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"timeline\\\">\\n      <div class=\\\"step\\\">\\n        <h3>1. Intake & Listening</h3>\\n        <p>A focused first visit explores history, current symptoms, medications, lifestyle and priorities. Time is made for your story — this guides everything that follows.</p>\\n      </div>\\n\\n      <div class=\\\"step\\\">\\n        <h3>2. Comprehensive Assessment</h3>\\n        <p>Assessment includes targeted questions, review of recent records and optional non-invasive measures. Testing is considered when it meaningfully informs a plan.</p>\\n      </div>\\n\\n      <div class=\\\"step\\\">\\n        <h3>3. Collaborative Plan</h3>\\n        <p>Together we co-create a realistic plan: dietary steps, habits, therapeutic supports, and measurable goals. We discuss risks, alternatives and expected timelines.</p>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"timeline\\\" style=\\\"margin-top:12px\\\">\\n      <div class=\\\"step\\\">\\n        <h3>4. Follow-ups & Adaptation</h3>\\n        <p>Short follow-ups monitor progress, address barriers, and refine the plan. Our emphasis is on sustainable change and patient education.</p>\\n      </div>\\n      <div class=\\\"step\\\">\\n        <h3>5. Optional Labs & Tools</h3>\\n        <p>Labs or functional tests may be discussed as educational resources to clarify physiology. Any testing is optional and chosen with your informed consent.</p>\\n      </div>\\n      <div class=\\\"step\\\">\\n        <h3>6. Ongoing Self-Care Skills</h3>\\n        <p>We prioritize skills you can use daily: stress management, nutritional patterns, sleep hygiene, and pacing strategies to support long-term wellbeing.</p>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"graphic\\\">\\n      <svg width=\\\"90%\\\" height=\\\"90%\\\" viewBox=\\\"0 0 600 120\\\" aria-hidden xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n        <defs>\\n          <linearGradient id=\\\"lineg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#cdefe4\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#9fe7d2\\\"/></linearGradient>\\n        </defs>\\n        <rect x=\\\"16\\\" y=\\\"20\\\" width=\\\"568\\\" height=\\\"80\\\" rx=\\\"18\\\" fill=\\\"#f7fffb\\\" stroke=\\\"#e5f6ef\\\"/>\\n        <g fill=\\\"none\\\" stroke=\\\"url(#lineg)\\\" stroke-width=\\\"8\\\" stroke-linecap=\\\"round\\\">\\n          <path d=\\\"M40 60 C120 10, 240 110, 320 60 C400 10, 520 110, 560 60\\\"/>\\n        </g>\\n        <g fill=\\\"#1f6f5f\\\">\\n          <circle cx=\\\"40\\\" cy=\\\"60\\\" r=\\\"10\\\"/>\\n          <circle cx=\\\"320\\\" cy=\\\"60\\\" r=\\\"10\\\"/>\\n          <circle cx=\\\"560\\\" cy=\\\"60\\\" r=\\\"10\\\"/>\\n        </g>\\n      </svg>\\n    </div>\\n\\n    <div class=\\\"note\\\">\\n      Our approach emphasizes education, shared decision-making and safety. We do not promise cures — we aim to reduce symptom burden and support functional improvement through sustainable strategies.\\n    </div>\\n\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:18px\\\">\\n      <div style=\\\"color:var(--muted)\\\">Questions? Reach us at {{PHONE}} or <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start with an intake</a>\\n    </div>\\n\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
