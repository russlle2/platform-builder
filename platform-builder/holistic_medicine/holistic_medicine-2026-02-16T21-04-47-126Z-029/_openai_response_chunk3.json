          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Investment — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#f7fbf9;--accent:#6C63FF;--accent-2:#00C2A8;--muted:#6b7280;--card:#ffffff}\\n    html,body{height:100%;margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,\\\"Segoe UI\\\",Roboto,\\\"Helvetica Neue\\\",Arial; color:#0f172a;background:linear-gradient(180deg,var(--bg1),#eef7f7);}\\n    header{position:relative;z-index:10;padding:28px 40px;display:flex;align-items:center;justify-content:space-between}\\n    .logo{font-weight:700;color:var(--accent)}\\n    nav a{margin:0 10px;color:#0f172a;text-decoration:none;font-weight:600}\\n    nav a:hover{color:var(--accent)}\\n    .wrap{max-width:1100px;margin:30px auto;padding:36px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n\\n    /* Hero */\\n    .hero{background:linear-gradient(135deg,rgba(108,99,255,0.08),rgba(0,194,168,0.06));border-radius:18px;padding:36px;display:flex;gap:24px;align-items:center}\\n    .hero-left h1{margin:0 0 8px 0;font-size:28px;color:#061124}\\n    .hero-left p{margin:0;color:var(--muted)}\\n    .badge{display:inline-block;background:linear-gradient(90deg,var(--accent),var(--accent-2));color:white;padding:8px 12px;border-radius:999px;font-weight:700;margin-bottom:12px}\\n    .hero-cta{margin-top:16px}\\n    .btn{background:var(--accent);color:white;padding:12px 18px;border-radius:12px;text-decoration:none;font-weight:700}\\n    .muted{color:var(--muted);font-size:14px}\\n\\n    /* Pricing cards */\\n    .pricing-cards{display:flex;flex-direction:column;gap:16px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(12,18,30,0.06)}\\n    .card h3{margin:0 0 8px 0}\\n    .price{font-size:22px;font-weight:800;color:#051423}\\n    .list{margin:12px 0 0 0;padding:0 0 0 16px}\\n    .list li{margin:8px 0;list-style:disc;color:var(--muted)}\\n\\n    /* Sidebar */\\n    .aside .note{background:linear-gradient(180deg,#fff,#f8feff);padding:16px;border-radius:10px;border:1px solid rgba(4,16,23,0.03)}\\n    .small{font-size:13px;color:var(--muted)}\\n\\n    /* FAQ */\\n    .faq{margin-top:22px}\\n    .qa{background:linear-gradient(90deg,#ffffff,#fbffff);padding:14px;border-radius:10px;border:1px solid rgba(6,12,20,0.04);margin-bottom:10px}\\n\\n    footer{max-width:1100px;margin:40px auto;color:var(--muted);font-size:13px;padding:0 36px}\\n\\n    /* Decorative SVG */\\n    .pattern{position:fixed;right:-120px;top:-120px;opacity:0.12;width:520px;height:520px;z-index:0}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}.pattern{display:none}.wrap{padding:20px}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#6C63FF\\\" stop-opacity=\\\"0.6\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#00C2A8\\\" stop-opacity=\\\"0.6\\\"/>\\n      </linearGradient>\\n      <pattern id=\\\"p\\\" patternUnits=\\\"userSpaceOnUse\\\" width=\\\"20\\\" height=\\\"20\\\">\\n        <rect width=\\\"10\\\" height=\\\"10\\\" fill=\\\"url(#g)\\\" />\\n        <circle cx=\\\"15\\\" cy=\\\"15\\\" r=\\\"2\\\" fill=\\\"#fff\\\" fill-opacity=\\\"0.12\\\" />\\n      </pattern>\\n      <filter id=\\\"blur\\\"><feGaussianBlur stdDeviation=\\\"8\\\"/></filter>\\n    </defs>\\n    <rect width=\\\"200\\\" height=\\\"200\\\" fill=\\\"url(#p)\\\" filter=\\\"url(#blur)\\\" rx=\\\"18\\\" />\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">What We Offer</a>\\n      <a href=\\\"conditions.html\\\">Conditions</a>\\n      <a href=\\\"approach.html\\\">Our Method</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"about.html\\\">Who We Are</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <div class=\\\"grid\\\">\\n      <div>\\n        <section class=\\\"hero\\\">\\n          <div class=\\\"hero-left\\\">\\n            <span class=\\\"badge\\\">Intensive Program</span>\\n            <h1>Personalized plans, one intensive path to whole-health</h1>\\n            <p class=\\\"muted\\\">Short, focused partnerships with {{PRACTITIONER_NAME}} ({{CREDENTIALS}}) for people ready to dive deep. Education-forward. Root-cause oriented. No promises — just thoughtful, whole-person care.</p>\\n            <div class=\\\"hero-cta\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n          </div>\\n        </section>\\n\\n        <section style=\\\"margin-top:22px\\\">\\n          <h2>Packages for focused change</h2>\\n          <p class=\\\"small\\\">Choose an investment that fits your intensity and timeline. All programs include an educational intake and two follow-ups; optional labs are available as add-ons.</p>\\n\\n          <div class=\\\"pricing-cards\\\">\\n            <div class=\\\"card\\\">\\n              <h3>Sprint — 6 week intensive</h3>\\n              <div class=\\\"price\\\">$1,200</div>\\n              <ul class=\\\"list\\\">\\n                <li>90-minute initial integrative intake</li>\\n                <li>Two 45-minute follow-ups over six weeks</li>\\n                <li>Personalized lifestyle & nutrition guide</li>\\n                <li>Educational lab suggestions (optional)</li>\\n              </ul>\\n            </div>\\n\\n            <div class=\\\"card\\\">\\n              <h3>Deep Dive — 12 week program</h3>\\n              <div class=\\\"price\\\">$2,400</div>\\n              <ul class=\\\"list\\\">\\n                <li>120-minute comprehensive intake</li>\\n                <li>Four 45-minute follow-ups</li>\\n                <li>Care pathway + small journaling curriculum</li>\\n                <li>Discounted lab coordination</li>\\n              </ul>\\n            </div>\\n\\n            <div class=\\\"card\\\">\\n              <h3>Starter Consult — single session</h3>\\n              <div class=\\\"price\\\">$240</div>\\n              <ul class=\\\"list\\\">\\n                <li>60-minute focused visit</li>\\n                <li>Actionable recommendations & resources</li>\\n                <li>Good for one-off questions or planning next steps</li>\\n              </ul>\\n            </div>\\n          </div>\\n        </section>\\n\\n        <section class=\\\"faq\\\">\\n          <h3>Common questions</h3>\\n          <div class=\\\"qa\\\">\\n            <strong>Do you guarantee results?</strong>\\n            <div class=\\\"small\\\">No guarantees. We provide education, tools, and a personalized plan. Outcomes depend on many factors including adherence and underlying conditions.</div>\\n          </div>\\n          <div class=\\\"qa\\\">\\n            <strong>Are labs included?</strong>\\n            <div class=\\\"small\\\">Labs are educational and optional. We can recommend and coordinate testing; costs are separate and will be discussed during intake.</div>\\n          </div>\\n          <div class=\\\"qa\\\">\\n            <strong>Is insurance accepted?</strong>\\n            <div class=\\\"small\\\">We provide superbills for out-of-network reimbursement where applicable. Contact us at {{EMAIL}} for details.</div>\\n          </div>\\n        </section>\\n      </div>\\n\\n      <aside class=\\\"aside\\\">\\n        <div class=\\\"note\\\">\\n          <strong>Ready for an intensive plan?</strong>\\n          <p class=\\\"small\\\">An intensive is best for people ready to commit to focused change. It combines clinical evaluation with lifestyle, nutrition, and mind-body strategies.</p>\\n          <p style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Book an Intake</a></p>\\n        </div>\\n\\n        <div style=\\\"height:18px\\\"></div>\\n        <div class=\\\"note small\\\">\\n          <strong>Disclaimer</strong>\\n          <p>No guaranteed cures. Our approach is educational and whole-person oriented. If you have urgent medical issues, please seek emergency care or your primary clinician.</p>\\n        </div>\\n\\n        <div style=\\\"height:18px\\\"></div>\\n        <div class=\\\"note small\\\">\\n          <strong>Contact</strong>\\n          <p>{{PHONE}} • {{EMAIL}}</p>\\n          <p class=\\\"small\\\">Serving {{CITY}}, {{STATE}} — Telehealth options available.</p>\\n        </div>\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>&copy; <strong>{{BUSINESS_NAME}}</strong> — Holistic, integrative care. No guarantees, only thoughtful partnership.</div>\\n      <div class=\\\"small\\\">Made with care • {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffdfa;--primary:#ff6f91;--accent:#6C63FF;--muted:#556074}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:#0b1220;background:linear-gradient(180deg,var(--bg),#f4fbfb)}\\n    header{padding:20px 28px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{font-weight:800;color:var(--accent)}\\n    nav a{margin:0 8px;color:#0b1220;text-decoration:none;font-weight:600}\\n    .container{max-width:1000px;margin:28px auto;padding:28px}\\n\\n    .profile{display:grid;grid-template-columns:1fr 340px;gap:24px;align-items:start}\\n    .card{background:white;padding:20px;border-radius:14px;box-shadow:0 8px 20px rgba(6,12,20,0.04)}\\n\\n    .hero{padding:18px;border-radius:12px;background:linear-gradient(135deg,#fff,#fffdfd)}\\n    .hero h1{margin:0;color:#081126}\\n    .lead{color:var(--muted);margin-top:8px}\\n\\n    .pillars{display:flex;flex-direction:column;gap:12px;margin-top:16px}\\n    .pillar{display:flex;gap:12px;align-items:flex-start}\\n    .dot{width:44px;height:44px;border-radius:10px;background:linear-gradient(180deg,var(--primary),var(--accent));display:flex;align-items:center;justify-content:center;color:white;font-weight:800}\\n\\n    .myth{margin-top:18px}\\n    .myth .truth{background:linear-gradient(90deg,#fff,#fbffff);padding:12px;border-radius:10px;border:1px solid rgba(8,14,22,0.04)}\\n\\n    .cta{margin-top:20px;text-align:center}\\n    .btn{background:var(--accent);color:white;padding:12px 18px;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    .svg-blob{position:fixed;left:-120px;bottom:-120px;opacity:0.08;width:520px;height:520px}\\n    @media(max-width:880px){.profile{grid-template-columns:1fr}.svg-blob{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"svg-blob\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"a\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#FF6F91\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#6C63FF\\\"/></linearGradient>\\n      <pattern id=\\\"q\\\" width=\\\"24\\\" height=\\\"24\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"12\\\" height=\\\"12\\\" fill=\\\"#fff\\\" />\\n        <rect x=\\\"12\\\" y=\\\"12\\\" width=\\\"12\\\" height=\\\"12\\\" fill=\\\"#fff\\\" />\\n      </pattern>\\n    </defs>\\n    <g fill=\\\"url(#a)\\\">\\n      <path d=\\\"M45,-10C60,0 95,5 117,25C140,45 154,95 128,118C102,141 45,134 17,116C-11,98 -20,62 -13,36C-6,10 30,-20 45,-10Z\\\" transform=\\\"translate(80 80)\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"conditions.html\\\">Health Concerns</a>\\n      <a href=\\\"approach.html\\\">Approach</a>\\n      <a href=\\\"pricing.html\\\">Plans</a>\\n      <a href=\\\"about.html\\\">Team</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Talk</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"profile\\\">\\n      <div>\\n        <div class=\\\"hero card\\\">\\n          <h1>We combine curiosity with care</h1>\\n          <p class=\\\"lead\\\">At {{BUSINESS_NAME}}, we partner with you to explore the roots of symptoms and teach practical, sustainable tools. Our work is evidence-informed, integrative, and tailored to your life.</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h3>Our pillars</h3>\\n          <div class=\\\"pillars\\\">\\n            <div class=\\\"pillar\\\"><div class=\\\"dot\\\">M</div><div><strong>Mindful foundation</strong><div class=\\\"small\\\">Stress and sleep practices built into every plan.</div></div></div>\\n            <div class=\\\"pillar\\\"><div class=\\\"dot\\\">N</div><div><strong>Nourish & digest</strong><div class=\\\"small\\\">Food as education: small shifts that support digestion and energy.</div></div></div>\\n            <div class=\\\"pillar\\\"><div class=\\\"dot\\\">L</div><div><strong>Lifestyle architecture</strong><div class=\\\"small\\\">Movement, routines, and environmental tweaks to reduce inflammation and boost vitality.</div></div></div>\\n            <div class=\\\"pillar\\\"><div class=\\\"dot\\\">C</div><div><strong>Clinical curiosity</strong><div class=\\\"small\\\">Optional labs and collaborative care when clinically indicated.</div></div></div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card myth\\\">\\n          <h3>Myths we hear — and what’s truer</h3>\\n          <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px;\\\">\\n            <div style=\\\"padding:8px;border-radius:8px;background:#fff;\\\">\\\"Holistic means alternative.\\\"<div class=\\\"small\\\">Truth: It means integrative — we combine conventional knowledge with lifestyle, nutrition, and mind-body tools.</div></div>\\n            <div style=\\\"padding:8px;border-radius:8px;background:#fff;\\\">\\\"You’ll be cured quickly.\\\"<div class=\\\"small\\\">Truth: We aim for durable improvements through education and personalized plans; timelines vary.</div></div>\\n          </div>\\n          <div class=\\\"truth\\\" style=\\\"margin-top:12px\\\"><strong>Approach note:</strong> We focus on education and sustainable steps, not on one-off fixes.</div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h3>Sample case notes (anonymized & educational)</h3>\\n          <p class=\\\"small\\\">Case A — A person with chronic low energy: initial intake highlighted disrupted sleep, iron borderline low, and high daily stress. Plan emphasized sleep hygiene, targeted nutrition, gentle activity plan, and repeat labs in 8 weeks. Follow-ups focused on education and small habit folding.</p>\\n          <p class=\\\"small\\\">Case B — Digestive discomfort: workup prioritized food logs, micronutrient review, and nonpharmacologic strategies. Education reduced anxiety around symptoms and improved function over time.</p>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3>{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</h3>\\n          <p class=\\\"small\\\">Practitioner bio: A clinician blending training in conventional medicine with nutrition, behavioral strategies, and time-tested lifestyle approaches. Committed to teaching and shared decision-making.</p>\\n          <div style=\\\"margin-top:12px\\\"><strong>Practice focus</strong><div class=\\\"small\\\">Stress, sleep, digestion, inflammation, and energy optimization.</div></div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Schedule an Intro</a></div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4>Quick FAQs</h4>\\n          <div class=\\\"small\\\">We do not promise cures. Labs are educational. If you have urgent symptoms, seek immediate care.</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\" class=\\\"card\\\">\\n      <h3>Philosophy in a sentence</h3>\\n      <p class=\\\"small\\\">We teach you to be your own best clinician — you walk away with knowledge, practical tools, and a plan designed for your life and goals.</p>\\n      <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"contact.html\\\">Ask a question • {{EMAIL}}</a></div>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"max-width:1000px;margin:24px auto;padding:0 28px;color:var(--muted)\\\">\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>&copy; {{BUSINESS_NAME}} — Educational integrative care in {{CITY}}, {{STATE}}</div>\\n      <div class=\\\"small\\\">Call or text: {{PHONE}}</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Book a Session — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f6fcfb;--accent:#00C2A8;--ink:#07202b;--muted:#4b5563}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system,'Segoe UI',Roboto,Arial;color:var(--ink);background:linear-gradient(180deg,var(--bg),#fff)}\\n    header{padding:18px 28px;display:flex;align-items:center;justify-content:space-between}\\n    .logo{font-weight:800;color:var(--accent)}\\n    nav a{margin:0 8px;color:var(--ink);text-decoration:none;font-weight:600}\\n\\n    .wrap{max-width:960px;margin:28px auto;padding:18px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:20px}\\n    .card{background:white;padding:18px;border-radius:12px;box-shadow:0 8px 24px rgba(4,12,20,0.04)}\\n\\n    .step{display:flex;gap:12px;align-items:flex-start;margin-bottom:14px}\\n    .step .num{width:44px;height:44px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#6C63FF);color:white;display:flex;align-items:center;justify-content:center;font-weight:800}\\n    label{display:block;margin-top:8px;font-weight:700}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6eef0;margin-top:6px}\\n    .muted{color:var(--muted);font-size:13px}\\n    .btn{display:inline-block;background:var(--accent);color:white;padding:12px 18px;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    .pattern{position:fixed;left:40%;top:-80px;opacity:0.08;width:420px;height:420px}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"b\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#00C2A8\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#6C63FF\\\"/></linearGradient>\\n      <pattern id=\\\"r\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"20\\\" height=\\\"20\\\" fill=\\\"#fff\\\"/> \\n        <rect x=\\\"20\\\" y=\\\"20\\\" width=\\\"20\\\" height=\\\"20\\\" fill=\\\"#fff\\\"/>\\n      </pattern>\\n    </defs>\\n    <g fill=\\\"url(#b)\\\">\\n      <circle cx=\\\"100\\\" cy=\\\"100\\\" r=\\\"80\\\" />\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Back</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"approach.html\\\">Our Way</a>\\n      <a href=\\\"pricing.html\\\">Prices</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <div class=\\\"grid\\\">\\n      <div>\\n        <div class=\\\"card\\\">\\n          <h2>Reserve an intake or session</h2>\\n          <p class=\\\"muted\\\">Choose an option, tell us a bit about what brought you here, and pick a time. After booking, you'll receive a secure link for intake paperwork. If this is urgent, please call {{PHONE}}.</p>\\n\\n          <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" style=\\\"margin-top:12px\\\">\\n            <div class=\\\"step\\\">\\n              <div class=\\\"num\\\">1</div>\\n              <div style=\\\"flex:1\\\">\\n                <label for=\\\"type\\\">Session type</label>\\n                <select id=\\\"type\\\" name=\\\"type\\\">\\n                  <option>Intake — 90–120 min (recommended for intensives)</option>\\n                  <option>Follow-up — 45 min</option>\\n                  <option>Starter consult — 60 min</option>\\n                  <option>Telehealth check-in</option>\\n                </select>\\n              </div>\\n            </div>\\n\\n            <div class=\\\"step\\\">\\n              <div class=\\\"num\\\">2</div>\\n              <div style=\\\"flex:1\\\">\\n                <label for=\\\"name\\\">Your name</label>\\n                <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"First and last\\\" required />\\n                <label for=\\\"email\\\">Email</label>\\n                <input id=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"you@example.com\\\" required />\\n                <label for=\\\"phone\\\">Phone</label>\\n                <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"(555) 555‑5555\\\" />\\n              </div>\\n            </div>\\n\\n            <div class=\\\"step\\\">\\n              <div class=\\\"num\\\">3</div>\\n              <div style=\\\"flex:1\\\">\\n                <label for=\\\"concern\\\">Primary concern (brief)</label>\\n                <textarea id=\\\"concern\\\" name=\\\"concern\\\" rows=\\\"4\\\" placeholder=\\\"Stress, sleep, digestion, energy, etc.\\\"></textarea>\\n                <div class=\\\"muted\\\">Not a substitute for urgent care. If you have acute symptoms, please seek emergency services.</div>\\n              </div>\\n            </div>\\n\\n            <div style=\\\"margin-top:12px\\\">\\n              <button class=\\\"btn\\\" type=\\\"submit\\\">Book — {{PRIMARY_CTA_LABEL}}</button>\\n            </div>\\n            <input type=\\\"hidden\\\" name=\\\"source\\\" value=\\\"website-bookform\\\" />\\n          </form>\\n\\n        </div>\\n\\n        <div style=\\\"height:18px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h3>What to expect next</h3>\\n          <ol style=\\\"margin:0 0 0 18px\\\" class=\\\"muted\\\">\\n            <li>Confirmation email with paperwork link.</li>\\n            <li>Complete intake forms before the appointment to make time more productive.</li>\\n            <li>Intake includes a clinical review, lifestyle inventory, and an educational plan with next steps.</li>\\n          </ol>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4>Need help choosing?</h4>\\n          <p class=\\\"muted\\\">If you're unsure which option fits, choose 'Starter consult' and we'll help clarify an appropriate pathway during the session.</p>\\n          <p style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"contact.html\\\">Ask a question</a></p>\\n        </div>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h4>Important notes</h4>\\n          <p class=\\\"muted\\\">We do not promise cures. Our role is educational and supportive. Labs may be suggested when helpful; they are optional and billed separately.</p>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Payments & cancellations: Please review our policy in the confirmation email or contact {{EMAIL}}.</p>\\n        </div>\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <footer style=\\\"max-width:960px;margin:20px auto;padding:0 18px;color:var(--muted)\\\">\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div>Serving {{CITY}}, {{STATE}} • {{PHONE}}</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
