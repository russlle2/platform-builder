          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Services</title>\\n  <meta name=\\\"description\\\" content=\\\"Holistic care packages, bespoke plans, and integrative supports from {{PRACTITIONER_NAME}}.\\\">\\n  <style>\\n    :root{--bg:#f7fbf9;--card:#ffffff;--muted:#556;--accent:#6b9;--glass:rgba(255,255,255,0.6);--shadow:0 6px 20px rgba(48,60,72,0.08)}\\n    html,body{height:100%}\\n    body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;background:linear-gradient(180deg,#f2fbf8 0%,#ffffff 60%);color:#103;line-height:1.45}\\n    header{position:relative;padding:44px 28px 20px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;align-items:center;gap:14px}\\n    .logo{width:54px;height:54px;border-radius:12px;background:linear-gradient(135deg,#dff5ea,#e8fff3);display:grid;place-items:center;font-weight:700;color:#084}\\n    nav a{margin-left:18px;text-decoration:none;color:var(--muted);font-weight:600}\\n    nav a.cta{background:linear-gradient(90deg,#2a7  ,#49c);color:#fff;padding:10px 14px;border-radius:10px}\\n\\n    /* Decorative SVG backdrop */\\n    .hero-wrap{position:relative;overflow:hidden;padding:36px;border-radius:18px;margin:18px 28px;background:linear-gradient(180deg,rgba(250,255,250,0.9),rgba(255,255,255,0.6));box-shadow:var(--shadow)}\\n    .pattern-svg{position:absolute;inset:0;opacity:0.35;pointer-events:none}\\n    .hero{position:relative;display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:center}\\n    h1{font-size:28px;margin:0;color:#063}\\n    p.lead{margin:10px 0;color:#274;opacity:0.95}\\n\\n    .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:22px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:var(--shadow);border:1px solid rgba(6,40,28,0.04)}\\n    .kicker{font-size:12px;color:#4b6;padding:6px 10px;border-radius:999px;font-weight:700;display:inline-block}\\n    .price{font-weight:800;color:#063;font-size:18px}\\n\\n    footer{padding:28px;margin-top:28px;border-top:1px dashed rgba(6,40,28,0.06);display:flex;justify-content:space-between;align-items:center}\\n    .muted{color:#546;font-size:13px}\\n\\n    /* Misc */\\n    .cta-block{margin-top:12px}\\n    .btn{display:inline-block;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,#0a7,#39b);color:#fff;text-decoration:none;font-weight:700}\\n    .micro{font-size:13px;color:#345}\\n    details{margin-top:8px}\\n\\n    @media (max-width:820px){\\n      .hero{grid-template-columns:1fr;}\\n      nav a{display:none}\\n      nav a.mobile{display:inline-block}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"micro\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Begin</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"approach.html\\\">How I Work</a>\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero-wrap\\\">\\n      <svg class=\\\"pattern-svg\\\" viewBox=\\\"0 0 1200 400\\\" preserveAspectRatio=\\\"none\\\">\\n        <defs>\\n          <linearGradient id=\\\"gS1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#dff7ee\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#f1fff6\\\"/></linearGradient>\\n          <filter id=\\\"blur1\\\"><feGaussianBlur stdDeviation=\\\"30\\\"/></filter>\\n        </defs>\\n        <rect width=\\\"1200\\\" height=\\\"400\\\" fill=\\\"url(#gS1)\\\"/>\\n        <g filter=\\\"url(#blur1)\\\" fill=\\\"#b7eede\\\">\\n          <circle cx=\\\"180\\\" cy=\\\"80\\\" r=\\\"120\\\" opacity=\\\"0.32\\\"/>\\n          <circle cx=\\\"420\\\" cy=\\\"240\\\" r=\\\"180\\\" opacity=\\\"0.18\\\"/>\\n          <circle cx=\\\"980\\\" cy=\\\"120\\\" r=\\\"100\\\" opacity=\\\"0.12\\\"/>\\n        </g>\\n      </svg>\\n\\n      <div class=\\\"hero\\\">\\n        <div>\\n          <h1>Nurturing plans, not quick fixes.</h1>\\n          <p class=\\\"lead\\\">At {{BUSINESS_NAME}}, {{PRACTITIONER_NAME}} blends evidence-based integrative practices with lifestyle rituals to support whole-person resilience. Sessions are educational and collaborative — we don’t promise miracle cures, we map a path forward.</p>\\n\\n          <div class=\\\"cards\\\">\\n            <article class=\\\"card\\\">\\n              <div class=\\\"kicker\\\">Signature Ritual</div>\\n              <h3 style=\\\"margin:8px 0 6px\\\">Foundational Intake</h3>\\n              <p class=\\\"micro\\\">Two-hour deep-dive: history, goals, movement & sleep review, targeted inquiries. Creates the scaffold for your plan.</p>\\n              <div style=\\\"margin-top:10px\\\" class=\\\"price\\\">Initial: $260</div>\\n            </article>\\n\\n            <article class=\\\"card\\\">\\n              <div class=\\\"kicker\\\">Targeted Works</div>\\n              <h3 style=\\\"margin:8px 0 6px\\\">60-min Integrative Session</h3>\\n              <p class=\\\"micro\\\">Follow-ups, coaching, herbal & nutrition education, breath or movement prescriptions tailored to your needs.</p>\\n              <div style=\\\"margin-top:10px\\\" class=\\\"price\\\">Follow-up: $120</div>\\n            </article>\\n\\n            <article class=\\\"card\\\">\\n              <div class=\\\"kicker\\\">Intensive</div>\\n              <h3 style=\\\"margin:8px 0 6px\\\">3-Session Intensive</h3>\\n              <p class=\\\"micro\\\">Compact learning loop: intake, action plan, and refinement call across 6 weeks.</p>\\n              <div style=\\\"margin-top:10px\\\" class=\\\"price\\\">Bundle: $340</div>\\n            </article>\\n          </div>\\n        </div>\\n\\n        <aside style=\\\"padding:18px;background:var(--glass);border-radius:12px;box-shadow:var(--shadow);align-self:start\\\">\\n          <div style=\\\"font-size:13px;color:#163;font-weight:700\\\">Quick Availability</div>\\n          <div style=\\\"margin-top:8px\\\" class=\\\"micro\\\">Intake windows typically fill weekly. Evening slots limited.</div>\\n          <div class=\\\"cta-block\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a Session</a></div>\\n          <div style=\\\"margin-top:10px;font-size:12px;color:#476\\\">Questions? Call <strong>{{PHONE}}</strong> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        </aside>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"padding:28px;margin:18px;border-radius:12px;background:rgba(255,255,255,0.7);box-shadow:var(--shadow)\\\">\\n      <h2 style=\\\"margin-top:0\\\">What you can expect from sessions</h2>\\n      <p class=\\\"micro\\\">Sessions balance practical education with actionable practices: simple movement, breath tools, thoughtful diet adjustments, and investigative conversations. Each plan is bespoke and focuses on sustainable shifts.</p>\\n\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Assessment & History</strong>\\n          <p class=\\\"micro\\\">Understanding the full context of sleep, digestion, stress, and energy patterns.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Personalized Plan</strong>\\n          <p class=\\\"micro\\\">Small daily rituals, prioritized goals, and optional lab discussions to inform choices.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Tools & Education</strong>\\n          <p class=\\\"micro\\\">Herbal supports, nutrition guidance, breathwork, and movement that you can integrate at home.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Follow-through</strong>\\n          <p class=\\\"micro\\\">Check-ins, resource notes, and milestone revisions — we aim for clarity, not overwhelm.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin:18px;padding:18px;border-radius:12px;background:#fff;border:1px solid rgba(6,40,28,0.03)\\\">\\n      <h2 style=\\\"margin-top:0\\\">Scheduling & payments</h2>\\n      <p class=\\\"micro\\\">Sessions are available in-person in {{CITY}}, {{STATE}} and virtually. Payment via card; packages pre-pay for a modest savings.</p>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-wrap:wrap\\\">\\n        <div style=\\\"padding:12px;border-radius:10px;background:linear-gradient(180deg,#fbfdfb,#fff);box-shadow:var(--shadow);min-width:200px\\\">\\n          <div style=\\\"font-weight:700\\\">Intake (120–150m)</div>\\n          <div class=\\\"micro\\\">$260 — includes follow-up notes and home plan.</div>\\n        </div>\\n        <div style=\\\"padding:12px;border-radius:10px;background:linear-gradient(180deg,#fbfdfb,#fff);box-shadow:var(--shadow);min-width:200px\\\">\\n          <div style=\\\"font-weight:700\\\">Follow-up (60m)</div>\\n          <div class=\\\"micro\\\">$120 — ongoing plan refinement.</div>\\n        </div>\\n        <div style=\\\"padding:12px;border-radius:10px;background:linear-gradient(180deg,#fbfdfb,#fff);box-shadow:var(--shadow);min-width:200px\\\">\\n          <div style=\\\"font-weight:700\\\">Lab Review</div>\\n          <div class=\\\"micro\\\">$90 — educational review of optional results.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin:18px;padding:18px;border-radius:12px;background:linear-gradient(180deg,#fff,#fbfffb);\\\">\\n      <h2 style=\\\"margin-top:0\\\">FAQ</h2>\\n      <details>\\n        <summary style=\\\"cursor:pointer\\\">Do you provide prescriptions or medical diagnoses?</summary>\\n        <p class=\\\"micro\\\">This practice provides integrative education and lifestyle guidance. We do not replace urgent medical care or provide controlled prescriptions. For acute or emergent care please contact your medical provider or emergency services.</p>\\n      </details>\\n      <details>\\n        <summary style=\\\"cursor:pointer\\\">Are labs required?</summary>\\n        <p class=\\\"micro\\\">Labs are optional tools. When helpful, we discuss what they might clarify; ordering is collaborative and educational.</p>\\n      </details>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"muted\\\">© {{BUSINESS_NAME}} — {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n    <div><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule Now</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Common Concerns</title>\\n  <meta name=\\\"description\\\" content=\\\"Typical areas where integrative care can support resilience: sleep, digestion, stress, inflammation, and energy.\\\"/>\\n  <style>\\n    :root{--bg:#fffdf9;--card:#ffffff;--accent:#7aa;--muted:#334}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;color:#142;background:linear-gradient(180deg,#fffdf9,#fbfefc);}\\n    header{padding:26px 20px;display:flex;justify-content:space-between;align-items:center}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,#eafbf1,#f6fffb);display:grid;place-items:center;color:#0a6;font-weight:800}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none;font-weight:600}\\n\\n    .wrap{max-width:980px;margin:10px auto;padding:18px}\\n    .hero{padding:22px;border-radius:14px;background:linear-gradient(180deg,#f9fffb,#ffffff);box-shadow:0 8px 26px rgba(8,42,32,0.05)}\\n    h1{margin:0;color:#073;font-size:26px}\\n    p.lead{margin-top:8px;color:#254}\\n\\n    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px;margin-top:16px}\\n    .issue{background:#fff;border-radius:12px;padding:14px;border:1px solid rgba(6,40,28,0.04)}\\n    .issue h3{margin:0 0 6px}\\n    .note{font-size:13px;color:#476}\\n\\n    .disclaimer{margin-top:14px;font-size:13px;color:#335}\\n\\n    .cta{margin-top:18px}\\n    .btn{background:linear-gradient(90deg,#2c9,#3ab);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    /* SVG accent */\\n    .accent-svg{width:100%;height:110px;margin-top:12px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:#4a6\\\">Holistic & thoughtful care</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"conditions.html\\\">This Page</a>\\n      <a href=\\\"approach.html\\\">Process</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <h1>Common areas people bring in</h1>\\n      <p class=\\\"lead\\\">The list below highlights typical concerns we explore together. Each item is handled with respectful curiosity and practical steps — not promises of cure.</p>\\n      <svg class=\\\"accent-svg\\\" viewBox=\\\"0 0 600 110\\\" preserveAspectRatio=\\\"none\\\">\\n        <defs>\\n          <linearGradient id=\\\"c1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#e8f9f0\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#f8fff9\\\"/></linearGradient>\\n        </defs>\\n        <rect width=\\\"600\\\" height=\\\"110\\\" fill=\\\"url(#c1)\\\"/>\\n        <g fill=\\\"#c8eedf\\\" opacity=\\\"0.6\\\">\\n          <ellipse cx=\\\"80\\\" cy=\\\"40\\\" rx=\\\"60\\\" ry=\\\"30\\\"/>\\n          <ellipse cx=\\\"240\\\" cy=\\\"70\\\" rx=\\\"120\\\" ry=\\\"38\\\"/>\\n          <ellipse cx=\\\"480\\\" cy=\\\"50\\\" rx=\\\"90\\\" ry=\\\"45\\\"/>\\n        </g>\\n      </svg>\\n    </section>\\n\\n    <section style=\\\"margin-top:16px\\\">\\n      <div class=\\\"grid\\\">\\n        <article class=\\\"issue\\\">\\n          <h3>Chronic stress & overwhelm</h3>\\n          <p class=\\\"note\\\">Tools include pacing plans, breathwork, and behavioral experiments to support down-regulation. Sessions emphasize skills and small habit changes rather than one-off fixes.</p>\\n        </article>\\n\\n        <article class=\\\"issue\\\">\\n          <h3>Sleep difficulties</h3>\\n          <p class=\\\"note\\\">We look at circadian cues, evening rituals, stimulants, and movement patterns. Interventions are educational and personalized.</p>\\n        </article>\\n\\n        <article class=\\\"issue\\\">\\n          <h3>Digestive discomfort</h3>\\n          <p class=\\\"note\\\">Dietary patterns, mindful eating, and gentle herbal or nutritional suggestions may be discussed. Labs can be helpful but are not always necessary.</p>\\n        </article>\\n\\n        <article class=\\\"issue\\\">\\n          <h3>Low energy & fatigue</h3>\\n          <p class=\\\"note\\\">Energy is multifactorial — we review sleep, movement, stress load, and nourishment, and create a stepwise plan to rebuild reserves.</p>\\n        </article>\\n\\n        <article class=\\\"issue\\\">\\n          <h3>Chronic inflammation & pain</h3>\\n          <p class=\\\"note\\\">Approaches may include movement adjustments, anti-inflammatory nutrition principles, and supportive therapies. This is educational care and coordination with medical teams is welcomed.</p>\\n        </article>\\n      </div>\\n\\n      <div class=\\\"disclaimer\\\">\\n        Important: This practice focuses on whole-person support and education. We do not promise cures or replace medical treatment. If you have urgent symptoms, severe pain, or sudden changes in health, seek immediate medical attention.\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px;padding:12px;border-radius:12px;background:#fff;box-shadow:0 6px 20px rgba(6,40,28,0.04)\\\">\\n      <h2 style=\\\"margin-top:0\\\">How I typically help</h2>\\n      <p class=\\\"note\\\">A typical path: listen deeply, co-create a simple set of daily practices, and check in to refine. Optional labs and referrals are considered when they add clarity.</p>\\n      <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start a Conversation</a></div>\\n    </section>\\n  </main>\\n\\n  <footer style=\\\"padding:20px;text-align:center;color:#456\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}} • {{BUSINESS_NAME}}</footer>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Approach — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Our intake, planning, follow-ups, and optional labs — an educational, whole-person process.\\\">\\n  <style>\\n    :root{--bg:#fbfdff;--accent:#5aa;--muted:#244}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#fbfdff,#f8fffb);color:#042}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:50px;height:50px;border-radius:10px;background:linear-gradient(135deg,#eaf8f4,#f3fff9);display:grid;place-items:center;font-weight:800;color:#078}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n\\n    .container{max-width:980px;margin:10px auto;padding:18px}\\n    .intro{display:flex;gap:18px;align-items:flex-start}\\n    .intro .col{flex:1}\\n    h1{margin:0;font-size:26px}\\n    .tag{color:#456}\\n\\n    .timeline{margin-top:18px;border-left:2px dashed rgba(6,40,28,0.05);padding-left:18px}\\n    .step{margin-bottom:18px}\\n    .step h3{margin:0 0 6px}\\n    .mini{font-size:13px;color:#365}\\n\\n    .labs{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px}\\n    .lab{background:#fff;padding:12px;border-radius:10px;box-shadow:0 6px 18px rgba(6,40,28,0.04);min-width:220px}\\n\\n    .faq{margin-top:18px}\\n    .btn{background:linear-gradient(90deg,#36a,#39c);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    /* subtle SVG curve */\\n    .hero-curve{width:100%;height:120px}\\n    @media (max-width:720px){.intro{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n        <div class=\\\"tag\\\">Integrative, curious, practical</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section>\\n      <svg class=\\\"hero-curve\\\" viewBox=\\\"0 0 1200 120\\\" preserveAspectRatio=\\\"none\\\">\\n        <defs>\\n          <linearGradient id=\\\"ag\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#e9fbf6\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#f6fff9\\\"/></linearGradient>\\n        </defs>\\n        <rect width=\\\"1200\\\" height=\\\"120\\\" fill=\\\"url(#ag)\\\"/>\\n        <path d=\\\"M0 80 C200 10 400 150 600 80 C800 10 1000 140 1200 80 L1200 120 L0 120 Z\\\" fill=\\\"#dff7ee\\\" opacity=\\\"0.7\\\"/>\\n      </svg>\\n      <div class=\\\"intro\\\">\\n        <div class=\\\"col\\\">\\n          <h1>My approach: scaffolded, science-forward, person-first</h1>\\n          <p class=\\\"mini\\\">I blend research-aligned tools with lifestyle medicine and mindful rituals. The process is educational: we learn what works for you and build simple practices that fit your life.</p>\\n        </div>\\n        <aside style=\\\"width:260px;background:#fff;border-radius:12px;padding:14px;box-shadow:0 6px 20px rgba(6,40,28,0.04)\\\">\\n          <div style=\\\"font-weight:800\\\">Quick framework</div>\\n          <div style=\\\"margin-top:8px;font-size:13px;color:#375\\\">Intake → Tailored Plan → Follow-ups → Ongoing refinement</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Begin intake</a></div>\\n        </aside>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"timeline\\\">\\n      <div class=\\\"step\\\">\\n        <h3>Intake & story-gathering</h3>\\n        <p class=\\\"mini\\\">We start with a generous intake: history, symptoms, routines, relationships with food, movement, and sleep. This is a partnership — you bring the context, I bring frameworks and curiosity. Typical intake length: 90–150 minutes depending on needs.</p>\\n      </div>\\n\\n      <div class=\\\"step\\\">\\n        <h3>Co-created plan</h3>\\n        <p class=\\\"mini\\\">Plans focus on a few high-leverage changes: 1–3 practical rituals (sleep cues, micro-movements, breath practice), clear nutrition or herbal education when relevant, and measurable, time-bound goals. Plans are intentionally small to encourage adherence.</p>\\n      </div>\\n\\n      <div class=\\\"step\\\">\\n        <h3>Follow-ups & iteration</h3>\\n        <p class=\\\"mini\\\">Follow-up sessions refine interventions, troubleshoot barriers, and teach small skills. These check-ins are tools for learning, not judgement. Frequency depends on your needs: weekly, biweekly, or monthly.</p>\\n      </div>\\n\\n      <div class=\\\"step\\\">\\n        <h3>Optional labs (educational)</h3>\\n        <p class=\\\"mini\\\">When labs can add clarity (e.g., basic metabolic markers, targeted nutrient panels, or sleep assessments), we discuss what to test, what the results might mean, and how they might shift the plan. Ordering or interpreting labs is always collaborative and framed as educational information, not definitive cures.</p>\\n        <div class=\\\"labs\\\">\\n          <div class=\\\"lab\\\">\\n            <strong>When labs help</strong>\\n            <div class=\\\"mini\\\">Unexplained fatigue, metabolic concerns, persistent gut issues.</div>\\n          </div>\\n          <div class=\\\"lab\\\">\\n            <strong>When labs may not be needed</strong>\\n            <div class=\\\"mini\\\">Mild, recent symptoms that respond to simple habit changes.</div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin-top:0\\\">A note on safety & coordination</h2>\\n      <p class=\\\"mini\\\">If you are under medical care, we welcome coordination. Integrative work complements ongoing medical treatment; we do not replace urgent or emergency care. Any herbal or supplemental recommendations are discussed with attention to interactions and safety.</p>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h2 style=\\\"margin-top:0\\\">Common questions</h2>\\n      <details>\\n        <summary style=\\\"cursor:pointer\\\">How many sessions will I need?</summary>\\n        <p class=\\\"mini\\\">It varies. Some people see meaningful shifts in a few visits; others benefit from ongoing coaching. We review progress and adjust timelines together.</p>\\n      </details>\\n      <details>\\n        <summary style=\\\"cursor:pointer\\\">Do you prescribe medication?</summary>\\n        <p class=\\\"mini\\\">No — this practice offers education and integrative strategies. For prescription needs, we coordinate with your medical provider as appropriate.</p>\\n      </details>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px;background:#fff;padding:14px;border-radius:12px;box-shadow:0 6px 20px rgba(6,40,28,0.04)\\\">\\n      <h3 style=\\\"margin-top:0\\\">Ready to begin?</h3>\\n      <p class=\\\"mini\\\">If you’re curious about a thoughtful, evidence-informed route to better daily function, let’s talk. Book an intake or send a question via email.</p>\\n      <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Request an Intake</a> <span style=\\\"margin-left:12px;color:#456\\\">or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></span></div>\\n    </section>\\n  </main>\\n\\n  <footer style=\\\"padding:20px;text-align:center;color:#456\\\">{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
