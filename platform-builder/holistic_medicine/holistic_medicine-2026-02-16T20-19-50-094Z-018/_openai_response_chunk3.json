          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Plans — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f6fff6;--accent:#3b7d5a;--muted:#6b7280;--card:#ffffff;--glass:rgba(255,255,255,0.6)}\\n    *{box-sizing:border-box}\\n    html,body{height:100%}\\n    body{margin:0;font-family:Inter,system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; background:linear-gradient(160deg,#fbfff8 0%,#f4fff7 60%);color:#0f172a}\\n    .wrap{min-height:100vh;display:flex;flex-direction:column}\\n    header{position:relative;padding:28px 36px;display:flex;align-items:center;justify-content:space-between}\\n    .logo{display:flex;flex-direction:column}\\n    .logo .name{font-weight:700;color:var(--accent)}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600}\\n\\n    /* diagonal hero */\\n    .hero{position:relative;overflow:hidden;display:grid;grid-template-columns:1fr 520px;align-items:center;gap:40px;padding:60px 36px}\\n    .hero:before{content:\\\"\\\";position:absolute;left:-10%;top:40%;width:120%;height:60%;background:linear-gradient(135deg,rgba(59,125,90,0.08),rgba(59,125,90,0.02));transform:skewY(-6deg);filter:blur(12px);z-index:0}\\n    .hero .copy{position:relative;z-index:1}\\n    h1{margin:0 0 10px;font-size:36px}\\n    p.lead{margin:0;color:var(--muted);max-width:48ch}\\n\\n    .card{background:var(--card);border-radius:14px;padding:22px;box-shadow:0 8px 30px rgba(18,38,27,0.06);}\\n\\n    .plans{display:flex;flex-direction:column;gap:18px}\\n    .plan{display:flex;justify-content:space-between;align-items:center;padding:18px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.6),rgba(255,255,255,0.85));border:1px solid rgba(10,10,10,0.03)}\\n    .plan .meta{max-width:60%}\\n    .price{font-weight:800;color:var(--accent);font-size:20px}\\n\\n    .ribbon{display:inline-block;background:linear-gradient(90deg,#ffd7a8,#ffd0c7);padding:6px 10px;border-radius:999px;font-weight:700;color:#3b2b00;margin-right:10px}\\n\\n    section.small{padding:36px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\\n    .benefit{background:linear-gradient(180deg,#ffffff,#fbfff8);padding:18px;border-radius:10px}\\n\\n    footer{margin-top:auto;padding:28px 36px;color:var(--muted);font-size:14px}\\n\\n    /* SVG motif */\\n    .pattern{position:fixed;right:-10%;top:-10%;width:680px;height:680px;opacity:0.08;pointer-events:none}\\n\\n    /* responsive */\\n    @media(max-width:920px){\\n      .hero{grid-template-columns:1fr;padding:36px}\\n      .pattern{display:none}\\n      .grid{grid-template-columns:1fr}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"logo\\\">\\n        <div class=\\\"name\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"muted\\\" style=\\\"font-size:12px;color:var(--muted)\\\">Holistic care with modern clarity</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Treatments</a>\\n        <a href=\\\"about.html\\\">Meet</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <div class=\\\"hero\\\">\\n        <div class=\\\"copy\\\">\\n          <div class=\\\"card\\\">\\n            <span class=\\\"ribbon\\\">Intensive Offer</span>\\n            <h1>Tiered plans for concentrated healing</h1>\\n            <p class=\\\"lead\\\">Choose an approach that matches your life rhythm — multi-session intensive packages for focused change, designed around whole-person assessment and educational guidance. No promises of cures: we focus on understanding, incremental progress, and evidence-informed options.</p>\\n          </div>\\n\\n          <section class=\\\"small\\\" style=\\\"margin-top:18px\\\">\\n            <h3 style=\\\"margin:0 0 10px\\\">What you get</h3>\\n            <div class=\\\"grid\\\">\\n              <div class=\\\"benefit\\\">Personalized treatment mapping: integrative plan blending lifestyle, botanicals, mind-body practices.</div>\\n              <div class=\\\"benefit\\\">Priority scheduling + deeper session time for active implementation.</div>\\n              <div class=\\\"benefit\\\">Educational materials and optional guided labs to track physiology.</div>\\n            </div>\\n          </section>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"position:relative;z-index:1\\\">\\n          <h3 style=\\\"margin-top:0\\\">Packages</h3>\\n          <div class=\\\"plans\\\">\\n            <div class=\\\"plan\\\">\\n              <div class=\\\"meta\\\">\\n                <div style=\\\"font-weight:700\\\">Foundation Intensive — 3 sessions</div>\\n                <div style=\\\"color:var(--muted);font-size:13px\\\">Intake + two focused follow-ups over 8 weeks</div>\\n              </div>\\n              <div class=\\\"price\\\">$950</div>\\n            </div>\\n\\n            <div class=\\\"plan\\\">\\n              <div class=\\\"meta\\\">\\n                <div style=\\\"font-weight:700\\\">Deep Reset — 6 sessions</div>\\n                <div style=\\\"color:var(--muted);font-size:13px\\\">Comprehensive plan, optional labs, priority messaging</div>\\n              </div>\\n              <div class=\\\"price\\\">$1,800</div>\\n            </div>\\n\\n            <div class=\\\"plan\\\" style=\\\"border:2px solid rgba(59,125,90,0.12);background:linear-gradient(180deg,#fffefb,#f7fff6)\\\">\\n              <div class=\\\"meta\\\">\\n                <div style=\\\"font-weight:800\\\">Immersive Course — 12 sessions</div>\\n                <div style=\\\"color:var(--muted);font-size:13px\\\">Best for complex, chronic patterns — includes extended coaching and education.</div>\\n              </div>\\n              <div class=\\\"price\\\">$3,400</div>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:18px;display:flex;gap:10px;align-items:center\\\">\\n            <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700\\\">{{PRIMARY_CTA_LABEL}}</a>\\n            <a href=\\\"contact.html\\\" style=\\\"color:var(--muted);text-decoration:none;font-weight:700\\\">Ask about scholarships</a>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <section class=\\\"small card\\\" style=\\\"margin:22px 36px;border-radius:16px\\\">\\n        <h3 style=\\\"margin-top:0\\\">How we structure intensive work</h3>\\n        <ol style=\\\"color:var(--muted)\\\">\\n          <li>Intake consultation (90 minutes): whole-person history and priorities.</li>\\n          <li>Collaborative plan: practical steps, interventions, and education.</li>\\n          <li>Scheduled follow-ups: monitoring, adjustments, and skill-building.</li>\\n          <li>Optional labs explained: used only as tools to inform decisions, never required.</li>\\n        </ol>\\n      </section>\\n\\n      <section class=\\\"small\\\" style=\\\"margin:22px 36px\\\">\\n        <h3>Frequently asked</h3>\\n        <div class=\\\"card\\\" style=\\\"padding:18px\\\">\\n          <strong>Do you guarantee results?</strong>\\n          <p style=\\\"margin:6px 0;color:var(--muted)\\\">No guarantees. Our goal is to educate and support sustainable changes. Outcomes vary by individual factors.</p>\\n\\n          <strong>Are labs required?</strong>\\n          <p style=\\\"margin:6px 0;color:var(--muted)\\\">Labs are optional and used when they add clarity. We discuss benefits and limits before recommending them.</p>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"small\\\" style=\\\"margin:22px 36px;display:flex;justify-content:space-between;align-items:center;gap:18px\\\">\\n        <div>\\n          <h3 style=\\\"margin:0\\\">Ready to begin the intensive?</h3>\\n          <p style=\\\"margin:6px 0;color:var(--muted)\\\">Book an intake to explore the right tier for your needs.</p>\\n        </div>\\n        <div>\\n          <a href=\\\"book.html\\\" style=\\\"background:linear-gradient(90deg,var(--accent),#2b6b48);color:#fff;padding:12px 18px;border-radius:12px;text-decoration:none;font-weight:800\\\">Reserve intake</a>\\n        </div>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n        <div style=\\\"color:var(--muted)\\\">Phone: {{PHONE}}</div>\\n      </div>\\n    </footer>\\n\\n    <!-- decorative SVG pattern -->\\n    <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#9de3c6\\\" stop-opacity=\\\"0.9\\\"/>\\n          <stop offset=\\\"1\\\" stop-color=\\\"#d6f7ea\\\" stop-opacity=\\\"0.7\\\"/>\\n        </linearGradient>\\n        <pattern id=\\\"p1\\\" width=\\\"20\\\" height=\\\"20\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(18)\\\">\\n          <rect width=\\\"6\\\" height=\\\"6\\\" fill=\\\"url(#g1)\\\"/>\\n        </pattern>\\n      </defs>\\n      <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\"/>\\n    </svg>\\n\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffdf9;--accent:#1f6b4b;--muted:#5b6b63}\\n    body{margin:0;font-family:Inter,system-ui, -apple-system, 'Segoe UI', Roboto, Arial;background:linear-gradient(180deg,#ffffff,#fbfff9);color:#092018}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:22px 28px}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n\\n    .hero{padding:44px 28px;display:flex;gap:28px;align-items:center}\\n    .hero .left{flex:1}\\n    .hero .right{width:320px}\\n    h1{margin:0;font-size:32px}\\n    .tag{color:var(--muted);margin-top:8px}\\n\\n    .split{display:grid;grid-template-columns:1fr 340px;gap:22px;padding:0 28px}\\n    .pane{background:linear-gradient(180deg,#fff,#fcfff8);padding:18px;border-radius:12px;box-shadow:0 6px 20px rgba(7,22,16,0.04)}\\n\\n    .bio{line-height:1.6;color:var(--muted)}\\n    .cta{display:flex;gap:12px;margin-top:14px}\\n    .cta a{padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .cta .primary{background:var(--accent);color:#fff}\\n    .cta .ghost{background:transparent;border:2px solid rgba(31,107,75,0.08);color:var(--accent)}\\n\\n    .credential{background:linear-gradient(90deg,#f7fff8,#ffffff);padding:10px;border-radius:8px;margin-top:12px}\\n\\n    footer{padding:22px 28px;color:var(--muted);font-size:13px}\\n\\n    /* decorative diagonal accent */\\n    .diag{position:absolute;left:0;top:20%;width:60%;height:40%;background:linear-gradient(120deg,rgba(31,107,75,0.06),rgba(31,107,75,0.01));transform:skewY(-6deg);filter:blur(8px);z-index:-1}\\n\\n    @media(max-width:860px){.split{grid-template-columns:1fr}.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <div style=\\\"position:relative;overflow:hidden\\\">\\n    <div class=\\\"diag\\\" aria-hidden></div>\\n    <header>\\n      <div style=\\\"font-weight:800;color:var(--accent)\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Overview</a>\\n        <a href=\\\"approach.html\\\">Our Way</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"left\\\">\\n        <h1>Where curiosity meets care</h1>\\n        <div class=\\\"tag\\\">A whole-person practice blending evidence, tradition, and contemporary lifestyle medicine.</div>\\n        <div style=\\\"margin-top:16px\\\" class=\\\"pane credential\\\">\\n          <strong>{{PRACTITIONER_NAME}}</strong>, <span style=\\\"color:var(--muted)\\\">{{CREDENTIALS}}</span>\\n          <p class=\\\"bio\\\" style=\\\"margin-top:8px\\\">I joined {{BUSINESS_NAME}} to offer approachable, deeply educational care for people who want to understand their patterns and change them with clarity. Appointments are collaborative — we map physiology, environment, and habits to realistic steps.</p>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"right\\\">\\n        <div class=\\\"pane\\\" style=\\\"text-align:center\\\">\\n          <div style=\\\"font-weight:800;font-size:18px\\\">Practice philosophy</div>\\n          <p style=\\\"color:var(--muted);margin-top:8px\\\">We prioritize safety, transparency, and patient education. Interventions are chosen for individual context; labs are options when they inform care.</p>\\n          <div class=\\\"cta\\\">\\n            <a class=\\\"primary\\\" href=\\\"book.html\\\">Book an intake</a>\\n            <a class=\\\"ghost\\\" href=\\\"contact.html\\\">Message us</a>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"padding:22px 28px\\\">\\n      <div class=\\\"split\\\">\\n        <div class=\\\"pane\\\">\\n          <h3 style=\\\"margin-top:0\\\">Background & training</h3>\\n          <p class=\\\"bio\\\">{{PRACTITIONER_NAME}} trained across conventional and integrative settings, focusing on chronic stress, sleep, digestion, and energy regulation. The approach centers on education: we explain why things may be happening and co-create practical next steps. Results are individualized; we never promise cures.</p>\\n\\n          <h4 style=\\\"margin-top:16px\\\">Community commitments</h4>\\n          <ul style=\\\"color:var(--muted)\\\">\\n            <li>Accessible education materials for every client</li>\\n            <li>Bespoke plans that consider work, family, and finances</li>\\n            <li>Transparent discussion about risks, benefits, and limits of treatments</li>\\n          </ul>\\n        </div>\\n\\n        <aside class=\\\"pane\\\">\\n          <h4 style=\\\"margin-top:0\\\">Quick facts</h4>\\n          <div style=\\\"color:var(--muted)\\\">\\n            <p style=\\\"margin:6px 0\\\"><strong>Location:</strong> {{CITY}}, {{STATE}}</p>\\n            <p style=\\\"margin:6px 0\\\"><strong>Email:</strong> <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></p>\\n            <p style=\\\"margin:6px 0\\\"><strong>Phone:</strong> {{PHONE}}</p>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <h5 style=\\\"margin:6px 0\\\">Values</h5>\\n            <ul style=\\\"color:var(--muted)\\\">\\n              <li>Curiosity</li>\\n              <li>Transparency</li>\\n              <li>Sustainable change</li>\\n            </ul>\\n          </div>\\n        </aside>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"padding:0 28px 28px\\\">\\n      <div class=\\\"pane\\\" style=\\\"display:flex;gap:16px;align-items:center\\\">\\n        <div style=\\\"flex:1\\\">\\n          <h4 style=\\\"margin:0\\\">Want an intro packet?</h4>\\n          <p style=\\\"margin:8px 0;color:var(--muted)\\\">Get a short guide on our intake process and what to expect from an initial visit.</p>\\n        </div>\\n        <div>\\n          <a href=\\\"lead-magnet.pdf\\\" style=\\\"background:linear-gradient(90deg,#bdeed1,#dff9ee);padding:10px 14px;border-radius:10px;text-decoration:none;color:#044a2e;font-weight:800\\\">Send me the packet</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div style=\\\"color:var(--muted)\\\">© {{BUSINESS_NAME}}</div>\\n        <div style=\\\"color:var(--muted)\\\">Licensed care in {{STATE}}</div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfff8;--accent:#2b7b55;--muted:#626f63}\\n    body{margin:0;font-family:Inter,system-ui, -apple-system, 'Segoe UI', Roboto, Arial;background:linear-gradient(160deg,#ffffff,#f6fff6);color:#092018}\\n    header{padding:16px 22px;display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n\\n    .wrap{max-width:980px;margin:28px auto;padding:18px}\\n    .hero{background:linear-gradient(180deg,#fff,#f7fff6);padding:18px;border-radius:14px;display:flex;align-items:center;gap:18px}\\n    .hero h2{margin:0}\\n    .note{color:var(--muted);font-size:14px}\\n\\n    .columns{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    .card{background:#fff;padding:16px;border-radius:12px;box-shadow:0 6px 22px rgba(5,25,16,0.04)}\\n    label{display:block;font-weight:700;margin-bottom:6px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6efe8;margin-bottom:12px}\\n    button{background:var(--accent);color:#fff;padding:12px 16px;border-radius:10px;border:0;font-weight:800}\\n\\n    .aside .steps{list-style:none;padding:0;margin:0}\\n    .steps li{padding:10px 0;border-bottom:1px dashed rgba(0,0,0,0.04);color:var(--muted)}\\n\\n    .pattern{position:fixed;left:-8%;bottom:-12%;width:500px;height:500px;opacity:0.06;pointer-events:none}\\n\\n    @media(max-width:860px){.columns{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:800;color:var(--accent)\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Back</a>\\n      <a href=\\\"services.html\\\">What we do</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <div class=\\\"hero\\\">\\n      <div>\\n        <h2>Reserve your intake</h2>\\n        <div class=\\\"note\\\">Initial visits are 75–90 minutes. If you're unsure which package fits, choose a standard intake and we'll recommend next steps.</div>\\n      </div>\\n      <div style=\\\"margin-left:auto\\\">\\n        <a href=\\\"pricing.html\\\" style=\\\"text-decoration:none;color:var(--muted);font-weight:700\\\">View plans</a>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"columns\\\">\\n      <form class=\\\"card\\\" action=\\\"/book\\\" method=\\\"post\\\" onsubmit=\\\"return fakeSubmit(event)\\\">\\n        <div style=\\\"display:flex;gap:10px\\\">\\n          <div style=\\\"flex:1\\\">\\n            <label for=\\\"name\\\">Full name</label>\\n            <input id=\\\"name\\\" name=\\\"name\\\" required placeholder=\\\"Your name\\\" />\\n          </div>\\n          <div style=\\\"width:140px\\\">\\n            <label for=\\\"phone\\\">Phone</label>\\n            <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"{{PHONE}}\\\" />\\n          </div>\\n        </div>\\n\\n        <label for=\\\"email\\\">Email</label>\\n        <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required />\\n\\n        <label for=\\\"reason\\\">Primary concern</label>\\n        <select id=\\\"reason\\\" name=\\\"reason\\\">\\n          <option>Stress / emotional balance</option>\\n          <option>Sleep problems</option>\\n          <option>Digestive symptoms</option>\\n          <option>Chronic inflammation</option>\\n          <option>Low energy / fatigue</option>\\n          <option>Other</option>\\n        </select>\\n\\n        <label for=\\\"notes\\\">Brief history & goals</label>\\n        <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"5\\\" placeholder=\\\"What would you like to focus on?\\\"></textarea>\\n\\n        <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n          <button type=\\\"submit\\\">Request appointment</button>\\n          <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none;font-weight:700\\\">Or email: {{EMAIL}}</a>\\n        </div>\\n\\n        <p style=\\\"margin-top:12px;color:var(--muted);font-size:13px\\\">By requesting, you agree we'll contact you to schedule. This form does not create a medical record. For urgent issues call local emergency services.</p>\\n      </form>\\n\\n      <aside class=\\\"aside\\\">\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin-top:0\\\">What to expect</h4>\\n          <ol class=\\\"steps\\\">\\n            <li><strong>Step 1:</strong> Intake conversation to understand history and priorities.</li>\\n            <li><strong>Step 2:</strong> Collaborative plan with education and options.</li>\\n            <li><strong>Step 3:</strong> Follow-ups to refine and build skills.</li>\\n            <li style=\\\"color:var(--muted);font-size:13px\\\">Optional labs are discussed only if they are likely to add meaningful information.</li>\\n          </ol>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Need help choosing?</h4>\\n          <p style=\\\"color:var(--muted);margin:0 0 12px\\\">If you prefer, send a short message to <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"text-decoration:none;color:var(--muted)\\\">{{EMAIL}}</a> or call {{PHONE}}.</p>\\n         