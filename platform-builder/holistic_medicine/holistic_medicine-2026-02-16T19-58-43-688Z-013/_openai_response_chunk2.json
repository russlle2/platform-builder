          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Offerings</title>\\n  <style>\\n    :root{\\n      --bg1:#f6fbf9;--bg2:#eef7ff;--accent:#2b7a78;--muted:#5b6468;--card:#ffffff;\\n      --glass: rgba(255,255,255,0.6);\\n    }\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; color:var(--muted);background:linear-gradient(180deg,var(--bg1),var(--bg2));}\\n    .page{min-height:100vh;position:relative;overflow:hidden;padding-bottom:60px}\\n    /* unique inline svg pattern sits behind content */\\n    .pattern{position:absolute;inset:0;pointer-events:none;opacity:0.18}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 36px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#4fb3bf);display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n    nav{display:flex;gap:18px}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px 10px;border-radius:8px}\\n    nav a.active{background:var(--glass);backdrop-filter:blur(6px);color:#0b3b3a;font-weight:600}\\n    main{max-width:980px;margin:22px auto;padding:36px;display:grid;grid-template-columns:1fr 320px;gap:28px}\\n    .hero{background:linear-gradient(180deg,rgba(255,255,255,0.9),var(--card));padding:28px;border-radius:14px;box-shadow:0 6px 30px rgba(15,22,23,0.06)}\\n    .hero h1{margin:0 0 8px 0;color:#08383a}\\n    .hero p{margin:0 0 18px;color:var(--muted)}\\n    .cta-row{display:flex;gap:12px}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:600}\\n    .muted-btn{background:transparent;border:1px solid rgba(11,59,58,0.08);padding:10px 12px;border-radius:10px;color:var(--muted);text-decoration:none}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 20px rgba(11,59,58,0.04)}\\n    .services-list{display:grid;gap:12px}\\n    .service{display:flex;gap:12px;align-items:flex-start}\\n    .icon{width:46px;height:46px;border-radius:8px;background:linear-gradient(135deg,#fff,rgba(75,160,155,0.08));display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent)}\\n    .small{font-size:13px;color:var(--muted)}\\n    aside .card{position:sticky;top:32px}\\n    dl.faq{margin:0}\\n    dl dt{font-weight:600;margin-top:12px}\\n    dl dd{margin:6px 0 12px 0;color:var(--muted)}\\n    footer{position:relative;text-align:center;padding:24px 16px;color:var(--muted)}\\n    /* responsive */\\n    @media (max-width:880px){main{grid-template-columns:1fr;padding:20px}aside{order:2}header{padding:16px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"page\\\">\\n    <!-- decorative pattern (unique to services) -->\\n    <svg class=\\\"pattern\\\" viewBox=\\\"0 0 800 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" preserveAspectRatio=\\\"none\\\">\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#c9f0ec\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#eaf8ff\\\"/></linearGradient>\\n        <pattern id=\\\"p1\\\" width=\\\"120\\\" height=\\\"120\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n          <rect width=\\\"120\\\" height=\\\"120\\\" fill=\\\"url(#g1)\\\" />\\n          <circle cx=\\\"20\\\" cy=\\\"20\\\" r=\\\"6\\\" fill=\\\"#9ee1db\\\" />\\n          <circle cx=\\\"100\\\" cy=\\\"100\\\" r=\\\"6\\\" fill=\\\"#b2efe7\\\" />\\n          <path d=\\\"M0 60h120\\\" stroke=\\\"#7fd6cf\\\" stroke-width=\\\"1\\\" opacity=\\\"0.7\\\"/>\\n        </pattern>\\n      </defs>\\n      <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\"/>\\n    </svg>\\n\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">HM</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\" class=\\\"active\\\">Offerings</a>\\n        <a href=\\\"approach.html\\\">Method</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section>\\n        <div class=\\\"hero card\\\">\\n          <h1>Integrative sessions that meet you where you are</h1>\\n          <p>Personalized consultations blending evidence-informed nutrition, lifestyle, herbal care and mind-body skills to support whole-person well-being. We partner with you—no promises of cures, only practical tools and guidance.</p>\\n          <div class=\\\"cta-row\\\">\\n            <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n            <a class=\\\"muted-btn\\\" href=\\\"contact.html\\\">Ask a question</a>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"height:18px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">How sessions are structured</h3>\\n          <div class=\\\"services-list\\\">\\n            <div class=\\\"service\\\">\\n              <div class=\\\"icon\\\">C</div>\\n              <div>\\n                <strong>Comprehensive consultation</strong>\\n                <div class=\\\"small\\\">60–90 minutes. Detailed intake, health history, and collaborative goal-setting.</div>\\n              </div>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <div class=\\\"icon\\\">P</div>\\n              <div>\\n                <strong>Follow-up visits</strong>\\n                <div class=\\\"small\\\">30–45 minutes. Review progress, adjust plan, and provide practical steps.</div>\\n              </div>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <div class=\\\"icon\\\">N</div>\\n              <div>\\n                <strong>Nutrition & lifestyle coaching</strong>\\n                <div class=\\\"small\\\">Individualized guidance with meal frameworks, sleep, and stress tools.</div>\\n              </div>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <div class=\\\"icon\\\">H</div>\\n              <div>\\n                <strong>Herbal and supplementary options</strong>\\n                <div class=\\\"small\\\">Education on supportive botanicals and safe supplementation when appropriate.</div>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"height:14px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Typical client ritual</h3>\\n          <p class=\\\"small\\\">Our intake is intentionally attentive: we gather context, listen for patterns, and co-create a plan. You may be asked to track sleep, food, or mood for a short period so recommendations are grounded in your daily life.</p>\\n        </div>\\n\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin-top:0\\\">What to expect</h4>\\n          <ul class=\\\"small\\\">\\n            <li>Collaborative planning, rooted in whole-person assessment.</li>\\n            <li>Education about options and risks—not promises.</li>\\n            <li>Support for gradual, sustainable change.</li>\\n          </ul>\\n        </div>\\n\\n        <div style=\\\"height:14px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin-top:0\\\">Visit types & scheduling</h4>\\n          <p class=\\\"small\\\">Intake: 60–90 min. Follow-up: 30–45 min. Remote and in-person availability; scheduling via Book page.</p>\\n        </div>\\n\\n        <div style=\\\"height:14px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin-top:0\\\">FAQ</h4>\\n          <dl class=\\\"faq\\\">\\n            <dt>Do you replace my primary care?</dt>\\n            <dd>We complement medical care and coordinate with your providers when helpful.</dd>\\n            <dt>Are lab tests required?</dt>\\n            <dd>Optional labs are educational and used selectively; they are always discussed before ordering.</dd>\\n          </dl>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <footer>\\n      <div class=\\\"card\\\" style=\\\"display:inline-block;padding:18px;border-radius:12px;box-shadow:0 8px 30px rgba(11,59,58,0.05)\\\">\\n        <div style=\\\"font-weight:700\\\">Ready to begin?</div>\\n        <div class=\\\"small\\\">Schedule a conversation with {{PRACTITIONER_NAME}}, {{CREDENTIALS}} — {{CITY}}, {{STATE}}</div>\\n        <div style=\\\"height:10px\\\"></div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n      <div style=\\\"height:12px\\\"></div>\\n      <div class=\\\"small\\\">Call: {{PHONE}} • Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Common Concerns</title>\\n  <style>\\n    :root{--bg:#fcfdfc;--accent:#4a8f8b;--soft:#f0fcfb;--text:#26403f}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;color:var(--text);background:linear-gradient(180deg,#fbfffe,#f2fbfa)}\\n    .wrap{max-width:980px;margin:28px auto;padding:22px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav{display:flex;gap:14px}\\n    .nav a{color:var(--text);text-decoration:none;padding:8px 10px;border-radius:8px}\\n    .nav a.active{background:var(--soft);font-weight:600}\\n    .grid{display:grid;grid-template-columns:1fr 340px;gap:20px;margin-top:18px}\\n    .lead{background:white;padding:18px;border-radius:14px;box-shadow:0 10px 30px rgba(33,47,46,0.05)}\\n    .lead h1{margin:0 0 8px 0}\\n    .pill{display:inline-block;padding:6px 10px;background:linear-gradient(90deg,rgba(74,143,139,0.12),transparent);border-radius:999px;color:var(--accent);font-weight:600}\\n    .concern{display:grid;grid-template-columns:44px 1fr;gap:10px;padding:12px;border-radius:10px;background:linear-gradient(180deg,#ffffff,#fbfffe);align-items:center}\\n    .concern + .concern{margin-top:10px}\\n    .dot{width:40px;height:40px;border-radius:8px;background:linear-gradient(135deg,#e6faf6,#d8f7f2);display:flex;align-items:center;justify-content:center;color:var(--accent);font-weight:700}\\n    aside .card{padding:16px;background:white;border-radius:12px;box-shadow:0 8px 22px rgba(33,47,46,0.04)}\\n    .disclaimer{font-size:13px;color:#6a6f6f;margin-top:12px}\\n    footer{margin-top:20px;text-align:center;font-size:13px;color:#6b7473}\\n    @media (max-width:900px){.grid{grid-template-columns:1fr}aside{order:2}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:#6b7473\\\">Support for day-to-day health with whole-person care</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"conditions.html\\\" class=\\\"active\\\">Concerns</a>\\n        <a href=\\\"approach.html\\\">Our Way</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"grid\\\">\\n      <main>\\n        <div class=\\\"lead\\\">\\n          <span class=\\\"pill\\\">Common concerns</span>\\n          <h1>What people often bring to integrative care</h1>\\n          <p class=\\\"disclaimer\\\">Below are typical concerns that clients seek support for. This is educational information and not a medical diagnosis. We aim to help you understand options to manage symptoms and improve resilience; outcomes vary and no cure is guaranteed.</p>\\n\\n          <div style=\\\"height:14px\\\"></div>\\n\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"dot\\\">S</div>\\n            <div>\\n              <strong>Stress & overwhelm</strong>\\n              <div style=\\\"font-size:13px;color:#596463\\\">Practical stress management, sleep hygiene, breath practices, and lifestyle adjustments to support emotional balance.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"dot\\\">Z</div>\\n            <div>\\n              <strong>Sleep difficulties</strong>\\n              <div style=\\\"font-size:13px;color:#596463\\\">Assessing sleep patterns, routines, and behaviors; education on sleep-supportive nutrition and habits.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"dot\\\">G</div>\\n            <div>\\n              <strong>Digestion & gut health</strong>\\n              <div style=\\\"font-size:13px;color:#596463\\\">Investigating pattern-based causes and dietary approaches to ease symptoms; labs may be discussed when educational.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"dot\\\">I</div>\\n            <div>\\n              <strong>Chronic inflammation & pain</strong>\\n              <div style=\\\"font-size:13px;color:#596463\\\">Lifestyle, anti-inflammatory nutrition, and supportive practices to reduce symptom burden alongside medical care.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"dot\\\">E</div>\\n            <div>\\n              <strong>Low energy & fatigue</strong>\\n              <div style=\\\"font-size:13px;color:#596463\\\">Assessing sleep, nutrition, stress, and movement. We look for patterns to restore steady energy when possible.</div>\\n            </div>\\n          </div>\\n\\n        </div>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div class=\\\"lead\\\">\\n          <h3 style=\\\"margin-top:0\\\">When to seek medical care</h3>\\n          <p class=\\\"disclaimer\\\">If you have acute or severe symptoms (chest pain, difficulty breathing, sudden neurological changes, severe bleeding, suicidal thoughts), seek emergency care immediately. Our work complements medical care and we will coordinate with your clinicians if needed.</p>\\n        </div>\\n\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0\\\">What we offer</h4>\\n          <p style=\\\"color:#596463;font-size:13px;margin-top:8px\\\">Tailored consults, follow-ups, nutrition guidance, herbal education, and optional lab review to inform a personalized plan.</p>\\n          <div style=\\\"height:10px\\\"></div>\\n          <a href=\\\"approach.html\\\" style=\\\"display:inline-block;padding:10px 14px;background:var(--accent);color:white;border-radius:10px;text-decoration:none\\\">Learn the process</a>\\n        </div>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0\\\">Quick FAQ</h4>\\n          <p style=\\\"font-size:13px;color:#596463;margin-top:8px\\\">We do not promise cure. We provide guidance and support for sustainable change. If you are on medications, continue them unless advised by your prescriber.</p>\\n        </div>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0\\\">Ready to discuss?</h4>\\n          <p style=\\\"font-size:13px;color:#596463;margin-top:8px\\\">Book an intake to review your concerns in depth. Phone: {{PHONE}}</p>\\n          <div style=\\\"height:8px\\\"></div>\\n          <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:inline-block;padding:10px 12px;background:#e9fffc;color:var(--accent);border-radius:8px;text-decoration:none\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} — {{PRACTITIONER_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Our Approach</title>\\n  <style>\\n    :root{--bg:#fffefc;--accent:#1f6e6b;--muted:#4f5e5d}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;background:linear-gradient(180deg,var(--bg),#f4fbfa);color:var(--muted)}\\n    .wrap{max-width:1100px;margin:30px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:14px;text-decoration:none;color:var(--muted)}\\n    .hero{margin-top:18px;display:flex;gap:24px;align-items:center}\\n    .panel{background:white;padding:20px;border-radius:14px;box-shadow:0 12px 40px rgba(17,34,33,0.06)}\\n    .left{flex:1}\\n    .right{width:340px}\\n    .step{display:flex;gap:12px;align-items:flex-start;padding:12px;border-radius:10px;background:linear-gradient(180deg,#ffffff,#fbfffe);margin-bottom:10px}\\n    .num{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#bff0ea,#b0eae4);display:flex;align-items:center;justify-content:center;color:var(--accent);font-weight:700}\\n    .muted{font-size:13px}\\n    .cta{margin-top:16px}\\n    footer{margin-top:20px;font-size:13px;color:#6b7473;text-align:center}\\n    @media (max-width:920px){.hero{flex-direction:column}.right{width:100%}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Welcome</a>\\n        <a href=\\\"services.html\\\">Care</a>\\n        <a href=\\\"approach.html\\\" style=\\\"font-weight:700\\\">Our Approach</a>\\n        <a href=\\\"pricing.html\\\">Fees</a>\\n        <a href=\\\"contact.html\\\">Reach</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"hero\\\">\\n      <div class=\\\"left panel\\\">\\n        <h2 style=\\\"margin-top:0\\\">A compass for your health — clear, supportive steps</h2>\\n        <p class=\\\"muted\\\">We use a layered approach: listening, mapping patterns, testing selectively, and supporting sustainable change through education and tailored plans. No guarantees—only a collaborative path forward.</p>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div class=\\\"step\\\">\\n          <div class=\\\"num\\\">1</div>\\n          <div>\\n            <strong>Intake & listening</strong>\\n            <div class=\\\"muted\\\">A thorough review of your history, current symptoms, lifestyle, and priorities. This is where we learn patterns and set realistic goals together.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"step\\\">\\n          <div class=\\\"num\\\">2</div>\\n          <div>\\n            <strong>Personalized plan</strong>\\n            <div class=\\\"muted\\\">We craft an integrative plan that may include nutrition shifts, movement, sleep strategies, stress tools, and safe herbal or supplemental options when appropriate.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"step\\\">\\n          <div class=\\\"num\\\">3</div>\\n          <div>\\n            <strong>Optional labs (educational)</strong>\\n            <div class=\\\"muted\\\">When data will clarify the plan, we discuss targeted lab testing. Tests are presented as educational tools—not mandatory steps—and are chosen only when they inform care.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"step\\\">\\n          <div class=\\\"num\\\">4</div>\\n          <div>\\n            <strong>Follow-ups & adjustment</strong>\\n            <div class=\\\"muted\\\">Regular check-ins to monitor progress, refine strategies, and support habit formation. Follow-ups focus on realistic, measurable steps.</div>\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"right panel\\\">\\n        <h4 style=\\\"margin:0\\\">Practical things to expect</h4>\\n        <ul class=\\\"muted\\\" style=\\\"margin-top:12px\\\">\\n          <li>Initial visit: 60–90 minutes; follow-ups: 30–45 minutes.</li>\\n          <li>Emphasis on education—understanding \\\"why\\\" behind recommendations.</li>\\n          <li>Coordination with your medical providers when helpful.</li>\\n        </ul>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <h4 style=\\\"margin:0\\\">Safety & scope</h4>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">We do not replace urgent or specialized medical care. If concerning or emergent issues arise, you will be directed to appropriate services.</p>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div style=\\\"display:flex;gap:10px;align-items:center\\\" class=\\\"cta\\\">\\n          <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"padding:10px 12px;background:var(--accent);color:white;border-radius:10px;text-decoration:none;font-weight:600\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a href=\\\"contact.html\\\" style=\\\"padding:8px 10px;border-radius:10px;background:#eef7f6;color:var(--accent);text-decoration:none\\\">Ask a question</a>\\n        </div>\\n\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <div class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0\\\">A note on testing and supplements</h3>\\n        <p class=\\\"muted\\\">Labs can be useful educational tools, but they are not always necessary. When recommended, we explain the purpose, limitations, and how results might change care. Supplements or herbal supports are suggested cautiously, with attention to interactions and safety.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:14px\\\">\\n      <div class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0\\\">Frequently asked</h3>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">\\n          <strong>Will this replace my current doctor?</strong>\\n          <p class=\\\"muted\\\">No — we aim to complement and coordinate, not replace. For medication changes or urgent matters, we work with your primary providers.</p>\\n          <strong>How many visits will I need?</strong>\\n          <p class=\\\"muted\\\">It depends on goals and complexity. We offer a hybrid model: short-term plans or ongoing support, decided together.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"color:#6b7473\\\">{{BUSINESS_NAME}} • {{PRACTITIONER_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}} • {{PHONE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
