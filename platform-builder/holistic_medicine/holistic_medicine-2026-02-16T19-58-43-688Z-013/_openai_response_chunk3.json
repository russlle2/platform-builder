          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Holistic, integrative care that centers the whole person — philosophy, practitioner, and process at {{BUSINESS_NAME}}.\\\">\\n  <style>\\n    :root{--bg1:#f7fbf9;--bg2:#e8f3ef;--accent:#6aa88b;--muted:#5b6b63;--card:#ffffff;--glass:rgba(255,255,255,0.6);--shadow:0 6px 20px rgba(15,23,20,0.08)}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:var(--muted);background:linear-gradient(180deg,var(--bg1),var(--bg2));-webkit-font-smoothing:antialiased}\\n    body::before{content:\\\"\\\";position:fixed;inset:0;background-image:url('assets/img/pattern.svg');opacity:0.12;mix-blend-mode:multiply}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 28px;backdrop-filter: blur(6px)}\\n    .brand{display:flex;flex-direction:column}\\n    .brand .title{font-weight:700;color:#163826}\\n    nav{display:flex;gap:14px;align-items:center}\\n    nav a{color:#163826;text-decoration:none;padding:8px 12px;border-radius:10px}\\n    nav a[href$=\\\"pricing.html\\\"]{background:linear-gradient(90deg,var(--accent),#4d9f77);color:white}\\n    main{max-width:980px;margin:28px auto;padding:28px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:22px;align-items:center}\\n    .card{background:var(--card);border-radius:14px;padding:20px;box-shadow:var(--shadow)}\\n    h1{margin:0 0 8px 0;color:#153a2f}\\n    p.lead{margin:0 0 12px 0;color:#385047}\\n    .practitioner{font-size:14px;color:#2b4b3e}\\n    .pill{display:inline-block;background:linear-gradient(90deg,#edf9f2,#e6f3ea);padding:6px 10px;border-radius:999px;color:#165033;font-weight:600;font-size:13px}\\n    .sections{display:grid;grid-template-columns:1fr 300px;gap:22px;margin-top:18px}\\n    .what{line-height:1.5}\\n    .rituals{background:linear-gradient(180deg,#fff,#f7fffb);padding:16px;border-radius:12px}\\n    .muted{color:#6b7c73;font-size:14px}\\n    .list{display:grid;gap:10px;margin-top:12px}\\n    .list .item{padding:12px;border-radius:10px;background:var(--glass)}\\n    .cta{display:flex;gap:12px;margin-top:18px}\\n    .primary{background:var(--accent);color:#fff;padding:12px 16px;border-radius:10px;border:none}\\n    .secondary{background:transparent;border:1px solid #dceee2;padding:12px 14px;border-radius:10px}\\n    footer{max-width:980px;margin:40px auto;color:#4b5f56;font-size:14px;padding:12px}\\n    @media (max-width:880px){.hero{grid-template-columns:1fr}.sections{grid-template-columns:1fr}.brand{align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"title\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"muted\\\">Integrative & whole-person care — {{CITY}}, {{STATE}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Welcome</a>\\n      <a href=\\\"approach.html\\\">Our Way</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"pricing.html\\\">Plans</a>\\n      <a href=\\\"book.html\\\">Get Started</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"card\\\">\\n        <span class=\\\"pill\\\">About your care</span>\\n        <h1>Thoughtful, whole-person medicine — not quick fixes</h1>\\n        <p class=\\\"lead\\\">At {{BUSINESS_NAME}}, we combine modern assessment and traditional wisdom to support resilience, balance, and everyday function. Care is educational and personalized.</p>\\n        <div class=\\\"practitioner\\\">Led by {{PRACTITIONER_NAME}}, {{CREDENTIALS}} — focused on helping people understand patterns (stress, sleep, digestion, energy) and act on them.</div>\\n        <div class=\\\"cta\\\">\\n          <a class=\\\"primary\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a class=\\\"secondary\\\" href=\\\"contact.html\\\">Contact — {{PHONE}}</a>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card rituals\\\">\\n        <strong style=\\\"display:block;color:#145939\\\">A short daily ritual</strong>\\n        <p class=\\\"muted\\\">Small, consistent practices support measurable change. We emphasize gentle routines that support sleep, digestion, and nervous system balance.</p>\\n        <div class=\\\"list\\\">\\n          <div class=\\\"item\\\"><strong>Morning check-in</strong><div class=\\\"muted\\\">1–2 minutes to note sleep, mood, digestion.</div></div>\\n          <div class=\\\"item\\\"><strong>Breath pause</strong><div class=\\\"muted\\\">A 3-minute breathing practice mid-day to reset stress response.</div></div>\\n          <div class=\\\"item\\\"><strong>Nourish with intention</strong><div class=\\\"muted\\\">Simple meal cues to support digestion and energy.</div></div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section id=\\\"what_to_expect\\\" style=\\\"margin-top:22px\\\" class=\\\"card what\\\">\\n      <h2 style=\\\"color:#163826\\\">What to expect in your first few visits</h2>\\n      <p class=\\\"muted\\\">We prioritize listening, education, and a stepwise plan. The intake gathers history, daily rhythms, and priorities. Care may include lifestyle plans, targeted supplements, or educational labs where appropriate.</p>\\n      <ol style=\\\"margin-top:12px;color:#2f4f44\\\">\\n        <li><strong>Comprehensive intake.</strong> A holistic review of systems, stressors, and goals.</li>\\n        <li><strong>Personalized plan.</strong> Practical steps, prioritized so you can progress without overwhelm.</li>\\n        <li><strong>Follow-up.</strong> Short check-ins to track response and adjust.</li>\\n      </ol>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:10px;font-size:13px\\\">Note: We focus on supportive, evidence-informed approaches. We do not guarantee cures; outcomes depend on many variables including adherence and underlying conditions.</p>\\n    </section>\\n\\n    <div class=\\\"sections\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0;color:#163826\\\">Your therapeutic ritual</h3>\\n        <p class=\\\"muted\\\">Rituals are practical, repeatable actions that anchor a plan. We build habits that complement medical care and reduce symptom burden over time.</p>\\n        <ul class=\\\"muted\\\" style=\\\"margin-top:12px\\\">\\n          <li>Daily rhythm scaffolding (sleep + meals)</li>\\n          <li>Movement and breath practices to regulate nervous system</li>\\n          <li>Targeted nutrition and supportive botanicals where indicated</li>\\n        </ul>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <h4 style=\\\"margin:0 0 8px 0;color:#163826\\\">Quick scheduling</h4>\\n        <div class=\\\"muted\\\">New patient availability updated weekly. For urgent concerns, contact your primary care or local emergency services.</div>\\n        <div style=\\\"margin-top:12px\\\">\\n          <a class=\\\"primary\\\" href=\\\"book.html\\\">Book a New Visit</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section id=\\\"pricing\\\" style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"color:#163826\\\">A snapshot of fees</h3>\\n      <p class=\\\"muted\\\">We offer single visits and bundled plans. Exact fees and insurance options are discussed during intake — plans can be adapted to budget and goals.</p>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-wrap:wrap\\\">\\n        <div style=\\\"flex:1;min-width:180px;padding:12px;border-radius:10px;background:#f8fffa;\\\">Single New Visit — introductory evaluation</div>\\n        <div style=\\\"flex:1;min-width:180px;padding:12px;border-radius:10px;background:#fff\\\">Support Package — follow-ups and check-ins</div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"faq\\\" style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"color:#163826\\\">Frequently asked</h3>\\n      <div style=\\\"margin-top:10px\\\">\\n        <details>\\n          <summary style=\\\"cursor:pointer\\\">Do you take insurance?</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">We provide superbills for many plans; direct billing depends on partnerships. We discuss billing options during scheduling.</div>\\n        </details>\\n        <details style=\\\"margin-top:8px\\\">\\n          <summary style=\\\"cursor:pointer\\\">Will you replace my current care?</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">We coordinate with existing providers and emphasize continuity. We do not recommend stopping prescribed medications without consulting your prescriber.</div>\\n        </details>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:24px;padding:20px;border-radius:12px;background:linear-gradient(90deg,#fefcf7,#f3fff6)\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0;color:#163826\\\">Ready to begin?</h3>\\n      <p class=\\\"muted\\\">Set a first visit to explore a personalized path toward steadier sleep, calmer stress response, more reliable digestion, and sustained energy.</p>\\n      <div style=\\\"margin-top:12px\\\">\\n        <a class=\\\"primary\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <a class=\\\"secondary\\\" href=\\\"contact.html\\\">Ask a question — {{EMAIL}}</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap\\\">\\n      <div>&copy; <strong>{{BUSINESS_NAME}}</strong> — {{CITY}}, {{STATE}}</div>\\n      <div class=\\\"muted\\\">Phone: {{PHONE}} • Email: {{EMAIL}}</div>\\n    </div>\\n  </footer>\\n\\n  <script>\\n    // small accessibility helper for details elements\\n    document.querySelectorAll('details').forEach(d=>{d.addEventListener('toggle',e=>{/*noop*/})});\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Pricing & Plans — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Transparent pricing for integrative care packages, single visits, and subscription support options.\\\">\\n  <style>\\n    :root{--bg:#f5fffb;--accent:#4f9f77;--dark:#153a2f;--card:#fff;--glass:rgba(255,255,255,0.7);--muted:#516a60}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:linear-gradient(180deg,#fafffb,#f1fff7);color:var(--muted)}\\n    body::after{content:\\\"\\\";position:fixed;right:0;top:0;bottom:0;width:40%;background-image:url('assets/img/pattern.svg');opacity:0.08;pointer-events:none}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 26px}\\n    nav a{margin-left:10px;color:var(--dark);text-decoration:none}\\n    .container{max-width:1100px;margin:22px auto;padding:18px}\\n    .hero{padding:22px;border-radius:14px;background:linear-gradient(90deg,#ffffff,#f6fff9);display:flex;justify-content:space-between;align-items:center}\\n    h1{margin:0;color:var(--dark)}\\n    .subtitle{color:#2f5d4f}\\n    .tiers{display:flex;gap:16px;margin-top:18px;flex-wrap:wrap}\\n    .tier{flex:1;min-width:220px;background:var(--card);border-radius:12px;padding:18px;box-shadow:0 8px 24px rgba(11,27,20,0.06)}\\n    .price{font-size:22px;color:var(--accent);font-weight:700}\\n    .features{margin-top:10px;color:#3b5d53}\\n    .muted{color:#6e8379;font-size:14px}\\n    .cta{margin-top:14px}\\n    .primary{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    .faq{margin-top:20px}\\n    footer{margin-top:28px;color:#536b62}\\n    @media (max-width:760px){.hero{flex-direction:column;align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:700;color:var(--dark)\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Overview</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"about.html\\\">Our Story</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Fees that aim to be clear and flexible</h1>\\n        <p class=\\\"subtitle\\\">Choose single visits or structured support. Pricing below is illustrative — exact details given during scheduling.</p>\\n      </div>\\n      <div style=\\\"text-align:right\\\">\\n        <div class=\\\"muted\\\">Questions?</div>\\n        <div style=\\\"margin-top:8px\\\"><a class=\\\"primary\\\" href=\\\"contact.html\\\">Contact Billing — {{EMAIL}}</a></div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"pricing\\\" style=\\\"margin-top:18px\\\">\\n      <div class=\\\"tiers\\\">\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><strong>Intro Visit</strong><div class=\\\"price\\\">Single</div></div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Comprehensive intake & initial plan (90 minutes typical).</div>\\n          <div class=\\\"features\\\">\\n            <ul>\\n              <li>Full history & personalized education</li>\\n              <li>Actionable steps to begin</li>\\n            </ul>\\n          </div>\\n          <div class=\\\"cta\\\"><a class=\\\"primary\\\" href=\\\"book.html\\\">Schedule an Intro</a></div>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><strong>Support Package</strong><div class=\\\"price\\\">3 visits</div></div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Designed for focused follow-through and measurable changes over 3 months.</div>\\n          <div class=\\\"features\\\">\\n            <ul>\\n              <li>2 follow-ups + check-ins</li>\\n              <li>Plan adjustments and educational resources</li>\\n            </ul>\\n          </div>\\n          <div class=\\\"cta\\\"><a class=\\\"primary\\\" href=\\\"book.html\\\">Choose Package</a></div>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><strong>Subscription Care</strong><div class=\\\"price\\\">Ongoing</div></div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Monthly support for maintenance and iterative change. Frequency tailored to need.</div>\\n          <div class=\\\"features\\\">\\n            <ul>\\n              <li>Monthly appointments + messaging</li>\\n              <li>Priority scheduling</li>\\n            </ul>\\n          </div>\\n          <div class=\\\"cta\\\"><a class=\\\"primary\\\" href=\\\"contact.html\\\">Inquire</a></div>\\n        </div>\\n      </div>\\n\\n      <p class=\\\"muted\\\" style=\\\"margin-top:12px\\\">Prices are indicative. We will review exact fees, payment options, and whether labs are educational supplements or medically indicated during intake. We do not promise cures; we provide evidence-informed supportive care.</p>\\n    </section>\\n\\n    <section id=\\\"faq\\\" class=\\\"faq card\\\" style=\\\"margin-top:18px;padding:16px;border-radius:10px;background:linear-gradient(90deg,#ffffff,#fbfff9)\\\">\\n      <h3 style=\\\"margin:0;color:var(--dark)\\\">Pricing FAQ</h3>\\n      <div style=\\\"margin-top:10px;color:var(--muted)\\\">\\n        <details>\\n          <summary style=\\\"cursor:pointer\\\">Do you accept insurance?</summary>\\n          <div style=\\\"margin-top:8px\\\">We can provide documentation for many plans (superbill). Direct billing varies by insurer and is clarified on intake.</div>\\n        </details>\\n        <details style=\\\"margin-top:8px\\\">\\n          <summary style=\\\"cursor:pointer\\\">Are labs required?</summary>\\n          <div style=\\\"margin-top:8px\\\">Labs are optional educational tools. When used, we explain purpose and what we can learn from results.</div>\\n        </details>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"schedule\\\" style=\\\"margin-top:16px;padding:18px;border-radius:12px;background:linear-gradient(180deg,#fbfff8,#f7fff5)\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0;color:var(--dark)\\\">How scheduling works</h3>\\n      <p class=\\\"muted\\\">New visits are longer; follow-ups shorter. We share appointment types during booking so you can choose what fits your timeline.</p>\\n      <div style=\\\"margin-top:10px\\\"><a class=\\\"primary\\\" href=\\\"book.html\\\">View available times</a></div>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">For clinical questions, call {{PHONE}}. Administrative inquiries: {{EMAIL}}.</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a Visit — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Schedule an initial or follow-up visit. Choose a time, tell us briefly about priorities, and we'll follow up to confirm.\\\">\\n  <style>\\n    :root{--bg:#fffefb;--accent:#2f856a;--card:#ffffff;--muted:#465d53}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:linear-gradient(180deg,#ffffff,#f7fff8);color:var(--muted)}\\n    body::before{content:\\\"\\\";position:fixed;left:0;top:0;height:100%;width:60%;background-image:url('assets/img/pattern.svg');opacity:0.06}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:16px 22px}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .wrap{max-width:900px;margin:18px auto;padding:18px}\\n    .hero{padding:18px;background:linear-gradient(90deg,#f6fff7,#ffffff);border-radius:12px}\\n    h1{margin:0;color:#153a2f}\\n    .lead{margin-top:8px}\\n    .grid{display:grid;grid-template-columns:1fr 340px;gap:18px;margin-top:18px}\\n    form{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 8px 20px rgba(10,20,18,0.06)}\\n    label{display:block;font-size:14px;margin-top:8px}\\n    input,textarea,select{width:100%;padding:10px;border-radius:8px;border:1px solid #e6efe8;background:#fbfffb;margin-top:6px}\\n    button{margin-top:12px;background:var(--accent);color:#fff;padding:10px 14px;border:0;border-radius:10px}\\n    .aside{background:linear-gradient(180deg,#ffffff,#f8fff7);padding:14px;border-radius:12px}\\n    .muted{color:#5f756b}\\n    .note{font-size:13px;margin-top:8px;color:#6d7f74}\\n    @media (max-width:880px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">Care Options</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n      <a href=\\\"contact.html\\\">Help</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <h1>Book your visit</h1>\\n      <p class=\\\"lead muted\\\">Choose an appointment type and share priorities. We will contact you to confirm and prepare an intake packet if needed.</p>\\n    </section>\\n\\n    <div class=\\\"grid\\\">\\n      <form id=\\\"booking\\\" aria-label=\\\"Booking form\\\">\\n        <label for=\\\"name\\\">Full name</label>\\n        <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"Your name\\\" required>\\n\\n        <label for=\\\"email\\\">Email</label>\\n        <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n\\n        <label for=\\\"phone\\\">Phone</label>\\n        <input id=\\\"phone\\\" name=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"(555) 555-5555\\\">\\n\\n        <label for=\\\"type\\\">Appointment type</label>\\n        <select id=\\\"type\\\" name=\\\"type\\\">\\n          <option>New patient intake (long)</option>\\n          <option>Follow-up (short)</option>\\n          <option>Wellness check / consult</option>\\n        </select>\\n\\n        <label for=\\\"when\\\">Preferred timeframe</label>\\n        <input id=\\\"when\\\" name=\\\"when\\\" type=\\\"text\\\" placeholder=\\\"Weekdays morning/afternoon\\\">\\n\\n        <label for=\\\"notes\\\">Brief priorities (sleep, energy, digestion, stress)</label>\\n        <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Tell us what you hope to address.\\\"></textarea>\\n\\n        <div class=\\\"note\\\">By submitting you agree to receive scheduling communications from {{BUSINESS_NAME}}. For urgent medical issues call local emergency services.</div>\\n\\n        <button type=\\\"submit\\\">Request appointment</button>\\n      </form>\\n\\n      <aside class=\\\"aside\\\">\\n        <h3 style=\\\"margin-top:0;color:#153a2f\\\">What to expect next</h3>\\n        <p class=\\\"muted\\\">Within 2 business days we will reach out to confirm a time, request any intake forms, and share preparation tips. New visits typically run 60–90 minutes; follow-ups 20–40 minutes.</p>\\n\\n        <h4 style=\\\"margin-top:12px;color:#153a2f\\\">Rituals & preparation</h4>\\n        <p class=\\\"muted\\\">Bring a current medication list and any recent labs. Note sleep patterns and main stressors for a focused first session.</p>\\n\\n        <h4 style=\\\"margin-top:12px;color:#153a2f\\\">Fees & logistics</h4>\\n        <p class=\\\"muted\\\">Fees vary by visit type; see <a href=\\\"pricing.html\\\">Pricing</a>. Insurance and billing options discussed during scheduling. We provide educational guidance; results vary and cannot be guaranteed.</p>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <a href=\\\"contact.html\\\" style=\\\"text-decoration:none;color:var(--accent);font-weight:600\\\">Questions? Email {{EMAIL}}</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section id=\\\"faq\\\" style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"color:#153a2f\\\">Quick FAQ</h3>\\n      <div class=\\\"muted\\\">\\n        <details>\\n          <summary style=\\\"cursor:pointer\\\">How soon can I be seen?</summary>\\n          <div style=\\\"margin-top:8px\\\">Availability varies; new patients are often scheduled within 1–3 weeks. For urgent concerns contact your primary care.</div>\\n        </details>\\n        <details style=\\\"margin-top:8px\\\">\\n          <summary style=\\\"cursor:pointer\\\">Are telehealth visits available?</summary>\\n          <div style=\\\"margin-top:8px\\\">Yes — we offer virtual visits for many appointment types. We'll confirm modality when scheduling.</div>\\n        </details>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;padding:12px;border-radius:10px;background:linear-gradient(90deg,#fff,#f7fff6)\\\">\\n      <h4 style=\\\"margin:0;color:#153a2f\\\">Still unsure?</h4>\\n      <p class=\\\"muted\\\">Call us at {{PHONE}} or email {{EMAIL}} if you prefer phone scheduling or have specific accessibility needs.</p>\\n      <div style=\\\"margin-top:8px\\\"><a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"background:var(--accent);color:#fff;padding:9px 12px;border-radius:8px;text-decoration:none\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n    </section>\\n  </main>\\n\\n  <script>\\n    document.getElementById('booking').addEventListener('submit',function(e){\\n      e.preventDefault();\\n      var name=document.getElementById('name').value||'Guest';\\n      alert('Thanks, '+name+'. Your request has been submitted. We will contact you to confirm.');\\n      this.reset();\\n    });\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
