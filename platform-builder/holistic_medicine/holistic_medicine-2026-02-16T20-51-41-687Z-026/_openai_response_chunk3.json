          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Care Plans — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#f6fffc;--bg2:#e8fbf4;--accent:#2a9d8f;--muted:#6b7280;--card:#ffffff;--glass:rgba(255,255,255,0.6)}\\n    html,body{height:100%;margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;}\\n    body{background:linear-gradient(180deg,var(--bg1),var(--bg2));background-image: url('assets/img/pattern.svg'), linear-gradient(180deg,var(--bg1),var(--bg2));background-repeat:repeat; color:#0f172a;}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:22px 4vw;background:linear-gradient(90deg,rgba(255,255,255,0.6),rgba(255,255,255,0.35));backdrop-filter:blur(6px);position:sticky;top:0;z-index:10;border-bottom:1px solid rgba(10,10,10,0.03)}\\n    .brand{display:flex;align-items:center;gap:12px;font-weight:700;color:var(--accent)}\\n    .brand .logo{width:44px;height:44px;background:linear-gradient(135deg,#8ee3c2,#2a9d8f);border-radius:10px;display:flex;align-items:center;justify-content:center;color:#063;box-shadow:0 6px 18px rgba(42,157,143,0.12)}\\n    nav{display:flex;gap:18px;align-items:center}\\n    nav a{color:#08303a;text-decoration:none;font-weight:600}\\n    .btn{background:linear-gradient(90deg,var(--accent),#1f7a72);color:#fff;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    main{max-width:1100px;margin:36px auto;padding:0 20px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;margin-bottom:26px}\\n    .hero .lead{background:var(--card);padding:28px;border-radius:14px;box-shadow:0 8px 30px rgba(10,20,30,0.06)}\\n    h1{margin:0 0 8px 0;font-size:28px;line-height:1.05}\\n    p.lead-sub{margin:0;color:var(--muted)}\\n    .hero .aside{background:linear-gradient(180deg,rgba(255,255,255,0.65),var(--glass));padding:20px;border-radius:12px;box-shadow:inset 0 1px 0 rgba(255,255,255,0.6)}\\n\\n    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:28px 0}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 8px 18px rgba(16,24,40,0.06);border:1px solid rgba(12,14,20,0.02)}\\n    .price{font-size:22px;font-weight:800;color:#08303a}\\n    ul.features{padding-left:18px;margin:12px 0;color:var(--muted)}\\n\\n    .note{font-size:13px;color:var(--muted);margin-top:8px}\\n    .pricing-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:28px}\\n\\n    .testimonial-wrap{display:flex;flex-direction:column;gap:12px}\\n    .t{background:linear-gradient(180deg,#fff,rgba(255,255,255,0.98));padding:14px;border-radius:10px;border-left:4px solid rgba(42,157,143,0.16)}\\n    footer{margin:40px 0;padding:24px;text-align:center;color:var(--muted);font-size:13px}\\n\\n    @media (max-width:900px){\\n      .hero{grid-template-columns:1fr}\\n      .cards{grid-template-columns:1fr}\\n      .pricing-grid{grid-template-columns:1fr}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\"><div class=\\\"logo\\\">HM</div><div>{{BUSINESS_NAME}}</div></div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"approach.html\\\">Our Ways</a>\\n      <a href=\\\"pricing.html\\\">Care Plans</a>\\n      <a href=\\\"about.html\\\">Who We Are</a>\\n      <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"lead\\\">\\n        <h1>Transparent pricing for thoughtful, whole-person care</h1>\\n        <p class=\\\"lead-sub\\\">Clear plans and predictable support so you can focus on progress, not surprises. We blend clinical evaluation, lifestyle guidance, and optional lab testing into personalized care.</p>\\n        <div style=\\\"margin-top:18px;display:flex;gap:12px;flex-wrap:wrap\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule a discovery</a>\\n          <a href=\\\"about.html\\\" style=\\\"padding:10px 14px;border-radius:10px;background:transparent;border:1px solid rgba(6,48,58,0.06);text-decoration:none;color:#08303a;font-weight:700\\\">Meet the practitioner</a>\\n        </div>\\n      </div>\\n      <aside class=\\\"aside\\\">\\n        <strong>Quick guide</strong>\\n        <p class=\\\"note\\\">Typical timeline: Intake → 6–8 week plan → follow-ups. Optional diagnostic tests supported when helpful.</p>\\n        <div style=\\\"margin-top:12px\\\">\\n          <div><strong>Phone</strong>: {{PHONE}}</div>\\n          <div><strong>Email</strong>: {{EMAIL}}</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section>\\n      <h2 style=\\\"margin-bottom:12px\\\">Care packages</h2>\\n      <div class=\\\"cards\\\">\\n        <div class=\\\"card\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><div><strong>Discovery Visit</strong><div class=\\\"note\\\">45–60 min</div></div><div class=\\\"price\\\">$150</div></div>\\n          <p class=\\\"note\\\">Focused intake to understand history, priorities, and immediate steps. Ideal to begin care.</p>\\n          <ul class=\\\"features\\\"><li>Comprehensive history</li><li>Initial wellness recommendations</li><li>Plan outline</li></ul>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><div><strong>Integrative Plan</strong><div class=\\\"note\\\">Personalized 8-week plan</div></div><div class=\\\"price\\\">$480</div></div>\\n          <p class=\\\"note\\\">A blended plan of nutrition, movement, sleep, stress tools, and targeted supplements when appropriate.</p>\\n          <ul class=\\\"features\\\"><li>Weekly check-ins (4)</li><li>Customized nutrition & lifestyle plan</li><li>Educational resources</li></ul>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><div><strong>Ongoing Support</strong><div class=\\\"note\\\">Monthly subscription</div></div><div class=\\\"price\\\">$120 / month</div></div>\\n          <p class=\\\"note\\\">For clients seeking continued guidance: monthly follow-ups, messaging, and plan adjustments.</p>\\n          <ul class=\\\"features\\\"><li>1x monthly follow-up</li><li>Priority messaging</li><li>Care coordination support</li></ul>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"pricing-grid\\\">\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Diagnostics & Labs</h3>\\n          <p class=\\\"note\\\">Optional: targeted labs (hormones, GI, micronutrients). Labs billed separately; we recommend only when it informs care.</p>\\n          <div style=\\\"margin-top:8px\\\"><strong>Typical range:</strong> $80–$420 depending on tests.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Insurance & billing</h3>\\n          <p class=\\\"note\\\">We are hybrid (self-pay + select billing). Many clients use health savings accounts (HSA). We provide receipts to submit to insurance when possible.</p>\\n        </div>\\n      </div>\\n\\n      <p class=\\\"note\\\">We focus on education and whole-person strategies; individual responses vary and outcomes are not guaranteed. Treatment decisions are collaborative and tailored to each person.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2 style=\\\"margin-bottom:12px\\\">What to expect after you book</h2>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px\\\">\\n        <div class=\\\"card\\\"><strong>Before visit</strong><p class=\\\"note\\\">Secure a short intake form and any relevant records so we can use time efficiently.</p></div>\\n        <div class=\\\"card\\\"><strong>During visit</strong><p class=\\\"note\\\">We review history, set priorities, and create an initial set of steps you can start right away.</p></div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:26px\\\">\\n      <h2 style=\\\"margin-bottom:12px\\\">Client voices</h2>\\n      <div class=\\\"testimonial-wrap\\\">\\n        <div class=\\\"t\\\"><strong>A. R.</strong> — \\\"I appreciated the clear plan and practical steps. The follow-ups kept me accountable.\\\"</div>\\n        <div class=\\\"t\\\"><strong>J. P.</strong> — \\\"The practitioner listens and explains options; I felt seen as a whole person.\\\"</div>\\n        <div class=\\\"t\\\"><strong>S. K.</strong> — \\\"Labs helped clarify a missing piece; recommendations were realistic and sustainable.\\\"</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px;text-align:center\\\">\\n      <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a discovery visit</a>\\n      <p class=\\\"note\\\" style=\\\"margin-top:10px\\\">Prefer a quick question? Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></p>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffefc;--accent:#3a8f84;--muted:#67727a}\\n    html,body{height:100%;margin:0;font-family:Georgia,serif,system-ui; background:linear-gradient(180deg,#fcfff9,#f1fbf7);}\\n    body{background-image:url('assets/img/pattern.svg');background-repeat:repeat;background-blend-mode:multiply}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 4vw;background:transparent}\\n    .brand{font-weight:800;color:var(--accent)}\\n    nav{display:flex;gap:14px}\\n    nav a{text-decoration:none;color:#0b2b2a;font-weight:600}\\n\\n    main{max-width:980px;margin:28px auto;padding:0 20px}\\n    .hero{padding:26px;background:linear-gradient(90deg,rgba(58,143,132,0.08),rgba(58,143,132,0.03));border-radius:12px;margin-bottom:18px}\\n    h1{margin:0;font-size:26px}\\n    p.lead{color:var(--muted)}\\n\\n    .story{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    .card{background:#fff;padding:18px;border-radius:10px;box-shadow:0 8px 20px rgba(6,20,24,0.04)}\\n    .bio{line-height:1.5;color:#05282a}\\n\\n    .framework{margin-top:16px}\\n    .steps{display:flex;gap:12px;flex-wrap:wrap}\\n    .step{flex:1 1 200px;background:linear-gradient(180deg,#ffffff,#f6fffb);padding:14px;border-radius:10px;border-left:6px solid rgba(58,143,132,0.12)}\\n\\n    .testimonials{margin-top:18px}\\n    footer{margin:40px 0;text-align:center;color:var(--muted)}\\n\\n    @media (max-width:900px){.story{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Welcome</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n      <a href=\\\"book.html\\\" style=\\\"background:var(--accent);color:#fff;padding:8px 12px;border-radius:8px;text-decoration:none\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <h1>About our approach to whole-person care</h1>\\n      <p class=\\\"lead\\\">We combine evidence-informed clinical thinking with lifestyle medicine and patient education. Our aim is to clarify drivers of health and support meaningful, sustainable change.</p>\\n    </section>\\n\\n    <section class=\\\"story\\\">\\n      <div class=\\\"card\\\">\\n        <h2 style=\\\"margin-top:0\\\">The story behind the practice</h2>\\n        <p class=\\\"bio\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}}, trained in both conventional and integrative methods. The practice began with a simple idea: medicine that listens. We prioritize careful history-taking, clear explanations, and plans that fit your life rather than demanding a perfect one.</p>\\n        <p class=\\\"note\\\">We work with adults facing common concerns such as stress, sleep disruption, digestive imbalance, inflammatory signals, and low energy — always alongside standard care and with respect for medical boundaries.</p>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <h3>Quick facts</h3>\\n        <div class=\\\"note\\\"><strong>Location:</strong> {{CITY}}, {{STATE}}</div>\\n        <div class=\\\"note\\\"><strong>Contact:</strong> {{PHONE}}</div>\\n        <div style=\\\"margin-top:12px\\\"><a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"btn\\\" style=\\\"display:inline-block;background:#3a8f84;color:#fff;padding:8px 12px;border-radius:8px;text-decoration:none\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"framework\\\">\\n      <h2>How we build a plan</h2>\\n      <div class=\\\"steps\\\">\\n        <div class=\\\"step\\\"><strong>1 — Intake</strong><p class=\\\"note\\\">We gather history, labs, and life context to see the whole picture.</p></div>\\n        <div class=\\\"step\\\"><strong>2 — Shared plan</strong><p class=\\\"note\\\">Collaborative goals with practical actions: food, sleep, movement, stress tools, and focused supplements when indicated.</p></div>\\n        <div class=\\\"step\\\"><strong>3 — Follow-up</strong><p class=\\\"note\\\">Regular check-ins to adjust the plan, review data, and support learning.</p></div>\\n        <div class=\\\"step\\\"><strong>4 — Optional testing</strong><p class=\\\"note\\\">Targeted tests can inform care; they’re considered only when they change management.</p></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"testimonials\\\">\\n      <h3>Patient reflections</h3>\\n      <div class=\\\"card\\\"><strong>\\\"A practical approach that fit my schedule.\\\"</strong><p class=\\\"note\\\">\\\"I liked that I left with clear steps and sources to learn more.\\\"</p></div>\\n      <div class=\\\"card\\\" style=\\\"margin-top:12px\\\"><strong>\\\"Thorough and compassionate.\\\"</strong><p class=\\\"note\\\">\\\"The visit felt like a conversation, not a checklist.\\\"</p></div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px;text-align:center\\\">\\n      <p class=\\\"note\\\">We welcome collaboration with your other clinicians. If you have medical conditions or are on medications, bring those questions to your visit so we can coordinate safely.</p>\\n      <a href=\\\"book.html\\\" style=\\\"display:inline-block;margin-top:12px;background:#2a9d8f;color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none\\\">Schedule a first visit</a>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • {{PRACTITIONER_NAME}}, {{CREDENTIALS}} • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f7fff8;--accent:#259083;--muted:#59656b}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,Arial,Sans-serif;background:linear-gradient(180deg,#fbfff8,#eefaf6)}\\n    body{background-image:url('assets/img/pattern.svg');background-repeat:repeat}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:16px 4vw}\\n    .brand{font-weight:800;color:var(--accent)}\\n    nav a{margin-left:12px;text-decoration:none;color:#0b2b2a}\\n\\n    main{max-width:980px;margin:26px auto;padding:0 20px}\\n    .wrap{display:grid;grid-template-columns:1fr 360px;gap:18px}\\n    .panel{background:#fff;padding:18px;border-radius:12px;box-shadow:0 10px 30px rgba(10,20,20,0.06)}\\n    h1{margin:0 0 8px 0}\\n    .small{color:var(--muted);font-size:14px}\\n\\n    form{display:flex;flex-direction:column;gap:12px}\\n    input,textarea,select{padding:10px;border-radius:8px;border:1px solid #e6eef0;font-size:15px}\\n    button{background:linear-gradient(90deg,var(--accent),#1f6f63);color:#fff;padding:10px 14px;border-radius:10px;font-weight:700;border:0}\\n    .hint{font-size:13px;color:var(--muted)}\\n\\n    @media (max-width:900px){.wrap{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"approach.html\\\">How it works</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"wrap\\\">\\n      <section class=\\\"panel\\\">\\n        <h1>Book your initial visit</h1>\\n        <p class=\\\"small\\\">Choose a time for a Discovery Visit (45–60 minutes). If you have questions about insurance or labs, we’ll address them during intake.</p>\\n\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" onsubmit=\\\"event.preventDefault();alert('Thank you — we will follow up via email.');\\\">\\n          <label><span class=\\\"hint\\\">Full name</span><input name=\\\"name\\\" required placeholder=\\\"Full name\\\"></label>\\n          <label><span class=\\\"hint\\\">Email</span><input name=\\\"email\\\" type=\\\"email\\\" required placeholder=\\\"you@example.com\\\"></label>\\n          <label><span class=\\\"hint\\\">Phone</span><input name=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"(555) 555-5555\\\"></label>\\n          <label><span class=\\\"hint\\\">Preferred date</span><input name=\\\"date\\\" type=\\\"date\\\"></label>\\n          <label><span class=\\\"hint\\\">Session type</span>\\n            <select name=\\\"type\\\">\\n              <option>Discovery Visit — 45–60 min</option>\\n              <option>Follow-up — 30 min</option>\\n              <option>Extended Visit — 90 min</option>\\n            </select>\\n          </label>\\n          <label><span class=\\\"hint\\\">Brief reason for visit (optional)</span><textarea name=\\\"reason\\\" rows=\\\"4\\\" placeholder=\\\"Main concerns or goals\\\"></textarea></label>\\n          <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n            <button type=\\\"submit\\\">Request appointment</button>\\n            <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"text-decoration:none;color:var(--accent);font-weight:700\\\">Or email us</a>\\n          </div>\\n          <p class=\\\"hint\\\" style=\\\"margin-top:8px\\\">By submitting you agree to receive follow-up messages. If you have urgent medical needs, call emergency services.</p>\\n        </form>\\n      </section>\\n\\n      <aside class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0\\\">What happens next</h3>\\n        <p class=\\\"hint\\\">After you request an appointment we’ll confirm scheduling and send a short secure intake form. Please bring or upload any recent labs or relevant records.</p>\\n\\n        <h4 style=\\\"margin-top:14px\\\">Intake & optional tests</h4>\\n        <p class=\\\"hint\\\">We may recommend targeted labs to clarify clinical questions. Tests are optional and chosen when they will influence care. Costs vary and are billed separately.</p>\\n\\n        <h4 style=\\\"margin-top:14px\\\">Fees</h4>\\n        <p class=\\\"hint\\\">Discovery Visit: typical fee is $150. Follow-ups and extended visits follow our published pricing; see the Care Plans page for details.</p>\\n\\n        <div style=\\\"margin-top:16px\\\">\\n          <strong>Need help?</strong>\\n          <p class=\\\"hint\\\">Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></p>\\n        </div>\\n\\n        <div style=\\\"margin-top:10px;text-align:center\\\"><a href=\\\"pricing.html\\\" style=\\\"display:inline-block;background:var(--accent);color:#fff;padding:8px 12px;border-radius:8px;text-decoration:none\\\">View plans & pricing</a></div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:20px\\\" class=\\\"panel\\\">\\n      <h3 style=\\\"margin-top:0\\\">Helpful notes before your first visit</h3>\\n      <ul class=\\\"hint\\\">\\n        <li>Gather a list of current medications and supplements.</li>\\n        <li>Note key symptoms, sleep patterns, and typical meals.</li>\\n        <li>If you have recent labs, have copies ready to upload.</li>\\n      </ul>\\n      <p class=\\\"hint\\\">Our care emphasizes education and stepwise changes. Outcomes vary by individual; we do not promise cures but offer guidance to support better health.</p>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"text-align:center;padding:18px;color:var(--muted)\\\">{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</footer>\\n</body>\\n</html>\"} \n{\"path\":\"assets/img/pattern.svg\",\"content\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"240\\\" height=\\\"240\\\" viewBox=\\\"0 0 240 240\\\">\\n  <defs>\\n    <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n      <stop offset=\\\"0\\\" stop-color=\\\"#e6fff8\\\" />\\n      <stop offset=\\\"1\\\" stop-color=\\\"#d9f7ef\\\" />\\n    </linearGradient>\\n    <pattern id=\\\"p\\\" width=\\\"60\\\" height=\\\"60\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(12)\\\">\\n      <rect width=\\\"60\\\" height=\\\"60\\\" fill=\\\"url(#g1)\\\" />\\n      <circle cx=\\\"10\\\" cy=\\\"10\\\" r=\\\"4\\\" fill=\\\"#bff1e6\\\" fill-opacity=\\\"0.9\\\" />\\n      <circle cx=\\\"50\\\" cy=\\\"50\\\" r=\\\"3\\\" 