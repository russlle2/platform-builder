          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Offerings & Pricing — {{BUSINESS_NAME}}</title>\\n  <meta name='description' content='Series, workshops, and guided gatherings for whole-person health.'>\\n  <style>\\n    :root{--accent:#6aa84f;--accent-2:#3d85c6;--muted:#6b7280;--bg:#0f1724;--card:#0b1220}\\n    *{box-sizing:border-box}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial;color:#e6eef7;background:linear-gradient(160deg,#071428 0%,#052035 50%,#062b2d 100%);-webkit-font-smoothing:antialiased}\\n    header{position:sticky;top:0;z-index:20;background:linear-gradient(180deg,rgba(2,6,23,0.6),rgba(2,6,23,0.3));backdrop-filter:blur(6px);padding:14px 28px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,0.03)}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:46px;height:46px;border-radius:10px;display:grid;place-items:center;color:white;font-weight:700;background:linear-gradient(135deg,var(--accent),var(--accent-2));box-shadow:0 6px 18px rgba(10,20,40,0.45)}\\n    nav a{color:rgba(230,238,247,0.9);text-decoration:none;margin-left:18px;font-weight:600;font-size:14px}\\n    nav a[href='pricing.html']{opacity:1}\\n\\n    .wrap{max-width:1100px;margin:36px auto;padding:32px;position:relative}\\n\\n    /* diagonal split hero */\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:28px;align-items:stretch}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border-radius:14px;padding:28px;color:#eaf5ff;position:relative;overflow:hidden;border:1px solid rgba(255,255,255,0.03)}\\n    .hero .left{padding:40px 36px;min-height:220px}\\n    .kicker{color:var(--accent);font-weight:700;letter-spacing:0.06em;font-size:13px}\\n    h1{margin:10px 0 6px;font-size:34px;line-height:1.05}\\n    p.lead{color:#cfe8ff;margin:0 0 18px}\\n\\n    /* small SVG pattern as background via data URI */\\n    .pattern-clip{position:absolute;inset:0;pointer-events:none;opacity:0.12}\\n\\n    .hero .right{background:linear-gradient(135deg,rgba(61,133,198,0.09),rgba(106,168,79,0.06));display:flex;flex-direction:column;gap:12px;align-items:flex-start}\\n    .price-badge{background:rgba(255,255,255,0.03);padding:12px;border-radius:10px;width:100%;display:flex;justify-content:space-between;align-items:center}\\n    .price-badge strong{font-size:18px}\\n\\n    /* sections */\\n    section{margin-top:22px}\\n    h2{font-size:20px;margin:0 0 8px;color:#e7f6ff}\\n    .muted{color:var(--muted);font-size:14px}\\n    ul.habits{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;padding:0;margin:12px 0 0;list-style:none}\\n    ul.habits li{background:rgba(255,255,255,0.02);padding:10px;border-radius:8px;font-size:14px}\\n\\n    .tiers{display:flex;gap:12px;margin-top:12px}\\n    .tier{flex:1;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:16px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .tier h3{margin:0 0 8px;font-size:16px}\\n    .cta{display:inline-block;background:linear-gradient(90deg,var(--accent),var(--accent-2));color:#04202a;padding:12px 18px;border-radius:10px;font-weight:700;border:none;cursor:pointer;text-decoration:none}\\n    footer{margin:36px 0 80px;color:#9fb3c6;text-align:center}\\n\\n    /* responsive */\\n    @media(max-width:900px){\\n      .hero{grid-template-columns:1fr;}\\n      nav a{margin-left:12px;font-size:13px}\\n      .wrap{padding:18px}\\n      ul.habits{grid-template-columns:1fr}\\n      .tiers{flex-direction:column}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class='brand'>\\n      <div class='logo'>HM</div>\\n      <div style='line-height:1'>\\n        <div style='font-weight:700;color:#eaf5ff'>{{BUSINESS_NAME}}</div>\\n        <div style='font-size:13px;color:#9fb3c6'>{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='services.html'>Offerings</a>\\n      <a href='conditions.html'>Concerns</a>\\n      <a href='approach.html'>Method</a>\\n      <a href='pricing.html'>Prices</a>\\n      <a href='about.html'>About</a>\\n      <a href='book.html'>Book</a>\\n      <a href='contact.html'>Reach</a>\\n    </nav>\\n  </header>\\n\\n  <main class='wrap'>\\n    <div class='hero'>\\n      <div class='card left'>\\n        <div class='kicker'>Gatherings • Workshops • Series</div>\\n        <h1>Learning in rhythm — group series for whole-person health</h1>\\n        <p class='lead'>We focus on teaching practical, evidence-informed habits and supportive rituals that move you toward steadier sleep, digestion, and calm. Events are educational and not medical guarantees.</p>\\n        <div style='display:flex;gap:12px;margin-top:18px'>\\n          <a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n          <a class='cta' href='about.html' style='background:transparent;border:1px solid rgba(255,255,255,0.06;color:var(--accent);padding:10px 14px'>Learn More</a>\\n        </div>\\n        <svg class='pattern-clip' width='100%' height='100%' viewBox='0 0 800 400' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n          <defs>\\n            <linearGradient id='g1' x1='0' x2='1'><stop offset='0' stop-color='#3d85c6' stop-opacity='0.12'/><stop offset='1' stop-color='#6aa84f' stop-opacity='0.06'/></linearGradient>\\n            <pattern id='p1' patternUnits='userSpaceOnUse' width='40' height='40' patternTransform='rotate(12)'>\\n              <rect width='20' height='40' fill='rgba(255,255,255,0.01)' />\\n              <circle cx='30' cy='20' r='2' fill='#ffffff' fill-opacity='0.06' />\\n            </pattern>\\n          </defs>\\n          <rect x='0' y='0' width='100%' height='100%' fill='url(#p1)' />\\n          <path d='M0 350 L800 120 L800 400 L0 400 Z' fill='url(#g1)' opacity='0.18'></path>\\n        </svg>\\n      </div>\\n\\n      <aside class='card right'>\\n        <div class='price-badge'><strong>Series Pass</strong><span style='color:#cfe8ff'>4 sessions — ongoing learning</span></div>\\n        <p class='muted' style='margin-top:12px'>Choose a format: live workshop, weekly cohort, or self-paced companion materials. All include guided practices and take-home resources.</p>\\n        <div class='tiers'>\\n          <div class='tier'>\\n            <h3>Intro Seminar</h3>\\n            <div class='muted'>Single 2-hr evening session</div>\\n            <p style='margin-top:10px;font-weight:700'>$49</p>\\n          </div>\\n          <div class='tier'>\\n            <h3>Series Pass</h3>\\n            <div class='muted'>4-week cohort, weekly 90-min meetings</div>\\n            <p style='margin-top:10px;font-weight:700'>$199</p>\\n          </div>\\n          <div class='tier'>\\n            <h3>Practitioner Roundtable</h3>\\n            <div class='muted'>Limited seats, interactive Q&amp;A</div>\\n            <p style='margin-top:10px;font-weight:700'>$349</p>\\n          </div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section id='diagnostic' class='card'>\\n      <h2>How we explore what matters</h2>\\n      <p class='muted'>Education begins with gentle assessment. Before a series we invite a short intake questionnaire and a one-on-one check-in so the material fits your context. Optional laboratory testing may be discussed as educational tools — not mandates — to help you and your practitioner better understand patterns in sleep, digestion, inflammation, and energy.</p>\\n      <p class='muted' style='margin-top:8px;font-size:13px'>Note: workshops are educational and supportive. They do not replace individualized medical advice. If you have urgent medical concerns, please consult your primary care clinician.</p>\\n    </section>\\n\\n    <section id='plan' class='card'>\\n      <h2>What a series looks like</h2>\\n      <ul class='muted'>\\n        <li>Week 1 — Foundations: rhythm, breathing, and sleep habits.</li>\\n        <li>Week 2 — Gut & nutrition patterns: simple changes with measurable effects.</li>\\n        <li>Week 3 — Stress-science: tools to calm the nervous system.</li>\\n        <li>Week 4 — Integration: building a personalized plan and next steps.</li>\\n      </ul>\\n    </section>\\n\\n    <section id='micro_habits' class='card'>\\n      <h2>Tiny habits we teach (start today)</h2>\\n      <ul class='habits'>\\n        <li>Evening wind-down: 30-min low light, no screens</li>\\n        <li>Micro-breaths: 4-4-6 pattern, twice daily</li>\\n        <li>Gentle gut reset: 2-day mindful eating practice</li>\\n        <li>Energy check-ins: brief mid-day pause</li>\\n      </ul>\\n    </section>\\n\\n    <section id='pricing' class='card'>\\n      <h2>Transparent pricing & policy</h2>\\n      <p class='muted'>Our events emphasize skill-building and group learning. Pricing above includes materials and access to recordings (when available). Scholarships or sliding scale options may be offered for community sessions — inquire by email at {{EMAIL}}.</p>\\n      <p class='muted' style='margin-top:8px'>No promises of cure are made; programs are educational and supportive components of a whole-person approach.</p>\\n    </section>\\n\\n    <section class='card' style='display:flex;gap:16px;align-items:center;justify-content:space-between'>\\n      <div>\\n        <h2>Reserve a spot</h2>\\n        <p class='muted'>Seats fill quickly. Join a cohort to deepen learning with peers and guided practice.</p>\\n      </div>\\n      <div style='text-align:right'>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n        <div class='muted' style='margin-top:8px;font-size:13px'>Questions? Call {{PHONE}} or email <a href='mailto:{{EMAIL}}' style='color:#cfe8ff;text-decoration:none'>{{EMAIL}}</a></div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}} • Practitioner: {{PRACTITIONER_NAME}} {{CREDENTIALS}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name='description' content='Our philosophy and approach to integrative, whole-person care.'>\\n  <style>\\n    :root{--bg:#061421;--soft:#dff3ff;--accent:#7b61ff;--accent-2:#44c2b0}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;color:#e8f5ff;background:linear-gradient(180deg,#021018 0%,#051926 60%);-webkit-font-smoothing:antialiased}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 28px;background:rgba(3,6,12,0.25);backdrop-filter:blur(6px);position:sticky;top:0}\\n    .logo{display:flex;gap:12px;align-items:center}\\n    .logo div{width:44px;height:44;border-radius:10px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:grid;place-items:center;font-weight:800;color:#051622}\\n    nav a{color:#cdefff;text-decoration:none;margin-left:14px;font-weight:600}\\n\\n    .container{max-width:980px;margin:36px auto;padding:26px}\\n    .intro{display:grid;grid-template-columns:1fr 320px;gap:20px}\\n    .bio{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:22px;border-radius:12px}\\n    .side{padding:20px;border-radius:12px;background:linear-gradient(135deg,rgba(123,97,255,0.06),rgba(68,194,176,0.04))}\\n    h1{margin:0 0 6px}\\n    .tag{color:#bfeaf0}\\n    p{color:#cfe8ff}\\n\\n    /* SVG background unique to this page */\\n    .svg-hero{height:140px;border-radius:10px;overflow:hidden;margin-top:12px}\\n    .svg-hero svg{width:100%;height:100%;display:block}\\n\\n    section{margin-top:18px}\\n    h2{color:#e8fbff}\\n    .muted{color:#9fb3c6}\\n    ul{margin:8px 0 0;padding-left:18px;color:#cfe8ff}\\n\\n    .cta{display:inline-block;background:linear-gradient(90deg,var(--accent),var(--accent-2));padding:10px 14px;border-radius:10px;color:#061421;font-weight:800;text-decoration:none}\\n\\n    @media(max-width:880px){.intro{grid-template-columns:1fr}.side{order:2}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class='logo'>\\n      <div>HM</div>\\n      <div style='line-height:1'>\\n        <div style='font-weight:700'>{{BUSINESS_NAME}}</div>\\n        <div style='font-size:13px;color:#9fb3c6'>A calm, curious practice</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href='index.html'>Root</a>\\n      <a href='services.html'>What We Do</a>\\n      <a href='conditions.html'>Concerns</a>\\n      <a href='approach.html'>How We Work</a>\\n      <a href='pricing.html'>Fees</a>\\n      <a href='about.html'>Story</a>\\n      <a href='book.html'>Schedule</a>\\n      <a href='contact.html'>Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class='container'>\\n    <div class='intro'>\\n      <article class='bio'>\\n        <div class='tag'>Our orientation</div>\\n        <h1>Whole-person medicine, taught and practiced</h1>\\n        <p class='muted'>We weave science, lifestyle, and lived experience into approachable learning. Our events and consultations focus on practical shifts in sleep, digestion, stress regulation, and steady energy — always educational, always collaborative.</p>\\n        <div class='svg-hero'>\\n          <svg viewBox='0 0 800 140' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n            <defs>\\n              <linearGradient id='ag' x1='0' x2='1'><stop offset='0' stop-color='#7b61ff' stop-opacity='0.12'/><stop offset='1' stop-color='#44c2b0' stop-opacity='0.12'/></linearGradient>\\n            </defs>\\n            <rect width='100%' height='100%' fill='rgba(255,255,255,0.01)' />\\n            <path d='M0 80 Q160 10 320 80 T640 80 T800 60 L800 140 L0 140 Z' fill='url(#ag)' opacity='0.24'></path>\\n          </svg>\\n        </div>\\n      </article>\\n\\n      <aside class='side'>\\n        <div style='font-weight:700;color:#eaf6ff'>Meet the practitioner</div>\\n        <p style='margin:6px 0 0'><strong>{{PRACTITIONER_NAME}}</strong><span style='color:#9fb3c6'> {{CREDENTIALS}}</span></p>\\n        <p class='muted' style='margin-top:6px'>Years of integrative work with adults and communities. Teaching-led offerings, thoughtful one-on-ones, and small cohorts.</p>\\n        <div style='margin-top:12px'>\\n          <a class='cta' href='book.html'>Reserve a consult or cohort seat</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section id='diagnostic' class='bio'>\\n      <h2>Listening first</h2>\\n      <p class='muted'>We begin with an intake: story, patterns, and goals. For some people optional labs may be introduced as teaching tools to clarify patterns in sleep, digestion, or inflammation. These are shared to inform education and planning, not as promises of cure.</p>\\n    </section>\\n\\n    <section id='micro_habits' class='bio'>\\n      <h2>Daily practices that quiet the mind</h2>\\n      <ul>\\n        <li>Short morning breath & grounding</li>\\n        <li>Consistent evening cues: light, sound, and ritual</li>\\n        <li>Two-minute post-meal pause to notice digestion</li>\\n      </ul>\\n    </section>\\n\\n    <section id='plan' class='bio'>\\n      <h2>How plans are shaped</h2>\\n      <p class='muted'>We co-design goals: modest, measurable steps that align with your life. In series formats we layer skills across sessions; in one-on-one visits we build personalized experiments and follow-ups.</p>\\n    </section>\\n\\n    <section id='pricing' class='bio'>\\n      <h2>Pricing & access</h2>\\n      <p class='muted'>Events are priced per-session or as a series pass. Sliding scale options and community spots are available when possible — email {{EMAIL}} to inquire. All programming centers education and self-directed learning; please contact your medical provider for urgent medical matters.</p>\\n    </section>\\n\\n    <section class='bio' style='display:flex;justify-content:space-between;align-items:center'>\\n      <div>\\n        <h2>Stay in touch</h2>\\n        <p class='muted'>Questions about an upcoming series? Want to request a workplace workshop in {{CITY}}, {{STATE}}? We can help shape the content.</p>\\n      </div>\\n      <div style='text-align:right'>\\n        <a class='cta' href='mailto:{{EMAIL}}'>Email us</a>\\n        <div class='muted' style='margin-top:8px'>Or call {{PHONE}}</div>\\n      </div>\\n    </section>\\n\\n    <footer style='margin-top:30px;text-align:center;color:#9fb3c6'>\\n      <div>{{BUSINESS_NAME}} • {{PRACTITIONER_NAME}} {{CREDENTIALS}} • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Schedule & Book — {{BUSINESS_NAME}}</title>\\n  <meta name='description' content='Reserve a spot in a series or book a consult.'>\\n  <style>\\n    :root{--bg:#07121a;--glass:rgba(255,255,255,0.03);--accent:#ffb86b;--accent-2:#6bd3c0}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;color:#eaf6ff;background:linear-gradient(160deg,#031018, #05202a);-webkit-font-smoothing:antialiased}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:16px 24px;background:linear-gradient(180deg,rgba(0,0,0,0.2),transparent);position:sticky;top:0}\\n    .logo{display:flex;gap:12px;align-items:center}\\n    .logo div{width:40px;height:40px;border-radius:8px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:grid;place-items:center;font-weight:800;color:#051622}\\n    nav a{color:#dff4ff;text-decoration:none;margin-left:12px}\\n\\n    .sheet{max-width:980px;margin:28px auto;padding:22px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:18px}\\n    .panel{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    h1{margin:0 0 6px}\\n    .muted{color:#a9c6cf}\\n\\n    /* unique svg motif */\\n    .hero-pattern{height:88px;border-radius:10px;overflow:hidden;margin-top:10px}\\n\\n    form{display:flex;flex-direction:column;gap:10px}\\n    input,select,textarea{background:transparent;border:1px solid rgba(255,255,255,0.06);padding:10px;border-radius:8px;color:#eaf6ff}\\n    label{font-size:13px;color:#bfeef6}\\n    .btn{background:linear-gradient(90deg,var(--accent),var(--accent-2));padding:12px;border-radius:10px;border:none;color:#051622;font-weight:800;cursor:pointer}\\n\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}.hero-pattern{height:60px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class='logo'>\\n      <div>HM</div>\\n      <div style='line-height:1'>\\n        <div style='font-weight:700'>{{BUSINESS_NAME}}</div>\\n        <div style='font-size:13px;color:#9fb3c6'>Book a spot or consult</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href='index.html'>Nest</a>\\n      <a href='services.html'>Services</a>\\n      <a href='conditions.html'>Issues</a>\\n      <a href='approach.html'>Approach</a>\\n      <a href='pricing.html'>Rates</a>\\n      <a href='about.html'>Care Team</a>\\n      <a href='book.html'>Reserve</a>\\n      <a href='contact.html'>Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main class='sheet'>\\n    <div class='grid'>\\n      <div class='panel'>\\n        <h1>Reserve your place in a cohort or schedule a consult</h1>\\n        <p class='muted'>Choose a series seat or a focused one-on-one. Gatherings emphasize education and practical skills; consultations are for personalized planning.</p>\\n\\n        <div class='hero-pattern'>\\n          <svg viewBox='0 0 800 88' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n            <defs>\\n              <linearGradient id='lg' x1='0' x2='1'><stop offset='0' stop-color='#ffb86b' stop-opacity='0.14'/><stop offset='1' stop-color='#6bd3c0' stop-opacity='0.14'/></linearGradient>\\n            </defs>\\n            <rect width='100%' height='100%' fill='rgba(255,255,255,0.01)' />\\n            <g opacity='0.22' fill='url(#lg)'>\\n              <circle cx='60' cy='40' r='36'/>\\n              <rect x='160' y='18' width='260' height='54' rx='8'/>\\n              <path d='M480 70 L680 20 L800 60 L800 88 L480 88 Z'/>\\n            </g>\\n          </svg>\\n        </div>\\n\\n        <section id='micro_habits' style='margin-top:12px'>\\n          <h2 style='margin:0 0 6px'>Tiny practices included with series</h2>\\n          <p class='muted'>Every cohort includes a short toolkit: breathing, evening ritual, and a simple food pattern to try between sessions.</p>\\n        </section>\\n\\n        <section id='plan' style='margin-top:12px'>\\n          <h2 style='margin:0 0 6px'>Booking options</h2>\\n          <ul style='color:#cfe8ff;margin:6px 0 0;padding-left:18px'>\\n            <li>One-off workshop — single session</li>\\n            <li>4-week series pass — weekly meetings + materials</li>\\n            <li>Private consult — 45 or 75 minutes</li>\\n          </ul>\\n        </section>\\n\\n        <section id='diagnostic' style='margin-top:12px'>\\n          <h2 style='margin:0 0 6px'>Pre-visit intake</h2>\\n          <p class='muted'>After you reserve, we'll send a short intake to tailor the content to your needs. Optional labs may be discussed as learning tools during a consult; these are never required.</p>\\n        </section>\\n      </div>\\n\\n      <aside class='panel'>\\n        <h3 style='margin:0 0 8px'>Book now</h3>\\n        <form action='{{PRIMARY_CTA_URL}}' method='get'>\\n          <label for='name'>Full name</label>\\n          <input id='name' name='name' placeholder='Your name' required />\\n\\n          <label for='email'>Email</label>\\n          <input id='email' name='email' type='email' placeholder='you@example.com' required />\\n\\n          <label for='type'>Select</label>\\n          <select id='type' name='type'>\\n            <option value='series'>Series pass</option>\\n            <option value='workshop'>Workshop</option>\\n            <option value='consult'>Private consult</option>\\n          </select>\\n\\n          <label for='note'>Notes (goals or concerns)</label>\\n          <textarea id='note' name='note' rows='3' placeholder='Anything you want us to know'></textarea>\\n\\n          <button class='btn' type='submit'>{{PRIMARY_CTA_LABEL}}</button>\\n        </form>\\n\\n        <div style='margin-top:14px;color:#a9c6cf;font-size:13px'>\\n          <div>Questions? Call <strong style='color:#eaf6ff'>{{PHONE}}</strong> or email <a href='mailto:{{EMAIL}}' style='color:#eaf6ff;text-decoration:none'>{{EMAIL}}</a></div>\\n          <div style='margin-top:8px;color:#9fb3c6;font-size:12px'>Workshops are educational and supportive, not a substitute for urgent medical care.</div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer style='margin-top:22px;text-align:center;color:#9fb3c6'>\\n      <div>{{BUSINESS_NAME}} • {{PRACTITIONER_NAME}} {{CREDENTIALS}} • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
