          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investment & Packages — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#f7fff7;--bg2:#eef6ff;--accent:#5aa897;--muted:#6b6b6b;--card:#ffffff;--glass:rgba(255,255,255,0.6)}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;line-height:1.5;color:#123; background:linear-gradient(135deg,var(--bg1),var(--bg2));min-height:100vh;display:flex;flex-direction:column}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:24px 6vw}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:52px;height:52px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#7ad3c4);display:grid;place-items:center;color:white;font-weight:700}\\n    nav a{margin-left:18px;color:#064; text-decoration:none;font-weight:600}\\n    .hero{padding:36px 6vw 24px;display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center}\\n    .hero-card{background:var(--card);border-radius:16px;padding:28px;box-shadow:0 10px 30px rgba(17,24,39,0.06)}\\n    h1{margin:0 0 8px;font-size:28px}\\n    p.lead{margin:0;color:var(--muted)}\\n    /* inline SVG pattern as decorative element */\\n    .pattern-wrap{position:relative}\\n    .pattern{position:absolute;right:-60px;top:-40px;opacity:0.12;width:420px;height:420px;transform:rotate(12deg)}\\n    /* sections */\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:22px}\\n    .card{background:linear-gradient(180deg,var(--glass),rgba(255,255,255,0.3));padding:18px;border-radius:12px;backdrop-filter: blur(6px);box-shadow:0 6px 18px rgba(10,20,20,0.04)}\\n    .price{font-size:24px;font-weight:800;color:#063;}\\n    .muted{color:var(--muted);font-size:14px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#3fbdb1);color:white;text-decoration:none;font-weight:700}\\n    .small{font-size:13px}\\n    footer{margin-top:auto;padding:28px 6vw;color:var(--muted);font-size:14px}\\n    /* responsive */\\n    @media (max-width:900px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}} \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"approach.html\\\">My Process</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <h1>Pricing built for focused, integrative change</h1>\\n        <p class=\\\"lead\\\">You deserve an intentional, supportive plan that looks at lifestyle, labs, and long-term resilience. Choose a pacing that fits your life—everything below centers education and whole-person care, not quick fixes.</p>\\n        <div style=\\\"margin-top:18px;display:flex;gap:12px;align-items:center\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <div style=\\\"color:var(--muted);font-size:13px\\\">or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:inherit\\\">{{PHONE}}</a></div>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"position:relative\\\">\\n        <div class=\\\"card\\\" style=\\\"padding:20px\\\">\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">Personalized paths — intensive support</div>\\n          <div style=\\\"margin-top:8px\\\">\\n            <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n              <div>\\n                <div style=\\\"font-weight:800\\\">Focused Reset — 8 weeks</div>\\n                <div class=\\\"small muted\\\">For acute overwhelm, sleep reset, or digestive re-education</div>\\n              </div>\\n              <div class=\\\"price\\\">$1,200</div>\\n            </div>\\n            <a class=\\\"cta\\\" href=\\\"book.html\\\" style=\\\"display:inline-block;margin-top:12px\\\">Reserve a spot</a>\\n          </div>\\n        </div>\\n        <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n          <defs>\\n            <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n              <stop offset=\\\"0\\\" stop-color=\\\"#7ad3c4\\\"/>\\n              <stop offset=\\\"1\\\" stop-color=\\\"#b6f0e8\\\"/>\\n            </linearGradient>\\n            <pattern id=\\\"p1\\\" width=\\\"20\\\" height=\\\"20\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n              <rect width=\\\"10\\\" height=\\\"10\\\" fill=\\\"url(#g1)\\\"/>\\n              <rect x=\\\"10\\\" y=\\\"10\\\" width=\\\"10\\\" height=\\\"10\\\" fill=\\\"#ffffff\\\" opacity=\\\"0.08\\\"/>\\n            </pattern>\\n          </defs>\\n          <rect width=\\\"200\\\" height=\\\"200\\\" fill=\\\"url(#p1)\\\" rx=\\\"20\\\"/>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <!-- story: why this pricing exists -->\\n    <section style=\\\"padding:28px 6vw;display:flex;gap:24px;flex-wrap:wrap;align-items:flex-start\\\">\\n      <div style=\\\"flex:1;min-width:260px\\\">\\n        <h2 style=\\\"margin-top:0\\\">Why a staged investment?</h2>\\n        <p class=\\\"muted\\\">Health happens over time. Intensive packages give frequent touchpoints for behavior change, optional evidence-based labs, and adjustable plans. Everything I offer emphasizes learning, measurable goals, and shared decision-making.</p>\\n      </div>\\n      <div style=\\\"width:320px\\\" class=\\\"card\\\">\\n        <div style=\\\"font-weight:800\\\">What's included in intensives</div>\\n        <ul style=\\\"margin:8px 0 0;padding-left:18px;color:var(--muted)\\\">\\n          <li>Comprehensive intake & individualized plan</li>\\n          <li>Weekly check-ins and focused coaching</li>\\n          <li>Educational resources and lifestyle tools</li>\\n          <li>Optional lab guidance (as an educational support)</li>\\n        </ul>\\n      </div>\\n    </section>\\n\\n    <!-- offers: other options -->\\n    <section style=\\\"padding:0 6vw 28px;\\\">\\n      <h3 style=\\\"margin-bottom:8px\\\">Other ways to work together</h3>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"card\\\">\\n          <div style=\\\"font-weight:700\\\">Single Consult</div>\\n          <div class=\\\"muted small\\\">A 60-minute initial meeting — ideal for one-off guidance or a focused next step.</div>\\n          <div style=\\\"margin-top:12px;\\\" class=\\\"price\\\">$220</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <div style=\\\"font-weight:700\\\">3-Session Starter</div>\\n          <div class=\\\"muted small\\\">Short-term support to address a specific concern and build momentum.</div>\\n          <div style=\\\"margin-top:12px;\\\" class=\\\"price\\\">$580</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <div style=\\\"font-weight:700\\\">Maintenance — Monthly</div>\\n          <div class=\\\"muted small\\\">Ongoing monthly support for people already in a plan who want continuity.</div>\\n          <div style=\\\"margin-top:12px;\\\" class=\\\"price\\\">$220 / mo</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- testimonials -->\\n    <section style=\\\"padding:0 6vw 28px;\\\">\\n      <h3>Words from people who focused on habits</h3>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:16px\\\">\\n        <blockquote class=\\\"card\\\" style=\\\"margin:0\\\">\\\"I finally learned how to track small wins. The plan felt realistic and supportive, not scary.\\\"<div style=\\\"margin-top:8px;font-weight:700\\\">— {{PRACTITIONER_NAME}}'s client</div></blockquote>\\n        <blockquote class=\\\"card\\\" style=\\\"margin:0\\\">\\\"The educational approach made labs understandable. I made changes that stuck.\\\"<div style=\\\"margin-top:8px;font-weight:700\\\">— Satisfied patient</div></blockquote>\\n      </div>\\n    </section>\\n\\n    <!-- fine print / pricing section -->\\n    <section style=\\\"padding:8px 6vw 40px;\\\">\\n      <div class=\\\"card\\\" style=\\\"padding:14px\\\">\\n        <div style=\\\"font-weight:700\\\">A note on expectations</div>\\n        <p class=\\\"muted small\\\">Holistic and integrative care focuses on whole-person education, lifestyle, and evidence-informed options. Results vary by individual; no program promises cure. Optional labs are discussed for education and context, not as mandatory tests.</p>\\n      </div>\\n    </section>\\n\\n    <!-- cta -->\\n    <section style=\\\"padding:0 6vw 60px;display:flex;align-items:center;gap:18px;flex-wrap:wrap\\\">\\n      <div style=\\\"flex:1;min-width:220px\\\">\\n        <h3 style=\\\"margin:0\\\">Ready to choose a path?</h3>\\n        <p class=\\\"muted\\\">Book a discovery call to find the best intensity for your goals.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start the conversation</a>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px\\\">\\n      <div>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}}</div>\\n      <div>Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> · <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffdfb;--teal:#4daaa0;--ink:#163d3a;--muted:#6b6b6b}\\n    body{margin:0;font-family:Inter,Arial,Helvetica,sans-serif;color:var(--ink);background:linear-gradient(180deg,var(--bg),#f1f8f6);min-height:100vh}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 6vw}\\n    .logo{display:flex;align-items:center;gap:12px}\\n    .logo div{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,#6bd0c3,#4daaa0);color:white;display:grid;place-items:center;font-weight:800}\\n    nav a{margin-left:16px;text-decoration:none;color:var(--ink);font-weight:600}\\n    .hero{padding:28px 6vw 14px;display:flex;gap:22px;align-items:center}\\n    .portrait{width:160px;height:160px;border-radius:18px;background:linear-gradient(180deg,#ffffff,#f3fbfa);box-shadow:0 8px 30px rgba(13,20,20,0.06);display:grid;place-items:center;font-weight:700}\\n    h1{margin:0;font-size:30px}\\n    p.lead{color:var(--muted);margin:8px 0 0}\\n    .sections{padding:18px 6vw;display:grid;grid-template-columns:1fr 340px;gap:24px}\\n    .story{background:white;border-radius:14px;padding:18px;box-shadow:0 6px 18px rgba(17,24,39,0.04)}\\n    .side{display:flex;flex-direction:column;gap:12px}\\n    .pill{background:linear-gradient(90deg,#aef0e1,#bfeff4);padding:10px;border-radius:10px;font-weight:700;color:#064}\\n    footer{padding:26px 6vw;color:var(--muted)}\\n    @media (max-width:880px){.hero{flex-direction:column;align-items:flex-start}.sections{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">\\n      <div>HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Overview</a>\\n      <a href=\\\"services.html\\\">Care</a>\\n      <a href=\\\"contact.html\\\">Reach out</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Meet {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</h1>\\n        <p class=\\\"lead\\\">I blend integrative tools, education, and deep listening to support sustainable health. My work centers practical habits, lab-informed decisions, and compassionate partnership.</p>\\n        <div style=\\\"margin-top:12px\\\"><a href=\\\"book.html\\\" style=\\\"padding:10px 14px;background:linear-gradient(90deg,#4daaa0,#6bd0c3);color:white;border-radius:10px;text-decoration:none;font-weight:700\\\">Book a discovery call</a></div>\\n      </div>\\n      <div class=\\\"portrait\\\">{{PRACTITIONER_NAME}}</div>\\n    </section>\\n\\n    <!-- framework: how this practice works, order differs from pricing page -->\\n    <section class=\\\"sections\\\">\\n      <div class=\\\"story\\\">\\n        <h2 style=\\\"margin-top:0\\\">A human-first framework</h2>\\n        <p class=\\\"muted\\\">My approach has four guiding moves: understand, educate, co-create, and iterate. That means a thorough intake, shared planning, optional educational labs, and regular check-ins to adapt the plan.</p>\\n\\n        <h3 style=\\\"margin-bottom:6px\\\">Intake & discovery</h3>\\n        <p class=\\\"small muted\\\">We gather history, current habits, and priorities. This is a two-way learning moment — I show you the \\\"why\\\" behind recommendations.</p>\\n\\n        <h3 style=\\\"margin-bottom:6px\\\">Plan & partner</h3>\\n        <p class=\\\"small muted\\\">Plans are co-created and scaled to fit your life. We emphasize practical changes that build momentum and measurable markers for progress.</p>\\n\\n        <h3 style=\\\"margin-bottom:6px\\\">Follow-up & tweak</h3>\\n        <p class=\\\"small muted\\\">Routine check-ins let us see what's working and refine steps. We use data, symptoms, and your lived experience to iterate.</p>\\n      </div>\\n\\n      <aside class=\\\"side\\\">\\n        <div class=\\\"pill\\\">Education-first: no smoke-and-mirror promises</div>\\n        <div style=\\\"background:white;padding:12px;border-radius:12px;box-shadow:0 6px 18px rgba(17,24,39,0.04)\\\">\\n          <div style=\\\"font-weight:800\\\">Credentials</div>\\n          <div class=\\\"muted small\\\">{{CREDENTIALS}}</div>\\n        </div>\\n        <div style=\\\"background:white;padding:12px;border-radius:12px;box-shadow:0 6px 18px rgba(17,24,39,0.04)\\\">\\n          <div style=\\\"font-weight:800\\\">Practice values</div>\\n          <ul class=\\\"muted small\\\" style=\\\"margin:8px 0 0;padding-left:18px\\\">\\n            <li>Whole-person focus</li>\\n            <li>Shared decision making</li>\\n            <li>Evidence-informed options</li>\\n          </ul>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <!-- offers: personal note about services, different order and voice -->\\n    <section style=\\\"padding:12px 6vw;display:flex;gap:18px;flex-wrap:wrap;align-items:center\\\">\\n      <div style=\\\"flex:1;min-width:260px\\\">\\n        <h3 style=\\\"margin:0\\\">How I typically work</h3>\\n        <p class=\\\"muted\\\">Short consults, 8-week intensives, or ongoing maintenance—each built to teach and support sustainable changes rather than one-off fixes.</p>\\n      </div>\\n      <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n        <a href=\\\"pricing.html\\\" style=\\\"padding:10px 12px;background:#4daaa0;color:white;border-radius:10px;text-decoration:none\\\">See pricing</a>\\n        <a href=\\\"book.html\\\" style=\\\"padding:10px 12px;border-radius:10px;background:transparent;border:1px solid #e4f3ef;text-decoration:none;color:var(--ink);font-weight:700\\\">Schedule</a>\\n      </div>\\n    </section>\\n\\n    <!-- testimonials (small) -->\\n    <section style=\\\"padding:0 6vw 22px;\\\">\\n      <h4 style=\\\"margin-bottom:8px\\\">Patient perspective</h4>\\n      <div style=\\\"display:flex;gap:12px;flex-wrap:wrap\\\">\\n        <div style=\\\"background:white;padding:12px;border-radius:12px;box-shadow:0 6px 18px rgba(17,24,39,0.04);flex:1;min-width:220px\\\">\\\"Clear guidance that respected my constraints and helped me sleep better.\\\"<div style=\\\"font-weight:700;margin-top:8px\\\">— a client</div></div>\\n        <div style=\\\"background:white;padding:12px;border-radius:12px;box-shadow:0 6px 18px rgba(17,24,39,0.04);flex:1;min-width:220px\\\">\\\"I appreciated learning the why behind suggestions.\\\"<div style=\\\"font-weight:700;margin-top:8px\\\">— another client</div></div>\\n      </div>\\n    </section>\\n\\n    <!-- cta: final invitation -->\\n    <section style=\\\"padding:12px 6vw 60px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap\\\">\\n      <div>\\n        <h3 style=\\\"margin:0\\\">Curious to explore options?</h3>\\n        <p class=\\\"muted\\\" style=\\\"margin:6px 0 0\\\">I offer a complimentary 15-minute call to see if we're a fit.</p>\\n      </div>\\n      <div>\\n        <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"padding:12px 16px;background:linear-gradient(90deg,#4daaa0,#7ee6d9);color:white;border-radius:12px;text-decoration:none;font-weight:800\\\">Book the intro</a>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"padding:18px 6vw;color:var(--muted)\\\">\\n      <div>{{BUSINESS_NAME}} · {{CITY}}, {{STATE}} · <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#ffffff;--accent:#6bd0c3;--ink:#042826;--muted:#586a67}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;color:var(--ink);background:linear-gradient(180deg,#f7fffc,#ffffff);min-height:100vh}\\n    header{padding:18px 6vw;display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:14px;color:var(--ink);text-decoration:none;font-weight:600}\\n    .wrap{max-width:980px;margin:18px auto;padding:0 6vw}\\n    .hero{background:linear-gradient(135deg,#f0fffb,#e6fbf7);padding:22px;border-radius:14px;display:flex;gap:20px;align-items:center}\\n    .form{background:white;padding:18px;border-radius:12px;box-shadow:0 8px 28px rgba(8,20,18,0.06);flex:1}\\n    label{display:block;font-weight:700;margin-bottom:6px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e7f4f0;margin-bottom:12px}\\n    .btn{display:inline-block;padding:10px 14px;background:linear-gradient(90deg,var(--accent),#4daaa0);color:white;border-radius:10px;text-decoration:none;font-weight:800}\\n    .aside{width:300px}\\n    .note{background:linear-gradient(90deg,#e6fbf7,#f7fff9);padding:12px;border-radius:10px;color:var(--muted)}\\n    .muted{color:var(--muted)}\\n    footer{padding:28px 6vw;color:var(--muted)}\\n    @media (max-width:940px){.hero{flex-direction:column}.aside{width:100%}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">Care</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"form\\\">\\n        <h1 style=\\\"margin:0 0 8px\\\">Schedule a conversation</h1>\\n        <p class=\\\"muted\\\" style=\\\"margin:0 0 12px\\\">Pick a time for a brief discovery call to discuss goals and which package fits best.</p>\\n\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" onsubmit=\\\"alert('This is a placeholder booking form. Replace with your scheduling integration.'); return false;\\\">\\n          <label for=\\\"name\\\">Your name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"First & last\\\" required>\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n\\n          <label for=\\\"phone\\\">Phone</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"Optional\\\">\\n\\n          <label for=\\\"session\\\">What would you like?</label>\\n          <select id=\\\"session\\\" name=\\\"session\\\">\\n            <option>15-min Intro (free)</option>\\n            <option>60-min Consultation</option>\\n            <option>8-week Intensive</option>\\n          </select>\\n\\n          <label for=\\\"notes\\\">A few words about your goals</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Sleep, stress, digestion, energy...\\\"></textarea>\\n\\n          <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n            <button class=\\\"btn\\\" type=\\\"submit\\\">Request booking</button>\\n            <div style=\\\"color:var(--muted);font-size:13px\\\">Or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:inherit\\\">{{PHONE}}</a></div>\\n          </div>\\n        </form>\\n\\n      </div>\\n\\n      <aside class=\\\"aside\\\">\\n        <div class=\\\"note\\\">\\n          <div style=\\\"font-weight:800\\\">Before you book</div>\\n          <p class=\\\"muted\\\" style=\\\"margin:8px 0 0\\\">Please note: sessions prioritize education, lifestyle strategies, and collaborative planning. There are no guaranteed cures. Optional labs are available for further information when appropriate.</p>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px;background:white;padding:12px;border-radius:12px;box-shadow:0 6px 18px rgba(17,24,39,0.04)\\\">\\n          <div style=\\\"font-weight:800\\\">Preparing for your call</div>\\n          <ul class=\\\"muted\\\" style=\\\"margin:8px 0 0;padding-left:18px\\\">\\n            <li>Note top 2-3 concerns</li>\\n            <li>Have a quick list of current meds/supps</li>\\n            <li>Think about what success looks like</li>\\n          </ul>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <!-- framework (brief) placed later in different tone -->\\n    <section style=\\\"margin-top:18px;display:grid;grid-template-columns:1fr 1fr;gap:16px\\\">\\n      <div style=\\\"background:white;padding:14px;border-radius:12px;box-shadow:0 6px 18px rgba(17,24,39,0.04)\\\">\\n        <h3 style=\\\"margin-top:0\\\">What happens next</h3>\\n        <ol class=\\\"muted\\\" style=\\\"padding-left:18px\\\">\\n          <li>We meet for the intro and clarify priorities.</li>\\n          <li>If we proceed, a focused intake forms the foundation.</li>\\n          <li>We co-create a plan and schedule first follow-ups.</li>\\n        </ol>\\n      </div>\\n      <div style=\\\"background:white;padding:14px;border-radius:12px;box-shadow:0 6px 18px rgba(17,24,39,0.04)\\\">\\n        <h3 style=\\\"margin-top:0\\\">Pricing highlights</h3>\\n        <p class=\\\"muted\\\">Intro is complimentary. Consults and intensives are priced to reflect frequent touchpoints, educational resources, and individualized planning. See the full fee page for details.</p>\\n        <a class=\\\"btn\\\" href=\\\"pricing.html\\\" style=\\\"display:inline-block;margin-top:10px\\\">View fees</a>\\n      </div>\\n    </section>\\n\\n    <!-- testimonials small -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h4 style=\\\"margin-bottom:8px\\\">From people who booked</h4>\\n      <div style=\\\"display:flex;gap:10px;flex-wrap:wrap\\\">\\n        <div style=\\\"background:linear-gradient(90deg,#f7fffd,#eefbf9);padding:12px;border-radius:10px;min-width:220px\\\">\\\"The intro helped me pick a realistic path.\\\"<div style=\\\"font-weight:700;margin-top:8px\\\">— a patient</div></div>\\n        <div style=\\\"background:linear-gradient(90deg,#f7fffd,#eefbf9);padding:12px;border-radius:10px;min-width:220px\\\">\\\"Clear next steps and no pressure.\\\"<div style=\\\"font-weight:700;margin-top:8px\\\">— another patient</div></div>\\n      </div>\\n    </section>\\n\\n    <!-- cta: final nudge -->\\n    <section style=\\\"margin:26px 0 60px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap\\\">\\n      <div>\\n        <h3 style=\\\"margin:0\\\">Still deciding?</h3>\\n        <p class=\\\"muted\\\" style=\\\"margin:6px 0 0\\\">Send a quick note and I'll reply within a business day.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"mailto:{{EMAIL}}\\\">Email {{PRACTITIONER_NAME}}</a>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:980px;margin:0 auto;padding:0 6vw 28px;color:var(--muted)\\\">{{BUSINESS_NAME}} · <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> · <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
