          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Fees & Plans — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#5A9A6F;--muted:#6b7280;--bg:#fbfdfb;--card:#ffffff;--glass:rgba(255,255,255,0.6)}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#0f172a;background:linear-gradient(180deg,#f7fff7 0%,var(--bg) 60%);} \\n    .site{min-height:100%;display:flex;flex-direction:column}\\n    header{position:relative;z-index:2;padding:28px 24px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:52px;height:52px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),#80c99b);color:#fff;font-weight:700}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none;font-weight:600}\\n    main{flex:1;position:relative;padding:36px 24px;max-width:1100px;margin:0 auto;width:100%}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;margin-top:18px}\\n    .hero-card{background:var(--card);padding:28px;border-radius:14px;box-shadow:0 6px 28px rgba(12,17,22,0.06)}\\n    h1{margin:0 0 10px 0;font-size:28px;color:#052018}\\n    p.lead{margin:0;color:var(--muted);line-height:1.5}\\n    .price-panel{background:linear-gradient(180deg,rgba(90,154,111,0.06),rgba(128,201,155,0.03));border-radius:12px;padding:18px}\\n    .tiers{display:flex;flex-direction:column;gap:12px;margin-top:18px}\\n    .tier{background:var(--glass);padding:14px;border-radius:10px;display:flex;justify-content:space-between;align-items:center}\\n    .cta{display:inline-block;padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none;font-weight:700}\\n    section{margin-top:28px}\\n    .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 4px 24px rgba(10,12,15,0.04)}\\n    footer{padding:28px;text-align:center;color:var(--muted);font-size:14px}\\n    .testimonials{display:flex;flex-direction:column;gap:12px}\\n    .testimonial{padding:12px;border-left:4px solid var(--accent);background:linear-gradient(90deg,#fff,rgba(250,255,250,0.7));border-radius:8px}\\n    /* subtle decorative SVG backdrop */\\n    .bg-svg{position:absolute;inset:0;z-index:0;pointer-events:none;opacity:0.65}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.grid-3{grid-template-columns:1fr}.brand .logo{width:44px;height:44px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">HM</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Our Care</a>\\n        <a href=\\\"approach.html\\\">Method</a>\\n        <a href=\\\"about.html\\\">Team</a>\\n        <a href=\\\"book.html\\\" style=\\\"color:var(--accent);\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 800 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" preserveAspectRatio=\\\"xMidYMid slice\\\">\\n      <defs>\\n        <linearGradient id=\\\"g1-1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#e8f8ee\\\" />\\n          <stop offset=\\\"1\\\" stop-color=\\\"#f7fff7\\\" />\\n        </linearGradient>\\n        <pattern id=\\\"p1\\\" width=\\\"120\\\" height=\\\"120\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(12)\\\">\\n          <rect width=\\\"60\\\" height=\\\"60\\\" fill=\\\"#f3f9f5\\\" />\\n          <rect x=\\\"60\\\" y=\\\"60\\\" width=\\\"60\\\" height=\\\"60\\\" fill=\\\"#f9fff9\\\" />\\n        </pattern>\\n      </defs>\\n      <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g1-1)\\\" />\\n      <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\" opacity=\\\"0.6\\\" />\\n      <g fill=\\\"none\\\" stroke=\\\"#d7efe0\\\" stroke-width=\\\"2\\\" opacity=\\\"0.9\\\">\\n        <path d=\\\"M40 520 C140 380, 300 560, 520 420\\\" />\\n        <path d=\\\"M-20 420 C120 300, 240 480, 720 320\\\" />\\n      </g>\\n    </svg>\\n\\n    <main>\\n      <div class=\\\"hero\\\">\\n        <div class=\\\"hero-card\\\">\\n          <h1>Transparent fees that back thoughtful care</h1>\\n          <p class=\\\"lead\\\">We design plans that center your whole-person needs: time, labs, lifestyle support and a clear roadmap. No promises of cure—only evidence-informed guidance and collaborative planning.</p>\\n\\n          <section style=\\\"margin-top:20px\\\">\\n            <h3 style=\\\"margin:0 0 8px 0\\\">Why many choose a VIP day</h3>\\n            <p style=\\\"margin:0;color:var(--muted);\\\">A focused, deep-dive evaluation and a tailored plan you can act on immediately. Ideal for people seeking an intensive, one-day reset plus written takeaways.</p>\\n          </section>\\n        </div>\\n\\n        <aside class=\\\"price-panel\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div style=\\\"font-size:12px;color:var(--muted);\\\">VIP Day</div>\\n              <div style=\\\"font-size:20px;font-weight:800;color:#05341f\\\">$1,800</div>\\n            </div>\\n            <div style=\\\"text-align:right\\\">\\n              <div style=\\\"font-size:12px;color:var(--muted)\\\">Includes:</div>\\n              <div style=\\\"font-size:12px;color:var(--muted)\\\">Intake, 6-8h session, plan, 30d follow-up</div>\\n            </div>\\n          </div>\\n          <div class=\\\"tiers\\\">\\n            <div class=\\\"tier\\\"><div>Extended Intake + Visit</div><div style=\\\"font-weight:700\\\">Included</div></div>\\n            <div class=\\\"tier\\\"><div>Comprehensive Plan</div><div style=\\\"font-weight:700\\\">Included</div></div>\\n            <div class=\\\"tier\\\"><div>30-day Email Support</div><div style=\\\"font-weight:700\\\">Optional</div></div>\\n          </div>\\n          <div style=\\\"margin-top:14px\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n        </aside>\\n      </div>\\n\\n      <section>\\n        <h2 style=\\\"margin:0 0 10px 0\\\">A la carte & payment options</h2>\\n        <p style=\\\"margin:0 0 18px 0;color:var(--muted)\\\">Not ready for a VIP Day? Choose hourly coaching, modular follow-ups, or a short plan. We accept major cards and offer flexible payment plans for multi-session packages.</p>\\n\\n        <div class=\\\"grid-3\\\">\\n          <div class=\\\"card\\\">\\n            <strong>Hourly Follow-up</strong>\\n            <p style=\\\"color:var(--muted);margin:8px 0 0\\\">45–60 minute visits for adjustments and ongoing coaching — $220</p>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <strong>Nutrition + Lifestyle Package</strong>\\n            <p style=\\\"color:var(--muted);margin:8px 0 0\\\">3 sessions + resources and meal scaffolding — $650</p>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <strong>Lab Review Add-on</strong>\\n            <p style=\\\"color:var(--muted);margin:8px 0 0\\\">Educational review of optional labs — starting at $120</p>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section>\\n        <h2 style=\\\"margin:0 0 10px 0\\\">How the pricing is structured</h2>\\n        <p style=\\\"color:var(--muted);margin:0\\\">Fees reflect extended visit time, clinical synthesis and written plans. Optional labs are billed separately by the lab provider. We emphasize shared decision-making about tests and interventions.</p>\\n      </section>\\n\\n      <section>\\n        <h2 style=\\\"margin:0 0 10px 0\\\">What you get with a VIP Day</h2>\\n        <ul style=\\\"color:var(--muted);line-height:1.6\\\">\\n          <li>Comprehensive pre-visit questionnaire and chart review</li>\\n          <li>Extended in-person or virtual visit (6–8 hours of focused care)</li>\\n          <li>Clear, written integrative care plan with prioritized steps</li>\\n          <li>30-day follow-up message support to troubleshoot first steps</li>\\n        </ul>\\n      </section>\\n\\n      <section>\\n        <h2 style=\\\"margin:0 0 10px 0\\\">Voices from patients</h2>\\n        <div class=\\\"testimonials\\\">\\n          <div class=\\\"testimonial\\\"><strong>\\\"A compass when I felt overwhelmed.\\\"</strong><div style=\\\"color:var(--muted);margin-top:6px\\\">The VIP day gave me clarity and a stepwise plan I could actually follow. — S., {{CITY}}</div></div>\\n          <div class=\\\"testimonial\\\"><strong>\\\"Practical and educative.\\\"</strong><div style=\\\"color:var(--muted);margin-top:6px\\\">I appreciated the clear rationale for each recommendation. — M., {{STATE}}</div></div>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:26px;display:flex;gap:14px;align-items:center\\\">\\n        <div style=\\\"flex:1\\\">\\n          <h3 style=\\\"margin:0\\\">Ready to book a focused day?</h3>\\n          <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">Reserve a VIP Day and receive prep materials to make the session efficient and actionable.</p>\\n        </div>\\n        <div>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Book a VIP Day</a>\\n        </div>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div style=\\\"margin-top:6px;color:var(--muted)\\\">We do not guarantee cures. Our work focuses on education, lifestyle, and whole-person support.</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"}  \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--teal:#1b7a59;--soft:#efefef;--deep:#053028}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#fbfff9,#ffffff);color:#08231b}\\n    .wrap{max-width:980px;margin:0 auto;padding:26px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:12px;color:#4b5563;text-decoration:none}\\n    .hero{display:flex;gap:22px;align-items:center;margin-top:18px}\\n    .bio{background:#fff;border-radius:10px;padding:18px;box-shadow:0 10px 30px rgba(9,16,13,0.06)}\\n    .svg-deco{position:fixed;right:-60px;top:120px;opacity:0.35;width:420px;height:420px}\\n    h1{margin:0 0 8px 0}\\n    .lead{color:#466f5a}\\n    .sections{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:20px}\\n    .panel{background:#fff;padding:16px;border-radius:10px}\\n    .framework{display:flex;flex-direction:column;gap:12px}\\n    .pill{display:inline-block;background:linear-gradient(90deg,#eef8f2,#ffffff);padding:8px 10px;border-radius:999px;color:var(--teal);font-weight:700}\\n    footer{margin-top:30px;color:#6b7280;font-size:13px}\\n    @media(max-width:880px){.hero{flex-direction:column}.sections{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:#6b7280\\\">Practical integrative care in {{CITY}}, {{STATE}}</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"conditions.html\\\">Concerns</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"book.html\\\" style=\\\"color:var(--teal)\\\">Schedule</a>\\n      </nav>\\n    </header>\\n\\n    <svg class=\\\"svg-deco\\\" viewBox=\\\"0 0 300 300\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"ag\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#dff7ec\\\" /><stop offset=\\\"1\\\" stop-color=\\\"#f7fff9\\\" /></linearGradient>\\n      </defs>\\n      <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#ag)\\\" rx=\\\"40\\\"/>\\n      <g fill=\\\"none\\\" stroke=\\\"#bfead0\\\" stroke-width=\\\"2\\\">\\n        <path d=\\\"M10 200 C50 120, 140 260, 280 90\\\" />\\n        <circle cx=\\\"44\\\" cy=\\\"40\\\" r=\\\"10\\\" fill=\\\"#c9f0dc\\\" stroke=\\\"none\\\" />\\n      </g>\\n    </svg>\\n\\n    <div class=\\\"hero\\\">\\n      <div class=\\\"bio\\\">\\n        <h1>People-first integrative medicine</h1>\\n        <p class=\\\"lead\\\">We blend conventional evaluation with evidence-informed lifestyle, nutritional, and mind-body strategies. Our aim is to educate and empower—not to promise cures.</p>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <strong>{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</strong>\\n          <div style=\\\"color:#6b7280;margin-top:6px\\\">I trained in integrative approaches and long-form clinical assessment. My focus is practical plans that fit your life.</div>\\n        </div>\\n      </div>\\n\\n      <aside style=\\\"width:320px\\\">\\n        <div class=\\\"panel\\\">\\n          <div class=\\\"pill\\\">VIP Day available</div>\\n          <p style=\\\"margin:10px 0 0;color:#6b7280\\\">An intensive, focused visit to create an actionable roadmap, with follow-up support.</p>\\n          <div style=\\\"margin-top:12px\\\"><a href=\\\"book.html\\\" style=\\\"background:var(--teal);color:#fff;padding:8px 12px;border-radius:8px;text-decoration:none;font-weight:700\\\">Reserve a VIP Day</a></div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <strong>Contact</strong>\\n          <div style=\\\"color:#6b7280;margin-top:6px\\\">Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <div class=\\\"sections\\\">\\n      <div>\\n        <section class=\\\"panel\\\">\\n          <h2 style=\\\"margin-top:0\\\">Our story — a different lens on health</h2>\\n          <p style=\\\"color:#6b7280\\\">We began as a small clinic focused on melding thorough medical reasoning with practical lifestyle change. Over time we've refined an intake and care synthesis that prioritizes the biggest leverage points: sleep, stress, nutrition and movement.</p>\\n        </section>\\n\\n        <section class=\\\"panel\\\" style=\\\"margin-top:14px\\\">\\n          <h3 style=\\\"margin:0 0 8px 0\\\">Clinical framework</h3>\\n          <div class=\\\"framework\\\">\\n            <div><strong>1. Intake & Listening</strong> — deep history and context-gathering</div>\\n            <div><strong>2. Shared Plan</strong> — prioritized, attainable steps</div>\\n            <div><strong>3. Follow-up</strong> — coaching and optional labs to guide adjustments</div>\\n          </div>\\n        </section>\\n\\n        <section class=\\\"panel\\\" style=\\\"margin-top:14px\\\">\\n          <h3 style=\\\"margin:0 0 8px 0\\\">Philosophy</h3>\\n          <p style=\\\"color:#6b7280\\\">We use interventions supported by evidence and tailor them to you. Testing is educational; we decide together what will meaningfully change care.</p>\\n        </section>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <h4 style=\\\"margin:0\\\">Testimonials</h4>\\n          <div style=\\\"color:#6b7280;margin-top:8px\\\">“A pragmatic clinician who taught me how to manage my sleep and energy.” — K.</div>\\n          <div style=\\\"color:#6b7280;margin-top:8px\\\">“Clear plan, fewer appointments, more action.” — R.</div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0\\\">Approach snapshot</h4>\\n          <ul style=\\\"color:#6b7280;margin-top:8px;line-height:1.6\\\">\\n            <li>Thorough history</li>\\n            <li>Prioritized plan</li>\\n            <li>Follow-up and education</li>\\n          </ul>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div style=\\\"color:#6b7280\\\">© {{BUSINESS_NAME}} — serving {{CITY}}, {{STATE}}</div>\\n        <div><a href=\\\"book.html\\\" style=\\\"color:var(--teal);text-decoration:none;font-weight:700\\\">Book a session</a></div>\\n      </div>\\n      <div style=\\\"margin-top:10px;color:#7a8877\\\">We do not promise cures. Our focus is education, collaborative planning, and whole-person support.</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"}  \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--main:#2c7a5a;--muted:#6b7280}\\n    body{margin:0;font-family:Arial,Helvetica,sans-serif;background:linear-gradient(0deg,#f8fff8,#ffffff);color:#052018}\\n    .container{max-width:980px;margin:0 auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .hero{margin-top:18px;padding:20px;background:linear-gradient(90deg,#f6fff6,#ffffff);border-radius:12px;display:flex;justify-content:space-between;align-items:center}\\n    .form-wrap{display:grid;grid-template-columns:1fr 360px;gap:20px;margin-top:18px}\\n    form{background:#fff;padding:18px;border-radius:10px;box-shadow:0 8px 26px rgba(7,12,9,0.06)}\\n    label{display:block;margin-top:12px;font-weight:700}\\n    input,textarea,select{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid #e6eee7}\\n    .aside{background:linear-gradient(180deg,#e9f8ee,#ffffff);padding:16px;border-radius:10px}\\n    .offer{background:#fff;padding:12px;border-radius:8px;margin-top:12px}\\n    .btn{display:inline-block;padding:10px 14px;background:var(--main);color:#fff;border-radius:10px;text-decoration:none;font-weight:700}\\n    .small{color:var(--muted);font-size:14px}\\n    .svg-line{width:100%;height:60px;margin-top:12px}\\n    footer{margin-top:26px;color:var(--muted);font-size:13px}\\n    @media(max-width:880px){.form-wrap{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Main</a>\\n        <a href=\\\"about.html\\\">Who we are</a>\\n        <a href=\\\"pricing.html\\\">Costs</a>\\n        <a href=\\\"contact.html\\\">Get in touch</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"hero\\\">\\n      <div>\\n        <h1 style=\\\"margin:0\\\">Schedule your visit</h1>\\n        <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Choose a VIP Day or a standard visit. We'll send prep materials after booking.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"#bookNow\\\">Book now</a>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"form-wrap\\\">\\n      <form id=\\\"bookNow\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\">\\n        <h2 style=\\\"margin:0 0 6px 0\\\">Booking form</h2>\\n        <p class=\\\"small\\\" style=\\\"margin:0 0 10px 0\\\">We collect a brief summary to tailor your session. This is educational and not a diagnosis.</p>\\n\\n        <label for=\\\"name\\\">Full name</label>\\n        <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"Your name\\\" required />\\n\\n        <label for=\\\"email\\\">Email</label>\\n        <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required />\\n\\n        <label for=\\\"phone\\\">Phone</label>\\n        <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"(555) 555-5555\\\" />\\n\\n        <label for=\\\"visit\\\">Select visit type</label>\\n        <select id=\\\"visit\\\" name=\\\"visit\\\">\\n          <option value=\\\"vip\\\">VIP Day — intensive, 6–8 hours</option>\\n          <option value=\\\"standard\\\">Standard new patient visit — 90 minutes</option>\\n          <option value=\\\"follow\\\">Follow-up — 45 minutes</option>\\n        </select>\\n\\n        <label for=\\\"concerns\\\">Main concerns (brief)</label>\\n        <textarea id=\\\"concerns\\\" name=\\\"concerns\\\" rows=\\\"4\\\" placeholder=\\\"sleep, digestion, stress, energy...\\\" ></textarea>\\n\\n        <div style=\\\"margin-top:12px;display:flex;gap:10px;align-items:center\\\">\\n          <button class=\\\"btn\\\" type=\\\"submit\\\">Request booking</button>\\n          <div class=\\\"small\\\">Or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n        </div>\\n\\n        <div class=\\\"small\\\" style=\\\"margin-top:10px;color:var(--muted)\\\">By submitting you agree we'll contact you about scheduling. We do not guarantee outcomes; our goal is education and a collaborative plan.</div>\\n      </form>\\n\\n      <aside class=\\\"aside\\\">\\n        <h3 style=\\\"margin:0\\\">What to expect</h3>\\n        <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">An intake questionnaire arrives after booking. On the visit day we synthesize history, may suggest optional educational labs, and create a practical plan.</p>\\n\\n        <div class=\\\"offer\\\">\\n          <strong>VIP Day</strong>\\n          <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">A focused, full-day session for complex concerns and a complete plan. Ideal for resetting habits and making quick progress.</div>\\n        </div>\\n\\n        <div class=\\\"offer\\\">\\n          <strong>Short follow-up</strong>\\n          <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Used to iterate on a plan and troubleshoot initial steps.</div>\\n        </div>\\n\\n        <svg class=\\\"svg-line\\\" viewBox=\\\"0 0 600 60\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n          <defs>\\n            <linearGradient id=\\\"lg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#e3f7eb\\\" /><stop offset=\\\"1\\\" stop-color=\\\"#ffffff\\\" /></linearGradient>\\n          </defs>\\n          <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#lg)\\\" rx=\\\"6\\\" />\\n          <g stroke=\\\"#cfeedb\\\" stroke-width=\\\"2\\\" fill=\\\"none\\\">\\n            <path d=\\\"M12 38 C90 10, 210 70, 560 20\\\" />\\n          </g>\\n        </svg>\\n\\n        <div style=\\\"margin-top:10px\\\" class=\\\"small\\\">\\n          Need help deciding? Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0 0 8px 0\\\">Testimonials</h3>\\n      <div style=\\\"color:var(--muted)\\\">\\\"Clear, pragmatic care that respected my time and goals.\\\" — A. <br/>\\\"The plan was doable and educational.\\\" — J.</div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"margin-top:18px;color:var(--muted)\\\">Appointments subject to availability. Optional labs are discussed as educational tools; they are not mandatory and are billed separately by labs.</div>\\n      <div style=\\\"margin-top:6px;color:var(--muted)\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"}  \nBUNDLE_END"
