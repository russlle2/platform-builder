          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Care & Pricing — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#f6fbf9;--accent:#4b9f8a;--muted:#6b7280;--card:#ffffff;--glass:rgba(255,255,255,0.7);--shadow:0 8px 30px rgba(22,28,37,0.08)}\\n    html,body{height:100%}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;line-height:1.45;color:#0f172a;background:linear-gradient(180deg,var(--bg1),#eef7f4);display:flex;flex-direction:column}\\n    header{position:sticky;top:0;backdrop-filter:blur(6px);background:linear-gradient(180deg,rgba(255,255,255,0.6),rgba(255,255,255,0.45));border-bottom:1px solid rgba(15,23,42,0.04);z-index:10}\\n    .container{max-width:1100px;margin:0 auto;padding:28px}\\n    nav{display:flex;align-items:center;gap:20px}\\n    .brand{font-weight:700;color:var(--accent)}\\n    .nav-links{margin-left:auto;display:flex;gap:14px}\\n    .nav-links a{color:#0f172a;text-decoration:none;padding:8px 12px;border-radius:8px;font-weight:600}\\n    .nav-links a[href$=\\\"pricing.html\\\"]{background:linear-gradient(90deg,var(--accent),#3d8f77);color:#fff}\\n\\n    /* hero */\\n    .hero{display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:center;padding:48px 0}\\n    .card{background:var(--card);padding:28px;border-radius:14px;box-shadow:var(--shadow)}\\n    .kicker{display:inline-block;background:linear-gradient(90deg,var(--accent),#2d7f69);color:#fff;padding:6px 10px;border-radius:999px;font-size:13px;font-weight:700}\\n    h1{margin:12px 0 6px;font-size:28px}\\n    p.lead{margin:0;color:var(--muted)}\\n\\n    /* pricing grid */\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:20px}\\n    .tier{padding:20px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.9),var(--glass));box-shadow:0 6px 24px rgba(16,24,40,0.06);border:1px solid rgba(15,23,42,0.04)}\\n    .tier h3{margin:0 0 6px}\\n    .price{font-size:20px;font-weight:800;color:var(--accent)}\\n    .muted{color:var(--muted);font-size:14px}\\n    .features{margin:12px 0 18px;line-height:1.5;color:#111827}\\n    .cta{display:inline-block;background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    /* sections */\\n    section{margin:28px 0}\\n    .two-col{display:grid;grid-template-columns:1fr 320px;gap:20px}\\n    .micro-list{display:flex;flex-direction:column;gap:10px}\\n    .micro{background:linear-gradient(180deg,#fff,rgba(255,255,255,0.98));padding:12px;border-radius:10px;border:1px solid rgba(15,23,42,0.03)}\\n\\n    footer{padding:28px 0;color:var(--muted)}\\n\\n    /* decorative SVG */\\n    .pattern{position:fixed;right:-120px;top:-40px;opacity:0.12;transform:rotate(8deg);width:560px;height:560px;pointer-events:none}\\n    @media (max-width:900px){.hero{grid-template-columns:1fr;}.two-col{grid-template-columns:1fr}.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- embedded decorative svg pattern -->\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 600 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#a7f3d0\\\" stop-opacity=\\\"0.8\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#60a5fa\\\" stop-opacity=\\\"0.6\\\"/>\\n      </linearGradient>\\n      <pattern id=\\\"p1\\\" width=\\\"120\\\" height=\\\"120\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(15)\\\">\\n        <rect width=\\\"120\\\" height=\\\"120\\\" fill=\\\"none\\\"/>\\n        <circle cx=\\\"10\\\" cy=\\\"10\\\" r=\\\"6\\\" fill=\\\"#dff6ee\\\"/>\\n        <circle cx=\\\"60\\\" cy=\\\"60\\\" r=\\\"6\\\" fill=\\\"#e6f0ff\\\"/>\\n        <path d=\\\"M0 120 L120 0\\\" stroke=\\\"#cde\\\" stroke-width=\\\"2\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\"/>\\n    <g fill=\\\"url(#g1)\\\" opacity=\\\"0.5\\\">\\n      <ellipse cx=\\\"420\\\" cy=\\\"120\\\" rx=\\\"200\\\" ry=\\\"80\\\"/>\\n      <ellipse cx=\\\"480\\\" cy=\\\"260\\\" rx=\\\"140\\\" ry=\\\"60\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"container\\\">\\n      <nav>\\n        <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"nav-links\\\">\\n          <a href=\\\"index.html\\\">Home</a>\\n          <a href=\\\"services.html\\\">Services</a>\\n          <a href=\\\"approach.html\\\">Approach</a>\\n          <a href=\\\"pricing.html\\\">Fees</a>\\n          <a href=\\\"book.html\\\">Schedule</a>\\n        </div>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"card\\\">\\n        <span class=\\\"kicker\\\">Integrative visits</span>\\n        <h1>Transparent care options, designed for whole-person results</h1>\\n        <p class=\\\"lead\\\">We combine evidence-informed diagnostics, personalized lifestyle plans, and gentle therapeutics. Pricing below is for common pathways; individualized recommendations and optional labs may change cost estimates.</p>\\n        <div style=\\\"margin-top:18px\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a style=\\\"margin-left:12px;color:var(--muted);text-decoration:none;font-weight:600\\\" href=\\\"contact.html\\\">Contact</a>\\n        </div>\\n      </div>\\n      <aside class=\\\"card\\\">\\n        <h3>Quick snapshot</h3>\\n        <p class=\\\"muted\\\">Hybrid care: in-clinic and telehealth. You’ll get assessment, plan, and follow-ups tailored for your life.</p>\\n        <dl style=\\\"margin-top:12px\\\">\\n          <dt style=\\\"font-weight:700\\\">Phone</dt>\\n          <dd class=\\\"muted\\\">{{PHONE}}</dd>\\n          <dt style=\\\"font-weight:700;margin-top:8px\\\">Email</dt>\\n          <dd class=\\\"muted\\\">{{EMAIL}}</dd>\\n        </dl>\\n      </aside>\\n    </section>\\n\\n    <section>\\n      <h2>Our common care packages</h2>\\n      <p class=\\\"muted\\\">Choose a pathway; each includes education, goal-setting, and follow-up. Optional testing or supplements will be discussed when appropriate.</p>\\n      <div class=\\\"grid\\\" role=\\\"list\\\">\\n        <div class=\\\"tier\\\" role=\\\"listitem\\\">\\n          <h3>Discovery Visit</h3>\\n          <div class=\\\"price\\\">$165 — 60 min</div>\\n          <div class=\\\"muted\\\">Initial intake + focused plan</div>\\n          <p class=\\\"features\\\">Comprehensive history, targeted exams, and an actionable 2–4 week starter plan. Ideal to explore drivers of symptoms and immediate strategies.</p>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Book Discovery</a>\\n        </div>\\n\\n        <div class=\\\"tier\\\" role=\\\"listitem\\\">\\n          <h3>Integrative Path</h3>\\n          <div class=\\\"price\\\">$120 / follow-up</div>\\n          <div class=\\\"muted\\\">Short follow-ups & care coordination</div>\\n          <p class=\\\"features\\\">Ongoing support with stepwise adjustments, medication review, lifestyle coaching, and shared decision-making about labs or referrals.</p>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Start a Path</a>\\n        </div>\\n\\n        <div class=\\\"tier\\\" role=\\\"listitem\\\">\\n          <h3>Comprehensive Annual</h3>\\n          <div class=\\\"price\\\">$985 / year</div>\\n          <div class=\\\"muted\\\">Bundled intake + follow-ups</div>\\n          <p class=\\\"features\\\">Yearly health plan with two detailed follow-ups, prevention-focused screening discussion, and priority access. Pricing excludes lab costs.</p>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Enroll</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"two-col\\\">\\n      <div class=\\\"card\\\">\\n        <h2>How we choose tests and treatments</h2>\\n        <p class=\\\"muted\\\">We emphasize minimally invasive, evidence-aligned options. Labs are offered to clarify physiology when results will change management. Expect a clear explanation of benefit, risk, and cost before ordering.</p>\\n        <ul style=\\\"margin-top:12px;color:#111827;line-height:1.6\\\">\\n          <li><strong>Clinical-first:</strong> decisions start with your history and symptoms.</li>\\n          <li><strong>Stepwise testing:</strong> only when results will impact care.</li>\\n          <li><strong>Education:</strong> we teach you what each measure means for daily choices.</li>\\n        </ul>\\n      </div>\\n      <aside class=\\\"card\\\">\\n        <h3>Typical extras</h3>\\n        <div class=\\\"micro-list\\\">\\n          <div class=\\\"micro\\\"><strong>Functional labs:</strong> targeted hormone, nutrient, or stool testing (separate fee).</div>\\n          <div class=\\\"micro\\\"><strong>Supplement guidance:</strong> discussed only when clinically appropriate.</div>\\n          <div class=\\\"micro\\\"><strong>Referrals:</strong> coordinated with local specialists as needed.</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section>\\n      <h2>Payment & insurance</h2>\\n      <p class=\\\"muted\\\">We operate on a hybrid fee model. Many insurers reimburse telehealth or specialist visits; we can provide superbills on request. Please confirm with your carrier. No guarantees of coverage are made here.</p>\\n    </section>\\n\\n    <section>\\n      <h2>Small, practical habits that compound</h2>\\n      <div class=\\\"micro-list\\\">\\n        <div class=\\\"micro\\\"><strong>Sleep anchor:</strong> consistent wake time + wind-down routine for 15 minutes each night.</div>\\n        <div class=\\\"micro\\\"><strong>Mindful pause:</strong> 3-minute breathing check twice daily to reduce stress signaling.</div>\\n        <div class=\\\"micro\\\"><strong>Gut reset:</strong> add a daily vegetable or fiber-rich food to support digestion.</div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <div class=\\\"card\\\">\\n        <h3>Ready to talk through options?</h3>\\n        <p class=\\\"muted\\\">We’ll review what matters most to you and outline clear next steps without pressure.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap\\\">\\n        <div>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}} · <span style=\\\"color:var(--muted)\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</span></div>\\n        <div style=\\\"color:var(--muted)\\\">Questions? <a href=\\\"contact.html\\\">Reach out</a></div>\\n      </div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — The Team & Philosophy — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfDF9;--teal:#3aa68a;--ink:#0b1220;--sub:#6b7280}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;background:linear-gradient(180deg,#fbfbfc,var(--bg));color:var(--ink)}\\n    header{padding:20px 28px;border-bottom:1px solid rgba(11,18,32,0.04)}\\n    .container{max-width:1000px;margin:0 auto;padding:28px}\\n    .logo{font-weight:700;color:var(--teal)}\\n    .nav{display:flex;gap:14px;align-items:center}\\n    .nav a{color:var(--ink);text-decoration:none;padding:8px;border-radius:8px}\\n    .nav a[href$=\\\"about.html\\\"]{background:rgba(58,166,138,0.12);font-weight:700}\\n\\n    .hero{padding:28px;background:linear-gradient(90deg,rgba(58,166,138,0.06),rgba(96,165,250,0.03));border-radius:12px}\\n    h1{margin:6px 0;font-size:26px}\\n    .muted{color:var(--sub)}\\n    .stack{display:grid;grid-template-columns:1fr 320px;gap:22px;margin-top:22px}\\n\\n    .bio{background:#fff;padding:20px;border-radius:12px;box-shadow:0 10px 30px rgba(12,18,28,0.05)}\\n    .side{padding:18px;background:linear-gradient(180deg,#fff,#f9fffb);border-radius:12px}\\n\\n    .values{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px}\\n    .pill{background:#f0f8f3;padding:8px 12px;border-radius:999px;color:var(--teal);font-weight:700}\\n\\n    .svg-deco{width:260px;height:260px;position:absolute;left:-60px;top:140px;opacity:0.08}\\n\\n    @media (max-width:900px){.stack{grid-template-columns:1fr}.svg-deco{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"svg-deco\\\" viewBox=\\\"0 0 220 220\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"A\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#a7f3d0\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#93c5fd\\\"/>\\n      </linearGradient>\\n      <pattern id=\\\"q\\\" width=\\\"80\\\" height=\\\"80\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"80\\\" height=\\\"80\\\" fill=\\\"none\\\"></rect>\\n        <path d=\\\"M0 40 L80 40\\\" stroke=\\\"#dff6ee\\\" stroke-width=\\\"2\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#q)\\\"/>\\n    <g fill=\\\"url(#A)\\\">\\n      <circle cx=\\\"60\\\" cy=\\\"60\\\" r=\\\"46\\\"/>\\n      <circle cx=\\\"160\\\" cy=\\\"140\\\" r=\\\"40\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"container\\\">\\n      <div style=\\\"display:flex;align-items:center;gap:18px\\\">\\n        <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n        <nav class=\\\"nav\\\" aria-label=\\\"Primary\\\">\\n          <a href=\\\"index.html\\\">Welcome</a>\\n          <a href=\\\"approach.html\\\">How we work</a>\\n          <a href=\\\"services.html\\\">Offerings</a>\\n          <a href=\\\"about.html\\\">Our Story</a>\\n        </nav>\\n      </div>\\n    </div>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <h1>Blending modern evidence with time-tested approaches</h1>\\n      <p class=\\\"muted\\\">At {{BUSINESS_NAME}}, we center care on the whole person: physiology, lifestyle, and context. We empower patients through clear education and collaborative planning rather than one-size-fits-all fixes.</p>\\n    </section>\\n\\n    <section class=\\\"stack\\\">\\n      <article class=\\\"bio\\\">\\n        <h2>About the practice</h2>\\n        <p class=\\\"muted\\\">Founded on a commitment to patient-centered education, our clinical model balances research-backed interventions with personalized lifestyle strategies. We emphasize prevention, symptom relief, and practical skills you can use daily.</p>\\n\\n        <h3 style=\\\"margin-top:18px\\\">What to expect</h3>\\n        <ol style=\\\"color:var(--ink);line-height:1.6\\\">\\n          <li>Careful listening and an in-depth intake.</li>\\n          <li>A stepwise plan focused on measurable goals.</li>\\n          <li>Follow-ups that adjust treatment based on response.</li>\\n        </ol>\\n\\n        <h3 style=\\\"margin-top:18px\\\">Our philosophy in one sentence</h3>\\n        <p class=\\\"muted\\\">Health is a set of interrelated systems; improving one area often supports others. We teach small, high-leverage changes that compound over time.</p>\\n      </article>\\n\\n      <aside class=\\\"side\\\">\\n        <h3>{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</h3>\\n        <p class=\\\"muted\\\">A clinician trained in integrative approaches, focused on creating individualized, practical plans. They prioritize education and measurable goals.</p>\\n        <div style=\\\"margin-top:10px\\\" class=\\\"values\\\">\\n          <span class=\\\"pill\\\">Evidence-informed</span>\\n          <span class=\\\"pill\\\">Patient-led</span>\\n          <span class=\\\"pill\\\">Sustainable</span>\\n        </div>\\n\\n        <h4 style=\\\"margin-top:16px\\\">Snapshot</h4>\\n        <dl class=\\\"muted\\\">\\n          <dt style=\\\"font-weight:700\\\">Location</dt>\\n          <dd>{{CITY}}, {{STATE}}</dd>\\n          <dt style=\\\"font-weight:700;margin-top:8px\\\">Contact</dt>\\n          <dd>{{PHONE}} · <a href=\\\"mailto:{{EMAIL}}\\\">Email</a></dd>\\n        </dl>\\n        <div style=\\\"margin-top:14px\\\">\\n          <a href=\\\"book.html\\\" style=\\\"display:inline-block;background:var(--teal);color:#fff;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:700\\\">Schedule a chat</a>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2>Small habits we teach first</h2>\\n      <p class=\\\"muted\\\">Change starts with doable steps. Below are examples we teach early in care — these are for education, not individualized medical advice.</p>\\n      <div style=\\\"display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:12px\\\">\\n        <div style=\\\"background:#fff;padding:14px;border-radius:10px\\\">Regular light exposure within 30 minutes of waking</div>\\n        <div style=\\\"background:#fff;padding:14px;border-radius:10px\\\">Two servings of fiber-rich foods daily</div>\\n        <div style=\\\"background:#fff;padding:14px;border-radius:10px\\\">3-minute breathing breaks after stressful events</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h2>Why education matters</h2>\\n      <p class=\\\"muted\\\">We focus on teaching what to measure and why. Decisions about tests or supplements are made with transparent discussion of expected benefit, risks, and costs.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <div style=\\\"background:linear-gradient(180deg,#fff,#f6fffb);padding:18px;border-radius:12px\\\">\\n        <h3>Curious about next steps?</h3>\\n        <p class=\\\"muted\\\">If you want a focused discussion about your priorities, book a Discovery Visit to create an individualized plan.</p>\\n        <a href=\\\"book.html\\\" style=\\\"background:var(--teal);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700\\\">Book a Discovery Visit</a>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:28px;color:var(--sub)\\\">\\n      <div>{{BUSINESS_NAME}} · {{PRACTITIONER_NAME}}, {{CREDENTIALS}} · <a href=\\\"contact.html\\\">Contact</a></div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Schedule — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#ffffff;--accent:#2b8f73;--muted:#6b7280}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto;background:linear-gradient(180deg,#ffffff,#f3fbf8);color:#082328}\\n    .wrap{max-width:980px;margin:0 auto;padding:28px}\\n    header{display:flex;align-items:center;gap:16px;padding-bottom:8px}\\n    .brand{font-weight:800;color:var(--accent)}\\n    nav a{margin-left:12px;text-decoration:none;color:#0b2730}\\n\\n    .hero{display:flex;gap:22px;align-items:flex-start;margin-top:10px}\\n    .panel{background:#fff;padding:20px;border-radius:12px;box-shadow:0 12px 36px rgba(16,24,40,0.06)}\\n    h1{margin:0 0 6px}\\n    .muted{color:var(--muted)}\\n\\n    form{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    .field{margin-bottom:12px}\\n    label{display:block;font-weight:700;margin-bottom:6px}\\n    input,select,textarea{width:100%;padding:10px;border:1px solid #e6eef0;border-radius:8px;font-size:15px}\\n    textarea{min-height:120px}\\n    .submit{background:var(--accent);color:#fff;padding:12px;border-radius:10px;border:none;font-weight:800;cursor:pointer}\\n\\n    .aside-list{display:flex;flex-direction:column;gap:10px}\\n    .aside-item{background:linear-gradient(180deg,#fff,#f8fffb);padding:12px;border-radius:10px;border:1px solid rgba(43,143,115,0.06)}\\n\\n    .note{font-size:13px;color:var(--muted);margin-top:10px}\\n\\n    /* small svg */\\n    .corner-svg{position:fixed;right:12px;bottom:12px;width:160px;height:160px;opacity:0.08}\\n\\n    @media (max-width:900px){form{grid-template-columns:1fr}.corner-svg{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"corner-svg\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"B\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#bff7df\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#93c5fd\\\"/></linearGradient>\\n      <pattern id=\\\"r\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\"><circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"4\\\" fill=\\\"#e6fff6\\\"/></pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#r)\\\"/>\\n    <g fill=\\\"url(#B)\\\" opacity=\\\"0.6\\\"><rect x=\\\"10\\\" y=\\\"10\\\" width=\\\"180\\\" height=\\\"80\\\" rx=\\\"20\\\"></rect><circle cx=\\\"140\\\" cy=\\\"140\\\" r=\\\"40\\\"></circle></g>\\n  </svg>\\n\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <nav aria-label=\\\"top\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Care</a>\\n        <a href=\\\"pricing.html\\\">Fees</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <div class=\\\"hero\\\">\\n        <div class=\\\"panel\\\" style=\\\"flex:1\\\">\\n          <h1>Schedule a Discovery or Follow-up</h1>\\n          <p class=\\\"muted\\\">Use this booking form to request a Discovery Visit or a follow-up. We’ll reach out to confirm specifics and discuss any optional testing that might be helpful. There are no guaranteed outcomes; our goal is collaborative improvement via education and targeted plans.</p>\\n\\n          <form id=\\\"bookingForm\\\" action=\\\"#\\\" method=\\\"post\\\" onsubmit=\\\"event.preventDefault();handleSubmit();\\\">\\n            <div>\\n              <div class=\\\"field\\\">\\n                <label for=\\\"name\\\">Full name</label>\\n                <input id=\\\"name\\\" name=\\\"name\\\" required placeholder=\\\"Your name\\\">\\n              </div>\\n              <div class=\\\"field\\\">\\n                <label for=\\\"email\\\">Email</label>\\n                <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required placeholder=\\\"you@example.com\\\">\\n              </div>\\n              <div class=\\\"field\\\">\\n                <label for=\\\"phone\\\">Phone</label>\\n                <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"{{PHONE}}\\\">\\n              </div>\\n\\n              <div class=\\\"field\\\">\\n                <label for=\\\"type\\\">Visit type</label>\\n                <select id=\\\"type\\\" name=\\\"type\\\">\\n                  <option>Discovery Visit — 60 min</option>\\n                  <option>Follow-up — 30 min</option>\\n                  <option>Telehealth check-in — 20 min</option>\\n                </select>\\n              </div>\\n\\n              <div class=\\\"field\\\">\\n                <label for=\\\"notes\\\">Brief context</label>\\n                <textarea id=\\\"notes\\\" name=\\\"notes\\\" placeholder=\\\"Main concerns or goals (sleep, digestion, stress, energy, etc.)\\\"></textarea>\\n              </div>\\n\\n              <div class=\\\"field\\\">\\n                <button class=\\\"submit\\\" type=\\\"submit\\\">Request appointment</button>\\n              </div>\\n            </div>\\n\\n            <aside style=\\\"padding-left:14px\\\">\\n              <div class=\\\"aside-list\\\">\\n                <div class=\\\"aside-item\\\">\\n                  <strong>What happens next</strong>\\n                  <div class=\\\"note\\\">We review your request and reply within 2 business days to confirm time and any pre-visit forms or recommended labs.</div>\\n                </div>\\n                <div class=\\\"aside-item\\\">\\n                  <strong>Cost & payment</strong>\\n                  <div class=\\\"note\\\">Fees vary by visit type. See our Fees page for common package pricing. Insurance coverage varies and is not guaranteed.</div>\\n                </div>\\n                <div class=\\\"aside-item\\\">\\n                  <strong>Privacy</strong>\\n                  <div class=\\\"note\\\">We protect your information and only request tests when clinically useful.</div>\\n                </div>\\n              </div>\\n            </aside>\\n\\n          </form>\\n\\n          <div id=\\\"thanks\\\" style=\\\"display:none;margin-top:12px;padding:12px;background:#f6fff8;border-radius:8px;border:1px solid rgba(43,143,115,0.08)\\\">\\n            <strong>Thanks — request sent.</strong>\\n            <div class=\\\"muted\\\">We’ll contact you soon to finalize scheduling and review any next steps.</div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"width:320px\\\">\\n          <div class=\\\"panel\\\">\\n            <h3>Before your visit</h3>\\n            <ul style=\\\"color:var(--muted);line-height:1.6\\\">\\n              <li>Gather a brief medication/supplement list.</li>\\n              <li>Note approximate symptom timeline and recent labs if available.</li>\\n              <li>Answer pre-visit questions if sent — these speed care planning.</li>\\n            </ul>\\n            <p class=\\\"note\\\">If you’re unsure whether a Discovery visit or a follow-up is right, choose Discovery and we’ll tailor the session to your priorities.</p>\\n          </div>\\n\\n          <div style=\\\"height:14px\\\"></div>\\n\\n          <div class=\\\"panel\\\">\\n            <h3>Contact</h3>\\n            <div class=\\\"muted\\\">Phone: {{PHONE}}</div>\\n            <div class=\\\"muted\\\">Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n            <div style=\\\"margin-top:10px\\\"><a href=\\\"contact.html\\\" style=\\\"color:var(--accent);text-decoration:none;font-weight:700\\\">More ways to reach us</a></div>\\n          </div>\\n        </div>\\n      </div>\\n    </main>\\n\\n    <footer style=\\\"margin-top:22px;color:var(--muted)\\\">\\n      {{BUSINESS_NAME}} · {{CITY}}, {{STATE}} · <a href=\\\"about.html\\\">About</a>\\n    </footer>\\n  </div>\\n\\n  <script>\\n    function handleSubmit(){\\n      var form = document.getElementById('bookingForm');\\n      var thanks = document.getElementById('thanks');\\n      // Basic in-page acknowledgment; in a real site this would POST to a server.\\n      form.style.display = 'none';\\n      thanks.style.display = 'block';\\n      console.log('Booking request simulated');\\n    }\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
