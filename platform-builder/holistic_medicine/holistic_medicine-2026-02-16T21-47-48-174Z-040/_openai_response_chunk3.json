          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Rates & Series — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Workshops and gently guided series for whole-person health. Educational — integrative — practical.\\\">\\n  <style>\\n    :root{\\n      --accent:#6b8e6a; --muted:#f6f7f4; --ink:#123; --card:#ffffff; --glass:rgba(255,255,255,0.65);\\n      --radius:14px; --max:980px; --pad:24px;\\n    }\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:var(--ink);background:linear-gradient(180deg,#f8fbf9 0%,#ffffff 60%);}\\n    .wrap{max-width:var(--max);margin:40px auto;padding:0 20px;position:relative;}\\n\\n    /* header pattern */\\n    header{position:relative;padding:36px 0 18px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:72px;height:72px;border-radius:18px;display:grid;place-items:center;background:linear-gradient(135deg, #e9f6ec 0%, #dff0e2 60%);box-shadow:0 6px 18px rgba(16,24,32,0.06);font-weight:700;color:var(--accent)}\\n    nav{display:flex;gap:14px;font-size:14px}\\n    nav a{color:var(--ink);text-decoration:none;padding:8px 12px;border-radius:10px}\\n    nav a[href$=\\\"pricing.html\\\"]{background:var(--accent);color:white}\\n\\n    /* hero */\\n    .hero{display:grid;grid-template-columns:1fr 340px;gap:28px;align-items:center;margin-top:8px}\\n    .hero .lead{background:linear-gradient(180deg, rgba(255,255,255,0.8), rgba(255,255,255,0.6));padding:28px;border-radius:20px;box-shadow:0 10px 30px rgba(18,24,36,0.06)}\\n    h1{margin:0 0 8px 0;font-size:28px;letter-spacing:-0.02em}\\n    p.lead{margin:0;color:#475259}\\n    .aside{position:relative;padding:22px;border-radius:16px;backdrop-filter:blur(6px);background:var(--glass);box-shadow:inset 0 1px 0 rgba(255,255,255,0.4)}\\n    .aside strong{display:block;margin-bottom:6px;color:var(--accent)}\\n\\n    /* series list */\\n    .series{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:22px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 8px 20px rgba(16,24,32,0.06)}\\n    .card h3{margin:0 0 8px;font-size:16px}\\n    .meta{font-size:13px;color:#6b6b6b;margin-bottom:12px}\\n    .price{font-weight:700;color:var(--accent)}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#8aa97b);color:white;text-decoration:none}\\n\\n    /* pricing table */\\n    .pricing{margin-top:26px;background:linear-gradient(180deg,#ffffff, #fbfffb);padding:18px;border-radius:12px}\\n    .tier{display:flex;align-items:center;justify-content:space-between;padding:14px;border-radius:10px;background:linear-gradient(180deg,rgba(107,142,106,0.04),transparent);margin-bottom:10px}\\n    .tier .name{font-weight:600}\\n    .fine{font-size:13px;color:#6b6b6b;margin-top:10px}\\n\\n    /* testimonials */\\n    .testimonials{margin-top:28px;display:grid;grid-template-columns:1fr 1fr;gap:12px}\\n    .test{padding:16px;border-radius:12px;background:linear-gradient(180deg,#fff,#fbfdfb);box-shadow:0 8px 18px rgba(8,10,10,0.03)}\\n    .test p{margin:0;color:#334}\\n\\n    footer{margin:36px 0 80px;color:#5b6b64;font-size:13px;text-align:center}\\n\\n    /* svg behind */\\n    .pattern-wrap{position:absolute;right:0;top:0;bottom:0;width:44%;pointer-events:none;opacity:0.22}\\n    svg{width:100%;height:100%}\\n\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.series{grid-template-columns:1fr}.pattern-wrap{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">HM</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:#6b6b6b\\\">A gentle, whole-person practice — {{CITY}}, {{STATE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"approach.html\\\">Our Way</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"hero\\\">\\n      <div class=\\\"lead\\\">\\n        <h1>Workshops & Seasonal Series — learning, practice, community</h1>\\n        <p class=\\\"lead\\\">Group workshops and short series designed to teach body-aware habits: sleep rituals, digestive resilience, stress patterns. Educational, supportive, and grounded in whole-person assessment.</p>\\n\\n        <div class=\\\"series\\\">\\n          <div class=\\\"card\\\">\\n            <h3>Seasonal Reset — 4 sessions</h3>\\n            <div class=\\\"meta\\\">Small group • Guided practices • Handouts</div>\\n            <div class=\\\"price\\\">$180 per person</div>\\n            <a class=\\\"cta\\\" href=\\\"book.html?series=seasonal-reset\\\">Reserve a spot</a>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <h3>Digestive Tune-Up — 6 weeks</h3>\\n            <div class=\\\"meta\\\">Weekly lessons • Q&A • Meal frameworks</div>\\n            <div class=\\\"price\\\">$320 per person</div>\\n            <a class=\\\"cta\\\" href=\\\"book.html?series=digestive\\\">Join the next cohort</a>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <h3>Sleep Rituals Workshop</h3>\\n            <div class=\\\"meta\\\">Single evening • Practical tools</div>\\n            <div class=\\\"price\\\">$45 suggested donation</div>\\n            <a class=\\\"cta\\\" href=\\\"book.html?series=sleep\\\">Sign up</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"pricing\\\">\\n          <div class=\\\"tier\\\"><div class=\\\"name\\\">Single Workshop</div><div class=\\\"price\\\">From $35</div></div>\\n          <div class=\\\"tier\\\"><div class=\\\"name\\\">4‑week Series (core)</div><div class=\\\"price\\\">$150–$220</div></div>\\n          <div class=\\\"tier\\\"><div class=\\\"name\\\">6‑8 Week Intensive</div><div class=\\\"price\\\">$300–$480</div></div>\\n          <div class=\\\"fine\\\">Sliding scale available; contact {{EMAIL}} for scholarship options. All programming is educational and supportive; not a substitute for medical care.</div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"aside\\\">\\n        <strong>Upcoming dates</strong>\\n        <div style=\\\"font-size:14px;color:#334;margin-bottom:12px\\\">Next cohort begins: Apr 4 • Evening series • Limited seats</div>\\n        <div style=\\\"font-size:13px;color:#6b6b6b\\\">Questions? Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        <a class=\\\"cta\\\" style=\\\"display:block;margin-top:14px;text-align:center\\\" href=\\\"book.html\\\">Book a spot</a>\\n      </aside>\\n    </div>\\n\\n    <div class=\\\"testimonials\\\">\\n      <div class=\\\"test\\\"><strong>\\\"I left with simple, usable habits.\\\"</strong><p>— Participant, Sleep Rituals Workshop</p></div>\\n      <div class=\\\"test\\\"><strong>\\\"The series helped me reframe my relationship to food.\\\"</strong><p>— Participant, Digestive Tune‑Up</p></div>\\n    </div>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"contact.html\\\">Contact</a> • <a href=\\\"book.html\\\">Book</a></div>\\n      <div style=\\\"margin-top:8px;font-size:12px;color:#7a877a\\\">Educational programming only. For individualized medical care, consult your licensed provider.</div>\\n    </footer>\\n\\n    <div class=\\\"pattern-wrap\\\" aria-hidden=\\\"true\\\">\\n      <svg viewBox=\\\"0 0 800 1200\\\" preserveAspectRatio=\\\"xMidYMid slice\\\">\\n        <defs>\\n          <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"1\\\" y2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#e6f4ea\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#f6fbf8\\\"/></linearGradient>\\n          <filter id=\\\"soft\\\"><feGaussianBlur stdDeviation=\\\"34\\\"/></filter>\\n        </defs>\\n        <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g1)\\\"/>\\n        <g fill=\\\"#bfe0c6\\\" opacity=\\\"0.9\\\" filter=\\\"url(#soft)\\\">\\n          <ellipse cx=\\\"600\\\" cy=\\\"160\\\" rx=\\\"260\\\" ry=\\\"120\\\"/>\\n          <ellipse cx=\\\"720\\\" cy=\\\"480\\\" rx=\\\"200\\\" ry=\\\"96\\\"/>\\n          <ellipse cx=\\\"520\\\" cy=\\\"860\\\" rx=\\\"320\\\" ry=\\\"160\\\"/>\\n        </g>\\n      </svg>\\n    </div>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Meet the practitioner, philosophy, and the practice's core values in whole‑person care.\\\">\\n  <style>\\n    :root{--bg:#fbfefb;--ink:#132;--accent:#7aa07a;--card:#fff;--muted:#6b6b6b}\\n    html,body{margin:0;padding:0;background:var(--bg);font-family:Georgia, 'Times New Roman', serif;color:var(--ink)}\\n    .frame{max-width:900px;margin:36px auto;padding:22px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    .nav{font-size:14px}\\n    .nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .title{margin-top:18px}\\n    h1{margin:0;font-size:30px;letter-spacing:-0.02em}\\n    .subtitle{color:#4b5b52;margin-top:8px;font-style:italic}\\n\\n    .intro{display:flex;gap:24px;margin-top:20px}\\n    .bio{flex:1;padding:20px;border-radius:14px;background:linear-gradient(180deg,#fff,#f8fff8);box-shadow:0 10px 30px rgba(16,20,18,0.04)}\\n    .portrait{width:260px;border-radius:12px;padding:18px;background:linear-gradient(180deg,rgba(122,160,122,0.06),transparent)}\\n    .portrait h3{margin:0}\\n    .small{font-size:13px;color:var(--muted);margin-top:6px}\\n\\n    .framework{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:18px}\\n    .pill{background:#fff;padding:14px;border-radius:12px;box-shadow:0 8px 20px rgba(12,16,14,0.03)}\\n    .pill h4{margin:0 0 6px 0}\\n\\n    .story{margin-top:22px;padding:16px;background:linear-gradient(180deg,#fff,#f9fff9);border-radius:12px}\\n    .cta{margin-top:18px;display:inline-block;padding:12px 16px;background:linear-gradient(90deg,var(--accent),#96c096);color:white;border-radius:10px;text-decoration:none}\\n\\n    footer{margin-top:36px;color:#6b6b6b;font-size:13px;text-align:center}\\n\\n    /* subtle decorative svg */\\n    .ornament{position:absolute;left:-40px;top:60px;opacity:0.12}\\n    @media (max-width:760px){.intro{flex-direction:column}.portrait{width:100%}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"frame\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">What we do</a>\\n        <a href=\\\"conditions.html\\\">Common Concerns</a>\\n        <a href=\\\"pricing.html\\\">Rates</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"title\\\">\\n      <h1>Who we are — a practice of listening</h1>\\n      <div class=\\\"subtitle\\\">Integrative, educational care that honors each person's story and context.</div>\\n    </div>\\n\\n    <div class=\\\"intro\\\">\\n      <div class=\\\"bio\\\">\\n        <p style=\\\"margin-top:6px\\\">I’m {{PRACTITIONER_NAME}}, {{CREDENTIALS}}. My work is rooted in a patient‑centered curiosity about how life, stress, sleep, movement, and food come together to shape wellbeing. I teach practical methods and design personalized plans that fit daily life.\\n        </p>\\n\\n        <div class=\\\"framework\\\">\\n          <div class=\\\"pill\\\"><h4>Intake</h4><div class=\\\"small\\\">Comprehensive listening: symptoms, rhythms, goals.</div></div>\\n          <div class=\\\"pill\\\"><h4>Personal Plan</h4><div class=\\\"small\\\">Tiny experiments—nutrition, rituals, movement, sleep.</div></div>\\n          <div class=\\\"pill\\\"><h4>Education</h4><div class=\\\"small\\\">Workshops, handouts, and guided practices for self-care.</div></div>\\n          <div class=\\\"pill\\\"><h4>Follow-up</h4><div class=\\\"small\\\">Short check-ins to refine and sustain change.</div></div>\\n        </div>\\n\\n        <div class=\\\"story\\\">\\n          <strong>A note on labs and testing</strong>\\n          <p style=\\\"margin:6px 0;color:#4b5b52\\\">When helpful, we discuss optional functional testing as an educational tool; tests are offered to inform personalized plans, never to replace medical diagnosis. We collaborate with your healthcare team as needed.</p>\\n        </div>\\n\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Schedule a conversation</a>\\n      </div>\\n\\n      <aside class=\\\"portrait\\\">\\n        <h3>{{PRACTITIONER_NAME}} <span style=\\\"font-weight:400;color:var(--muted)\\\">({{CREDENTIALS}})</span></h3>\\n        <div class=\\\"small\\\">Clinician • Coach • Educator</div>\\n        <div style=\\\"margin-top:12px;color:#4b5b52\\\">I blend nutritional insight, lifestyle coaching, and mindful practice to help people find steadier rhythms. I value small, sustainable shifts over quick fixes.</div>\\n        <div style=\\\"margin-top:18px;color:var(--muted);font-size:13px\\\">Reach: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n      </aside>\\n    </div>\\n\\n    <div style=\\\"position:relative;margin-top:30px\\\">\\n      <svg class=\\\"ornament\\\" width=\\\"140\\\" height=\\\"140\\\" viewBox=\\\"0 0 140 140\\\" aria-hidden=\\\"true\\\">\\n        <defs>\\n          <radialGradient id=\\\"rg2\\\"><stop offset=\\\"0\\\" stop-color=\\\"#cdebd0\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#f8fff8\\\"/></radialGradient>\\n        </defs>\\n        <circle cx=\\\"70\\\" cy=\\\"70\\\" r=\\\"66\\\" fill=\\\"url(#rg2)\\\"/>\\n      </svg>\\n    </div>\\n\\n    <section style=\\\"margin-top:28px\\\">\\n      <h2 style=\\\"margin:0 0 6px 0\\\">Philosophy — small practices, steady ground</h2>\\n      <p style=\\\"color:var(--muted);margin:0\\\">We honor context: environmental, social, and emotional factors are as relevant as symptoms. Our work is educational and collaborative; we never promise cures but offer tools and time to learn what works for you.</p>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"margin-top:30px\\\">{{BUSINESS_NAME}} — {{CITY}}, {{STATE}} • <a href=\\\"contact.html\\\">Connect</a></div>\\n      <div style=\\\"margin-top:6px;font-size:12px;color:var(--muted)\\\">All care described is educational. For medical advice, contact your licensed clinician.</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Reserve a spot in a workshop or request a consult. Simple booking for integrative programs.\\\">\\n  <style>\\n    :root{--bg:#ffffff;--accent:#5f9960;--ink:#102;--muted:#6c6c6c}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;background:linear-gradient(180deg,#fbfff9, #ffffff);color:var(--ink)}\\n    .container{max-width:880px;margin:34px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    h1{font-size:26px;margin:12px 0}\\n\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px}\\n    .form-card{background:#fff;padding:18px;border-radius:12px;box-shadow:0 12px 30px rgba(12,16,12,0.06)}\\n    label{display:block;font-size:13px;margin-top:12px;color:#234}\\n    input,select,textarea{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid #e6ece6;font-size:14px}\\n    button{margin-top:14px;padding:11px 14px;background:linear-gradient(90deg,var(--accent),#82ad82);color:white;border:none;border-radius:10px;font-weight:600}\\n\\n    .note{font-size:13px;color:var(--muted);margin-top:8px}\\n    .side{padding:16px;background:linear-gradient(180deg,#fff,#f7fff6);border-radius:12px}\\n    .spot{display:flex;justify-content:space-between;padding:10px;border-radius:10px;background:rgba(95,153,96,0.06);margin-top:10px}\\n\\n    .pattern{height:120px;margin-bottom:12px}\\n    footer{margin-top:22px;font-size:13px;color:var(--muted);text-align:center}\\n\\n    @media (max-width:900px){.grid{grid-template-columns:1fr}.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Main</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"pricing.html\\\">Rates</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <h1>Reserve a spot or request a consult</h1>\\n    <div class=\\\"grid\\\">\\n      <form id=\\\"booking\\\" class=\\\"form-card\\\" onsubmit=\\\"return submitForm(event)\\\">\\n        <label for=\\\"name\\\">Full name</label>\\n        <input id=\\\"name\\\" name=\\\"name\\\" required>\\n\\n        <label for=\\\"email\\\">Email</label>\\n        <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required placeholder=\\\"you@example.com\\\">\\n\\n        <label for=\\\"phone\\\">Phone</label>\\n        <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"{{PHONE}}\\\">\\n\\n        <label for=\\\"series\\\">I'm booking</label>\\n        <select id=\\\"series\\\" name=\\\"series\\\">\\n          <option value=\\\"consult\\\">Private consult</option>\\n          <option value=\\\"seasonal-reset\\\">Seasonal Reset — 4 sessions</option>\\n          <option value=\\\"digestive\\\">Digestive Tune‑Up — 6 weeks</option>\\n          <option value=\\\"sleep\\\">Sleep Rituals — workshop</option>\\n        </select>\\n\\n        <label for=\\\"notes\\\">Notes / goals (brief)</label>\\n        <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"What brought you here?\\\"></textarea>\\n\\n        <label style=\\\"margin-top:12px\\\"><input type=\\\"checkbox\\\" id=\\\"agree\\\" required> I understand the programming is educational and not a guaranteed medical cure.</label>\\n\\n        <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n          <button type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">Or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n        </div>\\n\\n        <div class=\\\"note\\\">After submitting you'll receive a confirmation by email and next steps. Payments are taken via secure links after reservation.</div>\\n      </form>\\n\\n      <aside class=\\\"side\\\">\\n        <div class=\\\"pattern\\\" aria-hidden=\\\"true\\\">\\n          <svg viewBox=\\\"0 0 360 120\\\" width=\\\"100%\\\" height=\\\"100%\\\">\\n            <defs>\\n              <pattern id=\\\"p1\\\" width=\\\"24\\\" height=\\\"24\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n                <rect width=\\\"24\\\" height=\\\"24\\\" fill=\\\"#f7fff6\\\"/>\\n                <circle cx=\\\"6\\\" cy=\\\"6\\\" r=\\\"2.5\\\" fill=\\\"#d7f0d8\\\"/>\\n                <circle cx=\\\"18\\\" cy=\\\"18\\\" r=\\\"2.5\\\" fill=\\\"#eaf7ea\\\"/>\\n              </pattern>\\n            </defs>\\n            <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\"/>\\n          </svg>\\n        </div>\\n\\n        <div style=\\\"font-weight:700\\\">Upcoming</div>\\n        <div class=\\\"spot\\\"><div>Seasonal Reset</div><div>Next: Apr 4</div></div>\\n        <div class=\\\"spot\\\"><div>Sleep Workshop</div><div>Next: Mar 19</div></div>\\n        <div style=\\\"margin-top:12px;font-size:13px;color:var(--muted)\\\">Need help choosing? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n\\n        <div style=\\\"margin-top:14px;font-size:13px\\\">\\n          <strong>Policies</strong>\\n          <p style=\\\"margin:6px 0;color:var(--muted)\\\">Cancellations within 48 hours may forfeit fee. Sliding scale for series; ask for details.</p>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer>\\n      <div>Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n      <div style=\\\"margin-top:8px;color:var(--muted);font-size:12px\\\">Educational services only. For urgent or emergent medical concerns, contact emergency services.</div>\\n    </footer>\\n  </div>\\n\\n  <script>\\n    function submitForm(e){\\n      e.preventDefault();\\n      const form=document.getElementById('booking');\\n      const data={\\n        name:form.name.value,\\n        email:form.email.value,\\n        phone:form.phone.value,\\n        series:form.series.value,\\n        notes:form.notes.value\\n      };\\n      // Minimal client-side flow: redirect to PRIMARY_CTA_URL with encoded data\\n      const params=new URLSearchParams(data).toString();\\n      const target='{{PRIMARY_CTA_URL}}';\\n      if(!target || target===''){\\n        alert('Thanks — we would send confirmation to ' + data.email);\\n        return false;\\n      }\\n      window.location.href = target + (target.includes('?') ? '&' : '?') + params;\\n      return false;\\n    }\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
