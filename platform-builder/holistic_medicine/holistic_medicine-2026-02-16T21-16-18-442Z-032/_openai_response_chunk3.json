          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investment — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#f6fbf8;--accent:#6b8f6b;--muted:#6d6d6d;--card:#ffffff;--glass:rgba(255,255,255,0.6)}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;color:#123;background:linear-gradient(180deg,var(--bg1),#eef6f2);}\\n    .wrap{min-height:100%;display:flex;flex-direction:column;}\\n    nav{display:flex;justify-content:space-between;align-items:center;padding:22px 28px;background:transparent}\\n    .brand{font-weight:600;color:var(--accent)}\\n    .links{display:flex;gap:14px;font-size:0.95rem}\\n    .links a{color:#123;text-decoration:none;padding:8px 10px;border-radius:8px}\\n    .links a:hover{background:rgba(0,0,0,0.04)}\\n    header.hero{position:relative;overflow:hidden;padding:48px 28px 60px;}\\n    .canvas{position:absolute;inset:0;pointer-events:none;opacity:0.28}\\n    .sheet{max-width:980px;margin:0 auto;display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center}\\n    .lead{padding:28px;background:linear-gradient(180deg,rgba(255,255,255,0.8),var(--glass));border-radius:14px;backdrop-filter:blur(6px)}\\n    h1{margin:0 0 10px;font-size:2rem;line-height:1.05}\\n    p.lead-by{margin:0;color:var(--muted)}\\n    .price-card{padding:20px;border-radius:12px;background:var(--card);box-shadow:0 6px 20px rgba(12,18,12,0.06)}\\n    .tier{display:flex;flex-direction:column;gap:8px}\\n    .tier strong{font-size:1.15rem}\\n    .list{margin:14px 0 0;padding:0;list-style:none;color:var(--muted)}\\n    main{max-width:980px;margin:24px auto;padding:0 28px 80px}\\n    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}\\n    .card{background:var(--card);padding:16px;border-radius:10px;box-shadow:0 6px 18px rgba(11,20,14,0.04)}\\n    .muted{color:var(--muted);font-size:0.95rem}\\n    .cta-row{display:flex;gap:12px;align-items:center;margin-top:12px}\\n    .btn{background:linear-gradient(90deg,var(--accent),#4f7a4f);color:white;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    footer{padding:28px;text-align:center;color:var(--muted);font-size:0.9rem}\\n    /* FAQ small interactions */\\n    details{background:linear-gradient(180deg,rgba(255,255,255,0.7),#fff);padding:12px;border-radius:8px}\\n    summary{cursor:pointer;font-weight:600}\\n    @media(max-width:860px){.sheet{grid-template-columns:1fr;}.lead{order:2}.price-card{order:1}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"links\\\">\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"conditions.html\\\">Concerns</a>\\n        <a href=\\\"approach.html\\\">How we work</a>\\n        <a href=\\\"pricing.html\\\" aria-current=\\\"page\\\">Investment</a>\\n        <a href=\\\"about.html\\\">Who we are</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n      </div>\\n    </nav>\\n\\n    <header class=\\\"hero\\\">\\n      <!-- unique svg background: soft cellular motif -->\\n      <svg class=\\\"canvas\\\" viewBox=\\\"0 0 800 500\\\" preserveAspectRatio=\\\"xMidYMid slice\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n        <defs>\\n          <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n            <stop offset=\\\"0\\\" stop-color=\\\"#dff3e8\\\" />\\n            <stop offset=\\\"1\\\" stop-color=\\\"#eaf7ee\\\" />\\n          </linearGradient>\\n          <filter id=\\\"blur\\\"><feGaussianBlur stdDeviation=\\\"35\\\" /></filter>\\n        </defs>\\n        <g fill=\\\"url(#g1)\\\" filter=\\\"url(#blur)\\\" opacity=\\\"0.95\\\">\\n          <circle cx=\\\"120\\\" cy=\\\"120\\\" r=\\\"140\\\" />\\n          <circle cx=\\\"400\\\" cy=\\\"80\\\" r=\\\"100\\\" />\\n          <circle cx=\\\"680\\\" cy=\\\"180\\\" r=\\\"150\\\" />\\n          <circle cx=\\\"520\\\" cy=\\\"360\\\" r=\\\"120\\\" />\\n        </g>\\n      </svg>\\n\\n      <div class=\\\"sheet\\\">\\n        <div class=\\\"lead\\\">\\n          <h1>Practical pricing for mindful care</h1>\\n          <p class=\\\"lead-by\\\">Events, workshops and a series model designed to support whole-person change — education, nutrition literacy, movement and guided coaching. No promises of cure; only pathways and skilled guidance.</p>\\n          <div class=\\\"cta-row\\\">\\n            <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n            <a href=\\\"contact.html\\\" style=\\\"color:var(--muted);text-decoration:none;padding:8px;border-radius:8px\\\">Contact {{PRACTITIONER_NAME}}</a>\\n          </div>\\n        </div>\\n\\n        <aside class=\\\"price-card\\\">\\n          <div class=\\\"tier\\\">\\n            <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n              <strong>Series Plan</strong><span class=\\\"muted\\\">Events + 5 follow-ups</span>\\n            </div>\\n            <div class=\\\"muted\\\">Starting at</div>\\n            <div style=\\\"font-size:1.6rem;font-weight:700\\\">$420</div>\\n            <ul class=\\\"list\\\">\\n              <li>Group learning sessions</li>\\n              <li>Two private touchpoints</li>\\n              <li>Guided home plan & resources</li>\\n            </ul>\\n          </div>\\n        </aside>\\n      </div>\\n    </header>\\n\\n    <main>\\n      <section>\\n        <h2>What you get — gentle pillars of practice</h2>\\n        <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n          <div class=\\\"card\\\"><strong>Education</strong><p class=\\\"muted\\\">Evidence-framed learning about how body, mind and environment interplay.</p></div>\\n          <div class=\\\"card\\\"><strong>Nutrition & Lifestyle</strong><p class=\\\"muted\\\">Practical steps tailored to rhythms, not rigid rules.</p></div>\\n          <div class=\\\"card\\\"><strong>Mind-Body Tools</strong><p class=\\\"muted\\\">Breath, movement and sleep strategies to stabilize energy.</p></div>\\n          <div class=\\\"card\\\"><strong>Follow-up Support</strong><p class=\\\"muted\\\">Short check-ins to adapt plans and celebrate small wins.</p></div>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:28px\\\">\\n        <h3>Selected session formats</h3>\\n        <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n          <div class=\\\"card\\\"><strong>Intro Workshop (90m)</strong><p class=\\\"muted\\\">Group orientation to topics and approachable practices.</p></div>\\n          <div class=\\\"card\\\"><strong>Deep-Dive (2h)</strong><p class=\\\"muted\\\">Focused skill-building and personalized pointers.</p></div>\\n          <div class=\\\"card\\\"><strong>Private Consult</strong><p class=\\\"muted\\\">Individual intake, tailored plan, optional educational labs.</p></div>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:28px\\\">\\n        <h3>Common questions</h3>\\n        <details>\\n          <summary>Are labs required?</summary>\\n          <p class=\\\"muted\\\">Optional labs may be suggested for education and clarity; they are never mandatory. Any lab work is discussed and consented to before ordering.</p>\\n        </details>\\n        <details style=\\\"margin-top:10px\\\">\\n          <summary>Do you guarantee improvement?</summary>\\n          <p class=\\\"muted\\\">No guarantee is made. Our work focuses on education, supported habit change and whole-person assessment. Results vary.</p>\\n        </details>\\n      </section>\\n\\n      <section style=\\\"margin-top:28px\\\">\\n        <h3>Case notes — small stories of steady change</h3>\\n        <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n          <div class=\\\"card\\\"><strong>Sleep & Rhythm</strong><p class=\\\"muted\\\">Patient-centered tweaks to evening routines that improved sleep continuity over weeks.</p></div>\\n          <div class=\\\"card\\\"><strong>Digestive Education</strong><p class=\\\"muted\\\">Dietary re-education and mindful eating reduced bloating and supported energy.</p></div>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:28px\\\">\\n        <h3>Myths vs. thoughtful truth</h3>\\n        <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n          <div class=\\\"card\\\"><strong>Myth:</strong> Quick fixes heal everything.<p class=\\\"muted\\\">Truth: Durability comes from incremental, supported changes.</p></div>\\n          <div class=\\\"card\\\"><strong>Myth:</strong> More tests always mean better care.<p class=\\\"muted\\\">Truth: Tests are tools; their value lies in how results shape meaningful plans.</p></div>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:28px;display:flex;gap:14px;align-items:center;justify-content:space-between\\\">\\n        <div>\\n          <h3>Ready to join a series?</h3>\\n          <p class=\\\"muted\\\">Sign up for the next cohort, or book a short consult to see if the format fits your needs.</p>\\n        </div>\\n        <div>\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Save my spot</a>\\n        </div>\\n      </section>\\n    </main>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} — {{TAGLINE}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div style=\\\"margin-top:8px;color:var(--muted)\\\">Located in {{CITY}}, {{STATE}} — Practitioned by {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Who we are — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfcfb;--ink:#163;--soft:#8fb38f}\\n    body{margin:0;font-family:ui-sans-serif,system-ui,Segoe UI,Roboto;color:#072;background:linear-gradient(180deg,#fff,#f4faf4)}\\n    header{padding:22px 26px;display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:12px;text-decoration:none;color:var(--ink)}\\n    .wrap{max-width:980px;margin:18px auto;padding:0 20px}\\n    .intro{background:linear-gradient(180deg,rgba(255,255,255,0.9),#fff);padding:20px;border-radius:12px;box-shadow:0 6px 18px rgba(10,20,10,0.04)}\\n    .meta{display:flex;gap:18px;align-items:center;margin-top:12px}\\n    .portrait{width:84px;height:84px;border-radius:12px;background:linear-gradient(135deg,#eaf6ea,#dff3e5);display:flex;align-items:center;justify-content:center;font-weight:700;color:#2a5}\\n    h1{margin:0;font-size:1.6rem}\\n    p{color:#496;line-height:1.45}\\n    section{margin-top:18px}\\n    .values{display:flex;gap:14px;flex-wrap:wrap}\\n    .pill{background:white;padding:10px;border-radius:10px;box-shadow:0 6px 14px rgba(12,20,12,0.03)}\\n    .muted{color:#657;font-size:0.95rem}\\n    .cta{margin-top:18px}\\n    .btn{background:linear-gradient(90deg,var(--soft),#6e9e6e);color:white;padding:10px 14px;border-radius:9px;text-decoration:none}\\n    footer{margin:36px 0 18px;color:#6b7}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:600\\\">{{BUSINESS_NAME}}</div>\\n    <div class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"conditions.html\\\">Conditions</a>\\n      <a href=\\\"approach.html\\\">Approach</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"about.html\\\" aria-current=\\\"page\\\">About</a>\\n      <a href=\\\"book.html\\\">Schedule</a>\\n    </div>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <div class=\\\"intro\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <h1>We work with people, not symptoms</h1>\\n          <p class=\\\"muted\\\">A small practice blending evidence-informed guidance with curious listening. We partner with you to explore patterns and build practical supports — not to promise cures.</p>\\n        </div>\\n        <div class=\\\"meta\\\">\\n          <div class=\\\"portrait\\\">{{PRACTITIONER_NAME}}</div>\\n          <div style=\\\"text-align:right\\\">\\n            <div style=\\\"font-weight:700\\\">{{PRACTITIONER_NAME}}</div>\\n            <div class=\\\"muted\\\">{{CREDENTIALS}}</div>\\n            <div style=\\\"margin-top:8px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Book a short meet</a></div>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n\\n    <section>\\n      <h2>A short story of approach</h2>\\n      <p class=\\\"muted\\\">We combine nutrition, lifestyle coaching, movement and stress regulation work. Our event-series model gathers people for shared learning; our private consults refine plans for individuals. Lab work is a tool we may recommend for clarity; it is optional and discussed thoughtfully.</p>\\n    </section>\\n\\n    <section>\\n      <h2>Core commitments</h2>\\n      <div class=\\\"values\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"pill\\\"><strong>Curiosity</strong><div class=\\\"muted\\\">We ask before we advise.</div></div>\\n        <div class=\\\"pill\\\"><strong>Practicality</strong><div class=\\\"muted\\\">Small steps you can keep.</div></div>\\n        <div class=\\\"pill\\\"><strong>Evidence-first</strong><div class=\\\"muted\\\">Education helps decisions.</div></div>\\n        <div class=\\\"pill\\\"><strong>Respect</strong><div class=\\\"muted\\\">Your life informs the plan.</div></div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h2>Selected notes</h2>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px\\\">\\n        <div class=\\\"pill\\\"><strong>Client A</strong><p class=\\\"muted\\\">Built a sleep ritual and saw gradual improvement in daytime energy over 8 weeks.</p></div>\\n        <div class=\\\"pill\\\"><strong>Client B</strong><p class=\\\"muted\\\">Education about mindful eating reduced post-meal discomfort and increased confidence.</p></div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h2>Questions people ask</h2>\\n      <div style=\\\"margin-top:12px\\\">\\n        <div class=\\\"pill\\\"><strong>Is this medical care?</strong><p class=\\\"muted\\\">This practice offers integrative and educational care that complements medical treatment. We do not replace urgent or specialized medical care.</p></div>\\n        <div class=\\\"pill\\\" style=\\\"margin-top:10px\\\"><strong>How quickly will I feel different?</strong><p class=\\\"muted\\\">Change timelines are personal. We emphasize steady, sustainable adjustments over quick fixes.</p></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"cta\\\">\\n      <h2>Meet us in a workshop or a short consult</h2>\\n      <p class=\\\"muted\\\">Attend an event to learn with peers, or book a private intake to get a tailored plan.</p>\\n      <div style=\\\"margin-top:10px\\\">\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bgA:#fcfff9;--accent:#4a7c4a;--muted:#587}\\n    body{margin:0;font-family:Inter,ui-sans-serif,system-ui,Segoe UI,Roboto;background:linear-gradient(160deg,var(--bgA),#eef7ef);color:#0c2}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 22px}\\n    .nav a{margin-left:12px;color:#153;text-decoration:none}\\n    .container{max-width:920px;margin:18px auto;padding:0 20px}\\n    .panel{background:white;border-radius:12px;padding:18px;box-shadow:0 10px 30px rgba(12,20,12,0.05)}\\n    h1{margin-top:0}\\n    form{display:grid;grid-template-columns:1fr 280px;gap:18px}\\n    label{display:block;margin-bottom:6px;font-weight:600}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6efe6}\\n    .right{background:linear-gradient(180deg,#f9fff8,#fff);padding:14px;border-radius:10px}\\n    .btn{display:inline-block;background:linear-gradient(90deg,var(--accent),#3f6c3f);color:white;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    .note{color:var(--muted);font-size:0.95rem}\\n    footer{margin-top:18px;color:var(--muted)}\\n    /* subtle background svg motif */\\n    .pattern{position:fixed;right:-120px;bottom:-100px;opacity:0.12;pointer-events:none}\\n    @media(max-width:820px){form{grid-template-columns:1fr} .pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Begin</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"approach.html\\\">Approach</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\" aria-current=\\\"page\\\">Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <div class=\\\"container\\\">\\n    <div class=\\\"panel\\\">\\n      <h1>Reserve a spot or a short consult</h1>\\n      <p class=\\\"note\\\">Choose a session type below — workshops are collaborative, consults are private. We emphasize education, paced change, and informed consent. No guarantees are given.</p>\\n\\n      <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\">\\n        <div>\\n          <label for=\\\"name\\\">Your name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"Full name\\\" required>\\n\\n          <label for=\\\"email\\\" style=\\\"margin-top:12px\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n\\n          <label for=\\\"type\\\" style=\\\"margin-top:12px\\\">Session type</label>\\n          <select id=\\\"type\\\" name=\\\"type\\\">\\n            <option>Intro Workshop (group)</option>\\n            <option>Series Enrollment</option>\\n            <option>Private Intake (60m)</option>\\n            <option>Follow-up (25m)</option>\\n          </select>\\n\\n          <label for=\\\"notes\\\" style=\\\"margin-top:12px\\\">Short note</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"A few lines about what you hope to address\\\"></textarea>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <button class=\\\"btn\\\" type=\\\"submit\\\">Request booking</button>\\n          </div>\\n        </div>\\n\\n        <aside class=\\\"right\\\">\\n          <h3>Before we meet</h3>\\n          <p class=\\\"note\\\">A brief intake form will be sent after you request a booking. Optional labs may be discussed as educational tools. If you have urgent medical needs, please seek immediate care.</p>\\n\\n          <h4 style=\\\"margin-top:12px\\\">Session costs</h4>\\n          <div class=\\\"note\\\">Workshop: starting $45 • Private intake: $140 • Series plans available — see Pricing.</div>\\n\\n          <div style=\\\"margin-top:16px\\\">\\n            <strong>Contact</strong>\\n            <div class=\\\"note\\\">{{PHONE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n            <div style=\\\"margin-top:8px\\\"><a class=\\\"btn\\\" href=\\\"contact.html\\\">Message us</a></div>\\n          </div>\\n        </aside>\\n      </form>\\n\\n      <section style=\\\"margin-top:18px\\\">\\n        <h3>Myth vs. helpful view</h3>\\n        <div style=\\\"display:flex;gap:12px;flex-wrap:wrap;margin-top:8px\\\">\\n          <div style=\\\"flex:1;min-width:200px;background:#fff;padding:10px;border-radius:10px;box-shadow:0 8px 18px rgba(12,18,12,0.03)\\\"><strong>Myth</strong><p class=\\\"note\\\">A single test will explain everything.</p></div>\\n          <div style=\\\"flex:1;min-width:200px;background:#fff;padding:10px;border-radius:10px;box-shadow:0 8px 18px rgba(12,18,12,0.03)\\\"><strong>Better</strong><p class=\\\"note\\\">Tests can illuminate one piece; we integrate data with lived experience.</p></div>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px\\\">\\n        <h3>A brief case note</h3>\\n        <div style=\\\"background:#fff;padding:12px;border-radius:10px;box-shadow:0 8px 18px rgba(12,18,12,0.03)\\\">\\n          <strong>Digestive learning</strong>\\n          <p class=\\\"note\\\">Education on meal timing and mindful eating helped a participant lower bloating and normalize energy over several weeks.</p>\\n        </div>\\n      </section>\\n\\n    </div>\\n\\n    <footer style=\\\"margin-top:14px;color:var(--muted)\\\">\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • Practitioner: {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n      <div style=\\\"margin-top:6px\\\">By requesting a booking you consent to receiving a scheduling email. This practice provides educational, integrative care; it is not a substitute for emergency medical services.</div>\\n    </footer>\\n  </div>\\n\\n  <!-- decorative svg pattern -->\\n  <svg class=\\\"pattern\\\" width=\\\"380\\\" height=\\\"380\\\" viewBox=\\\"0 0 380 380\\\" xml