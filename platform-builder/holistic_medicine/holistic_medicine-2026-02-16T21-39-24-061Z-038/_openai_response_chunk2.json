          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#6a8cff;--muted:#6b6b6b;--bg1:linear-gradient(180deg,#fbfcff 0%,#f3f7ff 100%);font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial}\\n    html,body{height:100%}\\n    body{margin:0;background:var(--bg1), url('assets/img/pattern.svg');background-size:2400px; color:#203047}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:24px 32px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:48px;height:48px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),#a1d8ff);color:#fff;font-weight:700}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600}\\n    main{max-width:1100px;margin:24px auto;padding:28px;background:rgba(255,255,255,0.7);border-radius:14px;box-shadow:0 6px 30px rgba(32,48,71,0.08)}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center}\\n    .hero h1{margin:0;font-size:28px;color:#122132}\\n    .hero p{color:var(--muted);margin-top:10px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.9),#fff);padding:18px;border-radius:12px;border:1px solid rgba(15,20,30,0.04)}\\n    .services-list{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:18px}\\n    .svc{padding:14px;border-radius:10px;background:linear-gradient(180deg,#fff,#fbfdff);border:1px solid rgba(106,140,255,0.08)}\\n    .muted{color:var(--muted);font-size:14px}\\n    .cta{display:inline-block;margin-top:14px;padding:10px 16px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none;font-weight:700}\\n    .testimonials{display:flex;gap:12px;margin-top:18px}\\n    .test{flex:1;padding:12px;border-radius:10px;background:linear-gradient(90deg,#ffffff,#f7fbff);border:1px solid rgba(16,24,40,0.04)}\\n    dl{margin:0}\\n    dt{font-weight:700}\\n    .faq{margin-top:20px}\\n    footer{display:flex;justify-content:space-between;align-items:center;padding:20px 32px;color:var(--muted)}\\n    .leadmag{display:flex;gap:8px;margin-top:18px}\\n    input[type=\\\"email\\\"]{flex:1;padding:10px;border-radius:8px;border:1px solid rgba(15,20,30,0.06)}\\n    button{padding:10px 12px;border-radius:8px;border:0;background:linear-gradient(90deg,var(--accent),#7ce0ff);color:#06324a;font-weight:700}\\n    @media (max-width:880px){.hero{grid-template-columns:1fr}.services-list{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\" aria-current=\\\"page\\\">Offerings</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"approach.html\\\">How I Work</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Integrative sessions and focused programs for whole-person health</h1>\\n        <p>Personalized plans that marry modern evidence with traditional wisdom — an intensive, guided path to clearer sleep, calmer stress, and steadier energy. Education-first, collaboration-forward.</p>\\n\\n        <div class=\\\"card\\\">\\n          <strong>Core offerings</strong>\\n          <div class=\\\"services-list\\\">\\n            <div class=\\\"svc\\\">\\n              <strong>Initial Comprehensive Intake</strong>\\n              <div class=\\\"muted\\\">90–120 min deep-dive &amp; goal mapping</div>\\n            </div>\\n            <div class=\\\"svc\\\">\\n              <strong>Focused Follow-Up</strong>\\n              <div class=\\\"muted\\\">45–60 min progress &amp; plan tweaks</div>\\n            </div>\\n            <div class=\\\"svc\\\">\\n              <strong>Stress &amp; Sleep Coaching</strong>\\n              <div class=\\\"muted\\\">Practical tools, breathing, and rhythm work</div>\\n            </div>\\n            <div class=\\\"svc\\\">\\n              <strong>Nutritional Strategy</strong>\\n              <div class=\\\"muted\\\">Food-first guidance tailored to digestion &amp; energy</div>\\n            </div>\\n          </div>\\n\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <strong>Quick facts</strong>\\n          <dl style=\\\"margin-top:8px\\\">\\n            <dt>Format</dt>\\n            <dd class=\\\"muted\\\">Video or in-person sessions in {{CITY}}, {{STATE}}</dd>\\n            <dt>Practitioner</dt>\\n            <dd class=\\\"muted\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</dd>\\n            <dt>Contact</dt>\\n            <dd class=\\\"muted\\\">{{EMAIL}} • {{PHONE}}</dd>\\n          </dl>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <strong>Testimonials</strong>\\n            <div class=\\\"testimonials\\\">\\n              <div class=\\\"test\\\">\\\"I finally sleep more than three hours — practical steps that actually fit my life.\\\" — A.</div>\\n              <div class=\\\"test\\\">\\\"Clear explanations and a plan I could follow. Education over hype.\\\" — M.</div>\\n            </div>\\n          </div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px;display:flex;gap:20px;align-items:flex-start\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h2>Why people choose this program</h2>\\n        <p class=\\\"muted\\\">We emphasize understanding the whole story — lifestyle, stress response, digestion, sleep, and routines — then build a focused, intensive plan.</p>\\n\\n        <ul>\\n          <li><strong>Actionable education:</strong> You get clear why something matters and small steps you can try immediately.</li>\\n          <li><strong>Tailored tools:</strong> Not one-size-fits-all—nutrition, movement, supplements only when useful.</li>\\n          <li><strong>Evidence-forward:</strong> We use research as a guide and monitor what actually helps you.</li>\\n        </ul>\\n      </div>\\n\\n      <div style=\\\"width:320px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Sample session flow</strong>\\n          <ol style=\\\"margin:8px 0 0 18px\\\">\\n            <li>History &amp; symptom mapping</li>\\n            <li>Immediate practical steps</li>\\n            <li>Personalized plan &amp; resources</li>\\n            <li>Scheduled follow-up and tracking</li>\\n          </ol>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3>Questions people ask</h3>\\n      <div style=\\\"display:grid;gap:12px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Do you cure chronic conditions?</strong>\\n          <div class=\\\"muted\\\">We focus on supporting resilience and symptom improvement through education and behavioral change. We do not promise cures.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Are labs included?</strong>\\n          <div class=\\\"muted\\\">Optional educational labs may be recommended; choices are discussed together and fit the plan.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>Free guide — Practical Steps for Better Sleep &amp; Rhythm</h3>\\n      <p class=\\\"muted\\\">A short PDF that outlines small, evidence-based adjustments you can start this week.</p>\\n      <form class=\\\"leadmag\\\" onsubmit=\\\"event.preventDefault();alert('Thanks! Please check your email.');\\\">\\n        <input type=\\\"email\\\" placeholder=\\\"Your best email\\\" aria-label=\\\"Email\\\" required />\\n        <button type=\\\"submit\\\">Send the guide</button>\\n      </form>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px;text-align:center\\\">\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book an intensive consult — {{PRIMARY_CTA_LABEL}}</a>\\n      <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Prefer a quick question? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>&copy; <strong>{{BUSINESS_NAME}}</strong> · {{CITY}}, {{STATE}}</div>\\n    <div class=\\\"muted\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Conditions &amp; Concerns — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--teal:#2bb7a6;--soft:#9fb8c9;--muted:#6c6c6c;font-family:Georgia,serif}\\n    body{margin:0;background:linear-gradient(180deg,#ffffff,#f2fbfa);color:#0e2b2a;background-image:url('assets/img/pattern.svg');background-size:1800px}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px}\\n    .brand{font-weight:800;color:#073533}\\n    nav a{margin-left:14px;color:#0e2b2a;text-decoration:none}\\n    main{max-width:950px;margin:18px auto;padding:26px;background:rgba(255,255,255,0.85);border-radius:12px}\\n    h1{margin:0;color:#03302f}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:16px}\\n    .box{padding:14px;border-radius:10px;background:linear-gradient(180deg,#ffffff,#f6fffb);border:1px solid rgba(43,183,166,0.08)}\\n    ul{padding-left:18px}\\n    .disclaimer{font-size:13px;color:var(--muted);margin-top:10px}\\n    .leadmag{margin-top:14px}\\n    input,button{padding:10px;border-radius:8px;border:1px solid rgba(0,0,0,0.06)}\\n    .cta{display:block;margin-top:18px;padding:10px 12px;background:var(--teal);color:white;text-decoration:none;border-radius:10px;text-align:center}\\n    footer{padding:18px 28px;color:var(--muted)}\\n    @media (max-width:880px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">What I Offer</a>\\n      <a href=\\\"conditions.html\\\" aria-current=\\\"page\\\">Your Concerns</a>\\n      <a href=\\\"approach.html\\\">Approach</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\">Schedule</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <h1>Common challenges people bring in</h1>\\n    <p class=\\\"disclaimer\\\">Below are common areas of concern we support through education, lifestyle planning, and team-based care. Treatments are individualized and we do not claim cures — we aim for measurable improvements in function and quality of life.</p>\\n\\n    <div class=\\\"grid\\\">\\n      <section>\\n        <div class=\\\"box\\\">\\n          <h2>Stress &amp; Anxiety</h2>\\n          <p class=\\\"disclaimer\\\">Practical, daily tools plus rhythm and breathing practices to reduce physiological arousal. Appropriate referrals are made when specialized mental health care is needed.</p>\\n        </div>\\n\\n        <div class=\\\"box\\\" style=\\\"margin-top:12px\\\">\\n          <h2>Sleep Difficulties</h2>\\n          <p class=\\\"disclaimer\\\">Regular sleep architecture support: sleep hygiene, circadian rhythm, and behavioral adjustments. We discuss caffeine, screen habits, and bedtime routines rather than promising instant fixes.</p>\\n        </div>\\n\\n        <div class=\\\"box\\\" style=\\\"margin-top:12px\\\">\\n          <h2>Digestive Concerns</h2>\\n          <p class=\\\"disclaimer\\\">Bloating, irregularity, and sensitivity are approached via dietary patterns, mindful eating, and gut-support strategies. Labs may be discussed for educational insight.</p>\\n        </div>\\n\\n        <div class=\\\"box\\\" style=\\\"margin-top:12px\\\">\\n          <h2>Low Energy &amp; Burnout</h2>\\n          <p class=\\\"disclaimer\\\">We look at sleep, nutrition, stress load, and movement. Goals are to restore sustainable energy through small, measurable changes.</p>\\n        </div>\\n\\n        <div class=\\\"box\\\" style=\\\"margin-top:12px\\\">\\n          <h2>Chronic Low-Grade Inflammation</h2>\\n          <p class=\\\"disclaimer\\\">Inflammation is complex; we focus on diet patterns, movement, sleep, and mitigation strategies. Medical management remains coordinated with your primary team.</p>\\n        </div>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"box\\\">\\n          <strong>How we decide next steps</strong>\\n          <ol style=\\\"margin:8px 0 0 18px\\\">\\n            <li>Listen to your full history</li>\\n            <li>Identify highest-impact targets</li>\\n            <li>Offer education &amp; practical experiments</li>\\n            <li>Recommend optional labs when helpful</li>\\n          </ol>\\n\\n          <p class=\\\"disclaimer\\\" style=\\\"margin-top:12px\\\">If you have acute or severe symptoms, please seek immediate medical attention. Our work is complementary to medical care and not a substitute for emergency services.</p>\\n        </div>\\n\\n        <div class=\\\"box\\\" style=\\\"margin-top:12px\\\">\\n          <strong>Quick symptom checklist</strong>\\n          <ul>\\n            <li>Persistent sleep problems</li>\\n            <li>Daily, overwhelming stress</li>\\n            <li>Ongoing digestive upset</li>\\n            <li>Low mood or energy</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"box\\\" style=\\\"margin-top:12px\\\">\\n          <strong>Free resource</strong>\\n          <p class=\\\"disclaimer\\\">Sign up for a short email mini-course: 5 simple experiments to test what might help you feel steadier.</p>\\n          <form class=\\\"leadmag\\\" onsubmit=\\\"event.preventDefault();alert('Thanks — we\\\\'ll send the mini-course shortly.');\\\">\\n            <input type=\\\"email\\\" placeholder=\\\"Email for the mini-course\\\" required />\\n            <button type=\\\"submit\\\" style=\\\"margin-top:8px;background:var(--teal);color:#fff;border:none\\\">Get the mini-course</button>\\n          </form>\\n        </div>\\n\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a discovery call</a>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>Short FAQ</h3>\\n      <div style=\\\"display:grid;gap:10px;margin-top:10px\\\">\\n        <div class=\\\"box\\\">\\n          <strong>Will you replace my current doctor?</strong>\\n          <div class=\\\"disclaimer\\\">No. We coordinate with your medical team and provide complementary strategies focused on whole-person wellness.</div>\\n        </div>\\n        <div class=\\\"box\\\">\\n          <strong>Do you use supplements?</strong>\\n          <div class=\\\"disclaimer\\\">Supplement suggestions are made selectively and explained clearly — including evidence, risks, and expected timeline.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;text-align:center\\\">\\n      <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"cta\\\">Start with an intake — {{PRIMARY_CTA_LABEL}}</a>\\n      <p class=\\\"disclaimer\\\" style=\\\"margin-top:8px\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></p>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} · {{CITY}}, {{STATE}}</div>\\n    <div class=\\\"disclaimer\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>My Approach — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--purple:#8b5cf6;--ink:#101827;--muted:#6b7280;font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\"}\\n    body{margin:0;background:linear-gradient(180deg,#fff7ff,#f6fbff);color:var(--ink);background-image:url('assets/img/pattern.svg');background-size:2000px}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 26px}\\n    .brand{font-weight:800}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    main{max-width:1000px;margin:20px auto;padding:24px;background:rgba(255,255,255,0.9);border-radius:14px}\\n    .hero{display:flex;gap:18px;align-items:center}\\n    .badge{background:linear-gradient(135deg,var(--purple),#a78bfa);color:#fff;padding:8px 12px;border-radius:999px;font-weight:700}\\n    .process{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:18px}\\n    .step{padding:14px;border-radius:12px;background:#fff;border:1px solid rgba(139,92,246,0.07)}\\n    .muted{color:var(--muted)}\\n    .faq{margin-top:18px}\\n    .leadmag{margin-top:14px;display:flex;gap:8px}\\n    input[type=\\\"email\\\"]{flex:1;padding:10px;border-radius:8px;border:1px solid rgba(0,0,0,0.06)}\\n    button{padding:10px 12px;border-radius:8px;border:0;background:var(--purple);color:#fff}\\n    .cta{display:inline-block;margin-top:14px;padding:10px 16px;border-radius:10px;background:linear-gradient(90deg,var(--purple),#6dd3ff);color:#fff;text-decoration:none;font-weight:700}\\n    @media (max-width:900px){.process{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Welcome</a>\\n      <a href=\\\"services.html\\\">Programs</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"approach.html\\\" aria-current=\\\"page\\\">My Method</a>\\n      <a href=\\\"contact.html\\\">Say Hello</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <div class=\\\"badge\\\">Intensive &amp; Educational</div>\\n        <h1 style=\\\"margin-top:10px\\\">A clear, stepwise path — understand, try, measure, refine</h1>\\n        <p class=\\\"muted\\\">We treat patterns, not isolated symptoms. Each step is documented and explained so you learn what works for you.</p>\\n\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book an intake — {{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n\\n      <aside style=\\\"width:320px\\\">\\n        <div style=\\\"padding:12px;border-radius:12px;background:linear-gradient(180deg,#fff,#fbf8ff);border:1px solid rgba(16,24,40,0.04)\\\">\\n          <strong>Practitioner</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n          <div style=\\\"margin-top:8px\\\" class=\\\"muted\\\">Sessions: video or in-person in {{CITY}}, {{STATE}} • {{EMAIL}}</div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h2>How a typical collaboration unfolds</h2>\\n      <div class=\\\"process\\\" aria-hidden=\\\"false\\\">\\n        <div class=\\\"step\\\">\\n          <strong>1. Intake</strong>\\n          <div class=\\\"muted\\\">Comprehensive history, goals, lifestyle, medications, and priorities. 90–120 minutes.</div>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <strong>2. Baseline plan</strong>\\n          <div class=\\\"muted\\\">A focused, time-bound plan with 3–5 high-impact experiments and education resources.</div>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <strong>3. Follow-ups</strong>\\n          <div class=\\\"muted\\\">Regular check-ins to track progress, refine steps, and troubleshoot barriers.</div>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <strong>4. Iteration</strong>\\n          <div class=\\\"muted\\\">Data-driven adjustments — if something isn\\\\'t moving the needle, we change the approach.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>Optional educational labs</h3>\\n      <p class=\\\"muted\\\">Labs are tools for learning — they may include basic metabolic panels, targeted nutrient tests, or gut panels when clinically indicated. They are never required and are discussed as part of shared decision-making.</p>\\n\\n      <ul>\\n        <li><strong>When helpful:</strong> to clarify a question raised in the intake</li>\\n        <li><strong>When optional:</strong> to guide or personalize a plan, not to replace behavior change</li>\\n        <li><strong>Interpretation:</strong> you get an explanation and actionable steps tied to results</li>\\n      </ul>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>What to expect from an intake</h3>\\n      <ol class=\\\"muted\\\">\\n        <li>Pre-visit intake form to save time</li>\\n        <li>Deep history, current routines, and priorities</li>\\n        <li>Clinical reasoning and an initial plan you can start immediately</li>\\n        <li>Clear follow-up schedule and homework</li>\\n      </ol>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3>Approach FAQ</h3>\\n      <div style=\\\"display:grid;gap:12px;margin-top:8px\\\">\\n        <div style=\\\"padding:12px;background:#fff;border-radius:10px;border:1px solid rgba(16,24,40,0.04)\\\">\\n          <strong>How quickly will I see changes?</strong>\\n          <div class=\\\"muted\\\">Some experiments produce quick feedback (days to weeks); other areas require longer trends. We focus on measurable short-term targets and long-term habits.</div>\\n        </div>\\n        <div style=\\\"padding:12px;background:#fff;border-radius:10px;border:1px solid rgba(16,24,40,0.04)\\\">\\n          <strong>Do you prescribe medications?</strong>\\n          <div class=\\\"muted\\\">Medication management is coordinated with your prescribing clinicians. We discuss when medication changes might be appropriate but work collaboratively.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>Get the starter checklist</h3>\\n      <p class=\\\"muted\\\">A simple PDF checklist to prepare for your intake and start a one-week experiment.</p>\\n      <form class=\\\"leadmag\\\" onsubmit=\\\"event.preventDefault();alert('Checklist sent — check your inbox!');\\\">\\n        <input type=\\\"email\\\" placeholder=\\\"Email for the checklist\\\" required />\\n        <button type=\\\"submit\\\">Send checklist</button>\\n      </form>\\n\\n      <div style=\\\"margin-top:14px\\\">\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve an intake — {{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer style=\\\"padding:18px 26px;color:var(--muted)\\\">\\n    <div>{{BUSINESS_NAME}} — {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n    <div>Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
