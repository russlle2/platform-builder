          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Investment & Packages — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f1724;--card:#071028;--accent1:#7DE3B8;--accent2:#9BE1FF;--muted:#a8b3c6;--glass:rgba(255,255,255,0.04);--radius:14px;}\\n    *{box-sizing:border-box;font-family: Inter, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,#071028 0%, #071426 60%);color:#e6f0f6}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:22px 28px}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 10px;font-weight:600}\\n    .logo{font-weight:700;color:#fff;letter-spacing:0.4px}\\n    .wrap{max-width:1100px;margin:28px auto;padding:36px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    .panel{background:linear-gradient(180deg,rgba(255,255,255,0.03),transparent);border-radius:var(--radius);padding:28px;box-shadow:0 6px 30px rgba(2,6,23,0.6);}\\n    h1{margin:0 0 8px 0;font-size:22px;color:#fff}\\n    p.lead{margin:0 0 18px 0;color:var(--muted)}\\n    .price-tier{border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:18px;margin-bottom:14px}\\n    .price-tier h3{margin:0;color:var(--accent1)}\\n    .amount{font-size:28px;font-weight:800;color:#fff;margin:6px 0}\\n    .bullets{color:var(--muted);margin:10px 0 0 0}\\n    .cta{display:inline-block;padding:10px 14px;background:linear-gradient(90deg,var(--accent1),var(--accent2));color:#002;border-radius:10px;font-weight:700;text-decoration:none}\\n    .note{font-size:13px;color:#9fb0c3;margin-top:12px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .faq-item{margin-bottom:12px}\\n\\n    footer{padding:34px 28px;text-align:center;color:var(--muted)}\\n\\n    /* decorative SVG pattern */\\n    .svg-deco{position:fixed;right:-120px;top:-120px;opacity:0.18;transform:rotate(15deg);filter:blur(8px)}\\n\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr 1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"approach.html\\\">Method</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <div class=\\\"wrap\\\">\\n    <div class=\\\"hero\\\">\\n      <section class=\\\"panel\\\">\\n        <h1>Investment & Packages — thoughtful, intensive care</h1>\\n        <p class=\\\"lead\\\">Holistic plans designed to teach, support, and shift patterns. Sessions emphasize education and whole-person plans; lab work and supplements may be suggested as options, not guarantees.</p>\\n\\n        <div class=\\\"grid\\\">\\n          <div class=\\\"price-tier\\\">\\n            <h3>Starter Visit</h3>\\n            <div class=\\\"amount\\\">$145 — 60 min</div>\\n            <div class=\\\"bullets\\\">Ideal for a focused concern, personalized guidance, and initial recommendations.</div>\\n          </div>\\n\\n          <div class=\\\"price-tier\\\">\\n            <h3>Comprehensive Initial</h3>\\n            <div class=\\\"amount\\\">$350 — 120 min</div>\\n            <div class=\\\"bullets\\\">Deep intake, full history, integrative plan, educational resources, and optional lab menu.</div>\\n          </div>\\n\\n          <div class=\\\"price-tier\\\">\\n            <h3>Follow-up Session</h3>\\n            <div class=\\\"amount\\\">$95 — 45 min</div>\\n            <div class=\\\"bullets\\\">Track progress, adjust strategies, and coach next steps.</div>\\n          </div>\\n        </div>\\n\\n        <p class=\\\"note\\\">Sliding scale and package discounts available on a limited basis — email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent2)\\\">{{EMAIL}}</a> to inquire.</p>\\n\\n      </section>\\n\\n      <aside class=\\\"panel\\\" aria-label=\\\"Book and quick actions\\\">\\n        <h2 style=\\\"margin-top:0;color:var(--accent2)\\\">Ready to begin?</h2>\\n        <p style=\\\"color:var(--muted);margin-bottom:14px\\\">Book a discovery call to see if the intensive model is right for you.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n\\n        <div style=\\\"margin-top:16px\\\"><strong style=\\\"color:#cfeee6\\\">Phone</strong>: <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a></div>\\n        <div style=\\\"margin-top:10px;font-size:13px;color:var(--muted)\\\">Insurance: we provide superbills for out-of-network reimbursement. Coverage varies; check with your carrier.</div>\\n\\n        <hr style=\\\"border:none;border-top:1px solid rgba(255,255,255,0.03);margin:16px 0\\\">\\n\\n        <strong style=\\\"color:var(--accent1)\\\">Package: Intensive 6</strong>\\n        <p class=\\\"note\\\">Six-session package for concentrated work: intake + five follow-ups. Save 10% vs single sessions. Payment plans available.</p>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:22px\\\" class=\\\"panel\\\">\\n      <h2 style=\\\"margin:0 0 8px 0\\\">What you get</h2>\\n      <p class=\\\"lead\\\">Packages focus on education, self-care practices, and measurable goals. We emphasize symptom tracking, lifestyle shifts, and collaborative planning — not quick fixes.</p>\\n\\n      <div style=\\\"display:flex;gap:20px;margin-top:14px;flex-wrap:wrap\\\">\\n        <div style=\\\"flex:1;min-width:220px\\\">\\n          <h4 style=\\\"margin:6px 0;color:var(--accent1)\\\">Personalized roadmaps</h4>\\n          <p class=\\\"note\\\">A step-by-step plan you can use between visits.</p>\\n        </div>\\n        <div style=\\\"flex:1;min-width:220px\\\">\\n          <h4 style=\\\"margin:6px 0;color:var(--accent2)\\\">Skill-building & education</h4>\\n          <p class=\\\"note\\\">Tools to manage stress, sleep, gut health, and energy.</p>\\n        </div>\\n        <div style=\\\"flex:1;min-width:220px\\\">\\n          <h4 style=\\\"margin:6px 0;color:#ffd6a5\\\">Care continuity</h4>\\n          <p class=\\\"note\\\">Follow-ups prioritize momentum and accountability.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"panel\\\">\\n      <h2 style=\\\"margin:0 0 10px 0\\\">Frequently asked — quick answers</h2>\\n      <div class=\\\"faq-item\\\"><strong>Do you accept insurance?</strong>\\n        <div class=\\\"note\\\">We are out-of-network; superbills provided. Please verify benefits with your insurer.</div>\\n      </div>\\n      <div class=\\\"faq-item\\\"><strong>Are labs required?</strong>\\n        <div class=\\\"note\\\">Labs are optional and educational — used to inform a plan when useful.</div>\\n      </div>\\n      <div class=\\\"faq-item\\\"><strong>Refunds / cancellations?</strong>\\n        <div class=\\\"note\\\">48-hour cancellation policy. Prepaid packages follow custom terms; ask when booking.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"panel\\\">\\n      <h2 style=\\\"margin:0 0 10px 0\\\">Get the mini-guide</h2>\\n      <p class=\\\"lead\\\">Sign up for a short guide: \\\"Five Foundations for Better Sleep & Energy\\\" — free, practical, and gentle.</p>\\n      <form action=\\\"#\\\" onsubmit=\\\"event.preventDefault(); alert('Thanks — we\\\\'ll email the guide to you.');\\\" style=\\\"display:flex;gap:8px;flex-wrap:wrap\\\">\\n        <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Your email\\\" required style=\\\"flex:1;padding:10px;border-radius:8px;border:none;background:rgba(255,255,255,0.03);color:#fff\\\">\\n        <button class=\\\"cta\\\" type=\\\"submit\\\">Send the guide</button>\\n      </form>\\n      <p class=\\\"note\\\">We respect your privacy. This guide is educational and not a diagnosis.</p>\\n    </section>\\n\\n  </div>\\n\\n  <svg class=\\\"svg-deco\\\" width=\\\"420\\\" height=\\\"420\\\" viewBox=\\\"0 0 420 420\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#7DE3B8\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#9BE1FF\\\"/></linearGradient>\\n      <pattern id=\\\"p1\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"40\\\" height=\\\"40\\\" fill=\\\"rgba(255,255,255,0)\\\" />\\n        <path d=\\\"M0 20h40\\\" stroke=\\\"rgba(255,255,255,0.03)\\\" stroke-width=\\\"1\\\"/>\\n        <path d=\\\"M20 0v40\\\" stroke=\\\"rgba(255,255,255,0.03)\\\" stroke-width=\\\"1\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"420\\\" height=\\\"420\\\" fill=\\\"url(#p1)\\\" rx=\\\"40\\\"/>\\n    <circle cx=\\\"60\\\" cy=\\\"60\\\" r=\\\"90\\\" fill=\\\"url(#g1)\\\" opacity=\\\"0.12\\\"/>\\n    <circle cx=\\\"300\\\" cy=\\\"320\\\" r=\\\"110\\\" fill=\\\"#7DE3B8\\\" opacity=\\\"0.08\\\"/>\\n  </svg>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} &middot; {{CITY}}, {{STATE}} &middot; <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{PRACTITIONER_NAME}}, {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f7fbfc;--ink:#072033;--accent:#ffb86b;--muted:#4b6b78;--card:#ffffff}\\n    *{box-sizing:border-box;font-family: Georgia, 'Times New Roman', serif;}\\n    body{margin:0;background:linear-gradient(180deg,#f7fbfc 0%,#eaf3f6 100%);color:var(--ink)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 28px}\\n    .nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .wrap{max-width:980px;margin:18px auto;padding:20px}\\n    .intro{display:flex;gap:20px;align-items:center}\\n    .portrait{width:150px;height:150px;border-radius:16px;background:linear-gradient(135deg,#ffd8b5,#ffe7d6);display:flex;align-items:center;justify-content:center;color:#6b3b00;font-weight:700}\\n    h1{margin:0;font-family:inherit;font-size:24px}\\n    .tag{color:var(--muted);margin-top:6px}\\n    .card{background:var(--card);padding:18px;border-radius:14px;box-shadow:0 8px 30px rgba(2,6,23,0.05);margin-top:18px}\\n    .values{display:flex;gap:14px;margin-top:12px}\\n    .val{flex:1;padding:12px;background:linear-gradient(180deg,rgba(255,255,255,0.8),#fff);border-radius:10px}\\n    .cta{display:inline-block;margin-top:12px;background:var(--accent);color:#072033;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .svg-deco{position:fixed;left:-140px;bottom:-140px;opacity:0.14;transform:rotate(-18deg)}\\n\\n    @media(max-width:700px){.intro{flex-direction:column;align-items:flex-start}.portrait{width:120px;height:120px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Main</a>\\n      <a href=\\\"services.html\\\">What I offer</a>\\n      <a href=\\\"approach.html\\\">How I work</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"intro\\\">\\n      <div class=\\\"portrait\\\">{{PRACTITIONER_NAME}}</div>\\n      <div>\\n        <h1>{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</h1>\\n        <div class=\\\"tag\\\">Practitioner, teacher, & curious listener — offering integrative, whole-person care.</div>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Request a visit</a>\\n      </div>\\n    </section>\\n\\n    <article class=\\\"card\\\">\\n      <h2 style=\\\"margin-top:0\\\">Philosophy in a few lines</h2>\\n      <p style=\\\"color:var(--muted)\\\">I combine evidence-informed nutrition, lifestyle coaching, and gentle complementary therapies to help you learn what your body is telling you. The work is collaborative: we set measurable goals, track progress, and adjust. You will leave each visit with practical steps — not vague promises.</p>\\n\\n      <div class=\\\"values\\\">\\n        <div class=\\\"val\\\"><strong>Education-first</strong>\\n          <div style=\\\"color:var(--muted);font-size:14px;margin-top:6px\\\">I teach tools you can use right away — breathwork, sleep hygiene, gut-supporting habits, and stress mapping.</div>\\n        </div>\\n        <div class=\\\"val\\\"><strong>Whole-person</strong>\\n          <div style=\\\"color:var(--muted);font-size:14px;margin-top:6px\\\">We look at sleep, digestion, movement, work, and relationships as parts of the same picture.</div>\\n        </div>\\n        <div class=\\\"val\\\"><strong>Practical</strong>\\n          <div style=\\\"color:var(--muted);font-size:14px;margin-top:6px\\\">Plans are realistic, paced, and tailored to your life — not a one-size regimen.</div>\\n        </div>\\n      </div>\\n    </article>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin:0 0 8px 0\\\">Training & background</h2>\\n      <p class=\\\"tag\\\">Licensed and trained in integrative modalities, with additional certifications in lifestyle medicine and functional nutrition.</p>\\n      <ul style=\\\"color:var(--muted)\\\">\\n        <li>Clinical training in patient-centered assessment and motivational coaching</li>\\n        <li>Ongoing study in sleep health, neuroplasticity, and gut-brain support</li>\\n        <li>Memberships: local integrative medicine consortium and community health coalitions</li>\\n      </ul>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin:0 0 8px 0\\\">What to expect in a first meeting</h2>\\n      <ol style=\\\"color:var(--muted)\\\">\\n        <li>A thorough intake about history, routines, and priorities</li>\\n        <li>Collaborative goal-setting and an initial set of small, evidence-informed steps</li>\\n        <li>A clear follow-up plan with measurable markers</li>\\n      </ol>\\n      <p style=\\\"color:var(--muted);font-size:13px;margin-top:8px\\\">Optional lab testing may be offered as part of education and assessment. Labs inform decisions — they are not always necessary.</p>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin:0 0 8px 0\\\">Stories from people I\\u2019ve worked with</h2>\\n      <blockquote style=\\\"margin:0;color:var(--muted);font-style:italic\\\">\\\"I finally understood what my sleep patterns were telling me. The plan felt doable and transformative.\\\"</blockquote>\\n      <div style=\\\"margin-top:10px;color:var(--muted);font-size:13px\\\">(Names changed to protect privacy.)</div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin:0 0 8px 0\\\">Stay in touch</h2>\\n      <p style=\\\"color:var(--muted)\\\">Sign up for short monthly notes with tips and mini-lessons on sleep, stress, digestion, and sustainable energy.</p>\\n      <form onsubmit=\\\"event.preventDefault(); alert('Thanks! You\\\\'re signed up.');\\\" style=\\\"display:flex;gap:8px;flex-wrap:wrap\\\">\\n        <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Your email\\\" required style=\\\"padding:10px;border-radius:8px;border:1px solid #e6eef3;flex:1\\\">\\n        <button class=\\\"cta\\\" type=\\\"submit\\\">Subscribe</button>\\n      </form>\\n    </section>\\n\\n  </main>\\n\\n  <svg class=\\\"svg-deco\\\" width=\\\"420\\\" height=\\\"420\\\" viewBox=\\\"0 0 420 420\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"ag\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#ffd8b5\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#ffe7d6\\\"/></linearGradient>\\n    </defs>\\n    <rect width=\\\"420\\\" height=\\\"420\\\" fill=\\\"url(#ag)\\\" rx=\\\"60\\\" opacity=\\\"0.12\\\"/>\\n    <g opacity=\\\"0.06\\\">\\n      <circle cx=\\\"80\\\" cy=\\\"320\\\" r=\\\"96\\\" fill=\\\"#ffd8b5\\\"/>\\n      <rect x=\\\"220\\\" y=\\\"40\\\" width=\\\"140\\\" height=\\\"140\\\" rx=\\\"20\\\" fill=\\\"#ffd8b5\\\"/>\\n    </g>\\n  </svg>\\n\\n  <footer style=\\\"text-align:center;padding:24px;color:var(--muted)\\\">\\n    <div>{{PRACTITIONER_NAME}} &middot; {{CREDENTIALS}} &middot; {{BUSINESS_NAME}} &middot; <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Book a Visit — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#091421;--card:#071826;--accent:#7DE3B8;--muted:#9fb0c3}\\n    *{box-sizing:border-box;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto;}\\n    body{margin:0;background:linear-gradient(180deg,#051021 0%,#072036 100%);color:#e8f6f2}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:22px}\\n    .logo{font-weight:800}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 8px}\\n    .wrap{max-width:960px;margin:28px auto;padding:18px}\\n    .grid{display:grid;grid-template-columns:1fr 380px;gap:22px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px}\\n    label{display:block;margin-top:10px;font-size:13px;color:var(--muted)}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:rgba(255,255,255,0.02);color:#e8f6f2}\\n    .btn{display:inline-block;margin-top:12px;padding:10px 14px;background:linear-gradient(90deg,var(--accent),#9be1ff);color:#022;border-radius:10px;border:none;font-weight:800;text-decoration:none}\\n    .mini{font-size:13px;color:var(--muted)}\\n    .svg-deco{position:fixed;right:-120px;bottom:-140px;opacity:0.12}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <h1 style=\\\"margin:0 0 8px 0\\\">Reserve your first visit</h1>\\n    <p class=\\\"mini\\\" style=\\\"margin:0 0 18px 0\\\">Choose a session type and tell us a little about what brought you here. We focus on teaching skills and building a plan together.</p>\\n\\n    <div class=\\\"grid\\\">\\n      <section class=\\\"card\\\">\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" onsubmit=\\\"return handleSubmit(event)\\\">\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" required>\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required>\\n\\n          <label for=\\\"phone\\\">Phone</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" type=\\\"tel\\\">\\n\\n          <label for=\\\"session\\\">Session type</label>\\n          <select id=\\\"session\\\" name=\\\"session\\\">\\n            <option>Comprehensive Initial — 120 min</option>\\n            <option>Starter Visit — 60 min</option>\\n            <option>Follow-up — 45 min</option>\\n            <option>Package (inquire)</option>\\n          </select>\\n\\n          <label for=\\\"concern\\\">Primary concerns (check all that apply)</label>\\n          <div style=\\\"display:flex;gap:10px;flex-wrap:wrap\\\">\\n            <label class=\\\"mini\\\"><input type=\\\"checkbox\\\" name=\\\"concern\\\" value=\\\"stress\\\"> Stress</label>\\n            <label class=\\\"mini\\\"><input type=\\\"checkbox\\\" name=\\\"concern\\\" value=\\\"sleep\\\"> Sleep</label>\\n            <label class=\\\"mini\\\"><input type=\\\"checkbox\\\" name=\\\"concern\\\" value=\\\"digestion\\\"> Digestion</label>\\n            <label class=\\\"mini\\\"><input type=\\\"checkbox\\\" name=\\\"concern\\\" value=\\\"inflammation\\\"> Inflammation</label>\\n            <label class=\\\"mini\\\"><input type=\\\"checkbox\\\" name=\\\"concern\\\" value=\\\"energy\\\"> Energy</label>\\n          </div>\\n\\n          <label for=\\\"notes\\\">Brief notes (what would you like to address?)</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\"></textarea>\\n\\n          <label style=\\\"margin-top:12px;display:flex;gap:10px;align-items:center\\\"><input type=\\\"checkbox\\\" id=\\\"consent\\\" required>\\n            <span class=\\\"mini\\\">I understand the care is educational and collaborative. I acknowledge there are no guaranteed cures and I consent to an integrative approach.</span>\\n          </label>\\n\\n          <button class=\\\"btn\\\" type=\\\"submit\\\">Request booking</button>\\n        </form>\\n\\n        <script>\\n          function handleSubmit(e){\\n            e.preventDefault();\\n            // lightweight simulated submit\\n            alert('Thanks — we received your request. {{PRACTITIONER_NAME}}\\\\'s team will reply to ' + document.getElementById('email').value + '.');\\n            return false;\\n          }\\n        </script>\\n      </section>\\n\\n      <aside class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Before you book</h3>\\n        <p class=\\\"mini\\\">Please note: our approach centers on teaching and whole-person plans. While we may suggest labs or supplements as educational tools, they are optional and not guarantees of outcomes.</p>\\n\\n        <h4 style=\\\"margin-top:12px\\\">Quick policy notes</h4>\\n        <ul class=\\\"mini\\\" style=\\\"margin:6px 0 0 18px\\\">\\n          <li>48-hour cancellation required for refunds.</li>\\n          <li>Payments via card; packages available.</li>\\n          <li>Superbills provided for out-of-network claims.</li>\\n        </ul>\\n\\n        <div style=\\\"margin-top:14px\\\">\\n          <strong>Need help now?</strong>\\n          <div class=\\\"mini\\\">Call: <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted)\\\">{{PHONE}}</a></div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px;border-top:1px dashed rgba(255,255,255,0.03);padding-top:12px\\\">\\n          <strong style=\\\"color:var(--accent)\\\">Package highlight</strong>\\n          <div class=\\\"mini\\\">Accelerated Intensive: intake + five check-ins. Ask about payment plans.</div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 6px 0\\\">Where we work</h3>\\n      <p class=\\\"mini\\\">In-person in {{CITY}}, {{STATE}} and virtual visits. We adapt the format to meet your needs.</p>\\n      <p class=\\\"mini\\\">Email: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a></p>\\n    </section>\\n  </main>\\n\\n  <svg class=\\\"svg-deco\\\" width=\\\"340\\\" height=\\\"340\\\" viewBox=\\\"0 0 340 340\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"bgG\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#7DE3B8\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#9BE1FF\\\"/></linearGradient>\\n      <pattern id=\\\"dots\\\" width=\\\"20\\\" height=\\\"20\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <circle cx=\\\"2\\\" cy=\\\"2\\\" r=\\\"1.2\\\" fill=\\\"rgba(255,255,255,0.06)\\\" />\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"340\\\" height=\\\"340\\\" rx=\\\"28\\\" fill=\\\"url(#dots)\\\" opacity=\\\"0.12\\\"/>\\n    <ellipse cx=\\\"60\\\" cy=\\\"280\\\" rx=\\\"120\\\" ry=\\\"40\\\" fill=\\\"url(#bgG)\\\" opacity=\\\"0.08\\\"/>\\n  </svg>\\n\\n  <footer style=\\\"text-align:center;padding:22px;color:var(--muted)\\\">\\n    <div>{{BUSINESS_NAME}} &middot; <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
