          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Investment & Fees — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Transparent fee guide for integrative care, personalized plans, optional labs and coaching. Educational focus; no guaranteed cures.\\\" />\\n  <style>\\n    :root{--bg:#fbfdfc;--card:#ffffff;--muted:#6b7280;--accent:#2563eb;--accent-2:#06b6d4;--glass:rgba(255,255,255,0.6)}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#0f172a;background:linear-gradient(180deg,var(--bg),#eef7f9);}\\n    .app{min-height:100%;display:flex;flex-direction:column;}\\n    header{position:sticky;top:0;backdrop-filter:blur(6px);background:linear-gradient(90deg,rgba(255,255,255,0.6),rgba(255,255,255,0.4));border-bottom:1px solid rgba(15,23,42,0.04);}\\n    .nav{max-width:1100px;margin:0 auto;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px}\\n    .brand{font-weight:700;color:#07203b}\\n    nav a{color:#0f172a;text-decoration:none;margin-left:18px;font-size:0.95rem}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;max-width:1100px;margin:28px auto;padding:28px}\\n    .panel{background:var(--card);border-radius:12px;padding:22px;box-shadow:0 6px 20px rgba(12,18,28,0.06)}\\n    h1{margin:0 0 8px;font-size:1.6rem;color:#052035}\\n    p.lead{margin:0 0 16px;color:var(--muted)}\\n    .price-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:16px}\\n    .tier{padding:16px;border-radius:10px;background:linear-gradient(180deg,#fff, #fbffff);border:1px solid rgba(3,7,18,0.04)}\\n    .tier h3{margin:0;color:#073049}\\n    .tier .price{font-size:1.4rem;color:var(--accent);margin:8px 0}\\n    .muted{color:var(--muted);font-size:0.95rem}\\n    .note{font-size:0.9rem;color:var(--muted);margin-top:12px}\\n    footer{max-width:1100px;margin:20px auto;padding:20px;text-align:center;color:var(--muted);font-size:0.9rem}\\n    /* SVG background */\\n    .bg-svg{position:fixed;inset:0;z-index:-1;opacity:0.7;pointer-events:none}\\n    /* lead magnet */\\n    .lead-magnet{display:flex;flex-direction:column;padding:14px;border-radius:10px;background:linear-gradient(135deg,rgba(6,182,212,0.06),rgba(37,99,235,0.04));border:1px solid rgba(6,182,212,0.06)}\\n    .cta{display:inline-block;padding:10px 14px;border-radius:8px;background:linear-gradient(90deg,var(--accent),var(--accent-2));color:white;text-decoration:none}\\n    .faq{margin-top:18px}\\n    details{background:linear-gradient(180deg,#fbfdff,#ffffff);padding:12px;border-radius:8px;margin-bottom:8px}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.price-grid{grid-template-columns:1fr}.nav a{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"app\\\">\\n    <!-- pattern source reference: assets/img/pattern.svg -->\\n    <svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 1200 800\\\" preserveAspectRatio=\\\"xMidYMid slice\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#e6f7fb\\\" />\\n          <stop offset=\\\"1\\\" stop-color=\\\"#f0f9ff\\\" />\\n        </linearGradient>\\n        <pattern id=\\\"p1\\\" width=\\\"120\\\" height=\\\"120\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(12)\\\">\\n          <rect width=\\\"60\\\" height=\\\"60\\\" fill=\\\"#f8feff\\\" />\\n          <rect x=\\\"60\\\" y=\\\"60\\\" width=\\\"60\\\" height=\\\"60\\\" fill=\\\"#eef9fb\\\" />\\n        </pattern>\\n        <filter id=\\\"soft\\\"><feGaussianBlur stdDeviation=\\\"30\\\"/></filter>\\n      </defs>\\n      <rect width=\\\"1200\\\" height=\\\"800\\\" fill=\\\"url(#g1)\\\" />\\n      <g filter=\\\"url(#soft)\\\" opacity=\\\"0.8\\\">\\n        <circle cx=\\\"200\\\" cy=\\\"120\\\" r=\\\"220\\\" fill=\\\"#dff7ff\\\" />\\n        <circle cx=\\\"1050\\\" cy=\\\"680\\\" r=\\\"260\\\" fill=\\\"#e9fbff\\\" />\\n      </g>\\n      <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"1200\\\" height=\\\"800\\\" fill=\\\"url(#p1)\\\" opacity=\\\"0.6\\\" />\\n    </svg>\\n\\n    <header>\\n      <div class=\\\"nav\\\">\\n        <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n        <nav>\\n          <a href=\\\"index.html\\\">Home</a>\\n          <a href=\\\"services.html\\\">Offerings</a>\\n          <a href=\\\"conditions.html\\\">Concerns</a>\\n          <a href=\\\"approach.html\\\">Method</a>\\n          <a href=\\\"pricing.html\\\" style=\\\"font-weight:700\\\">Fees</a>\\n          <a href=\\\"about.html\\\">Team</a>\\n          <a href=\\\"book.html\\\">Schedule</a>\\n        </nav>\\n      </div>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"hero\\\" aria-labelledby=\\\"pricing-hero\\\">\\n        <div>\\n          <div class=\\\"panel\\\">\\n            <h1 id=\\\"pricing-hero\\\">Care that matches your life stage — clear fee options</h1>\\n            <p class=\\\"lead\\\">We design personalized integrative plans that blend clinical assessment, nutrition, lifestyle coaching, and optional testing. Fees are transparent so you can choose what fits your needs. Educational focus — outcomes vary by person.</p>\\n            <div class=\\\"price-grid\\\" role=\\\"list\\\">\\n              <div class=\\\"tier\\\" role=\\\"listitem\\\">\\n                <h3>Intro Visit</h3>\\n                <div class=\\\"price\\\">$160</div>\\n                <div class=\\\"muted\\\">60 minutes: intake, whole-person review, initial recommendations</div>\\n              </div>\\n              <div class=\\\"tier\\\" role=\\\"listitem\\\">\\n                <h3>Follow-up</h3>\\n                <div class=\\\"price\\\">$95</div>\\n                <div class=\\\"muted\\\">30 minutes: review progress, iterate plan, brief coaching</div>\\n              </div>\\n              <div class=\\\"tier\\\" role=\\\"listitem\\\">\\n                <h3>Comprehensive Plan</h3>\\n                <div class=\\\"price\\\">$480</div>\\n                <div class=\\\"muted\\\">Includes intake, 90-day written plan, two follow-ups and resource guide</div>\\n              </div>\\n            </div>\\n            <p class=\\\"note\\\">Optional laboratory testing or specialty modalities are quoted separately; some labs are sent to external labs and billed independently. We focus on education and shared decision-making, not guaranteed cures.</p>\\n          </div>\\n        </div>\\n\\n        <aside style=\\\"align-self:start\\\">\\n          <div class=\\\"panel lead-magnet\\\">\\n            <h3 style=\\\"margin:0 0 6px;color:#053049\\\">Free guide: 5 steps to stabilize energy</h3>\\n            <p class=\\\"muted\\\" style=\\\"margin:0\\\">Evidence-informed practices you can try before your first appointment.</p>\\n            <div style=\\\"margin-top:12px;display:flex;gap:8px;align-items:center\\\">\\n              <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n              <a style=\\\"font-size:0.9rem;color:var(--muted);text-decoration:none\\\" href=\\\"book.html\\\">Book a consult</a>\\n            </div>\\n            <div class=\\\"social\\\" style=\\\"margin-top:12px\\\">\\n              <div class=\\\"muted\\\">Accepted: major credit cards. Insurance: out-of-network receipts available.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n            <h4 style=\\\"margin:0 0 8px\\\">Quick FAQ</h4>\\n            <div class=\\\"faq\\\">\\n              <details><summary>Do you accept insurance?</summary><p class=\\\"muted\\\">We provide superbills for many plans; check with your carrier. Labs and procedures may bill separately.</p></details>\\n              <details><summary>Are supplements required?</summary><p class=\\\"muted\\\">Supplements may be suggested when appropriate. Recommendations are individualized and optional.</p></details>\\n            </div>\\n          </div>\\n        </aside>\\n      </section>\\n\\n      <section style=\\\"max-width:1100px;margin:20px auto;padding:0 20px;display:grid;grid-template-columns:1fr 320px;gap:20px\\\">\\n        <div class=\\\"panel\\\">\\n          <h3 style=\\\"margin-top:0\\\">Payment plans & Packages</h3>\\n          <p class=\\\"muted\\\">We offer sliding scales for limited slots and 3-month plans for ongoing coaching. Ask about a tailored package during your intake—our goal is to make sustainable care accessible.</p>\\n          <h4 style=\\\"margin-top:16px\\\">What's included in Comprehensive Plan</h4>\\n          <ul class=\\\"muted\\\">\\n            <li>Full intake and health history review</li>\\n            <li>Personalized 90-day plan with nutrition and lifestyle priorities</li>\\n            <li>Two follow-ups and email check-ins</li>\\n            <li>Resource list and optional referrals</li>\\n          </ul>\\n        </div>\\n\\n        <div>\\n          <div class=\\\"panel\\\">\\n            <h4 style=\\\"margin:0\\\">Testimonials & Social Proof</h4>\\n            <p class=\\\"muted\\\" style=\\\"margin-top:10px\\\">\\\"Provided clarity and practical steps that I could actually use\\\" — A client from {{CITY}}, {{STATE}}</p>\\n            <p class=\\\"muted\\\">\\\"A collaborative approach that respected my priorities\\\" — another client</p>\\n          </div>\\n\\n          <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n            <h4 style=\\\"margin:0\\\">Disclaimer</h4>\\n            <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Our services focus on education and whole-person support. We do not promise cures. Individual results vary.</p>\\n          </div>\\n        </div>\\n      </section>\\n    </main>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • {{PHONE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Meet the practitioner, philosophy and clinical background. Integrative, evidence-informed care emphasizing whole-person health.\\\" />\\n  <style>\\n    :root{--bg:#ffffff;--ink:#042033;--soft:#7b8794;--accent:#0ea5a9}\\n    body{margin:0;font-family:Inter,ui-sans-serif,system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;background:linear-gradient(180deg,#fbffff,#f3f8fa);color:var(--ink)}\\n    header{padding:18px 20px;display:flex;justify-content:space-between;align-items:center;max-width:1100px;margin:0 auto}\\n    header nav a{margin-left:16px;text-decoration:none;color:var(--ink)}\\n    .container{max-width:1100px;margin:18px auto;padding:20px}\\n    .hero{display:flex;gap:22px;align-items:center}\\n    .card{background:white;border-radius:12px;padding:18px;box-shadow:0 8px 30px rgba(9,30,45,0.06)}\\n    h1{margin:0;font-size:1.5rem}\\n    .byline{color:var(--soft);margin-top:6px}\\n    .bio{margin-top:12px;color:#233444;line-height:1.5}\\n    .credentials{font-weight:600;color:#0b3b3c;margin-top:10px}\\n    .process{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px}\\n    .process .step{background:linear-gradient(180deg,#ffffff,#fbfeff);padding:12px;border-radius:8px;border:1px solid rgba(2,6,23,0.03)}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:8px;background:linear-gradient(90deg,#0ea5a9,#0284c7);color:white;text-decoration:none}\\n    .social{margin-top:14px;color:var(--soft)}\\n    svg.bg{position:fixed;inset:0;z-index:-1;opacity:0.6;pointer-events:none}\\n    @media(max-width:880px){.hero{flex-direction:column}.process{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- pattern stored as assets/img/pattern.svg (referenced for design) -->\\n  <svg class=\\\"bg\\\" viewBox=\\\"0 0 1200 700\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <radialGradient id=\\\"rg\\\" cx=\\\"20%\\\" cy=\\\"30%\\\">\\n        <stop offset=\\\"0%\\\" stop-color=\\\"#fffefb\\\"/>\\n        <stop offset=\\\"100%\\\" stop-color=\\\"#eafafc\\\"/>\\n      </radialGradient>\\n      <pattern id=\\\"dots\\\" width=\\\"24\\\" height=\\\"24\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <circle cx=\\\"2\\\" cy=\\\"2\\\" r=\\\"1.2\\\" fill=\\\"#dff6f7\\\"></circle>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"1200\\\" height=\\\"700\\\" fill=\\\"url(#rg)\\\"/>\\n    <rect width=\\\"1200\\\" height=\\\"700\\\" fill=\\\"url(#dots)\\\" opacity=\\\"0.7\\\"/>\\n    <g opacity=\\\"0.8\\\">\\n      <ellipse cx=\\\"1000\\\" cy=\\\"150\\\" rx=\\\"220\\\" ry=\\\"120\\\" fill=\\\"#e6fbff\\\"/>\\n      <ellipse cx=\\\"120\\\" cy=\\\"540\\\" rx=\\\"330\\\" ry=\\\"160\\\" fill=\\\"#f0fbf8\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"conditions.html\\\">Help</a>\\n      <a href=\\\"approach.html\\\">Approach</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"card\\\" style=\\\"flex:1\\\">\\n        <h1>Meet {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</h1>\\n        <div class=\\\"byline\\\">A pragmatic, whole-person clinician blending conventional and integrative tools.</div>\\n        <p class=\\\"bio\\\">{{PRACTITIONER_NAME}} brings clinical training and years of practice working with people seeking clearer direction on stress, sleep, digestion, inflammation, and sustained energy. The practice emphasizes education, measurable goals and collaborative planning. We do not promise cures; rather we provide tools and supports to help you make informed choices about your health.</p>\\n        <div class=\\\"credentials\\\">Clinical interests: gut health, sleep regulation, stress resilience, metabolic wellness</div>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Start an intake</a>\\n      </div>\\n\\n      <aside style=\\\"width:320px\\\">\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0\\\">Background</h4>\\n          <p class=\\\"social\\\">Clinical training in integrative modalities, board experience in patient-centered care, and ongoing education in functional nutrition and behavioral coaching.</p>\\n          <div style=\\\"margin-top:12px\\\"><strong>Location:</strong> {{CITY}}, {{STATE}}</div>\\n          <div style=\\\"margin-top:8px;color:var(--soft)\\\">Contact: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0\\\">Social proof</h4>\\n          <p class=\\\"social\\\">\\\"Clear, compassionate and practical.\\\" — Client</p>\\n          <p class=\\\"social\\\">\\\"Helped me build a sustainable routine\\\" — Another client</p>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Our collaborative process</h3>\\n        <div class=\\\"process\\\">\\n          <div class=\\\"step\\\"><strong>1 — Intake</strong><div class=\\\"muted\\\" style=\\\"color:var(--soft);margin-top:6px\\\">Comprehensive history and priorities.</div></div>\\n          <div class=\\\"step\\\"><strong>2 — Plan</strong><div class=\\\"muted\\\" style=\\\"color:var(--soft);margin-top:6px\\\">Evidence-informed and personalized; may include lifestyle, nutrition, or labs.</div></div>\\n          <div class=\\\"step\\\"><strong>3 — Follow-ups</strong><div class=\\\"muted\\\" style=\\\"color:var(--soft);margin-top:6px\\\">Short check-ins to refine what works in real life.</div></div>\\n        </div>\\n        <p style=\\\"margin-top:12px;color:var(--soft)\\\">Optional advanced testing is offered as an educational tool to guide decisions; it is not always necessary. Recommendations are made with attention to cost, benefit and your values.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;display:grid;grid-template-columns:1fr 300px;gap:16px\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">FAQ</h3>\\n        <details><summary>How long is a typical program?</summary><p style=\\\"color:var(--soft)\\\">Many plans are structured in 8–12 week phases for measurable changes, though timelines are individualized.</p></details>\\n        <details><summary>Will I need lab tests?</summary><p style=\\\"color:var(--soft)\\\">Labs are optional and used when results would meaningfully change your plan.</p></details>\\n        <details><summary>Is coaching included?</summary><p style=\\\"color:var(--soft)\\\">Coaching is integrated into many plans; separate coaching packages are available.</p></details>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0\\\">Lead Magnet</h4>\\n          <p style=\\\"color:var(--soft)\\\">Download a short checklist: \\\"Preparing for your first integrative visit\\\" — practical questions to bring to your appointment.</p>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Get the checklist</a>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0\\\">Call to action</h4>\\n          <p style=\\\"color:var(--soft)\\\">Ready to explore? Book a discovery session to discuss the most appropriate next steps for you.</p>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Book now</a>\\n        </div>\\n      </aside>\\n    </section>\\n  </main>\\n\\n  <footer style=\\\"max-width:1100px;margin:18px auto;padding:12px;color:#6b7280;text-align:center\\\">© {{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Schedule a Visit — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Secure an intake or follow-up. Practical scheduling page with options for telehealth and in-person visits. Educational and collaborative care.\\\" />\\n  <style>\\n    :root{--bg:#f7fcfb;--ink:#033049;--muted:#5f6b74;--accent:#0b7285}\\n    body{margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial;background:var(--bg);color:var(--ink)}\\n    header{background:linear-gradient(90deg,#e9fbfb,#ffffff);padding:14px 20px;box-shadow:0 6px 20px rgba(10,20,30,0.04)}\\n    .nav{max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:16px;text-decoration:none;color:var(--ink)}\\n    main{max-width:1100px;margin:22px auto;padding:20px}\\n    .grid{display:grid;grid-template-columns:1fr 380px;gap:20px}\\n    .card{background:white;border-radius:12px;padding:18px;box-shadow:0 12px 30px rgba(9,22,30,0.06)}\\n    h1{margin:0;font-size:1.5rem}\\n    .muted{color:var(--muted)}\\n    form{display:flex;flex-direction:column;gap:10px;margin-top:12px}\\n    input,textarea,select{padding:10px;border:1px solid #e6eef0;border-radius:8px;font-size:0.95rem}\\n    label{font-size:0.9rem}\\n    .primary{background:linear-gradient(90deg,var(--accent),#065f66);color:white;padding:10px 14px;border-radius:8px;border:none}\\n    .info{font-size:0.9rem;color:var(--muted)}\\n    .faq{margin-top:12px}\\n    details{padding:10px;border-radius:8px;background:linear-gradient(180deg,#fff,#fbfeff)}\\n    svg.bg{position:fixed;right:0;bottom:0;width:420px;height:420px;opacity:0.7;pointer-events:none}\\n    @media(max-width:920px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"bg\\\" viewBox=\\\"0 0 420 420\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"lg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#e6fbf8\\\" /><stop offset=\\\"1\\\" stop-color=\\\"#f0fbff\\\" /></linearGradient>\\n      <pattern id=\\\"p2\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\"><rect width=\\\"20\\\" height=\\\"20\\\" fill=\\\"#fff\\\"/><rect x=\\\"20\\\" y=\\\"20\\\" width=\\\"20\\\" height=\\\"20\\\" fill=\\\"#f7fffe\\\"/></pattern>\\n    </defs>\\n    <rect width=\\\"420\\\" height=\\\"420\\\" rx=\\\"40\\\" fill=\\\"url(#lg)\\\" />\\n    <rect width=\\\"420\\\" height=\\\"420\\\" rx=\\\"40\\\" fill=\\\"url(#p2)\\\" opacity=\\\"0.6\\\"/>\\n    <g opacity=\\\"0.85\\\"><circle cx=\\\"60\\\" cy=\\\"360\\\" r=\\\"90\\\" fill=\\\"#ddfbf7\\\"/><circle cx=\\\"360\\\" cy=\\\"60\\\" r=\\\"70\\\" fill=\\\"#e8fbff\\\"/></g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"services.html\\\">What we offer</a>\\n        <a href=\\\"conditions.html\\\">Concerns</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"pricing.html\\\">Fees</a>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"grid\\\">\\n      <section class=\\\"card\\\">\\n        <h1>Book your visit</h1>\\n        <p class=\\\"muted\\\">Select an appointment type, preferred format and share a brief summary. We'll follow up with availability and preparatory materials.</p>\\n        <form action=\\\"/submit\\\" method=\\\"post\\\" aria-label=\\\"Booking form\\\">\\n          <label for=\\\"type\\\">Appointment type</label>\\n          <select id=\\\"type\\\" name=\\\"type\\\">\\n            <option>Intro Visit — 60 min</option>\\n            <option>Follow-up — 30 min</option>\\n            <option>Comprehensive Plan — 90 min</option>\\n          </select>\\n\\n          <label for=\\\"format\\\">Format</label>\\n          <select id=\\\"format\\\" name=\\\"format\\\">\\n            <option>Telehealth</option>\\n            <option>In-person ({{CITY}}, {{STATE}})</option>\\n          </select>\\n\\n          <label for=\\\"name\\\">Your name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" required placeholder=\\\"Full name\\\" />\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required placeholder=\\\"you@example.com\\\" />\\n\\n          <label for=\\\"phone\\\">Phone</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"(optional)\\\" />\\n\\n          <label for=\\\"notes\\\">Brief summary of main concerns</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"e.g., sleep difficulties, low energy, digestive symptoms\\\"></textarea>\\n\\n          <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n            <button class=\\\"primary\\\" type=\\\"submit\\\">Request appointment</button>\\n            <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"text-decoration:none;color:var(--muted)\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          </div>\\n\\n          <p class=\\\"info\\\">By submitting you agree to receive scheduling messages. Your data will be handled in accordance with privacy practices. We do not promise specific outcomes.</p>\\n        </form>\\n\\n        <div style=\\\"margin-top:16px\\\">\\n          <h3 style=\\\"margin:0\\\">What to expect</h3>\\n          <p class=\\\"muted\\\">A confirmation will include a short intake form to complete before the visit and guides on how to prepare for optional labs or measurements if relevant.</p>\\n        </div>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Quick info</h3>\\n          <p class=\\\"muted\\\"><strong>Duration:</strong> Select above. <strong>Billing:</strong> Card on file or pay at visit; superbills available.</p>\\n          <p class=\\\"muted\\\"><strong>Cancellation:</strong> Please notify 48 hours in advance when possible.</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin-top:0\\\">FAQ</h3>\\n          <details><summary>Can I reschedule?</summary><p class=\\\"muted\\\">Yes—contact us and we will offer next openings. Late cancellations may incur fees.</p></details>\\n          <details><summary>Are services evidence-informed?</summary><p class=\\\"muted\\\">Yes. Recommendations combine clinical evidence, lab data when used, and your personal goals.</p></details>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0\\\">Contact</h4>\\n          <p class=\\\"muted\\\">Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a><br/>Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></p>\\n          <a class=\\\"primary\\\" href=\\\"tel:{{PHONE}}\\\" style=\\\"display:inline-block;margin-top:8px;text-decoration:none\\\">Call to book</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"max-width:1100px;margin:18px auto;padding:0 20px\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">A short note on scope & safety</h3>\\n        <p class=\\\"muted\\\">Our practice takes a conservative, educational approach. We coordinate with your other providers when helpful. If you have an urgent medical concern, please call emergency services.</p>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer style=\\\"max-width:1100px;margin:12px auto;padding:12px;text-align:center;color:var(--muted)\\\">© {{BUSINESS_NAME}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{CITY}}, {{STATE}}</footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
