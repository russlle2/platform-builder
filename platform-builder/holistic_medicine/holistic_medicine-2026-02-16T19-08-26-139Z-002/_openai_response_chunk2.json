          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f6fbf9;--card:#ffffff;--accent:#2a9d8f;--muted:#6b7280;--glass: rgba(255,255,255,0.6);--shadow: 0 8px 24px rgba(15,23,42,0.08);}    \\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:#0f172a;background:linear-gradient(180deg,#f6fbf9 0%, #eaf7f3 100%);}    \\n    header{position:relative;z-index:10;padding:28px 36px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#1f7a6f);box-shadow:0 6px 16px rgba(42,157,143,0.18);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav a{margin-left:18px;color:#0f172a;text-decoration:none;font-weight:600}\\n    nav a.secondary{color:var(--muted);font-weight:500}\\n    main{max-width:1100px;margin:28px auto;padding:28px}\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:28px;align-items:center}\\n    .hero-card{background:var(--card);border-radius:14px;padding:28px;box-shadow:var(--shadow)}\\n    .kicker{display:inline-block;padding:6px 10px;border-radius:999px;background:linear-gradient(90deg, rgba(42,157,143,0.12), rgba(42,157,143,0.06));color:var(--accent);font-weight:700;margin-bottom:12px}\\n    h1{margin:0 0 8px 0;font-size:28px;color:#062226}\\n    p.lead{margin:0;color:var(--muted);line-height:1.5}\\n    .services-list{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:18px}\\n    .service{background:linear-gradient(180deg,var(--glass),rgba(255,255,255,0.9));padding:14px;border-radius:10px;border:1px solid rgba(10,20,18,0.03)}\\n    .service h4{margin:0 0 6px 0;font-size:16px}\\n    .service p{margin:0;color:var(--muted);font-size:14px}\\n    .aside{background:linear-gradient(180deg,#fff,#f9fffd);padding:22px;border-radius:12px;border:1px solid rgba(15,23,42,0.04)}\\n    .cta-btn{display:inline-block;margin-top:12px;background:linear-gradient(180deg,var(--accent),#1f7a6f);color:#fff;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .testimonials{margin-top:26px;display:flex;gap:12px}\\n    .pill{background:rgba(42,157,143,0.06);padding:8px 12px;border-radius:999px;color:var(--accent);font-weight:700}\\n    .faq{margin-top:28px}\\n    .faq h3{margin-bottom:12px}\\n    .q{background:var(--card);padding:14px;border-radius:10px;margin-bottom:10px;border:1px solid rgba(15,23,42,0.04)}\\n    footer{padding:28px;text-align:center;color:var(--muted)}\\n    /* background svg */\\n    .bg-svg{position:fixed;right:-120px;top:-80px;width:520px;height:520px;opacity:0.16;pointer-events:none;z-index:0}\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.bg-svg{display:none}.services-list{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique svg pattern for services page -->\\n  <svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 600 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#dff7f3\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#bfeee6\\\"/></linearGradient>\\n      <filter id=\\\"f1\\\" x=\\\"-20%\\\" y=\\\"-20%\\\" width=\\\"140%\\\" height=\\\"140%\\\"><feGaussianBlur stdDeviation=\\\"24\\\"/></filter>\\n    </defs>\\n    <g filter=\\\"url(#f1)\\\">\\n      <circle cx=\\\"120\\\" cy=\\\"110\\\" r=\\\"140\\\" fill=\\\"url(#g1)\\\"/>\\n      <circle cx=\\\"430\\\" cy=\\\"380\\\" r=\\\"120\\\" fill=\\\"#e6fbf6\\\"/>\\n      <g fill=\\\"none\\\" stroke=\\\"#9fe6d8\\\" stroke-opacity=\\\"0.7\\\" stroke-width=\\\"2\\\">\\n        <path d=\\\"M30 480 C160 340 300 520 480 420\\\"/>\\n        <path d=\\\"M80 380 C180 280 360 480 520 360\\\"/>\\n      </g>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\" class=\\\"secondary\\\">Care &amp; Services</a>\\n      <a href=\\\"conditions.html\\\">Conditions</a>\\n      <a href=\\\"approach.html\\\">Our Way</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <span class=\\\"kicker\\\">Comprehensive • Hybrid</span>\\n        <h1>Personalized integrative services for whole-person health</h1>\\n        <p class=\\\"lead\\\">We combine evidence-informed nutrition, botanical medicine, mind-body techniques and collaborative care to support your resilience and daily functioning. Visits may be in-clinic or virtual, and plans bridge lifestyle, targeted therapies, and education.</p>\\n\\n        <div class=\\\"services-list\\\" aria-hidden=\\\"false\\\">\\n          <div class=\\\"service\\\">\\n            <h4>Integrative Health Consultation</h4>\\n            <p>Comprehensive intake, root-cause exploration and a shared care plan tailored to priorities and lifestyle.</p>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h4>Nutritional & Lifestyle Counseling</h4>\\n            <p>Practical food, sleep and stress strategies to strengthen daily rhythms and metabolic health.</p>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h4>Herbal & Nutraceutical Guidance</h4>\\n            <p>Evidence-based options reviewed for safety and interactions; recommendations focused on education, not cures.</p>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h4>Mind-Body & Stress Resilience</h4>\\n            <p>Breathwork, somatic tools and behavioral supports to enhance coping and recovery.</p>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:18px;display:flex;gap:10px;align-items:center\\\">\\n          <a class=\\\"cta-btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">Telehealth + in-person — {{CITY}}, {{STATE}}</div>\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"aside\\\">\\n        <strong style=\\\"display:block;margin-bottom:8px\\\">What to expect</strong>\\n        <p style=\\\"margin:0 0 12px;color:var(--muted)\\\">A thorough intake, collaborative plan, options for targeted labs if indicated, and clear follow-ups. We emphasize education and measurable goals.</p>\\n        <div class=\\\"pill\\\">Hybrid care</div>\\n        <div style=\\\"margin-top:12px\\\">Practitioner: {{PRACTITIONER_NAME}} {{CREDENTIALS}}</div>\\n        <a class=\\\"cta-btn\\\" href=\\\"book.html\\\" style=\\\"display:inline-block;margin-top:12px\\\">Schedule a visit</a>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"testimonials\\\" aria-labelledby=\\\"testi-title\\\">\\n      <div style=\\\"flex:1;background:var(--card);padding:14px;border-radius:12px;box-shadow:var(--shadow)\\\">\\n        <strong id=\\\"testi-title\\\">Client feedback</strong>\\n        <p style=\\\"margin:8px 0 0;color:var(--muted)\\\">\\\"Practical, compassionate care that helped me understand patterns in my health. The plan was realistic and supportive.\\\"</p>\\n        <div style=\\\"margin-top:8px;font-size:13px;color:var(--muted)\\\">— patient, {{CITY}}</div>\\n      </div>\\n      <div style=\\\"width:220px;background:linear-gradient(180deg,#fff,#f8fffc);padding:12px;border-radius:12px;border:1px solid rgba(15,23,42,0.04)\\\">\\n        <strong>Insurance & Billing</strong>\\n        <p style=\\\"margin:8px 0 0;color:var(--muted);font-size:13px\\\">We offer superbills for out-of-network claims and accept card payments. Contact {{EMAIL}} or call {{PHONE}} for details.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3>Common questions</h3>\\n      <div class=\\\"q\\\"><strong>Do you offer telehealth?</strong>\\n        <p style=\\\"margin:8px 0 0;color:var(--muted)\\\">Yes — many services are available virtually. In-person visits are available for assessments that benefit from a physical exam.</p>\\n      </div>\\n      <div class=\\\"q\\\"><strong>Will you order labs?</strong>\\n        <p style=\\\"margin:8px 0 0;color:var(--muted)\\\">We may suggest targeted, evidence-informed labs when clinically appropriate and discuss interpretation and next steps.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:26px;background:linear-gradient(90deg,#ffffff, #f3fff9);padding:18px;border-radius:12px;border:1px solid rgba(15,23,42,0.03);display:flex;justify-content:space-between;align-items:center;gap:12px\\\">\\n      <div>\\n        <strong>Get practical guidance emailed to you</strong>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">Sign up for concise, evidence-informed tips on sleep, stress and nutrition.</div>\\n      </div>\\n      <form action=\\\"mailto:{{EMAIL}}\\\" method=\\\"post\\\" enctype=\\\"text/plain\\\" style=\\\"display:flex;gap:8px;align-items:center\\\">\\n        <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Your email\\\" required style=\\\"padding:10px;border-radius:8px;border:1px solid rgba(15,23,42,0.06)\\\">\\n        <button class=\\\"cta-btn\\\" type=\\\"submit\\\">Subscribe</button>\\n      </form>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    <div style=\\\"margin-top:8px;color:var(--muted);font-size:13px\\\">All care is individualized. We focus on education and support rather than guarantees of cure.</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Concerns & Conditions — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#ffffff;--accent:#317873;--muted:#425164;--card:#fbfffe}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;background:linear-gradient(180deg,#ffffff,#f3fbf9);color:#082026}\\n    header{padding:20px 28px;display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:14px;text-decoration:none;color:var(--muted);font-weight:600}\\n    main{max-width:980px;margin:12px auto;padding:20px}\\n    .intro{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 8px 20px rgba(9,30,26,0.04)}\\n    h1{margin:0 0 8px 0}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px}\\n    .cond{background:white;padding:12px;border-radius:10px;border:1px solid rgba(6,34,32,0.03)}\\n    .cond h4{margin:0 0 6px 0}\\n    .cond p{margin:0;color:var(--muted);font-size:14px}\\n    .notice{margin-top:12px;color:#7f8b8a;font-size:13px}\\n    .cta{margin-top:18px}\\n    .btn{background:linear-gradient(180deg,var(--accent),#215f57);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .pattern{position:fixed;left:-100px;bottom:-60px;opacity:0.12;width:520px;height:520px;pointer-events:none}\\n    @media (max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <!-- nav with slightly different labels -->\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:10px\\\">\\n      <div style=\\\"width:44px;height:44px;border-radius:8px;background:linear-gradient(135deg,#2ba08f,#1a6e63);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Welcome</a>\\n      <a href=\\\"services.html\\\">Care</a>\\n      <a href=\\\"conditions.html\\\" style=\\\"color:#082026\\\">Concerns</a>\\n      <a href=\\\"approach.html\\\">How We Work</a>\\n      <a href=\\\"contact.html\\\">Get in touch</a>\\n    </nav>\\n  </header>\\n\\n  <!-- organic svg for conditions page -->\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 600 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <radialGradient id=\\\"rg\\\" cx=\\\"0.3\\\" cy=\\\"0.2\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#e8fcf5\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#c7f0e6\\\"/>\\n      </radialGradient>\\n    </defs>\\n    <g fill=\\\"url(#rg)\\\">\\n      <path d=\\\"M0 300 C120 180 200 420 360 360 C520 300 640 200 600 0 L600 600 L0 600 Z\\\"/>\\n    </g>\\n  </svg>\\n\\n  <main>\\n    <section class=\\\"intro\\\">\\n      <h1>Common health concerns we support</h1>\\n      <p style=\\\"margin-top:8px;color:var(--muted)\\\">Our approach centers on understanding the whole person: their habits, environment and biology. Below are typical concerns people bring to visits. Recommendations emphasize education, measurable goals, and shared decision-making.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"cond\\\">\\n          <h4>Chronic stress & anxiety</h4>\\n          <p>Practical strategies for nervous system regulation, sleep hygiene, and behavioral tools to reduce burden and restore function.</p>\\n        </div>\\n        <div class=\\\"cond\\\">\\n          <h4>Sleep difficulties</h4>\\n          <p>We assess sleep patterns, routines, and contributors such as diet, timing, and stress, offering nonpharmacologic supports and referrals when needed.</p>\\n        </div>\\n        <div class=\\\"cond\\\">\\n          <h4>Digestive complaints</h4>\\n          <p>Education on diet, microbiome-supportive choices, and stepwise assessment of red flags; personalized plans prioritize symptom relief and function.</p>\\n        </div>\\n        <div class=\\\"cond\\\">\\n          <h4>Chronic inflammation</h4>\\n          <p>Lifestyle-focused approaches (nutrition, activity, sleep) and discussion of evidence-based supplements when appropriate to lower inflammatory drivers.</p>\\n        </div>\\n        <div class=\\\"cond\\\">\\n          <h4>Low energy & fatigue</h4>\\n          <p>We explore sleep, metabolic factors, stress load and daily routines; education and practical pacing strategies form the core of care.</p>\\n        </div>\\n        <div class=\\\"cond\\\">\\n          <h4>Hormonal & metabolic concerns</h4>\\n          <p>We review patterns, labs when appropriate, and collaborative options that prioritize safety and individualized goals.</p>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"notice\\\">\\n        Note: This list is not exhaustive. Recommendations are evidence-informed and individualized. We do not promise cures; care focuses on supporting function, resilience and clarity about next steps. If you have urgent medical concerns, contact local emergency services or your primary care provider.</div>\\n\\n    </section>\\n\\n    <section style=\\\"margin-top:20px;display:flex;gap:14px;align-items:center;justify-content:space-between\\\">\\n      <div>\\n        <strong style=\\\"display:block\\\">Want tailored guidance?</strong>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">A focused visit assesses your priorities, clarifies possible drivers, and maps practical next steps.</div>\\n      </div>\\n      <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Book an assessment</a></div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>Short FAQ for concerns</h3>\\n      <div style=\\\"margin-top:8px;color:var(--muted)\\\">\\n        <strong>Will you treat my condition?</strong>\\n        <p style=\\\"margin:6px 0 0\\\">We provide education, personalized plans and, when appropriate, coordinate with other clinicians. Some conditions may require urgent or specialist care; we will refer as needed.</p>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"padding:18px;text-align:center;color:var(--muted)\\\">\\n    <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    <div style=\\\"margin-top:8px;font-size:13px\\\">All information is educational. Individual results vary and no cure is guaranteed.</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>How We Work — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfffd;--accent:#1f8b74;--muted:#4b5661}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;background:linear-gradient(180deg,#fbfffd,#f0faf7);color:#052022}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 24px}\\n    header a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    main{max-width:980px;margin:20px auto;padding:18px}\\n    .hero{padding:20px;background:white;border-radius:12px;box-shadow:0 8px 24px rgba(6,24,22,0.04)}\\n    .steps{display:flex;flex-direction:column;gap:12px;margin-top:14px}\\n    .step{background:linear-gradient(180deg,#ffffff,#f8fffb);padding:14px;border-radius:10px;border:1px solid rgba(6,24,22,0.03)}\\n    .step h4{margin:0 0 6px 0}\\n    .note{font-size:13px;color:var(--muted);margin-top:8px}\\n    .labs{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}\\n    .lab{background:rgba(31,139,116,0.06);padding:8px 10px;border-radius:999px;color:var(--accent);font-weight:700}\\n    .pattern{position:fixed;right:10px;bottom:10px;width:320px;height:320px;opacity:0.12;pointer-events:none}\\n    footer{padding:18px;text-align:center;color:var(--muted)}\\n    @media (max-width:700px){.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:10px\\\">\\n      <div style=\\\"width:44px;height:44px;border-radius:8px;background:linear-gradient(135deg,#27a186,#176a57);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">Practical, whole-person care</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"conditions.html\\\">Issues</a>\\n      <a href=\\\"approach.html\\\" style=\\\"color:#052022;font-weight:700\\\">Our Approach</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <!-- geometric svg for approach page -->\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 400 400\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"lg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#e6fbf6\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#cff4ea\\\"/></linearGradient>\\n    </defs>\\n    <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"400\\\" height=\\\"400\\\" rx=\\\"50\\\" fill=\\\"url(#lg)\\\"/>\\n    <g transform=\\\"translate(30,30)\\\" fill=\\\"none\\\" stroke=\\\"#9fe6d8\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\">\\n      <path d=\\\"M10 70 L90 10 L170 70 L250 10\\\"/>\\n      <circle cx=\\\"60\\\" cy=\\\"40\\\" r=\\\"6\\\" fill=\\\"#dffaf4\\\" stroke=\\\"none\\\"/>\\n    </g>\\n  </svg>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <h1 style=\\\"margin:0\\\">An evidence-informed, patient-centered process</h1>\\n      <p style=\\\"margin-top:8px;color:var(--muted)\\\">Our care is collaborative: we listen, clarify priorities, and co-create a plan that blends lifestyle, education, and targeted interventions when appropriate. We follow up to support progress and adapt the plan.</p>\\n\\n      <div class=\\\"steps\\\" aria-live=\\\"polite\\\">\\n        <div class=\\\"step\\\">\\n          <h4>1 — Intake & Listening</h4>\\n          <p style=\\\"margin:0;color:var(--muted)\\\">A detailed intake explores timelines, medical history, lifestyle patterns and goals. We identify possible contributors and immediate priorities.</p>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <h4>2 — Shared Plan</h4>\\n          <p style=\\\"margin:0;color:var(--muted)\\\">We co-design a practical plan that may include nutrition, sleep practices, stress tools, botanicals or supplements when safe. Expect clear, measurable steps and educational resources.</p>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <h4>3 — Optional labs & focused testing (educational)</h4>\\n          <p style=\\\"margin:0;color:var(--muted)\\\">When indicated, we discuss targeted laboratory options to clarify mechanisms. Labs are used to inform decisions, not as guarantees of outcomes.</p>\\n          <div class=\\\"labs\\\">\\n            <div class=\\\"lab\\\">Basic metabolic panel</div>\\n            <div class=\\\"lab\\\">Thyroid panel</div>\\n            <div class=\\\"lab\\\">Inflammation markers</div>\\n            <div class=\\\"lab\\\">Targeted micronutrient tests</div>\\n          </div>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <h4>4 — Follow-ups & Coordination</h4>\\n          <p style=\\\"margin:0;color:var(--muted)\\\">Follow-up visits monitor progress, refine strategies and coordinate with other clinicians. We emphasize achievable steps and long-term resilience.</p>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"note\\\">All recommendations are individualized. We emphasize education, risk/benefit discussion, and shared decision-making. We do not guarantee outcomes.</div>\\n\\n      <div style=\\\"margin-top:14px\\\">\\n        <a class=\\\"btn\\\" href=\\\"book.html\\\" style=\\\"background:linear-gradient(180deg,var(--accent),#166a57);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700\\\">Start with an intake</a>\\n        <a href=\\\"contact.html\\\" style=\\\"margin-left:12px;color:var(--muted);text-decoration:none\\\">Questions? Email {{EMAIL}}</a>\\n      </div>\\n\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>Our hybrid model</h3>\\n      <p style=\\\"color:var(--muted)\\\">We offer both telehealth and in-clinic visits to improve access and continuity. Certain assessments may be recommended in person for safety or thoroughness.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>What we do not do</h3>\\n      <p style=\\\"color:var(--muted)\\\">We provide education and evidence-informed options. We do not promise cures and will refer to specialists when conditions require targeted or urgent care.</p>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"color:var(--muted)\\\">{{BUSINESS_NAME}} • Practitioner: {{PRACTITIONER_NAME}} {{CREDENTIALS}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
