          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#FAF7F3;--accent:#6C7BFF;--muted:#6B6B6B;--card:#FFFFFF;--glass:rgba(255,255,255,0.6)}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#222}\\n    body{background:linear-gradient(160deg,var(--bg1),#F0F7FF);background-attachment:fixed}\\n    /* Data-URI SVG pattern (unique) */\\n    :root{--pattern:url(\\\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='400' viewBox='0 0 400 400'><defs><linearGradient id='g' x1='0' x2='1'><stop offset='0' stop-color='%236c7bff'/><stop offset='1' stop-color='%23ffb199'/></linearGradient></defs><g opacity='0.08'><path d='M0 120 C100 50 300 190 400 120 L400 400 L0 400 Z' fill='url(%23g)'/><circle cx='60' cy='60' r='40' fill='%23ffd7e0' opacity='0.12'/><circle cx='340' cy='320' r='60' fill='%23cfe9ff' opacity='0.10'/></g></svg>\\\")}\\n    header{position:sticky;top:0;backdrop-filter:saturate(120%) blur(6px);background:linear-gradient(180deg,rgba(255,255,255,0.7),rgba(255,255,255,0.55));border-bottom:1px solid rgba(0,0,0,0.04);display:flex;align-items:center;justify-content:space-between;padding:14px 20px;z-index:20}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:44px;height:44px;border-radius:10px;background:var(--pattern);box-shadow:0 6px 18px rgba(108,123,255,0.12);display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff}\\n    nav a{margin:0 8px;text-decoration:none;color:var(--muted);font-weight:600}\\n    .primary{background:linear-gradient(90deg,var(--accent),#FF9A8B);color:#fff;padding:10px 14px;border-radius:9px;text-decoration:none;font-weight:700}\\n    main{max-width:1100px;margin:36px auto;padding:0 20px}\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:28px;align-items:center}\\n    .card{background:var(--card);border-radius:14px;padding:26px;box-shadow:0 8px 28px rgba(84,88,130,0.06)}\\n    h1{margin:0 0 8px;font-size:28px;line-height:1.05}\\n    p.lead{margin:0;color:var(--muted)}\\n    .services-list{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:18px}\\n    .service{padding:14px;border-radius:12px;background:linear-gradient(180deg,rgba(108,123,255,0.04),rgba(255,154,139,0.03));border:1px solid rgba(108,123,255,0.06)}\\n    .service h3{margin:0 0 6px;font-size:16px}\\n    .service p{margin:0;color:var(--muted);font-size:14px}\\n    .aside-cta{position:relative}\\n    .aside-graphic{height:220px;border-radius:12px;background:var(--pattern);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    .social-proof{display:flex;gap:12px;align-items:center;margin-top:18px}\\n    .badge{background:linear-gradient(90deg,#fff,rgba(255,255,255,0.85));padding:10px 12px;border-radius:10px;box-shadow:0 6px 18px rgba(20,20,20,0.04);font-weight:700}\\n    .benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:22px}\\n    .benefit{background:var(--card);padding:16px;border-radius:10px;border:1px solid rgba(0,0,0,0.03)}\\n    .process{margin-top:26px}\\n    .step{display:flex;gap:12px;align-items:flex-start;padding:12px;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.7),rgba(255,255,255,0.55));border:1px dashed rgba(0,0,0,0.04)}\\n    footer{max-width:1100px;margin:36px auto;padding:18px 20px;color:var(--muted);display:flex;justify-content:space-between;align-items:center}\\n    /* responsive */\\n    @media(max-width:900px){.hero{grid-template-columns:1fr;}.benefits{grid-template-columns:1fr 1fr}.services-list{grid-template-columns:1fr}.aside-graphic{height:160px}}\\n    @media(max-width:520px){.benefits{grid-template-columns:1fr}.nav-small{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav class=\\\"nav-small\\\">\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"approach.html\\\">Method</a>\\n      <a class=\\\"primary\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"card\\\">\\n        <h1>Comprehensive integrative care for your whole life, not just symptoms.</h1>\\n        <p class=\\\"lead\\\">We blend evidence-informed therapies with lifestyle coaching so you can feel steadier, sleep better, and bring energy back—thoughtfully, safely, and person-first.</p>\\n\\n        <div class=\\\"services-list\\\" aria-label=\\\"services\\\">\\n          <div class=\\\"service\\\">\\n            <h3>Personalized Consultations</h3>\\n            <p>One-on-one visits to map your history, goals and priorities into a gentle plan.</p>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h3>Nutritional Strategy</h3>\\n            <p>Food as medicine: simple, practical changes that support digestion and energy.</p>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h3>Herbal & Mind-Body Support</h3>\\n            <p>Safe botanical recommendations combined with breathing, sleep coaching and stress tools.</p>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h3>Care Coordination</h3>\\n            <p>We work with your existing providers to make integrative options practical and aligned.</p>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"social-proof\\\">\\n          <div class=\\\"badge\\\">4.9★ — Kind, thoughtful care</div>\\n          <div style=\\\"color:var(--muted);font-size:13px\\\">Trusted by clients in {{CITY}}, {{STATE}}</div>\\n        </div>\\n\\n        <div class=\\\"benefits\\\" aria-label=\\\"benefits\\\">\\n          <div class=\\\"benefit\\\">\\n            <strong>Whole-person plans</strong>\\n            <div style=\\\"color:var(--muted);margin-top:6px\\\">Not quick fixes—sustainable routines that respect your life rhythm.</div>\\n          </div>\\n          <div class=\\\"benefit\\\">\\n            <strong>Evidence-minded</strong>\\n            <div style=\\\"color:var(--muted);margin-top:6px\\\">We prioritize safety and what the science supports for integrative care.</div>\\n          </div>\\n          <div class=\\\"benefit\\\">\\n            <strong>Flexible follow-up</strong>\\n            <div style=\\\"color:var(--muted);margin-top:6px\\\">Short check-ins, comprehensive reviews, and messaging between visits.</div>\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"aside-cta\\\">\\n        <div class=\\\"card\\\">\\n          <div class=\\\"aside-graphic\\\">Your care mosaic</div>\\n          <div style=\\\"margin-top:12px;font-weight:700\\\">Introductory Session</div>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">A thoughtful first visit with {{PRACTITIONER_NAME}}, {{CREDENTIALS}} to listen and co-create a plan.</div>\\n          <a class=\\\"primary\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:inline-block;margin-top:12px\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px;text-align:center\\\">\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">Questions? Call us:</div>\\n          <div style=\\\"font-weight:800;margin-top:6px\\\">{{PHONE}}</div>\\n          <div style=\\\"color:var(--muted);margin-top:8px;font-size:13px\\\">Or email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"process card\\\">\\n      <h2 style=\\\"margin-top:0\\\">How a typical engagement flows</h2>\\n      <div class=\\\"step\\\">\\n        <div style=\\\"width:42px;height:42px;border-radius:10px;background:linear-gradient(180deg,var(--accent),#FF9A8B);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800\\\">1</div>\\n        <div>\\n          <strong>Intake & story</strong>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">We dig into history, lifestyle, labs and goals so recommendations are tailored—not generic.</div>\\n        </div>\\n      </div>\\n      <div class=\\\"step\\\" style=\\\"margin-top:10px\\\">\\n        <div style=\\\"width:42px;height:42px;border-radius:10px;background:linear-gradient(180deg,#FFD7E0,#CFE9FF);display:flex;align-items:center;justify-content:center;font-weight:800\\\">2</div>\\n        <div>\\n          <strong>Co-created plan</strong>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">A balanced approach combining lifestyle, nutrition, and optional supportive modalities. We discuss risks, benefits and alternatives.</div>\\n        </div>\\n      </div>\\n      <div class=\\\"step\\\" style=\\\"margin-top:10px\\\">\\n        <div style=\\\"width:42px;height:42px;border-radius:10px;background:linear-gradient(180deg,#E6F9E9,#CFE9FF);display:flex;align-items:center;justify-content:center;font-weight:800\\\">3</div>\\n        <div>\\n          <strong>Follow-up & adjust</strong>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">Short check-ins to refine and support, with practical tools you can use at home.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Common questions</h2>\\n      <div style=\\\"color:var(--muted);font-size:14px\\\">We keep notes concise and share resources. Here are a few things clients often ask.</div>\\n      <div style=\\\"margin-top:12px\\\">\\n        <details>\\n          <summary style=\\\"cursor:pointer;font-weight:700\\\">Do you prescribe supplements or herbs?</summary>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Yes—when appropriate and evidence-supported. We review interactions and safety. Not all clients need supplements; we emphasize food-first where possible.</div>\\n        </details>\\n        <details style=\\\"margin-top:8px\\\">\\n          <summary style=\\\"cursor:pointer;font-weight:700\\\">How long until I see change?</summary>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Timing varies. Some habits show improvement in weeks, others take months. We focus on realistic, measurable steps rather than promises.</div>\\n        </details>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center;gap:12px\\\">\\n      <div>\\n        <strong style=\\\"font-size:16px\\\">Free guide: 7 gentle shifts for better sleep & energy</strong>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">Download practical, no-nonsense tips you can try tonight.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"primary\\\" href=\\\"book.html\\\">Get the guide</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>© {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n    <div style=\\\"color:var(--muted)\\\">Practitioner: {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Concerns & Conditions — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#FFFDF8;--accent:#2FBF9A;--muted:#5B616A}\\n    body{margin:0;font-family:Inter,system-ui,Roboto,Arial;color:#202124;background:linear-gradient(180deg,var(--bg),#F4FAF8)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:16px 22px;background:rgba(255,255,255,0.7);backdrop-filter:blur(6px)}\\n    .logo{font-weight:800;color:var(--accent)}\\n    nav a{margin:0 8px;color:var(--muted);text-decoration:none}\\n    .hero{max-width:1000px;margin:28px auto;padding:0 20px}\\n    .intro{display:flex;gap:18px;align-items:center}\\n    .intro .title{font-size:26px;font-weight:800}\\n    .intro p{color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:20px;margin-top:18px}\\n    .card{background:#fff;border-radius:12px;padding:18px;box-shadow:0 10px 30px rgba(12,20,24,0.04)}\\n    .concerns{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}\\n    .concern{padding:12px;border-radius:10px;border-left:4px solid rgba(47,191,154,0.12)}\\n    .concern h4{margin:0 0 6px}\\n    .disclaimer{font-size:13px;color:#7a7a7a;margin-top:12px}\\n    .side-help{display:flex;flex-direction:column;gap:12px}\\n    .contact-card{background:linear-gradient(180deg,rgba(47,191,154,0.06),#fff);padding:14px;border-radius:10px}\\n    footer{max-width:1000px;margin:22px auto;padding:10px 20px;color:var(--muted)}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}.concerns{grid-template-columns:1fr}.intro{flex-direction:column;align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"approach.html\\\">Approach</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"hero\\\">\\n    <div class=\\\"intro\\\">\\n      <div>\\n        <div class=\\\"title\\\">Common health concerns we support</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\">Our focus is education, integrating safe options, and helping you build resilience. We never promise cures; instead we support practical, evidence-informed change.</div>\\n      </div>\\n      <div style=\\\"margin-left:auto;color:var(--muted)\\\">Call to discuss: <strong style=\\\"color:#111\\\">{{PHONE}}</strong></div>\\n    </div>\\n\\n    <div class=\\\"grid\\\">\\n      <section class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Areas clients often bring</h3>\\n        <div class=\\\"concerns\\\">\\n          <div class=\\\"concern\\\">\\n            <h4>Chronic stress & anxiety</h4>\\n            <div style=\\\"color:var(--muted);font-size:14px\\\">Tools for calming the nervous system, sleep hygiene, breathwork and gentle herbal support where appropriate.</div>\\n          </div>\\n          <div class=\\\"concern\\\">\\n            <h4>Sleep disturbances</h4>\\n            <div style=\\\"color:var(--muted);font-size:14px\\\">Behavioral strategies, evening routines, and selective, safe interventions to improve sleep onset and continuity.</div>\\n          </div>\\n          <div class=\\\"concern\\\">\\n            <h4>Digestive discomfort</h4>\\n            <div style=\\\"color:var(--muted);font-size:14px\\\">Dietary patterns, mindful eating, and targeted support to address bloating, irregularity and reflux symptoms.</div>\\n          </div>\\n          <div class=\\\"concern\\\">\\n            <h4>Inflammatory symptoms</h4>\\n            <div style=\\\"color:var(--muted);font-size:14px\\\">Lifestyle, nutrition and movement approaches that reduce systemic strain; we discuss labs only when clinically useful.</div>\\n          </div>\\n          <div class=\\\"concern\\\">\\n            <h4>Low energy & fatigue</h4>\\n            <div style=\\\"color:var(--muted);font-size:14px\\\">Work-within-your-life plans to restore steadier energy through sleep, nutrition and pacing strategies.</div>\\n          </div>\\n          <div class=\\\"concern\\\">\\n            <h4>General wellness & prevention</h4>\\n            <div style=\\\"color:var(--muted);font-size:14px\\\">Practical steps for long-term resilience—movement, stress buffering, and nutrient-rich eating.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"disclaimer\\\">\\n          Important: This information is educational and not a substitute for medical care. If you have acute or severe symptoms, please seek immediate medical attention. We focus on supporting whole-person health and coordinating with your medical providers when needed.\\n        </div>\\n      </section>\\n\\n      <aside class=\\\"side-help\\\">\\n        <div class=\\\"contact-card\\\">\\n          <div style=\\\"font-weight:800\\\">New here?</div>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">Start with an intake to map your priorities. We emphasize realistic, safe steps aligned with your values.</div>\\n          <a href=\\\"book.html\\\" style=\\\"display:inline-block;margin-top:10px;padding:10px 12px;background:var(--accent);color:#fff;border-radius:8px;text-decoration:none;font-weight:700\\\">Book an intake</a>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <strong>Resources</strong>\\n          <ul style=\\\"margin-top:8px;color:var(--muted)\\\">\\n            <li>Sleep checklist</li>\\n            <li>Digestive basics</li>\\n            <li>Stress toolkit</li>\\n          </ul>\\n          <a href=\\\"contact.html\\\" style=\\\"color:var(--accent);font-weight:700;text-decoration:none\\\">Ask a question</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin-top:0\\\">Frequently asked</h3>\\n      <details>\\n        <summary style=\\\"cursor:pointer;font-weight:700\\\">Will you replace my current doctor?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">No—our model is integrative and collaborative. We can coordinate with your primary care or specialists and provide complementary support.</div>\\n      </details>\\n      <details style=\\\"margin-top:8px\\\">\\n        <summary style=\\\"cursor:pointer;font-weight:700\\\">Are labs required?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Not always. Labs are discussed when they will inform care; we aim to avoid unnecessary testing and to interpret results within your full context.</div>\\n      </details>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <strong>Want a short guide?</strong>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">Download quick strategies for sleep, stress and digestion.</div>\\n        </div>\\n        <a href=\\\"book.html\\\" style=\\\"background:var(--accent);color:#fff;padding:10px 12px;border-radius:8px;text-decoration:none;font-weight:700\\\">Get the guide</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"text-align:center\\\">© {{BUSINESS_NAME}} • {{PRACTITIONER_NAME}}, {{CREDENTIALS}} • Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Our Approach — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#F7FBFF;--accent:#FF8FB0;--ink:#212121;--muted:#667085}\\n    body{margin:0;font-family:Inter,system-ui,Arial;color:var(--ink);background:linear-gradient(180deg,var(--bg),#FFF8FB)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;background:rgba(255,255,255,0.8);box-shadow:0 4px 16px rgba(20,20,50,0.03)}\\n    .nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-weight:600}\\n    main{max-width:1000px;margin:28px auto;padding:0 20px}\\n    .hero{background:linear-gradient(90deg,#fff,#FFF6F8);border-radius:14px;padding:20px;display:flex;gap:18px;align-items:center}\\n    .hero h1{margin:0;font-size:24px}\\n    .overview{margin-top:18px}\\n    .flow{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:12px}\\n    .phase{background:#fff;padding:12px;border-radius:10px;border:1px solid rgba(0,0,0,0.03)}\\n    .phase h4{margin:0 0 6px}\\n    .note{color:var(--muted);font-size:14px;margin-top:10px}\\n    .labs{margin-top:18px;background:linear-gradient(180deg,rgba(255,143,176,0.06),#fff);padding:14px;border-radius:12px}\\n    .faq{margin-top:18px}\\n    .cta{margin-top:20px;display:flex;gap:12px;align-items:center}\\n    @media(max-width:880px){.flow{grid-template-columns:1fr 1fr}.hero{flex-direction:column}}\\n    @media(max-width:520px){.flow{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"approach.html\\\">Our Way</a>\\n      <a href=\\\"book.html\\\" style=\\\"font-weight:800;color:var(--accent)\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>A calm, evidence-informed route to whole-person care</h1>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">We listen first, use targeted tools, and adapt. Think of us as a guide: educational, careful, and collaborative.</div>\\n      </div>\\n      <div style=\\\"margin-left:auto;text-align:right\\\">\\n        <div style=\\\"font-weight:800\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n        <div style=\\\"color:var(--muted);font-size:14px;margin-top:6px\\\">Serving {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"overview\\\">\\n      <h2 style=\\\"margin:12px 0 6px\\\">What to expect in our clinical flow</h2>\\n      <div class=\\\"flow\\\" aria-label=\\\"flow\\\">\\n        <div class=\\\"phase\\\">\\n          <h4>1 — Intake & listening</h4>\\n          <div class=\\\"note\\\">A deep-dive conversation: history, priorities and current challenges. We co-create the goals here.</div>\\n        </div>\\n        <div class=\\\"phase\\\">\\n          <h4>2 — Assessment</h4>\\n          <div class=\\\"note\\\">We review relevant history and any existing labs. If additional tests could change management, we discuss options and costs.</div>\\n        </div>\\n        <div class=\\\"phase\\\">\\n          <h4>3 — Plan</h4>\\n          <div class=\\\"note\\\">A balanced plan with lifestyle steps, optional supplements or botanicals, and clear measurement points.</div>\\n        </div>\\n        <div class=\\\"phase\\\">\\n          <h4>4 — Follow-up</h4>\\n          <div class=\\\"note\\\">Short check-ins to adjust, plus scheduled reassessments to track progress and safety.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"labs card\\\" aria-labelledby=\\\"labs-title\\\">\\n      <h3 id=\\\"labs-title\\\" style=\\\"margin-top:0\\\">About labs & testing (educational)</h3>\\n      <div style=\\\"color:var(--muted);\\\">Tests can be informative when chosen for a specific question. We discuss who benefits, what each test can and cannot tell us, and avoid unnecessary or redundant panels. Common examples include:</div>\\n      <ul style=\\\"margin-top:8px;color:var(--muted)\\\">\\n        <li>Basic metabolic and thyroid panels — to screen common contributors to fatigue.</li>\\n        <li>Targeted nutrient testing — when signs suggest deficiency and results would change recommendations.</li>\\n        <li>Specialized GI testing — only if symptoms or history indicate likely benefit.</li>\\n      </ul>\\n      <div style=\\\"margin-top:8px;color:var(--muted);font-size:13px\\\">Testing is optional and always discussed with transparency about cost, utility and interpretation. We never use tests to oversell treatments.</div>\\n    </section>\\n\\n    <section class=\\\"faq card\\\">\\n      <h3 style=\\\"margin-top:0\\\">Questions people ask about our approach</h3>\\n      <details>\\n        <summary style=\\\"cursor:pointer;font-weight:700\\\">Do you promise results?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">No. Each body is unique. We focus on realistic expectations, educational support and stepwise change—never guarantees.</div>\\n      </details>\\n\\n      <details style=\\\"margin-top:8px\\\">\\n        <summary style=\\\"cursor:pointer;font-weight:700\\\">Will you recommend prescription medications?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">When within scope and clinically indicated, we may discuss pharmacologic options, but our orientation emphasizes lifestyle, coordination and evidence-based integrative tools.</div>\\n      </details>\\n\\n      <details style=\\\"margin-top:8px\\\">\\n        <summary style=\\\"cursor:pointer;font-weight:700\\\">What about herbal safety?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Herbs are considered when evidence and safety align with your care. We always review interactions with medications and existing conditions.</div>\\n      </details>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;display:flex;gap:12px;align-items:center\\\">\\n      <div style=\\\"flex:1\\\" class=\\\"card\\\">\\n        <strong>Ready to begin?</strong>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">Book an intake to map your priorities and build a plan that fits your life.</div>\\n      </div>\\n      <div>\\n        <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:inline-block;padding:12px 14px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#FFB87A);color:#fff;font-weight:800;text-decoration:none\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <strong>Free resource</strong>\\n      <div style=\\\"color:var(--muted);margin-top:6px\\\">Download our quick checklist: first 14 days after your intake — simple steps to get started.</div>\\n      <a href=\\\"book.html\\\" style=\\\"display:inline-block;margin-top:10px;padding:10px 12px;background:#fff;border:1px solid rgba(0,0,0,0.06);border-radius:8px;text-decoration:none;font-weight:700;color:var(--accent)\\\">Download</a>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"text-align:center;padding:18px 0;color:var(--muted)\\\">Practitioner: {{PRACTITIONER_NAME}}, {{CREDENTIALS}} • {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
