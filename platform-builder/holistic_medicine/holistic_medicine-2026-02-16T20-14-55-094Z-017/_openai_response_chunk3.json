          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'/>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'/>\\n  <title>Plans — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfaf8;--muted:#6b6b6b;--accent:#6a9b6a;--soft:#eaf6ea;--card:#ffffff;--glass:rgba(255,255,255,0.6);font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;}\\n    *{box-sizing:border-box}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg),#f3f7f6);color:#122;min-height:100vh;line-height:1.4}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:22px 28px}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-weight:600}\\n    nav a.active{color:var(--accent)}\\n    .wrap{max-width:1100px;margin:0 auto;padding:20px}\\n    .hero{display:flex;gap:24px;align-items:center;padding:36px;border-radius:14px;background:linear-gradient(135deg,rgba(106,155,106,0.08),rgba(234,246,234,0.6));box-shadow:0 6px 30px rgba(14,30,20,0.06)}\\n    .hero .lead{flex:1}\\n    h1{margin:0 0 10px 0;font-size:28px;color:#0f2b22}\\n    p.lead{margin:0;color:var(--muted)}\\n    .price-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:20px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 8px 20px rgba(16,24,16,0.04);border:1px solid rgba(12,20,16,0.04)}\\n    .card.feature{border:2px solid var(--accent);transform:translateY(-6px)}\\n    .price{font-size:22px;color:var(--accent);font-weight:700}\\n    ul.benefits{padding-left:18px;margin:12px 0 0 0;color:var(--muted)}\\n    .cta{display:inline-block;margin-top:14px;padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none;font-weight:700}\\n    /* Social proof */\\n    .social{display:flex;gap:12px;align-items:center;margin-top:18px}\\n    .avatar{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#fff,#f3f7f6);display:flex;align-items:center;justify-content:center;font-weight:800;color:#2b5}\\n    .small{font-size:13px;color:var(--muted)}\\n    /* process */\\n    .process{display:flex;gap:12px;margin-top:20px}\\n    .step{background:var(--card);padding:12px;border-radius:10px;flex:1;border:1px solid rgba(12,20,16,0.04)}\\n    .faq{margin-top:20px}\\n    .faq details{background:var(--card);padding:12px;border-radius:10px;margin-bottom:10px}\\n    /* lead magnet */\\n    .lead-magnet{display:flex;gap:18px;align-items:center;margin-top:22px;padding:14px;border-radius:12px;background:linear-gradient(90deg,#ffffff, #fbfff8)}\\n    .lead-magnet input{padding:10px;border-radius:10px;border:1px solid #e5e5e5;flex:1}\\n    .footer-cta{margin-top:26px;padding:20px;border-radius:12px;background:linear-gradient(180deg,#fff,#f6fff6);display:flex;justify-content:space-between;align-items:center}\\n    .pattern{position:fixed;right:-80px;top:-40px;opacity:0.12;width:420px;height:420px;pointer-events:none}\\n    @media(max-width:900px){.price-grid{grid-template-columns:1fr}.hero{flex-direction:column}.pattern{width:260px;height:260px;right:-40px;top:-10px}}\\n  </style>\\n</head>\\n<body>\\n  <svg class='pattern' viewBox='0 0 600 600' xmlns='http://www.w3.org/2000/svg' preserveAspectRatio='xMidYMid slice'>\\n    <defs>\\n      <linearGradient id='g1' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#ccf0cc'/>\\n        <stop offset='1' stop-color='#eaf6ea'/>\\n      </linearGradient>\\n    </defs>\\n    <rect width='100%' height='100%' fill='url(#g1)' rx='24' />\\n    <g fill='rgba(106,155,106,0.12)'>\\n      <circle cx='120' cy='80' r='60'/>\\n      <circle cx='320' cy='220' r='90'/>\\n      <circle cx='480' cy='420' r='40'/>\\n    </g>\\n  </svg>\\n\\n  <header class='wrap'>\\n    <div style='display:flex;align-items:center;gap:12px'>\\n      <div style='font-weight:800;color:var(--accent)'>{{BUSINESS_NAME}}</div>\\n      <div style='color:var(--muted);font-size:13px'>{{TAGLINE}}</div>\\n    </div>\\n    <nav>\\n      <a href='index.html'>Welcome</a>\\n      <a href='services.html'>Our Offer</a>\\n      <a href='conditions.html'>Concerns</a>\\n      <a href='approach.html'>How We Help</a>\\n      <a class='active' href='pricing.html'>Plans</a>\\n      <a href='about.html'>Who We Are</a>\\n      <a href='book.html'>Book</a>\\n    </nav>\\n  </header>\\n\\n  <main class='wrap'>\\n    <section class='hero'>\\n      <div class='lead'>\\n        <h1>Flexible care packages for whole-person health</h1>\\n        <p class='lead'>Thoughtful plans that combine education, one-on-one time, and optional testing — not promises. Choose the level of support that fits your life and goals.</p>\\n        <div class='social'>\\n          <div class='avatar'>JP</div>\\n          <div style='font-size:14px'>Trusted by hundreds in <strong>{{CITY}}, {{STATE}}</strong></div>\\n        </div>\\n      </div>\\n      <div style='min-width:260px'>\\n        <div class='card'>\\n          <div class='small'>Starter Session</div>\\n          <div class='price'>$129</div>\\n          <div style='font-size:13px;color:var(--muted);margin-top:8px'>Single extended intake + individualized education.</div>\\n          <a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class='price-grid'>\\n      <div class='card'>\\n        <h3>Baseline Wellness</h3>\\n        <div class='small'>Ideal for focused, short-term goals</div>\\n        <div class='price'>$349 / 3 months</div>\\n        <ul class='benefits'>\\n          <li>Intake + 2 follow-ups</li>\\n          <li>Personalized lifestyle guide</li>\\n          <li>Email check-ins</li>\\n        </ul>\\n        <a class='cta' href='book.html'>Choose Baseline</a>\\n      </div>\\n\\n      <div class='card feature'>\\n        <h3>Integrative Intensive</h3>\\n        <div class='small'>For people seeking deep, structured change</div>\\n        <div class='price'>$999 / 6 months</div>\\n        <ul class='benefits'>\\n          <li>Comprehensive intake + monthly visits</li>\\n          <li>Lab review (optional, educational)</li>\\n          <li>Priority messaging & progress planning</li>\\n        </ul>\\n        <a class='cta' href='book.html'>Start Intensive</a>\\n      </div>\\n\\n      <div class='card'>\\n        <h3>Maintenance</h3>\\n        <div class='small'>Continued support for established plans</div>\\n        <div class='price'>$199 / month</div>\\n        <ul class='benefits'>\\n          <li>Monthly check-in</li>\\n          <li>Plan adjustments</li>\\n          <li>Referrals & resources</li>\\n        </ul>\\n        <a class='cta' href='book.html'>Maintain Progress</a>\\n      </div>\\n    </section>\\n\\n    <section class='process'>\\n      <div class='step'>\\n        <strong>1. Intake</strong>\\n        <div class='small'>A thorough conversation about history, nutrition, sleep, stress, and intentions.</div>\\n      </div>\\n      <div class='step'>\\n        <strong>2. Personalized Plan</strong>\\n        <div class='small'>Education-focused recommendations, gentle experiments, and optional labs explained — never pressured.</div>\\n      </div>\\n      <div class='step'>\\n        <strong>3. Follow-up</strong>\\n        <div class='small'>Adjustments over time, with tools to build lasting habits.</div>\\n      </div>\\n    </section>\\n\\n    <section class='faq'>\\n      <h3>Common questions</h3>\\n      <details>\\n        <summary>Do you promise a cure?</summary>\\n        <div class='small'>No. We focus on education, symptom management, and whole-person strategies. Results vary and we do not guarantee cures.</div>\\n      </details>\\n      <details>\\n        <summary>Are labs required?</summary>\\n        <div class='small'>Labs are optional and presented as educational tools to support the care plan.</div>\\n      </details>\\n      <details>\\n        <summary>Insurance?</summary>\\n        <div class='small'>Policies vary. We provide receipts that may help with reimbursement but do not bill insurers directly.</div>\\n      </details>\\n    </section>\\n\\n    <section class='lead-magnet'>\\n      <div style='flex:1'>\\n        <strong>Free guide:</strong> \\\"5 Gentle Shifts for Better Sleep & Energy\\\"\\n        <div class='small'>Quick, evidence-informed tips you can try tonight.</div>\\n      </div>\\n      <form style='display:flex;gap:8px;flex:1;max-width:480px' onsubmit='event.preventDefault();alert(\\\"Thanks — we\\\\'ll send the guide to \\\" + (this.email.value||\\\"your inbox\\\"));'>\\n        <input name='email' type='email' placeholder='Your email' required />\\n        <button class='cta' type='submit'>Send the guide</button>\\n      </form>\\n    </section>\\n\\n    <section class='footer-cta'>\\n      <div>\\n        <strong>Ready to begin?</strong>\\n        <div class='small'>Book a short consult to find the right plan for you.</div>\\n      </div>\\n      <div>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer style='padding:20px;text-align:center;color:var(--muted)'>\\n    <div>{{BUSINESS_NAME}} • <a href='mailto:{{EMAIL}}' style='color:var(--muted);text-decoration:none'>{{EMAIL}}</a> • {{PHONE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'/>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'/>\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffdfb;--accent:#7b5ea6;--muted:#68707b;--card:#fff;--glass:rgba(255,255,255,0.8);font-family:Georgia, 'Times New Roman', serif}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg),#f7f4fb);color:#1a1530}\\n    .wrap{max-width:960px;margin:0 auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center;padding-bottom:12px}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .hero{background:linear-gradient(135deg, rgba(123,94,166,0.06), rgba(247,240,251,0.8));padding:26px;border-radius:12px}\\n    h1{margin:0;font-size:30px}\\n    p.lead{color:var(--muted);margin-top:8px}\\n    .grid{display:grid;grid-template-columns:2fr 1fr;gap:18px;margin-top:18px}\\n    .card{background:var(--card);padding:16px;border-radius:12px;border:1px solid rgba(20,18,24,0.03)}\\n    .bio{font-size:15px}\\n    .credentials{margin-top:12px;color:var(--muted);font-weight:700}\\n    .social-proof{display:flex;gap:12px;margin-top:12px}\\n    .chip{background:linear-gradient(90deg,#fff,#faf7ff);padding:8px;border-radius:10px}\\n    .process{display:flex;flex-direction:column;gap:8px;margin-top:12px}\\n    .faq details{margin-top:8px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;background:var(--accent);color:white;border-radius:10px;text-decoration:none}\\n    .pattern{position:fixed;left:-80px;bottom:-60px;opacity:0.08;width:460px;height:460px;pointer-events:none}\\n    @media(max-width:800px){.grid{grid-template-columns:1fr}.pattern{left:-40px;bottom:-20px;width:300px;height:300px}}\\n  </style>\\n</head>\\n<body>\\n  <svg class='pattern' viewBox='0 0 600 600' xmlns='http://www.w3.org/2000/svg'>\\n    <defs>\\n      <radialGradient id='rg' cx='30%' cy='30%'>\\n        <stop offset='0%' stop-color='#f4e9ff' />\\n        <stop offset='100%' stop-color='#fff' />\\n      </radialGradient>\\n    </defs>\\n    <rect width='100%' height='100%' fill='url(#rg)' rx='40'/>\\n    <g fill='rgba(123,94,166,0.12)'>\\n      <rect x='40' y='60' width='140' height='140' rx='20' />\\n      <circle cx='420' cy='120' r='90' />\\n      <rect x='200' y='320' width='220' height='90' rx='18' />\\n    </g>\\n  </svg>\\n\\n  <div class='wrap'>\\n    <header>\\n      <div style='font-weight:800;color:var(--accent)'>{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href='index.html'>Intro</a>\\n        <a href='services.html'>Services</a>\\n        <a href='conditions.html'>Issues</a>\\n        <a href='approach.html'>Approach</a>\\n        <a href='pricing.html'>Prices</a>\\n        <a href='book.html'>Reserve</a>\\n      </nav>\\n    </header>\\n\\n    <section class='hero card'>\\n      <h1>Meet {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</h1>\\n      <p class='lead'>A collaborative guide for people who want practical, sustainable health changes — balanced with curiosity, science, and attention to the whole person.</p>\\n      <div class='social-proof'>\\n        <div class='chip'>\\\"Kind, clear, and realistic.\\\" — E.M.</div>\\n        <div class='chip'>\\\"Helped me sleep better without extremes.\\\" — R.S.</div>\\n      </div>\\n    </section>\\n\\n    <div class='grid'>\\n      <div class='card bio'>\\n        <h3>Philosophy</h3>\\n        <p>I help people bring simple, evidence-informed practices into their daily lives. My work centers on education, small experiments, and systems thinking — sleep, digestion, movement, stress, and community all matter. I do not sell quick-fixes; instead I guide steady progress.</p>\\n\\n        <h3 style='margin-top:14px'>Background</h3>\\n        <p class='small'>Years of training in integrative approaches plus clinical experience working with people managing stress, sleep disruption, digestive concerns, and chronic inflammation. I collaborate with your existing providers when helpful.</p>\\n\\n        <div class='credentials'>{{PRACTITIONER_NAME}} • {{CREDENTIALS}}</div>\\n\\n        <div style='margin-top:12px'>\\n          <a class='cta' href='book.html'>Schedule a Meet & Greet</a>\\n        </div>\\n      </div>\\n\\n      <aside class='card'>\\n        <h4>Quick facts</h4>\\n        <ul style='color:var(--muted)'>\\n          <li>Approach: Whole-person & collaborative</li>\\n          <li>Primary focus: Education, habit-building, optional labs</li>\\n          <li>Serving: {{CITY}}, {{STATE}}</li>\\n        </ul>\\n\\n        <div style='margin-top:12px'>\\n          <h4>What to expect</h4>\\n          <div class='process'>\\n            <div><strong>Intake:</strong> 60–90 minutes</div>\\n            <div><strong>Plan:</strong> Tailored goals and education</div>\\n            <div><strong>Follow-up:</strong> Focused visits & adjustments</div>\\n          </div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style='margin-top:18px'>\\n      <h3>Frequently asked</h3>\\n      <div class='faq'>\\n        <details>\\n          <summary>Will you order tests?</summary>\\n          <div class='small'>Sometimes. Tests are optional and used as tools to clarify questions. They are explained in plain language and framed within a plan.</div>\\n        </details>\\n        <details>\\n          <summary>Is this medical care?</summary>\\n          <div class='small'>We provide integrative care and education. For urgent medical needs or emergencies, please contact primary care or emergency services. We coordinate with your medical team as needed.</div>\\n        </details>\\n      </div>\\n    </section>\\n\\n    <section style='margin-top:20px' class='card'>\\n      <h3>Want a short orientation?</h3>\\n      <p class='small'>Sign up for a free, 15-minute clarity call to make sure this is the right fit.</p>\\n      <form onsubmit='event.preventDefault();alert(\\\"Thanks — we'll reach out at \\\" + (this.email.value||\\\"your email\\\"));'>\\n        <input name='email' placeholder='Email' style='padding:10px;border-radius:8px;border:1px solid #eee;width:60%' required />\\n        <button class='cta' style='margin-left:8px'>Get the 15-min call</button>\\n      </form>\\n    </section>\\n\\n    <footer style='margin-top:18px;color:var(--muted);text-align:center'>\\n      <div>{{BUSINESS_NAME}} • {{PHONE}} • <a href='mailto:{{EMAIL}}' style='color:var(--muted);text-decoration:none'>{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'/>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'/>\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f7fffd;--accent:#0b7285;--muted:#475d66;--card:#ffffff;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg),#f1fbfa);color:#07323a}\\n    .wrap{max-width:900px;margin:0 auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .hero{padding:18px;border-radius:12px;background:linear-gradient(90deg,rgba(11,114,133,0.06),#fff);display:flex;justify-content:space-between;align-items:center}\\n    .hero h1{margin:0;font-size:24px}\\n    .book-card{margin-top:18px;background:var(--card);padding:18px;border-radius:12px;border:1px solid rgba(7,50,58,0.04)}\\n    label{display:block;margin-top:10px;font-weight:700}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6f0ef;margin-top:6px}\\n    .row{display:flex;gap:12px}\\n    .row > *{flex:1}\\n    .note{font-size:13px;color:var(--muted);margin-top:8px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none}\\n    .social{margin-top:12px;color:var(--muted)}\\n    .faq{margin-top:18px}\\n    .pattern{position:fixed;right:-50px;bottom:-50px;opacity:0.08;width:420px;height:420px;pointer-events:none}\\n    @media(max-width:700px){.row{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <svg class='pattern' viewBox='0 0 600 600' xmlns='http://www.w3.org/2000/svg'>\\n    <defs>\\n      <linearGradient id='lg2' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#e6fffb'/>\\n        <stop offset='1' stop-color='#ffffff'/>\\n      </linearGradient>\\n    </defs>\\n    <rect width='100%' height='100%' fill='url(#lg2)' rx='40'/>\\n    <g fill='rgba(11,114,133,0.14)'>\\n      <path d='M80 120c40 0 60-40 120-40s80 40 120 40 60-40 120-40v360H80V120z' />\\n    </g>\\n  </svg>\\n\\n  <div class='wrap'>\\n    <header>\\n      <div style='font-weight:800;color:var(--accent)'>{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href='index.html'>Home</a>\\n        <a href='services.html'>Care</a>\\n        <a href='pricing.html'>Plans</a>\\n        <a href='about.html'>About</a>\\n        <a href='contact.html'>Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class='hero'>\\n      <div>\\n        <h1>Book a consultation</h1>\\n        <div class='note'>Choose a time to talk through your goals. We'll review what's helpful, what to test, and map a realistic first step.</div>\\n      </div>\\n      <div>\\n        <div style='text-align:right'>\\n          <div style='font-weight:800'>{{PRACTITIONER_NAME}}</div>\\n          <div style='color:var(--muted);font-size:13px'>{{CREDENTIALS}}</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class='book-card'>\\n      <form onsubmit='event.preventDefault();alert(\\\"Thanks — we\\\\'ll contact you at \\\" + (this.email.value||\\\"your email\\\") + \\\" to finalize scheduling.\\\");'>\\n        <label for='name'>Full name</label>\\n        <input id='name' name='name' required />\\n\\n        <div class='row'>\\n          <div>\\n            <label for='email'>Email</label>\\n            <input id='email' name='email' type='email' required />\\n          </div>\\n          <div>\\n            <label for='phone'>Phone</label>\\n            <input id='phone' name='phone' type='tel' />\\n          </div>\\n        </div>\\n\\n        <label for='reason'>What would you like help with?</label>\\n        <select id='reason' name='reason'>\\n          <option>Sleep & energy</option>\\n          <option>Stress & resilience</option>\\n          <option>Digestion & gut health</option>\\n          <option>Inflammation & pain</option>\\n          <option>General wellness review</option>\\n        </select>\\n\\n        <label for='notes'>Notes or questions (optional)</label>\\n        <textarea id='notes' name='notes' rows='4' placeholder='Any relevant history, medications, or preferences'></textarea>\\n\\n        <div style='display:flex;gap:12px;align-items:center;margin-top:12px'>\\n          <div style='flex:1'>\\n            <label for='type'>Visit type</label>\\n            <select id='type' name='type'>\\n              <option>Intake (60–90 min)</option>\\n              <option>Follow-up (30 min)</option>\\n              <option>15-min clarity call</option>\\n            </select>\\n          </div>\\n          <div style='flex:1'>\\n            <label for='time'>Preferred dates</label>\\n            <input id='time' name='time' placeholder='e.g. Tuesdays, mornings' />\\n          </div>\\n        </div>\\n\\n        <div class='note'>Note: For urgent medical concerns, please call your provider or emergency services. We use optional testing only as an educational aid.</div>\\n\\n        <button class='cta' type='submit'>Request booking</button>\\n      </form>\\n\\n      <div style='margin-top:18px'>\\n        <h4>What happens next?</h4>\\n        <ol style='color:var(--muted)'>\\n          <li>We review your form and check availability.</li>\\n          <li>A coordinator confirms the appointment and sends a short intake packet.</li>\\n          <li>You choose an online or in-person visit at the time of booking.</li>\\n        </ol>\\n      </div>\\n\\n      <div style='margin-top:16px;color:var(--muted)'>\\n        <strong>Questions?</strong> Email <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a> or call {{PHONE}}.\\n      </div>\\n    </section>\\n\\n    <section class='faq'>\\n      <h4>Quick FAQs</h4>\\n      <details>\\n        <summary>Do you take insurance?</summary>\\n        <div class='note'>We provide statements for potential reimbursement but do not bill insurers directly. Coverage varies by plan.</div>\\n      </details>\\n      <details>\\n        <summary>Are results guaranteed?</summary>\\n        <div class='note'>No. We emphasize education and gradual change. Individual outcomes vary.</div>\\n      </details>\\n    </section>\\n\\n    <footer style='margin-top:20px;color:var(--muted);text-align:center'>\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href='tel:{{PHONE}}' style='color:var(--muted);text-decoration:none'>{{PHONE}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
