          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Integrative services blending clinical evidence and whole-person care. Initial visits, follow-ups, nutrition, herbal options, and mind-body supports.\\\">\\n  <style>\\n    :root{--bg:#f6fbfb;--card:#ffffff;--muted:#6b7280;--accent1:#006c6a;--accent2:#00a896;--accent3:#f7b267;--glass:rgba(255,255,255,0.6);--radius:14px;--max:1100px}\\n    *{box-sizing:border-box}\\n    html,body{height:100%;margin:0;font-family:Inter, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;color:#0f172a;background:linear-gradient(180deg,var(--bg),#eaf7f6);-webkit-font-smoothing:antialiased}\\n    .site{min-height:100vh;display:flex;flex-direction:column}\\n    header{position:relative;padding:28px 20px;max-width:var(--max);margin:0 auto;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;align-items:center;gap:14px}\\n    .logo{width:58px;height:58px;border-radius:12px;background:linear-gradient(135deg,var(--accent1),var(--accent2));display:flex;align-items:center;justify-content:center;color:white;font-weight:700;box-shadow:0 6px 18px rgba(0,102,102,0.12)}\\n    nav ul{display:flex;gap:14px;list-style:none;margin:0;padding:0}\\n    nav a{color:#06343a;text-decoration:none;padding:8px 12px;border-radius:10px;font-weight:600}\\n    nav a:hover{background:rgba(0,164,150,0.08)}\\n    .hero{max-width:var(--max);margin:14px auto;padding:40px;border-radius:20px;background:linear-gradient(180deg,rgba(255,255,255,0.7),rgba(255,255,255,0.6));backdrop-filter:blur(6px);position:relative;overflow:hidden}\\n    .hero-grid{display:grid;grid-template-columns:1fr 340px;gap:28px;align-items:start}\\n    .intro h1{margin:0 0 12px 0;font-size:28px;color: #06343a}\\n    .intro p{margin:0;color:var(--muted);line-height:1.5}\\n    .cta-row{margin-top:18px;display:flex;gap:12px}\\n    .btn{background:var(--accent2);color:#fff;padding:12px 16px;border-radius:12px;text-decoration:none;font-weight:700}\\n    .btn.secondary{background:transparent;color:var(--accent1);border:2px solid rgba(0,108,106,0.08)}\\n    .card{background:var(--card);padding:18px;border-radius:14px;box-shadow:0 8px 30px rgba(2,6,23,0.06)}\\n    .services-list{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}\\n    .service{padding:14px;border-radius:12px;background:linear-gradient(180deg,#ffffff,#fbffff);border:1px solid rgba(2,6,23,0.04)}\\n    .service h4{margin:0 0 6px 0;color:#064a49}\\n    .service p{margin:0;color:var(--muted);font-size:14px}\\n    .small{font-size:13px;color:var(--muted)}\\n    footer{max-width:var(--max);margin:26px auto;padding:18px 20px;border-radius:12px;background:transparent;display:flex;justify-content:space-between;align-items:center;color:var(--muted)}\\n    .pattern-wrap{position:absolute;inset:0;pointer-events:none;opacity:0.28}\\n    .meta{font-size:13px;color:var(--muted)}\\n    .faq{margin-top:22px;display:grid;gap:10px}\\n    details{background:linear-gradient(180deg,#fff,#fcffff);padding:12px;border-radius:10px;border:1px solid rgba(2,6,23,0.03)}\\n    @media (max-width:880px){.hero-grid{grid-template-columns:1fr}.services-list{grid-template-columns:1fr}.brand .logo{width:46px;height:46px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">HM</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <ul>\\n          <li><a href=\\\"index.html\\\">Home</a></li>\\n          <li><a href=\\\"services.html\\\">Offerings</a></li>\\n          <li><a href=\\\"conditions.html\\\">Concerns</a></li>\\n          <li><a href=\\\"approach.html\\\">How We Work</a></li>\\n          <li><a href=\\\"pricing.html\\\">Fees</a></li>\\n          <li><a href=\\\"book.html\\\">Book</a></li>\\n        </ul>\\n      </nav>\\n    </header>\\n\\n    <main style=\\\"flex:1\\\">\\n      <section class=\\\"hero\\\">\\n        <div class=\\\"pattern-wrap\\\" aria-hidden>\\n          <svg width=\\\"100%\\\" height=\\\"100%\\\" viewBox=\\\"0 0 800 400\\\" preserveAspectRatio=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n            <defs>\\n              <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n                <stop offset=\\\"0\\\" stop-color=\\\"#e8fbfa\\\"/>\\n                <stop offset=\\\"1\\\" stop-color=\\\"#ffffff\\\"/>\\n              </linearGradient>\\n              <pattern id=\\\"p1\\\" x=\\\"0\\\" y=\\\"0\\\" width=\\\"80\\\" height=\\\"80\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n                <circle cx=\\\"10\\\" cy=\\\"10\\\" r=\\\"2\\\" fill=\\\"#e6fffd\\\" />\\n                <circle cx=\\\"50\\\" cy=\\\"50\\\" r=\\\"2\\\" fill=\\\"#e6fffd\\\" />\\n              </pattern>\\n              <filter id=\\\"blur\\\"><feGaussianBlur stdDeviation=\\\"12\\\" /></filter>\\n            </defs>\\n            <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g1)\\\"/>\\n            <g opacity=\\\"0.9\\\" filter=\\\"url(#blur)\\\">\\n              <circle cx=\\\"110\\\" cy=\\\"220\\\" r=\\\"140\\\" fill=\\\"#b8f0ec\\\"/>\\n              <circle cx=\\\"680\\\" cy=\\\"80\\\" r=\\\"120\\\" fill=\\\"#cff8f5\\\"/>\\n            </g>\\n            <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\" opacity=\\\"0.6\\\"/>\\n          </svg>\\n        </div>\\n\\n        <div class=\\\"hero-grid\\\">\\n          <div class=\\\"intro\\\">\\n            <h1>Thoughtful, evidence-informed care tailored to your life</h1>\\n            <p>We combine clinical reasoning with whole-person approaches — nutrition, botanicals, lifestyle and mind-body skills — to support resilience and sustainable health. Appointments are individualized; we prioritize teaching and practical steps you can use right away.</p>\\n            <div class=\\\"cta-row\\\">\\n              <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n              <a class=\\\"btn secondary\\\" href=\\\"contact.html\\\">Contact {{PRACTITIONER_NAME}}</a>\\n            </div>\\n            <div style=\\\"margin-top:12px;color:var(--muted);font-size:13px\\\">Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n          </div>\\n\\n          <aside class=\\\"card\\\">\\n            <div style=\\\"font-size:14px;font-weight:700;color:#073d3c\\\">Quick snapshot</div>\\n            <div class=\\\"meta\\\" style=\\\"margin-top:8px\\\">Initial visit: 60–90 min • Follow-ups: 30–45 min • Telehealth & in-person</div>\\n            <div style=\\\"margin-top:12px;font-size:13px;color:var(--muted)\\\">Practitioner: {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n            <div style=\\\"margin-top:14px;display:flex;gap:8px\\\">\\n              <a class=\\\"btn\\\" href=\\\"book.html\\\">Schedule</a>\\n              <a class=\\\"btn secondary\\\" href=\\\"about.html\\\">Meet the team</a>\\n            </div>\\n          </aside>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"max-width:var(--max);margin:20px auto;padding:0 20px\\\">\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0;color:#043a39\\\">Offerings — practical supports for daily life</h3>\\n          <p class=\\\"small\\\">Descriptions below are educational and meant to help you choose a service. A treatment plan is created collaboratively; results vary and no cure is guaranteed.</p>\\n\\n          <div class=\\\"services-list\\\" style=\\\"margin-top:14px\\\">\\n            <div class=\\\"service\\\">\\n              <h4>Comprehensive Initial Visit</h4>\\n              <p>In-depth intake and health history, personalized plan emphasizing lifestyle, nutrition, and targeted supports.</p>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <h4>Follow-up & Plan Optimization</h4>\\n              <p>Progress review, lab interpretation (if ordered), adjustments to supplements or lifestyle prescriptions.</p>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <h4>Integrative Nutrition Counseling</h4>\\n              <p>Whole-food strategies for digestive health, energy, and inflammation reduction with practical meal suggestions.</p>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <h4>Herbal & Botanical Guidance</h4>\\n              <p>Evidence-informed discussions about botanicals, interactions, and safe use as part of a broader plan.</p>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <h4>Mind-Body Skills & Stress Resilience</h4>\\n              <p>Breathwork, guided practices, and lifestyle tools to support sleep and stress regulation.</p>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <h4>Lab Review & Interpretation</h4>\\n              <p>Educational review of relevant labs (blood, metabolic, nutrient markers) to inform a personalized approach.</p>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:16px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px\\\">\\n            <div class=\\\"small\\\">Want a tailored cost estimate? See <a href=\\\"pricing.html\\\">Fees & Packages</a>.</div>\\n            <div>\\n              <a class=\\\"btn\\\" href=\\\"book.html\\\">Book an initial visit</a>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"display:flex;gap:16px;margin-top:18px;flex-wrap:wrap\\\">\\n          <div class=\\\"card\\\" style=\\\"flex:1;min-width:240px\\\">\\n            <h4 style=\\\"margin-top:0;color:#064a49\\\">Session Ritual</h4>\\n            <p class=\\\"small\\\">Visits begin with a focused intake, listening to what matters most to you. We aim to provide clear teaching, one to three practical actions you can implement, and a plan for follow-up. Herbal or supplement recommendations are offered with safety in mind and documented interactions considered.</p>\\n          </div>\\n\\n          <div class=\\\"card\\\" style=\\\"flex:1;min-width:240px\\\">\\n            <h4 style=\\\"margin-top:0;color:#064a49\\\">What to Expect</h4>\\n            <p class=\\\"small\\\">You will receive an individualized plan with priorities, expected timelines, and educational resources. We emphasize realistic, sustainable steps and measure progress over time.</p>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h4 style=\\\"margin-top:0;color:#043a39\\\">Common questions</h4>\\n          <div class=\\\"faq\\\" style=\\\"margin-top:8px\\\">\\n            <details><summary style=\\\"font-weight:700\\\">Do you accept insurance?</summary><div class=\\\"small\\\">We provide superbills for many plans; direct billing varies. Check with your insurer for coverage details.</div></details>\\n            <details><summary style=\\\"font-weight:700\\\">Are herbal medicines safe?</summary><div class=\\\"small\\\">Herbals can be supportive but may interact with medications. We discuss safety and monitor changes. Recommendations are educational and individualized.</div></details>\\n            <details><summary style=\\\"font-weight:700\\\">Can I bring my labs?</summary><div class=\\\"small\\\">Yes — sharing recent labs helps. We can recommend targeted tests when clinically appropriate.</div></details>\\n          </div>\\n        </div>\\n      </section>\\n    </main>\\n\\n    <footer>\\n      <div class=\\\"meta\\\">© {{BUSINESS_NAME}} • Serving {{CITY}}, {{STATE}}</div>\\n      <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n        <div class=\\\"meta\\\">Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n        <a href=\\\"contact.html\\\" style=\\\"color:var(--accent1);text-decoration:none;font-weight:700\\\">Connect</a>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"}  \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Common Concerns — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Common health concerns often addressed in integrative care: stress, sleep, digestion, chronic inflammation, and low energy. Educational guidance and collaborative plans.\\\">\\n  <style>\\n    :root{--bg:#fffbf9;--muted:#5b6368;--accent:#0b6b66;--card:#ffffff;--radius:12px;--max:1000px}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;color:#062e2c;background:linear-gradient(180deg,#ffffff,var(--bg))}\\n    .wrap{max-width:var(--max);margin:28px auto;padding:18px}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}\\n    header .brand{font-weight:800;color:var(--accent)}\\n    nav a{margin-left:14px;color:#093634;text-decoration:none;font-weight:600}\\n    .hero{background:linear-gradient(90deg,#eaf9f7,rgba(255,255,255,0.9));padding:20px;border-radius:14px}\\n    .hero h1{margin:0;color:#053a39}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:16px}\\n    .card{background:var(--card);padding:16px;border-radius:12px;border:1px solid rgba(4,20,15,0.04)}\\n    .concern{display:flex;gap:12px;align-items:flex-start}\\n    .badge{width:58px;height:58px;border-radius:10px;background:linear-gradient(135deg,#e7fffb,#d7fff8);display:flex;align-items:center;justify-content:center;font-weight:700;color:#03504d}\\n    .concern h3{margin:0 0 6px 0}\\n    .muted{color:var(--muted);font-size:14px}\\n    .disclaimer{margin-top:12px;padding:12px;border-radius:10px;background:linear-gradient(180deg,#fff,#fcfffd);font-size:13px;color:var(--muted)}\\n    footer{margin-top:28px;color:var(--muted);display:flex;justify-content:space-between;align-items:center}\\n    @media (max-width:900px){.grid{grid-template-columns:1fr}.badge{width:48px;height:48px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"approach.html\\\">Method</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <h1>Concerns we commonly support</h1>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">The guidance provided is educational. Our focus is on improving function and quality of life through individualized plans; outcomes vary and no specific cure is promised.</p>\\n    </section>\\n\\n    <div class=\\\"grid\\\">\\n      <div>\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"badge\\\">ST</div>\\n            <div>\\n              <h3>Stress & Anxiety</h3>\\n              <div class=\\\"muted\\\">Practical mind-body strategies, breathwork, and lifestyle adjustments to support nervous system regulation. We teach skills you can use between visits and may include targeted supplements or herbs when appropriate.</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"badge\\\">SL</div>\\n            <div>\\n              <h3>Poor Sleep</h3>\\n              <div class=\\\"muted\\\">Behavioral framing, sleep hygiene, and tailored approaches to improve sleep quality. Where helpful, short-term supports and education about sleep physiology are provided.</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"badge\\\">DG</div>\\n            <div>\\n              <h3>Digestive Symptoms</h3>\\n              <div class=\\\"muted\\\">We look at diet patterns, microbiome-supportive strategies, and targeted interventions. Testing can be discussed to clarify causes when clinically warranted.</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"badge\\\">IN</div>\\n            <div>\\n              <h3>Chronic Inflammation</h3>\\n              <div class=\\\"muted\\\">Lifestyle, dietary shifts, and anti-inflammatory practices aimed at lowering systemic triggers. Plans are individualized; inflammatory markers may be monitored with appropriate testing.</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"badge\\\">EN</div>\\n            <div>\\n              <h3>Low Energy & Fatigue</h3>\\n              <div class=\\\"muted\\\">We assess sleep, nutrition, stress load, and relevant labs. Recommendations focus on restoring rhythms, nutrient support, and graded activity.</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin-top:0;color:#053a39\\\">A careful note on expectations</h4>\\n          <div class=\\\"disclaimer\\\">Our approach is educational and collaborative. We do not offer guaranteed cures. Clinical progress depends on many factors including adherence, underlying conditions, and access to resources. Recommendations may include lifestyle change, dietary shifts, monitored supplements, and occasionally laboratory testing. Any tests or botanicals discussed are optional and chosen with safety in mind.</div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin-top:0;color:#053a39\\\">When to seek urgent care</h4>\\n          <p class=\\\"muted\\\">For sudden or severe symptoms (chest pain, shortness of breath, severe abdominal pain, neurological changes), contact emergency services or your primary care provider immediately. Our services are for ongoing, non-emergent care and education.</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin-top:0;color:#053a39\\\">Next steps</h4>\\n          <p class=\\\"muted\\\">If a concern resonates, book an initial visit to review history and create a practical plan. We welcome shared decision-making and respect existing treatment plans from other clinicians.</p>\\n          <div style=\\\"margin-top:10px\\\"><a href=\\\"book.html\\\" style=\\\"display:inline-block;padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none;font-weight:700\\\">Schedule a visit</a></div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"}  \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Our Approach — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"How we assess, plan, and follow up: intake, collaborative planning, optional educational labs, and ongoing support to build sustainable health habits.\\\">\\n  <style>\\n    :root{--bg:#f3fbf9;--accent:#00766e;--muted:#576169;--card:#fff;--radius:14px;--max:1050px}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;background:linear-gradient(180deg,#ffffff,var(--bg));color:#042f2e}\\n    .container{max-width:var(--max);margin:28px auto;padding:18px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:12px;color:#044c4a;text-decoration:none;font-weight:600}\\n    .lead{background:linear-gradient(90deg,#e9f9f8,#ffffff);padding:18px;border-radius:14px;margin-top:12px}\\n    .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:14px}\\n    .step{background:var(--card);padding:16px;border-radius:12px;border:1px solid rgba(2,6,23,0.03)}\\n    .step h4{margin:0 0 8px 0;color:var(--accent)}\\n    .note{margin-top:12px;font-size:13px;color:var(--muted)}\\n    .labs{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px}\\n    .lab{background:linear-gradient(180deg,#fff,#fbfffe);padding:10px;border-radius:10px;border:1px solid rgba(3,60,57,0.04)}\\n    .cta{margin-top:18px}\\n    footer{margin-top:26px;color:var(--muted);display:flex;justify-content:space-between}\\n    @media (max-width:900px){.steps{grid-template-columns:1fr}.labs{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"font-weight:800;color:var(--accent)\\\">{{BUSINESS_NAME}}</div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Back</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"conditions.html\\\">Concerns</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"lead\\\">\\n      <h1 style=\\\"margin:0;color:#054c4a\\\">A clear framework for personalized, integrative care</h1>\\n      <p class=\\\"note\\\">Our model combines clinical assessment with practical lifestyle, nutritional, and supportive interventions. We emphasize education, shared decision-making, and measurable steps. Lab testing is optional and used as an educational tool when it will inform care.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"steps\\\">\\n        <div class=\\\"step\\\">\\n          <h4>1. Intake & Listening</h4>\\n          <div class=\\\"note\\\">Extended initial visit to gather history, goals, and priorities. We review current treatments and identify immediate, safe steps you can take.</div>\\n        </div>\\n\\n        <div class=\\\"step\\\">\\n          <h4>2. Collaborative Plan</h4>\\n          <div class=\\\"note\\\">We co-create a realistic plan with 1–3 priority actions: dietary adjustments, movement, sleep strategies, and targeted botanical or supplement options when appropriate.</div>\\n        </div>\\n\\n        <div class=\\\"step\\\">\\n          <h4>3. Support & Follow-up</h4>\\n          <div class=\\\"note\\\">Follow-ups focus on troubleshooting, education, and gradual progress. Plans are adjusted based on response and new information.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:16px\\\">\\n      <h3 style=\\\"margin:0;color:#054c4a\\\">Educational testing — when and why</h3>\\n      <p class=\\\"note\\\">We sometimes recommend targeted labs to clarify causes or to guide nutrient supports. Testing is always optional and chosen to add actionable information. Examples include metabolic panels, thyroid, nutrient markers, and targeted inflammatory markers.</p>\\n\\n      <div class=\\\"labs\\\">\\n        <div class=\\\"lab\\\"><strong>Metabolic & CBC</strong><div class=\\\"note\\\">Baseline health and red flags</div></div>\\n        <div class=\\\"lab\\\"><strong>Thyroid panel</strong><div class=\\\"note\\\">Energy, weight changes, or hair loss</div></div>\\n        <div class=\\\"lab\\\"><strong>Inflammatory markers</strong><div class=\\\"note\\\">Persistent pain or systemic inflammation</div></div>\\n        <div class=\\\"lab\\\"><strong>Nutrient testing</strong><div class=\\\"note\\\">Targeted nutrients when deficiency is suspected</div></div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0;color:#054c4a\\\">Safety & coordination of care</h3>\\n      <p class=\\\"note\\\">We review current prescriptions and coordinate with other providers as needed. Herbal and supplement recommendations consider possible interactions and are introduced cautiously. Our priority is patient safety and integrative collaboration.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0;color:#054c4a\\\">How progress is measured</h3>\\n      <p class=\\\"note\\\">We set practical goals and track symptoms, functional markers (sleep, energy, digestion), and occasionally lab trends. Progress is framed in achievable milestones rather than promises of cure.</p>\\n    </section>\\n\\n    <div class=\\\"cta\\\">\\n      <a href=\\\"book.html\\\" style=\\\"padding:12px 16px;background:var(--accent);color:#fff;border-radius:12px;text-decoration:none;font-weight:700\\\">Start with an initial visit</a>\\n      <a href=\\\"contact.html\\\" style=\\\"padding:12px 12px;margin-left:12px;color:var(--accent);text-decoration:none;font-weight:700\\\">Ask a question</a>\\n    </div>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n      <div style=\\\"color:var(--muted)\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"}  \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
