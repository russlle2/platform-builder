          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Integrative services that support whole-person wellness. Educational, personalized, and evidence-aware.\\\">\\n  <style>\\n    :root{--bg1:#0f1724;--accent:#7be0c9;--muted:#9aa6b2;--panel:#0b1220;--glass:rgba(255,255,255,0.03)}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#e6eef0;background:linear-gradient(180deg,var(--bg1),#051426);-webkit-font-smoothing:antialiased}\\n    /* Unique SVG pattern encoded as data URI (assets/img/pattern.svg conceptual) */\\n    body::before{content:\\\"\\\";position:fixed;inset:0;z-index:0;opacity:0.22;background-image:url('data:image/svg+xml;utf8,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"600\\\" height=\\\"600\\\"><defs><linearGradient id=\\\"g\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"rgba(123,224,201,0.12)\\\"/><stop offset=\\\"1\\\" stop-color=\\\"rgba(120,132,255,0.06)\\\"/></linearGradient><pattern id=\\\"p\\\" width=\\\"120\\\" height=\\\"120\\\" patternUnits=\\\"userSpaceOnUse\\\"><rect width=\\\"120\\\" height=\\\"120\\\" fill=\\\"transparent\\\"/><g fill=\\\"none\\\" stroke=\\\"rgba(255,255,255,0.02)\\\" stroke-width=\\\"1\\\"><path d=\\\"M0 60 Q60 0 120 60\\\"/><path d=\\\"M0 120 Q60 60 120 120\\\"/></g></pattern></defs><rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(%23p)\\\"/><rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(%23g)\\\" opacity=\\\"0.6\\\"/></svg>');background-size:cover;mix-blend-mode:screen}\\n    .wrap{position:relative;z-index:1;max-width:1100px;margin:40px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between;gap:18px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#7b8dff);display:flex;align-items:center;justify-content:center;color:#052028;font-weight:700;box-shadow:0 6px 18px rgba(11,18,32,0.6)}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 10px}\\n    nav a.cta{background:linear-gradient(90deg,var(--accent),#8aa0ff);color:#072026;padding:10px 14px;border-radius:10px}\\n    main{margin-top:28px;display:grid;grid-template-columns:1fr 360px;gap:28px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:14px;padding:20px;box-shadow:inset 0 1px 0 rgba(255,255,255,0.02),0 8px 30px rgba(3,8,18,0.6)}\\n    .hero{padding:28px;border-radius:14px;background:linear-gradient(135deg,rgba(123,224,201,0.06),rgba(138,160,255,0.04));display:flex;flex-direction:column;gap:8px}\\n    h1{margin:0;color:#dffbf2;font-size:22px}\\n    p.lead{margin:0;color:var(--muted)}\\n    .service-list{display:grid;gap:12px;margin-top:16px}\\n    .service{display:flex;gap:12px;align-items:flex-start}\\n    .icon{width:48px;height:48;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.03),transparent);display:flex;align-items:center;justify-content:center;color:var(--accent);font-weight:700}\\n    h3{margin:0;color:#e9fbf5}\\n    .muted{color:var(--muted);font-size:14px}\\n    aside .panel-title{font-size:13px;color:var(--muted);margin-bottom:8px}\\n    .price-pill{background:var(--glass);padding:8px 12px;border-radius:999px;color:var(--accent);display:inline-block;margin-top:8px}\\n    footer{margin-top:28px;color:var(--muted);font-size:13px}\\n    .btn-primary{display:inline-block;background:linear-gradient(90deg,var(--accent),#8aa0ff);color:#042726;padding:12px 18px;border-radius:12px;text-decoration:none;font-weight:600}\\n    /* responsive */\\n    @media(max-width:900px){main{grid-template-columns:1fr} .wrap{padding:18px} nav{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\"><div class=\\\"logo\\\">HM</div><div><div style=\\\"font-weight:700;color:#e6fff9\\\">{{BUSINESS_NAME}}</div><div class=\\\"muted\\\">A whole-person approach to wellbeing</div></div></div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\" class=\\\"cta\\\">Offerings</a>\\n        <a href=\\\"approach.html\\\">Method</a>\\n        <a href=\\\"conditions.html\\\">Concerns</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"card hero\\\" aria-labelledby=\\\"h1\\\">\\n        <h1 id=\\\"h1\\\">Services that meet you where you are</h1>\\n        <p class=\\\"lead\\\">Personalized consultations, integrative therapies and supportive retail options. We emphasize education, small steps, and measurable progress for sustainable health.</p>\\n\\n        <div class=\\\"service-list\\\">\\n          <div class=\\\"service\\\">\\n            <div class=\\\"icon\\\">C</div>\\n            <div>\\n              <h3>Comprehensive Consultations</h3>\\n              <p class=\\\"muted\\\">Initial intake exploring medical history, lifestyle, stressors and goals. Collaborative care planning — no one-size-fits-all promises.</p>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"service\\\">\\n            <div class=\\\"icon\\\">N</div>\\n            <div>\\n              <h3>Integrative Nutrition Counseling</h3>\\n              <p class=\\\"muted\\\">Evidence-aware dietary guidance tailored to energy, digestion and vitality. Focus on food patterns and practical adjustments.</p>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"service\\\">\\n            <div class=\\\"icon\\\">H</div>\\n            <div>\\n              <h3>Herbal & Supplement Guidance</h3>\\n              <p class=\\\"muted\\\">Educational recommendations for botanicals and supplements as adjuncts. We discuss interactions, quality, and realistic expectations.</p>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"service\\\">\\n            <div class=\\\"icon\\\">M</div>\\n            <div>\\n              <h3>MInd-Body Practices</h3>\\n              <p class=\\\"muted\\\">Breathwork, mindfulness, movement and sleep hygiene strategies to reduce stress and improve resilience.</p>\\n            </div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <aside class=\\\"card\\\">\\n        <div class=\\\"panel-title\\\">Add-on retail + labs</div>\\n        <div class=\\\"muted\\\">High-quality supplements and select educational labs are available as optional additions. Labs are discussed and ordered only when clinically appropriate.</div>\\n        <div class=\\\"price-pill\\\">Starting at $75 — follow-up packages available</div>\\n\\n        <hr style=\\\"margin:18px 0;border:none;border-top:1px solid rgba(255,255,255,0.03)\\\">\\n        <div>\\n          <div style=\\\"font-weight:700;color:#e6fff9\\\">Why choose a tailored plan?</div>\\n          <p class=\\\"muted\\\">We synthesize traditional wisdom and modern evidence to support your unique needs. No cures promised — only education, partnership, and measurable steps forward.</p>\\n        </div>\\n\\n        <div style=\\\"margin-top:16px;text-align:center\\\">\\n          <a href=\\\"book.html\\\" class=\\\"btn-primary\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:22px\\\">\\n      <h3 style=\\\"margin-top:0;color:#dffbf2\\\">A note on safety and outcomes</h3>\\n      <p class=\\\"muted\\\">Holistic care supports the whole person. We do not promise cures. Services are educational and supportive; they complement, not replace, conventional medical care. Always inform your primary provider about supplements or lab testing.</p>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;gap:12px;align-items:center\\\">\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n          <div class=\\\"muted\\\">Serving {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n        </div>\\n        <div class=\\\"muted\\\">© {{BUSINESS_NAME}} — informational care & guidance. Not a substitute for emergency services.</div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Common Concerns — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Areas of focus for integrative care: stress, sleep, digestion, inflammation, and energy — educational guidance and whole-person support.\\\">\\n  <style>\\n    :root{--bg:#071428;--accent:#ffd6a5;--soft:#b9c3d0}\\n    html,body{height:100%;margin:0;background:radial-gradient(1200px 600px at 10% 10%,rgba(255,214,165,0.06),transparent),linear-gradient(180deg,#041020,#071428);font-family:Inter,system-ui,Segoe UI,Roboto,Arial;color:#eef6f4}\\n    /* Different unique SVG background pattern (conceptual assets/img/pattern.svg) */\\n    header::after{content:\\\"\\\";position:fixed;inset:0;z-index:0;opacity:0.18;background-image:url('data:image/svg+xml;utf8,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"600\\\" height=\\\"600\\\"><defs><pattern id=\\\"q\\\" width=\\\"80\\\" height=\\\"80\\\" patternUnits=\\\"userSpaceOnUse\\\"><circle cx=\\\"10\\\" cy=\\\"10\\\" r=\\\"2\\\" fill=\\\"rgba(255,214,165,0.08)\\\"/><circle cx=\\\"50\\\" cy=\\\"50\\\" r=\\\"2\\\" fill=\\\"rgba(170,190,255,0.06)\\\"/></pattern></defs><rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(%23q)\\\"/></svg>');background-size:cover}\\n    .container{position:relative;z-index:1;max-width:1000px;margin:36px auto;padding:22px}\\n    nav{display:flex;gap:16px;align-items:center;justify-content:space-between}\\n    .links a{color:var(--soft);text-decoration:none}\\n    .hero{background:linear-gradient(135deg,rgba(255,214,165,0.04),rgba(170,190,255,0.03));padding:20px;border-radius:12px}\\n    h1{margin:0;color:#fff}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:16px}\\n    .cond{background:rgba(255,255,255,0.02);padding:14px;border-radius:10px}\\n    .cond h3{margin:0 0 6px 0;color:#fff}\\n    .muted{color:var(--soft);font-size:14px}\\n    .disclaimer{margin-top:16px;background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;color:var(--soft)}\\n    .cta-row{display:flex;gap:12px;align-items:center;margin-top:14px}\\n    .btn{background:linear-gradient(90deg,#ffd6a5,#c3d1ff);color:#071428;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    @media(max-width:800px){.grid{grid-template-columns:1fr}nav{flex-direction:column;align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <nav>\\n      <div style=\\\"display:flex;gap:12px;align-items:center\\\"><div style=\\\"width:56px;height:56;border-radius:10px;background:linear-gradient(135deg,#ffd6a5,#c3d1ff);display:flex;align-items:center;justify-content:center;font-weight:800;color:#052026\\\">HM</div><div><div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div><div class=\\\"muted\\\">Integrative, educational care</div></div></div>\\n      <div class=\\\"links\\\"><a href=\\\"index.html\\\">Return</a> • <a href=\\\"services.html\\\">Offerings</a> • <a href=\\\"book.html\\\">Schedule</a></div>\\n    </nav>\\n\\n    <section class=\\\"hero\\\">\\n      <h1>What people often seek help for</h1>\\n      <p class=\\\"muted\\\">Below are common concerns we address with whole-person assessment, lifestyle approaches, and optional adjuncts. This content is informational — not a substitute for medical diagnosis or emergency care.</p>\\n    </section>\\n\\n    <section class=\\\"grid\\\">\\n      <div class=\\\"cond\\\">\\n        <h3>Stress & Anxiety</h3>\\n        <p class=\\\"muted\\\">Chronic stress impacts sleep, digestion and immunity. We offer breathwork, behavioral tools, and routines to shift nervous system balance. Strategies are individualized and educational.</p>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Typical focus: daily habits, cognitive reframing, resilience practices.</div>\\n      </div>\\n\\n      <div class=\\\"cond\\\">\\n        <h3>Poor Sleep & Fatigue</h3>\\n        <p class=\\\"muted\\\">Sleep hygiene, circadian cues, and gentle evening rituals can improve restorative sleep. We evaluate contributors like stress, diet, and medication interactions.</p>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Typical focus: sleep routines, stimulus control, circadian rhythm alignment.</div>\\n      </div>\\n\\n      <div class=\\\"cond\\\">\\n        <h3>Digestive Troubles</h3>\\n        <p class=\\\"muted\\\">Bloating, irregularity, and intolerance are approached with diet patterns, mindful eating, and selective testing when indicated. Education is emphasized before heavy intervention.</p>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Typical focus: food patterns, anti-inflammatory choices, optional GI-focused labs.</div>\\n      </div>\\n\\n      <div class=\\\"cond\\\">\\n        <h3>Chronic Inflammation</h3>\\n        <p class=\\\"muted\\\">Persistent low-grade inflammation is addressed through nutrition, movement, sleep and stress reduction. We discuss risk factors and evidence-based lifestyle steps.</p>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Typical focus: anti-inflammatory patterns, activity planning, metabolic health.</div>\\n      </div>\\n\\n      <div class=\\\"cond\\\">\\n        <h3>Low Energy & Vitality</h3>\\n        <p class=\\\"muted\\\">Energy is shaped by sleep, nutrition, thyroid and adrenal considerations. We prioritize foundational steps and may recommend targeted assessments when appropriate.</p>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Typical focus: meal timing, restorative practices, lab-informed adjustments.</div>\\n      </div>\\n\\n      <div class=\\\"cond\\\">\\n        <h3>Preventive & Lifestyle Support</h3>\\n        <p class=\\\"muted\\\">For clients wanting to optimize long-term health, we craft educational plans emphasizing sustainability and incremental change.</p>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"disclaimer\\\">\\n      <strong>Important:</strong> The services and suggestions provided are educational and supportive. We do not promise cures. If you are experiencing severe symptoms or an emergency, contact local emergency services right away. Always coordinate integrative care with your primary medical provider, especially when considering supplements or lab testing.\\n    </div>\\n\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:18px;gap:12px\\\">\\n      <div class=\\\"muted\\\">Interested in working on one of these? Start with an in-depth intake so we can tailor a plan.</div>\\n      <div class=\\\"cta-row\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Begin an Intake</a><a class=\\\"muted\\\" href=\\\"approach.html\\\">How we work</a></div>\\n    </div>\\n\\n    <footer style=\\\"margin-top:22px;color:var(--soft)\\\">Practitioner: {{PRACTITIONER_NAME}}, {{CREDENTIALS}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--soft)\\\">{{EMAIL}}</a> • {{CITY}}, {{STATE}}</footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Our Approach — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"A stepwise, educational intake and follow-up process emphasizing measurement, optional labs, and collaborative decision-making.\\\">\\n  <style>\\n    :root{--bg:#02121b;--card:#071a24;--accent1:#9be7ff;--accent2:#b8ffd3;--muted:#9fb2bd}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,#02121b,#071a24);font-family:Inter,system-ui,Roboto,Arial;color:#e8fbf8}\\n    /* Another distinct SVG motif inline */\\n    .bg-svg{position:fixed;inset:0;z-index:0;opacity:0.14;background-image:url('data:image/svg+xml;utf8,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"800\\\" height=\\\"800\\\"><defs><pattern id=\\\"r\\\" width=\\\"160\\\" height=\\\"160\\\" patternUnits=\\\"userSpaceOnUse\\\"><rect width=\\\"80\\\" height=\\\"80\\\" fill=\\\"rgba(155,231,255,0.04)\\\"/><rect x=\\\"80\\\" y=\\\"80\\\" width=\\\"80\\\" height=\\\"80\\\" fill=\\\"rgba(184,255,211,0.03)\\\"/></pattern></defs><rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(%23r)\\\"/></svg>');background-size:cover}\\n    .shell{position:relative;z-index:1;max-width:980px;margin:40px auto;padding:22px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:12px}\\n    .lead{background:linear-gradient(135deg,rgba(155,231,255,0.04),rgba(184,255,211,0.03));padding:16px;border-radius:12px}\\n    h1{margin:0;color:#dff7f3}\\n    .steps{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}\\n    .step{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:14px;border-radius:10px}\\n    .step h3{margin:0 0 6px 0;color:#e9fbf5}\\n    .muted{color:var(--muted);font-size:14px}\\n    .notes{margin-top:12px;background:rgba(255,255,255,0.02);padding:12px;border-radius:10px}\\n    .cta{margin-top:16px}\\n    .btn-cta{background:linear-gradient(90deg,var(--accent2),var(--accent1));color:#032024;padding:12px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    @media(max-width:780px){.steps{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"bg-svg\\\"></div>\\n  <div class=\\\"shell\\\">\\n    <header>\\n      <div><div style=\\\"font-weight:800;color:#e8fbf8\\\">{{BUSINESS_NAME}}</div><div class=\\\"muted\\\">Care designed around your life</div></div>\\n      <nav><a href=\\\"index.html\\\">Home</a><a href=\\\"services.html\\\">What we offer</a><a href=\\\"conditions.html\\\">Concerns</a><a href=\\\"book.html\\\" style=\\\"font-weight:700\\\">{{PRIMARY_CTA_LABEL}}</a></nav>\\n    </header>\\n\\n    <section class=\\\"lead\\\">\\n      <h1>How we work — clear steps, gentle progress</h1>\\n      <p class=\\\"muted\\\">Our approach blends listening, practical education, and measurable goals. We outline intake -> personalized plan -> follow-up, and discuss optional labs when helpful. Nothing is imposed; everything is collaborative.</p>\\n    </section>\\n\\n    <section class=\\\"steps\\\">\\n      <div class=\\\"step\\\">\\n        <h3>1. Thoughtful Intake</h3>\\n        <p class=\\\"muted\\\">A comprehensive conversation about your history, lifestyle, sleep, stressors, diet and medications. This is time to tell your story — we synthesize it into clear priorities.</p>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px;font-size:13px\\\">Includes baseline questionnaires and short functional screens to guide next steps.</div>\\n      </div>\\n\\n      <div class=\\\"step\\\">\\n        <h3>2. A Personalized Plan</h3>\\n        <p class=\\\"muted\\\">We co-create a plan with practical, incremental changes: nutrition patterns, movement, sleep rituals, and self-care practices. Plans may include educational supplement guidance or botanical suggestions when appropriate.</p>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px;font-size:13px\\\">Goals are measurable and revisited — progress over perfection.</div>\\n      </div>\\n\\n      <div class=\\\"step\\\">\\n        <h3>3. Optional, Targeted Labs</h3>\\n        <p class=\\\"muted\\\">When clinically indicated, we may recommend select labs to inform care (e.g., micronutrient testing, metabolic markers). Labs are discussed for their educational value and limits.</p>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px;font-size:13px\\\">Lab selection is conservative and explained thoroughly; they are never mandatory for care.</div>\\n      </div>\\n\\n      <div class=\\\"step\\\">\\n        <h3>4. Follow-ups & Adaptation</h3>\\n        <p class=\\\"muted\\\">Short follow-ups help adjust the plan, troubleshoot barriers, and celebrate wins. Frequency is based on need — the aim is self-efficacy and long-term resilience.</p>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px;font-size:13px\\\">We track outcomes and refine interventions to avoid unnecessary complexity.</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"notes\\\">\\n      <h3 style=\\\"margin-top:0;color:#e9fbf5\\\">Micro-habits & small experiments</h3>\\n      <p class=\\\"muted\\\">We emphasize micro-habits: short, repeatable changes that create momentum. Examples: 3-minute breathing before bed, a protein-focused breakfast, or a 10-minute daily walk after lunch. These small shifts compound into meaningful outcomes over time.</p>\\n    </section>\\n\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:16px;gap:12px\\\">\\n      <div class=\\\"muted\\\">Interested in a tailored intake to begin this process?</div>\\n      <div class=\\\"cta\\\"><a class=\\\"btn-cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n    </div>\\n\\n    <footer style=\\\"margin-top:20px;color:var(--muted)\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}} • {{BUSINESS_NAME}} — Educational, integrative guidance. Contact: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a></footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
