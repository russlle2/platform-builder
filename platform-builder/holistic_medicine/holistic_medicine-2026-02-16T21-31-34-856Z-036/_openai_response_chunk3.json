          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Fees & Add‑Ons — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f1724;--card:#0b1220;--accent1:#7dd3fc;--accent2:#a78bfa;--muted:#cbd5e1;--glass:rgba(255,255,255,0.04)}\\n    *{box-sizing:border-box}\\n    html,body{height:100%}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:var(--muted);background:linear-gradient(180deg,var(--bg) 0%, #071029 60%);-webkit-font-smoothing:antialiased}\\n    header{position:relative;padding:28px 32px;display:flex;align-items:center;justify-content:space-between}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 12px;font-weight:600;font-size:14px}\\n    nav a:hover{color:var(--accent1)}\\n    .wrap{max-width:1040px;margin:28px auto;padding:36px;border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);backdrop-filter:blur(6px)}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    .title{color:#e6eef8;font-size:28px;margin:0 0 6px}\\n    .subtitle{color:var(--muted);margin:0 0 18px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 24px rgba(2,6,23,0.6)}\\n    .tier{display:flex;align-items:flex-start;gap:14px;border-radius:10px;padding:14px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);margin-bottom:12px}\\n    .price{font-weight:700;color:#f8fafc;font-size:20px}\\n    .tag{background:linear-gradient(90deg,var(--accent1),var(--accent2));padding:6px 10px;border-radius:999px;color:#021025;font-weight:700;font-size:12px}\\n    .muted{color:#9fb0c6;font-size:14px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:22px}\\n    footer{margin-top:18px;padding-top:10px;border-top:1px dashed rgba(255,255,255,0.03);display:flex;justify-content:space-between;align-items:center}\\n    .cta{display:inline-block;padding:12px 16px;border-radius:10px;background:linear-gradient(90deg,var(--accent2),var(--accent1));color:#021025;font-weight:800;text-decoration:none}\\n    .small{font-size:13px;color:#90a4b8}\\n    .addon{display:flex;justify-content:space-between;align-items:center;padding:10px 12px;background:rgba(255,255,255,0.02);border-radius:8px;margin-bottom:8px}\\n    /* decorative pattern */\\n    .pattern{position:fixed;right:-120px;top:-60px;opacity:0.14;filter:blur(6px);transform:rotate(18deg);pointer-events:none}\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <svg class='pattern' width='520' height='520' viewBox='0 0 520 520' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n    <defs>\\n      <linearGradient id='g1' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#7dd3fc'/>\\n        <stop offset='1' stop-color='#a78bfa'/>\\n      </linearGradient>\\n      <filter id='f1' x='-20%' y='-20%' width='140%' height='140%'>\\n        <feTurbulence baseFrequency='0.9' numOctaves='2' seed='8'/>\\n        <feColorMatrix type='saturate' values='0.3'/>\\n      </filter>\\n    </defs>\\n    <rect width='520' height='520' rx='28' fill='url(#g1)' opacity='0.12' filter='url(#f1)'/>\\n    <g opacity='0.18' fill='none' stroke='white' stroke-width='1.2'>\\n      <path d='M20 260c60-120 220-140 320-40'></path>\\n      <path d='M40 300c80 60 200 80 320-20'></path>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div style='display:flex;gap:14px;align-items:center'>\\n      <div style='width:46px;height:46px;border-radius:10px;background:linear-gradient(180deg,#0ea5e9,#7c3aed);display:flex;align-items:center;justify-content:center;font-weight:800;color:#021025'>HM</div>\\n      <div>\\n        <div style='font-weight:800;color:#e6eef8'>{{BUSINESS_NAME}}</div>\\n        <div style='font-size:12px;color:#9fb0c6'>Holistic integrative care in {{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav aria-label='Main navigation'>\\n      <a href='index.html'>Home</a>\\n      <a href='services.html'>Offerings</a>\\n      <a href='conditions.html'>Concerns</a>\\n      <a href='approach.html'>Method</a>\\n      <a href='pricing.html' style='color:#fff'>Fees</a>\\n      <a href='about.html'>Story</a>\\n      <a href='book.html'>Book</a>\\n      <a href='contact.html'>Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main class='wrap'>\\n    <section class='hero'>\\n      <div>\\n        <h1 class='title'>Transparent fees that support whole‑person care</h1>\\n        <p class='subtitle'>We price for clarity — session types, recommended follow‑ups, and optional retail add‑ons so you can make informed choices.</p>\\n        <div class='card'>\\n          <div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:12px'>\\n            <div>\\n              <div class='small'>Initial consultation</div>\\n              <div class='muted'>A 75‑minute intake to understand your story, labs, and priorities.</div>\\n            </div>\\n            <div style='text-align:right'>\\n              <div class='price'>$210</div>\\n              <div class='small'>Add labs as recommended</div>\\n            </div>\\n          </div>\\n          <div style='display:flex;gap:10px'>\\n            <a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n            <a class='small' href='about.html' style='align-self:center;margin-left:8px;color:#9fb0c6;text-decoration:none'>Meet the practitioner</a>\\n          </div>\\n        </div>\\n      </div>\\n      <aside>\\n        <div class='card'>\\n          <div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:12px'>\\n            <div style='font-weight:800;color:#e6eef8'>Follow‑up</div>\\n            <div class='tag'>30–45m</div>\\n          </div>\\n          <div class='muted'>Focused visits to review progress, adjust plan, and support integration.</div>\\n          <div style='margin-top:12px'>\\n            <div class='tier'>\\n              <div style='flex:1'>Standard follow‑up</div>\\n              <div class='price'>$95</div>\\n            </div>\\n            <div class='tier'>\\n              <div style='flex:1'>Extended follow‑up</div>\\n              <div class='price'>$140</div>\\n            </div>\\n          </div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style='margin-top:22px'>\\n      <h2 style='margin:0 0 10px;color:#e6eef8'>Care packages & retail add‑ons</h2>\\n      <p class='muted' style='margin:0 0 12px'>Packages bundle visits with educational resources; retail items are optional and evidence‑informed. No guarantees — care focuses on education and support.</p>\\n      <div class='grid'>\\n        <div>\\n          <div class='card'>\\n            <div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:10px'>\\n              <div style='font-weight:800;color:#e6eef8'>Starter Package</div>\\n              <div class='tag'>$360</div>\\n            </div>\\n            <div class='muted'>Intake + two follow‑ups, care plan, and resource packet. Recommended for new patients seeking support for stress, sleep, or digestion.</div>\\n          </div>\\n\\n          <div class='card' style='margin-top:12px'>\\n            <div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:10px'>\\n              <div style='font-weight:800;color:#e6eef8'>Monthly Support</div>\\n              <div class='tag'>$350/mo</div>\\n            </div>\\n            <div class='muted'>Two follow‑ups + messaging check‑ins and periodic care adjustments. Best for ongoing chronic concerns.</div>\\n          </div>\\n        </div>\\n\\n        <aside>\\n          <div class='card'>\\n            <div style='font-weight:800;margin-bottom:8px;color:#e6eef8'>Retail / Add‑Ons</div>\\n            <div class='addon'><div class='small'>Targeted supplement formulas</div><div class='price'>$28–$120</div></div>\\n            <div class='addon'><div class='small'>Functional lab panels (educational)</div><div class='price'>Varies</div></div>\\n            <div class='addon'><div class='small'>Personalized meal guide</div><div class='price'>$45</div></div>\\n            <div style='margin-top:10px;color:#93a6bd;font-size:13px'>All add‑ons are optional. We discuss benefits, risks, and evidence before recommending.</div>\\n          </div>\\n        </aside>\\n      </div>\\n    </section>\\n\\n    <section style='margin-top:20px'>\\n      <h3 style='color:#e6eef8;margin-bottom:8px'>Insurance & payments</h3>\\n      <p class='muted'>We are a private‑pay practice. Receipts can be provided for out‑of‑network reimbursement. For clarity on billing, call {{PHONE}} or email {{EMAIL}}.</p>\\n      <footer>\\n        <div class='small'>Phone: {{PHONE}} • Email: {{EMAIL}}</div>\\n        <div style='display:flex;gap:12px;align-items:center'>\\n          <a class='small' href='book.html'>Schedule a visit</a>\\n          <a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </footer>\\n    </section>\\n\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#081226;--card:#0d1724;--accent:#96f2d7;--text:#e7f6f2;--muted:#9fb0c6}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial;color:var(--text);background:radial-gradient(700px 400px at 10% 0%,#072433 0%,var(--bg) 30%), linear-gradient(180deg,#071029 40%,#04111f 100%);-webkit-font-smoothing:antialiased}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:22px 28px}\\n    nav a{color:var(--muted);margin-left:12px;text-decoration:none;font-weight:700}\\n    .container{max-width:980px;margin:26px auto;padding:30px}\\n    .panel{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:22px;border-radius:12px}\\n    h1{margin:0 0 8px;font-size:26px}\\n    h2{margin:18px 0 6px;font-size:18px;color:#dff8f0}\\n    p{margin:0 0 12px;color:var(--muted)}\\n    .bio{display:flex;gap:18px;align-items:flex-start}\\n    .avatar{width:120px;height:120px;border-radius:12px;background:linear-gradient(135deg,#a78bfa,#7dd3fc);display:flex;align-items:center;justify-content:center;font-weight:900;color:#021025}\\n    .facts{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}\\n    .fact{padding:12px;background:rgba(255,255,255,0.02);border-radius:8px}\\n    .cta{display:inline-block;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,#7dd3fc,#a78bfa);color:#021025;font-weight:800;text-decoration:none}\\n    .pattern{position:absolute;left:-60px;top:40%;opacity:0.12;transform:rotate(-18deg);pointer-events:none}\\n    @media (max-width:720px){.bio{flex-direction:column}.facts{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <svg class='pattern' width='420' height='420' viewBox='0 0 420 420' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n    <defs>\\n      <linearGradient id='bgA' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#7dd3fc'/>\\n        <stop offset='1' stop-color='#a78bfa'/>\\n      </linearGradient>\\n    </defs>\\n    <circle cx='210' cy='210' r='200' fill='url(#bgA)' opacity='0.08'/>\\n    <g fill='none' stroke='white' opacity='0.06' stroke-width='1'>\\n      <path d='M40 100c70 0 120 40 200 40s140-60 200-40'></path>\\n      <path d='M30 160c60 20 120 40 220 20s150-80 220-20'></path>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div style='display:flex;gap:12px;align-items:center'>\\n      <div style='width:46px;height:46px;border-radius:10px;background:#7dd3fc;display:flex;align-items:center;justify-content:center;font-weight:800;color:#021025'>HM</div>\\n      <div>\\n        <div style='font-weight:800'>{{BUSINESS_NAME}}</div>\\n        <div style='font-size:12px;color:var(--muted)'>A human‑centered approach in {{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href='index.html'>Welcome</a>\\n      <a href='services.html'>Services</a>\\n      <a href='conditions.html'>Issues</a>\\n      <a href='approach.html'>Our Way</a>\\n      <a href='pricing.html'>Costs</a>\\n      <a href='about.html' style='color:var(--text)'>Team</a>\\n      <a href='book.html'>Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <main class='container'>\\n    <section class='panel'>\\n      <div class='bio'>\\n        <div class='avatar'>\\n          <div style='text-align:center'>\\n            <div style='font-size:18px'>{{PRACTITIONER_NAME}}</div>\\n            <div style='font-size:12px;margin-top:6px'>{{CREDENTIALS}}</div>\\n          </div>\\n        </div>\\n        <div>\\n          <h1>Care that listens to the whole story</h1>\\n          <p>I blend evidence‑informed modalities with compassionate coaching to help people navigate stress, sleep issues, digestion concerns, inflammation, and low energy. My role is educator, guide, and partner.</p>\\n\\n          <h2>Clinical perspective</h2>\\n          <p>We look beyond isolated symptoms — examining lifestyle, context, and labs when appropriate. Recommendations emphasize sustainable habits, informed choices, and the limits of current knowledge. No promises of cures; only clear guidance and collaborative support.</p>\\n\\n          <div style='margin-top:12px'>\\n            <a class='cta' href='book.html'>Book a conversation</a>\\n            <a href='contact.html' style='margin-left:12px;color:var(--muted);text-decoration:none'>Ask a question</a>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <div class='facts' style='margin-top:16px'>\\n        <div class='fact'>\\n          <strong style='display:block;color:#dff8f0'>Experience</strong>\\n          <div style='color:var(--muted)'>Years in integrative practice with training in functional assessment and lifestyle medicine.</div>\\n        </div>\\n        <div class='fact'>\\n          <strong style='display:block;color:#dff8f0'>Approach</strong>\\n          <div style='color:var(--muted)'>Collaborative plans, educational emphasis, and optional labs when clinically useful.</div>\\n        </div>\\n        <div class='fact'>\\n          <strong style='display:block;color:#dff8f0'>Community</strong>\\n          <div style='color:var(--muted)'>Workshops and resources to support lasting habits in daily life.</div>\\n        </div>\\n        <div class='fact'>\\n          <strong style='display:block;color:#dff8f0'>Values</strong>\\n          <div style='color:var(--muted)'>Curiosity, humility, and evidence‑centered care.</div>\\n        </div>\\n      </div>\\n\\n      <h2 style='margin-top:18px'>Licenses & training</h2>\\n      <p class='muted'>{{PRACTITIONER_NAME}} holds professional credentials and engages in ongoing education. Credentials: {{CREDENTIALS}}. For verification or questions about qualifications, email {{EMAIL}}.</p>\\n\\n      <h2 style='margin-top:16px'>A note about scope</h2>\\n      <p class='muted'>Holistic care supports wellness through education and integrative therapies. We do not offer guaranteed cures. When appropriate, we collaborate with primary care and specialists for comprehensive care.</p>\\n\\n    </section>\\n  </main>\\n\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Book a Visit — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#021225;--card:#071827;--accent1:#63f3b0;--accent2:#7dd3fc;--txt:#eaf6f1}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial;color:var(--txt);background:linear-gradient(180deg,#021225 0%,#041528 60%)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 26px}\\n    nav a{color:#9fb0c6;margin-left:12px;text-decoration:none;font-weight:700}\\n    .stage{max-width:920px;margin:24px auto;padding:22px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:20px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px}\\n    label{display:block;font-size:13px;color:#bfeadf;margin-bottom:6px}\\n    input,textarea,select{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:var(--txt)}\\n    .btn{display:inline-block;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,var(--accent1),var(--accent2));color:#021025;font-weight:800;text-decoration:none;border:none}\\n    .note{font-size:13px;color:#9fb0c6}\\n    .pattern{position:fixed;right:20px;bottom:10px;opacity:0.12;pointer-events:none}\\n    @media (max-width:880px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <svg class='pattern' width='360' height='360' viewBox='0 0 360 360' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n    <defs>\\n      <linearGradient id='lg' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#63f3b0'/>\\n        <stop offset='1' stop-color='#7dd3fc'/>\\n      </linearGradient>\\n    </defs>\\n    <rect width='360' height='360' rx='24' fill='url(#lg)' opacity='0.09'/>\\n    <g opacity='0.08' fill='none' stroke='white' stroke-width='1'>\\n      <path d='M20 180c60-90 180-90 280-20'></path>\\n      <path d='M40 220c80 40 180 60 300-40'></path>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div style='display:flex;gap:12px;align-items:center'>\\n      <div style='width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#63f3b0,#7dd3fc);display:flex;align-items:center;justify-content:center;color:#021025;font-weight:800'>HM</div>\\n      <div>\\n        <div style='font-weight:800'>{{BUSINESS_NAME}}</div>\\n        <div style='font-size:12px;color:#9fb0c6'>Schedule your first conversation</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href='index.html'>Back</a>\\n      <a href='services.html'>Offerings</a>\\n      <a href='pricing.html'>Pricing</a>\\n      <a href='about.html'>Who</a>\\n      <a href='book.html' style='color:var(--txt)'>Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <main class='stage'>\\n    <div class='grid'>\\n      <section class='card'>\\n        <h1 style='margin:0 0 10px'>Reserve time</h1>\\n        <p class='note' style='margin:0 0 14px'>Choose an intake or follow‑up. If you're unsure, pick an intake (longer visit). We will review and may suggest labs only if clinically warranted.</p>\\n\\n        <form action='{{PRIMARY_CTA_URL}}' method='get' aria-label='Booking form' style='display:grid;gap:12px'>\\n          <div>\\n            <label for='visit'>Visit type</label>\\n            <select id='visit' name='visit'>\\n              <option>Initial intake — 75 minutes</option>\\n              <option>Follow‑up — 45 minutes</option>\\n              <option>Follow‑up — 30 minutes</option>\\n            </select>\\n          </div>\\n\\n          <div>\\n            <label for='name'>Full name</label>\\n            <input id='name' name='name' placeholder='Your name' required>\\n          </div>\\n\\n          <div style='display:grid;grid-template-columns:1fr 1fr;gap:10px'>\\n            <div>\\n              <label for='phone'>Phone</label>\\n              <input id='phone' name='phone' placeholder='{{PHONE}}' required>\\n            </div>\\n            <div>\\n              <label for='email'>Email</label>\\n              <input id='email' name='email' placeholder='{{EMAIL}}' required>\\n            </div>\\n          </div>\\n\\n          <div>\\n            <label for='concern'>Primary concern</label>\\n            <input id='concern' name='concern' placeholder='e.g., sleep, digestion, low energy'>\\n          </div>\\n\\n          <div>\\n            <label for='notes'>Anything to share before we meet?</label>\\n            <textarea id='notes' name='notes' rows='4' placeholder='Brief health history, meds, or priorities (optional)'></textarea>\\n          </div>\\n\\n          <div style='display:flex;gap:10px;align-items:center'>\\n            <button type='submit' class='btn'>Request appointment</button>\\n            <div class='note'>We will follow up to confirm availability and intake instructions.</div>\\n          </div>\\n        </form>\\n\\n        <div style='margin-top:14px;font-size:13px;color:#9fb0c6'>Cancellation policy: Please give 48 hours' notice when possible. Late cancellations or missed visits may incur a fee.</div>\\n      </section>\\n\\n      <aside class='card'>\\n        <h3 style='margin:0 0 8px;color:var(--txt)'>Before your visit</h3>\\n        <p class='note' style='margin:0 0 12px'>To make the most of our time: write down recent labs, current supplements, medications, and a short timeline of your symptoms.</p>\\n\\n        <div style='margin-bottom:12px'>\\n          <strong style='color:var(--txt)'>Virtual & in‑person options</strong>\\n          <div class='note'>We offer secure telehealth and selective in‑clinic appointments. Location and format will be confirmed when booking.</div>\\n        </div>\\n\\n        <div style='margin-bottom:12px'>\\n          <strong style='color:var(--txt)'>Optional labs</strong>\\n          <div class='note'>Functional lab testing is educational. It may be useful in some cases but is never required. We discuss appropriateness during intake.</div>\\n        </div>\\n\\n        <div style='margin-top:12px'>\\n          <div class='note'>Questions? Call {{PHONE}} or email <a href='mailto:{{EMAIL}}' style='color:var(--accent2);text-decoration:none'>{{EMAIL}}</a>.</div>\\n          <div style='margin-top:10px'><a class='btn' href='{{PRIMARY_CTA_URL}}'>Proceed to scheduling</a></div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
  "parallel_tool_calls": true,
  "presence_penalty": 0,
  "previous_response_id": null,
  "prompt_cache_key": null,
  "prompt_cache_retention": null,
  "reasoning": {
    "effort": "medium",
    "summary": null
  },
  "safety_identifier": null,
  "service_tier": "default",
  "store": true,
  "temperature": 1,
