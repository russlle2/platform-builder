          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Services</title>\\n  <style>\\n    :root{--bg1:#FFEDD5;--bg2:#E6FFFA;--accent:#FF6B6B;--muted:#445566;--glass:rgba(255,255,255,0.6);--radius:18px}\\n    *{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial;color:var(--muted);background:linear-gradient(160deg,var(--bg1),var(--bg2));min-height:100vh;display:flex;flex-direction:column}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 28px}\\n    .brand{font-weight:800;color:#203040;letter-spacing:-0.02em}\\n    nav a{margin-left:16px;text-decoration:none;color:#203040;font-weight:600}\\n    .wrap{max-width:1100px;margin:24px auto;padding:28px}\\n    /* playful hero */\\n    .hero{display:grid;grid-template-columns:1fr 340px;gap:24px;align-items:center;margin-bottom:20px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.9),var(--glass));padding:26px;border-radius:var(--radius);box-shadow:0 8px 30px rgba(20,30,40,0.08)}\\n    h1{margin:0 0 8px 0;font-size:28px;color:#122233}\\n    p.lead{margin:0;color:#334455;font-size:15px}\\n    .bubble{background:linear-gradient(90deg,#FFEFDB,#FFF3F3);padding:14px;border-radius:12px;font-weight:700;color:#2B2B2B}\\n    .services-list{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:18px}\\n    .service{padding:12px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.7),rgba(250,250,252,0.7));border:1px solid rgba(15,20,30,0.04)}\\n    .muted{color:#556677;font-size:13px}\\n    /* ritual (VIP Day) */\\n    section.ritual{display:flex;gap:18px;margin:26px 0}\\n    .ritual .left{flex:1}\\n    .ritual .right{width:320px}\\n    .pill{display:inline-block;padding:8px 12px;border-radius:999px;background:linear-gradient(90deg,#FFE2E2,#FFF1F2);font-weight:700;color:#7A2020}\\n    /* what to expect */\\n    .expect{display:flex;gap:16px;align-items:stretch}\\n    .step{flex:1;padding:16px;border-radius:12px;background:linear-gradient(180deg,#FFF,#F8FFFC);border:1px dashed rgba(50,60,70,0.04)}\\n    .step h4{margin:0 0 8px 0}\\n    /* schedule */\\n    .timeline{margin-top:14px;border-left:3px solid rgba(20,30,40,0.06);padding-left:14px}\\n    .t-item{margin-bottom:12px}\\n    /* pricing */\\n    .price{font-size:22px;font-weight:900;color:#172A3A}\\n    .sub{font-size:13px;color:#5A6B78}\\n    /* faq */\\n    .faq dt{font-weight:700;margin-top:10px}\\n    footer{margin-top:34px;padding:18px 0;border-top:1px dashed rgba(0,0,0,0.05);display:flex;justify-content:space-between;align-items:center}\\n    .cta{display:inline-block;padding:12px 18px;border-radius:12px;background:linear-gradient(90deg,var(--accent),#FF8D8D);color:white;font-weight:800;text-decoration:none}\\n    /* decorative svg */\\n    .pattern{position:fixed;right:-8vw;top:-6vh;opacity:0.12;filter:blur(6px);transform:rotate(12deg);pointer-events:none}\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.services-list{grid-template-columns:1fr}.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern\\\" width=\\\"520\\\" height=\\\"520\\\" viewBox=\\\"0 0 520 520\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#FFB4B4\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#FFD9B4\\\"/></linearGradient>\\n      <filter id=\\\"f1\\\"><feTurbulence baseFrequency=\\\"0.9\\\" numOctaves=\\\"2\\\" stitchTiles=\\\"stitch\\\"/></filter>\\n    </defs>\\n    <rect width=\\\"520\\\" height=\\\"520\\\" rx=\\\"80\\\" fill=\\\"url(#g1)\\\" />\\n    <g fill=\\\"#FFF\\\" opacity=\\\"0.18\\\">\\n      <circle cx=\\\"120\\\" cy=\\\"90\\\" r=\\\"46\\\"/>\\n      <circle cx=\\\"260\\\" cy=\\\"260\\\" r=\\\"28\\\"/>\\n      <circle cx=\\\"420\\\" cy=\\\"160\\\" r=\\\"18\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header class=\\\"wrap\\\">\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"approach.html\\\">Pathway</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero card\\\">\\n      <div>\\n        <div class=\\\"pill\\\">VIP Day — Intensive Session</div>\\n        <h1>Full-spectrum care in one focused day</h1>\\n        <p class=\\\"lead\\\">A concentrated VIP Day for adults seeking a clear, personalized plan that joins traditional wisdom with modern testing and lifestyle medicine. We emphasize education, measurable goals, and safe, integrative options tailored to you.</p>\\n\\n        <div class=\\\"services-list\\\" aria-hidden>\\n          <div class=\\\"service\\\"><strong>Comprehensive intake</strong>\\n            <div class=\\\"muted\\\">History, symptom mapping, lifestyle review</div>\\n          </div>\\n          <div class=\\\"service\\\"><strong>Targeted labs (optional)</strong>\\n            <div class=\\\"muted\\\">Educative labs to inform choices — explained and contextualized</div>\\n          </div>\\n          <div class=\\\"service\\\"><strong>Individualized plan</strong>\\n            <div class=\\\"muted\\\">Diet, sleep strategies, movement, supplements when appropriate</div>\\n          </div>\\n          <div class=\\\"service\\\"><strong>Follow-up roadmap</strong>\\n            <div class=\\\"muted\\\">Short-term actions and measurable next steps</div>\\n          </div>\\n        </div>\\n\\n      </div>\\n      <aside class=\\\"card\\\">\\n        <div style=\\\"display:flex;flex-direction:column;gap:12px\\\">\\n          <div class=\\\"bubble\\\">One-day deep dive — ideal for busy people</div>\\n          <div>\\n            <div class=\\\"price\\\">Investment: $2,400</div>\\n            <div class=\\\"sub\\\">Includes pre-visit review, up to 4 hours with practitioner, written plan, and one 30-minute check-in within 30 days.</div>\\n          </div>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"ritual card\\\" aria-labelledby=\\\"ritual-title\\\">\\n      <div class=\\\"left\\\">\\n        <h3 id=\\\"ritual-title\\\">The Ritual: How a VIP Day unfolds</h3>\\n        <p class=\\\"muted\\\">Think of this as a structured learning day — we investigate, teach, and map next steps together. The goal is clarity and a practical toolkit you can use immediately.</p>\\n\\n        <div class=\\\"expect\\\" style=\\\"margin-top:12px\\\">\\n          <div class=\\\"step\\\">\\n            <h4>Pre-Visit</h4>\\n            <p class=\\\"muted\\\">Questionnaires, prior records review, and optional baseline labs recommended for richer insights.</p>\\n          </div>\\n          <div class=\\\"step\\\">\\n            <h4>Deep Intake</h4>\\n            <p class=\\\"muted\\\">A thorough, supportive conversation about symptoms, lifestyle, and goals.</p>\\n          </div>\\n          <div class=\\\"step\\\">\\n            <h4>Co-Created Plan</h4>\\n            <p class=\\\"muted\\\">Actionable, prioritized items with rationale and expected timelines.</p>\\n          </div>\\n        </div>\\n      </div>\\n      <aside class=\\\"right card\\\">\\n        <h4>Who benefits most?</h4>\\n        <p class=\\\"muted\\\">People ready to invest focused time to get a clear roadmap — often those juggling work, family, and health goals who want a practical plan without repeated short visits.</p>\\n        <div style=\\\"margin-top:12px\\\"><strong>Practitioner:</strong> {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"card\\\" id=\\\"what-to-expect\\\">\\n      <h3>What to expect: practical steps</h3>\\n      <div class=\\\"timeline\\\">\\n        <div class=\\\"t-item\\\"><strong>Before your visit:</strong> intake forms and suggested labs (optional). We explain each test so there are no surprises.</div>\\n        <div class=\\\"t-item\\\"><strong>During the VIP Day:</strong> focused dialogue, education, and co-designed plan. We prioritize 2–3 high-impact changes first.</div>\\n        <div class=\\\"t-item\\\"><strong>Afterwards:</strong> written plan, resources, and one follow-up check-in within 30 days to review progress and adjust safely.</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" id=\\\"pricing\\\">\\n      <h3>Pricing & what's included</h3>\\n      <p class=\\\"muted\\\">The VIP Day is a single-session intensive. Pricing covers preparation time, the multi-hour visit, written plan, and the one follow-up. Optional lab costs are billed separately.</p>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:12px\\\">\\n        <div>\\n          <div class=\\\"price\\\">$2,400</div>\\n          <div class=\\\"sub\\\">VIP Day investment</div>\\n        </div>\\n        <div>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve a VIP Day</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" id=\\\"faq\\\">\\n      <h3>Frequently asked questions</h3>\\n      <dl>\\n        <dt>Do you guarantee outcomes?</dt>\\n        <dd class=\\\"muted\\\">We cannot guarantee cures. Our focus is education, evidence-informed options, and individualized support. Results vary by person and engagement.</dd>\\n        <dt>Are labs required?</dt>\\n        <dd class=\\\"muted\\\">No — labs are optional and recommended when they will meaningfully inform the plan. We always explain benefits, limits, and costs.</dd>\\n        <dt>Can I use insurance?</dt>\\n        <dd class=\\\"muted\\\">Insurance may not cover VIP Day time packages. We provide receipts to submit for out-of-network reimbursement where applicable.</dd>\\n      </dl>\\n    </section>\\n\\n    <section class=\\\"card\\\" id=\\\"cta\\\">\\n      <h3>Ready to make progress?</h3>\\n      <p class=\\\"muted\\\">Book a focused day to come away with clarity, practical steps, and the knowledge to move forward.</p>\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">{{BUSINESS_NAME}} — {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n      <div class=\\\"muted\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">Email us</a></div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Concerns We Support</title>\\n  <style>\\n    :root{--bg:#F7FFF7;--ink:#12323A;--accent:#2E8B57;--card:#FFFFFF;--muted:#51656A}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#F7FFF7,#F0FFF8);color:var(--ink)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 26px}\\n    .brand{font-weight:900;color:var(--ink);letter-spacing:-0.01em}\\n    nav a{margin-left:14px;color:var(--ink);text-decoration:none;font-weight:700}\\n    .container{max-width:1000px;margin:20px auto;padding:18px}\\n    .hero{background:linear-gradient(90deg,#E8FFF0,#FFFDF7);padding:22px;border-radius:14px;display:flex;gap:16px;align-items:center}\\n    h1{margin:0;font-size:24px}\\n    .intro{color:var(--muted);margin-top:8px}\\n    section{margin-top:18px}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}\\n    .item{background:var(--card);padding:14px;border-radius:12px;border:1px solid rgba(10,20,10,0.03)}\\n    .icon{width:44px;height:44px;border-radius:10px;background:linear-gradient(180deg,#FFFFFF,#F0FFF0);display:inline-flex;align-items:center;justify-content:center;margin-right:10px}\\n    .flag{font-weight:800;color:var(--accent)}\\n    .muted{color:var(--muted)}\\n    .disclaimer{font-size:13px;color:#6B7280;margin-top:12px}\\n    footer{margin-top:22px;padding:14px;border-top:1px dashed rgba(0,0,0,0.06);display:flex;justify-content:space-between}\\n    .svg-splash{position:absolute;left:-6vw;bottom:-8vh;opacity:0.08;pointer-events:none}\\n    @media (max-width:780px){.grid{grid-template-columns:1fr}.svg-splash{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"svg-splash\\\" width=\\\"420\\\" height=\\\"420\\\" viewBox=\\\"0 0 420 420\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <radialGradient id=\\\"rg1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#DFF7E2\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#F8FFF9\\\"/></radialGradient>\\n    </defs>\\n    <rect width=\\\"420\\\" height=\\\"420\\\" rx=\\\"60\\\" fill=\\\"url(#rg1)\\\" />\\n    <g fill=\\\"#0F5132\\\" opacity=\\\"0.12\\\">\\n      <ellipse cx=\\\"110\\\" cy=\\\"80\\\" rx=\\\"48\\\" ry=\\\"28\\\"/>\\n      <ellipse cx=\\\"300\\\" cy=\\\"320\\\" rx=\\\"90\\\" ry=\\\"36\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header class=\\\"container\\\">\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Back</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"approach.html\\\">Pathway</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <div class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1>Common concerns we help people explore</h1>\\n        <p class=\\\"intro\\\">We take a whole-person view — addressing symptoms through education, lifestyle, and selectively applied testing. Below are areas often discussed in visits. This is educational and not a promise of specific outcomes.</p>\\n      </div>\\n      <div style=\\\"width:180px;text-align:right\\\">\\n        <div class=\\\"flag\\\">VIP Day option</div>\\n        <div class=\\\"muted\\\">A single-day deep consultation for tailored support.</div>\\n      </div>\\n    </div>\\n\\n    <section aria-labelledby=\\\"conds-title\\\">\\n      <h2 id=\\\"conds-title\\\">Areas of focus</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"item\\\"><div style=\\\"display:flex;align-items:center\\\"><div class=\\\"icon\\\">💤</div><div><strong>Sleep & Circadian Health</strong><div class=\\\"muted\\\">Trouble falling/staying asleep, inconsistent rhythms.</div></div></div></div>\\n        <div class=\\\"item\\\"><div style=\\\"display:flex;align-items:center\\\"><div class=\\\"icon\\\">💆</div><div><strong>Stress & Resilience</strong><div class=\\\"muted\\\">Chronic stress, burnout, anxious patterns—tools for nervous system regulation and pacing.</div></div></div></div>\\n        <div class=\\\"item\\\"><div style=\\\"display:flex;align-items:center\\\"><div class=\\\"icon\\\">🍽️</div><div><strong>Digestion & Gut Comfort</strong><div class=\\\"muted\\\">Bloating, irregularity, dietary strategies, and when testing may clarify causes.</div></div></div></div>\\n        <div class=\\\"item\\\"><div style=\\\"display:flex;align-items:center\\\"><div class=\\\"icon\\\">🔥</div><div><strong>Inflammation & Joint Care</strong><div class=\\\"muted\\\">Non-specific pain or inflammatory markers — focus on lifestyle, anti-inflammatory choices, and safe options.</div></div></div></div>\\n        <div class=\\\"item\\\"><div style=\\\"display:flex;align-items:center\\\"><div class=\\\"icon\\\">⚡</div><div><strong>Energy & Fatigue</strong><div class=\\\"muted\\\">Low energy that affects function — we look for patterns and prioritize low-risk, high-impact changes.</div></div></div></div>\\n        <div class=\\\"item\\\"><div style=\\\"display:flex;align-items:center\\\"><div class=\\\"icon\\\">🧠</div><div><strong>Focus & Cognitive Support</strong><div class=\\\"muted\\\">Attention, clarity, and mental stamina strategies that include sleep, nutrition, and routines.</div></div></div></div>\\n      </div>\\n\\n      <p class=\\\"disclaimer\\\"><strong>Important:</strong> We do not offer guaranteed cures. Our approach is educational and individualized. We may suggest labs as a tool to inform a plan, but tests are always discussed with informed consent and context. If you have an urgent medical condition, seek immediate care.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;\\\" aria-labelledby=\\\"how-we-help\\\">\\n      <h3 id=\\\"how-we-help\\\">How we approach these concerns</h3>\\n      <p class=\\\"muted\\\">Every plan begins with understanding context: your history, priorities, and what has or hasn't worked. We focus on safe interventions with clear rationale and measurable next steps.</p>\\n      <ul class=\\\"muted\\\">\\n        <li>Education about mechanisms and trade-offs</li>\\n        <li>Priority-based actions you can test over weeks</li>\\n        <li>Optional labs only when results will change management</li>\\n      </ul>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;\\\" aria-labelledby=\\\"next-steps\\\">\\n      <h3 id=\\\"next-steps\\\">Next steps</h3>\\n      <p class=\\\"muted\\\">If one of these areas resonates, consider a focused VIP Day or an initial visit to map a safe plan. We provide clear documentation you can use with other providers.</p>\\n      <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:inline-block;margin-top:8px;padding:10px 14px;border-radius:12px;background:var(--accent);color:white;text-decoration:none;font-weight:800\\\">Start here</a>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n      <div class=\\\"muted\\\">Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Our Approach</title>\\n  <style>\\n    :root{--bgA:#FFF7FF;--accent:#6B46C1;--ink:#2B2B2B;--soft:#6F6F7A}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,var(--bgA),#FFFFFF);color:var(--ink)}\\n    header{padding:18px 26px;display:flex;justify-content:space-between;align-items:center}\\n    .brand{font-weight:900}\\n    nav a{margin-left:12px;text-decoration:none;color:var(--ink);font-weight:700}\\n    .wrap{max-width:980px;margin:18px auto;padding:18px}\\n    .lead-card{background:linear-gradient(90deg,#FDF7FF,#FFF);border-radius:14px;padding:20px;border:1px solid rgba(60,20,80,0.04)}\\n    h1{margin:0 0 6px 0}\\n    .muted{color:var(--soft)}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:14px}\\n    .box{background:white;padding:16px;border-radius:12px;border:1px solid rgba(10,10,10,0.03)}\\n    .steps{display:flex;flex-direction:column;gap:12px}\\n    .step{padding:12px;border-radius:10px;background:linear-gradient(180deg,#FFF,#FBF8FF);border-left:6px solid rgba(107,70,193,0.12)}\\n    .labs{font-size:14px;color:#475569}\\n    .note{font-size:13px;color:#6B7280}\\n    .cta{display:inline-block;padding:10px 14px;background:var(--accent);color:white;border-radius:10px;font-weight:800;text-decoration:none}\\n    .svg-orn{position:fixed;right:-4vw;bottom:-6vh;opacity:0.08;pointer-events:none}\\n    @media (max-width:920px){.grid{grid-template-columns:1fr}.svg-orn{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"svg-orn\\\" width=\\\"420\\\" height=\\\"420\\\" viewBox=\\\"0 0 420 420\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"lg1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#EAD9FF\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#FFEAF7\\\"/></linearGradient>\\n    </defs>\\n    <rect width=\\\"420\\\" height=\\\"420\\\" rx=\\\"80\\\" fill=\\\"url(#lg1)\\\"/>\\n    <g fill=\\\"#3E2A6B\\\" opacity=\\\"0.12\\\">\\n      <rect x=\\\"60\\\" y=\\\"60\\\" width=\\\"80\\\" height=\\\"80\\\" rx=\\\"18\\\"/>\\n      <circle cx=\\\"320\\\" cy=\\\"120\\\" r=\\\"28\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header class=\\\"wrap\\\">\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"lead-card\\\">\\n      <h1>Our pathway: listen, learn, and design together</h1>\\n      <p class=\\\"muted\\\">We merge evidence-informed integrative practices with practical behavior change. The aim is a safe, transparent plan you understand and can follow — with measurable checkpoints.</p>\\n    </section>\\n\\n    <section class=\\\"grid\\\">\\n      <div>\\n        <div class=\\\"box\\\">\\n          <h3>Intake & discovery</h3>\\n          <p class=\\\"muted\\\">We begin by mapping symptoms, life context, medical history, and priorities. The intake is collaborative — you lead with what matters most.</p>\\n        </div>\\n\\n        <div class=\\\"steps\\\" style=\\\"margin-top:12px\\\">\\n          <div class=\\\"step\\\">\\n            <strong>Co-created goals</strong>\\n            <div class=\\\"muted\\\">Short-term, measurable goals so progress is visible and realistic.</div>\\n          </div>\\n\\n          <div class=\\\"step\\\">\\n            <strong>Personalized plan</strong>\\n            <div class=\\\"muted\\\">Nutrition, sleep, movement, stress tools, and selective supplements when appropriate — each with a rationale.</div>\\n          </div>\\n\\n          <div class=\\\"step\\\">\\n            <strong>Follow-up & adjustment</strong>\\n            <div class=\\\"muted\\\">Regular check-ins to track progress and safely adapt the plan.</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"box\\\">\\n          <h4>Optional labs — educational, not mandatory</h4>\\n          <p class=\\\"labs\\\">We may suggest targeted lab tests when results will change management or provide clarity. Tests are explained in plain language, with costs and alternatives discussed before ordering.</p>\\n          <p class=\\\"note\\\">Examples include metabolic panels, targeted nutrient levels, or gut-focused tests — chosen thoughtfully and only when helpful.</p>\\n        </div>\\n\\n        <div class=\\\"box\\\" style=\\\"margin-top:12px\\\">\\n          <h4>Safety & collaboration</h4>\\n          <p class=\\\"muted\\\">We coordinate with your other providers when appropriate and prioritize interventions that are low risk and evidence-informed. If a condition requires specialty or urgent care, we will recommend next steps.</p>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:16px\\\" aria-labelledby=\\\"follow\\\">\\n      <h3 id=\\\"follow\\\">Follow-ups, measurement, and timelines</h3>\\n      <p class=\\\"muted\\\">We focus on tracking a few metrics that matter to you — symptom diaries, sleep data, or repeat labs when indicated. Follow-up cadence is personalized: many clients prefer a 2–6 week check-in after initial changes.</p>\\n      <ul class=\\\"muted\\\">\\n        <li>Initial plan with 2–3 prioritized steps</li>\\n        <li>Written rationale and timeframe for reassessment</li>\\n        <li>Optional objective measures if they will influence decisions</li>\\n      </ul>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <h3>Ethos</h3>\\n        <p class=\\\"muted\\\">We teach you how and why choices are made, so you gain skills for long-term self-care. The work is collaborative, respectful, and pragmatic.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Work with us</a>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:28px;border-top:1px dashed rgba(0,0,0,0.06);padding-top:12px;display:flex;justify-content:space-between\\\">\\n      <div class=\\\"muted\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}} • {{BUSINESS_NAME}}</div>\\n      <div class=\\\"muted\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
