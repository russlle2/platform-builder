          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Investment — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfbfb;--ink:#122;--muted:#586;--accent:#7aa;--glass:rgba(255,255,255,0.6);--card:#fff}\\n    html,body{height:100%;margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:var(--ink);background:linear-gradient(160deg,#fbfff9 0%,#f6f9ff 100%);} \\n    .wrap{max-width:980px;margin:44px auto;padding:40px;background:linear-gradient(180deg,rgba(255,255,255,0.75),rgba(255,255,255,0.9));box-shadow:0 10px 30px rgba(16,24,32,0.08);border-radius:14px;position:relative;overflow:hidden}\\n    nav{display:flex;gap:18px;align-items:center;margin-bottom:28px}\\n    nav a{color:var(--ink);text-decoration:none;font-weight:600;font-size:14px;opacity:0.9}\\n    .logo{font-weight:700;letter-spacing:0.2px}\\n    header.hero{display:grid;grid-template-columns:1fr 320px;gap:28px;align-items:center}\\n    h1{margin:0 0 8px;font-size:28px}\\n    p.lead{margin:0;color:#334;opacity:0.9}\\n    .aside{background:var(--card);padding:20px;border-radius:10px;box-shadow:0 6px 20px rgba(20,30,40,0.04)}\\n    .price-tier{border-left:4px solid var(--accent);padding:14px;border-radius:8px;background:linear-gradient(180deg,rgba(122,170,170,0.03),transparent)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:22px}\\n    .tier{background:var(--card);padding:18px;border-radius:10px;border:1px solid rgba(0,0,0,0.04)}\\n    .tier h3{margin:0 0 6px;font-size:16px}\\n    .cost{font-weight:700;color:var(--muted);font-size:18px}\\n    .muted{color:#556;opacity:0.9}\\n    .note{font-size:13px;color:#445;margin-top:10px}\\n    .cta{display:inline-block;margin-top:12px;background:linear-gradient(90deg,var(--accent),#66c);color:white;padding:10px 14px;border-radius:8px;text-decoration:none;font-weight:700}\\n    .process{display:flex;gap:12px;margin-top:26px}\\n    .step{flex:1;background:linear-gradient(180deg,rgba(122,170,170,0.03),transparent);padding:12px;border-radius:8px;font-size:14px}\\n    footer{margin-top:28px;padding-top:18px;border-top:1px dashed rgba(18,34,34,0.06);display:flex;justify-content:space-between;align-items:center;font-size:13px;color:#556}\\n    .faq{margin-top:22px}\\n    .faq details{background:var(--card);padding:12px;border-radius:8px;margin-bottom:8px}\\n    /* SVG decorative corner */\\n    .pattern{position:absolute;right:-120px;top:-120px;opacity:0.12;transform:rotate(12deg)}\\n    /* subtle responsive */\\n    @media(max-width:880px){header.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}} \\n    /* background reference to asset pattern (fallback if available) */\\n    .wrap::before{content:'';position:absolute;inset:0;background-image:url('assets/img/pattern.svg');opacity:0.06;mix-blend-mode:overlay}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav>\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n      <div style=\\\"flex:1\\\"></div>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"approach.html\\\">Path</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n\\n    <header class=\\\"hero\\\">\\n      <div>\\n        <h1>Investment in care: sessions & series</h1>\\n        <p class=\\\"lead\\\">Choose thoughtful support for body, mind, and rhythm. Pricing is transparent; plans are educational and tailored. No promises of cures—only tools, context, and partnership.</p>\\n\\n        <section style=\\\"margin-top:18px\\\">\\n          <div class=\\\"grid\\\">\\n            <div class=\\\"tier\\\">\\n              <h3>Intro Session</h3>\\n              <div class=\\\"cost\\\">$95 — 50–60 min</div>\\n              <div class=\\\"muted\\\">Great for new clients and learning the whole-person approach.</div>\\n              <div class=\\\"note\\\">A single intake to map priorities and offer an integrative plan.</div>\\n            </div>\\n\\n            <div class=\\\"tier\\\">\\n              <h3>Follow-up</h3>\\n              <div class=\\\"cost\\\">$75 — 30–40 min</div>\\n              <div class=\\\"muted\\\">Progress check, plan tweaks, education and self-care coaching.</div>\\n            </div>\\n\\n            <div class=\\\"tier\\\">\\n              <h3>Series: Monthly Cohort</h3>\\n              <div class=\\\"cost\\\">$240 / month</div>\\n              <div class=\\\"muted\\\">Three-session series designed as a learning arc: intake, educational session, integration workshop.</div>\\n            </div>\\n          </div>\\n        </section>\\n\\n        <div class=\\\"process\\\">\\n          <div class=\\\"step\\\">Intake: understand you.</div>\\n          <div class=\\\"step\\\">Plan: options, education, gentle labs as choice.</div>\\n          <div class=\\\"step\\\">Support: follow-up and group learning.</div>\\n        </div>\\n\\n        <p class=\\\"note\\\">Optional lab work may be discussed for educational purposes; decisions are collaborative. Insurance and sliding scale options may be available—ask on booking.</p>\\n\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n\\n      <aside class=\\\"aside\\\">\\n        <div class=\\\"price-tier\\\">\\n          <strong>Upcoming series</strong>\\n          <div style=\\\"margin-top:8px\\\">A seasonal integrative series begins soon: four workshops + two small-group check-ins. Limited seats.</div>\\n          <div style=\\\"margin-top:12px;display:flex;gap:8px;align-items:center\\\">\\n            <div style=\\\"font-weight:700\\\">Next cohort:</div>\\n            <div class=\\\"muted\\\">Starts Apr 14 — online + local office</div>\\n          </div>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\" style=\\\"display:inline-block;margin-top:12px\\\">Reserve a seat</a>\\n        </div>\\n\\n        <div class=\\\"faq\\\" style=\\\"margin-top:14px\\\">\\n          <details>\\n            <summary>Do you accept insurance?</summary>\\n            <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Primary care may be billed differently. We provide receipts and can discuss options; many clients pay out-of-pocket or use flexible spending accounts.</div>\\n          </details>\\n          <details>\\n            <summary>Are there refunds?</summary>\\n            <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Workshops have a courtesy policy—contact us at {{EMAIL}} for details. No guaranteed cures are offered.</div>\\n          </details>\\n        </div>\\n\\n      </aside>\\n    </header>\\n\\n    <svg class=\\\"pattern\\\" width=\\\"460\\\" height=\\\"460\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#7aa\\\" /><stop offset=\\\"1\\\" stop-color=\\\"#66c\\\" /></linearGradient>\\n      </defs>\\n      <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"200\\\" height=\\\"200\\\" fill=\\\"url(#g1)\\\" opacity=\\\"0.08\\\" />\\n      <g fill=\\\"white\\\" opacity=\\\"0.06\\\">\\n        <circle cx=\\\"30\\\" cy=\\\"40\\\" r=\\\"28\\\" />\\n        <circle cx=\\\"160\\\" cy=\\\"150\\\" r=\\\"36\\\" />\\n      </g>\\n    </svg>\\n\\n    <footer>\\n      <div>{{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n      <div>Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{PRACTITIONER_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfbfb;--ink:#132;--accent:#7b9;--card:#fff}\\n    body{margin:0;font-family:Georgia,serif;color:var(--ink);background:linear-gradient(180deg,#fffefc,#f2fbff)}\\n    .sheet{max-width:880px;margin:48px auto;padding:36px;background:rgba(255,255,255,0.8);border-radius:12px;box-shadow:0 12px 40px rgba(12,20,30,0.06);position:relative}\\n    header{display:flex;gap:20px;align-items:center}\\n    .title{font-family:Cambria,Georgia;line-height:1.05}\\n    h1{margin:0;font-size:28px}\\n    .byline{color:#345;opacity:0.9;margin-top:6px}\\n    nav{margin-top:14px;display:flex;gap:12px}\\n    nav a{font-weight:600;text-decoration:none;color:var(--ink)}\\n    .bio{display:grid;grid-template-columns:1fr 320px;gap:22px;margin-top:18px}\\n    .card{background:var(--card);padding:18px;border-radius:10px;border:1px solid rgba(0,0,0,0.04)}\\n    .credentials{font-weight:700;color:#234;margin-top:6px}\\n    .quote{font-style:italic;color:#456;padding:12px;border-left:3px solid rgba(123,153,153,0.16);margin-top:12px}\\n    .testimonials{display:flex;flex-direction:column;gap:10px}\\n    .test{background:linear-gradient(180deg,rgba(123,153,153,0.02),transparent);padding:10px;border-radius:8px}\\n    .cta{display:inline-block;margin-top:14px;background:linear-gradient(90deg,#6fa,#78a);color:white;padding:10px 14px;border-radius:8px;text-decoration:none;font-weight:700}\\n    .pattern{position:absolute;left:-90px;bottom:-90px;opacity:0.08}\\n    .wrap::before{content:'';position:absolute;inset:0;background-image:url('assets/img/pattern.svg');opacity:0.04}\\n    @media(max-width:880px){.bio{grid-template-columns:1fr}} \\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"sheet\\\">\\n    <header>\\n      <div>\\n        <div class=\\\"title\\\">\\n          <h1>Gentle inquiry, whole-person practice</h1>\\n          <div class=\\\"byline\\\">I am {{PRACTITIONER_NAME}}, {{CREDENTIALS}}—rooted in curious listening and evidence-informed integrative care.</div>\\n        </div>\\n      </div>\\n      <nav style=\\\"margin-left:auto\\\">\\n        <a href=\\\"index.html\\\">Studio</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"conditions.html\\\">Concerns</a>\\n        <a href=\\\"pricing.html\\\">Investment</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"bio\\\">\\n      <div>\\n        <section class=\\\"card\\\">\\n          <h2 style=\\\"margin-top:0;font-size:18px\\\">Philosophy</h2>\\n          <p class=\\\"muted\\\">I view health as a layered landscape where sleep, movement, nutrition, stress, and meaning intersect. Sessions focus on education, practical shifts, and measurable steps—never on quick fixes or promises.</p>\\n\\n          <div class=\\\"credentials\\\">Training & work</div>\\n          <ul style=\\\"margin:10px 0 0 18px;color:#345\\\">\\n            <li>Certifications in integrative medicine, nutrition, and mind-body approaches</li>\\n            <li>Years of clinical practice combining lifestyle medicine with gentle diagnostics</li>\\n            <li>Group learning facilitation for sustainable habits</li>\\n          </ul>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <a class=\\\"cta\\\" href=\\\"book.html\\\">Meet me</a>\\n          </div>\\n        </section>\\n\\n        <section style=\\\"margin-top:12px\\\" class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">Approach in brief</h3>\\n          <ol style=\\\"margin:0 0 0 18px;color:#345\\\">\\n            <li>We listen—goals, history, context</li>\\n            <li>We educate—what affects you and why</li>\\n            <li>We plan—small experiments, measurable outcomes</li>\\n            <li>We follow up—refine and build resilience</li>\\n          </ol>\\n        </section>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n            <div style=\\\"width:64px;height:64px;border-radius:10px;background:linear-gradient(180deg,#cfe,#aee);display:flex;align-items:center;justify-content:center;font-weight:700;color:#033\\\">PM</div>\\n            <div>\\n              <div style=\\\"font-weight:700\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n              <div style=\\\"color:#345;font-size:13px\\\">Practitioner in {{CITY}}, {{STATE}}</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"quote\\\">\\\"True change arrives through steady, curious practice and small reliable habits. I teach the steps and walk beside you.\\\"</div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <div style=\\\"font-size:13px;color:#345\\\">Reach out: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n            <div style=\\\"font-size:13px;color:#345;margin-top:6px\\\">Call: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\" class=\\\"card\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Kind words</h4>\\n          <div class=\\\"testimonials\\\">\\n            <div class=\\\"test\\\">\\\"I learned practical steps that actually fit into my life—slow, steady change.\\\" — A.</div>\\n            <div class=\\\"test\\\">\\\"A gentle approach that taught me to notice patterns instead of blame.\\\" — M.</div>\\n          </div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <svg class=\\\"pattern\\\" width=\\\"320\\\" height=\\\"320\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n      <defs>\\n        <radialGradient id=\\\"rg\\\" cx=\\\"0.3\\\" cy=\\\"0.2\\\"><stop offset=\\\"0\\\" stop-color=\\\"#bfe\\\" /><stop offset=\\\"1\\\" stop-color=\\\"#def\\\" /></radialGradient>\\n      </defs>\\n      <rect width=\\\"200\\\" height=\\\"200\\\" fill=\\\"url(#rg)\\\" opacity=\\\"0.06\\\" rx=\\\"20\\\"/>\\n      <path d=\\\"M20 160c40-30 60-60 120-80\\\" stroke=\\\"#7b9\\\" stroke-width=\\\"6\\\" fill=\\\"none\\\" opacity=\\\"0.08\\\"/>\\n    </svg>\\n\\n    <footer style=\\\"margin-top:20px;color:#445;font-size:13px\\\">\\n      <div>Small-group series, workshops, and individual sessions. Educational resources provided after each visit.</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--ink:#112;--accent:#68a;--card:#fff}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#fbfff9,#f7fbff);color:var(--ink)}\\n    .container{max-width:880px;margin:36px auto;padding:28px;background:rgba(255,255,255,0.9);border-radius:12px;box-shadow:0 12px 30px rgba(10,20,30,0.05);position:relative}\\n    header{display:flex;align-items:baseline;gap:16px}\\n    h1{margin:0;font-size:24px}\\n    nav{margin-left:auto;display:flex;gap:12px}\\n    nav a{text-decoration:none;color:var(--ink);font-weight:600}\\n    .grid{display:grid;grid-template-columns:1fr 340px;gap:22px;margin-top:18px}\\n    form.card{background:var(--card);padding:16px;border-radius:10px;border:1px solid rgba(0,0,0,0.04)}\\n    label{display:block;font-size:13px;margin-top:10px;color:#335}\\n    input,select,textarea{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid rgba(0,0,0,0.06);font-size:14px}\\n    .metas{font-size:13px;color:#456;margin-top:12px}\\n    .submit{margin-top:12px;background:linear-gradient(90deg,var(--accent),#56b);color:white;padding:12px 14px;border-radius:10px;border:none;font-weight:700;cursor:pointer}\\n    .aside{background:linear-gradient(180deg,rgba(104,136,170,0.03),transparent);padding:14px;border-radius:10px}\\n    .lead{color:#334}\\n    .faq{margin-top:12px}\\n    .faq details{background:#fff;padding:10px;border-radius:8px;margin-bottom:8px}\\n    .notice{font-size:13px;color:#445;margin-top:12px}\\n    .wrap::before{content:'';position:absolute;inset:0;background-image:url('assets/img/pattern.svg');opacity:0.05}\\n    .svg-deco{position:absolute;right:-80px;top:-80px;opacity:0.06}\\n    @media(max-width:820px){.grid{grid-template-columns:1fr}} \\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <h1>Reserve a session or series seat</h1>\\n      <nav>\\n        <a href=\\\"index.html\\\">Studio</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"approach.html\\\">How it works</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"grid\\\">\\n      <form class=\\\"card\\\" method=\\\"post\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\">\\n        <label for=\\\"name\\\">Your full name</label>\\n        <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"First Last\\\" required />\\n\\n        <label for=\\\"email\\\">Email</label>\\n        <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required />\\n\\n        <label for=\\\"phone\\\">Phone</label>\\n        <input id=\\\"phone\\\" name=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"(555) 555-5555\\\" />\\n\\n        <label for=\\\"type\\\">I am booking</label>\\n        <select id=\\\"type\\\" name=\\\"type\\\">\\n          <option>Intro Session — 50–60 min</option>\\n          <option>Follow-up — 30–40 min</option>\\n          <option>Monthly Series — cohort seat</option>\\n        </select>\\n\\n        <label for=\\\"notes\\\">Brief notes / goals (optional)</label>\\n        <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"What brings you here? What would you like to learn?\\\"></textarea>\\n\\n        <div class=\\\"metas\\\">Sessions focus on education, measurable steps, and collaboration. No cure promises. Optional labs discussed as educational tools.</div>\\n\\n        <button class=\\\"submit\\\" type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n\\n        <div class=\\\"notice\\\">By reserving you consent to contact at the details provided. For cancellations or questions contact <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>.</div>\\n      </form>\\n\\n      <aside class=\\\"aside\\\">\\n        <div>\\n          <div class=\\\"lead\\\" style=\\\"font-weight:700\\\">Need help choosing?</div>\\n          <p class=\\\"lead\\\" style=\\\"margin-top:8px\\\">Intro sessions map your needs; series are for experiential learning with small groups. Follow-ups keep momentum.</p>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <strong>When to book</strong>\\n            <div class=\\\"muted\\\" style=\\\"color:#345;margin-top:6px\\\">If sleep, digestion, stress, or ongoing low energy are present, an intake helps align steps. We do not offer diagnostic guarantees—education is primary.</div>\\n          </div>\\n\\n          <div class=\\\"faq\\\">\\n            <details>\\n              <summary>What if I need billing help?</summary>\\n              <div style=\\\"margin-top:8px;color:#445\\\">Receipts and codes are available for many clients. Sliding scale may be discussed—please ask.</div>\\n            </details>\\n            <details>\\n              <summary>Can I join a cohort late?</summary>\\n              <div style=\\\"margin-top:8px;color:#445\\\">We prefer full-series attendance for cohesion, but contact us about partial access.</div>\\n            </details>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <a href=\\\"pricing.html\\\" style=\\\"display:inline-block;background:linear-gradient(90deg,#6fa,#78a);color:white;padding:10px 12px;border-radius:8px;text-decoration:none;font-weight:700\\\">See fees & plans</a>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px;font-size:13px;color:#445\\\">\\n          <strong>Quick contact</strong>\\n          <div style=\\\"margin-top:6px\\\">Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n          <div style=\\\"margin-top:6px\\\">Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <svg class=\\\"svg-deco\\\" width=\\\"320\\\" height=\\\"320\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n      <defs>\\n        <linearGradient id=\\\"lg2\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#bde\\\" /><stop offset=\\\"1\\\" stop-color=\\\"#cfe\\\" /></linearGradient>\\n      </defs>\\n      <rect width=\\\"200\\\" height=\\\"200\\\" fill=\\\"url(#lg2)\\\" opacity=\\\"0.06\\\" rx=\\\"40\\\" />\\n      <g fill=\\\"white\\\" opacity=\\\"0.05\\\">\\n        <path d=\\\"M20 100c40-40 80-40 120 0\\\" />\\n        <circle cx=\\\"80\\\" cy=\\\"60\\\" r=\\\"6\\\" />\\n      </g>\\n    </svg>\\n\\n    <footer style=\\\"margin-top:18px;color:#445;font-size:13px\\\">Questions about sessions or suitability? We emphasize education and context—email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>.</footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
