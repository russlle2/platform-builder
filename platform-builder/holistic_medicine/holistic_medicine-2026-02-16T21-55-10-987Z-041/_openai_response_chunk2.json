          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Services</title>\\n  <meta name=\\\"description\\\" content=\\\"Integrative consultations, restorative programs, and gentle support for whole-person health.\\\" />\\n  <style>\\n    :root{--bg:#fbfbfc;--card:#ffffff;--muted:#6b7280;--accent1:#6b9fed;--accent2:#8ad39f;--glass:rgba(255,255,255,0.6);font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial; color-scheme:light}\\n    *{box-sizing:border-box}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg) 0%, #f0f7fb 60%);min-height:100vh;display:flex;flex-direction:column}\\n    header{position:relative;padding:28px 24px;display:flex;align-items:center;justify-content:space-between}\\n    nav{display:flex;gap:14px;align-items:center}\\n    a.logo{font-weight:700;color:#0f172a;text-decoration:none;letter-spacing:0.2px}\\n    a.navlink{color:var(--muted);text-decoration:none;padding:8px 10px;border-radius:8px;font-size:14px}\\n    a.navlink:hover{background:linear-gradient(90deg,rgba(107,159,237,0.12),rgba(138,211,159,0.06));color:#0b1220}\\n    .hero{position:relative;padding:48px 24px;display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:start}\\n    .card{background:var(--card);border-radius:14px;padding:26px;box-shadow:0 6px 18px rgba(15,23,42,0.06)}\\n    h1{margin:0 0 10px;font-size:28px;line-height:1.05;color:#06263f}\\n    p.lead{margin:0;color:var(--muted);font-size:15px}\\n    .aside .cta{display:flex;flex-direction:column;gap:10px;margin-top:14px}\\n    .btn{display:inline-block;background:linear-gradient(90deg,var(--accent1),var(--accent2));color:white;padding:12px 14px;border-radius:10px;text-decoration:none;font-weight:600}\\n    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:18px}\\n    .service{padding:16px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.8),rgba(250,254,255,0.92));border:1px solid rgba(7,30,60,0.04)}\\n    .service h3{margin:0 0 8px;font-size:16px}\\n    .muted{color:var(--muted);font-size:14px}\\n    .ribbon{display:flex;gap:10px;align-items:center;margin-top:14px}\\n    footer{margin-top:auto;padding:22px 24px;color:var(--muted);font-size:13px}\\n    .pattern{position:absolute;inset:0;pointer-events:none;z-index:-1;opacity:0.8}\\n    .social-proof{display:flex;gap:12px;align-items:center;margin-top:18px}\\n    .pill{background:linear-gradient(90deg,#fff,#f7fcff);border-radius:999px;padding:6px 10px;border:1px solid rgba(11,18,32,0.04);font-size:13px}\\n    .faq{margin-top:20px}\\n    details summary{cursor:pointer;padding:10px 12px;border-radius:10px;font-weight:600;background:linear-gradient(180deg,rgba(250,250,252,0.6),rgba(245,249,252,0.6));border:1px solid rgba(8,20,40,0.04)}\\n    .lead-magnet{display:flex;gap:12px;align-items:center;margin-top:20px}\\n    .small{font-size:13px;color:var(--muted)}\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.aside{order: -1}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <a class=\\\"logo\\\" href=\\\"index.html\\\">{{BUSINESS_NAME}}</a>\\n    <nav>\\n      <a class=\\\"navlink\\\" href=\\\"index.html\\\">Begin</a>\\n      <a class=\\\"navlink\\\" href=\\\"services.html\\\">Offerings</a>\\n      <a class=\\\"navlink\\\" href=\\\"conditions.html\\\">Concerns</a>\\n      <a class=\\\"navlink\\\" href=\\\"approach.html\\\">How We Care</a>\\n      <a class=\\\"navlink\\\" href=\\\"book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <div class=\\\"hero\\\">\\n    <svg class=\\\"pattern\\\" width=\\\"100%\\\" height=\\\"100%\\\" viewBox=\\\"0 0 900 600\\\" preserveAspectRatio=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#eaf6ff\\\" />\\n          <stop offset=\\\"1\\\" stop-color=\\\"#f3fff4\\\" />\\n        </linearGradient>\\n        <pattern id=\\\"p1\\\" width=\\\"80\\\" height=\\\"80\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n          <rect width=\\\"80\\\" height=\\\"80\\\" fill=\\\"rgba(255,255,255,0)\\\"/>\\n          <circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"3\\\" fill=\\\"#d6eefc\\\" />\\n          <circle cx=\\\"60\\\" cy=\\\"60\\\" r=\\\"2\\\" fill=\\\"#dff7e8\\\" />\\n        </pattern>\\n      </defs>\\n      <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g1)\\\" />\\n      <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\" opacity=\\\"0.9\\\" />\\n      <g fill-opacity=\\\"0.07\\\" transform=\\\"translate(60,30)\\\">\\n        <circle cx=\\\"180\\\" cy=\\\"120\\\" r=\\\"220\\\" fill=\\\"#6b9fed\\\" />\\n        <circle cx=\\\"540\\\" cy=\\\"360\\\" r=\\\"180\\\" fill=\\\"#8ad39f\\\" />\\n      </g>\\n    </svg>\\n\\n    <div class=\\\"card\\\">\\n      <h1>Seasonal sessions & ongoing support for whole-person vitality</h1>\\n      <p class=\\\"lead\\\">We blend evidence-informed modalities to help you feel steadier in body and mind. Consultations, guided programs, and group events that teach sustainable habits — not quick fixes.</p>\\n\\n      <div class=\\\"social-proof\\\">\\n        <div class=\\\"pill\\\">Trusted in {{CITY}}, {{STATE}}</div>\\n        <div class=\\\"pill\\\">Practitioner: {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n        <div class=\\\"pill\\\">Patient-focused • Education-first</div>\\n      </div>\\n\\n      <div class=\\\"grid\\\" aria-hidden=\\\"false\\\">\\n        <div class=\\\"service\\\">\\n          <h3>Initial Integrative Visit</h3>\\n          <div class=\\\"small\\\">Comprehensive intake, lifestyle mapping, and an initial plan. 60–90 min.</div>\\n        </div>\\n        <div class=\\\"service\\\">\\n          <h3>Follow-up & Momentum Sessions</h3>\\n          <div class=\\\"small\\\">30–45 min sessions to refine habits, supplements, or therapies based on response.</div>\\n        </div>\\n        <div class=\\\"service\\\">\\n          <h3>Restorative Programs (series)</h3>\\n          <div class=\\\"small\\\">Practical multi-week series (sleep, digestion, stress resilience) that include education and coaching.</div>\\n        </div>\\n        <div class=\\\"service\\\">\\n          <h3>Group Workshops & Events</h3>\\n          <div class=\\\"small\\\">Interactive sessions for community learning — topics rotate seasonally.</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"ribbon\\\">\\n        <div class=\\\"muted\\\">Phone: {{PHONE}}</div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </div>\\n\\n    <aside class=\\\"card aside\\\">\\n      <div style=\\\"font-size:13px;color:var(--muted)\\\">Featured offering</div>\\n      <h3 style=\\\"margin-top:8px;margin-bottom:6px\\\">Foundations Series — 6 weeks</h3>\\n      <div class=\\\"small\\\">A gentle, educational series for rebuilding routines: sleep hygiene, nourishment, movement, and stress tools. Includes guided resources and two follow-ups.</div>\\n      <div class=\\\"cta\\\">\\n        <a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve a discovery slot</a>\\n        <a class=\\\"navlink\\\" href=\\\"pricing.html\\\">See event dates & fees</a>\\n      </div>\\n    </aside>\\n  </div>\\n\\n  <main style=\\\"padding:24px\\\">\\n    <section class=\\\"card\\\">\\n      <h2 style=\\\"margin-top:0\\\">How we work with you</h2>\\n      <p class=\\\"muted\\\">A practical flow that centers your story and measurable steps.</p>\\n      <ol style=\\\"margin-top:12px\\\">\\n        <li><strong>Curated intake</strong> — listening, mapping, and prioritizing what matters most.</li>\\n        <li><strong>Personalized plan</strong> — small experiments: movement, stress tools, diet adjustments, and optional labs when helpful.</li>\\n        <li><strong>Support & measure</strong> — short follow-ups to adapt, educate, and empower.</li>\\n      </ol>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:16px\\\">\\n      <h2>Frequently asked</h2>\\n      <div class=\\\"faq\\\">\\n        <details>\\n          <summary>Do you provide prescriptions?</summary>\\n          <div class=\\\"muted\\\">We focus on lifestyle, education, and evidence-informed adjuncts. If prescriptions are appropriate, we coordinate care with your primary clinician.</div>\\n        </details>\\n        <details>\\n          <summary>Are labs necessary?</summary>\\n          <div class=\\\"muted\\\">Labs are optional and used selectively to inform decisions. We explain what they mean and why they might help.</div>\\n        </details>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card lead-magnet\\\">\\n      <div style=\\\"flex:1\\\">\\n        <strong>Free guide:</strong>\\n        <div class=\\\"small\\\">\\\"Three Habits to Reset Your Day\\\" — a one-page starter you can use immediately.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"contact.html\\\">Send me the guide</a>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:16px\\\">\\n      <h2>Why choose a whole-person path?</h2>\\n      <p class=\\\"muted\\\">Health is layered: biology, habits, and environment. Our practice supports learning and gradual change so you build resilience that lasts.</p>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px\\\">\\n      <div>{{BUSINESS_NAME}} — {{TAGLINE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div>© <span id=\\\"year\\\">2026</span> • Serving {{CITY}}, {{STATE}}</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Common Concerns</title>\\n  <meta name=\\\"description\\\" content=\\\"Common concerns we support through education, lifestyle strategies, and integrative planning.\\\" />\\n  <style>\\n    :root{--bg:#fffaf8;--card:#ffffff;--muted:#59626b;--accent:#e0988a;--glass:rgba(255,255,255,0.75);font-family:Georgia, 'Times New Roman', serif}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg),#fff);color:#102028}\\n    header{padding:20px 22px;display:flex;align-items:center;justify-content:space-between}\\n    a.logo{font-weight:700;color:#2b373a;text-decoration:none}\\n    nav{display:flex;gap:12px}\\n    a.navlink{color:var(--muted);text-decoration:none;padding:8px;border-radius:8px}\\n    main{max-width:980px;margin:18px auto;padding:18px}\\n    .hero{background:linear-gradient(180deg,rgba(255,248,246,0.9),#fff);padding:22px;border-radius:12px;border:1px solid rgba(16,32,40,0.04)}\\n    h1{margin:0;font-size:26px}\\n    p.lead{color:var(--muted);margin-top:6px}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:18px}\\n    .concern{padding:14px;border-radius:10px;background:linear-gradient(180deg,#fff,#fffdfd);border:1px solid rgba(0,0,0,0.03)}\\n    .concern h3{margin:0 0 6px}\\n    .muted{color:var(--muted)}\\n    .disclaimer{font-size:13px;color:#7b7f87;margin-top:14px}\\n    .lead-magnet{display:flex;justify-content:space-between;align-items:center;margin-top:18px;padding:14px;border-radius:10px;background:linear-gradient(90deg,rgba(224,152,138,0.06),rgba(255,255,255,0.6));}\\n    footer{padding:18px;text-align:center;color:var(--muted)}\\n    .pattern{width:100%;height:84px;display:block;margin-top:12px}\\n    @media (max-width:720px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <a class=\\\"logo\\\" href=\\\"index.html\\\">{{BUSINESS_NAME}}</a>\\n    <nav>\\n      <a class=\\\"navlink\\\" href=\\\"index.html\\\">Start</a>\\n      <a class=\\\"navlink\\\" href=\\\"services.html\\\">Services</a>\\n      <a class=\\\"navlink\\\" href=\\\"conditions.html\\\">Issues</a>\\n      <a class=\\\"navlink\\\" href=\\\"about.html\\\">About</a>\\n      <a class=\\\"navlink\\\" href=\\\"contact.html\\\">Reach out</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <h1>Common concerns we guide people through</h1>\\n      <p class=\\\"lead\\\">This is educational support for symptoms often linked to lifestyle, stress, sleep, and digestion. We do not offer guaranteed cures; instead we teach and co-create plans.</p>\\n      <svg class=\\\"pattern\\\" viewBox=\\\"0 0 800 80\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" preserveAspectRatio=\\\"none\\\">\\n        <defs>\\n          <linearGradient id=\\\"g2\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#fff6f4\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#fffefc\\\"/></linearGradient>\\n        </defs>\\n        <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g2)\\\"/>\\n        <path d=\\\"M0 60 C120 10 240 110 360 60 C480 10 600 110 720 60 L800 60 L800 80 L0 80 Z\\\" fill=\\\"#ffeae5\\\" opacity=\\\"0.6\\\"/>\\n      </svg>\\n\\n      <div class=\\\"grid\\\" role=\\\"list\\\">\\n        <div class=\\\"concern\\\" role=\\\"listitem\\\">\\n          <h3>Stress & burnout</h3>\\n          <div class=\\\"muted\\\">Teachable tools for resilience: pacing, breath practices, and structure. We focus on practical steps to reduce daily load.</div>\\n        </div>\\n        <div class=\\\"concern\\\" role=\\\"listitem\\\">\\n          <h3>Sleep disturbances</h3>\\n          <div class=\\\"muted\\\">Sleep hygiene, timing, and habit changes. When needed, we discuss rhythm-supportive routines and measurement.</div>\\n        </div>\\n        <div class=\\\"concern\\\" role=\\\"listitem\\\">\\n          <h3>Digestive complaints</h3>\\n          <div class=\\\"muted\\\">Patterns of eating, mindful movement, and gentle dietary adjustments. Labs sometimes help clarify underlying contributors.</div>\\n        </div>\\n        <div class=\\\"concern\\\" role=\\\"listitem\\\">\\n          <h3>Low energy & fatigue</h3>\\n          <div class=\\\"muted\\\">We look at sleep, nourishment, stress, and movement patterns before considering further testing.</div>\\n        </div>\\n        <div class=\\\"concern\\\" role=\\\"listitem\\\">\\n          <h3>Chronic low-level inflammation</h3>\\n          <div class=\\\"muted\\\">Education on inflammatory drivers and lifestyle steps to reduce everyday triggers; lab testing is an optional part of assessment.</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"disclaimer\\\">Important: Individual results vary. The information here is educational and not a substitute for urgent medical care. For acute or severe symptoms, please contact emergency services or your primary clinician.</div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap\\\">\\n      <div style=\\\"flex:1;min-width:260px\\\" class=\\\"card\\\">\\n        <h2 style=\\\"margin:0 0 8px\\\">What we offer</h2>\\n        <p class=\\\"muted\\\">Integrative visits, gradual plans, optional targeted labs, and community workshops that emphasize self-care literacy.</p>\\n        <a href=\\\"approach.html\\\" class=\\\"navlink\\\">Learn about our approach</a>\\n      </div>\\n\\n      <div style=\\\"min-width:240px\\\" class=\\\"lead-magnet\\\">\\n        <div>\\n          <strong>Quick resource</strong>\\n          <div class=\\\"muted\\\">Download: \\\"A simple 7-day reset\\\" — a compact, gentle plan to test small habit changes.</div>\\n        </div>\\n        <div>\\n          <a class=\\\"navlink\\\" href=\\\"contact.html\\\">Get the reset</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h2 style=\\\"margin-top:0\\\">Questions people ask</h2>\\n      <details>\\n        <summary>Will you replace my current doctor?</summary>\\n        <div class=\\\"muted\\\">No. We coordinate with your existing clinicians and offer complementary education and lifestyle-focused planning.</div>\\n      </details>\\n      <details>\\n        <summary>Can you test my hormones or inflammation?</summary>\\n        <div class=\\\"muted\\\">Sometimes. Labs can be useful; we recommend them selectively and explain the meaning and limits of results.</div>\\n      </details>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"padding:12px 18px;color:var(--muted)\\\">\\n      <div>{{BUSINESS_NAME}} — {{TAGLINE}}</div>\\n      <div style=\\\"margin-top:6px\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Our Approach</title>\\n  <meta name=\\\"description\\\" content=\\\"A clear, educational outline of intake, planning, follow-up, and optional investigations we use as tools.\\\" />\\n  <style>\\n    :root{--bg:#f8fff6;--card:#ffffff;--muted:#4b5258;--accent:#5bb3a2;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto}\\n    body{margin:0;background:linear-gradient(180deg,#f8fff6 0%, #ffffff 60%);color:#052028}\\n    header{padding:18px 22px;display:flex;justify-content:space-between;align-items:center}\\n    a.logo{font-weight:700;color:#073033;text-decoration:none}\\n    nav{display:flex;gap:10px}\\n    a.navlink{color:var(--muted);text-decoration:none;padding:8px;border-radius:8px}\\n    main{max-width:980px;margin:18px auto;padding:18px}\\n    .hero{padding:20px;border-radius:12px;background:linear-gradient(180deg,rgba(91,179,162,0.06),rgba(255,255,255,0.85));border:1px solid rgba(5,32,40,0.03)}\\n    h1{margin:0;font-size:28px}\\n    p.lead{color:var(--muted);margin-top:8px}\\n    .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:18px}\\n    .step{padding:14px;border-radius:10px;background:linear-gradient(180deg,#fff,#fbfffc);border:1px solid rgba(6,40,38,0.04)}\\n    .step h4{margin:0 0 6px}\\n    .muted{color:var(--muted)}\\n    .faq{margin-top:18px}\\n    .lead-magnet{margin-top:18px;padding:14px;border-radius:10px;background:linear-gradient(90deg,#eefaf6,#fff)}\\n    .pattern{width:100%;height:120px;display:block;margin-top:12px}\\n    @media (max-width:880px){.steps{grid-template-columns:1fr}} \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <a class=\\\"logo\\\" href=\\\"index.html\\\">{{BUSINESS_NAME}}</a>\\n    <nav>\\n      <a class=\\\"navlink\\\" href=\\\"index.html\\\">Welcome</a>\\n      <a class=\\\"navlink\\\" href=\\\"services.html\\\">Offerings</a>\\n      <a class=\\\"navlink\\\" href=\\\"conditions.html\\\">Concerns</a>\\n      <a class=\\\"navlink\\\" href=\\\"approach.html\\\">Our Way</a>\\n      <a class=\\\"navlink\\\" href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <h1>How a visit unfolds — transparent, educational, collaborative</h1>\\n      <p class=\\\"lead\\\">We treat visits like a dialogue: careful intake, practical experiments, and short, focused follow-ups. Tests are tools — not the default.</p>\\n\\n      <svg class=\\\"pattern\\\" viewBox=\\\"0 0 900 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" preserveAspectRatio=\\\"none\\\">\\n        <defs>\\n          <linearGradient id=\\\"g3\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#f0fff9\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#ffffff\\\"/></linearGradient>\\n        </defs>\\n        <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g3)\\\"/>\\n        <g opacity=\\\"0.08\\\" fill=\\\"#5bb3a2\\\">\\n          <rect x=\\\"40\\\" y=\\\"10\\\" width=\\\"220\\\" height=\\\"100\\\" rx=\\\"14\\\"/>\\n          <rect x=\\\"300\\\" y=\\\"5\\\" width=\\\"220\\\" height=\\\"110\\\" rx=\\\"14\\\"/>\\n          <rect x=\\\"560\\\" y=\\\"18\\\" width=\\\"260\\\" height=\\\"90\\\" rx=\\\"14\\\"/>\\n        </g>\\n      </svg>\\n\\n      <div class=\\\"steps\\\" aria-hidden=\\\"false\\\">\\n        <div class=\\\"step\\\">\\n          <h4>1 — Intake</h4>\\n          <div class=\\\"muted\\\">A generous conversation mapping history, current routines, and priorities. 60–90 minutes for first visits.</div>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <h4>2 — Personalized plan</h4>\\n          <div class=\\\"muted\\\">Clear, measurable steps: sleep anchors, gentle movement, nutrition experiments, and stress tools. Each plan is tailored and adjustable.</div>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <h4>3 — Follow-ups</h4>\\n          <div class=\\\"muted\\\">Short, focused sessions to iterate the plan, troubleshoot obstacles, and teach sustainable habits.</div>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <h4>4 — Optional investigations</h4>\\n          <div class=\\\"muted\\\">When indicated, selective lab tests can clarify questions. We discuss pros/cons and interpret results together — education first.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h2 style=\\\"margin-top:0\\\">Philosophy in a sentence</h2>\\n      <p class=\\\"muted\\\">We prefer small, reversible experiments and clear measuring points. The goal is to increase your confidence and capacity to manage health — not to promise instant cures.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h2>Commonly discussed tests (educational)</h2>\\n      <ul>\\n        <li class=\\\"muted\\\">Basic metabolic panels and blood counts — to rule out common contributors to fatigue.</li>\\n        <li class=\\\"muted\\\">Thyroid and hormone screens — when symptoms suggest imbalance.</li>\\n        <li class=\\\"muted\\\">Targeted inflammation markers — used selectively to inform a plan.</li>\\n        <li class=\\\"muted\\\">Stool or microbiome assessments — sometimes useful for persistent digestive issues; interpretation is nuanced.</li>\\n      </ul>\\n      <div class=\\\"muted\\\">These tests are tools to inform conversation, not one-size-fits-all answers.</div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card faq\\\">\\n      <h2 style=\\\"margin-top:0\\\">Questions about the process</h2>\\n      <details>\\n        <summary>How soon will I feel better?</summary>\\n        <div class=\\\"muted\\\">Timelines vary. Some people notice changes in days with simple habit shifts; others need weeks of practice. We set realistic expectations together.</div>\\n      </details>\\n      <details>\\n        <summary>Will you suggest supplements?</summary>\\n        <div class=\\\"muted\\\">When appropriate, supplements may be offered as short-term tools. We prioritize lifestyle changes and explain why any supplement is recommended.</div>\\n      </details>\\n    </section>\\n\\n    <section class=\\\"lead-magnet\\\" aria-label=\\\"Call to action\\\">\\n      <div>\\n        <strong>Ready to begin?</strong>\\n        <div class=\\\"muted\\\">Schedule a discovery conversation to see if our approach fits your needs.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"navlink\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer style=\\\"padding:18px;text-align:center;color:var(--muted)\\\">\\n    <div>{{BUSINESS_NAME}} • {{PRACTITIONER_NAME}}, {{CREDENTIALS}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
