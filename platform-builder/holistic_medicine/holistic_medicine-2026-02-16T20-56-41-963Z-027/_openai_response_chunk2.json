          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'/>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'/>\\n  <title>Offerings — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#0f1724;--bg2:#0b3a2e;--accent:#a8ffcf;--muted:#bcd8d0;--card:#0e1b18}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--muted);background:linear-gradient(180deg,var(--bg1),var(--bg2));}\\n    .wrap{max-width:1100px;margin:48px auto;padding:28px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(0,0,0,0.12));border-radius:16px;box-shadow:0 10px 40px rgba(2,6,23,0.6);position:relative;overflow:hidden}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#7be9d0);display:flex;align-items:center;justify-content:center;color:#012;font-weight:700;box-shadow:0 6px 20px rgba(0,0,0,0.5)}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:16px;font-size:15px}\\n    nav a.active{color:#fff;border-bottom:2px solid rgba(168,255,207,0.12);padding-bottom:6px}\\n    .hero{display:grid;grid-template-columns:1fr 340px;gap:28px;align-items:start;margin-top:8px}\\n    .hero .lead{padding:20px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent)}\\n    h1{color:#fff;margin:0 0 10px 0;font-size:28px;letter-spacing:0.4px}\\n    p.lead{color:var(--muted);margin:0 0 12px 0;line-height:1.5}\\n    .cta{display:inline-block;background:linear-gradient(90deg,var(--accent),#89ffd6);color:#012;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:600}\\n    .contact{font-size:13px;color:#cde9df;margin-top:8px}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:20px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(0,0,0,0.08));padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .card h3{margin:0 0 8px 0;color:#fff;font-size:16px}\\n    .card p{margin:0;color:var(--muted);font-size:14px}\\n    .retail{margin-top:18px;padding:16px;border-radius:12px;background:linear-gradient(90deg,rgba(120,220,190,0.04),rgba(120,120,140,0.01));border:1px dashed rgba(168,255,207,0.06)}\\n    .retail h4{color:#e8fff6;margin:0 0 8px 0}\\n    .case-notes{margin-top:18px;display:flex;flex-direction:column;gap:8px}\\n    .case-notes .note{background:linear-gradient(180deg,rgba(255,255,255,0.01),rgba(0,0,0,0.06));padding:12px;border-radius:10px;font-size:14px;color:var(--muted)}\\n    .faq{margin-top:18px}\\n    .faq details{background:rgba(255,255,255,0.02);padding:10px;border-radius:8px;margin-bottom:8px}\\n    footer{display:flex;justify-content:space-between;align-items:center;margin-top:22px;padding-top:12px;border-top:1px solid rgba(255,255,255,0.03)}\\n    .pattern-svg{position:absolute;right:-120px;top:-60px;opacity:0.12;width:560px;height:560px;pointer-events:none}\\n    @media (max-width:880px){.hero{grid-template-columns:1fr}.grid{grid-template-columns:1fr}.pattern-svg{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <!-- decorative SVG pattern unique to this page -->\\n  <svg class='pattern-svg' viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'>\\n    <defs>\\n      <linearGradient id='g1' x1='0' x2='1' y1='0' y2='1'>\\n        <stop offset='0' stop-color='#a8ffcf' stop-opacity='0.9'/>\\n        <stop offset='1' stop-color='#7be9d0' stop-opacity='0.6'/>\\n      </linearGradient>\\n      <pattern id='p1' width='20' height='20' patternUnits='userSpaceOnUse'>\\n        <rect width='10' height='10' fill='rgba(255,255,255,0.02)' />\\n        <circle cx='15' cy='5' r='3' fill='url(#g1)' />\\n      </pattern>\\n    </defs>\\n    <rect width='200' height='200' fill='url(#p1)' rx='16'/>\\n    <g fill='none' stroke='rgba(255,255,255,0.06)' stroke-width='1'>\\n      <path d='M14 170 C50 120 140 160 186 20' />\\n    </g>\\n  </svg>\\n\\n  <div class='wrap'>\\n    <header>\\n      <div class='brand'>\\n        <div class='logo'>HM</div>\\n        <div style='line-height:1'>\\n          <div style='color:#fff;font-weight:700'>{{BUSINESS_NAME}}</div>\\n          <div style='font-size:12px;color:var(--muted)'>{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href='index.html'>Home</a>\\n        <a href='services.html' class='active'>Offerings</a>\\n        <a href='conditions.html'>Concerns</a>\\n        <a href='approach.html'>Method</a>\\n        <a href='pricing.html'>Pricing</a>\\n        <a href='about.html'>About</a>\\n        <a href='book.html'>Book</a>\\n        <a href='contact.html'>Contact</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class='hero'>\\n        <div class='lead'>\\n          <h1>Services for whole-person wellbeing</h1>\\n          <p class='lead'>We combine evidence-informed nutrition, herbal wisdom, movement and mind-body approaches to help you move toward balance. Our work is educational and supportive — not a promise of cure.</p>\\n          <a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n          <div class='contact'>Phone: {{PHONE}} • Email: {{EMAIL}}</div>\\n        </div>\\n\\n        <aside style='padding:18px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent)'>\\n          <h3 style='color:#fff;margin-top:0'>Quick intake</h3>\\n          <p style='margin:6px 0;color:var(--muted)'>Initial consults are 60–75 minutes. Follow-ups 30–45 minutes. Labs and supplements offered as optional add-ons.</p>\\n          <a class='cta' href='book.html' style='display:inline-block;margin-top:10px'>Schedule a Visit</a>\\n        </aside>\\n      </section>\\n\\n      <section class='grid' aria-label='services list'>\\n        <div class='card'>\\n          <h3>Integrative Health Consultation</h3>\\n          <p>Whole-person intake, lifestyle mapping, and a collaborative plan rooted in clinical evidence and patient context.</p>\\n        </div>\\n        <div class='card'>\\n          <h3>Nutrition & Functional Food Guidance</h3>\\n          <p>Personalized food-based strategies to address digestion, metabolism, inflammation and energy regulation.</p>\\n        </div>\\n        <div class='card'>\\n          <h3>Herbal & Botanical Recommendations</h3>\\n          <p>Plant-based options selected for safety and synergy — education on interactions and proper sourcing.</p>\\n        </div>\\n        <div class='card'>\\n          <h3>Mind-Body & Stress Resilience</h3>\\n          <p>Breathwork, movement, and behavioral tools to support sleep, stress and nervous-system balance.</p>\\n        </div>\\n      </section>\\n\\n      <section class='retail' aria-label='retail add-ons'>\\n        <h4>Retail add-ons: formulations & supplements</h4>\\n        <p style='margin:0 0 10px 0;color:var(--muted)'>Curated supplements and targeted formulations are offered as a retail add-on when clinically appropriate. All products are discussed transparently; you may decline at any time.</p>\\n        <div style='display:flex;gap:12px;margin-top:12px;flex-wrap:wrap'>\\n          <div style='background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;min-width:200px'>\\n            <strong style='color:#fff'>Digestive Support Trio</strong>\\n            <div style='color:var(--muted);font-size:13px;margin-top:6px'>Enzymes + bitters + herbal support for gentle digestive function.</div>\\n          </div>\\n          <div style='background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;min-width:200px'>\\n            <strong style='color:#fff'>Calming Botanical Blend</strong>\\n            <div style='color:var(--muted);font-size:13px;margin-top:6px'>A standardized formula to support sleep onset and nervous-system balance.</div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section class='case-notes' aria-label='case notes'>\\n        <div class='note'>\\n          <strong style='color:#fff'>Case note:</strong> A client with chronic bloating used dietary patterning, targeted botanicals and supportive breathing practices to move from daily discomfort to more predictable digestion over 4 months (individual results vary).\\n        </div>\\n        <div class='note'>\\n          <strong style='color:#fff'>Case note:</strong> Working with sleep hygiene, a personalised supplement trial and stress management, one client improved sleep continuity. This is educational and not a guaranteed outcome.\\n        </div>\\n      </section>\\n\\n      <section class='faq' aria-label='faq'>\\n        <details>\\n          <summary style='cursor:pointer;color:#fff'>Do you guarantee outcomes?</summary>\\n          <div style='padding-top:8px;color:var(--muted)'>We focus on education and a tailored plan; we cannot guarantee cures. Our goal is sustainable progress and shared decision-making.</div>\\n        </details>\\n        <details>\\n          <summary style='cursor:pointer;color:#fff'>Do you work with lab testing?</summary>\\n          <div style='padding-top:8px;color:var(--muted)'>Optional functional or conventional labs may be recommended for clarity; we explain risks, benefits and costs beforehand.</div>\\n        </details>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div style='font-size:14px;color:var(--muted)'>Prefer a conversation? Call {{PHONE}} • {{EMAIL}}</div>\\n      <div>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}' style='padding:8px 12px;font-size:14px'>{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </footer>\\n\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'/>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'/>\\n  <title>Concerns — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#07131a;--panel:#082426;--accent:#ffd2a6;--muted:#cfe9e1}\\n    html,body{height:100%;margin:0;background:radial-gradient(circle at 10% 10%,#07323a 0%,var(--bg) 40%);font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--muted)}\\n    .shell{max-width:1000px;margin:48px auto;padding:28px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:14px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .logo{background:linear-gradient(90deg,var(--accent),#a3ffcf);width:48px;height:48px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#062;font-weight:700}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:14px}\\n    h1{color:#fff;margin-top:14px}\\n    .lead{color:var(--muted);margin-bottom:12px}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}\\n    .concern{background:linear-gradient(180deg,rgba(255,255,255,0.01),rgba(0,0,0,0.06));padding:16px;border-radius:10px;border-left:4px solid rgba(255,210,166,0.06)}\\n    .concern h3{margin:0;color:#fff}\\n    .concern p{margin:8px 0;color:var(--muted);font-size:14px}\\n    .note{font-size:13px;color:#f6dfc7;background:rgba(255,210,166,0.04);padding:10px;border-radius:8px;margin-top:12px}\\n    .disclaimer{margin-top:12px;color:#f4b7a6;font-size:13px}\\n    footer{margin-top:18px;display:flex;justify-content:space-between;align-items:center}\\n    .pattern{position:absolute;left:-100px;bottom:-80px;opacity:0.08;width:420px;height:420px}\\n    @media (max-width:800px){.grid{grid-template-columns:1fr}.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class='pattern' viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'>\\n    <defs>\\n      <linearGradient id='gg' x1='0' x2='1'><stop offset='0' stop-color='#ffd2a6'/><stop offset='1' stop-color='#a3ffcf'/></linearGradient>\\n      <pattern id='dots' width='16' height='16' patternUnits='userSpaceOnUse'>\\n        <rect width='16' height='16' fill='transparent'></rect>\\n        <circle cx='8' cy='8' r='1.5' fill='#ffd2a6' />\\n      </pattern>\\n    </defs>\\n    <rect width='200' height='200' rx='24' fill='url(#dots)' />\\n    <circle cx='40' cy='40' r='36' fill='url(#gg)' opacity='0.14'/>\\n  </svg>\\n\\n  <div class='shell'>\\n    <header>\\n      <div style='display:flex;align-items:center;gap:12px'>\\n        <div class='logo'>HM</div>\\n        <div>\\n          <div style='color:#fff;font-weight:700'>{{BUSINESS_NAME}}</div>\\n          <div style='font-size:13px;color:var(--muted)'>{{CITY}}, {{STATE}} • {{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href='index.html'>Home</a>\\n        <a href='services.html'>Offerings</a>\\n        <a href='conditions.html' style='font-weight:700;color:#fff'>Concerns</a>\\n        <a href='approach.html'>How we work</a>\\n        <a href='book.html'>Book</a>\\n      </nav>\\n    </header>\\n\\n    <h1>Common concerns we support</h1>\\n    <p class='lead'>Below are frequent health themes we explore together. Each entry is educational — not a promise of cure. If you are experiencing an emergency or severe symptoms, please seek urgent medical care.</p>\\n\\n    <div class='grid'>\\n      <div class='concern'>\\n        <h3>Stress & Anxiety Regulation</h3>\\n        <p>Approaches include breath-based practices, sleep/behavioral strategies, targeted botanicals and lifestyle coaching to improve resilience.</p>\\n      </div>\\n\\n      <div class='concern'>\\n        <h3>Sleep Difficulties</h3>\\n        <p>We emphasize sleep architecture education, circadian-supportive routines, and non-pharmacologic options. Supplements may be used cautiously as an adjunct.</p>\\n      </div>\\n\\n      <div class='concern'>\\n        <h3>Digestion & Gut Function</h3>\\n        <p>Nutritional patterning, targeted botanical and enzyme strategies, and selective testing when indicated to clarify underlying factors.</p>\\n      </div>\\n\\n      <div class='concern'>\\n        <h3>Chronic Inflammation</h3>\\n        <p>Dietary anti-inflammatory patterns, movement therapy and risk-reduction strategies are prioritized; we discuss lab monitoring if helpful.</p>\\n      </div>\\n\\n      <div class='concern'>\\n        <h3>Low Energy & Metabolic Balance</h3>\\n        <p>Assessment looks at sleep, nutrition, thyroid and metabolic context. We focus on sustainable habits and measured interventions.</p>\\n      </div>\\n\\n      <div class='concern'>\\n        <h3>Pain & Musculoskeletal Tension</h3>\\n        <p>Movement-based plans, bodywork referrals, and calming nervous-system tools are commonly useful parts of a personalized plan.</p>\\n      </div>\\n    </div>\\n\\n    <div class='note'>\\n      These summaries are educational. Individual evaluation is required to make safe, effective recommendations. We do not offer guarantees of cure.\\n    </div>\\n\\n    <div class='disclaimer'>If symptoms are sudden, severe, or life-threatening (chest pain, severe shortness of breath, sudden neurological changes), call emergency services immediately.</div>\\n\\n    <footer>\\n      <div style='color:var(--muted)'>Ready to discuss? Call {{PHONE}} or <a href='contact.html' style='color:#fff'>reach out</a>.</div>\\n      <div><a href='book.html' style='background:linear-gradient(90deg,#ffd2a6,#a3ffcf);padding:8px 12px;border-radius:10px;color:#062;text-decoration:none;font-weight:700'>Book a Visit</a></div>\\n    </footer>\\n\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'/>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'/>\\n  <title>Method & Process — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#061212;--panel:#083c3a;--accent:#d7f8ff;--muted:#c8ece9}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg),#042f2f);font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--muted)}\\n    .container{max-width:1050px;margin:48px auto;padding:28px;border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(0,0,0,0.06))}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);margin-left:14px;text-decoration:none}\\n    h1{color:#fff}\\n    .steps{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:18px}\\n    .flow{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:16px;border-radius:12px}\\n    .flow ol{margin:0;padding-left:18px}\\n    .flow li{margin:10px 0;color:var(--muted)}\\n    .panel{padding:14px;border-radius:10px;background:linear-gradient(180deg,rgba(215,248,255,0.03),transparent);border-left:4px solid rgba(215,248,255,0.06)}\\n    .labs{margin-top:12px}\\n    .case{margin-top:14px;padding:12px;border-radius:10px;background:rgba(255,255,255,0.02)}\\n    footer{margin-top:20px;display:flex;justify-content:space-between;align-items:center}\\n    .bg-deco{position:absolute;right:-120px;top:40px;opacity:0.08;width:420px;height:420px}\\n    @media (max-width:900px){.steps{grid-template-columns:1fr}.bg-deco{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class='bg-deco' viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'>\\n    <defs>\\n      <linearGradient id='gA' x1='0' x2='1'><stop offset='0' stop-color='#d7f8ff'/><stop offset='1' stop-color='#a7fff2'/></linearGradient>\\n      <pattern id='hex' width='32' height='32' patternUnits='userSpaceOnUse'>\\n        <rect width='32' height='32' fill='transparent'/>\\n        <path d='M16 2 L26 8 L26 24 L16 30 L6 24 L6 8 Z' fill='rgba(167,255,242,0.08)' />\\n      </pattern>\\n    </defs>\\n    <rect width='200' height='200' rx='28' fill='url(#hex)' />\\n    <circle cx='150' cy='30' r='48' fill='url(#gA)' opacity='0.12'/>\\n  </svg>\\n\\n  <div class='container'>\\n    <header>\\n      <div>\\n        <div style='color:#fff;font-weight:700'>{{BUSINESS_NAME}}</div>\\n        <div style='font-size:13px;color:var(--muted)'>{{PRACTITIONER_NAME}} {{CREDENTIALS}} — {{TAGLINE}}</div>\\n      </div>\\n      <nav>\\n        <a href='index.html'>Home</a>\\n        <a href='services.html'>Services</a>\\n        <a href='conditions.html'>Concerns</a>\\n        <a href='approach.html' style='font-weight:700;color:#fff'>Method</a>\\n        <a href='contact.html'>Contact</a>\\n      </nav>\\n    </header>\\n\\n    <h1>How we work — a stepwise, collaborative practice</h1>\\n    <p style='color:var(--muted);margin-top:8px'>Our process centers on careful intake, evidence-informed planning and iterative follow-up. Labs and supplements are optional and always explained with risks and benefits.</p>\\n\\n    <section class='steps'>\\n      <div class='flow'>\\n        <ol>\\n          <li><strong>Intake & Narrative mapping</strong> — A 60–75 minute visit to explore history, lifestyle, goals and context. We listen more than we speak and gather what matters.</li>\\n          <li><strong>Assessment & shared priorities</strong> — We synthesize findings and co-create what to address first, considering safety, feasibility and personal values.</li>\\n          <li><strong>Personalized plan</strong> — Food-based strategies, movement, sleep hygiene, mind-body tools, and targeted botanicals where appropriate. No guarantees, only tailored recommendations.</li>\\n          <li><strong>Optional labs</strong> — When useful, we may suggest conventional or functional testing as an educational tool to clarify mechanisms; testing is elective and explained.</li>\\n          <li><strong>Follow-up & refinement</strong> — Regular check-ins to track outcomes, adjust dosing or approaches, and focus on sustainable habits.</li>\\n        </ol>\\n\\n        <div class='panel'>\\n          <strong>What to expect</strong>\\n          <p style='margin:8px 0;color:var(--muted)'>Education-forward visits, a collaborative tone, and a plan you can adapt. We emphasize safety and transparent options.</p>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div style='padding:12px;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent)'>\\n          <h3 style='margin-top:0;color:#fff'>Follow-up cadence</h3>\\n          <p style='color:var(--muted)'>Typical plans include a 4–8 week follow-up after initial changes, then monthly or as clinically indicated. We track symptoms, function and quality of life.</p>\\n          <div style='margin-top:8px;'>\\n            <a href='book.html' style='background:linear-gradient(90deg,#d7f8ff,#a7fff2);padding:8px 10px;border-radius:8px;color:#012;text-decoration:none;font-weight:700'>Schedule</a>\\n          </div>\\n        </div>\\n\\n        <div class='labs'>\\n          <h4 style='color:#fff;margin-bottom:6px'>About optional labs</h4>\\n          <p style='color:var(--muted);font-size:14px'>Labs can refine a plan but are not always necessary. We discuss what each test might change and the limitations of interpretation.</p>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class='case'>\\n      <strong style='color:#fff'>Example:</strong>\\n      <p style='color:var(--muted);margin:8px 0'>A patient with disrupted sleep and low daytime energy followed a staged plan combining sleep timing, brief supplement trial and breathwork; outcomes improved over several months. Results are individual and not guaranteed.</p>\\n    </section>\\n\\n    <section style='margin-top:14px'>\\n      <h3 style='color:#fff;margin-bottom:8px'>Collaboration & referrals</h3>\\n      <p style='color:var(--muted)'>We partner with conventional providers and allied therapists when needed to ensure safety and comprehensive care. Your autonomy and choices guide all recommendations.</p>\\n    </section>\\n\\n    <footer>\\n      <div style='color:var(--muted)'>Questions? Email <a href='mailto:{{EMAIL}}' style='color:#fff'>{{EMAIL}}</a> or call {{PHONE}}.</div>\\n      <div><a href='{{PRIMARY_CTA_URL}}' style='background:linear-gradient(90deg,#a7fff2,#d7f8ff);padding:8px 12px;border-radius:10px;color:#012;text-decoration:none;font-weight:700'>{{PRIMARY_CTA_LABEL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
