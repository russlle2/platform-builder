          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Membership & Pricing — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfbfd;--muted:#6b7280;--accent1:#6ee7b7;--accent2:#60a5fa;--card:#ffffff;--glass:rgba(255,255,255,0.6);--shadow:0 8px 30px rgba(14,22,54,0.08)}\\n    html,body{height:100%;margin:0;font-family:Inter, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;color:#0f172a;background:linear-gradient(180deg,var(--bg),#f6f8fb)}\\n    nav{display:flex;gap:20px;align-items:center;padding:22px 40px;position:relative;z-index:10}\\n    nav a{color:#0f172a;text-decoration:none;font-weight:600}\\n    .wrap{max-width:1100px;margin:0 auto;padding:30px}\\n    .diagonal{display:grid;grid-template-columns:1fr 460px;gap:40px;align-items:stretch;margin:20px auto;max-width:1200px}\\n    .left{position:relative;padding:48px;border-radius:18px;background:linear-gradient(160deg,var(--accent1),var(--accent2));color:#05203a;overflow:hidden}\\n    .left h1{margin:0 0 12px;font-size:28px}\\n    .left p{margin:0 0 18px;color:rgba(3,7,18,0.85)}\\n    .pattern{position:absolute;inset:0;opacity:0.14}\\n    .right{background:var(--card);border-radius:18px;padding:28px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:18px}\\n    .tier{display:flex;justify-content:space-between;align-items:center;padding:14px;border-radius:12px;border:1px solid #eef2ff;background:linear-gradient(180deg,rgba(255,255,255,0.6),rgba(255,255,255,0.4))}\\n    .tier h3{margin:0;font-size:16px}\\n    .price{font-weight:800;color:#0f172a}\\n    .muted{color:var(--muted);font-size:13px}\\n    .cta{display:inline-block;padding:12px 18px;border-radius:10px;background:#041125;color:white;text-decoration:none;font-weight:700}\\n    .benefits{display:grid;grid-template-columns:1fr 1fr;gap:10px}\\n    .pill{background:#f8fcf8;border-radius:8px;padding:10px;font-size:13px}\\n    .faq{margin-top:6px}\\n    footer{margin:28px auto;text-align:center;color:var(--muted);font-size:13px}\\n    @media(max-width:900px){.diagonal{grid-template-columns:1fr;padding:20px}.right{order:2}.left{order:1}}\\n  </style>\\n</head>\\n<body>\\n  <nav class=\\\"wrap\\\">\\n    <a href=\\\"index.html\\\">Home</a>\\n    <a href=\\\"services.html\\\">Services</a>\\n    <a href=\\\"conditions.html\\\">Concerns</a>\\n    <a href=\\\"approach.html\\\">Our Way</a>\\n    <a href=\\\"pricing.html\\\" aria-current=\\\"page\\\">Membership</a>\\n    <a href=\\\"about.html\\\">Team</a>\\n    <a href=\\\"book.html\\\">Reserve</a>\\n    <a href=\\\"contact.html\\\">Reach</a>\\n  </nav>\\n\\n  <div class=\\\"diagonal wrap\\\">\\n    <div class=\\\"left\\\">\\n      <svg class=\\\"pattern\\\" viewBox=\\\"0 0 800 600\\\" preserveAspectRatio=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n        <defs>\\n          <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n            <stop offset=\\\"0\\\" stop-color=\\\"#ffffff\\\" stop-opacity=\\\"0.18\\\"/>\\n            <stop offset=\\\"1\\\" stop-color=\\\"#05203a\\\" stop-opacity=\\\"0.06\\\"/>\\n          </linearGradient>\\n          <pattern id=\\\"pPricing\\\" width=\\\"120\\\" height=\\\"120\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(18)\\\">\\n            <rect width=\\\"120\\\" height=\\\"120\\\" fill=\\\"transparent\\\"/>\\n            <circle cx=\\\"10\\\" cy=\\\"10\\\" r=\\\"2.5\\\" fill=\\\"#ffffff\\\" opacity=\\\"0.12\\\"/>\\n            <circle cx=\\\"60\\\" cy=\\\"60\\\" r=\\\"2\\\" fill=\\\"#ffffff\\\" opacity=\\\"0.08\\\"/>\\n            <circle cx=\\\"100\\\" cy=\\\"20\\\" r=\\\"3\\\" fill=\\\"#ffffff\\\" opacity=\\\"0.06\\\"/>\\n          </pattern>\\n        </defs>\\n        <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#pPricing)\\\"/>\\n        <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g1)\\\"/>\\n      </svg>\\n      <h1>Memberships that nurture your whole life</h1>\\n      <p>Choose steady support for lifestyle shifts, ongoing coaching, and periodic assessments. Memberships focus on education, prevention, and measurable habit change—not guaranteed cures.</p>\\n      <div style=\\\"display:flex;gap:12px;flex-wrap:wrap\\\">\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <a href=\\\"about.html\\\" style=\\\"padding:12px 18px;border-radius:10px;background:rgba(255,255,255,0.16);color:inherit;text-decoration:none;font-weight:700\\\">Meet the team</a>\\n      </div>\\n    </div>\\n\\n    <aside class=\\\"right\\\" aria-labelledby=\\\"plansTitle\\\">\\n      <h2 id=\\\"plansTitle\\\">Plans — simple tiers with human care</h2>\\n      <p class=\\\"muted\\\">Monthly subscriptions. Annual billing available as 10% savings. Cancel anytime. Services emphasize guidance, education, and coordinated care; lab tests or prescriptions may be recommended as educational options when appropriate.</p>\\n\\n      <div class=\\\"tier\\\">\\n        <div>\\n          <h3>Foundations</h3>\\n          <div class=\\\"muted\\\">Ideal to begin learning and steady check-ins</div>\\n        </div>\\n        <div style=\\\"text-align:right\\\">\\n          <div class=\\\"price\\\">$49<span class=\\\"muted\\\">/mo</span></div>\\n          <div class=\\\"muted\\\" style=\\\"font-size:12px\\\">1x virtual check-in / month</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <div>\\n          <h3>Essentials</h3>\\n          <div class=\\\"muted\\\">Deeper planning, labs consulted as educational tools</div>\\n        </div>\\n        <div style=\\\"text-align:right\\\">\\n          <div class=\\\"price\\\">$99<span class=\\\"muted\\\">/mo</span></div>\\n          <div class=\\\"muted\\\" style=\\\"font-size:12px\\\">Includes care plan + 2 check-ins</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <div>\\n          <h3>WholeCare</h3>\\n          <div class=\\\"muted\\\">Comprehensive coordination and priority scheduling</div>\\n        </div>\\n        <div style=\\\"text-align:right\\\">\\n          <div class=\\\"price\\\">$149<span class=\\\"muted\\\">/mo</span></div>\\n          <div class=\\\"muted\\\" style=\\\"font-size:12px\\\">Extended consults, 24/7 messaging access</div>\\n        </div>\\n      </div>\\n\\n      <div>\\n        <h4 style=\\\"margin:8px 0 6px\\\">What you get</h4>\\n        <div class=\\\"benefits\\\">\\n          <div class=\\\"pill\\\">Personalized intake & care plan</div>\\n          <div class=\\\"pill\\\">Lifestyle, nutrition & sleep coaching</div>\\n          <div class=\\\"pill\\\">Guided supplement education</div>\\n          <div class=\\\"pill\\\">Optional educational labs reviewed together</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"faq\\\">\\n        <h4 style=\\\"margin:14px 0 6px\\\">Quick questions</h4>\\n        <div class=\\\"muted\\\">Are labs included? — Labs are optional and billed separately. Any testing recommended is for educational understanding and shared decision-making.</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Do you promise cures? — No. We aim to reduce symptoms and support function through whole-person strategies; individual outcomes vary.</div>\\n      </div>\\n\\n      <div style=\\\"display:flex;gap:10px;margin-top:12px\\\">\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Join a plan</a>\\n        <a href=\\\"book.html\\\" style=\\\"padding:10px 14px;border-radius:10px;background:#eef2ff;color:#0f172a;text-decoration:none;font-weight:700\\\">Book consult</a>\\n      </div>\\n\\n    </aside>\\n  </div>\\n\\n  <div class=\\\"wrap\\\" style=\\\"max-width:1000px\\\">\\n    <section style=\\\"background:var(--card);border-radius:14px;padding:18px;box-shadow:var(--shadow)\\\">\\n      <h3 style=\\\"margin-top:0\\\">Commitment, not a promise</h3>\\n      <p class=\\\"muted\\\">Memberships are designed for gradual, sustainable change: coaching, accountability, and education toward better sleep, digestion, stress resilience, inflammation management, and energy. We cannot guarantee specific medical outcomes; members receive prioritized access and continuous learning supports.</p>\\n    </section>\\n  </div>\\n\\n  <footer>\\n    <div class=\\\"wrap\\\">Questions? Call {{PHONE}} • Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffdfa;--deep:#032a2b;--accent:#ffd6a5;--soft:#fff6f0}\\n    body{margin:0;font-family:Georgia, 'Times New Roman', serif;background:linear-gradient(180deg,var(--bg),#f7fafc);color:var(--deep)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:26px 36px}\\n    header nav a{margin-left:18px;color:var(--deep);text-decoration:none;font-weight:600}\\n    .hero{display:grid;grid-template-columns:1fr 380px;gap:30px;align-items:center;padding:24px 36px}\\n    .card{background:linear-gradient(180deg,var(--soft),white);border-radius:14px;padding:20px;box-shadow:0 10px 30px rgba(2,6,23,0.06)}\\n    .bio h1{margin:0 0 8px;font-family:Inter, system-ui, sans-serif;font-size:26px}\\n    .bio p{margin:0;color:#374151}\\n    .stats{display:flex;gap:10px;margin-top:16px}\\n    .stat{background:#fff;border-radius:10px;padding:10px;font-weight:700}\\n    .case{margin-top:16px;padding:12px;border-left:4px solid #ffd6a5;background:#fffdf8;border-radius:8px}\\n    .svg-bg{position:absolute;right:40px;top:20px;opacity:0.06;transform:rotate(12deg)}\\n    footer{padding:22px 36px;color:#6b7280;font-size:13px}\\n    @media(max-width:900px){.hero{grid-template-columns:1fr;padding:18px}.svg-bg{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:18px\\\">\\n      <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n      <div style=\\\"color:#6b7280\\\">{{TAGLINE}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Back</a>\\n      <a href=\\\"services.html\\\">What We Offer</a>\\n      <a href=\\\"conditions.html\\\">Common Concerns</a>\\n      <a href=\\\"approach.html\\\">Our Process</a>\\n      <a href=\\\"pricing.html\\\">Plans</a>\\n      <a href=\\\"about.html\\\" aria-current=\\\"page\\\">About</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"hero wrap\\\" style=\\\"max-width:1100px;margin:0 auto;position:relative\\\">\\n    <div class=\\\"card bio\\\">\\n      <h1>Hi — I\\u2019m {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</h1>\\n      <p>My approach blends evidence-aware natural therapies with practical lifestyle change. I listen for the story beneath symptoms: sleep patterns, stress rhythms, digestion, environment, and meaning. My goal is to equip you to be your own best clinician through education, not to promise instant fixes.</p>\\n\\n      <div class=\\\"stats\\\">\\n        <div class=\\\"stat\\\">20+ years experience</div>\\n        <div class=\\\"stat\\\">4,000+ consults</div>\\n        <div class=\\\"stat\\\">Member-first care</div>\\n      </div>\\n\\n      <div class=\\\"case\\\" aria-hidden=\\\"false\\\">\\n        <strong>Case note (anonymized):</strong>\\n        <p style=\\\"margin:8px 0 0;color:#374151\\\">A 38-year-old came with chronic fatigue and bloating. Through dietary rhythm coaching, sleep consolidation, and targeted lab interpretation (education only), the person reported more energy and reduced interruptions to daily life within three months. This is an illustrative example, not a guarantee of outcome.</p>\\n      </div>\\n\\n      <p style=\\\"margin-top:14px;color:#374151\\\">Outside clinical work, I teach workshops on restorative sleep, gentle movement, and stress education. I collaborate with primary care and specialists when integrated care benefits the person.\\n      </p>\\n\\n      <div style=\\\"margin-top:14px\\\">\\n        <a href=\\\"book.html\\\" style=\\\"padding:10px 16px;background:#052a2a;color:white;border-radius:10px;text-decoration:none;font-weight:700\\\">Reserve a consult</a>\\n        <a href=\\\"pricing.html\\\" style=\\\"margin-left:10px;padding:10px 16px;background:transparent;border-radius:10px;border:1px solid #e6e9ef;text-decoration:none;color:inherit\\\">See memberships</a>\\n      </div>\\n    </div>\\n\\n    <aside style=\\\"position:relative;\\\">\\n      <div class=\\\"card\\\" style=\\\"padding:20px\\\">\\n        <h3 style=\\\"margin-top:0\\\">Philosophy</h3>\\n        <p style=\\\"color:#374151\\\">We tend to the whole person: body systems, sleep, stress resilience, and meaningful routines. Our recommendations are rooted in current evidence and tailored to your life, preferences, and goals, with a focus on education and shared decision-making.</p>\\n\\n        <h4 style=\\\"margin-top:12px\\\">Training & influences</h4>\\n        <ul style=\\\"margin:8px 0 0 16px;color:#374151\\\">\\n          <li>Integrative clinical training</li>\\n          <li>Functional lab interpretation (educational)</li>\\n          <li>Behavioral coaching & sleep science</li>\\n        </ul>\\n      </div>\\n\\n      <svg class=\\\"svg-bg\\\" width=\\\"240\\\" height=\\\"240\\\" viewBox=\\\"0 0 240 240\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n        <defs>\\n          <pattern id=\\\"pAbout\\\" width=\\\"80\\\" height=\\\"80\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n            <rect width=\\\"80\\\" height=\\\"80\\\" fill=\\\"transparent\\\"/>\\n            <path d=\\\"M0 40 Q20 0 40 40 T80 40\\\" stroke=\\\"#ffd6a5\\\" stroke-opacity=\\\"0.18\\\" fill=\\\"none\\\"/>\\n          </pattern>\\n        </defs>\\n        <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#pAbout)\\\"/>\\n      </svg>\\n    </aside>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>Serving {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div>Phone: {{PHONE}}</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Schedule — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f7fbfb;--card:#ffffff;--accent:#9be7ff;--ink:#04223a}\\n    body{margin:0;font-family:Inter, ui-sans-serif, system-ui, -apple-system,'Segoe UI',Roboto;background:linear-gradient(180deg,var(--bg),#ffffff);color:var(--ink)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 28px}\\n    header nav a{margin-left:14px;text-decoration:none;color:var(--ink);font-weight:600}\\n    .stage{max-width:1000px;margin:20px auto;padding:22px;display:grid;grid-template-columns:1fr 360px;gap:22px}\\n    .form-card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 12px 30px rgba(3,12,34,0.06)}\\n    label{display:block;font-size:13px;margin-bottom:6px;font-weight:700}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #dbeafe;margin-bottom:12px;font-size:14px}\\n    .submit{background:linear-gradient(90deg,#06b6d4,#60a5fa);color:white;padding:12px 14px;border-radius:10px;border:none;font-weight:800}\\n    .aside{position:relative}\\n    .note{background:linear-gradient(180deg,#fff,#fbfdff);padding:14px;border-radius:10px;border:1px solid #e6f0f9}\\n    .disclaimer{font-size:12px;color:#6b7280}\\n    footer{margin-top:24px;text-align:center;color:#6b7280;padding-bottom:36px}\\n    @media(max-width:900px){.stage{grid-template-columns:1fr;padding:12px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Return</a>\\n      <a href=\\\"services.html\\\">Programs</a>\\n      <a href=\\\"conditions.html\\\">Symptoms</a>\\n      <a href=\\\"approach.html\\\">Process</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\" aria-current=\\\"page\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Say hi</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"stage\\\">\\n    <form class=\\\"form-card\\\" action=\\\"{{PRIMARY_CTA_URL}}?source=booking\\\" method=\\\"POST\\\">\\n      <h2 style=\\\"margin-top:0\\\">Reserve a visit</h2>\\n      <p class=\\\"disclaimer\\\">Booking initiates a clinical intake. We do not guarantee outcomes. Please list current concerns and any medications or supplements.</p>\\n\\n      <label for=\\\"name\\\">Full name</label>\\n      <input id=\\\"name\\\" name=\\\"name\\\" required placeholder=\\\"Your name\\\" />\\n\\n      <label for=\\\"email\\\">Email</label>\\n      <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required placeholder=\\\"you@example.com\\\" />\\n\\n      <label for=\\\"phone\\\">Phone</label>\\n      <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"(555) 555-5555\\\" />\\n\\n      <label for=\\\"service\\\">Service</label>\\n      <select id=\\\"service\\\" name=\\\"service\\\">\\n        <option>New patient intake (60m)</option>\\n        <option>Follow-up (30m)</option>\\n        <option>Membership consultation (20m)</option>\\n      </select>\\n\\n      <label for=\\\"datetime\\\">Preferred date/time</label>\\n      <input id=\\\"datetime\\\" name=\\\"datetime\\\" type=\\\"text\\\" placeholder=\\\"e.g. Weekday mornings, 9-11am\\\" />\\n\\n      <label for=\\\"notes\\\">Brief notes - what brings you here?</label>\\n      <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Sleep, digestion, stress, energy…\\\"></textarea>\\n\\n      <label style=\\\"display:flex;gap:10px;align-items:center\\\"><input type=\\\"checkbox\\\" name=\\\"membership\\\"/> Interested in membership options</label>\\n\\n      <div style=\\\"display:flex;gap:10px;margin-top:8px\\\">\\n        <button class=\\\"submit\\\" type=\\\"submit\\\">Request appointment</button>\\n        <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:inline-block;padding:10px 14px;border-radius:10px;background:transparent;border:1px solid #e6eef7;text-decoration:none;color:inherit\\\">Contact us</a>\\n      </div>\\n\\n      <p class=\\\"disclaimer\\\" style=\\\"margin-top:8px\\\">If urgent, call {{PHONE}}. Submitting this form does not create an emergency visit.</p>\\n    </form>\\n\\n    <aside class=\\\"aside\\\">\\n      <div class=\\\"form-card note\\\">\\n        <h3 style=\\\"margin-top:0\\\">Before your first visit</h3>\\n        <ul style=\\\"margin:8px 0 0 18px;color:#264653\\\">\\n          <li>Complete the intake form you\\u2019ll receive by email.</li>\\n          <li>Bring a list of current meds & supplements.</li>\\n          <li>Be ready to discuss sleep patterns, stress, digestion, energy, and goals.</li>\\n        </ul>\\n\\n        <h4 style=\\\"margin-top:12px\\\">Fees & insurance</h4>\\n        <p class=\\\"disclaimer\\\">We offer membership and private-pay options. Some services may be eligible for reimbursement; check with your provider. Labs billed separately when ordered as an educational tool.</p>\\n      </div>\\n\\n      <div style=\\\"height:18px\\\"></div>\\n\\n      <div class=\\\"form-card note\\\">\\n        <h4 style=\\\"margin-top:0\\\">Privacy & consent</h4>\\n        <p class=\\\"disclaimer\\\">Your information is kept confidential. Communications may be used to coordinate care. By booking you consent to receive appointment communications via email or phone.</p>\\n        <div style=\\\"margin-top:8px;font-size:13px\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </aside>\\n  </main>\\n\\n  <footer>\\n    <div>Serving {{CITY}}, {{STATE}} • Phone: {{PHONE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
