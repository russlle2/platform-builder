          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Tariff — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Flexible integrative packages and transparent pricing.\\\">\\n  <style>\\n    :root{--bg:#fbfbf8;--card:#ffffff;--muted:#6b6b6b;--accent:#6c8b6b;--accent-2:#9bb39b;--glass:rgba(255,255,255,0.7);--mono:#111}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--mono);background:linear-gradient(180deg,#fbfbf8 0%,#f4f7f3 100%)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px;background:transparent}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:46px;height:46px;border-radius:8px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:grid;place-items:center;color:white;font-weight:700}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-size:14px}\\n    .hero{padding:44px 28px;display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    .hero .lead{background:var(--card);padding:26px;border-radius:12px;box-shadow:0 6px 24px rgba(24,24,24,0.05)}\\n    h1{margin:0 0 8px 0;font-size:28px}\\n    p.lead-copy{margin:0;color:var(--muted);line-height:1.5}\\n    .lead .cta{margin-top:16px}\\n    .cta a{display:inline-block;background:linear-gradient(90deg,var(--accent),var(--accent-2));color:white;padding:10px 16px;border-radius:8px;text-decoration:none}\\n    .pricing-grid{display:flex;flex-direction:column;gap:14px;padding:20px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(18,18,18,0.04);display:flex;flex-direction:column;gap:10px}\\n    .card h3{margin:0;font-size:18px}\\n    .price{font-size:22px;font-weight:700}\\n    ul.features{margin:0;padding-left:18px;color:var(--muted)}\\n    .legal{font-size:12px;color:var(--muted)}\\n    .gallery{margin-top:18px;background:linear-gradient(180deg,rgba(108,139,107,0.06),transparent);padding:12px;border-radius:10px}\\n    .testimony{min-height:72px;display:grid;align-items:center}\\n    .badges{display:flex;gap:8px;margin-top:12px}\\n    .badge{background:var(--glass);padding:8px 10px;border-radius:8px;font-size:13px;position:relative}\\n    .badge .tip{position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);background:#222;color:#fff;padding:6px 8px;border-radius:6px;font-size:12px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .18s}\\n    .badge:hover .tip{opacity:1}\\n    footer{padding:18px 28px;font-size:13px;color:var(--muted);display:flex;justify-content:space-between}\\n    .pattern{position:fixed;right:0;bottom:0;opacity:0.15;width:320px;height:320px;background-image:url('assets/img/pattern.svg');background-size:cover;pointer-events:none}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.pricing-grid{order:2}.hero .lead{order:1}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:600\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"conditions.html\\\">Conditions</a>\\n      <a href=\\\"approach.html\\\">Method</a>\\n      <a href=\\\"pricing.html\\\" style=\\\"color:var(--accent)\\\">Tariff</a>\\n      <a href=\\\"about.html\\\">Story</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"lead\\\">\\n        <h1>Pathways and pricing tuned to life’s pace</h1>\\n        <p class=\\\"lead-copy\\\">Choose a structure that fits your rhythm — short-cycle guidance, deeper twelve-week courses, or ongoing integrative mentorship. Transparent tiers, clear inclusions, and a learning-first approach.</p>\\n        <div class=\\\"cta\\\"><a href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n      </div>\\n\\n      <aside class=\\\"pricing-grid\\\" aria-label=\\\"Pricing options\\\">\\n        <div class=\\\"card\\\">\\n          <h3>Seed Session</h3>\\n          <div class=\\\"price\\\">$120 — single consult</div>\\n          <p class=\\\"legal\\\">A focused 60‑minute intake and targeted plan. Educational, non-diagnostic; not a substitute for medical care.</p>\\n          <ul class=\\\"features\\\">\\n            <li>Comprehensive intake</li>\\n            <li>One focused pathway with 2–3 actions</li>\\n            <li>Email follow‑up (7 days)</li>\\n          </ul>\\n          <div><a href=\\\"book.html\\\">Begin with Seed</a></div>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <h3>Root Cycle</h3>\\n          <div class=\\\"price\\\">$420 — 6 weeks</div>\\n          <p class=\\\"legal\\\">Structured six-week cycle with two live check-ins and daily micro-habits. Educational guidance toward sustainable habits.</p>\\n          <ul class=\\\"features\\\">\\n            <li>Initial intake + 2 coaching calls</li>\\n            <li>Personalized micro-habit plan</li>\\n            <li>Resource pack and habit tracker</li>\\n          </ul>\\n          <div><a href=\\\"book.html\\\">Reserve Root Cycle</a></div>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <h3>Bloom Mentorship</h3>\\n          <div class=\\\"price\\\">$1200 — 3 months</div>\\n          <p class=\\\"legal\\\">Ongoing mentorship for complex patterns, cadence referrals, and lifestyle redesign. Educational and supportive; clinical decisions made with your primary providers.</p>\\n          <ul class=\\\"features\\\">\\n            <li>Weekly sessions + messaging</li>\\n            <li>Cross-disciplinary coordination</li>\\n            <li>30‑day habit integration plan</li>\\n          </ul>\\n          <div><a href=\\\"book.html\\\">Join Bloom</a></div>\\n        </div>\\n\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"padding:0 28px 28px\\\">\\n      <div class=\\\"gallery\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <strong>Proof Gallery</strong>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">Real notes, rotated</div>\\n        </div>\\n        <div id=\\\"testimony\\\" class=\\\"testimony\\\" style=\\\"padding-top:8px;color:#223\\\">\\n          \\\"A pragmatic set of steps that felt made for my daily week — small wins, steady confidence.\\\"\\n        </div>\\n        <div class=\\\"badges\\\" aria-hidden=\\\"false\\\">\\n          <div class=\\\"badge\\\">Peer-Reviewed Tip<span class=\\\"tip\\\">Our resources cite peer-reviewed literature where relevant.</span></div>\\n          <div class=\\\"badge\\\">Local Clinic Referrals<span class=\\\"tip\\\">We work with clinics in {{CITY}} for integrated care pathways.</span></div>\\n          <div class=\\\"badge\\\">Continuing Education<span class=\\\"tip\\\">Clinician has CE credits in integrative approaches.</span></div>\\n        </div>\\n      </div>\\n      <div style=\\\"margin-top:12px;font-size:12px;color:var(--muted)\\\">Testimonials are selected summaries of client feedback; experiences vary. Services are educational and supportive, not curative guarantees.</div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    <div style=\\\"color:var(--muted)\\\">© <span id=\\\"year\\\"></span> {{BUSINESS_NAME}}</div>\\n  </footer>\\n\\n  <div class=\\\"pattern\\\" aria-hidden=\\\"true\\\"></div>\\n\\n  <script>\\n    document.getElementById('year').textContent = new Date().getFullYear();\\n\\n    // Rotating testimonials\\n    (function(){\\n      const notes = [\\n        \\\"Small, steady steps that actually stuck — I feel steadier.\\\",\\n        \\\"The plan respected my work schedule and gave me practical adjustments.\\\",\\n        \\\"We focused on a few measurable shifts; results were subtle and real.\\\",\\n        \\\"Clear language, gentle accountability; I learned how to iterate my habits.\\\",\\n        \\\"An integrative lens that connected sleep, movement, and stress in a single map.\\\"\\n      ];\\n      let i=0; const el=document.getElementById('testimony');\\n      setInterval(()=>{ i=(i+1)%notes.length; el.style.opacity=0; setTimeout(()=>{ el.textContent='\\\"'+notes[i]+'\\\"'; el.style.opacity=1; },220); },4000);\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Story — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Our approach, credentials, and community proof.\\\">\\n  <style>\\n    :root{--bg:#fffaf8;--muted:#6d6d6d;--accent:#7a9a78;--panel:#fff}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;background:var(--bg);color:#111}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 26px}\\n    .logo{width:44px;height:44px;border-radius:8px;background:linear-gradient(135deg,var(--accent),#b4cbb3);display:grid;place-items:center;color:white;font-weight:700}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none}\\n    main{padding:20px 26px}\\n    .intro{display:flex;gap:18px;align-items:flex-start}\\n    .intro .who{background:var(--panel);padding:18px;border-radius:12px;flex:1}\\n    h1{margin:0 0 6px 0}\\n    .mission{font-size:15px;color:var(--muted);line-height:1.6}\\n    .team{margin-top:16px;display:flex;gap:12px}\\n    .person{background:var(--panel);padding:12px;border-radius:10px;flex:1}\\n    .gallery{margin-top:18px;padding:14px;background:linear-gradient(90deg,rgba(122,154,120,0.06),transparent);border-radius:10px}\\n    .cred{display:flex;gap:10px;align-items:center}\\n    .cred .seal{width:56px;height:56px;border-radius:8px;background:linear-gradient(135deg,#fff,#f4f7f3);display:grid;place-items:center;font-weight:700}\\n    .cred .meta{font-size:13px;color:var(--muted)}\\n    .proof{margin-top:12px;display:flex;gap:8px}\\n    .proof .item{padding:10px;border-radius:8px;background:rgba(255,255,255,0.7)}\\n    .tooltip{position:relative}\\n    .tooltip .hint{position:absolute;bottom:110%;left:50%;transform:translateX(-50%);background:#222;color:#fff;padding:6px 8px;border-radius:6px;font-size:12px;opacity:0;pointer-events:none;transition:opacity .12s}\\n    .tooltip:hover .hint{opacity:1}\\n    footer{padding:18px 26px;color:var(--muted);display:flex;justify-content:space-between}\\n    .pattern{position:fixed;left:10px;top:60px;opacity:0.12;width:280px;height:280px;background-image:url('assets/img/pattern.svg');background-size:cover;pointer-events:none}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:600\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">A quiet practice of integrative insight</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"conditions.html\\\">Conditions</a>\\n      <a href=\\\"approach.html\\\">Method</a>\\n      <a href=\\\"pricing.html\\\">Tariff</a>\\n      <a href=\\\"about.html\\\" style=\\\"color:var(--accent)\\\">Story</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"intro\\\">\\n      <div class=\\\"who\\\">\\n        <h1>We map patterns, not just problems</h1>\\n        <p class=\\\"mission\\\">Care here is a gentle inquiry. We layer evidence, experience, and your lived rhythm to craft simple experiments you can run between sessions. No promises of cures—only clearer ways to test what works for you.</p>\\n\\n        <div class=\\\"team\\\">\\n          <div class=\\\"person\\\">\\n            <strong>Lead Guide</strong>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Clinician with cross-disciplinary training. Focused on translating evidence into small, trackable steps.</div>\\n          </div>\\n          <div class=\\\"person\\\">\\n            <strong>Community Liaison</strong>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Coordinates referrals, local resources, and group learning circles.</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside style=\\\"width:320px\\\">\\n        <div style=\\\"background:var(--panel);padding:14px;border-radius:12px\\\">\\n          <strong>Quick facts</strong>\\n          <div style=\\\"margin-top:8px;color:var(--muted);font-size:13px\\\">Serving {{CITY}}, offering remote and in-person touchpoints. Educational guidance and care planning; we coordinate but do not replace your primary providers.</div>\\n          <div style=\\\"margin-top:12px\\\"><a href=\\\"contact.html\\\">Connect with us</a></div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"gallery\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <strong>Proof Gallery</strong>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Voices and credentials</div>\\n      </div>\\n      <div class=\\\"cred\\\" style=\\\"margin-top:10px\\\">\\n        <div class=\\\"seal\\\">CE</div>\\n        <div class=\\\"meta\\\">\\n          <div style=\\\"font-weight:600\\\">Continuing Education</div>\\n          <div style=\\\"color:var(--muted);font-size:13px\\\">Ongoing training in integrative methods and behavior change.</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"proof\\\" id=\\\"proof\\\">\\n        <div class=\\\"item\\\">\\\"I finally had a plan that fit my days.\\\" — A local parent</div>\\n        <div class=\\\"item\\\">\\\"Practical ideas to manage evening anxiety.\\\" — Office worker</div>\\n        <div class=\\\"item\\\">\\\"Coaching that respected my medical team.\\\" — Someone with chronic illness</div>\\n      </div>\\n\\n      <div style=\\\"margin-top:12px;display:flex;gap:8px\\\">\\n        <div class=\\\"tooltip\\\"><div class=\\\"item\\\">Local Partnership</div><div class=\\\"hint\\\">We collaborate with clinics and therapists in {{CITY}} for integrated referrals.</div></div>\\n        <div class=\\\"tooltip\\\"><div class=\\\"item\\\">Peer Resources</div><div class=\\\"hint\\\">Curated reading lists and selective citations for each plan.</div></div>\\n        <div class=\\\"tooltip\\\"><div class=\\\"item\\\">Community Groups</div><div class=\\\"hint\\\">Optional small cohorts for skill practice and accountability.</div></div>\\n      </div>\\n\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>Ethos</h3>\\n      <p style=\\\"color:var(--muted)\\\">We accept uncertainty. We create testable steps. We never promise cures; we support learning, coordination, and steadier days.</p>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>Reach: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    <div style=\\\"color:var(--muted)\\\">© <span id=\\\"year\\\"></span> {{BUSINESS_NAME}}</div>\\n  </footer>\\n\\n  <div class=\\\"pattern\\\" aria-hidden=\\\"true\\\"></div>\\n\\n  <script>\\n    document.getElementById('year').textContent = new Date().getFullYear();\\n\\n    // Rotate proof items\\n    (function(){\\n      const wrap=document.getElementById('proof');\\n      let idx=0; const nodes=Array.from(wrap.children);\\n      setInterval(()=>{\\n        nodes.forEach((n,i)=>{ n.style.display = (i===idx)?'block':'none'; });\\n        idx = (idx+1)%nodes.length;\\n      },3600);\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Schedule an initial intake or reserve a pathway.\\\">\\n  <style>\\n    :root{--bg:#fffefc;--muted:#6a6a6a;--accent:#6b8f6b}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;background:var(--bg);color:#111}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 26px}\\n    .logo{width:44px;height:44px;border-radius:8px;background:linear-gradient(135deg,var(--accent),#b6d1b6);display:grid;place-items:center;color:white;font-weight:700}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none}\\n    main{padding:18px 26px}\\n    .hero{display:flex;gap:20px;align-items:flex-start}\\n    .panel{background:#fff;padding:16px;border-radius:12px;box-shadow:0 6px 20px rgba(18,18,18,0.04)}\\n    .planner{width:680px}\\n    .phases{display:flex;gap:10px}\\n    .phase{flex:1;padding:12px;border-radius:10px;background:linear-gradient(180deg,#fff,#f7faf7);border:1px solid rgba(100,120,100,0.06)}\\n    .phase h4{margin:0 0 6px 0}\\n    .controls{display:flex;gap:8px;margin-top:8px}\\n    input[type=range]{width:100%}\\n    .summary{margin-top:12px;padding:12px;background:linear-gradient(90deg,rgba(107,143,107,0.04),transparent);border-radius:8px}\\n    .disclaimer{font-size:13px;color:var(--muted);margin-top:8px}\\n    form{display:flex;flex-direction:column;gap:8px}\\n    label{font-size:13px;color:var(--muted)}\\n    input,select,textarea{padding:10px;border-radius:8px;border:1px solid #e6e6e6}\\n    button{background:linear-gradient(90deg,var(--accent),#9fbf9f);color:white;padding:10px;border-radius:8px;border:0}\\n    .pattern{position:fixed;right:10px;top:100px;opacity:0.12;width:260px;height:260px;background-image:url('assets/img/pattern.svg');background-size:cover;pointer-events:none}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:600\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">Reserve a session or a pathway</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"conditions.html\\\">Conditions</a>\\n      <a href=\\\"approach.html\\\">Method</a>\\n      <a href=\\\"pricing.html\\\">Tariff</a>\\n      <a href=\\\"about.html\\\">Story</a>\\n      <a href=\\\"book.html\\\" style=\\\"color:var(--accent)\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"panel planner\\\">\\n        <h2>Plan your first three phases</h2>\\n        <p style=\\\"color:var(--muted)\\\">Choose cadence and intensity for Phase 1 (foundations), Phase 2 (integration), and Phase 3 (maintenance). This planner creates a suggested roadmap; it is educational and illustrative only.</p>\\n\\n        <div class=\\\"phases\\\">\\n          <div class=\\\"phase\\\" data-phase=\\\"1\\\">\\n            <h4>Phase 1 — Foundations</h4>\\n            <div class=\\\"controls\\\">\\n              <label style=\\\"flex:1\\\">Weeks: <span class=\\\"val weeks\\\">4</span></label>\\n            </div>\\n            <input class=\\\"weeksInput\\\" type=\\\"range\\\" min=\\\"1\\\" max=\\\"8\\\" value=\\\"4\\\">\\n            <div style=\\\"font-size:13px;color:var(--muted);margin-top:8px\\\">Primary aims: stabilize sleep, reduce urgent stressors, start simple habits.</div>\\n          </div>\\n\\n          <div class=\\\"phase\\\" data-phase=\\\"2\\\">\\n            <h4>Phase 2 — Integration</h4>\\n            <div class=\\\"controls\\\">\\n              <label style=\\\"flex:1\\\">Weeks: <span class=\\\"val weeks\\\">6</span></label>\\n            </div>\\n            <input class=\\\"weeksInput\\\" type=\\\"range\\\" min=\\\"2\\\" max=\\\"12\\\" value=\\\"6\\\">\\n            <div style=\\\"font-size:13px;color:var(--muted);margin-top:8px\\\">Primary aims: build routines, coordinate therapies, refine nutrition and movement.</div>\\n          </div>\\n\\n          <div class=\\\"phase\\\" data-phase=\\\"3\\\">\\n            <h4>Phase 3 — Maintenance</h4>\\n            <div class=\\\"controls\\\">\\n              <label style=\\\"flex:1\\\">Weeks: <span class=\\\"val weeks\\\">8</span></label>\\n            </div>\\n            <input class=\\\"weeksInput\\\" type=\\\"range\\\" min=\\\"4\\\" max=\\\"24\\\" value=\\\"8\\\">\\n            <div style=\\\"font-size:13px;color:var(--muted);margin-top:8px\\\">Primary aims: sustain gains, plan for relapses, transition to self-led practice.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"summary\\\" id=\\\"summary\\\">\\n          <strong>Suggested roadmap</strong>\\n          <div id=\\\"roadmap\\\" style=\\\"margin-top:8px;color:var(--muted)\\\">Phase 1: 4 weeks • Phase 2: 6 weeks • Phase 3: 8 weeks — Total 18 weeks</div>\\n          <div class=\\\"disclaimer\\\">This roadmap is a planner tool for orientation. It does not replace individualized clinical assessment. Adjust with your care team as needed.</div>\\n        </div>\\n\\n      </div>\\n\\n      <aside style=\\\"width:360px\\\">\\n        <div class=\\\"panel\\\">\\n          <h3>Reserve a session</h3>\\n          <form id=\\\"bookingForm\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\">\\n            <label>Full name</label>\\n            <input name=\\\"name\\\" required>\\n            <label>Email</label>\\n            <input type=\\\"email\\\" name=\\\"email\\\" required>\\n            <label>Phone</label>\\n            <input name=\\\"phone\\\">\\n            <label>Choose option</label>\\n            <select name=\\\"plan\\\">\\n              <option>Seed Session — single intake</option>\\n              <option>Root Cycle — 6 weeks</option>\\n              <option>Bloom Mentorship — 3 months</option>\\n            </select>\\n            <label>Preferred times or notes</label>\\n            <textarea name=\\\"notes\\\" rows=\\\"3\\\"></textarea>\\n            <div style=\\\"display:flex;gap:8px;margin-top:8px\\\"><button type=\\\"submit\\\">Plan a Meeting</button><a href=\\\"contact.html\\\" style=\\\"align-self:center;color:var(--muted);font-size:14px\\\">Ask a question</a></div>\\n            <div style=\\\"font-size:12px;color:var(--muted);margin-top:8px\\\">By booking you agree to our educational care model. No guaranteed cures. If you have urgent medical needs, contact your local emergency services.</div>\\n          </form>\\n        </div>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div class=\\\"panel\\\">\\n          <h4>Quick timeline preview</h4>\\n          <div id=\\\"miniRoad\\\" style=\\\"font-size:13px;color:var(--muted)\\\">Loading…</div>\\n        </div>\\n      </aside>\\n    </section>\\n  </main>\\n\\n  <footer style=\\\"padding:18px 26px;color:var(--muted)\\\">\\n    <div>Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    <div>© <span id=\\\"year\\\"></span> {{BUSINESS_NAME}}</div>\\n  </footer>\\n\\n  <div class=\\\"pattern\\\" aria-hidden=\\\"true\\\"></div>\\n\\n  <script>\\n    // Timeline planner logic\\n    (function(){\\n      const weeksInputs = Array.from(document.querySelectorAll('.weeksInput'));\\n      const weekSpans = Array.from(document.querySelectorAll('.phase .weeks'));\\n      const roadmapEl = document.getElementById('roadmap');\\n      const mini = document.getElementById('miniRoad');\\n\\n      function update(){\\n        const values = weeksInputs.map((el,i)=>{ const v=Number(el.value); weekSpans[i].textContent = v; return v; });\\n        const total = values.reduce((a,b)=>a+b,0);\\n        roadmapEl.textContent = `Phase 1: ${values[0]} weeks • Phase 2: ${values[1]} weeks • Phase 3: ${values[2]} weeks — Total ${total} weeks`;\\n        // mini timeline\\n        const p1 = Math.round((values[0]/total)*100);\\n        const p2 = Math.round((values[1]/total)*100);\\n        const p3 = 100 - p1 - p2;\\n        mini.innerHTML = `<div style=\\\\\\\"display:flex;gap:6px;align-items:center\\\\\\\"><div style=\\\\\\\"width:12px;height:12px;border-radius:3px;background:#9fbf9f\\\\\\\"></div>Phase1 ${p1}%</div><div style=\\\\\\\"display:flex;gap:6px;align-items:center;margin-top:6px\\\\\\\"><div style=\\\\\\\"width:12px;height:12px;border-radius:3px;background:#c7d9c7\\\\\\\"></div>Phase2 ${p2}%</div><div style=\\\\\\\"display:flex;gap:6px;align-items:center;margin-top:6px\\\\\\\"><div style=\\\\\\\"width:12px;height:12px;border-radius:3px;background:#eaf3ea\\\\\\\"></div>Phase3 ${p3}%</div>`;\\n      }\\n\\n      weeksInputs.forEach(i=>i.addEventListener('input',update));\\n      update();\\n    })();\\n\\n    // Simple submit handler to simulate booking\\n    document.getElementById('bookingForm').addEventListener('submit',function(e){\\n      e.preventDefault();\\n      alert('Thanks — your request was sent. We will follow up to confirm.');\\n      this.reset();\\n    });\\n\\n    document.getElementById('year').textContent = new Date().getFullYear();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
