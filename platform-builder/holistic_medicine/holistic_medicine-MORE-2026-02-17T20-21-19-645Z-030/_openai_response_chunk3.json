          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Pricing — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f1724;--card:rgba(255,255,255,0.06);--glass:rgba(255,255,255,0.08);--accent:#6ee7b7;--muted:#9aa4af;--glass-2:rgba(255,255,255,0.04)}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#e6eef3;background:linear-gradient(180deg,#071029 0%, #0b1320 100%);-webkit-font-smoothing:antialiased}\\n    body::before{content:\\\"\\\";position:fixed;inset:0;background-image:url('assets/img/pattern.svg');opacity:0.08;mix-blend-mode:overlay;pointer-events:none}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:22px 28px}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#60a5fa);display:grid;place-items:center;color:#042028;font-weight:700}\\n    nav a{color:#bfdbe0;text-decoration:none;margin:0 10px;font-size:15px}\\n    .container{max-width:1100px;margin:30px auto;padding:20px}\\n    .hero{background:linear-gradient(135deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border-radius:12px;padding:26px;backdrop-filter: blur(8px);display:grid;grid-template-columns:1fr 320px;gap:20px}\\n    .hero h1{margin:0;color:#e9f7f0;font-size:28px}\\n    .hero p{color:var(--muted);margin-top:8px}\\n    .kicker{color:var(--accent);font-weight:600;font-size:13px}\\n    .price-cards{display:flex;gap:14px;margin-top:18px}\\n    .card{flex:1;background:var(--card);padding:16px;border-radius:10px;border:1px solid rgba(255,255,255,0.03)}\\n    .card h3{margin:0;color:#dff9ef}\\n    .card .meta{color:var(--muted);font-size:13px;margin-top:8px}\\n    .price{font-size:20px;margin-top:12px;color:#e6fff6;font-weight:700}\\n    .cta{display:inline-block;margin-top:14px;padding:10px 14px;border-radius:8px;background:linear-gradient(90deg,var(--accent),#60a5fa);color:#042028;text-decoration:none;font-weight:700}\\n    .muted{color:var(--muted)}\\n    .timeline{margin-top:22px;padding:14px;border-radius:10px;background:linear-gradient(180deg,var(--glass),var(--glass-2));border:1px solid rgba(255,255,255,0.03)}\\n    .phase{display:flex;gap:12px;align-items:flex-start;padding:12px;border-radius:8px;background:rgba(255,255,255,0.02)}\\n    .phase h4{margin:0;color:#eafff4}\\n    .phase p{margin:6px 0 0;color:var(--muted);font-size:13px}\\n    .phase .meta{font-size:12px;color:#b7c6cb;margin-top:6px}\\n    .disclaimer{font-size:12px;color:#9fb0b7;margin-top:10px}\\n    .faq{margin-top:18px}\\n    .faq dt{font-weight:700;color:#dff9ef;margin-top:12px}\\n    .faq dd{margin:6px 0 0;color:var(--muted)}\\n    footer{margin-top:30px;color:var(--muted);font-size:13px;padding:20px;text-align:center}\\n    /* small */\\n    @media (max-width:900px){.hero{grid-template-columns:1fr;}.price-cards{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:700;color:#e6fff6\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"approach.html\\\">Philosophy</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"about.html\\\">Team</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <div class=\\\"kicker\\\">Personalized program investments</div>\\n        <h1>Choose a path that meets your life, not a template</h1>\\n        <p class=\\\"muted\\\">We frame plans as sequences and continuums rather than single sessions. Pick the pace and depth that fits your goals — all educational and integrative in nature, with no promises of cure.</p>\\n        <div class=\\\"price-cards\\\">\\n          <div class=\\\"card\\\">\\n            <h3>Foundational Sequence</h3>\\n            <div class=\\\"meta\\\">For clarity, habits, and baseline resets</div>\\n            <div class=\\\"price\\\">$480 — 6 sessions</div>\\n            <div class=\\\"muted\\\">Includes intake, 3 planning visits, two follow-ups</div>\\n            <a class=\\\"cta\\\" href=\\\"book.html?pkg=foundational\\\">Begin Foundational</a>\\n          </div>\\n          <div class=\\\"card\\\">\\n            <h3>Restorative Series</h3>\\n            <div class=\\\"meta\\\">For recurring challenges and measured supports</div>\\n            <div class=\\\"price\\\">$950 — 12 sessions</div>\\n            <div class=\\\"muted\\\">Deep review, tailored supports, bi-weekly touchpoints</div>\\n            <a class=\\\"cta\\\" href=\\\"book.html?pkg=restorative\\\">Start Restorative</a>\\n          </div>\\n          <div class=\\\"card\\\">\\n            <h3>Integration Continuum</h3>\\n            <div class=\\\"meta\\\">Ongoing guidance for layering health into life</div>\\n            <div class=\\\"price\\\">$220 / month — membership</div>\\n            <div class=\\\"muted\\\">Monthly check-ins, priority scheduling, learning modules</div>\\n            <a class=\\\"cta\\\" href=\\\"book.html?pkg=continuum\\\">Join the Continuum</a>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div style=\\\"font-weight:700;color:#e6fff4\\\">Roadmap planner</div>\\n        <div class=\\\"timeline\\\" id=\\\"timeline-planner\\\">\\n          <div class=\\\"phase\\\">\\n            <div style=\\\"flex:1\\\">\\n              <h4>Phase 1 — Discover</h4>\\n              <p class=\\\"muted\\\">Comprehensive intake, patterns, and priority-setting.</p>\\n              <div class=\\\"meta\\\">Typical length: 2–6 weeks</div>\\n            </div>\\n          </div>\\n          <div class=\\\"phase\\\">\\n            <div style=\\\"flex:1\\\">\\n              <h4>Phase 2 — Intervene</h4>\\n              <p class=\\\"muted\\\">Targeted adjustments: habits, nutrition, and supportive tools.</p>\\n              <div class=\\\"meta\\\">Typical length: 6–16 weeks</div>\\n            </div>\\n          </div>\\n          <div class=\\\"phase\\\">\\n            <div style=\\\"flex:1\\\">\\n              <h4>Phase 3 — Integrate</h4>\\n              <p class=\\\"muted\\\">Consolidating wins, personal maintenance plan, scalable supports.</p>\\n              <div class=\\\"meta\\\">Typical length: ongoing</div>\\n            </div>\\n          </div>\\n          <div class=\\\"disclaimer\\\">Disclaimer: This timeline is educational. Individual pacing varies. These programs support learning and lifestyle change; they do not promise specific clinical outcomes.</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Plan a Roadmap</a></div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;display:grid;grid-template-columns:1fr 320px;gap:18px\\\">\\n      <div>\\n        <h3 style=\\\"color:#e6fff4\\\">How we price the work</h3>\\n        <p class=\\\"muted\\\">Programs are priced as investments in a sequence of learning and practice. You can pay per sequence, or choose the monthly Continuum for long-term support. Sliding scale and limited scholarships available; inquire over phone or email.</p>\\n\\n        <dl class=\\\"faq\\\">\\n          <dt>Do you bill insurance?</dt>\\n          <dd class=\\\"muted\\\">We provide superbills on request for qualified services; availability varies. Contact {{EMAIL}} for details.</dd>\\n          <dt>Can I change my plan mid-course?</dt>\\n          <dd class=\\\"muted\\\">Yes. Plans are adaptive. We review progress at defined checkpoints and shift pacing as needed.</dd>\\n          <dt>Are there refunds?</dt>\\n          <dd class=\\\"muted\\\">Refunds follow a clear policy: consult before purchase. Partial credits may be offered for unused coaching hours.</dd>\\n        </dl>\\n      </div>\\n\\n      <aside style=\\\"background:var(--glass);padding:14px;border-radius:10px;border:1px solid rgba(255,255,255,0.03)\\\">\\n        <div style=\\\"font-weight:700;color:#e6fff4\\\">Need a tailored estimate?</div>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Call us at {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#bfeee0\\\">{{EMAIL}}</a>. We’ll sketch a pace and investment that suits your life rhythm.</p>\\n        <div style=\\\"margin-top:10px\\\"><a class=\\\"cta\\\" href=\\\"contact.html\\\">Request Estimate</a></div>\\n      </aside>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} — Educational, integrative services. For scheduling: <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:#bfeee0\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#bfeee0\\\">{{EMAIL}}</a></div>\\n      <div style=\\\"margin-top:6px;color:#9fb0b7\\\">All content is informational and educational. No guaranteed cures; consult your clinician for medical decisions.</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0b1220;--glass:rgba(255,255,255,0.04);--accent:#8ee7c6;--muted:#9fb6bd}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;color:#e9f9f2;background:linear-gradient(180deg,#04121a,#071625);-webkit-font-smoothing:antialiased}\\n    body::before{content:\\\"\\\";position:fixed;inset:0;background-image:url('assets/img/pattern.svg');opacity:0.06}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 24px}\\n    .logo{width:46px;height:46px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#5fa8ff);display:grid;place-items:center;color:#022; font-weight:800}\\n    nav a{color:#cfeee2;text-decoration:none;margin:0 10px}\\n    .wrap{max-width:1000px;margin:26px auto;padding:20px}\\n    .hero{padding:20px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));display:flex;gap:20px}\\n    .profile{flex:1}\\n    .side{width:300px}\\n    h1{margin:0;color:#e6fff4}\\n    p{color:var(--muted)}\\n    .values{display:flex;gap:12px;margin-top:12px}\\n    .chip{background:var(--glass);padding:8px;border-radius:8px;color:#dff9ef;font-weight:700}\\n    .team{margin-top:18px;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}\\n    .member{background:rgba(255,255,255,0.02);padding:12px;border-radius:10px}\\n    .member h4{margin:0;color:#e6fff4}\\n    .member p{margin:6px 0 0;color:var(--muted)}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:8px;background:linear-gradient(90deg,var(--accent),#60a5fa);color:#022;text-decoration:none;font-weight:700}\\n    .quote{margin-top:14px;padding:12px;border-left:4px solid rgba(110,231,183,0.18);color:var(--muted)}\\n    footer{margin-top:26px;color:var(--muted);font-size:13px;text-align:center}\\n    @media(max-width:800px){.hero{flex-direction:column}.side{width:auto}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800;color:#eafff3\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"conditions.html\\\">Conditions</a>\\n      <a href=\\\"approach.html\\\">Philosophy</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"profile\\\">\\n        <h1>We join the threads you already have</h1>\\n        <p>Small, evidence-informed changes arranged into a clear plan. Our team listens for context — your schedule, priorities, and constraints — then builds learning and support that can be used in daily life. Educational in scope; aimed at resilience and improved functioning.</p>\\n        <div class=\\\"values\\\">\\n          <div class=\\\"chip\\\">Context first</div>\\n          <div class=\\\"chip\\\">Measurable steps</div>\\n          <div class=\\\"chip\\\">Practical learning</div>\\n        </div>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Schedule an Intro</a>\\n        <div class=\\\"quote\\\">\\\"Focused, human-centered guidance that helps you make clearer choices about daily health.\\\" — Participant</div>\\n      </div>\\n      <aside class=\\\"side\\\">\\n        <div style=\\\"background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:14px;border-radius:10px;color:#e6fff4\\\">\\n          <div style=\\\"font-weight:700\\\">Our approach</div>\\n          <p style=\\\"color:var(--muted);margin-top:8px\\\">We combine practical skill-building, systems thinking, and supportive check-ins. Your plan is a sequence: discover, adapt, integrate. No single silver bullet — instead, durable practices adapted to you.</p>\\n          <div style=\\\"margin-top:8px\\\"><a class=\\\"cta\\\" href=\\\"approach.html\\\">Read the Approach</a></div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"color:#e6fff4\\\">The team</h2>\\n      <div class=\\\"team\\\">\\n        <div class=\\\"member\\\">\\n          <h4>Lead Integrative Practitioner</h4>\\n          <p class=\\\"muted\\\">Specializes in systems-based assessments and practical habit design.</p>\\n        </div>\\n        <div class=\\\"member\\\">\\n          <h4>Nutrition & Lifestyle Coach</h4>\\n          <p class=\\\"muted\\\">Works with meal patterns, sleep, and movement to support daily energy.</p>\\n        </div>\\n        <div class=\\\"member\\\">\\n          <h4>Mind-Body Facilitator</h4>\\n          <p class=\\\"muted\\\">Teaches accessible practices for stress resiliency and focus.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"color:#e6fff4\\\">Community & learning</h2>\\n      <p class=\\\"muted\\\">We run small cohort learning blocks, drop-in workshops, and monthly member circles. All offerings are educational and supportive; we do not promise medical cures. Ask about scholarships and sliding-scale options when you reach out.</p>\\n    </section>\\n\\n    <footer>\\n      <div>Contact: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#bfeee0\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:#bfeee0\\\">{{PHONE}}</a></div>\\n      <div style=\\\"margin-top:6px;color:var(--muted)\\\">All content is informational and educational. Consult your healthcare professional for medical advice.</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071428;--glass:rgba(255,255,255,0.03);--accent:#7af3c6;--muted:#9fb8bf}\\n    body{margin:0;font-family:Inter,system-ui,Roboto,Arial;color:#e8fbf3;background:linear-gradient(180deg,#04101a,#081524)}\\n    body::before{content:'';position:fixed;inset:0;background-image:url('assets/img/pattern.svg');opacity:0.07}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 24px}\\n    .logo{width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#5fb0ff);display:grid;place-items:center;color:#002}\\n    nav a{color:#cfeee2;margin:0 10px;text-decoration:none}\\n    .wrap{max-width:980px;margin:26px auto;padding:20px}\\n    .intro{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:18px;border-radius:12px}\\n    h1{margin:0;color:#e6fff4}\\n    p{color:var(--muted)}\\n    .selector{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}\\n    .mood{padding:10px 12px;border-radius:10px;background:rgba(255,255,255,0.02);cursor:pointer;color:#dff9ef;border:1px solid rgba(255,255,255,0.02)}\\n    .mood.active{background:linear-gradient(90deg,var(--accent),#60a5fa);color:#042028}\\n    .method-card{margin-top:16px;padding:14px;border-radius:10px;background:var(--glass);border:1px solid rgba(255,255,255,0.03)}\\n    .method-card h3{margin:0;color:#e6fff4}\\n    .method-card p{color:var(--muted);margin-top:8px}\\n    .book-cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#60a5fa);color:#042028;text-decoration:none;font-weight:700}\\n    .timeline{margin-top:18px;padding:12px;border-radius:10px;background:rgba(255,255,255,0.02)}\\n    .timeline .step{padding:10px;border-radius:8px;margin-top:8px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent)}\\n    .timeline .step h4{margin:0;color:#e6fff4}\\n    .timeline .step p{color:var(--muted);margin-top:6px}\\n    .disclaimer{font-size:12px;color:#9fb0b7;margin-top:10px}\\n    form{margin-top:12px;display:grid;gap:8px}\\n    input,select,textarea{padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:#e6fff4}\\n    .note{font-size:12px;color:var(--muted)}\\n    footer{margin-top:20px;color:var(--muted);font-size:13px;text-align:center}\\n    @media(max-width:700px){.selector{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800;color:#eafff3\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"about.html\\\">Team</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"intro\\\">\\n      <h1>Book an Intro or a Program</h1>\\n      <p class=\\\"muted\\\">Select how you feel right now; we’ll suggest an approach and update the booking action. All sessions are educational and integrative rather than curative.</p>\\n\\n      <div style=\\\"margin-top:12px\\\">\\n        <div style=\\\"font-weight:700;color:#dff9ef\\\">Mood-to-Method — choose one</div>\\n        <div class=\\\"selector\\\" id=\\\"mood-selector\\\">\\n          <button class=\\\"mood\\\" data-method=\\\"clarify\\\">Stuck & Overwhelmed</button>\\n          <button class=\\\"mood\\\" data-method=\\\"renew\\\">Low Energy & Tired</button>\\n          <button class=\\\"mood\\\" data-method=\\\"stabilize\\\">Recurring Upsets</button>\\n          <button class=\\\"mood\\\" data-method=\\\"optimize\\\">Ready to Optimize</button>\\n        </div>\\n\\n        <div class=\\\"method-card\\\" id=\\\"method-card\\\">\\n          <h3 id=\\\"method-title\\\">Start with an Intro</h3>\\n          <p id=\\\"method-desc\\\" class=\\\"muted\\\">A 45-minute educational intake to map your priorities and plan the next practical steps.</p>\\n          <a id=\\\"book-cta\\\" class=\\\"book-cta\\\" href=\\\"book.html?pkg=intro\\\">Book a 45-min Intro</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"timeline\\\" id=\\\"timeline\\\">\\n      <h3 style=\\\"color:#e6fff4\\\">Three-stage planner</h3>\\n      <div class=\\\"step\\\">\\n        <h4>Phase 1 — Map</h4>\\n        <p class=\\\"muted\\\">Detailed intake and simple metrics to establish a baseline and priorities.</p>\\n      </div>\\n      <div class=\\\"step\\\">\\n        <h4>Phase 2 — Adjust</h4>\\n        <p class=\\\"muted\\\">Short experiments, habit anchoring, and practical supports to shift patterns.</p>\\n      </div>\\n      <div class=\\\"step\\\">\\n        <h4>Phase 3 — Maintain</h4>\\n        <p class=\\\"muted\\\">Sustaining practices and tools — membership or periodic check-ins if desired.</p>\\n      </div>\\n      <div class=\\\"disclaimer\\\">Educational note: This planner is a guide, not a medical prescription. Timelines change based on individual context. If you have an urgent medical concern, please contact your medical provider.</div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"color:#e6fff4\\\">Quick booking</h3>\\n      <form id=\\\"booking-form\\\">\\n        <label class=\\\"note\\\">Full name</label>\\n        <input name=\\\"name\\\" placeholder=\\\"Your name\\\" required>\\n        <label class=\\\"note\\\">Email</label>\\n        <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n        <label class=\\\"note\\\">Phone</label>\\n        <input name=\\\"phone\\\" placeholder=\\\"Optional\\\">\\n        <label class=\\\"note\\\">Preferred package</label>\\n        <select id=\\\"package-select\\\" name=\\\"package\\\">\\n          <option value=\\\"intro\\\">45-min Intro</option>\\n          <option value=\\\"foundational\\\">Foundational Sequence</option>\\n          <option value=\\\"restorative\\\">Restorative Series</option>\\n          <option value=\\\"continuum\\\">Integration Continuum (monthly)</option>\\n        </select>\\n        <label class=\\\"note\\\">Notes (goals & current concerns)</label>\\n        <textarea name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Briefly tell us what's on your mind\\\"></textarea>\\n        <div style=\\\"display:flex;gap:8px;align-items:center;margin-top:8px\\\">\\n          <button type=\\\"submit\\\" class=\\\"book-cta\\\" id=\\\"submit-btn\\\">Request Booking</button>\\n          <div class=\\\"note\\\">Or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:#bfeee0\\\">{{PHONE}}</a></div>\\n        </div>\\n      </form>\\n      <div id=\\\"form-msg\\\" class=\\\"note\\\" style=\\\"margin-top:10px\\\"></div>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"note\\\">If you need immediate care, contact local services. For scheduling: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#bfeee0\\\">{{EMAIL}}</a></div>\\n      <div class=\\\"note\\\" style=\\\"margin-top:6px;color:#9fb0b7\\\">All services are educational and supportive. We do not claim cures.</div>\\n    </footer>\\n  </main>\\n\\n  <script>\\n    (function(){\\n      // Mood-to-Method logic\\n      const moods = document.querySelectorAll('#mood-selector .mood');\\n      const title = document.getElementById('method-title');\\n      const desc = document.getElementById('method-desc');\\n      const cta = document.getElementById('book-cta');\\n      const pkgSelect = document.getElementById('package-select');\\n\\n      const methods = {\\n        clarify: {title:'Clarify & Prioritize',desc:'A 45–60 minute mapping session to untangle competing demands and set realistic first steps.',ctaLabel:'Book a Mapping Session',pkg:'intro'},\\n        renew: {title:'Energy Renewal Block',desc:'A short sequence focused on sleep, rhythm, and modest nutritional shifts to rebuild energy.',ctaLabel:'Request the Renewal Block',pkg:'foundational'},\\n        stabilize: {title:'Stability Toolkit',desc:'Targeted supports and monitoring for recurring upsets with scheduled check-ins.',ctaLabel:'Start the Stabilizer',pkg:'restorative'},\\n        optimize: {title:'Optimize & Maintain',desc:'A longer view for layering sustainable practices and monthly oversight.',ctaLabel:'Join the Continuum',pkg:'continuum'}\\n      };\\n\\n      function setActive(methodKey,button){\\n        moods.forEach(b=>b.classList.remove('active'));\\n        if(button) button.classList.add('active');\\n        const m = methods[methodKey] || methods.clarify;\\n        title.textContent = m.title;\\n        desc.textContent = m.desc;\\n        cta.textContent = m.ctaLabel;\\n        cta.href = 'book.html?pkg='+m.pkg;\\n        // update select to match\\n        if(pkgSelect) pkgSelect.value = m.pkg;\\n        // update submit button label\\n        document.getElementById('submit-btn').textContent = m.ctaLabel;\\n      }\\n\\n      moods.forEach(b=>{\\n        b.addEventListener('click',()=>{setActive(b.dataset.method,b)})\\n      });\\n\\n      // initialize by query param or default\\n      const params = new URLSearchParams(location.search);\\n      const initial = params.get('mood') || params.get('pkg') || 'clarify';\\n      // map pkg to method\\n      const map = {intro:'clarify',foundational:'renew',restorative:'stabilize',continuum:'optimize'};\\n      const start = map[initial] || initial;\\n      const btn = Array.from(moods).find(b=>b.dataset.method===start);\\n      setActive(start,btn);\\n\\n      // booking form handler (local-only simulation)\\n      const form = document.getElementById('booking-form');\\n      const msg = document.getElementById('form-msg');\\n      form.addEventListener('submit',function(e){\\n        e.preventDefault();\\n        const data = new FormData(form);\\n        // simple validation\\n        if(!data.get('name')||!data.get('email')){\\n          msg.textContent = 'Please provide name and email.';return;\\n        }\\n        // update message\\n        msg.textContent = 'Thanks — a scheduling coordinator will follow up at '+data.get('email')+'. If urgent, call '+ '{{PHONE}}' +'.';\\n        form.reset();\\n        setTimeout(()=>{msg.textContent='';},8000);\\n      });\\n\\n      // Simple timeline toggles for user to mark phases they'd like\\n      const timeline = document.getElementById('timeline');\\n      const steps = timeline.querySelectorAll('.step');\\n      steps.forEach((s,i)=>{\\n        s.style.cursor='pointer';\\n        s.addEventListener('click',()=>{\\n          s.classList.toggle('selected');\\n          s.style.outline = s.classList.contains('selected') ? '2px solid rgba(122,243,198,0.18)' : 'none';\\n        });\\n      });\\n\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
