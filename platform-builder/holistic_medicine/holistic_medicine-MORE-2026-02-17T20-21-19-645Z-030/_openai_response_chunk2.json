          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f1724;--glass:rgba(255,255,255,0.06);--glass-2:rgba(255,255,255,0.08);--accent:#7ad0a0;--muted:#9aa4b2;--card:#0b1220}\\n    *{box-sizing:border-box}\\n    body{font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, 'Helvetica Neue', Arial; margin:0; min-height:100vh; background:linear-gradient(180deg,#071026 0%, #0b1530 60%); color:#e6eef6}\\n    header{backdrop-filter:blur(8px); background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)); border-bottom:1px solid rgba(255,255,255,0.03); position:sticky; top:0; z-index:20}\\n    .container{max-width:1100px; margin:0 auto; padding:28px}\\n    .nav{display:flex; align-items:center; gap:18px}\\n    .brand{font-weight:700; letter-spacing:0.4px}\\n    nav a{color:var(--muted); text-decoration:none; padding:10px 12px; border-radius:10px}\\n    nav a:hover{color:#fff; background:rgba(255,255,255,0.02)}\\n    .hero{display:grid; grid-template-columns:1fr 360px; gap:28px; align-items:center; padding:46px 0}\\n    .card{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)); border-radius:14px; padding:20px; box-shadow:0 6px 18px rgba(1,6,12,0.6); border:1px solid rgba(255,255,255,0.03)}\\n    h1{margin:0 0 8px 0; font-size:22px}\\n    p.lead{color:var(--muted); margin:0 0 12px 0}\\n    .mood-grid{display:flex; gap:10px; flex-wrap:wrap}\\n    .mood{cursor:pointer; padding:10px 12px; border-radius:10px; background:var(--glass); color:#eaf6ef; border:1px solid rgba(255,255,255,0.03)}\\n    .mood.active{background:linear-gradient(90deg, rgba(122,208,160,0.12), rgba(122,208,160,0.06)); color:var(--accent); border-color:rgba(122,208,160,0.18)}\\n    .suggest{margin-top:12px; font-weight:600}\\n    .cta{display:inline-block; margin-top:14px; padding:12px 16px; border-radius:10px; background:linear-gradient(90deg,var(--accent), #66b68f); color:#042018; font-weight:700; text-decoration:none}\\n    .programs{display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-top:20px}\\n    .prog{padding:16px; border-radius:12px; background:linear-gradient(180deg, rgba(255,255,255,0.015), rgba(255,255,255,0.01)); border:1px solid rgba(255,255,255,0.03)}\\n    .price{font-weight:700; color:var(--accent)}\\n    .timeline{margin-top:18px}\\n    .phase{padding:12px; margin-bottom:8px; border-radius:10px; background:var(--glass-2); border:1px solid rgba(255,255,255,0.02)}\\n    .phase h4{margin:0 0 6px 0}\\n    label.inline{display:flex; gap:8px; align-items:center}\\n    .muted{color:var(--muted); font-size:13px}\\n    .disclaimer{font-size:12px; color:#c9d6df; background:rgba(255,255,255,0.02); padding:10px; border-radius:8px; margin-top:10px}\\n    footer{padding:30px 0; color:var(--muted)}\\n    /* decorative SVG */\\n    .pattern{position:fixed; right:-120px; top:-120px; width:420px; height:420px; opacity:0.08; z-index:0}\\n    @media(max-width:900px){.hero{grid-template-columns:1fr;}.programs{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop stop-color=\\\"#7ad0a0\\\" offset=\\\"0\\\"/>\\n        <stop stop-color=\\\"#5bb388\\\" offset=\\\"1\\\"/>\\n      </linearGradient>\\n    </defs>\\n    <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"200\\\" height=\\\"200\\\" fill=\\\"url(#g1)\\\" rx=\\\"24\\\"/>\\n    <g fill-opacity=\\\"0.6\\\" fill=\\\"#fff\\\">\\n      <circle cx=\\\"40\\\" cy=\\\"40\\\" r=\\\"28\\\"/>\\n      <circle cx=\\\"160\\\" cy=\\\"80\\\" r=\\\"18\\\"/>\\n      <rect x=\\\"110\\\" y=\\\"120\\\" width=\\\"70\\\" height=\\\"20\\\" rx=\\\"6\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"container nav\\\">\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <nav style=\\\"margin-left:18px\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"approach.html\\\">Our Way</a>\\n        <a href=\\\"services.html\\\">Care Options</a>\\n        <a href=\\\"conditions.html\\\">Concerns</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"about.html\\\">Team</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n      <div style=\\\"margin-left:auto; display:flex; gap:8px; align-items:center\\\">\\n        <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"cta\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </div>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <div class=\\\"card\\\">\\n          <h1>Care options tuned to what you feel today</h1>\\n          <p class=\\\"lead\\\">Choose how you're showing up, and we'll surface an approach that fits your rhythm. Education-forward, adaptable, and built to support daily life.</p>\\n\\n          <div>\\n            <div class=\\\"muted\\\">How are you today?</div>\\n            <div class=\\\"mood-grid\\\" id=\\\"moodGrid\\\">\\n              <div class=\\\"mood\\\" data-method=\\\"Gentle Reset\\\">Worn out</div>\\n              <div class=\\\"mood\\\" data-method=\\\"Energy Map\\\">Low energy</div>\\n              <div class=\\\"mood\\\" data-method=\\\"Clarify & Plan\\\">Overwhelmed</div>\\n              <div class=\\\"mood\\\" data-method=\\\"Tune-Up\\\">Curious / proactive</div>\\n            </div>\\n            <div class=\\\"suggest\\\">Suggested approach: <span id=\\\"methodLabel\\\">Gentle Reset</span></div>\\n            <a id=\\\"primaryCta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"cta\\\">Start a Gentle Reset — {{PRIMARY_CTA_LABEL}}</a>\\n            <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">You can change this anytime; selections inform session focus and materials.</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3>Programs & Contributions</h3>\\n          <p class=\\\"muted\\\">Plans framed as ongoing collaborations rather than one-off fixes. Choose an offering that fits your time and goals.</p>\\n\\n          <div class=\\\"programs\\\">\\n            <div class=\\\"prog\\\">\\n              <div style=\\\"font-weight:700\\\">Vital Rhythm</div>\\n              <div class=\\\"muted\\\">Triage + weekly check-ins for three months.</div>\\n              <div class=\\\"price\\\">starting contribution $275/mo</div>\\n            </div>\\n            <div class=\\\"prog\\\">\\n              <div style=\\\"font-weight:700\\\">Root Clarity</div>\\n              <div class=\\\"muted\\\">Focused investigation: labs, lifestyle, and a 6-week plan.</div>\\n              <div class=\\\"price\\\">package from $950</div>\\n            </div>\\n            <div class=\\\"prog\\\">\\n              <div style=\\\"font-weight:700\\\">Movement Reset</div>\\n              <div class=\\\"muted\\\">Short guided cycle to rebuild daily ease and sleep.</div>\\n              <div class=\\\"price\\\">contribute $180–$320</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"timeline\\\">\\n            <h4 style=\\\"margin-top:14px\\\">Roadmap builder</h4>\\n            <div class=\\\"phase\\\">\\n              <h4>Phase 1 — Stabilize</h4>\\n              <div class=\\\"muted\\\">Set a week-by-week intention. Small, safe changes first.</div>\\n              <div style=\\\"margin-top:8px\\\"><label class=\\\"inline\\\">Target date: <input type=\\\"date\\\" id=\\\"p1d\\\" style=\\\"margin-left:8px\\\"/></label></div>\\n            </div>\\n            <div class=\\\"phase\\\">\\n              <h4>Phase 2 — Investigate</h4>\\n              <div class=\\\"muted\\\">Gather context: sleep, movement, labs, stressors.</div>\\n              <div style=\\\"margin-top:8px\\\"><label class=\\\"inline\\\">Target date: <input type=\\\"date\\\" id=\\\"p2d\\\" style=\\\"margin-left:8px\\\"/></label></div>\\n            </div>\\n            <div class=\\\"phase\\\">\\n              <h4>Phase 3 — Integrate</h4>\\n              <div class=\\\"muted\\\">Build durable habits; plan for follow-ups and review.</div>\\n              <div style=\\\"margin-top:8px\\\"><label class=\\\"inline\\\">Target date: <input type=\\\"date\\\" id=\\\"p3d\\\" style=\\\"margin-left:8px\\\"/></label></div>\\n            </div>\\n            <div class=\\\"disclaimer\\\">These are educational milestones, not guarantees. Timeline depends on personal context and testing; adjust with your practitioner.</div>\\n          </div>\\n\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <div class=\\\"card\\\">\\n        <h3>What to expect</h3>\\n        <ul class=\\\"muted\\\">\\n          <li>Sessions combine clinical review, lifestyle changes, and practical experiments.</li>\\n          <li>We favor evidence-informed adjustments you can try safely at home.</li>\\n          <li>Billing and scheduling are transparent — see Plans for details.</li>\\n        </ul>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <strong>Testimonials</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">\\\"Helped me find a steady baseline when I thought chaos was permanent.\\\" — A client in {{CITY}}, {{STATE}}</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer class=\\\"container\\\">\\n    <div style=\\\"display:flex; justify-content:space-between; gap:20px; align-items:center\\\">\\n      <div class=\\\"muted\\\">Contact: <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent); text-decoration:none\\\">{{PHONE}}</a> · <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent); text-decoration:none\\\">{{EMAIL}}</a></div>\\n      <div class=\\\"muted\\\">© <span id=\\\"yr\\\"></span> {{BUSINESS_NAME}}</div>\\n    </div>\\n  </footer>\\n\\n  <script>\\n    (function(){\\n      document.getElementById('yr').textContent = new Date().getFullYear();\\n      // Mood-to-Method selector\\n      const moods = document.querySelectorAll('.mood');\\n      const methodLabel = document.getElementById('methodLabel');\\n      const cta = document.getElementById('primaryCta');\\n      moods.forEach(m=>{\\n        m.addEventListener('click', ()=>{\\n          moods.forEach(x=>x.classList.remove('active'));\\n          m.classList.add('active');\\n          const method = m.getAttribute('data-method');\\n          methodLabel.textContent = method;\\n          cta.textContent = 'Request ' + method + ' — {{PRIMARY_CTA_LABEL}}';\\n          // small visual hint\\n          cta.style.transform = 'translateY(-2px)';\\n          setTimeout(()=>c cta.style.transform = '', 160);\\n        });\\n      });\\n\\n      // Basic timeline persistence in localStorage\\n      ['p1d','p2d','p3d'].forEach(id=>{\\n        const el = document.getElementById(id);\\n        if(!el) return;\\n        el.value = localStorage.getItem('tl_'+id) || '';\\n        el.addEventListener('change', ()=>{\\n          localStorage.setItem('tl_'+id, el.value);\\n        });\\n      });\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Conditions — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071022;--glass:rgba(255,255,255,0.04);--accent:#f6b67a;--muted:#9fb0c3}\\n    body{font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial; margin:0; color:#e8f3fb; background:linear-gradient(180deg,#041026 0%, #081427 60%)}\\n    .wrap{max-width:980px; margin:0 auto; padding:34px}\\n    header{display:flex; align-items:center; gap:14px}\\n    nav a{color:var(--muted); text-decoration:none; padding:8px; border-radius:8px}\\n    nav a:hover{color:#fff}\\n    .card{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)); border-radius:12px; padding:18px; margin-top:18px; border:1px solid rgba(255,255,255,0.03)}\\n    h1{margin:0}\\n    .grid{display:grid; grid-template-columns:1fr 320px; gap:18px}\\n    .condition{padding:12px; border-radius:10px; background:rgba(255,255,255,0.02); margin-bottom:10px}\\n    .muted{color:var(--muted)}\\n    .disclaimer{background:rgba(255,255,255,0.02); padding:10px; border-radius:8px; font-size:13px; color:#d7e9ff}\\n    footer{margin-top:22px; color:var(--muted)}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <nav style=\\\"margin-left:18px\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"approach.html\\\">Our Way</a>\\n        <a href=\\\"services.html\\\">Care Options</a>\\n        <a href=\\\"conditions.html\\\">Concerns</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"about.html\\\">Team</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n      <div style=\\\"margin-left:auto; color:var(--muted)\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent); text-decoration:none\\\">{{EMAIL}}</a></div>\\n    </header>\\n\\n    <main class=\\\"grid\\\">\\n      <section>\\n        <h1>What we support</h1>\\n        <p class=\\\"muted\\\">We provide educational, integrative support for common concerns. Nothing here is a promise of cure — care is individualized and may include referrals.</p>\\n\\n        <div class=\\\"card\\\">\\n          <h3>Digestive & metabolic patterns</h3>\\n          <div class=\\\"condition\\\"><strong>Symptoms:</strong> bloating, irregular bowel habits, fluctuating weight, post-meal fatigue.</div>\\n          <div class=\\\"condition\\\"><strong>Approach:</strong> dietary experiments, targeted labs, gentle elimination trials, and pacing plans.</div>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <h3>Sleep, energy, and circadian alignment</h3>\\n          <div class=\\\"condition\\\"><strong>Symptoms:</strong> difficulty falling asleep, frequent waking, daytime exhaustion.</div>\\n          <div class=\\\"condition\\\"><strong>Approach:</strong> tailored sleep routines, light and activity scheduling, and pragmatic habit shifts.</div>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <h3>Mental load & stress resilience</h3>\\n          <div class=\\\"condition\\\"><strong>Symptoms:</strong> persistent worry, overwhelm, difficulty with focus.</div>\\n          <div class=\\\"condition\\\"><strong>Approach:</strong> short behavioral experiments, pacing strategies, and collaboratively chosen coping tools. When needed, we coordinate with mental health specialists.</div>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <h3>Chronic pain & movement</h3>\\n          <div class=\\\"condition\\\"><strong>Symptoms:</strong> recurring joint or back discomfort, movement avoidance, postural fatigue.</div>\\n          <div class=\\\"condition\\\"><strong>Approach:</strong> functional movement assessments, gentle plan building, and referrals to PT or specialists as appropriate.</div>\\n        </div>\\n\\n        <div class=\\\"disclaimer\\\" style=\\\"margin-top:12px\\\">\\n          Important: This information is educational. We do not promise specific outcomes. Our work is a process of exploration — tests, thoughtful changes, and frequent adjustments. If you are experiencing an emergency, seek immediate medical care. For conditions that require specialist care, we will coordinate or refer.\\n        </div>\\n\\n        <section style=\\\"margin-top:14px\\\" class=\\\"card\\\">\\n          <h4>How we decide what to try</h4>\\n          <ul class=\\\"muted\\\">\\n            <li>Start with low-risk, high-relevance experiments.</li>\\n            <li>Use tests selectively to reduce guesswork.</li>\\n            <li>Keep plans simple and trackable so you can see what changes.</li>\\n          </ul>\\n        </section>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3>When to reach out</h3>\\n          <p class=\\\"muted\\\">If a pattern is interfering with your work, relationships, or daily routines, an initial conversation can help map next steps.</p>\\n          <div style=\\\"margin-top:12px\\\"><a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"cta\\\" style=\\\"display:inline-block;padding:10px 12px;border-radius:8px;background:linear-gradient(90deg,var(--accent), #d99559);color:#081418;font-weight:700;text-decoration:none\\\">Connect about my concern</a></div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4>Notes on medication & specialist care</h4>\\n          <p class=\\\"muted\\\">We collaborate with existing prescribers and specialists. We do not stop critical medications without a supervising clinician. If medication management is needed, we coordinate or refer.</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4>Accessibility</h4>\\n          <p class=\\\"muted\\\">We strive to make care usable for people with busy lives. If you need adjustments (timing, remote visits, summaries), tell us on booking.</p>\\n        </div>\\n\\n      </aside>\\n    </main>\\n\\n    <footer style=\\\"margin-top:24px; color:var(--muted); display:flex; justify-content:space-between; align-items:center\\\">\\n      <div>Phone: <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent); text-decoration:none\\\">{{PHONE}}</a></div>\\n      <div>© <span id=\\\"yr2\\\"></span> {{BUSINESS_NAME}}</div>\\n    </footer>\\n  </div>\\n\\n  <script>\\n    document.getElementById('yr2').textContent = new Date().getFullYear();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Our Way — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#081221;--glass:rgba(255,255,255,0.03);--accent:#92c4ff;--muted:#9fb6c9}\\n    body{margin:0; font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial; color:#eaf6ff; background:linear-gradient(180deg,#031226 0%, #071a2a 70%)}\\n    .wrap{max-width:1000px; margin:0 auto; padding:28px}\\n    header{display:flex; align-items:center; gap:12px}\\n    nav a{color:var(--muted); text-decoration:none; padding:8px}\\n    .hero{margin-top:18px; padding:18px; border-radius:12px; background:linear-gradient(180deg, rgba(255,255,255,0.015), rgba(255,255,255,0.01)); border:1px solid rgba(255,255,255,0.03)}\\n    h1{margin:0}\\n    .steps{display:flex; gap:12px; margin-top:18px}\\n    .step{flex:1; padding:14px; border-radius:10px; background:var(--glass); border:1px solid rgba(255,255,255,0.02)}\\n    .muted{color:var(--muted)}\\n    .timeline{margin-top:18px}\\n    .phase{padding:12px; margin-bottom:10px; border-radius:10px; background:linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.005)); border:1px solid rgba(255,255,255,0.02)}\\n    .cta{display:inline-block; padding:10px 14px; border-radius:10px; background:linear-gradient(90deg,var(--accent), #5aa6ff); color:#022133; font-weight:700; text-decoration:none}\\n    .builder{margin-top:12px; display:flex; gap:8px}\\n    input[type=\\\"date\\\"], input[type=\\\"text\\\"]{background:transparent; border:1px solid rgba(255,255,255,0.03); padding:8px; color:#eaf6ff; border-radius:8px}\\n    .notes{margin-top:10px; font-size:13px; color:#cfe9ff}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <nav style=\\\"margin-left:18px\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"approach.html\\\">Our Way</a>\\n        <a href=\\\"services.html\\\">Care Options</a>\\n        <a href=\\\"conditions.html\\\">Concerns</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"about.html\\\">Team</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n      <div style=\\\"margin-left:auto\\\"><a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"cta\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"hero\\\">\\n        <h1>Our approach: map, test, and steady the path forward</h1>\\n        <p class=\\\"muted\\\">We pair practical learning with short experiments. The goal is informed, sustainable movement — not instant fixes.</p>\\n\\n        <div class=\\\"steps\\\">\\n          <div class=\\\"step\\\">\\n            <strong>Listen</strong>\\n            <div class=\\\"muted\\\">Collect history and priorities; what matters most to you now?</div>\\n          </div>\\n          <div class=\\\"step\\\">\\n            <strong>Map</strong>\\n            <div class=\\\"muted\\\">Gather targeted data to reduce uncertainty.</div>\\n          </div>\\n          <div class=\\\"step\\\">\\n            <strong>Try</strong>\\n            <div class=\\\"muted\\\">Short, measurable experiments you can do at home.</div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px\\\">\\n          <label style=\\\"display:block; margin-bottom:8px; color:var(--muted)\\\">Mood-to-Method quick selector</label>\\n          <select id=\\\"moodSelect\\\" style=\\\"padding:10px; border-radius:8px; background:transparent; color:#eaf6ff; border:1px solid rgba(255,255,255,0.03)\\\">\\n            <option value=\\\"Calm Clarify\\\">Calm Clarify — paced review</option>\\n            <option value=\\\"Focus Renew\\\">Focus Renew — attention tools</option>\\n            <option value=\\\"Energy Rebuild\\\">Energy Rebuild — sleep & rhythm</option>\\n            <option value=\\\"Investigate\\\">Investigate — targeted testing</option>\\n          </select>\\n          <div class=\\\"notes\\\" id=\\\"approachNote\\\">Select how you're feeling; we show an aligned plan and update the booking phrase.</div>\\n          <div style=\\\"margin-top:10px\\\"><a id=\\\"approachCta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"cta\\\">Book a Calm Clarify session — {{PRIMARY_CTA_LABEL}}</a></div>\\n        </div>\\n\\n      </section>\\n\\n      <section class=\\\"timeline\\\">\\n        <h2 style=\\\"margin-top:18px\\\">Three-phase planner</h2>\\n        <div class=\\\"phase\\\">\\n          <h3>Phase 1 — Foundations</h3>\\n          <p class=\\\"muted\\\">Stabilize sleep, water, and immediate burden. Short checklist with daily micro-goals.</p>\\n          <div class=\\\"builder\\\"><input type=\\\"date\\\" id=\\\"f1d\\\"/><input type=\\\"text\\\" id=\\\"f1note\\\" placeholder=\\\"Primary focus (example: sleep window)\\\"/></div>\\n        </div>\\n        <div class=\\\"phase\\\">\\n          <h3>Phase 2 — Investigate</h3>\\n          <p class=\\\"muted\\\">If patterns persist, use selective testing and structured trials to isolate drivers.</p>\\n          <div class=\\\"builder\\\"><input type=\\\"date\\\" id=\\\"f2d\\\"/><input type=\\\"text\\\" id=\\\"f2note\\\" placeholder=\\\"Investigation focus (example: iron, thyroid)\\\"/></div>\\n        </div>\\n        <div class=\\\"phase\\\">\\n          <h3>Phase 3 — Integrate</h3>\\n          <p class=\\\"muted\\\">Translate what worked into sustainable habits and a follow-up cadence.</p>\\n          <div class=\\\"builder\\\"><input type=\\\"date\\\" id=\\\"f3d\\\"/><input type=\\\"text\\\" id=\\\"f3note\\\" placeholder=\\\"Integration goal (example: 30-min walk)\\\"/></div>\\n        </div>\\n        <div class=\\\"disclaimer muted\\\" style=\\\"margin-top:10px\\\">This planner is a tool to structure thinking, not a substitute for clinical judgment. Timelines and tests depend on your care team and personal context.</div>\\n        <div style=\\\"margin-top:12px\\\"><button id=\\\"savePlan\\\" style=\\\"padding:10px 12px;border-radius:8px;background:linear-gradient(90deg,var(--accent),#6aa8ff);border:none;color:#042536;font-weight:700\\\">Save plan</button></div>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n        <h3>How decisions are made</h3>\\n        <p class=\\\"muted\\\">We prioritize safety, minimize unnecessary testing, and choose interventions you can try with clear measures. When appropriate, we partner with specialists for medication or procedures.</p>\\n\\n        <h4 style=\\\"margin-top:10px\\\">Documentation and learning</h4>\\n        <p class=\\\"muted\\\">Every plan includes clear steps, expected signals to watch for, and what to do if something doesn’t improve. This keeps learning efficient and humane.</p>\\n      </section>\\n\\n      <div style=\\\"margin-top:18px; display:flex; gap:12px; align-items:center\\\">\\n        <a id=\\\"finalCta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"cta\\\">Start with a Calm Clarify visit — {{PRIMARY_CTA_LABEL}}</a>\\n        <div class=\\\"muted\\\">Or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent); text-decoration:none\\\">{{PHONE}}</a></div>\\n      </div>\\n\\n    </main>\\n\\n    <footer style=\\\"margin-top:22px; color:var(--muted)\\\">© <span id=\\\"yr3\\\"></span> {{BUSINESS_NAME}} · <a href=\\\"contact.html\\\" style=\\\"color:var(--accent); text-decoration:none\\\">Contact</a></footer>\\n  </div>\\n\\n  <script>\\n    (function(){\\n      document.getElementById('yr3').textContent = new Date().getFullYear();\\n      const moodSelect = document.getElementById('moodSelect');\\n      const note = document.getElementById('approachNote');\\n      const approachCta = document.getElementById('approachCta');\\n      const finalCta = document.getElementById('finalCta');\\n\\n      function updateFromMood(val){\\n        const phrases = {\\n          'Calm Clarify': 'A paced review and recovery plan',\\n          'Focus Renew': 'Tools to sharpen attention and reduce distraction',\\n          'Energy Rebuild': 'Rhythm-based changes for steadier days',\\n          'Investigate': 'Targeted tests and structured trials'\\n        };\\n        note.textContent = phrases[val] || '';\\n        approachCta.textContent = 'Request ' + val + ' — {{PRIMARY_CTA_LABEL}}';\\n        finalCta.textContent = 'Begin with ' + val + ' — {{PRIMARY_CTA_LABEL}}';\\n      }\\n      moodSelect.addEventListener('change', ()=>updateFromMood(moodSelect.value));\\n      updateFromMood(moodSelect.value);\\n\\n      // Timeline save/load\\n      const fields = ['f1d','f1note','f2d','f2note','f3d','f3note'];\\n      fields.forEach(id=>{\\n        const el = document.getElementById(id);\\n        el.value = localStorage.getItem('ap_'+id) || '';\\n      });\\n      document.getElementById('savePlan').addEventListener('click', ()=>{\\n        fields.forEach(id=>{\\n          const el=document.getElementById(id);\\n          localStorage.setItem('ap_'+id, el.value);\\n        });\\n        alert('Plan saved locally in your browser. Share these notes with your practitioner during visits.');\\n      });\\n\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
