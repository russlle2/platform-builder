          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Packages & Pricing — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"VIP Day and integrative care packages from {{BUSINESS_NAME}}. Single-day immersive planning and follow-up packages focused on whole-person health education.\\\">\\n  <style>\\n    :root{--bg1:#f9fbf8;--accent:#6aa84f;--muted:#6b7280;--card:#ffffff;--glass:rgba(255,255,255,0.6);--shadow:0 10px 25px rgba(18,22,26,0.08);--radius:12px}\\n    *{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:#0f1720;background:linear-gradient(180deg,var(--bg1),#eef6ee);min-height:100vh;line-height:1.5}\\n    /* SVG pattern as background using data URI for visual richness */\\n    html{background-image:radial-gradient(circle at 10% 10%,rgba(106,168,79,0.06),transparent 8%),linear-gradient(180deg,rgba(255,255,255,0.45),transparent 50%)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:52px;height:52px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--accent),#4f9c3a);box-shadow:0 6px 18px rgba(79,156,58,0.18);color:#fff;font-weight:700}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600}\\n    nav a.primary{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    main{max-width:980px;margin:28px auto;padding:28px}\\n    .hero{display:grid;grid-template-columns:1fr 320px;gap:28px;align-items:start}\\n    .hero-card{background:linear-gradient(180deg,rgba(255,255,255,0.8),var(--card));padding:26px;border-radius:var(--radius);box-shadow:var(--shadow)}\\n    h1{margin:0 0 8px;font-size:28px;color:#083014}\\n    p.lead{margin:0;color:var(--muted)}\\n    .cta-row{display:flex;gap:12px;margin-top:16px}\\n    .btn{display:inline-block;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .btn-cta{background:var(--accent);color:#fff}\\n    .btn-ghost{background:transparent;border:1px solid rgba(15,23,32,0.06);color:var(--muted)}\\n    /* Pricing grid */\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}\\n    .card{background:var(--card);border-radius:12px;padding:18px;box-shadow:var(--shadow);min-height:220px;display:flex;flex-direction:column}\\n    .card h3{margin:0 0 6px}\\n    .price{font-size:22px;color:#083014;font-weight:800;margin:8px 0}\\n    .muted{color:var(--muted);font-size:14px}\\n    ul.features{padding-left:18px;margin:12px 0 0}\\n    .small{font-size:13px;color:var(--muted)}\\n    /* FAQ */\\n    .faq{margin-top:24px}\\n    .faq-item{background:var(--card);padding:14px;border-radius:10px;margin-bottom:10px}\\n    .question{font-weight:700}\\n    .answer{margin-top:6px;color:var(--muted)}\\n    footer{margin-top:28px;padding:20px;border-top:1px solid rgba(15,23,32,0.04);display:flex;justify-content:space-between;align-items:center}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}} \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Welcome</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"approach.html\\\">Our Method</a>\\n      <a href=\\\"contact.html\\\" class=\\\"primary\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <h1>VIP Day packages: focused, educational, whole-person planning</h1>\\n        <p class=\\\"lead\\\">One-day immersive sessions for clients who want a clear plan, personalized education, and practical next steps. Each option emphasizes assessment, discussion, and an individualized integrative plan—not promises of cure.</p>\\n        <div class=\\\"cta-row\\\">\\n          <a href=\\\"book.html\\\" class=\\\"btn btn-cta\\\">Book a VIP Day</a>\\n          <a href=\\\"contact.html\\\" class=\\\"btn btn-ghost\\\">Ask a question</a>\\n        </div>\\n        <p class=\\\"small\\\" style=\\\"margin-top:12px\\\">Most packages include a pre-visit intake questionnaire and a 30-day follow-up touchpoint. Labs are available as optional educational tools and are discussed as part of shared decision-making.</p>\\n      </div>\\n\\n      <aside class=\\\"hero-card\\\" style=\\\"font-size:14px\\\">\\n        <strong>Practical note</strong>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:6px\\\">We do not guarantee outcomes. Our approach focuses on education, risk reduction, and coordinated supportive care. Insurance billing may vary; we provide superbills on request.</p>\\n        <div style=\\\"margin-top:12px\\\">\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">Phone</div>\\n          <div style=\\\"font-weight:700\\\">{{PHONE}}</div>\\n        </div>\\n        <div style=\\\"margin-top:12px\\\">\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">Email</div>\\n          <div style=\\\"font-weight:700\\\">{{EMAIL}}</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section aria-labelledby=\\\"pricing-heading\\\" style=\\\"margin-top:24px\\\">\\n      <h2 id=\\\"pricing-heading\\\" style=\\\"margin:0 0 8px\\\">Packages & investment</h2>\\n      <p class=\\\"muted\\\" style=\\\"margin:0 0 12px\\\">Designed for different needs: foundational education, targeted investigation, and comprehensive planning. Fees reflect time, clinician expertise ({{PRACTITIONER_NAME}}, {{CREDENTIALS}}), and included pre/post touchpoints.</p>\\n\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"card\\\">\\n          <h3>Focused Tune — Half-Day</h3>\\n          <div class=\\\"price\\\">$650</div>\\n          <div class=\\\"muted\\\">2.5–3 hours | intake + focused plan</div>\\n          <ul class=\\\"features\\\">\\n            <li>Pre-visit intake form</li>\\n            <li>Targeted review and plan</li>\\n            <li>30-day follow-up email</li>\\n          </ul>\\n          <div style=\\\"margin-top:auto\\\">\\n            <a class=\\\"btn btn-cta\\\" href=\\\"book.html#tune\\\">Choose</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <h3>Deep Reset — VIP Day</h3>\\n          <div class=\\\"price\\\">$1850</div>\\n          <div class=\\\"muted\\\">Full day | comprehensive assessment & plan</div>\\n          <ul class=\\\"features\\\">\\n            <li>Extensive intake & medication review</li>\\n            <li>Personalized, multi-domain plan (sleep, stress, nutrition, movement)</li>\\n            <li>30–60 day follow-up call</li>\\n          </ul>\\n          <div style=\\\"margin-top:auto\\\">\\n            <a class=\\\"btn btn-cta\\\" href=\\\"book.html#vip\\\">Choose</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <h3>Ongoing Launch — VIP + 3-month support</h3>\\n          <div class=\\\"price\\\">$3200</div>\\n          <div class=\\\"muted\\\">Deep VIP Day + structured check-ins</div>\\n          <ul class=\\\"features\\\">\\n            <li>VIP Day + three 30-min follow-ups</li>\\n            <li>Support tools, tracker templates</li>\\n            <li>Optional lab review sessions (education-focused)</li>\\n          </ul>\\n          <div style=\\\"margin-top:auto\\\">\\n            <a class=\\\"btn btn-cta\\\" href=\\\"book.html#launch\\\">Choose</a>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3 style=\\\"margin-bottom:8px\\\">Frequently asked — practical answers</h3>\\n      <div class=\\\"faq-item\\\">\\n        <div class=\\\"question\\\">Do you bill insurance?</div>\\n        <div class=\\\"answer\\\">We are primarily fee-for-service. We can provide a superbill for clients to submit to certain insurers; coverage depends on your plan. Payment policies are reviewed at booking.</div>\\n      </div>\\n\\n      <div class=\\\"faq-item\\\">\\n        <div class=\\\"question\\\">Are labs required?</div>\\n        <div class=\\\"answer\\\">Labs are optional tools used when clinically appropriate. They are discussed in the intake and pursued only with informed consent. We focus on interpretation and practical next steps.</div>\\n      </div>\\n\\n      <div class=\\\"faq-item\\\">\\n        <div class=\\\"question\\\">What if I need ongoing care?</div>\\n        <div class=\\\"answer\\\">If sustained support is indicated, we design a plan that may include regular check-ins, referrals, or community resources. The VIP Day is designed to create a clear, teachable roadmap.</div>\\n      </div>\\n\\n      <div class=\\\"faq-item\\\">\\n        <div class=\\\"question\\\">Cancellation & reschedule policy</div>\\n        <div class=\\\"answer\\\">For VIP Day bookings, please notify us at least 7 days in advance to reschedule. Fees and refunds are explained during booking. Emergencies are handled case-by-case.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px;display:flex;gap:12px;align-items:center;justify-content:space-between\\\">\\n      <div>\\n        <div style=\\\"font-weight:700\\\">Ready to book a VIP Day?</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Select a package and reserve your date. We’ll send a pre-visit intake to prepare.</div>\\n      </div>\\n      <div>\\n        <a href=\\\"book.html\\\" class=\\\"btn btn-cta\\\">Schedule now</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"font-size:13px;color:var(--muted)\\\">© {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n    <div style=\\\"font-size:13px;color:var(--muted)\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n  </footer>\\n\\n  <script>\\n    // Simple accordion for FAQ\\n    document.querySelectorAll('.faq-item').forEach(function(item){\\n      item.addEventListener('click',function(){\\n        this.classList.toggle('open');\\n        var a=this.querySelector('.answer');\\n        if(this.classList.contains('open')){a.style.display='block'}else{a.style.display='none'}\\n      });\\n      // start collapsed\\n      item.querySelector('.answer').style.display='none';\\n    });\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Meet {{PRACTITIONER_NAME}} and learn about our integrative, whole-person approach to health and education.\\\">\\n  <style>\\n    :root{--bg:#fffefb;--accent:#2b7a4b;--muted:#556169;--card:#ffffff;--glass:rgba(255,255,255,0.75);--radius:14px}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:#0b1a14;background:linear-gradient(180deg,#fbfff8,#eef7ee);}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 26px}\\n    .logo{width:48px;height:48px;border-radius:11px;background:linear-gradient(135deg,var(--accent),#2e8b54);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    nav a.contact{color:var(--accent);font-weight:700}\\n    main{max-width:980px;margin:18px auto;padding:20px}\\n    .intro{display:flex;gap:20px;align-items:flex-start}\\n    .card{background:var(--card);padding:18px;border-radius:var(--radius);box-shadow:0 8px 26px rgba(16,24,26,0.06)}\\n    .bio{flex:1}\\n    .portrait{width:260px;border-radius:12px;background:linear-gradient(180deg,#ffffff,#f3fff2);padding:16px;display:flex;flex-direction:column;align-items:center;gap:10px}\\n    h1{margin:0 0 8px;font-size:26px}\\n    p.lead{margin:0;color:var(--muted)}\\n    .section{margin-top:16px}\\n    .pill{display:inline-block;background:rgba(43,122,75,0.08);color:var(--accent);padding:6px 10px;border-radius:999px;font-weight:700;font-size:13px}\\n    .list{margin-top:10px}\\n    .muted{color:var(--muted)}\\n    footer{margin-top:20px;padding:18px;border-top:1px solid rgba(11,26,20,0.04);display:flex;justify-content:space-between}\\n    @media(max-width:880px){.intro{flex-direction:column}.portrait{width:100%}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Practical integrative care in {{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Intro</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"pricing.html\\\">Costs</a>\\n      <a href=\\\"contact.html\\\" class=\\\"contact\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"intro\\\">\\n      <div class=\\\"bio card\\\">\\n        <h1>About {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</h1>\\n        <p class=\\\"lead\\\">I blend evidence-informed medicine with practical lifestyle tools so clients leave with a clear, manageable plan. My work centers on education, shared decision-making, and whole-person context: medical history, sleep, stress, nutrition, movement, and environment.</p>\\n\\n        <div class=\\\"section\\\">\\n          <div class=\\\"pill\\\">Philosophy — Whole-person first</div>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:10px\\\">We focus on root contributors and daily habits rather than quick fixes. Every plan is tailored, realistic, and measurable. Labs may be offered as an educational resource when they help guide safe decisions.</p>\\n        </div>\\n\\n        <div class=\\\"section\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">What to expect at a first visit</h3>\\n          <ol class=\\\"list muted\\\">\\n            <li>Pre-visit intake to gather history and priorities.</li>\\n            <li>An in-depth, conversational evaluation—your goals guide the visit.</li>\\n            <li>A practical plan with small, trackable steps and optional resources.</li>\\n          </ol>\\n          <p class=\\\"muted small\\\" style=\\\"margin-top:8px\\\">We do not promise cures; rather, we aim to improve understanding, reduce risk, and support sustainable change.</p>\\n        </div>\\n\\n        <div class=\\\"section\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">Credentials & training</h3>\\n          <p class=\\\"muted\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}}, trained in integrative approaches with additional certifications in nutrition and functional assessment. Continuous learning and measured outcomes shape clinical decisions.</p>\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"portrait card\\\">\\n        <div style=\\\"width:120px;height:120px;border-radius:12px;background:linear-gradient(135deg,#f7fff3,#e6f6e4);display:flex;align-items:center;justify-content:center;font-weight:800;color:var(--accent);font-size:36px\\\">{{PRACTITIONER_NAME.split(' ')[0][0]}}{{PRACTITIONER_NAME.split(' ')[1] ? PRACTITIONER_NAME.split(' ')[1][0] : ''}}</div>\\n        <div style=\\\"font-weight:700\\\">{{PRACTITIONER_NAME}}</div>\\n        <div style=\\\"color:var(--muted);font-size:13px\\\">{{CREDENTIALS}}</div>\\n        <div style=\\\"margin-top:10px;color:var(--muted);font-size:13px\\\">Based in {{CITY}}, {{STATE}}</div>\\n        <div style=\\\"margin-top:12px;width:100%\\\"><a href=\\\"book.html\\\" class=\\\"pill\\\" style=\\\"text-decoration:none\\\">Schedule a time</a></div>\\n      </aside>\\n    </div>\\n\\n    <section class=\\\"section card\\\" style=\\\"margin-top:16px\\\">\\n      <h3 style=\\\"margin-top:0\\\">A typical clinical ritual</h3>\\n      <p class=\\\"muted\\\">Our visit sequence is intentionally structured to maximize clarity and respect your time. We call it a ritual because consistent structure improves outcomes and reduces unnecessary tests.</p>\\n\\n      <ul class=\\\"list\\\" style=\\\"margin-top:10px;color:var(--muted)\\\">\\n        <li><strong>1. Intake synthesis:</strong> quick summary of your history and priorities.</li>\\n        <li><strong>2. Focused review:</strong> targeted discussion of domains that matter most to you.</li>\\n        <li><strong>3. Practical plan:</strong> stepwise activities, measurable short-term goals, and resources.</li>\\n        <li><strong>4. Follow-up:</strong> check-ins and adjustments; labs only when they inform a safe plan.</li>\\n      </ul>\\n    </section>\\n\\n    <section class=\\\"section\\\" style=\\\"margin-top:16px\\\">\\n      <h3>Community & learning</h3>\\n      <p class=\\\"muted\\\">We emphasize self-education. After visits clients frequently receive worksheets, tracking templates, and trustworthy reading lists so they can make steady progress.</p>\\n      <div style=\\\"margin-top:12px\\\"><a href=\\\"contact.html\\\" class=\\\"pill\\\" style=\\\"text-decoration:none\\\">Discuss a VIP Day</a></div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"font-size:13px;color:var(--muted)\\\">© {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n    <div style=\\\"font-size:13px;color:var(--muted)\\\">Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Reserve your VIP Day or consultation at {{BUSINESS_NAME}}. Choose a package, pick a date, and complete a short intake to prepare.\\\">\\n  <style>\\n    :root{--bg:#fcfff9;--accent:#1f7a5f;--muted:#5b6b6a;--card:#ffffff;--radius:12px}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;background:linear-gradient(180deg,var(--bg),#eef7ee);color:#071812}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:16px 22px}\\n    .logo{width:44px;height:44px;border-radius:11px;background:linear-gradient(135deg,var(--accent),#2e8b54);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    main{max-width:920px;margin:12px auto;padding:20px}\\n    h1{margin:0 0 6px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:18px}\\n    .form-card{background:var(--card);padding:18px;border-radius:var(--radius);box-shadow:0 10px 28px rgba(18,22,26,0.06)}\\n    label{display:block;margin-top:12px;font-weight:700}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(0,0,0,0.06);margin-top:6px}\\n    .small{font-size:13px;color:var(--muted)}\\n    .btn{margin-top:12px;padding:10px 14px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none;display:inline-block}\\n    .aside{position:sticky;top:22px}\\n    .slot{background:#f7fff7;border-radius:10px;padding:10px;margin-bottom:8px;cursor:pointer}\\n    .slot.selected{box-shadow:0 6px 18px rgba(31,122,95,0.12);border:1px solid rgba(31,122,95,0.18)}\\n    footer{margin-top:20px;padding:16px;border-top:1px solid rgba(0,0,0,0.04);color:var(--muted)}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}.aside{position:static}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Back</a>\\n      <a href=\\\"about.html\\\">Who we are</a>\\n      <a href=\\\"pricing.html\\\">Packages</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <h1>Reserve a session</h1>\\n    <p class=\\\"small\\\">Pick a package and a convenient time. After booking you will receive a brief intake to complete before your visit. If you need assistance, call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</p>\\n\\n    <div class=\\\"grid\\\" role=\\\"region\\\">\\n      <div class=\\\"form-card\\\">\\n        <form id=\\\"bookingForm\\\">\\n          <label for=\\\"package\\\">Choose a package</label>\\n          <select id=\\\"package\\\" name=\\\"package\\\">\\n            <option value=\\\"tune\\\">Focused Tune — Half-Day ($650)</option>\\n            <option value=\\\"vip\\\">Deep Reset — VIP Day ($1850)</option>\\n            <option value=\\\"launch\\\">Ongoing Launch — VIP + 3mo ($3200)</option>\\n          </select>\\n\\n          <label for=\\\"name\\\">Your full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"First Last\\\" required>\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n\\n          <label for=\\\"phone\\\">Phone</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"(555) 555-5555\\\">\\n\\n          <label for=\\\"notes\\\">Brief priorities for the visit (1-2 sentences)</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"What matters most to you right now?\\\"></textarea>\\n\\n          <label for=\\\"slot\\\">Selected slot</label>\\n          <input id=\\\"slot\\\" name=\\\"slot\\\" readonly placeholder=\\\"Pick a time on the right\\\" required>\\n\\n          <div style=\\\"display:flex;gap:8px;align-items:center\\\">\\n            <button type=\\\"submit\\\" class=\\\"btn\\\">Confirm booking</button>\\n            <a href=\\\"mailto:{{EMAIL}}\\\" class=\\\"small\\\" style=\\\"margin-left:8px\\\">Need help? Email us</a>\\n          </div>\\n\\n          <p class=\\\"small\\\" style=\\\"margin-top:10px\\\">When you confirm we will email a link to a secure intake form and payment instructions. Labs are optional and discussed during the visit.</p>\\n        </form>\\n      </div>\\n\\n      <aside class=\\\"aside\\\">\\n        <div class=\\\"form-card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Available slots</h3>\\n          <div class=\\\"small muted\\\" style=\\\"margin-bottom:8px\\\">Select a time; times are local to {{CITY}}.</div>\\n\\n          <div id=\\\"slots\\\">\\n            <div class=\\\"slot\\\" data-slot=\\\"2026-03-02 09:00\\\">Mar 2 — 09:00 AM</div>\\n            <div class=\\\"slot\\\" data-slot=\\\"2026-03-04 13:30\\\">Mar 4 — 01:30 PM</div>\\n            <div class=\\\"slot\\\" data-slot=\\\"2026-03-07 10:00\\\">Mar 7 — 10:00 AM</div>\\n            <div class=\\\"slot\\\" data-slot=\\\"2026-03-10 14:00\\\">Mar 10 — 02:00 PM</div>\\n            <div class=\\\"slot\\\" data-slot=\\\"2026-03-15 08:30\\\">Mar 15 — 08:30 AM</div>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\" class=\\\"small muted\\\">If none of these work, email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> with preferred dates and we will try to accommodate.</div>\\n        </div>\\n\\n        <div class=\\\"form-card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0 0 6px\\\">What happens next</h4>\\n          <ol style=\\\"margin:0;color:var(--muted);font-size:14px\\\">\\n            <li>Confirm your slot and package.</li>\\n            <li>Receive intake form and preparation notes.</li>\\n            <li>Attend the session; get a practical plan and follow-up schedule.</li>\\n          </ol>\\n          <div style=\\\"margin-top:10px\\\"><a href=\\\"pricing.html\\\" class=\\\"small\\\">See package details</a></div>\\n        </div>\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"small\\\">By booking you acknowledge fees and our scheduling policy. We prioritize safety and shared decision-making; no guarantees of specific outcomes are made.</div>\\n  </footer>\\n\\n  <script>\\n    // Slot selection\\n    document.querySelectorAll('.slot').forEach(function(el){\\n      el.addEventListener('click',function(){\\n        document.querySelectorAll('.slot').forEach(s=>s.classList.remove('selected'));\\n        this.classList.add('selected');\\n        document.getElementById('slot').value=this.getAttribute('data-slot');\\n      });\\n    });\\n\\n    // Form submission (demo - no real booking)\\n    document.getElementById('bookingForm').addEventListener('submit',function(e){\\n      e.preventDefault();\\n      var name=document.getElementById('name').value||'';\\n      var slot=document.getElementById('slot').value||'';\\n      if(!slot){alert('Please select a slot from the right.');return}\\n      // Simulate submission\\n      alert('Thanks '+name+' — your request for '+slot+' has been received. We will email next steps to '+document.getElementById('email').value);\\n      // In production, post to server here\\n      this.reset();\\n      document.querySelectorAll('.slot').forEach(s=>s.classList.remove('selected'));\\n    });\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
