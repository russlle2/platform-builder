          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Rates — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f1724;--card:#0b1220;--muted:#9aa5b1;--accent1:#8ad3c7;--accent2:#a48ef7;--glass:rgba(255,255,255,0.04);--glass2:rgba(255,255,255,0.02);}    \\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:#e6eef6;background:linear-gradient(180deg,#071226 0%, #07172b 60%);}\\n    .wrap{max-width:1100px;margin:40px auto;padding:36px;border-radius:14px;background:linear-gradient(180deg,var(--glass),transparent);box-shadow:0 8px 40px rgba(3,6,10,0.7);position:relative;overflow:hidden}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:10px;background:linear-gradient(135deg,var(--accent1),var(--accent2));display:flex;align-items:center;justify-content:center;font-weight:700;color:#042033}\\n    nav a{color:#cfeaf0;text-decoration:none;margin-left:18px;font-size:14px}\\n    nav a.cta{background:linear-gradient(90deg,var(--accent1),var(--accent2));padding:8px 12px;border-radius:8px;color:#021018;font-weight:600}\\n    .hero{display:grid;grid-template-columns:1fr 340px;gap:28px;align-items:center;padding:22px 0}\\n    .hero h1{margin:0;font-size:28px;line-height:1.05;color:#f4fbff}\\n    .hero p{color:var(--muted);margin-top:8px}\\n    .card{background:linear-gradient(180deg,var(--card),transparent);border-radius:12px;padding:18px;box-shadow:inset 0 1px 0 rgba(255,255,255,0.02)}\\n    .diag, .plan, .micro{display:flex;gap:12px;align-items:flex-start;margin-top:18px}\\n    .diag svg, .plan svg{width:44px;height:44px;flex:0 0 44px}\\n    .packages{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .pkg{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:16px;border-radius:10px}\\n    .pkg h3{margin:0 0 8px 0;color:#f8feff}\\n    .pkg p{margin:0 0 14px;color:var(--muted);font-size:14px}\\n    .price{font-weight:700;font-size:20px;color:#e8fff9}\\n    .retail{margin-top:18px;display:flex;gap:12px;flex-wrap:wrap}\\n    .retail .item{padding:10px 12px;border-radius:10px;background:var(--glass2);color:#dff6f0}\\n    footer{display:flex;justify-content:space-between;align-items:center;margin-top:22px}\\n    .cta-btn{background:linear-gradient(90deg,var(--accent2),var(--accent1));padding:12px 18px;border-radius:10px;color:#031018;font-weight:700;text-decoration:none}\\n    .muted{color:var(--muted);font-size:13px}\\n    /* decorative svg */\\n    .pattern{position:absolute;right:-80px;top:-80px;opacity:0.12;transform:rotate(12deg)}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.packages{grid-template-columns:1fr}.wrap{margin:18px;padding:18px}}\\n  </style>\\n</head>\\n<body>\\n  <div class='wrap'>\\n    <header>\\n      <div class='brand'>\\n        <div class='logo' aria-hidden='true'>HM</div>\\n        <div>\\n          <div style='font-size:16px;color:#f6fffd;font-weight:700'>{{BUSINESS_NAME}}</div>\\n          <div style='font-size:12px;color:var(--muted)'>Integrative care in {{CITY}}, {{STATE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href='index.html'>Home</a>\\n        <a href='services.html'>Treatments</a>\\n        <a href='conditions.html'>Concerns</a>\\n        <a href='approach.html'>Method</a>\\n        <a href='pricing.html' class='cta'>Rates</a>\\n      </nav>\\n    </header>\\n\\n    <svg class='pattern' width='420' height='420' viewBox='0 0 420 420' fill='none' xmlns='http://www.w3.org/2000/svg'>\\n      <defs>\\n        <linearGradient id='g1' x1='0' x2='1'><stop offset='0' stop-color='#8ad3c7'/><stop offset='1' stop-color='#a48ef7'/></linearGradient>\\n        <filter id='f1' x='-20%' y='-20%' width='140%' height='140%'><feGaussianBlur stdDeviation='18' result='b'/></filter>\\n      </defs>\\n      <g filter='url(#f1)' opacity='0.9'>\\n        <circle cx='80' cy='70' r='90' fill='url(#g1)'/>\\n        <circle cx='300' cy='220' r='110' fill='url(#g1)' opacity='0.7'/>\\n        <circle cx='180' cy='330' r='40' fill='url(#g1)' opacity='0.6'/>\\n      </g>\\n    </svg>\\n\\n    <section class='hero'>\\n      <div>\\n        <h1>Thoughtful pricing for whole-person care</h1>\\n        <p>Transparent packages and careful add-ons so you can choose support that fits your life. No promises of cure—just clear guidance, personalized plans, and practical tools.</p>\\n\\n        <div class='diag card'>\\n          <svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M12 2v20' stroke='#8ad3c7' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/><path d='M5 7c3 6 12 6 14 0' stroke='#a48ef7' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>\\n          <div>\\n            <strong style='color:#f4fbff'>What's included</strong>\\n            <div class='muted'>Initial intake, individualized plan, optional lab review, and two follow-ups in every plan unless noted.</div>\\n          </div>\\n        </div>\\n\\n        <div class='plan card'>\\n          <svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><rect x='3' y='4' width='18' height='16' rx='3' stroke='#a48ef7' stroke-width='1.5'/><path d='M8 11h8' stroke='#8ad3c7' stroke-width='1.5' stroke-linecap='round'/></svg>\\n          <div>\\n            <strong style='color:#f4fbff'>How billing works</strong>\\n            <div class='muted'>Pay per package or pick a matched plan; add retail products or extended coaching as needed. Insurance varies—ask for a superbill.</div>\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n      <aside>\\n        <div class='card'>\\n          <h3 style='margin:0 0 6px 0;color:#f4fbff'>Quick rates</h3>\\n          <div class='muted'>If you need help selecting, call {{PHONE}} or email {{EMAIL}}.</div>\\n          <div style='margin-top:12px'>\\n            <div style='display:flex;justify-content:space-between;align-items:center'><div class='muted'>Single Consult</div><div class='price'>$150</div></div>\\n            <div style='display:flex;justify-content:space-between;align-items:center;margin-top:8px'><div class='muted'>90-min Intake</div><div class='price'>$240</div></div>\\n            <div style='display:flex;justify-content:space-between;align-items:center;margin-top:8px'><div class='muted'>Follow-Up (30m)</div><div class='price'>$95</div></div>\\n          </div>\\n          <div style='margin-top:12px'><a class='cta-btn' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a></div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class='card' style='margin-top:18px'>\\n      <h3 style='margin:0;color:#f4fbff'>Packages—practical roadmaps</h3>\\n      <div class='packages'>\\n        <div class='pkg'>\\n          <h3>Starter Balance</h3>\\n          <p>For a focused reset: intake + one follow-up + targeted resources.</p>\\n          <div class='price'>$320</div>\\n        </div>\\n        <div class='pkg'>\\n          <h3>Sustained Care</h3>\\n          <p>Three months of guided support: intake + monthly follow-ups + habit toolkit.</p>\\n          <div class='price'>$820</div>\\n        </div>\\n        <div class='pkg'>\\n          <h3>Comprehensive Plan</h3>\\n          <p>Deep-dive with optional lab review, nutrition guidance, and extended coaching.</p>\\n          <div class='price'>$1,650</div>\\n        </div>\\n      </div>\\n\\n      <div style='margin-top:14px'>\\n        <div class='muted'>Optional testing & labs are billed separately and are educational. Labs may be recommended to inform a plan; selection and interpretation are collaborative.</div>\\n      </div>\\n    </section>\\n\\n    <section class='card' style='margin-top:18px'>\\n      <h3 style='margin:0;color:#f4fbff'>Retail + Add-ons</h3>\\n      <div class='retail'>\\n        <div class='item'>Herbal blends — $28</div>\\n        <div class='item'>Supplements (starter kit) — $45</div>\\n        <div class='item'>Extended coaching (monthly) — $180</div>\\n        <div class='item'>In-depth lab analysis — starting $120</div>\\n      </div>\\n      <div class='muted' style='margin-top:10px'>Retail items are optional. Please notify us of allergies or interactions.</div>\\n    </section>\\n\\n    <section class='card' style='margin-top:18px'>\\n      <h3 style='margin:0;color:#f4fbff'>Small daily shifts</h3>\\n      <div class='micro' style='flex-direction:column'>\\n        <div><strong>Micro habit:</strong> Wake 15 minutes earlier twice a week for breathwork.</div>\\n        <div><strong>Micro habit:</strong> Swap one processed snack for a whole-food option daily.</div>\\n        <div><strong>Micro habit:</strong> Journal 3 things that went well each evening.</div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div class='muted'>No guarantees are offered; our work emphasizes education, risk reduction, and supportive care across mind, body, and context.</div>\\n      <div><a class='cta-btn' href='{{PRIMARY_CTA_URL}}'>Book a consult</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#06121a;--panel:#071820;--muted:#9fb0b7;--accent:#9ad5d0;--accent2:#b6a8ff}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:radial-gradient(1200px 800px at 10% 10%,rgba(154,213,208,0.08),transparent),linear-gradient(180deg,#021018,#051323);color:#eaf8f6}\\n    .container{max-width:1000px;margin:36px auto;padding:28px;border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);box-shadow:0 20px 60px rgba(0,0,0,0.6);position:relative}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    .nav a{color:#cfeff4;text-decoration:none;margin-left:16px}\\n    h1{margin:8px 0 6px 0;font-size:26px}\\n    .lead{color:var(--muted);margin-bottom:12px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:18px}\\n    .panel{background:linear-gradient(180deg,var(--panel),transparent);padding:16px;border-radius:10px}\\n    .bio p{color:var(--muted)}\\n    .chip{background:rgba(255,255,255,0.02);padding:8px 10px;border-radius:8px;display:inline-block;margin-right:8px;margin-top:8px}\\n    .micro{margin-top:12px;color:var(--muted)}\\n    .pattern{position:absolute;left:-80px;bottom:-80px;opacity:0.08}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}.container{margin:14px;padding:16px}}\\n  </style>\\n</head>\\n<body>\\n  <div class='container'>\\n    <svg class='pattern' width='360' height='360' viewBox='0 0 360 360' fill='none' xmlns='http://www.w3.org/2000/svg'>\\n      <defs>\\n        <linearGradient id='lg' x1='0' x2='1'><stop offset='0' stop-color='#9ad5d0'/><stop offset='1' stop-color='#b6a8ff'/></linearGradient>\\n      </defs>\\n      <g opacity='0.95'>\\n        <rect x='20' y='20' width='220' height='220' rx='40' fill='url(#lg)' opacity='0.18'/>\\n        <circle cx='260' cy='260' r='80' fill='url(#lg)' opacity='0.12'/>\\n      </g>\\n    </svg>\\n\\n    <header>\\n      <div>\\n        <div style='font-weight:700;font-size:16px'>{{BUSINESS_NAME}}</div>\\n        <div class='lead'>A home for integrative, evidence-informed care in {{CITY}}, {{STATE}}</div>\\n      </div>\\n      <nav class='nav'>\\n        <a href='index.html'>Home</a>\\n        <a href='services.html'>Offerings</a>\\n        <a href='pricing.html'>Rates</a>\\n        <a href='book.html'>Reserve</a>\\n      </nav>\\n    </header>\\n\\n    <h1>Weaving science and lived experience</h1>\\n    <div class='grid'>\\n      <main>\\n        <section class='panel bio'>\\n          <h2 style='margin-top:0'>Hello—I'm {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</h2>\\n          <p>I trained in conventional and integrative settings and now focus on whole-person care that honors physiology, lifestyle, and story. My work centers on helping people build resilience and practical routines that support long-term wellbeing.</p>\\n          <p class='micro'><strong>Philosophy:</strong> I do not promise cures; instead I partner with you to reduce risk, clarify contributors to symptoms, and co-design sustainable plans that respect your context.</p>\\n\\n          <h3 style='margin-top:14px'>Education & training</h3>\\n          <p class='muted'>Board certifications, licensure, and continuing training across nutrition, herbal medicine, and behavior change inform a measured, evidence-aware approach.</p>\\n\\n          <h3 style='margin-top:12px'>Clinical focus</h3>\\n          <div class='chip'>Stress + nervous system support</div><div class='chip'>Sleep & circadian health</div><div class='chip'>Gut resilience</div>\\n\\n          <h3 style='margin-top:12px'>Not medical advice</h3>\\n          <p class='muted'>This site provides educational information. Individual assessment is necessary; please consult with your provider about medications, chronic conditions, or acute symptoms.</p>\\n        </section>\\n      </main>\\n\\n      <aside>\\n        <div class='panel'>\\n          <h4 style='margin:0 0 8px 0'>Quick facts</h4>\\n          <div class='muted'>Serving {{CITY}}, {{STATE}} — telehealth available across state lines per licensing.</div>\\n          <div style='margin-top:10px'><strong>Contact</strong><div class='muted'>{{PHONE}} • {{EMAIL}}</div></div>\\n\\n          <div style='margin-top:12px'>\\n            <h4 style='margin:0 0 6px 0'>Approach snapshot</h4>\\n            <div class='muted'>Intake → collaborative plan → short-term lab options → follow-ups. Focus on small habits, environmental changes, and clear metrics.</div>\\n          </div>\\n\\n          <div style='margin-top:12px'>\\n            <a style='display:inline-block;background:linear-gradient(90deg,#b6a8ff,#9ad5d0);padding:10px 12px;border-radius:10px;color:#041018;font-weight:700;text-decoration:none' href='{{PRIMARY_CTA_URL}}'>Book a time</a>\\n          </div>\\n        </div>\\n\\n        <div class='panel' style='margin-top:12px'>\\n          <h4 style='margin:0 0 8px 0'>Micro practices I recommend</h4>\\n          <ul style='padding-left:18px;color:var(--muted);margin:0'>\\n            <li>Daily 3-minute grounding practice on waking</li>\\n            <li>Two tech-free meals per day for improved digestion</li>\\n            <li>Weekly reflection on one small win</li>\\n          </ul>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer style='margin-top:18px;display:flex;justify-content:space-between;align-items:center'>\\n      <div class='muted'>I practice with an emphasis on safety and collaboration. I do not offer guaranteed cures—care is individualized.</div>\\n      <div><a href='book.html' style='background:linear-gradient(90deg,#9ad5d0,#b6a8ff);padding:10px 12px;border-radius:10px;color:#041018;font-weight:700;text-decoration:none'>Schedule a visit</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#08121a;--card:#081826;--muted:#95a8b0;--accent:#8bd6c9}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#031017,#051728);color:#e8f9f6}\\n    .shell{max-width:900px;margin:32px auto;padding:22px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);position:relative}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:#cfeff4;text-decoration:none;margin-left:14px}\\n    h1{margin:12px 0 6px;font-size:26px}\\n    .two{display:grid;grid-template-columns:1fr 360px;gap:20px;margin-top:18px}\\n    .panel{background:linear-gradient(180deg,var(--card),transparent);padding:16px;border-radius:12px}\\n    label{display:block;font-size:13px;color:var(--muted);margin-top:10px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.03);background:transparent;color:#e6f8f4}\\n    .btn{display:inline-block;margin-top:12px;background:linear-gradient(90deg,var(--accent),#b7aef8);padding:10px 14px;border-radius:10px;color:#031018;text-decoration:none;font-weight:700}\\n    .muted{color:var(--muted);font-size:13px}\\n    .pattern{position:absolute;right:-60px;top:-60px;opacity:0.06}\\n    @media(max-width:880px){.two{grid-template-columns:1fr}.shell{margin:14px;padding:14px}}\\n  </style>\\n</head>\\n<body>\\n  <div class='shell'>\\n    <svg class='pattern' width='320' height='320' viewBox='0 0 320 320' fill='none' xmlns='http://www.w3.org/2000/svg'>\\n      <defs>\\n        <linearGradient id='mg' x1='0' x2='1'><stop offset='0' stop-color='#8bd6c9'/><stop offset='1' stop-color='#b7aef8'/></linearGradient>\\n      </defs>\\n      <g>\\n        <path d='M40 40c60-40 180-40 240 0v240c-60 40-180 40-240 0z' fill='url(#mg)' opacity='0.08'/>\\n        <circle cx='80' cy='220' r='28' fill='url(#mg)' opacity='0.06'/>\\n      </g>\\n    </svg>\\n\\n    <header>\\n      <div>\\n        <div style='font-weight:700'>{{BUSINESS_NAME}}</div>\\n        <div class='muted'>Book a visit — telehealth & in-person options</div>\\n      </div>\\n      <nav>\\n        <a href='index.html'>Start</a>\\n        <a href='about.html'>About</a>\\n        <a href='pricing.html'>Rates</a>\\n      </nav>\\n    </header>\\n\\n    <h1>Reserve a conversation</h1>\\n    <p class='muted' style='margin-top:6px'>Choose a time for an initial intake or a follow-up. If you have urgent medical concerns, please call local emergency services or your primary care provider.</p>\\n\\n    <div class='two'>\\n      <main>\\n        <section class='panel'>\\n          <h3 style='margin-top:0'>Booking form</h3>\\n          <form action='https://example.com/submit' method='post' onsubmit='return handleSubmit(event)'>\\n            <label for='name'>Full name</label>\\n            <input id='name' name='name' placeholder='Your name' required>\\n\\n            <label for='email'>Email</label>\\n            <input id='email' type='email' name='email' placeholder='you@example.com' required>\\n\\n            <label for='phone'>Phone</label>\\n            <input id='phone' name='phone' placeholder='(555) 555-5555' required>\\n\\n            <label for='type'>Appointment type</label>\\n            <select id='type' name='type'>\\n              <option>90-min Intake</option>\\n              <option>Follow-up (30 min)</option>\\n              <option>Single Consult (60 min)</option>\\n            </select>\\n\\n            <label for='notes'>Brief concerns (optional)</label>\\n            <textarea id='notes' name='notes' rows='4' placeholder='What brings you in?'></textarea>\\n\\n            <div style='display:flex;gap:10px;align-items:center'>\\n              <button class='btn' type='submit'>Request time</button>\\n              <div class='muted' style='font-size:13px'>Prefer to call? <a href='tel:{{PHONE}}' style='color:#dff7f0;text-decoration:none'>{{PHONE}}</a></div>\\n            </div>\\n          </form>\\n        </section>\\n\\n        <section class='panel' style='margin-top:12px'>\\n          <h4 style='margin:0 0 8px 0'>Before your visit</h4>\\n          <div class='muted'>Complete an intake questionnaire when prompted. Consider a list of current medications, supplements, and any recent lab results to share.</div>\\n\\n          <h4 style='margin-top:10px'>Micro steps to prepare</h4>\\n          <ul style='color:var(--muted);margin:0;padding-left:18px'>\\n            <li>Note 1–3 symptoms you'd like to prioritize</li>\\n            <li>Gather medication and supplement names/doses</li>\\n            <li>If relevant, list recent labs or referral notes</li>\\n          </ul>\\n        </section>\\n      </main>\\n\\n      <aside>\\n        <div class='panel'>\\n          <h4 style='margin:0 0 8px 0'>How booking flows</h4>\\n          <ol style='color:var(--muted);margin:0 0 10px 18px;padding:0'>\\n            <li>We confirm availability by email.</li>\\n            <li>Complete intake docs before the visit.</li>\\n            <li>Visit: intake, education, and a collaborative plan.</li>\\n            <li>Follow-ups scheduled as needed.</li>\\n          </ol>\\n\\n          <div style='margin-top:8px'>\\n            <strong style='color:#f4fffb'>Fees & insurance</strong>\\n            <div class='muted' style='margin-top:6px'>Services are self-pay by default. We can provide superbills—insurance reimbursement varies by plan.</div>\\n          </div>\\n\\n          <div style='margin-top:12px'>\\n            <a class='btn' href='mailto:{{EMAIL}}'>Email us</a>\\n          </div>\\n        </div>\\n\\n        <div class='panel' style='margin-top:12px'>\\n          <h4 style='margin:0 0 8px 0'>Safety & scope</h4>\\n          <div class='muted'>Our focus is education and integrative support. We do not offer emergency medical services. For urgent or life-threatening issues, contact emergency services.</div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer style='margin-top:18px;display:flex;justify-content:space-between;align-items:center'>\\n      <div class='muted'>By requesting an appointment you agree to receive communications from {{BUSINESS_NAME}}. Privacy and consent details will be provided with scheduling.</div>\\n      <div><a class='btn' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a></div>\\n    </footer>\\n  </div>\\n\\n  <script>\\n    function handleSubmit(e){\\n      e.preventDefault();\\n      alert('Request received. We will follow up via email to confirm your appointment.');\\n      // In production, this would POST to a scheduling backend.\\n      return false;\\n    }\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
  "parallel_tool_calls": true,
  "presence_penalty": 0,
  "previous_response_id": null,
  "prompt_cache_key": null,
  "prompt_cache_retention": null,
  "reasoning": {
    "effort": "medium",
    "summary": null
  },
  "safety_identifier": null,
  "service_tier": "default",
  "store": true,
  "temperature": 1,
  "text": {
    "format": {
