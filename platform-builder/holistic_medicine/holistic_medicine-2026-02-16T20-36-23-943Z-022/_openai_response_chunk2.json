          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} — Services</title>\\n  <style>\\n    :root{--glass-bg: rgba(255,255,255,0.08);--card-bg: rgba(255,255,255,0.06);--accent: #7bd389;--muted:#cfeee0;--glass-border: rgba(255,255,255,0.12)}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial;color:#f8f9fb;background:linear-gradient(135deg,#0f1724 0%,#071428 50%,#0a2333 100%);-webkit-font-smoothing:antialiased}\\n    /* background pattern */\\n    .pattern{position:fixed;inset:0;pointer-events:none;opacity:0.14}\\n    .wrap{max-width:1100px;margin:48px auto;padding:36px;border-radius:18px;backdrop-filter:blur(10px) saturate(120%);background:linear-gradient(180deg,rgba(255,255,255,0.03),rgba(255,255,255,0.02));box-shadow:0 8px 30px rgba(2,6,23,0.6);border:1px solid var(--glass-border)}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:52px;height:52px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#5ec3ff);display:flex;align-items:center;justify-content:center;color:#052023;font-weight:700}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:14px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:22px;align-items:start}\\n    .lead{padding:22px;background:var(--glass-bg);border-radius:12px;border:1px solid var(--glass-border)}\\n    h1{margin:0 0 8px 0;font-size:26px;color:#e6fbf0}\\n    p.leadsub{margin:0;color:#d6efe3}\\n    .panel{padding:18px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border-radius:12px;border:1px solid var(--glass-border)}\\n    .services-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:18px}\\n    .service{background:var(--card-bg);padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.04)}\\n    .service h3{margin:0 0 6px 0;font-size:16px;color:#e9fff3}\\n    .service p{margin:0;color:#cfeee0;font-size:14px}\\n    .meta{font-size:13px;color:#bde6cf;margin-top:10px}\\n    .cta{margin-top:20px;text-align:right}\\n    .btn{background:linear-gradient(90deg,var(--accent),#5ec3ff);color:#042023;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{margin-top:26px;color:#bcded0;font-size:13px;display:flex;justify-content:space-between;align-items:center}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr}.services-grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- decorative svg pattern (unique to this page) -->\\n  <svg class='pattern' viewBox='0 0 800 600' preserveAspectRatio='xMidYMid meet' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n    <defs>\\n      <linearGradient id='g1' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#7bd389' stop-opacity='0.45'/>\\n        <stop offset='1' stop-color='#5ec3ff' stop-opacity='0.35'/>\\n      </linearGradient>\\n      <pattern id='p1' width='40' height='40' patternUnits='userSpaceOnUse'>\\n        <circle cx='6' cy='6' r='2.5' fill='url(#g1)' />\\n        <rect x='20' y='20' width='12' height='12' fill='rgba(255,255,255,0.02)' />\\n      </pattern>\\n      <filter id='soft' x='-20%' y='-20%' width='140%' height='140%'>\\n        <feGaussianBlur stdDeviation='12' result='b' />\\n        <feBlend in='SourceGraphic' in2='b' mode='normal' />\\n      </filter>\\n    </defs>\\n    <rect width='100%' height='100%' fill='url(#p1)' filter='url(#soft)' />\\n    <g transform='translate(120,60)' opacity='0.9'>\\n      <path d='M0 160 C120 40 260 260 380 120' stroke='url(#g1)' stroke-width='2' fill='none' stroke-linecap='round' />\\n      <circle cx='380' cy='120' r='48' fill='url(#g1)' opacity='0.08' />\\n    </g>\\n  </svg>\\n\\n  <div class='wrap'>\\n    <header>\\n      <div class='brand'>\\n        <div class='logo'>HM</div>\\n        <div>\\n          <div style='color:#e8fff4;font-weight:700'>{{BUSINESS_NAME}}</div>\\n          <div style='color:#b7e8d9;font-size:13px'>Holistic & integrative care • {{CITY}}, {{STATE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href='index.html'>Home</a>\\n        <a href='services.html' style='color:#e6fff0'>Services</a>\\n        <a href='conditions.html'>Concerns</a>\\n        <a href='approach.html'>Care</a>\\n        <a href='book.html'>Book</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class='hero'>\\n        <div class='lead panel'>\\n          <h1>Integrated offerings for whole-person health</h1>\\n          <p class='leadsub'>We combine evidence-informed nutrition, botanical and lifestyle strategies with modern diagnostics to support resilience, symptom relief, and long-term wellbeing. Care is collaborative and tailored to your life.</p>\\n\\n          <div class='services-grid' aria-hidden='false'>\\n            <div class='service'>\\n              <h3>Integrative Clinical Consultation</h3>\\n              <p>Comprehensive intake that covers medical history, lifestyle, and goals to form a practical care plan.</p>\\n            </div>\\n            <div class='service'>\\n              <h3>Nutritional & Lifestyle Counseling</h3>\\n              <p>Food-first guidance, sleep and stress tools, movement planning, and habit-based coaching.</p>\\n            </div>\\n            <div class='service'>\\n              <h3>Herbal & Nutraceutical Guidance</h3>\\n              <p>Evidence-informed options discussed with attention to interactions and safety; patient education prioritized.</p>\\n            </div>\\n            <div class='service'>\\n              <h3>Mind-Body Practices</h3>\\n              <p>Breathwork, guided relaxation, and behavioral strategies to support stress and sleep.</p>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <aside class='panel'>\\n          <h3 style='color:#e8fff4;margin-top:0'>Hybrid care model</h3>\\n          <p style='color:#cfeee0;margin:0'>Sessions available in-person and via secure telehealth. Flexible follow-ups and optional educational labs are offered when clinically appropriate.</p>\\n\\n          <div class='meta'>\\n            <div style='margin-top:12px'>Primary contact: <a href='tel:{{PHONE}}' style='color:#cfeee0;text-decoration:none'>{{PHONE}}</a></div>\\n            <div style='margin-top:6px'>Email: <a href='mailto:{{EMAIL}}' style='color:#cfeee0;text-decoration:none'>{{EMAIL}}</a></div>\\n          </div>\\n\\n          <div class='cta'>\\n            <a class='btn' href='{{PRIMARY_CTA_URL}}' aria-label='Schedule'>{{PRIMARY_CTA_LABEL}}</a>\\n          </div>\\n        </aside>\\n      </section>\\n\\n      <section style='margin-top:22px'>\\n        <div class='panel'>\\n          <h2 style='color:#e8fff4;margin:0 0 10px 0'>How we partner with you</h2>\\n          <p style='color:#d9efe2;margin:0'>Care is collaborative and pragmatic: we prioritize non-invasive strategies first, monitor outcomes, and adapt plans so they integrate into daily life. Education about options and risks is central to every recommendation.</p>\\n        </div>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div>© <strong>{{BUSINESS_NAME}}</strong> — {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n      <div><a href='contact.html' style='color:#cfeee0;text-decoration:none'>Connect</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} — Conditions we support</title>\\n  <style>\\n    :root{--bg1:#021421;--card:rgba(255,255,255,0.04);--glass-border:rgba(255,255,255,0.10);--accent:#6bd2a8}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial;color:#e9fff6;background:linear-gradient(180deg,#021421 0%,#042732 60%)}\\n    .container{max-width:980px;margin:48px auto;padding:28px;border-radius:16px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));backdrop-filter:blur(8px);border:1px solid var(--glass-border)}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:#bfeedd;text-decoration:none;margin-left:16px;font-size:14px}\\n    .title{font-size:22px;margin:6px 0;color:#eafff4}\\n    .intro{color:#cfeee0;margin-bottom:18px}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}\\n    .card{background:var(--card);padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .card h3{margin:0;color:#e9fff2;font-size:16px}\\n    .card p{margin:8px 0 0 0;color:#c8efe0;font-size:14px}\\n    .disclaimer{margin-top:14px;padding:10px;border-radius:10px;background:rgba(255,255,255,0.02);color:#bfe8d7;font-size:13px}\\n    .learn{margin-top:12px;text-align:right}\\n    .btn{background:transparent;border:1px solid var(--accent);color:var(--accent);padding:8px 12px;border-radius:10px;text-decoration:none;font-weight:700}\\n    @media(max-width:820px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique svg background for this page -->\\n  <svg viewBox='0 0 600 400' style='position:fixed;right:0;top:0;opacity:0.08;pointer-events:none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n    <defs>\\n      <linearGradient id='c1' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#6bd2a8'/>\\n        <stop offset='1' stop-color='#75d0ff'/>\\n      </linearGradient>\\n    </defs>\\n    <g transform='translate(20,20)'>\\n      <rect x='0' y='40' width='520' height='220' rx='36' fill='url(#c1)' opacity='0.06'/>\\n      <circle cx='480' cy='60' r='32' fill='url(#c1)' opacity='0.05'/>\\n      <path d='M40 320 C160 260 300 360 460 300' stroke='url(#c1)' stroke-width='2' fill='none' opacity='0.07'/>\\n    </g>\\n  </svg>\\n\\n  <div class='container'>\\n    <header>\\n      <div>\\n        <div style='font-weight:700;color:#eafff6'>{{BUSINESS_NAME}}</div>\\n        <div style='color:#bfeedd;font-size:13px'>Supporting common health concerns with education and whole-person plans</div>\\n      </div>\\n      <nav>\\n        <a href='index.html'>Welcome</a>\\n        <a href='services.html'>Services</a>\\n        <a href='conditions.html' style='color:#e6fff0'>Concerns</a>\\n        <a href='approach.html'>Our process</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <h1 class='title'>Areas people often seek help for</h1>\\n      <p class='intro'>Below are common concerns we address through lifestyle, nutritional, botanical, and behavioral strategies. Recommendations focus on safety, evidence-informed options, and practical steps you can try. This is educational care and not a guarantee of specific outcomes.</p>\\n\\n      <section class='grid' role='list'>\\n        <article class='card' role='listitem'>\\n          <h3>Stress & burnout</h3>\\n          <p>Support focuses on sleep hygiene, pacing, breath and relaxation techniques, nutritional supports, and habit changes to reduce physiological load.</p>\\n        </article>\\n\\n        <article class='card' role='listitem'>\\n          <h3>Sleep disturbance</h3>\\n          <p>Behavioral sleep strategies, circadian guidance, and safe adjunctive supports are discussed. We prioritize non-pharmacologic approaches when appropriate.</p>\\n        </article>\\n\\n        <article class='card' role='listitem'>\\n          <h3>Digestive concerns</h3>\\n          <p>Education about diet patterns, meal timing, microbiome-supportive choices, and when further testing or referral may be warranted.</p>\\n        </article>\\n\\n        <article class='card' role='listitem'>\\n          <h3>Chronic inflammation & pain</h3>\\n          <p>Strategies include diet, movement, stress reduction, sleep optimization, and exploring safe targeted adjuncts. Collaborative care with other providers is common.</p>\\n        </article>\\n\\n        <article class='card' role='listitem'>\\n          <h3>Low energy & metabolic balance</h3>\\n          <p>We review lifestyle, sleep, nutrition, and consider educational labs when helpful to guide individualized plans.</p>\\n        </article>\\n\\n      </section>\\n\\n      <div class='disclaimer'>\\n        Important: These descriptions are for education and planning. Individual responses vary and no clinic can promise a cure. When appropriate, we will coordinate with your existing clinicians for safe and effective care.</div>\\n\\n      <div class='learn'>\\n        <a class='btn' href='approach.html'>Learn how we evaluate concerns</a>\\n      </div>\\n\\n    </main>\\n\\n    <footer style='margin-top:18px;color:#bfeedd;font-size:13px'>\\n      Contact {{PRACTITIONER_NAME}} at <a href='mailto:{{EMAIL}}' style='color:#bfeedd'>{{EMAIL}}</a> or <a href='tel:{{PHONE}}' style='color:#bfeedd'>{{PHONE}}</a>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} — Our approach</title>\\n  <style>\\n    :root{--bg:#071827;--card:rgba(255,255,255,0.03);--accent:#89e0b6;--glass-border:rgba(255,255,255,0.09)}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial;color:#e8fff4;background:radial-gradient(1200px 600px at 10% 10%,#08303a 0%,#04121a 40%,#03111a 100%)}\\n    .sheet{max-width:980px;margin:48px auto;padding:28px;border-radius:16px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));backdrop-filter:blur(10px);border:1px solid var(--glass-border)}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    .nav a{color:#bfeedd;text-decoration:none;margin-left:16px}\\n    h1{margin:10px 0 6px 0;color:#e8fff4}\\n    .summary{color:#cfeee0}\\n    .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .step{background:var(--card);padding:16px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .step h3{margin:0;color:#e9fff2;font-size:15px}\\n    .step p{margin:8px 0 0 0;color:#cfeee0;font-size:14px}\\n    .note{margin-top:14px;color:#bce7d4;font-size:13px}\\n    .cta{margin-top:20px;text-align:center}\\n    .btn{background:linear-gradient(90deg,var(--accent),#5ec3ff);color:#052022;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    @media(max-width:880px){.steps{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique svg motif for approach page -->\\n  <svg style='position:fixed;left:0;bottom:0;opacity:0.12;pointer-events:none' viewBox='0 0 700 300' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n    <defs>\\n      <linearGradient id='a1' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#89e0b6'/>\\n        <stop offset='1' stop-color='#6fc8ff'/>\\n      </linearGradient>\\n    </defs>\\n    <g transform='translate(0,20)'>\\n      <ellipse cx='140' cy='200' rx='160' ry='60' fill='url(#a1)' opacity='0.05' />\\n      <path d='M20 140 C140 60 300 220 560 120' stroke='url(#a1)' stroke-width='2' fill='none' opacity='0.06' />\\n    </g>\\n  </svg>\\n\\n  <div class='sheet'>\\n    <header>\\n      <div>\\n        <div style='font-weight:700;color:#eafff6'>{{BUSINESS_NAME}}</div>\\n        <div style='color:#bfeedd;font-size:13px'>A thoughtful, stepwise process to personalized care</div>\\n      </div>\\n      <nav class='nav'>\\n        <a href='index.html'>Home</a>\\n        <a href='services.html'>Offerings</a>\\n        <a href='conditions.html'>Support</a>\\n        <a href='book.html'>Schedule</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <h1>How we assess and support you</h1>\\n      <p class='summary'>Our focus is practical education and tailored plans. Below are the typical steps in a new therapeutic partnership. Optional educational tests are discussed transparently — we never order anything without explaining purpose, limits, and alternatives.</p>\\n\\n      <section class='steps' aria-label='Care steps'>\\n        <div class='step'>\\n          <h3>1 — Intake & Listening</h3>\\n          <p>Extended first visit to review medical history, lifestyle patterns, medications, exposures, and goals. The aim is to understand context and identify priorities.</p>\\n        </div>\\n        <div class='step'>\\n          <h3>2 — Assessment & Shared Plan</h3>\\n          <p>We translate findings into a personalized, realistic plan that may include dietary changes, movement, stress tools, and targeted safe interventions. Education drives decisions.</p>\\n        </div>\\n        <div class='step'>\\n          <h3>3 — Optional Educational Labs</h3>\\n          <p>If helpful, we discuss non-invasive labs to refine the plan (eg, basic metabolic panels, targeted nutrient testing, or stool/cardiometabolic markers). These are educational tools used selectively.</p>\\n        </div>\\n\\n        <div class='step'>\\n          <h3>4 — Implementation Support</h3>\\n          <p>We provide pragmatic steps, resources, and follow-up points. Small, measurable changes are emphasized to support sustainable improvement.</p>\\n        </div>\\n        <div class='step'>\\n          <h3>5 — Follow-ups & Adjustment</h3>\\n          <p>Regular follow-ups to monitor progress, adjust plans, and coordinate with other clinicians. We track outcomes and adapt based on what is working and what is not.</p>\\n        </div>\\n        <div class='step'>\\n          <h3>6 — Maintenance & Self-care</h3>\\n          <p>Long-term focus on resilience-building skills and prevention strategies so you can manage health with confidence.</p>\\n        </div>\\n      </section>\\n\\n      <p class='note'>Note: Care is integrative and collaborative. We educate about potential benefits and risks for each option. Results vary by individual; this information is not a promise of cure.</p>\\n\\n      <div class='cta'>\\n        <a class='btn' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </main>\\n\\n    <footer style='margin-top:18px;color:#bce7d4;font-size:13px'>\\n      For appointments or questions call <a href='tel:{{PHONE}}' style='color:#bce7d4'>{{PHONE}}</a> or email <a href='mailto:{{EMAIL}}' style='color:#bce7d4'>{{EMAIL}}</a>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
