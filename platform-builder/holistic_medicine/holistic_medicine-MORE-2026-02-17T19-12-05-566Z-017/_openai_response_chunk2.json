          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Offerings — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--glass-bg:rgba(255,255,255,0.06);--glass-border:rgba(255,255,255,0.12);--accent:#2b8c6b;--muted:#cbd5d1;--bg:#071420;--card:#0b2430}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:linear-gradient(180deg,#04121a 0%,#071420 60%);color:#e6f2ef}\\n    body{display:flex;flex-direction:column;align-items:center}\\n    .wrap{width:100%;max-width:1100px;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#4fb48f);box-shadow:0 6px 18px rgba(43,140,107,0.18);display:flex;align-items:center;justify-content:center;font-weight:700}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:14px;font-size:14px}\\n    nav a.primary{background:var(--accent);color:white;padding:8px 12px;border-radius:8px}\\n    .hero{background:var(--glass-bg);border:1px solid var(--glass-border);backdrop-filter:blur(8px);padding:26px;border-radius:14px;display:grid;grid-template-columns:1fr 300px;gap:20px;align-items:center}\\n    .hero h1{margin:0;font-size:28px}\\n    .hero p{margin:8px 0 0;color:var(--muted)}\\n    .offer-card{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.04)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:20px}\\n    .service{background:var(--card);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .service h3{margin:0 0 8px}\\n    .service p{margin:0;color:var(--muted);font-size:14px}\\n    .price{margin-top:12px;font-weight:700;color:var(--accent)}\\n    .cta-row{display:flex;gap:12px;margin-top:18px}\\n    .btn{padding:10px 14px;border-radius:10px;border:0;cursor:pointer}\\n    .btn-solid{background:var(--accent);color:#042018}\\n    .btn-outline{background:transparent;border:1px solid rgba(255,255,255,0.06);color:var(--muted)}\\n    .social-proof{display:flex;gap:14px;align-items:flex-start;margin-top:20px}\\n    .testimonials{flex:1;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .badge-strip{width:220px;display:flex;flex-direction:column;gap:8px}\\n    .badge{background:#071c1a;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.03);display:flex;align-items:center;gap:10px;cursor:default}\\n    .badge .b-icon{width:36px;height:36;border-radius:6px;background:rgba(255,255,255,0.02);display:flex;align-items:center;justify-content:center}\\n    .tooltip{position:relative}\\n    .tooltip:hover::after{content:attr(data-tip);position:absolute;left:50%;transform:translateX(-50%);bottom:calc(100% + 8px);background:#011017;padding:8px;border-radius:8px;border:1px solid rgba(255,255,255,0.05);white-space:nowrap;font-size:13px}\\n    .timeline{margin-top:22px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .phase{display:flex;align-items:center;gap:12px;padding:10px;border-radius:10px}\\n    .phase .dot{width:46px;height:46;border-radius:10px;background:linear-gradient(180deg,#0f3e34,#1e6b59);display:flex;align-items:center;justify-content:center;font-weight:700}\\n    .phase p{margin:0;color:var(--muted)}\\n    .controls{display:flex;gap:8px;margin-top:10px}\\n    .faq{margin-top:18px}\\n    .faq details{background:#082a2a;padding:12px;border-radius:8px;margin-bottom:8px;border:1px solid rgba(255,255,255,0.03)}\\n    footer{margin-top:28px;color:var(--muted);font-size:13px}\\n    /* small screens */\\n    @media (max-width:880px){.hero{grid-template-columns:1fr} .grid{grid-template-columns:1fr} .social-proof{flex-direction:column} .badge-strip{flex-direction:row;width:100%;overflow:auto}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">HM</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">Practical integrative sessions for modern lives</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Homebase</a>\\n        <a href=\\\"services.html\\\" class=\\\"primary\\\">Offerings</a>\\n        <a href=\\\"approach.html\\\">Method</a>\\n        <a href=\\\"pricing.html\\\">Invest</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Focused integrative offerings — one clear day at a time</h1>\\n        <p>Choose short, targeted programs that blend evidence-aware therapies, lifestyle planning, and VIP-day intensives. Each track is designed to be practical, measurable, and paced to your life.</p>\\n        <div class=\\\"cta-row\\\">\\n          <button class=\\\"btn btn-solid\\\" onclick=\\\"location.href='{{PRIMARY_CTA_URL}}'\\\">{{PRIMARY_CTA_LABEL}}</button>\\n          <button class=\\\"btn btn-outline\\\" onclick=\\\"location.href='book.html'\\\">Schedule a consult</button>\\n        </div>\\n      </div>\\n      <aside class=\\\"offer-card\\\">\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Current VIP model</div>\\n        <div style=\\\"font-size:20px;font-weight:700;margin-top:6px\\\">VIP Day — focused 1:1</div>\\n        <div style=\\\"font-size:13px;color:var(--muted);margin-top:8px\\\">A single deep day of assessment, planning, and hands-on coaching. Often paired with follow-up touchpoints.</div>\\n        <div style=\\\"margin-top:12px;display:flex;gap:8px;flex-wrap:wrap\\\">\\n          <div style=\\\"background:#062825;padding:6px 10px;border-radius:8px;font-weight:700;color:var(--accent)\\\">Limited capacity</div>\\n          <div style=\\\"background:rgba(255,255,255,0.02);padding:6px 10px;border-radius:8px;color:var(--muted)\\\">Remote or in-clinic</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"grid\\\" aria-label=\\\"services\\\">\\n      <div class=\\\"service\\\">\\n        <h3>Core Alignment Plan</h3>\\n        <p>An 8-week guided plan that reforms daily routines, sleep anchors, and stress responses with measurable checkpoints.</p>\\n        <div class=\\\"price\\\">Investment framing: subscription-friendly with optional VIP add-on</div>\\n      </div>\\n      <div class=\\\"service\\\">\\n        <h3>Accelerated Reset (VIP Day)</h3>\\n        <p>Immersive single-day strategy: intake, targeted testing review, and a consolidated action map you can implement immediately.</p>\\n        <div class=\\\"price\\\">Book a focused day — capacity-based scheduling</div>\\n      </div>\\n      <div class=\\\"service\\\">\\n        <h3>Maintenance Sprint</h3>\\n        <p>A 4-week pulse to stabilize improvements, refine metrics, and set the next milestones with brief check-ins.</p>\\n        <div class=\\\"price\\\">Structured check-ins, outcome-focused</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"social-proof\\\">\\n      <div class=\\\"testimonials\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <strong>Proof & client notes</strong>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">Rotating highlights</div>\\n        </div>\\n        <div id=\\\"testimonial-container\\\" style=\\\"margin-top:12px;min-height:86px;display:flex;align-items:center\\\">\\n          <!-- JS rotates content here -->\\n        </div>\\n        <div style=\\\"margin-top:10px;color:var(--muted);font-size:13px\\\">Credibility: select badges have hover details</div>\\n      </div>\\n\\n      <div class=\\\"badge-strip\\\" aria-hidden=\\\"false\\\">\\n        <div class=\\\"badge tooltip\\\" data-tip=\\\"Published case notes and peer-reviewed summaries available on request\\\">\\n          <div class=\\\"b-icon\\\">P</div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Peer summaries</div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Curated evidence</div>\\n          </div>\\n        </div>\\n        <div class=\\\"badge tooltip\\\" data-tip=\\\"Years of practice across primary care, nutrition, and behavioral coaching\\\">\\n          <div class=\\\"b-icon\\\">E</div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Team expertise</div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Interdisciplinary</div>\\n          </div>\\n        </div>\\n        <div class=\\\"badge tooltip\\\" data-tip=\\\"Client-reported outcome tools help track perceived progress; not medical proof of cure\\\">\\n          <div class=\\\"b-icon\\\">O</div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Outcome tracking</div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Progress metrics</div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"timeline\\\" aria-label=\\\"roadmap\\\">\\n      <strong>Roadmap planner</strong>\\n      <div style=\\\"font-size:13px;color:var(--muted);margin-top:6px\\\">Use this interactive outline to test how a three-phase approach could fit your schedule. This is educational and not a medical prescription.</div>\\n\\n      <div id=\\\"phases\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"phase\\\" data-phase=\\\"1\\\">\\n          <div class=\\\"dot\\\">1</div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Phase 1 — Stabilize</div>\\n            <p>Short-term anchors: sleep window, hydration cues, and stress buffering.</p>\\n          </div>\\n        </div>\\n        <div class=\\\"phase\\\" data-phase=\\\"2\\\">\\n          <div class=\\\"dot\\\">2</div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Phase 2 — Refine</div>\\n            <p>Targeted habits: movement patterns, tailored nutrition steps, and cognitive reframing practices.</p>\\n          </div>\\n        </div>\\n        <div class=\\\"phase\\\" data-phase=\\\"3\\\">\\n          <div class=\\\"dot\\\">3</div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Phase 3 — Sustain</div>\\n            <p>Maintenance rhythms, relapse planning, and scaling goals for long-term benefit.</p>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"controls\\\">\\n        <button class=\\\"btn btn-outline\\\" id=\\\"prev\\\">Back</button>\\n        <button class=\\\"btn btn-solid\\\" id=\\\"next\\\">Advance</button>\\n        <div style=\\\"margin-left:auto;color:var(--muted);font-size:13px\\\" id=\\\"phase-note\\\">Phase 1 of 3</div>\\n      </div>\\n      <div style=\\\"margin-top:10px;font-size:12px;color:var(--muted)\\\">Disclaimer: This planner offers educational structuring. It does not replace individualized medical advice or emergency care. Adjust with your clinician.</div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <strong>Questions</strong>\\n      <details>\\n        <summary>How do I choose which offering fits me?</summary>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\">We use a short intake to match your priorities to an offering: intensive day, multi-week plan, or a maintenance sprint. A consult helps clarify fit.</div>\\n      </details>\\n      <details>\\n        <summary>Are the VIP days clinical assessments?</summary>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\">VIP Days include focused evaluation and personalized planning. They are clinical in intent but educational in delivery; specific tests are ordered when clinically appropriate.</div>\\n      </details>\\n    </section>\\n\\n    <footer>\\n      <div>Contact: <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted)\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a></div>\\n      <div style=\\\"margin-top:6px;color:var(--muted)\\\">Serving {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n\\n  <script>\\n    // Rotating testimonials + badge tooltip handled via data-tip attribute (CSS)\\n    (function(){\\n      const items = [\\n        {text:\\\"The VIP day clarified priorities and produced a realistic map to implement; I appreciated the clear checkpoints.\\\", cite:\\\"— A\\\"\\n        },\\n        {text:\\\"An 8-week plan that actually fit my schedule. Small, targeted changes with measurable check-ins.\\\", cite:\\\"— B\\\"\\n        },\\n        {text:\\\"Evidence-aware, practical suggestions that I could start the next day. Helpful coaching and clear notes.\\\", cite:\\\"— C\\\"\\n        }\\n      ];\\n      let i=0;const container=document.getElementById('testimonial-container');\\n      function render(){\\n        const t=items[i%items.length];\\n        container.innerHTML = '<div style=\\\"font-size:15px\\\">\\\"'+t.text+'\\\"</div><div style=\\\"margin-top:8px;color:var(--muted);font-size:13px\\\">'+t.cite+'</div>';\\n        i++;\\n      }\\n      render();setInterval(render,4200);\\n    })();\\n\\n    // Timeline planner logic\\n    (function(){\\n      const phases = Array.from(document.querySelectorAll('.phase'));\\n      let index=0;\\n      const prev=document.getElementById('prev');\\n      const next=document.getElementById('next');\\n      const note=document.getElementById('phase-note');\\n      function update(){\\n        phases.forEach((p,idx)=>{p.style.opacity= idx===index?1:0.5; p.style.transform = idx===index? 'scale(1)':'scale(0.98)'});\\n        note.textContent = 'Phase '+(index+1)+' of '+phases.length;\\n      }\\n      prev.addEventListener('click',()=>{ if(index>0){index--; update();}});\\n      next.addEventListener('click',()=>{ if(index<phases.length-1){index++; update();}});\\n      update();\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Conditions & Support — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#08121a;--card:#071b20;--accent:#2f7f6a;--muted:#bcd3cc}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:linear-gradient(180deg,#031016,#08121a);color:#eaf3ee}\\n    .wrap{max-width:1000px;margin:28px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    header a{color:var(--muted);text-decoration:none;margin-left:12px}\\n    .hero{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.04);margin-top:12px}\\n    .hero h1{margin:0;font-size:24px}\\n    .hero p{margin:8px 0;color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:16px;margin-top:14px}\\n    .list{background:var(--card);padding:14px;border-radius:10px;border:1px solid rgba(255,255,255,0.03)}\\n    .cond{margin-bottom:8px}\\n    .cond h4{margin:0 0 6px}\\n    .cond p{margin:0;color:var(--muted);font-size:14px}\\n    .disclaimer{background:#061414;padding:12px;border-radius:8px;border:1px solid rgba(255,255,255,0.03);color:var(--muted);font-size:13px}\\n    .faq{margin-top:14px}\\n    .faq details{background:#062a28;padding:12px;border-radius:8px;margin-bottom:8px}\\n    .proof{margin-top:12px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);padding:12px;border-radius:10px;border:1px solid rgba(255,255,255,0.03)}\\n    .cta{margin-top:18px;display:flex;gap:10px}\\n    .btn{padding:10px 14px;border-radius:10px;border:0;cursor:pointer}\\n    .btn-primary{background:var(--accent);color:#042018}\\n    .small{font-size:13px;color:var(--muted)}\\n    @media (max-width:880px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Homebase</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"conditions.html\\\" style=\\\"font-weight:700\\\">Conditions</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <h1>Supportive framing for common health concerns</h1>\\n      <p>We provide educational, integrative approaches that complement your medical care. Below is a non-exhaustive list of areas we commonly support — always alongside primary care or specialty teams as needed.</p>\\n    </section>\\n\\n    <div class=\\\"grid\\\">\\n      <main class=\\\"list\\\">\\n        <div class=\\\"cond\\\">\\n          <h4>Sleep disruptions</h4>\\n          <p>Behavioral anchors, evening routines, and sleep hygiene tools that reduce variability in your sleep schedule. Not a diagnosis — work with your clinician for persistent sleep disorders.</p>\\n        </div>\\n        <div class=\\\"cond\\\">\\n          <h4>Chronic fatigue patterns</h4>\\n          <p>Energy mapping, pacing strategies, and measurable pacing plans with gradual ramps. Educational and supportive, not curative statements.</p>\\n        </div>\\n        <div class=\\\"cond\\\">\\n          <h4>Stress-reactivity & anxiety responses</h4>\\n          <p>Breathwork, behavioral micro-actions, and situational rehearsal to lower day-to-day reactivity. For clinical anxiety disorders, we coordinate with mental health providers.</p>\\n        </div>\\n        <div class=\\\"cond\\\">\\n          <h4>Digestive discomfort</h4>\\n          <p>Dietary pattern redesign, journaling, and fiber/timing adjustments. We do not replace GI workups — we support self-monitoring and liaise with gastroenterology where needed.</p>\\n        </div>\\n        <div class=\\\"cond\\\">\\n          <h4>Mood fluctuations & motivation dips</h4>\\n          <p>Activity scheduling, brief behavior activation steps, and referral pathways for psychiatric care when appropriate.</p>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\" class=\\\"disclaimer\\\">\\n          Important: Our services are educational and supportive. We do not promise cures or replace medical, psychiatric, or emergency care. Recommendations are shared to complement existing treatment plans — please consult your medical providers before making changes to medications or treatments.\\n        </div>\\n\\n        <section class=\\\"faq\\\" style=\\\"margin-top:12px\\\">\\n          <strong>Common questions</strong>\\n          <details>\\n            <summary>Will I need labs or testing?</summary>\\n            <div style=\\\"margin-top:8px;color:var(--muted)\\\">Many clients benefit from targeted tests. When tests are recommended, they are ordered or coordinated with appropriate providers. We discuss clinical utility before any testing.</div>\\n          </details>\\n          <details>\\n            <summary>Is telehealth available?</summary>\\n            <div style=\\\"margin-top:8px;color:var(--muted)\\\">Yes. Remote offerings include consultations, planning sessions, and follow-ups. In-person VIP days are available where listed.</div>\\n          </details>\\n        </section>\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"proof\\\">\\n          <strong>Proof Gallery</strong>\\n          <div id=\\\"cond-testimonial\\\" style=\\\"margin-top:10px;color:var(--muted)\\\">Rotating client perspectives and brief outcomes</div>\\n          <div style=\\\"margin-top:10px;font-size:13px;color:var(--muted)\\\">Badges: hover for context</div>\\n          <div style=\\\"display:flex;gap:8px;margin-top:8px\\\">\\n            <div class=\\\"badge tooltip\\\" data-tip=\\\"Collaborative referrals to local specialists\\\">Referrals</div>\\n            <div class=\\\"badge tooltip\\\" data-tip=\\\"Outcome trackers measure perceived change over time\\\">Tracking</div>\\n            <div class=\\\"badge tooltip\\\" data-tip=\\\"Educational materials and actionable plans\\\">Guides</div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px;padding:12px;background:#062426;border-radius:8px;border:1px solid rgba(255,255,255,0.03)\\\">\\n          <strong>Need rapid support?</strong>\\n          <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">If you experience a medical emergency, call emergency services. For urgent clinical decisions, contact your primary care or specialty provider.</div>\\n          <div style=\\\"margin-top:10px\\\">\\n            <button class=\\\"btn btn-primary\\\" onclick=\\\"location.href='{{PRIMARY_CTA_URL}}'\\\">Start with a consult</button>\\n          </div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted);font-size:13px\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a> • Serving {{CITY}}, {{STATE}}</footer>\\n  </div>\\n\\n  <script>\\n    // Simple rotating testimonial for conditions page\\n    (function(){\\n      const pool=[\\n        'The focused plan helped me test small changes safely — I appreciate the cautious, evidence-aware approach. — K',\\n        'They connected me with a GI specialist and helped organize tracking so we could see what changed. — M',\\n        'Short, practical adjustments that fit my life and did not feel overwhelming. — L'\\n      ];\\n      let idx=0; const el=document.getElementById('cond-testimonial');\\n      function show(){ el.textContent = pool[idx%pool.length]; idx++; }\\n      show(); setInterval(show,4800);\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Method & Practice — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#06151a;--card:#062028;--accent:#3a8a6b;--muted:#bcd6cf}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:linear-gradient(180deg,#041216,#06151a);color:#e8f5ef}\\n    .wrap{max-width:1000px;margin:28px auto;padding:18px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:12px}\\n    .hero{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03);margin-top:12px}\\n    .method{display:grid;grid-template-columns:1fr 340px;gap:16px;margin-top:16px}\\n    .card{background:var(--card);padding:14px;border-radius:10px;border:1px solid rgba(255,255,255,0.03)}\\n    .steps{display:flex;flex-direction:column;gap:10px}\\n    .step{padding:12px;border-radius:8px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent)}\\n    .plan{margin-top:10px}\\n    .timeline-mini{display:flex;gap:8px;margin-top:8px}\\n    .mini{background:#042a24;padding:8px;border-radius:8px;font-weight:700;color:var(--accent)}\\n    .cta{margin-top:14px}\\n    .btn{padding:10px 12px;border-radius:10px;border:0;cursor:pointer}\\n    .btn-primary{background:var(--accent);color:#041916}\\n    .faq{margin-top:12px}\\n    @media (max-width:880px){.method{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Homebase</a>\\n        <a href=\\\"approach.html\\\" style=\\\"font-weight:700\\\">Method</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <h1>How we structure care</h1>\\n      <p>Our practice applies a layered workflow: concise assessment, targeted interventions, then sustainable rhythms. Each layer is documented and reversible — it's about learning what works for you.</p>\\n    </section>\\n\\n    <div class=\\\"method\\\">\\n      <main>\\n        <div class=\\\"card\\\">\\n          <strong>Core workflow</strong>\\n          <div class=\\\"steps\\\">\\n            <div class=\\\"step\\\">\\n              <div style=\\\"font-weight:700\\\">Assess</div>\\n              <div style=\\\"color:var(--muted);font-size:14px\\\">Focused intake, prioritized concerns, and baseline measures to inform a pragmatic plan.</div>\\n            </div>\\n            <div class=\\\"step\\\">\\n              <div style=\\\"font-weight:700\\\">Intervene</div>\\n              <div style=\\\"color:var(--muted);font-size:14px\\\">Short, testable tactics: movement, sleep, micro-habits, and targeted tools chosen for low friction and measurable effect.</div>\\n            </div>\\n            <div class=\\\"step\\\">\\n              <div style=\\\"font-weight:700\\\">Monitor & Adapt</div>\\n              <div style=\\\"color:var(--muted);font-size:14px\\\">Regular check-ins and simple tracking to refine the plan. We favor pragmatic metrics over complex dashboards.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"plan\\\">\\n            <strong>Program names</strong>\\n            <div style=\\\"margin-top:8px;color:var(--muted)\\\">We offer modular tracks such as: Pulse Reset, Focus Sprint, and Stability Continuum — each customizable and available with VIP-day intensives.</div>\\n            <div class=\\\"timeline-mini\\\">\\n              <div class=\\\"mini\\\">Pulse Reset • 4 weeks</div>\\n              <div class=\\\"mini\\\">Focus Sprint • VIP Day</div>\\n              <div class=\\\"mini\\\">Stability • ongoing</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <section class=\\\"faq card\\\" style=\\\"margin-top:12px\\\">\\n          <strong>Method notes</strong>\\n          <details>\\n            <summary>How is progress measured?</summary>\\n            <div style=\\\"margin-top:8px;color:var(--muted)\\\">We use simple, repeatable self-report instruments and targeted metrics tied to your goals. This is not a substitute for diagnostic testing when required.</div>\\n          </details>\\n          <details>\\n            <summary>Will the team coordinate with my clinicians?</summary>\\n            <div style=\\\"margin-top:8px;color:var(--muted)\\\">Yes — with your permission, we coordinate recommendations and referrals to ensure care continuity.</div>\\n          </details>\\n        </section>\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <strong>Timeline planner (interactive)</strong>\\n          <div style=\\\"font-size:13px;color:var(--muted);margin-top:8px\\\">Experiment with a three-stage scaffold. Educational only — not individualized medical advice.</div>\\n          <div style=\\\"margin-top:10px;display:flex;gap:8px;align-items:center\\\">\\n            <label style=\\\"font-size:13px;color:var(--muted)\\\">Start week</label>\\n            <input id=\\\"start-week\\\" type=\\\"number\\\" min=\\\"1\\\" value=\\\"1\\\" style=\\\"width:64px;padding:6px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:inherit\\\">\\n          </div>\\n          <div id=\\\"roadmap\\\" style=\\\"margin-top:12px;font-size:14px;color:var(--muted)\\\"></div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <button class=\\\"btn btn-primary\\\" id=\\\"apply-plan\\\">Save plan draft</button>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\" class=\\\"card\\\">\\n          <strong>Proof & credibility</strong>\\n          <div style=\\\"margin-top:8px;color:var(--muted)\\\">Short rotating notes</div>\\n          <div id=\\\"approach-testimonial\\\" style=\\\"margin-top:10px;color:var(--muted)\\\"></div>\\n          <div style=\\\"margin-top:10px\\\"><button class=\\\"btn\\\" onclick=\\\"location.href='{{PRIMARY_CTA_URL}}'\\\" style=\\\"background:rgba(255,255,255,0.02);border-radius:10px;padding:8px 10px;color:var(--muted)\\\">{{PRIMARY_CTA_LABEL}}</button></div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted);font-size:13px\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted)\\\">{{PHONE}}</a></footer>\\n  </div>\\n\\n  <script>\\n    // Roadmap generator\\n    (function(){\\n      const road = document.getElementById('roadmap');\\n      const startInput = document.getElementById('start-week');\\n      const applyBtn = document.getElementById('apply-plan');\\n      function render(){\\n        const s = parseInt(startInput.value,10)||1;\\n        const phase1 = 'Weeks '+s+'–'+(s+1)+': Stabilize daily anchors (sleep window, hydration, morning routine).';\\n        const phase2 = 'Weeks '+(s+2)+'–'+(s+5)+': Introduce targeted interventions and test one variable at a time.';\\n        const phase3 = 'Weeks '+(s+6)+'–'+(s+11)+': Consolidate what worked; build low-friction maintenance habits.';\\n        road.innerHTML = '<div style=\\\"margin-bottom:8px\\\">'+phase1+'</div><div style=\\\"margin-bottom:8px\\\">'+phase2+'</div><div>'+phase3+'</div>';\\n      }\\n      startInput.addEventListener('input',render); render();\\n      applyBtn.addEventListener('click',()=>{ applyBtn.textContent='Saved draft'; setTimeout(()=>{applyBtn.textContent='Save plan draft'},1800); });\\n    })();\\n\\n    // Approach testimonial rotating\\n    (function(){\\n      const notes=['Practical, prioritized guidance that cut through overwhelm. — J','The method gave me a measurable path without too much busywork. — S','Clear plans, quick wins, and sensible follow-ups. — R'];\\n      let k=0; const el=document.getElementById('approach-testimonial');\\n      function show(){ el.textContent = notes[k%notes.length]; k++; }\\n      show(); setInterval(show,5000);\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
