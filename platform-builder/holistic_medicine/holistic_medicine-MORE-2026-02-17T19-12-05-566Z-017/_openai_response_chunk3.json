          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Investment — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--glass:#ffffff22;--glass-2:#ffffff14;--accent:#4a8f6e;--muted:#aab3b0;--bg:#0f1720;--card:#0f172020;--glass-border:rgba(255,255,255,0.12)}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Inter,ui-sans-serif,system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;color:#e6eef0;background:linear-gradient(180deg,#081018 0%, #0b1a1f 100%);min-height:100vh}\\n    header{backdrop-filter: blur(8px);-webkit-backdrop-filter:blur(8px);background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border-bottom:1px solid var(--glass-border);position:sticky;top:0;z-index:40}\\n    .nav{max-width:1100px;margin:0 auto;padding:18px 22px;display:flex;align-items:center;gap:18px}\\n    .brand{font-weight:700;color:#f8fffb;letter-spacing:0.4px}\\n    nav{margin-left:auto;display:flex;gap:14px}\\n    nav a{color:#d7e4e2;text-decoration:none;padding:8px 12px;border-radius:8px;font-size:14px}\\n    nav a.cta{background:linear-gradient(90deg,var(--accent),#6ccf9a);color:#042016;font-weight:700}\\n    main{max-width:1100px;margin:28px auto;padding:0 22px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:22px;align-items:start;margin-bottom:20px}\\n    .card{background:var(--glass);border-radius:14px;padding:22px;border:1px solid var(--glass-border);box-shadow:0 8px 30px rgba(6,12,15,0.5)}\\n    .hero-left h1{margin:0 0 8px 0;color:#e9fbf2;font-size:26px}\\n    .lead{color:var(--muted);margin-bottom:16px}\\n    .pill{display:inline-block;padding:6px 10px;border-radius:999px;background:rgba(255,255,255,0.03);color:var(--accent);font-weight:700;margin-bottom:12px}\\n    .pricing-grid{display:flex;gap:14px;margin-top:14px}\\n    .tier{flex:1;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:16px;border-radius:12px;border:1px solid var(--glass-border)}\\n    .tier h3{margin:0;color:#eaf8f0}\\n    .price{font-size:20px;font-weight:800;color:#fff;margin-top:8px}\\n    .muted{color:var(--muted);font-size:13px}\\n    .features{margin-top:12px;list-style:none;padding:0;margin:0;color:#cfe7dd}\\n    .cta-row{display:flex;gap:10px;margin-top:14px}\\n    .btn{padding:10px 14px;border-radius:10px;border:0;cursor:pointer}\\n    .btn.primary{background:var(--accent);color:#042016;font-weight:700}\\n    .btn.ghost{background:transparent;border:1px solid var(--glass-border);color:#cfe7dd}\\n    .proof{display:flex;gap:12px;margin-top:18px;align-items:center}\\n    .badge{background:rgba(255,255,255,0.02);padding:8px 10px;border-radius:8px;border:1px solid var(--glass-border);font-size:13px;color:#dff3e8;cursor:default}\\n    .gallery{margin-top:18px}\\n    .testimonial{min-height:90px;display:flex;flex-direction:column;gap:8px}\\n    .quote{color:#dff7ef}\\n    .author{color:var(--muted);font-size:13px}\\n    .badges{display:flex;gap:10px;margin-top:10px}\\n    .cred{padding:8px;border-radius:8px;background:rgba(255,255,255,0.02);border:1px solid var(--glass-border);position:relative}\\n    .cred[data-tip]:hover::after{content:attr(data-tip);position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);background:#071014;color:#bfead6;padding:8px;border-radius:8px;white-space:nowrap;font-size:12px;border:1px solid rgba(255,255,255,0.06)}\\n    .faq{margin-top:18px}\\n    .faq h4{margin:0 0 8px 0;color:#e9fbf2}\\n    footer{max-width:1100px;margin:28px auto;padding:18px 22px;color:var(--muted);font-size:13px}\\n    /* decorative svg */\\n    .pattern-svg{position:absolute;right:6%;top:6%;width:300px;opacity:0.06;pointer-events:none}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.pattern-svg{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Explore</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"conditions.html\\\">Conditions</a>\\n        <a href=\\\"approach.html\\\">Philosophy</a>\\n        <a href=\\\"pricing.html\\\" class=\\\"cta\\\">Investment</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"hero\\\">\\n      <div class=\\\"card hero-left\\\">\\n        <div class=\\\"pill\\\">Personalized VIP Day available</div>\\n        <h1>Transparent packages for practical integrative support</h1>\\n        <p class=\\\"lead\\\">Choose a focused pathway — from orientation to an immersive VIP alignment — designed to match time, budget, and clinical depth. All plans are educational and supportive; individual responses vary.</p>\\n\\n        <div class=\\\"pricing-grid\\\">\\n          <div class=\\\"tier\\\">\\n            <h3>Orientation Compass</h3>\\n            <div class=\\\"price\\\">$295</div>\\n            <div class=\\\"muted\\\">A baseline assessment and action plan</div>\\n            <ul class=\\\"features\\\">\\n              <li>60-minute intake\\n              <li>Personalized 4-week starter plan\\n              <li>Resource packet + simple metrics\\n            </ul>\\n            <div class=\\\"cta-row\\\">\\n              <button class=\\\"btn primary\\\" onclick=\\\"location.href='book.html#orientation'\\\">Reserve Orientation</button>\\n              <button class=\\\"btn ghost\\\" onclick=\\\"openDetails('orientation')\\\">Details</button>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"tier\\\">\\n            <h3>Renewal Accelerator</h3>\\n            <div class=\\\"price\\\">$895</div>\\n            <div class=\\\"muted\\\">Multi-session coaching + guided adjustments</div>\\n            <ul class=\\\"features\\\">\\n              <li>4 sessions over 8 weeks\\n              <li>Weekly progress tools and check-ins\\n              <li>Customized nutrition & movement cues\\n            </ul>\\n            <div class=\\\"cta-row\\\">\\n              <button class=\\\"btn primary\\\" onclick=\\\"location.href='book.html#accelerator'\\\">Book Accelerator</button>\\n              <button class=\\\"btn ghost\\\" onclick=\\\"openDetails('accelerator')\\\">Details</button>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"tier\\\">\\n            <h3>Alignment VIP Day</h3>\\n            <div class=\\\"price\\\">$2495</div>\\n            <div class=\\\"muted\\\">Deep-dive, single-day collaborative plan</div>\\n            <ul class=\\\"features\\\">\\n              <li>6-hour in-depth session\\n              <li>Real-time protocol planning\\n              <li>Follow-up plan + 30-day touchpoint\\n            </ul>\\n            <div class=\\\"cta-row\\\">\\n              <button class=\\\"btn primary\\\" onclick=\\\"location.href='book.html#vip'\\\">Request VIP Day</button>\\n              <button class=\\\"btn ghost\\\" onclick=\\\"openDetails('vip')\\\">Details</button>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"proof\\\">\\n          <div class=\\\"badge\\\">Evidence-oriented</div>\\n          <div class=\\\"badge\\\">Patient-centered</div>\\n          <div class=\\\"badge\\\">Limited VIP seats</div>\\n        </div>\\n\\n        <div class=\\\"gallery card\\\" aria-live=\\\"polite\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <strong style=\\\"color:#e9fbf2\\\">Client notes</strong>\\n            <div class=\\\"muted\\\">Rotating highlights</div>\\n          </div>\\n          <div id=\\\"testimonial\\\" class=\\\"testimonial\\\" style=\\\"margin-top:12px\\\">\\n            <div class=\\\"quote\\\" id=\\\"quote\\\">\\\"I left with a concise plan I could actually follow — practical and clear guidance.\\\"</div>\\n            <div class=\\\"author\\\" id=\\\"author\\\">— A person served, {{CITY}}</div>\\n          </div>\\n\\n          <div class=\\\"badges\\\" style=\\\"margin-top:8px\\\">\\n            <div class=\\\"cred\\\" data-tip=\\\"Board-certified clinician network\\\">Board Network</div>\\n            <div class=\\\"cred\\\" data-tip=\\\"Featured in practitioner roundtables\\\">Roundtable</div>\\n            <div class=\\\"cred\\\" data-tip=\\\"Peer-reviewed practice framework\\\">Peer Informed</div>\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <h4 style=\\\"margin-top:0;color:#e9fbf2\\\">Why this model?</h4>\\n        <p class=\\\"muted\\\">We present tiered commitments so you pick depth and pace. Sessions emphasize learning, practical experiments, and careful tracking rather than promises of cure.</p>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <h5 style=\\\"margin:0;color:#e9fbf2\\\">Quick FAQ</h5>\\n          <div class=\\\"faq\\\">\\n            <h4>Who benefits?</h4>\\n            <p class=\\\"muted\\\">Those seeking integrated, practical steps — and a clinician who helps coordinate resources across lifestyle, nutrition, and monitoring.</p>\\n            <h4 style=\\\"margin-top:8px\\\">Insurance?</h4>\\n            <p class=\\\"muted\\\">Many plans are private-pay. We provide documentation you can submit to insurers where applicable.</p>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;display:flex;gap:8px\\\">\\n          <button class=\\\"btn primary\\\" onclick=\\\"location.href='{{PRIMARY_CTA_URL}}'\\\">{{PRIMARY_CTA_LABEL}}</button>\\n          <button class=\\\"btn ghost\\\" onclick=\\\"document.getElementById('contact').scrollIntoView()\\\">Contact team</button>\\n        </div>\\n\\n      </aside>\\n    </div>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:8px\\\">\\n      <h3 style=\\\"margin:0 0 8px 0;color:#e9fbf2\\\">Simple commitments, clear support</h3>\\n      <p class=\\\"muted\\\">Each package is framed to give measurable next steps. The VIP Day is a concentrated collaboration that includes a follow-up review; space is limited to protect quality.</p>\\n\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-wrap:wrap\\\">\\n        <div style=\\\"flex:1;min-width:220px\\\">\\n          <h4 style=\\\"margin:0;color:#e9fbf2\\\">What to expect</h4>\\n          <ul class=\\\"muted\\\" style=\\\"margin-top:6px\\\">\\n            <li>Clear priorities set on day one\\n            <li>Prescribed small experiments with metrics\\n            <li>Resources focused on habit integration\\n          </ul>\\n        </div>\\n        <div style=\\\"flex:1;min-width:220px\\\">\\n          <h4 style=\\\"margin:0;color:#e9fbf2\\\">Follow-up</h4>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:6px\\\">All packages have recommended follow-ups. The VIP Day includes a 30-day touchpoint to refine the plan.</p>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:14px;display:flex;justify-content:space-between;align-items:center\\\">\\n        <div class=\\\"muted\\\">No guarantees — educational and supportive care only. Individual outcomes vary.</div>\\n        <div>\\n          <button class=\\\"btn primary\\\" onclick=\\\"location.href='book.html'\\\">Book a conversation</button>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"contact\\\" style=\\\"margin-top:14px;display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"muted\\\">Questions? Call us at {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#bfead6\\\">{{EMAIL}}</a></div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>© <span id=\\\"year\\\"></span> {{BUSINESS_NAME}} — Serving {{CITY}}, {{STATE}} · Private-pay offerings</div>\\n  </footer>\\n\\n  <svg class=\\\"pattern-svg\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\" y1=\\\"0\\\" y2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#4a8f6e\\\" stop-opacity=\\\"0.6\\\" />\\n        <stop offset=\\\"1\\\" stop-color=\\\"#2b6b52\\\" stop-opacity=\\\"0.4\\\" />\\n      </linearGradient>\\n      <pattern id=\\\"p1\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"40\\\" height=\\\"40\\\" fill=\\\"none\\\" />\\n        <path d=\\\"M0 20 L10 10 L20 20 L30 10 L40 20\\\" stroke=\\\"#bfead6\\\" stroke-opacity=\\\"0.12\\\" stroke-width=\\\"1\\\" fill=\\\"none\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\" />\\n    <circle cx=\\\"160\\\" cy=\\\"40\\\" r=\\\"40\\\" fill=\\\"url(#g1)\\\" opacity=\\\"0.12\\\" />\\n  </svg>\\n\\n  <script>\\n    // year\\n    document.getElementById('year').textContent = new Date().getFullYear();\\n\\n    // testimonial rotation\\n    const quotes = [\\n      {q: '\\\"The session felt focused — I left with practical steps and an easy plan to test.\\\"', a: '— Participant, coaching plan'},\\n      {q: '\\\"Clear, evidence-aware options that fit my schedule and concerns.\\\"', a: '— Client, VIP Day'},\\n      {q: '\\\"Clinician paired specificity with real-world pacing — I felt supported.\\\"', a: '— Member, Renewal Accelerator'}\\n    ];\\n    let idx = 0;\\n    function rotate(){\\n      idx = (idx + 1) % quotes.length;\\n      document.getElementById('quote').textContent = quotes[idx].q;\\n      document.getElementById('author').textContent = quotes[idx].a + ' — ' + '{{CITY}}';\\n    }\\n    setInterval(rotate, 5500);\\n\\n    function openDetails(id){\\n      alert('Details are available during a short consult. Please request a conversation through the booking page.');\\n    }\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071014;--glass:#11202444;--accent:#3aa07d;--muted:#aab3b0}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;color:#eaf7f0;background:linear-gradient(180deg,#041018, #071018)}\\n    header{position:sticky;top:0;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);backdrop-filter:blur(6px);border-bottom:1px solid rgba(255,255,255,0.04)}\\n    .nav{max-width:1100px;margin:0 auto;padding:16px 20px;display:flex;align-items:center}\\n    .brand{font-weight:700;color:#eafdf4}\\n    nav{margin-left:auto;display:flex;gap:12px}\\n    nav a{color:#cfece0;text-decoration:none;padding:8px 10px;border-radius:8px}\\n    nav a.active{background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.04)}\\n    main{max-width:1100px;margin:26px auto;padding:0 22px}\\n    .hero{display:flex;gap:18px;align-items:center}\\n    .hero .left{flex:1}\\n    .glass{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:18px}\\n    h1{margin:0;color:#eafff5}\\n    .muted{color:var(--muted)}\\n    .team{display:flex;gap:12px;margin-top:12px}\\n    .person{flex:1;background:rgba(255,255,255,0.02);padding:12px;border-radius:10px}\\n    .process{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:18px}\\n    .timeline{background:transparent;padding:12px}\\n    .step{background:rgba(255,255,255,0.02);padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.04)}\\n    .proof-rotator{margin-top:14px}\\n    .badges{display:flex;gap:10px;margin-top:8px}\\n    .cred{padding:8px;border-radius:8px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.03);position:relative}\\n    .cred[data-tip]:hover::after{content:attr(data-tip);position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);background:#062323;color:#e7fff5;padding:8px;border-radius:8px;white-space:nowrap;font-size:12px}\\n    .footer-note{margin-top:18px;color:var(--muted);font-size:13px}\\n    .svg-deco{position:absolute;left:8%;top:20%;opacity:0.05;width:260px;pointer-events:none}\\n    @media(max-width:820px){.process{grid-template-columns:1fr}.team{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Explore</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"conditions.html\\\">Conditions</a>\\n        <a href=\\\"approach.html\\\">Philosophy</a>\\n        <a href=\\\"pricing.html\\\">Investment</a>\\n        <a href=\\\"about.html\\\" class=\\\"active\\\">About</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <div style=\\\"position:relative\\\">\\n      <svg class=\\\"svg-deco\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n        <defs>\\n          <linearGradient id=\\\"gd\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"1\\\" y2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#3aa07d\\\" stop-opacity=\\\"0.7\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#1f7a5f\\\" stop-opacity=\\\"0.5\\\"/></linearGradient>\\n        </defs>\\n        <g fill=\\\"url(#gd)\\\"><rect x=\\\"10\\\" y=\\\"10\\\" width=\\\"180\\\" height=\\\"180\\\" rx=\\\"20\\\"/></g>\\n      </svg>\\n\\n      <section class=\\\"hero\\\">\\n        <div class=\\\"left glass\\\">\\n          <h1>Clinical pragmatism with a collaborative edge</h1>\\n          <p class=\\\"muted\\\">We work with people who want coordinated options that map to everyday life — clear steps, prioritized choices, and documented experiments. All care is educational; we do not promise cures.</p>\\n\\n          <div class=\\\"team\\\">\\n            <div class=\\\"person\\\">\\n              <strong>Lead clinician</strong>\\n              <div class=\\\"muted\\\">Board-affiliated practitioner with integrative training. Focus: translating clinical evidence into daily practice.</div>\\n            </div>\\n            <div class=\\\"person\\\">\\n              <strong>Care coordinator</strong>\\n              <div class=\\\"muted\\\">Organizes follow-ups, medication reconciliations, and referrals to community resources.</div>\\n            </div>\\n            <div class=\\\"person\\\">\\n              <strong>Education specialist</strong>\\n              <div class=\\\"muted\\\">Designs practical experiments and helps track outcomes with simple metrics.</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <aside class=\\\"glass\\\" style=\\\"width:320px\\\">\\n          <strong style=\\\"color:#eafff5\\\">Proof Gallery</strong>\\n          <div class=\\\"proof-rotator\\\" id=\\\"proof-rotator\\\">\\n            <div id=\\\"p-quote\\\" style=\\\"margin-top:10px;color:#dff7ef\\\">\\\"Thorough and practical — the team helped me prioritize one small change at a time.\\\"</div>\\n            <div id=\\\"p-author\\\" class=\\\"muted\\\" style=\\\"margin-top:6px\\\">— Community member</div>\\n            <div class=\\\"badges\\\">\\n              <div class=\\\"cred\\\" data-tip=\\\"Collaborations with regional clinics\\\">Clinic Partner</div>\\n              <div class=\\\"cred\\\" data-tip=\\\"Continuing education provider\\\">Education</div>\\n              <div class=\\\"cred\\\" data-tip=\\\"Published procedural summaries\\\">Publications</div>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <button class=\\\"btn-primary\\\" style=\\\"padding:10px 12px;border-radius:8px;background:var(--accent);color:#052219;border:0;font-weight:700\\\" onclick=\\\"location.href='book.html'\\\">Arrange an intro</button>\\n          </div>\\n        </aside>\\n      </section>\\n\\n      <section class=\\\"process\\\">\\n        <div class=\\\"glass\\\">\\n          <h3 style=\\\"margin-top:0;color:#eafff5\\\">How we work</h3>\\n          <div class=\\\"step\\\" style=\\\"margin-top:8px\\\">\\n            <strong>Discover</strong>\\n            <p class=\\\"muted\\\">Listen to history, current goals, and immediate constraints. Identify three testable priorities.</p>\\n          </div>\\n          <div class=\\\"step\\\" style=\\\"margin-top:8px\\\">\\n            <strong>Design</strong>\\n            <p class=\\\"muted\\\">Pick small, measurable changes. Draft a short experiment and specify what to track.</p>\\n          </div>\\n          <div class=\\\"step\\\" style=\\\"margin-top:8px\\\">\\n            <strong>Review</strong>\\n            <p class=\\\"muted\\\">Iterate based on data. Adjust scope and align next steps with life demands.</p>\\n          </div>\\n          <div class=\\\"step\\\" style=\\\"margin-top:8px\\\">\\n            <strong>Coordinate</strong>\\n            <p class=\\\"muted\\\">We connect to other providers and resources as requested.</p>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"glass timeline\\\">\\n          <h3 style=\\\"margin-top:0;color:#eafff5\\\">Values and limits</h3>\\n          <p class=\\\"muted\\\">We emphasize clear boundaries: educational support, shared decision-making, and careful documentation. We do not make guarantees about outcomes; results depend on many factors.</p>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <strong style=\\\"color:#eafff5\\\">Clinical safeguards</strong>\\n            <ul class=\\\"muted\\\" style=\\\"margin-top:6px\\\">\\n              <li>Medication safety checks\\n              <li>Referral for urgent concerns\\n              <li>Transparent documentation for other clinicians\\n            </ul>\\n          </div>\\n        </div>\\n      </section>\\n\\n    </div>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"glass\\\">\\n      <h3 style=\\\"margin:0;color:#eafff5\\\">Community proof</h3>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Voices from people who shared the work.</p>\\n\\n      <div style=\\\"display:flex;gap:12px;flex-wrap:wrap;margin-top:12px\\\">\\n        <div style=\\\"flex:1;min-width:260px;background:rgba(255,255,255,0.02);padding:12px;border-radius:8px\\\">\\n          <div style=\\\"color:#dff7ef\\\">\\\"A clinician who helped us test changes without overwhelming our schedule.\\\"</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">— Local participant</div>\\n        </div>\\n        <div style=\\\"flex:1;min-width:260px;background:rgba(255,255,255,0.02);padding:12px;border-radius:8px\\\">\\n          <div style=\\\"color:#dff7ef\\\">\\\"The VIP Day gave us a compact, workable plan to try in 30 days.\\\"</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">— VIP attendee</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"footer-note\\\">\\n        Important: The care provided is educational and supportive. It is not a substitute for emergency care or guaranteed medical outcomes. If you are in crisis, please contact local emergency services.\\n      </div>\\n\\n      <div style=\\\"margin-top:12px;display:flex;gap:10px\\\">\\n        <button style=\\\"padding:10px 12px;border-radius:8px;background:var(--accent);border:0;color:#052219;font-weight:700\\\" onclick=\\\"location.href='book.html'\\\">Start a conversation</button>\\n        <button style=\\\"padding:10px 12px;border-radius:8px;background:transparent;border:1px solid rgba(255,255,255,0.04);color:#cfeee0\\\" onclick=\\\"location.href='contact.html'\\\">Request information</button>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <script>\\n    // rotate proof gallery here too\\n    const proofs = [\\n      {q: '\\\"I appreciated the concrete experiments — not vague advice.\\\"', a: '— Review'},\\n      {q: '\\\"Coordinated care, practical tools, and realistic pacing.\\\"', a: '— Participant'},\\n      {q: '\\\"A careful, evidence-aware team that listened.\\\"', a: '— Member'}\\n    ];\\n    let pidx = 0;\\n    function rotateProof(){\\n      pidx = (pidx + 1) % proofs.length;\\n      document.getElementById('p-quote').textContent = proofs[pidx].q;\\n      document.getElementById('p-author').textContent = proofs[pidx].a;\\n    }\\n    setInterval(rotateProof, 6000);\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Schedule — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#081018;--glass:#0d2a28cc;--accent:#54b286;--muted:#9fb7b1}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;color:#e8faf0;background:linear-gradient(180deg,#041018,#081218);min-height:100vh}\\n    header{position:sticky;top:0;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);backdrop-filter:blur(6px);padding:12px 0;border-bottom:1px solid rgba(255,255,255,0.03)}\\n    .nav{max-width:1100px;margin:0 auto;padding:6px 22px;display:flex;align-items:center}\\n    .brand{font-weight:700;color:#e9fff7}\\n    nav{margin-left:auto;display:flex;gap:12px}\\n    nav a{color:#cbeee2;text-decoration:none;padding:8px 10px;border-radius:8px}\\n    main{max-width:1100px;margin:22px auto;padding:0 22px}\\n    .hero{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.04)}\\n    h1{margin:0;color:#eafff5}\\n    .muted{color:var(--muted)}\\n    .planner{margin-top:16px;display:grid;grid-template-columns:1fr 340px;gap:14px}\\n    .plan-card{background:rgba(255,255,255,0.02);padding:14px;border-radius:10px;border:1px solid rgba(255,255,255,0.03)}\\n    .phase{margin-bottom:12px}\\n    .phase label{display:block;color:#dff7ef;font-weight:700;margin-bottom:6px}\\n    input[type=\\\"range\\\"]{width:100%}\\n    .timeline-visual{height:120px;position:relative;border-radius:8px;background:linear-gradient(90deg,#062728, #072021);overflow:hidden}\\n    .bar{position:absolute;height:34px;border-radius:6px;top:18px;display:flex;align-items:center;padding-left:10px;color:#052018;font-weight:700}\\n    .bar.phase1{background:#73d9a1}\\n    .bar.phase2{background:#4fbf8b}\\n    .bar.phase3{background:#2f9670}\\n    .legend{display:flex;gap:8px;align-items:center;margin-top:10px}\\n    .legend span{display:inline-block;width:12px;height:12px;border-radius:3px}\\n    .note{margin-top:12px;color:var(--muted)}\\n    .actions{margin-top:14px;display:flex;gap:8px}\\n    .btn{padding:10px 12px;border-radius:8px;border:0;cursor:pointer}\\n    .btn.primary{background:var(--accent);color:#022319;font-weight:700}\\n    .disclaimer{margin-top:12px;color:var(--muted);font-size:13px}\\n    @media(max-width:920px){.planner{grid-template-columns:1fr}.timeline-visual{height:140px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Explore</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"conditions.html\\\">Conditions</a>\\n        <a href=\\\"approach.html\\\">Philosophy</a>\\n        <a href=\\\"pricing.html\\\">Investment</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"book.html\\\" class=\\\"active\\\">Schedule</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <h1>Book a conversation or a VIP day</h1>\\n      <p class=\\\"muted\\\">Select a format below — orientation visit, multi-session program, or an immersive VIP Day. Use the planner to sketch a phased timeline before you request a date.</p>\\n\\n      <div class=\\\"planner\\\">\\n        <div class=\\\"plan-card\\\">\\n          <h3 style=\\\"margin-top:0;color:#eafff5\\\">Timeline planner</h3>\\n          <p class=\\\"muted\\\">Map out three phases. Use as a proposal to bring to the session; we'll refine together. No guarantees; educational guidance only.</p>\\n\\n          <div class=\\\"phase\\\">\\n            <label for=\\\"p1\\\">Phase 1 — Foundation (weeks)</label>\\n            <input id=\\\"p1\\\" type=\\\"range\\\" min=\\\"1\\\" max=\\\"8\\\" value=\\\"2\\\" oninput=\\\"updatePlanner()\\\" />\\n            <div class=\\\"muted\\\" id=\\\"p1v\\\">2 weeks</div>\\n          </div>\\n\\n          <div class=\\\"phase\\\">\\n            <label for=\\\"p2\\\">Phase 2 — Adjustment (weeks)</label>\\n            <input id=\\\"p2\\\" type=\\\"range\\\" min=\\\"2\\\" max=\\\"12\\\" value=\\\"6\\\" oninput=\\\"updatePlanner()\\\" />\\n            <div class=\\\"muted\\\" id=\\\"p2v\\\">6 weeks</div>\\n          </div>\\n\\n          <div class=\\\"phase\\\">\\n            <label for=\\\"p3\\\">Phase 3 — Integration (weeks)</label>\\n            <input id=\\\"p3\\\" type=\\\"range\\\" min=\\\"2\\\" max=\\\"20\\\" value=\\\"8\\\" oninput=\\\"updatePlanner()\\\" />\\n            <div class=\\\"muted\\\" id=\\\"p3v\\\">8 weeks</div>\\n          </div>\\n\\n          <div style=\\\"margin-top:10px;display:flex;gap:8px\\\">\\n            <input id=\\\"start\\\" type=\\\"date\\\" value=\\\"\\\" style=\\\"padding:8px;border-radius:8px;border:1px solid rgba(255,255,255,0.04)\\\" />\\n            <button class=\\\"btn primary\\\" onclick=\\\"applyProposal()\\\">Save proposal</button>\\n          </div>\\n\\n          <div class=\\\"note\\\" id=\\\"proposal-note\\\">No start date chosen</div>\\n          <div class=\\\"disclaimer\\\">This planner is an organizational tool — not a treatment schedule. Always confirm medical steps with your clinician.</div>\\n        </div>\\n\\n        <aside class=\\\"plan-card\\\">\\n          <h3 style=\\\"margin-top:0;color:#eafff5\\\">Visual timeline</h3>\\n          <div class=\\\"timeline-visual\\\" id=\\\"timeline\\\">\\n            <div class=\\\"bar phase1\\\" id=\\\"bar1\\\" style=\\\"left:6%;width:12%\\\">Phase 1</div>\\n            <div class=\\\"bar phase2\\\" id=\\\"bar2\\\" style=\\\"left:20%;width:36%\\\">Phase 2</div>\\n            <div class=\\\"bar phase3\\\" id=\\\"bar3\\\" style=\\\"left:56%;width:44%\\\">Phase 3</div>\\n          </div>\\n\\n          <div class=\\\"legend\\\">\\n            <div style=\\\"display:flex;gap:8px;align-items:center\\\"><span style=\\\"background:#73d9a1\\\"></span><div class=\\\"muted\\\">Foundation</div></div>\\n            <div style=\\\"display:flex;gap:8px;align-items:center\\\"><span style=\\\"background:#4fbf8b\\\"></span><div class=\\\"muted\\\">Adjustment</div></div>\\n            <div style=\\\"display:flex;gap:8px;align-items:center\\\"><span style=\\\"background:#2f9670\\\"></span><div class=\\\"muted\\\">Integration</div></div>\\n          </div>\\n\\n          <div style=\\\"margin-top:10px\\\">\\n            <strong style=\\\"color:#eafff5\\\">Estimated timeline</strong>\\n            <div class=\\\"muted\\\" id=\\\"est-range\\\">—</div>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <button class=\\\"btn\\\" onclick=\\\"location.href='pricing.html'\\\" style=\\\"background:transparent;border:1px solid rgba(255,255,255,0.04);color:#cfeee0\\\">Compare packages</button>\\n            <button class=\\\"btn primary\\\" style=\\\"margin-left:6px\\\" onclick=\\\"proposeAndContact()\\\">Request a slot</button>\\n          </div>\\n        </aside>\\n\\n      </div>\\n\\n      <div style=\\\"margin-top:16px\\\" class=\\\"plan-card\\\">\\n        <h3 style=\\\"margin-top:0;color:#eafff5\\\">Booking notes</h3>\\n        <ul class=\\\"muted\\\" style=\\\"margin-top:8px\\\">\\n          <li>VIP Day requests are reviewed for availability; we prioritize clinical fit and preparation time.\\n          <li>Orientation visits are the quickest path to get started; multi-session packages are scheduled per mutual agreement.\\n          <li>All scheduling communications are confirmed by email to {{EMAIL}} or by phone at {{PHONE}}.\\n        </ul>\\n        <div class=\\\"disclaimer\\\" style=\\\"margin-top:10px\\\">Educational approach. Not an emergency service. If you have urgent medical needs, please contact local emergency services or your primary care provider.</div>\\n      </div>\\n\\n    </section>\\n  </main>\\n\\n  <script>\\n    // planner logic\\n    function weeksToPercent(n, total){ return Math.max(4, Math.round((n/total)*86)); }\\n    function updatePlanner(){\\n      const p1 = +document.getElementById('p1').value;\\n      const p2 = +document.getElementById('p2').value;\\n      const p3 = +document.getElementById('p3').value;\\n      document.getElementById('p1v').textContent = p1 + ' weeks';\\n      document.getElementById('p2v').textContent = p2 + ' weeks';\\n      document.getElementById('p3v').textContent = p3 + ' weeks';\\n      const total = p1 + p2 + p3;\\n      // layout bars based on relative widths\\n      const minLeft = 6; // percent left padding\\n      const available = 88; // percent available for bars\\n      const p1w = Math.max(6, Math.round((p1/total)*available));\\n      const p2w = Math.max(6, Math.round((p2/total)*available));\\n      const p3w = Math.max(6, available - p1w - p2w);\\n      const b1Left = minLeft;\\n      const b2Left = b1Left + p1w;\\n      const b3Left = b2Left + p2w;\\n      document.getElementById('bar1').style.left = b1Left + '%';\\n      document.getElementById('bar1').style.width = p1w + '%';\\n      document.getElementById('bar2').style.left = b2Left + '%';\\n      document.getElementById('bar2').style.width = p2w + '%';\\n      document.getElementById('bar3').style.left = b3Left + '%';\\n      document.getElementById('bar3').style.width = p3w + '%';\\n\\n      // estimate range text\\n      let est = total + ' weeks total';\\n      document.getElementById('est-range').textContent = est;\\n    }\\n    updatePlanner();\\n\\n    function applyProposal(){\\n      const start = document.getElementById('start').value;\\n      if(!start){\\n        document.getElementById('proposal-note').textContent = 'Select a start date to see exact phase dates.';\\n        return;\\n      }\\n      const p1 = +document.getElementById('p1').value;\\n      const p2 = +document.getElementById('p2').value;\\n      const p3 = +document.getElementById('p3').value;\\n      const s = new Date(start);\\n      const off = (d, w)=>{ const nd = new Date(d); nd.setDate(nd.getDate()+7*w); return nd; };\\n      const end1 = off(s, p1);\\n      const end2 = off(end1, p2);\\n      const end3 = off(end2, p3);\\n      function fmt(d){ return d.toISOString().slice(0,10); }\\n      document.getElementById('proposal-note').textContent = 'Phase dates: ' + fmt(s) + ' → ' + fmt(end1) + ' (P1), ' + fmt(end1) + ' → ' + fmt(end2) + ' (P2), ' + fmt(end2) + ' → ' + fmt(end3) + ' (P3)';\\n    }\\n\\n    function proposeAndContact(){\\n      // collect summary then open mailto\\n      const start = document.getElementById('start').value || '(no start)';\\n      const p1 = document.getElementById('p1').value;\\n      const p2 = document.getElementById('p2').value;\\n      const p3 = document.getElementById('p3').value;\\n      const subj = encodeURIComponent('Booking request — ' + '{{BUSINESS_NAME}}');\\n      const body = encodeURIComponent('I would like to request a booking. Proposed start: ' + start + '\\\\nPhases (weeks): P1=' + p1 + ', P2=' + p2 + ', P3=' + p3 + '\\\\nPlease advise on next steps and availability.\\\\n\\\\n— Sent from booking tool');\\n      location.href = 'mailto:' + '{{EMAIL}}' + '?subject=' + subj + '&body=' + body;\\n    }\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
