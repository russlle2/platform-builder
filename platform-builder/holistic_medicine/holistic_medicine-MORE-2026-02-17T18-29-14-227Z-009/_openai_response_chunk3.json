          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Care Packages — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f1724;--card:#0b1220;--accent:#ffb86b;--muted:#9aa4b2;--glass:rgba(255,255,255,0.04);--accent-2:#7ee7c6}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#e6eef6;background:linear-gradient(180deg,var(--bg),#071023);}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:22px 32px;background:linear-gradient(90deg,rgba(255,255,255,0.02),transparent);backdrop-filter:blur(6px)}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#ff8a5b);display:grid;place-items:center;color:#081020;font-weight:700}\\n    nav{display:flex;gap:18px}\\n    nav a{color:#cfe7ff;text-decoration:none;padding:8px 10px;border-radius:8px;font-weight:600}\\n    nav a:hover{background:rgba(255,255,255,0.02)}\\n    .cta{background:linear-gradient(90deg,var(--accent-2),var(--accent));padding:10px 14px;border-radius:10px;color:#041017;font-weight:700;text-decoration:none}\\n    main{max-width:1100px;margin:36px auto;padding:28px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    .hero .lead{background:var(--card);padding:26px;border-radius:14px;box-shadow:0 6px 24px rgba(3,7,12,0.6)}\\n    h1{margin:0 0 8px 0;font-size:28px}\\n    p.lead-desc{color:var(--muted);margin:0 0 18px 0}\\n    .pill{display:inline-block;padding:6px 10px;border-radius:999px;background:var(--glass);color:var(--muted);font-size:13px;margin-bottom:10px}\\n    .session-card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;margin-bottom:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .price{font-size:20px;font-weight:800;color:var(--accent);}\\n    .perks{color:var(--muted);font-size:14px;margin-top:8px}\\n    .side{position:relative;padding:18px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border:1px solid rgba(255,255,255,0.03)}\\n    .side h3{margin:0 0 8px 0}\\n    .badges{display:flex;gap:8px;flex-wrap:wrap}\\n    .badge{background:rgba(255,255,255,0.03);padding:8px 10px;border-radius:8px;font-size:13px;color:#dff7ee;position:relative}\\n    .tooltip{position:absolute;left:50%;top:-10px;transform:translateX(-50%) translateY(-100%);background:#02131a;padding:8px;border-radius:8px;color:#bfede5;font-size:12px;white-space:nowrap;opacity:0;pointer-events:none;transition:all .18s}\\n    .badge:hover .tooltip{opacity:1;top:-14px}\\n    .gallery{margin-top:16px}\\n    .testimonial{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:12px;border-radius:10px;border:1px solid rgba(255,255,255,0.02);min-height:84px}\\n    .controls{display:flex;gap:10px;margin-top:12px}\\n    .btn{background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.03);padding:8px 12px;border-radius:10px;color:var(--muted);cursor:pointer}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:22px}\\n    .tier{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .tier h4{margin:0 0 8px 0}\\n    footer{max-width:1100px;margin:28px auto;padding:12px 28px;color:var(--muted);display:flex;justify-content:space-between;align-items:center}\\n    /* pattern accent */\\n    .pattern-blob{position:absolute;inset:auto -40px -40px auto;width:220px;height:220px;opacity:0.08}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr}.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Welcome</a>\\n      <a href=\\\"approach.html\\\">Care Map</a>\\n      <a href=\\\"conditions.html\\\">Conditions</a>\\n      <a href=\\\"services.html\\\">Sessions</a>\\n      <a href=\\\"pricing.html\\\" style=\\\"opacity:1;border-radius:10px;padding:8px 12px;background:rgba(255,255,255,0.02)\\\">Pricing</a>\\n      <a href=\\\"about.html\\\">Purpose</a>\\n      <a class=\\\"cta\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"hero\\\">\\n      <section class=\\\"lead\\\">\\n        <span class=\\\"pill\\\">Personalized planning • Evidence-aware</span>\\n        <h1>Packages shaped for a single focused day or a guided quarter</h1>\\n        <p class=\\\"lead-desc\\\">Choose a pathway that suits the speed you need: an intensive recalibration, a tactical follow-up, or a supported stretch across several months. Transparent scope and clear next steps for each offering.</p>\\n\\n        <div class=\\\"session-card\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Immersive Alignment — VIP Day</div>\\n              <div class=\\\"perks\\\">A deep single-day collaboration: assessments, prioritized plan, and hands-on guidance.</div>\\n            </div>\\n            <div class=\\\"price\\\">$1,850</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"session-card\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Focused Follow — 60m Consult</div>\\n              <div class=\\\"perks\\\">A focused one-to-one session to tackle a single concern and practical next steps.</div>\\n            </div>\\n            <div class=\\\"price\\\">$220</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"session-card\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Sustained Support — 12-week Track</div>\\n              <div class=\\\"perks\\\">Weekly touchpoints, planning roadmap, and progress reviews for lasting momentum.</div>\\n            </div>\\n            <div class=\\\"price\\\">$2,900</div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;display:flex;gap:10px\\\">\\n          <a class=\\\"btn\\\" href=\\\"services.html\\\">Explore sessions</a>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve a VIP Day</a>\\n        </div>\\n      </section>\\n\\n      <aside class=\\\"side\\\">\\n        <h3>Proof & credibility</h3>\\n        <div class=\\\"badges\\\">\\n          <div class=\\\"badge\\\">Board-Informed\\n            <div class=\\\"tooltip\\\">Clinical review and integrative training background</div>\\n          </div>\\n          <div class=\\\"badge\\\">Research-Sourced\\n            <div class=\\\"tooltip\\\">Protocols referenced from peer-reviewed literature</div>\\n          </div>\\n          <div class=\\\"badge\\\">Client-Focused\\n            <div class=\\\"tooltip\\\">Individualized plans, not one-size-fits-all</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"gallery\\\">\\n          <div class=\\\"testimonial\\\" id=\\\"testi\\\">\\\"A clear, stepwise plan that helped me reframe my daily routines.\\\" — M.</div>\\n          <div class=\\\"controls\\\">\\n            <button class=\\\"btn\\\" id=\\\"prev\\\">Previous</button>\\n            <button class=\\\"btn\\\" id=\\\"next\\\">Next</button>\\n            <div style=\\\"flex:1\\\"></div>\\n            <div style=\\\"font-size:12px;color:var(--muted)\\\">Reviewed outcomes available on request</div>\\n          </div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <h2 style=\\\"margin:0;color:#dff6ee\\\">How we frame value</h2>\\n        <div style=\\\"color:var(--muted);font-size:14px\\\">Transparent inclusions and optional add-ons</div>\\n      </div>\\n\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"tier\\\">\\n          <h4>Day Reset (VIP Day)</h4>\\n          <div style=\\\"font-weight:700;color:var(--accent)\\\">$1,850</div>\\n          <ul style=\\\"color:var(--muted);margin-top:8px;padding-left:18px\\\">\\n            <li>Pre-visit testing review</li>\\n            <li>6–8 hour in-person or virtual intensive</li>\\n            <li>Action roadmap + 30-day check-in</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <h4>Point Consult</h4>\\n          <div style=\\\"font-weight:700;color:var(--accent)\\\">$220</div>\\n          <ul style=\\\"color:var(--muted);margin-top:8px;padding-left:18px\\\">\\n            <li>60-minute clinical review</li>\\n            <li>Targeted strategies & resources</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <h4>Guided Track</h4>\\n          <div style=\\\"font-weight:700;color:var(--accent)\\\">$2,900</div>\\n          <ul style=\\\"color:var(--muted);margin-top:8px;padding-left:18px\\\">\\n            <li>Twelve weeks of coaching & follow-ups</li>\\n            <li>Roadmap adjustments & progress metrics</li>\\n          </ul>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:18px;color:var(--muted);font-size:13px\\\">\\n        Note: Plans are educational and supportive. Content is not a guarantee of clinical outcomes and is provided as guidance for lifestyle and integrative strategies. For urgent health concerns, please contact your primary medical provider or local emergency services.\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>Call us: <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:inherit;text-decoration:none\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:inherit;text-decoration:none\\\">{{EMAIL}}</a></div>\\n    <div>© <span id=\\\"year\\\"></span> {{BUSINESS_NAME}} • All materials educational</div>\\n  </footer>\\n\\n  <script>\\n    // Testimonials rotating gallery\\n    (function(){\\n      const items = [\\n        {t:'\\\"Clear, practical steps without pressure — felt like a partnership.\\\" — A.'},\\n        {t:'\\\"Thoughtful assessment and realistic goals I could try the next day.\\\" — R.'},\\n        {t:'\\\"The VIP Day clarified priorities quickly — I left with a plan I could follow.\\\" — S.'}\\n      ];\\n      let idx=0;const el=document.getElementById('testi');const next=document.getElementById('next');const prev=document.getElementById('prev');\\n      function show(i){el.textContent=items[i].t}\\n      next.addEventListener('click',()=>{idx=(idx+1)%items.length;show(idx)});\\n      prev.addEventListener('click',()=>{idx=(idx-1+items.length)%items.length;show(idx)});\\n      setInterval(()=>{idx=(idx+1)%items.length;show(idx)},5500);\\n      show(0);\\n      document.getElementById('year').textContent=new Date().getFullYear();\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071022;--card:#0e1620;--accent:#8be7d0;--muted:#9fb2bf}\\n    body{margin:0;font-family:Inter,system-ui,Arial;background:linear-gradient(180deg,var(--bg),#04121a);color:#e9fbf5}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 28px;background:linear-gradient(90deg,rgba(255,255,255,0.02),transparent)}\\n    .logo{width:46px;height:46px;background:linear-gradient(135deg,#ffd7a8,#a0ffd6);display:grid;place-items:center;border-radius:12px;font-weight:800;color:#08161a}\\n    nav{display:flex;gap:14px}\\n    nav a{color:#cfeff0;text-decoration:none;padding:8px;border-radius:8px}\\n    main{max-width:1000px;margin:30px auto;padding:24px}\\n    .hero{display:flex;gap:20px;align-items:flex-start}\\n    .bio{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    h1{margin-top:0}\\n    .values{display:flex;gap:12px;margin-top:14px}\\n    .chip{background:rgba(255,255,255,0.03);padding:8px 12px;border-radius:999px;color:var(--muted)}\\n    .proven{margin-top:18px;display:flex;gap:12px}\\n    .cred{background:var(--card);padding:12px;border-radius:12px;border:1px solid rgba(255,255,255,0.03);min-width:220px}\\n    .proof{margin-top:14px}\\n    .badge{display:inline-block;padding:8px;border-radius:10px;margin-right:8px;background:rgba(255,255,255,0.02)}\\n    .timeline{margin-top:18px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);padding:12px;border-radius:10px}\\n    .phase{display:flex;gap:12px;align-items:center;padding:10px 6px}\\n    .phase .step{width:46px;height:46px;border-radius:10px;background:linear-gradient(180deg,#0b2a24,#063b30);display:grid;place-items:center;font-weight:800}\\n    .planner{background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;margin-top:12px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px}\\n    footer{max-width:1000px;margin:20px auto;padding:12px;color:var(--muted)}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Integrative care in {{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"approach.html\\\">Method</a>\\n      <a href=\\\"conditions.html\\\">Conditions</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n      <a href=\\\"book.html\\\" style=\\\"background:rgba(255,255,255,0.02);padding:8px;border-radius:8px\\\">Schedule</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"grid\\\">\\n      <section>\\n        <div class=\\\"hero\\\">\\n          <div class=\\\"bio\\\">\\n            <h1>Purposeful, evidence-aware integrative practice</h1>\\n            <p style=\\\"color:var(--muted)\\\">We blend clinical learning, lifestyle-first strategies, and respect for each person's context. Our goal: create practical steps you can try and refine, with clinical caution and clear documentation.</p>\\n\\n            <div class=\\\"values\\\">\\n              <div class=\\\"chip\\\">Client-centered</div>\\n              <div class=\\\"chip\\\">Measured & modest</div>\\n              <div class=\\\"chip\\\">Transparent</div>\\n            </div>\\n\\n            <div class=\\\"proof\\\">\\n              <div style=\\\"font-weight:700;margin-top:12px\\\">Independent perspectives</div>\\n              <div style=\\\"color:var(--muted);margin-top:6px\\\">A rotating snapshot of client reflection and institutional mentions.</div>\\n\\n              <div style=\\\"margin-top:10px;\\\" id=\\\"about-testimonial\\\">\\\"Reliable, clear steps and compassionate listening.\\\" — J.</div>\\n              <div style=\\\"display:flex;gap:8px;margin-top:8px;align-items:center\\\">\\n                <div class=\\\"badge\\\" data-tip=\\\"Featured in a regional health write-up\\\">Regional Press</div>\\n                <div class=\\\"badge\\\" data-tip=\\\"Clinical case-review available\\\">Clinical Review</div>\\n                <div class=\\\"badge\\\" data-tip=\\\"Client-reported satisfaction scores\\\">Client Scores</div>\\n              </div>\\n            </div>\\n\\n          </div>\\n          <div style=\\\"min-width:240px\\\">\\n            <div class=\\\"proven\\\">\\n              <div class=\\\"cred\\\">\\n                <div style=\\\"font-weight:800\\\">Credentials</div>\\n                <div style=\\\"color:var(--muted);margin-top:8px\\\">Advanced training in integrative approaches; ongoing review of literature and safety practices.</div>\\n              </div>\\n\\n              <div class=\\\"cred\\\">\\n                <div style=\\\"font-weight:800\\\">Approach</div>\\n                <div style=\\\"color:var(--muted);margin-top:8px\\\">We prioritize evidence where available and clearly label experimental or supplementary options.</div>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"timeline\\\">\\n          <div style=\\\"font-weight:800\\\">Three-phase roadmap (illustrative)</div>\\n          <div class=\\\"phase\\\">\\n            <div class=\\\"step\\\">1</div>\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Discovery & stabilization</div>\\n              <div style=\\\"color:var(--muted)\\\">History, data review, initial stabilizing steps. Typical window: 1–3 weeks.</div>\\n            </div>\\n          </div>\\n          <div class=\\\"phase\\\">\\n            <div class=\\\"step\\\">2</div>\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Prioritize & practice</div>\\n              <div style=\\\"color:var(--muted)\\\">Targeted strategies are introduced with measurable markers. Typical window: 4–8 weeks.</div>\\n            </div>\\n          </div>\\n          <div class=\\\"phase\\\">\\n            <div class=\\\"step\\\">3</div>\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Support & taper</div>\\n              <div style=\\\"color:var(--muted)\\\">Transition to self-management or stepped-down support as appropriate.</div>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:10px;color:var(--muted);font-size:13px\\\">Disclaimer: This roadmap is educational and illustrative. Individual pacing varies. Materials do not replace primary medical care or urgent services.</div>\\n        </div>\\n\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"planner\\\">\\n          <div style=\\\"font-weight:800\\\">Plan builder</div>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">Map out target timing and commitments for a three-phase plan.</div>\\n\\n          <div style=\\\"margin-top:10px\\\">\\n            <label style=\\\"font-size:13px\\\">Phase 1 length (weeks)</label>\\n            <input id=\\\"p1\\\" type=\\\"number\\\" value=\\\"2\\\" min=\\\"0\\\" style=\\\"width:100%;padding:8px;margin-top:6px;border-radius:8px;border:1px solid rgba(255,255,255,0.03);background:transparent;color:inherit\\\">\\n          </div>\\n          <div style=\\\"margin-top:8px\\\">\\n            <label style=\\\"font-size:13px\\\">Phase 2 length (weeks)</label>\\n            <input id=\\\"p2\\\" type=\\\"number\\\" value=\\\"6\\\" min=\\\"0\\\" style=\\\"width:100%;padding:8px;margin-top:6px;border-radius:8px;border:1px solid rgba(255,255,255,0.03);background:transparent;color:inherit\\\">\\n          </div>\\n          <div style=\\\"margin-top:8px\\\">\\n            <label style=\\\"font-size:13px\\\">Phase 3 length (weeks)</label>\\n            <input id=\\\"p3\\\" type=\\\"number\\\" value=\\\"4\\\" min=\\\"0\\\" style=\\\"width:100%;padding:8px;margin-top:6px;border-radius:8px;border:1px solid rgba(255,255,255,0.03);background:transparent;color:inherit\\\">\\n          </div>\\n\\n          <div style=\\\"display:flex;gap:8px;margin-top:12px\\\">\\n            <button class=\\\"btn\\\" id=\\\"calc\\\">Estimate total</button>\\n            <button class=\\\"btn\\\" id=\\\"reset\\\">Reset</button>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px;color:var(--muted)\\\" id=\\\"plan-result\\\">Total weeks: 12</div>\\n          <div style=\\\"font-size:12px;color:var(--muted);margin-top:8px\\\">Educational: timelines vary. This is a planning tool, not a treatment schedule.</div>\\n\\n        </div>\\n\\n        <div style=\\\"margin-top:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:12px;border-radius:10px;border:1px solid rgba(255,255,255,0.03)\\\">\\n          <div style=\\\"font-weight:700\\\">Quick connect</div>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Book a discovery session to translate a plan to your context.</div>\\n          <a class=\\\"btn\\\" href=\\\"book.html\\\" style=\\\"display:inline-block;margin-top:10px\\\">Reserve a time</a>\\n        </div>\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"display:flex;justify-content:space-between;max-width:1000px;margin:0 auto;padding:10px 24px;color:var(--muted)\\\">\\n      <div>Contact: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:inherit\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n      <div>© <span id=\\\"yr\\\"></span> {{BUSINESS_NAME}}</div>\\n    </div>\\n  </footer>\\n\\n  <script>\\n    // Simple testimonial rotation with badges tooltip\\n    (function(){\\n      const pool = [\\n        '\\\"I appreciated the careful listening and the practical suggestions.\\\" — L.',\\n        '\\\"A realistic plan that respected my schedule and needs.\\\" — K.',\\n        '\\\"Evidence-aware and approachable guidance.\\\" — D.'\\n      ];\\n      let i=0;const out=document.getElementById('about-testimonial');\\n      setInterval(()=>{i=(i+1)%pool.length;out.textContent=pool[i]},4800);\\n\\n      // badged tooltips: use title attribute for accessibility fallback\\n      document.querySelectorAll('[data-tip]').forEach(el=>el.setAttribute('title',el.getAttribute('data-tip')));\\n\\n      // planner interactions\\n      const p1=document.getElementById('p1'),p2=document.getElementById('p2'),p3=document.getElementById('p3');\\n      const res=document.getElementById('plan-result');\\n      function calc(){const total=(Number(p1.value)||0)+(Number(p2.value)||0)+(Number(p3.value)||0);res.textContent='Total weeks: '+total}\\n      document.getElementById('calc').addEventListener('click',calc);\\n      document.getElementById('reset').addEventListener('click',()=>{p1.value=2;p2.value=6;p3.value=4;calc();});\\n      calc();\\n      document.getElementById('yr').textContent=new Date().getFullYear();\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Schedule — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#08121b;--card:#0b1620;--accent:#ffd08a;--muted:#9fb3c1}\\n    body{margin:0;font-family:Inter,system-ui,Arial;background:linear-gradient(180deg,var(--bg),#04131b);color:#eaf6f0}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:16px 22px}\\n    .logo{width:44px;height:44px;background:linear-gradient(135deg,#ffd7a8,#7ee7c6);display:grid;place-items:center;border-radius:10px;font-weight:800}\\n    nav{display:flex;gap:12px}\\n    nav a{color:#cfe7ff;text-decoration:none}\\n    main{max-width:980px;margin:30px auto;padding:20px}\\n    .wrap{display:grid;grid-template-columns:1fr 360px;gap:18px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    h1{margin:0 0 8px 0}\\n    .note{color:var(--muted);font-size:13px}\\n    form{display:flex;flex-direction:column;gap:10px;margin-top:12px}\\n    input,select,textarea{padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.03);background:transparent;color:inherit}\\n    .row{display:flex;gap:8px}\\n    .btn-primary{background:linear-gradient(90deg,var(--accent),#7ee7c6);color:#071217;padding:10px;border-radius:10px;border:none;font-weight:800}\\n    .timeline-visual{margin-top:12px;padding:12px;border-radius:10px;background:rgba(255,255,255,0.02)}\\n    .phase{display:flex;justify-content:space-between;gap:6px;padding:8px;border-radius:8px}\\n    .phase strong{display:block}\\n    .disclaimer{font-size:12px;color:var(--muted);margin-top:8px}\\n    footer{max-width:980px;margin:18px auto;padding:10px;color:var(--muted)}\\n    @media(max-width:880px){.wrap{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Schedule your visit</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Sessions</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"wrap\\\">\\n      <section>\\n        <div class=\\\"card\\\">\\n          <h1>Reserve a session</h1>\\n          <div class=\\\"note\\\">Secure a slot and we'll follow up with intake items. Prefer a different pace? Use the planner to customize your three-phase timeline before booking.</div>\\n\\n          <form id=\\\"booking\\\">\\n            <input name=\\\"name\\\" placeholder=\\\"Your full name\\\" required>\\n            <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Email (we'll confirm)\\\" required>\\n            <input name=\\\"phone\\\" placeholder=\\\"Phone\\\" required>\\n            <select name=\\\"service\\\">\\n              <option value=\\\"vip\\\">Immersive Alignment — VIP Day</option>\\n              <option value=\\\"consult\\\">Focused Follow — 60m Consult</option>\\n              <option value=\\\"track\\\">Sustained Support — 12-week Track</option>\\n            </select>\\n            <div class=\\\"row\\\">\\n              <input name=\\\"date\\\" type=\\\"date\\\" style=\\\"flex:1\\\">\\n              <input name=\\\"time\\\" type=\\\"time\\\" style=\\\"width:140px\\\">\\n            </div>\\n            <textarea name=\\\"notes\\\" rows=\\\"3\\\" placeholder=\\\"Brief goals or questions (optional)\\\"></textarea>\\n            <div style=\\\"display:flex;gap:8px;align-items:center\\\">\\n              <button class=\\\"btn-primary\\\" type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n              <div style=\\\"color:var(--muted);font-size:13px\\\">Or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:inherit;text-decoration:none\\\">{{PHONE}}</a></div>\\n            </div>\\n            <div class=\\\"disclaimer\\\">By submitting you agree to receive scheduling messages. This booking does not replace urgent medical attention. Educational content only.</div>\\n          </form>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h3 style=\\\"margin:0\\\">Booking helper — Quick timeline preview</h3>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Adjust expected phase lengths and preview total commitment before you book.</div>\\n\\n          <div style=\\\"display:flex;gap:8px;margin-top:10px\\\">\\n            <input id=\\\"b1\\\" type=\\\"number\\\" value=\\\"2\\\" min=\\\"0\\\" style=\\\"width:80px\\\">\\n            <input id=\\\"b2\\\" type=\\\"number\\\" value=\\\"6\\\" min=\\\"0\\\" style=\\\"width:80px\\\">\\n            <input id=\\\"b3\\\" type=\\\"number\\\" value=\\\"4\\\" min=\\\"0\\\" style=\\\"width:80px\\\">\\n            <button class=\\\"btn-primary\\\" id=\\\"bcalc\\\">Preview</button>\\n          </div>\\n\\n          <div class=\\\"timeline-visual\\\" id=\\\"timeline\\\">\\n            <div class=\\\"phase\\\"><div><strong>Phase 1</strong><div style=\\\"color:var(--muted)\\\">Discovery</div></div><div id=\\\"v1\\\">2w</div></div>\\n            <div class=\\\"phase\\\"><div><strong>Phase 2</strong><div style=\\\"color:var(--muted)\\\">Practice</div></div><div id=\\\"v2\\\">6w</div></div>\\n            <div class=\\\"phase\\\"><div><strong>Phase 3</strong><div style=\\\"color:var(--muted)\\\">Support</div></div><div id=\\\"v3\\\">4w</div></div>\\n            <div style=\\\"margin-top:8px;color:var(--muted)\\\" id=\\\"total\\\">Total: 12 weeks</div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0\\\">Need help choosing?</h3>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">If you prefer a concierge approach, book a longer intake (VIP Day) and we'll block extra time for assessments. For targeted questions, choose a point consult.</div>\\n          <div style=\\\"margin-top:12px;display:flex;gap:8px\\\">\\n            <a class=\\\"btn-primary\\\" href=\\\"contact.html\\\">Request a call</a>\\n            <a class=\\\"btn-primary\\\" href=\\\"services.html\\\">View options</a>\\n          </div>\\n\\n          <div style=\\\"margin-top:14px\\\">\\n            <div style=\\\"font-weight:700\\\">Proof gallery</div>\\n            <div style=\\\"color:var(--muted);margin-top:6px\\\">Client reflections and quality markers rotate below.</div>\\n            <div style=\\\"margin-top:8px;padding:10px;background:rgba(255,255,255,0.01);border-radius:8px\\\" id=\\\"book-test\\\">\\\"Helpful, balanced advice.\\\" — C.</div>\\n            <div style=\\\"display:flex;gap:8px;margin-top:8px\\\">\\n              <div class=\\\"badge\\\" style=\\\"background:rgba(255,255,255,0.02);padding:8px;border-radius:8px;\\\">Accredited</div>\\n              <div class=\\\"badge\\\" style=\\\"background:rgba(255,255,255,0.02);padding:8px;border-radius:8px;\\\">Peer Review</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"height:14px\\\"></div>\\n        <div class=\\\"card\\\">\\n          <div style=\\\"font-weight:800\\\">Contact & policy</div>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Email: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:inherit\\\">{{EMAIL}}</a></div>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">Payment & cancellation policies will be included in confirmation.</div>\\n        </div>\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"text-align:center;color:var(--muted)\\\">© <span id=\\\"yr\\\"></span> {{BUSINESS_NAME}} • Scheduling and intake are educational in scope.</div>\\n  </footer>\\n\\n  <script>\\n    // Planner preview\\n    (function(){\\n      const b1=document.getElementById('b1'),b2=document.getElementById('b2'),b3=document.getElementById('b3');\\n      const v1=document.getElementById('v1'),v2=document.getElementById('v2'),v3=document.getElementById('v3'),tot=document.getElementById('total');\\n      function update(){const a=(Number(b1.value)||0),b=(Number(b2.value)||0),c=(Number(b3.value)||0);v1.textContent=a+'w';v2.textContent=b+'w';v3.textContent=c+'w';tot.textContent='Total: '+(a+b+c)+' weeks'}\\n      document.getElementById('bcalc').addEventListener('click',update);update();\\n    })();\\n\\n    // Booking form — local-only handler\\n    (function(){\\n      const form=document.getElementById('booking');\\n      form.addEventListener('submit',function(e){e.preventDefault();\\n        const data=new FormData(form);const out={};data.forEach((v,k)=>out[k]=v);\\n        // Basic validation demo\\n        if(!out.name||!out.email){alert('Please add name and email');return}\\n        // Simulate sending\\n        alert('Thanks, '+out.name+'. We received your request. We will email ' + out.email + ' with next steps.');\\n        form.reset();\\n      });\\n      document.getElementById('yr').textContent=new Date().getFullYear();\\n    })();\\n\\n    // Proof rotation on booking page\\n    (function(){\\n      const notes=['\\\"Helpful, balanced advice.\\\" — C.','\\\"Compassionate and practical.\\\" — F.','\\\"Clear check-ins that kept me honest.\\\" — T.'];\\n      let j=0;const el=document.getElementById('book-test');setInterval(()=>{j=(j+1)%notes.length;el.textContent=notes[j]},4200);\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
