          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investment options — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Cohort-based integrative plans, clear scopes, and flexible payment approaches for people wanting practical, whole-life change.\\\">\\n  <style>\\n    :root{--bg:#fbfbfb;--muted:#6b6b6b;--accent:#2b8f8f;--card:#ffffff;--glass:rgba(255,255,255,0.6);--radius:12px;}\\n    *{box-sizing:border-box}\\n    html,body{height:100%}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#111;background:var(--bg);}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 24px;background:linear-gradient(180deg,rgba(255,255,255,0.8),transparent);backdrop-filter:blur(6px);position:sticky;top:0;z-index:30}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:44px;height:44px;background:var(--accent);border-radius:10px;display:grid;place-items:center;color:#fff;font-weight:700}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none;font-weight:600}\\n    main{max-width:1100px;margin:36px auto;padding:0 20px}\\n    .hero{display:grid;grid-template-columns:1fr;gap:18px;padding:28px;border-radius:14px;background-image:url('assets/img/pattern.svg');background-size:270px 270px;box-shadow:0 8px 30px rgba(12,15,20,0.04)}\\n    .hero h1{margin:0;font-size:28px}\\n    .hero p{margin:6px 0 0;color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;margin-top:22px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 20px rgba(12,15,20,0.04);border:1px solid rgba(15,20,25,0.03)}\\n    .card h3{margin:0 0 8px}\\n    .price{font-size:20px;color:var(--accent);font-weight:700}\\n    .muted{color:var(--muted);font-size:14px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none;font-weight:700}\\n    footer{margin:48px 0 60px;padding:22px 0;text-align:center;color:var(--muted)}\\n    .pill{display:inline-block;padding:6px 10px;border-radius:999px;background:linear-gradient(90deg,rgba(43,143,143,0.12),rgba(43,143,143,0.04));font-weight:700;color:var(--accent)}\\n    .notes{font-size:13px;color:var(--muted);margin-top:12px}\\n    /* reveal animations */\\n    .reveal{opacity:0;transform:translateY(16px);transition:opacity 520ms cubic-bezier(.2,.9,.2,1),transform 520ms cubic-bezier(.2,.9,.2,1)}\\n    .reveal.visible{opacity:1;transform:none}\\n    @media (prefers-reduced-motion: reduce){.reveal{transition:none;opacity:1;transform:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">Practical integrative learning in a social cohort</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"conditions.html\\\">Conditions</a>\\n      <a href=\\\"approach.html\\\">Our Way</a>\\n      <a href=\\\"pricing.html\\\" style=\\\"color:var(--accent)\\\">Invest</a>\\n      <a href=\\\"about.html\\\">Who we are</a>\\n      <a href=\\\"book.html\\\">Join</a>\\n      <a href=\\\"contact.html\\\">Reach</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero reveal\\\" data-reveal>\\n      <div>\\n        <h1>Transparent cohort options for people ready to build daily habits that stick</h1>\\n        <p>Choose a guided, time-boxed path with clear deliverables, peer accountability, and a clinician-led rhythm. Payment structures that meet different needs.</p>\\n      </div>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:8px\\\">\\n        <div class=\\\"card\\\">\\n          <div class=\\\"pill\\\">New cohort start</div>\\n          <h3>Foundations Track</h3>\\n          <div class=\\\"price\\\">$495</div>\\n          <div class=\\\"muted\\\">8-week small cohort • weekly group sessions • two 1:1 check-ins</div>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve a seat</a>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3>Integration Rhythm</h3>\\n          <div class=\\\"price\\\">$1,750</div>\\n          <div class=\\\"muted\\\">12-week cohort with extended curriculum • group problem-solving • personalized adjustments</div>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">See next dates</a>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3>Peer Immersion</h3>\\n          <div class=\\\"price\\\">$3,200</div>\\n          <div class=\\\"muted\\\">Intensive cohort + mentorship slots • ideal for professionals seeking deeper practice shifts</div>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Request info</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card reveal\\\" data-reveal style=\\\"margin-top:20px\\\">\\n      <h3>How we frame value</h3>\\n      <p class=\\\"muted\\\">Cohorts are purpose-built: clear scopes, group learning, and clinician-led guidance. Pricing reflects clinician time, instructional materials, and ongoing peer support. No medical guarantees — education and shared practice.</p>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"card\\\">\\n          <h4>Flexible payments</h4>\\n          <p class=\\\"muted\\\">Split payments available at checkout. Sliding-scale spots per cohort.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h4>What's included</h4>\\n          <p class=\\\"muted\\\">Session recordings, a tailored plan, curated resources, community forum access during the cohort.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h4>Add-ons</h4>\\n          <p class=\\\"muted\\\">One-off personalized consultations, focused labs reviews, or ongoing maintenance groups available post-cohort.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"reveal\\\" data-reveal style=\\\"margin-top:20px\\\">\\n      <div class=\\\"card\\\">\\n        <h3>Questions people ask</h3>\\n        <p class=\\\"muted\\\">Do cohorts work for someone with a busy schedule? They often do — the group setting provides structure and shared accountability while allowing home practice at each participant’s pace. Medical questions are scoped and educational; clinical care decisions remain between you and your healthcare team.</p>\\n        <a class=\\\"cta\\\" href=\\\"contact.html\\\">Ask about next group</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>Phone: {{PHONE}} • Email: {{EMAIL}}</div>\\n      <div class=\\\"notes\\\">All cohort offerings are educational and supportive. Nothing here is a substitute for individualized medical assessment. For urgent concerns contact local emergency services.</div>\\n    </footer>\\n  </main>\\n\\n  <script>\\n    (function(){\\n      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\\n      const nodes = document.querySelectorAll('[data-reveal]');\\n      if(prefersReduced){ nodes.forEach(n=>n.classList.add('visible')); return }\\n      const io = new IntersectionObserver((entries)=>{\\n        entries.forEach(e=>{ if(e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target) } })\\n      },{threshold:0.12});\\n      nodes.forEach(n=>{ n.classList.add('reveal'); io.observe(n) });\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About us — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Meet the clinicians, community mentors, and the thinking that shapes our cohort experience.\\\">\\n  <style>\\n    :root{--bg:#fff;--muted:#6c6c6c;--accent:#7b4ccf;--card:#fcfcff}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#111;background:var(--bg)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 24px;border-bottom:1px solid rgba(16,18,20,0.04)}\\n    .logo{width:44px;height:44px;background:var(--accent);border-radius:10px;display:grid;place-items:center;color:#fff;font-weight:700}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none;font-weight:600}\\n    main{max-width:980px;margin:28px auto;padding:18px}\\n    .lead{display:flex;gap:18px;align-items:center;padding:18px;border-radius:12px;background:linear-gradient(180deg,rgba(123,76,207,0.06),transparent)}\\n    .lead h1{margin:0;font-size:22px}\\n    .grid{display:grid;grid-template-columns:1fr 280px;gap:18px;margin-top:18px}\\n    .card{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 8px 30px rgba(12,15,20,0.04)}\\n    .muted{color:var(--muted)}\\n    .bio{display:flex;gap:12px;align-items:center}\\n    .avatar{width:68px;height:68px;border-radius:12px;background:linear-gradient(180deg,var(--accent),#5f36c9);color:#fff;display:grid;place-items:center;font-weight:800}\\n    .pillars{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}\\n    .pill{padding:8px 12px;border-radius:999px;background:rgba(123,76,207,0.08);color:var(--accent);font-weight:700}\\n    .reveal{opacity:0;transform:translateY(14px);transition:opacity 520ms cubic-bezier(.2,.9,.2,1),transform 520ms cubic-bezier(.2,.9,.2,1)}\\n    .reveal.visible{opacity:1;transform:none}\\n    @media (prefers-reduced-motion: reduce){.reveal{transition:none;opacity:1;transform:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"conditions.html\\\">Conditions</a>\\n      <a href=\\\"approach.html\\\">Our Way</a>\\n      <a href=\\\"pricing.html\\\">Invest</a>\\n      <a href=\\\"about.html\\\" style=\\\"color:var(--accent)\\\">Story</a>\\n      <a href=\\\"book.html\\\">Join</a>\\n      <a href=\\\"contact.html\\\">Reach</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"lead reveal\\\" data-reveal>\\n      <div>\\n        <h1>We design learning paths for living better — with curiosity and evidence</h1>\\n        <p class=\\\"muted\\\">A small team of clinicians and facilitators create time-framed cohorts that blend lecture, hands-on practice, and peer accountability.</p>\\n        <div class=\\\"pillars\\\">\\n          <div class=\\\"pill\\\">Practical</div>\\n          <div class=\\\"pill\\\">Evidence-aware</div>\\n          <div class=\\\"pill\\\">Cohort-driven</div>\\n          <div class=\\\"pill\\\">Sustainable</div>\\n        </div>\\n      </div>\\n      <aside style=\\\"text-align:right;color:var(--muted)\\\">\\n        <div style=\\\"font-weight:700\\\">Cohort-based sessions</div>\\n        <div style=\\\"margin-top:8px\\\">Small groups, fixed curriculum, shared homework.</div>\\n      </aside>\\n    </section>\\n\\n    <div class=\\\"grid\\\" style=\\\"margin-top:18px\\\">\\n      <div>\\n        <section class=\\\"card reveal\\\" data-reveal>\\n          <h3>Origins</h3>\\n          <p class=\\\"muted\\\">We started from a simple question: how do people make small, meaningful changes that actually last? Rather than private therapy alone, cohorts create reliable practice windows and community feedback loops. Clinicians guide, peers reflect, and each person leaves with a concrete plan.</p>\\n        </section>\\n\\n        <section class=\\\"card reveal\\\" data-reveal style=\\\"margin-top:12px\\\">\\n          <h3>What we value</h3>\\n          <ul class=\\\"muted\\\">\\n            <li>Clarity over jargon — clear steps, not ideas alone.</li>\\n            <li>Respect for context — life constraints shape any plan.</li>\\n            <li>Shared experimentation — cohorts test, measure, iterate.</li>\\n          </ul>\\n        </section>\\n\\n        <section class=\\\"card reveal\\\" data-reveal style=\\\"margin-top:12px\\\">\\n          <h3>Community checks</h3>\\n          <p class=\\\"muted\\\">Peer sessions are moderated to keep things safe and useful. Clinical touches are educational and not a replacement for one-to-one medical care. If you need individualized clinical decisions, book a private consult.</p>\\n        </section>\\n      </div>\\n\\n      <aside>\\n        <section class=\\\"card reveal\\\" data-reveal>\\n          <h4>Meet the guides</h4>\\n          <div class=\\\"bio\\\" style=\\\"margin-top:10px\\\">\\n            <div class=\\\"avatar\\\">AB</div>\\n            <div>\\n              <div style=\\\"font-weight:800\\\">Alex B., ND</div>\\n              <div class=\\\"muted\\\">Clinician & curriculum lead</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"bio\\\" style=\\\"margin-top:12px\\\">\\n            <div class=\\\"avatar\\\">RM</div>\\n            <div>\\n              <div style=\\\"font-weight:800\\\">Rae M., MPH</div>\\n              <div class=\\\"muted\\\">Facilitator & cohort coach</div>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <a href=\\\"contact.html\\\" style=\\\"display:inline-block;padding:8px 12px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none\\\">Connect with the team</a>\\n          </div>\\n        </section>\\n\\n        <section class=\\\"card reveal\\\" data-reveal style=\\\"margin-top:12px\\\">\\n          <h4>Practical details</h4>\\n          <p class=\\\"muted\\\">We run multiple cohorts per year in {{CITY}}, {{STATE}} and online. Scholarships and sliding-scale seats are offered case-by-case.</p>\\n        </section>\\n      </aside>\\n    </div>\\n\\n    <div style=\\\"margin-top:18px;text-align:center;color:var(--muted)\\\">\\n      <div>Phone: {{PHONE}} • Email: {{EMAIL}}</div>\\n      <div style=\\\"margin-top:8px\\\">If you have an urgent medical concern, please contact your primary care provider or local emergency services. Our programs are educational and supportive.</div>\\n    </div>\\n  </main>\\n\\n  <script>\\n    (function(){\\n      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\\n      const nodes = document.querySelectorAll('[data-reveal]');\\n      if(prefersReduced){ nodes.forEach(n=>n.classList.add('visible')); return }\\n      const io = new IntersectionObserver((entries)=>{\\n        entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('visible'); io.unobserve(e.target) } })\\n      },{threshold:0.12});\\n      nodes.forEach(n=>{ n.classList.add('reveal'); io.observe(n) });\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Join a cohort — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Sign up for a cohort seat or use the Session Planner to craft a short plan and export it as a plain text summary.\\\">\\n  <style>\\n    :root{--bg:#f7fbfb;--muted:#5f6b6b;--accent:#d9534f;--card:#ffffff}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#111;background:var(--bg)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:16px 22px;background:transparent}\\n    .logo{width:42px;height:42px;background:var(--accent);border-radius:10px;display:grid;place-items:center;color:#fff;font-weight:800}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    main{max-width:980px;margin:22px auto;padding:18px}\\n    .intro{display:flex;gap:18px;align-items:center}\\n    .card{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 12px 40px rgba(12,15,20,0.06);border:1px solid rgba(12,15,20,0.03)}\\n    h1{margin:0}\\n    .muted{color:var(--muted)}\\n    .planner{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    label{display:block;margin-top:10px;font-weight:700}\\n    input[type=\\\"text\\\"],textarea,select{width:100%;padding:10px;border-radius:8px;border:1px solid #e6e6e6;margin-top:6px}\\n    textarea{min-height:120px}\\n    .btn{display:inline-block;padding:10px 14px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none;border:none;font-weight:700;cursor:pointer}\\n    .secondary{background:#fff;color:var(--accent);border:1px solid rgba(0,0,0,0.06)}\\n    .reveal{opacity:0;transform:translateY(12px);transition:opacity 520ms cubic-bezier(.2,.9,.2,1),transform 520ms cubic-bezier(.2,.9,.2,1)}\\n    .reveal.visible{opacity:1;transform:none}\\n    @media (prefers-reduced-motion: reduce){.reveal{transition:none;opacity:1;transform:none}}\\n    .summary{white-space:pre-wrap;background:#fbfbfb;padding:12px;border-radius:8px;border:1px dashed rgba(0,0,0,0.04);font-family:monospace;font-size:13px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"pricing.html\\\">Invest</a>\\n      <a href=\\\"about.html\\\">Story</a>\\n      <a href=\\\"contact.html\\\">Reach</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"card reveal\\\" data-reveal>\\n      <div class=\\\"intro\\\">\\n        <div>\\n          <h1>Ready to join?</h1>\\n          <p class=\\\"muted\\\">Reserve a cohort seat or try the Session Planner to sketch a personalized plan you can bring to a clinician or keep for your own practice.</p>\\n        </div>\\n        <div style=\\\"margin-left:auto;text-align:right\\\">\\n          <div style=\\\"font-weight:800\\\">Next cohort starts soon</div>\\n          <div class=\\\"muted\\\">Limited seats. Payment options available at checkout.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"planner\\\" style=\\\"margin-top:18px\\\">\\n      <div class=\\\"card reveal\\\" data-reveal>\\n        <h3>Session Planner</h3>\\n        <p class=\\\"muted\\\">Answer a few prompts and we’ll create a concise, shareable plan summary you can copy or download.</p>\\n\\n        <label for=\\\"goal\\\">Primary goal</label>\\n        <input id=\\\"goal\\\" type=\\\"text\\\" placeholder=\\\"Example: Sleep more consistently\\\" />\\n\\n        <label for=\\\"symptoms\\\">Top challenges</label>\\n        <textarea id=\\\"symptoms\\\" placeholder=\\\"List the things getting in the way\\\"></textarea>\\n\\n        <label for=\\\"time\\\">Weekly time available</label>\\n        <select id=\\\"time\\\">\\n          <option value=\\\"1\\\">~1 hour</option>\\n          <option value=\\\"3\\\">~3 hours</option>\\n          <option value=\\\"5\\\">~5+ hours</option>\\n        </select>\\n\\n        <label for=\\\"style\\\">Preferred approach</label>\\n        <select id=\\\"style\\\">\\n          <option value=\\\"gentle\\\">Gentle habit shifts</option>\\n          <option value=\\\"structured\\\">Structured protocols</option>\\n          <option value=\\\"peer\\\">Peer accountability focus</option>\\n        </select>\\n\\n        <label for=\\\"notes\\\">Anything else we should know</label>\\n        <textarea id=\\\"notes\\\" placeholder=\\\"Preferences, access, barriers\\\"></textarea>\\n\\n        <div style=\\\"margin-top:12px;display:flex;gap:8px\\\">\\n          <button id=\\\"build\\\" class=\\\"btn\\\">Build summary</button>\\n          <button id=\\\"clear\\\" class=\\\"secondary\\\" style=\\\"padding:10px 12px\\\">Clear</button>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card reveal\\\" data-reveal>\\n        <h3>Plan preview</h3>\\n        <div id=\\\"preview\\\" class=\\\"summary\\\">Your plan will appear here after you click \\\"Build summary\\\".</div>\\n        <div style=\\\"display:flex;gap:8px;margin-top:12px\\\">\\n          <button id=\\\"copy\\\" class=\\\"btn\\\" disabled>Copy text</button>\\n          <button id=\\\"download\\\" class=\\\"secondary\\\" disabled>Download .txt</button>\\n          <a id=\\\"bookSeat\\\" class=\\\"btn\\\" href=\\\"booking-checkout.html\\\" style=\\\"margin-left:auto\\\">Book a seat</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section class=\\\"card reveal\\\" data-reveal style=\\\"margin-top:18px\\\">\\n      <h3>Need a private consult?</h3>\\n      <p class=\\\"muted\\\">If your situation feels complex or urgent, a one-on-one appointment is appropriate. Our cohorts are educational and community-focused; they do not replace medical care.</p>\\n      <a class=\\\"btn\\\" href=\\\"contact.html\\\">Request consult</a>\\n    </section>\\n\\n    <div style=\\\"margin-top:18px;text-align:center;color:var(--muted)\\\">\\n      <div>Questions — call {{PHONE}} or email {{EMAIL}}</div>\\n      <div style=\\\"font-size:13px;margin-top:8px\\\">By using the planner you acknowledge this is for informational use only and not a medical record.</div>\\n    </div>\\n  </main>\\n\\n  <script>\\n    // reveal logic respecting reduced-motion\\n    (function(){\\n      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\\n      const nodes = document.querySelectorAll('[data-reveal]');\\n      if(prefersReduced){ nodes.forEach(n=>n.classList.add('visible')); return }\\n      const io = new IntersectionObserver((entries)=>{ entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('visible'); io.unobserve(e.target) } }) },{threshold:0.12});\\n      nodes.forEach(n=>{ n.classList.add('reveal'); io.observe(n) });\\n    })();\\n\\n    // Session Planner logic\\n    (function(){\\n      const el = id=>document.getElementById(id);\\n      const buildBtn = el('build');\\n      const copyBtn = el('copy');\\n      const downloadBtn = el('download');\\n      const clearBtn = el('clear');\\n      const preview = el('preview');\\n\\n      function summarise(){\\n        const goal = el('goal').value.trim();\\n        const symptoms = el('symptoms').value.trim();\\n        const time = el('time').value;\\n        const style = el('style').value;\\n        const notes = el('notes').value.trim();\\n        const timeLabel = time==='1'? '~1 hour/wk' : time==='3'? '~3 hours/wk' : '~5+ hours/wk';\\n        const styleLabel = style==='gentle'? 'Gentle habit shifts' : style==='structured'? 'Structured protocol' : 'Peer accountability focus';\\n\\n        let lines = [];\\n        lines.push('Session Planner — Personal snapshot');\\n        lines.push('Goal: ' + (goal || '[not specified]'));\\n        lines.push('Top challenges: ' + (symptoms || '[not specified]'));\\n        lines.push('Weekly capacity: ' + timeLabel);\\n        lines.push('Preferred approach: ' + styleLabel);\\n        if(notes) lines.push('Notes: ' + notes);\\n        lines.push('Suggested cohort fit: ' + suggestCohort(goal, time, style));\\n        lines.push('Practical first steps:');\\n        lines.push(...firstSteps(goal, symptoms, style));\\n        lines.push('\\\\nBring this summary to an intake or keep it for your own tracking.');\\n\\n        return lines.join('\\\\n');\\n      }\\n\\n      function suggestCohort(goal, time, style){\\n        // simple heuristic\\n        if(style==='peer') return 'Peer Immersion';\\n        if(time==='1') return 'Foundations Track';\\n        if(time==='5') return 'Integration Rhythm';\\n        return 'Foundations Track';\\n      }\\n\\n      function firstSteps(goal, symptoms, style){\\n        const steps = [];\\n        if(goal) steps.push('- Define one measurable check (e.g., sleep by 11pm on 5 nights/wk)');\\n        else steps.push('- Pick one clear, achievable target to track this week');\\n        if(symptoms) steps.push('- Note 1 small change to reduce the most frequent barrier you mentioned');\\n        steps.push(style==='structured' ? '- Use a short protocol and measure twice weekly' : '- Pick one habit and a simple cue to attach it to');\\n        steps.push('- Share the plan with your cohort buddy for accountability');\\n        return steps;\\n      }\\n\\n      buildBtn.addEventListener('click',function(){\\n        const text = summarise();\\n        preview.textContent = text;\\n        copyBtn.disabled = false; downloadBtn.disabled = false;\\n      });\\n\\n      copyBtn.addEventListener('click',async function(){\\n        try{\\n          await navigator.clipboard.writeText(preview.textContent);\\n          copyBtn.textContent = 'Copied!';\\n          setTimeout(()=>copyBtn.textContent='Copy text',1600);\\n        }catch(e){\\n          alert('Copy not supported in this browser.');\\n        }\\n      });\\n\\n      downloadBtn.addEventListener('click',function(){\\n        const blob = new Blob([preview.textContent],{type:'text/plain'});\\n        const url = URL.createObjectURL(blob);\\n        const a = document.createElement('a');\\n        a.href = url; a.download = 'session-plan.txt'; document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);\\n      });\\n\\n      clearBtn.addEventListener('click',function(){\\n        ['goal','symptoms','notes'].forEach(id=>el(id).value='');\\n        el('time').selectedIndex=0; el('style').selectedIndex=0; preview.textContent = 'Your plan will appear here after you click \\\"Build summary\\\".';\\n        copyBtn.disabled = true; downloadBtn.disabled = true;\\n      });\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
