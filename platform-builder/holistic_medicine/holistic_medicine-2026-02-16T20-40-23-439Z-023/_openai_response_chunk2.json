          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Offerings — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Holistic, integrative services to support whole-person health. Education-forward, personalized care.\\\">\\n  <style>\\n    :root{--earth-1:#6a4f3a;--earth-2:#b88b5a;--earth-3:#efe6dd;--accent:#8aa39a;--muted:#7a6f66}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--earth-1);background:linear-gradient(180deg,var(--earth-3),#fff);}\\n    .wrap{max-width:980px;margin:36px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between;gap:16px}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:58px;height:58px;border-radius:10px;background:linear-gradient(135deg,var(--earth-2),var(--accent));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;box-shadow:0 6px 18px rgba(106,79,58,0.12)}\\n    nav a{margin-left:14px;color:var(--earth-1);text-decoration:none;font-weight:600}\\n    .hero{display:grid;grid-template-columns:1fr 320px;gap:22px;align-items:center;margin-top:28px}\\n    .card{background:rgba(255,255,255,0.7);border-radius:12px;padding:20px;box-shadow:0 8px 20px rgba(106,79,58,0.06)}\\n    .tag{display:inline-block;padding:6px 10px;background:rgba(138,163,154,0.14);color:var(--accent);border-radius:999px;font-size:13px}\\n    h1{margin:8px 0 6px;font-size:28px;letter-spacing:0.2px}\\n    p.lead{color:var(--muted);margin:0 0 14px}\\n    .actions{display:flex;gap:10px}\\n    .btn{background:var(--earth-2);color:white;border:none;padding:10px 14px;border-radius:10px;font-weight:700;text-decoration:none}\\n    .btn.alt{background:transparent;border:2px solid var(--earth-2);color:var(--earth-1)}\\n    .list{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:16px}\\n    .item{background:linear-gradient(180deg,#fff,rgba(238,230,221,0.7));padding:14px;border-radius:10px}\\n    .muted{color:var(--muted);font-size:14px}\\n    .process{margin-top:20px;display:flex;flex-direction:column;gap:12px}\\n    .step{display:flex;gap:14px;align-items:flex-start}\\n    .num{width:38px;height:38px;border-radius:50%;background:var(--earth-2);color:#fff;display:grid;place-items:center;font-weight:800}\\n    footer{margin-top:36px;padding-top:18px;border-top:1px dashed rgba(106,79,58,0.08);display:flex;justify-content:space-between;align-items:center}\\n    .testimonial{font-style:italic;color:var(--earth-1);background:linear-gradient(90deg,rgba(138,163,154,0.06),transparent);padding:12px;border-radius:10px}\\n    .faq{margin-top:18px}\\n    .q{font-weight:700}\\n    .lead-magnet{margin-top:18px;padding:14px;border-radius:10px;background:linear-gradient(90deg,rgba(138,163,154,0.06),rgba(168,130,90,0.02))}\\n    .form-row{display:flex;gap:8px;margin-top:8px}\\n    input[type=\\\"email\\\"],input[type=\\\"text\\\"]{flex:1;padding:10px;border-radius:8px;border:1px solid rgba(106,79,58,0.12)}\\n    .svg-bg{position:fixed;right:-120px;top:-120px;width:480px;opacity:0.12;pointer-events:none}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.logo{width:48px;height:48px}.svg-bg{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <img class=\\\"svg-bg\\\" src=\\\"/assets/img/pattern.svg\\\" alt=\\\"pattern\\\">\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">HM</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">A rooted approach to whole-person wellbeing</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Root</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"conditions.html\\\">Concerns</a>\\n        <a href=\\\"approach.html\\\">Path</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"card\\\">\\n        <span class=\\\"tag\\\">Services & Programs</span>\\n        <h1>Gentle, evidence-minded support for lasting balance</h1>\\n        <p class=\\\"lead\\\">We blend lifestyle guidance, herbal and nutritional insight, and mind-body practices to help you move toward steadier sleep, calmer stress response, and clearer digestion. Education and measurable steps come first — not promises.</p>\\n\\n        <div class=\\\"list\\\">\\n          <div class=\\\"item\\\">\\n            <strong>Initial Integrative Visit</strong>\\n            <div class=\\\"muted\\\">Comprehensive history, whole-person listening, and care priorities.</div>\\n          </div>\\n          <div class=\\\"item\\\">\\n            <strong>Short Follow-Up</strong>\\n            <div class=\\\"muted\\\">Tweak a plan, review symptoms, adapt tools.</div>\\n          </div>\\n          <div class=\\\"item\\\">\\n            <strong>Therapeutic Nutrition & Botanicals</strong>\\n            <div class=\\\"muted\\\">Education on food, herbs, and lifestyle roles for better rhythms.</div>\\n          </div>\\n          <div class=\\\"item\\\">\\n            <strong>Mind-Body Coaching</strong>\\n            <div class=\\\"muted\\\">Practical breathwork, sleep rituals, stress resiliency techniques.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"process\\\">\\n          <div style=\\\"display:flex;gap:8px;margin-top:8px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a><a class=\\\"btn alt\\\" href=\\\"about.html\\\">Meet the practitioner</a></div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <div class=\\\"testimonial\\\">\\\"A calm, practical guide through messy health questions.\\\" — A.R., Portland</div>\\n        <div style=\\\"margin-top:14px\\\">\\n          <div style=\\\"font-weight:700\\\">Quick rates</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Initial 75–90 min consult · Follow-ups 30–40 min · Packages available. See pricing page for details.</div>\\n        </div>\\n        <div class=\\\"lead-magnet\\\">\\n          <div style=\\\"font-weight:700\\\">Seasonal Reset Guide</div>\\n          <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Sign up for a short guide with simple morning and evening rituals.</div>\\n          <form style=\\\"margin-top:10px\\\" action=\\\"/subscribe\\\" method=\\\"post\\\">\\n            <div class=\\\"form-row\\\">\\n              <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Your email\\\" required>\\n              <button class=\\\"btn\\\">Get the guide</button>\\n            </div>\\n          </form>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:22px\\\">\\n      <h2 style=\\\"margin-bottom:6px\\\">How the work flows</h2>\\n      <div class=\\\"process\\\">\\n        <div class=\\\"step\\\"><div class=\\\"num\\\">1</div><div><strong>Discovery</strong><div class=\\\"muted\\\">A broad conversation about your history, priorities, and what matters to you now.</div></div></div>\\n        <div class=\\\"step\\\"><div class=\\\"num\\\">2</div><div><strong>Plan</strong><div class=\\\"muted\\\">A personalized, teachable plan with small, measurable next steps — food, sleep, movement, botanicals as appropriate.</div></div></div>\\n        <div class=\\\"step\\\"><div class=\\\"num\\\">3</div><div><strong>Support</strong><div class=\\\"muted\\\">Follow-ups, care adjustments, and referrals when additional testing or specialists are indicated.</div></div></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card faq\\\">\\n      <h3>Questions people often ask</h3>\\n      <div style=\\\"margin-top:10px\\\">\\n        <div class=\\\"q\\\">Do you guarantee outcomes?</div>\\n        <div class=\\\"muted\\\">No. We focus on education, measurable habits, and whole-person care. Individual responses vary.</div>\\n      </div>\\n      <div style=\\\"margin-top:8px\\\">\\n        <div class=\\\"q\\\">Will you order labs?</div>\\n        <div class=\\\"muted\\\">When educationally useful, yes. Labs are optional and discussed collaboratively.</div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">Ready to begin?</div>\\n        <div class=\\\"muted\\\">Call {{PHONE}} or <a href=\\\"mailto:{{EMAIL}}\\\">email</a> to schedule.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Concerns & Common Conditions — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Common health concerns we support with whole-person strategies: sleep, stress, digestion, inflammation, energy.\\\">\\n  <style>\\n    :root{--earth-1:#5b4434;--accent:#7f9b8f;--cream:#fbf7f4;--terra:#c79a6b}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#fff,var(--cream));color:var(--earth-1)}\\n    .container{max-width:900px;margin:28px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:12px;color:var(--earth-1);text-decoration:none}\\n    .hero{margin-top:18px;background:rgba(199,154,107,0.06);padding:18px;border-radius:12px}\\n    h1{margin:6px 0}\\n    .grid{display:grid;grid-template-columns:1fr 300px;gap:18px;margin-top:18px}\\n    .panel{background:#fff;padding:16px;border-radius:10px;box-shadow:0 6px 18px rgba(91,68,52,0.06)}\\n    .concern{display:flex;gap:12px;align-items:flex-start;padding:10px;border-radius:8px}\\n    .icon{width:46px;height:46px;border-radius:8px;background:linear-gradient(135deg,var(--terra),#e6d7c8);display:grid;place-items:center;color:#fff;font-weight:800}\\n    .muted{color:rgba(91,68,52,0.64)}\\n    .disclaimer{font-size:13px;color:rgba(91,68,52,0.6);margin-top:8px}\\n    .lead-magnet{margin-top:12px;padding:12px;border-radius:10px;background:linear-gradient(90deg,rgba(127,155,143,0.06),transparent)}\\n    .cta{display:flex;justify-content:space-between;align-items:center;margin-top:18px}\\n    .btn{background:var(--terra);color:#fff;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:700}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}.nav a{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"width:52px;height:52px;border-radius:10px;background:linear-gradient(135deg,#c79a6b,#8aa39a);display:grid;place-items:center;color:#fff;font-weight:800\\\">HM</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">I run programs that teach steady habits — not quick fixes.</div>\\n        </div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"conditions.html\\\">Concerns</a>\\n        <a href=\\\"approach.html\\\">How we work</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <h1>Common concerns we help people understand</h1>\\n      <p class=\\\"muted\\\">We prioritize education, lifestyle tools, and appropriate testing. Care is individualized and there are no guaranteed cures.</p>\\n    </section>\\n\\n    <div class=\\\"grid\\\">\\n      <main>\\n        <div class=\\\"panel\\\">\\n          <h3 style=\\\"margin-top:0\\\">What people often seek help for</h3>\\n\\n          <div class=\\\"concern\\\" style=\\\"margin-top:10px\\\">\\n            <div class=\\\"icon\\\">S</div>\\n            <div>\\n              <strong>Stress & Anxiety</strong>\\n              <div class=\\\"muted\\\">Breath practices, sleep hygiene, circadian-friendly habits, and supportive botanicals can lower reactivity. We teach skills and track progress.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"icon\\\">Z</div>\\n            <div>\\n              <strong>Sleep Disturbance</strong>\\n              <div class=\\\"muted\\\">Small, regular changes to evening routine, light exposure, and nutrition often shift sleep patterns. Labs only when clinically indicated.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"icon\\\">D</div>\\n            <div>\\n              <strong>Digestion & Gut Comfort</strong>\\n              <div class=\\\"muted\\\">Education about food patterns, mindful eating, and targeted interventions can ease symptoms. We avoid overselling quick fixes.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"icon\\\">I</div>\\n            <div>\\n              <strong>Low-Grade Inflammation</strong>\\n              <div class=\\\"muted\\\">Nutrition, movement, sleep, and stress are pillars. Labs and referrals discussed when needed to guide safe options.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"icon\\\">E</div>\\n            <div>\\n              <strong>Energy & Fatigue</strong>\\n              <div class=\\\"muted\\\">We explore rhythms, diet, sleep, and environmental contributors. Testing is one tool among many.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"disclaimer\\\">Note: This list is educational and not exhaustive. We do not promise cures. If you have urgent or severe symptoms, please consult emergency services or your primary care provider.</div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:14px\\\">\\n          <h4 style=\\\"margin:0\\\">When tests are helpful</h4>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Labs can clarify medical issues or guide safe use of supplements. They are discussed as one possible step and always paired with lifestyle-first strategies.</p>\\n        </div>\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <h4 style=\\\"margin-top:0\\\">A short story</h4>\\n          <p class=\\\"muted\\\">People often ask for a single answer. Instead, we map small, repeatable practices that build resilience over months. The work is steady; the gains are durable.</p>\\n\\n          <div class=\\\"lead-magnet\\\">\\n            <strong>Free primer: \\\"Begin with Breath\\\"</strong>\\n            <p class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Enter your email for a three-step breathing practice to calm the nervous system.</p>\\n            <form action=\\\"/subscribe\\\" method=\\\"post\\\">\\n              <div style=\\\"display:flex;gap:8px;margin-top:8px\\\">\\n                <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Email\\\" required style=\\\"flex:1;padding:10px;border-radius:8px;border:1px solid rgba(91,68,52,0.08)\\\">\\n                <button class=\\\"btn\\\">Send</button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0\\\">Still unsure?</h4>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">A 15-minute consult can clarify goals and next steps. No pressure, just information.</p>\\n          <div style=\\\"margin-top:8px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <div style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div class=\\\"muted\\\">Serving {{CITY}}, {{STATE}} · {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n      <div>\\n        <a href=\\\"contact.html\\\" style=\\\"margin-right:8px;color:var(--earth-1);text-decoration:none\\\">Connect</a>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a visit</a>\\n      </div>\\n    </div>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Our Path — How Care Works — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"A calm, structured intake and follow-up process emphasizing education, small steps, and shared decision-making.\\\">\\n  <style>\\n    :root{--wood:#6b4f3d;--sage:#8da495;--light:#fbf9f7}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,var(--light),#fff);color:var(--wood)}\\n    .shell{max-width:920px;margin:34px auto;padding:22px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    .logo{width:58px;height:58px;border-radius:12px;background:linear-gradient(135deg,var(--wood),var(--sage));display:grid;place-items:center;color:#fff;font-weight:800}\\n    nav a{margin-left:12px;color:var(--wood);text-decoration:none}\\n    .intro{margin-top:18px;background:linear-gradient(90deg,rgba(141,164,149,0.06),transparent);padding:16px;border-radius:12px}\\n    h1{margin:8px 0}\\n    .flow{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:18px}\\n    .card{background:#fff;border-radius:12px;padding:14px;box-shadow:0 8px 20px rgba(107,79,61,0.06)}\\n    .small{font-size:13px;color:rgba(107,79,61,0.7)}\\n    .detail{margin-top:12px}\\n    .faq{margin-top:16px}\\n    .lead{display:flex;gap:10px;margin-top:12px}\\n    .btn{background:var(--wood);color:#fff;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:700}\\n    @media(max-width:900px){.flow{grid-template-columns:1fr 1fr}.logo{width:48px;height:48px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"shell\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div class=\\\"logo\\\">HM</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div class=\\\"small\\\">A clear, teachable path to better rhythms and resilience</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"conditions.html\\\">Concerns</a>\\n        <a href=\\\"approach.html\\\">Path</a>\\n        <a href=\\\"about.html\\\">Origins</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"intro\\\">\\n      <h1>How we partner with you</h1>\\n      <p class=\\\"small\\\">Care here follows a steady map: listen, educate, try small changes, measure, repeat. Any testing is discussed as a way to illuminate, not to promise answers.</p>\\n    </section>\\n\\n    <section class=\\\"flow\\\">\\n      <div class=\\\"card\\\">\\n        <strong>1. Intake — Deep listening</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">We gather your history, patterns, relationships to food, sleep, stress, and goals. Questions are welcome; judgment is not.</div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <strong>2. Shared plan — Simple, teachable steps</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Expect a prioritized plan you can read and follow: habits, gentle nutrition shifts, movement, sleep cues, and optional botanicals when appropriate.</div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <strong>3. Follow-ups — Adjust and measure</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Short, frequent follow-ups keep momentum. We track outcomes and tune the plan together.</div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <strong>4. Optional tests & referrals</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">When tests help explain symptoms or ensure safety, we recommend targeted labs and partner with specialists as needed.</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"detail\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Intake in detail</h3>\\n        <p class=\\\"small\\\">The initial visit is a careful inventory of your lifestyle, medical history, sleep and stress patterns, and what you hope to change. We emphasize learning: you should leave with clear, practical next steps.</p>\\n      </div>\\n\\n      <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n        <h3 style=\\\"margin-top:0\\\">What a plan looks like</h3>\\n        <ul class=\\\"small\\\" style=\\\"margin-top:8px\\\">\\n          <li>1–3 measurable behavior changes (sleep window, evening routine, simplified meals)</li>\\n          <li>Short breathing or movement practices to try daily</li>\\n          <li>When appropriate, short courses of botanicals or nutrients with safety notes</li>\\n        </ul>\\n      </div>\\n\\n      <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n        <h3 style=\\\"margin-top:0\\\">Follow-up rhythm</h3>\\n        <p class=\\\"small\\\">Most people start with a 4–8 week cadence of brief check-ins to adapt the plan. Frequency is personalized.</p>\\n      </div>\\n\\n      <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n        <h3 style=\\\"margin-top:0\\\">About labs (educational)</h3>\\n        <p class=\\\"small\\\">Labs can be useful to rule out medical causes or to inform safe supplement use. Examples: basic metabolic panels, thyroid indices, targeted micronutrient checks. We discuss benefits, limits, and costs before ordering.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Questions people ask</h3>\\n        <div style=\\\"margin-top:8px\\\">\\n          <strong>Is this a replacement for primary care?</strong>\\n          <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">No. We collaborate with your primary care and specialists when needed. We supplement with lifestyle-focused, integrative strategies.</div>\\n        </div>\\n        <div style=\\\"margin-top:8px\\\">\\n          <strong>How long until I notice changes?</strong>\\n          <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Some practices shift mood or sleep within days; lasting change is often seen over weeks to months. We focus on sustainable, measurable steps.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"lead\\\" style=\\\"justify-content:space-between;align-items:center\\\">\\n      <div class=\\\"small\\\">Questions? Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </div>\\n\\n    <div style=\\\"margin-top:18px;font-size:13px;color:rgba(107,79,61,0.6)\\\">Practitioner: {{PRACTITIONER_NAME}}, {{CREDENTIALS}} · Serving {{CITY}}, {{STATE}}</div>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
