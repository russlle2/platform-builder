          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Pricing — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f6efe6;--accent:#7d5a3c;--muted:#8a6f57;--card:#fff;--glass:rgba(255,255,255,0.6);--shadow:rgba(45,35,25,0.08)}\\n    html,body{height:100%}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#2b2b2b;background:linear-gradient(180deg,var(--bg),#efe6da);}\\n    nav{display:flex;gap:18px;align-items:center;padding:28px 32px;background:transparent}\\n    .brand{font-weight:700;color:var(--accent);font-size:18px}\\n    .navlinks{margin-left:auto;display:flex;gap:14px}\\n    a.link{color:var(--muted);text-decoration:none;font-size:15px}\\n    header.hero{position:relative;overflow:hidden;padding:44px 32px 72px}\\n    .grid{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 360px;gap:28px}\\n    .card{background:var(--card);border-radius:12px;padding:22px;box-shadow:0 6px 24px var(--shadow)}\\n    h1{margin:0;font-size:28px;color:var(--accent);line-height:1.05}\\n    p.lead{color:#4a3d34;margin-top:10px}\\n    .price-list{display:flex;flex-direction:column;gap:12px;margin-top:16px}\\n    .tier{border-radius:10px;padding:14px;background:linear-gradient(180deg,#fff, #fbf7f3);display:flex;justify-content:space-between;align-items:center}\\n    .tier h3{margin:0;font-size:16px;color:#3e2f28}\\n    .amt{font-weight:700;color:var(--accent)}\\n    .note{font-size:13px;color:var(--muted);margin-top:8px}\\n\\n    /* sections */\\n    section{max-width:1100px;margin:28px auto;padding:0 32px}\\n    .social{display:flex;gap:12px;align-items:center}\\n    .testimonial{background:var(--card);padding:14px;border-radius:10px;box-shadow:0 6px 18px var(--shadow);}\\n    ul.benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;padding:0;list-style:none}\\n    ul.benefits li{background:var(--glass);padding:12px;border-radius:8px;color:#3b312a}\\n    .process-steps{display:flex;gap:12px}\\n    .step{flex:1;background:var(--card);padding:14px;border-radius:8px;text-align:center}\\n    .faq{display:grid;gap:12px}\\n    .faq .q{background:var(--card);padding:12px;border-radius:8px}\\n\\n    form.leadmag{display:flex;gap:8px;margin-top:12px}\\n    input,select,textarea{padding:10px;border-radius:8px;border:1px solid #e6ddd3;font-size:14px}\\n    button.btn{background:var(--accent);color:white;padding:10px 14px;border-radius:8px;border:0}\\n\\n    footer.cta{background:linear-gradient(180deg,#efe4d6,#f6efe6);padding:28px 32px;border-top:1px solid rgba(0,0,0,0.02)}\\n    .cta-wrap{max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;align-items:center}\\n\\n    /* decorative SVG */\\n    .pattern{position:fixed;right:-120px;top:-80px;width:520px;height:520px;opacity:0.16;z-index:0}\\n\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}.navlinks{display:none}.hero{padding-bottom:48px}.pattern{display:none}ul.benefits{grid-template-columns:repeat(2,1fr)} }\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#e9cbc0\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#d6b89e\\\"/></linearGradient>\\n    </defs>\\n    <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"200\\\" height=\\\"200\\\" fill=\\\"url(#g1)\\\" rx=\\\"20\\\"/>\\n    <g fill-opacity=\\\"0.08\\\" fill=\\\"#5b3f2a\\\">\\n      <circle cx=\\\"40\\\" cy=\\\"40\\\" r=\\\"60\\\"/>\\n      <circle cx=\\\"160\\\" cy=\\\"140\\\" r=\\\"40\\\"/>\\n    </g>\\n  </svg>\\n\\n  <nav>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <div class=\\\"navlinks\\\">\\n      <a class=\\\"link\\\" href=\\\"index.html\\\">Gatherings</a>\\n      <a class=\\\"link\\\" href=\\\"services.html\\\">Offerings</a>\\n      <a class=\\\"link\\\" href=\\\"approach.html\\\">Method</a>\\n      <a class=\\\"link\\\" href=\\\"about.html\\\">About</a>\\n      <a class=\\\"link\\\" href=\\\"contact.html\\\">Connect</a>\\n    </div>\\n  </nav>\\n\\n  <header class=\\\"hero\\\">\\n    <div class=\\\"grid\\\">\\n      <div style=\\\"z-index:2\\\">\\n        <h1>Pricing for event series & workshops</h1>\\n        <p class=\\\"lead\\\">Join thoughtfully paced sessions that blend education, gentle somatics and practical tools. Pricing reflects small groups, guided materials and follow-up support—no promises of cures, only a steady path toward resilience.</p>\\n\\n        <div class=\\\"card price-list\\\" role=\\\"list\\\">\\n          <div class=\\\"tier\\\" role=\\\"listitem\\\">\\n            <div>\\n              <h3>Intro Workshop (single session)</h3>\\n              <div class=\\\"note\\\">2.5 hours • Group learning + Q&amp;A</div>\\n            </div>\\n            <div class=\\\"amt\\\">$45</div>\\n          </div>\\n\\n          <div class=\\\"tier\\\" role=\\\"listitem\\\">\\n            <div>\\n              <h3>Foundations Series — 4 sessions</h3>\\n              <div class=\\\"note\\\">Monthly rhythm, practical homework, small cohort</div>\\n            </div>\\n            <div class=\\\"amt\\\">$295</div>\\n          </div>\\n\\n          <div class=\\\"tier\\\" role=\\\"listitem\\\">\\n            <div>\\n              <h3>Weekend Retreat (limited)</h3>\\n              <div class=\\\"note\\\">Immersive practice, meals, guided reflections</div>\\n            </div>\\n            <div class=\\\"amt\\\">$560</div>\\n          </div>\\n        </div>\\n\\n        <p class=\\\"note\\\">Sliding scale and payment plans are available for those in genuine need—email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> to inquire. Pricing does not imply clinical guarantees; sessions are educational and supportive.</p>\\n\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <strong>Reserve a spot</strong>\\n          <p class=\\\"note\\\">Spaces are limited to keep gatherings intimate. Each ticket includes concise takeaways and a follow-up check-in.</p>\\n          <form style=\\\"margin-top:12px\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\">\\n            <select name=\\\"event\\\" aria-label=\\\"Choose event\\\">\\n              <option>Intro Workshop — next date</option>\\n              <option>Foundations Series — cohort A</option>\\n              <option>Weekend Retreat — seeds</option>\\n            </select>\\n            <div style=\\\"display:flex;gap:8px;margin-top:10px\\\">\\n              <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Email\\\" required style=\\\"flex:1\\\"/>\\n              <button class=\\\"btn\\\" type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n            </div>\\n          </form>\\n        </div>\\n\\n        <div style=\\\"height:14px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <strong>Small-group care</strong>\\n          <p class=\\\"note\\\">If you prefer one-on-one work after a workshop, ask about private sessions and optional educational labs.</p>\\n        </div>\\n      </aside>\\n    </div>\\n  </header>\\n\\n  <section id=\\\"social_proof\\\">\\n    <h2 style=\\\"color:var(--accent)\\\">Voices from gatherings</h2>\\n    <div class=\\\"social\\\" style=\\\"margin-top:12px\\\">\\n      <div class=\\\"testimonial card\\\">\\n        \\\"A calm, practical workshop — I left with tools I actually used. The follow-up notes helped too.\\\"<div style=\\\"margin-top:8px;font-size:13px;color:var(--muted)\\\">— Participant, Foundations Series</div>\\n      </div>\\n      <div class=\\\"testimonial card\\\">\\n        \\\"Gentle pacing and clear explanations. Felt held in a small group setting.\\\"<div style=\\\"margin-top:8px;font-size:13px;color:var(--muted)\\\">— Retreat attendee</div>\\n      </div>\\n    </div>\\n  </section>\\n\\n  <section id=\\\"benefits\\\">\\n    <h3>What participants notice</h3>\\n    <ul class=\\\"benefits\\\" style=\\\"margin-top:12px\\\">\\n      <li>Practical routines to ease daily stress</li>\\n      <li>Clear, evidence-minded education about self-care</li>\\n      <li>Community and shared learning</li>\\n      <li>Tools for more restful evenings</li>\\n      <li>Guidance for gentle digestion support</li>\\n      <li>Strategies to sustain steady energy</li>\\n    </ul>\\n  </section>\\n\\n  <section id=\\\"process\\\">\\n    <h3>How registration and support work</h3>\\n    <div class=\\\"process-steps\\\" style=\\\"margin-top:12px\\\">\\n      <div class=\\\"step\\\">\\n        <strong>1. Register</strong>\\n        <div class=\\\"note\\\">Choose your event, share a few notes, and save your place.</div>\\n      </div>\\n      <div class=\\\"step\\\">\\n        <strong>2. Participate</strong>\\n        <div class=\\\"note\\\">Attend the session; materials are shared after each gathering.</div>\\n      </div>\\n      <div class=\\\"step\\\">\\n        <strong>3. Reflect</strong>\\n        <div class=\\\"note\\\">A brief check-in helps integrate what you learned — optional and included.</div>\\n      </div>\\n    </div>\\n  </section>\\n\\n  <section id=\\\"faq\\\">\\n    <h3>Common questions</h3>\\n    <div class=\\\"faq\\\" style=\\\"margin-top:12px\\\">\\n      <div class=\\\"q\\\">\\n        <strong>Do workshops replace medical care?</strong>\\n        <p class=\\\"note\\\">No. Sessions are educational and supportive. For medical advice or urgent concerns please consult your clinician.</p>\\n      </div>\\n      <div class=\\\"q\\\">\\n        <strong>Is there a refund policy?</strong>\\n        <p class=\\\"note\\\">Refunds are handled case-by-case; contact <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> as soon as possible.</p>\\n      </div>\\n      <div class=\\\"q\\\">\\n        <strong>Are labs included?</strong>\\n        <p class=\\\"note\\\">Optional educational lab suggestions may be shared; any testing is arranged separately and discussed as part of follow-up care.</p>\\n      </div>\\n    </div>\\n  </section>\\n\\n  <section id=\\\"lead_magnet\\\">\\n    <div class=\\\"card\\\" style=\\\"max-width:720px;margin:0 auto;text-align:center\\\">\\n      <h3>Free guide: Gentle resets for busy lives</h3>\\n      <p class=\\\"note\\\">A succinct PDF with simple practices you can use after any session. Sign up to receive the guide and occasional event invitations.</p>\\n      <form class=\\\"leadmag\\\" action=\\\"/subscribe\\\" method=\\\"post\\\">\\n        <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Your email\\\" required />\\n        <button class=\\\"btn\\\" type=\\\"submit\\\">Send me the guide</button>\\n      </form>\\n    </div>\\n  </section>\\n\\n  <footer class=\\\"cta\\\">\\n    <div class=\\\"cta-wrap\\\">\\n      <div>\\n        <div style=\\\"font-weight:700;color:var(--accent)\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"note\\\">Events are offered with care in {{CITY}}, {{STATE}} • Questions: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"book.html\\\">Book a space</a>\\n      </div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff8f2;--accent:#6b4a36;--muted:#7e6450}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, Roboto, 'Helvetica Neue', Arial;background:linear-gradient(180deg,var(--bg),#fbf6ef);color:#2d2a27}\\n    header{padding:28px 24px;display:flex;align-items:center;gap:18px}\\n    .logo{font-weight:800;color:var(--accent)}\\n    nav{margin-left:auto}\\n    a.nav{color:var(--muted);text-decoration:none;margin-left:14px}\\n    .wrap{max-width:960px;margin:24px auto;padding:0 24px}\\n    .hero{background:linear-gradient(180deg,#fff,#f9f4ef);padding:18px;border-radius:12px;display:flex;gap:18px;align-items:center}\\n    .portrait{width:96px;height:96px;border-radius:12px;background:linear-gradient(180deg,#e8d6c8,#dac1a8);display:flex;align-items:center;justify-content:center;color:#6b4a36;font-weight:700}\\n    h1{margin:0;color:var(--accent)}\\n    p.lead{margin:8px 0;color:var(--muted)}\\n    .twocol{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    .card{background:#fff;padding:14px;border-radius:10px;box-shadow:0 6px 20px rgba(36,28,20,0.06)}\\n    .meta{font-size:13px;color:var(--muted)}\\n    .pattern{position:absolute;left:-120px;bottom:-120px;width:420px;height:420px;opacity:0.12}\\n    .bio p{line-height:1.45}\\n    .leadmag form{display:flex;gap:8px;margin-top:12px}\\n    input{flex:1;padding:10px;border-radius:8px;border:1px solid #e8dfd6}\\n    button{background:var(--accent);color:white;border:0;padding:10px 12px;border-radius:8px}\\n    @media(max-width:880px){.twocol{grid-template-columns:1fr}.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g2\\\"><stop offset=\\\"0\\\" stop-color=\\\"#f2e2d3\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#e7cdb6\\\"/></linearGradient>\\n    </defs>\\n    <rect width=\\\"200\\\" height=\\\"200\\\" rx=\\\"24\\\" fill=\\\"url(#g2)\\\"/>\\n    <g fill=\\\"#6b4a36\\\" fill-opacity=\\\"0.06\\\">\\n      <rect x=\\\"10\\\" y=\\\"30\\\" width=\\\"80\\\" height=\\\"80\\\" rx=\\\"12\\\"/>\\n      <circle cx=\\\"150\\\" cy=\\\"150\\\" r=\\\"36\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a class=\\\"nav\\\" href=\\\"index.html\\\">Home</a>\\n      <a class=\\\"nav\\\" href=\\\"services.html\\\">Services</a>\\n      <a class=\\\"nav\\\" href=\\\"approach.html\\\">Approach</a>\\n      <a class=\\\"nav\\\" href=\\\"pricing.html\\\">Fees</a>\\n      <a class=\\\"nav\\\" href=\\\"book.html\\\">Schedule</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"portrait\\\">{{PRACTITIONER_NAME}}</div>\\n      <div>\\n        <h1>There is room for the whole story</h1>\\n        <p class=\\\"lead\\\">{{BUSINESS_NAME}} blends gentle clinical insight with practical, everyday practices. We honor context—work, sleep, food, and relationships—when supporting renewal.</p>\\n        <div class=\\\"meta\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}} • Serving {{CITY}}, {{STATE}}</div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"twocol\\\">\\n      <div>\\n        <div class=\\\"card bio\\\">\\n          <h3 style=\\\"color:var(--accent)\\\">Practitioner background</h3>\\n          <p>I train the ear to listen to patterns rather than single symptoms. My approach is integrative: education, movement, nutrition basics, and trauma-aware care where relevant. I collaborate with your primary providers when appropriate.</p>\\n          <p>Workshops and series are crafted to teach sustainable shifts—bite-sized practices, clear rationales, and measurable ways to notice change. This is not a promise of cure, but a practical companion on the path toward better regulation.</p>\\n        </div>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h4>Values</h4>\\n          <ul class=\\\"meta\\\">\\n            <li>Humility: no quick fixes, just steady work</li>\\n            <li>Practicality: tools you can use tomorrow</li>\\n            <li>Community: learning with others creates momentum</li>\\n          </ul>\\n        </div>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h4>Education & training</h4>\\n          <p class=\\\"meta\\\">I draw on integrative medicine principles, somatic practices, and evidence-minded nutrition. Optional educational labs may be discussed as part of individualized follow-ups.</p>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4>Social proof</h4>\\n          <p class=\\\"meta\\\">\\\"Clear teaching and gentle practices — I felt like I could bring the tools into my day.\\\" — Workshop attendee</p>\\n        </div>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h4>Request a conversation</h4>\\n          <p class=\\\"meta\\\">If you're unsure which gathering fits, schedule a brief consult to see how the series format could support you.</p>\\n          <a style=\\\"display:inline-block;margin-top:10px;padding:10px 12px;background:var(--accent);color:#fff;border-radius:8px;text-decoration:none\\\" href=\\\"book.html\\\">Start here</a>\\n        </div>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h4>Subscribe</h4>\\n          <p class=\\\"meta\\\">Monthly notes about upcoming series and occasional educational resources.</p>\\n          <form class=\\\"leadmag\\\" action=\\\"/subscribe\\\" method=\\\"post\\\">\\n            <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Email\\\" required />\\n            <button type=\\\"submit\\\">Join</button>\\n          </form>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>FAQ</h3>\\n      <div style=\\\"display:grid;gap:8px;margin-top:8px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Will the workshops diagnose conditions?</strong>\\n          <p class=\\\"meta\\\">No. Workshops provide education and self-care strategies. For a clinical diagnosis or urgent concerns please see your medical provider.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Are private sessions available?</strong>\\n          <p class=\\\"meta\\\">Yes—after workshops many participants choose private follow-ups. Reach out to discuss options.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"card\\\">\\n        <h4>Contact</h4>\\n        <p class=\\\"meta\\\">For scheduling and questions: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • Phone: {{PHONE}}</p>\\n        <p class=\\\"meta\\\">We hold community events in {{CITY}}, {{STATE}}. Please reply to an event listing for specific locations.</p>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer style=\\\"padding:18px;text-align:center;color:var(--muted)\\\">\\n    <small>All programming is educational. {{BUSINESS_NAME}} does not provide guaranteed cures. Learn more or book: <a href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a></small>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f8f4ef;--accent:#5a3b2d;--muted:#7a6353}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, Roboto, 'Helvetica Neue', Arial;background:linear-gradient(180deg,var(--bg),#fff);color:#2b2724}\\n    header{display:flex;align-items:center;gap:16px;padding:20px}\\n    .brand{font-weight:800;color:var(--accent)}\\n    nav{margin-left:auto}\\n    nav a{margin-left:10px;color:var(--muted);text-decoration:none}\\n    main{max-width:980px;margin:20px auto;padding:0 20px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:18px}\\n    .card{background:#fff;padding:16px;border-radius:12px;box-shadow:0 8px 28px rgba(31,23,18,0.06)}\\n    h1{margin:0;color:var(--accent)}\\n    .cal{height:340px;border-radius:8px;background:linear-gradient(180deg,#fbf7f3,#fff)}\\n    label{display:block;font-weight:600;margin-top:10px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #eee;margin-top:6px}\\n    .btn{background:var(--accent);color:#fff;padding:10px 12px;border-radius:8px;border:0;margin-top:12px}\\n    .steps{display:flex;gap:10px;justify-content:space-between;margin-top:12px}\\n    .step{flex:1;background:linear-gradient(180deg,#fff,#faf6f3);padding:10px;border-radius:8px;text-align:center}\\n    .small{font-size:13px;color:var(--muted)}\\n    .pattern{position:fixed;left:6%;top:10%;width:360px;height:360px;opacity:0.08}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g3\\\"><stop offset=\\\"0\\\" stop-color=\\\"#ffeedd\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#e6c9b0\\\"/></linearGradient>\\n    </defs>\\n    <rect width=\\\"200\\\" height=\\\"200\\\" rx=\\\"24\\\" fill=\\\"url(#g3)\\\"/>\\n    <g fill=\\\"#5a3b2d\\\" fill-opacity=\\\"0.06\\\">\\n      <path d=\\\"M20 140c30-40 80-40 120 0v20H20z\\\"/>\\n      <circle cx=\\\"140\\\" cy=\\\"50\\\" r=\\\"28\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Welcome</a>\\n      <a href=\\\"services.html\\\">Programs</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n      <a href=\\\"contact.html\\\">Reach</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"grid\\\">\\n      <div>\\n        <div class=\\\"card\\\">\\n          <h1>Reserve your place</h1>\\n          <p class=\\\"small\\\">Select an event and tell us a little about what brings you. This helps shape the session focus. We do not offer medical guarantees—workshops are educational.</p>\\n\\n          <form action=\\\"/reserve\\\" method=\\\"post\\\" style=\\\"margin-top:12px\\\">\\n            <label for=\\\"event\\\">Choose an event</label>\\n            <select id=\\\"event\\\" name=\\\"event\\\">\\n              <option value=\\\"intro\\\">Intro Workshop — 2.5 hours</option>\\n              <option value=\\\"series\\\">Foundations Series — 4 sessions</option>\\n              <option value=\\\"retreat\\\">Weekend Retreat</option>\\n            </select>\\n\\n            <label for=\\\"name\\\">Your name</label>\\n            <input id=\\\"name\\\" name=\\\"name\\\" required />\\n\\n            <label for=\\\"email\\\">Email</label>\\n            <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required />\\n\\n            <label for=\\\"notes\\\">Brief notes (what you'd like to learn)</label>\\n            <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"e.g., better sleep, less tension, digestive clarity\\\"></textarea>\\n\\n            <div style=\\\"display:flex;gap:8px\\\">\\n              <label style=\\\"flex:1\\\">\\n                <input type=\\\"checkbox\\\" name=\\\"followup\\\" /> I may want a brief follow-up conversation\\n              </label>\\n            </div>\\n\\n            <button class=\\\"btn\\\" type=\\\"submit\\\">Book — {{PRIMARY_CTA_LABEL}}</button>\\n          </form>\\n\\n          <div class=\\\"steps\\\">\\n            <div class=\\\"step\\\">\\n              <strong>Confirmation</strong>\\n              <div class=\\\"small\\\">You receive an email with event details and pre-session notes.</div>\\n            </div>\\n            <div class=\\\"step\\\">\\n              <strong>Attend</strong>\\n              <div class=\\\"small\\\">Participate in the group session and gather practical tools.</div>\\n            </div>\\n            <div class=\\\"step\\\">\\n              <strong>Follow-up</strong>\\n              <div class=\\\"small\\\">Optional check-in offered after the series or workshop.</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h4>Policies & notes</h4>\\n          <p class=\\\"small\\\">If you need to cancel, please contact us at least 7 days before the event for a refund or credit. Sliding scale options are considered on request. Workshops are educational and not a substitute for medical care.</p>\\n        </div>\\n\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card cal\\\">\\n          <h4 style=\\\"margin-top:0\\\">Upcoming dates</h4>\\n          <ul style=\\\"margin-top:10px;color:var(--muted)\\\">\\n            <li>Intro Workshop — Sat, March 6</li>\\n            <li>Foundations Series starts — Apr 2</li>\\n            <li>Weekend Retreat — June 12–13</li>\\n          </ul>\\n          <p class=\\\"small\\\" style=\\\"margin-top:10px\\\">Exact location shared with registrants. Reach out to ask about travel assistance or accessibility needs.</p>\\n        </div>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h4>Need guidance?</h4>\\n          <p class=\\\"small\\\">If you are unsure which option fits, request a short consult. Topics commonly addressed in workshops: stress regulation, sleep practices, digestion-friendly rhythms, inflammation education, and steady energy.</p>\\n          <a class=\\\"btn\\\" href=\\\"contact.html\\\" style=\\\"display:inline-block;margin-top:10px\\\">Ask a question</a>\\n        </div>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h4>Privacy</h4>\\n          <p class=\\\"small\\\">Information you share is used only to tailor sessions and will not be shared without consent. For clinical care, separate informed consent and privacy arrangements apply.</p>\\n        </div>\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <footer style=\\\"padding:18px;text-align:center;color:var(--muted)\\\">\\n    <div>{{BUSINESS_NAME}} • Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • Phone: {{PHONE}}</div>\\n    <small style=\\\"display:block;margin-top:8px\\\">Workshops are educational; not medical treatment. For urgent medical matters please consult your clinician.</small>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
