          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Programs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfbfa;--card:#ffffff;--accent:#7b5cf6;--muted:#6b7280;--glass:rgba(255,255,255,0.6);--shadow:0 6px 24px rgba(18,18,18,0.08)}\\n    *{box-sizing:border-box}\\n    body{font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; margin:0;background:linear-gradient(180deg,var(--bg),#fff);color:#0f1724;line-height:1.45}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 36px;background:linear-gradient(90deg,rgba(123,92,246,0.06),transparent)}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#ff7ab6);display:grid;place-items:center;color:white;font-weight:700}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-weight:600}\\n    nav a:hover{color:#111827}\\n    .hero{padding:56px 36px;background-image:url('assets/img/pattern.svg');background-repeat:repeat;display:grid;grid-template-columns:1fr 420px;gap:32px}\\n    .hero .lead{background:var(--card);padding:28px;border-radius:14px;box-shadow:var(--shadow)}\\n    h1{margin:0 0 8px 0;font-size:28px}\\n    p.lead-copy{color:var(--muted);margin:0 0 18px}\\n    .hero .cta{display:flex;gap:12px}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .btn.secondary{background:transparent;border:1px solid #e6e6ef;color:var(--accent)}\\n    .grid{display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));margin-top:20px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:var(--shadow)}\\n    .pill{display:inline-block;padding:6px 10px;background:rgba(123,92,246,0.08);color:var(--accent);border-radius:999px;font-weight:700;font-size:13px}\\n    .muted{color:var(--muted)}\\n    .price-framing{background:linear-gradient(180deg,#fff,#fbf7ff);padding:12px;border-radius:10px;border:1px dashed rgba(123,92,246,0.12)}\\n    /* Proof gallery */\\n    .proof{display:flex;gap:18px;align-items:center}\\n    .testimonials{flex:1}\\n    .testimonial{background:linear-gradient(180deg,rgba(123,92,246,0.03),transparent);padding:18px;border-radius:10px;min-height:96px}\\n    .cred-badges{display:flex;gap:12px;align-items:center}\\n    .badge{padding:8px 10px;border-radius:8px;background:#fff;border:1px solid #eef2ff;font-size:13px;position:relative;cursor:default}\\n    .badge:hover .tip{opacity:1;transform:translateY(0)}\\n    .tip{position:absolute;left:50%;transform:translateX(-50%) translateY(6px);bottom:calc(100% + 8px);background:#111827;color:white;padding:8px 10px;border-radius:8px;font-size:12px;white-space:nowrap;opacity:0;transition:all .18s ease}\\n    /* roadmap planner */\\n    .roadmap{display:flex;gap:14px;align-items:flex-start}\\n    .phase{background:linear-gradient(180deg,#fff,#fff7f8);padding:14px;border-radius:12px;border:1px solid rgba(0,0,0,0.04);flex:1}\\n    .phase h4{margin:0 0 6px}\\n    .disclaimer{font-size:13px;color:#6b7280;margin-top:10px}\\n    /* timeline interactive */\\n    .timeline{display:flex;gap:8px;align-items:center;margin-top:10px}\\n    .step{width:34px;height:34px;border-radius:999px;background:#eef2ff;color:var(--accent);display:grid;place-items:center;font-weight:700;cursor:pointer;border:2px solid transparent}\\n    .step.active{background:var(--accent);color:white}\\n    .timeline-info{padding:12px;background:#fff;border-radius:10px;border:1px solid #f0f4ff;margin-top:12px}\\n    footer{padding:28px 36px;color:var(--muted);font-size:14px}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.hero .lead{order:2}.hero .aside{order:1}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">A modern, humane approach to long-haul wellbeing</div>\\n      </div>\\n    </div>\\n    <nav aria-label=\\\"Main navigation\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Programs</a>\\n      <a href=\\\"conditions.html\\\">Ailments</a>\\n      <a href=\\\"approach.html\\\">Method</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"about.html\\\">Team</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Reach</a>\\n    </nav>\\n  </header>\\n\\n  <section class=\\\"hero\\\">\\n    <div class=\\\"lead\\\">\\n      <span class=\\\"pill\\\">Cohort format · limited seats</span>\\n      <h1>Small-group programs that teach you to steward your own health</h1>\\n      <p class=\\\"lead-copy\\\">Join a guided cycle that blends evidence-informed strategies with everyday practicality. We meet in cohorts so you get learning, lived practice, and community accountability.</p>\\n      <div class=\\\"cta\\\">\\n        <a class=\\\"btn\\\" href=\\\"book.html\\\">Join a cohort</a>\\n        <a class=\\\"btn secondary\\\" href=\\\"contact.html\\\">Ask about dates</a>\\n      </div>\\n\\n      <div style=\\\"margin-top:18px\\\" class=\\\"grid\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Seasonal Cycle</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">8 weeks of live small-group classes + weekly action plans</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Deep Reset Mini</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">4-week focused module: sleep, gut, stress rescripting</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Foundations Cohort</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">12-week, structured learning with individualized check-ins</div>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:16px\\\" class=\\\"price-framing\\\">\\n        Enrollment framed as two options: self-supported access or cohort-supported guidance. Payment plans available for cohort seats; scholarships offered each term.\\n      </div>\\n    </div>\\n\\n    <aside class=\\\"aside card\\\">\\n      <h3 style=\\\"margin-top:0\\\">Quick orientation</h3>\\n      <p class=\\\"muted\\\">Programs emphasize skill-building and sustainable routines rather than quick fixes. Participation includes recordings, worksheets, and community circles.</p>\\n      <div style=\\\"margin-top:12px\\\" class=\\\"muted\\\">Questions? Call <strong>{{PHONE}}</strong> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </aside>\\n  </section>\\n\\n  <main style=\\\"padding:36px\\\">\\n    <section aria-labelledby=\\\"proof-title\\\" class=\\\"card\\\" style=\\\"margin-bottom:22px\\\">\\n      <h3 id=\\\"proof-title\\\">Proof & credibility</h3>\\n      <p class=\\\"muted\\\">Short rotating stories from people who completed a cohort, plus credentials that explain why our method is trusted.</p>\\n      <div class=\\\"proof\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"testimonials\\\">\\n          <div class=\\\"testimonial\\\" id=\\\"testimonial\\\">\\\"I left with a toolbox — and a crew who kept me on track through month three.\\\" — A participant</div>\\n          <div style=\\\"display:flex;gap:8px;margin-top:10px\\\">\\n            <button class=\\\"btn\\\" id=\\\"prev\\\">Previous</button>\\n            <button class=\\\"btn\\\" id=\\\"next\\\">Next</button>\\n          </div>\\n        </div>\\n        <div style=\\\"width:220px\\\" class=\\\"card\\\">\\n          <strong style=\\\"display:block\\\">Credentials</strong>\\n          <div class=\\\"cred-badges\\\" style=\\\"margin-top:10px\\\">\\n            <div class=\\\"badge\\\" tabindex=\\\"0\\\">MD\\n              <div class=\\\"tip\\\">Collaborative MDs on our advisory board</div>\\n            </div>\\n            <div class=\\\"badge\\\" tabindex=\\\"0\\\">NTP\\n              <div class=\\\"tip\\\">Nutrition therapists contribute curriculum</div>\\n            </div>\\n            <div class=\\\"badge\\\" tabindex=\\\"0\\\">RCTs\\n              <div class=\\\"tip\\\">Modules reference peer-reviewed trials</div>\\n            </div>\\n          </div>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:10px\\\">We use reputable sources, but programs are educational and not medical treatment. See terms for scope.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\">\\n      <h3>Roadmap planner — sketch your first 12 weeks</h3>\\n      <p class=\\\"muted\\\">Click a phase to explore typical milestones. This is a planning tool for education and habit design, not a medical schedule.</p>\\n\\n      <div class=\\\"roadmap\\\">\\n        <div class=\\\"phase\\\">\\n          <h4>Phase 1 — Stabilize</h4>\\n          <p class=\\\"muted\\\">Emphasis on rhythm: sleep, gentle movement, nutrition anchors. Small wins that reduce volatility.</p>\\n          <ul style=\\\"margin:10px 0 0 18px;color:var(--muted)\\\"><li>Establish nightly routine</li><li>Baseline labs & tracking</li></ul>\\n        </div>\\n        <div class=\\\"phase\\\">\\n          <h4>Phase 2 — Rebuild</h4>\\n          <p class=\\\"muted\\\">Introduce graded interventions: behaviour scaffolds, coach-backed experiments, community labs.</p>\\n          <ul style=\\\"margin:10px 0 0 18px;color:var(--muted)\\\"><li>Targeted nutrition shift</li><li>Stress resiliency micro-practices</li></ul>\\n        </div>\\n        <div class=\\\"phase\\\">\\n          <h4>Phase 3 — Sustain</h4>\\n          <p class=\\\"muted\\\">Integration and relapse planning: realistic guardrails and long-term maintenance strategies.</p>\\n          <ul style=\\\"margin:10px 0 0 18px;color:var(--muted)\\\"><li>Ritualize key habits</li><li>Peer accountability plan</li></ul>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:12px\\\">\\n        <div class=\\\"timeline\\\" role=\\\"tablist\\\" aria-label=\\\"Planner phases\\\">\\n          <div class=\\\"step active\\\" data-phase=\\\"1\\\" role=\\\"tab\\\" aria-selected=\\\"true\\\">1</div>\\n          <div class=\\\"step\\\" data-phase=\\\"2\\\" role=\\\"tab\\\">2</div>\\n          <div class=\\\"step\\\" data-phase=\\\"3\\\" role=\\\"tab\\\">3</div>\\n        </div>\\n        <div class=\\\"timeline-info\\\" id=\\\"phase-info\\\">Phase 1: Focus on predictable schedules and baseline metrics. This planner is educational and not a substitute for individualized medical advice.</div>\\n      </div>\\n\\n      <p class=\\\"disclaimer\\\">Disclaimer: These roadmaps are educational. If you have a medical condition, talk to your care team before changing treatments. Our cohorts are not a replacement for individualized medical care.</p>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h3>How to enroll</h3>\\n      <p class=\\\"muted\\\">We run cohorts seasonally. Seats are reserved on a first-come basis with a deposit; payment plans available. Prefer an alternative schedule? Ask about private group rates.</p>\\n      <div style=\\\"margin-top:12px\\\">\\n        <a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve a seat</a>\\n        <a class=\\\"btn secondary\\\" href=\\\"contact.html\\\">Request cohort guide</a>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap\\\">\\n      <div>&copy; <strong>{{BUSINESS_NAME}}</strong> — Serving {{CITY}}, {{STATE}} · <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div class=\\\"muted\\\">Phone: {{PHONE}}</div>\\n    </div>\\n  </footer>\\n\\n  <script>\\n    // Proof gallery data\\n    (function(){\\n      const quotes = [\\n        '\\\"I left with a toolbox — and a crew who kept me on track through month three.\\\" — Participant',\\n        '\\\"Concrete strategies, explained with a touch of humor. I still use the sleep checklist.\\\" — Participant',\\n        '\\\"The cohort pacing made habit change feel doable; coach feedback mattered.\\\" — Participant'\\n      ];\\n      let idx = 0;\\n      const el = document.getElementById('testimonial');\\n      const prev = document.getElementById('prev');\\n      const next = document.getElementById('next');\\n      function show(i){ idx = (i + quotes.length) % quotes.length; el.textContent = quotes[idx]; }\\n      prev.addEventListener('click', ()=> show(idx-1));\\n      next.addEventListener('click', ()=> show(idx+1));\\n      // automatic rotate\\n      setInterval(()=> show(idx+1), 8000);\\n    })();\\n\\n    // Timeline planner interactions\\n    (function(){\\n      const steps = document.querySelectorAll('.step');\\n      const info = document.getElementById('phase-info');\\n      const texts = {\\n        1: 'Phase 1: Focus on predictable schedules and baseline metrics. Start with gentle, consistent steps and simple tracking.',\\n        2: 'Phase 2: Introduce focused experiments and coach-supported adjustments. Maintain safety checks and small increments.',\\n        3: 'Phase 3: Consolidate gains with routines and relapse plans. Prioritize long-term feasibility over perfection.'\\n      };\\n      steps.forEach(s => s.addEventListener('click', () => {\\n        steps.forEach(x=>{x.classList.remove('active');x.setAttribute('aria-selected','false')});\\n        s.classList.add('active'); s.setAttribute('aria-selected','true');\\n        const p = s.getAttribute('data-phase');\\n        info.textContent = texts[p] + ' (This planner is educational and not medical advice.)';\\n      }));\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Conditions & guidance — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--card:#ffffff;--accent:#06b6d4;--muted:#6b7280}\\n    body{font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto; margin:0;background:var(--bg);color:#0b1220}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 30px;background:linear-gradient(90deg,rgba(6,182,212,0.06),transparent)}\\n    .logo{width:44px;height:44px;border-radius:8px;background:linear-gradient(135deg,#06b6d4,#7c3aed);display:grid;place-items:center;color:white;font-weight:800}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-weight:600}\\n    main{padding:28px}\\n    .hero{background:#ffffff;padding:22px;border-radius:12px;box-shadow:0 6px 18px rgba(10,10,10,0.04)}\\n    h1{margin:0 0 6px}\\n    .muted{color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:18px}\\n    .condition-list{display:grid;gap:12px}\\n    .condition{padding:12px;border-radius:10px;border:1px solid #f2f6f8;background:linear-gradient(180deg,#fff,#fbffff)}\\n    .learn-more{background:transparent;border:none;color:var(--accent);cursor:pointer;font-weight:700}\\n    .support{padding:14px;background:#fff;border-radius:10px;border:1px solid #eef9fb}\\n    .resources{margin-top:12px;font-size:14px}\\n    .faq{margin-top:14px}\\n    .disclaimer{background:#fffbe6;padding:12px;border-radius:10px;border:1px solid #fff2cc;margin-top:12px}\\n    .proof{margin-top:18px;padding:12px;border-radius:10px;border:1px solid #f1f5f9}\\n    .badge{display:inline-block;padding:6px 8px;border-radius:8px;background:#f8fafc;border:1px solid #e6eef2;margin-right:8px;font-size:13px}\\n    .tip{display:none}\\n    /* timeline micro-planner */\\n    .mini-timeline{display:flex;gap:8px;align-items:center;margin-top:12px}\\n    .mini-step{padding:8px;background:#f1f5f9;border-radius:8px;cursor:pointer}\\n    .mini-info{margin-top:10px;color:var(--muted)}\\n    footer{padding:18px 30px;color:var(--muted);font-size:14px}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <strong>{{BUSINESS_NAME}}</strong>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Evidence-minded education for complex symptoms</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Programs</a>\\n      <a href=\\\"conditions.html\\\">Ailments</a>\\n      <a href=\\\"approach.html\\\">Method</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"about.html\\\">Team</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Reach</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <h1>What we help people understand</h1>\\n      <p class=\\\"muted\\\">Topics below are framed as educational modules. We do not promise cures; we offer structured learning to improve daily management and resilience.</p>\\n      <div class=\\\"disclaimer\\\" role=\\\"note\\\">Important: Content is educational. If you have an active medical emergency or are under medical treatment, contact your care team. Our cohorts complement — not replace — individualized clinical care.</div>\\n    </section>\\n\\n    <div class=\\\"grid\\\">\\n      <div>\\n        <section style=\\\"margin-top:18px\\\">\\n          <h3>Conditions & educational focus</h3>\\n          <p class=\\\"muted\\\">Below are common patterns our cohorts address through skills, pacing, and community experiments.</p>\\n          <div class=\\\"condition-list\\\">\\n            <div class=\\\"condition\\\">\\n              <strong>Persistent fatigue patterns</strong>\\n              <div class=\\\"muted\\\">Focus: pacing, energy budgeting, sleep windows, and expectation setting. Not a replacement for medical evaluation.</div>\\n              <div style=\\\"margin-top:8px\\\"><button class=\\\"learn-more\\\" data-topic=\\\"fatigue\\\">See sample module</button></div>\\n            </div>\\n\\n            <div class=\\\"condition\\\">\\n              <strong>Digestive disruption</strong>\\n              <div class=\\\"muted\\\">Focus: symptom mapping, food pattern experiments, breathing techniques for gut-brain regulation. Educational only.</div>\\n              <div style=\\\"margin-top:8px\\\"><button class=\\\"learn-more\\\" data-topic=\\\"gut\\\">See sample module</button></div>\\n            </div>\\n\\n            <div class=\\\"condition\\\">\\n              <strong>Chronic stress & burnout</strong>\\n              <div class=\\\"muted\\\">Focus: small resiliency practices, boundary setting, micro-recovery strategies, and relapse planning.</div>\\n              <div style=\\\"margin-top:8px\\\"><button class=\\\"learn-more\\\" data-topic=\\\"stress\\\">See sample module</button></div>\\n            </div>\\n\\n            <div class=\\\"condition\\\">\\n              <strong>Sleep disruption</strong>\\n              <div class=\\\"muted\\\">Focus: circadian alignment, stimulus control, and sleep-supportive routines — educational and behaviorally focused.</div>\\n              <div style=\\\"margin-top:8px\\\"><button class=\\\"learn-more\\\" data-topic=\\\"sleep\\\">See sample module</button></div>\\n            </div>\\n          </div>\\n        </section>\\n\\n        <section class=\\\"support\\\" style=\\\"margin-top:18px\\\">\\n          <h4 style=\\\"margin:0\\\">Supportive resources</h4>\\n          <div class=\\\"resources\\\">\\n            <div>Guided worksheets, journaling prompts, and stepwise experiments included with enrollment.</div>\\n            <div style=\\\"margin-top:8px\\\"><a href=\\\"book.html\\\" class=\\\"btn\\\" style=\\\"background:linear-gradient(90deg,#06b6d4,#7c3aed);color:white;padding:8px 12px;border-radius:8px;text-decoration:none\\\">Start a conversation</a></div>\\n          </div>\\n        </section>\\n      </div>\\n\\n      <aside>\\n        <section class=\\\"proof\\\">\\n          <strong>Quick proof</strong>\\n          <p class=\\\"muted\\\">Short participant notes rotate below; badges explain partnerships and review signals.</p>\\n          <div style=\\\"margin-top:10px\\\">\\n            <div id=\\\"cond-testimonial\\\">\\\"The pacing took the pressure off — I could learn without burning out.\\\" — Participant</div>\\n            <div style=\\\"margin-top:10px\\\">\\n              <span class=\\\"badge\\\">Partner clinics</span>\\n              <span class=\\\"badge\\\">Peer-reviewed citations</span>\\n              <span class=\\\"badge\\\">Alumni NPS</span>\\n            </div>\\n          </div>\\n        </section>\\n\\n        <section class=\\\"card\\\" style=\\\"margin-top:12px;padding:12px;border-radius:10px;border:1px solid #eef3f7\\\">\\n          <h4 style=\\\"margin:0\\\">Mini planner</h4>\\n          <p class=\\\"muted\\\">Tap a week to see typical activities in an educational cycle.</p>\\n          <div class=\\\"mini-timeline\\\">\\n            <div class=\\\"mini-step\\\" data-week=\\\"1\\\">Week 1</div>\\n            <div class=\\\"mini-step\\\" data-week=\\\"2\\\">Week 2</div>\\n            <div class=\\\"mini-step\\\" data-week=\\\"3\\\">Week 3</div>\\n            <div class=\\\"mini-step\\\" data-week=\\\"4\\\">Week 4</div>\\n          </div>\\n          <div class=\\\"mini-info\\\" id=\\\"mini-info\\\">Select a week to preview the kinds of learning and experiments we introduce.</div>\\n        </section>\\n\\n      </aside>\\n    </div>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h3>Helpful FAQ</h3>\\n      <div class=\\\"faq\\\">\\n        <strong>Are these programs medical treatment?</strong>\\n        <p class=\\\"muted\\\">No. They are educational, skill-based cohorts. If you need diagnosis or medication management, please speak with your healthcare provider.</p>\\n\\n        <strong>Can I join if I'm on medication?</strong>\\n        <p class=\\\"muted\\\">Often yes, but coordinate changes with your prescriber. Our instructors do not provide individual medication advice.</p>\\n\\n        <strong>What if my condition is complex?</strong>\\n        <p class=\\\"muted\\\">We partner with clinical colleagues for referrals; our role is to teach behaviors, pacing, and pragmatic strategies within a learning community.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>Ready to explore?</h3>\\n      <p class=\\\"muted\\\">If a cohort sounds helpful, reserve a space or request a call. We can discuss what a safe, educational plan looks like for you.</p>\\n      <div style=\\\"margin-top:10px\\\">\\n        <a class=\\\"btn\\\" href=\\\"book.html\\\" style=\\\"background:linear-gradient(90deg,#06b6d4,#7c3aed);color:white;padding:10px 12px;border-radius:8px;text-decoration:none\\\">Reserve a seat</a>\\n        <a class=\\\"btn secondary\\\" href=\\\"contact.html\\\" style=\\\"margin-left:8px;border:1px solid #e6f7fb;color:var(--accent);background:transparent;padding:8px 10px;border-radius:8px;text-decoration:none\\\">Ask about safety</a>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"padding:18px 30px;color:var(--muted);display:flex;justify-content:space-between;flex-wrap:wrap\\\">\\n      <div>&copy; {{BUSINESS_NAME}} — {{CITY}}, {{STATE}}</div>\\n      <div>Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> · {{PHONE}}</div>\\n    </div>\\n  </footer>\\n\\n  <script>\\n    // rotating testimonial for conditions page\\n    (function(){\\n      const notes = [\\n        '\\\"The pacing took the pressure off — I could learn without burning out.\\\" — Alumnus',\\n        '\\\"Small experiments, measurable wins — I felt safer trying changes.\\\" — Alumnus',\\n        '\\\"I appreciated the plain language and the emphasis on feasibility.\\\" — Alumnus'\\n      ];\\n      let i=0; const el=document.getElementById('cond-testimonial');\\n      function rot(){ el.textContent = notes[i%notes.length]; i++; }\\n      setInterval(rot,7000);\\n    })();\\n\\n    // mini timeline interactions\\n    (function(){\\n      const steps = document.querySelectorAll('.mini-step');\\n      const info = document.getElementById('mini-info');\\n      const weekText = {\\n        1: 'Week 1: Establish baselines, simple trackers, and small routines to reduce day-to-day variability.',\\n        2: 'Week 2: Introduce one targeted experiment (nutrition, movement, or sleep tweak) with logbook entries.',\\n        3: 'Week 3: Coach-led troubleshooting and peer check-ins. Adjust experiment as needed.',\\n        4: 'Week 4: Consolidate what worked and build a maintenance plan; plan a relapse guardrail.'\\n      };\\n      steps.forEach(s=>s.addEventListener('click', ()=>{ info.textContent = weekText[s.dataset.week]; }));\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Method — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfbff;--card:#ffffff;--accent:#ef4444;--muted:#4b5563}\\n    body{font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto; margin:0;background:var(--bg);color:#051124}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:22px 30px;background:linear-gradient(90deg,rgba(239,68,68,0.04),transparent)}\\n    .logo{width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,#ef4444,#f97316);display:grid;place-items:center;color:white;font-weight:800}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .hero{padding:28px 30px;display:flex;gap:18px}\\n    .hero .left{flex:2}\\n    .hero .right{flex:1}\\n    h1{margin:0 0 6px}\\n    .muted{color:var(--muted)}\\n    .pillars{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-top:18px}\\n    .pillar{background:var(--card);padding:14px;border-radius:10px;border:1px solid rgba(0,0,0,0.04)}\\n    .timeline{margin-top:14px;padding:12px;background:#fff;border-radius:10px;border:1px solid #fff0f0}\\n    .cta{margin-top:12px}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .proof{margin-top:16px;display:flex;gap:12px;align-items:center}\\n    .cred{display:flex;gap:8px}\\n    .cred .badge{padding:6px 8px;background:#fff;border-radius:8px;border:1px solid #ffecec;font-size:13px}\\n    .tooltip{position:absolute;background:#111827;color:white;padding:8px;border-radius:8px;font-size:13px;white-space:nowrap}\\n    footer{padding:18px 30px;color:var(--muted)}\\n    @media(max-width:900px){.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <strong>{{BUSINESS_NAME}}</strong>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">A humane approach to learning health</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Programs</a>\\n      <a href=\\\"conditions.html\\\">Ailments</a>\\n      <a href=\\\"approach.html\\\">Method</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"about.html\\\">Team</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Reach</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"left\\\">\\n        <h1>How we teach practical, durable change</h1>\\n        <p class=\\\"muted\\\">Our method is cohort-based instruction plus repeatable micro-experiments. We focus on learning systems you can keep using after the program ends.</p>\\n\\n        <div class=\\\"pillars\\\" aria-label=\\\"Core principles\\\">\\n          <div class=\\\"pillar\\\">\\n            <strong>Small experiments</strong>\\n            <div class=\\\"muted\\\">We test tiny changes that reveal what scales for you.</div>\\n          </div>\\n          <div class=\\\"pillar\\\">\\n            <strong>Pace & safety</strong>\\n            <div class=\\\"muted\\\">Progress is measured and reversible; checkpoints avoid overwhelm.</div>\\n          </div>\\n          <div class=\\\"pillar\\\">\\n            <strong>Community learning</strong>\\n            <div class=\\\"muted\\\">Shared case-notes and peer feedback amplify retention.</div>\\n          </div>\\n          <div class=\\\"pillar\\\">\\n            <strong>Evidence-aware</strong>\\n            <div class=\\\"muted\\\">Curriculum references studies and practical clinical guidance where relevant.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"timeline\\\" id=\\\"timeline\\\">\\n          <h4 style=\\\"margin:0 0 8px 0\\\">Phase planner — interactive</h4>\\n          <p class=\\\"muted\\\">Select a phase to reveal typical practices and a cautionary note.</p>\\n          <div style=\\\"display:flex;gap:8px\\\">\\n            <button class=\\\"btn-phase\\\" data-phase=\\\"learn\\\">Learn</button>\\n            <button class=\\\"btn-phase\\\" data-phase=\\\"apply\\\">Apply</button>\\n            <button class=\\\"btn-phase\\\" data-phase=\\\"sustain\\\">Sustain</button>\\n          </div>\\n          <div id=\\\"phase-detail\\\" style=\\\"margin-top:10px;color:var(--muted)\\\">Choose a phase to preview activities.</div>\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"right\\\">\\n        <div class=\\\"card\\\" style=\\\"background:#fff;padding:16px;border-radius:10px;border:1px solid #fff0f0\\\">\\n          <strong>Quick enroll</strong>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Cohort seats come with group workshops, worksheets, and two live 1:1 check-ins per seat.</p>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Claim a seat</a></div>\\n        </div>\\n\\n        <div class=\\\"proof\\\" style=\\\"margin-top:12px\\\">\\n          <div>\\n            <div id=\\\"approach-testimonial\\\">\\\"The method helped me iterate without feeling judged.\\\"</div>\\n          </div>\\n          <div class=\\\"cred\\\">\\n            <div class=\\\"badge\\\" data-tip=\\\"Our team curates trial summaries\\\">Study notes</div>\\n            <div class=\\\"badge\\\" data-tip=\\\"Clinicians help with triage and referrals\\\">Clinical link</div>\\n            <div class=\\\"badge\\\" data-tip=\\\"We ask alumni to rate the impact and share stories\\\">Alumni reviews</div>\\n          </div>\\n        </div>\\n\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"padding:18px\\\">\\n      <h3>Case notes & teaching style</h3>\\n      <p class=\\\"muted\\\">We present de-identified case examples in class to show decision-making and troubleshooting. These are educational narratives, not prescriptions.</p>\\n      <div style=\\\"margin-top:12px;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px\\\">\\n        <div style=\\\"background:#fff;padding:12px;border-radius:8px;border:1px solid #fff0f0\\\">Module: Sleep experiments — small, reversible tweaks</div>\\n        <div style=\\\"background:#fff;padding:12px;border-radius:8px;border:1px solid #fff0f0\\\">Module: Energy budgeting — pacing & activity ratio</div>\\n        <div style=\\\"background:#fff;padding:12px;border-radius:8px;border:1px solid #fff0f0\\\">Module: Gut mapping — tracking and elimination experiments</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"padding:18px\\\">\\n      <h3>FAQ & safety notes</h3>\\n      <p class=\\\"muted\\\">Programs provide behavioral and educational support. We do not provide individualized medical diagnoses or medication management within cohort sessions. If you are managing serious illness, discuss cohort participation with your clinical team first.</p>\\n    </section>\\n\\n    <section style=\\\"padding:18px\\\">\\n      <h3>Ready to try a different way?</h3>\\n      <p class=\\\"muted\\\">We accept small cohorts each term. If you'd like priority access, reserve now or request a syllabus.</p>\\n      <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve a spot</a> <a href=\\\"contact.html\\\" style=\\\"margin-left:10px;color:var(--muted);text-decoration:none\\\">Request syllabus</a></div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"padding:18px 30px;color:var(--muted);display:flex;justify-content:space-between;flex-wrap:wrap\\\">\\n      <div>&copy; {{BUSINESS_NAME}} — {{CITY}}, {{STATE}}</div>\\n      <div>Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> · {{PHONE}}</div>\\n    </div>\\n  </footer>\\n\\n  <script>\\n    // Phase planner for approach page\\n    (function(){\\n      const mapping = {\\n        learn: 'Learn: Foundational concepts and shared case notes. Focus on comprehension and low-risk experiments.',\\n        apply: 'Apply: Guided experiments with coach checkpoints. Scale only what proves feasible.',\\n        sustain: 'Sustain: Build long-term guardrails and peer accountability. Emphasize maintainability.'\\n      };\\n      document.querySelectorAll('.btn-phase').forEach(btn => btn.addEventListener('click', ()=>{\\n        document.getElementById('phase-detail').textContent = mapping[btn.dataset.phase] + ' (Educational guidance only — not individualized medical advice.)';\\n      }));\\n    })();\\n\\n    // Approach page testimonial rotate and badge tooltips\\n    (function(){\\n      const notes = ['\\\"The method helped me iterate without feeling judged.\\\"','\\\"Teaching felt practical and wise.\\\"','\\\"I learned what to test and when to pause.\\\"'];\\n      let i=0; const el=document.getElementById('approach-testimonial');\\n      setInterval(()=>{ el.textContent = notes[i%notes.length]; i++; },7000);\\n\\n      // tooltip behavior for badges\\n      const badges = document.querySelectorAll('.badge');\\n      badges.forEach(b => {\\n        b.addEventListener('mouseenter', (e)=>{\\n          const tip = document.createElement('div'); tip.className='tooltip'; tip.textContent = b.getAttribute('data-tip');\\n          document.body.appendChild(tip);\\n          const r = b.getBoundingClientRect();\\n          tip.style.left = (r.left + r.width/2 - tip.offsetWidth/2) + 'px';\\n          tip.style.top = (r.top - tip.offsetHeight - 8) + 'px';\\n          b._tip = tip;\\n        });\\n        b.addEventListener('mouseleave', ()=>{ if(b._tip){ b._tip.remove(); b._tip=null; } });\\n      });\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
