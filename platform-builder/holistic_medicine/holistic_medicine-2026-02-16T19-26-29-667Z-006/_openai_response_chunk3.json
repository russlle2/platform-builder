          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Investment & Plans</title>\\n  <style>\\n    :root{--bg1:#f6fbf9;--accent:#6d9f7a;--muted:#6b6b6b;--card:#ffffff;--accent2:#8bd3c7}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial,sans-serif;color:#123;}\\n    a{color:var(--accent);text-decoration:none}\\n    header{position:relative;overflow:hidden;padding:36px 28px 24px;background:linear-gradient(120deg,var(--bg1),#eaf7f3 60%);}\\n    header:before{content:\\\"\\\";position:absolute;right:-20%;top:-25%;width:140%;height:120%;background:linear-gradient(180deg,rgba(109,159,122,0.15),rgba(139,211,199,0.06));transform:rotate(-12deg);z-index:0}\\n    .brand{position:relative;z-index:1;display:flex;gap:18px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),var(--accent2));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav{margin-left:auto}\\n    nav a{margin:0 10px;font-size:14px;color:var(--muted)}\\n    .wrap{max-width:1100px;margin:22px auto;padding:42px 28px 120px;position:relative}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;position:relative}\\n    .hero h1{font-size:28px;margin:0 0 8px}\\n    .hero p{margin:0 0 18px;color:var(--muted)}\\n    .card{background:var(--card);box-shadow:0 10px 30px rgba(18,30,40,0.06);border-radius:14px;padding:22px}\\n    .price-list{display:flex;flex-direction:column;gap:14px}\\n    .tier{display:flex;justify-content:space-between;align-items:center;padding:14px;border-radius:10px;border:1px solid rgba(18,30,40,0.04)}\\n    .tier .meta{font-size:13px;color:var(--muted)}\\n    .tag{background:linear-gradient(90deg,var(--accent),var(--accent2));color:white;padding:8px 12px;border-radius:999px;font-weight:600}\\n    .note{font-size:13px;color:var(--muted);margin-top:10px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .feature{background:linear-gradient(180deg,rgba(139,211,199,0.08),transparent);padding:12px;border-radius:10px;font-size:14px}\\n    footer{max-width:1100px;margin:28px auto;padding:18px 28px;color:var(--muted)}\\n    /* diagonal decorative svg */\\n    .pattern{position:absolute;left:0;bottom:-60px;width:380px;height:380px;opacity:0.14;z-index:0}\\n    .cta{display:inline-block;margin-top:12px;background:var(--accent);color:#fff;padding:10px 16px;border-radius:12px}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr}.wrap{padding-bottom:80px}.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"wrap\\\">\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">HM</div>\\n        <div style=\\\"z-index:1\\\">\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n        <nav>\\n          <a href=\\\"index.html\\\">Home</a>\\n          <a href=\\\"services.html\\\">Offerings</a>\\n          <a href=\\\"conditions.html\\\">Conditions</a>\\n          <a href=\\\"approach.html\\\">How We Work</a>\\n          <a href=\\\"pricing.html\\\">Investment</a>\\n          <a href=\\\"about.html\\\">Who We Are</a>\\n          <a href=\\\"book.html\\\">Reserve</a>\\n          <a href=\\\"contact.html\\\">Connect</a>\\n        </nav>\\n      </div>\\n      <div class=\\\"hero\\\" style=\\\"margin-top:22px;\\\">\\n        <div style=\\\"position:relative;z-index:1\\\">\\n          <h1>Investment plans built for a whole-person reset — focused, guided, compassionate.</h1>\\n          <p>Intensive program options for people seeking measurable shifts in stress resilience, sleep, digestion, and energy. Education-forward; no promises, just a structured path and clear metrics.</p>\\n          <div class=\\\"card\\\">\\n            <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n              <div>\\n                <div style=\\\"font-weight:700\\\">Deep Reset Program</div>\\n                <div class=\\\"meta\\\">6 sessions over 12 weeks • bespoke lab guidance optional</div>\\n              </div>\\n              <div style=\\\"text-align:right\\\">\\n                <div class=\\\"tag\\\">Popular</div>\\n                <div style=\\\"font-weight:700;margin-top:8px\\\">$2,900</div>\\n              </div>\\n            </div>\\n            <div class=\\\"note\\\">Includes intake, individualized plan, two guided follow-ups, and a concluding review. Payment plans available.</div>\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          </div>\\n        </div>\\n        <aside style=\\\"position:relative;z-index:1\\\">\\n          <div class=\\\"card\\\">\\n            <div style=\\\"font-weight:700;margin-bottom:8px\\\">Quick Options</div>\\n            <div class=\\\"price-list\\\">\\n              <div class=\\\"tier\\\"><div><div style=\\\"font-weight:600\\\">Discovery</div><div class=\\\"meta\\\">60 min single session — exploratory</div></div><div style=\\\"text-align:right\\\"><div style=\\\"font-weight:700\\\">$180</div></div></div>\\n              <div class=\\\"tier\\\"><div><div style=\\\"font-weight:600\\\">Essentials Pack</div><div class=\\\"meta\\\">3 sessions, focused plan</div></div><div style=\\\"text-align:right\\\"><div style=\\\"font-weight:700\\\">$820</div></div></div>\\n              <div class=\\\"tier\\\"><div><div style=\\\"font-weight:600\\\">Lab Review Add-on</div><div class=\\\"meta\\\">Interpretation + recommendations</div></div><div style=\\\"text-align:right\\\"><div style=\\\"font-weight:700\\\">$160</div></div></div>\\n            </div>\\n            <div class=\\\"note\\\">Insurance coverage varies. We can provide superbills for out-of-network reimbursement.</div>\\n          </div>\\n          <div style=\\\"height:14px\\\"></div>\\n          <div class=\\\"card\\\">\\n            <div style=\\\"font-weight:700\\\">Why choose an intensive track?</div>\\n            <div style=\\\"font-size:14px;margin-top:8px;color:var(--muted)\\\">An intensive plan creates time and structure for visible changes. We'll educate you about underlying drivers and set realistic, trackable goals.</div>\\n          </div>\\n        </aside>\\n      </div>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"feature card\\\"><strong>Personalized journey</strong><div class=\\\"meta\\\">Nutrition, lifestyle, movement—and an educational roadmap.</div></div>\\n        <div class=\\\"feature card\\\"><strong>Measured outcomes</strong><div class=\\\"meta\\\">Track sleep, stress, digestion markers to see trends, not promises.</div></div>\\n        <div class=\\\"feature card\\\"><strong>Labs as tools</strong><div class=\\\"meta\\\">Optional testing when clinically useful—explained in plain language.</div></div>\\n      </div>\\n    </div>\\n    <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n      <defs>\\n        <linearGradient id=\\\"g\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#8bd3c7\\\" stop-opacity=\\\"0.8\\\" />\\n          <stop offset=\\\"1\\\" stop-color=\\\"#6d9f7a\\\" stop-opacity=\\\"0.6\\\" />\\n        </linearGradient>\\n      </defs>\\n      <path d=\\\"M0 160 Q50 120 100 160 T200 160 V200 H0z\\\" fill=\\\"url(#g)\\\" />\\n    </svg>\\n  </header>\\n  <main style=\\\"max-width:1100px;margin:18px auto;padding:0 28px;\\\">\\n    <section class=\\\"card\\\" style=\\\"margin-bottom:18px;padding:18px\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Packages at a glance</h2>\\n      <p style=\\\"margin:0 0 12px;color:var(--muted)\\\">Choose a focused plan or design something longer. Each plan includes education, lifestyle coaching, and check-ins; lab recommendations are optional and discussed collaboratively.</p>\\n      <div style=\\\"display:flex;gap:12px;flex-wrap:wrap\\\">\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:220px\\\"><strong>Discovery</strong><div class=\\\"meta\\\">Find clarity and next steps. Single 60-minute session.</div></div>\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:220px\\\"><strong>Essentials</strong><div class=\\\"meta\\\">Three visits across 6–8 weeks to start shifting habits.</div></div>\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:220px\\\"><strong>Deep Reset</strong><div class=\\\"meta\\\">A structured 12-week intensive with measured outcomes.</div></div>\\n      </div>\\n    </section>\\n    <section class=\\\"card\\\" style=\\\"margin-bottom:18px;padding:18px\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">How billing & insurance work</h3>\\n      <p class=\\\"meta\\\" style=\\\"margin:0;color:var(--muted)\\\">We accept card payment for sessions. If you'd like reimbursement, we can provide a superbill. No guarantees of reimbursement; check your benefits.</p>\\n    </section>\\n    <section class=\\\"card\\\" style=\\\"padding:18px;margin-bottom:18px\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">A note on outcomes</h3>\\n      <p style=\\\"color:var(--muted)\\\">Holistic care aims to support whole-person health through lifestyle, nutrition, and education. We never promise cures. Your engagement, context, and medical history shape results.</p>\\n    </section>\\n    <section style=\\\"text-align:center;margin:28px 0\\\">\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book an Intake with {{PRACTITIONER_NAME}}</a>\\n    </section>\\n  </main>\\n  <footer>\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap\\\">\\n      <div>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n      <div style=\\\"color:var(--muted)\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffefc;--accent:#b27fdb;--accent2:#f6c3ff;--muted:#5a5a5a}\\n    html,body{margin:0;height:100%;font-family:Inter,system-ui,Segoe UI,Roboto,Arial,sans-serif;color:#111}\\n    header{padding:28px;background:linear-gradient(145deg,#fffafc,#f8fbff);position:relative;overflow:hidden}\\n    .wrap{max-width:980px;margin:16px auto;padding:18px}\\n    .nav{display:flex;gap:12px;align-items:center}\\n    .nav a{color:var(--muted);font-size:14px}\\n    .intro{display:grid;grid-template-columns:1fr 320px;gap:22px;align-items:start;}\\n    .portrait{background:linear-gradient(180deg,var(--accent2),#fff);height:220px;border-radius:14px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    .kicker{color:var(--muted);font-size:14px}\\n    .pillars{display:flex;gap:12px;margin-top:14px}\\n    .pillar{flex:1;padding:12px;border-radius:10px;background:linear-gradient(180deg,rgba(178,127,219,0.08),transparent)}\\n    .myth{background:#fff;padding:14px;border-radius:10px;border-left:4px solid var(--accent);margin-top:18px}\\n    .case{margin-top:12px;padding:14px;background:#fff;border-radius:10px;border:1px solid rgba(0,0,0,0.04)}\\n    .cta{display:inline-block;margin-top:12px;background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px}\\n    footer{max-width:980px;margin:22px auto;padding:12px 18px;color:var(--muted)}\\n    @media(max-width:880px){.intro{grid-template-columns:1fr}.pillars{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"wrap\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <nav class=\\\"nav\\\">\\n          <a href=\\\"index.html\\\">Welcome</a>\\n          <a href=\\\"services.html\\\">Programs</a>\\n          <a href=\\\"conditions.html\\\">Concerns</a>\\n          <a href=\\\"approach.html\\\">Approach</a>\\n          <a href=\\\"pricing.html\\\">Fees</a>\\n          <a href=\\\"about.html\\\">Team</a>\\n          <a href=\\\"book.html\\\">Schedule</a>\\n          <a href=\\\"contact.html\\\">Contact</a>\\n        </nav>\\n      </div>\\n      <div class=\\\"intro\\\">\\n        <div>\\n          <div class=\\\"kicker\\\">Meet the person behind the plan</div>\\n          <h1 style=\\\"margin:6px 0\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</h1>\\n          <p style=\\\"color:var(--muted)\\\">A playful and premium take on integrative care — clinical curiosity, warm coaching, and an emphasis on education for sustainable change.</p>\\n          <div class=\\\"pillars\\\">\\n            <div class=\\\"pillar\\\"><strong>Whole-person</strong><div style=\\\"color:var(--muted);font-size:13px;margin-top:6px\\\">We look at mind, movement, food, and rhythms together.</div></div>\\n            <div class=\\\"pillar\\\"><strong>Evidence-led</strong><div style=\\\"color:var(--muted);font-size:13px;margin-top:6px\\\">We explain the science without the jargon.</div></div>\\n            <div class=\\\"pillar\\\"><strong>Compassion-first</strong><div style=\\\"color:var(--muted);font-size:13px;margin-top:6px\\\">Plans are realistic and kind to your life.</div></div>\\n          </div>\\n          <div class=\\\"myth\\\">\\n            <strong>Myth vs. Truth</strong>\\n            <div style=\\\"margin-top:8px;color:var(--muted)\\\"><em>Myth:</em> Holistic care guarantees fast cures. <br/><em>Truth:</em> We provide tools and education; progress depends on many factors including medical context and adherence.</div>\\n          </div>\\n        </div>\\n        <aside>\\n          <div class=\\\"portrait\\\">{{PRACTITIONER_NAME}}</div>\\n          <div style=\\\"margin-top:12px;background:#fff;padding:12px;border-radius:10px\\\">\\n            <div style=\\\"font-weight:700\\\">Credentials</div>\\n            <div style=\\\"color:var(--muted);margin-top:8px\\\">{{CREDENTIALS}} — training in integrative approaches, nutrition, and functional assessment.</div>\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:block;text-align:center;margin-top:10px\\\">Work with {{PRACTITIONER_NAME}}</a>\\n          </div>\\n        </aside>\\n      </div>\\n      <div class=\\\"case\\\" aria-live=\\\"polite\\\">\\n        <strong>Case notes (anonymized)</strong>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Client A: Chronic low energy and disrupted sleep. Through education, targeted habits, and selective testing, they improved sleep regularity and daytime energy. Individual results vary; these notes are illustrative, not predictive.</div>\\n      </div>\\n    </div>\\n  </header>\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"card\\\" style=\\\"padding:14px\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">What to expect from a first visit</h3>\\n      <p style=\\\"color:var(--muted)\\\">We take a thorough intake, review history and current habits, and co-create a clear set of next steps. Labs are discussed as educational options, not mandatory.</p>\\n    </section>\\n    <section class=\\\"card\\\" style=\\\"padding:14px;margin-top:12px\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Frequently asked</h3>\\n      <div style=\\\"margin-top:8px;color:var(--muted)\\\">\\n        <strong>Do you replace my primary care?</strong>\\n        <div>No. We work with your healthcare team when appropriate and always value safe medical oversight.</div>\\n        <strong style=\\\"margin-top:6px;display:block\\\">How long before I see changes?</strong>\\n        <div>Some people notice shifts in weeks; others take months. We focus on steady progress and learning.</div>\\n      </div>\\n    </section>\\n    <section style=\\\"text-align:center;margin-top:18px\\\">\\n      <a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve a Discovery Visit</a>\\n    </section>\\n  </main>\\n  <footer>\\n    <div class=\\\"wrap\\\" style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;color:var(--muted)\\\">\\n      <div>{{BUSINESS_NAME}} — Holistic & Integrative Care</div>\\n      <div>Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Schedule — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f7fbff;--accent:#ff8a8a;--muted:#505050}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial,sans-serif;color:#111}\\n    .top{background:linear-gradient(120deg,#fff,#fef7f7);padding:20px}\\n    .wrap{max-width:920px;margin:20px auto;padding:20px}\\n    .nav{display:flex;gap:12px;align-items:center;margin-bottom:12px}\\n    .nav a{color:var(--muted)}\\n    .split{display:grid;grid-template-columns:1fr 360px;gap:18px}\\n    .card{background:white;padding:16px;border-radius:12px;box-shadow:0 8px 22px rgba(16,24,40,0.04)}\\n    label{display:block;font-size:13px;margin:12px 0 6px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(0,0,0,0.06);font-size:14px}\\n    .btn{display:inline-block;background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;border:none;cursor:pointer;margin-top:12px}\\n    .policy{font-size:13px;color:var(--muted);margin-top:10px}\\n    .faq{margin-top:14px}\\n    footer{margin-top:18px;color:var(--muted)}\\n    @media(max-width:880px){.split{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"top\\\">\\n    <div class=\\\"wrap\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <nav class=\\\"nav\\\">\\n          <a href=\\\"index.html\\\">Home</a>\\n          <a href=\\\"services.html\\\">Programs</a>\\n          <a href=\\\"approach.html\\\">How We Work</a>\\n          <a href=\\\"pricing.html\\\">Pricing</a>\\n          <a href=\\\"about.html\\\">About</a>\\n          <a href=\\\"book.html\\\">Book</a>\\n          <a href=\\\"contact.html\\\">Contact</a>\\n        </nav>\\n      </div>\\n    </div>\\n  </div>\\n  <main class=\\\"wrap\\\">\\n    <div class=\\\"split\\\">\\n      <section class=\\\"card\\\">\\n        <h1 style=\\\"margin:0 0 6px\\\">Book your visit</h1>\\n        <p style=\\\"margin:0 0 12px;color:var(--muted)\\\">Start with a Discovery session or choose an intensive track. Sessions are educational and collaborative—no guaranteed cures.</p>\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\">\\n          <label for=\\\"type\\\">Appointment type</label>\\n          <select id=\\\"type\\\" name=\\\"type\\\">\\n            <option>Discovery — 60 min</option>\\n            <option>Essentials Pack — 3 sessions</option>\\n            <option>Deep Reset — 6 sessions</option>\\n            <option>Lab Review — 30 min</option>\\n          </select>\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"Your name\\\" required />\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required />\\n          <label for=\\\"phone\\\">Phone</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"{{PHONE}}\\\" />\\n          <label for=\\\"notes\\\">Brief notes (current concerns)</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Sleep, stress, digestion, energy—share what matters most\\\"></textarea>\\n          <label for=\\\"date\\\">Preferred date</label>\\n          <input id=\\\"date\\\" name=\\\"date\\\" type=\\\"date\\\" />\\n          <div class=\\\"policy\\\">By booking you acknowledge the educational nature of sessions. We will coordinate with your healthcare team as appropriate.</div>\\n          <button class=\\\"btn\\\" type=\\\"submit\\\">Request Appointment</button>\\n        </form>\\n      </section>\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <strong>Before your first visit</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Complete the form and any intake forms we send. If you have recent labs, bring them or upload ahead of time for a faster, focused session.</div>\\n          <div class=\\\"faq\\\">\\n            <details>\\n              <summary style=\\\"cursor:pointer\\\">What if I need labs?</summary>\\n              <div style=\\\"color:var(--muted);margin-top:8px\\\">Labs are tools to inform our plan. We'll only suggest testing when it meaningfully guides recommendations.</div>\\n            </details>\\n            <details style=\\\"margin-top:8px\\\">\\n              <summary style=\\\"cursor:pointer\\\">Cancellation & rescheduling</summary>\\n              <div style=\\\"color:var(--muted);margin-top:8px\\\">Please notify us 48 hours in advance to avoid a late cancellation fee.</div>\\n            </details>\\n            <details style=\\\"margin-top:8px\\\">\\n              <summary style=\\\"cursor:pointer\\\">Insurance</summary>\\n              <div style=\\\"color:var(--muted);margin-top:8px\\\">We provide superbills; coverage for integrative services varies. We do not guarantee reimbursement.</div>\\n            </details>\\n          </div>\\n        </div>\\n        <div style=\\\"height:12px\\\"></div>\\n        <div class=\\\"card\\\">\\n          <strong>Need a quick answer?</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>. For urgent medical issues, contact your primary care or emergency services.</div>\\n        </div>\\n      </aside>\\n    </div>\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">What happens after you request</h3>\\n      <ol style=\\\"margin:0 0 8px;color:var(--muted)\\\">\\n        <li>We review your request and intake notes.</li>\\n        <li>We send scheduling options and any pre-visit forms.</li>\\n        <li>Your first session focuses on history, priorities, and an educational plan.</li>\\n      </ol>\\n      <div style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Note:</strong> We do not offer guarantees; our role is to educate and co-create change strategies tailored to you.</div>\\n    </section>\\n  </main>\\n  <footer class=\\\"wrap\\\">\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;color:var(--muted)\\\">\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n      <div>Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
