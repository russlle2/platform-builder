          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Services</title>\\n  <style>\\n    :root{--bg1:#f6fff8;--accent:#6b9c6a;--accent-dark:#2f6b4b;--muted:#6b7280;--glass:rgba(255,255,255,0.7)}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial}\\n    body{background:linear-gradient(180deg,var(--bg1),#f0faf2);color:#0b2b1f;line-height:1.5}\\n    .nav{display:flex;justify-content:space-between;align-items:center;padding:22px 28px}\\n    .brand{font-weight:700;letter-spacing:0.6px}\\n    nav a{margin:0 10px;color:var(--accent-dark);text-decoration:none;font-weight:600}\\n    header.hero{position:relative;overflow:hidden;padding:56px 28px 48px;border-bottom:1px solid rgba(47,107,75,0.06)}\\n    .hero-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:center}\\n    .kicker{display:inline-block;background:linear-gradient(90deg,rgba(107,156,106,0.12),rgba(47,107,75,0.06));padding:6px 10px;border-radius:999px;font-size:13px;color:var(--accent-dark);margin-bottom:12px}\\n    h1{font-size:34px;margin:0 0 12px}\\n    p.lead{color:var(--muted);margin:0 0 20px}\\n    .card{background:var(--glass);backdrop-filter:blur(6px);padding:20px;border-radius:14px;box-shadow:0 8px 30px rgba(35,72,50,0.05)}\\n    .service-list{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}\\n    .service{padding:14px;border-radius:10px;background:linear-gradient(180deg,#ffffff,rgba(235,252,241,0.8));border:1px solid rgba(47,107,75,0.06)}\\n    .service h4{margin:0 0 6px;font-size:16px}\\n    .service p{margin:0;color:var(--muted);font-size:14px}\\n    .cta{display:inline-block;margin-top:14px;padding:12px 18px;background:linear-gradient(90deg,var(--accent),var(--accent-dark));color:white;border-radius:10px;text-decoration:none;font-weight:700}\\n    .pattern{position:absolute;right:-180px;top:-40px;opacity:0.12;width:560px;height:560px}\\n    main{max-width:1100px;margin:28px auto;padding:0 28px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:22px}\\n    .social-proof{padding:18px;border-radius:12px;background:linear-gradient(180deg,#fff,rgba(240,250,244,0.9));border:1px solid rgba(47,107,75,0.06)}\\n    .testimonial{font-style:italic;color:#0b2b1f;padding:10px 0}\\n    .benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}\\n    .benefit{background:linear-gradient(90deg,#f9fff6,white);padding:14px;border-radius:10px;border:1px solid rgba(47,107,75,0.04)}\\n    .process{margin-top:18px}\\n    .step{display:flex;gap:12px;margin-bottom:12px}\\n    .bubble{width:44px;height:44px;border-radius:999px;background:var(--accent);color:white;display:flex;align-items:center;justify-content:center;font-weight:700}\\n    .faq{margin-top:18px}\\n    .faq details{background:white;padding:12px;border-radius:10px;border:1px solid rgba(14,30,20,0.04);margin-bottom:8px}\\n    .lead-magnet{display:flex;gap:12px;align-items:center;margin-top:16px;padding:14px;background:linear-gradient(90deg,#fff,#f3fff0);border-radius:12px;border:1px dashed rgba(107,156,106,0.14)}\\n    .lead-magnet input{padding:10px;border-radius:8px;border:1px solid rgba(14,30,20,0.06);flex:1}\\n    footer{max-width:1100px;margin:28px auto;padding:18px 28px;color:var(--muted);display:flex;justify-content:space-between;align-items:center}\\n    @media (max-width:880px){.hero-inner{grid-template-columns:1fr} .grid{grid-template-columns:1fr} .service-list{grid-template-columns:1fr} .benefits{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header class=\\\"hero\\\">\\n    <svg class=\\\"pattern\\\" viewBox=\\\"0 0 600 600\\\" preserveAspectRatio=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#dff6e6\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#bfead1\\\"/></linearGradient>\\n        <filter id=\\\"blur\\\"><feGaussianBlur stdDeviation=\\\"18\\\"/></filter>\\n      </defs>\\n      <g filter=\\\"url(#blur)\\\">\\n        <circle cx=\\\"120\\\" cy=\\\"140\\\" r=\\\"120\\\" fill=\\\"url(#g1)\\\"/>\\n        <rect x=\\\"260\\\" y=\\\"220\\\" width=\\\"220\\\" height=\\\"220\\\" rx=\\\"40\\\" fill=\\\"#e6fbef\\\"/>\\n        <circle cx=\\\"420\\\" cy=\\\"80\\\" r=\\\"80\\\" fill=\\\"#eafaf0\\\"/>\\n      </g>\\n    </svg>\\n\\n    <div class=\\\"nav\\\">\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Care</a>\\n        <a href=\\\"conditions.html\\\">Conditions</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </div>\\n\\n    <div class=\\\"hero-inner\\\">\\n      <div>\\n        <span class=\\\"kicker\\\">Whole-person programs</span>\\n        <h1>Nourish, restore, and align — personalized service paths</h1>\\n        <p class=\\\"lead\\\">We blend evidence-informed modalities with lifestyle education to help you feel steadier, sleep deeper, and move toward long-term balance. Each program is tailored to your life, not a template.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Featured packages</h3>\\n        <div class=\\\"service-list\\\">\\n          <div class=\\\"service\\\">\\n            <h4>Foundations Intensive</h4>\\n            <p>8-week guided reset focused on nutrition, sleep, and stress resilience.</p>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h4>Gut & Energy Tune-up</h4>\\n            <p>Short-cycle coaching with targeted lifestyle shifts for digestion and vitality.</p>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h4>Chronic Symptom Support</h4>\\n            <p>Collaborative planning for long-standing inflammation and low energy.</p>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h4>One-off Consult</h4>\\n            <p>Clarity visit: assessment, recommendations, and a clear next-step plan.</p>\\n          </div>\\n        </div>\\n      </aside>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"grid\\\">\\n      <section>\\n        <h2 style=\\\"margin-top:0\\\">Why choose an integrative path?</h2>\\n        <p class=\\\"lead\\\">We look beyond single symptoms to the systems and habits that shape them. Our work blends clinical knowledge, thoughtful labs when useful, and practical coaching so you can make lasting adjustments with confidence.</p>\\n\\n        <div class=\\\"benefits\\\" style=\\\"margin-top:14px\\\">\\n          <div class=\\\"benefit\\\"><strong>Personalized plans</strong><div style=\\\"color:var(--muted)\\\">No cookie-cutter scripts — your rhythms and needs guide the plan.</div></div>\\n          <div class=\\\"benefit\\\"><strong>Evidence-forward tools</strong><div style=\\\"color:var(--muted)\\\">Lifestyle, nutrition, movement, and selective testing when informative.</div></div>\\n          <div class=\\\"benefit\\\"><strong>Ongoing support</strong><div style=\\\"color:var(--muted)\\\">Check-ins and coaching keep progress steady without overwhelm.</div></div>\\n        </div>\\n\\n        <div class=\\\"process\\\">\\n          <h3 style=\\\"margin-bottom:8px\\\">How a program unfolds</h3>\\n          <div class=\\\"step\\\"><div class=\\\"bubble\\\">1</div><div><strong>Discovery</strong><div style=\\\"color:var(--muted)\\\">Thorough intake to map symptoms, history, goals and habits.</div></div></div>\\n          <div class=\\\"step\\\"><div class=\\\"bubble\\\">2</div><div><strong>Blueprint</strong><div style=\\\"color:var(--muted)\\\">A focused plan combining behavior, nutrition, and optional testing.</div></div></div>\\n          <div class=\\\"step\\\"><div class=\\\"bubble\\\">3</div><div><strong>Support</strong><div style=\\\"color:var(--muted)\\\">Regular follow-ups, coaching prompts, and adjustments as you progress.</div></div></div>\\n        </div>\\n\\n        <div class=\\\"faq\\\">\\n          <h3>Common questions</h3>\\n          <details><summary>Do you guarantee a cure?</summary><div style=\\\"color:var(--muted);margin-top:8px\\\">We emphasize education and whole-person strategies. While we aim to improve symptoms and function, we do not guarantee cures. Results vary by individual and adherence.</div></details>\\n          <details><summary>Do you work with labs?</summary><div style=\\\"color:var(--muted);margin-top:8px\\\">Labs are used selectively to inform care. We recommend tests only when they add actionable clarity to your plan.</div></details>\\n        </div>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"social-proof\\\">\\n          <strong>What clients say</strong>\\n          <div class=\\\"testimonial\\\">\\\"I finally sleep through the night — I didn't know small routine shifts could make such a difference.\\\" — A.M.</div>\\n          <div class=\\\"testimonial\\\">\\\"The plan felt crafted for my life, not just my symptoms.\\\" — J.T.</div>\\n          <div style=\\\"margin-top:8px\\\"><a href=\\\"about.html\\\" style=\\\"color:var(--accent-dark);font-weight:700;text-decoration:none\\\">Meet the practitioner</a></div>\\n        </div>\\n\\n        <div class=\\\"lead-magnet\\\">\\n          <div style=\\\"flex:1\\\">\\n            <strong>Free guide:</strong>\\n            <div style=\\\"color:var(--muted);font-size:14px\\\">\\\"5 Foundations for Better Sleep & Energy\\\" — practical steps to start tonight.</div>\\n          </div>\\n          <form id=\\\"leadForm\\\" style=\\\"display:flex;gap:8px;align-items:center\\\">\\n            <input aria-label=\\\"email\\\" placeholder=\\\"you@domain.com\\\" type=\\\"email\\\" required>\\n            <button style=\\\"background:var(--accent);color:white;border:none;padding:10px 12px;border-radius:8px;cursor:pointer\\\">Get it</button>\\n          </form>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px;padding:12px;background:linear-gradient(180deg,#fff,#f8fff6);border-radius:10px;border:1px solid rgba(47,107,75,0.04)\\\">\\n          <strong>Ready for next steps?</strong>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">Start with a clarity visit or choose an intensive package.</div>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:inline-block;margin-top:10px\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <footer>\\n    <div>&copy; {{BUSINESS_NAME}} — <span style=\\\"color:var(--muted)\\\">{{CITY}}, {{STATE}}</span></div>\\n    <div style=\\\"text-align:right\\\">Call: <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent-dark);text-decoration:none\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent-dark);text-decoration:none\\\">{{EMAIL}}</a></div>\\n  </footer>\\n\\n  <script>\\n    document.getElementById('leadForm').addEventListener('submit',function(e){e.preventDefault();alert('Thanks — your guide will be emailed shortly.');});\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Common Concerns</title>\\n  <style>\\n    :root{--bg:#fffefc;--teal:#2a7050;--soft:#dff6e6;--muted:#6b7280}\\n    body{margin:0;font-family:Inter,system-ui,Arial;color:#072817;background:linear-gradient(180deg,var(--bg),#f6fff8)}\\n    .top{display:flex;justify-content:space-between;align-items:center;padding:20px 24px}\\n    .brand{font-weight:800}\\n    nav a{margin-left:14px;color:var(--teal);text-decoration:none;font-weight:600}\\n    .hero{padding:24px;border-bottom:1px solid rgba(42,112,80,0.06)}\\n    .hero h1{margin:6px 0 0;font-size:28px}\\n    .hero p{color:var(--muted);margin:8px 0 0}\\n    .wrap{max-width:1000px;margin:22px auto;padding:0 24px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px}\\n    .card{background:white;border-radius:12px;padding:16px;border:1px solid rgba(14,30,20,0.04)}\\n    .concern{display:flex;gap:12px;align-items:flex-start;padding:12px;border-radius:10px;border:1px solid rgba(42,112,80,0.04);margin-bottom:10px}\\n    .icon{width:56px;height:56px;border-radius:10px;background:linear-gradient(180deg,#f3fff0,#fff);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--teal)}\\n    h3{margin:0 0 6px}\\n    .muted{color:var(--muted)}\\n    .disclaimer{font-size:13px;color:#5a6360;margin-top:12px}\\n    .lead-magnet{margin-top:14px;padding:12px;border-radius:10px;background:linear-gradient(90deg,#fff,#f7fff2);border:1px dashed rgba(42,112,80,0.12);display:flex;justify-content:space-between;align-items:center}\\n    footer{max-width:1000px;margin:22px auto;padding:8px 24px;color:var(--muted);display:flex;justify-content:space-between}\\n    @media (max-width:900px){.grid{grid-template-columns:1fr} .icon{width:48px;height:48px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"top\\\">\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">Programs</a>\\n      <a href=\\\"book.html\\\">Schedule</a>\\n    </nav>\\n  </div>\\n\\n  <section class=\\\"hero\\\">\\n    <div class=\\\"wrap\\\">\\n      <h1>Common areas we support</h1>\\n      <p class=\\\"muted\\\">Below are typical concerns people bring. Our approach focuses on education, individualized planning, and gradual, sustainable change. We do not promise cures; outcomes vary.</p>\\n    </div>\\n  </section>\\n\\n  <main class=\\\"wrap\\\">\\n    <div class=\\\"grid\\\">\\n      <section>\\n        <div class=\\\"card\\\">\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"icon\\\">Z</div>\\n            <div>\\n              <h3>Stress & overwhelm</h3>\\n              <div class=\\\"muted\\\">Practical coaching for nervous system regulation, sleep hygiene, and sustainable habit shifts to reduce reactivity.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"icon\\\">🌙</div>\\n            <div>\\n              <h3>Sleep difficulty</h3>\\n              <div class=\\\"muted\\\">Behavioral strategies, circadian-friendly routines, and targeted nutritional support to improve sleep quality.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"icon\\\">🍽️</div>\\n            <div>\\n              <h3>Digestion & gut health</h3>\\n              <div class=\\\"muted\\\">Dietary adjustments, habit-based interventions, and selective testing when it informs a clear plan.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"icon\\\">🔥</div>\\n            <div>\\n              <h3>Inflammation & aches</h3>\\n              <div class=\\\"muted\\\">Lifestyle and nutritional patterns that support balanced inflammatory responses and movement resilience.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"concern\\\">\\n            <div class=\\\"icon\\\">⚡</div>\\n            <div>\\n              <h3>Low energy & fatigue</h3>\\n              <div class=\\\"muted\\\">A systems approach to sleep, blood sugar, activity, and stress to rebuild sustainable energy.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"disclaimer\\\">Disclaimer: This information is educational and not a substitute for medical diagnosis. If you have serious or urgent symptoms, contact your primary care provider or emergency services. Recommendations may include labs or referrals when indicated.</div>\\n        </div>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin-top:0\\\">How we decide on next steps</h4>\\n          <ol style=\\\"color:var(--muted);padding-left:18px\\\"> \\n            <li>Listen and map your story</li>\\n            <li>Identify priority drivers (sleep, stress, digestion)</li>\\n            <li>Design a clear, time-bound plan</li>\\n          </ol>\\n\\n          <div class=\\\"lead-magnet\\\">\\n            <div>\\n              <strong>Quick start checklist</strong>\\n              <div style=\\\"color:var(--muted);font-size:14px\\\">Download practical steps to begin evening and morning routines tonight.</div>\\n            </div>\\n            <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"padding:8px 12px;background:var(--teal);color:white;border-radius:8px;text-decoration:none\\\">Get it</a>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px;color:var(--muted);font-size:14px\\\">Questions? Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--teal);text-decoration:none\\\">{{PHONE}}</a> or <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--teal);text-decoration:none\\\">email</a>.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;padding:12px;background:linear-gradient(180deg,#fff,#f8fff6);border-radius:10px;border:1px solid rgba(42,112,80,0.04)\\\">\\n          <strong>Ready to explore?</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Start with a clarity visit — we listen, map priorities, and leave you with a practical next step.</div>\\n          <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:inline-block;margin-top:10px;padding:10px 14px;background:var(--teal);color:white;border-radius:8px;text-decoration:none\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <footer>\\n    <div>&copy; {{BUSINESS_NAME}}</div>\\n    <div class=\\\"muted\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}} — {{CITY}}, {{STATE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Our Approach</title>\\n  <style>\\n    :root{--bg:#fbfff9;--accent:#3c8a63;--stone:#4b5563}\\n    body{margin:0;font-family:Inter,system-ui,Arial;background:linear-gradient(180deg,var(--bg),#eef9ef);color:#07311f}\\n    header{display:flex;justify-content:space-between;padding:20px 24px;align-items:center}\\n    nav a{margin-left:14px;color:var(--accent);text-decoration:none;font-weight:600}\\n    .hero{padding:36px 24px 18px}\\n    .hero h1{margin:0;font-size:30px}\\n    .hero p{color:var(--stone);margin:8px 0 0}\\n    .container{max-width:1000px;margin:18px auto;padding:0 24px}\\n    .cards{display:grid;grid-template-columns:1fr 320px;gap:20px}\\n    .guide{background:white;padding:16px;border-radius:12px;border:1px solid rgba(14,30,20,0.04)}\\n    .flow{display:grid;grid-auto-rows:min-content;gap:12px}\\n    .flow .item{display:flex;gap:12px;align-items:flex-start}\\n    .num{width:44px;height:44px;border-radius:999px;background:linear-gradient(180deg,var(--accent),#2f6b4b);color:white;display:flex;align-items:center;justify-content:center;font-weight:700}\\n    .labs{background:linear-gradient(90deg,#f8fff7,#ffffff);padding:12px;border-radius:10px;border:1px solid rgba(60,138,99,0.06);margin-top:10px}\\n    .faq details{margin-top:8px;background:white;padding:10px;border-radius:8px;border:1px solid rgba(14,30,20,0.04)}\\n    .lead{display:flex;gap:12px;margin-top:14px;align-items:center}\\n    .lead input{flex:1;padding:10px;border-radius:8px;border:1px solid rgba(14,30,20,0.06)}\\n    footer{max-width:1000px;margin:26px auto;padding:8px 24px;color:var(--stone);display:flex;justify-content:space-between}\\n    @media (max-width:900px){.cards{grid-template-columns:1fr} .num{width:40px;height:40px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"approach.html\\\">Our Way</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <section class=\\\"hero\\\">\\n    <div class=\\\"container\\\">\\n      <h1>How we work — clear, compassionate, and evidence-minded</h1>\\n      <p class=\\\"lead muted\\\">Our method centers on listening first, then crafting an individualized plan that you can actually follow. Common tools: education, lifestyle shifts, strategic labs, and supportive coaching.</p>\\n    </div>\\n  </section>\\n\\n  <main class=\\\"container\\\">\\n    <div class=\\\"cards\\\">\\n      <article class=\\\"guide\\\">\\n        <h2 style=\\\"margin-top:0\\\">The step-by-step intake & care flow</h2>\\n        <div class=\\\"flow\\\">\\n          <div class=\\\"item\\\"><div class=\\\"num\\\">1</div><div><strong>Intake & story</strong><div style=\\\"color:var(--stone)\\\">We map symptoms, medical history, sleep, stressors, routines and goals — so recommendations fit your life.</div></div></div>\\n\\n          <div class=\\\"item\\\"><div class=\\\"num\\\">2</div><div><strong>Assessment</strong><div style=\\\"color:var(--stone)\\\">Where useful, selective labs are discussed as educational tools to direct treatment — not as mandatory steps.</div></div></div>\\n\\n          <div class=\\\"item\\\"><div class=\\\"num\\\">3</div><div><strong>Plan & priorities</strong><div style=\\\"color:var(--stone)\\\">A practical blueprint with small, measurable steps and timelines. We focus on what to do first to gain momentum.</div></div></div>\\n\\n          <div class=\\\"item\\\"><div class=\\\"num\\\">4</div><div><strong>Support & follow-up</strong><div style=\\\"color:var(--stone)\\\">Scheduled check-ins to adjust the plan, celebrate wins, and troubleshoot barriers.</div></div></div>\\n\\n          <div class=\\\"item\\\"><div class=\\\"num\\\">5</div><div><strong>Integration</strong><div style=\\\"color:var(--stone)\\\">Sustaining change through habit design, community resources, and handed-over tools for long-term resilience.</div></div></div>\\n\\n          <div class=\\\"labs\\\">\\n            <strong>About optional labs</strong>\\n            <div style=\\\"color:var(--stone);margin-top:6px\\\">Labs (bloodwork, stool, hormone panels) are offered when they will change management. They are used as educational data points, not guarantees. We review results and translate them into clear next steps if they add actionable insight.</div>\\n          </div>\\n\\n        </div>\\n\\n        <div class=\\\"lead\\\">\\n          <input placeholder=\\\"you@domain.com\\\" type=\\\"email\\\" aria-label=\\\"email\\\">\\n          <button onclick=\\\"location.href='{{PRIMARY_CTA_URL}}'\\\" style=\\\"background:var(--accent);color:white;border:none;padding:10px 12px;border-radius:8px;cursor:pointer\\\">{{PRIMARY_CTA_LABEL}}</button>\\n        </div>\\n      </article>\\n\\n      <aside>\\n        <div class=\\\"guide\\\">\\n          <h3 style=\\\"margin-top:0\\\">What to expect in your first visit</h3>\\n          <ul style=\\\"color:var(--stone);padding-left:18px\\\">\\n            <li>Detailed health history and goal-setting</li>\\n            <li>Initial recommendations you can implement immediately</li>\\n            <li>Discussion of whether labs would be informative</li>\\n          </ul>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <strong>Follow-ups</strong>\\n            <div style=\\\"color:var(--stone);margin-top:6px\\\">Typically 20–40 minutes depending on the focus. We track outcomes and refine priorities each visit.</div>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <strong>Teamwork</strong>\\n            <div style=\\\"color:var(--stone);margin-top:6px\\\">We collaborate with your other providers when helpful and coordinate referrals if specialized care is needed.</div>\\n          </div>\\n\\n          <div style=\\\"margin-top:14px\\\">\\n            <strong>Still unsure?</strong>\\n            <div style=\\\"color:var(--stone);margin-top:8px\\\">Book a short clarity call to see if our approach fits your needs.</div>\\n            <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:inline-block;margin-top:10px;padding:10px 14px;background:var(--accent);color:white;border-radius:8px;text-decoration:none\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;padding:12px;background:linear-gradient(90deg,#fff,#f5fff3);border-radius:10px;border:1px solid rgba(14,30,20,0.04)\\\">\\n          <strong>Questions answered</strong>\\n          <div class=\\\"faq\\\">\\n            <details><summary>Will I need tests?</summary>\\n              <div style=\\\"color:var(--stone);margin-top:8px\\\">Not always. We recommend tests only when they will meaningfully change the plan.</div>\\n            </details>\\n            <details><summary>Do you promise results?</summary>\\n              <div style=\\\"color:var(--stone);margin-top:8px\\\">We focus on education and practical tools. While many clients see improvement, individual responses vary and cures are not guaranteed.</div>\\n            </details>\\n          </div>\\n        </div>\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <footer>\\n    <div>&copy; {{BUSINESS_NAME}}</div>\\n    <div style=\\\"color:var(--stone)\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}} — <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
