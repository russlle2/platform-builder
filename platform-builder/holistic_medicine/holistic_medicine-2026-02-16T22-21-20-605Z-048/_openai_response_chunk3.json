          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Plans — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Transparent pricing and packages for whole-person care at {{BUSINESS_NAME}}.\\\">\\n  <style>\\n    :root{--bg1:linear-gradient(120deg,#f6fff8 0%,#e8fbf5 50%,#eef9ff 100%);--accent:#6a8c6a;--muted:#6d6d6d;--card:#ffffff;--glass:rgba(255,255,255,0.7);--shadow:0 8px 24px rgba(17,24,39,0.08);--radius:14px}\\n    *{box-sizing:border-box}html,body{height:100%}body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:#083826;background:var(--bg1);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:46px;height:46px;border-radius:10px;background:radial-gradient(circle at 30% 30%, #c8efd0, #9bd6a6 40%, #6aa276 100%);box-shadow:var(--shadow);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav a{margin-left:18px;color:#134e3a;text-decoration:none;font-weight:600}\\n    nav a.pricing{color:#0b3d2b}\\n    .container{max-width:1100px;margin:22px auto;padding:28px}\\n\\n    /* background svg art */\\n    .hero{position:relative;padding:34px;border-radius:20px;background:linear-gradient(180deg,rgba(255,255,255,0.85),rgba(255,255,255,0.7));box-shadow:var(--shadow);overflow:hidden}\\n    .hero .art{position:absolute;right:-80px;top:-40px;opacity:0.18;transform:rotate(15deg);width:420px}\\n    .hero h1{margin:0;font-size:28px;color:#062c20}\\n    .hero p.lead{margin:8px 0 18px;color:var(--muted)}\\n\\n    /* pricing grid */\\n    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;margin-top:18px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:var(--shadow);border:1px solid rgba(12,34,20,0.04)}\\n    .card h3{margin:0 0 6px;color:#164a34}\\n    .price{font-size:22px;font-weight:700;color:var(--accent);margin:8px 0}\\n    .muted{color:var(--muted);font-size:14px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,#6aa276,#3e7a5a);color:white;text-decoration:none;font-weight:700}\\n\\n    /* comparison table */\\n    .compare{margin-top:22px;background:linear-gradient(180deg,rgba(255,255,255,0.6),transparent);padding:12px;border-radius:12px}\\n    .compare table{width:100%;border-collapse:collapse}\\n    .compare th{text-align:left;padding:8px;color:#163e31}\\n    .compare td{padding:8px;color:var(--muted)}\\n\\n    /* FAQ */\\n    .faq{margin-top:22px}\\n    .faq details{background:var(--card);padding:12px;border-radius:10px;margin-bottom:10px}\\n\\n    footer{margin-top:26px;padding:18px;text-align:center;color:var(--muted);font-size:13px}\\n\\n    /* responsive touches */\\n    @media (max-width:680px){.hero h1{font-size:22px}.brand .logo{width:42px;height:42px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"approach.html\\\">How It Works</a>\\n      <a href=\\\"pricing.html\\\" class=\\\"pricing\\\">Investment</a>\\n      <a href=\\\"book.html\\\">Schedule</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <svg class=\\\"art\\\" viewBox=\\\"0 0 600 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n        <defs>\\n          <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n            <stop offset=\\\"0\\\" stop-color=\\\"#bfead8\\\" />\\n            <stop offset=\\\"1\\\" stop-color=\\\"#dff4ff\\\" />\\n          </linearGradient>\\n          <filter id=\\\"blur\\\"><feGaussianBlur stdDeviation=\\\"12\\\" /></filter>\\n        </defs>\\n        <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"600\\\" height=\\\"200\\\" fill=\\\"url(#g1)\\\" rx=\\\"22\\\" filter=\\\"url(#blur)\\\"/>\\n        <circle cx=\\\"200\\\" cy=\\\"60\\\" r=\\\"50\\\" fill=\\\"#8fd2a4\\\" opacity=\\\"0.9\\\" />\\n        <circle cx=\\\"320\\\" cy=\\\"100\\\" r=\\\"68\\\" fill=\\\"#6aa276\\\" opacity=\\\"0.6\\\" />\\n      </svg>\\n      <h1>Simple, transparent programs for whole-person health</h1>\\n      <p class=\\\"lead\\\">Choose the support level that fits your lifestyle. Packages combine time with {{PRACTITIONER_NAME}} ({{CREDENTIALS}}), personalized education, and optional testing. No promises of cure — only evidence-informed, integrative guidance.</p>\\n\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"card\\\">\\n          <h3>Starter Visit</h3>\\n          <div class=\\\"price\\\">$175 — Single</div>\\n          <div class=\\\"muted\\\">60-minute comprehensive intake. Ideal for clarifying concerns and next steps.</div>\\n          <a class=\\\"cta\\\" href=\\\"book.html?plan=starter\\\">Book a Visit</a>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3>Deep Dive</h3>\\n          <div class=\\\"price\\\">$480 — Package</div>\\n          <div class=\\\"muted\\\">Initial intake + 2 follow-ups across 3 months. Includes a tailored plan and educational resources.</div>\\n          <a class=\\\"cta\\\" href=\\\"book.html?plan=deep\\\">Reserve Package</a>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h3>Continuity — 6 mo</h3>\\n          <div class=\\\"price\\\">$1200 — Program</div>\\n          <div class=\\\"muted\\\">Monthly sessions, priority messaging, and plan refinement. Best for chronic lifestyle change support.</div>\\n          <a class=\\\"cta\\\" href=\\\"book.html?plan=continuity\\\">Join Program</a>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"compare\\\">\\n        <table>\\n          <tr><th>What’s included</th><td>Individualized care plan, educational materials, & optional lab coordination</td></tr>\\n          <tr><th>Labs & supplements</th><td>May incur extra fees. Labs are optional and ordered for educational clarity, not definitive diagnosis.</td></tr>\\n          <tr><th>Insurance</th><td>Payments accepted; we provide superbills for reimbursement in many cases.</td></tr>\\n        </table>\\n      </div>\\n\\n      <div class=\\\"faq\\\">\\n        <details>\\n          <summary style=\\\"font-weight:700\\\">Do you guarantee outcomes?</summary>\\n          <div class=\\\"muted\\\">No. Holistic care emphasizes education and individualized planning. Outcomes depend on many factors; we focus on supporting sustainable change.</div>\\n        </details>\\n        <details>\\n          <summary style=\\\"font-weight:700\\\">Can I add lab testing?</summary>\\n          <div class=\\\"muted\\\">Yes — lab testing is available as an add-on when clinically indicated. We discuss appropriateness during intake.</div>\\n        </details>\\n      </div>\\n\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;display:flex;gap:12px;align-items:center;justify-content:space-between\\\">\\n      <div style=\\\"max-width:72%\\\">\\n        <div style=\\\"font-weight:800\\\">Still unsure which path fits?</div>\\n        <div class=\\\"muted\\\">Start with a Starter Visit to get clarity, then upgrade into a program tailored to your rhythm.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Schedule a Clarity Call</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — Holistic care in {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    <div style=\\\"margin-top:6px;color:var(--muted)\\\">All services emphasize education and informed choices; they do not replace emergency or urgent medical care.</div>\\n  </footer>\\n\\n  <script>\\n    // Small enhancement: allow deep link query for plan\\n    (function(){\\n      var params = new URLSearchParams(location.search);\\n      var p = params.get('plan');\\n      if(p){\\n        // highlight a suggestion briefly\\n        var el = document.querySelector('a[href*=\\\"'+p+'\\\"]');\\n        if(el){el.style.boxShadow='0 8px 30px rgba(58,125,80,0.18)';setTimeout(function(){el.style.boxShadow=''},2200)}\\n      }\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Meet the people and philosophy behind {{BUSINESS_NAME}}. Whole-person, integrative care built on curiosity and evidence.\\\">\\n  <style>\\n    :root{--bg:linear-gradient(180deg,#fffefb,#f2fbf6);--accent:#2d6b4a;--text:#093227;--muted:#5f6b63}\\n    *{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:var(--text);background:var(--bg)}\\n    .wrap{max-width:980px;margin:26px auto;padding:20px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    .nav a{margin-left:16px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .hero{display:flex;gap:20px;align-items:center;background:rgba(255,255,255,0.78);padding:18px;border-radius:14px;box-shadow:0 12px 30px rgba(10,18,14,0.06)}\\n    .avatar{width:96px;height:96px;border-radius:16px;background:linear-gradient(180deg,#eaf6ec,#cdebd3);display:flex;align-items:center;justify-content:center;font-weight:800;color:#123b2a}\\n    .meta small{color:var(--muted)}\\n\\n    .story{margin-top:18px;padding:16px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.8),rgba(255,255,255,0.6));box-shadow:0 8px 20px rgba(12,28,18,0.04)}\\n\\n    .grid{display:grid;grid-template-columns:1fr 300px;gap:18px;margin-top:18px}\\n    .card{background:white;border-radius:12px;padding:14px;box-shadow:0 8px 20px rgba(12,28,18,0.04)}\\n\\n    .values{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}\\n    .pill{background:linear-gradient(90deg,#def6e6,#f2fff7);padding:8px 10px;border-radius:999px;color:#1f5b3f;font-weight:700}\\n\\n    .faq{margin-top:12px}\\n\\n    footer{margin-top:24px;color:var(--muted);font-size:13px;text-align:center}\\n\\n    /* playful accent shapes */\\n    .shape{position:absolute;right:20px;top:80px;opacity:0.07;width:260px;height:260px}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"font-weight:900\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"services.html\\\">What We Do</a>\\n        <a href=\\\"approach.html\\\">Our Approach</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"avatar\\\">{{PRACTITIONER_NAME.split(' ')[0]}}</div>\\n      <div class=\\\"meta\\\">\\n        <div style=\\\"font-size:18px;font-weight:800\\\">Hi, I’m {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n        <small>I blend evidence-based tools with a whole-person perspective — nutrition, lifestyle, mind-body, and targeted testing when helpful.</small>\\n        <div class=\\\"values\\\">\\n          <div class=\\\"pill\\\">Education First</div>\\n          <div class=\\\"pill\\\">Personalized</div>\\n          <div class=\\\"pill\\\">Practical Plans</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"grid\\\">\\n      <div>\\n        <div class=\\\"story card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Our philosophy</h3>\\n          <p style=\\\"margin:4px 0;color:var(--muted)\\\">At {{BUSINESS_NAME}} we focus on helping you understand the interplay of habits, environment, relationships, and biology. We translate science into actionable steps rather than silver-bullet promises. Care is collaborative: you are the expert on your life; we bring tools and clinical reasoning.</p>\\n\\n          <h4 style=\\\"margin-top:12px\\\">How we work with you</h4>\\n          <ol style=\\\"margin:8px 0 0 18px;color:var(--muted)\\\">\\n            <li>Curated intake to hear your story</li>\\n            <li>Tailored plan with small, measurable experiments</li>\\n            <li>Regular check-ins and adjustments</li>\\n          </ol>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <a href=\\\"approach.html\\\" style=\\\"background:linear-gradient(90deg,#5d9a78,#2f6b4f);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700\\\">Learn More</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0 0 6px\\\">Community & learning</h4>\\n          <div style=\\\"color:var(--muted)\\\">We prioritize patient education: workshops, brief guides, and periodic group sessions are available for program participants.</div>\\n        </div>\\n\\n        <div class=\\\"faq\\\">\\n          <details>\\n            <summary style=\\\"font-weight:700\\\">Do you prescribe medications?</summary>\\n            <div style=\\\"color:var(--muted)\\\">When clinically appropriate, medications may be discussed. Our emphasis is on informed, shared decision-making and exploring integrative options alongside standard care.</div>\\n          </details>\\n          <details>\\n            <summary style=\\\"font-weight:700\\\">Is this a replacement for medical care?</summary>\\n            <div style=\\\"color:var(--muted)\\\">No. We complement primary and specialty care. For urgent or emergency needs, seek immediate medical attention.</div>\\n          </details>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\" style=\\\"text-align:center\\\">\\n          <h4 style=\\\"margin:6px 0\\\">Quick facts</h4>\\n          <div style=\\\"color:var(--muted);font-size:14px\\\">Serving {{CITY}}, {{STATE}} • Telehealth available • Flexible scheduling</div>\\n          <div style=\\\"margin-top:12px\\\"><a href=\\\"book.html\\\" style=\\\"display:inline-block;background:linear-gradient(90deg,#6aa276,#2f6b4f);color:white;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:700\\\">Schedule an Intro</a></div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:6px 0\\\">Professional snapshot</h4>\\n          <div style=\\\"color:var(--muted);font-size:14px\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}} — years in integrative care, trained in evidence-based lifestyle medicine and patient-centered counseling.</div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <div style=\\\"margin-top:18px;text-align:center\\\">\\n      <div style=\\\"font-weight:800\\\">Want practical guides sent to your inbox?</div>\\n      <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" style=\\\"margin-top:10px;display:inline-flex;gap:8px\\\">\\n        <input name=\\\"email\\\" placeholder=\\\"your@email.com\\\" style=\\\"padding:10px;border-radius:10px;border:1px solid #e6ece2\\\" />\\n        <button style=\\\"padding:10px 12px;border-radius:10px;background:linear-gradient(90deg,#3f805a,#236b47);color:white;border:none;font-weight:700\\\">Get Guides</button>\\n      </form>\\n      <div style=\\\"margin-top:8px;color:var(--muted);font-size:13px\\\">We respect your inbox. These are educational resources — not medical guarantees.</div>\\n    </div>\\n\\n    <footer>\\n      <div style=\\\"margin-top:18px;color:var(--muted)\\\">{{BUSINESS_NAME}} • <a href=\\\"contact.html\\\">Contact</a> • <a href=\\\"privacy.html\\\">Privacy</a></div>\\n    </footer>\\n  </div>\\n\\n  <svg class=\\\"shape\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" style=\\\"position:fixed;right:12px;top:88px;opacity:0.06\\\">\\n    <defs>\\n      <linearGradient id=\\\"lg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#d7f3e3\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#f1fbff\\\"/></linearGradient>\\n    </defs>\\n    <rect width=\\\"200\\\" height=\\\"200\\\" rx=\\\"40\\\" fill=\\\"url(#lg)\\\"/>\\n    <circle cx=\\\"48\\\" cy=\\\"56\\\" r=\\\"20\\\" fill=\\\"#9bd6a6\\\" opacity=\\\"0.8\\\"/>\\n    <path d=\\\"M20 140 C60 110,140 170,180 140\\\" stroke=\\\"#6aa276\\\" stroke-width=\\\"6\\\" fill=\\\"none\\\" opacity=\\\"0.5\\\"/>\\n  </svg>\\n\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Schedule a visit with {{PRACTITIONER_NAME}}. Choose a program, pick a time, and start a collaborative path toward better balance.\\\">\\n  <style>\\n    :root{--bg:#fbfffd;--accent:#336a4a;--muted:#657a71}\\n    *{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial;color:#083526;background:var(--bg)}\\n    .frame{max-width:900px;margin:24px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    header a{color:var(--muted);text-decoration:none;margin-left:14px}\\n    .panel{background:white;border-radius:14px;padding:18px;box-shadow:0 12px 30px rgba(9,31,20,0.06)}\\n\\n    .steps{display:flex;gap:12px;margin-top:12px}\\n    .step{flex:1;padding:10px;border-radius:10px;background:linear-gradient(180deg,#f7fdf6,#f0fbf6);text-align:center}\\n    .step strong{display:block;color:#1b5a3e}\\n\\n    form{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}\\n    label{font-size:13px;color:var(--muted);display:block;margin-bottom:6px}\\n    input,select,textarea{padding:10px;border-radius:10px;border:1px solid #e6eee6;font-size:14px}\\n    textarea{grid-column:1/3;min-height:92px}\\n    .full{grid-column:1/3}\\n\\n    .aside{margin-top:14px;padding:12px;border-radius:12px;background:linear-gradient(180deg,#fbfff9,#eef9f0);color:var(--muted)}\\n    .notice{font-size:13px;color:var(--muted);margin-top:10px}\\n\\n    .submit{background:linear-gradient(90deg,#3f805a,#1f5b3f);color:white;padding:12px;border-radius:12px;border:none;font-weight:800}\\n\\n    footer{margin-top:18px;color:var(--muted);text-align:center;font-size:13px}\\n\\n    @media (max-width:720px){form{grid-template-columns:1fr}textarea{grid-column:1/2}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"frame\\\">\\n    <header>\\n      <div style=\\\"font-weight:900\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"panel\\\">\\n      <h2 style=\\\"margin:4px 0 6px\\\">Book an appointment</h2>\\n      <div style=\\\"color:var(--muted);margin-bottom:12px\\\">Select a visit type and we’ll follow up to finalize time and pre-visit intake. All visits are intended to educate and support — not to replace urgent medical care.</div>\\n\\n      <div class=\\\"steps\\\">\\n        <div class=\\\"step\\\"><strong>1. Pick</strong><span style=\\\"display:block;color:var(--muted)\\\">Choose a visit type</span></div>\\n        <div class=\\\"step\\\"><strong>2. Tell Us</strong><span style=\\\"display:block;color:var(--muted)\\\">Share context & goals</span></div>\\n        <div class=\\\"step\\\"><strong>3. Confirm</strong><span style=\\\"display:block;color:var(--muted)\\\">We’ll email next steps</span></div>\\n      </div>\\n\\n      <form id=\\\"bookingForm\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\">\\n        <div>\\n          <label for=\\\"plan\\\">Visit type</label>\\n          <select id=\\\"plan\\\" name=\\\"plan\\\">\\n            <option value=\\\"starter\\\">Starter Visit — 60m</option>\\n            <option value=\\\"follow\\\">Follow-up — 30m</option>\\n            <option value=\\\"tele\\\">Telehealth — 45m</option>\\n            <option value=\\\"program\\\">Program Intake — 90m</option>\\n          </select>\\n        </div>\\n        <div>\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" required />\\n        </div>\\n        <div>\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required />\\n        </div>\\n        <div>\\n          <label for=\\\"phone\\\">Phone</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" />\\n        </div>\\n\\n        <div class=\\\"full\\\">\\n          <label for=\\\"concerns\\\">Main concerns / goals</label>\\n          <textarea id=\\\"concerns\\\" name=\\\"concerns\\\" placeholder=\\\"e.g., low energy, trouble sleeping, digestive changes\\\"></textarea>\\n        </div>\\n\\n        <div style=\\\"display:flex;gap:8px;align-items:center\\\" class=\\\"full\\\">\\n          <div style=\\\"flex:1\\\">\\n            <label for=\\\"when\\\">Preferred days / times</label>\\n            <input id=\\\"when\\\" name=\\\"when\\\" placeholder=\\\"weekday mornings, afternoons, etc.\\\" />\\n          </div>\\n          <div style=\\\"width:220px\\\">\\n            <label for=\\\"ref\\\">How did you hear about us?</label>\\n            <input id=\\\"ref\\\" name=\\\"ref\\\" />\\n          </div>\\n        </div>\\n\\n        <div class=\\\"full\\\" style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px\\\">\\n          <div style=\\\"color:var(--muted);font-size:13px\\\">By booking you agree to our intake process. We'll contact you to confirm scheduling and any recommended preparatory steps.</div>\\n          <button class=\\\"submit\\\" type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n        </div>\\n      </form>\\n\\n      <div class=\\\"aside\\\">\\n        <strong>What happens after you submit?</strong>\\n        <div class=\\\"notice\\\">We review your request within 48 business hours, send intake paperwork, and offer available times. Labs and supplements are optional and reviewed with you when appropriate.</div>\\n      </div>\\n\\n    </section>\\n\\n    <section style=\\\"margin-top:14px;display:grid;grid-template-columns:1fr 280px;gap:12px\\\">\\n      <div class=\\\"panel\\\">\\n        <h4 style=\\\"margin-top:0\\\">Need help choosing?</h4>\\n        <p style=\\\"color:var(--muted)\\\">If you're unsure which visit is best, pick a Starter Visit for a thorough intake. Follow-ups and programs are intended to deepen support over time.</p>\\n        <div style=\\\"margin-top:10px\\\">\\n          <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"text-decoration:none;background:linear-gradient(90deg,#6aa276,#397b57);color:white;padding:10px 12px;border-radius:10px;font-weight:700\\\">Email us</a>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"panel\\\">\\n        <h4 style=\\\"margin-top:0\\\">Quick FAQ</h4>\\n        <div style=\\\"color:var(--muted);font-size:14px\\\">\\n          <strong>Insurance?</strong> We provide superbills; check with your carrier for coverage.\\n        </div>\\n        <div style=\\\"margin-top:8px;color:var(--muted);font-size:14px\\\">\\n          <strong>Urgent needs?</strong> For emergencies, call local emergency services. Booking is not for immediate care.\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"margin-top:14px;color:var(--muted)\\\">Questions? Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n\\n  <script>\\n    // lightweight client validation + small playful confirmation\\n    document.getElementById('bookingForm').addEventListener('submit', function(e){\\n      var name = document.getElementById('name').value.trim();\\n      var email = document.getElementById('email').value.trim();\\n      if(!name || !email){\\n        e.preventDefault();\\n        alert('Please include your name and email so we can follow up.');\\n        return false;\\n      }\\n      // show a friendly momentary confirmation before sending\\n      var btn = e.submitter || this.querySelector('.submit');\\n      if(btn){btn.disabled=true;btn.textContent='Sending…'}\\n    });\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
