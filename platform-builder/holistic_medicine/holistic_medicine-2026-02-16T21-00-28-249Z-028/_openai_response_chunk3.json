          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Pricing — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Series and session pricing for holistic, whole-person care—education first, no guaranteed cures.\\\">\\n  <style>\\n    :root{--bg:#fbfbf9;--accent:#7a5cff;--muted:#6b6b6b;--card:#ffffff;--glass:rgba(255,255,255,0.6);--accent-2:#2ec4b6}\\n    *{box-sizing:border-box;font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial}\\n    html,body{height:100%;margin:0;background:linear-gradient(150deg,var(--bg),#f1f6ff 60%)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:56px;height:56px;display:grid;place-items:center;border-radius:12px;overflow:hidden;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#fff;font-weight:700}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:15px}\\n    /* split diagonal hero */\\n    .hero{display:grid;grid-template-columns:1fr 1fr;gap:0;min-height:360px;align-items:center;padding:48px;position:relative}\\n    .hero .left{padding:28px}\\n    .hero h1{margin:0;font-size:34px;letter-spacing:-0.02em;color:#1a1a1a}\\n    .hero p.lead{color:var(--muted);margin-top:12px;max-width:46ch}\\n    .hero .right{position:relative;height:260px}\\n    /* diagonal panel */\\n    .diagonal{position:absolute;inset:18px;border-radius:18px;background:linear-gradient(180deg,rgba(122,92,255,0.09),rgba(46,196,182,0.06));clip-path:polygon(0 0,100% 0,70% 100%,0% 100%);box-shadow:0 8px 30px rgba(20,20,60,0.06)}\\n    .card-grid{display:grid;gap:18px;margin-top:20px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(20,20,60,0.04)}\\n    .price{font-weight:700;font-size:20px;color:var(--accent)}\\n    .muted{color:var(--muted);font-size:14px}\\n    main{max-width:1100px;margin:28px auto;padding:0 20px}\\n    section{margin:28px 0}\\n    h2{margin:0 0 8px 0;font-size:20px}\\n    .faq dt{font-weight:600}\\n    .faq dd{margin:8px 0 16px 0;color:var(--muted)}\\n    footer{padding:36px 20px;text-align:center;color:var(--muted);font-size:14px}\\n    /* responsive */\\n    @media(max-width:860px){.hero{grid-template-columns:1fr;min-height:360px}.hero .right{height:180px}\\n      nav a{display:none}\\n    }\\n    /* subtle pattern via svg mask */\\n    .pattern{position:absolute;inset:0;pointer-events:none;opacity:0.12}\\n    .cta-btn{display:inline-block;background:linear-gradient(90deg,var(--accent),var(--accent-2));color:white;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:600}\\n    .tiers{display:flex;gap:14px}\\n    .tier{flex:1;padding:18px;border-radius:12px;background:linear-gradient(180deg,#fff,#fbfbff);border:1px solid rgba(10,10,50,0.03)}\\n    .tiny{font-size:13px;color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern\\\" width=\\\"0\\\" height=\\\"0\\\" viewBox=\\\"0 0 800 600\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#7a5cff\\\" stop-opacity=\\\"0.18\\\" />\\n        <stop offset=\\\"1\\\" stop-color=\\\"#2ec4b6\\\" stop-opacity=\\\"0.12\\\" />\\n      </linearGradient>\\n      <pattern id=\\\"p\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"40\\\" height=\\\"40\\\" fill=\\\"transparent\\\"></rect>\\n        <path d=\\\"M0 20 L20 0 M20 40 L40 20\\\" stroke=\\\"#7a5cff\\\" stroke-opacity=\\\"0.06\\\" stroke-width=\\\"1\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p)\\\"></rect>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"tiny\\\" style=\\\"margin-top:4px\\\">A gentle series of gatherings for whole-person health</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"about.html\\\">Who we are</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <div class=\\\"hero\\\">\\n    <div class=\\\"left\\\">\\n      <h1>Pricing for the Seasons: guided series + individual sessions</h1>\\n      <p class=\\\"lead\\\">We offer small-series workshops and one-on-one visits grounded in education and whole-person planning. Choose an approachable path—no promises, only support, learning, and tending.</p>\\n      <div style=\\\"margin-top:18px\\\">\\n        <a class=\\\"cta-btn\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n      <div class=\\\"card-grid\\\" style=\\\"margin-top:18px\\\">\\n        <div class=\\\"card tiny\\\">Sliding-scale options and community scholarships are available. Ask during booking: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </div>\\n    <div class=\\\"right\\\">\\n      <div class=\\\"diagonal\\\"></div>\\n    </div>\\n  </div>\\n\\n  <main>\\n    <section id=\\\"pricing\\\">\\n      <h2>How the series are priced</h2>\\n      <p class=\\\"muted\\\">Events are structured as educational cohorts: each series includes 4–6 meetings, learning materials, and a follow-up support call. Sessions are small and intentionally paced.</p>\\n\\n      <div class=\\\"tiers\\\" style=\\\"margin-top:14px\\\">\\n        <div class=\\\"tier\\\">\\n          <div class=\\\"price\\\">Series — Seasonal Cohort</div>\\n          <div class=\\\"tiny\\\" style=\\\"margin-top:6px\\\">4 sessions + materials + group support call</div>\\n          <div style=\\\"margin-top:12px;font-weight:700\\\">$240 / person</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Reserve your seat — limited capacity.</div>\\n        </div>\\n        <div class=\\\"tier\\\">\\n          <div class=\\\"price\\\">Individual intake + plan</div>\\n          <div class=\\\"tiny\\\" style=\\\"margin-top:6px\\\">Initial 60–75 min visit with personalized plan</div>\\n          <div style=\\\"margin-top:12px;font-weight:700\\\">$150</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Includes care recommendations; optional labs billed separately.</div>\\n        </div>\\n        <div class=\\\"tier\\\">\\n          <div class=\\\"price\\\">Follow-up coaching</div>\\n          <div class=\\\"tiny\\\" style=\\\"margin-top:6px\\\">30-minute check-ins to tune your plan</div>\\n          <div style=\\\"margin-top:12px;font-weight:700\\\">$65</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Pack discounts available for recurring support.</div>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:16px\\\" class=\\\"card\\\">\\n        <div style=\\\"font-weight:700\\\">Community evening (pay what you can)</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">A monthly educational gathering: sliding scale, suggested $10–30. Pre-register to hold your place.</div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"what_to_expect\\\">\\n      <h2>What to expect with payment</h2>\\n      <p class=\\\"muted\\\">Payments secure your place and help us prepare materials. If you must cancel, we ask for at least 48 hours notice for partial refund credit. All plans emphasize education, self-care, and coordinated options; there are no guaranteed cures.</p>\\n    </section>\\n\\n    <section id=\\\"faq\\\" class=\\\"faq\\\">\\n      <h2>Frequently asked</h2>\\n      <dl>\\n        <dt>Are refunds available?</dt>\\n        <dd>We offer credit or partial refunds for cancellations made 48+ hours ahead. Workshop cancellations may be refunded based on timing and resources committed.</dd>\\n        <dt>Do you offer scholarships?</dt>\\n        <dd>Yes — limited spots each series. Reach out to <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> with a brief note.</dd>\\n        <dt>Will labs be required?</dt>\\n        <dd>Optional educational labs may be suggested; they are billed separately and used to inform a plan where relevant.</dd>\\n      </dl>\\n    </section>\\n\\n    <section id=\\\"cta\\\" style=\\\"display:flex;gap:18px;align-items:center;justify-content:space-between\\\">\\n      <div>\\n        <h2>Ready to join a series or book a visit?</h2>\\n        <p class=\\\"muted\\\">Select a cohort, or schedule an intake to craft a plan that's tailored to you.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"cta-btn\\\" href=\\\"book.html\\\">Book now</a>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    <div style=\\\"margin-top:8px\\\">Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"A short, poetic introduction to our philosophy and practitioner background in integrative, whole-person care.\\\">\\n  <style>\\n    :root{--ink:#202023;--soft:#f7f9fb;--accent:#2ec4b6;--deep:#7a5cff}\\n    *{box-sizing:border-box;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial}\\n    body{margin:0;background:linear-gradient(180deg,#fff,#fbfdff);color:var(--ink)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 24px}\\n    .logo{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,var(--deep),var(--accent));color:white;display:grid;place-items:center;font-weight:700}\\n    nav a{margin-left:14px;color:rgba(20,20,40,0.6);text-decoration:none}\\n    main{max-width:980px;margin:28px auto;padding:0 20px}\\n    .hero{padding:28px;border-radius:16px;background:linear-gradient(180deg,rgba(46,196,182,0.06),rgba(122,92,255,0.03));display:grid;grid-template-columns:2fr 1fr;gap:22px;align-items:center}\\n    h1{margin:0;font-size:28px}\\n    .poem{color:rgba(10,10,40,0.7);margin-top:10px}\\n    .panel{background:#fff;padding:16px;border-radius:12px;box-shadow:0 6px 18px rgba(30,30,60,0.04)}\\n    section{margin-top:18px}\\n    h2{font-size:18px;margin-bottom:8px}\\n    .muted{color:rgba(30,30,60,0.5)}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}\\n    .svg-bg{position:absolute;right:0;top:0;width:360px;height:360px;opacity:0.06}\\n    footer{padding:28px;text-align:center;color:var(--muted)}\\n    @media(max-width:800px){.hero{grid-template-columns:1fr}.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"svg-bg\\\" viewBox=\\\"0 0 600 600\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"bg1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#7a5cff\\\" />\\n        <stop offset=\\\"1\\\" stop-color=\\\"#2ec4b6\\\" />\\n      </linearGradient>\\n    </defs>\\n    <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"600\\\" height=\\\"600\\\" rx=\\\"80\\\" fill=\\\"url(#bg1)\\\"></rect>\\n    <g fill=\\\"white\\\" opacity=\\\"0.04\\\">\\n      <circle cx=\\\"120\\\" cy=\\\"60\\\" r=\\\"60\\\" />\\n      <circle cx=\\\"300\\\" cy=\\\"220\\\" r=\\\"40\\\" />\\n      <path d=\\\"M0 400 L600 200 L600 600 L0 600 Z\\\" />\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Nurture, learn, and adapt — small steps, steady tending</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Gather</a>\\n      <a href=\\\"services.html\\\">Paths</a>\\n      <a href=\\\"pricing.html\\\">Invest</a>\\n      <a href=\\\"book.html\\\">Meet</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"hero\\\">\\n      <div>\\n        <h1>We tend the whole: body, mind, routine — an integrative approach</h1>\\n        <p class=\\\"poem\\\">A practice rooted in listening: we combine evidence-informed options with lifestyle-centered guidance so you can learn, experiment, and steward your health.</p>\\n        <div style=\\\"margin-top:12px;display:flex;gap:10px\\\">\\n          <a href=\\\"book.html\\\" style=\\\"background:linear-gradient(90deg,var(--deep),var(--accent));color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:600\\\">Book a visit</a>\\n          <a href=\\\"pricing.html\\\" style=\\\"padding:10px 14px;border-radius:10px;text-decoration:none;color:var(--deep);background:rgba(122,92,255,0.06)\\\">See pricing</a>\\n        </div>\\n      </div>\\n      <div>\\n        <div class=\\\"panel\\\">\\n          <div style=\\\"font-weight:700\\\">Practitioner</div>\\n          <div style=\\\"margin-top:6px\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Training in integrative and functional approaches; emphasis on patient education, nutritional support, and gentle movement.</div>\\n        </div>\\n      </div>\\n    </div>\\n\\n    <section id=\\\"ritual\\\">\\n      <h2>Rituals we teach</h2>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:10px\\\">\\n        <div class=\\\"panel\\\">\\n          <strong>Breath & pause</strong>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Simple daily practices to regulate stress and support sleep.</p>\\n        </div>\\n        <div class=\\\"panel\\\">\\n          <strong>Gentle movement</strong>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Short routines to ease tension and improve circulation.</p>\\n        </div>\\n        <div class=\\\"panel\\\">\\n          <strong>Foundational nutrition</strong>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Practical food choices and rhythms to stabilize energy and digestion.</p>\\n        </div>\\n        <div class=\\\"panel\\\">\\n          <strong>Rest architecture</strong>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Habits and environmental adjustments that favor restorative sleep.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"what_to_expect\\\">\\n      <h2>What to expect in a first meeting</h2>\\n      <p class=\\\"muted\\\">An intake explores your history, priorities, and routines. Education and a practical plan are co-created. Optional labs may be discussed for additional clarity—these are educational tools, not mandates.</p>\\n    </section>\\n\\n    <section id=\\\"schedule\\\">\\n      <h2>Upcoming gatherings</h2>\\n      <div style=\\\"display:flex;gap:12px;margin-top:8px\\\">\\n        <div class=\\\"panel\\\"><strong>Spring Equinox Series</strong><div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Four weekly evenings — cohort learning and practice</div></div>\\n        <div class=\\\"panel\\\"><strong>Monthly Community Circle</strong><div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Pay-what-you-can educational nights</div></div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"pricing\\\">\\n      <h2>Investing in care</h2>\\n      <p class=\\\"muted\\\">We offer series pricing, individual visits, and sliding-scale options. See the full breakdown on the pricing page. Financial barriers should not stop learning—reach out for arrangements.</p>\\n    </section>\\n\\n    <section id=\\\"faq\\\">\\n      <h2>Questions people ask</h2>\\n      <div class=\\\"panel\\\">\\n        <strong>Do you replace my current care?</strong>\\n        <p class=\\\"muted\\\">No. We work alongside your existing providers when helpful and support informed choices. We emphasize education rather than promises of cure.</p>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"cta\\\" style=\\\"margin-top:20px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <h2>Curious to learn more?</h2>\\n        <p class=\\\"muted\\\">Join a series or schedule an intake to begin a thoughtful, patient-led journey.</p>\\n      </div>\\n      <div>\\n        <a href=\\\"book.html\\\" style=\\\"background:linear-gradient(90deg,var(--deep),var(--accent));color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:600\\\">Reserve time</a>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Reserve your spot in a series or schedule a one-on-one intake. Simple booking form with options and availability notes.\\\">\\n  <style>\\n    :root{--bg:#fff;--ink:#151518;--accent:#7a5cff;--accent-2:#2ec4b6}\\n    *{box-sizing:border-box;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial}\\n    body{margin:0;background:linear-gradient(180deg,#fbfdff,#ffffff);color:var(--ink)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 24px}\\n    .logo{width:42px;height:42px;border-radius:10px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:grid;place-items:center;color:white;font-weight:700}\\n    nav a{margin-left:12px;color:rgba(10,10,30,0.6);text-decoration:none}\\n    main{max-width:920px;margin:24px auto;padding:0 18px}\\n    .split{display:grid;grid-template-columns:1fr 420px;gap:22px;align-items:start}\\n    .panel{background:#fff;padding:18px;border-radius:12px;box-shadow:0 6px 20px rgba(20,20,60,0.04)}\\n    h1{margin:0 0 8px 0}\\n    label{display:block;font-size:13px;margin-top:10px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(20,20,60,0.06);margin-top:6px}\\n    button{background:linear-gradient(90deg,var(--accent),var(--accent-2));color:white;padding:10px 14px;border-radius:10px;border:0;margin-top:12px;font-weight:700}\\n    .note{font-size:13px;color:rgba(20,20,60,0.6)}\\n    .small{font-size:13px;color:rgba(20,20,60,0.5)}\\n    @media(max-width:860px){.split{grid-template-columns:1fr}}\\n    .pattern-svg{width:100%;height:80px;display:block;margin-bottom:8px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"small\\\">Book a series seat or a private intake</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"split\\\">\\n      <div>\\n        <div class=\\\"panel\\\">\\n          <h1>Reserve your place</h1>\\n          <p class=\\\"note\\\">Choose a series or a private visit. We emphasize education and whole-person plans; lab work is optional and discussed if helpful.</p>\\n\\n          <form id=\\\"booking\\\" method=\\\"post\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\">\\n            <label for=\\\"name\\\">Full name</label>\\n            <input id=\\\"name\\\" name=\\\"name\\\" required placeholder=\\\"Your name\\\">\\n\\n            <label for=\\\"email\\\">Email</label>\\n            <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required placeholder=\\\"you@example.com\\\">\\n\\n            <label for=\\\"phone\\\">Phone</label>\\n            <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"(optional)\\\" >\\n\\n            <label for=\\\"service\\\">I am booking</label>\\n            <select id=\\\"service\\\" name=\\\"service\\\">\\n              <option>Seasonal series (group)</option>\\n              <option>Initial intake — 60–75 min</option>\\n              <option>Follow-up coaching — 30 min</option>\\n              <option>Community evening (sliding scale)</option>\\n            </select>\\n\\n            <label for=\\\"date\\\">Preferred dates / notes</label>\\n            <input id=\\\"date\\\" name=\\\"date\\\" placeholder=\\\"e.g. Weeknights in March or flexible\\\">\\n\\n            <label for=\\\"message\\\">Brief note — goals or concerns</label>\\n            <textarea id=\\\"message\\\" name=\\\"message\\\" rows=\\\"4\\\" placeholder=\\\"What would you like to focus on?\\\"></textarea>\\n\\n            <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n              <button type=\\\"submit\\\">Request booking</button>\\n              <div class=\\\"small\\\">We will confirm availability and any sliding-scale options.</div>\\n            </div>\\n          </form>\\n\\n          <div style=\\\"margin-top:12px\\\" class=\\\"small\\\">By booking you acknowledge that our approach is educational and supportive; we do not offer guaranteed cures. If you have urgent concerns, contact your primary provider.</div>\\n        </div>\\n\\n        <section id=\\\"what_to_expect\\\" style=\\\"margin-top:14px\\\">\\n          <div class=\\\"panel\\\">\\n            <h2>Before your first visit</h2>\\n            <p class=\\\"small\\\">You'll receive a short intake form and practical pre-visit notes to make our time focused on learning and next steps.</p>\\n          </div>\\n        </section>\\n\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <svg class=\\\"pattern-svg\\\" viewBox=\\\"0 0 400 80\\\" aria-hidden>\\n            <defs>\\n              <linearGradient id=\\\"lg\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n                <stop offset=\\\"0\\\" stop-color=\\\"#7a5cff\\\" stop-opacity=\\\"0.9\\\"/>\\n                <stop offset=\\\"1\\\" stop-color=\\\"#2ec4b6\\\" stop-opacity=\\\"0.9\\\"/>\\n              </linearGradient>\\n            </defs>\\n            <rect width=\\\"400\\\" height=\\\"80\\\" rx=\\\"10\\\" fill=\\\"url(#lg)\\\"/>\\n          </svg>\\n\\n          <div style=\\\"font-weight:700\\\">Quick availability</div>\\n          <ul style=\\\"margin-top:8px;padding-left:18px;color:rgba(20,20,60,0.65)\\\">\\n            <li>Weekly evening series — seats open</li>\\n            <li>Next intake slots: mornings on Monday & Thursday</li>\\n            <li>Follow-ups: flexible 30-minute windows</li>\\n          </ul>\\n\\n          <div style=\\\"margin-top:12px\\\" class=\\\"small\\\">If you need immediate assistance, call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>. For bookings by email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n\\n          <div style=\\\"margin-top:12px\\\" class=\\\"small\\\"><strong>Pricing snapshot</strong><div style=\\\"margin-top:6px\\\">Series: $240 • Intake: $150 • Follow-up: $65 • Community: pay-what-you-can</div></div>\\n\\n          <div style=\\\"margin-top:12px\\\" class=\\\"small\\\">Payments secure reservations. Cancellation policy: 48 hours for credit or partial refund.</div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h2>Need help choosing?</h2>\\n          <p class=\\\"small\\\">If you're unsure whether to join a series or book an intake, select whichever feels most useful. We will follow up and help you choose the right path.</p>\\n          <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"display:inline-block;margin-top:10px;padding:8px 12px;border-radius:8px;background:rgba(122,92,255,0.06);text-decoration:none;color:var(--ink)\\\">Email us</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section id=\\\"faq\\\" style=\\\"margin-top:20px\\\">\\n      <div class=\\\"panel\\\">\\n        <h2>Booking FAQ</h2>\\n        <p class=\\\"small\\\"><strong>What if I need to reschedule?</strong> Please notify us 48+ hours before the appointment when possible. We'll offer a credit or reschedule depending on timing.</p>\\n        <p class=\\\"small\\\" style=\\\"margin-top:8px\\\"><strong>Are there discounts?</strong> Yes — multi-session packs and sliding-scale openings. Ask when you book.</p>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"text-align:center;padding:20px;color:rgba(20,20,60,0.6)\\\">\\n    <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </footer>\\n\\n  <script>\\n    // Minimal client-side form friendly behavior\\n    document.getElementById('booking').addEventListener('submit', function(ev){\\n      // allow default post to PRIMARY_CTA_URL, but provide validation\\n      var name = document.getElementById('name').value.trim();\\n      var email = document.getElementById('email').value.trim();\\n      if(!name || !email){\\n        ev.preventDefault();\\n        alert('Please add your name and email to continue.');\\n      }\\n    });\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
