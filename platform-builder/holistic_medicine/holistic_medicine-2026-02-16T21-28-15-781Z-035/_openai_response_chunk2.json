          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Care & Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f6fbff;--card:#ffffff;--accent:#2b8a84;--muted:#6b7280;--glass:rgba(255,255,255,0.7);--shadow:0 6px 18px rgba(20,30,40,0.08);}    \\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#0f1724;background:linear-gradient(180deg,#f6fbff 0%, #eef7f9 60%);}    \\n    header{position:relative;z-index:30;padding:24px 36px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:48px;height:48px;display:inline-grid;place-items:center;border-radius:10px;background:linear-gradient(135deg,var(--accent),#6ad2c9);box-shadow:var(--shadow);color:white;font-weight:700}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .nav-cta{background:var(--accent);color:#fff;padding:10px 14px;border-radius:8px;text-decoration:none;margin-left:18px}\\n\\n    /* Pattern slot */\\n    .hero{position:relative;overflow:hidden;padding:48px 36px 72px}\\n    .pattern{position:absolute;inset:0;opacity:0.12;pointer-events:none}\\n\\n    .container{max-width:1100px;margin:0 auto}\\n    .hero-grid{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center}\\n    .card{background:var(--card);border-radius:14px;padding:22px;box-shadow:var(--shadow)}\\n\\n    h1{margin:0 0 8px;font-size:28px;color:#052024}\\n    p.lead{margin:0;color:var(--muted);line-height:1.5}\\n\\n    .services-list{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:18px}\\n    .service{padding:14px;border-radius:10px;background:linear-gradient(180deg,var(--glass),rgba(255,255,255,0.85));border:1px solid rgba(15,23,36,0.04)}\\n    .service h3{margin:0 0 6px;font-size:16px}\\n    .service p{margin:0;color:var(--muted);font-size:14px}\\n\\n    .aside{position:relative}\\n    .aside .box{background:linear-gradient(180deg,#fbfffe,#f0fffd);padding:18px;border-radius:12px}\\n    .muted{color:var(--muted);font-size:13px}\\n\\n    .plan{display:flex;gap:12px;margin-top:18px}\\n    .plan .step{flex:1;background:#fff;border-radius:10px;padding:12px;border:1px solid rgba(2,6,23,0.04)}\\n\\n    .micro{margin-top:18px;display:flex;gap:12px}\\n    .micro .pill{background:linear-gradient(90deg,#fbfbff,#f9fff8);padding:10px;border-radius:999px;border:1px solid rgba(11,22,20,0.04)}\\n\\n    .pricing{display:flex;gap:12px;margin-top:18px}\\n    .price{flex:1;padding:14px;border-radius:10px;background:linear-gradient(180deg,#ffffff,#fbfff9);text-align:center}\\n    .price strong{display:block;font-size:18px;color:var(--accent)}\\n\\n    footer{margin-top:48px;padding:26px 36px;border-top:1px solid rgba(2,6,23,0.04);display:flex;justify-content:space-between;color:var(--muted)}\\n    a.cta{display:inline-block;padding:10px 16px;background:linear-gradient(90deg,var(--accent),#60c8c1);color:white;border-radius:10px;text-decoration:none}\\n\\n    /* Responsive */\\n    @media (max-width:880px){.hero-grid{grid-template-columns:1fr}.services-list{grid-template-columns:1fr}.aside{order:2}.pattern{opacity:0.08}}\\n  </style>\\n</head>\\n<body>\\n  <header class=\\\"container\\\">\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Care &amp; Services</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"approach.html\\\">How We Work</a>\\n      <a class=\\\"nav-cta\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <section class=\\\"hero\\\">\\n    <!-- Inline SVG pattern unique to services page -->\\n    <svg class=\\\"pattern\\\" width=\\\"100%\\\" height=\\\"100%\\\" viewBox=\\\"0 0 800 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#e0fbf8\\\" />\\n          <stop offset=\\\"1\\\" stop-color=\\\"#eef9fe\\\" />\\n        </linearGradient>\\n        <filter id=\\\"soft\\\" x=\\\"-20%\\\" y=\\\"-20%\\\" width=\\\"140%\\\" height=\\\"140%\\\">\\n          <feGaussianBlur stdDeviation=\\\"18\\\" result=\\\"b\\\" />\\n          <feBlend in=\\\"SourceGraphic\\\" in2=\\\"b\\\" mode=\\\"normal\\\" />\\n        </filter>\\n      </defs>\\n      <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g1)\\\" />\\n      <g fill-opacity=\\\"0.06\\\" filter=\\\"url(#soft)\\\" fill=\\\"#2b8a84\\\">\\n        <circle cx=\\\"120\\\" cy=\\\"100\\\" r=\\\"80\\\" />\\n        <rect x=\\\"600\\\" y=\\\"40\\\" width=\\\"220\\\" height=\\\"220\\\" rx=\\\"30\\\" />\\n        <ellipse cx=\\\"440\\\" cy=\\\"420\\\" rx=\\\"220\\\" ry=\\\"100\\\" />\\n      </g>\\n    </svg>\\n\\n    <div class=\\\"container hero-grid\\\">\\n      <div>\\n        <div class=\\\"card\\\">\\n          <h1>Personalized integrative care for adults and families</h1>\\n          <p class=\\\"lead\\\">Blending evidence-informed medicine with lifestyle and mind-body strategies to address the root of symptoms — not just mask them. We offer a hybrid model of telehealth and in-person visits tailored to your needs.</p>\\n\\n          <div class=\\\"services-list\\\" aria-label=\\\"Services\\\">\\n            <div class=\\\"service\\\">\\n              <h3>Comprehensive Intake</h3>\\n              <p>Deep health history and systems review to identify patterns and priorities.</p>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <h3>Functional Nutrition</h3>\\n              <p>Whole-foods based plans to support digestion, inflammation, and energy.</p>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <h3>Stress Management</h3>\\n              <p>Mind-body tools and biofeedback options to reduce physiologic burden.</p>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <h3>Chronic Symptom Support</h3>\\n              <p>Longitudinal care for sleep, fatigue, digestive concerns, and more.</p>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"plan\\\">\\n            <div class=\\\"step\\\">\\n              <strong>Step 1</strong>\\n              <div class=\\\"muted\\\">Intake & baseline assessment</div>\\n            </div>\\n            <div class=\\\"step\\\">\\n              <strong>Step 2</strong>\\n              <div class=\\\"muted\\\">A collaborative plan with lifestyle + optional testing</div>\\n            </div>\\n            <div class=\\\"step\\\">\\n              <strong>Step 3</strong>\\n              <div class=\\\"muted\\\">Follow-up and plan refinement</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"micro\\\">\\n            <div class=\\\"pill\\\">Micro-habit: 10-minute evening wind-down</div>\\n            <div class=\\\"pill\\\">Micro-habit: Balanced protein at breakfast</div>\\n            <div class=\\\"pill\\\">Micro-habit: Mindful 3-breath resets</div>\\n          </div>\\n\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"aside\\\">\\n        <div class=\\\"box card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Quick diagnostic snapshot</h3>\\n          <p class=\\\"muted\\\">An early screen helps prioritize next steps — nutrition, sleep hygiene, stress load, targeted labs when appropriate.</p>\\n\\n          <div style=\\\"margin-top:14px\\\">\\n            <div class=\\\"price\\\">\\n              <div class=\\\"muted\\\">Initial Consult</div>\\n              <strong>$195+</strong>\\n            </div>\\n            <div style=\\\"margin-top:10px\\\">\\n              <a class=\\\"cta\\\" href=\\\"book.html\\\">Book an Intake</a>\\n            </div>\\n          </div>\\n\\n          <p style=\\\"font-size:12px;margin-top:12px;color:var(--muted)\\\">We do not promise cures. Care focuses on education, symptom understanding, and stepwise improvement.</p>\\n        </div>\\n      </aside>\\n    </div>\\n  </section>\\n\\n  <section class=\\\"container\\\" style=\\\"margin-top:12px\\\">\\n    <div class=\\\"card\\\">\\n      <h2 style=\\\"margin-top:0\\\">How we structure care</h2>\\n      <p class=\\\"muted\\\">Our hybrid model offers flexibility: telehealth for check-ins, in-person for hands-on assessments. Plans can include targeted labs as an educational tool and are tailored to your goals.</p>\\n\\n      <div class=\\\"pricing\\\">\\n        <div class=\\\"price\\\">\\n          <div class=\\\"muted\\\">Follow-up visit</div>\\n          <strong>$95+</strong>\\n        </div>\\n        <div class=\\\"price\\\">\\n          <div class=\\\"muted\\\">Program consultations</div>\\n          <strong>Packages available</strong>\\n        </div>\\n      </div>\\n    </div>\\n  </section>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    <div><a href=\\\"contact.html\\\" style=\\\"color:var(--muted);text-decoration:none\\\">Contact</a> • <a href=\\\"book.html\\\" class=\\\"cta\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Concerns & Common Symptoms — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffefc;--soft:#f3f7f6;--accent:#176b68;--muted:#6b7280}\\n    body{margin:0;font-family:Inter,system-ui,Arial;color:#052024;background:linear-gradient(180deg,var(--bg),#f1fbfa)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 28px}\\n    .logo{font-weight:700;background:linear-gradient(180deg,#20a89a,#1a7b79);color:white;padding:8px 12px;border-radius:8px}\\n    nav a{margin-left:14px;text-decoration:none;color:var(--muted);font-weight:600}\\n    .hero{padding:32px 28px}\\n    .hero-card{background:linear-gradient(90deg,#ffffff,#fbfffe);border-radius:12px;padding:22px;max-width:980px;margin:0 auto;box-shadow:0 8px 24px rgba(12,20,20,0.06)}\\n    h1{margin:0 0 6px}\\n    p.lead{margin:0;color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:18px}\\n    .concerns{display:grid;gap:12px}\\n    .concern{background:var(--soft);padding:14px;border-radius:10px}\\n    .concern h3{margin:0 0 6px}\\n    .disclaimer{font-size:13px;color:var(--muted);margin-top:8px}\\n    .micro{margin-top:14px}\\n    .micro li{margin-bottom:8px}\\n    .btn{display:inline-block;padding:9px 12px;background:var(--accent);color:white;border-radius:8px;text-decoration:none}\\n    footer{padding:18px 28px;color:var(--muted);display:flex;justify-content:space-between}\\n    @media (max-width:880px){.grid{grid-template-columns:1fr}.hero-card{padding:16px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n      <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">Care</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"hero\\\">\\n    <div class=\\\"hero-card\\\">\\n      <h1>Health concerns we commonly support</h1>\\n      <p class=\\\"lead\\\">Educational, whole-person approaches for persistent or recurrent symptoms. Below are areas we frequently work with; each care plan is individualized and may include lifestyle coaching, targeted testing for context, and follow-up visits.</p>\\n\\n      <div class=\\\"grid\\\">\\n        <section>\\n          <div class=\\\"concerns\\\">\\n\\n            <div class=\\\"concern\\\">\\n              <h3>Stress & Anxiety</h3>\\n              <p>Patterns of chronic stress can affect sleep, digestion, immune function, and mood. We use behavioral tools, pacing strategies, and gentle physiologic supports. Symptom-focused education is central.</p>\\n            </div>\\n\\n            <div class=\\\"concern\\\">\\n              <h3>Poor Sleep & Insomnia</h3>\\n              <p>Sleep hygiene, sleep scheduling, and addressing contributing conditions (pain, stress, circadian factors) are prioritized. When indicated, we discuss evidence-based aids and referrals.</p>\\n            </div>\\n\\n            <div class=\\\"concern\\\">\\n              <h3>Digestive Disturbances</h3>\\n              <p>Bloating, irregular bowel habits, and reflux are assessed for diet, microbiome context, and lifestyle contributors. Recommendations emphasize simple, sustainable changes.</p>\\n            </div>\\n\\n            <div class=\\\"concern\\\">\\n              <h3>Chronic Inflammation & Pain</h3>\\n              <p>Inflammatory signals often reflect lifestyle inputs and underlying drivers. We focus on dietary patterns, movement, stress reduction, and targeted education about safe adjunctive measures.</p>\\n            </div>\\n\\n            <div class=\\\"concern\\\">\\n              <h3>Low Energy & Fatigue</h3>\\n              <p>Energy concerns are explored across sleep, nutrition, mood, and metabolic contributors. Testing can be considered as an educational tool; treatment is personalized and pragmatic.</p>\\n            </div>\\n\\n            <div class=\\\"concern\\\">\\n              <h3>Hormonal & Menstrual Health</h3>\\n              <p>A holistic view of menstrual and hormonal symptoms considers lifestyle, nutrition, sleep, and referral pathways when specialized care is needed.</p>\\n            </div>\\n\\n          </div>\\n\\n          <p class=\\\"disclaimer\\\">Disclaimer: Individual results vary. We do not offer guarantees or promises of cure. Our role is to educate, identify patterns, and partner with you on evidence-informed interventions.</p>\\n\\n          <div class=\\\"micro\\\">\\n            <h4 style=\\\"margin-bottom:8px\\\">Small habits that help</h4>\\n            <ul>\\n              <li>1–2 minute breathing breaks mid-day</li>\\n              <li>Consistent protein + fiber at breakfast</li>\\n              <li>Wind-down routine 30–45 minutes before bed</li>\\n            </ul>\\n          </div>\\n\\n        </section>\\n\\n        <aside style=\\\"align-self:start\\\">\\n          <!-- Unique svg accent for conditions page -->\\n          <svg width=\\\"320\\\" height=\\\"220\\\" viewBox=\\\"0 0 320 220\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" style=\\\"border-radius:12px;display:block;margin-bottom:12px\\\">\\n            <defs>\\n              <linearGradient id=\\\"cg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#eafbf9\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#e8f7ff\\\"/></linearGradient>\\n            </defs>\\n            <rect width=\\\"100%\\\" height=\\\"100%\\\" rx=\\\"12\\\" fill=\\\"url(#cg)\\\"/>\\n            <g fill=\\\"#176b68\\\" opacity=\\\"0.08\\\">\\n              <circle cx=\\\"40\\\" cy=\\\"40\\\" r=\\\"34\\\" />\\n              <rect x=\\\"180\\\" y=\\\"60\\\" width=\\\"120\\\" height=\\\"80\\\" rx=\\\"18\\\" />\\n            </g>\\n          </svg>\\n\\n          <div style=\\\"background:#fff;padding:16px;border-radius:10px;box-shadow:0 6px 18px rgba(10,20,20,0.05)\\\">\\n            <h4 style=\\\"margin:0 0 8px\\\">Next steps</h4>\\n            <p class=\\\"muted\\\">If one of these areas resonates, an initial visit allows us to map priorities and create a stepwise plan. Optional targeted labs are discussed only when they add context.</p>\\n            <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Schedule a visit</a></div>\\n            <p style=\\\"font-size:12px;color:var(--muted);margin-top:8px\\\">Telehealth and in-person options available.</p>\\n          </div>\\n\\n        </aside>\\n\\n      </div>\\n    </div>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    <div><a href=\\\"about.html\\\">About {{PRACTITIONER_NAME}}</a> • <a href=\\\"book.html\\\">Book</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Our Approach — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f8fdfa;--card:#ffffff;--teal:#0b6e69;--muted:#5b6b6a}\\n    body{margin:0;font-family:system-ui,Segoe UI,Roboto,Arial;color:#042325;background:linear-gradient(180deg,var(--bg),#eefdfc)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 26px}\\n    .logo{font-weight:800;color:var(--teal)}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .wrap{max-width:1000px;margin:0 auto;padding:18px}\\n    .hero{display:flex;gap:20px;align-items:center}\\n    .hero .lead{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 10px 30px rgba(8,18,18,0.06)}\\n    .hero h1{margin:0 0 6px}\\n    .flow{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:18px}\\n    .tile{background:linear-gradient(180deg,#fff,#fbfffe);padding:16px;border-radius:12px;border:1px solid rgba(6,20,18,0.04)}\\n    .tile h3{margin:0 0 8px}\\n    .labs{margin-top:12px}\\n    .micro{margin-top:12px;padding:12px;border-radius:10px;background:linear-gradient(90deg,#f9fff8,#ffffff)}\\n    .cta{margin-top:16px}\\n    .btn{background:var(--teal);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    footer{margin-top:28px;padding:18px 26px;color:var(--muted);display:flex;justify-content:space-between}\\n    @media (max-width:880px){.flow{grid-template-columns:1fr}.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n      <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">What We Offer</a>\\n      <a href=\\\"conditions.html\\\">Concerns</a>\\n      <a href=\\\"contact.html\\\">Get in touch</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <div class=\\\"hero\\\">\\n      <div class=\\\"lead\\\">\\n        <h1>Collaborative, stepwise care</h1>\\n        <p style=\\\"margin:0;color:var(--muted)\\\">We emphasize clear education and measurable steps. Our hybrid model (telehealth + in-person) is designed to fit your life while prioritizing continuity.</p>\\n      </div>\\n\\n      <!-- Unique svg motif for approach -->\\n      <svg width=\\\"160\\\" height=\\\"140\\\" viewBox=\\\"0 0 160 140\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" style=\\\"border-radius:12px\\\">\\n        <defs>\\n          <linearGradient id=\\\"ag\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#ecfffb\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#eefcfb\\\"/></linearGradient>\\n        </defs>\\n        <rect width=\\\"100%\\\" height=\\\"100%\\\" rx=\\\"12\\\" fill=\\\"url(#ag)\\\"/>\\n        <g fill=\\\"#0b6e69\\\" opacity=\\\"0.07\\\">\\n          <rect x=\\\"10\\\" y=\\\"18\\\" width=\\\"48\\\" height=\\\"48\\\" rx=\\\"10\\\" />\\n          <circle cx=\\\"120\\\" cy=\\\"90\\\" r=\\\"38\\\" />\\n        </g>\\n      </svg>\\n    </div>\\n\\n    <div class=\\\"flow\\\" aria-label=\\\"Care flow\\\">\\n      <div class=\\\"tile\\\">\\n        <h3>Intake & listening</h3>\\n        <p class=\\\"muted\\\">The intake is structured to learn your story, medical history, sleep, stressors, and nutrition patterns. We prioritize what matters most to you.</p>\\n      </div>\\n\\n      <div class=\\\"tile\\\">\\n        <h3>Collaborative plan</h3>\\n        <p class=\\\"muted\\\">Plans combine practical lifestyle changes, focused education, and—when helpful—adjunctive supports. Every recommendation includes a rationale so you can make informed choices.</p>\\n      </div>\\n\\n      <div class=\\\"tile\\\">\\n        <h3>Optional labs (educational)</h3>\\n        <p class=\\\"muted\\\">Labs are used selectively to add context. We discuss when a test can change management and when it may provide limited information. Examples: basic metabolic panels, thyroid screening, targeted nutrient assessment.</p>\\n        <div class=\\\"labs\\\">\\n          <small style=\\\"color:var(--muted)\\\">Labs are optional and interpreted in the context of symptoms — not ordered reflexively.</small>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"tile\\\">\\n        <h3>Follow-ups & adjustments</h3>\\n        <p class=\\\"muted\\\">Regular short follow-ups allow us to assess progress, troubleshoot obstacles, and adapt the plan. Education and small habit changes often produce steady gains.</p>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"micro\\\">\\n      <h4 style=\\\"margin:0 0 8px\\\">Practical micro-habits we teach</h4>\\n      <ul style=\\\"margin:0;color:var(--muted)\\\">\\n        <li>3 simple movement breaks daily to reduce stiffness and improve circulation</li>\\n        <li>Protein + fiber at the first meal to stabilize energy</li>\\n        <li>Evening routine to cue restorative sleep</li>\\n      </ul>\\n    </div>\\n\\n    <div class=\\\"cta\\\">\\n      <p style=\\\"color:var(--muted)\\\">To discuss whether this approach may suit your goals, start with an intake visit. We will co-create a plan and offer clear next steps.</p>\\n      <a class=\\\"btn\\\" href=\\\"book.html\\\">Schedule an Intake</a>\\n    </div>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{PRACTITIONER_NAME}}, {{CREDENTIALS}} • {{BUSINESS_NAME}}</div>\\n    <div><a href=\\\"contact.html\\\">{{EMAIL}}</a> • <a href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
