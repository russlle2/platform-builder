          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Care & Fees — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Transparent fees for integrative, whole-person care. Hybrid appointments available.\\\">\\n  <style>\\n    :root{--bg:#f6fbf9;--card:#ffffff;--muted:#6b7280;--accent:#2f9e84;--accent-2:#7dd3c7;--glass:rgba(255,255,255,0.7);--radius:14px}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;padding:0;color:#0f172a;background:linear-gradient(180deg,var(--bg),#eef6f4)}\\n    .wrap{max-width:1100px;margin:48px auto;padding:32px}\\n    header{display:flex;align-items:center;justify-content:space-between;gap:20px}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:54px;height:54px;border-radius:12px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n    nav a{margin-left:16px;color:#04423d;text-decoration:none;font-weight:600}\\n    main{margin-top:28px}\\n    .hero{display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:start}\\n    .card{background:var(--card);border-radius:var(--radius);box-shadow:0 6px 20px rgba(12,22,16,0.06);padding:26px}\\n    h1{margin:0;font-size:28px;color:#06372f}\\n    p.lead{margin-top:8px;color:var(--muted);line-height:1.5}\\n    .price-list{display:flex;flex-direction:column;gap:14px;margin-top:18px}\\n    .plan{display:flex;justify-content:space-between;align-items:center;padding:14px;border-radius:10px;background:linear-gradient(180deg,rgba(47,158,132,0.04),rgba(125,211,199,0.02));}\\n    .plan .meta{max-width:68%}\\n    .plan h3{margin:0;font-size:16px;color:#06372f}\\n    .plan p{margin:6px 0 0;color:var(--muted);font-size:13px}\\n    .price{font-weight:700;color:#04423d}\\n    .note{font-size:13px;color:var(--muted);margin-top:12px}\\n    .cta-row{display:flex;gap:12px;margin-top:18px}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:600}\\n    .ghost{background:transparent;border:1px solid rgba(4,66,61,0.08);padding:10px 14px;border-radius:10px;color:#04423d}\\n    footer{margin-top:34px;color:var(--muted);font-size:13px}\\n    /* small screens */\\n    @media (max-width:880px){\\n      .hero{grid-template-columns:1fr}\\n      nav{display:none}\\n    }\\n    /* decorative svg */\\n    .bg-svg{position:fixed;right:-100px;top:-80px;width:520px;height:520px;opacity:0.12;pointer-events:none}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 400 400\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#7dd3c7\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#2f9e84\\\"/></linearGradient>\\n      <pattern id=\\\"dots\\\" width=\\\"20\\\" height=\\\"20\\\" patternUnits=\\\"userSpaceOnUse\\\"><circle cx=\\\"2\\\" cy=\\\"2\\\" r=\\\"1.4\\\" fill=\\\"#cdeee6\\\"/></pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#dots)\\\"/>\\n    <g transform=\\\"translate(80,40)\\\">\\n      <path d=\\\"M0 120 C40 0,160 0,200 120 C220 180,140 260,60 220 C10 200 -20 150 0 120Z\\\" fill=\\\"url(#g1)\\\"/>\\n      <circle cx=\\\"260\\\" cy=\\\"320\\\" r=\\\"70\\\" fill=\\\"#9fe8dd\\\" opacity=\\\"0.6\\\"/>\\n    </g>\\n  </svg>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">HM</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav aria-label=\\\"Primary\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"conditions.html\\\">Common Concerns</a>\\n        <a href=\\\"approach.html\\\">Approach</a>\\n        <a href=\\\"pricing.html\\\" style=\\\"text-decoration:underline\\\">Fees</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"hero\\\">\\n        <div>\\n          <div class=\\\"card\\\">\\n            <h1>Fees & care formats — transparent and adaptive</h1>\\n            <p class=\\\"lead\\\">We offer hybrid visits (in-person + telehealth) and tailored care plans that combine lifestyle guidance, evidence-informed supplements, and optional lab coordination. Fees below reflect the scope of time, education, and clinical coordination. Insurance may apply for certain visits; we provide superbills.</p>\\n\\n            <div class=\\\"price-list\\\">\\n              <div class=\\\"plan\\\">\\n                <div class=\\\"meta\\\">\\n                  <h3>Initial Comprehensive Visit — 75 minutes</h3>\\n                  <p>In-depth intake, whole-person assessment, initial education and priorities.</p>\\n                </div>\\n                <div class=\\\"price\\\">$260</div>\\n              </div>\\n\\n              <div class=\\\"plan\\\">\\n                <div class=\\\"meta\\\">\\n                  <h3>Standard Follow-up — 30 minutes</h3>\\n                  <p>Progress review, treatment adjustments, brief education and labs review.</p>\\n                </div>\\n                <div class=\\\"price\\\">$95</div>\\n              </div>\\n\\n              <div class=\\\"plan\\\">\\n                <div class=\\\"meta\\\">\\n                  <h3>Extended Follow-up — 50 minutes</h3>\\n                  <p>Deeper coaching, medication review, or initial coordination for complex concerns.</p>\\n                </div>\\n                <div class=\\\"price\\\">$160</div>\\n              </div>\\n\\n              <div class=\\\"plan\\\">\\n                <div class=\\\"meta\\\">\\n                  <h3>Integrative Plan & Lab Coordination</h3>\\n                  <p>Creation of a personalized plan with optional lab ordering and interpretation. Labs billed separately.</p>\\n                </div>\\n                <div class=\\\"price\\\">From $120</div>\\n              </div>\\n\\n              <div class=\\\"plan\\\">\\n                <div class=\\\"meta\\\">\\n                  <h3>Monthly Support (subscription)</h3>\\n                  <p>Includes set of monthly follow-ups, text check-ins, and care coordination.</p>\\n                </div>\\n                <div class=\\\"price\\\">$240/month</div>\\n              </div>\\n            </div>\\n\\n            <p class=\\\"note\\\">All prices are examples for planning and may vary. We emphasize education, self-care strategies, and shared decision-making — there are no guaranteed outcomes. For insurance and superbill options, please contact us.</p>\\n\\n            <div class=\\\"cta-row\\\">\\n              <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n              <a class=\\\"ghost\\\" href=\\\"contact.html\\\">Questions? Contact us</a>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <aside>\\n          <div class=\\\"card\\\">\\n            <h3 style=\\\"margin-top:0\\\">Why these fees?</h3>\\n            <p class=\\\"lead\\\" style=\\\"margin-top:8px\\\">Fees reflect time for comprehensive assessment, patient education, integration of labs, and coordination across providers. Our hybrid model allows follow-ups by telehealth for convenience.</p>\\n\\n            <h4 style=\\\"margin-top:16px\\\">What to expect</h4>\\n            <ul style=\\\"color:var(--muted);padding-left:18px\\\">\\n              <li>Clear intake and goal-setting</li>\\n              <li>Evidence-informed, whole-person recommendations</li>\\n              <li>Optional labs explained before ordering</li>\\n            </ul>\\n\\n            <p style=\\\"font-size:12px;color:var(--muted);margin-top:12px\\\">If you have insurance questions, please call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</p>\\n          </div>\\n        </aside>\\n      </section>\\n\\n      <section style=\\\"margin-top:22px\\\" class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Financial policies & accessibility</h3>\\n        <p class=\\\"lead\\\">We strive for equity in access. Sliding scale or reduced-fee options may be available for qualifying clients; contact our office to discuss. Refunds for prepaid unused services are handled case-by-case. We do not promise cures; our focus is education, symptom management, and optimizing resilience.</p>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;gap:18px;flex-wrap:wrap\\\">\\n        <div>&copy; <strong>{{BUSINESS_NAME}}</strong> — Serving {{CITY}}, {{STATE}}</div>\\n        <div style=\\\"color:var(--muted)\\\">Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> · Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Meet our practitioner and learn our integrative approach to whole-person well-being.\\\">\\n  <style>\\n    :root{--bg:#fbfefa;--card:#ffffff;--muted:#54616a;--accent:#166354;--accent-2:#3ac9b1;--radius:12px}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial;color:#042f2a;background:linear-gradient(180deg,var(--bg),#eefaf7)}\\n    .container{max-width:980px;margin:38px auto;padding:26px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    .logo{display:flex;align-items:center;gap:12px}\\n    .logo-box{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,var(--accent-2),var(--accent));color:white;display:flex;align-items:center;justify-content:center;font-weight:700}\\n    nav a{margin-left:12px;color:#0b3e38;text-decoration:none;font-weight:600}\\n    main{margin-top:22px}\\n    .top{display:flex;gap:22px;align-items:center}\\n    .bio{background:var(--card);padding:20px;border-radius:var(--radius);box-shadow:0 8px 24px rgba(12,22,16,0.06)}\\n    h1{margin:0;color:#063b35}\\n    p.lead{color:var(--muted);line-height:1.5}\\n    .grid{display:grid;grid-template-columns:260px 1fr;gap:18px;margin-top:16px}\\n    .portrait{background:linear-gradient(180deg,rgba(26,87,78,0.08),rgba(74,201,187,0.03));height:260px;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#06433d;font-weight:700}\\n    .details h3{margin:6px 0 10px}\\n    .pill{display:inline-block;background:rgba(34,139,121,0.09);color:#0b5f55;padding:6px 10px;border-radius:999px;font-weight:600;font-size:13px}\\n    .section{margin-top:14px;padding:14px;border-radius:10px;background:linear-gradient(180deg,rgba(34,139,121,0.02),#fff)}\\n    .micro{display:flex;gap:10px;flex-wrap:wrap}\\n    .micro .item{background:#f1fffb;border-radius:8px;padding:10px;font-size:13px;color:#06433d}\\n    footer{margin-top:28px;color:var(--muted);font-size:13px}\\n    .decor{position:fixed;left:-140px;bottom:-80px;opacity:0.11;width:420px;height:420px;pointer-events:none}\\n    @media (max-width:820px){.grid{grid-template-columns:1fr}.top{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"decor\\\" viewBox=\\\"0 0 400 400\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"bgA\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#3ac9b1\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#166354\\\"/></linearGradient>\\n      <pattern id=\\\"rlines\\\" width=\\\"14\\\" height=\\\"14\\\" patternUnits=\\\"userSpaceOnUse\\\"><path d=\\\"M0 14 L14 0\\\" stroke=\\\"#dff5ef\\\" stroke-width=\\\"1\\\"/></pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#rlines)\\\"/>\\n    <g transform=\\\"translate(40,20)\\\">\\n      <ellipse cx=\\\"220\\\" cy=\\\"260\\\" rx=\\\"140\\\" ry=\\\"90\\\" fill=\\\"url(#bgA)\\\"/>\\n      <path d=\\\"M20 180 C60 60,220 40,300 150 C330 190,280 300,160 290 C80 282 20 230 20 180Z\\\" fill=\\\"#8ee7d9\\\" opacity=\\\"0.6\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div class=\\\"logo\\\">\\n        <div class=\\\"logo-box\\\">HM</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:#4f6b66\\\">Integrative care, patient-centered</div>\\n        </div>\\n      </div>\\n      <nav aria-label=\\\"Site navigation\\\">\\n        <a href=\\\"index.html\\\">Welcome</a>\\n        <a href=\\\"services.html\\\">What We Offer</a>\\n        <a href=\\\"approach.html\\\">Our Way</a>\\n        <a href=\\\"pricing.html\\\">Fees & Support</a>\\n        <a href=\\\"book.html\\\">Book Visit</a>\\n        <a href=\\\"contact.html\\\">Reach Us</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"top\\\">\\n        <div class=\\\"bio\\\">\\n          <h1>Care that centers you, informed by science and context</h1>\\n          <p class=\\\"lead\\\">At {{BUSINESS_NAME}} we blend clinical rigor with whole-person perspectives — lifestyle, environment, sleep, stress, and relationships all matter. Our role is educator and collaborator: we translate evidence into practical steps that fit your life.</p>\\n        </div>\\n\\n        <div style=\\\"min-width:220px;text-align:right\\\">\\n          <div class=\\\"pill\\\">Hybrid: In-person & Telehealth</div>\\n          <div style=\\\"margin-top:12px;color:var(--muted)\\\">Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> · <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        </div>\\n      </section>\\n\\n      <div class=\\\"grid\\\">\\n        <aside>\\n          <div class=\\\"portrait\\\" role=\\\"img\\\" aria-label=\\\"Portrait of practitioner\\\">{{PRACTITIONER_NAME}}</div>\\n          <div style=\\\"margin-top:12px;font-size:13px;color:var(--muted)\\\">Based in {{CITY}}, {{STATE}}</div>\\n        </aside>\\n\\n        <div class=\\\"details\\\">\\n          <div class=\\\"card section\\\">\\n            <h3>{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</h3>\\n            <p style=\\\"margin-top:6px;color:var(--muted)\\\">Clinical experience in integrative medicine, chronic illness management, and health coaching. Training includes conventional medical foundations plus additional certification in nutritional and lifestyle medicine.</p>\\n\\n            <div style=\\\"margin-top:12px\\\">\\n              <strong>Approach highlights</strong>\\n              <ul style=\\\"color:var(--muted);margin-top:8px;padding-left:18px\\\">\\n                <li>Thorough intake and shared goal-setting</li>\\n                <li>Evidence-informed, conservative use of supplements and treatments</li>\\n                <li>Coordination with your existing care team</li>\\n              </ul>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"section\\\" aria-labelledby=\\\"modalities\\\">\\n            <h4 id=\\\"modalities\\\">Modalities and supports</h4>\\n            <div class=\\\"micro\\\" style=\\\"margin-top:8px\\\">\\n              <div class=\\\"item\\\">Lifestyle counseling</div>\\n              <div class=\\\"item\\\">Sleep & circadian strategies</div>\\n              <div class=\\\"item\\\">Nutritional guidance</div>\\n              <div class=\\\"item\\\">Stress resilience coaching</div>\\n              <div class=\\\"item\\\">Selective lab interpretation</div>\\n            </div>\\n            <p style=\\\"margin-top:10px;color:var(--muted)\\\">We prioritize interventions with a favorable balance of benefit and safety. Labs are used selectively to illuminate modifiable factors rather than to promise fixed cures.</p>\\n          </div>\\n\\n          <div class=\\\"section\\\">\\n            <h4>Community & continuing education</h4>\\n            <p style=\\\"color:var(--muted)\\\">We maintain active collaboration with local specialists and engage in regular continuing education to integrate new evidence into care. If you require services beyond our scope, we will support referrals and care handoffs.</p>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px;display:flex;gap:10px\\\">\\n            <a class=\\\"pill\\\" href=\\\"book.html\\\" style=\\\"text-decoration:none\\\">Schedule a visit</a>\\n            <a href=\\\"contact.html\\\" style=\\\"padding:9px 12px;border-radius:8px;background:transparent;border:1px solid rgba(6,59,51,0.07);text-decoration:none;color:#06433d\\\">Message us</a>\\n          </div>\\n        </div>\\n      </div>\\n\\n    </main>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap\\\">\\n        <div style=\\\"color:var(--muted)\\\">© {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n        <div style=\\\"color:var(--muted)\\\">Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> · Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Schedule — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Request an appointment. Choose telehealth or in-person, and select your preferred visit type.\\\">\\n  <style>\\n    :root{--bg:#ffffff;--panel:#fcfffb;--muted:#5b6666;--accent:#0e786a;--accent-2:#66d6bd}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial;background:linear-gradient(180deg,#f7fffb,#f0fbf9);color:#083733}\\n    .page{max-width:900px;margin:36px auto;padding:22px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:12px;color:#06433d;text-decoration:none;font-weight:600}\\n    .hero{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:14px}\\n    .hero .copy{max-width:58%}\\n    h1{margin:0;font-size:22px}\\n    p.lead{margin-top:8px;color:var(--muted)}\\n    .form-card{margin-top:20px;background:var(--panel);padding:18px;border-radius:12px;box-shadow:0 10px 30px rgba(6,50,44,0.05)}\\n    label{display:block;font-weight:600;margin-top:10px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6f1ee;margin-top:6px}\\n    .row{display:grid;grid-template-columns:1fr 1fr;gap:12px}\\n    .types{display:flex;flex-direction:column;gap:8px;margin-top:8px}\\n    .type{display:flex;justify-content:space-between;align-items:center;padding:10px;border-radius:10px;background:linear-gradient(180deg,rgba(14,120,106,0.04),transparent);}\\n    .type small{color:var(--muted)}\\n    .submit{margin-top:14px;display:flex;gap:10px}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;border:none;font-weight:700}\\n    .muted{color:var(--muted);font-size:13px;margin-top:8px}\\n    footer{margin-top:18px;color:var(--muted);font-size:13px}\\n    .svg-deco{position:fixed;right:10px;bottom:10px;width:260px;height:260px;opacity:0.09;pointer-events:none}\\n    @media (max-width:720px){.row{grid-template-columns:1fr}.hero{flex-direction:column}.hero .copy{max-width:100%}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"svg-deco\\\" viewBox=\\\"0 0 300 300\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"a\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#66d6bd\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#0e786a\\\"/></linearGradient>\\n    </defs>\\n    <g>\\n      <circle cx=\\\"70\\\" cy=\\\"70\\\" r=\\\"60\\\" fill=\\\"url(#a)\\\" />\\n      <rect x=\\\"140\\\" y=\\\"120\\\" width=\\\"140\\\" height=\\\"90\\\" rx=\\\"18\\\" fill=\\\"#bff3ea\\\" opacity=\\\"0.7\\\"/>\\n      <path d=\\\"M10 220 C60 120,240 80,290 190 L290 300 L10 300 Z\\\" fill=\\\"#9ef0dd\\\" opacity=\\\"0.6\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"page\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"width:46px;height:46px;background:linear-gradient(135deg,#66d6bd,#0e786a);border-radius:10px;color:white;display:flex;align-items:center;justify-content:center;font-weight:700\\\">HM</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav aria-label=\\\"booking nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"about.html\\\">Who We Are</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"copy\\\">\\n        <h1>Request an appointment</h1>\\n        <p class=\\\"lead\\\">Choose the visit type that best fits your needs. We will follow up to confirm availability and next steps. Telehealth and in-person slots are available; indicate preference below.</p>\\n      </div>\\n      <div style=\\\"text-align:right\\\">\\n        <div style=\\\"font-weight:700\\\">Questions?</div>\\n        <div style=\\\"color:var(--muted)\\\">Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </section>\\n\\n    <form class=\\\"form-card\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"POST\\\" novalidate>\\n      <div class=\\\"row\\\">\\n        <div>\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" required placeholder=\\\"Your full name\\\">\\n        </div>\\n        <div>\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required placeholder=\\\"you@example.com\\\">\\n        </div>\\n      </div>\\n\\n      <div class=\\\"row\\\" style=\\\"margin-top:6px\\\">\\n        <div>\\n          <label for=\\\"phone\\\">Phone</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"(555) 555-5555\\\">\\n        </div>\\n        <div>\\n          <label for=\\\"location\\\">Preferred format</label>\\n          <select id=\\\"location\\\" name=\\\"location\\\">\\n            <option>Telehealth</option>\\n            <option>In-person ({{CITY}})</option>\\n            <option>Either</option>\\n          </select>\\n        </div>\\n      </div>\\n\\n      <label for=\\\"type\\\">Visit type</label>\\n      <div class=\\\"types\\\">\\n        <label class=\\\"type\\\"><span>\\n          <strong>Initial Comprehensive — 75 min</strong><br><small>In-depth intake, whole-person plan</small>\\n        </span><span>$260</span></label>\\n\\n        <label class=\\\"type\\\"><span>\\n          <strong>Follow-up — 30 min</strong><br><small>Progress review, adjustments</small>\\n        </span><span>$95</span></label>\\n\\n        <label class=\\\"type\\\"><span>\\n          <strong>Extended follow-up — 50 min</strong><br><small>More time for planning/coaching</small>\\n        </span><span>$160</span></label>\\n      </div>\\n\\n      <label for=\\\"message\\\">Brief reason for visit (optional)</label>\\n      <textarea id=\\\"message\\\" name=\\\"message\\\" rows=\\\"4\\\" placeholder=\\\"E.g., sleep concerns, fatigue, digestive issues...\\\"></textarea>\\n\\n      <div style=\\\"display:flex;gap:10px;align-items:center;margin-top:10px\\\">\\n        <input id=\\\"consent\\\" name=\\\"consent\\\" type=\\\"checkbox\\\" required>\\n        <label for=\\\"consent\\\" style=\\\"margin:0;font-size:13px;color:var(--muted)\\\">I understand this request does not establish an emergency contact or promise a specific outcome. I agree to be contacted about scheduling and administrative details.</label>\\n      </div>\\n\\n      <div class=\\\"submit\\\">\\n        <button type=\\\"submit\\\" class=\\\"btn\\\">Request appointment</button>\\n        <a href=\\\"contact.html\\\" style=\\\"padding:10px 14px;border-radius:8px;background:transparent;border:1px solid rgba(6,119,104,0.08);text-decoration:none;color:#084a42\\\">Contact office</a>\\n      </div>\\n\\n      <p class=\\\"muted\\\">We aim to respond within 2 business days. For urgent needs, please call {{PHONE}}. No guarantees of specific outcomes are made; our care emphasizes education and individualized planning.</p>\\n    </form>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap\\\">\\n        <div>© {{BUSINESS_NAME}}</div>\\n        <div style=\\\"color:var(--muted)\\\">Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> · Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
