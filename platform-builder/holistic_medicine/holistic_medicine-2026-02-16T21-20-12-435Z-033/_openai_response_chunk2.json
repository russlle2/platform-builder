          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>What We Offer — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#7fb77e;--accent-2:#7aa6d9;--muted:#5b6470;--bg:#fbfaf8;--card:#ffffff}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#233;line-height:1.45;background:linear-gradient(180deg, var(--bg), #f6fbff)}\\n    .site{min-height:100vh;display:flex;flex-direction:column}\\n    nav{display:flex;align-items:center;justify-content:space-between;padding:20px 28px}\\n    .brand{font-weight:700;color:var(--accent);letter-spacing:0.4px}\\n    .navlinks a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .navlinks a[href$='services.html']{color:var(--accent)}\\n\\n    /* split diagonal hero */\\n    .hero{position:relative;display:grid;grid-template-columns:1fr 1fr;align-items:stretch;overflow:hidden}\\n    .hero .left{padding:56px 48px;background:transparent;z-index:2}\\n    .hero h1{font-size:clamp(24px,3.6vw,40px);margin:0 0 12px;color:#15333a}\\n    .hero p.lead{color:#2d4b4a;margin:0 0 20px;max-width:56ch}\\n    .cta-row{margin-top:22px}\\n    .btn{display:inline-block;padding:12px 18px;border-radius:10px;background:linear-gradient(90deg,var(--accent),var(--accent-2));color:#fff;text-decoration:none;font-weight:700}\\n    .muted{color:var(--muted);font-size:14px}\\n\\n    .hero .right{position:relative;min-height:320px;background:linear-gradient(140deg,#ecf9f1 0%, #f3f8ff 100%);overflow:hidden}\\n    .diagonal{position:absolute;left:-20%;top:-10%;width:140%;height:140%;background:linear-gradient(120deg, rgba(34,51,62,0.05), rgba(122,166,217,0.04));transform:skewX(-12deg);border-radius:8px}\\n\\n    /* decorative svg pattern (unique to this page) */\\n    .pattern{position:absolute;right:-10%;bottom:-10%;opacity:0.12;width:520px;height:520px}\\n\\n    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;padding:36px 48px}\\n    .card{background:var(--card);padding:20px;border-radius:12px;box-shadow:0 6px 18px rgba(34,51,62,0.06)}\\n    .card h3{margin:0 0 8px;color:#10343a}\\n    .card p{margin:0;color:var(--muted)}\\n\\n    footer{margin-top:auto;padding:36px 28px;color:var(--muted);font-size:14px;text-align:center}\\n\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;padding:0}.hero .left{padding:32px}.hero .right{height:160px}.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class='site'>\\n    <nav>\\n      <div class='brand'>{{BUSINESS_NAME}}</div>\\n      <div class='navlinks'>\\n        <a href='index.html'>Home</a>\\n        <a href='services.html'>Offerings</a>\\n        <a href='conditions.html'>Concerns</a>\\n        <a href='approach.html'>Our Way</a>\\n        <a href='pricing.html'>Membership</a>\\n        <a href='book.html' style='margin-left:14px' class='btn'>{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </nav>\\n\\n    <main>\\n      <section class='hero'>\\n        <div class='left'>\\n          <h1>Membership-based whole-person care that grows with you</h1>\\n          <p class='lead'>At {{BUSINESS_NAME}} we believe steady support is the most sustainable medicine. Our membership combines education, integrative therapies, and continuity so you feel seen, understood, and empowered to steward your health.</p>\\n          <div class='cta-row'>\\n            <a class='btn' href='{{PRIMARY_CTA_URL}}'>Join the Membership</a>\\n            <span class='muted' style='margin-left:12px'>or call <a href='tel:{{PHONE}}' style='color:var(--muted);text-decoration:underline'>{{PHONE}}</a></span>\\n          </div>\\n          <p class='muted' style='margin-top:14px'>Monthly plans include visits, personalized plans, and discounted labs and supplements.</p>\\n        </div>\\n        <div class='right' aria-hidden='true'>\\n          <div class='diagonal'></div>\\n          <svg class='pattern' viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg' role='img' aria-hidden='true'>\\n            <defs>\\n              <linearGradient id='g1' x1='0' x2='1'><stop offset='0' stop-color='#7fb77e'/><stop offset='1' stop-color='#7aa6d9'/></linearGradient>\\n            </defs>\\n            <g fill='none' stroke='url(#g1)' stroke-opacity='0.9' stroke-width='2'>\\n              <path d='M10 100 C40 10, 160 10, 190 100' />\\n              <path d='M10 120 C40 210, 160 210, 190 120' />\\n              <circle cx='40' cy='60' r='6' fill='#7fb77e' />\\n              <circle cx='160' cy='140' r='8' fill='#7aa6d9' />\\n            </g>\\n          </svg>\\n        </div>\\n      </section>\\n\\n      <section class='grid' aria-labelledby='offerings'>\\n        <div class='card'>\\n          <h3 id='offerings'>Membership Essentials</h3>\\n          <p>Monthly visits (virtual or in-person), personalized lifestyle plans, medication review, and priority messaging for ongoing guidance.</p>\\n        </div>\\n        <div class='card'>\\n          <h3>Integrative Modalities</h3>\\n          <p>Evidence-informed approaches: nutrition counseling, botanical and supplement education, stress resiliency training, and movement prescriptions.</p>\\n        </div>\\n        <div class='card'>\\n          <h3>Education & Labs</h3>\\n          <p>We prioritize learning: optional functional and conventional labs are discussed as tools—not mandates—to guide tailored plans.</p>\\n        </div>\\n        <div class='card'>\\n          <h3>Community & Events</h3>\\n          <p>Members have access to workshops, group classes, and curated resources that help translate knowledge into daily habits.</p>\\n        </div>\\n      </section>\\n\\n      <section class='grid' aria-labelledby='how-it-works'>\\n        <div class='card'>\\n          <h3 id='how-it-works'>How the membership works</h3>\\n          <p>Sign up, complete a detailed intake, meet with your practitioner for a tailored plan, and follow up regularly. Adjustments are collaborative; you are the expert of your life.</p>\\n        </div>\\n        <div class='card'>\\n          <h3>Pricing transparency</h3>\\n          <p>Our membership gives you predictable monthly care and savings on additional services. Visit the Membership page for details.</p>\\n        </div>\\n        <div class='card'>\\n          <h3>Small-group learning</h3>\\n          <p>Optional group programs teach food, stress, and sleep practices in a supportive cohort to amplify results through shared learning.</p>\\n        </div>\\n      </section>\\n\\n      <section class='grid' aria-labelledby='small-case'>\\n        <div class='card'>\\n          <h3 id='small-case'>A note on results</h3>\\n          <p class='muted'>We focus on education, measurable goals, and steady progress. Individual responses vary; ongoing assessment helps refine what works best for you.</p>\\n        </div>\\n        <div class='card'>\\n          <h3>Start with a conversation</h3>\\n          <p>New members begin with a comprehensive intake that centers your story, priorities, and context—not only symptoms.</p>\\n        </div>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} — {{TAGLINE}} • <a href='mailto:{{EMAIL}}' style='color:inherit;text-decoration:underline'>{{EMAIL}}</a> • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Concerns We Support — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--warm:#dcb49b;--teal:#4aa3a1;--text:#273233;--soft:#fffdfb}\\n    body{margin:0;font-family:Georgia,serif;color:var(--text);background:linear-gradient(180deg,#fffefc,#f7fbfa)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 28px}\\n    .brand{font-weight:800;color:var(--teal)}\\n    nav a{margin-left:14px;color:#6a7376;text-decoration:none}\\n\\n    .hero{padding:36px 28px;display:flex;gap:24px;align-items:center}\\n    .hero .copy{max-width:64ch}\\n    h1{margin:0 0 8px;font-family:inherit;font-size:28px}\\n    .intro{color:#394c4b;margin-bottom:6px}\\n    .sub{color:#6b7575;font-size:15px}\\n\\n    .list{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;padding:18px 28px}\\n    .issue{background:#fff;border-radius:10px;padding:16px;box-shadow:0 6px 16px rgba(39,50,51,0.06)}\\n    .issue h3{margin:0 0 8px;color:#1f4443}\\n    .issue p{margin:0;color:#556668}\\n\\n    .disclaimer{margin:22px 28px;padding:14px;border-left:4px solid var(--warm);background:#fffaf7;border-radius:6px;color:#6a4a3a}\\n\\n    .cta{display:flex;justify-content:center;padding:26px}\\n    .cta a{background:linear-gradient(90deg,var(--teal),#7fb77e);color:white;padding:12px 20px;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    .pattern{position:absolute;right:8px;top:56px;opacity:0.09;width:300px;height:300px}\\n    footer{padding:18px 28px;color:#6e7778;text-align:center}\\n\\n    @media(max-width:700px){.hero{flex-direction:column}.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class='brand'>{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href='index.html'>Welcome</a>\\n      <a href='services.html'>Offerings</a>\\n      <a href='conditions.html' style='color:var(--teal)'>Concerns</a>\\n      <a href='approach.html'>Approach</a>\\n      <a href='contact.html'>Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class='hero'>\\n      <div class='copy'>\\n        <h1>Common health concerns we support</h1>\\n        <p class='intro'>Our practice emphasizes whole-person care. Below are areas people commonly seek help with; each plan is individualized and educational. We do not promise cures, but we do offer evidence-informed strategies and ongoing support.</p>\\n        <p class='sub'>If you have urgent or life-threatening symptoms, please seek immediate medical care.</p>\\n      </div>\\n      <svg class='pattern' viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg' aria-hidden='true' focusable='false'>\\n        <defs>\\n          <linearGradient id='p2' x1='0' x2='1'><stop offset='0' stop-color='#4aa3a1'/><stop offset='1' stop-color='#dcb49b'/></linearGradient>\\n        </defs>\\n        <g fill='none' stroke='url(#p2)' stroke-width='2'>\\n          <path d='M10 30 q60 40 120 0' />\\n          <path d='M20 60 q50 50 100 0' />\\n          <circle cx='60' cy='30' r='4' fill='#4aa3a1'/>\\n        </g>\\n      </svg>\\n    </section>\\n\\n    <section class='list' aria-label='common-concerns'>\\n      <article class='issue'>\\n        <h3>Stress & Emotional Exhaustion</h3>\\n        <p>Tools include paced breathing, sleep hygiene, mindfulness skills, and behavior-focused plans to build resilience. We work collaboratively to identify triggers and practical strategies.</p>\\n      </article>\\n\\n      <article class='issue'>\\n        <h3>Sleep Difficulties</h3>\\n        <p>We explore routines, circadian habits, light exposure, and cognitive approaches. When appropriate, sleep-focused testing or referrals are discussed as educational options.</p>\\n      </article>\\n\\n      <article class='issue'>\\n        <h3>Digestive Complaints</h3>\\n        <p>Nutrition-focused assessment, patterns of eating, and symptom-tracking help clarify contributors. Labs and referral options may be reviewed when they add useful information.</p>\\n      </article>\\n\\n      <article class='issue'>\\n        <h3>Chronic Low-grade Inflammation</h3>\\n        <p>Lifestyle, targeted nutrition, and movement prescriptions aim to reduce inflammatory drivers. We emphasize realistic, sustainable steps rather than one-size-fits-all fixes.</p>\\n      </article>\\n\\n      <article class='issue'>\\n        <h3>Low Energy & Fatigue</h3>\\n        <p>Energy concerns are explored in context: sleep, stress, nutrition, movement, and medication effects. We create stepwise plans and consider targeted testing only if clinically indicated.</p>\\n      </article>\\n    </section>\\n\\n    <section class='disclaimer' aria-hidden='false'>\\n      <strong>Important:</strong> The information here is educational and part of a shared decision-making process. Results vary. We do not guarantee cures; our focus is on safe, personalized care and measurable improvements in daily function.\\n    </section>\\n\\n    <div class='cta'>\\n      <a href='book.html'>Start with a Discovery Visit</a>\\n    </div>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • {{PRACTITIONER_NAME}}, {{CREDENTIALS}} • <a href='mailto:{{EMAIL}}' style='color:inherit;text-decoration:underline'>{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Our Approach — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#f3f9f6;--accent:#a18dff;--tone:#2b3a3a}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--tone);background:var(--bg1)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 26px}\\n    .logo{font-weight:800;color:var(--accent)}\\n    nav a{margin-left:12px;color:#465656;text-decoration:none}\\n\\n    .wrap{max-width:1100px;margin:0 auto}\\n    .intro{padding:36px 20px 6px}\\n    h1{margin:0 0 6px;font-size:28px}\\n    .lead{color:#344c4c}\\n\\n    /* procedural timeline cards */\\n    .timeline{display:flex;flex-direction:column;gap:18px;padding:18px 20px}\\n    .step{display:grid;grid-template-columns:80px 1fr;gap:12px;align-items:start;background:#fff;border-radius:12px;padding:16px;box-shadow:0 8px 24px rgba(36,48,48,0.06)}\\n    .step .num{width:64px;height:64px;border-radius:12px;background:linear-gradient(180deg,var(--accent),#7fb77e);color:white;display:flex;align-items:center;justify-content:center;font-weight:700}\\n    .step h3{margin:0 0 6px}\\n    .step p{margin:0;color:#415959}\\n\\n    .aside{background:linear-gradient(180deg,#fff,#f7fdff);padding:20px;border-radius:10px;margin:18px 20px;color:#324848}\\n\\n    .labs{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px}\\n    .lab{background:#fff;border-radius:10px;padding:10px 12px;box-shadow:0 6px 18px rgba(33,45,45,0.05)}\\n\\n    footer{padding:22px 20px;text-align:center;color:#526767}\\n\\n    /* subtle diagonal strip */\\n    .ribbon{height:64px;background:linear-gradient(120deg,rgba(161,141,255,0.08),rgba(127,183,126,0.06));clip-path:polygon(0 0,100% 0,85% 100%,0% 100%);margin-top:12px}\\n\\n    @media(min-width:900px){.timeline{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class='logo'>{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='services.html'>Services</a>\\n      <a href='conditions.html'>Concerns</a>\\n      <a href='approach.html' style='color:var(--accent)'>How We Work</a>\\n      <a href='book.html'>Book</a>\\n    </nav>\\n  </header>\\n\\n  <div class='ribbon' aria-hidden='true'></div>\\n\\n  <main class='wrap'>\\n    <section class='intro'>\\n      <h1>A clear, compassionate process for whole-person care</h1>\\n      <p class='lead'>We combine attentive listening with practical steps. Below is how a typical engagement unfolds—designed to be educational, conservative with testing, and always individualized.</p>\\n    </section>\\n\\n    <section class='timeline' aria-label='care-steps'>\\n      <div class='step'>\\n        <div class='num'>1</div>\\n        <div>\\n          <h3>Intake & Story</h3>\\n          <p>Your first visit centers on your story: health history, priorities, daily rhythms, and what matters most. We use questionnaires and open conversation to build a shared picture.</p>\\n        </div>\\n      </div>\\n\\n      <div class='step'>\\n        <div class='num'>2</div>\\n        <div>\\n          <h3>Collaborative Plan</h3>\\n          <p>Together we craft a stepwise plan that may include lifestyle strategies, targeted supplements, and small habit experiments. Education is core—each recommendation includes the why and how.</p>\\n        </div>\\n      </div>\\n\\n      <div class='step'>\\n        <div class='num'>3</div>\\n        <div>\\n          <h3>Optional Labs & Tools</h3>\\n          <p>Laboratory testing is offered when it meaningfully informs care. We explain benefits, limits, and costs—labs are tools to reduce uncertainty, not a requirement for care.</p>\\n          <div class='labs' aria-hidden='true'>\\n            <div class='lab'>Basic blood panel</div>\\n            <div class='lab'>Thyroid & hormones (as indicated)</div>\\n            <div class='lab'>Nutrient markers</div>\\n            <div class='lab'>Functional GI or metabolic panels</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <div class='step'>\\n        <div class='num'>4</div>\\n        <div>\\n          <h3>Follow-up & Adjustment</h3>\\n          <p>Follow-ups are built into the membership model. We track progress, iterate on plans, and celebrate small wins. Our focus is on sustainable change rather than quick fixes.</p>\\n        </div>\\n      </div>\\n\\n      <div class='step'>\\n        <div class='num'>5</div>\\n        <div>\\n          <h3>Community & Continued Learning</h3>\\n          <p>Members access curated learning—workshops, guides, and group sessions—so practical skills become part of daily life. Peer learning often accelerates habits.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <aside class='aside' aria-label='principles'>\\n      <strong>Our guiding principles</strong>\\n      <ul>\\n        <li>Listen first; act second.</li>\\n        <li>Use evidence-informed, low-risk interventions to start.</li>\\n        <li>Teach you tools so you can self-manage with confidence.</li>\\n      </ul>\\n      <p style='margin-top:8px;font-size:14px;color:#405b5b'>Questions about labs, referrals, or why we recommend a particular step? Bring them—shared decision-making is central to our model.</p>\\n    </aside>\\n\\n    <div style='padding:18px 20px;display:flex;justify-content:center'>\\n      <a href='book.html' style='background:linear-gradient(90deg,var(--accent),#7fb77e);color:white;padding:12px 18px;border-radius:10px;text-decoration:none;font-weight:700'>Schedule a Discovery Visit</a>\\n    </div>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{PRACTITIONER_NAME}}, {{CREDENTIALS}} • {{BUSINESS_NAME}} • <a href='mailto:{{EMAIL}}' style='color:inherit;text-decoration:underline'>{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
