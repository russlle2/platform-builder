          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Fees & Packages — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Transparent pricing for whole-person care, consultations, follow-ups, and natural-retail add-ons.\\\">\\n  <style>\\n    :root{--bg1:#0f1724;--bg2:#102233;--accent:#7dd3fc;--muted:#9aa9b2;--card:#0b1220;--glass:rgba(255,255,255,0.04);--radius:14px}\\n    *{box-sizing:border-box}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:#e6f0f6;background:linear-gradient(160deg,var(--bg1),var(--bg2));-webkit-font-smoothing:antialiased}\\n    .pattern{position:fixed;inset:0;pointer-events:none;opacity:0.14;background-image:url('assets/img/pattern.svg');background-repeat:repeat;mix-blend-mode:screen}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:22px 28px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);backdrop-filter:blur(6px)}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .mark{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#8b5cf6);display:grid;place-items:center;font-weight:700;color:#071428}\\n    nav a{color:rgba(230,240,246,0.84);text-decoration:none;margin:0 10px;font-size:15px}\\n    nav a.active{font-weight:700;color:#fff}\\n    main{max-width:1100px;margin:28px auto;padding:28px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:var(--radius);padding:26px;color:#eaf6fb;box-shadow:0 6px 30px rgba(2,6,23,0.6)}\\n    h1{margin:0;font-size:28px;letter-spacing:-0.02em}\\n    p.lead{color:var(--muted);margin-top:10px}\\n    .price-list{display:flex;flex-direction:column;gap:14px;margin-top:18px}\\n    .plan{display:flex;justify-content:space-between;align-items:center;padding:14px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.017),transparent);border:1px solid rgba(255,255,255,0.03)}\\n    .plan .meta{display:flex;flex-direction:column}\\n    .plan .meta b{font-weight:700}\\n    .plan .cta{background:linear-gradient(90deg,var(--accent),#a78bfa);padding:8px 12px;border-radius:10px;color:#04202b;text-decoration:none;font-weight:700}\\n    .retail{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px}\\n    .tag{background:var(--glass);padding:8px 10px;border-radius:999px;font-size:13px;color:var(--muted)}\\n    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:20px}\\n    .small{font-size:13px;color:var(--muted)}\\n    .testimonials{display:flex;flex-direction:column;gap:12px}\\n    blockquote{margin:0;padding:12px;background:rgba(255,255,255,0.02);border-radius:10px;color:#dff6ff}\\n    .process{display:flex;flex-direction:column;gap:12px}\\n    .step{display:flex;gap:12px;align-items:flex-start}\\n    .step .idx{width:36px;height:36px;border-radius:9px;background:linear-gradient(90deg,#7dd3fc,#8b5cf6);display:grid;place-items:center;font-weight:700;color:#04202b}\\n    footer{margin-top:28px;padding:18px;border-radius:12px;color:var(--muted);font-size:13px;background:transparent}\\n    .faq{margin-top:18px}\\n    details{background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;margin-top:8px}\\n    .lead-magnet{display:flex;gap:10px;align-items:center;margin-top:18px}\\n    input[type=\\\"email\\\"]{padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,0.03);background:transparent;color:#fff}\\n    button.primary{background:linear-gradient(90deg,#7dd3fc,#a78bfa);border:none;padding:10px 14px;border-radius:10px;font-weight:700}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr}.grid-2{grid-template-columns:1fr}.pattern{opacity:0.08}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern\\\" aria-hidden=\\\"true\\\"></div>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"mark\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"/index.html\\\">Home</a>\\n      <a href=\\\"/services.html\\\">Offerings</a>\\n      <a href=\\\"/conditions.html\\\">Concerns</a>\\n      <a href=\\\"/approach.html\\\">Philosophy</a>\\n      <a href=\\\"/pricing.html\\\" class=\\\"active\\\">Fees</a>\\n      <a href=\\\"/about.html\\\">About</a>\\n      <a href=\\\"/book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"card\\\">\\n        <h1>Transparent fees, flexible pathways</h1>\\n        <p class=\\\"lead\\\">Clear options for personalized integrative care — consults, follow-ups, lab reviews, and curated retail add-ons to support your plan. No promises of cures; emphasis on education, lifestyle, and measurable steps.</p>\\n        <div class=\\\"price-list\\\" aria-hidden=\\\"false\\\">\\n          <div class=\\\"plan\\\">\\n            <div class=\\\"meta\\\"><b>New Patient Intake</b><span class=\\\"small\\\">90–120 min comprehensive session</span></div>\\n            <div style=\\\"text-align:right\\\"><div style=\\\"font-weight:800\\\">$220</div><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book Intake</a></div>\\n          </div>\\n          <div class=\\\"plan\\\">\\n            <div class=\\\"meta\\\"><b>Follow-up Visit</b><span class=\\\"small\\\">45–60 min adjustment & progress</span></div>\\n            <div style=\\\"text-align:right\\\"><div style=\\\"font-weight:800\\\">$95</div><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule</a></div>\\n          </div>\\n          <div class=\\\"plan\\\">\\n            <div class=\\\"meta\\\"><b>Lab Review + Plan</b><span class=\\\"small\\\">Review results and integrate treatments</span></div>\\n            <div style=\\\"text-align:right\\\"><div style=\\\"font-weight:800\\\">$150</div><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Request</a></div>\\n          </div>\\n        </div>\\n        <div class=\\\"retail\\\" aria-hidden=\\\"false\\\">\\n          <span class=\\\"tag\\\">Herbal blends (retail)</span>\\n          <span class=\\\"tag\\\">Targeted supplements</span>\\n          <span class=\\\"tag\\\">Topical therapies</span>\\n          <span class=\\\"tag\\\">At-home labs (optional)</span>\\n        </div>\\n        <div class=\\\"small\\\" style=\\\"margin-top:12px\\\">Retail products are optional and chosen to support your individualized plan. Full disclosure of pricing at time of recommendation.</div>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Need help choosing?</div>\\n            <div style=\\\"font-weight:800;font-size:18px\\\">Concise guidance call</div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <div style=\\\"font-weight:800\\\">$35</div>\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Quick Call</a>\\n          </div>\\n        </div>\\n        <hr style=\\\"border:none;height:1px;background:rgba(255,255,255,0.03);margin:14px 0\\\">\\n        <div class=\\\"small\\\">All prices are listed in USD. Insurance coverage varies; ask us for a superbill template. By booking you accept that results are individual and not guaranteed.</div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"grid-2\\\">\\n      <div class=\\\"card\\\">\\n        <h2 style=\\\"margin-top:0\\\">Why our pricing matters</h2>\\n        <p class=\\\"small\\\">We align time and attention with care complexity. Integrative medicine blends clinical evaluation, lifestyle coaching, and evidence-informed natural modalities — this requires longer intake time and thoughtful follow-up.</p>\\n        <div class=\\\"process\\\">\\n          <div class=\\\"step\\\"><div class=\\\"idx\\\">1</div><div><b>Intake</b><div class=\\\"small\\\">Deep-dive history, current labs, goals.</div></div></div>\\n          <div class=\\\"step\\\"><div class=\\\"idx\\\">2</div><div><b>Individualized Plan</b><div class=\\\"small\\\">Diet, movement, targeted supplements, optional lab recommendations.</div></div></div>\\n          <div class=\\\"step\\\"><div class=\\\"idx\\\">3</div><div><b>Follow-ups</b><div class=\\\"small\\\">Track changes, adapt safely with attention to interactions.</div></div></div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <h2 style=\\\"margin-top:0\\\">Testimonials</h2>\\n        <div class=\\\"testimonials\\\">\\n          <blockquote>\\\"Attentive, patient, and practical — I finally felt supported.\\\" <div class=\\\"small\\\">— A client in {{CITY}}, {{STATE}}</div></blockquote>\\n          <blockquote>\\\"Clear plan, gentle changes that actually stuck.\\\" <div class=\\\"small\\\">— Another client</div></blockquote>\\n        </div>\\n        <div style=\\\"margin-top:12px\\\" class=\\\"small\\\">Testimonials reflect individual experiences; they are not guarantees of specific results.</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card faq\\\">\\n      <h3 style=\\\"margin:0\\\">Common questions</h3>\\n      <details>\\n        <summary>Do you accept insurance?</summary>\\n        <div class=\\\"small\\\">We do not bill insurance directly in-clinic. We provide superbills on request; reimbursement depends on your plan.</div>\\n      </details>\\n      <details>\\n        <summary>Are products included in session fees?</summary>\\n        <div class=\\\"small\\\">Session fees cover clinical time and planning. Supplements and herbal preparations are retail items and billed separately when dispatched.</div>\\n      </details>\\n      <details>\\n        <summary>Can you guarantee outcomes?</summary>\\n        <div class=\\\"small\\\">No — we cannot promise cures. Our focus is education, risk-aware interventions, and measurable improvement over time.</div>\\n      </details>\\n    </section>\\n\\n    <section class=\\\"card\\\">\\n      <h3 style=\\\"margin-top:0\\\">Get the 7-step Wellness Cost Guide</h3>\\n      <div class=\\\"lead-magnet\\\">\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" style=\\\"display:flex;gap:8px;width:100%\\\">\\n          <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Email for the guide\\\" aria-label=\\\"Email\\\" required>\\n          <button class=\\\"primary\\\" type=\\\"submit\\\">Send Guide</button>\\n        </form>\\n      </div>\\n      <div class=\\\"small\\\" style=\\\"margin-top:10px\\\">A concise primer to help you budget for integrative care and optional at-home labs.</div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px\\\">\\n        <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n        <div class=\\\"small\\\">Contact: <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Meet our clinician & learn the philosophy behind our integrative approach to whole-person care.\\\">\\n  <style>\\n    :root{--bg:#071428;--card:#071a26;--accent:#9be7ff;--muted:#a8c2cb;--glass:rgba(255,255,255,0.03);--radius:12px}\\n    body{margin:0;background:radial-gradient(1200px 600px at 10% 10%,#072235 0%,#041025 40%,#03121b 100%);color:#e8fbff;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial}\\n    .pattern{position:fixed;inset:0;background-image:url('assets/img/pattern.svg');opacity:0.12;pointer-events:none}\\n    header{display:flex;justify-content:space-between;padding:18px 22px;align-items:center}\\n    .brand{display:flex;gap:10px;align-items:center}\\n    .mark{width:46px;height:46px;border-radius:12px;background:linear-gradient(135deg,#7dd3fc,#a78bfa);display:grid;place-items:center;color:#021018;font-weight:800}\\n    nav a{color:rgba(232,251,255,0.86);text-decoration:none;margin:0 8px}\\n    nav a.active{font-weight:700}\\n    main{max-width:980px;margin:26px auto;padding:22px}\\n    .hero{display:flex;gap:22px;align-items:center}\\n    .portrait{width:180px;height:180px;border-radius:18px;background:linear-gradient(135deg,#052430,#073a47);display:grid;place-items:center;font-weight:700}\\n    .bio{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px}\\n    h1{margin:0;font-size:26px}\\n    .muted{color:var(--muted)}\\n    .sections{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:16px;border-radius:12px}\\n    .credentials{margin-top:8px;color:var(--muted)}\\n    .philosophy{line-height:1.5}\\n    .process{display:flex;flex-direction:column;gap:10px;margin-top:10px}\\n    details{background:rgba(255,255,255,0.02);padding:10px;border-radius:8px;margin-top:8px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,#7dd3fc,#8b5cf6);color:#041828;font-weight:800;text-decoration:none}\\n    @media(max-width:880px){.sections{grid-template-columns:1fr}.hero{flex-direction:column;align-items:flex-start}.portrait{width:140px;height:140px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern\\\" aria-hidden=\\\"true\\\"></div>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"mark\\\">HM</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Holistic care in {{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"/index.html\\\">Home</a>\\n      <a href=\\\"/services.html\\\">Services</a>\\n      <a href=\\\"/conditions.html\\\">Concerns</a>\\n      <a href=\\\"/approach.html\\\">Our Way</a>\\n      <a href=\\\"/pricing.html\\\">Investment</a>\\n      <a href=\\\"/about.html\\\" class=\\\"active\\\">About Us</a>\\n      <a href=\\\"/book.html\\\">Schedule</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"portrait\\\">{{PRACTITIONER_NAME}}</div>\\n      <div class=\\\"bio\\\">\\n        <h1>Hello — I'm {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</h1>\\n        <div class=\\\"credentials\\\">Clinician, educator, and guide in whole-person health.</div>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:12px\\\">My practice blends conventional assessment with evidence-informed natural therapies. I prioritize safety, clear rationale, and patient empowerment — we craft plans you can live with.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a Conversation</a>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"sections\\\">\\n      <div>\\n        <div class=\\\"card\\\">\\n          <h2 style=\\\"margin-top:0\\\">Practice Philosophy</h2>\\n          <p class=\\\"philosophy\\\">We listen first. Health emerges from many layers — sleep, stress resilience, gut ecology, movement, nutrition, relationships, and meaning. Our recommendations are conservative when needed and bold when evidence supports it. Expect education, measurable goals, and shared decision-making.</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h3 style=\\\"margin-top:0\\\">Notable training</h3>\\n          <ul class=\\\"muted\\\" style=\\\"margin:8px 0 0 18px\\\">\\n            <li>Integrative Clinical Fellowship</li>\\n            <li>Herbal Pharmacology & Nutrition</li>\\n            <li>Functional Lab interpretation</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h3 style=\\\"margin-top:0\\\">How we work</h3>\\n          <div class=\\\"process\\\">\\n            <div><b>1.</b> Detailed intake & baseline measures.</div>\\n            <div><b>2.</b> A practical plan with priorities & safety checks.</div>\\n            <div><b>3.</b> Regular follow-up, tweak, and learn together.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h3 style=\\\"margin-top:0\\\">Realistic outcomes</h3>\\n          <p class=\\\"muted\\\">We cannot promise a cure. Progress is individualized. Our goal is improved function, symptom reduction, and clarity on next steps — supported by education and monitoring.</p>\\n        </div>\\n\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Client stories</h3>\\n          <blockquote style=\\\"margin:0\\\">\\\"A collaborative clinician who explained options clearly and respected my preferences.\\\" <div class=\\\"muted\\\">— Client</div></blockquote>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin-top:0\\\">Pressing issues I help with</h3>\\n          <div class=\\\"muted\\\">Stress, sleep disturbances, digestive complaints, low energy, inflammation concerns — approached with education and layered interventions.</div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin-top:0\\\">Quick FAQ</h3>\\n          <details>\\n            <summary>Do you prescribe medications?</summary>\\n            <div class=\\\"muted\\\">When within my scope and appropriate, yes — but treatment blends multiple modalities; we discuss risks and interactions openly.</div>\\n          </details>\\n          <details>\\n            <summary>Is this alternative medicine?</summary>\\n            <div class=\\\"muted\\\">Integrative medicine combines conventional diagnostics with thoughtfully chosen natural therapies; it's complementary rather than oppositional.</div>\\n          </details>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin-top:0\\\">Stay informed</h3>\\n          <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\">\\n            <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Your email\\\" style=\\\"width:100%;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.03);background:transparent;color:#fff\\\" required>\\n            <button class=\\\"cta\\\" style=\\\"display:block;width:100%;text-align:center;margin-top:8px\\\">Subscribe</button>\\n          </form>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Credentials & transparency</h3>\\n        <p class=\\\"muted\\\">Licensure and training details are shared during intake. We recommend labs when educationally useful; lab costs are additional and we explain which tests provide actionable data.</p>\\n        <a href=\\\"/pricing.html\\\" class=\\\"cta\\\">See Fees</a>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted);font-size:13px\\\">\\n      <div>{{BUSINESS_NAME}} • Contact <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a> • Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{PHONE}}</a></div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a Session — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Reserve time for an intake, follow-up, or lab review. Practical booking and pre-visit guidance.\\\">\\n  <style>\\n    :root{--bg:#041426;--panel:#071a26;--accent:#8be6ff;--muted:#9fbfc8;--glass:rgba(255,255,255,0.03);--radius:14px}\\n    body{margin:0;background:linear-gradient(180deg,#021824 0%,#041026 100%);color:#e9fbff;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial}\\n    .pattern{position:fixed;inset:0;background-image:url('assets/img/pattern.svg');opacity:0.13;pointer-events:none}\\n    header{display:flex;justify-content:space-between;padding:18px 20px}\\n    .brand{display:flex;gap:10px;align-items:center}\\n    .mark{width:44px;height:44px;border-radius:12px;background:linear-gradient(90deg,#7dd3fc,#8b5cf6);display:grid;place-items:center;color:#021018;font-weight:800}\\n    nav a{color:rgba(233,251,255,0.9);text-decoration:none;margin:0 8px}\\n    nav a.active{font-weight:800}\\n    main{max-width:1000px;margin:18px auto;padding:18px}\\n    .grid{display:grid;grid-template-columns:1fr 380px;gap:18px}\\n    .panel{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:var(--radius)}\\n    h1{margin:0;font-size:26px}\\n    form{display:flex;flex-direction:column;gap:10px;margin-top:12px}\\n    input,select,textarea{padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,0.03);background:transparent;color:#fff}\\n    .btn{background:linear-gradient(90deg,#7dd3fc,#a78bfa);padding:10px;border-radius:10px;border:none;font-weight:800}\\n    .benefits{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}\\n    .small{color:var(--muted);font-size:13px}\\n    details{background:rgba(255,255,255,0.02);padding:10px;border-radius:8px;margin-top:8px}\\n    @media(max-width:920px){.grid{grid-template-columns:1fr}.benefits{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern\\\" aria-hidden=\\\"true\\\"></div>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"mark\\\">HM</div>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"/index.html\\\">Welcome</a>\\n      <a href=\\\"/services.html\\\">Programs</a>\\n      <a href=\\\"/conditions.html\\\">Concerns</a>\\n      <a href=\\\"/approach.html\\\">Approach</a>\\n      <a href=\\\"/pricing.html\\\">Fees</a>\\n      <a href=\\\"/about.html\\\">Team</a>\\n      <a href=\\\"/book.html\\\" class=\\\"active\\\">Book</a>\\n      <a href=\\\"/contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"grid\\\">\\n      <div>\\n        <div class=\\\"panel\\\">\\n          <h1>Reserve time — Intake, Follow-up, or Lab Review</h1>\\n          <p class=\\\"small\\\">Choose a visit type below. If you are new, please book an intake so we can allocate the necessary time. All appointments include educational guidance; outcomes vary by person.</p>\\n\\n          <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" aria-label=\\\"Booking form\\\">\\n            <label class=\\\"small\\\">Name\\n              <input type=\\\"text\\\" name=\\\"name\\\" placeholder=\\\"Your full name\\\" required>\\n            </label>\\n            <label class=\\\"small\\\">Email\\n              <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n            </label>\\n            <label class=\\\"small\\\">Phone\\n              <input type=\\\"tel\\\" name=\\\"phone\\\" placeholder=\\\"Optional phone\\\" >\\n            </label>\\n            <label class=\\\"small\\\">Visit type\\n              <select name=\\\"visit\\\">\\n                <option>New Patient Intake — 90–120 min</option>\\n                <option>Follow-up — 45–60 min</option>\\n                <option>Lab Review — 45–60 min</option>\\n                <option>Consultation Call — 20–30 min</option>\\n              </select>\\n            </label>\\n            <label class=\\\"small\\\">Brief note (symptoms / goals)\\n              <textarea name=\\\"note\\\" rows=\\\"4\\\" placeholder=\\\"What brings you in? Be concise.\\\"></textarea>\\n            </label>\\n            <div style=\\\"display:flex;gap:10px;align-items:center;margin-top:6px\\\">\\n              <button class=\\\"btn\\\" type=\\\"submit\\\">Request Booking</button>\\n              <a href=\\\"mailto:{{EMAIL}}\\\" class=\\\"small\\\" style=\\\"color:var(--accent);text-decoration:none\\\">Questions? Email us</a>\\n            </div>\\n            <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">By submitting you agree to receive scheduling communication. We do not guarantee outcomes; appointments are educational and therapeutic in scope.</div>\\n          </form>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin-top:0\\\">Lead magnet — Pre-visit checklist</h3>\\n          <p class=\\\"small\\\">Download a short checklist to prepare labs, medication list, and symptom trackers before your session.</p>\\n          <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" style=\\\"display:flex;gap:8px;margin-top:8px\\\">\\n            <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Email to receive the checklist\\\" required style=\\\"flex:1\\\">\\n            <button class=\\\"btn\\\" type=\\\"submit\\\">Get Checklist</button>\\n          </form>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin-top:0\\\">What to expect</h3>\\n          <div class=\\\"benefits\\\">\\n            <div>\\n              <b>Thorough history</b>\\n              <div class=\\\"small\\\">We ask about lifestyle, stress, and relevant labs.</div>\\n            </div>\\n            <div>\\n              <b>Individualized steps</b>\\n              <div class=\\\"small\\\">Small, measurable changes prioritized first.</div>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <h3 style=\\\"margin-top:0\\\">Quick process guide</h3>\\n          <ol class=\\\"small\\\">\\n            <li>Book online or request a call.</li>\\n            <li>Complete pre-visit intake sent via email.</li>\\n            <li>Attend the session — bring questions and recent labs.</li>\\n            <li>We provide an action plan and resources.</li>\\n          </ol>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin-top:0\\\">Safety & labs</h3>\\n          <p class=\\\"small\\\">We may recommend optional lab testing for clearer data. Labs are educational and billed separately. All recommendations consider medication interactions and contraindications.</p>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin-top:0\\\">Practical matters</h3>\\n          <div class=\\\"small\\\">Need to reschedule? Please provide 48-hour notice. For urgent issues, call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{PHONE}}</a>.</div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin-top:0\\\">Common FAQs</h3>\\n          <details>\\n            <summary>How long until I see change?</summary>\\n            <div class=\\\"small\\\">Timing depends on the concern. Some symptoms shift within weeks; others take months. We set realistic milestones.</div>\\n          </details>\\n          <details>\\n            <summary>Will I need supplements?</summary>\\n            <div class=\\\"small\\\">Sometimes — we prefer evidence-informed choices and review interactions. Supplements are optional retail items.</div>\\n          </details>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted);font-size:13px\\\">\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
