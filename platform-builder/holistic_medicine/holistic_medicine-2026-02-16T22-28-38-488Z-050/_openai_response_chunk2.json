          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Services</title>\\n  <style>\\n    :root{\\n      --bg1:#0f1724;--bg2:#06202a;--accent1:#7be495;--accent2:#a78bfa;--glass:rgba(255,255,255,0.06);\\n      --card:rgba(255,255,255,0.04);--muted:rgba(255,255,255,0.6);\\n      --radius:16px;--padding:24px;\\n      font-family:Inter, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;\\n    }\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg1),var(--bg2));color:#e6f7ef}\\n    .wrap{max-width:1100px;margin:48px auto;padding:24px}\\n    header{display:flex;gap:18px;align-items:center;justify-content:space-between}\\n    .logo{display:flex;gap:12px;align-items:center}\\n    .logo-badge{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent1),var(--accent2));display:flex;align-items:center;justify-content:center;font-weight:700;color:#012;box-shadow:0 8px 30px rgba(0,0,0,0.5)}\\n    nav a{color:#e2fff0;text-decoration:none;margin:0 10px;font-weight:600;opacity:0.95}\\n    nav a:hover{text-decoration:underline}\\n    /* hero */\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:24px;margin-top:28px}\\n    .hero-card{background:linear-gradient(180deg,rgba(255,255,255,0.03),rgba(255,255,255,0.02));padding:28px;border-radius:var(--radius);backdrop-filter:blur(6px);box-shadow:0 10px 30px rgba(5,10,15,0.6)}\\n    h1{margin:0;font-size:30px;letter-spacing:-0.02em}\\n    .eyebrow{color:var(--accent1);font-weight:700;font-size:13px}\\n    p.lead{color:var(--muted);margin-top:12px;line-height:1.5}\\n    .cta{display:inline-block;margin-top:18px;padding:12px 16px;border-radius:12px;background:linear-gradient(90deg,var(--accent1),var(--accent2));color:#022; font-weight:800;text-decoration:none}\\n    /* services grid */\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:18px}\\n    .service{background:var(--card);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .service h3{margin:0 0 8px 0}\\n    .price{color:var(--accent2);font-weight:700}\\n    .addons{margin-top:12px;padding-top:12px;border-top:1px dashed rgba(255,255,255,0.04)}\\n    .pill{display:inline-block;margin:6px 6px 0 0;padding:8px 10px;border-radius:999px;background:rgba(255,255,255,0.02);font-size:13px}\\n    footer{margin-top:36px;color:var(--muted);display:flex;justify-content:space-between;align-items:center}\\n    /* testimonial strip */\\n    .testimonials{margin-top:28px;display:flex;gap:12px;overflow:auto}\\n    .t{min-width:240px;background:rgba(255,255,255,0.02);padding:14px;border-radius:12px}\\n    /* subtle SVG spotlight */\\n    .pattern{position:fixed;right:-200px;top:-120px;opacity:0.16;pointer-events:none;transform:rotate(18deg)}\\n    small.disclaimer{display:block;color:#9dd6b5;margin-top:8px;font-size:13px}\\n  </style>\\n</head>\\n<body>\\n  <!-- Unique decorative SVG pattern (assets/img/pattern.svg conceptual) -->\\n  <svg class=\\\"pattern\\\" width=\\\"680\\\" height=\\\"680\\\" viewBox=\\\"0 0 680 680\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"1\\\" y2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#7be495\\\" stop-opacity=\\\"0.95\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#a78bfa\\\" stop-opacity=\\\"0.95\\\"/>\\n      </linearGradient>\\n      <pattern id=\\\"p1\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"20\\\" height=\\\"20\\\" fill=\\\"rgba(255,255,255,0.02)\\\"/>\\n      </pattern>\\n    </defs>\\n    <circle cx=\\\"340\\\" cy=\\\"340\\\" r=\\\"320\\\" fill=\\\"url(#g1)\\\" filter=\\\"url(#f0)\\\" opacity=\\\"0.18\\\"/>\\n    <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"680\\\" height=\\\"680\\\" fill=\\\"url(#p1)\\\" opacity=\\\"0.06\\\"/>\\n    <g fill=\\\"rgba(255,255,255,0.06)\\\">\\n      <path d=\\\"M120 60c50 30 140 0 200 40s120 120 60 220-170 120-240 60S40 190 120 60z\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"logo\\\">\\n        <div class=\\\"logo-badge\\\">HM</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav aria-label=\\\"Main\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"conditions.html\\\">What We Treat</a>\\n        <a href=\\\"approach.html\\\">How We Work</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <div class=\\\"eyebrow\\\">Services &amp; Add‑Ons</div>\\n        <h1>Practical, whole-person care — therapies, education, and curated supplements</h1>\\n        <p class=\\\"lead\\\">We blend evidence-informed modalities and lifestyle coaching to support balanced health. Choose clinical visits, therapeutic packages, or retail add-ons to support your plan. Nothing here guarantees a cure — education and partnership are our promise.</p>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n\\n      <aside style=\\\"align-self:start\\\">\\n        <div class=\\\"hero-card\\\" style=\\\"padding:18px\\\">\\n          <strong>Quick info</strong>\\n          <p style=\\\"margin:8px 0;color:var(--muted)\\\">Sessions by appointment in {{CITY}}, {{STATE}} — telehealth available. Phone: {{PHONE}}</p>\\n          <a href=\\\"contact.html\\\" style=\\\"color:var(--accent1);text-decoration:underline\\\">Contact &amp; hours</a>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"grid\\\" aria-labelledby=\\\"services-heading\\\">\\n      <h2 id=\\\"services-heading\\\" style=\\\"grid-column:1 / -1;font-size:18px;margin-top:12px\\\">Core Services</h2>\\n      <div class=\\\"service\\\">\\n        <h3>Comprehensive Intake &amp; Plan</h3>\\n        <div class=\\\"price\\\">60–90 min consult — $185</div>\\n        <p style=\\\"color:var(--muted)\\\">An initial, whole-person evaluation covering history, lifestyle, and goal-setting. Includes personalized plan and educational resources.</p>\\n      </div>\\n      <div class=\\\"service\\\">\\n        <h3>Follow-up &amp; Coaching</h3>\\n        <div class=\\\"price\\\">30–45 min — $95</div>\\n        <p style=\\\"color:var(--muted)\\\">Shorter visits to review progress, refine goals, and adjust non-pharmacologic strategies. Ideal for ongoing support.</p>\\n      </div>\\n\\n      <div class=\\\"service\\\">\\n        <h3>Therapeutic Visits (Hands-on / Modalities)</h3>\\n        <div class=\\\"price\\\">45–60 min — $120</div>\\n        <p style=\\\"color:var(--muted)\\\">Integrative modalities may be used where appropriate — e.g., gentle manual therapies, guided breathwork, or movement coaching.</p>\\n      </div>\\n      <div class=\\\"service\\\">\\n        <h3>Telehealth Education Session</h3>\\n        <div class=\\\"price\\\">30 min — $75</div>\\n        <p style=\\\"color:var(--muted)\\\">Focused education on sleep hygiene, stress tools, or digestive self-care. Practical takeaways and worksheets provided.</p>\\n      </div>\\n\\n      <div class=\\\"service\\\" style=\\\"grid-column:1 / -1\\\">\\n        <h3>Add‑On Retail &amp; Kits (optional)</h3>\\n        <p class=\\\"lead\\\" style=\\\"color:var(--muted)\\\">Carefully selected supplements, herbal kits, and at-home tools are available as adjuncts. These are optional purchases and not required for treatment.</p>\\n        <div class=\\\"addons\\\">\\n          <span class=\\\"pill\\\">Herbal Starter Kit</span>\\n          <span class=\\\"pill\\\">Digestive Support Bundle</span>\\n          <span class=\\\"pill\\\">Sleep Ritual Kit</span>\\n          <span class=\\\"pill\\\">At‑home Breathwork Guide</span>\\n        </div>\\n        <small class=\\\"disclaimer\\\">Retail items are educational and supportive. They are not guaranteed cures and are offered as part of a broader plan when appropriate.</small>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"testimonials\\\">\\n      <div class=\\\"t\\\">\\n        <strong>\\\"Grounding and practical\\\"</strong>\\n        <p style=\\\"color:var(--muted);margin:6px 0\\\">The plan felt realistic — small steps that actually changed my sleep. — J.</p>\\n      </div>\\n      <div class=\\\"t\\\">\\n        <strong>\\\"Support with clarity\\\"</strong>\\n        <p style=\\\"color:var(--muted);margin:6px 0\\\">Helpful education on digestion and stress management. — A.</p>\\n      </div>\\n      <div class=\\\"t\\\">\\n        <strong>\\\"Helpful add-ons\\\"</strong>\\n        <p style=\\\"color:var(--muted);margin:6px 0\\\">The herbal starter kit complemented my plan well. — R.</p>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>Phone: <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent1);text-decoration:none\\\">{{PHONE}}</a> &middot; Email: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent1);text-decoration:none\\\">{{EMAIL}}</a></div>\\n      <div>&copy; <strong>{{BUSINESS_NAME}}</strong></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"conditions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Concerns We Support</title>\\n  <style>\\n    :root{--bg:#05121a;--panel:#07232b;--accent:#a6f3d1;--muted:rgba(255,255,255,0.65);--card:rgba(255,255,255,0.03);--radius:14px}\\n    body{margin:0;min-height:100vh;background:radial-gradient(800px 400px at 10% 10%,#0b3a3b 0%,var(--bg) 40%),linear-gradient(180deg,#02121a,#031827);color:#e8fff4;font-family:Inter,system-ui,Segoe UI,Roboto,Arial}\\n    .site{max-width:980px;margin:48px auto;padding:26px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    header a{color:var(--accent);text-decoration:none;font-weight:700}\\n    .nav{display:flex;gap:12px}\\n    .hero{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:22px;border-radius:var(--radius);display:flex;gap:18px}\\n    .hero h1{margin:0;font-size:26px}\\n    .lead{color:var(--muted);margin-top:8px}\\n    .columns{display:grid;grid-template-columns:1fr 300px;gap:18px;margin-top:18px}\\n    .card{background:var(--card);padding:16px;border-radius:12px}\\n    .condition{margin-bottom:12px;padding:12px;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.015),transparent)}\\n    .condition h3{margin:0 0 6px 0}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:12px;background:var(--accent);color:#032; font-weight:800;text-decoration:none}\\n    .disclaimer{font-size:13px;color:rgba(255,255,255,0.6);margin-top:10px}\\n    /* unique SVG motif */\\n    .motif{position:fixed;left:-120px;bottom:-160px;opacity:0.12;pointer-events:none}\\n  </style>\\n</head>\\n<body>\\n  <!-- Unique decorative SVG pattern (assets/img/pattern.svg conceptual) -->\\n  <svg class=\\\"motif\\\" width=\\\"560\\\" height=\\\"560\\\" viewBox=\\\"0 0 560 560\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"g2\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"1\\\" y2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#7be495\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#d6b3ff\\\"/>\\n      </linearGradient>\\n    </defs>\\n    <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"560\\\" height=\\\"560\\\" rx=\\\"40\\\" fill=\\\"url(#g2)\\\"/>\\n    <g fill=\\\"rgba(255,255,255,0.06)\\\">\\n      <circle cx=\\\"120\\\" cy=\\\"120\\\" r=\\\"90\\\"/>\\n      <circle cx=\\\"420\\\" cy=\\\"420\\\" r=\\\"70\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"site\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">A whole-person view for modern life</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"conditions.html\\\">Conditions</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\" aria-labelledby=\\\"what-heading\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1 id=\\\"what-heading\\\">Common concerns people bring to their visit</h1>\\n        <p class=\\\"lead\\\">Our work centers on education, lifestyle tools, and individualized plans. Below are areas we commonly support — we never promise cures, only informed pathways and collaborative care.</p>\\n      </div>\\n      <div style=\\\"width:320px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Practical note</strong>\\n          <p style=\\\"color:var(--muted);margin:8px 0\\\">We sometimes recommend optional labs for clarity; labs are discussed and consented to during the plan-building process.</p>\\n          <a class=\\\"cta\\\" href=\\\"approach.html\\\">Learn our approach</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"columns\\\">\\n      <main>\\n        <section>\\n          <article class=\\\"condition\\\">\\n            <h3>Chronic Stress &amp; Burnout</h3>\\n            <p style=\\\"color:var(--muted)\\\">Symptoms: overwhelm, reduced resilience, difficulty concentrating. We teach nervous system tools, pacing strategies, and sleep-supportive routines.</p>\\n            <small class=\\\"disclaimer\\\">Educational support — if you have severe psychiatric symptoms or thoughts of self-harm, seek emergency or psychiatric care immediately.</small>\\n          </article>\\n\\n          <article class=\\\"condition\\\">\\n            <h3>Sleep Dysregulation</h3>\\n            <p style=\\\"color:var(--muted)\\\">Symptoms: difficulty falling or staying asleep, non-restorative sleep. Interventions focus on habits, light exposure, behavioral rituals, and targeted education.</p>\\n          </article>\\n\\n          <article class=\\\"condition\\\">\\n            <h3>Digestive Complaints</h3>\\n            <p style=\\\"color:var(--muted)\\\">Symptoms: bloating, irregular bowel patterns, heartburn. We use a biopsychosocial approach: diet patterns, mindfulness of eating, and when appropriate, laboratory guidance.</p>\\n          </article>\\n\\n          <article class=\\\"condition\\\">\\n            <h3>Inflammatory Patterns</h3>\\n            <p style=\\\"color:var(--muted)\\\">Symptoms: aches, flares, metabolic concerns. Interventions include anti-inflammatory lifestyle elements, nutrition education, and collaborative planning with your providers.</p>\\n          </article>\\n\\n          <article class=\\\"condition\\\">\\n            <h3>Low Energy &amp; Vitality</h3>\\n            <p style=\\\"color:var(--muted)\\\">Symptoms: persistent fatigue, difficulty sustaining daily energy. We review sleep, movement, micronutrient context, and stress load to craft stepwise changes.</p>\\n            <small class=\\\"disclaimer\\\">If you have unexplained severe fatigue, we may recommend medical tests and coordination with your primary care clinician.</small>\\n          </article>\\n        </section>\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <strong>Want a quick match?</strong>\\n          <p style=\\\"color:var(--muted)\\\">If one of these resonates, a focused telehealth education session may be a good first step to learn practical tools.</p>\\n          <a href=\\\"book.html\\\" class=\\\"cta\\\">Book a short visit</a>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <strong>Safety &amp; scope</strong>\\n          <p style=\\\"color:var(--muted)\\\">We emphasize collaboration with your medical providers. We do not replace urgent or emergency care.</p>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer style=\\\"margin-top:26px;color:var(--muted);display:flex;justify-content:space-between\\\">\\n      <div>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}}</div>\\n      <div>Call: <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{PHONE}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"approach.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Our Approach</title>\\n  <style>\\n    :root{--bg:#f6f9f8;--ink:#022;--accent:#6ae2b0;--violet:#b78eff}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#eafaf4,#f6f9f8);color:var(--ink)}\\n    .container{max-width:1000px;margin:36px auto;padding:26px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:12px;color:var(--ink);text-decoration:none;font-weight:700}\\n    .intro{display:flex;gap:18px;margin-top:18px}\\n    .panel{background:white;border-radius:14px;padding:18px;box-shadow:0 8px 30px rgba(12,20,30,0.08)}\\n    .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .step{padding:14px;border-radius:12px;border:1px solid rgba(0,0,0,0.04)}\\n    .muted{color:rgba(0,0,0,0.6);font-size:14px}\\n    .cta{display:inline-block;margin-top:14px;padding:10px 14px;border-radius:12px;background:linear-gradient(90deg,var(--accent),var(--violet));color:#022;font-weight:800;text-decoration:none}\\n    .labs{margin-top:12px;background:linear-gradient(180deg,rgba(107,214,176,0.12),transparent);padding:12px;border-radius:10px}\\n    footer{margin-top:28px;color:rgba(0,0,0,0.6)}\\n    /* decorative vector */\\n    .vector{position:fixed;right:12px;top:140px;opacity:0.14;pointer-events:none}\\n  </style>\\n</head>\\n<body>\\n  <!-- Unique decorative SVG pattern (assets/img/pattern.svg conceptual) -->\\n  <svg class=\\\"vector\\\" width=\\\"240\\\" height=\\\"420\\\" viewBox=\\\"0 0 240 420\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"g3\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"1\\\" y2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#7be495\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#a78bfa\\\"/>\\n      </linearGradient>\\n    </defs>\\n    <g fill=\\\"url(#g3)\\\">\\n      <path d=\\\"M60 10c30 20 80 10 120 50s20 120-40 150S10 160 10 90 30-10 60 10z\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div>\\n        <strong style=\\\"font-size:18px\\\">{{BUSINESS_NAME}}</strong>\\n        <div style=\\\"font-size:13px;color:rgba(0,0,0,0.6)\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"conditions.html\\\">Concerns</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"intro\\\">\\n      <div style=\\\"flex:1\\\" class=\\\"panel\\\">\\n        <h1 style=\\\"margin:0\\\">A stepwise, educational path to balanced wellbeing</h1>\\n        <p class=\\\"muted\\\">We approach care like a series of experiments: intake, collaborative plan, short cycles of implementation, and reassessment. Optional labs are offered as tools for clarity, not as the sole answer.</p>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Schedule an intake</a>\\n      </div>\\n      <div style=\\\"width:320px\\\" class=\\\"panel\\\">\\n        <strong>Philosophy</strong>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Whole-person: body, mind, rhythms, and environment. Each plan is tailored — educational, achievable, and measurable.</p>\\n      </div>\\n    </section>\\n\\n    <section aria-labelledby=\\\"how-heading\\\">\\n      <h2 id=\\\"how-heading\\\" style=\\\"margin-top:22px\\\">How a typical engagement flows</h2>\\n      <div class=\\\"steps\\\">\\n        <div class=\\\"step\\\">\\n          <strong>Intake</strong>\\n          <p class=\\\"muted\\\">Comprehensive history, goals, and baseline education. We listen first and gather what matters most.</p>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <strong>Personalized Plan</strong>\\n          <p class=\\\"muted\\\">A tiered plan with short-term actions and educational resources: sleep practices, movement, nutrition patterns, stress tools.</p>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <strong>Follow-ups</strong>\\n          <p class=\\\"muted\\\">Short visits to review data, troubleshoot, and adapt. We use measurable small goals rather than vague prescriptions.</p>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:18px\\\" class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0\\\">Optional labs &amp; testing — educational context</h3>\\n        <p class=\\\"muted\\\">When indicated, we may suggest targeted labs (e.g., thyroid panel, basic metabolic, micronutrient context, or digestive markers) to inform the plan. Testing is optional and occurs with informed consent. Labs are interpreted in partnership with your primary clinician when needed.</p>\\n        <div class=\\\"labs\\\">\\n          <strong>Commonly discussed tests</strong>\\n          <ul style=\\\"margin:8px 0;color:rgba(0,0,0,0.65)\\\">\\n            <li>Basic metabolic &amp; endocrine panels</li>\\n            <li>Thyroid function tests</li>\\n            <li>Micronutrient screening where relevant</li>\\n            <li>Stool or breath testing for persistent digestive symptoms</li>\\n          </ul>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"panel\\\" style=\\\"margin-top:14px\\\">\\n        <h3 style=\\\"margin-top:0\\\">Shared decision-making &amp; education</h3>\\n        <p class=\\\"muted\\\">Every recommendation includes rationale, alternatives, and expected timeframes. You remain the primary decision-maker; we are a guide and an educator throughout.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"display:flex;gap:12px;margin-top:18px\\\">\\n      <div class=\\\"panel\\\" style=\\\"flex:1\\\">\\n        <strong>Payment &amp; packages</strong>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">We offer single visits and package pricing for ongoing support. Retail items are optional add-ons to support the plan.</p>\\n        <a href=\\\"pricing.html\\\" class=\\\"cta\\\">See pricing</a>\\n      </div>\\n\\n      <div class=\\\"panel\\\" style=\\\"width:320px\\\">\\n        <strong>Ready to start?</strong>\\n        <p class=\\\"muted\\\">If this approach resonates, begin with a comprehensive intake to establish baseline goals.</p>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Book intake</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> &middot; {{PHONE}}</div>\\n        <div style=\\\"font-weight:700\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
