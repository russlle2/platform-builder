          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investment | {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Transparent session and series pricing for integrative, whole-person care in {{CITY}}, {{STATE}}.\\\">\\n  <style>\\n    :root{--bg:#f8fbfa;--card:#ffffff;--muted:#6b7280;--accent1:#7dd3fc;--accent2:#c7b8ff;--glass:rgba(255,255,255,0.7);--radius:14px;--max:980px}\\n    *{box-sizing:border-box}\\n    html,body{height:100%}\\n    body{margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial;color:#0f172a;background:linear-gradient(180deg,var(--bg),#eef7f6);display:flex;flex-direction:column;align-items:center}\\n    .wrap{width:92%;max-width:var(--max);position:relative;padding:48px 0}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}\\n    header a.logo{font-weight:700;color:#06202a;text-decoration:none}\\n    nav{display:flex;gap:12px}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px 12px;border-radius:10px;font-size:0.95rem}\\n    nav a:hover{background:linear-gradient(90deg,var(--accent1),var(--accent2));color:#022;}\\n    /* SVG backdrop */\\n    .bg-svg{position:fixed;inset:0;z-index:-1;opacity:0.18}\\n    main{display:grid;grid-template-columns:1fr;gap:22px}\\n    .hero{display:grid;gap:10px;padding:28px;border-radius:var(--radius);background:linear-gradient(180deg,rgba(255,255,255,0.6),rgba(255,255,255,0.4));backdrop-filter:blur(6px);box-shadow:0 6px 30px rgba(6,18,25,0.06)}\\n    .hero h1{margin:0;font-size:1.6rem;color:#023047}\\n    .hero p{margin:0;color:var(--muted)}\\n    /* Pricing grid */\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:8px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 8px 20px rgba(2,6,23,0.05);border:1px solid rgba(3,7,18,0.04)}\\n    .price{font-size:1.45rem;font-weight:700;color:#044d4a}\\n    .muted{color:var(--muted);font-size:0.92rem}\\n    ul.features{padding-left:18px;margin:12px 0 0 0;color:var(--muted);line-height:1.5}\\n    .btn{display:inline-block;background:linear-gradient(90deg,var(--accent1),var(--accent2));color:#022;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:600}\\n    .note{font-size:0.85rem;color:var(--muted);margin-top:12px}\\n    footer{margin-top:26px;padding:18px 0;color:var(--muted);font-size:0.9rem}\\n    /* responsive */\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}.wrap{padding:26px 0}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique SVG pattern for pricing page -->\\n  <svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 800 600\\\" preserveAspectRatio=\\\"xMidYMid slice\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#e6fbff\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#f3eaff\\\"/></linearGradient>\\n      <pattern id=\\\"p1\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(10)\\\">\\n        <rect width=\\\"40\\\" height=\\\"40\\\" fill=\\\"url(#g1)\\\"/>\\n        <path d=\\\"M0 20 L10 10 M20 0 L30 10 M10 30 L20 20\\\" stroke=\\\"#dbeef3\\\" stroke-width=\\\"1\\\"/>\\n      </pattern>\\n      <filter id=\\\"soft\\\"><feGaussianBlur stdDeviation=\\\"22\\\"/></filter>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\" filter=\\\"url(#soft)\\\"/>\\n    <g fill-opacity=\\\"0.5\\\">\\n      <ellipse cx=\\\"680\\\" cy=\\\"120\\\" rx=\\\"280\\\" ry=\\\"80\\\" fill=\\\"#dbeefd\\\" />\\n      <ellipse cx=\\\"120\\\" cy=\\\"520\\\" rx=\\\"240\\\" ry=\\\"80\\\" fill=\\\"#efe4ff\\\" />\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <a class=\\\"logo\\\" href=\\\"/\\\">{{BUSINESS_NAME}}</a>\\n      <nav>\\n        <a href=\\\"/\\\">Nest</a>\\n        <a href=\\\"/services.html\\\">Care</a>\\n        <a href=\\\"/conditions.html\\\">Ailments</a>\\n        <a href=\\\"/approach.html\\\">How we work</a>\\n        <a href=\\\"/about.html\\\">Who</a>\\n        <a href=\\\"/book.html\\\">Reserve</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"hero\\\">\\n        <h1>Support that meets the whole of you — clear, compassionate, and structured.</h1>\\n        <p>Pricing for sessions, short series, and small-group workshops. Transparent tiers so you can choose care that fits your life. No promises of cures — just education, tailored plans, and steady collaborative support.</p>\\n      </section>\\n\\n      <section>\\n        <div class=\\\"grid\\\">\\n          <div class=\\\"card\\\">\\n            <div class=\\\"muted\\\">Introductory Visit</div>\\n            <div class=\\\"price\\\">$150</div>\\n            <p class=\\\"muted\\\">90 minutes — comprehensive intake, health story, and initial guidance.</p>\\n            <ul class=\\\"features\\\">\\n              <li>Whole-person intake & history</li>\\n              <li>Brief physical, symptom mapping</li>\\n              <li>Initial plan & home practices</li>\\n            </ul>\\n            <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n            <div class=\\\"note\\\">Insurance: evaluate on a case-by-case basis. Ask during booking.</div>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <div class=\\\"muted\\\">Series of Sessions (Recommended)</div>\\n            <div class=\\\"price\\\">$780</div>\\n            <p class=\\\"muted\\\">6 sessions — consistent care designed to shift patterns and build resilience.</p>\\n            <ul class=\\\"features\\\">\\n              <li>Personalized curriculum across visits</li>\\n              <li>Optional lab education (if indicated)</li>\\n              <li>Between-session check-ins & micro-habits</li>\\n            </ul>\\n            <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a Series</a></div>\\n            <div class=\\\"note\\\">Series pricing reflects planned continuity; single-session option available.</div>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <div class=\\\"muted\\\">Group Workshop / Events</div>\\n            <div class=\\\"price\\\">$40–$120</div>\\n            <p class=\\\"muted\\\">Community classes focused on sleep, stress resilience, digestion, or mindful movement.</p>\\n            <ul class=\\\"features\\\">\\n              <li>Short evidence-informed teachings</li>\\n              <li>Practical habit workshops</li>\\n              <li>Q&amp;A and resource takeaways</li>\\n            </ul>\\n            <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"/services.html\\\">See Events</a></div>\\n            <div class=\\\"note\\\">Group events are educational and not a substitute for individualized medical care.</div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:18px;padding:14px;border-radius:10px;background:linear-gradient(90deg,rgba(255,255,255,0.6),rgba(248,253,253,0.6));border:1px solid rgba(3,7,18,0.03)\\\">\\n          <strong>Payment</strong>\\n          <p class=\\\"muted\\\">We accept card payments and flexible invoicing. If cost is a barrier, ask about sliding-scale options when you book: transparency and access are part of our care values.</p>\\n        </div>\\n      </section>\\n\\n      <section>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 8px 0\\\">What the price includes — a short map</h3>\\n          <p class=\\\"muted\\\">Each paid visit prioritizes teaching, measurable goals, and skills you can use daily. Typical components:</p>\\n          <ul class=\\\"features\\\">\\n            <li>Symptom synthesis & root-concern framing</li>\\n            <li>Behavioral micro-habits and gentle rituals</li>\\n            <li>Optional educational labs and referrals</li>\\n            <li>Progress tracking and adjustments</li>\\n          </ul>\\n          <p class=\\\"note\\\">All care follows education-first principles. We do not promise cures; we support skill-building and resilience.</p>\\n        </div>\\n      </section>\\n\\n      <section>\\n        <div style=\\\"display:flex;gap:12px;flex-wrap:wrap;align-items:center\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve a Time</a>\\n          <div class=\\\"muted\\\">Or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> · <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        </div>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} &middot; {{CITY}}, {{STATE}} · {{PRACTITIONER_NAME}}, {{CREDENTIALS}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About | {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Meet the practitioner and learn our integrative perspective—rooted in education, gentle routines, and collaborative planning.\\\">\\n  <style>\\n    :root{--bg:#fffdfb;--ink:#04151a;--muted:#6c757d;--accent:#b9f2e0;--card:#ffffff;--radius:12px;--max:900px}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,var(--bg),#f3fbf8);color:var(--ink);display:flex;justify-content:center}\\n    .container{width:94%;max-width:var(--max);padding:36px 0}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}\\n    header a.logo{font-weight:700;color:var(--ink);text-decoration:none}\\n    nav{display:flex;gap:10px}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px;border-radius:8px}\\n    nav a:hover{background:#eef;}\\n    .hero{padding:18px;border-radius:var(--radius);background:linear-gradient(180deg,#ffffff,#fbfffd);box-shadow:0 8px 24px rgba(2,6,23,0.04);display:flex;gap:18px;align-items:center}\\n    .avatar{width:84px;height:84px;border-radius:14px;background:linear-gradient(135deg,#d6f7eb,#f0e7ff);display:flex;align-items:center;justify-content:center;font-weight:700;color:#033;}\\n    h1{margin:0;font-size:1.4rem}\\n    p.lead{margin:6px 0 0 0;color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    .card{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 6px 20px rgba(2,6,23,0.04)}\\n    .muted{color:var(--muted)}\\n    .micro{display:flex;flex-direction:column;gap:8px;margin-top:12px}\\n    .micro p{margin:0;padding:10px;border-radius:8px;background:linear-gradient(90deg,#fbfff8,#fffafc);}\\n    .cta{margin-top:14px}\\n    .btn{background:#7dd3fc;padding:10px 12px;border-radius:10px;color:#022;text-decoration:none;font-weight:600}\\n    @media(max-width:920px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique SVG pattern for about page -->\\n  <svg style=\\\"position:fixed;inset:0;z-index:-1;opacity:0.12\\\" viewBox=\\\"0 0 1000 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"a\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#f0fff9\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#fff6ff\\\"/></linearGradient>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#a)\\\"/>\\n    <g transform=\\\"translate(40,40)\\\" fill=\\\"#e6f7ef\\\">\\n      <circle cx=\\\"160\\\" cy=\\\"80\\\" r=\\\"90\\\"/>\\n      <circle cx=\\\"840\\\" cy=\\\"460\\\" r=\\\"140\\\" fill=\\\"#f4e9ff\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"container\\\">\\n    <header>\\n      <a class=\\\"logo\\\" href=\\\"/\\\">{{BUSINESS_NAME}}</a>\\n      <nav>\\n        <a href=\\\"/\\\">Begin</a>\\n        <a href=\\\"/services.html\\\">Offerings</a>\\n        <a href=\\\"/conditions.html\\\">Concerns</a>\\n        <a href=\\\"/pricing.html\\\">Costs</a>\\n        <a href=\\\"/book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"hero\\\">\\n        <div class=\\\"avatar\\\">{{PRACTITIONER_NAME.split(' ')[0][0]}}</div>\\n        <div>\\n          <h1>Compassionate guidance, clinical curiosity</h1>\\n          <p class=\\\"lead\\\">{{PRACTITIONER_NAME}}, {{CREDENTIALS}} — an integrative practitioner teaching sustainable practices that meet your biology and rhythm.</p>\\n        </div>\\n      </section>\\n\\n      <div class=\\\"grid\\\">\\n        <div>\\n          <div class=\\\"card\\\">\\n            <h3 style=\\\"margin:0 0 8px 0\\\">A human-centered approach</h3>\\n            <p class=\\\"muted\\\">We blend evidence-informed interventions with lifestyle scaffolding: nutrition basics, sleep architecture, stress physiology, and movement—always adapted to your story. Care is education-forward: we teach, you practice, we adjust.</p>\\n            <div class=\\\"micro\\\">\\n              <p><strong>Intake</strong> — detailed history, priorities, and context.</p>\\n              <p><strong>Synthesis</strong> — a clear problem map and learning plan.</p>\\n              <p><strong>Rhythms</strong> — small daily habits designed to compound into better balance.</p>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n            <h4 style=\\\"margin:0 0 8px 0\\\">Clinical philosophy</h4>\\n            <p class=\\\"muted\\\">Care is collaborative and iterative. We use optional labs or referrals as educational tools, not as a single authority. You remain the expert on your life; we provide structure, evidence, and accountability.</p>\\n            <p class=\\\"muted\\\" style=\\\"margin-top:10px\\\">We do not offer guaranteed cures; outcomes vary and depend on many factors. Our commitment is to teach clear, manageable steps and support your agency.</p>\\n          </div>\\n        </div>\\n\\n        <aside>\\n          <div class=\\\"card\\\">\\n            <h4 style=\\\"margin:0 0 8px 0\\\">Quick details</h4>\\n            <p class=\\\"muted\\\">Location: {{CITY}}, {{STATE}}</p>\\n            <p class=\\\"muted\\\">Contact: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> · <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></p>\\n            <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule a Visit</a></div>\\n          </div>\\n\\n          <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n            <h4 style=\\\"margin:0 0 8px 0\\\">Micro-habits we teach</h4>\\n            <ul style=\\\"padding-left:16px;color:var(--muted);margin:0\\\">\\n              <li>Evening wind-down ritual (20–30 min)</li>\\n              <li>Two simple breath practices for pause</li>\\n              <li>Meal timing suggestions for digestion</li>\\n            </ul>\\n            <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">These are offered as gentle experiments to discover what supports you.</p>\\n          </div>\\n        </aside>\\n      </div>\\n\\n      <section style=\\\"margin-top:18px\\\">\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 8px 0\\\">Training & background</h3>\\n          <p class=\\\"muted\\\">{{PRACTITIONER_NAME}} holds clinical training in integrative disciplines and brings years of experience in patient-centered education. Ongoing study in nutrition, sleep, and behavioral medicine informs the work.</p>\\n        </div>\\n      </section>\\n\\n    </main>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted)\\\">\\n      <div>{{BUSINESS_NAME}} · Teaching tools, plans, and steady support. Reach: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a Visit | {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Reserve an introductory visit or join a small-group event. Simple booking with clear next steps.\\\">\\n  <style>\\n    :root{--bg:#fbfffe;--ink:#042029;--muted:#6b7280;--accent:#b8e9d7;--card:#fff;--radius:12px;--max:920px}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial;background:linear-gradient(180deg,var(--bg),#f0fbfa);color:var(--ink);display:flex;justify-content:center}\\n    .wrap{width:94%;max-width:var(--max);padding:36px 0}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}\\n    nav{display:flex;gap:10px}\\n    nav a{color:var(--muted);text-decoration:none}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:18px}\\n    .card{background:var(--card);padding:18px;border-radius:var(--radius);box-shadow:0 10px 30px rgba(2,6,23,0.05)}\\n    label{display:block;font-size:0.92rem;margin-top:12px;color:var(--muted)}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(3,7,18,0.06);margin-top:6px}\\n    .btn{display:inline-block;background:linear-gradient(90deg,#9be7d7,#cbb8ff);padding:10px 12px;border-radius:10px;color:#022;text-decoration:none;font-weight:700;border:none;cursor:pointer}\\n    .muted{color:var(--muted)}\\n    .small{font-size:0.88rem}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique SVG pattern for booking page -->\\n  <svg style=\\\"position:fixed;inset:0;z-index:-1;opacity:0.14\\\" viewBox=\\\"0 0 1000 700\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"b\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#f7fffb\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#fff8ff\\\"/></linearGradient>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#b)\\\"/>\\n    <g fill-opacity=\\\"0.6\\\">\\n      <rect x=\\\"40\\\" y=\\\"520\\\" width=\\\"300\\\" height=\\\"80\\\" rx=\\\"40\\\" fill=\\\"#e8fff6\\\"/>\\n      <rect x=\\\"620\\\" y=\\\"60\\\" width=\\\"340\\\" height=\\\"140\\\" rx=\\\"70\\\" fill=\\\"#f4edff\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <a class=\\\"logo\\\" href=\\\"/\\\">{{BUSINESS_NAME}}</a>\\n      <nav>\\n        <a href=\\\"/\\\">Home</a>\\n        <a href=\\\"/services.html\\\">What we offer</a>\\n        <a href=\\\"/about.html\\\">About</a>\\n        <a href=\\\"/pricing.html\\\">Fees</a>\\n      </nav>\\n    </header>\\n\\n    <main class=\\\"grid\\\">\\n      <section class=\\\"card\\\">\\n        <h2 style=\\\"margin:0 0 6px 0\\\">Reserve your visit</h2>\\n        <p class=\\\"muted small\\\" style=\\\"margin:0 0 12px 0\\\">Choose an introductory visit, a series, or a workshop. We will follow up by email with next steps and a short intake form.</p>\\n\\n        <form method=\\\"post\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\">\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"Your name\\\" required>\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n\\n          <label for=\\\"phone\\\">Phone</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"{{PHONE}}\\\">\\n\\n          <label for=\\\"service\\\">Service</label>\\n          <select id=\\\"service\\\" name=\\\"service\\\">\\n            <option>Introductory Visit — 90 min</option>\\n            <option>6-session Series</option>\\n            <option>Group Workshop / Event</option>\\n          </select>\\n\\n          <label for=\\\"date\\\">Preferred date</label>\\n          <input id=\\\"date\\\" name=\\\"date\\\" type=\\\"date\\\">\\n\\n          <label for=\\\"note\\\">Short note (what matters most)</label>\\n          <textarea id=\\\"note\\\" name=\\\"note\\\" rows=\\\"4\\\" placeholder=\\\"A few words about what you hope to address\\\"></textarea>\\n\\n          <div style=\\\"margin-top:14px;display:flex;gap:10px;align-items:center\\\">\\n            <button type=\\\"submit\\\" class=\\\"btn\\\">Request a Booking</button>\\n            <div class=\\\"muted small\\\">Or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n          </div>\\n\\n          <p class=\\\"muted small\\\" style=\\\"margin-top:10px\\\">By requesting an appointment you consent to follow-up by email or phone. We provide education-first integrative care; no guaranteed cures are offered.</p>\\n        </form>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0 0 8px 0\\\">Quick notes</h4>\\n          <p class=\\\"muted\\\">Intro visit: 90 minutes. Series and workshops have variable lengths. If you need an urgent medical assessment, please visit urgent care or contact your primary provider.</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0 0 8px 0\\\">Fees snapshot</h4>\\n          <div class=\\\"muted small\\\">Intro visit: $150 · Series (6): $780 · Group events: $40–$120</div>\\n          <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"/pricing.html\\\">See full pricing</a></div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0 0 8px 0\\\">What to expect next</h4>\\n          <ol