          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investment & Membership — Aromatherapy</title>\\n  <style>\\n    :root{--bg:#f7efe6;--accent:#7a4b2a;--muted:#8a6f5b;--card:#fff2ea;--glass:rgba(255,255,255,0.6);--shadow:rgba(122,75,42,0.08);--radius:14px;}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--accent);background:linear-gradient(180deg,var(--bg),#fff) fixed;}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px;background:linear-gradient(90deg,rgba(122,75,42,0.04),transparent);backdrop-filter:blur(4px);}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:46px;height:46px;border-radius:10px;background:radial-gradient(circle at 30% 30%,#f3d7c7,#e0a77b);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;box-shadow:var(--shadow) 0 6px 18px;}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 12px;font-size:15px}\\n    .cta{background:var(--accent);color:#fff;padding:8px 14px;border-radius:10px;text-decoration:none}\\n    main{max-width:980px;margin:28px auto;padding:24px}\\n    .hero{display:grid;grid-template-columns:1fr;gap:18px;padding:22px;border-radius:var(--radius);background:linear-gradient(180deg,var(--card),#fff);box-shadow:0 8px 30px rgba(0,0,0,0.04)}\\n    .kicker{font-size:13px;color:var(--muted);}\\n    h1{margin:6px 0 0;font-size:28px}\\n    p.lead{margin:6px 0 0;color:var(--muted);line-height:1.45}\\n    .plans{display:flex;gap:18px;margin-top:18px}\\n    .plan{flex:1;padding:18px;background:#fff;border-radius:12px;border:1px solid rgba(122,75,42,0.06)}\\n    .plan h3{margin:0 0 6px;color:var(--accent)}\\n    .price{font-size:22px;font-weight:700;color:var(--accent);margin:6px 0}\\n    ul{padding-left:18px;color:var(--muted)}\\n    .fine{font-size:13px;color:var(--muted);margin-top:12px}\\n    .binder{margin-top:18px;padding:14px;border-radius:10px;background:linear-gradient(180deg,rgba(234,216,200,0.6),transparent)}\\n    footer{margin-top:34px;padding:18px 24px;border-radius:12px;background:var(--glass);display:flex;justify-content:space-between;align-items:center;color:var(--muted)}\\n    .small{font-size:13px}\\n    .testimonial{margin-top:14px;padding:12px;border-radius:10px;background:#fff;border:1px dashed rgba(122,75,42,0.06)}\\n    .pattern{position:fixed;right:0;bottom:0;opacity:0.12;width:320px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted);\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav aria-label=\\\"primary\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Shop</a>\\n      <a href=\\\"pricing.html\\\" style=\\\"font-weight:700;color:var(--accent)\\\">Investment</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n    <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"kicker\\\">Memberships & single sessions</div>\\n      <h1>Longer rhythm, clearer habits. Choose a membership or single session that fits your routine.</h1>\\n      <p class=\\\"lead\\\">Our offerings are framed around repeatable practices that may support calm, focus, or sleep. Pricing below shows typical structures — membership includes prioritised scheduling and a seasonal blend refresh.</p>\\n\\n      <div class=\\\"plans\\\" role=\\\"list\\\">\\n        <div class=\\\"plan\\\" role=\\\"listitem\\\">\\n          <h3>Foundation Plan</h3>\\n          <div class=\\\"price\\\">$45 / session (pay-as-you-go)</div>\\n          <ul>\\n            <li>Single aromatherapy consultation or blend card</li>\\n            <li>Safe dilution guide and application notes</li>\\n            <li>Email follow-up</li>\\n          </ul>\\n          <div class=\\\"fine\\\">Good for trying a focused session without commitment.</div>\\n        </div>\\n\\n        <div class=\\\"plan\\\" role=\\\"listitem\\\">\\n          <h3>Seasonal Rhythm Membership</h3>\\n          <div class=\\\"price\\\">$120 / month</div>\\n          <ul>\\n            <li>Two 45-min sessions monthly (one consult + one check-in)</li>\\n            <li>Quarterly blend refresh + doorstep sample</li>\\n            <li>Priority booking and member-only guidance</li>\\n          </ul>\\n          <div class=\\\"fine\\\">Designed to anchor a slow, observable shift across weeks.</div>\\n        </div>\\n\\n        <div class=\\\"plan\\\" role=\\\"listitem\\\">\\n          <h3>Focused Course (4 weeks)</h3>\\n          <div class=\\\"price\\\">$360 one-time</div>\\n          <ul>\\n            <li>Weekly 60-min sessions</li>\\n            <li>Personalized ritual and at-home plan</li>\\n            <li>Printable blend cards + diluted samples</li>\\n          </ul>\\n          <div class=\\\"fine\\\">A short, structured program to build daily practice.</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"binder\\\">\\n        <strong>Why membership?</strong>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Repetition supports noticing small changes. Memberships prioritize continuity, access to seasonal blends, and a predictable cadence for adjustments. No promises — aromatics may support a sense of settling, attention, and ritual.</div>\\n      </div>\\n\\n      <div class=\\\"testimonial\\\">\\n        <strong style=\\\"color:var(--accent)\\\">Client note</strong>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">\\\"Simple, science-minded guidance with safe, usable blends. The seasonal plan keeps things gentle and easy to follow.\\\" — local client</div>\\n      </div>\\n\\n      <div style=\\\"display:flex;gap:12px;margin-top:18px;align-items:center\\\">\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Join the rhythm</a>\\n        <a href=\\\"book.html\\\" style=\\\"padding:8px 14px;border-radius:10px;background:transparent;border:1px solid rgba(122,75,42,0.08);text-decoration:none;color:var(--accent)\\\">Schedule a trial</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;\\\">\\n      <h2 style=\\\"margin:0 0 6px\\\">Membership details & policies</h2>\\n      <div style=\\\"color:var(--muted);line-height:1.5\\\">Memberships are billed monthly. You may pause membership with 30 days' notice. All aromatic guidance is educational and safety-forward — we include dilution guidance, patch testing instructions, and clear notes about pregnancy, medications, and animal safety in our materials.</div>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"small\\\">Questions? Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div class=\\\"small\\\">Serving {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </main>\\n\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#f4d6c2\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#e6b58a\\\"/>\\n      </linearGradient>\\n    </defs>\\n    <rect width=\\\"200\\\" height=\\\"200\\\" fill=\\\"url(#g1)\\\" rx=\\\"20\\\"/>\\n    <g fill-opacity=\\\"0.06\\\" fill=\\\"#7a4b2a\\\">\\n      <circle cx=\\\"40\\\" cy=\\\"40\\\" r=\\\"36\\\"/>\\n      <circle cx=\\\"120\\\" cy=\\\"90\\\" r=\\\"50\\\"/>\\n      <circle cx=\\\"60\\\" cy=\\\"150\\\" r=\\\"30\\\"/>\\n    </g>\\n  </svg>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — Aromatherapy Practice</title>\\n  <style>\\n    :root{--bg:#fbf7f2;--accent:#6b422a;--muted:#856451;--card:#fff7f2;--glass:rgba(255,255,255,0.7);--radius:12px}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--accent);background:var(--bg)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 26px;background:linear-gradient(90deg,rgba(107,66,42,0.04),transparent)}\\n    .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(180deg,#f7decf,#e9b892);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none}\\n    main{max-width:1000px;margin:26px auto;padding:18px}\\n    .intro{padding:18px;border-radius:var(--radius);background:linear-gradient(180deg,var(--card),#fff);box-shadow:0 10px 24px rgba(107,66,42,0.04)}\\n    h1{margin:6px 0;color:var(--accent)}\\n    p{color:var(--muted);line-height:1.5}\\n    .two{display:grid;grid-template-columns:1fr 340px;gap:18px;margin-top:18px}\\n    .bio{padding:16px;background:#fff;border-radius:12px}\\n    aside{padding:14px;border-radius:12px;background:linear-gradient(180deg,rgba(234,216,200,0.5),transparent)}\\n    .builder{margin-top:10px;padding:12px;background:#fff;border-radius:10px}\\n    label{display:block;font-size:13px;margin-top:8px;color:var(--muted)}\\n    select,input[type=text]{width:100%;padding:8px;border-radius:8px;border:1px solid rgba(133,100,81,0.12);margin-top:6px}\\n    button{margin-top:10px;padding:10px 12px;border-radius:10px;border:0;background:var(--accent);color:#fff}\\n    .card{margin-top:12px;padding:12px;border-radius:8px;background:#fff;border:1px solid rgba(107,66,42,0.06)}\\n    .legal{font-size:13px;color:var(--muted);margin-top:12px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Shop</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"about.html\\\" style=\\\"font-weight:700;color:var(--accent)\\\">About</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"intro\\\">\\n      <h1>A quiet approach to scent and routine</h1>\\n      <p>We sit with evidence-informed safety, careful dilution, and simple rituals you can return to. Aromatics may support moments of calm, clearer windows of attention, and improved at-home ritual consistency. Our focus is practical: usable blends, clear patch test instructions, and guidance that fits daily life.</p>\\n    </section>\\n\\n    <div class=\\\"two\\\">\\n      <div class=\\\"bio\\\">\\n        <h2 style=\\\"margin-top:0\\\">Practice note</h2>\\n        <p style=\\\"color:var(--muted)\\\">Sessions blend sensory education with practical templates — how to diffuse thoughtfully, how to dilute for topical use, and how to build a short ritual that fits morning or evening. We emphasize the least-invasive option first and include notes for pregnancy, children, and pets.</p>\\n\\n        <div class=\\\"card\\\">\\n          <strong>What to expect in a consult</strong>\\n          <ul style=\\\"color:var(--muted);margin:8px 0 0 18px\\\">\\n            <li>30–60 minute intake focused on preferences and safety</li>\\n            <li>Clear dilution and patch-test instructions</li>\\n            <li>Personalized blend card and simple ritual</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"legal\\\">All guidance is educational. Essential oils are concentrated substances. Always patch test and consult a healthcare provider for specific medical questions. See FAQ for dilution, pregnancy, and pet notes.</div>\\n      </div>\\n\\n      <aside>\\n        <h3 style=\\\"margin:0\\\">Blend Builder</h3>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Choose a vibe below and get a non-medical blend card plus a safe dilution guide you can use at home.</div>\\n\\n        <div class=\\\"builder\\\" id=\\\"blendBuilder\\\">\\n          <label for=\\\"vibe\\\">Desired vibe</label>\\n          <select id=\\\"vibe\\\">\\n            <option value=\\\"calm\\\">Calm / Grounded</option>\\n            <option value=\\\"focus\\\">Focus / Clarity</option>\\n            <option value=\\\"sleep\\\">Sleep / Wind-down</option>\\n            <option value=\\\"bright\\\">Uplift / Cheer</option>\\n          </select>\\n\\n          <label for=\\\"volume\\\">Target bottle size</label>\\n          <select id=\\\"volume\\\">\\n            <option value=\\\"10\\\">10 mL (roller or small bottle)</option>\\n            <option value=\\\"30\\\">30 mL (spray / bottle)</option>\\n          </select>\\n\\n          <label for=\\\"carrier\\\">Carrier oil</label>\\n          <select id=\\\"carrier\\\">\\n            <option>Fractionated coconut oil</option>\\n            <option>Sweet almond oil</option>\\n            <option>Apricot kernel oil</option>\\n            <option>Jojoba</option>\\n          </select>\\n\\n          <button id=\\\"buildBtn\\\">Create blend card</button>\\n\\n          <div id=\\\"blendResult\\\" class=\\\"card\\\" aria-live=\\\"polite\\\" style=\\\"display:none\\\"></div>\\n        </div>\\n\\n        <div class=\\\"legal\\\">Notes: This builder gives non-medical suggestions and conservative dilutions. If pregnant, nursing, on medication, or caring for animals, follow the FAQ and consult a clinician before topical use.</div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px;padding:14px;border-radius:12px;background:#fff;border:1px solid rgba(107,66,42,0.04)\\\">\\n      <h3 style=\\\"margin-top:0\\\">Questions commonly answered</h3>\\n      <details style=\\\"margin-top:8px\\\"><summary style=\\\"cursor:pointer;color:var(--accent)\\\">How strong should topical blends be?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Typical starting dilutions: 0.5–1% for facial areas, 1–2% for general adult topical use, and 0.25–0.5% for older adults or sensitive skin. This tool gives drop-per-bottle guidance; always patch test before widespread use.</div>\\n      </details>\\n\\n      <details style=\\\"margin-top:8px\\\"><summary style=\\\"cursor:pointer;color:var(--accent)\\\">What about pets?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Many essential oils affect animals differently. Keep blends out of reach, avoid concentrated topical use on pets, and avoid diffusing strong oils in small enclosed spaces with pets present. Consult a vet for specific guidance.</div>\\n      </details>\\n\\n      <details style=\\\"margin-top:8px\\\"><summary style=\\\"cursor:pointer;color:var(--accent)\\\">Pregnancy and nursing</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Some oils are contraindicated in pregnancy. If you are pregnant or nursing, discuss blends with a qualified clinician before use. We will always recommend extremely conservative dilutions and prioritise diffusion over topical use when appropriate.</div>\\n      </details>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div style=\\\"color:var(--muted)\\\">Ready to build a blend and receive a printable card? Book a consult or create a starter blend now.</div>\\n      <div>\\n        <a href=\\\"book.html\\\" style=\\\"padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none\\\">Book a consult</a>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:26px;padding:18px;text-align:center;color:var(--muted)\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}} • Serving {{CITY}}, {{STATE}}</footer>\\n  </main>\\n\\n  <script>\\n    (function(){\\n      const vibes = {\\n        calm: {name:'Calm / Grounded',notes:['Lavender','Frankincense','Cedarwood'],profile:'earthy, floral'},\\n        focus:{name:'Focus / Clarity',notes:['Rosemary','Bergamot','Peppermint'],profile:'bright, herbal'},\\n        sleep:{name:'Sleep / Wind-down',notes:['Lavender','Roman Chamomile','Vetiver'],profile:'soft, resinous'},\\n        bright:{name:'Uplift / Cheer',notes:['Sweet Orange','Grapefruit','Ginger'],profile:'citrus, spicy'}\\n      };\\n\\n      function dropsForDilution(volumeMl, percent){\\n        // approximate: 1 mL ~ 20 drops\\n        const totalDrops = Math.round(volumeMl * 20);\\n        return Math.max(1, Math.round(totalDrops * (percent/100)));\\n      }\\n\\n      document.getElementById('buildBtn').addEventListener('click', function(){\\n        const vibeKey = document.getElementById('vibe').value;\\n        const vol = Number(document.getElementById('volume').value);\\n        const carrier = document.getElementById('carrier').value;\\n        const info = vibes[vibeKey];\\n        // choose conservative dilution for general use\\n        const dilutionPercent = vol <= 10 ? 1.0 : 2.0; // 1% for 10mL, 2% for 30mL\\n\\n        // split drops among 3 notes\\n        const totalDrops = dropsForDilution(vol,dilutionPercent);\\n        const perNote = Math.max(1, Math.round(totalDrops/3));\\n\\n        const card = {\\n          title: info.name,\\n          notes: info.notes,\\n          profile: info.profile,\\n          volumeMl: vol,\\n          carrier: carrier,\\n          dilutionPercent: dilutionPercent,\\n          dropsPerNote: perNote,\\n          instructions: 'Combine drops of essential oil into ' + vol + 'mL ' + carrier + '. Shake gently. Patch test on inner forearm and wait 24 hours.'\\n        };\\n\\n        const out = document.getElementById('blendResult');\\n        out.style.display='block';\\n        out.innerHTML = ''+\\n          '<strong style=\\\"color:var(--accent)\\\">'+card.title+'</strong>'+ \\n          '<div style=\\\"color:var(--muted);margin-top:8px\\\">Profile: '+card.profile+'</div>'+ \\n          '<div style=\\\"margin-top:10px\\\"><em>Notes</em>:</div>'+ \\n          '<ul style=\\\"color:var(--muted);margin-top:6px\\\">' + card.notes.map(n=>'<li>'+n+': '+card.dropsPerNote+' drop(s)</li>').join('') + '</ul>'+ \\n          '<div style=\\\"margin-top:8px;color:var(--muted)\\\">Dilution: ~'+card.dilutionPercent+'% total. '+card.instructions+'</div>'+ \\n          '<button id=\\\"copyBlend\\\" style=\\\"margin-top:10px;padding:8px 10px;border-radius:8px;background:var(--accent);color:#fff;border:0\\\">Copy blend card</button>';\\n\\n        document.getElementById('copyBlend').addEventListener('click', function(){\\n          const text = 'Blend: '+card.title+'\\\\nProfile: '+card.profile+'\\\\nVolume: '+card.volumeMl+' mL\\\\nCarrier: '+card.carrier+'\\\\nDilution: '+card.dilutionPercent+'%\\\\nNotes:'+card.notes.map((n,i)=>'\\\\n - '+n+': '+card.dropsPerNote+' drop(s)').join('')+'\\\\n'+card.instructions+'\\\\n\\\\nSafety: Patch test. Avoid in pregnancy without guidance. Keep away from pets.';\\n          navigator.clipboard && navigator.clipboard.writeText(text).then(()=>{\\n            alert('Blend card copied to clipboard');\\n          }).catch(()=>{ alert('Unable to copy — select and copy manually'); });\\n        });\\n      });\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a Session — Aromatherapy</title>\\n  <style>\\n    :root{--bg:#fffaf6;--accent:#6b422a;--muted:#825f4e;--card:#fff;--radius:12px}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--accent);background:var(--bg)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:16px 22px;background:linear-gradient(90deg,rgba(107,66,42,0.03),transparent)}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none}\\n    main{max-width:920px;margin:22px auto;padding:18px}\\n    .panel{padding:18px;border-radius:var(--radius);background:linear-gradient(180deg,var(--card),#fff);box-shadow:0 12px 28px rgba(107,66,42,0.05)}\\n    h1{margin:0 0 8px}\\n    form{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:14px}\\n    label{font-size:13px;color:var(--muted);display:block;margin-top:8px}\\n    input,textarea,select{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(130,95,78,0.08);font-size:14px}\\n    textarea{min-height:120px}\\n    .planner{padding:12px;border-radius:10px;background:linear-gradient(180deg,rgba(234,216,200,0.55),transparent)}\\n    button{padding:10px 12px;border-radius:10px;background:var(--accent);color:#fff;border:0}\\n    .summary{margin-top:12px;padding:12px;border-radius:8px;background:#fff;border:1px solid rgba(107,66,42,0.06)}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div style=\\\"width:44px;height:44px;border-radius:10px;background:linear-gradient(180deg,#f7decf,#e9b892);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Shop</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\" style=\\\"font-weight:700;color:var(--accent)\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"panel\\\">\\n      <h1>Plan a session</h1>\\n      <p style=\\\"color:var(--muted);margin-top:6px\\\">Use the session planner to draft what you want from a consult. The summary you create can be copied into your booking form or sent ahead of your appointment.</p>\\n\\n      <form id=\\\"plannerForm\\\">\\n        <div>\\n          <label for=\\\"name\\\">Your name</label>\\n          <input id=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"First and last name\\\" required>\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" type=\\\"text\\\" placeholder=\\\"you@domain.com\\\">\\n\\n          <label for=\\\"goal\\\">Primary goals (brief)</label>\\n          <input id=\\\"goal\\\" type=\\\"text\\\" placeholder=\\\"e.g., calmer evenings; clearer focus at work\\\">\\n\\n          <label for=\\\"duration\\\">Preferred session length</label>\\n          <select id=\\\"duration\\\">\\n            <option>30 minutes</option>\\n            <option selected>45 minutes</option>\\n            <option>60 minutes</option>\\n          </select>\\n\\n          <label for=\\\"frequency\\\">Desired frequency</label>\\n          <select id=\\\"frequency\\\">\\n            <option>One-time consult</option>\\n            <option>Weekly</option>\\n            <option>Bi-weekly</option>\\n            <option>Monthly</option>\\n          </select>\\n\\n          <label for=\\\"notes\\\">Anything else we should know? (allergies, medications, pregnancy, pets)</label>\\n          <textarea id=\\\"notes\\\" placeholder=\\\"Include relevant safety notes here\\\"></textarea>\\n\\n          <div style=\\\"margin-top:12px;display:flex;gap:10px\\\">\\n            <button type=\\\"button\\\" id=\\\"buildPlan\\\">Build plan</button>\\n            <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:inline-block;padding:10px 12px;border-radius:10px;background:transparent;border:1px solid rgba(107,66,42,0.06);text-decoration:none;color:var(--accent)\\\">Start booking</a>\\n          </div>\\n        </div>\\n\\n        <aside class=\\\"planner\\\">\\n          <strong>Planner output</strong>\\n          <div id=\\\"planSummary\\\" class=\\\"summary\\\">Use the form to the left and click \\\"Build plan\\\" to generate a personalized plan summary. You can copy the text to your clipboard for the booking form.</div>\\n          <div style=\\\"margin-top:10px;display:flex;gap:8px\\\">\\n            <button type=\\\"button\\\" id=\\\"copyPlan\\\">Copy summary</button>\\n            <button type=\\\"button\\\" id=\\\"clearPlan\\\" style=\\\"background:#efefef;color:var(--accent)\\\">Clear</button>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px;color:var(--muted);font-size:13px\\\">We prioritize safety. Expect patch-test guidance, conservative dilution recommendations, and notes for pregnancy and pets during the consult.</div>\\n        </aside>\\n      </form>\\n\\n      <div style=\\\"margin-top:18px;color:var(--muted)\\\">Prefer a quick phone chat? Call <strong>{{PHONE}}</strong> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted)\\\">Serving {{CITY}}, {{STATE}} • Thank you for approaching scent with care</footer>\\n  </main>\\n\\n  <script>\\n    (function(){\\n      const buildBtn = document.getElementById('buildPlan');\\n      const copyBtn = document.getElementById('copyPlan');\\n      const clearBtn = document.getElementById('clearPlan');\\n      const summary = document.getElementById('planSummary');\\n\\n      function sanitize(s){ return (s||'').toString().trim(); }\\n\\n      buildBtn.addEventListener('click', function(){\\n        const name = sanitize(document.getElementById('name').value) || 'Client';\\n        const email = sanitize(document.getElementById('email').value) || '{{EMAIL}}';\\n        const goal = sanitize(document.getElementById('goal').value) || 'General well-being';\\n        const duration = sanitize(document.getElementById('duration').value);\\n        const frequency = sanitize(document.getElementById('frequency').value);\\n        const notes = sanitize(document.getElementById('notes').value) || 'No additional notes.';\\n\\n        const planText = [];\\n        planText.push('Name: ' + name);\\n        planText.push('Email: ' + email);\\n        planText.push('Primary goal: ' + goal);\\n        planText.push('Preferred session length: ' + duration);\\n        planText.push('Desired frequency: ' + frequency);\\n        planText.push('Safety notes: ' + notes);\\n        planText.push('Suggested in-session focus: intake on scent history; patch test; 1–2 starter blends with conservative dilutions; simple at-home ritual.');\\n        planText.push('Next steps: Book a consult and bring any current products or notes.');\\n\\n        summary.textContent = planText.join('\\\\n');\\n      });\\n\\n      copyBtn.addEventListener('click', function(){\\n        const text = summary.textContent;\\n        if(!text) return alert('No summary to copy — build a plan first.');\\n        navigator.clipboard && navigator.clipboard.writeText(text).then(()=>{\\n          alert('Plan summary copied to clipboard');\\n        }).catch(()=>{ alert('Unable to copy automatically. Select the text and copy.') });\\n      });\\n\\n      clearBtn.addEventListener('click', function(){\\n        document.getElementById('plannerForm').reset();\\n        summary.textContent = 'Use the form to the left and click \\\"Build plan\\\" to generate a personalized plan summary. You can copy the text to your clipboard for the booking form.';\\n      });\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
