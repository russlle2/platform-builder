          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Membership — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#FFF8F2;--bg2:#F3FFF9;--accent:#7F5A83;--muted:#6B6B6B;--card:#FFFFFF;--glass:rgba(255,255,255,0.6)}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:#222;background:linear-gradient(180deg,var(--bg1),var(--bg2));}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:24px 28px;position:relative;z-index:3}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 12px;font-weight:600}\\n    .brand{font-weight:700;color:var(--accent)}\\n    .wrap{max-width:1100px;margin:28px auto;padding:32px;position:relative}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center}\\n    .hero-card{background:linear-gradient(180deg,rgba(255,255,255,0.7),var(--glass));border-radius:14px;padding:30px;box-shadow:0 6px 30px rgba(20,20,20,0.06)}\\n    h1{margin:0 0 8px 0;font-size:28px;color:var(--accent)}\\n    p.lead{margin:0;color:var(--muted);line-height:1.5}\\n    .membership-grid{display:flex;flex-direction:column;gap:18px}\\n    .tier{display:flex;align-items:flex-start;gap:16px;padding:18px;border-radius:12px;background:var(--card);box-shadow:0 6px 22px rgba(100,80,120,0.06)}\\n    .price{font-weight:800;font-size:20px;color:var(--accent)}\\n    .meta{color:var(--muted);font-size:13px}\\n    .btn{display:inline-block;padding:12px 18px;border-radius:10px;color:white;background:linear-gradient(90deg,#8B6FA1,#4BA089);text-decoration:none;font-weight:700}\\n    .muted{color:var(--muted);font-size:13px}\\n    .features{display:flex;gap:12px;flex-wrap:wrap;margin-top:10px}\\n    .pill{background:linear-gradient(90deg,rgba(123,92,138,0.08),rgba(75,160,137,0.06));padding:8px 10px;border-radius:999px;font-size:13px;color:var(--muted)}\\n    .testimonials{margin-top:26px;display:grid;grid-template-columns:1fr 1fr;gap:16px}\\n    .quote{background:rgba(255,255,255,0.9);padding:18px;border-radius:12px;font-size:14px}\\n    footer{padding:28px;text-align:center;color:var(--muted)}\\n    .note{font-size:13px;color:var(--muted);margin-top:14px}\\n    /* pattern */\\n    .pattern{position:absolute;inset:0;pointer-events:none;opacity:0.38}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.testimonials{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 800 500\\\" preserveAspectRatio=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1p\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#FDEEEF\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#E9FBF6\\\"/></linearGradient>\\n      <radialGradient id=\\\"g2p\\\"><stop offset=\\\"0\\\" stop-color=\\\"#FFF\\\" stop-opacity=\\\"0.4\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#FFF\\\" stop-opacity=\\\"0\\\"/></radialGradient>\\n      <pattern id=\\\"p_pricing\\\" width=\\\"120\\\" height=\\\"120\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"120\\\" height=\\\"120\\\" fill=\\\"url(#g1p)\\\" />\\n        <circle cx=\\\"18\\\" cy=\\\"18\\\" r=\\\"6\\\" fill=\\\"#F7E7F0\\\" />\\n        <circle cx=\\\"96\\\" cy=\\\"96\\\" r=\\\"6\\\" fill=\\\"#E7F8F2\\\" />\\n        <path d=\\\"M0 60 L60 120\\\" stroke=\\\"#F0E6F3\\\" stroke-width=\\\"2\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p_pricing)\\\" />\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g2p)\\\" />\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav aria-label=\\\"Primary\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Shop</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <h1>Membership for continuing care and seasonal scenting</h1>\\n        <p class=\\\"lead\\\">Join a slow, thoughtful membership for blended aromatherapy rituals, monthly refill discounts, and priority sessions with {{PRACTITIONER_NAME}}. Designed as a supportive self-care structure — not medical treatment.</p>\\n        <div class=\\\"features\\\">\\n          <span class=\\\"pill\\\">Monthly blends</span>\\n          <span class=\\\"pill\\\">20% shop discount</span>\\n          <span class=\\\"pill\\\">Priority booking</span>\\n          <span class=\\\"pill\\\">Member-only classes</span>\\n        </div>\\n        <p class=\\\"note\\\">Safety-first: guidance focuses on safe aromatic use. Consult your healthcare provider about conditions or pregnancy; always patch test and dilute appropriately.</p>\\n      </div>\\n\\n      <aside class=\\\"hero-card\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:flex-start\\\">\\n          <div>\\n            <div class=\\\"muted\\\">Starting</div>\\n            <div class=\\\"price\\\">$12 / month</div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <div class=\\\"muted\\\">Member since</div>\\n            <div class=\\\"muted\\\">{{CITY}}, {{STATE}}</div>\\n          </div>\\n        </div>\\n        <div style=\\\"margin-top:14px\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px\\\">\\n      <h2 style=\\\"color:var(--accent);margin:0 0 8px 0\\\">Choose a rhythm that fits</h2>\\n      <p class=\\\"muted\\\" style=\\\"margin:0 0 18px 0\\\">Three membership tiers for different rhythms of care and scent exploration.</p>\\n\\n      <div class=\\\"membership-grid\\\">\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"flex:1\\\">\\n            <strong>Seedling</strong>\\n            <div class=\\\"meta\\\">Intro monthly plan — ideal for curious newcomers</div>\\n            <div class=\\\"features\\\" style=\\\"margin-top:10px\\\">\\n              <span class=\\\"pill\\\">1 monthly roll-on</span>\\n              <span class=\\\"pill\\\">10% shop discount</span>\\n            </div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <div class=\\\"price\\\">$12</div>\\n            <div class=\\\"meta\\\">per month</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"flex:1\\\">\\n            <strong>Bloom</strong>\\n            <div class=\\\"meta\\\">Most popular — for regular ritual and seasonal blends</div>\\n            <div class=\\\"features\\\" style=\\\"margin-top:10px\\\">\\n              <span class=\\\"pill\\\">2 monthly blends</span>\\n              <span class=\\\"pill\\\">20% shop discount</span>\\n              <span class=\\\"pill\\\">Quarterly consult</span>\\n            </div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <div class=\\\"price\\\">$36</div>\\n            <div class=\\\"meta\\\">per month</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"flex:1\\\">\\n            <strong>Sanctuary</strong>\\n            <div class=\\\"meta\\\">Annual support for deeper practice and priority access</div>\\n            <div class=\\\"features\\\" style=\\\"margin-top:10px\\\">\\n              <span class=\\\"pill\\\">Monthly bespoke blend</span>\\n              <span class=\\\"pill\\\">30% shop discount</span>\\n              <span class=\\\"pill\\\">Unlimited quick check-ins</span>\\n            </div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <div class=\\\"price\\\">$360</div>\\n            <div class=\\\"meta\\\">per year</div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px\\\">\\n      <h3 style=\\\"margin:0 0 8px 0;color:var(--accent)\\\">How membership helps you build a ritual</h3>\\n      <ol class=\\\"muted\\\" style=\\\"margin:0 0 18px 18px\\\">\\n        <li>Monthly blends chosen for season and emotional resonance (no medical claims).</li>\\n        <li>Guided usage and dilution suggestions for safe topical and diffuser use.</li>\\n        <li>Access to workshops and a library of blending notes prepared by {{PRACTITIONER_NAME}}.</li>\\n      </ol>\\n      <p class=\\\"note\\\">All aromatherapy guidance is educational. If you are pregnant, nursing, have severe allergies, or take medication, please consult a healthcare professional before using essential oils.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:26px\\\">\\n      <h3 style=\\\"color:var(--accent);margin:0 0 8px 0\\\">What members say</h3>\\n      <div class=\\\"testimonials\\\">\\n        <div class=\\\"quote\\\">\\\"The monthly blends are a quiet anchor for my mornings. {{PRACTITIONER_NAME}} listens and crafts something small and thoughtful.\\\" — A.R.</div>\\n        <div class=\\\"quote\\\">\\\"I love the care notes and safety tips. The roll-on formulas fit right into my day.\\\" — M.L.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:26px;display:flex;gap:18px;align-items:center;justify-content:space-between;background:transparent;padding:16px\\\">\\n      <div>\\n        <h4 style=\\\"margin:0;color:var(--accent)\\\">Ready to begin?</h4>\\n        <p class=\\\"muted\\\" style=\\\"margin:6px 0 0 0\\\">Start with a trial month and experience seasonal blends and priority booking.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:900px;margin:0 auto\\\">\\n      <div class=\\\"muted\\\">Questions? Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div style=\\\"margin-top:6px;font-size:13px;color:var(--muted)\\\">Aromatherapy is supportive self-care; content is informational and not a substitute for medical advice.</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#FEFEFF;--ink:#2F2F2F;--accent:#6C4A7A;--soft:#EAF7F1;--card:#FFFFFF}\\n    body{margin:0;font-family:Georgia,serif;color:var(--ink);background:linear-gradient(180deg,#FFF,#FEFEFF);}\\n    header{padding:22px 28px;display:flex;justify-content:space-between;align-items:center}\\n    .logo{font-weight:700;color:var(--accent)}\\n    nav a{margin-left:14px;color:#666;text-decoration:none;font-weight:600}\\n    .container{max-width:980px;margin:32px auto;padding:28px}\\n    .intro{display:flex;gap:22px;align-items:flex-start}\\n    .story{flex:1;background:var(--card);padding:22px;border-radius:12px;box-shadow:0 8px 28px rgba(30,30,30,0.04)}\\n    .portrait{width:260px;border-radius:12px;padding:18px;background:linear-gradient(180deg,var(--soft),#fff);box-shadow:inset 0 1px 0 rgba(255,255,255,0.6)}\\n    h1{margin:0 0 8px 0;color:var(--accent);font-family:Inter,system-ui}\\n    p{margin:0 0 12px 0;line-height:1.6;color:#444}\\n    .framework{margin-top:18px;padding:18px;border-radius:10px;background:linear-gradient(90deg,#fff,#FBFBFF)}\\n    .step{display:flex;gap:12px;align-items:flex-start}\\n    .step .num{width:28px;height:28px;border-radius:8px;background:#F5EEF8;color:var(--accent);display:flex;align-items:center;justify-content:center;font-weight:700}\\n    .cta{margin-top:18px}\\n    .btn{background:linear-gradient(90deg,#6C4A7A,#4BA089);color:#fff;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{padding:28px;text-align:center;color:#777}\\n    .pattern-wrap{position:absolute;left:0;top:0;opacity:0.16;pointer-events:none}\\n    @media(max-width:820px){.intro{flex-direction:column}.portrait{width:100%}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern-wrap\\\" width=\\\"360\\\" height=\\\"360\\\" viewBox=\\\"0 0 360 360\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"ag1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#FFF6F9\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#F0FFF9\\\"/></linearGradient>\\n      <pattern id=\\\"p_about\\\" width=\\\"80\\\" height=\\\"80\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"80\\\" height=\\\"80\\\" fill=\\\"url(#ag1)\\\"/>\\n        <path d=\\\"M0 40 Q20 20 40 40 T80 40\\\" stroke=\\\"#E8E0F0\\\" stroke-width=\\\"1.5\\\" fill=\\\"none\\\"/>\\n        <circle cx=\\\"60\\\" cy=\\\"20\\\" r=\\\"4\\\" fill=\\\"#E8F6EF\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p_about)\\\"/>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Welcome</a>\\n      <a href=\\\"services.html\\\">Sessions</a>\\n      <a href=\\\"pricing.html\\\">Membership</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"intro\\\">\\n      <article class=\\\"story\\\">\\n        <h1>About {{PRACTITIONER_NAME}}</h1>\\n        <p>{{PRACTITIONER_NAME}} blends botanical tradition and modern safety practice to craft aromatic experiences that invite calm, curiosity, and ritual. The focus is on sensory literacy: learning how scent becomes a reliable part of your day rather than a quick fix.</p>\\n        <p>Rooted in gentle blending techniques, {{PRACTITIONER_NAME}} sources pure essential oils and favors low-dilution, evidence-informed guidance for topical use. This practice is educational and supportive, never medical.</p>\\n\\n        <div class=\\\"framework\\\">\\n          <h4 style=\\\"margin:0 0 10px 0;color:var(--accent)\\\">The Quiet Ritual Framework</h4>\\n          <div class=\\\"step\\\"><div class=\\\"num\\\">1</div><div><strong>Listen</strong> — we begin with intention and scent memory, not labels.</div></div>\\n          <div class=\\\"step\\\" style=\\\"margin-top:8px\\\"><div class=\\\"num\\\">2</div><div><strong>Compose</strong> — selecting top/middle/base notes for balance and safety-forward use.</div></div>\\n          <div class=\\\"step\\\" style=\\\"margin-top:8px\\\"><div class=\\\"num\\\">3</div><div><strong>Practice</strong> — dilution, patch test, and mindful application for daily ritual.</div></div>\\n        </div>\\n\\n        <p style=\\\"margin-top:12px\\\">I design blends to fit life rhythms — morning clarity, mid-day calm, and evening unwinding. If you have medical concerns, pregnancy, or pets, please consult an appropriate healthcare provider; I will offer adaptations and safer alternatives whenever needed.</p>\\n\\n        <div class=\\\"cta\\\">\\n          <a class=\\\"btn\\\" href=\\\"book.html\\\">Book a consult</a>\\n          <span style=\\\"margin-left:12px;color:#777;font-size:14px\\\">or call {{PHONE}}</span>\\n        </div>\\n      </article>\\n\\n      <aside class=\\\"portrait\\\">\\n        <div style=\\\"font-weight:700;color:var(--accent);font-size:20px;margin-bottom:8px\\\">A note from {{PRACTITIONER_NAME}}</div>\\n        <p style=\\\"margin:0 0 8px 0;color:#555\\\">\\\"I create blends that sit quietly with you — simple, safe, and tailored. We never promise cures. We create routines.\\\"</p>\\n        <p style=\\\"margin:8px 0 0 0;color:#777;font-size:14px\\\">Based in {{CITY}}, {{STATE}} — offering in-person and virtual sessions.</p>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:26px\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">Community and craft</h3>\\n      <p class=\\\"muted\\\" style=\\\"color:#555\\\">Workshops, seasonal blending nights, and member gatherings are part of the offering — designed to teach safe blending, sourcing, and mindful use.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">Testimonials</h3>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px\\\">\\n        <blockquote style=\\\"background:#fff;padding:14px;border-radius:10px;box-shadow:0 8px 18px rgba(40,30,40,0.04)\\\">\\\"Gentle guidance and thoughtful blends — exactly what I needed to slow down.\\\" — S.</blockquote>\\n        <blockquote style=\\\"background:#fff;padding:14px;border-radius:10px;box-shadow:0 8px 18px rgba(40,30,40,0.04)\\\">\\\"I appreciate the safety notes and adaptations for my cat at home.\\\" — D.</blockquote>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:900px;margin:0 auto;color:#888\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • Phone: {{PHONE}} • {{BUSINESS_NAME}}, {{CITY}}, {{STATE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Book a Session — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#FBFFFE;--card:#FFFFFF;--accent:#3C6A7A;--muted:#666}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;background:linear-gradient(180deg,#fff,#F7FFFB);color:#1b1b1b}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 22px}\\n    .brand{font-weight:800;color:var(--accent)}\\n    nav a{color:#666;margin-left:12px;text-decoration:none;font-weight:600}\\n    .container{max-width:980px;margin:28px auto;padding:20px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:22px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 10px 30px rgba(20,20,20,0.06)}\\n    h1{margin:0 0 10px 0}\\n    label{display:block;font-weight:700;margin-top:10px}\\n    input,select,textarea{width:100%;padding:10px;margin-top:6px;border:1px solid #E6E6E6;border-radius:8px}\\n    .btn{display:inline-block;background:linear-gradient(90deg,#3C6A7A,#7C4A90);color:white;padding:10px 16px;border-radius:10px;text-decoration:none;margin-top:12px}\\n    .small{font-size:13px;color:var(--muted)}\\n    .faq{margin-top:16px;font-size:14px}\\n    .faq h4{margin:0 0 8px 0;color:var(--accent)}\\n    .safety{background:linear-gradient(90deg,#fff,#F8FEF9);padding:12px;border-radius:10px;margin-top:12px}\\n    footer{padding:18px;text-align:center;color:var(--muted)}\\n    @media(max-width:920px){.grid{grid-template-columns:1fr}.container{padding:10px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"pricing.html\\\">Plans</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <div class=\\\"grid\\\">\\n      <section class=\\\"card\\\">\\n        <h1>Book a consult or session</h1>\\n        <p class=\\\"small\\\">Select a session type below. All consultations are focused on safe aromatic use and personalized blends. Not a replacement for medical care.</p>\\n\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" onsubmit=\\\"alert('This is a demo booking flow. Redirecting to: '+this.action);\\\">\\n          <label for=\\\"type\\\">Session type</label>\\n          <select id=\\\"type\\\" name=\\\"type\\\">\\n            <option>Initial aromatherapy consult (45 min)</option>\\n            <option>Blend bar session — create a personalized blend (60 min)</option>\\n            <option>Follow-up (30 min)</option>\\n            <option>Membership onboarding</option>\\n          </select>\\n\\n          <label for=\\\"name\\\">Your name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"Full name\\\" required />\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required />\\n\\n          <label for=\\\"phone\\\">Phone</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"Optional phone\\\" />\\n\\n          <label for=\\\"notes\\\">Notes or preferences</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Tell us about sensitivities, pets, pregnancy, or scent likes/dislikes\\\"></textarea>\\n\\n          <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n            <button class=\\\"btn\\\" type=\\\"submit\\\">Book now</button>\\n            <a class=\\\"small\\\" href=\\\"mailto:{{EMAIL}}\\\">Or email {{EMAIL}}</a>\\n          </div>\\n        </form>\\n\\n        <div class=\\\"safety\\\">\\n          <strong>Safety notes</strong>\\n          <p class=\\\"small\\\" style=\\\"margin:8px 0 0 0\\\">Please perform a patch test for topical blends; use recommended dilutions. If pregnant, nursing, or managing serious health conditions, consult your healthcare provider before use. We adapt blends for homes with pets.</p>\\n        </div>\\n      </section>\\n\\n      <aside class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Quick scheduling</h3>\\n        <p class=\\\"small\\\">Typical availability: weekdays and select weekends. Sessions can be virtual or in {{CITY}}, {{STATE}} by appointment.</p>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <strong>Session highlights</strong>\\n          <ul class=\\\"small\\\" style=\\\"padding-left:18px;margin:8px 0\\\">\\n            <li>Personalized scent profile</li>\\n            <li>Dilution & application guidance</li>\\n            <li>Take-home samples (blend bar)</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"faq\\\">\\n          <h4>FAQ — safety focused</h4>\\n          <p class=\\\"small\\\"><strong>Dilution?</strong> Typical topical dilutions are 1–3% for adults; lower for sensitive skin and children. Exact guidance provided per session.</p>\\n          <p class=\\\"small\\\" style=\\\"margin-top:8px\\\"><strong>Patch test?</strong> Always perform a patch test on inner forearm 24 hours before regular topical use.</p>\\n          <p class=\\\"small\\\" style=\\\"margin-top:8px\\\"><strong>Pets?</strong> Some essential oils can affect animals. We provide pet-safe alternatives and dosing guidance for household use.</p>\\n          <p class=\\\"small\\\" style=\\\"margin-top:8px\\\"><strong>Pregnancy & nursing?</strong> We avoid certain oils and will offer tailored, safer choices. Consult your care provider as well.</p>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <strong>Cancel / reschedule</strong>\\n          <p class=\\\"small\\\" style=\\\"margin:6px 0 0 0\\\">Please notify 24 hours in advance to reschedule. Late cancellations may incur a fee.</p>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Proceed to booking</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:20px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px 0\\\">Preparing for your session</h3>\\n      <ol class=\\\"small\\\" style=\\\"margin:0 0 0 18px\\\">\\n        <li>Note any medications, allergies, and household pets.</li>\\n        <li>Bring or describe fragrances you like or dislike.</li>\\n        <li>Expect safety guidance on dilution and topical use; no medical advice will be provided.</li>\\n      </ol>\\n      <p class=\\\"small\\\" style=\\\"margin-top:10px\\\">If you have an urgent medical concern, please contact a healthcare professional. Sessions are educational and supportive in scope.</p>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"small\\\">Questions before booking? Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>. {{BUSINESS_NAME}} — thoughtful aromatherapy in {{CITY}}, {{STATE}}.</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
