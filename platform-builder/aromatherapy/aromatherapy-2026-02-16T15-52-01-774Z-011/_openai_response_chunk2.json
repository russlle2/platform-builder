          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Aromatherapy consultations, workshops, and membership — gentle, safe, scent-forward care.\\\" />\\n  <style>\\n    :root{--bg1:#f6fbf8;--accent:#6aa84f;--muted:#6b6b6b;--card:#ffffff;--glass:rgba(255,255,255,0.6);--shadow:0 8px 30px rgba(20,30,15,0.08);}\\n    html,body{height:100%;margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;line-height:1.5;color:#16321f;background:linear-gradient(180deg,var(--bg1),#eef7f1);}\\n    .wrap{max-width:980px;margin:48px auto;padding:28px;border-radius:16px;background:linear-gradient(135deg,rgba(255,255,255,0.8),rgba(250,255,250,0.9));box-shadow:var(--shadow);position:relative;overflow:hidden}\\n    header{display:flex;align-items:center;justify-content:space-between;gap:12px}\\n    .brand{display:flex;flex-direction:column}\\n    .brand .title{font-size:20px;font-weight:700;color:#14321b}\\n    .brand .tag{font-size:12px;color:var(--muted)}\\n    nav a{margin-left:18px;color:#14321b;text-decoration:none;font-weight:600}\\n    .hero{display:grid;grid-template-columns:1fr 320px;gap:22px;align-items:center;margin-top:24px}\\n    .hero h1{margin:0;font-size:28px;color:#0f2a18}\\n    .hero p{color:#244a2b;margin-top:8px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 20px rgba(22,40,24,0.06)}\\n    .services-list{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:18px}\\n    .service{padding:14px;border-radius:10px;background:linear-gradient(180deg,#fff,#fbfffa);border:1px solid rgba(20,40,20,0.04)}\\n    .service h3{margin:0 0 8px 0;font-size:16px;color:#16321f}\\n    .service p{margin:0;color:var(--muted);font-size:14px}\\n    .framework{display:flex;gap:12px;margin-top:22px}\\n    .step{flex:1;padding:14px;border-radius:10px;background:linear-gradient(90deg,rgba(106,168,79,0.06),rgba(106,168,79,0.02))}\\n    .step h4{margin:0;color:#234d28}\\n    .membership{margin-top:22px;padding:16px;border-radius:12px;background:linear-gradient(180deg,#f7fff7,#eef9ee);border:1px solid rgba(106,168,79,0.12)}\\n    .cta{display:flex;gap:12px;margin-top:18px}\\n    .btn-primary{background:linear-gradient(180deg,var(--accent),#3f7f34);color:white;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .btn-ghost{background:transparent;border:1px solid rgba(20,40,20,0.08);padding:10px 14px;border-radius:10px;color:#16321f;text-decoration:none}\\n    footer{margin-top:28px;color:var(--muted);font-size:13px;display:flex;justify-content:space-between;align-items:center}\\n    /* subtle decorative pattern */\\n    .pattern{position:absolute;right:-60px;top:-60px;width:420px;height:420px;opacity:0.12;filter:blur(0.2px)}\\n\\n    @media (max-width:880px){.hero{grid-template-columns:1fr}.services-list{grid-template-columns:1fr}.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#b7e3b2\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#e9f7e9\\\"/></linearGradient>\\n      </defs>\\n      <rect width=\\\"200\\\" height=\\\"200\\\" fill=\\\"url(#g1)\\\" rx=\\\"24\\\"/>\\n      <g fill=\\\"#fff\\\" opacity=\\\"0.12\\\">\\n        <circle cx=\\\"30\\\" cy=\\\"30\\\" r=\\\"6\\\"/>\\n        <circle cx=\\\"70\\\" cy=\\\"60\\\" r=\\\"4\\\"/>\\n        <circle cx=\\\"110\\\" cy=\\\"90\\\" r=\\\"5\\\"/>\\n        <circle cx=\\\"150\\\" cy=\\\"40\\\" r=\\\"3\\\"/>\\n      </g>\\n    </svg>\\n\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"title\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"tag\\\">A quiet study of scent and ritual</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"shop.html\\\">Boutique</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Thoughtful aromatherapy services for everyday rituals</h1>\\n        <p class=\\\"muted\\\">I design scent profiles that fit your life rhythms — gentle, safe, and rooted in aromatic tradition. No medical promises; just care, guidance, and crafted blends.</p>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <strong style=\\\"color:#234d28\\\">Private Aromatherapy Consult</strong>\\n          <p style=\\\"margin:6px 0 0;color:var(--muted);font-size:14px\\\">One-on-one intake, scent mapping, and a take-home small-batch blend tailored to your preferences and safety needs.</p>\\n        </div>\\n\\n        <div class=\\\"services-list\\\">\\n          <div class=\\\"service\\\">\\n            <h3>Initial Consult (60 min)</h3>\\n            <p>Intake, fragrance preferences, safety review, and home use guidance. Includes patch-test coaching.</p>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h3>Follow-up Session (30 min)</h3>\\n            <p>Refine a blend, adjust directions, or explore a new aroma focus.</p>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h3>Mini Workshop (group)</h3>\\n            <p>Hands-on scent education for small groups (dilution, blending basics, and safety).</p>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h3>Custom Blend Craft</h3>\\n            <p>Commission a personalized blend for your ritual or space; includes label and usage notes.</p>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"framework\\\">\\n          <div class=\\\"step\\\">\\n            <h4>Listen</h4>\\n            <p style=\\\"margin-top:6px;color:var(--muted)\\\">We begin with your story — scent memories, sensitivities, and lifestyle.</p>\\n          </div>\\n          <div class=\\\"step\\\">\\n            <h4>Map</h4>\\n            <p style=\\\"margin-top:6px;color:var(--muted)\\\">We choose safe, complementary aromatics and a simple application plan.</p>\\n          </div>\\n          <div class=\\\"step\\\">\\n            <h4>Craft</h4>\\n            <p style=\\\"margin-top:6px;color:var(--muted)\\\">A small-batch blend, straightforward directions, and follow-up guidance.</p>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"membership\\\">\\n          <strong>Membership: The Scent Circle</strong>\\n          <p style=\\\"margin-top:6px;color:var(--muted)\\\">Monthly support, seasonal mini-blends, priority booking, and members-only micro-workshops. Designed for ongoing ritual support and scent education.</p>\\n        </div>\\n\\n        <div class=\\\"cta\\\">\\n          <a class=\\\"btn-primary\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a class=\\\"btn-ghost\\\" href=\\\"contact.html\\\">Speak with {{PRACTITIONER_NAME}}</a>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0 0 8px 0\\\">Quick Booking</h4>\\n          <p style=\\\"margin:0 0 10px;color:var(--muted)\\\">Call <strong>{{PHONE}}</strong> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></p>\\n          <p style=\\\"margin:0 0 12px;color:var(--muted);font-size:13px\\\">Memberships include a standing 10% boutique credit.</p>\\n          <a class=\\\"btn-primary\\\" href=\\\"book.html\\\">Book a session</a>\\n        </div>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0\\\">Small-group Workshops</h4>\\n          <p style=\\\"margin-top:8px;color:var(--muted)\\\">Explore blending basics, dilution and patch-testing safety, and scent layering. Great for mindful teams or friends.</p>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h3 style=\\\"margin:0 0 8px 0;color:#16321f\\\">What to expect</h3>\\n      <p style=\\\"margin:0;color:var(--muted)\\\">Sessions balance practical guidance, safety-first handling, and creative scent choices. I avoid medical claims and focus on supportive sensory care.</p>\\n    </section>\\n\\n    <footer>\\n      <div>Serving {{CITY}}, {{STATE}} • <a href=\\\"contact.html\\\">Contact</a></div>\\n      <div style=\\\"color:var(--muted)\\\">© {{BUSINESS_NAME}} • {{PRACTITIONER_NAME}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Blends — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Carefully composed aromatherapy blends with safety notes and recommended uses.\\\" />\\n  <style>\\n    :root{--bg:#fbfdfb;--ink:#12321e;--muted:#5b6b5a;--card:#ffffff;--accent:#88c08c}\\n    body{margin:0;font-family:Georgia,serif;background:linear-gradient(180deg,#fbfff9,#eef7ef);color:var(--ink)}\\n    .container{max-width:1100px;margin:36px auto;padding:26px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:16px;color:var(--ink);text-decoration:none;font-weight:600}\\n    .intro{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 10px 30px rgba(18,50,30,0.06);margin-top:18px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .blend{background:linear-gradient(180deg,#ffffff,#fbfff6);border-radius:12px;padding:14px;border:1px solid rgba(18,50,30,0.04)}\\n    .blend h4{margin:0 0 6px 0}\\n    .notes{font-size:13px;color:var(--muted);margin-top:6px}\\n    .meta{margin-top:8px;font-size:13px;color:#264e33}\\n    .safety{margin-top:12px;padding:12px;border-radius:10px;background:linear-gradient(90deg,#f9fff9,#f0fff3);border:1px dashed rgba(30,80,40,0.06)}\\n    .faq{margin-top:18px;background:#fff;padding:14px;border-radius:10px}\\n    footer{margin-top:22px;color:var(--muted);font-size:13px}\\n    @media (max-width:920px){.grid{grid-template-columns:repeat(2,1fr)} }\\n    @media (max-width:600px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div>\\n        <h2 style=\\\"margin:0\\\">{{BUSINESS_NAME}} — Signature Blends</h2>\\n        <div style=\\\"color:var(--muted);font-size:13px\\\">A small collection of thoughtfully balanced aromatics</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Welcome</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"shop.html\\\">Shop</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"intro\\\">\\n      <p style=\\\"margin:0 0 8px 0;color:var(--muted)\\\">Below are blends crafted for everyday ritual: each lists its top/middle/base notes, an aroma profile, and gentle language about what the scent supports. This is educational guidance — not medical advice.</p>\\n      <div style=\\\"font-size:13px;color:#2a5c36\\\">Tip: Always perform a patch test and follow dilution guidance included with each blend.</div>\\n    </section>\\n\\n    <section class=\\\"grid\\\" aria-live=\\\"polite\\\">\\n      <article class=\\\"blend\\\">\\n        <h4>Calm Harbor</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Bergamot • <strong>Middle:</strong> Lavender • <strong>Base:</strong> Vetiver</div>\\n        <div class=\\\"meta\\\">Aroma: soft citrus meets herbal-lilac and grounding woods.</div>\\n        <div class=\\\"notes\\\">Supports: creates a calm, steadying atmosphere for unwinding after a busy day.</div>\\n      </article>\\n\\n      <article class=\\\"blend\\\">\\n        <h4>Morning Clarity</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Lemon • <strong>Middle:</strong> Rosemary • <strong>Base:</strong> Cedarwood</div>\\n        <div class=\\\"meta\\\">Aroma: bright citrus with a crisp herbal center.</div>\\n        <div class=\\\"notes\\\">Supports: gentle uplift and mental clarity for morning routines.</div>\\n      </article>\\n\\n      <article class=\\\"blend\\\">\\n        <h4>Evening Ground</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Sweet Orange • <strong>Middle:</strong> Frankincense • <strong>Base:</strong> Sandalwood</div>\\n        <div class=\\\"meta\\\">Aroma: warm citrus with resinous, woody depth.</div>\\n        <div class=\\\"notes\\\">Supports: a settling ritual for quiet moments before rest.</div>\\n      </article>\\n\\n      <article class=\\\"blend\\\">\\n        <h4>Sweet Sleep</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Mandarin • <strong>Middle:</strong> Roman Chamomile • <strong>Base:</strong> Vanilla CO2</div>\\n        <div class=\\\"meta\\\">Aroma: soft, honeyed florals with warm sweetness.</div>\\n        <div class=\\\"notes\\\">Supports: encourages a soothing bedtime environment when used with safe dilution.</div>\\n      </article>\\n\\n      <article class=\\\"blend\\\">\\n        <h4>Uplift Citrus</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Grapefruit • <strong>Middle:</strong> Neroli • <strong>Base:</strong> Petitgrain</div>\\n        <div class=\\\"meta\\\">Aroma: bright, effusive citrus with delicate floral depth.</div>\\n        <div class=\\\"notes\\\">Supports: a cheerful, enlivening atmosphere for creative moments.</div>\\n      </article>\\n\\n      <article class=\\\"blend\\\">\\n        <h4>Woodland Balance</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Pine • <strong>Middle:</strong> Juniper • <strong>Base:</strong> Patchouli</div>\\n        <div class=\\\"meta\\\">Aroma: crisp forest greens with a warm earthy base.</div>\\n        <div class=\\\"notes\\\">Supports: grounding energy and a sense of steadiness in a busy day.</div>\\n      </article>\\n\\n      <article class=\\\"blend\\\">\\n        <h4>Breathe Ease</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Eucalyptus Radiata • <strong>Middle:</strong> Lavender • <strong>Base:</strong> White Fir</div>\\n        <div class=\\\"meta\\\">Aroma: cool, camphorous top with clean herbal notes.</div>\\n        <div class=\\\"notes\\\">Supports: clear, fresh-feeling airspace for calm, mindful breathing practices.</div>\\n      </article>\\n\\n      <article class=\\\"blend\\\">\\n        <h4>Focus Grove</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Peppermint • <strong>Middle:</strong> Basil • <strong>Base:</strong> Black Spruce</div>\\n        <div class=\\\"meta\\\">Aroma: crisp mint with savory green herbs and resinous depth.</div>\\n        <div class=\\\"notes\\\">Supports: a centered workspace when used responsibly and at appropriate dilutions.</div>\\n      </article>\\n\\n      <article class=\\\"blend\\\">\\n        <h4>Comfort Tea</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Ginger • <strong>Middle:</strong> Clary Sage • <strong>Base:</strong> Benzoin</div>\\n        <div class=\\\"meta\\\">Aroma: warm, spicy heart softened by balsamic sweetness.</div>\\n        <div class=\\\"notes\\\">Supports: a cozy, comforting presence in the home for quiet afternoons.</div>\\n      </article>\\n\\n      <article class=\\\"blend\\\">\\n        <h4>Citrus Breeze</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Lime • <strong>Middle:</strong> Ylang Ylang • <strong>Base:</strong> Musk accord (synthetic)</div>\\n        <div class=\\\"meta\\\">Aroma: zesty and floral with a soft rounded base.</div>\\n        <div class=\\\"notes\\\">Supports: an upbeat, refreshing ambience for social gatherings or morning ritual.</div>\\n      </article>\\n    </section>\\n\\n    <section class=\\\"safety\\\">\\n      <strong>Safety & Usage</strong>\\n      <p style=\\\"margin:8px 0 0 0;color:var(--muted)\\\">Each blend is intended for aromatic use or proper topical dilution. Always perform a patch test and follow directions provided at purchase. For pregnant persons, young children, or households with pets, consult with the practitioner to adapt blends and dilution. Avoid ingesting essential oils.</p>\\n    </section>\\n\\n    <section class=\\\"faq\\\" aria-labelledby=\\\"faq-title\\\">\\n      <h4 id=\\\"faq-title\\\" style=\\\"margin:0 0 8px 0\\\">FAQ — gentle answers</h4>\\n      <div style=\\\"font-size:13px;color:var(--muted)\\\">\\n        <strong>Patch test?</strong> Apply diluted sample (2–3% in carrier) to inner forearm and wait 24 hours. If irritation occurs, discontinue use.\\n        <br/><br/>\\n        <strong>Dilution guidance?</strong> Typical aromatic inhalation blends are 1–3% for room diffusion; topical blends depend on age and sensitivity. Membership notes include exact dilution recipes.\\n        <br/><br/>\\n        <strong>Pets?</strong> Some oils are not pet-safe (e.g., high concentrations of phenolic compounds). Always notify the practitioner about animals in the home; we’ll tailor choices accordingly.\\n        <br/><br/>\\n        <strong>Pregnancy?</strong> Certain oils and high concentrations are not recommended during pregnancy. We prioritize safety-forward options and will provide pregnancy-safe alternatives upon request.\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"margin-top:18px;color:var(--muted)\\\">For custom versions of any blend, contact <a href=\\\"contact.html\\\">{{PRACTITIONER_NAME}}</a>. Remember: these blends support calming rituals and sensory experience — not medical treatment.</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Boutique — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Shop artisan aromatherapy kits, roll-ons, and diffusers. Safety-forward product info and FAQs included.\\\" />\\n  <style>\\n    :root{--bg:#fffefc;--card:#ffffff;--ink:#0f2416;--muted:#596a5a;--accent:#4ea66a}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#f7fff7,#fbfff9);color:var(--ink)}\\n    .shell{max-width:1100px;margin:28px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    header a{margin-left:14px;text-decoration:none;color:var(--ink);font-weight:600}\\n    .hero{display:flex;justify-content:space-between;align-items:center;margin-top:18px}\\n    .hero h1{margin:0;font-size:26px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .product{background:var(--card);padding:14px;border-radius:12px;border:1px solid rgba(10,30,18,0.04);box-shadow:0 8px 20px rgba(10,30,18,0.04)}\\n    .art{height:120px;border-radius:8px;background:linear-gradient(135deg,#f1faf1,#e6f5e6);display:flex;align-items:center;justify-content:center;color:var(--muted);font-weight:700}\\n    .price{margin-top:8px;color:#133b23;font-weight:700}\\n    .small{font-size:13px;color:var(--muted)}\\n    .btn{display:inline-block;margin-top:10px;padding:8px 12px;border-radius:10px;background:linear-gradient(180deg,var(--accent),#3e8b4c);color:white;text-decoration:none;font-weight:700}\\n    .side{width:320px}\\n    .aside-card{background:var(--card);padding:14px;border-radius:10px;border:1px solid rgba(10,30,18,0.04)}\\n    .faq{margin-top:18px}\\n    footer{margin-top:22px;color:var(--muted);font-size:13px}\\n    @media (max-width:920px){.grid{grid-template-columns:repeat(2,1fr)} .hero{flex-direction:column;align-items:flex-start}.side{width:100%;margin-top:12px}}\\n    @media (max-width:600px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"shell\\\">\\n    <header>\\n      <div>\\n        <strong>{{BUSINESS_NAME}}</strong>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Carefully sourced essentials and thoughtful kits</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Back</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"hero\\\">\\n      <div>\\n        <h1>Shop — small-batch goods and starter kits</h1>\\n        <p class=\\\"small\\\">Safety-first product details and clear dilution guidance included with each purchase. Members receive {{FAVORITE_BLEND}} sample discounts.</p>\\n      </div>\\n      <aside class=\\\"side\\\">\\n        <div class=\\\"aside-card\\\">\\n          <h4 style=\\\"margin:0\\\">Membership Perks</h4>\\n          <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">Join the Scent Circle for seasonal mini-blends, 10% shop credit, and priority booking.</p>\\n          <a class=\\\"btn\\\" href=\\\"membership.html\\\">Learn more</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section class=\\\"grid\\\" aria-live=\\\"polite\\\">\\n      <div class=\\\"product\\\">\\n        <div class=\\\"art\\\">Starter Kit</div>\\n        <h3 style=\\\"margin:8px 0 0 0\\\">At-Home Starter Kit</h3>\\n        <div class=\\\"small\\\">Includes 5 sampler blends (2ml), simple diffuser, usage guide, and dilution cards.</div>\\n        <div class=\\\"price\\\">$64</div>\\n        <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"art\\\">Roll-On</div>\\n        <h3 style=\\\"margin:8px 0 0 0\\\">Relax Roll-On (10ml)</h3>\\n        <div class=\\\"small\\\">Pre-diluted (2.5%) roller with Calm Harbor blend. Ready for pulse points.</div>\\n        <div class=\\\"price\\\">$18</div>\\n        <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"art\\\">Diffuser</div>\\n        <h3 style=\\\"margin:8px 0 0 0\\\">Ceramic Diffuser — Mini</h3>\\n        <div class=\\\"small\\\">Gentle ultrasonic diffuser for small rooms (ensures even aromatic delivery).</div>\\n        <div class=\\\"price\\\">$48</div>\\n        <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"art\\\">Sampler</div>\\n        <h3 style=\\\"margin:8px 0 0 0\\\">Blend Sampler Pack</h3>\\n        <div class=\\\"small\\\">Ten 1ml samples from our signature collection; perfect for sensitivity testing and discovery.</div>\\n        <div class=\\\"price\\\">$32</div>\\n        <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"art\\\">Kit</div>\\n        <h3 style=\\\"margin:8px 0 0 0\\\">Travel Calm Kit</h3>\\n        <div class=\\\"small\\\">Roll-on, calming pillow spray (.5oz), and travel dilution guide. TSA-friendly choices.</div>\\n        <div class=\\\"price\\\">$28</div>\\n        <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"art\\\">Blend</div>\\n        <h3 style=\\\"margin:8px 0 0 0\\\">Focus Roll-On (10ml)</h3>\\n        <div class=\\\"small\\\">Pre-diluted support blend using Focus Grove profile; safe topical dilution.</div>\\n        <div class=\\\"price\\\">$18</div>\\n        <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\" aria-labelledby=\\\"shop-faq\\\" style=\\\"margin-top:18px\\\">\\n      <h3 id=\\\"shop-faq\\\">Shop FAQ — safe use, clearly explained</h3>\\n      <div style=\\\"margin-top:8px;color:var(--muted);font-size:14px\\\">\\n        <strong>Dilution:</strong> Bottles intended for topical use are supplied at safe dilutions; always follow the label. For DIY, adult topical dilutions generally range 1–3% depending on sensitivity. Children and elders often require lower dilutions; consult the practitioner.\\n        <br/><br/>\\n        <strong>Patch Test:</strong> Before topical use, apply a small amount of diluted product to the inner forearm and wait 24 hours. If irritation, redness, or discomfort occurs, discontinue use.\\n        <br/><br/>\\n        <strong>Pets:</strong> Many essential oils can affect animals differently. Avoid direct application to pets and consult before diffusing in shared spaces. Notify us of pets in your home for tailored product guidance.\\n        <br/><br/>\\n        <strong>Pregnancy & Nursing:</strong> Some essential oils are not recommended during pregnancy or nursing, and some blends will be adapted accordingly. If pregnant or nursing, select products labeled pregnancy-safe or contact {{PRACTITIONER_NAME}} for recommendations.\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h4 style=\\\"margin:0\\\">Support & Returns</h4>\\n      <p class=\\\"small\\\" style=\\\"margin-top:8px;color:var(--muted)\\\">We guarantee products for arrival and quality. Opened bottles are handled case-by-case for safety reasons; contact <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> for support.</p>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div style=\\\"color:var(--muted)\\\">Questions? Call <strong>{{PHONE}}</strong> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        <div style=\\\"color:var(--muted)\\\">© {{BUSINESS_NAME}} • Serving {{CITY}}, {{STATE}}</div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
