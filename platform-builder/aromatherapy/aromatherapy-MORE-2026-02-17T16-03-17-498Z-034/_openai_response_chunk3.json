          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Tariffs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--earth:#7a5a3e;--warm:#d9b99b;--cream:#fff8ef;--accent:#8fb56b;--muted:#6b5a50}\\n    *{box-sizing:border-box}\\n    body{font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial;background:linear-gradient(180deg,var(--cream),#fff);color:var(--muted);margin:0}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px;background:linear-gradient(90deg,rgba(122,90,62,0.06),transparent);border-bottom:1px solid rgba(122,90,62,0.06)}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,var(--earth),var(--warm));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none;font-weight:600;font-size:14px}\\n    main{max-width:980px;margin:36px auto;padding:28px}\\n    h1{color:var(--earth);margin:0 0 10px;font-size:28px}\\n    p.lead{color:#5b4a3f;margin:0 0 20px}\\n    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:24px 0}\\n    .card{background:#fff;border-radius:12px;padding:18px;border:1px solid rgba(122,90,62,0.06);box-shadow:0 6px 18px rgba(120,90,60,0.06)}\\n    .price{font-size:20px;color:var(--earth);font-weight:800}\\n    .muted{color:#8b7769;font-size:14px}\\n    .cta{display:inline-block;margin-top:14px;padding:10px 14px;background:var(--earth);color:#fff;border-radius:10px;text-decoration:none}\\n    .tiny{font-size:13px;color:#6d5c50}\\n    .faq{margin-top:36px}\\n    .faq h3{color:var(--earth);margin-bottom:8px}\\n    .faq p{margin:8px 0;color:#5b4a3f}\\n    footer{margin-top:50px;padding:28px;color:#6b5a50;text-align:center}\\n    /* subtle svg patterned background via data-uri */\\n    body::before{content:\\\"\\\";position:fixed;inset:0;opacity:0.06;background-image:url('data:image/svg+xml;utf8,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"200\\\" height=\\\"200\\\"><defs><pattern id=\\\"p\\\" width=\\\"20\\\" height=\\\"20\\\" patternUnits=\\\"userSpaceOnUse\\\"><rect width=\\\"20\\\" height=\\\"20\\\" fill=\\\"%23fff6f0\\\"/><circle cx=\\\"10\\\" cy=\\\"10\\\" r=\\\"2\\\" fill=\\\"%238fb56b\\\" opacity=\\\"0.12\\\"/></pattern></defs><rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(%23p)\\\"/></svg>');pointer-events:none}\\n    @media(max-width:880px){.cards{grid-template-columns:1fr}.brand .logo{width:40px;height:40px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:700;color:var(--earth)\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:#8b7769\\\">Handmade scent learning in a collective format</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Nest</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Apothecary</a>\\n      <a href=\\\"pricing.html\\\" style=\\\"color:var(--earth)\\\">Tariffs</a>\\n      <a href=\\\"about.html\\\">Our Soil</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <h1>Group scent learning & seasonal cohort plans</h1>\\n    <p class=\\\"lead\\\">Practical aromatherapy for everyday rhythms — cohort programs that guide you through crafted scent practices, group reflection and safe blending habits you can keep. Spaces are limited to keep the cohort intimate.</p>\\n\\n    <section class=\\\"cards\\\" aria-label=\\\"cohort plans\\\">\\n      <div class=\\\"card\\\">\\n        <h2 style=\\\"margin:0 0 8px;color:var(--earth)\\\">Foundations Cohort</h2>\\n        <div class=\\\"price\\\">$249</div>\\n        <div class=\\\"tiny\\\">4 sessions across 6 weeks • small cohort learning</div>\\n        <p class=\\\"muted\\\">Learn safe dilution basics, patch-testing, and simple blends that may support sleep, focus, and calm. Included: mix-along kit list and community call.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Join the Foundations</a>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <h2 style=\\\"margin:0 0 8px;color:var(--earth)\\\">Seasonal Scent Circle</h2>\\n        <div class=\\\"price\\\">$99</div>\\n        <div class=\\\"tiny\\\">Drop-in month • cohort format</div>\\n        <p class=\\\"muted\\\">A single-month cohort with guided scent practices, short rituals and journaling prompts to tune to the season. May support grounding and mood regulation.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve a Seat</a>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <h2 style=\\\"margin:0 0 8px;color:var(--earth)\\\">Scent Stewardship — Ongoing</h2>\\n        <div class=\\\"price\\\">$49 / month</div>\\n        <div class=\\\"tiny\\\">Monthly live circle • limited cohort</div>\\n        <p class=\\\"muted\\\">Monthly gatherings, rotating blend themes and member-only recipes. Practical scent support that may help steady daily ritual.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Request Invite</a>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3>Practical questions</h3>\\n      <p><strong>Why a cohort?</strong> Group learning helps you build consistent scent habits with peer support and guided practice — we keep sessions small so there’s space to ask about dilution and safety.</p>\\n      <p><strong>What’s included?</strong> Session recordings, blend cards, dilution guides, and an optional mix-along kit list. No medical promises — scent practices may support mood and routines.</p>\\n      <p><strong>Payment & refunds</strong> Payment secures your spot. Full refund up to 14 days before cohort start; partial credit may be available for later cancellations.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px;display:flex;gap:12px;align-items:center\\\">\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Register a Seat</a>\\n      <a href=\\\"contact.html\\\" style=\\\"color:var(--muted);text-decoration:none\\\">Have questions? Reach out — {{EMAIL}}</a>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--earth);text-decoration:none\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Our Soil — About {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--earth:#6f4a32;--warm:#e9c9a6;--cream:#fff9f4;--accent:#9fb870;--muted:#5b463b}\\n    body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto;line-height:1.45;margin:0;background:var(--cream);color:var(--muted)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 26px;border-bottom:1px solid rgba(111,74,50,0.06)}\\n    .logo{width:44px;height:44px;border-radius:8px;background:linear-gradient(135deg,var(--earth),var(--warm));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none;font-weight:600}\\n    main{max-width:900px;margin:28px auto;padding:22px}\\n    .hero{display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:start}\\n    h1{color:var(--earth);margin:0 0 10px}\\n    p.lead{color:#6a5246}\\n    .aside{background:#fff;padding:18px;border-radius:12px;border:1px solid rgba(111,74,50,0.04)}\\n    .try{display:block;margin-top:12px;padding:10px 12px;background:var(--earth);color:#fff;border-radius:10px;text-decoration:none}\\n    .section{margin-top:24px;background:linear-gradient(180deg,rgba(159,184,112,0.04),transparent);padding:16px;border-radius:12px}\\n    .pill{display:inline-block;background:var(--warm);padding:6px 10px;border-radius:999px;color:var(--earth);font-weight:700;font-size:13px}\\n    footer{margin-top:40px;text-align:center;color:#8b7466;padding:20px}\\n    @media(max-width:820px){.hero{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:700;color:var(--earth)\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:#8b7466\\\">A gentle, practical approach to scent</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Nest</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Apothecary</a>\\n      <a href=\\\"pricing.html\\\">Tariffs</a>\\n      <a href=\\\"about.html\\\" style=\\\"color:var(--earth)\\\">Our Soil</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"hero\\\">\\n      <div>\\n        <span class=\\\"pill\\\">Aromatic craft</span>\\n        <h1>We teach simple scent practices you can keep</h1>\\n        <p class=\\\"lead\\\">We make approachable aromatherapy for people who want clear, safe ways to add scent to daily life. Our offerings focus on habits, simple blends, and how scent can be an anchor for attention — never a medical treatment.</p>\\n\\n        <section class=\\\"section\\\">\\n          <h3 style=\\\"margin-top:0;color:var(--earth)\\\">Our approach</h3>\\n          <ul style=\\\"color:#6a5246\\\">\\n            <li>Safety-first blending and dilution guidance</li>\\n            <li>Short, playful rituals you can actually fit into your day</li>\\n            <li>Cohort learning so skill-building happens with encouragement</li>\\n          </ul>\\n        </section>\\n\\n        <section style=\\\"margin-top:18px\\\">\\n          <h3 style=\\\"color:var(--earth)\\\">Beliefs</h3>\\n          <p class=\\\"muted\\\">Scent can be a small companion to intention. We avoid claims and focus on practices that may support regulation, attention and restful routines. We lean into seasonal rhythms and community reflection.</p>\\n        </section>\\n\\n        <section style=\\\"margin-top:18px\\\">\\n          <h3 style=\\\"color:var(--earth)\\\">Want a quick practice?</h3>\\n          <p class=\\\"muted\\\">Try a short guided practice — three minutes to breathe and set an intention. No sign-up required.</p>\\n          <a class=\\\"try\\\" href=\\\"#\\\" id=\\\"open-practice\\\">Try it now — three minutes</a>\\n        </section>\\n      </div>\\n\\n      <aside class=\\\"aside\\\">\\n        <h4 style=\\\"margin-top:0;color:var(--earth)\\\">Meet the maker</h4>\\n        <p class=\\\"muted\\\">Aromatherapist, plant curious, ritual tinker. I study safety-first blending, enjoy teaching cohort formats, and keep my kit simple: a set of core oils and a small journal.</p>\\n        <p style=\\\"font-size:13px;margin:10px 0;color:#8b7466\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></p>\\n        <a href=\\\"book.html\\\" class=\\\"try\\\" style=\\\"background:var(--accent);color:#2e3b23\\\">Reserve a consult</a>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:26px\\\">\\n      <h3 style=\\\"color:var(--earth)\\\">Values & Safety</h3>\\n      <p class=\\\"muted\\\">We teach patch testing, dilution, and pet/pregnancy cautions in every course. No medical promises — aromatherapy practices may support feelings of calm or focus for some people. We prioritize clear guidance over fancy claims.</p>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"color:#8b7466\\\">Local sessions in {{CITY}}, {{STATE}} • Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </footer>\\n\\n  <!-- Guided exercise modal (breathing / journaling / intention) -->\\n  <div id=\\\"practice-modal\\\" role=\\\"dialog\\\" aria-modal=\\\"true\\\" aria-hidden=\\\"true\\\" style=\\\"position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.35);visibility:hidden;opacity:0;transition:all .22s\\\">\\n    <div style=\\\"background:#fff;border-radius:14px;padding:22px;max-width:520px;width:92%;box-shadow:0 20px 40px rgba(0,0,0,0.18);text-align:center;color:var(--muted)\\\">\\n      <h2 style=\\\"color:var(--earth);margin-top:0\\\">Three-minute anchoring</h2>\\n      <p id=\\\"practice-text\\\" style=\\\"font-size:16px\\\">Get comfortable. We’ll take three minutes to breathe, notice, and set one small intention.</p>\\n      <div id=\\\"timer\\\" style=\\\"font-weight:800;font-size:28px;color:var(--earth);margin:12px 0\\\">03:00</div>\\n      <div style=\\\"display:flex;gap:10px;justify-content:center\\\">\\n        <button id=\\\"start-btn\\\" style=\\\"padding:8px 12px;border-radius:10px;background:var(--accent);border:0;color:#17320f\\\">Begin</button>\\n        <button id=\\\"close-btn\\\" style=\\\"padding:8px 12px;border-radius:10px;background:#eee;border:0;color:var(--muted)\\\">Close</button>\\n      </div>\\n      <div style=\\\"margin-top:12px;font-size:13px;color:#8b7466\\\">Option: jot one line in a notebook during the final minute.</div>\\n    </div>\\n  </div>\\n\\n  <script>\\n    (function(){\\n      var modal=document.getElementById('practice-modal');\\n      var open=document.getElementById('open-practice');\\n      var close=document.getElementById('close-btn');\\n      var start=document.getElementById('start-btn');\\n      var timerEl=document.getElementById('timer');\\n      var text=document.getElementById('practice-text');\\n      var seconds=180, interval=null;\\n\\n      function show(){modal.style.visibility='visible';modal.style.opacity='1';modal.setAttribute('aria-hidden','false');}\\n      function hide(){modal.style.opacity='0';setTimeout(function(){modal.style.visibility='hidden';modal.setAttribute('aria-hidden','true');clearInterval(interval);reset();},220)}\\n      function format(s){var m=Math.floor(s/60);var ss=s%60;return (m<10? '0'+m:m)+':'+(ss<10? '0'+ss:ss)}\\n      function reset(){seconds=180;timerEl.textContent=format(seconds);text.textContent='Get comfortable. We’ll take three minutes to breathe, notice, and set one small intention.';start.textContent='Begin'}\\n\\n      open.addEventListener('click',function(e){e.preventDefault();show();});\\n      close.addEventListener('click',hide);\\n      start.addEventListener('click',function(){\\n        if(interval){clearInterval(interval);interval=null;start.textContent='Begin';reset();return}\\n        start.textContent='Pause';\\n        interval=setInterval(function(){seconds--; if(seconds<=0){clearInterval(interval);interval=null;timerEl.textContent='00:00';text.textContent='Take a deep breath. When you\\'re ready, open your eyes and write one short note about how you feel.';start.textContent='Begin';return} timerEl.textContent=format(seconds);\\n          if(seconds===120) text.textContent='Notice the breath: inhale for 4, pause 1, exhale for 5 — repeat.';\\n          if(seconds===60) text.textContent='Shift to a softer focus: notice body sensations, and choose one short intention to carry.';\\n        },1000);\\n      });\\n\\n      // accessibility: close on ESC\\n      document.addEventListener('keydown',function(e){if(e.key==='Escape'){if(modal.getAttribute('aria-hidden')==='false')hide()}});\\n\\n      // init\\n      reset();\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Reserve — Book a moment with {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--earth:#5a3f2b;--warm:#e3bfa3;--cream:#fffaf6;--accent:#7aa76a;--muted:#59463f}\\n    body{font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto;color:var(--muted);background:var(--cream);margin:0}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:16px 22px;border-bottom:1px solid rgba(90,63,43,0.05)}\\n    .logo{width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,var(--earth),var(--warm));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    main{max-width:1080px;margin:30px auto;padding:20px}\\n    .grid{display:grid;grid-template-columns:1fr 420px;gap:22px}\\n    .hero{background:#fff;padding:22px;border-radius:14px;border:1px solid rgba(90,63,43,0.04)}\\n    h1{color:var(--earth);margin-top:0}\\n    .muted{color:#6b5348}\\n    .form{background:#fff;padding:16px;border-radius:12px;border:1px solid rgba(90,63,43,0.04)}\\n    label{display:block;margin-top:10px;font-size:13px;color:#6b5348}\\n    select,input,textarea{width:100%;padding:10px;margin-top:6px;border:1px solid #e7ded5;border-radius:8px}\\n    .btn{display:inline-block;margin-top:12px;padding:10px 14px;background:var(--earth);color:#fff;border-radius:10px;text-decoration:none}\\n    .small{font-size:13px;color:#8b7466}\\n    .builder{margin-top:18px;background:linear-gradient(180deg,rgba(122,90,62,0.03),transparent);padding:12px;border-radius:10px}\\n    .blend-card{background:#fff;border-radius:10px;padding:12px;margin-top:12px;border:1px dashed rgba(90,63,43,0.08)}\\n    .copy{background:var(--accent);color:#153218;padding:8px 10px;border-radius:10px;border:0}\\n    @media(max-width:980px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div style=\\\"font-weight:700;color:var(--earth)\\\">{{BUSINESS_NAME}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Nest</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Apothecary</a>\\n      <a href=\\\"pricing.html\\\">Tariffs</a>\\n      <a href=\\\"about.html\\\">Our Soil</a>\\n      <a href=\\\"book.html\\\" style=\\\"color:var(--earth)\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"grid\\\">\\n      <div class=\\\"hero\\\">\\n        <h1>Reserve a session / Build a simple blend</h1>\\n        <p class=\\\"muted\\\">Pick a short consult or cohort spot. Below you can also craft a safe, simple blend — choose a vibe and container size and we’ll offer a dilution guide and a printable card.</p>\\n\\n        <section class=\\\"form\\\" aria-labelledby=\\\"booking\\\">\\n          <h3 id=\\\"booking\\\" style=\\\"color:var(--earth);margin:0\\\">Book a moment</h3>\\n          <label>Service</label>\\n          <select id=\\\"service\\\">\\n            <option>30 min: Quick consult (trial)</option>\\n            <option>60 min: Personal aroma plan</option>\\n            <option>Group cohort registration</option>\\n          </select>\\n          <label>Name</label>\\n          <input id=\\\"name\\\" placeholder=\\\"Your name\\\" />\\n          <label>Email</label>\\n          <input id=\\\"email\\\" placeholder=\\\"you@example.com\\\" />\\n          <label>Notes (optional)</label>\\n          <textarea id=\\\"notes\\\" rows=\\\"3\\\" placeholder=\\\"Anything to share before we meet?\\\"></textarea>\\n          <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n            <a href=\\\"#\\\" id=\\\"book-now\\\" class=\\\"btn\\\">{{PRIMARY_CTA_LABEL}}</a>\\n            <span class=\\\"small\\\">Or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></span>\\n          </div>\\n        </section>\\n\\n        <section class=\\\"builder\\\" aria-label=\\\"blend builder\\\">\\n          <h3 style=\\\"margin:0;color:var(--earth)\\\">Blend Builder — pick a vibe</h3>\\n          <div style=\\\"display:flex;gap:8px;margin-top:10px;flex-wrap:wrap\\\">\\n            <button class=\\\"vibe\\\" data-vibe=\\\"calm\\\">Calm</button>\\n            <button class=\\\"vibe\\\" data-vibe=\\\"focus\\\">Focus</button>\\n            <button class=\\\"vibe\\\" data-vibe=\\\"sleep\\\">Sleep</button>\\n            <button class=\\\"vibe\\\" data-vibe=\\\"uplift\\\">Uplift</button>\\n            <button class=\\\"vibe\\\" data-vibe=\\\"ground\\\">Ground</button>\\n          </div>\\n\\n          <div style=\\\"display:flex;gap:8px;margin-top:10px;align-items:center\\\">\\n            <label style=\\\"margin:0;font-size:13px\\\">Container</label>\\n            <select id=\\\"size\\\" style=\\\"width:140px;margin-left:8px\\\">\\n              <option value=\\\"10\\\">10 ml</option>\\n              <option value=\\\"30\\\">30 ml</option>\\n            </select>\\n            <label style=\\\"margin-left:12px;font-size:13px\\\">Dilution</label>\\n            <select id=\\\"dilution\\\" style=\\\"width:160px;margin-left:8px\\\">\\n              <option value=\\\"1\\\">Low (1%) — sensitive</option>\\n              <option value=\\\"2\\\" selected>Standard (2%)</option>\\n              <option value=\\\"3\\\">Full (3%) — adults</option>\\n            </select>\\n          </div>\\n\\n          <div id=\\\"blend-result\\\" class=\\\"blend-card\\\" aria-live=\\\"polite\\\" style=\\\"display:none\\\">\\n            <strong id=\\\"blend-title\\\"></strong>\\n            <div id=\\\"blend-list\\\" style=\\\"margin-top:8px;color:#6b5348\\\"></div>\\n            <div id=\\\"dilution-guide\\\" style=\\\"margin-top:10px;font-size:13px;color:#8b7466\\\"></div>\\n            <div style=\\\"margin-top:10px;display:flex;gap:8px;align-items:center\\\">\\n              <button id=\\\"copy-card\\\" class=\\\"copy\\\">Copy blend card</button>\\n              <button id=\\\"reset-blend\\\" style=\\\"padding:8px;border-radius:8px;border:1px solid #eee;background:#fff\\\">Reset</button>\\n            </div>\\n            <div style=\\\"margin-top:8px;font-size:12px;color:#9b8377\\\">Note: This is non-medical guidance. See FAQ for pregnancy, pets and patch testing.\\n            </div>\\n          </div>\\n        </section>\\n\\n      </div>\\n\\n      <aside style=\\\"background:#fff;padding:18px;border-radius:12px;border:1px solid rgba(90,63,43,0.04)\\\">\\n        <h3 style=\\\"color:var(--earth);margin-top:0\\\">Quick booking</h3>\\n        <p class=\\\"small\\\">I offer short consults and deeper aroma planning sessions. If you’re joining a cohort, choose the registration option. We’ll email details after you request a booking.</p>\\n\\n        <h4 style=\\\"color:var(--earth);margin-top:16px\\\">Safety notes</h4>\\n        <ul class=\\\"small\\\" style=\\\"color:#6b5348\\\">\\n          <li>We provide dilution tables — always patch-test before use.</li>\\n          <li>Use baby-safe dilutions and avoid direct inhalation for young children.</li>\\n          <li>Check pregnancy and pet cautions in our FAQ before blending.</li>\\n        </ul>\\n\\n        <div style=\\\"margin-top:14px;display:flex;gap:8px\\\">\\n          <a href=\\\"#\\\" class=\\\"btn\\\" id=\\\"open-practice-2\\\" style=\\\"background:var(--accent);color:#153218\\\">Try a 3-minute practice</a>\\n          <a href=\\\"contact.html\\\" style=\\\"padding:10px 12px;border-radius:10px;background:#f4f0ec;color:var(--muted);text-decoration:none\\\">Questions</a>\\n        </div>\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <footer style=\\\"text-align:center;padding:22px;color:#8b7466\\\">{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></footer>\\n\\n  <script>\\n    // Blend builder logic\\n    (function(){\\n      var vibes={\\n        calm:{name:'Calm', oils:['Lavender','Roman Chamomile','Bergamot']},\\n        focus:{name:'Focus', oils:['Rosemary','Lemon','Basil']},\\n        sleep:{name:'Sleep', oils:['Lavender','Cedarwood','Frankincense']},\\n        uplift:{name:'Uplift', oils:['Sweet Orange','Grapefruit','Palmarosa']},\\n        ground:{name:'Ground', oils:['Vetiver','Patchouli','Atlas Cedar']}\\n      };\\n\\n      function dropsFor(containerMl, percent){\\n        // guide: 1% = 6 drops per 30ml -> per ml = 0.2 drops\\n        var dropsPerMl = 6/30;\\n        var totalDrops = Math.round(dropsPerMl * containerMl * percent);\\n        // spread across oils roughly evenly\\n        return totalDrops;\\n      }\\n\\n      var buttons=document.querySelectorAll('.vibe');\\n      var sizeEl=document.getElementById('size');\\n      var dilEl=document.getElementById('dilution');\\n      var result=document.getElementById('blend-result');\\n      var title=document.getElementById('blend-title');\\n      var list=document.getElementById('blend-list');\\n      var guide=document.getElementById('dilution-guide');\\n      var copyBtn=document.getElementById('copy-card');\\n      var resetBtn=document.getElementById('reset-blend');\\n\\n      function render(vibeKey){\\n        var size = parseInt(sizeEl.value,10);\\n        var pct = parseInt(dilEl.value,10);\\n        var spec = vibes[vibeKey];\\n        if(!spec) return;\\n        var total = dropsFor(size,pct);\\n        var oils = spec.oils;\\n        var per = Math.max(1,Math.round(total/oils.length));\\n        title.textContent = spec.name + ' blend';\\n        var html = '<strong>Oils:</strong><br><ul style=\\\"margin:6px 0 0 18px;padding:0;color:#6b5348\\\">';\\n        oils.forEach(function(o,i){\\n          html += '<li>'+o+' — '+per+' drops</li>';\\n        });\\n        html += '</ul>';\\n        list.innerHTML = html;\\n        guide.innerHTML = '<strong>Dilution guide:</strong> For a '+size+'ml bottle at '+pct+'% dilution, use approximately '+total+' total drops of essential oil (about '+per+' drops per oil). Typical conversions: 1% ≈ 6 drops/30ml; 2% ≈ 12 drops/30ml; 3% ≈ 18 drops/30ml. Use a carrier oil like jojoba or sweet almond to fill the rest.';\\n        result.style.display='block';\\n      }\\n\\n      buttons.forEach(function(b){b.addEventListener('click',function(){\\n        var key=b.getAttribute('data-vibe');\\n        render(key);\\n      })});\\n\\n      copyBtn.addEventListener('click',function(){\\n        var text = title.textContent+'\\\\n'+list.textContent+'\\\\n'+guide.textContent+'\\\\n\\\\nGenerated from '+location.href;\\n        navigator.clipboard && navigator.clipboard.writeText(text).then(function(){copyBtn.textContent='Copied!';setTimeout(function(){copyBtn.textContent='Copy blend card'},1200)});\\n      });\\n\\n      resetBtn.addEventListener('click',function(){result.style.display='none'});\\n\\n      // handle booking CTA - simple client side affirmation\\n      document.getElementById('book-now').addEventListener('click',function(e){e.preventDefault();var name=document.getElementById('name').value||'Friend';alert('Thanks '+name+' — we\\\\'ll send next steps to the email you provided.');window.location.href='{{PRIMARY_CTA_URL}}';});\\n    })();\\n\\n    // second guided practice instance (same behavior as about page)\\n    (function(){\\n      var open=document.getElementById('open-practice-2');\\n      // create a lightweight modal\\n      function createModal(){\\n        var modal=document.createElement('div');modal.setAttribute('role','dialog');modal.style.position='fixed';modal.style.inset='0';modal.style.display='flex';modal.style.alignItems='center';modal.style.justifyContent='center';modal.style.background='rgba(0,0,0,0.32)';\\n        var card=document.createElement('div');card.style.background='#fff';card.style.padding='18px';card.style.borderRadius='12px';card.style.maxWidth='520px';card.style.width='92%';card.style.textAlign='center';card.style.color='var(--muted)';\\n        card.innerHTML='<h2 style=\\\"color:var(--earth);margin-top:0\\\">Three-minute anchoring</h2><p id=\\\"ptext\\\">Take a seat. We\\\\'ll breathe and set one intention — no experience needed.</p><div id=\\\"ptimer\\\" style=\\\"font-weight:800;font-size:28px;color:var(--earth);margin:12px 0\\\">03:00</div><div style=\\\"display:flex;gap:8px;justify-content:center\\\"><button id=\\\"pstart\\\" style=\\\"padding:8px 12px;border-radius:10px;background:var(--accent);border:0;color:#153218\\\">Begin</button><button id=\\\"pclose\\\" style=\\\"padding:8px 12px;border-radius:10px;background:#eee;border:0;color:var(--muted)\\\">Close</button></div>';\\n        modal.appendChild(card);document.body.appendChild(modal);\\n        return modal;\\n      }\\n      var modal=null,interval=null,seconds=180;\\n      function format(s){var m=Math.floor(s/60);var ss=s%60;return (m<10? '0'+m:m)+':'+(ss<10? '0'+ss:ss)}\\n      open.addEventListener('click',function(e){e.preventDefault(); if(!modal) modal=createModal(); modal.style.visibility='visible'; modal.querySelector('#pstart').addEventListener('click',function(){var startBtn=this; if(interval){clearInterval(interval);interval=null;startBtn.textContent='Begin';seconds=180;modal.querySelector('#ptimer').textContent=format(seconds);modal.querySelector('#ptext').textContent='Take a seat. We\\\\'ll breathe and set one intention — no experience needed.';return} startBtn.textContent='Pause'; interval=setInterval(function(){seconds--; modal.querySelector('#ptimer').textContent=format(seconds); if(seconds===120) modal.querySelector('#ptext').textContent='Breathe steadily: inhale for 4, hold 1, exhale for 5.'; if(seconds===60) modal.querySelector('#ptext').textContent='Bring attention to one brief intention — a word or short phrase.'; if(seconds<=0){clearInterval(interval);interval=null;modal.querySelector('#ptext').textContent='When you\\\\'re ready, open your eyes and write one line in your notebook.';modal.querySelector('#pstart').textContent='Begin';}},1000); }); modal.querySelector('#pclose').addEventListener('click',function(){if(interval){clearInterval(interval);interval=null}modal.remove();modal=null;}); });\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
