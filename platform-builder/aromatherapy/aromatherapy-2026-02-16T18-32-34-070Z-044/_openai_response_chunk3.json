          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Plans & Pricing — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Carefully crafted aromatherapy intensives and packages from {{PRACTITIONER_NAME}}. Safety-forward, boutique care in {{CITY}}, {{STATE}}.\\\" />\\n  <style>\\n    :root{\\n      --bg-1:#FFF6EE;--bg-2:#F5E7D9;--accent:#8B5E3C;--muted:#645049;--card:#FFFFFF;--glass:rgba(255,255,255,0.6);\\n      --radius:14px;--gap:20px;--shadow: 0 8px 30px rgba(99,67,54,0.12);\\n      font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;\\n    }\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg-1),var(--bg-2));color:var(--muted);}\\n    .wrap{max-width:1100px;margin:48px auto;padding:36px;position:relative}\\n    header.nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,#FCE9D8,#F5D6B6);box-shadow:inset 0 -6px 12px rgba(139,94,60,0.06);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent)}\\n    nav a{margin:0 10px;text-decoration:none;color:var(--muted);font-weight:600}\\n    nav a[href$=\\\"pricing.html\\\"]{color:var(--accent)}\\n\\n    /* hero */\\n    .hero{display:flex;gap:28px;align-items:center;background:var(--glass);backdrop-filter:blur(6px);padding:24px;border-radius:var(--radius);box-shadow:var(--shadow)}\\n    .hero .eyebrow{font-size:13px;color:#8A6A53;text-transform:uppercase;letter-spacing:0.14em}\\n    .hero h1{margin:8px 0 6px;font-size:28px;color:#553A2C}\\n    .hero p{margin:0;color:#6D5648}\\n    .hero .cta{margin-top:12px;display:inline-block;padding:10px 16px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#A46A46);color:white;text-decoration:none;font-weight:700}\\n\\n    /* pricing grid */\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:22px}\\n    .card{background:var(--card);padding:20px;border-radius:12px;box-shadow:var(--shadow);border:1px solid rgba(132,98,70,0.06)}\\n    .card h3{margin:0 0 6px;color:#4A2F21}\\n    .price{font-size:22px;color:var(--accent);font-weight:800}\\n    .muted{color:#83645A;font-size:14px}\\n    .features{margin:12px 0 0;padding:0;list-style:none}\\n    .features li{padding:6px 0;border-top:1px dashed rgba(138,113,96,0.06)}\\n    .select{display:inline-block;margin-top:14px;padding:8px 12px;border-radius:10px;background:transparent;border:2px solid var(--accent);color:var(--accent);text-decoration:none;font-weight:700}\\n\\n    /* social proof */\\n    .social{display:flex;gap:12px;margin-top:26px}\\n    .testimonial{flex:1;background:linear-gradient(180deg,#FFF9F4,#FFF6EE);padding:16px;border-radius:12px;border:1px solid rgba(139,94,60,0.06)}\\n    .quote{font-style:italic;color:#5B4033}\\n    .by{margin-top:8px;font-size:13px;color:#8A6A53}\\n\\n    /* benefits + process */\\n    .two-col{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:24px}\\n    .benefits li{margin:8px 0}\\n    .process{counter-reset:step;display:flex;flex-direction:column;gap:12px}\\n    .step{display:flex;gap:12px;align-items:flex-start}\\n    .step .num{width:36px;height:36px;border-radius:10px;background:linear-gradient(180deg,#F3D9C0,#E9C6A9);display:flex;align-items:center;justify-content:center;font-weight:800;color:#6B402D}\\n\\n    /* faq */\\n    .faq{margin-top:26px}\\n    .q{margin:10px 0}\\n    .q summary{cursor:pointer;font-weight:700}\\n    details{background:#FFF;padding:12px;border-radius:10px;border:1px solid rgba(132,98,70,0.06)}\\n\\n    /* lead magnet */\\n    .magnet{margin-top:28px;padding:18px;border-radius:12px;background:linear-gradient(180deg,#FFFDF9,#FFF6EE);display:flex;gap:12px;align-items:center}\\n    .magnet input{flex:1;padding:12px;border-radius:10px;border:1px solid rgba(132,98,70,0.08)}\\n    .magnet button{padding:10px 14px;border-radius:10px;background:var(--accent);color:#fff;border:none}\\n\\n    /* cta footer */\\n    .cta-wrap{margin-top:28px;padding:18px;border-radius:12px;text-align:center;background:linear-gradient(90deg,#F5E7D9,#FFF6EE);border:1px solid rgba(139,94,60,0.06)}\\n    .cta-wrap a{display:inline-block;padding:12px 18px;border-radius:12px;background:#7A4F34;color:#fff;text-decoration:none;font-weight:800}\\n\\n    /* responsive */\\n    @media (max-width:880px){.grid{grid-template-columns:1fr}.two-col{grid-template-columns:1fr}.hero{flex-direction:column;align-items:flex-start}}\\n\\n    /* decorative inline svg */\\n    .pattern{position:fixed;right:-10%;top:-12%;opacity:0.09;transform:rotate(8deg);width:520px;height:520px;pointer-events:none}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#F8EDE2\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#EFDAC8\\\"/></linearGradient>\\n    </defs>\\n    <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"200\\\" height=\\\"200\\\" fill=\\\"url(#g1)\\\" rx=\\\"20\\\"/>\\n    <g fill=\\\"#DDBCA6\\\" transform=\\\"translate(20,20)\\\">\\n      <circle cx=\\\"40\\\" cy=\\\"40\\\" r=\\\"6\\\"/>\\n      <circle cx=\\\"80\\\" cy=\\\"80\\\" r=\\\"5\\\"/>\\n      <circle cx=\\\"20\\\" cy=\\\"120\\\" r=\\\"4\\\"/>\\n      <path d=\\\"M0 160 Q40 120 80 160\\\" stroke=\\\"#C79A7A\\\" stroke-width=\\\"2\\\" fill=\\\"none\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"wrap\\\">\\n    <header class=\\\"nav\\\">\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">A</div>\\n        <div>\\n          <div style=\\\"font-weight:800;color:#4A2F21\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:#8A6A53\\\">Handmade aromatherapy · {{CITY}}, {{STATE}}</div>\\n        </div>\\n      </div>\\n      <nav aria-label=\\\"top navigation\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"shop.html\\\">Shop</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"about.html\\\">Our Story</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\" aria-labelledby=\\\"pricing-hero\\\">\\n      <div>\\n        <div class=\\\"eyebrow\\\">Small-batch intensives</div>\\n        <h1 id=\\\"pricing-hero\\\">Choose the scent-skillet that fits your rhythm</h1>\\n        <p>Deep, safety-first aromatherapy sessions and curated packs designed for an experiential, hands-on approach. No medical promises — just careful, bespoke scent work by {{PRACTITIONER_NAME}}.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n      <div style=\\\"flex:1;max-width:360px\\\">\\n        <div style=\\\"background:linear-gradient(180deg,#FFF9F4,#FFF2E7);padding:12px;border-radius:12px;border:1px solid rgba(139,94,60,0.06)\\\">\\n          <div style=\\\"font-weight:800;color:#6A422F\\\">Intensive Model</div>\\n          <div style=\\\"font-size:13px;color:#8A6A53;margin-top:6px\\\">Book a focused 90–120 minute session for blending, ritual, and guidance. Bring questions, sensitivities, and curiosity.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"grid\\\" aria-label=\\\"pricing plans\\\">\\n      <div class=\\\"card\\\">\\n        <h3>Starter Ritual</h3>\\n        <div class=\\\"price\\\">$95</div>\\n        <div class=\\\"muted\\\">60-minute consult + mini blend</div>\\n        <ul class=\\\"features\\\">\\n          <li>Personalized aromatic notes</li>\\n          <li>Safety & dilution guidance</li>\\n          <li>One 10ml roll-on takeaway</li>\\n        </ul>\\n        <a class=\\\"select\\\" href=\\\"book.html\\\">Book Starter</a>\\n      </div>\\n      <div class=\\\"card\\\">\\n        <h3>Intensive Session</h3>\\n        <div class=\\\"price\\\">$185</div>\\n        <div class=\\\"muted\\\">90–120 minutes · custom blend</div>\\n        <ul class=\\\"features\\\">\\n          <li>Full sensory intake</li>\\n          <li>One bespoke 30ml blend + notes</li>\\n          <li>Care plan & safe-use tips</li>\\n        </ul>\\n        <a class=\\\"select\\\" href=\\\"book.html\\\">Reserve Intensive</a>\\n      </div>\\n      <div class=\\\"card\\\">\\n        <h3>Series — 3 Intensives</h3>\\n        <div class=\\\"price\\\">$510</div>\\n        <div class=\\\"muted\\\">Save 10% · ongoing support</div>\\n        <ul class=\\\"features\\\">\\n          <li>Three guided sessions</li>\\n          <li>Two bespoke blends across visits</li>\\n          <li>Priority booking & mini-check-ins</li>\\n        </ul>\\n        <a class=\\\"select\\\" href=\\\"contact.html\\\">Ask About Series</a>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"social\\\" aria-label=\\\"testimonials\\\">\\n      <div class=\\\"testimonial\\\">\\n        <div class=\\\"quote\\\">\\\"Aromatic, thoughtful, and so grounding. The intensive felt like a tiny ceremony — crafted with care.\\\"</div>\\n        <div class=\\\"by\\\">— L.M., local client</div>\\n      </div>\\n      <div class=\\\"testimonial\\\">\\n        <div class=\\\"quote\\\">\\\"Clear safety guidance and a blend that actually suits my sensitive skin. Highly recommend.\\\"</div>\\n        <div class=\\\"by\\\">— R.S., repeat guest</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"two-col\\\">\\n      <div class=\\\"card\\\">\\n        <h4>Why choose these plans?</h4>\\n        <ul class=\\\"benefits\\\">\\n          <li>Safety-first approach — dilution & patch testing explained.</li>\\n          <li>Hand-blended formulas for clarity, not cure.</li>\\n          <li>Personal instruction so you use blends with confidence.</li>\\n        </ul>\\n      </div>\\n      <div class=\\\"card\\\">\\n        <h4>How an Intensive flows</h4>\\n        <div class=\\\"process\\\">\\n          <div class=\\\"step\\\"><div class=\\\"num\\\">1</div><div><strong>Intake</strong><div class=\\\"muted\\\">We review sensitivities, preferences, and context.</div></div></div>\\n          <div class=\\\"step\\\"><div class=\\\"num\\\">2</div><div><strong>Explore & Blend</strong><div class=\\\"muted\\\">Hands-on scent testing and formulation.</div></div></div>\\n          <div class=\\\"step\\\"><div class=\\\"num\\\">3</div><div><strong>Plan & Pack</strong><div class=\\\"muted\\\">Dilution ratios, storage, and safe-use notes for at-home care.</div></div></div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h4>Common Questions</h4>\\n      <details class=\\\"q\\\"><summary>How do you handle dilution?</summary><div style=\\\"margin-top:8px\\\">Dilution is tailored to the client and intended use. For topical products we provide clear percentages and patch-test instructions. We never suggest internal use.</div></details>\\n      <details class=\\\"q\\\"><summary>Do I need a patch test?</summary><div style=\\\"margin-top:8px\\\">Yes — for topical blends we recommend a patch test 24–48 hours before regular use. We'll walk you through the steps during your session.</div></details>\\n      <details class=\\\"q\\\"><summary>Are these safe around pets?</summary><div style=\\\"margin-top:8px\\\">Some essential oils are not pet-friendly. We'll provide pet-safe alternatives and advice if you share your home with animals.</div></details>\\n      <details class=\\\"q\\\"><summary>What about pregnancy?</summary><div style=\\\"margin-top:8px\\\">Safety during pregnancy is important. We offer pregnancy-friendly options and avoid oils contraindicated in pregnancy. Always consult your healthcare provider on medical concerns.</div></details>\\n    </section>\\n\\n    <section class=\\\"magnet\\\">\\n      <div style=\\\"flex:1\\\">\\n        <strong>Free guide:</strong> \\\"A Gentle Start to Aromatherapy\\\" — brief, safety-first tips for blends at home.\\n      </div>\\n      <input aria-label=\\\"Email for guide\\\" placeholder=\\\"Your email\\\" type=\\\"email\\\" />\\n      <button type=\\\"button\\\">Send guide</button>\\n    </section>\\n\\n    <section class=\\\"cta-wrap\\\">\\n      <div style=\\\"font-weight:800;color:#4A2F21\\\">Ready to book an immersive session?</div>\\n      <div style=\\\"margin-top:10px\\\"><a href=\\\"book.html\\\">Book an Intensive with {{PRACTITIONER_NAME}}</a></div>\\n      <div style=\\\"margin-top:8px;font-size:13px;color:#83645A\\\">Prefer a quick question? Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </section>\\n\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Learn about {{PRACTITIONER_NAME}} and the philosophy behind our scent craft. Safety-first aromatherapy in {{CITY}}, {{STATE}}.\\\" />\\n  <style>\\n    :root{--bg:#F7F2EE;--accent:#7D4C35;--text:#4E372E;--muted:#866C60;--card:#FFFFFF}\\n    body{margin:0;background:radial-gradient(circle at 20% 10%,#FFF7F0 0%,var(--bg) 30%);font-family: Georgia, 'Times New Roman', serif;color:var(--text)}\\n    .site{max-width:980px;margin:44px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    .nav a{margin-left:12px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .nav a[href$=\\\"about.html\\\"]{color:var(--accent)}\\n\\n    .hero{display:flex;gap:18px;align-items:center;margin-top:18px}\\n    .portrait{width:140px;height:140px;border-radius:18px;background:linear-gradient(180deg,#FDEEE0,#FCE3CE);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent);box-shadow:0 10px 30px rgba(125,76,53,0.08)}\\n    .hero h1{margin:0;font-family:inherit;font-size:26px}\\n    .hero p{margin-top:6px;color:var(--muted)}\\n\\n    .story{margin-top:20px;padding:18px;background:var(--card);border-radius:12px;box-shadow:0 8px 24px rgba(125,76,53,0.06)}\\n    .accent-strip{height:8px;background:linear-gradient(90deg,#E8C6AD,#F7E1D2);border-radius:6px;margin-bottom:12px}\\n\\n    .values{display:flex;gap:12px;margin-top:14px}\\n    .pill{background:linear-gradient(180deg,#FFF8F3,#FFF2EA);padding:10px;border-radius:10px;border:1px solid rgba(125,76,53,0.06)}\\n\\n    .social-proof{margin-top:18px;display:flex;gap:12px}\\n    .quote{background:#FFF;padding:12px;border-radius:10px;border:1px solid rgba(139,94,60,0.06)}\\n\\n    /* FAQ block — moved earlier on this page for variety */\\n    .faq{margin-top:20px}\\n    details{background:#FFF;padding:12px;border-radius:10px;border:1px solid rgba(139,94,60,0.06);margin-top:8px}\\n\\n    .lead{margin-top:20px;padding:14px;border-radius:12px;background:linear-gradient(90deg,#FFF8F4,#FFF2EA);display:flex;align-items:center;gap:12px}\\n    .lead input{flex:1;padding:10px;border-radius:10px;border:1px solid rgba(125,76,53,0.08)}\\n    .lead button{padding:10px 14px;border-radius:10px;background:var(--accent);color:#fff;border:none}\\n\\n    .footer-cta{margin-top:22px;text-align:center}\\n    .footer-cta a{padding:12px 16px;border-radius:12px;background:#7A4E36;color:#fff;text-decoration:none}\\n\\n    .bg-flowers{position:fixed;left:-8%;bottom:-10%;opacity:0.06;width:600px;height:600px;pointer-events:none}\\n\\n    @media (max-width:760px){.hero{flex-direction:column;align-items:flex-start}.values{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"bg-flowers\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"bgA\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#F9EDE4\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#F6E0D0\\\"/></linearGradient>\\n    </defs>\\n    <rect width=\\\"200\\\" height=\\\"200\\\" fill=\\\"url(#bgA)\\\" rx=\\\"30\\\"/>\\n    <g fill=\\\"#D8B8A0\\\" transform=\\\"translate(30,30)\\\">\\n      <path d=\\\"M10 40 C20 10, 60 10, 70 40 C60 30, 20 30, 10 40\\\"/>\\n      <circle cx=\\\"120\\\" cy=\\\"80\\\" r=\\\"6\\\"/>\\n      <circle cx=\\\"40\\\" cy=\\\"120\\\" r=\\\"5\\\"/>\\n    </g>\\n  </svg>\\n\\n  <main class=\\\"site\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:800;font-size:18px\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:#866C60\\\">Curated aromatherapy — handcrafted blends</div>\\n      </div>\\n      <nav class=\\\"nav\\\" aria-label=\\\"main\\\">\\n        <a href=\\\"index.html\\\">Welcome</a>\\n        <a href=\\\"services.html\\\">Work</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"shop.html\\\">Boutique</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"portrait\\\">{{PRACTITIONER_NAME}}</div>\\n      <div>\\n        <h1>Hi — I’m {{PRACTITIONER_NAME}}. I make scent with intention.</h1>\\n        <p>My work centers on sensory listening, careful blending, and practical guidance. I create blends that feel like a small ritual you can carry with you. Safety and clarity are always first.</p>\\n      </div>\\n    </section>\\n\\n    <article class=\\\"story\\\">\\n      <div class=\\\"accent-strip\\\"></div>\\n      <h3>Our story</h3>\\n      <p>What began as a kitchen table curiosity turned into a practice rooted in close attention. I spend time with each guest to learn about sensitivities, memories, and favourite green corners of the world. Then we translate that into a simple, usable aromatherapy plan — whether a single roll-on or a seasonal series.</p>\\n\\n      <div class=\\\"values\\\">\\n        <div class=\\\"pill\\\"><strong>Safety-forward</strong><div style=\\\"font-size:13px;color:var(--muted)\\\">All recommendations include dilution and patch test info.</div></div>\\n        <div class=\\\"pill\\\"><strong>Hand-crafted</strong><div style=\\\"font-size:13px;color:var(--muted)\\\">Small-batch blends, labeled and dated.</div></div>\\n        <div class=\\\"pill\\\"><strong>Playful ritual</strong><div style=\\\"font-size:13px;color:var(--muted)\\\">Ceremony without complexity.</div></div>\\n      </div>\\n\\n      <div class=\\\"social-proof\\\">\\n        <div class=\\\"quote\\\">\\\"An experience that's both luxe and warm — I left with a blend that actually calmed my busy brain.\\\" — H</div>\\n        <div class=\\\"quote\\\">\\\"Detailed, kind, and very clear about what is safe with my cat at home.\\\" — N</div>\\n      </div>\\n    </article>\\n\\n    <section class=\\\"faq\\\">\\n      <h4>FAQ — practical notes</h4>\\n      <details><summary>What is dilution and why does it matter?</summary><div style=\\\"margin-top:8px\\\">Dilution is the percent of essential oil in a carrier. It's how we keep topical blends safe and reduce irritation. During sessions you receive exact percentages for your blend and its intended use.</div></details>\\n      <details><summary>How to do a patch test</summary><div style=\\\"margin-top:8px\\\">Apply a small diluted drop to the inner forearm and wait 24–48 hours. If redness or itchiness occurs, discontinue use. We'll demonstrate during your session.</div></details>\\n      <details><summary>Are blends pet-safe?</summary><div style=\\\"margin-top:8px\\\">Some oils are not recommended around pets. Tell me about your household and I will suggest pet-friendly formulations and diffusing practices.</div></details>\\n      <details><summary>Pregnancy & essential oils</summary><div style=\\\"margin-top:8px\\\">Pregnancy safety is nuanced. I offer pregnancy-safe alternatives and avoid oils that are commonly contraindicated. For medical advice, consult your healthcare practitioner.</div></details>\\n    </section>\\n\\n    <section class=\\\"lead\\\">\\n      <div style=\\\"flex:1\\\">Love gentle how-tos? Get occasional notes on seasonal blends and safe-use tips.</div>\\n      <input placeholder=\\\"Email address\\\" aria-label=\\\"email for updates\\\" />\\n      <button type=\\\"button\\\">Join</button>\\n    </section>\\n\\n    <div class=\\\"footer-cta\\\">\\n      <div style=\\\"font-weight:800;margin-bottom:8px\\\">Curious about a custom blend?</div>\\n      <a href=\\\"book.html\\\">Book a consult with {{PRACTITIONER_NAME}}</a>\\n      <div style=\\\"margin-top:8px;font-size:13px;color:var(--muted)\\\">Questions? Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or <a href=\\\"mailto:{{EMAIL}}\\\">email</a></div>\\n    </div>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Book a Session — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Schedule your aromatherapy intensive with {{PRACTITIONER_NAME}} in {{CITY}}, {{STATE}}. Safety-first, bespoke blends and guidance.\\\" />\\n  <style>\\n    :root{--bg:#FFF9F6;--accent:#8A5C43;--muted:#725748;--card:#FFFFFF}\\n    body{margin:0;font-family: 'Helvetica Neue', Arial, sans-serif;background:linear-gradient(180deg,#FFF9F6,#FFF3EA);color:var(--muted)}\\n    .container{max-width:920px;margin:36px auto;padding:26px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:14px;text-decoration:none;color:var(--muted)}\\n    nav a[href$=\\\"book.html\\\"]{color:var(--accent);font-weight:700}\\n\\n    .intro{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 8px 26px rgba(138,92,64,0.06);display:flex;gap:14px}\\n    .intro h1{margin:0;font-size:22px}\\n    .intro p{margin:6px 0 0;color:#876857}\\n\\n    .scheduler{display:grid;grid-template-columns:1fr 360px;gap:18px;margin-top:18px}\\n    .panel{background:var(--card);padding:16px;border-radius:12px;border:1px solid rgba(138,92,64,0.06)}\\n    .calendar{height:360px;border-radius:10px;background:linear-gradient(180deg,#FFFDFB,#FFF6F0);display:flex;align-items:center;justify-content:center;color:#A67A5F}\\n\\n    form{display:flex;flex-direction:column;gap:10px}\\n    input,textarea,select{padding:10px;border-radius:8px;border:1px solid rgba(130,90,62,0.08)}\\n    .submit{background:var(--accent);color:#fff;padding:10px;border-radius:10px;border:none;font-weight:800}\\n\\n    .process{margin-top:16px;display:flex;gap:10px;flex-wrap:wrap}\\n    .process .item{padding:8px 10px;border-radius:10px;background:linear-gradient(90deg,#FFF8F5,#FFF1E8);border:1px solid rgba(138,92,64,0.06)}\\n\\n    .faq{margin-top:18px}\\n    details{background:#FFF;padding:12px;border-radius:10px;border:1px solid rgba(138,92,64,0.06);margin-top:8px}\\n\\n    .lead-magnet{margin-top:18px;padding:14px;border-radius:12px;background:linear-gradient(90deg,#FFF8F3,#FFF1EA);display:flex;justify-content:space-between;align-items:center}\\n\\n    .bottom-cta{text-align:center;margin-top:18px}\\n    .bottom-cta a{padding:12px 16px;border-radius:12px;background:#7A4E36;color:#fff;text-decoration:none}\\n\\n    @media (max-width:900px){.scheduler{grid-template-columns:1fr}.calendar{height:220px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"intro\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1>Book an Intensive</h1>\\n        <p>Choose a focused 90–120 minute session for custom blending, sensory exploration, and safe-use instruction. No medical advice — just thoughtful aromatherapy.</p>\\n      </div>\\n      <div style=\\\"min-width:260px;text-align:right;color:#8A6A53\\\">\\n        <div style=\\\"font-weight:800\\\">{{PRACTITIONER_NAME}}</div>\\n        <div style=\\\"font-size:13px\\\">{{CITY}}, {{STATE}}</div>\\n        <div style=\\\"margin-top:8px\\\">Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"scheduler\\\">\\n      <div class=\\\"panel\\\">\\n        <div class=\\\"calendar\\\" aria-hidden=\\\"true\\\">[Static calendar mock — select date on form]</div>\\n\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\" style=\\\"margin-top:12px\\\">\\n          <label for=\\\"service\\\">Service</label>\\n          <select id=\\\"service\\\" name=\\\"service\\\">\\n            <option>Starter Ritual — 60 min</option>\\n            <option selected>Intensive Session — 90–120 min</option>\\n            <option>3-Session Series</option>\\n          </select>\\n\\n          <label for=\\\"date\\\">Preferred date</label>\\n          <input id=\\\"date\\\" name=\\\"date\\\" type=\\\"date\\\" required />\\n\\n          <label for=\\\"time\\\">Preferred time</label>\\n          <input id=\\\"time\\\" name=\\\"time\\\" type=\\\"time\\\" />\\n\\n          <label for=\\\"notes\\\">Notes & sensitivities</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Tell me about scent dislikes, skin sensitivities, pets, pregnancy, or anything else...\\\"></textarea>\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required />\\n\\n          <button class=\\\"submit\\\" type=\\\"submit\\\">Request booking</button>\\n        </form>\\n\\n        <div style=\\\"margin-top:12px;font-size:13px;color:#876857\\\">After you request a booking, we will follow up to confirm details and share a safety checklist and pre-appointment patch-test instructions.</div>\\n      </div>\\n\\n      <aside class=\\\"panel\\\">\\n        <h4>How booking works</h4>\\n        <div class=\\\"process\\\">\\n          <div class=\\\"item\\\"><strong>1.</strong> Request a slot</div>\\n          <div class=\\\"item\\\"><strong>2.</strong> Confirm & complete intake</div>\\n          <div class=\\\"item\\\"><strong>3.</strong> Come for your session — we craft your blend</div>\\n          <div class=\\\"item\\\"><strong>4.</strong> Receive safe-use & storage notes</div>\\n        </div>\\n\\n        <h4 style=\\\"margin-top:12px\\\">What to bring</h4>\\n        <ul style=\\\"margin:8px 0 0 16px;color:#725748\\\">\\n          <li>List of current medications (if any)</li>\\n          <li>Notes on allergies & pregnancy</li>\\n          <li>Questions about household pets</li>\\n        </ul>\\n\\n        <div style=\\\"margin-top:12px;font-size:13px\\\">Need a different time? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}}.</div>\\n      </aside>\\n    </div>\\n\\n    <section class=\\\"faq\\\">\\n      <h4>Booking FAQ</h4>\\n      <details><summary>Dilution guidance — will I receive exact ratios?</summary><div style=\\\"margin-top:8px\\\">Yes. For every topical product you receive, we include precise dilution percentages and instructions for safe application.</div></details>\\n      <details><summary>Patch test — when should I do one?</summary><div style=\\\"margin-top:8px\\\">Perform a patch test 24–48 hours before regular use of a topical blend. We'll include a step-by-step in your confirmation email.</div></details>\\n      <details><summary>Pets in the home — what should I tell you?</summary><div style=\\\"margin-top:8px\\\">Let us know species and typical behaviors. We avoid certain oils for households with dogs, cats, or birds and suggest safer diffusion and cleaning practices.</div></details>\\n      <details><summary>Pregnancy & sessions</summary><div style=\\\"margin-top:8px\\\">If you are pregnant or nursing, mention this in the notes field. We will offer pregnancy-safe alternatives and avoid oils that are commonly contraindicated.</div></details>\\n    </section>\\n\\n    <section class=\\\"lead-magnet\\\">\\n      <div>\\n        <strong>Quick guide:</strong> \\\"How to patch test\\\" — short, practical steps included with every booking confirmation.\\n      </div>\\n      <div>\\n        <a href=\\\"contact.html\\\" style=\\\"background:#7A4E36;color:#fff;padding:8px 12px;border-radius:8px;text-decoration:none\\\">Contact for help</a>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"bottom-cta\\\">\\n      <div style=\\\"font-weight:800;margin-bottom:6px\\\">Ready to build your scent?</div>\\n      <a href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </div>\\n\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
