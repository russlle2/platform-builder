          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Investment — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#0f1724;--glass:rgba(255,255,255,0.06);--glass-2:rgba(255,255,255,0.08);--accent1:#a9ffeb;--accent2:#8bd5ff;--muted:#cbd5e1;--card:#0b1220}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial;color:var(--muted);background:linear-gradient(180deg,var(--bg1),#071021);background-attachment:fixed}\\n    /* background pattern reference (external file) */\\n    body::before{content:'';position:fixed;inset:0;background-image:url('/assets/img/pattern.svg');opacity:0.18;mix-blend-mode:overlay;pointer-events:none}\\n    /* inline SVG layer for uniqueness */\\n    .svg-bg{position:fixed;inset:0;opacity:0.06;pointer-events:none}\\n    .wrap{max-width:1100px;margin:32px auto;padding:28px}\\n    nav{display:flex;gap:18px;align-items:center;backdrop-filter:blur(8px);background:linear-gradient(90deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border-radius:14px;padding:12px}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px 12px;border-radius:8px}\\n    nav a:hover{background:var(--glass-2);color:#fff}\\n    header.hero{display:grid;grid-template-columns:1fr 360px;gap:22px;align-items:start;margin-top:22px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.03),rgba(255,255,255,0.02));border:1px solid rgba(255,255,255,0.04);border-radius:16px;padding:18px}\\n    h1{color:#fff;margin:0 0 8px 0;font-size:clamp(20px,3.2vw,28px)}\\n    p.lead{margin:0 0 16px 0;color:var(--muted)}\\n    .price-grid{display:flex;flex-wrap:wrap;gap:14px}\\n    .price{flex:1 1 240px;padding:18px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);box-shadow:0 6px 18px rgba(2,6,23,0.6);}\\n    .price h3{margin:0;color:var(--accent1)}\\n    .price .cost{font-size:20px;color:#fff;margin:8px 0}\\n    .muted{color:var(--muted);font-size:13px}\\n    .cta{display:inline-block;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,var(--accent2),var(--accent1));color:#012; font-weight:600;text-decoration:none}\\n    .testimonials{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}\\n    .testimonial{padding:12px;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.01),rgba(255,255,255,0.02));border:1px solid rgba(255,255,255,0.03)}\\n    .benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:18px}\\n    .benefit{padding:14px;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent)}\\n    .process{margin-top:18px}\\n    .faq{margin-top:20px}\\n    form.leadmag{display:flex;gap:8px;margin-top:12px}\\n    input,select,textarea{padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:var(--muted)}\\n    footer{margin-top:26px;color:var(--muted);font-size:13px;text-align:center}\\n    @media(max-width:880px){header.hero{grid-template-columns:1fr;}\\n      .benefits{grid-template-columns:1fr}\\n      .testimonials{grid-template-columns:1fr}\\n      nav{overflow:auto}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <!-- Unique inline SVG pattern for this page -->\\n  <svg class='svg-bg' width='100%' height='100%' xmlns='http://www.w3.org/2000/svg' preserveAspectRatio='none'>\\n    <defs>\\n      <linearGradient id='gprice' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#2BD4C4' stop-opacity='0.12'/>\\n        <stop offset='1' stop-color='#7BE0FF' stop-opacity='0.08'/>\\n      </linearGradient>\\n    </defs>\\n    <rect width='100%' height='100%' fill='url(#gprice)'/>\\n    <g fill='rgba(255,255,255,0.02)'>\\n      <circle cx='20%' cy='12%' r='200'/>\\n      <circle cx='80%' cy='85%' r='240'/>\\n    </g>\\n  </svg>\\n\\n  <div class='wrap'>\\n    <nav class='card' role='navigation'>\\n      <a href='index.html'>Nest</a>\\n      <a href='services.html'>Offerings</a>\\n      <a href='blends.html'>Blends</a>\\n      <a href='shop.html'>Goods</a>\\n      <a href='pricing.html'>Investment</a>\\n      <a href='about.html'>About</a>\\n      <a href='book.html'>Reserve</a>\\n      <a href='contact.html'>Reach</a>\\n    </nav>\\n\\n    <header class='hero'>\\n      <section class='card'>\\n        <h1>Clarity on pricing for tailored aromatherapy — simple, transparent, safety-first</h1>\\n        <p class='lead'>Select the package that fits your needs. Everything below is a single-session or small-series offering designed for one-on-one attention and bespoke blends. No medical promises — therapeutic support and sensory design only.</p>\\n\\n        <div class='price-grid'>\\n          <div class='price'>\\n            <h3>VIP Day — Deep Aroma Design</h3>\\n            <div class='cost'>$1,200</div>\\n            <div class='muted'>4-hour immersive session: consult, blend, and implementation plan. Includes 2 bespoke roll-ons and a custom diffuser blend.</div>\\n            <div style='margin-top:10px'><a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a></div>\\n          </div>\\n\\n          <div class='price'>\\n            <h3>Signature Session</h3>\\n            <div class='cost'>$295</div>\\n            <div class='muted'>90-minute consultation with a personalized blend recipe and a 10ml roll-on.</div>\\n            <div style='margin-top:10px'><a class='cta' href='book.html'>Reserve a spot</a></div>\\n          </div>\\n\\n          <div class='price'>\\n            <h3>Mini Consult</h3>\\n            <div class='cost'>$95</div>\\n            <div class='muted'>30-minute focused guidance, ideal for quick blend tweaks or product recommendations.</div>\\n            <div style='margin-top:10px'><a class='cta' href='book.html'>Quick book</a></div>\\n          </div>\\n        </div>\\n\\n        <div class='muted' style='margin-top:12px'>Custom packages and corporate bookings are available — contact {{EMAIL}} or call {{PHONE}} for bespoke arrangements.</div>\\n      </section>\\n\\n      <aside class='card'>\\n        <h3 style='color:var(--accent2)'>Why the investment?</h3>\\n        <p class='muted'>A VIP Day is about concentrated results: tailored blends, education for safe everyday use, and a plan you can follow home. You walk away with tools, not generalities.</p>\\n\\n        <div style='margin-top:12px'>\\n          <strong style='color:#fff'>What's included</strong>\\n          <ul style='color:var(--muted);padding-left:18px'>\\n            <li>Intake + scent profiling</li>\\n            <li>On-site blending & labeling</li>\\n            <li>Usage guidelines & dilution notes</li>\\n            <li>Follow-up email summary</li>\\n          </ul>\\n        </div>\\n\\n        <div style='margin-top:12px'>\\n          <a class='cta' href='book.html'>Book VIP Day</a>\\n        </div>\\n      </aside>\\n    </header>\\n\\n    <section class='card' style='margin-top:18px'>\\n      <h2 style='margin-top:0;color:#fff'>Praise from clients</h2>\\n      <div class='testimonials'>\\n        <div class='testimonial'>\\n          <strong>\\\"Calm and precise\\\"</strong>\\n          <p class='muted'>I appreciated the safety briefing and the clear instructions for home use. The blend is gorgeous and long-lasting. — L.</p>\\n        </div>\\n        <div class='testimonial'>\\n          <strong>\\\"A real reset\\\"</strong>\\n          <p class='muted'>We crafted a diffuser blend for the studio. It brightens the space without overpowering. — M.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class='card' style='margin-top:18px'>\\n      <h2 style='color:var(--accent1)'>Benefits you can expect</h2>\\n      <div class='benefits'>\\n        <div class='benefit'><strong>Personalized blends</strong><div class='muted'>Formulated to your scent profile and safety needs.</div></div>\\n        <div class='benefit'><strong>Clear usage guidance</strong><div class='muted'>Dilution ratios, patch testing, and safe preferences included.</div></div>\\n        <div class='benefit'><strong>Take-home kit</strong><div class='muted'>Ready-to-use roll-ons or diffuser blends from the session.</div></div>\\n      </div>\\n    </section>\\n\\n    <section class='card process' style='margin-top:18px'>\\n      <h2 style='margin-top:0;color:#fff'>How it unfolds (typical VIP Day flow)</h2>\\n      <ol class='muted'>\\n        <li>Pre-session intake & scent questionnaire.</li>\\n        <li>Guided aroma exploration and safety audit.</li>\\n        <li>Blend formulation, labeling, and usage planning.</li>\\n        <li>Documented plan sent after the session.</li>\\n      </ol>\\n    </section>\\n\\n    <section class='card faq'>\\n      <h2 style='margin-top:0;color:var(--accent2)'>Common questions — safety & use</h2>\\n      <div>\\n        <strong>What dilution should I use?</strong>\\n        <p class='muted'>Dilution depends on product type, age, and sensitivity. Typical topical dilutions range 1–3% for adults; sensitive users and children warrant lower dilutions. Specific ratios are given with each blend.</p>\\n      </div>\\n      <div>\\n        <strong>Should I patch test first?</strong>\\n        <p class='muted'>Yes. Always patch test a new topical blend on a small area for 24 hours before regular use.</p>\\n      </div>\\n      <div>\\n        <strong>Are essential oils safe around pets?</strong>\\n        <p class='muted'>Some essential oils can be irritating to animals. We always include pet-safe recommendations and will adapt blends if you live with pets.</p>\\n      </div>\\n      <div>\\n        <strong>What about pregnancy?</strong>\\n        <p class='muted'>Pregnancy requires extra caution. We provide guidance and will avoid oils that are commonly discouraged during pregnancy. Always consult your healthcare provider for personal medical concerns.</p>\\n      </div>\\n    </section>\\n\\n    <section class='card' style='margin-top:18px'>\\n      <h2 style='margin-top:0;color:#fff'>Get the short guide — free</h2>\\n      <p class='muted'>Sign up for our one-page safety & dilution cheat sheet, perfect for new users or as a quick reference during blending.</p>\\n      <form class='leadmag' action='{{PRIMARY_CTA_URL}}' method='post'>\\n        <input type='email' name='email' placeholder='Your email' required>\\n        <button class='cta' type='submit'>Send the guide</button>\\n      </form>\\n      <p class='muted' style='margin-top:8px'>We respect your privacy. No medical claims — educational information only.</p>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} — {{TAGLINE}} • {{CITY}}, {{STATE}} • <a href='tel:{{PHONE}}' style='color:var(--accent1)'>{{PHONE}}</a> • <a href='mailto:{{EMAIL}}' style='color:var(--accent1)'>{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071021;--glass:rgba(255,255,255,0.05);--text:#dbeafe;--muted:#9fb3c8;--accent:#ffd6a5}\\n    html,body{height:100%;margin:0;background:radial-gradient(circle at 10% 20%,#082033 0%,#041018 60%),linear-gradient(180deg,#012;#001);font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial;color:var(--text)}\\n    body::before{content:'';position:fixed;inset:0;background-image:url('/assets/img/pattern.svg');opacity:0.12;mix-blend-mode:soft-light}\\n    .wrap{max-width:1000px;margin:28px auto;padding:20px}\\n    nav{display:flex;gap:12px;padding:10px;background:linear-gradient(90deg,rgba(255,255,255,0.02),transparent);border-radius:12px}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px;border-radius:8px}\\n    nav a:hover{color:var(--text)}\\n    .hero{display:flex;gap:18px;align-items:center;margin-top:16px}\\n    .bio{flex:1;padding:20px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border-radius:12px;backdrop-filter:blur(6px);}\\n    .profile{width:260px;padding:18px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);}\\n    h1{margin:0 0 8px 0;color:var(--accent)}\\n    .muted{color:var(--muted)}\\n    .approach{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}\\n    .card{padding:14px;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent)}\\n    .faq{margin-top:16px}\\n    .leadmag{margin-top:12px}\\n    .cta{background:linear-gradient(90deg,#ffd6a5,#ffb4c6);color:#041018;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:600}\\n    footer{margin-top:20px;color:var(--muted);font-size:13px;text-align:center}\\n    @media(max-width:800px){.hero{flex-direction:column}.approach{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- Unique inline SVG for this page -->\\n  <svg class='svg-unique' style='position:fixed;inset:0;pointer-events:none;opacity:0.05' xmlns='http://www.w3.org/2000/svg'>\\n    <defs>\\n      <linearGradient id='gabout' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#ffd6a5'/>\\n        <stop offset='1' stop-color='#ffb4c6'/>\\n      </linearGradient>\\n    </defs>\\n    <g>\\n      <rect x='-10' y='-10' width='40%' height='60%' fill='url(#gabout)'></rect>\\n      <circle cx='85%' cy='20%' r='160' fill='#fff' opacity='0.02'></circle>\\n    </g>\\n  </svg>\\n\\n  <div class='wrap'>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='services.html'>Services</a>\\n      <a href='blends.html'>Blends</a>\\n      <a href='shop.html'>Store</a>\\n      <a href='pricing.html'>Rates</a>\\n      <a href='about.html'>Who we are</a>\\n      <a href='book.html'>Book</a>\\n      <a href='contact.html'>Contact</a>\\n    </nav>\\n\\n    <div class='hero'>\\n      <div class='bio card'>\\n        <h1>About {{PRACTITIONER_NAME}}</h1>\\n        <p class='muted'>A practical, safety-first aromatherapy practice rooted in scent education, hands-on blending, and clear usage guidance. My approach is tailored and evidence-respecting — not a substitute for medical care.</p>\\n        <p class='muted'>I trained in clinical-grade aroma technique and botanical safety and have worked with individuals seeking sensory support, mindful workplace scenting, and custom ritual blends.</p>\\n\\n        <div class='approach'>\\n          <div class='card'>\\n            <strong>Method</strong>\\n            <p class='muted'>Intake & scent mapping → formulation with documented dilutions → education for safe daily use.</p>\\n          </div>\\n          <div class='card'>\\n            <strong>Values</strong>\\n            <p class='muted'>Respect for individual sensitivity, transparency about contraindications, and practical takeaways you can use at home.</p>\\n          </div>\\n        </div>\\n\\n        <div style='margin-top:12px'>\\n          <a class='cta' href='book.html'>Reserve a personalized session</a>\\n        </div>\\n      </div>\\n\\n      <aside class='profile card'>\\n        <h3 style='margin:0;color:#fff'>Credentials</h3>\\n        <p class='muted' style='margin:6px 0 0'>Certified aromatherapist and registered practitioner in safe essential oil use. Ongoing training in botanical safety and fragrance psychology.</p>\\n\\n        <div style='margin-top:12px'>\\n          <strong style='color:#fff'>Locations</strong>\\n          <div class='muted'>{{CITY}}, {{STATE}}</div>\\n        </div>\\n\\n        <div style='margin-top:12px'>\\n          <strong style='color:#fff'>Contact</strong>\\n          <div class='muted'><a href='mailto:{{EMAIL}}' style='color:var(--muted)'>{{EMAIL}}</a></div>\\n          <div class='muted'><a href='tel:{{PHONE}}' style='color:var(--muted)'>{{PHONE}}</a></div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section class='card' style='margin-top:16px'>\\n      <h2 style='margin:0;color:var(--accent)'>Philosophy: scent as a practical tool</h2>\\n      <p class='muted'>I view aroma as an expressive tool that can shape environment and routine when used with respect and clarity. Sessions emphasize reproducible routines — labeled blends, clear dilution notes, and safe storage recommendations.</p>\\n\\n      <div style='margin-top:12px'>\\n        <strong style='color:#fff'>What I don't do</strong>\\n        <p class='muted'>I do not diagnose, treat, or claim cures for medical conditions. I provide sensory and lifestyle support, and when health conditions are relevant I encourage collaboration with your healthcare provider.</p>\\n      </div>\\n    </section>\\n\\n    <section class='card faq' style='margin-top:16px'>\\n      <h3 style='margin:0;color:#ffd6a5'>Safety Q&A</h3>\\n      <div style='margin-top:8px'>\\n        <strong>Dilution guidance</strong>\\n        <p class='muted'>We provide dilution percentages for every topical product and explain adjustments for age and sensitivity.</p>\\n      </div>\\n      <div>\\n        <strong>Patch testing</strong>\\n        <p class='muted'>A patch test is strongly recommended for new topical blends and will be covered during the session.</p>\\n      </div>\\n      <div>\\n        <strong>Pets & oils</strong>\\n        <p class='muted'>We use pet-aware guidelines and will adapt blends if animals are in your home. Some oils are avoided where animal exposure is likely.</p>\\n      </div>\\n      <div>\\n        <strong>Pregnancy note</strong>\\n        <p class='muted'>Pregnancy warrants extra caution. We provide pregnancy-safe alternatives and will omit oils commonly discouraged in prenatal care.</p>\\n      </div>\\n    </section>\\n\\n    <section class='card leadmag' style='margin-top:16px'>\\n      <h3 style='margin:0;color:#fff'>Free: Quick safety checklist</h3>\\n      <p class='muted'>Get a printable checklist for dilution and storage. Ideal for new blend-makers and gifting guidance.</p>\\n      <form action='{{PRIMARY_CTA_URL}}' method='post' style='display:flex;gap:8px;margin-top:8px'>\\n        <input type='email' name='email' placeholder='Email address' required>\\n        <button class='cta' type='submit'>Send checklist</button>\\n      </form>\\n    </section>\\n\\n    <footer>\\n      <div class='muted'>{{BUSINESS_NAME}} • {{PRACTITIONER_NAME}} • {{CITY}}, {{STATE}} • <a href='mailto:{{EMAIL}}' style='color:var(--muted)'>{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#031022;--glass:rgba(255,255,255,0.04);--muted:#bcd6e6;--accent:#7ef0c7}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,#021122,#001018);font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial;color:var(--muted)}\\n    body::before{content:'';position:fixed;inset:0;background-image:url('/assets/img/pattern.svg');opacity:0.14}\\n    .wrap{max-width:900px;margin:26px auto;padding:20px}\\n    nav{display:flex;gap:10px;background:rgba(255,255,255,0.02);padding:10px;border-radius:12px}\\n    nav a{color:var(--muted);text-decoration:none}\\n    .panel{display:grid;grid-template-columns:1fr 380px;gap:16px;margin-top:16px}\\n    .card{padding:18px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);backdrop-filter:blur(6px)}\\n    h1{margin:0 0 6px 0;color:var(--accent)}\\n    label{display:block;margin-top:10px;font-size:13px}\\n    input,textarea,select{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:var(--muted)}\\n    button.submit{margin-top:12px;padding:10px 12px;border-radius:10px;border:none;background:linear-gradient(90deg,#7ef0c7,#8bd5ff);color:#022;font-weight:700}\\n    .note{font-size:13px;color:var(--muted);margin-top:8px}\\n    .faq{margin-top:14px}\\n    .safebelt{font-size:13px;color:var(--muted);padding:10px;border-radius:10px;background:rgba(255,255,255,0.01);margin-top:10px}\\n    @media(max-width:900px){.panel{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- Unique inline SVG motif for booking page -->\\n  <svg style='position:fixed;inset:0;pointer-events:none;opacity:0.05' xmlns='http://www.w3.org/2000/svg'>\\n    <defs>\\n      <linearGradient id='gbook' x1='0' x2='1'><stop offset='0' stop-color='#7ef0c7'/><stop offset='1' stop-color='#8bd5ff'/></linearGradient>\\n    </defs>\\n    <rect width='60%' height='40%' fill='url(#gbook)' transform='translate(20,10) rotate(10)'></rect>\\n  </svg>\\n\\n  <div class='wrap'>\\n    <nav>\\n      <a href='index.html'>Welcome</a>\\n      <a href='services.html'>Our Work</a>\\n      <a href='blends.html'>Recipes</a>\\n      <a href='shop.html'>Shop</a>\\n      <a href='pricing.html'>Invest</a>\\n      <a href='about.html'>Practitioner</a>\\n      <a href='book.html'>Reserve</a>\\n      <a href='contact.html'>Say hi</a>\\n    </nav>\\n\\n    <main class='panel'>\\n      <section class='card'>\\n        <h1>Reserve a personalized session</h1>\\n        <p class='note'>Choose a time for a focused appointment. Our VIP Day and Signature Session options prioritize hands-on blending, clear dilution instructions, and a safety-first approach. Please share any allergies, pregnancy, or pet info in the form below so we can plan safe blends.</p>\\n\\n        <form action='{{PRIMARY_CTA_URL}}' method='post'>\\n          <label for='name'>Full name</label>\\n          <input id='name' name='name' type='text' required>\\n\\n          <label for='email'>Email</label>\\n          <input id='email' name='email' type='email' required>\\n\\n          <label for='phone'>Phone</label>\\n          <input id='phone' name='phone' type='tel'>\\n\\n          <label for='service'>Session type</label>\\n          <select id='service' name='service'>\\n            <option value='vip'>VIP Day — immersive</option>\\n            <option value='signature'>Signature Session — 90 min</option>\\n            <option value='mini'>Mini Consult — 30 min</option>\\n          </select>\\n\\n          <label for='date'>Preferred date (optional)</label>\\n          <input id='date' name='date' type='date'>\\n\\n          <label for='notes'>Notes (allergies, pregnancy, pets, sensitivities)</label>\\n          <textarea id='notes' name='notes' rows='4' placeholder='Tell us about any considerations...'></textarea>\\n\\n          <div class='safebelt'>\\n            <input id='consent' name='consent' type='checkbox' required> <label for='consent' style='display:inline'>I understand this is complementary aromatherapy education and sensory design. It is not a medical diagnosis or treatment.</label>\\n          </div>\\n\\n          <button class='submit' type='submit'>{{PRIMARY_CTA_LABEL}}</button>\\n        </form>\\n\\n        <div class='faq'>\\n          <h3 style='color:#fff;margin:12px 0 6px 0'>Safety notes</h3>\\n          <p class='note'><strong>Dilution:</strong> We'll recommend percent dilutions for each topical product and provide written ratios.</p>\\n          <p class='note'><strong>Patch test:</strong> A patch test is recommended before regular topical use — instructions will be provided.</p>\\n          <p class='note'><strong>Pets & pregnancy:</strong> We tailor blends to be pet-aware and provide pregnancy-safe options where appropriate.</p>\\n        </div>\\n      </section>\\n\\n      <aside class='card'>\\n        <h3 style='margin:0;color:var(--accent)'>Quick booking details</h3>\\n        <div class='note' style='margin-top:8px'>\\n          Location: {{CITY}}, {{STATE}}. Remote consultations available on request. To inquire by phone, call <a href='tel:{{PHONE}}' style='color:var(--muted)'>{{PHONE}}</a>.\\n        </div>\\n\\n        <div style='margin-top:12px'>\\n          <strong style='color:#fff'>Preparation checklist</strong>\\n          <ul style='color:var(--muted);padding-left:18px'>\\n            <li>Bring a list of current medications & sensitivities.</li>\\n            <li>Note any household pets and their species.</li>\\n            <li>Wear unscented products for scent profiling.</li>\\n          </ul>\\n        </div>\\n\\n        <div style='margin-top:12px'>\\n          <strong style='color:#fff'>What to expect after booking</strong>\\n          <p class='muted'>You'll receive a confirmation email and a brief intake form to complete before the appointment.</p>\\n        </div>\\n\\n        <div style='margin-top:12px'>\\n          <a class='submit' href='mailto:{{EMAIL}}?subject=Booking inquiry'>Ask a question</a>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <footer style='text-align:center;margin-top:18px;color:var(--muted)'>\\n      <div>{{BUSINESS_NAME}} • {{PRACTITIONER_NAME}} • <a href='mailto:{{EMAIL}}' style='color:var(--muted)'>{{EMAIL}}</a> • <a href='tel:{{PHONE}}' style='color:var(--muted)'>{{PHONE}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
