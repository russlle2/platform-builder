          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!DOCTYPE html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width, initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} · Services</title>\\n  <meta name='description' content='Clinical, safety-first aromatherapy services including consultations, blend creation, and workplace diffusing.'>\\n  <style>\\n    :root{\\n      --bg1:#f6fbfa; --bg2:#eef7f6; --accent:#6aa39d; --muted:#6b7b7a; --card:#ffffff; --glass:rgba(255,255,255,0.6);\\n      --maxw:1100px; --radius:12px; --shadow:0 6px 18px rgba(15,23,23,0.08);\\n      --pattern-opacity:0.14;\\n    }\\n    *{box-sizing:border-box}\\n    html,body{height:100%}\\n    body{margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial;color:#103033;background:linear-gradient(180deg,var(--bg1),var(--bg2));-webkit-font-smoothing:antialiased}\\n    /* decorative SVG background as DOM element */\\n    .bg-svg{position:fixed;inset:0;z-index:-1;opacity:var(--pattern-opacity);pointer-events:none}\\n    .wrap{max-width:var(--maxw);margin:36px auto;padding:28px}\\n    nav{display:flex;align-items:center;justify-content:space-between;padding:12px 18px;margin-bottom:18px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#81c5bb);display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n    .links{display:flex;gap:14px;align-items:center;color:var(--muted)}\\n    .links a{color:inherit;text-decoration:none;padding:8px}\\n    .cta-btn{background:var(--accent);color:white;padding:10px 14px;border-radius:9px;text-decoration:none}\\n\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;background:linear-gradient(180deg,rgba(255,255,255,0.6),rgba(255,255,255,0.4));padding:28px;border-radius:var(--radius);box-shadow:var(--shadow)}\\n    .hero h1{margin:0 0 8px;font-size:28px;color:#073233}\\n    .hero p{margin:0;color:var(--muted)}\\n    .hero .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 8px 30px rgba(6,18,18,0.04)}\\n\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:20px}\\n    .service{background:var(--card);padding:18px;border-radius:12px;box-shadow:var(--shadow)}\\n    .service h3{margin:0 0 8px;color:#114644}\\n    .service p{margin:0;color:var(--muted);font-size:14px}\\n\\n    .framework{margin-top:22px;display:flex;gap:14px}\\n    .framework .step{flex:1;background:linear-gradient(180deg,white,rgba(255,255,255,0.92));padding:16px;border-radius:10px;box-shadow:0 6px 18px rgba(8,18,18,0.04)}\\n    .framework h4{margin:0 0 6px;color:#165252}\\n\\n    .testimonials{margin-top:28px}\\n    .testimonials .item{background:var(--glass);padding:14px;border-radius:10px;margin-bottom:10px}\\n\\n    .story{margin-top:22px;padding:18px;background:linear-gradient(90deg,rgba(106,163,157,0.06),rgba(129,197,187,0.03));border-radius:12px}\\n\\n    .pricing{margin-top:20px;display:flex;gap:12px}\\n    .price{flex:1;background:var(--card);padding:18px;border-radius:12px;box-shadow:var(--shadow)}\\n\\n    footer.cta{margin-top:28px;padding:18px;text-align:center;border-radius:12px;background:linear-gradient(180deg,rgba(106,163,157,0.08),transparent)}\\n    .muted{color:var(--muted);font-size:13px}\\n\\n    /* responsive */\\n    @media (max-width:900px){\\n      .hero{grid-template-columns:1fr}\\n      .grid{grid-template-columns:repeat(2,1fr)}\\n    }\\n    @media (max-width:560px){.grid{grid-template-columns:1fr}.links{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique SVG background pattern (clinical geometric waves) -->\\n  <svg class='bg-svg' viewBox='0 0 1000 800' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n    <defs>\\n      <linearGradient id='g1' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#e6f6f3'/>\\n        <stop offset='1' stop-color='#f8fffd'/>\\n      </linearGradient>\\n      <pattern id='p1' width='160' height='160' patternUnits='userSpaceOnUse'>\\n        <rect width='160' height='160' fill='url(#g1)'/>\\n        <path d='M0 80 Q40 20 80 80 T160 80' fill='none' stroke='#cdece8' stroke-width='2' stroke-opacity='0.9' />\\n        <circle cx='28' cy='28' r='2' fill='#bfe8e4' />\\n        <circle cx='132' cy='132' r='2' fill='#bfe8e4' />\\n      </pattern>\\n    </defs>\\n    <rect width='100%' height='100%' fill='url(#p1)' opacity='0.95'/>\\n    <g transform='translate(120,40)' opacity='0.12'>\\n      <circle cx='280' cy='160' r='220' fill='none' stroke='#99d5cf' stroke-width='16'/>\\n      <rect x='520' y='40' width='420' height='320' rx='40' fill='none' stroke='#bfe8e4' stroke-width='24'/>\\n    </g>\\n  </svg>\\n\\n  <div class='wrap'>\\n    <nav>\\n      <div class='brand'>\\n        <div class='logo'>A</div>\\n        <div>\\n          <div style='font-weight:700'>{{BUSINESS_NAME}}</div>\\n          <div class='muted' style='font-size:12px'>A clinical approach to sense-led care</div>\\n        </div>\\n      </div>\\n      <div class='links'>\\n        <a href='index.html'>Home</a>\\n        <a href='services.html' aria-current='page'>Offerings</a>\\n        <a href='blends.html'>Blends</a>\\n        <a href='shop.html'>Shop</a>\\n        <a href='pricing.html'>Plans</a>\\n        <a class='cta-btn' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </nav>\\n\\n    <main>\\n      <header class='hero'>\\n        <div>\\n          <h1>Guided aromatherapy services for calm, clarity, and routine integration</h1>\\n          <p class='muted'>Personalized consultations, workplace scenting, and educational workshops delivered with safety-first practice. No medical claims—only evidence-informed aromatherapy care.</p>\\n          <div style='margin-top:12px;display:flex;gap:10px;align-items:center'>\\n            <a class='cta-btn' href='{{PRIMARY_CTA_URL}}'>Book a consultation</a>\\n            <a href='contact.html' style='color:var(--muted);text-decoration:none;padding:8px'>Request workplace info</a>\\n          </div>\\n        </div>\\n        <div class='card'>\\n          <strong style='display:block'>Quick intake</strong>\\n          <p class='muted' style='margin-top:8px'>A structured 20-minute pre-consult screening supports safe recommendations and identifies potential sensitivities. Phone: {{PHONE}}</p>\\n        </div>\\n      </header>\\n\\n      <section class='offers' aria-label='Services offered'>\\n        <div class='grid'>\\n          <div class='service'>\\n            <h3>One-on-one Consultation</h3>\\n            <p>60-minute tailored session including scent history, goals, safety screening, and a custom blend protocol for home use.</p>\\n          </div>\\n          <div class='service'>\\n            <h3>Follow-up Tune-Up</h3>\\n            <p>30-minute check-in to adjust blends, review reactions, and refresh delivery methods for better daily integration.</p>\\n          </div>\\n          <div class='service'>\\n            <h3>Workshop — Practical Aromatherapy</h3>\\n            <p>Small group sessions focusing on safe dilution, patch testing, and hands-on blending for at-home confidence.</p>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section class='framework' aria-label='Framework'>\\n        <div class='step'>\\n          <h4>Assessment</h4>\\n          <p class='muted'>Listening to inhalation preferences, sensitivities, environment, and current routines without making medical claims.</p>\\n        </div>\\n        <div class='step'>\\n          <h4>Formulation</h4>\\n          <p class='muted'>A bespoke blend plan using safe dilution and documented notes for reproducibility at home or work.</p>\\n        </div>\\n        <div class='step'>\\n          <h4>Integration</h4>\\n          <p class='muted'>Practical strategies for delivery, storage, and responsible diffusion with pet and pregnancy considerations.</p>\\n        </div>\\n      </section>\\n\\n      <section class='testimonials' aria-label='Client experiences'>\\n        <div class='item'>\\n          <strong>J.S., {{CITY}}</strong>\\n          <p class='muted' style='margin-top:6px'>'The guided patch test and clear dilution plan helped me use scents safely. I feel more intentional in my routine.' </p>\\n        </div>\\n        <div class='item'>\\n          <strong>M.D., caregiver</strong>\\n          <p class='muted' style='margin-top:6px'>'Workshop was practical and calm—great for teams learning safety basics.' </p>\\n        </div>\\n      </section>\\n\\n      <section class='story' aria-label='Practitioner approach'>\\n        <h3>Why a clinical-calm approach?</h3>\\n        <p class='muted'>Aromatherapy guides sensory habits. My practice centers safety, documentation, and compassion so that scent supports daily life without overreach. We emphasize patch testing, appropriate dilution, and clear guidance for special circumstances such as pregnancy and pet households.</p>\\n      </section>\\n\\n      <section class='pricing' aria-label='Service pricing'>\\n        <div class='price'>\\n          <h4>Initial Consultation</h4>\\n          <div style='font-size:18px;font-weight:700'>$120</div>\\n          <p class='muted'>60 minutes, includes formulation notes and home dilution guide.</p>\\n        </div>\\n        <div class='price'>\\n          <h4>Follow-up</h4>\\n          <div style='font-size:18px;font-weight:700'>$65</div>\\n          <p class='muted'>30 minutes for adjustments and safety checks.</p>\\n        </div>\\n      </section>\\n\\n      <footer class='cta'>\\n        <p style='margin:0;font-weight:600'>Ready to begin a safe, sensory plan with {{PRACTITIONER_NAME}}?</p>\\n        <div style='margin-top:10px'>\\n          <a class='cta-btn' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n          <div class='muted' style='margin-top:8px'>Or call <a href='tel:{{PHONE}}' style='color:inherit;text-decoration:none'>{{PHONE}}</a> • <a href='mailto:{{EMAIL}}' style='color:inherit;text-decoration:none'>{{EMAIL}}</a></div>\\n        </div>\\n      </footer>\\n    </main>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!DOCTYPE html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width, initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} · Blends</title>\\n  <meta name='description' content='A curated collection of aromatic blends with top/middle/base notes, aroma profiles, and safely framed supports statements.'>\\n  <style>\\n    :root{--bg:#fbfdfc;--accent:#4b8f85;--muted:#556c6a;--card:#fff;--radius:12px;--maxw:1100px}\\n    body{margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial;color:#0e2a28;background:linear-gradient(180deg,var(--bg),#f1fbfa)}\\n    .wrap{max-width:var(--maxw);margin:28px auto;padding:20px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    .nav{display:flex;gap:12px}\\n    .nav a{color:var(--muted);text-decoration:none;padding:8px}\\n    .title h1{margin:0;color:#073233}\\n    .intro{color:var(--muted);margin-top:8px}\\n\\n    .pattern-svg{position:fixed;right:0;bottom:0;width:40vw;height:60vh;opacity:0.08;z-index:-1}\\n\\n    .blends{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:20px}\\n    .blend{background:var(--card);padding:14px;border-radius:12px;box-shadow:0 10px 26px rgba(9,20,20,0.04)}\\n    .blend h3{margin:0 0 6px;color:#16524f}\\n    .notes{font-size:13px;color:var(--muted);margin-top:6px}\\n    .supports{margin-top:8px;font-weight:600;color:#214d48}\\n\\n    .notes small{display:block;color:#6b7b7a}\\n    .faq{margin-top:22px;background:linear-gradient(90deg,rgba(75,143,133,0.04),transparent);padding:14px;border-radius:12px}\\n\\n    @media(max-width:880px){.blends{grid-template-columns:1fr}}\\n  </style>\\head>\\n<body>\\n  <svg class='pattern-svg' viewBox='0 0 600 600' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n    <defs>\\n      <linearGradient id='bg2' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#e9fbf8'/>\\n        <stop offset='1' stop-color='#f5fffd'/>\\n      </linearGradient>\\n    </defs>\\n    <rect width='100%' height='100%' fill='url(#bg2)'/>\\n    <g transform='translate(-40,-40)' fill='none' stroke='#aee2db' stroke-width='14' opacity='0.6'>\\n      <path d='M120 300 C220 40 420 40 520 300'/>\\n      <path d='M0 420 C120 180 400 180 560 420'/>\\n    </g>\\n  </svg>\\n\\n  <div class='wrap'>\\n    <header>\\n      <div class='title'>\\n        <h1>Curated blends — measured, mindful, safe</h1>\\n        <div class='intro'>A practical library of blends with clear notes and concise guidance. Always patch test and consult your practitioner for specific needs.</div>\\n      </div>\\n      <nav class='nav'>\\n        <a href='index.html'>Main</a>\\n        <a href='services.html'>Services</a>\\n        <a href='blends.html' aria-current='page'>Blend Library</a>\\n        <a href='shop.html'>Storefront</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class='blends' aria-label='Blend list'>\\n\\n        <article class='blend'>\\n          <h3>Hearth Quiet</h3>\\n          <div class='notes'>Top: Sweet Orange, Bergamot • Middle: Lavender, Roman Chamomile • Base: Cedarwood, Benzoin</div>\\n          <div class='supports'>Aroma profile: gently citrus-herbal; supports evening wind-down and ritualized pause. Safe dilution: 1–2% for topical use. Patch test recommended.</div>\\n        </article>\\n\\n        <article class='blend'>\\n          <h3>Focus Clarify</h3>\\n          <div class='notes'>Top: Lemon, Grapefruit • Middle: Rosemary, Basil • Base: Vetiver</div>\\n          <div class='supports'>Aroma profile: bright-woody; supports situational alertness and clear breathing patterns for task-oriented sessions. Avoid if photosensitivity is a concern.</div>\\n        </article>\\n\\n        <article class='blend'>\\n          <h3>Evening Anchor</h3>\\n          <div class='notes'>Top: Mandarin • Middle: Ylang Ylang, Clary Sage • Base: Sandalwood</div>\\n          <div class='supports'>Aroma profile: soft floral-woody; supports ritual and evening presence; use light diffusion and low-concentration topical blends.</div>\\n        </article>\\n\\n        <article class='blend'>\\n          <h3>Circuit Calm</h3>\\n          <div class='notes'>Top: Spearmint, Litsea • Middle: Lavender • Base: Patchouli</div>\\n          <div class='supports'>Aroma profile: minty-aromatic; supports short-term calming during transitions. Keep distance from eyes and do a patch test before topical use.</div>\\n        </article>\\n\\n        <article class='blend'>\\n          <h3>Morning Ground</h3>\\n          <div class='notes'>Top: Bergamot • Middle: Black Pepper, Cardamom • Base: Frankincense</div>\\n          <div class='supports'>Aroma profile: spicy-citrus; supports ritualized morning routines and gentle centering. Not recommended for young infants or certain pregnancy stages; consult practitioner.</div>\\n        </article>\\n\\n        <article class='blend'>\\n          <h3>Respire Ease</h3>\\n          <div class='notes'>Top: Eucalyptus (small amount), Lemon • Middle: Lavender • Base: Cypress</div>\\n          <div class='supports'>Aroma profile: fresh-camphorous; supports perceived airway clarity for short-term environmental relief. Use low diffusion times and avoid topical application for young children. Not a medical treatment.</div>\\n        </article>\\n\\n        <article class='blend'>\\n          <h3>Cozy Linen</h3>\\n          <div class='notes'>Top: Neroli, Petitgrain • Middle: Lavender • Base: Iso E Super (trace)</div>\\n          <div class='supports'>Aroma profile: soft floral; supports restful impressions when used as a light linen mist at safe dilution. Patch test fabric and skin.</div>\\n        </article>\\n\\n        <article class='blend'>\\n          <h3>Uplift Circuit</h3>\\n          <div class='notes'>Top: Sweet Orange, Bergamot • Middle: Geranium • Base: Atlas Cedar</div>\\n          <div class='supports'>Aroma profile: bright-floral-woody; supports perceptual uplift and social setting presence. Use moderation in shared spaces and check for sensitivities.</div>\\n        </article>\\n\\n        <article class='blend'>\\n          <h3>Semiotic Balance</h3>\\n          <div class='notes'>Top: Lemon Verbena • Middle: Rosemary • Base: Hemlock-like resin (trace)</div>\\n          <div class='supports'>Aroma profile: herbaceous-resinous; supports cognitive ritual practices. Keep dilution low; practice patch testing and storage in a cool place.</div>\\n        </article>\\n\\n        <article class='blend'>\\n          <h3>Sleep Cradle</h3>\\n          <div class='notes'>Top: Mandarin • Middle: Roman Chamomile • Base: Vetiver, Benzoin</div>\\n          <div class='supports'>Aroma profile: sweet-warm-woody; supports bedtime routines. For topical use, remain within 1% dilution for adults; avoid direct infant exposure via topical application or strong diffusion.</div>\\n        </article>\\n\\n      </section>\\n\\n      <section class='faq' aria-label='Blends FAQ'>\\n        <h4>Safety & FAQ</h4>\\n        <p class='muted'><strong>Dilution</strong>: We recommend 1–3% for adult topical use unless otherwise advised. Children and sensitive adults often require lower dilutions. Use precise measurements (mL) not drops when possible.</p>\\n        <p class='muted'><strong>Patch test</strong>: Apply a small 0.5 mL of diluted blend to inner forearm and check at 24 hours for irritation. Discontinue if redness or discomfort occurs.</p>\\n        <p class='muted'><strong>Pets</strong>: Many essential oils are irritants to animals. Keep diffusion brief, provide escape routes, and avoid direct topical use on pets. Consult a veterinarian.</p>\\n        <p class='muted'><strong>Pregnancy</strong>: Some oils are not recommended in pregnancy. Please consult healthcare providers and disclose pregnancy status before topical or aromatherapy use.</p>\\n      </section>\\n\\n      <footer style='margin-top:18px;display:flex;justify-content:space-between;align-items:center'>\\n        <div class='muted'>Looking for {{FAVORITE_BLEND}} or a custom formulation? Book a session with {{PRACTITIONER_NAME}}.</div>\\n        <div><a href='{{PRIMARY_CTA_URL}}' style='background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none'>Book consult</a></div>\\n      </footer>\\n    </main>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!DOCTYPE html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width, initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} · Shop</title>\\n  <meta name='description' content='Shop essentials: starter kits, roll-ons, diffusers, and educational materials with safety tips included.'>\\n  <style>\\n    :root{--bg:#fbfefc;--accent:#2f7c75;--muted:#556b6a;--card:#fff;--radius:12px}\\n    body{margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial;background:linear-gradient(180deg,var(--bg),#eefaf8);color:#072a29}\\n    .wrap{max-width:1100px;margin:28px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav{display:flex;gap:12px}\\n    nav a{color:var(--muted);text-decoration:none}\\n\\n    .hero{margin-top:16px;padding:18px;border-radius:12px;background:linear-gradient(90deg,rgba(47,124,117,0.06),transparent)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .card{background:var(--card);padding:14px;border-radius:12px;box-shadow:0 10px 24px rgba(6,18,18,0.04)}\\n    .card img{width:100%;height:140px;object-fit:cover;border-radius:8px;background:linear-gradient(180deg,#f4fbfa,#e9f6f3)}\\n    .price{font-weight:700;color:#043432;margin-top:8px}\\n    .muted{color:var(--muted);font-size:13px}\\n\\n    .faq{margin-top:20px;padding:14px;border-radius:12px;background:linear-gradient(180deg,rgba(47,124,117,0.04),transparent)}\\n\\n    @media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}\\n    @media(max-width:560px){.grid{grid-template-columns:1fr};nav{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <!-- slender decorative wave -->\\n  <svg style='position:fixed;left:0;top:0;width:45vw;height:36vh;opacity:0.06;z-index:-1' viewBox='0 0 600 400' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n    <defs>\\n      <linearGradient id='sg' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#e8fbf8'/>\\n        <stop offset='1' stop-color='#ffffff'/>\\n      </linearGradient>\\n    </defs>\\n    <path d='M0 200 C150 50 450 350 600 150 L600 0 L0 0 Z' fill='url(#sg)' />\\n  </svg>\\n\\n  <div class='wrap'>\\n    <header>\\n      <div>\\n        <h1>Shop — thoughtful kits and delivery options</h1>\\n        <div class='muted'>Browse starter kits, single roll-ons, and clinical diffusers. All product descriptions include safe-use notes.</div>\\n      </div>\\n      <nav>\\n        <a href='index.html'>Home</a>\\n        <a href='blends.html'>Library</a>\\n        <a href='services.html'>Services</a>\\n        <a href='contact.html'>Contact</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class='hero'>\\n        <strong>Safety reminder:</strong>\\n        <span class='muted' style='margin-left:8px'>Products are not a substitute for medical care. Review dilution guidance and consult if pregnant or managing sensitivities. See FAQ below.</span>\\n      </section>\\n\\n      <section class='grid' aria-label='Products'>\\n        <article class='card'>\\n          <div style='display:flex;justify-content:space-between;align-items:center'>\\n            <div style='font-weight:700'>Starter Kit — Home</div>\\n            <div class='price'>$48</div>\\n          </div>\\n          <div style='height:10px'></div>\\n          <img alt='kit image placeholder' src='data:image/svg+xml;utf8,<svg xmlns=%27http://www.w3.org/2000/svg%27 width=%27300%27 height=%27140%27><rect width=%27100%25%27 height=%27100%25%27 fill=%27%23e9f8f5%27/><text x=%2750%25%27 y=%2750%25%27 dominant-baseline=%27middle%27 text-anchor=%27middle%27 fill=%27%237a9e99%27 font-size=%2714%27>Starter Kit</text></svg>'/>\\n          <div class='muted' style='margin-top:8px'>Includes 3 single oils, dilution cards, and a roller bottle. Clear labeling and safe-use instructions included.</div>\\n          <div style='margin-top:10px'><button style='background:var(--accent);color:white;border:none;padding:8px 12px;border-radius:8px'>Add to cart</button></div>\\n        </article>\\n\\n        <article class='card'>\\n          <div style='display:flex;justify-content:space-between;align-items:center'>\\n            <div style='font-weight:700'>Calm Roll-On</div>\\n            <div class='price'>$18</div>\\n          </div>\\n          <div style='height:10px'></div>\\n          <img alt='roll-on' src='data:image/svg+xml;utf8,<svg xmlns=%27http://www.w3.org/2000/svg%27 width=%27300%27 height=%27140%27><rect width=%27100%25%27 height=%27100%25%27 fill=%27%23f6fbfa%27/><text x=%2750%25%27 y=%2750%25%27 dominant-baseline=%27middle%27 text-anchor=%27middle%27 fill=%27%237a9e99%27 font-size=%2714%27>Roll-on</text></svg>'/>\\n          <div class='muted' style='margin-top:8px'>Pre-diluted 1.5% blend in fractionated coconut oil. Intended for adult wrist/neck use only. Patch test before use.</div>\\n          <div style='margin-top:10px'><button style='background:var(--accent);color:white;border:none;padding:8px 12px;border-radius:8px'>Add to cart</button></div>\\n        </article>\\n\\n        <article class='card'>\\n          <div style='display:flex;justify-content:space-between;align-items:center'>\\n            <div style='font-weight:700'>Mini Diffuser</div>\\n            <div class='price'>$36</div>\\n          </div>\\n          <div style='height:10px'></div>\\n          <img alt='diffuser' src='data:image/svg+xml;utf8,<svg xmlns=%27http://www.w3.org/2000/svg%27 width=%27300%27 height=%27140%27><rect width=%27100%25%27 height=%27100%25%27 fill=%27%23eef8f6%27/><text x=%2750%25%27 y=%2750%25%27 dominant-baseline=%27middle%27 text-anchor=%27middle%27 fill=%27%237a9e99%27 font-size=%2714%27>Diffuser</text></svg>'/>\\n          <div class='muted' style='margin-top:8px'>USB diffuser with 30-min and 60-min timer. Low-mist output suitable for shared spaces when used responsibly.</div>\\n          <div style='margin-top:10px'><button style='background:var(--accent);color:white;border:none;padding:8px 12px;border-radius:8px'>Add to cart</button></div>\\n        </article>\\n\\n        <article class='card'>\\n          <div style='display:flex;justify-content:space-between;align-items:center'>\\n            <div style='font-weight:700'>Workplace Diffuser Kit</div>\\n            <div class='price'>$150</div>\\n          </div>\\n          <div style='height:10px'></div>\\n          <img alt='work kit' src='data:image/svg+xml;utf8,<svg xmlns=%27http://www.w3.org/2000/svg%27 width=%27300%27 height=%27140%27><rect width=%27100%25%27 height=%27100%25%27 fill=%27%23f3fbfa%27/><text x=%2750%25%27 y=%2750%25%27 dominant-baseline=%27middle%27 text-anchor=%27middle%27 fill=%27%237a9e99%27 font-size=%2714%27>Work Kit</text></svg>'/>\\n          <div class='muted' style='margin-top:8px'>Includes commercial-grade diffuser and a set of 4 low-concentration blends with workplace safety notes. Consultation recommended before installation.</div>\\n          <div style='margin-top:10px'><button style='background:var(--accent);color:white;border:none;padding:8px 12px;border-radius:8px'>Request setup</button></div>\\n        </article>\\n\\n        <article class='card'>\\n          <div style='display:flex;justify-content:space-between;align-items:center'>\\n            <div style='font-weight:700'>Roll-On Trio Pack</div>\\n            <div class='price'>$45</div>\\n          </div>\\n          <div style='height:10px'></div>\\n          <img alt='trio' src='data:image/svg+xml;utf8,<svg xmlns=%27http://www.w3.org/2000/svg%27 width=%27300%27 height=%27140%27><rect width=%27100%25%27 height=%27100%25%27 fill=%27%23f8fffd%27/><text x=%2750%25%27 y=%2750%25%27 dominant-baseline=%27middle%27 text-anchor=%27middle%27 fill=%27%237a9e99%27 font-size=%2714%27>Trio</text></svg>'/>\\n          <div class='muted' style='margin-top:8px'>Three 10 mL roll-ons at 1–2% dilution. Labeled for adult use; keep away from children and pets.</div>\\n          <div style='margin-top:10px'><button style='background:var(--accent);color:white;border:none;padding:8px 12px;border-radius:8px'>Add to cart</button></div>\\n        </article>\\n\\n        <article class='card'>\\n          <div style='display:flex;justify-content:space-between;align-items:center'>\\n            <div style='font-weight:700'>Educational Pack</div>\\n            <div class='price'>$22</div>\\n          </div>\\n          <div style='height:10px'></div>\\n          <img alt='booklet' src='data:image/svg+xml;utf8,<svg xmlns=%27http://www.w3.org/2000/svg%27 width=%27300%27 height=%27140%27><rect width=%27100%25%27 height=%27100%25%27 fill=%27%23f7fff9%27/><text x=%2750%25%27 y=%2750%25%27 dominant-baseline=%27middle%27 text-anchor=%27middle%27 fill=%27%237a9e99%27 font-size=%2714%27>Guide</text></svg>'/>\\n          <div class='muted' style='margin-top:8px'>A pocket guide: dilution charts, patch testing steps, pet and pregnancy notes, and a safety checklist for storage and labeling.</div>\\n          <div style='margin-top:10px'><button style='background:var(--accent);color:white;border:none;padding:8px 12px;border-radius:8px'>Add to cart</button></div>\\n        </article>\\n\\n      </section>\\n\\n      <section class='faq' aria-label='Shop FAQ'>\\n        <h3>Common product questions</h3>\\n        <p class='muted'><strong>Dilution:</strong> Bottled roll-ons are pre-diluted and labeled. For DIY, use 1%–3% for adults. Lower concentrations for older adults and children.</p>\\n        <p class='muted'><strong>Patch test:</strong> Always patch test new products before widespread topical use. Apply a small amount to inner forearm and check at 24 hours.</p>\\n        <p class='muted'><strong>Pets:</strong> Many essential oils can cause irritation in animals. Use diffusers sparingly in pet areas, keep products out of reach, and never apply human blends directly to animals.</p>\\n        <p class='muted'><strong>Pregnancy & breastfeeding:</strong> Some oils are contraindicated. If pregnant or breastfeeding, consult your healthcare provider before use and share ingredient lists with them.</p>\\n      </section>\\n\\n      <footer style='margin-top:20px;display:flex;justify-content:space-between;align-items:center'>\\n        <div class='muted'>Questions about a product or need help assembling a kit? Email <a href='mailto:{{EMAIL}}' style='color:inherit;text-decoration:none'>{{EMAIL}}</a> or call <a href='tel:{{PHONE}}' style='color:inherit;text-decoration:none'>{{PHONE}}</a>.</div>\\n        <div><a href='{{PRIMARY_CTA_URL}}' style='background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none'>{{PRIMARY_CTA_LABEL}}</a></div>\\n      </footer>\\n    </main>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
