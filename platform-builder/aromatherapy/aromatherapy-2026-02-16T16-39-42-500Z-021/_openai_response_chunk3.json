          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Rates &amp; Packages — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#f6fbf9;--bg2:#eef7f3;--accent:#7fbfa3;--muted:#6b6b6b;--card:#ffffff;--glass:rgba(255,255,255,0.6)}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;line-height:1.45;color:#123;}\\n    body{background:\\n      radial-gradient(circle at 10% 10%, rgba(127,191,163,0.08), transparent 12%),\\n      linear-gradient(180deg,var(--bg1),var(--bg2));\\n      background-image: url('/assets/img/pattern.svg'), linear-gradient(180deg,var(--bg1),var(--bg2));\\n      background-blend-mode:overlay; padding:32px;}\\n    header{display:flex;align-items:center;justify-content:space-between;max-width:1100px;margin:0 auto;padding:12px 0}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#a7d5c1);display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n    nav a{margin:0 8px;color:#234;padding:8px 10px;text-decoration:none;border-radius:8px;font-size:14px}\\n    nav a.cta{background:transparent;border:1px solid rgba(18,51,60,0.08);padding:8px 12px}\\n    main{max-width:1100px;margin:20px auto;padding:28px;background:linear-gradient(180deg,rgba(255,255,255,0.6),rgba(255,255,255,0.8));backdrop-filter: blur(6px);border-radius:14px}\\n    .hero{display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:center}\\n    .hero h1{margin:0;font-size:28px;color:#083;letter-spacing:-0.02em}\\n    .muted{color:var(--muted);margin-top:8px}\\n    .cta-btn{display:inline-block;background:linear-gradient(90deg,var(--accent),#95d0b8);color:#053;padding:12px 16px;border-radius:10px;text-decoration:none;font-weight:600;margin-top:12px}\\n    .price-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:20px}\\n    .card{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 6px 18px rgba(15,30,20,0.06)}\\n    .card h3{margin:0 0 8px 0}\\n    .price{font-size:20px;font-weight:700;color:#045}\\n    .small{font-size:13px;color:var(--muted)}\\n    .features{margin-top:10px;padding-left:14px}\\n    .faq{margin-top:22px}\\n    .faq dt{font-weight:700;margin-top:12px}\\n    .footer{margin-top:28px;padding-top:18px;border-top:1px dashed rgba(20,40,30,0.06);display:flex;justify-content:space-between;align-items:center}\\n    @media(max-width:820px){.hero{grid-template-columns:1fr;}.brand{gap:8px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"small\\\">{{CITY}}, {{STATE}} — aromatherapy care</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Welcome</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Shop</a>\\n      <a href=\\\"pricing.html\\\" class=\\\"cta\\\">Investment</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\">Schedule</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Transparent rates for thoughtful aromatherapy</h1>\\n        <p class=\\\"muted\\\">We support sensory wellness through safe, evidence-aware essential oil use. Pricing is clear; care is attentive. Sessions are not a substitute for medical care.</p>\\n        <a class=\\\"cta-btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n      <aside class=\\\"card\\\">\\n        <h3>Quick note</h3>\\n        <p class=\\\"small\\\">Hybrid model: offered in-person and virtually. Initial consults include safety screening and a recommended dilution. Patch testing and pet-safe guidance are included where relevant.</p>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"price-cards\\\" aria-label=\\\"Pricing options\\\">\\n      <article class=\\\"card\\\">\\n        <h3>Discovery Session</h3>\\n        <div class=\\\"price\\\">$60</div>\\n        <div class=\\\"small\\\">30 minutes — ideal to explore needs and next steps</div>\\n        <ul class=\\\"features small\\\">\\n          <li>Brief history &amp; safety screening</li>\\n          <li>Intro to topical and inhalation best practices</li>\\n          <li>Personalized next-step recommendation</li>\\n        </ul>\\n      </article>\\n\\n      <article class=\\\"card\\\">\\n        <h3>Virtual Consultation</h3>\\n        <div class=\\\"price\\\">$120</div>\\n        <div class=\\\"small\\\">60 minutes — client education, aroma plan, Q&amp;A</div>\\n        <ul class=\\\"features small\\\">\\n          <li>Detailed safety guidance (dilution, patch test)</li>\\n          <li>Suggested blends &amp; usage instructions</li>\\n          <li>Follow-up notes by email</li>\\n        </ul>\\n      </article>\\n\\n      <article class=\\\"card\\\">\\n        <h3>In-person Session</h3>\\n        <div class=\\\"price\\\">$140</div>\\n        <div class=\\\"small\\\">75 minutes — hands-on blend testing &amp; consultation</div>\\n        <ul class=\\\"features small\\\">\\n          <li>In-clinic aroma sampling with proper ventilation</li>\\n          <li>Topical demonstration &amp; dilution guidance</li>\\n          <li>Custom roller or sample to take home</li>\\n        </ul>\\n      </article>\\n\\n      <article class=\\\"card\\\">\\n        <h3>Custom Blend Design</h3>\\n        <div class=\\\"price\\\">$90</div>\\n        <div class=\\\"small\\\">45 minutes — bespoke blend creation</div>\\n        <ul class=\\\"features small\\\">\\n          <li>Safety-forward formulation (allergies, pets, pregnancy notes)</li>\\n          <li>Labeling and usage instructions</li>\\n          <li>One complimentary 10ml roller</li>\\n        </ul>\\n      </article>\\n\\n      <article class=\\\"card\\\">\\n        <h3>Wellness Plan</h3>\\n        <div class=\\\"price\\\">$360</div>\\n        <div class=\\\"small\\\">Three-session package — discounted ongoing support</div>\\n        <ul class=\\\"features small\\\">\\n          <li>Personalized sequence of blends and education</li>\\n          <li>Priority booking</li>\\n          <li>Email check-ins between sessions</li>\\n        </ul>\\n      </article>\\n\\n      <article class=\\\"card\\\">\\n        <h3>Product Consult</h3>\\n        <div class=\\\"price\\\">$25</div>\\n        <div class=\\\"small\\\">15 minutes — help choosing items from the shop</div>\\n        <ul class=\\\"features small\\\">\\n          <li>Pet- & family-safety review</li>\\n          <li>Suggested dilutions for topical products</li>\\n        </ul>\\n      </article>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3>Practical safety FAQ</h3>\\n      <dl>\\n        <dt>What dilution do you recommend?</dt>\\n        <dd class=\\\"small\\\">Dilution varies by age, skin sensitivity, and intended use. Typical topical dilutions range from 0.5–3% for adults; we will provide tailored dilution guidance during consultations. Never apply undiluted essential oils to skin.</dd>\\n\\n        <dt>How do I perform a patch test?</dt>\\n        <dd class=\\\"small\\\">Apply the recommended diluted blend to a small forearm area and observe for 24 hours. If redness, itching, or irritation occurs, discontinue use and consult your healthcare provider.</dd>\\n\\n        <dt>Are essential oils safe around pets?</dt>\\n        <dd class=\\\"small\\\">Some oils can be harmful to animals. We provide pet-safe alternatives and usage recommendations. Diffuse cautiously, ensure ventilation, and never force exposure on an animal.</dd>\\n\\n        <dt>Pregnancy and nursing considerations?</dt>\\n        <dd class=\\\"small\\\">Certain oils are contraindicated in pregnancy. If pregnant or breastfeeding, let us know during booking so we can recommend appropriate, safety-focused options.</dd>\\n      </dl>\\n    </section>\\n\\n    <div class=\\\"footer\\\">\\n      <div class=\\\"small\\\">Questions? Call <strong>{{PHONE}}</strong> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div class=\\\"small\\\">Payments accepted: card, Apple Pay, Google Pay</div>\\n    </div>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfdfa;--accent:#8bc8a4;--ink:#0b2b2a;--muted:#677;--card:#fff}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial;background:linear-gradient(180deg,var(--bg),#eef8f5);color:var(--ink);padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center;max-width:1100px;margin:0 auto;padding-bottom:12px}\\n    .logoSmall{width:48px;height:48px;border-radius:10px;background:linear-gradient(45deg,var(--accent),#b9e6cf);display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n    nav a{margin-left:10px;color:var(--ink);text-decoration:none;padding:6px}\\n    main{max-width:1000px;margin:18px auto;background:linear-gradient(180deg,rgba(255,255,255,0.9),rgba(255,255,255,0.95));border-radius:14px;padding:22px;box-shadow:0 8px 20px rgba(10,20,18,0.05)}\\n    .lead{display:flex;gap:20px;align-items:flex-start}\\n    .lead h1{margin:0;font-size:26px}\\n    .bio{margin-top:12px;color:var(--muted)}\\n    .framework{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:18px}\\n    .pill{background:var(--card);padding:12px;border-radius:10px;box-shadow:0 6px 14px rgba(6,20,18,0.04)}\\n    .testimonial{margin-top:18px;padding:14px;border-left:3px solid var(--accent);background:rgba(139,200,164,0.04);border-radius:8px}\\n    .cta{display:inline-block;margin-top:14px;background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:600}\\n    footer{margin-top:22px;color:var(--muted);font-size:13px}\\n    @media(max-width:760px){.framework{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logoSmall\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">A mindful aromatherapy practice</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Aromas</a>\\n      <a href=\\\"shop.html\\\">Store</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Reach</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"lead\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1>About the practice</h1>\\n        <p class=\\\"bio\\\">Founded and led by {{PRACTITIONER_NAME}}, {{BUSINESS_NAME}} offers evidence-aware aromatherapy rooted in safety and person-centered care. We use essential oils thoughtfully: as sensory tools to enhance daily rituals and support wellbeing without medical claims.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a consultation</a>\\n      </div>\\n      <aside style=\\\"width:260px;padding:12px;background:linear-gradient(180deg,#fff,rgba(255,255,255,0.9));border-radius:12px;box-shadow:0 6px 16px rgba(10,20,18,0.05)\\\">\\n        <strong>Location</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">{{CITY}}, {{STATE}}</div>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Contact: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n        <div class=\\\"small\\\">Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin:0 0 10px 0\\\">An integrative framework</h2>\\n      <p class=\\\"small\\\">Our approach blends clinical attention and sensory practice. Each client receives a tailored plan that emphasizes safety, education, and practical use.</p>\\n\\n      <div class=\\\"framework\\\">\\n        <div class=\\\"pill\\\">\\n          <h4>1. Assess</h4>\\n          <p class=\\\"small\\\">Comprehensive intake covering history, household, pets, pregnancy, and sensitivities.</p>\\n        </div>\\n        <div class=\\\"pill\\\">\\n          <h4>2. Co‑create</h4>\\n          <p class=\\\"small\\\">Collaborative blend design with clear dilution and patch-test instructions.</p>\\n        </div>\\n        <div class=\\\"pill\\\">\\n          <h4>3. Integrate</h4>\\n          <p class=\\\"small\\\">Practical usage plans for daily routines, emotional regulation, and product selection.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <h2>Professional training &amp; ethics</h2>\\n      <p class=\\\"small\\\">{{PRACTITIONER_NAME}} trained in clinical aromatherapy, focusing on safety-forward education. Services avoid therapeutic claims and emphasize collaboration with healthcare providers when relevant.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2>Client perspectives</h2>\\n      <div class=\\\"testimonial\\\">\\n        \\\"Gentle, knowledgeable, and practical. I learned safe ways to use aromas in my home. The custom roller has become part of my evening routine.\\\" — L.R.\\n      </div>\\n      <div class=\\\"testimonial\\\">\\n        \\\"Clear guidance on pets and patch tests saved me a lot of worry. The virtual consult was thorough and supportive.\\\" — M.T.\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2>What we offer</h2>\\n      <p class=\\\"small\\\">Sessions, custom blends, product guidance, and small-group workshops. We operate hybridly—both in-person appointments in {{CITY}} and remote consultations.</p>\\n      <a class=\\\"cta\\\" href=\\\"book.html\\\">Schedule — {{PRIMARY_CTA_LABEL}}</a>\\n    </section>\\n\\n    <footer>\\n      <p class=\\\"small\\\">If you have questions about suitability (pregnancy, medications, pets), call <strong>{{PHONE}}</strong> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</p>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a Session — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f7fbfa;--accent:#6db08d;--ink:#062b2a;--muted:#667}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;background:linear-gradient(180deg,var(--bg),#eef8f5);color:var(--ink);padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center;max-width:1100px;margin:0 auto;padding-bottom:12px}\\n    nav a{margin-left:10px;color:var(--ink);text-decoration:none}\\n    main{max-width:980px;margin:18px auto;background:white;border-radius:12px;padding:18px;box-shadow:0 8px 22px rgba(6,18,14,0.05)}\\n    h1{margin:0 0 6px 0}\\n    .grid{display:grid;grid-template-columns:1fr 380px;gap:18px}\\n    form{display:flex;flex-direction:column;gap:10px}\\n    input,textarea,select{padding:10px;border-radius:8px;border:1px solid #e6efe9;font-size:15px}\\n    label{font-size:13px;color:var(--muted)}\\n    button{background:linear-gradient(90deg,var(--accent),#95d0b8);border:none;padding:12px;border-radius:10px;color:white;font-weight:700}\\n    .policies{font-size:13px;color:var(--muted)}\\n    .note{background:rgba(109,176,141,0.06);padding:10px;border-radius:8px;border-left:3px solid var(--accent)}\\n    footer{margin-top:14px;font-size:13px;color:var(--muted)}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">Treatments</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Boutique</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"about.html\\\">Who We Are</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <h1>Book a session</h1>\\n    <p class=\\\"policies\\\">Choose an appointment type and share a few details. We'll confirm availability and any pre-visit screening. Sessions are educational and supportive; they do not replace medical advice.</p>\\n\\n    <div class=\\\"grid\\\">\\n      <section>\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\">\\n          <div>\\n            <label for=\\\"name\\\">Full name</label>\\n            <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"First Last\\\" required>\\n          </div>\\n\\n          <div>\\n            <label for=\\\"email\\\">Email</label>\\n            <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n          </div>\\n\\n          <div>\\n            <label for=\\\"phone\\\">Phone</label>\\n            <input id=\\\"phone\\\" name=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"(555) 555-5555\\\">\\n          </div>\\n\\n          <div>\\n            <label for=\\\"service\\\">Service</label>\\n            <select id=\\\"service\\\" name=\\\"service\\\">\\n              <option>Discovery Session — 30 min</option>\\n              <option>Virtual Consultation — 60 min</option>\\n              <option>In-person Session — 75 min</option>\\n              <option>Custom Blend Design — 45 min</option>\\n              <option>Wellness Plan — 3 sessions</option>\\n              <option>Product Consult — 15 min</option>\\n            </select>\\n          </div>\\n\\n          <div>\\n            <label for=\\\"date\\\">Preferred date &amp; time</label>\\n            <input id=\\\"date\\\" name=\\\"date\\\" type=\\\"text\\\" placeholder=\\\"e.g. 2026-03-15 morning\\\">\\n          </div>\\n\\n          <div>\\n            <label for=\\\"notes\\\">Notes (sensitivities, pets, pregnancy)</label>\\n            <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Mention medications, pregnancies, pets, known sensitivities\\\"></textarea>\\n          </div>\\n\\n          <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n            <input id=\\\"consent\\\" name=\\\"consent\\\" type=\\\"checkbox\\\" required>\\n            <label for=\\\"consent\\\" style=\\\"font-size:13px\\\">I understand this service provides aromatherapy education and is not medical care.</label>\\n          </div>\\n\\n          <button type=\\\"submit\\\">Request appointment</button>\\n        </form>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"note\\\">\\n          <strong>Before your visit</strong>\\n          <p class=\\\"policies\\\">We will send a short intake to screen for allergies, pregnancy, medication interactions, and pet exposure. If you are pregnant, breastfeeding, or have serious health conditions, please inform us so we can adapt safely.</p>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:6px 0\\\">Scheduling &amp; cancellation</h4>\\n          <p class=\\\"policies\\\">Please allow up to 48 hours for confirmations. Cancellations within 24 hours may incur a fee. Rescheduling depends on availability.</p>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:6px 0\\\">Safety reminders</h4>\\n          <ul class=\\\"policies\\\">\\n            <li>Always dilute essential oils for topical use as instructed.</li>\\n            <li>Perform a patch test before regular topical use.</li>\\n            <li>Some oils are unsafe for pets and pregnancy — we will advise alternatives.</li>\\n          </ul>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:6px 0\\\">Need help?</h4>\\n          <p class=\\\"policies\\\">Call <strong>{{PHONE}}</strong> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> for urgent scheduling questions.</p>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;font-size:13px;color:var(--muted)\\\">\\n          <strong>Clinic hours</strong>\\n          <div>Mon–Fri: 9am–5pm (appointments by arrangement)</div>\\n          <div>Sessions offered in-person in {{CITY}} or virtually.</div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer>\\n      <p class=\\\"policies\\\">If you have questions about suitability (pregnancy, medications, pets), include them in the \\\"Notes\\\" field or call <strong>{{PHONE}}</strong>. We will follow up with safety guidance and next steps.</p>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
