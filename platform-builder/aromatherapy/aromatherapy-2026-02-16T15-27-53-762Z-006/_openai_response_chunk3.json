          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n<meta charset='utf-8'>\\n<title>{{BUSINESS_NAME}} — Investment & Packages</title>\\n<meta name='viewport' content='width=device-width,initial-scale=1'>\\n<style>\\n:root{--bg:#f6fbfb;--card:#ffffff;--ink:#0f1720;--muted:#6b7280;--accent1:#7cc7b6;--accent2:#8fbdd6;--glass:rgba(255,255,255,0.6)}\\n*{box-sizing:border-box}\\nhtml,body{height:100%}\\nbody{margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;color:var(--ink);background:linear-gradient(180deg,var(--bg),#eef8f7);-webkit-font-smoothing:antialiased}\\n.pattern{position:fixed;inset:0;z-index:0;opacity:0.14;pointer-events:none}\\n.container{position:relative;z-index:2;max-width:1100px;margin:2.5rem auto;padding:2rem}\\n.header{display:flex;align-items:center;justify-content:space-between;gap:1rem}\\n.brand{display:flex;align-items:center;gap:.75rem}\\n.logo{width:56px;height:56px;border-radius:10px;background:linear-gradient(135deg,var(--accent1),var(--accent2));display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n.nav{display:flex;gap:1rem;font-size:.95rem}\\n.nav a{color:var(--muted);text-decoration:none;padding:.35rem .6rem;border-radius:8px}\\n.nav a[href='pricing.html']{background:var(--glass);color:var(--ink)}\\n.hero{margin-top:1.6rem;padding:1.6rem;border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,0.85),rgba(250,255,255,0.8));box-shadow:0 8px 30px rgba(12,18,20,0.06);display:grid;grid-template-columns:1fr 320px;gap:1rem}\\n.hero h1{margin:0;font-size:1.5rem}\\n.lead{color:var(--muted);margin-top:.45rem}\\n.cta-btn{display:inline-block;margin-top:1rem;background:linear-gradient(90deg,var(--accent1),var(--accent2));color:white;padding:.6rem 1rem;border-radius:10px;text-decoration:none}\\n.tiers{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;margin-top:1.2rem}\\n.card{background:var(--card);padding:1rem;border-radius:12px;box-shadow:0 6px 18px rgba(12,18,20,0.05)}\\n.card h3{margin:.2rem 0}\\n.price{font-weight:700;font-size:1.2rem;color:var(--accent1)}\\n.features{color:var(--muted);font-size:.95rem;margin-top:.5rem}\\n.small{font-size:.88rem;color:var(--muted)}\\n.section-title{display:flex;align-items:center;gap:.6rem;margin-top:1.6rem}\\n.rule{height:1px;background:linear-gradient(90deg,transparent,var(--accent2),transparent);flex:1}\\n.pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:1rem}\\n.pillar{background:linear-gradient(180deg,rgba(255,255,255,0.9),#fff);padding:1rem;border-radius:10px}\\n.myths{margin-top:1rem}\\n.myth{background:linear-gradient(90deg,rgba(143,189,214,0.06),rgba(124,199,182,0.03));padding:1rem;border-radius:10px;margin-bottom:.7rem}\\n.case{margin-top:1rem;padding:1rem;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.9),#fff);box-shadow:0 6px 16px rgba(12,18,20,0.04)}\\n.faq{margin-top:1rem}\\n.q{background:var(--card);padding:1rem;border-radius:10px;margin-bottom:.6rem}\\n.footer{margin-top:2rem;padding:1rem;border-radius:8px;text-align:center;color:var(--muted);font-size:.9rem}\\n@media (max-width:800px){.hero{grid-template-columns:1fr}.pillars{grid-template-columns:1fr}.nav{display:none}}\\n</style>\\n</head>\\n<body>\\n<!-- SVG pattern: unique radial grid with gentle curves -->\\n<svg class='pattern' width='100%' height='100%' xmlns='http://www.w3.org/2000/svg' preserveAspectRatio='none'>\\n<defs>\\n<linearGradient id='g1' x1='0' x2='1'>\\n<stop offset='0' stop-color='#7cc7b6'/>\\n<stop offset='1' stop-color='#8fbdd6'/>\\n</linearGradient>\\n</defs>\\n<rect width='100%' height='100%' fill='none'/>\\n<g fill='none' stroke='url(#g1)' stroke-opacity='0.12' stroke-width='1'>\\n<path d='M0,40 Q150,80 300,40 T600,40 T900,40' />\\n<path d='M0,120 Q150,160 300,120 T600,120 T900,120' />\\n<path d='M0,200 Q150,240 300,200 T600,200 T900,200' />\\n</g>\\n</svg>\\n\\n<div class='container'>\\n<header class='header'>\\n<div class='brand'>\\n<div class='logo'>A</div>\\n<div>\\n<div style='font-weight:700'>{{BUSINESS_NAME}}</div>\\n<div class='small'>{{TAGLINE}}</div>\\n</div>\\n</div>\\n<nav class='nav'>\\n<a href='index.html'>Home</a>\\n<a href='services.html'>Offerings</a>\\n<a href='blends.html'>Blends</a>\\n<a href='shop.html'>Shop</a>\\n<a href='pricing.html'>Invest</a>\\n<a href='about.html'>About</a>\\n<a href='book.html'>Reserve</a>\\n<a href='contact.html'>Contact</a>\\n</nav>\\n</header>\\n\\n<section class='hero'>\\n<div>\\n<h1>Clear, careful aromatherapy sessions — pricing that reflects safety and customization</h1>\\n<p class='lead'>Hybrid sessions and bespoke blends. Packages support short-term experiments and ongoing protocols without clinical claims.</p>\\n<a class='cta-btn' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n<div class='small' style='margin-top:1rem'>Teleconsultations and in-person options available in {{CITY}}, {{STATE}}. Phone: {{PHONE}}</div>\\n</div>\\n<aside>\\n<div class='card'>\\n<h3>Quick booking</h3>\\n<p class='small'>30–45 minute check-in or full 75–90 minute consults. Add a tailored blend or at-home protocol.</p>\\n<div style='margin-top:1rem'>\\n<div class='small'>Next available</div>\\n<div style='font-weight:700;margin-top:.4rem'>Week of next business day</div>\\n<a class='cta-btn' href='book.html' style='display:inline-block;margin-top:.6rem'>Reserve a slot</a>\\n</div>\\n</div>\\n</aside>\\n</section>\\n\\n<section id='pricing' class='section'>\\n<div class='section-title'><div class='rule'></div><h3>Packages & Rates</h3><div class='rule'></div></div>\\n<div class='tiers'>\\n<div class='card'>\\n<h3>Intro Consult</h3>\\n<div class='price'>$75</div>\\n<div class='features'>30–45 min, intake review, safety screening, basic aroma plan</div>\\n<div class='small' style='margin-top:.6rem'>Best for first-time clients or focused questions.</div>\\n</div>\\n<div class='card'>\\n<h3>Standard Session</h3>\\n<div class='price'>$140</div>\\n<div class='features'>75 min, personalized blend suggestion, in-depth guidance</div>\\n<div class='small' style='margin-top:.6rem'>Includes written notes and dilution guidance.</div>\\n</div>\\n<div class='card'>\\n<h3>Package — 3 Sessions</h3>\\n<div class='price'>$390</div>\\n<div class='features'>Three 75-min sessions across 3 months, discount applied, follow-up emails</div>\\n<div class='small' style='margin-top:.6rem'>Hybrid-friendly and ideal for stepwise adjustments.</div>\\n</div>\\n<div class='card'>\\n<h3>Blend Creation (standalone)</h3>\\n<div class='price'>$55</div>\\n<div class='features'>Bespoke 10–15 ml roll-on or spray formula, safety labeling included</div>\\n<div class='small' style='margin-top:.6rem'>Not a clinical treatment — aromatic support and ritual design.</div>\\n</div>\\n</div>\\n</section>\\n\\n<section id='pillars' class='section'>\\n<div class='section-title'><div class='rule'></div><h3>Practice pillars</h3><div class='rule'></div></div>\\n<div class='pillars'>\\n<div class='pillar'>\\n<strong>Safety-first</strong>\\n<p class='small'>Clear dilution, contraindication screening, and patch testing guidance accompany every blend.</p>\\n</div>\\n<div class='pillar'>\\n<strong>Evidence-aware</strong>\\n<p class='small'>We translate aroma literature into practical, safety-forward options without promising cures.</p>\\n</div>\\n<div class='pillar'>\\n<strong>Client-led</strong>\\n<p class='small'>Your preferences, tolerances, and daily routines shape recommendations.</p>\\n</div>\\n</div>\\n</section>\\n\\n<section id='myth_vs_truth' class='section myths'>\\n<div class='section-title'><div class='rule'></div><h3>Common myths vs. thoughtful realities</h3><div class='rule'></div></div>\\n<div class='myth'>\\n<strong>Myth:</strong> Essential oils are completely benign because they're natural.\\n<p class='small'><strong>Truth:</strong> Natural substances can cause irritation or interact with medications; screening and dilution are essential.</p>\\n</div>\\n<div class='myth'>\\n<strong>Myth:</strong> A single blend will solve broad health problems.\\n<p class='small'><strong>Truth:</strong> Aromas can support routines and comfort but are not substitutes for medical care.</p>\\n</div>\\n</section>\\n\\n<section id='case_notes' class='case'>\\n<h3>Illustrative case notes (de-identified)</h3>\\n<p class='small'>Session summary: client preferred gentle florals; recommended a 1% dilution roll-on for nightly ritual; follow-up focused on scent fatigue and scent layering. No medical claims were made; adjustments based on tolerance and preferences.</p>\\n</section>\\n\\n<section id='faq' class='faq'>\\n<div class='section-title'><div class='rule'></div><h3>Practical questions</h3><div class='rule'></div></div>\\n<div class='q'><strong>How do you recommend dilutions?</strong>\\n<p class='small'>Dilutions are set by age and use-case. Typical adult topical dilutions are 1–3% for roll-ons; inhalation and diffusion use tiny amounts. You will receive explicit dilution guidance with each blend.</p></div>\\n<div class='q'><strong>What about patch testing?</strong>\\n<p class='small'>A patch test is recommended for all topical applications: 24–48 hours of observation on a small skin area before regular use.</p></div>\\n<div class='q'><strong>Are essential oils safe around pets?</strong>\\n<p class='small'>Some compounds affect animals differently. We include pet-safe guidance and alternatives; always consult your veterinarian for specific concerns.</p></div>\\n<div class='q'><strong>Pregnancy and breastfeeding?</strong>\\n<p class='small'>Certain oils are avoided in pregnancy and postpartum. I screen for pregnancy and nursing status and provide pregnancy-safe recommendations when relevant.</p></div>\\n</section>\\n\\n<section id='cta' style='margin-top:1.2rem'>\\n<div class='card'>\\n<h3>Ready to explore a careful approach?</h3>\\n<p class='small'>Book a consult or ask about a tailored at-home blend. Hybrid support available.</p>\\n<a class='cta-btn' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n</div>\\n</section>\\n\\n<footer class='footer'>\\n<p>Questions? Email <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a> or call {{PHONE}}. Serving {{CITY}}, {{STATE}}.</p>\\n</footer>\\n</div>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n<meta charset='utf-8'>\\n<title>About — {{BUSINESS_NAME}}</title>\\n<meta name='viewport' content='width=device-width,initial-scale=1'>\\n<style>\\n:root{--bg:#fbfcfe;--ink:#0d1720;--muted:#64748b;--accent:#9ad3c6}\\nbody{margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;color:var(--ink);background:linear-gradient(180deg,var(--bg),#eef8f9)}\\n.pattern{position:fixed;inset:0;z-index:0;opacity:0.12}\\n.wrap{position:relative;z-index:2;max-width:980px;margin:2.2rem auto;padding:1.6rem}\\n.top{display:flex;gap:1rem;align-items:center}\\n.logo{width:64px;height:64px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#8fbdd6);display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n.title{font-size:1.35rem;font-weight:700}\\n.sub{color:var(--muted)}\\n.nav{display:flex;gap:1rem;margin-top:1rem}\\n.nav a{color:var(--muted);text-decoration:none;padding:.4rem .7rem;border-radius:8px}\\n.nav a[href='about.html']{background:rgba(255,255,255,0.8);color:var(--ink)}\\n.section{margin-top:1.2rem}\\n.bio{background:white;padding:1rem;border-radius:12px;box-shadow:0 8px 24px rgba(12,18,20,0.04)}\\n.pillars{display:flex;gap:1rem;margin-top:1rem}\\n.pillar{flex:1;background:linear-gradient(180deg,#fff,rgba(255,255,255,0.95));padding:1rem;border-radius:10px}\\n.case{margin-top:1rem;padding:1rem;background:linear-gradient(90deg,rgba(154,211,198,0.07),transparent);border-radius:10px}\\n.faq{margin-top:1rem}\\n.q{background:white;padding:1rem;border-radius:10px;margin-bottom:.6rem}\\n.cta{margin-top:1.2rem;text-align:center}\\n.btn{background:linear-gradient(90deg,#9ad3c6,#8fbdd6);color:white;padding:.6rem 1rem;border-radius:10px;text-decoration:none}\\n@media(max-width:700px){.top{flex-direction:column;align-items:flex-start}.pillars{flex-direction:column}}\\n</style>\\n</head>\\n<body>\\n<!-- unique SVG motif: concentric soft rings -->\\n<svg class='pattern' width='100%' height='100%' xmlns='http://www.w3.org/2000/svg' preserveAspectRatio='none'>\\n<defs>\\n<radialGradient id='rg1'><stop offset='0' stop-color='#9ad3c6'/><stop offset='1' stop-color='#8fbdd6' stop-opacity='0.3'/></radialGradient>\\n</defs>\\n<rect width='100%' height='100%' fill='none'/>\\n<g fill='none' stroke='url(#rg1)' stroke-opacity='0.08' stroke-width='2'>\\n<circle cx='15%' cy='20%' r='120'/>\\n<circle cx='85%' cy='80%' r='200'/>\\n</g>\\n</svg>\\n\\n<div class='wrap'>\\n<header class='top'>\\n<div class='logo'>{{PRACTITIONER_NAME|slice:0:1}}</div>\\n<div>\\n<div class='title'>About {{BUSINESS_NAME}}</div>\\n<div class='sub'>A clinical-calm approach to scent, ritual, and everyday support — hybrid consultations available.</div>\\n</div>\\n</header>\\n<nav class='nav'>\\n<a href='index.html'>Start</a>\\n<a href='services.html'>Services</a>\\n<a href='blends.html'>Aromas</a>\\n<a href='shop.html'>Store</a>\\n<a href='pricing.html'>Pricing</a>\\n<a href='about.html'>Meet</a>\\n<a href='book.html'>Schedule</a>\\n<a href='contact.html'>Reach</a>\\n</nav>\\n\\n<section class='section bio'>\\n<h2 style='margin-top:0'>Meet {{PRACTITIONER_NAME}}</h2>\\n<p class='sub'>{{PRACTITIONER_NAME}} blends clinical rigor with sensory practice. Training, ongoing study, and a safety-forward stance shape every recommendation. No medical promises are made; the work focuses on aromatic support, ritual design, and tolerability guidance.</p>\\n\\n<div style='margin-top:1rem'>\\n<p class='small'><strong>Background:</strong> Formal training in aromatherapy, consultation experience, and continued professional learning in safety and contraindications. Works with adults, caregivers, and thoughtful pet-aware households.</p>\\n</div>\\n</section>\\n\\n<section class='section'>\\n<div class='section-title' style='display:flex;align-items:center;gap:.6rem'>\\n<h3 style='margin:0'>Core commitments</h3>\\n</div>\\n<div class='pillars'>\\n<div class='pillar'><strong>Transparent guidance</strong><p class='small'>You get clear dilution tables, patch-test instructions, and avoidance lists when appropriate.</p></div>\\n<div class='pillar'><strong>Personalized rituals</strong><p class='small'>Scent choices fit daily life, not just theory — aroma layering, timing, and context considered.</p></div>\\n<div class='pillar'><strong>Conservative selection</strong><p class='small'>Prioritize low-irritant choices and alternatives for sensitive skin or breathing issues.</p></div>\\n</div>\\n</section>\\n\\n<section class='section case'>\\n<h3>De-identified example</h3>\\n<p class='small'>Client preferred warm citrus notes but had sensitive skin. Offered a very low dilution inhalation strategy and a 0.5% topical blend for limited-area use. Follow-up noted improved comfort with scent and no irritation. All recommendations emphasized monitoring and discontinuing use if any reaction occurred.</p>\\n</section>\\n\\n<section class='section faq'>\\n<h3>Frequently asked</h3>\\n<div class='q'><strong>How do you stay current?</strong>\\n<p class='small'>Regular continuing education, reading recent safety summaries, and peer consultation inform my practice.</p></div>\\n<div class='q'><strong>Can I purchase blends directly?</strong>\\n<p class='small'>Yes — bespoke blends are available through the shop and by consult. Pre-made kits are also offered for safe at-home use.</p></div>\\n<div class='q'><strong>What if I have pets at home?</strong>\\n<p class='small'>I provide alternatives and diffusion protocols that minimize exposure to vulnerable animals; consult your vet if you have specific concerns.</p></div>\\n<div class='q'><strong>Pregnancy considerations?</strong>\\n<p class='small'>Pregnancy requires tailored avoidance lists and often conservative or alternative approaches; we always screen and adapt.</p></div>\\n</section>\\n\\n<div class='cta'>\\n<a class='btn' href='book.html'>Book a consultation with {{PRACTITIONER_NAME}}</a>\\n<div class='small' style='margin-top:.6rem'>Prefer a question first? Email <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a></div>\\n</div>\\n\\n</div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n<meta charset='utf-8'>\\n<title>Book — {{BUSINESS_NAME}}</title>\\n<meta name='viewport' content='width=device-width,initial-scale=1'>\\n<style>\\n:root{--bg:#f7fbfb;--card:#ffffff;--ink:#092026;--muted:#556672;--accent:#7fc4b2}\\nbody{margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;background:linear-gradient(180deg,var(--bg),#eef8f9);color:var(--ink)}\\n.pattern{position:fixed;inset:0;z-index:0;opacity:0.1}\\n.shell{position:relative;z-index:2;max-width:900px;margin:2rem auto;padding:1.2rem}\\n.topnav{display:flex;justify-content:space-between;align-items:center}\\n.nav a{margin-left:.6rem;color:var(--muted);text-decoration:none}\\n.hero{background:var(--card);padding:1rem;border-radius:12px;box-shadow:0 10px 30px rgba(5,10,12,0.05);margin-top:1rem}\\n.hero h1{margin:0;font-size:1.3rem}\\n.form{display:grid;grid-template-columns:1fr 320px;gap:1rem;margin-top:1rem}\\n.form-left{background:var(--card);padding:1rem;border-radius:12px}\\n.form-right{background:linear-gradient(180deg,rgba(127,196,178,0.06),transparent);padding:1rem;border-radius:12px}\\n.field{margin-bottom:.6rem}\\n.label{display:block;font-size:.9rem;margin-bottom:.25rem}\\n.input{width:100%;padding:.6rem;border-radius:8px;border:1px solid #e6eef0}\\n.small{font-size:.9rem;color:var(--muted)}\\n.book-btn{display:inline-block;background:linear-gradient(90deg,var(--accent),#8fbdd6);color:white;padding:.6rem 1rem;border-radius:10px;text-decoration:none}\\n.note{margin-top:.8rem;font-size:.88rem;color:var(--muted)}\\n.faq{margin-top:1rem}\\n.q{background:var(--card);padding:.8rem;border-radius:10px;margin-bottom:.6rem}\\n@media(max-width:880px){.form{grid-template-columns:1fr}.nav{display:none}}\\n</style>\\n</head>\\n<body>\\n<!-- elegant leaf lattice SVG -->\\n<svg class='pattern' width='100%' height='100%' xmlns='http://www.w3.org/2000/svg' preserveAspectRatio='none'>\\n<defs>\\n<linearGradient id='lg' x1='0' x2='1'>\\n<stop offset='0' stop-color='#7fc4b2'/>\\n<stop offset='1' stop-color='#8fbdd6'/>\\n</linearGradient>\\n</defs>\\n<g stroke='url(#lg)' stroke-opacity='0.08' fill='none'>\\n<path d='M0,80 C120,10 260,150 400,80 C540,10 680,150 900,80' />\\n<path d='M0,160 C120,80 260,220 400,160 C540,100 680,240 900,160' />\\n</g>\\n</svg>\\n\\n<div class='shell'>\\n<div class='topnav'>\\n<div style='font-weight:700'>{{BUSINESS_NAME}}</div>\\n<nav><a href='index.html'>Begin</a><a href='services.html'>Care</a><a href='blends.html'>Blends</a><a href='shop.html'>Buy</a><a href='pricing.html'>Rates</a><a href='about.html'>About</a><a href='book.html'>Book</a><a href='contact.html'>Connect</a></nav>\\n</div>\\n\\n<section class='hero'>\\n<h1>Reserve a consultation or blend creation</h1>\\n<p class='small'>Choose teleconsult or in-person. Sessions are structured to prioritize screening, dilution guidance, and safe use instructions. No medical advice is provided.</p>\\n</section>\\n\\n<section class='form'>\\n<div class='form-left'>\\n<form action='{{PRIMARY_CTA_URL}}' method='get'>\\n<div class='field'><label class='label'>Your name</label><input class='input' name='name' placeholder='Full name' required></div>\\n<div class='field'><label class='label'>Email</label><input class='input' name='email' placeholder='you@example.com' required></div>\\n<div class='field'><label class='label'>Phone</label><input class='input' name='phone' placeholder='{{PHONE}}'></div>\\n<div class='field'><label class='label'>Preferred session</label>\\n<select class='input' name='session'>\\n<option>Intro Consult — 30–45 min</option>\\n<option>Standard Session — 75 min</option>\\n<option>Blend Creation — 30 min</option>\\n</select></div>\\n<div class='field'><label class='label'>In-person or virtual?</label>\\n<select class='input' name='mode'>\\n<option>Virtual</option>\\n<option>In-person ({{CITY}}, {{STATE}})</option>\\n</select></div>\\n<div class='field'><label class='label'>Brief note / preferences</label>\\n<textarea class='input' name='notes' rows='4' placeholder='Scent likes, allergies, pregnancy, pets, or other considerations'></textarea></div>\\n<div style='display:flex;gap:.6rem;align-items:center'>\\n<button class='book-btn' type='submit'>Request booking</button>\\n<a href='mailto:{{EMAIL}}' class='small' style='margin-left:auto'>Questions? Email us</a>\\n</div>\\n</form>\\n<div class='note'>After requesting, you will receive a confirmation with intake forms and safety checklists. Please complete screening before the session.</div>\\n</div>\\n\\n<aside class='form-right'>\\n<h3>What to expect</h3>\\n<p class='small'>A structured intake includes: current medications, pregnancy/breastfeeding status, pet exposures, skin sensitivities, and fragrance preferences. We provide clear patch-test instructions and dilution tables when blends are suggested.</p>\\n\\n<div style='margin-top:1rem'>\\n<h4 style='margin:0'>Quick policies</h4>\\n<ul class='small'>\\n<li>Payment is collected at booking for packages and blend orders.</li>\\n<li>Cancellations: please notify 48 hours prior when possible.</li>\\n<li>All guidance is non-medical; consult your primary care provider for clinical issues.</li>\\n</ul>\\n</div>\\n\\n<div class='faq'>\\n<h4 style='margin-top:1rem'>Booking FAQs</h4>\\n<div class='q'><strong>Do you accept walk-ins?</strong>\\n<p class='small'>By appointment only to allow time for safety screening and blend preparation.</p></div>\\n<div class='q'><strong>Can I bring a support person?</strong>\\n<p class='small'>Yes. Please note their presence on your intake form so we'll factor preferences and sensitivities into recommendations.</p></div>\\n<div class='q'><strong>What if I'm pregnant?</strong>\\n<p class='small'>Select that in your notes; we will adapt recommendations using conservative, pregnancy-aware options and avoid particular oils.</p></div>\\n</div>\\n</aside>\\n</section>\\n\\n<footer style='margin-top:1.2rem;color:var(--muted)'>\\n<p class='small'>Need another time? Call {{PHONE}} or email <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a>. Serving {{CITY}}, {{STATE}}. By booking you agree to follow provided safety guidance and patch-testing procedures.</p>\\n</footer>\\n\\n</div>\\n</body>\\n</html>\"} \nBUNDLE_END"
