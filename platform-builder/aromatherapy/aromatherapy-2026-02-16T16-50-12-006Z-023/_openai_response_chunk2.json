          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Services</title>\\n  <style>\\n    :root{--bg:#FBFAF8;--muted:#6b6b6b;--accent1:#7bb387;--accent2:#e4b07a;--card:#fff;--glass:rgba(255,255,255,0.6)}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;color:#213;line-height:1.45;background:linear-gradient(180deg,var(--bg),#fff);min-height:100vh}\\n    header{position:sticky;top:0;backdrop-filter:blur(6px);background:linear-gradient(180deg,rgba(255,255,255,0.6),rgba(255,255,255,0.45));border-bottom:1px solid rgba(33,33,33,0.05);z-index:40}\\n    .nav{max-width:1100px;margin:0 auto;padding:14px 20px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:46px;height:46px;border-radius:12px;background:linear-gradient(135deg,var(--accent1),var(--accent2));display:grid;place-items:center;color:#fff;font-weight:700}\\n    nav a{margin-left:14px;color:#2b2b2b;text-decoration:none;font-weight:600;font-size:14px}\\n    .cta-btn{background:linear-gradient(90deg,var(--accent1),#69a07a);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    .hero{position:relative;overflow:hidden;padding:56px 20px 40px}\\n    .hero-grid{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center}\\n    .hero-card{background:linear-gradient(180deg,rgba(255,255,255,0.9),var(--glass));padding:28px;border-radius:16px;box-shadow:0 10px 30px rgba(34,40,30,0.06)}\\n    h1{margin:0 0 10px;font-size:28px;color:#123}\\n    p.lead{margin:0;color:var(--muted)}\\n\\n    /* unique SVG vignette */\\n    .pattern-wrap{position:absolute;right:-6%;top:-10%;width:520px;opacity:0.12;transform:rotate(12deg)}\\n\\n    .services-list{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:18px}\\n    .service{background:var(--card);padding:16px;border-radius:12px;border:1px solid rgba(35,35,35,0.04)}\\n    .service h4{margin:0 0 6px}\\n    .service p{margin:0;color:var(--muted);font-size:14px}\\n\\n    .story, .framework, .offers, .pricing, .testimonials, .cta{max-width:1100px;margin:36px auto;padding:0 20px}\\n    .framework-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}\\n    .step{background:linear-gradient(180deg,#fff,rgba(255,255,255,0.9));padding:16px;border-radius:10px;border:1px solid rgba(0,0,0,0.04)}\\n\\n    .offers-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}\\n    .offer-card{padding:18px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.95),#fff);box-shadow:0 12px 30px rgba(30,40,30,0.04)}\\n\\n    .pricing-tease{display:flex;gap:14px}\\n    .price{background:linear-gradient(180deg,#fff,#faf9f8);padding:12px;border-radius:10px}\\n\\n    .testimonials-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}\\n    .testimonial{padding:14px;background:linear-gradient(180deg,rgba(255,255,255,0.98),#fff);border-radius:10px}\\n    footer{padding:20px;text-align:center;color:var(--muted);font-size:14px}\\n\\n    @media(max-width:900px){.hero-grid{grid-template-columns:1fr}.services-list{grid-template-columns:1fr}.offers-cards{grid-template-columns:1fr}.testimonials-grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div class=\\\"brand\\\"><div class=\\\"logo\\\">A</div><div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted);margin-top:2px\\\">{{TAGLINE}}</div>\\n      </div></div>\\n      <div>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"blends.html\\\">Blends & Recipes</a>\\n        <a href=\\\"shop.html\\\">Shop</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a class=\\\"cta-btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-grid\\\">\\n        <div class=\\\"hero-card\\\">\\n          <h1>Guided scent work for everyday wellbeing</h1>\\n          <p class=\\\"lead\\\">I help people use essential oils as a gentle companion—no medical promises, just thoughtful blends and safe practices to support comfort, clarity, and calm. Memberships, custom blends, and seasonal workshops available.</p>\\n\\n          <div class=\\\"services-list\\\" style=\\\"margin-top:18px\\\">\\n            <div class=\\\"service\\\">\\n              <h4>1:1 Consultations</h4>\\n              <p>Personalized aromatic guidance and blending session—safety-first and tailored to your context.</p>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <h4>Custom Blends</h4>\\n              <p>Small-batch blends crafted with intention, labelled with dilution and patch-test notes.</p>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <h4>Workshops & Courses</h4>\\n              <p>Hands-on group classes about safe blending, diffusion, and mindful scent practices.</p>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <h4>Membership</h4>\\n              <p>Monthly blends, seasonal tips, and member-only workshops. Priority booking included.</p>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:16px;display:flex;gap:12px;align-items:center\\\">\\n            <a class=\\\"cta-btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a Visit</a>\\n            <a href=\\\"blends.html\\\" style=\\\"text-decoration:none;color:var(--muted);font-weight:700\\\">Explore Blends</a>\\n          </div>\\n        </div>\\n\\n        <aside style=\\\"position:relative\\\">\\n          <div style=\\\"background:linear-gradient(135deg,#fffefc,rgba(235,240,230,0.6));padding:18px;border-radius:14px;box-shadow:0 10px 30px rgba(30,30,30,0.04)\\\">\\n            <h3 style=\\\"margin:0 0 8px\\\">Quick Intake</h3>\\n            <p style=\\\"margin:0 0 12px;color:var(--muted)\\\">A five-step scent compass to guide your first session.</p>\\n            <ol style=\\\"margin:0;color:var(--muted)\\\">\\n              <li>Connect — share context & intentions</li>\\n              <li>Listen — scent preferences & safety notes</li>\\n              <li>Design — select oils with safe dilutions</li>\\n              <li>Blend — create a small sample</li>\\n              <li>Learn — tips for use & storage</li>\\n            </ol>\\n            <div style=\\\"margin-top:12px\\\"><a href=\\\"pricing.html\\\" class=\\\"cta-btn\\\">See Plans</a></div>\\n          </div>\\n          <div class=\\\"pattern-wrap\\\" aria-hidden=\\\"true\\\">\\n            <svg width=\\\"520\\\" height=\\\"520\\\" viewBox=\\\"0 0 520 520\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n              <defs>\\n                <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n                  <stop offset=\\\"0\\\" stop-color=\\\"#7bb387\\\" stop-opacity=\\\"0.9\\\"/>\\n                  <stop offset=\\\"1\\\" stop-color=\\\"#e4b07a\\\" stop-opacity=\\\"0.85\\\"/>\\n                </linearGradient>\\n                <pattern id=\\\"p1\\\" width=\\\"80\\\" height=\\\"80\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n                  <rect width=\\\"80\\\" height=\\\"80\\\" fill=\\\"transparent\\\"/>\\n                  <circle cx=\\\"16\\\" cy=\\\"16\\\" r=\\\"10\\\" fill=\\\"url(#g1)\\\" opacity=\\\"0.25\\\"/>\\n                  <circle cx=\\\"64\\\" cy=\\\"64\\\" r=\\\"6\\\" fill=\\\"#fff\\\" opacity=\\\"0.12\\\"/>\\n                </pattern>\\n              </defs>\\n              <rect width=\\\"520\\\" height=\\\"520\\\" fill=\\\"url(#p1)\\\"/>\\n              <g transform=\\\"translate(40,40)\\\" opacity=\\\"0.06\\\">\\n                <path d=\\\"M0 200 C120 80, 220 320, 520 60\\\" stroke=\\\"#093\\\" stroke-width=\\\"38\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\" />\\n              </g>\\n            </svg>\\n          </div>\\n        </aside>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"story\\\">\\n      <h2>Where scent meets intention</h2>\\n      <p style=\\\"color:var(--muted)\\\">I’m {{PRACTITIONER_NAME}}. My approach is rooted in safety, curiosity, and storytelling—helping you create blends that feel like a small ritual. I avoid medical claims and prioritize guidance so that oils are enjoyed with confidence.</p>\\n    </section>\\n\\n    <section class=\\\"framework\\\">\\n      <h2>My process — a gentle framework</h2>\\n      <div class=\\\"framework-grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"step\\\"><strong>Listen</strong><div style=\\\"color:var(--muted);margin-top:6px\\\">We begin with preferences and safety notes (allergies, medications, pregnancy, pets).</div></div>\\n        <div class=\\\"step\\\"><strong>Map</strong><div style=\\\"color:var(--muted);margin-top:6px\\\">I translate your needs into a safe aroma architecture—top, middle, base notes and dilution guidance.</div></div>\\n        <div class=\\\"step\\\"><strong>Create</strong><div style=\\\"color:var(--muted);margin-top:6px\\\">A small sample to try at home, with patch-test and use instructions.</div></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"offers\\\">\\n      <h2>Offerings</h2>\\n      <div class=\\\"offers-cards\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"offer-card\\\">\\n          <h4>Intro Consultation</h4>\\n          <p style=\\\"color:var(--muted)\\\">45-minute remote or in-person session to set intentions and design a safe starter blend.</p>\\n        </div>\\n        <div class=\\\"offer-card\\\">\\n          <h4>Custom Blend Session</h4>\\n          <p style=\\\"color:var(--muted)\\\">One-hour session including small-batch blending and dilution labeling.</p>\\n        </div>\\n        <div class=\\\"offer-card\\\">\\n          <h4>Membership</h4>\\n          <p style=\\\"color:var(--muted)\\\">Monthly blends, early access to workshops, and member-only recipes.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"pricing\\\">\\n      <h2>Pricing snapshot</h2>\\n      <div class=\\\"pricing-tease\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"price\\\"><strong>Intro — $65</strong><div style=\\\"color:var(--muted);margin-top:6px\\\">45 minutes, intake, starter blend</div></div>\\n        <div class=\\\"price\\\"><strong>Custom Blend — $95</strong><div style=\\\"color:var(--muted);margin-top:6px\\\">1 hour, 10ml sample included</div></div>\\n        <div class=\\\"price\\\"><strong>Membership — $24/mo</strong><div style=\\\"color:var(--muted);margin-top:6px\\\">Monthly sample + perks</div></div>\\n      </div>\\n      <div style=\\\"margin-top:12px;color:var(--muted);font-size:13px\\\">Full pricing and packages on the <a href=\\\"pricing.html\\\">Plans</a> page.</div>\\n    </section>\\n\\n    <section class=\\\"testimonials\\\">\\n      <h2>What people say</h2>\\n      <div class=\\\"testimonials-grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"testimonial\\\"><strong>\\\"Calm, thoughtful, and safe.\\\"</strong><div style=\\\"color:var(--muted);margin-top:8px\\\">— M., Portland</div></div>\\n        <div class=\\\"testimonial\\\"><strong>\\\"A beautiful custom blend that felt like home.\\\"</strong><div style=\\\"color:var(--muted);margin-top:8px\\\">— S., remote client</div></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"cta\\\">\\n      <div style=\\\"max-width:700px;margin:0 auto;padding:20px;background:linear-gradient(90deg,#fff,#f7fbf7);border-radius:12px;border:1px solid rgba(0,0,0,0.04)\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">Ready to begin?</h3>\\n        <p style=\\\"margin:0 0 12px;color:var(--muted)\\\">Book a consultation, ask about memberships, or request a sample blend. I’ll include safety notes and dilution guidance with every purchase.</p>\\n        <div style=\\\"display:flex;gap:12px\\\"><a class=\\\"cta-btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a><a href=\\\"contact.html\\\" style=\\\"align-self:center;color:var(--muted);font-weight:700;text-decoration:none\\\">Contact</a></div>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>Questions? Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    <div style=\\\"margin-top:6px\\\">Serving {{CITY}}, {{STATE}} • Copyright © <span id=\\\"yr\\\"></span> {{BUSINESS_NAME}}</div>\\n  </footer>\\n\\n  <script>document.getElementById('yr').textContent=new Date().getFullYear()</script>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Blends & Recipes</title>\\n  <style>\\n    :root{--bg:#fffefb;--accent:#a98b6a;--muted:#555;--card:#fff}\\n    body{margin:0;font-family:Georgia,serif;color:#222;background:linear-gradient(180deg,var(--bg),#fff);}\\n    header{position:sticky;top:0;background:rgba(255,255,255,0.8);backdrop-filter:blur(4px);border-bottom:1px solid rgba(0,0,0,0.04)}\\n    .nav{max-width:1100px;margin:0 auto;padding:12px 20px;display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:12px;color:#2b2b2b;text-decoration:none}\\n    .hero{padding:48px 20px 10px;max-width:1100px;margin:0 auto}\\n    h1{margin:0;font-size:30px;color:#1a2}\\n    p.lead{color:var(--muted)}\\n\\n    .pattern-hero{position:absolute;left:6%;top:10%;opacity:0.08;transform:rotate(-8deg)}\\n\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;max-width:1100px;margin:18px auto;padding:0 20px}\\n    .blend{background:var(--card);padding:16px;border-radius:12px;border:1px solid rgba(0,0,0,0.04)}\\n    .blend h3{margin:0 0 8px;font-family:system-ui, -apple-system, Arial}\\n    .notes{font-size:13px;color:var(--muted);margin-top:8px}\\n\\n    .faq{max-width:1100px;margin:28px auto;padding:0 20px}\\n    .faq dt{font-weight:700;margin-top:12px}\\n    .faq dd{margin:4px 0 12px;color:var(--muted)}\\n\\n    .disclaimer{max-width:1100px;margin:24px auto;padding:12px 20px;color:var(--muted);font-size:13px}\\n\\n    @media(max-width:1000px){.grid{grid-template-columns:repeat(2,1fr)} }\\n    @media(max-width:700px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n      <div>\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"services.html\\\">Our Work</a>\\n        <a href=\\\"blends.html\\\">Recipes</a>\\n        <a href=\\\"shop.html\\\">Store</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"about.html\\\">Story</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n      </div>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <h1>Blends — curated recipes and safe notes</h1>\\n      <p class=\\\"lead\\\">A small library of thoughtfully composed blends. Each entry lists top / middle / base notes, an aroma profile, and supportive uses. These are not medical treatments—just aromatic suggestions and safety reminders.</p>\\n      <div class=\\\"pattern-hero\\\" aria-hidden=\\\"true\\\">\\n        <svg width=\\\"260\\\" height=\\\"260\\\" viewBox=\\\"0 0 260 260\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n          <defs>\\n            <radialGradient id=\\\"rg\\\" cx=\\\"50%\\\" cy=\\\"30%\\\">\\n              <stop offset=\\\"0\\\" stop-color=\\\"#a98b6a\\\" stop-opacity=\\\"0.9\\\"/>\\n              <stop offset=\\\"1\\\" stop-color=\\\"#f6efe6\\\" stop-opacity=\\\"0.2\\\"/>\\n            </radialGradient>\\n          </defs>\\n          <circle cx=\\\"130\\\" cy=\\\"130\\\" r=\\\"120\\\" fill=\\\"url(#rg)\\\" />\\n          <g opacity=\\\"0.06\\\"><path d=\\\"M10 200 C70 120, 140 300, 250 60\\\" stroke=\\\"#3a6\\\" stroke-width=\\\"34\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/></g>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"grid\\\" aria-label=\\\"blend library\\\">\\n      <!-- 10 blends -->\\n      <div class=\\\"blend\\\">\\n        <h3>Calm Harbor</h3>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Bergamot, Sweet Orange • <strong>Middle:</strong> Lavender, Roman Chamomile • <strong>Base:</strong> Vetiver</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><em>Aroma:</em> bright citrus softened by floral-herbal heart and grounding base.</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> sense of calm, restful moments, mindful pauses. Use at low dilution; patch test before wider use.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h3>Forest Walk</h3>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Pine, Lemon • <strong>Middle:</strong> Rosemary • <strong>Base:</strong> Cedarwood</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><em>Aroma:</em> brisk, green, and resinous—like a walk among trees.</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> an uplifting, clearing atmosphere for focus and grounding. Keep away from pets that are sensitive to certain oils; consult guidance below.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h3>Evening Hearth</h3>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Sweet Orange • <strong>Middle:</strong> Clary Sage • <strong>Base:</strong> Sandalwood</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><em>Aroma:</em> warm citrus folded into gentle wood and soft spice.</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> cozy rituals and evening wind-downs. Avoid direct skin application without dilution; test first.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h3>Morning Clarity</h3>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Grapefruit, Lemon • <strong>Middle:</strong> Peppermint • <strong>Base:</strong> Frankincense</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><em>Aroma:</em> bright citrus with herbal lift and resinous depth.</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> an energizing ritual to begin the day; use in a diffuser for brief intervals.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h3>Gentle Restore</h3>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Mandarin • <strong>Middle:</strong> Geranium • <strong>Base:</strong> Jojoba (carrier)</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><em>Aroma:</em> floral-citrus and soft carrier base for topical use.</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> ritual massage at safe dilutions; always perform a patch test and consult about pregnancy and medications.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h3>Quiet Focus</h3>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Lemon • <strong>Middle:</strong> Lavender • <strong>Base:</strong> Atlas Cedar</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><em>Aroma:</em> clean, herbal, and quietly woody.</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> concentration and a calm workspace; suitable for diffusion in short bursts.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h3>Warm Spice</h3>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Bergamot • <strong>Middle:</strong> Cinnamon (low) • <strong>Base:</strong> Vanilla CO2</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><em>Aroma:</em> sweet-spicy with a soft gourmand finish.</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> seasonal rituals; use cinnamon sparingly and not on skin undiluted.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h3>Spring Meadow</h3>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Neroli • <strong>Middle:</strong> Lavender • <strong>Base:</strong> Benzoin</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><em>Aroma:</em> floral, bright, and warmly resinous.</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> gentle mood-lifting scent for shared spaces; dilute for topical use.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h3>Night Meadow</h3>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Lavender • <strong>Middle:</strong> Clary Sage • <strong>Base:</strong> Marjoram</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><em>Aroma:</em> dry floral with herbaceous undertones.</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> a supportive evening diffuser blend; keep to low concentrations and allow ventilation.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h3>Citrus Breeze</h3>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Lime • <strong>Middle:</strong> Sweet Basil • <strong>Base:</strong> Blonde Cedarwood</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><em>Aroma:</em> zesty, slightly herbal, and clean.</div>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> freshening a room and gently lifting the spirit. Avoid overexposure for sensitive noses.</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h2>Frequently asked safety questions</h2>\\n      <dl>\\n        <dt>How should I dilute oils?</dt>\\n        <dd>Dilution depends on age, sensitivity, and use. A common guideline is 1–3% for adults in topical blends; lower for children and sensitive skin. I provide explicit dilution for each custom blend.</dd>\\n\\n        <dt>What is a patch test?</dt>\\n        <dd>Apply a small diluted drop to the inner forearm, cover for 24 hours, and check for irritation. If redness or discomfort occurs, discontinue use.</dd>\\n\\n        <dt>How do I use blends around pets?</dt>\\n        <dd>Some essential oils can be toxic to animals. Avoid leaving diffusers running unattended; keep animals in a separate room while diffusing and consult a veterinarian for specific concerns.</dd>\\n\\n        <dt>Are blends safe during pregnancy?</dt>\\n        <dd>Certain oils are not recommended in pregnancy. If you are pregnant or nursing, please consult your healthcare provider and disclose this in any intake so blends can be adjusted accordingly.</dd>\\n      </dl>\\n    </section>\\n\\n    <section class=\\\"disclaimer\\\">\\n      <strong>Note:</strong> These blends are aromatic suggestions and learning tools. They are not medical treatments. For medical advice, please consult a licensed professional. Every blend includes guidance on dilution and a reminder to patch test.\\n    </section>\\n\\n    <section style=\\\"max-width:1100px;margin:24px auto;padding:0 20px\\\">\\n      <a href=\\\"services.html\\\" style=\\\"display:inline-block;padding:12px 16px;background:linear-gradient(90deg,#b5896b,#7aa17a);color:#fff;border-radius:10px;text-decoration:none\\\">Book a Blend Session</a>\\n      <a href=\\\"shop.html\\\" style=\\\"margin-left:12px;color:var(--muted);font-weight:700;text-decoration:none\\\">Shop samples</a>\\n    </section>\\n  </main>\\n\\n  <footer style=\\\"padding:28px 20px;color:var(--muted)\\\">\\n    <div style=\\\"max-width:1100px;margin:0 auto\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — Shop</title>\\n  <style>\\n    :root{--bg:#f8faf7;--muted:#5a5a5a;--accent:#7bb387}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system;line-height:1.5;background:var(--bg);color:#222}\\n    header{background:#fff;padding:12px 20px;box-shadow:0 6px 20px rgba(20,20,20,0.03);position:sticky;top:0}\\n    .nav{max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:12px;text-decoration:none;color:#222;font-weight:600}\\n\\n    .hero{max-width:1100px;margin:28px auto;padding:0 20px}\\n    h1{margin:0;font-size:28px}\\n    p.lead{color:var(--muted);margin-top:6px}\\n\\n    .catalog{max-width:1100px;margin:20px auto;padding:0 20px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\\n    .card{background:#fff;border-radius:12px;padding:16px;border:1px solid rgba(0,0,0,0.04);box-shadow:0 12px 30px rgba(10,20,10,0.03)}\\n    .thumb{height:140px;border-radius:10px;background:linear-gradient(135deg,#f2efe8,#e9f3ea);display:grid;place-items:center;color:#6b6b6b;font-weight:700}\\n    .price{font-weight:800;margin-top:8px}\\n    .meta{font-size:13px;color:var(--muted);margin-top:8px}\\n    .btn{display:inline-block;margin-top:12px;padding:10px 12px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#6aa17a);color:#fff;text-decoration:none;font-weight:700}\\n\\n    .helper{max-width:1100px;margin:18px auto;padding:0 20px;color:var(--muted)}\\n\\n    @media(max-width:1000px){.grid{grid-template-columns:repeat(2,1fr)}}\\n    @media(max-width:700px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n      <div>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">My Services</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"shop.html\\\">Shop</a>\\n        <a href=\\\"pricing.html\\\">Membership</a>\\n        <a href=\\\"about.html\\\">Our Story</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </div>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <h1>Shop curated blends and kits</h1>\\n      <p class=\\\"lead\\\">Browse ready-made roll-ons, diffuser blends, and starter kits. Each product includes dilution instructions, patch-test reminders, and safe-use tips. No medical claims—just safe, sensorial choices.</p>\\n    </section>\\n\\n    <section class=\\\"catalog\\\">\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"card\\\">\\n          <div class=\\\"thumb\\\">Starter Kit</div>\\n          <h3 style=\\\"margin:10px 0 0\\\">Starter Ritual Kit</h3>\\n          <div class=\\\"meta\\\">Includes three 5ml blends, usage guide, and a small diffuser mat.</div>\\n          <div class=\\\"price\\\">$49.00</div>\\n          <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <div class=\\\"thumb\\\">Roll-On</div>\\n          <h3 style=\\\"margin:10px 0 0\\\">Calm Harbor Roll-On (10ml)</h3>\\n          <div class=\\\"meta\\\">Pre-diluted to 2% in fractionated coconut oil. Patch test recommended.</div>\\n          <div class=\\\"price\\\">$18.00</div>\\n          <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <div class=\\\"thumb\\\">Diffuser</div>\\n          <h3 style=\\\"margin:10px 0 0\\\">Ceramic Diffuser — Mini</h3>\\n          <div class=\\\"meta\\\">Quiet ultrasonic diffuser, covers small rooms. Includes USB cable.</div>\\n          <div class=\\\"price\\\">$39.00</div>\\n          <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <div class=\\\"thumb\\\">Refills</div>\\n          <h3 style=\\\"margin:10px 0 0\\\">Membership Blend Refill</h3>\\n          <div class=\\\"meta\\\">10ml refill for members and non-members. Label includes dilution.</div>\\n          <div class=\\\"price\\\">$12.00</div>\\n          <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <div class=\\\"thumb\\\">Roll-On</div>\\n          <h3 style=\\\"margin:10px 0 0\\\">Morning Clarity Roll-On</h3>\\n          <div class=\\\"meta\\\">Convenient roll-on for grab-and-go focus. Diluted at 1.5%.</div>\\n          <div class=\\\"price\\\">$16.00</div>\\n          <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <div class=\\\"thumb\\\">Kit</div>\\n          <h3 style=\\\"margin:10px 0 0\\\">Travel Mini Collection</h3>\\n          <div class=\\\"meta\\\">Three 5ml blends chosen for travel and comfort. TSA-friendly sizes.</div>\\n          <div class=\\\"price\\\">$34.00</div>\\n          <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:18px;display:flex;gap:12px;flex-wrap:wrap;align-items:center\\\">\\n        <a href=\\\"blends.html\\\" style=\\\"text-decoration:none;color:var(--muted);font-weight:700\\\">View all blends</a>\\n        <a href=\\\"services.html\\\" style=\\\"text-decoration:none;color:var(--muted);font-weight:700\\\">Custom blend orders</a>\\n      </div>\\n\\n      <div class=\\\"helper\\\">\\n        <h4 style=\\\"margin-top:22px\\\">Product safety & FAQ</h4>\\n        <p style=\\\"margin:6px 0;color:var(--muted)\\\"><strong>Dilution:</strong> Each topical product is labeled with dilution. If you have sensitive skin, start lower than the suggested dilution and patch test.</p>\\n        <p style=\\\"margin:6px 0;color:var(--muted)\\\"><strong>Patch test:</strong> Apply a small amount on inner forearm for 24 hours to check for irritation before regular use.</p>\\n        <p style=\\\"margin:6px 0;color:var(--muted)\\\"><strong>Pets:</strong> Keep diffusers in a well-ventilated space and avoid prolonged exposure when pets are present. Some oils are unsafe for animals—consult us if you have concerns.</p>\\n        <p style=\\\"margin:6px 0;color:var(--muted)\\\"><strong>Pregnancy & medications:</strong> If pregnant, nursing, or on medication, consult your healthcare provider before using essential oils. We can tailor blends with safety in mind.</p>\\n      </div>\\n\\n      <div style=\\\"max-width:1100px;margin:18px auto;padding:0 20px;color:var(--muted);font-size:13px\\\">\\n        <strong>Shipping & returns:</strong> Local pickup and standard shipping available. Opened products may not be returnable for hygiene reasons—contact us if there’s an issue.\\n      </div>\\n\\n      <div style=\\\"max-width:1100px;margin:24px auto;padding:0 20px\\\">\\n        <a href=\\\"contact.html\\\" class=\\\"btn\\\" style=\\\"background:linear-gradient(90deg,#6aa17a,#4f8a63)\\\">Questions about a product? Ask us</a>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer style=\\\"padding:24px 20px;color:var(--muted);text-align:center\\\">\\n    <div>Contact <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n    <div style=\\\"margin-top:8px\\\">Serving {{CITY}}, {{STATE}} • Crafted with care by {{PRACTITIONER_NAME}}</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
