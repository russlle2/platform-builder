          "text": "BUNDLE_START\n{\"path\":\"contact.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Connect — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{\\n      --bg-1: #f6efe6; /* warm parchment */\\n      --bg-2: #efe6dc;\\n      --accent: #946a3d; /* clay */\\n      --muted: #6b5a4a;\\n      --leaf: #7a9a6e;\\n      --glass: rgba(255,255,255,0.6);\\n      --radius: 14px;\\n      --maxw: 980px;\\n      font-family: ui-serif, Georgia, 'Times New Roman', serif;\\n      color: var(--muted);\\n    }\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg-1),var(--bg-2));}\\n    .wrap{max-width:var(--maxw);margin:48px auto;padding:40px;border-radius:20px;background:linear-gradient(180deg,rgba(255,255,255,0.7),rgba(255,255,255,0.55));box-shadow:0 10px 30px rgba(25,20,15,0.08);position:relative;overflow:hidden}\\n    nav{display:flex;gap:18px;align-items:center;margin-bottom:28px}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px 12px;border-radius:10px;font-weight:600}\\n    nav a.current{background:linear-gradient(90deg,rgba(148,106,61,0.12),rgba(122,154,110,0.06));color:var(--accent)}\\n    header.hero{display:grid;grid-template-columns:1fr 360px;gap:26px;align-items:start;margin-bottom:26px}\\n    .intro{padding:12px 6px}\\n    h1{font-size:28px;margin:6px 0 8px;color:var(--accent);letter-spacing:0.2px}\\n    p.lead{margin:0;color:var(--muted);opacity:0.95;font-size:15px;line-height:1.5}\\n    .mini-card{background:var(--glass);backdrop-filter:blur(6px);padding:18px;border-radius:12px;border:1px solid rgba(150,110,70,0.06)}\\n    form.contact{display:flex;flex-direction:column;gap:10px}\\n    label{font-size:13px;color:var(--muted)}\\n    input[type='text'],input[type='email'],textarea,select{padding:10px;border-radius:10px;border:1px solid rgba(100,80,60,0.08);font-size:14px}\\n    textarea{min-height:110px;resize:vertical}\\n    .row{display:flex;gap:10px}\\n    .pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:24px 0}\\n    .pillar{background:linear-gradient(180deg,rgba(255,255,255,0.5),rgba(255,255,255,0.4));padding:14px;border-radius:12px;border:1px solid rgba(120,90,60,0.05)}\\n    .myths{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px}\\n    .myth{padding:12px;border-radius:12px;background:linear-gradient(90deg,rgba(122,154,110,0.06),rgba(148,106,61,0.04));}\\n    .case{margin:10px 0;padding:12px;border-radius:12px;background:rgba(250,245,240,0.6);border:1px dashed rgba(120,90,60,0.06)}\\n    .faq{margin-top:12px}\\n    .q{font-weight:700;margin-top:8px}\\n    .cta{display:flex;gap:12px;align-items:center;margin-top:18px}\\n    .btn{background:var(--accent);color:#fff;padding:12px 16px;border-radius:12px;text-decoration:none;font-weight:700}\\n    .secondary{background:transparent;border:1px solid rgba(120,90,60,0.12);padding:10px 12px;border-radius:12px}\\n    footer{margin-top:28px;font-size:13px;color:rgba(80,60,50,0.7)}\\n    /* subtle SVG backdrop */\\n    .art{position:absolute;inset:0;pointer-events:none;opacity:0.12}\\n    @media (max-width:920px){header.hero{grid-template-columns:1fr} .pillars{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class='wrap'>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='services.html'>Offerings</a>\\n      <a href='blends.html'>Blends</a>\\n      <a href='shop.html'>Market</a>\\n      <a href='pricing.html'>Rates</a>\\n      <a href='about.html'>About</a>\\n      <a href='book.html'>Gather</a>\\n      <a href='contact.html' class='current'>Connect</a>\\n    </nav>\\n\\n    <header class='hero'>\\n      <div class='intro'>\\n        <small style='font-weight:600;color:var(--leaf)'>A series of gentle gatherings</small>\\n        <h1>Conversations & Scheduled Sessions</h1>\\n        <p class='lead'>I hold space for scent-led gatherings, workshops and one-on-one consults. Each event is rooted in safety, intention, and the humble craft of blending. To inquire about an upcoming series or to request a bespoke session, reach out below.</p>\\n\\n        <div class='pillars' aria-hidden='false'>\\n          <div class='pillar'>\\n            <strong>Safety-First</strong>\\n            <div style='font-size:13px;margin-top:6px'>Dilution, patch tests and clear guidance are part of every meeting.</div>\\n          </div>\\n          <div class='pillar'>\\n            <strong>Seasonal Rhythm</strong>\\n            <div style='font-size:13px;margin-top:6px'>Blends and topics follow cycles — breath, warmth, rest, renewal.</div>\\n          </div>\\n          <div class='pillar'>\\n            <strong>Sensory Craft</strong>\\n            <div style='font-size:13px;margin-top:6px'>Simple recipes you can revisit at home — slow and steady.</div>\\n          </div>\\n        </div>\\n\\n        <section class='myths' aria-labelledby='mvstitle'>\\n          <div class='myth'>\\n            <strong>Myth</strong>\\n            <div style='font-size:13px;margin-top:6px'>Essential oils heal every ailment instantly.</div>\\n          </div>\\n          <div class='myth'>\\n            <strong>Truth</strong>\\n            <div style='font-size:13px;margin-top:6px'>Aromas support mood and ritual; they are not a substitute for medical care.</div>\\n          </div>\\n        </section>\\n\\n        <div class='case_notes'>\\n          <div class='case'>\\n            <strong>Case Note — Evening Calm (anonymized)</strong>\\n            <div style='font-size:13px;margin-top:6px'>Group blend workshop used lavender, frankincense and a soft citrus. Emphasis: 1% dilution for rollers, patch test before use.</div>\\n          </div>\\n          <div class='case'>\\n            <strong>Case Note — Studio Series</strong>\\n            <div style='font-size:13px;margin-top:6px'>Mini-lab: participants learned top/middle/base notes and built a personal inhaler for mindfulness practice.</div>\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n      <aside class='mini-card'>\\n        <form class='contact' aria-label='Contact form'>\\n          <label for='name'>Your name</label>\\n          <input id='name' name='name' type='text' placeholder='Your full name'>\\n\\n          <label for='email'>Email</label>\\n          <input id='email' name='email' type='email' placeholder='you@example.com'>\\n\\n          <label for='phone'>Phone</label>\\n          <input id='phone' name='phone' type='text' placeholder='{{PHONE}}'>\\n\\n          <label for='interest'>I am inquiring about</label>\\n          <select id='interest' name='interest'>\\n            <option>Workshop / Series</option>\\n            <option>Private session</option>\\n            <option>Wholesale / partnership</option>\\n            <option>Other</option>\\n          </select>\\n\\n          <label for='date'>Preferred date(s)</label>\\n          <input id='date' name='date' type='text' placeholder='e.g., weekends in May'>\\n\\n          <label for='message'>Message</label>\\n          <textarea id='message' name='message' placeholder='Share a little about intent, group size, or accessibility needs'></textarea>\\n\\n          <label style='font-size:13px'>\\n            <input type='checkbox' id='consent' name='consent' style='margin-right:8px'>\\n            I consent to receive scheduling details by email. I understand this is not medical advice.\\n          </label>\\n\\n          <div class='cta'>\\n            <a class='btn' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n            <button type='button' class='secondary' onclick='submitForm()'>Send inquiry</button>\\n          </div>\\n\\n          <div style='font-size:12px;color:rgba(80,60,50,0.7);margin-top:6px'>Or call <a href='tel:{{PHONE}}' style='color:var(--leaf);text-decoration:none'>{{PHONE}}</a> • email <a href='mailto:{{EMAIL}}' style='color:var(--leaf);text-decoration:none'>{{EMAIL}}</a></div>\\n        </form>\\n      </aside>\\n    </header>\\n\\n    <section class='faq' aria-labelledby='faqtitle'>\\n      <h2 id='faqtitle' style='margin:0 0 8px;color:var(--accent)'>Questions I often answer</h2>\\n      <div class='q'>Dilution — how concentrated should blends be?</div>\\n      <div style='font-size:14px'>For topical use I recommend conservative dilutions: 0.5–2.5% for adults depending on application. For events we provide clear labeling and sample sizes so you can make an informed choice.</div>\\n\\n      <div class='q'>Patch testing</div>\\n      <div style='font-size:14px'>A patch test on a small skin area is an essential step. We guide attendees through a simple patch protocol before topical use. If irritation occurs, discontinue use.</div>\\n\\n      <div class='q'>Pets & aromatic safety</div>\\n      <div style='font-size:14px'>Many oils are potent around animals. In shared spaces we prioritize ventilation, lower concentrations, and opt for pet-friendly alternatives when appropriate. If you are bringing animals, let me know in advance.</div>\\n\\n      <div class='q'>Pregnancy and nursing</div>\\n      <div style='font-size:14px'>Certain oils are contraindicated during pregnancy or lactation. We adapt blends and provide alternatives; always consult a licensed healthcare provider with specific medical questions.</div>\\n\\n      <div class='q'>Can oils replace medical care?</div>\\n      <div style='font-size:14px'>No. Aromatherapy supports well-being through scent and ritual but is not a replacement for professional medical treatment.</div>\\n    </section>\\n\\n    <footer>\\n      <div style='display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap'>\\n        <div>© {{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • Practitioner: {{PRACTITIONER_NAME}}</div>\\n        <div style='font-size:13px'>Favorite blend in the studio: <em>{{FAVORITE_BLEND}}</em></div>\\n      </div>\\n    </footer>\\n  </div>\\n\\n  <!-- Decorative SVG art: warm, hand-drawn inspired pattern -->\\n  <svg class='art' viewBox='0 0 1200 800' preserveAspectRatio='xMidYMid slice' aria-hidden='true'>\\n    <defs>\\n      <linearGradient id='g1' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#fff9f1'/>\\n        <stop offset='1' stop-color='#efe6dc'/>\\n      </linearGradient>\\n      <pattern id='p' width='120' height='120' patternUnits='userSpaceOnUse'>\\n        <rect width='120' height='120' fill='url(#g1)'></rect>\\n        <g fill='none' stroke='#d6c6b4' stroke-width='1.5'>\\n          <path d='M10 30 Q40 10 70 30 T130 30' stroke-linecap='round' opacity='0.9'></path>\\n          <path d='M30 90 Q60 70 90 90' stroke-linecap='round' opacity='0.6'></path>\\n        </g>\\n        <circle cx='20' cy='20' r='2.5' fill='#9f7a52' opacity='0.9'></circle>\\n      </pattern>\\n      <filter id='grain' x='-20%' y='-20%' width='140%' height='140%'>\\n        <feTurbulence baseFrequency='0.9' numOctaves='2' stitchTiles='stitch' result='t'/>\\n        <feColorMatrix type='saturate' values='0'/>\\n        <feBlend in='SourceGraphic' in2='t' mode='overlay'/>\\n      </filter>\\n    </defs>\\n\\n    <rect width='1200' height='800' fill='url(#p)'></rect>\\n    <g transform='translate(60,80)' stroke='#9a6f45' stroke-width='2' stroke-linecap='round' opacity='0.25'>\\n      <path d='M0 40 C100 0 200 80 300 40 C420 -10 520 90 640 40 C760 -10 860 70 1000 30' fill='none'/>\\n    </g>\\n    <g transform='translate(200,520)' opacity='0.14' fill='none' stroke='#7a9a6e'>\\n      <circle cx='0' cy='0' r='60'/>\\n      <circle cx='140' cy='-30' r='36'/>\\n    </g>\\n  </svg>\\n\\n  <script>\\n    function submitForm(){\\n      var name = document.getElementById('name').value.trim();\\n      var email = document.getElementById('email').value.trim();\\n      if(!name || !email){\\n        alert('Please share your name and email so I can follow up.');\\n        return;\\n      }\\n      // Simulated submission — integrate with real backend in production\\n      alert('Thank you, ' + (name.split(' ')[0] || name) + '. I will respond to ' + email + ' within 3 business days.');\\n    }\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"README.md\",\"content\":\"Contact page for the aromatherapy events series (earthy_warm / minimal_poetic).\\\\n\\\\nFiles in this bundle:\\\\n- contact.html — full contact + reservations page for workshops, private bookings and inquiries. Includes: hero, myth_vs_truth, pillars, case_notes, faq, cta.\\\\n\\\\nPlaceholders to replace in your build process: {{BUSINESS_NAME}}, {{TAGLINE}}, {{PHONE}}, {{EMAIL}}, {{PRIMARY_CTA_LABEL}}, {{PRIMARY_CTA_URL}}, {{CITY}}, {{STATE}}, {{PRACTITIONER_NAME}}, {{FAVORITE_BLEND}}.\\\\n\\\\nNotes for devs:\\\\n- Visual richness is achieved with an inline SVG pattern and warm gradients; no external fonts or CDNs used.\\\\n- The page prioritizes safety language (no medical claims) and includes FAQ items for dilution, patch testing, pets, and pregnancy.\\\\n- The contact form is a static UI with a JS stub (submitForm) for demo — replace with real endpoint or progressive enhancement as needed.\\\\n- Recommended: create a companion assets/img/pattern.svg (unique, warm motif) for use across other pages to maintain consistent branding.\\\\n\\\\nAccessibility & content: labels, clear consent checkbox, and readable contrast. Keep tone minimal and poetic; vary copy on other templates to preserve uniqueness.\"}\nBUNDLE_END"
