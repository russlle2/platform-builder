          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Offerings — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--earth-1:#3f2e2a;--earth-2:#7f5a45;--accent:#c89f6b;--bg:#fbf7f2;--muted:#6a5b4b}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--earth-1);background:var(--bg)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px;background:linear-gradient(180deg,rgba(63,46,42,0.04),transparent)}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:10px;background:linear-gradient(135deg,var(--earth-2),var(--accent));display:flex;align-items:center;justify-content:center;color:white;font-weight:700;box-shadow:0 6px 18px rgba(0,0,0,0.08)}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .wrap{max-width:980px;margin:28px auto;padding:24px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    .intro h1{margin:0;font-size:28px;color:var(--earth-1)}\\n    .intro p{color:var(--muted);line-height:1.5}\\n    .panel{background:white;border-radius:12px;padding:18px;box-shadow:0 6px 20px rgba(31,27,24,0.06)}\\n    .muted{color:var(--muted);font-size:14px}\\n    .btn{display:inline-block;background:var(--earth-2);color:white;padding:10px 14px;border-radius:8px;text-decoration:none;font-weight:700}\\n    .alt-cta{background:transparent;border:2px solid var(--earth-2);color:var(--earth-2);padding:8px 12px;border-radius:8px;text-decoration:none}\\n    /* pattern */\\n    .pattern-back{position:fixed;right:-120px;top:-120px;opacity:0.08;pointer-events:none}\\n    /* session planner */\\n    .form-row{margin-bottom:12px}\\n    label{display:block;font-weight:700;margin-bottom:6px}\\n    input[type=text],select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6dcd1;background:transparent}\\n    textarea{min-height:92px}\\n    .summary{white-space:pre-wrap;background:#fff9f3;border-radius:8px;padding:12px;border:1px dashed #e4d5c8}\\n    .copy{background:var(--accent);border:none;padding:8px 10px;border-radius:6px;color:#fff;font-weight:700}\\n    footer{margin:48px 0 12px;text-align:center;color:var(--muted);font-size:13px}\\n    /* small screens */\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.brand .logo{width:48px;height:48px}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern-back\\\" width=\\\"520\\\" height=\\\"520\\\" viewBox=\\\"0 0 520 520\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <pattern id=\\\"p\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(15)\\\">\\n        <rect width=\\\"40\\\" height=\\\"40\\\" fill=\\\"none\\\" />\\n        <circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"3\\\" fill=\\\"#c89f6b\\\" />\\n        <circle cx=\\\"28\\\" cy=\\\"28\\\" r=\\\"2\\\" fill=\\\"#7f5a45\\\" />\\n      </pattern>\\n      <linearGradient id=\\\"g\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#7f5a45\\\" stop-opacity=\\\"0.12\\\" />\\n        <stop offset=\\\"1\\\" stop-color=\\\"#c89f6b\\\" stop-opacity=\\\"0.04\\\" />\\n      </linearGradient>\\n    </defs>\\n    <rect width=\\\"520\\\" height=\\\"520\\\" fill=\\\"url(#p)\\\" />\\n    <rect width=\\\"520\\\" height=\\\"520\\\" fill=\\\"url(#g)\\\"/>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Aromatherapy intensive — services & craft blends</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Grove</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends Lab</a>\\n      <a href=\\\"shop.html\\\">Apothecary</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n      <a href=\\\"about.html\\\">Origins</a>\\n      <a href=\\\"book.html\\\" class=\\\"btn\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <div class=\\\"hero\\\">\\n      <div>\\n        <div class=\\\"panel intro\\\">\\n          <h1>Focused intensives and short-course scent sessions</h1>\\n          <p class=\\\"muted\\\">We craft concentrated aromatherapy sessions that may support emotional focus, rest, and gentle regulation. Choose a guided intensive, or build a plan you can return to at home. Sessions pair scent knowledge with hands-on blending and practical dilution guidance.</p>\\n          <p style=\\\"margin-top:12px\\\"><strong>Phone</strong> <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <strong>Email</strong> <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></p>\\n        </div>\\n\\n        <div style=\\\"display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-top:18px\\\">\\n          <div class=\\\"panel\\\">\\n            <h3 style=\\\"margin-top:0\\\">Signature Intensive</h3>\\n            <p class=\\\"muted\\\">A deep 90–120 minute session for concentrated exploration and a bespoke blend to take away. Pricing and schedule details on the Fees page.</p>\\n            <a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve an Intensive</a>\\n          </div>\\n          <div class=\\\"panel\\\">\\n            <h3 style=\\\"margin-top:0\\\">Short Focus Sessions</h3>\\n            <p class=\\\"muted\\\">40–60 minute appointments for a targeted concern and a small practice you can repeat.</p>\\n            <a class=\\\"alt-cta\\\" href=\\\"book.html\\\">Schedule a Short Session</a>\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0\\\">Session Planner</h3>\\n        <p class=\\\"muted\\\">Build a simple plan for your next session. The export button copies a plain-text plan you can paste into notes or email.</p>\\n        <div style=\\\"margin-top:10px\\\">\\n          <div class=\\\"form-row\\\">\\n            <label for=\\\"goal\\\">What would you like to explore?</label>\\n            <select id=\\\"goal\\\">\\n              <option>Calm & settling</option>\\n              <option>Better sleep</option>\\n              <option>Focus & clarity</option>\\n              <option>Emotional release</option>\\n              <option>Custom: physical ease</option>\\n            </select>\\n          </div>\\n          <div class=\\\"form-row\\\">\\n            <label for=\\\"length\\\">Preferred session length</label>\\n            <select id=\\\"length\\\">\\n              <option>40 minutes</option>\\n              <option>60 minutes</option>\\n              <option>90 minutes</option>\\n              <option>120 minutes</option>\\n            </select>\\n          </div>\\n          <div class=\\\"form-row\\\">\\n            <label for=\\\"sensitivity\\\">Aromas to avoid or sensitivities</label>\\n            <input id=\\\"sensitivity\\\" type=\\\"text\\\" placeholder=\\\"E.g., citrus, eucalyptus, none\\\">\\n          </div>\\n          <div class=\\\"form-row\\\">\\n            <label for=\\\"notes\\\">Short context or notes (optional)</label>\\n            <textarea id=\\\"notes\\\" placeholder=\\\"Anything you'd like the practitioner to know\\\"></textarea>\\n          </div>\\n          <div style=\\\"display:flex;gap:8px;align-items:center\\\">\\n            <button id=\\\"planBtn\\\" class=\\\"btn\\\">Compose Plan</button>\\n            <button id=\\\"clearBtn\\\" class=\\\"alt-cta\\\">Clear</button>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <div class=\\\"summary\\\" id=\\\"planSummary\\\">Your personalized session summary will appear here.</div>\\n            <div style=\\\"display:flex;gap:8px;margin-top:8px\\\">\\n              <button id=\\\"copyPlan\\\" class=\\\"copy\\\">Copy Summary</button>\\n              <a href=\\\"book.html\\\" class=\\\"alt-cta\\\">Book this session</a>\\n            </div>\\n          </div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:22px\\\">\\n      <div class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0\\\">How an intensive unfolds</h3>\\n        <ol class=\\\"muted\\\">\\n          <li>Arrival & short intake to note sensitivities and context.</li>\\n          <li>Guided scent exploration and in-session blending.</li>\\n          <li>Integration practices and dilution guidance for safe home use.</li>\\n          <li>A take-home blend and written notes to support practice.</li>\\n        </ol>\\n      </div>\\n      <div class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0\\\">Who may benefit</h3>\\n        <p class=\\\"muted\\\">People seeking a focused, practitioner-led scent experience that may support rest, attention, or mood regulation. Not a medical service; sessions may support wellbeing alongside care from health professionals.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"panel\\\">\\n      <h3 style=\\\"margin-top:0\\\">Frequently asked — safety first</h3>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px\\\">\\n        <div>\\n          <p class=\\\"muted\\\"><strong>Dilution guidance</strong><br/>Typical guidance we use: 1% = ~6 drops per 30ml carrier; 2% = ~12 drops per 30ml; 3% = ~18 drops per 30ml. We always provide a written dilution chart for your take-away blend.</p>\\n        </div>\\n        <div>\\n          <p class=\\\"muted\\\"><strong>Patch test</strong><br/>We recommend a patch test before topical use: dilute recommended amount and test a small skin area for 24 hours. Discontinue if any irritation occurs.</p>\\n        </div>\\n        <div>\\n          <p class=\\\"muted\\\"><strong>Pregnancy & nursing</strong><br/>If you are pregnant, nursing, or under medical care, consult your healthcare provider. We avoid certain oils during pregnancy and will recommend appropriate alternatives.</p>\\n        </div>\\n        <div>\\n          <p class=\\\"muted\\\"><strong>Pets</strong><br/>Some essential oils can be problematic for pets. We provide pet-aware guidance and suggest veterinary consultation for household safety.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <div style=\\\"display:flex;justify-content:space-between;margin-top:18px;gap:12px;flex-wrap:wrap\\\">\\n      <a class=\\\"btn\\\" href=\\\"book.html\\\">Begin a Guided Intensive</a>\\n      <div class=\\\"muted\\\">Prefer a custom plan? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </div>\\n\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"muted\\\">Serving {{CITY}}, {{STATE}} — Scheduling via online booking or phone.</div>\\n  </footer>\\n\\n  <script>\\n    (function(){\\n      const planBtn = document.getElementById('planBtn');\\n      const copyPlan = document.getElementById('copyPlan');\\n      const clearBtn = document.getElementById('clearBtn');\\n      const summary = document.getElementById('planSummary');\\n\\n      function buildSummary(){\\n        const goal = document.getElementById('goal').value;\\n        const length = document.getElementById('length').value;\\n        const sensitivity = document.getElementById('sensitivity').value || 'None noted';\\n        const notes = document.getElementById('notes').value || 'No extra notes.';\\n\\n        const lines = [];\\n        lines.push('{{BUSINESS_NAME}} — Session Planner');\\n        lines.push('Goal: ' + goal);\\n        lines.push('Preferred length: ' + length);\\n        lines.push('Aromas/sensitivities: ' + sensitivity);\\n        lines.push('Client notes: ' + notes);\\n        lines.push('Suggested flow: Intake → Scent exploration → Short blend craft → Dilution & take-home guidance.');\\n        lines.push('Safety notes: Patch test recommended; follow written dilution chart provided by practitioner.');\\n        lines.push('Next steps: Book at {{PRIMARY_CTA_URL}} or call {{PHONE}}.');\\n\\n        return lines.join('\\\\n');\\n      }\\n\\n      planBtn.addEventListener('click', function(){\\n        summary.textContent = buildSummary();\\n      });\\n\\n      copyPlan.addEventListener('click', function(){\\n        const text = summary.textContent;\\n        navigator.clipboard.writeText(text).then(()=>{\\n          copyPlan.textContent = 'Copied!';\\n          setTimeout(()=> copyPlan.textContent = 'Copy Summary',1500);\\n        });\\n      });\\n\\n      clearBtn.addEventListener('click', function(){\\n        document.getElementById('sensitivity').value='';\\n        document.getElementById('notes').value='';\\n        summary.textContent = 'Your personalized session summary will appear here.';\\n      });\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Blends Lab — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--deep:#2f2b28;--sand:#e9dccf;--honey:#c89f6b;--leaf:#6a8a6b}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;background:linear-gradient(180deg,#fffaf5,#fbf7f2);color:var(--deep)}\\n    header{padding:18px 26px;display:flex;align-items:center;justify-content:space-between}\\n    .logo{width:46px;height:46px;border-radius:10px;background:linear-gradient(45deg,var(--leaf),var(--honey));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800}\\n    nav a{margin-left:12px;color:var(--deep);text-decoration:none;font-weight:600}\\n    .container{max-width:980px;margin:18px auto;padding:18px}\\n    .top{display:flex;align-items:center;justify-content:space-between;gap:12px}\\n    h1{margin:0;font-size:26px}\\n    .lab{display:grid;grid-template-columns:360px 1fr;gap:18px;margin-top:18px}\\n    .card{background:white;padding:14px;border-radius:12px;box-shadow:0 6px 18px rgba(47,43,40,0.06)}\\n    label{display:block;font-weight:700;margin-bottom:6px}\\n    select,input[type=range]{width:100%}\\n    .vibes{display:flex;gap:8px;flex-wrap:wrap}\\n    .vibe{padding:8px 10px;border-radius:8px;background:#fff8f1;border:1px solid #efe1cf;cursor:pointer}\\n    .vibe.active{outline:3px solid rgba(104,78,52,0.14)}\\n    .blend-card{border-radius:10px;padding:12px;background:linear-gradient(180deg,#fff,#fff8ef);border:1px solid #efe0cf}\\n    .drops{font-weight:800;color:var(--deep)}\\n    .notes{color:var(--deep);opacity:0.85}\\n    .copy{background:var(--leaf);color:white;border:none;padding:8px 10px;border-radius:8px}\\n    .warning{color:#8a3c2c;font-weight:700}\\n    /* small screens */\\n    @media(max-width:900px){.lab{grid-template-columns:1fr}.top{flex-direction:column;align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">B</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:#6b5b4f\\\">Blends lab & dilution guidance</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends Lab</a>\\n      <a href=\\\"shop.html\\\">Apothecary</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <div class=\\\"top\\\">\\n      <div>\\n        <h1>Blend builder — craft a gentle synergy</h1>\\n        <p style=\\\"margin:6px 0;color:#6b5b4f\\\">Choose a mood direction and we'll suggest a small, safe blend with dilution guidance and a printable blend card. Non-medical; blends may support simple wellness goals.</p>\\n      </div>\\n      <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n        <a href=\\\"book.html\\\" class=\\\"card\\\" style=\\\"text-decoration:none;color:var(--deep);padding:8px 12px;border-radius:8px\\\">Book a Guided Blend</a>\\n        <a href=\\\"shop.html\\\" class=\\\"card\\\" style=\\\"text-decoration:none;color:var(--deep);padding:8px 12px;border-radius:8px\\\">Buy Supplies</a>\\n      </div>\\n    </div>\\n\\n    <section class=\\\"lab\\\">\\n      <aside class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Pick a vibe</h3>\\n        <div class=\\\"vibes\\\" id=\\\"vibeList\\\">\\n          <div class=\\\"vibe\\\" data-vibe=\\\"calm\\\">Calm</div>\\n          <div class=\\\"vibe\\\" data-vibe=\\\"sleep\\\">Sleep</div>\\n          <div class=\\\"vibe\\\" data-vibe=\\\"focus\\\">Focus</div>\\n          <div class=\\\"vibe\\\" data-vibe=\\\"uplift\\\">Uplift</div>\\n          <div class=\\\"vibe\\\" data-vibe=\\\"ground\\\">Ground</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <label for=\\\"strength\\\">Strength (dilution)</label>\\n          <select id=\\\"strength\\\">\\n            <option value=\\\"1\\\">1% — daily wearable (recommended)</option>\\n            <option value=\\\"2\\\">2% — occasional</option>\\n            <option value=\\\"3\\\">3% — short-term focused use</option>\\n          </select>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <label for=\\\"volume\\\">Carrier volume</label>\\n          <select id=\\\"volume\\\">\\n            <option value=\\\"10\\\">10 ml (roller / small bottle)</option>\\n            <option value=\\\"30\\\">30 ml (standard)</option>\\n            <option value=\\\"50\\\">50 ml</option>\\n          </select>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <label for=\\\"age\\\">Intended for</label>\\n          <select id=\\\"age\\\">\\n            <option value=\\\"adult\\\">Adult (18+)</option>\\n            <option value=\\\"teen\\\">Teen (13-17)</option>\\n            <option value=\\\"child\\\">Child (6-12) — use lower dilutions & consult practitioner</option>\\n          </select>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px;display:flex;gap:8px\\\">\\n          <button class=\\\"copy\\\" id=\\\"makeBlend\\\">Create Blend</button>\\n          <button id=\\\"reset\\\" style=\\\"background:transparent;border:1px solid #efe0cf;padding:8px;border-radius:8px\\\">Reset</button>\\n        </div>\\n\\n        <p style=\\\"margin-top:10px;color:#6b5b4f;font-size:13px\\\">All suggested recipes are non-medical. Patch test before topical use and keep blends away from pets' direct contact.</p>\\n      </aside>\\n\\n      <div>\\n        <div class=\\\"card blend-card\\\" id=\\\"resultCard\\\">\\n          <h3 style=\\\"margin-top:0\\\">Blend card</h3>\\n          <div id=\\\"blendName\\\" style=\\\"font-weight:800\\\">Pick a vibe to begin</div>\\n          <div style=\\\"margin-top:8px\\\" id=\\\"recipe\\\" class=\\\"notes\\\">Suggested oils, ratios, and dilution guidance will appear here.</div>\\n\\n          <div style=\\\"display:flex;gap:10px;margin-top:12px;align-items:center\\\">\\n            <button class=\\\"copy\\\" id=\\\"copyBlend\\\">Copy Blend Text</button>\\n            <button id=\\\"downloadCard\\\" style=\\\"background:var(--honey);border:none;padding:8px 10px;border-radius:8px;color:white\\\">Export Text</button>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin-top:0\\\">Dilution quickchart</h4>\\n          <div class=\\\"muted notes\\\">\\n            <p style=\\\"margin:0\\\">Common conversions we use:</p>\\n            <ul style=\\\"margin:8px 0 0 18px;color:#6b5b4f\\\">\\n              <li>1% ≈ 6 drops per 30 ml</li>\\n              <li>2% ≈ 12 drops per 30 ml</li>\\n              <li>3% ≈ 18 drops per 30 ml</li>\\n            </ul>\\n            <p style=\\\"margin-top:8px\\\">Adjust down for children, older adults, or sensitive skin. Always include a written patch-test reminder with blends.</p>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin-top:0\\\">Safety notes</h4>\\n          <p class=\\\"notes\\\">If pregnant, nursing, or under medical care consult a qualified provider. Some oils may be hazardous to pets—seek veterinary guidance. This information is educational and not a substitution for medical advice.</p>\\n        </div>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <script>\\n    (function(){\\n      const vibeList = document.getElementById('vibeList');\\n      const vibes = Array.from(vibeList.querySelectorAll('.vibe'));\\n      const make = document.getElementById('makeBlend');\\n      const reset = document.getElementById('reset');\\n      const blendName = document.getElementById('blendName');\\n      const recipe = document.getElementById('recipe');\\n      const copyBlend = document.getElementById('copyBlend');\\n      const downloadCard = document.getElementById('downloadCard');\\n\\n      const library = {\\n        calm:{title:'Quiet Grove', oils:[{name:'Lavender',pct:40},{name:'Roman Chamomile',pct:30},{name:'Bergamot',pct:30}],notes:'Soft floral-citrus that may support settling.'},\\n        sleep:{title:'Night Harbor', oils:[{name:'Lavender',pct:45},{name:'Vetiver',pct:30},{name:'Cedarwood',pct:25}],notes:'Grounding base with calming floral top-notes.'},\\n        focus:{title:'Clear Stone', oils:[{name:'Rosemary',pct:40},{name:'Basil',pct:30},{name:'Lemon',pct:30}],notes:'Herbaceous-citrus focus blend.'},\\n        uplift:{title:'Bright Hollow', oils:[{name:'Sweet Orange',pct:50},{name:'Grapefruit',pct:30},{name:'Bergamot',pct:20}],notes:'Citrus-forward energy.'},\\n        ground:{title:'Rooting Walk', oils:[{name:'Patchouli',pct:40},{name:'Frankincense',pct:30},{name:'Clary Sage',pct:30}],notes:'Earthy-resinous stabilizing blend.'}\\n      };\\n\\n      let selectedVibe = null;\\n\\n      vibes.forEach(v=> v.addEventListener('click', ()=>{\\n        vibes.forEach(x=>x.classList.remove('active'));\\n        v.classList.add('active');\\n        selectedVibe = v.dataset.vibe;\\n      }));\\n\\n      function computeDrops(volume,percent){\\n        // volume in ml, use 30ml baseline: drops per 30ml at 1% = ~6 drops\\n        const baselineDropsPer30ml = 6; // 1% => 6 drops/30ml\\n        const dropsForPercent = (percent/100) * baselineDropsPer30ml * (volume/30) * document.getElementById('strength').value;\\n        return Math.max(1,Math.round(dropsForPercent));\\n      }\\n\\n      function buildBlend(){\\n        if(!selectedVibe){\\n          blendName.textContent = 'Select a vibe to create a blend';\\n          recipe.textContent = 'No blend selected.';\\n          return;\\n        }\\n\\n        const lib = library[selectedVibe];\\n        const volume = parseInt(document.getElementById('volume').value,10);\\n        const age = document.getElementById('age').value;\\n        const strength = parseInt(document.getElementById('strength').value,10);\\n\\n        const header = lib.title + ' — ' + (strength)+'% dilution in ' + volume + ' ml';\\n        const lines = [];\\n        lines.push(header);\\n        lines.push('Intended for: ' + age);\\n        lines.push('Notes: ' + lib.notes);\\n        lines.push('---');\\n        lines.push('Recipe (approx. drops):');\\n        lib.oils.forEach(o=>{\\n          const drops = computeDrops(volume, o.pct/100 * 100); // pct is distribution; treat spread\\n          lines.push('- ' + o.name + ': ' + drops + ' drops (~' + o.pct + '% of the blend)');\\n        });\\n        lines.push('---');\\n        lines.push('Dilution guidance: ' + strength + '% = approx. ' + (6*strength) + ' drops per 30 ml');\\n        lines.push('Safety: Patch test before topical use; reduce dilution for children/older adults; consult if pregnant or nursing. Keep away from pets without veterinary guidance.');\\n        lines.push('Prepared by: {{BUSINESS_NAME}}');\\n\\n        blendName.textContent = lib.title;\\n        recipe.textContent = lines.join('\\\\n');\\n        return lines.join('\\\\n');\\n      }\\n\\n      make.addEventListener('click', function(){\\n        buildBlend();\\n      });\\n\\n      reset.addEventListener('click', function(){\\n        vibes.forEach(x=>x.classList.remove('active'));\\n        selectedVibe = null;\\n        blendName.textContent = 'Pick a vibe to begin';\\n        recipe.textContent = 'Suggested oils, ratios, and dilution guidance will appear here.';\\n      });\\n\\n      copyBlend.addEventListener('click', function(){\\n        const text = recipe.textContent;\\n        navigator.clipboard.writeText(text).then(()=>{\\n          copyBlend.textContent = 'Copied!';\\n          setTimeout(()=> copyBlend.textContent = 'Copy Blend Text',1400);\\n        });\\n      });\\n\\n      downloadCard.addEventListener('click', function(){\\n        const text = recipe.textContent;\\n        const blob = new Blob([text],{type:'text/plain'});\\n        const url = URL.createObjectURL(blob);\\n        const a = document.createElement('a');\\n        a.href = url; a.download = 'blend-card.txt'; document.body.appendChild(a); a.click(); a.remove();\\n        URL.revokeObjectURL(url);\\n      });\\n\\n      // small UX: allow keyboard first vibe\\n      vibes[0].classList.add('active');\\n      selectedVibe = vibes[0].dataset.vibe;\\n      buildBlend();\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Apothecary — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbf7f2;--card:#fff;--accent:#7f5a45;--muted:#6b5b4f}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;background:var(--bg);color:var(--muted)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px}\\n    .logo{width:46px;height:46px;border-radius:8px;background:linear-gradient(45deg,#7f5a45,#c89f6b);display:flex;align-items:center;justify-content:center;color:white;font-weight:800}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .wrap{max-width:980px;margin:18px auto;padding:18px}\\n    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}\\n    .product{background:var(--card);padding:12px;border-radius:12px;box-shadow:0 8px 20px rgba(47,43,40,0.06)}\\n    .price{font-weight:800;color:var(--accent)}\\n    .small{font-size:13px;color:#6b5b4f}\\n    .cart{position:fixed;right:18px;bottom:18px;background:var(--card);padding:12px;border-radius:12px;box-shadow:0 6px 18px rgba(47,43,40,0.12);width:300px}\\n    button{background:var(--accent);color:white;border:none;padding:8px 10px;border-radius:8px}\\n    .link{background:transparent;border:1px solid #efe1cf;padding:8px;border-radius:8px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">AP</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:#6b5b4f\\\">Apothecary: blends, carrier oils, rollers</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends Lab</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-bottom:14px\\\">\\n      <div>\\n        <h2 style=\\\"margin:0\\\">Shop essentials</h2>\\n        <div class=\\\"small\\\">Start with safe basics. Each product includes dilution & use guidance.</div>\\n      </div>\\n      <div style=\\\"display:flex;gap:8px\\\">\\n        <a href=\\\"blends.html\\\" class=\\\"link\\\">Build a custom blend</a>\\n        <a href=\\\"book.html\\\" class=\\\"link\\\">Book a consult</a>\\n      </div>\\n    </div>\\n\\n    <section class=\\\"grid\\\" id=\\\"products\\\">\\n      <div class=\\\"product\\\" data-id=\\\"lavender-10\\\">\\n        <h3 style=\\\"margin-top:0\\\">Lavender — 10ml</h3>\\n        <div class=\\\"small\\\">Gentle, balancing top note.</div>\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:10px\\\">\\n          <div class=\\\"price\\\">$12</div>\\n          <button data-add=\\\"lavender-10\\\">Add</button>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"product\\\" data-id=\\\"sweet-orange-10\\\">\\n        <h3 style=\\\"margin-top:0\\\">Sweet Orange — 10ml</h3>\\n        <div class=\\\"small\\\">Bright citrus to lift mood.</div>\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:10px\\\">\\n          <div class=\\\"price\\\">$10</div>\\n          <button data-add=\\\"sweet-orange-10\\\">Add</button>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"product\\\" data-id=\\\"carrier-30\\\">\\n        <h3 style=\\\"margin-top:0\\\">Fractionated Coconut — 30ml</h3>\\n        <div class=\\\"small\\\">Neutral carrier for daily blends.</div>\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:10px\\\">\\n          <div class=\\\"price\\\">$14</div>\\n          <button data-add=\\\"carrier-30\\\">Add</button>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"product\\\" data-id=\\\"roller-10\\\">\\n        <h3 style=\\\"margin-top:0\\\">Glass Roller Bottle — 10ml</h3>\\n        <div class=\\\"small\\\">Sterile glass for carry blends.</div>\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:10px\\\">\\n          <div class=\\\"price\\\">$6</div>\\n          <button data-add=\\\"roller-10\\\">Add</button>\\n        </div>\\n      </div>\\n\\n    </section>\\n\\n    <div style=\\\"margin-top:18px\\\" class=\\\"small\\\">Want a curated kit? Book a consult and we'll prepare a labeled set and dilution chart for home use.</div>\\n  </main>\\n\\n  <aside class=\\\"cart\\\" id=\\\"cartBox\\\">\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-bottom:8px\\\">\\n      <strong>Your cart</strong>\\n      <button id=\\\"clearCart\\\" style=\\\"background:transparent;border:1px solid #efe1cf;padding:6px;border-radius:6px\\\">Clear</button>\\n    </div>\\n    <div id=\\\"cartItems\\\" style=\\\"min-height:60px;color:var(--muted)\\\">Empty</div>\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:12px\\\">\\n      <div style=\\\"font-weight:800\\\">Total: <span id=\\\"total\\\">$0</span></div>\\n      <button id=\\\"checkout\\\">Checkout</button>\\n    </div>\\n    <div style=\\\"margin-top:10px;text-align:center\\\">\\n      <a href=\\\"book.html\\\" style=\\\"text-decoration:none;color:var(--muted)\\\">Need help choosing?</a>\\n    </div>\\n  </aside>\\n\\n  <script>\\n    (function(){\\n      const productData = {\\n        'lavender-10':{title:'Lavender — 10ml',price:12},\\n        'sweet-orange-10':{title:'Sweet Orange — 10ml',price:10},\\n        'carrier-30':{title:'Fractionated Coconut — 30ml',price:14},\\n        'roller-10':{title:'Glass Roller Bottle — 10ml',price:6}\\n      };\\n\\n      const cart = {};\\n      const cartItems = document.getElementById('cartItems');\\n      const totalEl = document.getElementById('total');\\n\\n      function renderCart(){\\n        const ids = Object.keys(cart);\\n        if(ids.length===0){cartItems.textContent='Empty'; totalEl.textContent='$0'; return}\\n        cartItems.innerHTML='';\\n        let total = 0;\\n        ids.forEach(id=>{\\n          const qty = cart[id];\\n          const p = productData[id];\\n          const row = document.createElement('div');\\n          row.style.display='flex'; row.style.justifyContent='space-between'; row.style.marginBottom='6px';\\n          row.innerHTML = '<span style=\\\"font-weight:700\\\">'+p.title+'</span><span>'+qty+' × $'+p.price+'</span>';\\n          cartItems.appendChild(row);\\n          total += qty * p.price;\\n        });\\n        totalEl.textContent = '$' + total;\\n      }\\n\\n      document.querySelectorAll('[data-add]').forEach(btn=>{\\n        btn.addEventListener('click', ()=>{\\n          const id = btn.getAttribute('data-add');\\n          cart[id] = (cart[id]||0) + 1;\\n          renderCart();\\n        });\\n      });\\n\\n      document.getElementById('clearCart').addEventListener('click', ()=>{for(const k in cart) delete cart[k]; renderCart();});\\n\\n      document.getElementById('checkout').addEventListener('click', ()=>{\\n        const ids = Object.keys(cart);\\n        if(ids.length===0){ alert('Cart is empty'); return; }\\n        let text = 'Order from {{BUSINESS_NAME}}\\\\n';\\n        let total = 0;\\n        ids.forEach(id=>{const p = productData[id]; text += p.title + ' x ' + cart[id] + ' — $' + (p.price*cart[id]) + '\\\\n'; total += p.price*cart[id];});\\n        text += 'Total: $' + total + '\\\\n';\\n        text += 'Contact: {{EMAIL}} or call {{PHONE}}.\\\\n';\\n        // copy to clipboard\\n        navigator.clipboard.writeText(text).then(()=>{\\n          alert('Order copied to clipboard. Use your email to send it to {{EMAIL}} or follow checkout at {{PRIMARY_CTA_URL}}');\\n        });\\n      });\\n\\n      // initial render\\n      renderCart();\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
