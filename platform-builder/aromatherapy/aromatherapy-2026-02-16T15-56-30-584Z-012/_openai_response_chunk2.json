          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} — Services</title>\\n  <style>\\n    :root{--bg:#fbfbfd;--card:#fff;--accent:#7b6cff;--muted:#6b6b78;--glass:rgba(255,255,255,0.6)}\\n    *{box-sizing:border-box}body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:#222;background:linear-gradient(180deg,var(--bg),#f4f4f7);min-height:100vh}\\n    header{position:relative;padding:28px 32px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;align-items:center;gap:14px}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#4cc3b6);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;box-shadow:0 6px 18px rgba(123,108,255,0.14)}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600}\\n    nav a.cta{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px}\\n\\n    /* hero */\\n    .hero{position:relative;padding:48px 32px 36px;display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    .hero-card{background:var(--card);padding:28px;border-radius:16px;box-shadow:0 10px 30px rgba(16,24,40,0.06)}\\n    h1{margin:0 0 12px;font-size:28px;color:#111}\\n    p.lead{margin:0;color:var(--muted);line-height:1.5}\\n    .cta-row{margin-top:18px;display:flex;gap:12px}\\n    .btn{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .alt{background:transparent;border:1px solid #e7e7ef;padding:10px 14px;border-radius:10px;color:var(--muted)}\\n\\n    /* side pattern */\\    \\n    .pattern-wrap{position:absolute;right:6px;top:6px;bottom:6px;width:42%;pointer-events:none;opacity:0.12}\\n\\n    /* social proof */\\n    .social-proof{display:flex;gap:16px;margin-top:18px;align-items:center}\\n    .testimonial{background:linear-gradient(180deg,#fff,#fbfbff);padding:14px;border-radius:12px;box-shadow:0 6px 18px rgba(30,38,70,0.04);flex:1}\\n    .stars{color:#f2b02b}\\n\\n    /* sections */\\n    main{padding:24px 32px 96px;display:grid;gap:24px;max-width:1100px;margin:0 auto}\\n    .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\\n    .card{background:var(--card);padding:18px;border-radius:12px}\\n\\n    /* process */\\n    .process{display:flex;gap:16px}\\n    .step{flex:1;padding:14px;border-radius:10px;background:linear-gradient(180deg,#fff,#fbfcff)}\\n\\n    /* faq */\\n    .faq{display:grid;grid-template-columns:1fr 1fr;gap:12px}\\n    .q{background:var(--card);padding:14px;border-radius:10px}\\n\\n    /* lead magnet */\\n    .lead-magnet{display:flex;gap:12px;align-items:center;padding:16px;background:linear-gradient(90deg,#fbf8ff,#fff);border-radius:12px}\\n    input[type='email']{padding:10px;border-radius:10px;border:1px solid #e9e9f2;flex:1}\\n\\n    footer{padding:32px;border-top:1px solid #f0f0f6;text-align:center;color:var(--muted)}\\n\\n    /* background svg styles */\\n    .bg-svg{position:fixed;left:0;top:0;width:100%;height:100%;z-index:-1;opacity:0.06}\\n  </style>\\n</head>\\n<body>\\n  <!-- decorative SVG background (unique pattern for services) -->\\n  <svg class='bg-svg' viewBox='0 0 800 600' preserveAspectRatio='xMidYMid slice' xmlns='http://www.w3.org/2000/svg'>\\n    <defs>\\n      <linearGradient id='g1' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#7b6cff'/>\\n        <stop offset='1' stop-color='#4cc3b6'/>\\n      </linearGradient>\\n      <pattern id='p1' width='120' height='120' patternUnits='userSpaceOnUse' patternTransform='rotate(25)'>\\n        <rect width='60' height='60' fill='rgba(255,255,255,0.02)' />\\n        <circle cx='30' cy='30' r='6' fill='url(#g1)' />\\n      </pattern>\\n    </defs>\\n    <rect width='100%' height='100%' fill='url(#p1)'></rect>\\n  </svg>\\n\\n  <header>\\n    <div class='brand'>\\n      <div class='logo'>A</div>\\n      <div>\\n        <div style='font-weight:700'>{{BUSINESS_NAME}}</div>\\n        <div style='font-size:12px;color:var(--muted)'>{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='services.html'>Offerings</a>\\n      <a href='blends.html'>Blends</a>\\n      <a href='shop.html'>Shop</a>\\n      <a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <section class='hero'>\\n    <div class='hero-card'>\\n      <h1>Personalized Aromatherapy Sessions — VIP Day & Signature Consults</h1>\\n      <p class='lead'>Practical, safety-forward aromatherapy designed for daily rituals. Book a focused VIP day to walk away with a tailored blend plan, ritual checklist, and at-home tools.</p>\\n\\n      <div class='social-proof' aria-hidden='false'>\\n        <div class='testimonial'>\\n          <div class='stars'>★★★★★</div>\\n          <div style='font-weight:700;margin-top:6px'>\\\"Grounding, precise guidance — I felt empowered to use oils safely at home.\\\"</div>\\n          <div style='font-size:13px;color:var(--muted)'>— {{PRACTITIONER_NAME}} client</div>\\n        </div>\\n        <div class='testimonial'>\\n          <div style='font-weight:700'>Tele-session friendly</div>\\n          <div style='font-size:13px;color:var(--muted)'>Prefer remote? Detailed blend recipes and follow-ups included.</div>\\n        </div>\\n      </div>\\n\\n      <div class='cta-row'>\\n        <a class='btn' href='{{PRIMARY_CTA_URL}}'>Book a VIP Day</a>\\n        <a class='alt' href='book.html'>Explore Consults</a>\\n      </div>\\n    </div>\\n\\n    <aside style='align-self:start'>\\n      <div class='card'>\\n        <h3 style='margin-top:0'>Quick Services</h3>\\n        <ul style='padding-left:18px;color:var(--muted)'>\\n          <li>60-min Clarity Consult — blend + safety plan</li>\\n          <li>VIP Day — custom blends, ritual mapping, take-home kit</li>\\n          <li>Group workshop — intro to safe home use</li>\\n        </ul>\\n        <div style='margin-top:12px'><a class='btn' href='pricing.html'>See Pricing</a></div>\\n      </div>\\n    </aside>\\n\\n    <div class='pattern-wrap' aria-hidden='true'>\\n      <!-- subtle decorative shape -->\\n      <svg viewBox='0 0 300 300' width='100%' height='100%'>\\n        <g fill='none' stroke='url(#g1)' stroke-opacity='0.12' stroke-width='6'>\\n          <path d='M20 280 C70 200 220 180 280 100' stroke-linecap='round'></path>\\n          <path d='M10 200 C110 120 190 140 290 20' stroke-linecap='round'></path>\\n        </g>\\n        <defs>\\n          <linearGradient id='g1' x1='0' x2='1'>\\n            <stop offset='0' stop-color='#7b6cff' />\\n            <stop offset='1' stop-color='#4cc3b6' />\\n          </linearGradient>\\n        </defs>\\n      </svg>\\n    </div>\\n  </section>\\n\\n  <main>\\n    <section>\\n      <h2 style='margin-bottom:8px'>Why clients value a guided approach</h2>\\n      <div class='grid-3'>\\n        <div class='card'>\\n          <h4>Safety-first formulations</h4>\\n          <p style='color:var(--muted)'>Every blend includes dilution instructions, patch-test guidance, and pet/pregnancy considerations where relevant.</p>\\n        </div>\\n        <div class='card'>\\n          <h4>Practical integration</h4>\\n          <p style='color:var(--muted)'>Advice is framed for real routines — morning focus, evening wind-down, and on-the-go roll-ons.</p>\\n        </div>\\n        <div class='card'>\\n          <h4>Simple supply lists</h4>\\n          <p style='color:var(--muted)'>You receive a straightforward shopping list so you can recreate blends safely at home.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h2>How a VIP Day runs (concise roadmap)</h2>\\n      <div class='process'>\\n        <div class='step'>\\n          <strong>1 — Intake & goals</strong>\\n          <p style='color:var(--muted)'>Pre-session questionnaire to clarify needs, sensitivities, and lifestyle constraints.</p>\\n        </div>\\n        <div class='step'>\\n          <strong>2 — Live creation</strong>\\n          <p style='color:var(--muted)'>We co-create 3–5 blends together with safety notes and dilution measurements.</p>\\n        </div>\\n        <div class='step'>\\n          <strong>3 — Takeaways</strong>\\n          <p style='color:var(--muted)'>You leave with formulas, ritual suggestions, and a resource PDF to reference.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h2>Frequently asked practical questions</h2>\\n      <div class='faq'>\\n        <div class='q'>\\n          <strong>How should I dilute blends?</strong>\\n          <p style='color:var(--muted)'>Dilution varies by use: typical topical roll-ons are 2–5% for adults. Specific dilution guidance is included with each blend. Always follow age- and condition-appropriate safety guidance.</p>\\n        </div>\\n        <div class='q'>\\n          <strong>What is a patch test?</strong>\\n          <p style='color:var(--muted)'>A patch test uses a small diluted amount on inner forearm for 24–48 hours to check for sensitivity. If irritation occurs, discontinue use.</p>\\n        </div>\\n        <div class='q'>\\n          <strong>Are oils safe around pets?</strong>\\n          <p style='color:var(--muted)'>Many essential oils can affect animals. I provide pet-safe alternatives and usage limits; always avoid prolonged exposure and never apply oils directly to pets without veterinary guidance.</p>\\n        </div>\\n        <div class='q'>\\n          <strong>Can pregnant clients participate?</strong>\\n          <p style='color:var(--muted)'>I offer pregnancy-safe options and avoid certain botanicals. Inform me of pregnancy or breastfeeding during intake so I can tailor blends appropriately.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h2>Get my concise guide</h2>\\n      <div class='lead-magnet'>\\n        <div style='flex:1'>\\n          <strong>Free PDF: Safe Aromatherapy Basics</strong>\\n          <div style='color:var(--muted);font-size:13px'>Quick reference on dilution, patch-testing, and 10 starter blends.</div>\\n        </div>\\n        <form onsubmit='event.preventDefault();alert(\\\"Thanks — a download link will be sent to \\\" + document.getElementById(\\\"email\\\").value);'>\\n          <input id='email' type='email' placeholder='Your email' required>\\n          <button type='submit' class='btn'>Send me the guide</button>\\n        </form>\\n      </div>\\n    </section>\\n\\n    <section style='display:flex;gap:16px;align-items:center'>\\n      <div style='flex:1'>\\n        <h2 style='margin:0'>Ready to design your routine?</h2>\\n        <p style='color:var(--muted)'>Book a focused session to get walk-away-ready blends with clear safety notes.</p>\\n      </div>\\n      <div>\\n        <a class='btn' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — Practical aromatherapy in {{CITY}}, {{STATE}} • <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a> • {{PHONE}}</div>\\n  </footer>\\n</body>\\n</html>\"}  \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} — Signature Blends Library</title>\\n  <style>\\n    :root{--bg:#fffaf6;--card:#ffffff;--accent:#ff8a65;--muted:#5b5b63}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;background:linear-gradient(180deg,var(--bg),#fff);color:#222}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 28px}\\n    .brand{font-weight:800;color:#333}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .hero{padding:28px;background:linear-gradient(135deg,#fff7f3,#fff);border-bottom:1px solid #fff0ec}\\n    h1{margin:0 0 8px;font-size:26px}\\n    .sub{color:var(--muted)}\\n\\n    .content{max-width:1100px;margin:20px auto;padding:0 20px;display:grid;gap:16px}\\n    .library{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}\\n    .blend{background:var(--card);padding:14px;border-radius:12px;border:1px solid #fff2ee}\\n    .notes{font-size:13px;color:var(--muted)}\\n    .pill{display:inline-block;background:#fff2ea;color:#d65a2b;padding:6px 8px;border-radius:999px;font-weight:700;font-size:12px}\\n\\n    /* background SVG (unique swirl for blends) */\\n    .bg{position:fixed;right:0;bottom:0;width:45%;height:45%;opacity:0.07;z-index:-1}\\n\\n    .safety{background:#fff6f3;padding:12px;border-radius:10px;border:1px solid #ffe6db}\\n    footer{padding:26px;text-align:center;color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <svg class='bg' viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'>\\n    <defs>\\n      <linearGradient id='b1' x1='0' x2='1'><stop offset='0' stop-color='#ff8a65'/><stop offset='1' stop-color='#ffc46b'/></linearGradient>\\n    </defs>\\n    <g fill='none' stroke='url(#b1)' stroke-width='12' stroke-linecap='round'>\\n      <path d='M10 200 C110 90 290 310 390 200' stroke-opacity='0.9'/>\\n      <path d='M10 260 C110 180 290 180 390 260' stroke-opacity='0.6'/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class='brand'>{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='services.html'>Offerings</a>\\n      <a href='blends.html'>Recipes</a>\\n      <a href='shop.html'>Shop</a>\\n      <a href='book.html'>Book</a>\\n    </nav>\\n  </header>\\n\\n  <section class='hero'>\\n    <div class='content'>\\n      <h1>Signature Blends — Notes & safe use tips</h1>\\n      <p class='sub'>A curated library of blends with top/middle/base notes, aroma profiles, and non-medical \\\"supports\\\" statements. All formulas include dilution and safety prompts.</p>\\n    </div>\\n  </section>\\n\\n  <main class='content'>\\n    <section class='safety'>\\n      <strong>Safety reminder:</strong>\\n      <div style='color:var(--muted);margin-top:6px'>These are non-medical suggestions. Always patch test, follow dilution guidance, avoid use with contraindications, and keep essential oils away from children and pets unless specifically indicated as safe.</div>\\n    </section>\\n\\n    <section>\\n      <h2 style='margin:0 0 8px'>Blend library</h2>\\n      <div class='library'>\\n\\n        <div class='blend'>\\n          <h3>Morning Clarity</h3>\\n          <div class='notes'>Top: Lemon, Bergamot — Middle: Rosemary — Base: Vetiver</div>\\n          <p style='margin:8px 0;color:var(--muted)'>A bright citrus-herbal profile. Supports alertness for morning routines. Suggested dilution: 2–3% for adults.</p>\\n        </div>\\n\\n        <div class='blend'>\\n          <h3>Gentle Focus</h3>\\n          <div class='notes'>Top: Sweet Orange — Middle: Clementine, Lavender — Base: Cedarwood</div>\\n          <p style='margin:8px 0;color:var(--muted)'>Sweet-citrus with soft floral heart. Supports steady attention without overstimulation. Avoid direct use for cats; use diffused briefly.</p>\\n        </div>\\n\\n        <div class='blend'>\\n          <h3>Evening Unwind</h3>\\n          <div class='notes'>Top: Mandarin — Middle: Lavender — Base: Chamomile Roman</div>\\n          <p style='margin:8px 0;color:var(--muted)'>Calming, soft floral-citrus. Supports an evening ritual. Use 1–2% dilution for topical sleep roll-ons.</p>\\n        </div>\\n\\n        <div class='blend'>\\n          <h3>Ground & Center</h3>\\n          <div class='notes'>Top: Bergamot — Middle: Frankincense — Base: Patchouli</div>\\n          <p style='margin:8px 0;color:var(--muted)'>Resinous and earthy. Supports moments of grounding and intentional breathwork. Not recommended for pregnancy without tailored substitution.</p>\\n        </div>\\n\\n        <div class='blend'>\\n          <h3>Breath Ease (diffuse)</h3>\\n          <div class='notes'>Top: Eucalyptus Radiata — Middle: Tea Tree — Base: Ravensara</div>\\n          <p style='margin:8px 0;color:var(--muted)'>Camphorous fresh profile for clear, open aroma in air. Use short 30-60 minute diffusions and avoid near pets unless pet-safe alternatives are advised.</p>\\n        </div>\\n\\n        <div class='blend'>\\n          <h3>Joyful Lift</h3>\\n          <div class='notes'>Top: Grapefruit — Middle: Ylang Ylang — Base: Benzoin</div>\\n          <p style='margin:8px 0;color:var(--muted)'>Bright, floral-sweet. Supports mood-boosting moments. Safe topical use at low dilution; avoid during pregnancy unless approved.</p>\\n        </div>\\n\\n        <div class='blend'>\\n          <h3>Calm Belly</h3>\\n          <div class='notes'>Top: Ginger — Middle: Cardamom — Base: Fennel</div>\\n          <p style='margin:8px 0;color:var(--muted)'>Warm-spicy aromatic profile. Supports digestive comfort rituals; apply topically with low dilution to abdomen only if comfortable and after patch testing.</p>\\n        </div>\\n\\n        <div class='blend'>\\n          <h3>Evening Ritual Roll-on</h3>\\n          <div class='notes'>Top: Sweet Marjoram — Middle: Lavender — Base: Copaiba</div>\\n          <p style='margin:8px 0;color:var(--muted)'>A gentle balm-like aroma for pre-bed routines. Designed as a topical roll-on at ~2% dilution for adults.</p>\\n        </div>\\n\\n        <div class='blend'>\\n          <h3>Refresh & Reset</h3>\\n          <div class='notes'>Top: Peppermint — Middle: Spearmint — Base: Basil</div>\\n          <p style='margin:8px 0;color:var(--muted)'>Crisp, minty profile for a midday reset. Keep away from young children and use diluted for topical application.</p>\\n        </div>\\n\\n        <div class='blend'>\\n          <h3>Cozy Hearth</h3>\\n          <div class='notes'>Top: Orange Peel — Middle: Cinnamon Leaf — Base: Clove</div>\\n          <p style='margin:8px 0;color:var(--muted)'>Warm and spicy, reminiscent of cozy kitchens. Use in diffuser intermittently; reduce intensity if sensitive.\\n          </p>\\n        </div>\\n\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h2 style='margin:0 0 8px'>How to use these recipes safely</h2>\\n      <ul style='color:var(--muted)'>\\n        <li>Always perform a patch test for topical use.</li>\\n        <li>Standard adult dilution guidance is included with each blend; reduce concentrations for sensitive skin and older adults.</li>\\n        <li>When diffusing, limit sessions to 30–60 minutes and ventilate the space.</li>\\n        <li>For pregnancy, breastfeeding, medical conditions, or pets, consult before use — personalized substitutions are recommended.</li>\\n      </ul>\\n    </section>\\n\\n    <section style='display:flex;justify-content:space-between;align-items:center;padding:10px 0'>\\n      <div>\\n        <strong>Want custom blends? </strong>\\n        <span style='color:var(--muted)'>Book a consult for personalized, safety-checked formulas.</span>\\n      </div>\\n      <div>\\n        <a style='background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700' href='{{PRIMARY_CTA_URL}}'>Book Custom Formulas</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style='color:var(--muted)'>© {{BUSINESS_NAME}} • Recipes curated by {{PRACTITIONER_NAME}} • <a href='contact.html'>Contact</a></div>\\n  </footer>\\n</body>\\n</html>\"}  \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} — Shop</title>\\n  <style>\\n    :root{--bg:#f6fff9;--card:#ffffff;--accent:#2dbb8f;--muted:#58615f}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;background:var(--bg);color:#222}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 24px}\\n    .brand{font-weight:800}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .hero{padding:28px 24px}\\n    h1{margin:0 0 6px}\\n    .sub{color:var(--muted)}\\n\\n    .catalog{max-width:1100px;margin:18px auto;padding:0 20px;display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\\n    .product{background:var(--card);padding:16px;border-radius:14px;border:1px solid #eaf6ef}\\n    .product h3{margin:8px 0 6px}\\n    .price{color:var(--accent);font-weight:800}\\n    .badge{display:inline-block;padding:6px 8px;background:#e6fff7;color:var(--accent);border-radius:8px;font-weight:700;font-size:12px}\\n\\n    /* small details */\\n    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px}\\n    .desc{color:var(--muted);font-size:13px}\\n    .btn{background:var(--accent);color:#fff;padding:8px 12px;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    .note{max-width:1100px;margin:12px auto;color:var(--muted);padding:0 20px}\\n\\n    .bg-svg{position:fixed;left:0;bottom:0;width:40%;height:40%;z-index:-1;opacity:0.06}\\n    footer{padding:26px;text-align:center;color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <svg class='bg-svg' viewBox='0 0 500 500' xmlns='http://www.w3.org/2000/svg'>\\n    <defs>\\n      <linearGradient id='s1' x1='0' x2='1'><stop offset='0' stop-color='#2dbb8f'/><stop offset='1' stop-color='#88e3c7'/></linearGradient>\\n    </defs>\\n    <g fill='none' stroke='url(#s1)' stroke-width='10' stroke-linecap='round'>\\n      <circle cx='120' cy='380' r='80' stroke-opacity='0.22'/>\\n      <circle cx='260' cy='460' r='120' stroke-opacity='0.12'/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class='brand'>{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='services.html'>Services</a>\\n      <a href='blends.html'>Blends</a>\\n      <a href='shop.html'>Store</a>\\n      <a href='contact.html'>Connect</a>\\n    </nav>\\n  </header>\\n\\n  <section class='hero'>\\n    <div style='max-width:1100px;margin:0 auto;padding:0 20px'>\\n      <h1>Shop — Kits, Roll-ons, and Diffusers</h1>\\n      <p class='sub'>Curated items to support your at-home aromatherapy practice. All product descriptions include safe-use notes.</p>\\n    </div>\\n  </section>\\n\\n  <main>\\n    <div class='catalog'>\\n\\n      <div class='product'>\\n        <div class='badge'>Starter Kit</div>\\n        <h3>Everyday Essentials Kit</h3>\\n        <div class='desc'>Set of 5 single-note oils (Citrus, Lavender, Peppermint, Frankincense, Eucalyptus) + dilution guide card.</div>\\n        <div style='margin-top:12px'><span class='price'>$49</span></div>\\n        <div style='margin-top:12px'><a class='btn' href='{{PRIMARY_CTA_URL}}'>Add to cart</a></div>\\n      </div>\\n\\n      <div class='product'>\\n        <div class='badge'>Handmade</div>\\n        <h3>Travel Roll-on Trio</h3>\\n        <div class='desc'>Three pre-diluted 10ml roll-ons for Focus, Calm, and Sleep. 2%–3% dilutions for adults; label lists ingredients.</div>\\n        <div style='margin-top:12px'><span class='price'>$32</span></div>\\n        <div style='margin-top:12px'><a class='btn' href='{{PRIMARY_CTA_URL}}'>Add to cart</a></div>\\n      </div>\\n\\n      <div class='product'>\\n        <div class='badge'>Eco</div>\\n        <h3>Ultrasonic Diffuser — Pebble</h3>\\n        <div class='desc'>Compact diffuser with variable run times and gentle LED. Includes short guide on safe diffusion windows.</div>\\n        <div style='margin-top:12px'><span class='price'>$59</span></div>\\n        <div style='margin-top:12px'><a class='btn' href='{{PRIMARY_CTA_URL}}'>Add to cart</a></div>\\n      </div>\\n\\n      <div class='product'>\\n        <div class='badge'>Bundle</div>\\n        <h3>Sleep Ritual Kit</h3>\\n        <div class='desc'>Includes Sleep Roll-on, pillow spritz (low dilution), and a 20-min guided wind-down audio download.</div>\\n        <div style='margin-top:12px'><span class='price'>$39</span></div>\\n        <div style='margin-top:12px'><a class='btn' href='{{PRIMARY_CTA_URL}}'>Add to cart</a></div>\\n      </div>\\n\\n      <div class='product'>\\n        <div class='badge'>Hand-blend</div>\\n        <h3>Custom Blend Service (Product)</h3>\\n        <div class='desc'>Purchase a custom-blend appointment; includes formula, a 10ml blended oil, and written safety notes.</div>\\n        <div style='margin-top:12px'><span class='price'>$95</span></div>\\n        <div style='margin-top:12px'><a class='btn' href='book.html'>Reserve slot</a></div>\\n      </div>\\n\\n      <div class='product'>\\n        <div class='badge'>Sample</div>\\n        <h3>Single-Note Sample Set</h3>\\n        <div class='desc'>Six 2ml samples to explore scent notes and sensitivity. Ideal for patch testing before committing to full bottles.</div>\\n        <div style='margin-top:12px'><span class='price'>$18</span></div>\\n        <div style='margin-top:12px'><a class='btn' href='{{PRIMARY_CTA_URL}}'>Add to cart</a></div>\\n      </div>\\n\\n    </div>\\n\\n    <div class='note'>\\n      <strong>Shop safety notes:</strong>\\n      <div style='color:var(--muted)'>Products are not substitutes for medical care. Patch test all topical products before regular use. For pregnancy, breastfeeding, medications, or pet safety, consult before using products. See full FAQ on the Services page for dilution and patch-test guidance.</div>\\n    </div>\\n\\n    <section style='max-width:1100px;margin:18px auto;padding:0 20px'>\\n      <h2 style='margin:0 0 8px'>Common shopping questions</h2>\\n      <div class='grid-2'>\\n        <div>\\n          <h4 style='margin:6px 0'>Dilution guidance</h4>\\n          <p class='desc'>Each topical product lists the dilution on the label. Our roll-ons are crafted for adult use. If you prefer different concentrations, book the custom blend service.</p>\\n        </div>\\n        <div>\\n          <h4 style='margin:6px 0'>Patch tests</h4>\\n          <p class='desc'>Use a 24–48 hour patch test with small amounts of product on inner forearm. Discontinue if redness or irritation occurs.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style='max-width:1100px;margin:18px auto;padding:0 20px;display:flex;justify-content:space-between;align-items:center'>\\n      <div>\\n        <strong>Need a tailored formula instead?</strong>\\n        <div style='color:var(--muted)'>Purchase a custom blend session and receive a small bottle sent to you.</div>\\n      </div>\\n      <div>\\n        <a class='btn' href='book.html'>Book Custom Blend</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • Questions? <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a> • {{PHONE}}</div>\\n  </footer>\\n</body>\\n</html>\"}  \nBUNDLE_END"
        }
