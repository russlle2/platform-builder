          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Services</title>\\n  <style>\\n    :root{--bg1:#F8FBFA;--accent:#7CC6B2;--muted:#6C6C6C;--card:#FFFFFF;--glass:rgba(255,255,255,0.6);--shadow:0 6px 22px rgba(17,24,39,0.08)}\\n    *{box-sizing:border-box}\\n    body{font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:#19323C;background:linear-gradient(180deg,var(--bg1),#F1FBF9);margin:0;line-height:1.45}\\n    header{position:sticky;top:0;backdrop-filter:blur(6px);background:linear-gradient(180deg,rgba(255,255,255,0.6),rgba(255,255,255,0.35));border-bottom:1px solid rgba(25,50,60,0.04);z-index:20}\\n    .nav{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:14px}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,#BEEAD4,#7CC6B2);display:grid;place-items:center;color:#053; font-weight:700}\\n    .links{display:flex;gap:14px;align-items:center}\\n    .links a{color:#0e3b36;text-decoration:none;font-weight:600}\\n    .cta{background:linear-gradient(90deg,#3BB08A,#2DA77A);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    main{max-width:1100px;margin:28px auto;padding:0 20px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;background:linear-gradient(180deg,rgba(255,255,255,0.85),rgba(255,255,255,0.7));padding:36px;border-radius:16px;box-shadow:var(--shadow)}\\n    .hero h1{margin:0;font-size:28px;color:#0b3a35}\\n    .hero p{margin:12px 0;color:var(--muted)}\\n    .hero .card{background:var(--card);padding:18px;border-radius:12px}\\n    .pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:22px}\\n    .pillar{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 6px 18px rgba(11,52,48,0.06)}\\n    .pillar h3{margin:0 0 8px 0}\\n\\n    .myths{margin-top:26px;display:flex;gap:14px}\\n    .myth,.truth{flex:1;padding:18px;border-radius:12px;background:linear-gradient(180deg,#fff,#FBFFFD)}\\n    .myth h4,.truth h4{margin:0 0 8px 0}\\n\\n    .cases{margin-top:26px}\\n    .case{display:flex;gap:12px;align-items:flex-start;background:var(--card);padding:14px;border-radius:12px;margin-bottom:12px}\\n    .tag{font-size:12px;color:#2b6b5a;background:rgba(43,107,90,0.08);padding:6px;border-radius:8px}\\n\\n    .faq{margin-top:26px;padding:18px;background:linear-gradient(180deg,#FFFFFF,#F7FFFB);border-radius:12px}\\n    .qa{margin-bottom:12px}\\n    .qa h5{margin:0 0 6px 0}\\n\\n    footer{max-width:1100px;margin:36px auto;padding:20px;color:var(--muted);font-size:14px}\\n    .bg-svg{position:absolute;inset:0;pointer-events:none;opacity:0.08}\\n\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.pillars{grid-template-columns:1fr}.nav{padding:10px}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"bg-svg\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><defs><pattern id=\\\"p1\\\" width=\\\"24\\\" height=\\\"24\\\" patternUnits=\\\"userSpaceOnUse\\\"><rect width=\\\"24\\\" height=\\\"24\\\" fill=\\\"#F1FBF6\\\"/><circle cx=\\\"6\\\" cy=\\\"6\\\" r=\\\"1.6\\\" fill=\\\"#CFF2E4\\\"/><circle cx=\\\"18\\\" cy=\\\"18\\\" r=\\\"1.6\\\" fill=\\\"#DFF7EE\\\"/></pattern></defs><rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\"/></svg>\\n\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div class=\\\"brand\\\"><div class=\\\"logo\\\">A</div><div><strong>{{BUSINESS_NAME}}</strong><div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div></div></div>\\n      <nav class=\\\"links\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Sessions</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"shop.html\\\">Shoppe</a>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Personalized aromatherapy sessions — safety-first and sumptuous.</h1>\\n        <p>Elegant, evidence-aware aromatherapy sessions crafted by {{PRACTITIONER_NAME}} in {{CITY}}, {{STATE}}. We blend intention with scent science and a big dollop of sensory delight.</p>\\n        <p style=\\\"margin-top:10px;color:var(--muted)\\\">Sessions are consultation-led, individualized, and include safe dilution recommendations and at-home care tips. Not a substitute for medical advice.</p>\\n        <div style=\\\"margin-top:14px;display:flex;gap:10px;align-items:center\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book an Intensive</a>\\n          <a href=\\\"contact.html\\\" style=\\\"color:var(--muted);text-decoration:underline\\\">Ask a question</a>\\n        </div>\\n      </div>\\n      <aside class=\\\"card\\\">\\n        <h3>Session Snapshot</h3>\\n        <div style=\\\"font-size:14px;color:var(--muted);margin-top:8px\\\">Intake • Aromatic assessment • Custom-blend creation • Safety briefing • Aftercare</div>\\n        <div style=\\\"margin-top:12px;display:flex;gap:8px;align-items:center\\\"><span class=\\\"tag\\\">60–90 min</span><span class=\\\"tag\\\">Virtual & in-person</span></div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"pillars\\\">\\n      <div class=\\\"pillar\\\"><h3>Safety-led</h3><p style=\\\"color:var(--muted);margin:0\\\">Dilution guidance, pregnancy & pet-aware alternatives, and patch-test routines included.</p></div>\\n      <div class=\\\"pillar\\\"><h3>Sensory Design</h3><p style=\\\"color:var(--muted);margin:0\\\">Blends that balance top, middle and base notes for a layered experience.</p></div>\\n      <div class=\\\"pillar\\\"><h3>Intentional</h3><p style=\\\"color:var(--muted);margin:0\\\">Your goals guide the blend—not trends. We co-create with you.</p></div>\\n    </section>\\n\\n    <section class=\\\"myths\\\" aria-labelledby=\\\"mythHeading\\\" style=\\\"margin-top:28px\\\">\\n      <div class=\\\"myth\\\"><h4 id=\\\"mythHeading\\\">Common myth</h4><p style=\\\"color:var(--muted);margin:0\\\">\\\"If a scent feels good it’s always safe.\\\"</p></div>\\n      <div class=\\\"truth\\\"><h4>Truth</h4><p style=\\\"color:var(--muted);margin:0\\\">Pleasure ≠ safety. We account for allergies, pregnancy status, medications and pets when choosing essential oils and dilutions.</p></div>\\n    </section>\\n\\n    <section class=\\\"cases\\\">\\n      <h3 style=\\\"margin:0 0 12px 0\\\">Case notes (anonymized)</h3>\\n      <div class=\\\"case\\\">\\n        <div style=\\\"flex:1\\\">\\n          <strong>Session: Sleep-supporting ritual</strong>\\n          <div style=\\\"color:var(--muted);font-size:14px;margin-top:6px\\\">Custom roll-on created; 2% dilution, patch-test done; alternatives offered for pet households.</div>\\n        </div>\\n        <div style=\\\"text-align:right;color:var(--muted);font-size:13px\\\">Follow-up: 7 days</div>\\n      </div>\\n      <div class=\\\"case\\\">\\n        <div style=\\\"flex:1\\\">\\n          <strong>Session: Focus + calm combo</strong>\\n          <div style=\\\"color:var(--muted);font-size:14px;margin-top:6px\\\">Desktop diffuser profile and inhaler blend provided; client given step-by-step inhaler usage and storage tips.</div>\\n        </div>\\n        <div style=\\\"text-align:right;color:var(--muted);font-size:13px\\\">Follow-up: 2 weeks</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3 style=\\\"margin-top:0\\\">FAQ — practical notes</h3>\\n      <div class=\\\"qa\\\"><h5>How do you decide a dilution?</h5><div style=\\\"color:var(--muted)\\\">Dilution is set by age, skin sensitivity, pregnancy status, and intended use. Typical topical blends range 0.5–3% for adults; roll-ons often 1–2%.</div></div>\\n      <div class=\\\"qa\\\"><h5>Do you require a patch test?</h5><div style=\\\"color:var(--muted)\\\">Yes—patch tests are recommended for topical applications. We guide you through a safe protocol during the session.</div></div>\\n      <div class=\\\"qa\\\"><h5>Are your sessions pet-friendly?</h5><div style=\\\"color:var(--muted)\\\">We always assume pets are in the home and will propose pet-safe alternatives; certain oils are avoided for cats and small animals.</div></div>\\n      <div class=\\\"qa\\\"><h5>Pregnancy & nursing?</h5><div style=\\\"color:var(--muted)\\\">Specific oils are avoided in pregnancy and breastfeeding. We tailor sessions with that safety lens—always consult your healthcare provider for medical questions.</div></div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <h3 style=\\\"margin:0\\\">Ready to craft your scent story?</h3>\\n        <p style=\\\"color:var(--muted);margin:6px 0 0 0\\\">Start with an in-depth intake and a custom blend you can trust.</p>\\n      </div>\\n      <div><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    <div style=\\\"margin-top:8px;color:var(--muted)\\\">All content is educational and safety-focused. Not medical advice.</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Blends Collection</title>\\n  <style>\\n    :root{--bg:#FBFFFE;--accent:#F5A623;--muted:#55656A}\\n    body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;color:#083537;background:linear-gradient(180deg,#FBFFFE,#F0FFFA);margin:0}\\n    header{padding:16px 20px;display:flex;justify-content:space-between;align-items:center}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:44px;height:44px;border-radius:8px;background:linear-gradient(135deg,#FFF1E6,#FFD8A8);display:grid;place-items:center;font-weight:800}\\n    nav a{margin-left:12px;color:#0a4b43;text-decoration:none;font-weight:600}\\n    main{max-width:1100px;margin:18px auto;padding:0 18px}\\n    .intro{background:linear-gradient(90deg,#FFFDF7,#F7FFF3);padding:18px;border-radius:12px;box-shadow:0 6px 20px rgba(8,53,55,0.06)}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:18px}\\n    .blend{background:white;padding:14px;border-radius:12px;box-shadow:0 8px 24px rgba(8,53,55,0.04)}\\n    .blend h4{margin:0 0 8px 0}\\n    .notes{font-size:13px;color:var(--muted);margin:6px 0}\\n    .meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}\\n    .chip{background:linear-gradient(90deg,#FFF2E8,#FFE7C3);padding:6px;border-radius:8px;font-size:13px}\\n    .safety{margin-top:10px;color:#7B7B7B;font-size:13px}\\n    .faq{margin-top:18px;background:rgba(255,255,255,0.7);padding:12px;border-radius:12px}\\n    footer{max-width:1100px;margin:22px auto;padding:12px;color:var(--muted)}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\"><div class=\\\"logo\\\">B</div><div><strong>{{BUSINESS_NAME}}</strong><div style=\\\"font-size:12px;color:var(--muted)\\\">Curated aromas — ethically sourced</div></div></div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Welcome</a>\\n      <a href=\\\"services.html\\\">Work with me</a>\\n      <a href=\\\"shop.html\\\">Buy</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"intro\\\">\\n      <h2 style=\\\"margin:0\\\">Signature blends</h2>\\n      <p style=\\\"margin:8px 0 0 0;color:var(--muted)\\\">A rotating collection of 10 thoughtfully layered blends. Each listing shows top/middle/base notes, an aroma snapshot, and safety-minded \\\"supports\\\" language for intention-setting. Not medical advice.</p>\\n    </section>\\n\\n    <section class=\\\"grid\\\" aria-label=\\\"Blends list\\\">\\n\\n      <div class=\\\"blend\\\">\\n        <h4>Calm Harbor</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Bergamot, Sweet Orange • <strong>Middle:</strong> Lavender, Clary Sage • <strong>Base:</strong> Vetiver</div>\\n        <div style=\\\"color:var(--muted)\\\">A soft citrus-lavender coastal whisper — smooth and grounding.</div>\\n        <div class=\\\"meta\\\"><div class=\\\"chip\\\">Aroma: soothing citrus-floral</div><div class=\\\"chip\\\">Supports: feelings of calm & ritual ease</div></div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h4>Citrus Lift</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Grapefruit, Lemon • <strong>Middle:</strong> Neroli • <strong>Base:</strong> Light Cedarwood</div>\\n        <div style=\\\"color:var(--muted)\\\">Sparkling and bright — a morning-sidekick for focus and mood uplift.</div>\\n        <div class=\\\"meta\\\"><div class=\\\"chip\\\">Aroma: bright citrus-nectar</div><div class=\\\"chip\\\">Supports: alertness and positive energy</div></div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h4>Focus Thread</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Rosemary, Peppermint • <strong>Middle:</strong> Basil • <strong>Base:</strong> Atlas Cedar</div>\\n        <div style=\\\"color:var(--muted)\\\">Herbal clarity with a clean woody finish — ideal for a desk diffuser.</div>\\n        <div class=\\\"meta\\\"><div class=\\\"chip\\\">Aroma: crisp herbal-wood</div><div class=\\\"chip\\\">Supports: concentration and mental clarity</div></div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h4>Sleepy Meadow</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Roman Chamomile • <strong>Middle:</strong> Lavender • <strong>Base:</strong> Sandalwood</div>\\n        <div style=\\\"color:var(--muted)\\\">A tender, floral lullaby — layered for gentle night rituals.</div>\\n        <div class=\\\"meta\\\"><div class=\\\"chip\\\">Aroma: soft floral-wood</div><div class=\\\"chip\\\">Supports: evening calm and bedtime routines</div></div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h4>Grounding Woods</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Black Pepper • <strong>Middle:</strong> Frankincense • <strong>Base:</strong> Patchouli</div>\\n        <div style=\\\"color:var(--muted)\\\">Deep, resinous, earthy — a centering base for meditation or focus.</div>\\n        <div class=\\\"meta\\\"><div class=\\\"chip\\\">Aroma: resinous-earth</div><div class=\\\"chip\\\">Supports: a grounded sense of presence</div></div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h4>Floral Embrace</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Geranium • <strong>Middle:</strong> Rose Otto • <strong>Base:</strong> Benzoin</div>\\n        <div style=\\\"color:var(--muted)\\\">Luxurious, rosy warmth — best used sparingly in personal blends.</div>\\n        <div class=\\\"meta\\\"><div class=\\\"chip\\\">Aroma: rich floral-balsamic</div><div class=\\\"chip\\\">Supports: ritual and reflective moments</div></div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h4>Breathe Easy (gentle)</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Sweet Orange • <strong>Middle:</strong> Eucalyptus (low ratio) • <strong>Base:</strong> Balsam Fir</div>\\n        <div style=\\\"color:var(--muted)\\\">A cautious respiratory-friendly blend with low eucalyptus; not for children under 2 or pets without guidance.</div>\\n        <div class=\\\"meta\\\"><div class=\\\"chip\\\">Aroma: fresh-camphoraceous light</div><div class=\\\"chip\\\">Supports: a clearer breathing sensation in adults</div></div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h4>Zen Workspace</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Lemon • <strong>Middle:</strong> Lavender • <strong>Base:</strong> Rosemary</div>\\n        <div style=\\\"color:var(--muted)\\\">Clean, calm, and slightly herbal; made for shared workspaces when diluted appropriately.</div>\\n        <div class=\\\"meta\\\"><div class=\\\"chip\\\">Aroma: bright herbal</div><div class=\\\"chip\\\">Supports: focus and communal calm</div></div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h4>Joyful Dawn</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Mandarin • <strong>Middle:</strong> Ylang Ylang (small amount) • <strong>Base:</strong> Vanilla CO2</div>\\n        <div style=\\\"color:var(--muted)\\\">Soft, sunny, and plush — a little indulgent, great for morning routines.</div>\\n        <div class=\\\"meta\\\"><div class=\\\"chip\\\">Aroma: sweet floral-citrus</div><div class=\\\"chip\\\">Supports: bright mood and morning ritual</div></div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <h4>Night Nectar</h4>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Sweet Marjoram • <strong>Middle:</strong> Lavender • <strong>Base:</strong> Myrrh</div>\\n        <div style=\\\"color:var(--muted)\\\">A warm, resinous evening blend for winding down in ritual space.</div>\\n        <div class=\\\"meta\\\"><div class=\\\"chip\\\">Aroma: warm resinous-floral</div><div class=\\\"chip\\\">Supports: evening ritual and reflective closure</div></div>\\n      </div>\\n\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3 style=\\\"margin:0 0 8px 0\\\">Safety notes & FAQ</h3>\\n      <p style=\\\"margin:0;color:var(--muted)\\\"><strong>Dilution:</strong> Typical aromatic use is between 0.5–3% for adults depending on application and oil potency. We always provide exact percentages for topical blends.</p>\\n      <p style=\\\"margin:10px 0 0 0;color:var(--muted)\\\"><strong>Patch test:</strong> Recommended for any topical product—apply a small diluted amount to forearm and observe for 24 hours.</p>\\n      <p style=\\\"margin:10px 0 0 0;color:var(--muted)\\\"><strong>Pets:</strong> Certain oils can be harmful to cats and other animals; we offer pet-safe substitutions and diffusing guidelines.</p>\\n      <p style=\\\"margin:10px 0 0 0;color:var(--muted)\\\"><strong>Pregnancy & nursing:</strong> Some oils are avoided. We adapt blends and always flag contraindicated ingredients.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:16px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <h3 style=\\\"margin:0\\\">Want a bespoke version of a blend?</h3>\\n        <p style=\\\"margin:6px 0 0 0;color:var(--muted)\\\">Book an intensive session and receive a custom dilution, inhaler, or roll-on crafted for you.</p>\\n      </div>\\n      <div><a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"background:linear-gradient(90deg,#FFB86B,#FF8A00);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"text-align:center;color:var(--muted)\\\">{{BUSINESS_NAME}} — handcrafted blends • {{PRACTITIONER_NAME}} • Not medical advice</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Shop</title>\\n  <style>\\n    :root{--bg:#FEFFFC;--card:#FFFFFF;--accent:#6AC1A9;--muted:#556067}\\n    body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,var(--bg),#F6FFFA);margin:0;color:#0b3a35}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:14px 18px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:46px;height:46px;border-radius:12px;background:linear-gradient(135deg,#E8FFF5,#BFEFE0);display:grid;place-items:center}\\n    nav a{margin-left:12px;color:#0a4b43;text-decoration:none}\\n    main{max-width:1100px;margin:18px auto;padding:0 18px}\\n    .hero{background:linear-gradient(90deg,#F4FFF9,#FFFFFF);padding:18px;border-radius:12px;display:flex;justify-content:space-between;align-items:center}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .product{background:var(--card);padding:12px;border-radius:12px;box-shadow:0 8px 24px rgba(5,37,34,0.06);display:flex;flex-direction:column}\\n    .thumb{height:120px;border-radius:10px;background:linear-gradient(180deg,#FFFDF8,#F1FFF7);display:grid;place-items:center;color:var(--muted);font-weight:700}\\n    .name{font-weight:700;margin:8px 0}\\n    .desc{color:var(--muted);font-size:14px}\\n    .price{margin-top:10px;font-weight:800}\\n    .buy{margin-top:12px;padding:8px 10px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#2FA885);color:white;text-decoration:none;text-align:center}\\n    .note{font-size:13px;color:#7B7B7B;margin-top:10px}\\n    footer{max-width:1100px;margin:26px auto;padding:12px;color:var(--muted)}\\n    @media(max-width:980px){.grid{grid-template-columns:repeat(2,1fr)};header{padding:10px}}\\n    @media(max-width:640px){.grid{grid-template-columns:1fr};.hero{flex-direction:column;gap:12px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\"><div class=\\\"logo\\\">S</div><div><strong>{{BUSINESS_NAME}}</strong><div style=\\\"font-size:12px;color:var(--muted)\\\">Shop — carefully curated aromatics</div></div></div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Sessions</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h2 style=\\\"margin:0\\\">Shop — kits, roll-ons & diffusers</h2>\\n        <p style=\\\"margin:8px 0 0 0;color:var(--muted)\\\">Each product includes use guidance, dilution suggestions, and pet/pregnancy notes where applicable. We prioritize safety in every bottle.</p>\\n      </div>\\n      <div><a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"buy\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n    </section>\\n\\n    <section class=\\\"grid\\\" aria-label=\\\"Products\\\">\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"thumb\\\">Starter Diffuser Kit</div>\\n        <div class=\\\"name\\\">Home Starter Kit</div>\\n        <div class=\\\"desc\\\">Ceramic diffuser + 3 travel blends (Calm Harbor, Citrus Lift, Focus Thread).</div>\\n        <div class=\\\"price\\\">$69</div>\\n        <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n        <div class=\\\"note\\\">Includes guide: dilution & diffusing for shared spaces.</div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"thumb\\\">Pocket Roll-On</div>\\n        <div class=\\\"name\\\">Calm Pocket Roll-On</div>\\n        <div class=\\\"desc\\\">2 mL roll-on, 2% dilution. Lavender-forward; safe swaps offered for pets.</div>\\n        <div class=\\\"price\\\">$18</div>\\n        <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n        <div class=\\\"note\\\">Patch-test recommended before topical use.</div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"thumb\\\">Travel Set</div>\\n        <div class=\\\"name\\\">Travel Roller Trio</div>\\n        <div class=\\\"desc\\\">Three 2 mL travel rollers: Dream, Focus, Bright. TSA-friendly packaging.</div>\\n        <div class=\\\"price\\\">$42</div>\\n        <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n        <div class=\\\"note\\\">Dilution indicated on each bottle.</div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"thumb\\\">Diffuser Halo</div>\\n        <div class=\\\"name\\\">Aroma Halo Diffuser</div>\\n        <div class=\\\"desc\\\">Ultrasonic diffuser with soft glow and two mist modes; 200 mL.</div>\\n        <div class=\\\"price\\\">$79</div>\\n        <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n        <div class=\\\"note\\\">Use distilled water; follow cleaning instructions to avoid microbial growth.</div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"thumb\\\">Wooden Inhaler</div>\\n        <div class=\\\"name\\\">Mini Inhaler</div>\\n        <div class=\\\"desc\\\">Personal inhaler with 1 sample blend. Great for workplace inhalation.</div>\\n        <div class=\\\"price\\\">$12</div>\\n        <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n        <div class=\\\"note\\\">Not for use with children under 3 without guidance.</div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"thumb\\\">Room Mist</div>\\n        <div class=\\\"name\\\">Relaxing Room Spray</div>\\n        <div class=\\\"desc\\\">Alcohol-based spray with Calm Harbor profile; safe for fabrics when tested first.</div>\\n        <div class=\\\"price\\\">$22</div>\\n        <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n        <div class=\\\"note\\\">Avoid direct mist on pets and small children.</div>\\n      </div>\\n\\n    </section>\\n\\n    <section style=\\\"margin-top:20px;background:linear-gradient(90deg,#FFFDF7,#F7FFF3);padding:12px;border-radius:12px\\\">\\n      <h3 style=\\\"margin:0\\\">Quick answers</h3>\\n      <div style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Dilution:</strong> We list dilution on topical products; follow instructions. <strong>Patch test:</strong> Always recommended.</div>\\n      <div style=\\\"margin-top:6px;color:var(--muted)\\\"><strong>Pets:</strong> Check product page for pet-friendly notes. <strong>Pregnancy:</strong> Some products are marked with pregnancy-safe guidance; consult your provider for medical questions.</div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <h3 style=\\\"margin:0\\\">Questions about a product?</h3>\\n        <p style=\\\"margin:6px 0 0 0;color:var(--muted)\\\">Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>. We answer safety & ingredient questions before purchase.</p>\\n      </div>\\n      <div><a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"buy\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:1100px;margin:0 auto;text-align:center;color:var(--muted)\\\">© {{BUSINESS_NAME}} • Crafted by {{PRACTITIONER_NAME}} • {{CITY}}, {{STATE}} • All product info is educational.</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
