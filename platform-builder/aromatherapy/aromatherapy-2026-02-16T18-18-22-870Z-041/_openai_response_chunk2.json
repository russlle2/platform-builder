          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Offerings — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#6AA84F;--muted:#6b7280;--bg:#f7fbf6;--card:#ffffff;--glass:rgba(255,255,255,0.6);--shadow:0 8px 24px rgba(15,23,42,0.08);--radius:14px;font-family:Inter,ui-sans-serif,system-ui,Segoe UI,Helvetica,Arial;}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg),#eef7ee);color:#102a14}\\n    .wrap{max-width:1100px;margin:28px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between;gap:16px}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#9ad27a);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;box-shadow:var(--shadow)}\\n    nav{display:flex;gap:12px;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px 12px;border-radius:10px}\\n    nav a.primary{background:var(--card);box-shadow:var(--shadow);color:#083014}\\n    .hero{margin-top:22px;background:linear-gradient(180deg,rgba(106,168,79,0.06),rgba(154,210,122,0.03));padding:28px;border-radius:18px;display:grid;grid-template-columns:1fr 320px;gap:20px;align-items:center}\\n    .hero h1{margin:0;color:#083014;font-size:28px}\\n    .hero p.lead{margin:8px 0 0;color:var(--muted)}\\n    .hero .card{background:var(--card);padding:18px;border-radius:14px;box-shadow:var(--shadow)}\\n    .grid{display:grid;grid-template-columns:1fr 340px;gap:20px;margin-top:18px}\\n    .section{background:var(--card);padding:20px;border-radius:12px;box-shadow:var(--shadow)}\\n    h2{margin:0 0 8px 0;color:#0a2d12}\\n    ul.clean{padding:0;margin:12px 0 0 0;list-style:none}\\n    .pill{display:inline-block;background:var(--glass);padding:8px 10px;border-radius:999px;margin:6px 6px 0 0;color:#234;box-shadow:inset 0 -2px 0 rgba(0,0,0,0.02)}\\n    .cta{display:inline-block;padding:12px 16px;border-radius:12px;background:linear-gradient(90deg,var(--accent),#9ad27a);color:white;text-decoration:none;font-weight:600;box-shadow:0 10px 30px rgba(106,168,79,0.18)}\\n    .list{display:grid;gap:12px}\\n    .service-item{display:flex;gap:12px;align-items:flex-start}\\n    .service-item .meta{font-size:13px;color:var(--muted)}\\n    .price{font-weight:700;color:#15491f}\\n    footer{margin-top:28px;color:var(--muted);font-size:13px;display:flex;justify-content:space-between;align-items:center}\\n    .faq .q{font-weight:600;margin-top:12px}\\n    /* decorative SVG as background */\\n    .bg-svg{position:fixed;right:-10vw;top:-6vh;width:70vw;height:70vh;opacity:0.14;pointer-events:none}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 600 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#cfeecd\\\" />\\n        <stop offset=\\\"1\\\" stop-color=\\\"#e9f7e9\\\" />\\n      </linearGradient>\\n      <pattern id=\\\"p1\\\" width=\\\"120\\\" height=\\\"120\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(12)\\\">\\n        <rect width=\\\"120\\\" height=\\\"120\\\" fill=\\\"url(#g1)\\\"/>\\n        <circle cx=\\\"20\\\" cy=\\\"20\\\" r=\\\"6\\\" fill=\\\"#a7d99a\\\" opacity=\\\"0.55\\\"/>\\n        <circle cx=\\\"80\\\" cy=\\\"100\\\" r=\\\"10\\\" fill=\\\"#78b85b\\\" opacity=\\\"0.18\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\" rx=\\\"80\\\"/>\\n  </svg>\\n\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">A</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\" class=\\\"primary\\\">Offerings</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"shop.html\\\">Shop</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Personalized aromatherapy & a VIP Day for deep ritual</h1>\\n        <p class=\\\"lead\\\">A thoughtful session to design blends and routines tailored to your life and preferences. Safety-first, evidence-aware guidance from {{PRACTITIONER_NAME}} in {{CITY}}, {{STATE}}.</p>\\n        <div style=\\\"margin-top:14px\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a href=\\\"contact.html\\\" style=\\\"margin-left:12px;color:var(--muted);text-decoration:none\\\">Ask a question</a>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">Featured</div>\\n          <div class=\\\"pill\\\">VIP Day</div>\\n        </div>\\n        <div style=\\\"margin-top:12px\\\">\\n          <div style=\\\"font-weight:700;font-size:18px\\\">Aromatherapy VIP Day</div>\\n          <div class=\\\"meta\\\" style=\\\"margin-top:6px\\\">One focused day: intake, blend crafting, practical rituals, take-home kit.</div>\\n          <div style=\\\"margin-top:12px;display:flex;justify-content:space-between;align-items:center\\\">\\n            <div class=\\\"price\\\">From $1,200</div>\\n            <a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve your VIP Day</a>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"grid\\\">\\n      <main class=\\\"section\\\">\\n        <h2>Guided rituals & signature sessions</h2>\\n        <p style=\\\"color:var(--muted);margin:8px 0 16px 0\\\">Sessions emphasize ritual, scent literacy, and at-home integration—no medical promises, just practical care and safety-first protocols.</p>\\n\\n        <div class=\\\"list\\\">\\n          <div class=\\\"service-item\\\">\\n            <div style=\\\"width:8px;height:8px;background:var(--accent);border-radius:4px;margin-top:6px\\\"></div>\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Signature Intake + Custom Blend</div>\\n              <div class=\\\"meta\\\">90–120 minutes · Personalized blend, dilution guidance, take-home sample</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"service-item\\\">\\n            <div style=\\\"width:8px;height:8px;background:#9ad27a;border-radius:4px;margin-top:6px\\\"></div>\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Ritual Coaching Session</div>\\n              <div class=\\\"meta\\\">60 minutes · Scent rituals for daily routines & mindful moments</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"service-item\\\">\\n            <div style=\\\"width:8px;height:8px;background:#cfeecd;border-radius:4px;margin-top:6px\\\"></div>\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Refill + Tune-up</div>\\n              <div class=\\\"meta\\\">30 minutes · Blend adjustment, dilution check, storage tips</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <h2 style=\\\"margin-top:18px\\\">What to expect</h2>\\n        <ul class=\\\"clean\\\">\\n          <li>Intake that respects your history and sensitivities.</li>\\n          <li>Evidence-aware discussion—no medical diagnosis or treatment promises.</li>\\n          <li>Clear dilution and patch-test instructions for home use.</li>\\n        </ul>\\n\\n        <h2 style=\\\"margin-top:18px\\\">Session flow</h2>\\n        <ol style=\\\"color:var(--muted);margin:8px 0 0 18px\\\">\\n          <li>Pre-session intake form</li>\\n          <li>In-depth consultation and scent sampling</li>\\n          <li>Blend formulation and ritual mapping</li>\\n          <li>Take-home oils, label, and care plan</li>\\n        </ol>\\n\\n        <div class=\\\"faq\\\" style=\\\"margin-top:18px\\\">\\n          <h2>Frequently asked — safety & practical</h2>\\n          <div class=\\\"q\\\">How should I dilute essential oils?</div>\\n          <div class=\\\"a\\\" style=\\\"color:var(--muted)\\\">I provide dilution guidelines based on age, sensitivity, and intended application. Typical topical dilutions range from 0.5–5% depending on use; always follow the specific recipe and perform a patch test first.</div>\\n\\n          <div class=\\\"q\\\">What is a patch test?</div>\\n          <div class=\\\"a\\\" style=\\\"color:var(--muted)\\\">A patch test involves applying a small diluted amount to a discreet area of skin and observing for 24–48 hours. It's a key safety step, and I will walk you through it.</div>\\n\\n          <div class=\\\"q\\\">Are your blends safe around pets?</div>\\n          <div class=\\\"a\\\" style=\\\"color:var(--muted)\\\">Some oils can be irritating to animals. I will provide guidance specific to your household and recommend pet-safe options and dispersal methods.</div>\\n\\n          <div class=\\\"q\\\">Pregnancy and breastfeeding notes?</div>\\n          <div class=\\\"a\\\" style=\\\"color:var(--muted)\\\">Certain oils are best avoided during pregnancy and lactation. I do not provide medical advice; I will offer conservative, safety-first recommendations and encourage consultation with your healthcare provider.</div>\\n        </div>\\n      </main>\\n\\n      <aside class=\\\"section\\\">\\n        <h3 style=\\\"margin:0 0 6px 0\\\">Quick schedule & pricing</h3>\\n        <div style=\\\"color:var(--muted);margin-bottom:12px\\\">Block availability varies; VIP Day is limited to monthly slots.</div>\\n        <div style=\\\"display:flex;flex-direction:column;gap:8px\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>Custom Blend Session</div>\\n            <div class=\\\"price\\\">$180</div>\\n          </div>\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>Ritual Coaching (60 min)</div>\\n            <div class=\\\"price\\\">$115</div>\\n          </div>\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>Refill + Tune-up (30 min)</div>\\n            <div class=\\\"price\\\">$55</div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:16px\\\">\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">VIP Day</div>\\n          <div style=\\\"font-weight:700;margin-top:6px\\\">Full-day immersion & blend library</div>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">From $1,200 — email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n        </div>\\n\\n        <div style=\\\"margin-top:16px\\\">\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Book a session</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer>\\n      <div>Serving {{CITY}}, {{STATE}} • {{BUSINESS_NAME}}</div>\\n      <div style=\\\"text-align:right\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Blends — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--teal:#2a9d8f;--soft:#e8fbf7;--card:#ffffff;--muted:#335;--radius:12px;font-family:Inter,system-ui,Segoe UI,Arial}\\n    body{margin:0;background:linear-gradient(180deg,#f9fffb,#f2fcf9);color:#0b2b24}\\n    .wrap{max-width:1100px;margin:24px auto;padding:24px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    .nav{display:flex;gap:10px}\\n    .nav a{color:var(--muted);text-decoration:none;padding:8px 10px;border-radius:10px}\\n    .hero{background:linear-gradient(90deg,#f1fff9,#e7f7f1);padding:18px;border-radius:14px;display:flex;justify-content:space-between;align-items:center}\\n    .hero h1{margin:0;font-size:24px}\\n    .card-list{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:18px}\\n    .blend{background:var(--card);padding:14px;border-radius:12px;box-shadow:0 12px 26px rgba(15,22,18,0.06)}\\n    .notes{font-size:13px;color:var(--muted);margin-top:8px}\\n    .profile{margin-top:6px;color:#1b4f45;font-weight:600}\\n    .supports{margin-top:8px;font-size:13px;color:#3b5a50}\\n    .footer{margin-top:18px;color:var(--muted);font-size:13px}\\n    /* single column on narrow screens */\\n    @media(max-width:760px){.card-list{grid-template-columns:1fr}}\\n    /* decorative SVG */\\n    .pattern{position:absolute;left:-6vw;top:-6vh;width:48vw;height:48vh;opacity:0.12}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 400 400\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <radialGradient id=\\\"rg\\\" cx=\\\"0.3\\\" cy=\\\"0.3\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#bfeee0\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#e8fff8\\\"/>\\n      </radialGradient>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" rx=\\\"60\\\" fill=\\\"url(#rg)\\\" />\\n    <g fill=\\\"#9be0c2\\\" opacity=\\\"0.18\\\">\\n      <circle cx=\\\"80\\\" cy=\\\"60\\\" r=\\\"30\\\"/>\\n      <circle cx=\\\"200\\\" cy=\\\"160\\\" r=\\\"50\\\"/>\\n      <circle cx=\\\"320\\\" cy=\\\"260\\\" r=\\\"36\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">A curated palette of safety-forward aroma blends</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Intro</a>\\n        <a href=\\\"services.html\\\">Sessions</a>\\n        <a href=\\\"blends.html\\\" style=\\\"background:#fff;padding:8px 12px;border-radius:10px;box-shadow:0 8px 18px rgba(11,43,36,0.06)\\\">Blends</a>\\n        <a href=\\\"shop.html\\\">Products</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\" style=\\\"margin-top:16px\\\">\\n      <div>\\n        <h1>Signature blends — small-batch, labeled and safe</h1>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">Each blend includes top/middle/base notes, a brief aroma profile, and suggested ways it supports daily rituals. No clinical claims.</div>\\n      </div>\\n      <div>\\n        <a href=\\\"shop.html\\\" style=\\\"background:var(--teal);color:white;padding:10px 14px;border-radius:12px;text-decoration:none\\\">Shop blends</a>\\n      </div>\\n    </section>\\n\\n    <main style=\\\"margin-top:16px\\\">\\n      <div class=\\\"card-list\\\">\\n\\n        <div class=\\\"blend\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div style=\\\"font-weight:700\\\">Cloud Rest</div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">10 mL</div>\\n          </div>\\n          <div class=\\\"notes\\\">Top: Sweet Orange, Bergamot · Middle: Lavender · Base: Vetiver</div>\\n          <div class=\\\"profile\\\">Soft citrus and herbaceous lavender; gentle, rounded woody base.</div>\\n          <div class=\\\"supports\\\">Supports evening calm and a routine for restful sleep when used responsibly (diffuse briefly and follow dilution guidance).</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div style=\\\"font-weight:700\\\">Morning Clarity</div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">10 mL</div>\\n          </div>\\n          <div class=\\\"notes\\\">Top: Lemon, Grapefruit · Middle: Rosemary · Base: Cedarwood</div>\\n          <div class=\\\"profile\\\">Bright citrus top with an herbaceous lift and grounding cedar base.</div>\\n          <div class=\\\"supports\\\">Supports focus and ritualized morning routines; use short diffusions and avoid direct inhalation of strong undiluted oils.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div style=\\\"font-weight:700\\\">Quietude</div>\\n          <div class=\\\"notes\\\">Top: Petitgrain · Middle: Rose Geranium · Base: Sandalwood</div>\\n          <div class=\\\"profile\\\">Green-floral heart with a creamy, subtle woody finish.</div>\\n          <div class=\\\"supports\\\">Supports reflective practices and journaling; designed for low-sensitivity wearers—still follow patch-test guidance.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div style=\\\"font-weight:700\\\">Warm Anchorage</div>\\n          <div class=\\\"notes\\\">Top: Cardamom · Middle: Clove · Base: Vanilla CO2</div>\\n          <div class=\\\"profile\\\">Spiced, cozy, and warmly gourmand with a rounded sweet base.</div>\\n          <div class=\\\"supports\\\">Supports comfort rituals and mindful evenings; not recommended for cats—see pet safety guidance.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div style=\\\"font-weight:700\\\">Green Walk</div>\\n          <div class=\\\"notes\\\">Top: Pine · Middle: Eucalyptus (low) · Base: Cypress</div>\\n          <div class=\\\"profile\\\">Fresh resinous forest notes with an airy camphoraceous lift kept intentionally mild.</div>\\n          <div class=\\\"supports\\\">Supports a feeling of outdoors and breathing-space rituals; use conservative diffusion around children and pets.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div style=\\\"font-weight:700\\\">Evening Unwind</div>\\n          <div class=\\\"notes\\\">Top: Mandarin · Middle: Chamomile · Base: Benzoin</div>\\n          <div class=\\\"profile\\\">Gentle sweet citrus with chamomile florals and a warm balsamic base.</div>\\n          <div class=\\\"supports\\\">Supports transition-to-bed routines; avoid during early pregnancy unless cleared by your provider—see consultation notes.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div style=\\\"font-weight:700\\\">Focus Garden</div>\\n          <div class=\\\"notes\\\">Top: Bergamot · Middle: Basil · Base: Oakmoss (trace)</div>\\n          <div class=\\\"profile\\\">Herbaceous and subtly citrus with an earthy anchoring note.</div>\\n          <div class=\\\"supports\\\">Supports short bursts of concentration; recommended for brief diffusions and aromatherapy inhalers rather than prolonged continuous diffusion.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div style=\\\"font-weight:700\\\">Gentle Resolve</div>\\n          <div class=\\\"notes\\\">Top: Pink Grapefruit · Middle: Ylang Ylang (low) · Base: Patchouli (light)</div>\\n          <div class=\\\"profile\\\">Lightly floral and citrus-forward with a rounded earthy base.</div>\\n          <div class=\\\"supports\\\">Supports emotionally steadying rituals and measured breathing practices; patch-test recommended for those with sensitive skin.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div style=\\\"font-weight:700\\\">Grounded Reset</div>\\n          <div class=\\\"notes\\\">Top: Juniper · Middle: Marjoram · Base: Atlas Cedar</div>\\n          <div class=\\\"profile\\\">Crisp resinous opening moving into soft herbal warmth and dry wood base.</div>\\n          <div class=\\\"supports\\\">Supports grounding in short contemplative moments; not designed for continuous heavy diffusion around infants.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div style=\\\"font-weight:700\\\">Pocket Ease</div>\\n          <div class=\\\"notes\\\">Top: Spearmint · Middle: Lavender · Base: Fractionated Coconut Oil (carrier blend)</div>\\n          <div class=\\\"profile\\\">Minty-fresh with a calming floral center, formulated as a low-irritant roll-on option.</div>\\n          <div class=\\\"supports\\\">Supports discreet on-the-go rituals for calming; always use diluted blends on skin and perform a patch test.</div>\\n        </div>\\n\\n      </div>\\n\\n      <div class=\\\"footer\\\">Interested in a custom variant? Book a blend consultation with {{PRACTITIONER_NAME}}. Consultations emphasize safe dilution, patch-testing, and household compatibility.</div>\\n\\n      <section style=\\\"margin-top:16px;background:var(--card);padding:12px;border-radius:10px;box-shadow:0 12px 26px rgba(16,34,24,0.06)\\\">\\n        <h3 style=\\\"margin:0 0 6px 0\\\">Safety notes</h3>\\n        <div style=\\\"color:var(--muted)\\\">These blends are created with conservative dilutions and separation of allergenic constituents where possible. They are not medical treatments. If pregnant, breastfeeding, or caring for pets, discuss before use. Always perform a patch test.</div>\\n      </section>\\n    </main>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted);font-size:13px\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Shop — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--primary:#4aa96c;--muted:#374046;--card:#fff;--bg:#fbfff9;font-family:Inter,system-ui,Segoe UI}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg),#eef9ee);color:#07311b}\\n    .wrap{max-width:1100px;margin:24px auto;padding:22px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:8px;text-decoration:none;color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .product{background:var(--card);padding:14px;border-radius:12px;box-shadow:0 12px 26px rgba(10,20,12,0.06);display:flex;flex-direction:column;gap:10px}\\n    .tag{font-size:13px;color:var(--muted)}\\n    .price{font-weight:700;color:#11411f}\\n    .btn{display:inline-block;padding:8px 12px;border-radius:10px;background:linear-gradient(90deg,var(--primary),#7fd297);color:white;text-decoration:none}\\n    .small{font-size:13px;color:var(--muted)}\\n    @media(max-width:980px){.grid{grid-template-columns:repeat(2,1fr)}}\\n    @media(max-width:640px){.grid{grid-template-columns:1fr}}\\n    /* decorative diagonal gradient */\\n    .decor{position:fixed;left:0;bottom:0;width:40vw;height:40vh;opacity:0.08;pointer-events:none;background:linear-gradient(135deg,#bfeecf,#e8f9ef);transform:skewY(-8deg) translateY(10vh)}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"decor\\\" aria-hidden></div>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}} — Shop</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Kits, roll-ons, and diffusers chosen for safe, practical use</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">About</a>\\n        <a href=\\\"services.html\\\">Sessions</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section style=\\\"margin-top:14px;display:flex;justify-content:space-between;align-items:center\\\">\\n        <div style=\\\"color:var(--muted)\\\">All products are non-medical and accompanied by safety/dilution instructions.</div>\\n        <div><a href=\\\"book.html\\\" class=\\\"btn\\\">Order a custom kit</a></div>\\n      </section>\\n\\n      <div class=\\\"grid\\\" style=\\\"margin-top:16px\\\">\\n        <!-- Kit: Starter Ritual Kit -->\\n        <div class=\\\"product\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div style=\\\"font-weight:700\\\">Starter Ritual Kit</div>\\n            <div class=\\\"price\\\">$72</div>\\n          </div>\\n          <div class=\\\"small\\\">Includes three 5 mL blends, a roll-on, and dilution guide.</div>\\n          <div style=\\\"display:flex;gap:8px;margin-top:8px\\\">\\n            <a class=\\\"btn\\\" href=\\\"shop.html#kit-starter\\\">Add to cart</a>\\n            <a href=\\\"blends.html\\\" style=\\\"align-self:center;color:var(--muted);text-decoration:none\\\">See blends</a>\\n          </div>\\n        </div>\\n\\n        <!-- Roll-on: Pocket Ease -->\\n        <div class=\\\"product\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div style=\\\"font-weight:700\\\">Pocket Ease Roll-On (10 mL)</div>\\n            <div class=\\\"price\\\">$18</div>\\n          </div>\\n          <div class=\\\"small\\\">Pre-diluted for on-skin use. Patch test recommended before regular use.</div>\\n          <div style=\\\"display:flex;gap:8px;margin-top:8px\\\">\\n            <a class=\\\"btn\\\" href=\\\"shop.html#pocket-ease\\\">Add to cart</a>\\n            <a href=\\\"contact.html\\\" style=\\\"align-self:center;color:var(--muted);text-decoration:none\\\">Ask about ingredients</a>\\n          </div>\\n        </div>\\n\\n        <!-- Diffuser: Ceramic USB Diffuser -->\\n        <div class=\\\"product\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div style=\\\"font-weight:700\\\">Ceramic USB Diffuser</div>\\n            <div class=\\\"price\\\">$45</div>\\n          </div>\\n          <div class=\\\"small\\\">Quiet, low-output diffuser ideal for short bursts. Includes care tips.</div>\\n          <div style=\\\"display:flex;gap:8px;margin-top:8px\\\">\\n            <a class=\\\"btn\\\" href=\\\"shop.html#diffuser-ceramic\\\">Add to cart</a>\\n            <a href=\\\"services.html\\\" style=\\\"align-self:center;color:var(--muted);text-decoration:none\\\">Diffusion guidance</a>\\n          </div>\\n        </div>\\n\\n        <!-- Kit: Sleep Support Kit -->\\n        <div class=\\\"product\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div style=\\\"font-weight:700\\\">Sleep Support Kit</div>\\n            <div class=\\\"price\\\">$64</div>\\n          </div>\\n          <div class=\\\"small\\\">Cloud Rest 10 mL, sleep roll-on, and bedtime ritual guide.</div>\\n          <div style=\\\"display:flex;gap:8px;margin-top:8px\\\">\\n            <a class=\\\"btn\\\" href=\\\"shop.html#kit-sleep\\\">Add to cart</a>\\n            <a href=\\\"blends.html\\\" style=\\\"align-self:center;color:var(--muted);text-decoration:none\\\">Blend details</a>\\n          </div>\\n        </div>\\n\\n        <!-- Product: Mini Roller Trio -->\\n        <div class=\\\"product\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div style=\\\"font-weight:700\\\">Mini Roller Trio</div>\\n            <div class=\\\"price\\\">$36</div>\\n          </div>\\n          <div class=\\\"small\\\">Three 5 mL pre-diluted rollers: Calm, Focus, Uplift. Great for travel.</div>\\n          <div style=\\\"display:flex;gap:8px;margin-top:8px\\\">\\n            <a class=\\\"btn\\\" href=\\\"shop.html#mini-trio\\\">Add to cart</a>\\n            <a href=\\\"faq.html\\\" style=\\\"align-self:center;color:var(--muted);text-decoration:none\\\">Usage tips</a>\\n          </div>\\n        </div>\\n\\n        <!-- Product: Refill Bottles -->\\n        <div class=\\\"product\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div style=\\\"font-weight:700\\\">Refill Bottles (Set of 3)</div>\\n            <div class=\\\"price\\\">$28</div>\\n          </div>\\n          <div class=\\\"small\\\">Empty amber 10 mL bottles with dropper caps for blends and storage.</div>\\n          <div style=\\\"display:flex;gap:8px;margin-top:8px\\\">\\n            <a class=\\\"btn\\\" href=\\\"shop.html#refill-3\\\">Add to cart</a>\\n            <a href=\\\"contact.html\\\" style=\\\"align-self:center;color:var(--muted);text-decoration:none\\\">Bulk inquiries</a>\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n      <section style=\\\"margin-top:18px;background:var(--card);padding:12px;border-radius:10px;box-shadow:0 12px 26px rgba(10,20,12,0.04)\\\">\\n        <h3 style=\\\"margin:0 0 6px 0\\\">Shopping & safety notes</h3>\\n        <p style=\\\"color:var(--muted);margin:0\\\">All products ship with a label containing dilution and patch-test instructions. If you are pregnant, breastfeeding, or have pets, reach out before ordering so we can recommend appropriate products and usage.</p>\\n      </section>\\n\\n      <section style=\\\"margin-top:12px;background:transparent;padding:6px\\\">\\n        <h4 style=\\\"margin:0 0 6px 0\\\">FAQ (short)</h4>\\n        <div style=\\\"color:var(--muted)\\\">\\n          <strong>How do I dilute roll-ons?</strong> Use the provided pre-diluted rollers, or dilute essential oils into a carrier (fractionated coconut oil) to around 1–3% for personal roll-ons.\\n        </div>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">\\n          <strong>Patch test?</strong> Apply a small diluted amount behind the ear or inner forearm and observe for 24–48 hours.\\n        </div>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">\\n          <strong>Pets?</strong> Some oils (e.g., tea tree, large quantities of eucalyptus) may be unsafe for pets—consult before diffusing or placing oils where animals frequent.\\n        </div>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">\\n          <strong>Pregnancy?</strong> Certain oils should be avoided. We recommend a consult before purchase if pregnant or breastfeeding.</div>\\n      </section>\\n\\n    </main>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted);font-size:13px\\\">Need a custom kit? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>.</footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
