          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investment — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f7fbf9;--card:#ffffff;--accent:#6aa19a;--muted:#6b7b75;--glass:rgba(255,255,255,0.7);--maxw:1100px}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;line-height:1.45;color:#173d3a;background:linear-gradient(180deg,var(--bg),#eef7f5);}\\n    header{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:20px;max-width:var(--maxw);margin:18px auto}\\n    nav a{color:#173d3a;text-decoration:none;margin:0 10px;font-weight:600}\\n    .wrap{max-width:var(--maxw);margin:0 auto;padding:24px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;padding:28px;border-radius:16px;background:linear-gradient(135deg,rgba(106,161,154,0.06),rgba(166,219,212,0.04));box-shadow:0 6px 24px rgba(20,40,36,0.06);}\\n    .title{font-size:28px;color:#0f3331;margin:0 0 8px}\\n    .subtitle{color:var(--muted);margin:0 0 18px}\\n    .card{background:var(--card);padding:20px;border-radius:12px;box-shadow:0 4px 18px rgba(15,51,49,0.06)}\\n    .price-list{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:16px}\\n    .price-item{padding:18px;border-radius:10px;border:1px solid #eef6f5;background:linear-gradient(180deg,#fff,#fbfffe)}\\n    .price-item h3{margin:0 0 6px;font-size:16px;color:#0b3a38}\\n    .price{font-size:20px;font-weight:700;color:var(--accent);margin:6px 0}\\n    .muted{color:var(--muted);font-size:14px}\\n    footer{max-width:var(--maxw);margin:36px auto 80px;padding:24px;text-align:center;color:var(--muted)}\\n    .cta{display:inline-block;padding:12px 18px;border-radius:999px;background:linear-gradient(90deg,var(--accent),#4e8c84);color:#fff;text-decoration:none;font-weight:700}\\n    .grid-2{display:grid;grid-template-columns:1fr 320px;gap:20px}\\n    .faq dt{font-weight:700;margin-top:12px}\\n    .faq dd{margin:6px 0 12px;color:var(--muted)}\\n    .svg-bg{position:fixed;right:-120px;top:-60px;opacity:0.38;transform:rotate(12deg);pointer-events:none}\\n    @media (max-width:880px){.hero,.grid-2{grid-template-columns:1fr;}.price-list{grid-template-columns:1fr}.svg-bg{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"svg-bg\\\" width=\\\"520\\\" height=\\\"520\\\" viewBox=\\\"0 0 520 520\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#cfeae6\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#e7faf7\\\"/></linearGradient>\\n      <pattern id=\\\"p1\\\" width=\\\"60\\\" height=\\\"60\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"60\\\" height=\\\"60\\\" fill=\\\"url(#g1)\\\"/>\\n        <circle cx=\\\"10\\\" cy=\\\"10\\\" r=\\\"3\\\" fill=\\\"#d2efe9\\\"/>\\n        <circle cx=\\\"40\\\" cy=\\\"40\\\" r=\\\"3\\\" fill=\\\"#d2efe9\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"520\\\" height=\\\"520\\\" fill=\\\"url(#p1)\\\" rx=\\\"26\\\"/>\\n  </svg>\\n\\n  <header>\\n    <div style=\\\"display:flex;flex-direction:column\\\">\\n      <strong>{{BUSINESS_NAME}}</strong>\\n      <small style=\\\"color:var(--muted)\\\">{{TAGLINE}}</small>\\n    </div>\\n    <nav aria-label=\\\"Primary\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"pricing.html\\\" style=\\\"opacity:0.95\\\">Invest</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1 class=\\\"title\\\">Thoughtful pricing for bespoke aromatherapy care</h1>\\n        <p class=\\\"subtitle\\\">Clear investment options for sessions and our signature VIP Day — safety-focused, personalized, and guided by scent literacy.</p>\\n        <div class=\\\"card\\\">\\n          <p style=\\\"margin:0 0 8px\\\" class=\\\"muted\\\">Need a custom plan? Ask about package pricing and sliding-scale options during booking.</p>\\n          <a href=\\\"book.html\\\" class=\\\"cta\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n      <aside class=\\\"card\\\">\\n        <h4 style=\\\"margin:0 0 6px\\\">Popular: VIP Day</h4>\\n        <p class=\\\"muted\\\" style=\\\"margin:0 0 12px\\\">Deep work, blend creation, and take-home kit in one focused day with {{PRACTITIONER_NAME}}.</p>\\n        <div style=\\\"font-size:20px;font-weight:700;color:var(--accent)\\\">$1,200</div>\\n        <div style=\\\"margin-top:10px\\\"><small class=\\\"muted\\\">Includes consultation, on-site blending, 30m follow-up, and a starter kit.</small></div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:24px\\\" class=\\\"grid-2\\\">\\n      <div>\\n        <h2 style=\\\"margin:0 0 8px\\\">Packages and single sessions</h2>\\n        <p class=\\\"muted\\\">Options designed for different levels of support: short consults, standard sessions, and immersive VIP experiences.</p>\\n        <div class=\\\"price-list\\\" aria-hidden>\\n          <div class=\\\"price-item\\\">\\n            <h3>Intro Consult</h3>\\n            <div class=\\\"price\\\">$75</div>\\n            <div class=\\\"muted\\\">30 minutes by video — scent history + safe-use tips.</div>\\n          </div>\\n          <div class=\\\"price-item\\\">\\n            <h3>Standard Session</h3>\\n            <div class=\\\"price\\\">$160</div>\\n            <div class=\\\"muted\\\">60 minutes — individualized blend + protocol notes.</div>\\n          </div>\\n          <div class=\\\"price-item\\\">\\n            <h3>VIP Day</h3>\\n            <div class=\\\"price\\\">$1,200</div>\\n            <div class=\\\"muted\\\">Full-day immersive session — co-create blends and a home ritual.</div>\\n          </div>\\n        </div>\\n\\n        <h3 style=\\\"margin-top:18px\\\">Payment & policy</h3>\\n        <p class=\\\"muted\\\">Deposit required for VIP Day. We accept card and bank transfer. Cancellations with 72+ hours notice receive a full credit; within 72 hours, deposits are retained but transferable once.</p>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0 0 6px\\\">What’s included with the VIP Day</h4>\\n          <ul style=\\\"margin:0;padding-left:18px;color:var(--muted)\\\">\\n            <li>Pre-visit questionnaire and scent history</li>\\n            <li>6–8 custom blends scaled for home use</li>\\n            <li>Starter kit of labeled vials and roller bottles</li>\\n            <li>30-minute follow-up for adjustments</li>\\n          </ul>\\n          <div style=\\\"margin-top:12px\\\"><a href=\\\"book.html\\\" class=\\\"cta\\\">Reserve a VIP Day</a></div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h4 style=\\\"margin:0 0 6px\\\">Sliding scale</h4>\\n          <p class=\\\"muted\\\" style=\\\"margin:0\\\">Partial scholarship or payment plan available on a limited basis — please inquire when booking.</p>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">What to expect</h3>\\n      <p class=\\\"muted\\\">Every visit blends clinical care with creativity. We begin with a safety review (allergies, medications, pregnancy, and pet exposure), then move to scent exploration and blend formulation. Recommendations focus on safe topical dilution and odor profiles — not medical diagnosis.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Frequently asked — safety first</h3>\\n      <dl class=\\\"faq\\\">\\n        <dt>How do you determine dilution?</dt>\\n        <dd>We use conservative dilution guidelines tailored to age, skin sensitivity, and intended use. Typical adult topical dilutions range from 1–3% depending on context; we document your personalized dilution on every blend label.</dd>\\n        <dt>Is a patch test recommended?</dt>\\n        <dd>Yes — we always recommend a small patch test (inner forearm) 24–48 hours before wider topical use to check for irritation or allergy.</dd>\\n        <dt>Are essential oils safe around pets?</dt>\\n        <dd>Some oils are poorly tolerated by animals. During your consultation we will review household pets and recommend pet-safe scent strategies and diffuser placement to avoid exposure.</dd>\\n        <dt>What if I’m pregnant?</dt>\\n        <dd>Pregnancy involves special considerations. We follow conservative practice and will avoid certain botanicals and provide pregnancy-safe alternatives. Always consult your care provider for clinical guidance.</dd>\\n      </dl>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px;text-align:center\\\">\\n      <a href=\\\"book.html\\\" class=\\\"cta\\\">Book your session — {{PRIMARY_CTA_LABEL}}</a>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Questions? Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></p>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <small>Serving {{CITY}}, {{STATE}} — {{BUSINESS_NAME}} by {{PRACTITIONER_NAME}}.</small>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#ffffff;--accent:#7bb7a8;--muted:#5d6d69;--card:#fbffff;--max:980px}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,\\\"Segoe UI\\\",Roboto,Arial;color:#0e3330;background:linear-gradient(180deg,#fbfffd,#eef6f4)}\\n    header{padding:20px;max-width:var(--max);margin:18px auto;display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:12px;text-decoration:none;color:#0e3330;font-weight:600}\\n    .container{max-width:var(--max);margin:0 auto;padding:18px}\\n    .lead{display:flex;gap:20px;align-items:flex-start}\\n    .bio{background:var(--card);padding:20px;border-radius:14px;box-shadow:0 6px 24px rgba(14,51,48,0.04)}\\n    .avatar{width:140px;height:140px;border-radius:12px;background:linear-gradient(180deg,#eef7f5,#dff3ef);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--muted)}\\n    h1{margin:0 0 6px}\\n    .pill{display:inline-block;padding:6px 10px;border-radius:999px;background:rgba(123,183,168,0.14);color:var(--accent);font-weight:700}\\n    .ritual{margin-top:16px;padding:14px;border-radius:10px;background:linear-gradient(180deg,#fff,#fbfffe)}\\n    .faq dt{font-weight:700;margin-top:12px}\\n    .faq dd{margin:6px 0 12px;color:var(--muted)}\\n    .svg-orn{position:absolute;left:-40px;top:120px;opacity:0.22;pointer-events:none}\\n    footer{max-width:var(--max);margin:40px auto;text-align:center;color:var(--muted);padding:12px}\\n    @media (max-width:800px){.lead{flex-direction:column}.avatar{margin-bottom:6px}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"svg-orn\\\" width=\\\"360\\\" height=\\\"360\\\" viewBox=\\\"0 0 360 360\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <radialGradient id=\\\"rg1\\\" cx=\\\"30%\\\" cy=\\\"30%\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#e9faf6\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#f6fdfb\\\"/>\\n      </radialGradient>\\n    </defs>\\n    <rect width=\\\"360\\\" height=\\\"360\\\" rx=\\\"30\\\" fill=\\\"url(#rg1)\\\"/>\\n    <g fill=\\\"#d8efe9\\\" opacity=\\\"0.9\\\">\\n      <path d=\\\"M60 40c30 18 60 18 90 0v60c-30 18-60 18-90 0z\\\"/>\\n      <circle cx=\\\"280\\\" cy=\\\"160\\\" r=\\\"6\\\"/>\\n      <circle cx=\\\"240\\\" cy=\\\"200\\\" r=\\\"4\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div style=\\\"display:flex;flex-direction:column\\\">\\n      <strong>{{BUSINESS_NAME}}</strong>\\n      <small style=\\\"color:var(--muted)\\\">{{TAGLINE}}</small>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Welcome</a>\\n      <a href=\\\"services.html\\\">Treatments</a>\\n      <a href=\\\"blends.html\\\">Our Blends</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"lead\\\">\\n      <div class=\\\"avatar\\\">{{PRACTITIONER_NAME}}</div>\\n      <div class=\\\"bio\\\">\\n        <h1>About the practice</h1>\\n        <div class=\\\"pill\\\">Plant-led, safety-first</div>\\n        <p style=\\\"color:var(--muted);margin-top:10px\\\">I’m {{PRACTITIONER_NAME}}, the practitioner behind {{BUSINESS_NAME}}. My approach blends scent education with pragmatic rituals you can keep at home. I aim for evidence-informed safety guidance and creative, personalized blends — never clinical claims.</p>\\n\\n        <div class=\\\"ritual\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">A simple ritual we teach</h3>\\n          <ol style=\\\"margin:0 0 6px;padding-left:18px;color:var(--muted)\\\">\\n            <li>Set intention for the scent session (1–2 minutes).</li>\\n            <li>Explore 6–8 single-note smells in small vials.</li>\\n            <li>Co-create a 1–3 oil blend and label dilution instructions.</li>\\n            <li>Bring the blend into a daily 60-second ritual for 2 weeks and note reactions.</li>\\n          </ol>\\n          <p style=\\\"margin:8px 0 0;color:var(--muted)\\\">We prioritize patch testing, clear dilution labels, and household safety, particularly around children and pets.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\" class=\\\"card\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">How I work</h2>\\n      <p class=\\\"muted\\\">Sessions begin with a structured intake focused on sensitivities, exposures, and lifestyle. We explore aroma profiles in an ordered way so any reactions are easy to spot. If you have pregnancy, chronic conditions, or pets, we adjust blends conservatively — this is about comfort and safe use, not medical treatment.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">What to expect in your first appointment</h2>\\n      <ul style=\\\"color:var(--muted)\\\">\\n        <li>30–45 minute intake and scent exploration</li>\\n        <li>Selection of safe top-notes and base-notes to build blends</li>\\n        <li>Written dilution guidance and storage instructions</li>\\n      </ul>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">FAQ — safety highlights</h3>\\n      <dl class=\\\"faq\\\">\\n        <dt>How do you set dilution percentages?</dt>\\n        <dd>We follow conservative, age-appropriate guidelines and record the percent on every label so you can replicate safe home use.</dd>\\n        <dt>Do I need a patch test?</dt>\\n        <dd>Yes — performing a patch test 24–48 hours before extended topical use is standard practice and reduces risk of irritation.</dd>\\n        <dt>What about pets?</dt>\\n        <dd>We present pet-safe scent plans and diffusion strategies. Certain oils can be harmful to animals — we will avoid those entirely if pets live in the home.</dd>\\n        <dt>Can pregnant clients participate?</dt>\\n        <dd>Pregnancy requires extra caution. We use pregnancy-safe options and will avoid a set of oils known to be contraindicated in pregnancy; consult your prenatal provider about any clinical questions.</dd>\\n      </dl>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;text-align:center\\\">\\n      <a href=\\\"book.html\\\" class=\\\"pill\\\">Schedule a consult — {{PRIMARY_CTA_LABEL}}</a>\\n      <p style=\\\"color:var(--muted);margin-top:8px\\\">Prefer to ask a question? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>.</p>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <small style=\\\"color:var(--muted)\\\">Serving {{CITY}}, {{STATE}} — respectful, safety-forward aromatherapy.</small>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f3fff9;--accent:#4aa08f;--muted:#577670;--card:#ffffff;--max:1040px}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,\\\"Segoe UI\\\",Roboto,Arial;color:#083331;background:linear-gradient(180deg,var(--bg),#eef9f6)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px;max-width:var(--max);margin:14px auto}\\n    nav a{margin-left:12px;text-decoration:none;color:#083331;font-weight:600}\\n    .wrap{max-width:var(--max);margin:0 auto;padding:18px}\\n    .hero{padding:22px;border-radius:14px;background:linear-gradient(90deg,#ffffff,#f8fffb);display:flex;justify-content:space-between;align-items:center}\\n    .hero h1{margin:0;font-size:22px}\\n    .box{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 6px 18px rgba(8,51,49,0.04)}\\n    .availability{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}\\n    .slot{padding:10px 12px;border-radius:8px;background:#f2fcf9;border:1px solid #e6f6f2;color:#06504a}\\n    .muted{color:var(--muted)}\\n    form{display:grid;grid-template-columns:1fr 280px;gap:18px;margin-top:18px}\\n    label{display:block;font-weight:700;margin-bottom:6px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e3efec}\\n    .small{font-size:13px;color:var(--muted)}\\n    .cta{display:inline-block;padding:10px 14px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none;font-weight:700}\\n    .faq dt{font-weight:700;margin-top:12px}\\n    .faq dd{margin:6px 0 12px;color:var(--muted)}\\n    @media (max-width:880px){form{grid-template-columns:1fr}.hero{flex-direction:column;align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div>\\n      <strong>{{BUSINESS_NAME}}</strong>\\n      <div style=\\\"color:var(--muted);font-size:13px\\\">Book a session or secure a VIP Day</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Reserve your time with {{PRACTITIONER_NAME}}</h1>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Select a slot below. VIP Day bookings require a short intake form and deposit.</p>\\n      </div>\\n      <div>\\n        <a href=\\\"pricing.html\\\" class=\\\"cta\\\">See Rates</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"box\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Available sample slots</h3>\\n      <div class=\\\"availability\\\">\\n        <div class=\\\"slot\\\">Mon 10:00 — 11:30</div>\\n        <div class=\\\"slot\\\">Tue 14:00 — 15:30</div>\\n        <div class=\\\"slot\\\">Wed 09:00 — 10:30</div>\\n        <div class=\\\"slot\\\">Thu 13:00 — 15:00 (VIP)</div>\\n        <div class=\\\"slot\\\">Fri 11:00 — 12:30</div>\\n      </div>\\n      <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">These are example availability windows. Actual booking availability is confirmed after submission.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <form class=\\\"box\\\" aria-label=\\\"Booking form\\\">\\n        <div>\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"Your name\\\" required>\\n\\n          <label for=\\\"email\\\" style=\\\"margin-top:10px\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n\\n          <label for=\\\"service\\\" style=\\\"margin-top:10px\\\">Service</label>\\n          <select id=\\\"service\\\" name=\\\"service\\\">\\n            <option>Intro Consult — $75</option>\\n            <option>Standard Session — $160</option>\\n            <option>VIP Day — $1,200</option>\\n          </select>\\n\\n          <label for=\\\"notes\\\" style=\\\"margin-top:10px\\\">Notes (allergies, pets, pregnancy)</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"List any sensitivities, medications, pets, pregnancy, etc.\\\"></textarea>\\n\\n          <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">We will review safety considerations and recommend conservative dilutions. A patch test is recommended for new topical blends.</p>\\n        </div>\\n\\n        <aside style=\\\"display:flex;flex-direction:column;gap:10px\\\">\\n          <div class=\\\"card\\\" style=\\\"padding:12px\\\">\\n            <strong>Booking summary</strong>\\n            <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Selected: VIP Day</div>\\n            <div style=\\\"font-size:18px;font-weight:700;color:var(--accent);margin-top:8px\\\">$1,200</div>\\n            <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Deposit required to secure VIP Day. Follow-up appointment included.</div>\\n          </div>\\n\\n          <div class=\\\"card\\\" style=\\\"padding:12px\\\">\\n            <strong>Safety checklist</strong>\\n            <ul style=\\\"margin:8px 0 0;padding-left:18px;color:var(--muted)\\\">\\n              <li>Perform patch test 24–48 hours before extended topical use</li>\\n              <li>Note any household pets and their access to diffusers</li>\\n              <li>Inform us if you are pregnant or nursing</li>\\n            </ul>\\n          </div>\\n\\n          <div style=\\\"margin-top:auto\\\">\\n            <button type=\\\"submit\\\" class=\\\"cta\\\">Complete booking</button>\\n          </div>\\n        </aside>\\n      </form>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"box\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">What will happen after you submit</h3>\\n      <ol style=\\\"color:var(--muted);margin:0;padding-left:18px\\\">\\n        <li>We receive your request and confirm availability by email.</li>\\n        <li>A short intake will be sent to collect safety information and scent preferences.</li>\\n        <li>Payment instructions and pre-visit guidance (including patch test) will be provided.</li>\\n      </ol>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"box\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">FAQ — practical safety</h3>\\n      <dl class=\\\"faq\\\">\\n        <dt>How should I do a patch test?</dt>\\n        <dd>Apply one drop of the diluted blend to the inside of your forearm and cover with a bandage. Check for redness or irritation at 24 and 48 hours.</dd>\\n        <dt>What dilution is typical?</dt>\\n        <dd>We normally recommend 1–3% for adults for most topical blends; for sensitive skin or elders we may recommend lower dilutions. We will write the exact percentage on your label.</dd>\\n        <dt>Are essential oils safe around my dog or cat?</dt>\\n        <dd>Certain oils are not recommended near pets. We build pet-safe plans and advise on diffuser placement to reduce animal exposure.</dd>\\n        <dt>What if I am pregnant or breastfeeding?</dt>\\n        <dd>We use conservative alternatives and avoid specific botanicals contraindicated in pregnancy. We do not provide medical advice — discuss clinical concerns with your provider.</dd>\\n      </dl>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;text-align:center\\\">\\n      <a href=\\\"contact.html\\\" class=\\\"small\\\" style=\\\"color:var(--muted);text-decoration:underline\\\">Questions before booking? Email {{EMAIL}}</a>\\n      <div style=\\\"margin-top:10px\\\"><a href=\\\"index.html\\\" class=\\\"muted\\\">Back to home</a></div>\\n    </section>\\n  </main>\\n\\n  <footer style=\\\"text-align:center;padding:24px;color:var(--muted)\\\">\\n    <small>Serving {{CITY}}, {{STATE}} — {{BUSINESS_NAME}}. Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></small>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
