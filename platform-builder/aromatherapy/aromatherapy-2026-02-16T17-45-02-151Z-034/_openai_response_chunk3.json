          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Investment & Pricing — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Transparent pricing for aromatherapy intensives and session packages. Safety-forward, personalized blends.\\\" />\\n  <style>\\n    :root{--bg:#fff7f0;--accent:#7a4b2a;--accent-2:#b06b44;--muted:#6b5a50;--card:#fff2ea;--glass:rgba(255,255,255,0.6);--radius:14px}\\n    *{box-sizing:border-box}\\n    body{font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;line-height:1.5;color:var(--muted);margin:0;background:linear-gradient(180deg,var(--bg),#fff);min-height:100vh;display:flex;flex-direction:column}\\n    header{padding:28px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px}\\n    .brand{display:flex;align-items:center;gap:14px}\\n    .logo{width:56px;height:56px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:white;font-weight:700}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 10px;font-weight:600}\\n    nav a:hover{color:var(--accent)}\\n    main{padding:28px;max-width:1100px;margin:0 auto;width:100%}\\n\\n    /* Hero */\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:32px;align-items:center;margin-top:10px}\\n    .hero-card{background:linear-gradient(180deg,rgba(255,255,255,0.9),var(--card));padding:28px;border-radius:18px;box-shadow:0 8px 30px rgba(122,75,42,0.08)}\\n    h1{margin:0 0 8px 0;color:var(--accent)}\\n    p.lead{margin:0;color:var(--muted);font-size:15px}\\n\\n    /* Pricing grid */\\n    .prices{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}\\n    .plan{background:linear-gradient(180deg,white, #fff3ec);padding:20px;border-radius:14px;border:1px solid rgba(122,75,42,0.06)}\\n    .plan h3{margin:0;color:var(--accent)}\\n    .price{font-size:28px;color:var(--accent-2);margin:12px 0;font-weight:800}\\n    ul.benefit{padding-left:18px;margin:8px 0 16px 0;color:var(--muted)}\\n    .plan .cta{display:inline-block;padding:10px 14px;background:var(--accent);color:white;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    /* feature strip */\\n    .strip{margin:28px 0;padding:18px;border-radius:12px;background:linear-gradient(90deg,rgba(184,139,115,0.06),rgba(122,75,42,0.02));display:flex;gap:20px;align-items:center}\\n    .strip svg{width:48px;height:48px;flex:0 0 48px}\\n\\n    /* FAQ brief */\\n    .faq{margin-top:22px;display:grid;grid-template-columns:1fr 1fr;gap:12px}\\n    .faq .q{background:linear-gradient(180deg,#fff,#fff9f6);padding:16px;border-radius:10px;border:1px solid rgba(122,75,42,0.04)}\\n    .small{font-size:13px;color:#6b5a50}\\n\\n    footer{padding:28px;text-align:center;color:var(--muted)}\\n\\n    /* decorative background using inline svg data URI */\\n    body::before{content:\\\"\\\";position:fixed;inset:0;z-index:-1;opacity:0.12;background-image:url('data:image/svg+xml;utf8,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"800\\\" height=\\\"600\\\" viewBox=\\\"0 0 800 600\\\"><defs><linearGradient id=\\\"g\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"%23b06b44\\\" stop-opacity=\\\"0.15\\\"/><stop offset=\\\"1\\\" stop-color=\\\"%237a4b2a\\\" stop-opacity=\\\"0.06\\\"/></linearGradient></defs><rect width=\\\"800\\\" height=\\\"600\\\" fill=\\\"%23fff7f0\\\"/><g fill=\\\"url(%23g)\\\" transform=\\\"rotate(-25 400 300)\\\"><circle cx=\\\"150\\\" cy=\\\"120\\\" r=\\\"120\\\"/><ellipse cx=\\\"430\\\" cy=\\\"480\\\" rx=\\\"220\\\" ry=\\\"80\\\"/></g><g fill=\\\"rgba(122,75,42,0.06)\\\"><path d=\\\"M0 560c60-30 140-40 220-16 120 36 150 0 300-20 120-17 220 40 280 56v20H0z\\\"/></g></svg>');background-repeat:no-repeat;background-position:top right;background-size:65%}\\n\\n    @media(max-width:900px){.hero{grid-template-columns:1fr;}.prices{grid-template-columns:1fr}.hero-card{padding:18px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:800;color:var(--accent)\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"small\\\">Curated aromatherapy · {{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Nest</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Formulas</a>\\n      <a href=\\\"shop.html\\\">Market</a>\\n      <a href=\\\"about.html\\\">Who we are</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <h1>Investment in scent + care</h1>\\n        <p class=\\\"lead\\\">Our pricing is transparent and crafted for deep, safe work. Each package is tailored and includes written blend notes, safety guidance, and a follow-up touchpoint. No medical claims — just thoughtful, professional aromatherapy.</p>\\n        <div class=\\\"strip\\\" style=\\\"margin-top:16px\\\">\\n          <svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"10\\\" stroke=\\\"rgba(122,75,42,0.3)\\\" stroke-width=\\\"1.5\\\"/><path d=\\\"M8 14s2-3 4-3 4 3 4 3\\\" stroke=\\\"rgba(122,75,42,0.5)\\\" stroke-width=\\\"1.5\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/></svg>\\n          <div>\\n            <div style=\\\"font-weight:700;color:var(--accent)\\\">Intensive model — designed for lasting change</div>\\n            <div class=\\\"small\\\">Multi-session packages with personalization, blend continuity, and a clear safety plan.</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside style=\\\"align-self:start\\\">\\n        <div style=\\\"background:linear-gradient(180deg,#fff9f7,#fff2ea);padding:18px;border-radius:12px;border:1px solid rgba(122,75,42,0.05)\\\">\\n          <div style=\\\"font-weight:800;color:var(--accent-2);font-size:18px\\\">Ready for a focused journey?</div>\\n          <p class=\\\"small\\\" style=\\\"margin:6px 0 12px\\\">Book a discovery call to see if the intensive is right for you.</p>\\n          <a class=\\\"plan cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"prices\\\">\\n      <div class=\\\"plan\\\">\\n        <h3>Starter Session</h3>\\n        <div class=\\\"price\\\">$95</div>\\n        <div class=\\\"small\\\">Single 60-minute consultation\\nwith a bespoke inhalation blend sample.</div>\\n        <ul class=\\\"benefit\\\">\\n          <li>One 60-min session</li>\\n          <li>Personalized inhalation blend (sample vial)</li>\\n          <li>Safety & dilution guidance</li>\\n        </ul>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Book a Session</a>\\n      </div>\\n\\n      <div class=\\\"plan\\\">\\n        <h3>Renewal Pack (3)</h3>\\n        <div class=\\\"price\\\">$260</div>\\n        <div class=\\\"small\\\">Three sessions for continuity and refinement.</div>\\n        <ul class=\\\"benefit\\\">\\n          <li>Three 60-min sessions</li>\\n          <li>Refined blends across visits</li>\\n          <li>Between-session check-ins</li>\\n        </ul>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve a Pack</a>\\n      </div>\\n\\n      <div class=\\\"plan\\\" style=\\\"border:2px solid var(--accent);box-shadow:0 10px 30px rgba(122,75,42,0.08)\\\">\\n        <h3>Focused Intensive</h3>\\n        <div class=\\\"price\\\">$680</div>\\n        <div class=\\\"small\\\">Four-session intensive: strategy, personalization, consolidation.</div>\\n        <ul class=\\\"benefit\\\">\\n          <li>Four 75-min sessions</li>\\n          <li>Comprehensive intake + final plan</li>\\n          <li>Two sample blends + written notes</li>\\n        </ul>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Begin the Intensive</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"color:var(--accent)\\\">What your investment includes</h2>\\n      <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Every package includes professional safety checks, patch-test instructions, dilution guidelines, and written blend notes you can keep. We do not offer medical diagnosis or treatment.</div>\\n    </section>\\n\\n    <section class=\\\"faq\\\" aria-label=\\\"pricing faq\\\">\\n      <div class=\\\"q\\\">\\n        <strong>Is there a sliding scale?</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Occasionally — please reach out via {{EMAIL}} to discuss accessibility. Availability is limited.</div>\\n      </div>\\n      <div class=\\\"q\\\">\\n        <strong>What's the cancellation policy?</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Please give 48 hours' notice for reschedules or cancellations. Late cancellations may be charged at full price.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px;padding:18px;background:linear-gradient(180deg,#fff,#fff7f1);border-radius:12px;border:1px dashed rgba(122,75,42,0.06)\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap\\\">\\n        <div>\\n          <div style=\\\"font-weight:800;color:var(--accent)\\\">Want a prep checklist?</div>\\n          <div class=\\\"small\\\">Download a one-page intake & scent prep guide before your first session.</div>\\n        </div>\\n        <div><a class=\\\"plan cta\\\" href=\\\"lead-magnet.html\\\">Get the Prep Guide</a></div>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:900px;margin:0 auto;padding:12px 24px\\\">© <span style=\\\"font-weight:700\\\">{{PRACTITIONER_NAME}}</span> — {{BUSINESS_NAME}} • <span class=\\\"small\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"book.html\\\">Book</a></span></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Meet your aromatherapist: training, philosophy, and the care-first approach.\\\" />\\n  <style>\\n    :root{--bg:#fff8f3;--deep:#5c3a29;--warm:#a6693f;--muted:#6b5a50;--card:#fff2e9}\\n    body{margin:0;font-family:Inter,system-ui,Arial;color:var(--muted);background:linear-gradient(180deg,var(--bg),#fff);min-height:100vh}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 24px}\\n    .nav a{margin-left:12px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .hero{padding:28px;max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 360px;gap:24px;align-items:start}\\n    .panel{background:linear-gradient(180deg,#fff,#fff4ee);padding:20px;border-radius:14px;border:1px solid rgba(166,105,63,0.06)}\\n    h1{color:var(--deep);margin:0}\\n    .tag{color:var(--warm);font-weight:700}\\n    .bio{margin-top:12px;color:var(--muted)}\\n\\n    /* testimony grid */\\n    .proof{display:flex;gap:12px;margin-top:18px}\\n    .card{background:var(--card);padding:14px;border-radius:12px;flex:1;border:1px solid rgba(92,58,41,0.03)}\\n    .sig{font-weight:700;color:var(--deep);margin-top:8px}\\n\\n    /* values */\\n    .values{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:18px}\\n    .value{background:linear-gradient(180deg,#fff,#fff7f3);padding:12px;border-radius:10px}\\n\\n    footer{padding:24px;text-align:center;color:var(--muted);margin-top:34px}\\n\\n    /* leaf motif svg background (inline) */\\n    body::after{content:\\\"\\\";position:fixed;left:8px;bottom:8px;z-index:-1;opacity:0.08;width:360px;height:360px;background-image:url('data:image/svg+xml;utf8,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 200 200\\\"><defs><linearGradient id=\\\"lg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"%23a6693f\\\" stop-opacity=\\\"0.12\\\"/><stop offset=\\\"1\\\" stop-color=\\\"%235c3a29\\\" stop-opacity=\\\"0.08\\\"/></linearGradient></defs><g fill=\\\"url(%23lg)\\\"><path d=\\\"M20 160c30-40 70-50 110-30-18-30-60-50-90-26C6 118 4 158 20 160z\\\"/><ellipse cx=\\\"140\\\" cy=\\\"40\\\" rx=\\\"60\\\" ry=\\\"20\\\"/></g></svg>');background-size:contain;background-repeat:no-repeat}\\n\\n    @media(max-width:900px){.hero{grid-template-columns:1fr}.values{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div style=\\\"width:52px;height:52px;border-radius:10px;background:linear-gradient(135deg,var(--deep),var(--warm));display:grid;place-items:center;color:#fff;font-weight:800\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:800;color:var(--deep)\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Sessions</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"book.html\\\">Schedule</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"panel\\\">\\n        <h1>Hello — I’m {{PRACTITIONER_NAME}}</h1>\\n        <div class=\\\"tag\\\">Aromatherapist, educator, and scent steward</div>\\n        <p class=\\\"bio\\\">I trained in clinical and plant-based aromatherapy and built a practice grounded in safety-first formulation. My work is non-medical: blending aromatic experiences, supporting ritual, and helping clients build sustainable scent habits. I prioritize clear dilution, patch testing, and informed consent.</p>\\n\\n        <h3 style=\\\"margin-top:16px;color:var(--deep)\\\">Approach</h3>\\n        <p class=\\\"small\\\">Every blend is chosen from an evidence-conscious, safety-forward perspective. I avoid recommending topical use without clear dilution plans, and I never claim to diagnose or treat medical conditions. Instead, we co-design practical aromatic tools that fit your life.</p>\\n      </div>\\n\\n      <aside style=\\\"align-self:start\\\">\\n        <div style=\\\"padding:18px;border-radius:12px;background:linear-gradient(180deg,#fff,#fff2e8);border:1px solid rgba(166,105,63,0.04)\\\">\\n          <div style=\\\"font-weight:800;color:var(--warm)\\\">Quick facts</div>\\n          <ul style=\\\"padding-left:16px;margin:8px 0 0 0;color:var(--muted)\\\">\\n            <li>Certified aromatherapist — clinical modules completed</li>\\n            <li>10+ years working with essential oils responsibly</li>\\n            <li>Offers virtual and in-person sessions in {{CITY}}, {{STATE}}</li>\\n          </ul>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"max-width:1100px;margin:18px auto;padding:0 24px\\\">\\n      <h2 style=\\\"color:var(--deep)\\\">What clients say</h2>\\n      <div class=\\\"proof\\\">\\n        <div class=\\\"card\\\">\\n          \\\"Warm, steady, and precise. The blend notes were a game-changer for my nightly routine.\\\"\\n          <div class=\\\"sig\\\">— T.S.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          \\\"I appreciated the safety plan and the dilution instructions. Felt so professional and caring.\\\"\\n          <div class=\\\"sig\\\">— M.R.</div>\\n        </div>\\n      </div>\\n\\n      <h3 style=\\\"margin-top:18px;color:var(--deep)\\\">Core values</h3>\\n      <div class=\\\"values\\\">\\n        <div class=\\\"value\\\"><strong>Safety-first</strong><div class=\\\"small\\\">Clear guidance for blending, dilution, and patch testing.</div></div>\\n        <div class=\\\"value\\\"><strong>Curiosity</strong><div class=\\\"small\\\">We explore aroma preferences and lived experience together.</div></div>\\n        <div class=\\\"value\\\"><strong>Practicality</strong><div class=\\\"small\\\">Blends and rituals that fit your daily life—portable, simple, and delightful.</div></div>\\n      </div>\\n\\n      <section style=\\\"margin-top:18px;padding:14px;border-radius:10px;background:linear-gradient(180deg,#fff,#fff7f1);border:1px solid rgba(92,58,41,0.03)\\\">\\n        <strong>Interested in a meet & greet?</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">A 20-minute discovery call helps us check suitability and safety considerations (pets, pregnancy, medications) before booking a full session.</div>\\n        <div style=\\\"margin-top:10px\\\"><a style=\\\"display:inline-block;padding:10px 14px;background:var(--warm);color:white;border-radius:8px;text-decoration:none;font-weight:700\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule the Call</a></div>\\n      </section>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:900px;margin:0 auto;padding:18px 24px\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • Serving {{CITY}}, {{STATE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Book a Session — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Reserve your aromatherapy consultation or intensive. Safety checks, consent, and clear next steps included.\\\" />\\n  <style>\\n    :root{--bg:#fff7f3;--primary:#7a4b2a;--secondary:#b06b44;--muted:#6b5a50}\\n    body{margin:0;font-family:Inter,system-ui,Arial;color:var(--muted);background:linear-gradient(180deg,var(--bg),#fff);min-height:100vh}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:16px 22px}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .wrap{max-width:980px;margin:18px auto;padding:18px}\\n    .hero{padding:20px;background:linear-gradient(180deg,#fff,#fff4ee);border-radius:14px;border:1px solid rgba(122,75,42,0.04)}\\n    h1{margin:0;color:var(--primary)}\\n    .sub{margin-top:8px}\\n\\n    /* booking form */\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    .form{background:#fff;padding:18px;border-radius:12px;border:1px solid rgba(122,75,42,0.03)}\\n    label{display:block;margin-top:8px;font-weight:700;color:var(--primary)}\\n    input,select,textarea{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid rgba(107,90,80,0.12)}\\n    .btn{display:inline-block;padding:10px 14px;background:var(--primary);color:white;border-radius:10px;text-decoration:none;margin-top:12px;font-weight:800}\\n\\n    /* sidebar */\\n    .side{background:linear-gradient(180deg,#fff,#fff9f8);padding:16px;border-radius:12px;border:1px solid rgba(122,75,42,0.03)}\\n    .muted{font-size:13px;color:var(--muted)}\\n\\n    /* FAQ accordion simple */\\n    details{background:white;padding:10px;border-radius:8px;margin-top:10px;border:1px solid rgba(122,75,42,0.04)}\\n    summary{font-weight:700;color:var(--primary);cursor:pointer}\\n\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}}\\n  </style>\\head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div style=\\\"width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,var(--primary),var(--secondary));display:grid;place-items:center;color:#fff;font-weight:800\\\">A</div>\\n      <div style=\\\"font-weight:800;color:var(--primary)\\\">{{BUSINESS_NAME}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"about.html\\\">About</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <h1>Reserve a spot</h1>\\n      <p class=\\\"sub\\\">Choose a session or begin the intensive. We'll confirm suitability and cover simple safety checks (pets, pregnancy, topical use) before finalizing your appointment.</p>\\n    </section>\\n\\n    <section class=\\\"grid\\\">\\n      <form class=\\\"form\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\">\\n        <label for=\\\"name\\\">Full name</label>\\n        <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"Your name\\\" required />\\n\\n        <label for=\\\"email\\\">Email</label>\\n        <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required />\\n\\n        <label for=\\\"phone\\\">Phone</label>\\n        <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"Optional\\\" />\\n\\n        <label for=\\\"service\\\">Choose a session</label>\\n        <select id=\\\"service\\\" name=\\\"service\\\">\\n          <option>Starter Session — 60 min</option>\\n          <option>Renewal Pack — 3 sessions</option>\\n          <option>Focused Intensive — multi-session</option>\\n        </select>\\n\\n        <label for=\\\"notes\\\">Any notes (allergies, pregnancy, pets, medications)</label>\\n        <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Please share anything relevant to safety\\\"></textarea>\\n\\n        <div style=\\\"margin-top:10px\\\" class=\\\"muted\\\">By booking, you confirm you understand this is non-medical aromatherapy. A patch test or dilution plan may be recommended where topical use is discussed.</div>\\n\\n        <button class=\\\"btn\\\" type=\\\"submit\\\">Request Booking</button>\\n      </form>\\n\\n      <aside class=\\\"side\\\">\\n        <div style=\\\"font-weight:800;color:var(--primary)\\\">Before you come</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Please note the following safety-forward checks we will review:</div>\\n\\n        <details>\\n          <summary>Dilution guidance</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">We provide dilution recommendations (usually 1–3% for adults, lower for sensitive skin). If you plan to use blends topically, we'll write a precise dilution plan.</div>\\n        </details>\\n\\n        <details>\\n          <summary>Patch tests</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">If topical application is suggested, a patch test will be recommended on a small skin area. We never advise skipping that step for concentrated oils.</div>\\n        </details>\\n\\n        <details>\\n          <summary>Pets & Safety</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Certain essential oils can affect pets. We'll ask about companion animals and recommend avoidance or safe diffusion protocols.</div>\\n        </details>\\n\\n        <details>\\n          <summary>Pregnancy & Medication notes</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Some oils are not recommended in pregnancy or with specific medications. If pregnant, nursing, or on medication, please disclose so we can advise safely.</div>\\n        </details>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <div style=\\\"font-weight:700\\\">Need a quick prep guide?</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">A short checklist helps you prepare for intake. It covers fragrance sensitivities and a pre-session patch test plan.</div>\\n          <a class=\\\"btn\\\" href=\\\"lead-magnet.html\\\" style=\\\"display:inline-block;margin-top:8px\\\">Download Prep Checklist</a>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\" class=\\\"muted\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>.</div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2 style=\\\"color:var(--primary)\\\">FAQ — Safety highlights</h2>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px\\\">\\n        <div style=\\\"background:#fff;padding:12px;border-radius:8px;border:1px solid rgba(122,75,42,0.03)\\\">\\n          <strong>What if I'm pregnant?</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Please tell us during booking. Some oils are best avoided; we will suggest safe alternatives and may recommend deferring certain applications. We do not provide medical advice.</div>\\n        </div>\\n        <div style=\\\"background:#fff;padding:12px;border-radius:8px;border:1px solid rgba(122,75,42,0.03)\\\">\\n          <strong>Are blends safe around pets?</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Certain strong oils can affect animals. We'll adapt diffusion and topical recommendations if pets live with you, prioritizing well-ventilated spaces and pet-safe alternatives.</div>\\n        </div>\\n        <div style=\\\"background:#fff;padding:12px;border-radius:8px;border:1px solid rgba(122,75,42,0.03)\\\">\\n          <strong>How do I do a patch test?</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">We'll give step-by-step patch test instructions: dilute a small amount, apply to a discreet area, and observe for 24–48 hours. If irritation appears, discontinue use and consult us.</div>\\n        </div>\\n        <div style=\\\"background:#fff;padding:12px;border-radius:8px;border:1px solid rgba(122,75,42,0.03)\\\">\\n          <strong>Medication interactions?</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Always tell us about medicines or conditions. We do not provide medical advice but will flag oils with known cautions and encourage cross-checking with your healthcare provider.</div>\\n        </div>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer style=\\\"padding:18px;text-align:center;color:var(--muted)\\\">\\n    <div>Serving {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
