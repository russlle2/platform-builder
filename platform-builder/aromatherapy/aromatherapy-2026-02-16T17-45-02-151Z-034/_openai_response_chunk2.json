          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f7efe6;--accent:#a56b3f;--muted:#6b6b6b;--card:#fff7f0;--glass:rgba(255,255,255,0.6)}\\n    html,body{height:100%;margin:0;font-family:Inter, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;color:#2f2f2f;background:linear-gradient(180deg,var(--bg),#efe7dd);}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 32px;background:linear-gradient(90deg,rgba(165,107,63,0.08),transparent);backdrop-filter:blur(4px)}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#a56b3f 0%,#c99b6f 100%);box-shadow:0 6px 18px rgba(165,107,63,0.14);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav a{color:#5b3b2b;text-decoration:none;margin:0 10px;font-weight:600}\\n    main{max-width:1100px;margin:40px auto;padding:24px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center}\\n    .hero-card{background:var(--card);padding:28px;border-radius:14px;box-shadow:0 10px 30px rgba(101,78,60,0.06)}\\n    h1{margin:0 0 12px 0;font-size:28px;color:#3a2b24}\\n    p.lead{margin:0 0 18px;color:var(--muted)}\\n    .cta{display:inline-block;padding:12px 18px;background:linear-gradient(90deg,#8a5a37,#b98055);color:white;border-radius:10px;text-decoration:none;font-weight:700}\\n    .aside{background:linear-gradient(180deg,rgba(255,255,255,0.6),var(--glass));padding:20px;border-radius:12px}\\n    .pill{display:inline-block;padding:6px 10px;background:#fff2e6;border-radius:999px;color:#6b3f2b;font-weight:700;margin-bottom:10px}\\n    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:22px}\\n    .card{background:white;padding:14px;border-radius:10px;border:1px solid rgba(80,60,44,0.06)}\\n    .section{margin-top:34px}\\n    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18px}\\n    .process-step{background:linear-gradient(180deg,#fff,rgba(255,255,255,0.92));padding:16px;border-radius:12px}\\n    footer{max-width:1100px;margin:40px auto;padding:24px;color:var(--muted);display:flex;justify-content:space-between}\\n    .faq-item{background:rgba(255,255,255,0.85);padding:14px;border-radius:10px;margin-bottom:10px}\\n    input,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6d8cc}\\n    .leadmag{display:flex;gap:12px}\\n    .pattern{position:fixed;right:-120px;top:-120px;opacity:0.12;transform:rotate(18deg);filter:blur(6px)}\\n    @media(max-width:900px){.hero{grid-template-columns:1fr}.cards{grid-template-columns:repeat(2,1fr)}.grid-2{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique inline SVG background (earthy warm swirls) -->\\n  <svg class=\\\"pattern\\\" width=\\\"520\\\" height=\\\"520\\\" viewBox=\\\"0 0 520 520\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#f7e7d9\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#e6d1bf\\\"/>\\n      </linearGradient>\\n    </defs>\\n    <rect width=\\\"520\\\" height=\\\"520\\\" rx=\\\"34\\\" fill=\\\"url(#g1)\\\"/>\\n    <g fill=\\\"none\\\" stroke=\\\"#b88962\\\" stroke-opacity=\\\"0.25\\\" stroke-width=\\\"16\\\" stroke-linecap=\\\"round\\\">\\n      <path d=\\\"M40 120 C120 20, 220 40, 300 100 S460 220, 480 320\\\" />\\n      <path d=\\\"M60 200 C150 130, 230 160, 320 220 S460 300, 500 380\\\" />\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"/\\\">Home</a>\\n      <a href=\\\"/services.html\\\">Offerings</a>\\n      <a href=\\\"/blends.html\\\">Our Blends</a>\\n      <a href=\\\"/shop.html\\\">Shop</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <!-- HERO -->\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <span class=\\\"pill\\\">Personalized Aromatherapy</span>\\n        <h1>Intensive sessions that meet your senses where they are</h1>\\n        <p class=\\\"lead\\\">A calming, evidence-minded approach to aromatic care. Sessions focus on scent history, safety, and creating balanced blends you can use at home. No medical promises — just botanical support for wellbeing rituals.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <div class=\\\"section\\\">\\n          <h3 style=\\\"margin:0 0 8px 0\\\">Who this is for</h3>\\n          <div class=\\\"cards\\\">\\n            <div class=\\\"card\\\">New to essential oils — gentle orientation + safety plan</div>\\n            <div class=\\\"card\\\">Ritual-seekers — bespoke blends for daily practice</div>\\n            <div class=\\\"card\\\">Gift coaching — blends for friends & family</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"aside\\\">\\n        <strong>Quick details</strong>\\n        <p style=\\\"margin:8px 0 0 0;color:var(--muted)\\\">Intensive 90–120 min sessions. Blend recipe + take-home roller included. Consult includes safety guidelines.</p>\\n        <div style=\\\"margin-top:12px\\\"><strong>{{PRACTITIONER_NAME}}</strong> • Aromatherapy Practitioner</div>\\n        <div style=\\\"margin-top:10px\\\"><a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">Call: {{PHONE}}</a></div>\\n      </aside>\\n    </section>\\n\\n    <!-- BENEFITS -->\\n    <section class=\\\"section\\\">\\n      <h2 style=\\\"margin-top:0\\\">Small, delightful wins</h2>\\n      <p class=\\\"lead\\\">What people often notice after an intensive consultation — gentle, aromatic upgrades to daily life.</p>\\n      <div class=\\\"grid-2\\\" style=\\\"margin-top:14px\\\">\\n        <div style=\\\"background:linear-gradient(180deg,#fff,#fff9f6);padding:16px;border-radius:12px\\\">Custom ritual design — blends + timings</div>\\n        <div style=\\\"background:linear-gradient(180deg,#fff,#fff9f6);padding:16px;border-radius:12px\\\">Safety-first dilution and storage plan</div>\\n        <div style=\\\"background:linear-gradient(180deg,#fff,#fff9f6);padding:16px;border-radius:12px\\\">Top-quality sourcing recommendations</div>\\n        <div style=\\\"background:linear-gradient(180deg,#fff,#fff9f6);padding:16px;border-radius:12px\\\">Shelf-life & patch test protocols</div>\\n      </div>\\n    </section>\\n\\n    <!-- SOCIAL PROOF -->\\n    <section class=\\\"section\\\">\\n      <h3>Stories from sessions</h3>\\n      <div style=\\\"display:flex;gap:12px;margin-top:10px;flex-wrap:wrap\\\">\\n        <div style=\\\"background:white;padding:12px;border-radius:10px;min-width:220px\\\">\\\"A practical, safe intro — I loved my roller.\\\" — M., {{CITY}}</div>\\n        <div style=\\\"background:white;padding:12px;border-radius:10px;min-width:220px\\\">\\\"Thoughtful and playful. Recipes I actually use.\\\" — R., {{STATE}}</div>\\n        <div style=\\\"background:white;padding:12px;border-radius:10px;min-width:220px\\\">\\\"Clear guidance for my curious teen.\\\" — K., {{CITY}}</div>\\n      </div>\\n    </section>\\n\\n    <!-- PROCESS -->\\n    <section class=\\\"section\\\">\\n      <h3>How an intensive unfolds</h3>\\n      <div class=\\\"grid-2\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"process-step\\\">\\n          <strong>1 • Discovery</strong>\\n          <p class=\\\"lead\\\" style=\\\"margin:6px 0 0 0\\\">We talk habits, sensitivities, and goals. Safety checklist included.</p>\\n        </div>\\n        <div class=\\\"process-step\\\">\\n          <strong>2 • Blend co-creation</strong>\\n          <p class=\\\"lead\\\" style=\\\"margin:6px 0 0 0\\\">Top/middle/base emphasis, aroma balancing, dilution recommendations.</p>\\n        </div>\\n        <div class=\\\"process-step\\\">\\n          <strong>3 • Teaching & handoff</strong>\\n          <p class=\\\"lead\\\" style=\\\"margin:6px 0 0 0\\\">Patch test plan, storage tips, and a take-home roller or sample vial.</p>\\n        </div>\\n        <div class=\\\"process-step\\\">\\n          <strong>4 • Follow-up</strong>\\n          <p class=\\\"lead\\\" style=\\\"margin:6px 0 0 0\\\">Email check-in and tweak suggestions within two weeks.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- LEAD MAGNET -->\\n    <section class=\\\"section\\\">\\n      <h3>Free guide: Starter dilution cheat-sheet</h3>\\n      <p class=\\\"lead\\\">Sign up and receive a concise PDF with safe dilution guidelines and a quick patch-test checklist.</p>\\n      <form style=\\\"display:flex;gap:8px;max-width:560px;margin-top:8px\\\" action=\\\"mailto:{{EMAIL}}\\\" method=\\\"post\\\">\\n        <input type=\\\"email\\\" placeholder=\\\"Your email\\\" required />\\n        <button class=\\\"cta\\\" type=\\\"submit\\\">Send me the guide</button>\\n      </form>\\n    </section>\\n\\n    <!-- FAQ -->\\n    <section class=\\\"section\\\">\\n      <h3>Safety & FAQ</h3>\\n      <div class=\\\"faq-item\\\">\\n        <strong>How do you handle dilution?</strong>\\n        <p style=\\\"margin:8px 0 0 0;color:var(--muted)\\\">I recommend safe dilution ranges based on age, skin sensitivity, and intended use. All recommendations avoid medical claims and focus on safe aromatic use.</p>\\n      </div>\\n      <div class=\\\"faq-item\\\">\\n        <strong>What is a patch test?</strong>\\n        <p style=\\\"margin:8px 0 0 0;color:var(--muted)\\\">A small application on the forearm to check for skin reactions over 24–48 hours. I guide you through it step-by-step.</p>\\n      </div>\\n      <div class=\\\"faq-item\\\">\\n        <strong>Are oils safe around pets?</strong>\\n        <p style=\\\"margin:8px 0 0 0;color:var(--muted)\\\">Some essential oils can affect animals. I include pet-safety advice and alternatives in every consultation.</p>\\n      </div>\\n      <div class=\\\"faq-item\\\">\\n        <strong>Pregnancy & nursing notes?</strong>\\n        <p style=\\\"margin:8px 0 0 0;color:var(--muted)\\\">I avoid suggesting oils contraindicated in pregnancy. If you are pregnant or nursing, we discuss safe options and referral when needed.</p>\\n      </div>\\n    </section>\\n\\n    <!-- CALL TO ACTION -->\\n    <section class=\\\"section\\\" style=\\\"display:flex;justify-content:space-between;align-items:center;background:linear-gradient(90deg,rgba(165,107,63,0.06),transparent);padding:18px;border-radius:12px\\\">\\n      <div>\\n        <strong style=\\\"font-size:18px\\\">Ready to design your signature scent?</strong>\\n        <div style=\\\"color:var(--muted)\\\">Book an intensive to receive a personalized plan and blend.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book now</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — {{PRACTITIONER_NAME}} • {{CITY}}, {{STATE}}</div>\\n    <div>Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Blends — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f2efe9;--accent:#7f4f2a;--card:#fff;--muted:#63504a}\\n    body{margin:0;font-family:Inter,system-ui,Arial;color:#362e2a;background:linear-gradient(180deg,#fbf6f1,var(--bg));}\\n    header{display:flex;justify-content:space-between;padding:22px 28px;align-items:center}\\n    .logo{width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,#8a5a37,#caa07a);display:flex;align-items:center;justify-content:center;color:white;font-weight:800}\\n    nav a{margin-left:12px;color:#5b4034;text-decoration:none;font-weight:600}\\n    main{max-width:1100px;margin:30px auto;padding:22px}\\n    h1{margin:0 0 8px 0}\\n    .intro{background:linear-gradient(180deg,rgba(255,255,255,0.9),transparent);padding:14px;border-radius:12px}\\n    .blends-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:18px}\\n    .blend{background:var(--card);padding:14px;border-radius:12px;border:1px solid rgba(120,88,66,0.06)}\\n    .notes{font-size:13px;color:var(--muted);margin-top:8px}\\n    .supports{margin-top:10px;padding:10px;background:#fff7f1;border-radius:10px;color:#6a4937}\\n    .leadmag{margin-top:18px;background:linear-gradient(90deg,#fff8f3,#fff);padding:12px;border-radius:12px;display:flex;justify-content:space-between;align-items:center}\\n    .faq{margin-top:20px}\\n    .faq-item{margin-bottom:10px}\\n    .pattern{position:fixed;left:-140px;bottom:-120px;opacity:0.09}\\n    @media(max-width:900px){.blends-grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique svg: concentric leaf rings -->\\n  <svg class=\\\"pattern\\\" width=\\\"560\\\" height=\\\"560\\\" viewBox=\\\"0 0 560 560\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <radialGradient id=\\\"rg\\\" cx=\\\"30%\\\" cy=\\\"70%\\\">\\n        <stop offset=\\\"0%\\\" stop-color=\\\"#fff6f0\\\" />\\n        <stop offset=\\\"100%\\\" stop-color=\\\"#ecd8c6\\\" />\\n      </radialGradient>\\n    </defs>\\n    <circle cx=\\\"280\\\" cy=\\\"280\\\" r=\\\"260\\\" fill=\\\"url(#rg)\\\" />\\n    <g stroke=\\\"#b07a52\\\" stroke-opacity=\\\"0.18\\\" stroke-width=\\\"10\\\" fill=\\\"none\\\">\\n      <path d=\\\"M60 280 C150 160, 410 160, 500 280\\\" />\\n      <path d=\\\"M70 320 C160 440, 400 440, 490 320\\\" />\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">B</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">Curated blends & recipes</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"/\\\">Home</a>\\n      <a href=\\\"/about.html\\\">About</a>\\n      <a href=\\\"/shop.html\\\">Market</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <!-- HERO (different heading style) -->\\n    <section class=\\\"intro\\\">\\n      <h1>Blends: Small bottles, big feelings</h1>\\n      <p style=\\\"margin:6px 0 0 0;color:var(--muted)\\\">Each blend lists top, middle, and base notes, a short aroma profile, and mindful language about what it supports. No medical claims are made.</p>\\n    </section>\\n\\n    <!-- LEAD MAGNET up front on this page -->\\n    <div class=\\\"leadmag\\\">\\n      <div>\\n        <strong>Download a 1-page blend planner</strong>\\n        <div style=\\\"color:var(--muted);font-size:13px\\\">Sketch your scent story and note safe dilutions.</div>\\n      </div>\\n      <div>\\n        <a style=\\\"padding:10px 14px;background:#8c5a35;color:white;border-radius:10px;text-decoration:none\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Get the planner</a>\\n      </div>\\n    </div>\\n\\n    <!-- BLENDS GRID -->\\n    <section class=\\\"blends-grid\\\" aria-label=\\\"blend-library\\\">\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Sunrise Ease</strong>\\n        <div class=\\\"notes\\\">Top: Sweet Orange • Middle: Lavender • Base: Cedarwood</div>\\n        <div class=\\\"notes\\\">Aroma: bright citrus warmed by soft floral and grounding wood.</div>\\n        <div class=\\\"supports\\\">Supports gentle morning grounding and a calm start to the day (safety-forward: dilute appropriately).</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Meditation Moss</strong>\\n        <div class=\\\"notes\\\">Top: Bergamot • Middle: Frankincense • Base: Patchouli</div>\\n        <div class=\\\"notes\\\">Aroma: resinous warmth with a citrus lift and deep earth notes.</div>\\n        <div class=\\\"supports\\\">Supports quiet focus for mindfulness practices; avoid direct skin use without dilution.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Evening Ritual</strong>\\n        <div class=\\\"notes\\\">Top: Mandarin • Middle: Roman Chamomile • Base: Vetiver</div>\\n        <div class=\\\"notes\\\">Aroma: soft, sweet citrus softening into chamomile and smokey base.</div>\\n        <div class=\\\"supports\\\">Supports a winding-down ritual; follow dilution and patch-test guidance.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Focus Grove</strong>\\n        <div class=\\\"notes\\\">Top: Rosemary • Middle: Lemon Peel • Base: Pine</div>\\n        <div class=\\\"notes\\\">Aroma: crisp herbal clarity with a clean coniferous finish.</div>\\n        <div class=\\\"supports\\\">Supports short bursts of attention and clarity; avoid in pregnancy unless approved by a provider.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Cozy Hearth</strong>\\n        <div class=\\\"notes\\\">Top: Cardamom • Middle: Clove • Base: Vanilla CO2</div>\\n        <div class=\\\"notes\\\">Aroma: warm spice layered over creamy vanilla base.</div>\\n        <div class=\\\"supports\\\">Supports comforting ambiance for rest and reading; use diluted for topical comfort blends.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Green Walk</strong>\\n        <div class=\\\"notes\\\">Top: Grapefruit • Middle: Basil • Base: Vetiver</div>\\n        <div class=\\\"notes\\\">Aroma: breezy citrus and leafy green mid-tones with earthy grounding.</div>\\n        <div class=\\\"supports\\\">Supports an energizing, nature-inspired atmosphere; keep away from curious pets' noses.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Quiet Night</strong>\\n        <div class=\\\"notes\\\">Top: Lavender • Middle: Clary Sage • Base: Sandalwood</div>\\n        <div class=\\\"notes\\\">Aroma: timeless floral-herb with a creamy woody base.</div>\\n        <div class=\\\"supports\\\">Supports a pre-sleep routine when used in diffusion; consult for pregnancy-safe substitutions.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Citrus Spark</strong>\\n        <div class=\\\"notes\\\">Top: Lemon • Middle: Neroli • Base: Benzoin</div>\\n        <div class=\\\"notes\\\">Aroma: sparkling, floral-citrus with sweet balsamic depth.</div>\\n        <div class=\\\"supports\\\">Supports an uplifting, focus-friendly diffusion; patch-test before topical use.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Forest Dew</strong>\\n        <div class=\\\"notes\\\">Top: Eucalyptus Radiata • Middle: Tea Tree (Melaleuca alternifolia) • Base: Fir Needle</div>\\n        <div class=\\\"notes\\\">Aroma: fresh, dewy evergreen with a clean herbal heart.</div>\\n        <div class=\\\"supports\\\">Supports a clear, fresh space for breathing practices; avoid high concentrations around small pets.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Sweet Ground</strong>\\n        <div class=\\\"notes\\\">Top: Sweet Marjoram • Middle: Orange Blossom • Base: Benzoin</div>\\n        <div class=\\\"notes\\\">Aroma: cozy sweet-herbal with a rich resinous finish.</div>\\n        <div class=\\\"supports\\\">Supports a gentle, cozy home atmosphere; safe dilution and storage notes provided on request.</div>\\n      </div>\\n\\n    </section>\\n\\n    <!-- BENEFITS (short snappy list, different position) -->\\n    <section style=\\\"margin-top:20px\\\">\\n      <h2>Why these blends?</h2>\\n      <ul style=\\\"color:var(--muted)\\\">\\n        <li>Designed with top/mid/base balance for layered aromatic complexity.</li>\\n        <li>Paired with precise, safety-focused usage notes.</li>\\n        <li>Recipes are adaptable — swap oils per sensitivity or availability.</li>\\n      </ul>\\n    </section>\\n\\n    <!-- PROCESS (compact) -->\\n    <section style=\\\"margin-top:20px\\\">\\n      <h3>How to use a blend safely</h3>\\n      <ol style=\\\"color:var(--muted)\\\">\\n        <li>Decide delivery: diffuser, roller, or inhaler.</li>\\n        <li>Apply recommended dilution for age & skin type.</li>\\n        <li>Perform a patch test 24–48 hours before regular topical use.</li>\\n      </ol>\\n    </section>\\n\\n    <!-- FAQ (condensed) -->\\n    <section class=\\\"faq\\\">\\n      <h3>Safety FAQs</h3>\\n      <div class=\\\"faq-item\\\"><strong>Why dilute?</strong> Pure essential oils are potent; dilution reduces irritation risk and supports safe topical use.</div>\\n      <div class=\\\"faq-item\\\"><strong>Patch test details</strong> Apply a diluted drop to the inner forearm, cover, and check for any reaction for up to 48 hours.</div>\\n      <div class=\\\"faq-item\\\"><strong>Pets</strong> Some oils can affect animals. Diffuse cautiously and avoid oils known to be harmful to cats and small mammals.</div>\\n      <div class=\\\"faq-item\\\"><strong>Pregnancy/nursing</strong> Many common oils are not recommended during pregnancy; contact me for pregnancy-safe alternatives.</div>\\n    </section>\\n\\n    <!-- CTA -->\\n    <section style=\\\"margin-top:22px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <strong>Want a custom version of a blend?</strong>\\n        <div style=\\\"color:var(--muted)\\\">Book a blend tweak session to receive a personalized recipe and safety notes.</div>\\n      </div>\\n      <div>\\n        <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"padding:12px 16px;background:#7f4f2a;color:white;border-radius:10px;text-decoration:none\\\">Book a tweak session</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"padding:18px;text-align:center;color:#7d6a60\\\">{{BUSINESS_NAME}} • Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></footer>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Shop — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f7f3ef;--accent:#9a603b;--muted:#5e4b45}\\n    body{margin:0;font-family:Inter,system-ui,Arial;background:linear-gradient(180deg,var(--bg),#efe7df);color:#352b26}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 26px}\\n    .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#9a603b,#caa57f);display:flex;align-items:center;justify-content:center;color:white;font-weight:800}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none;font-weight:600}\\n    main{max-width:1100px;margin:28px auto;padding:22px}\\n    h1{margin:0}\\n    .intro{margin-top:8px;color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .product{background:white;border-radius:12px;padding:14px;border:1px solid rgba(120,88,66,0.06)}\\n    .product h4{margin:0 0 8px 0}\\n    .price{font-weight:800;color:#7a4f31}\\n    .btn{display:inline-block;padding:10px 12px;background:linear-gradient(90deg,#8a5a37,#b67f56);color:white;border-radius:10px;text-decoration:none;margin-top:10px}\\n    .small{font-size:13px;color:var(--muted)}\\n    .faq{margin-top:24px}\\n    .pattern{position:fixed;right:-120px;bottom:-120px;opacity:0.08}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- inline swirl svg unique to shop -->\\n  <svg class=\\\"pattern\\\" width=\\\"480\\\" height=\\\"480\\\" viewBox=\\\"0 0 480 480\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"lg2\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#fff7f0\\\" />\\n        <stop offset=\\\"1\\\" stop-color=\\\"#efd7c1\\\" />\\n      </linearGradient>\\n    </defs>\\n    <rect width=\\\"480\\\" height=\\\"480\\\" rx=\\\"28\\\" fill=\\\"url(#lg2)\\\"/>\\n    <g stroke=\\\"#b07a52\\\" stroke-opacity=\\\"0.12\\\" stroke-width=\\\"8\\\" fill=\\\"none\\\">\\n      <path d=\\\"M40 200 C120 80, 300 60, 420 180\\\" />\\n      <path d=\\\"M60 260 C160 380, 340 380, 420 260\\\" />\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">S</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">Shop hand-curated aromatherapy items</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"/\\\">Home</a>\\n      <a href=\\\"/services.html\\\">Sessions</a>\\n      <a href=\\\"/blends.html\\\">Blends</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <h1>Market</h1>\\n    <p class=\\\"intro\\\">Thoughtfully selected kits, rollers, and diffusers. Product descriptions include safe-use prompts. No medical promises.</p>\\n\\n    <!-- SOCIAL PROOF block first on this page -->\\n    <section style=\\\"margin-top:14px\\\">\\n      <strong>Love from buyers</strong>\\n      <div style=\\\"display:flex;gap:10px;margin-top:8px\\\">\\n        <div style=\\\"background:white;padding:10px;border-radius:10px\\\">\\\"The starter kit was perfect for my first blends.\\\" — L.</div>\\n        <div style=\\\"background:white;padding:10px;border-radius:10px\\\">\\\"Beautiful rollers, great scents.\\\" — J.</div>\\n      </div>\\n    </section>\\n\\n    <!-- PRODUCTS GRID -->\\n    <section class=\\\"grid\\\" aria-label=\\\"products\\\">\\n      <div class=\\\"product\\\">\\n        <h4>Starter Kit — The Basics</h4>\\n        <div class=\\\"small\\\">Includes: 5 x 5ml singles, 1 amber roller, dilution guide</div>\\n        <div class=\\\"price\\\">$49</div>\\n        <a class=\\\"btn\\\" href=\\\"/book.html\\\">Reserve</a>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <h4>On-the-go Rollers (Set of 3)</h4>\\n        <div class=\\\"small\\\">Pre-diluted rollers (calming, focus, refresh). 10ml each.</div>\\n        <div class=\\\"price\\\">$38</div>\\n        <a class=\\\"btn\\\" href=\\\"/book.html\\\">Buy</a>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <h4>Mini Electric Diffuser</h4>\\n        <div class=\\\"small\\\">USB diffuser for bedrooms and desks. Quiet, 200ml.</div>\\n        <div class=\\\"price\\\">$45</div>\\n        <a class=\\\"btn\\\" href=\\\"/book.html\\\">Add to cart</a>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <h4>Seasonal Blends Bundle</h4>\\n        <div class=\\\"small\\\">Four 5ml blends curated for the season + usage notes.</div>\\n        <div class=\\\"price\\\">$36</div>\\n        <a class=\\\"btn\\\" href=\\\"/book.html\\\">Buy</a>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <h4>Travel Roller Trio (Blank)</h4>\\n        <div class=\\\"small\\\">Empty amber rollers with pipettes. Great for custom blends.</div>\\n        <div class=\\\"price\\\">$14</div>\\n        <a class=\\\"btn\\\" href=\\\"/book.html\\\">Shop</a>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <h4>Practitioner Blend Pack</h4>\\n        <div class=\\\"small\\\">Hand-selected oils for co-creation sessions. Includes safety datasheet.</div>\\n        <div class=\\\"price\\\">$89</div>\\n        <a class=\\\"btn\\\" href=\\\"/book.html\\\">Inquire</a>\\n      </div>\\n\\n    </section>\\n\\n    <!-- BENEFITS (short) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>Why shop here?</h3>\\n      <ul style=\\\"color:var(--muted)\\\">\\n        <li>Sourcing transparency and batch notes included.</li>\\n        <li>Products packed with safe-use literature.</li>\\n        <li>Return policy for unopened kits within 14 days.</li>\\n      </ul>\\n    </section>\\n\\n    <!-- FAQ -->\\n    <section class=\\\"faq\\\">\\n      <h3>Product safety FAQ</h3>\\n      <div class=\\\"faq-item\\\"><strong>Dilution:</strong> Every topical product includes a recommended dilution range. If in doubt, choose the lower concentration.</div>\\n      <div class=\\\"faq-item\\\"><strong>Patch testing:</strong> We recommend a patch test for any topical product to check for sensitivity, even if pre-diluted.</div>\\n      <div class=\\\"faq-item\\\"><strong>Pets:</strong> Some products may not be suitable around cats or small mammals. Check the product notes or reach out before use.</div>\\n      <div class=\\\"faq-item\\\"><strong>Pregnancy & nursing:</strong> Several common oils are avoided during pregnancy; consult before purchasing if pregnant or nursing.</div>\\n    </section>\\n\\n    <!-- PROCESS (checkout-like reassurance) -->\\n    <section style=\\\"margin-top:18px;background:linear-gradient(90deg,rgba(154,96,59,0.06),transparent);padding:12px;border-radius:10px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <strong>Easy ordering</strong>\\n        <div style=\\\"color:var(--muted)\\\">Secure checkout, tracked shipping, and friendly returns.</div>\\n      </div>\\n      <div>\\n        <a href=\\\"/contact.html\\\" class=\\\"btn\\\">Questions? Contact us</a>\\n      </div>\\n    </section>\\n\\n    <!-- CTA -->\\n    <section style=\\\"margin-top:22px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <strong>Prefer a custom kit?</strong>\\n        <div style=\\\"color:var(--muted)\\\">Book a consult to co-create a personalized kit and receive safety documentation.</div>\\n      </div>\\n      <div>\\n        <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"btn\\\">Book a consult</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"padding:18px;text-align:center;color:var(--muted)\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}} — {{BUSINESS_NAME}}</footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
