          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Costs — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f1724;--glass:rgba(255,255,255,0.06);--accent:#8ec5ff;--muted:#cbd5e1;--card:rgba(255,255,255,0.04);font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial}\\n    *{box-sizing:border-box}\\n    body{margin:0;min-height:100vh;background:linear-gradient(180deg,var(--bg),#071025 60%);color:var(--muted);position:relative;overflow-y:auto}\\n    header{backdrop-filter:blur(6px);position:sticky;top:16px;margin:24px auto;max-width:1000px;padding:12px;border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));display:flex;gap:18px;align-items:center;justify-content:space-between;border:1px solid rgba(255,255,255,0.04)}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#08293b,#0f4f6f);display:grid;place-items:center;color:var(--accent);font-weight:700}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px 10px;border-radius:10px;font-size:14px}\\n    nav a:hover{background:rgba(255,255,255,0.02)}\\n    main{max-width:1100px;margin:40px auto;padding:28px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border-radius:16px;padding:20px;border:1px solid rgba(255,255,255,0.04)}\\n    h1{margin:0;color:#e6f7ff;font-size:28px}\\n    p.lead{color:var(--muted);margin-top:8px;line-height:1.5}\\n    .diagnostic{margin-top:18px;padding:14px;border-radius:12px;background:linear-gradient(90deg,rgba(142,197,255,0.04),rgba(140,197,255,0.02));border:1px solid rgba(142,197,255,0.06)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:20px}\\n    .plan{padding:18px;border-radius:12px;background:var(--card);border:1px solid rgba(255,255,255,0.03)}\\n    .plan h3{margin:0 0 8px 0;color:#e9fbff}\\n    .price{font-size:20px;color:var(--accent);font-weight:700}\\n    .micro{display:flex;flex-direction:column;gap:10px;margin-top:18px}\\n    .micro li{background:rgba(255,255,255,0.02);padding:10px;border-radius:8px;font-size:14px}\\n    .pricing-table{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:20px}\\n    .cta{display:flex;gap:12px;align-items:center;margin-top:18px}\\n    .btn{background:linear-gradient(90deg,var(--accent),#6fd3ff);color:#012;padding:10px 14px;border-radius:10px;font-weight:700;text-decoration:none}\\n    .ghost{border:1px solid rgba(255,255,255,0.06);padding:10px 12px;border-radius:10px;color:var(--muted);text-decoration:none}\\n    footer{max-width:1100px;margin:28px auto;color:rgba(255,255,255,0.4);font-size:13px;padding:14px;text-align:center}\\n    /* decorative svg backdrop */\\n    .bg-svg{position:fixed;inset:0;pointer-events:none;opacity:0.6}\\n    @media(max-width:900px){.hero{grid-template-columns:1fr;}.pricing-table{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique inline SVG pattern for this page -->\\n  <svg class=\\\"bg-svg\\\" width=\\\"100%\\\" height=\\\"100%\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" preserveAspectRatio=\\\"none\\\">\\n    <defs>\\n      <linearGradient id=\\\"gA\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#08304a\\\" stop-opacity=\\\"0.7\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#06121a\\\" stop-opacity=\\\"0.3\\\"/></linearGradient>\\n      <pattern id=\\\"pA\\\" width=\\\"120\\\" height=\\\"120\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"120\\\" height=\\\"120\\\" fill=\\\"none\\\"/>\\n        <circle cx=\\\"20\\\" cy=\\\"20\\\" r=\\\"2.5\\\" fill=\\\"#0ea5bf\\\" opacity=\\\"0.12\\\"/>\\n        <circle cx=\\\"80\\\" cy=\\\"80\\\" r=\\\"2.5\\\" fill=\\\"#8ec5ff\\\" opacity=\\\"0.08\\\"/>\\n        <path d=\\\"M0 120 L120 0\\\" stroke=\\\"#0ea5bf\\\" stroke-opacity=\\\"0.03\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#gA)\\\"/>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#pA)\\\"/>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"color:#dff6ff;font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav aria-label=\\\"Primary navigation\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Shop</a>\\n      <a href=\\\"pricing.html\\\" style=\\\"background:rgba(255,255,255,0.02);border-radius:8px;padding:8px 10px\\\">Costs</a>\\n      <a href=\\\"about.html\\\">Who&nbsp;we&nbsp;are</a>\\n      <a href=\\\"book.html\\\" class=\\\"btn\\\" style=\\\"padding:8px 10px\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Transparent pricing for mindful aromatherapy</h1>\\n        <p class=\\\"lead\\\">Carefully structured sessions, product bundles, and short check-ins. A hybrid approach combining personalized consultations with safe, evidence-informed aromatic care. No medical promises — only practical, safety-first guidance.</p>\\n\\n        <div class=\\\"diagnostic card\\\">\\n          <strong>Choose your path</strong>\\n          <p style=\\\"margin:8px 0 0 0;color:var(--muted);font-size:14px\\\">We offer remote & in-person consultations, blend design, and curated product kits. Select a diagnostic path to find the right match for your needs.</p>\\n          <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n            <div class=\\\"plan\\\">\\n              <h3>Intro Consult</h3>\\n              <div class=\\\"price\\\">$65 • 30 min</div>\\n              <p style=\\\"font-size:13px;color:var(--muted);margin-top:8px\\\">Safe, focused intake and basic recommendations.</p>\\n            </div>\\n            <div class=\\\"plan\\\">\\n              <h3>Personal Session</h3>\\n              <div class=\\\"price\\\">$140 • 60 min</div>\\n              <p style=\\\"font-size:13px;color:var(--muted);margin-top:8px\\\">Comprehensive assessment with blend formulation.</p>\\n            </div>\\n            <div class=\\\"plan\\\">\\n              <h3>Follow-up</h3>\\n              <div class=\\\"price\\\">$55 • 25 min</div>\\n              <p style=\\\"font-size:13px;color:var(--muted);margin-top:8px\\\">Review progress, adjust blends/routines.</p>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"micro card\\\" style=\\\"margin-top:18px\\\">\\n          <strong>Micro-habits (sample)</strong>\\n          <ul style=\\\"list-style:none;padding:0;margin:8px 0 0 0\\\">\\n            <li>&#8226; 1–2 drops in diffuser for 20–30 min in a ventilated space</li>\\n            <li>&#8226; Patch test before direct skin application</li>\\n            <li>&#8226; Record responses for two days after a new blend</li>\\n          </ul>\\n        </div>\\n\\n        <div style=\\\"margin-top:16px\\\" class=\\\"card\\\">\\n          <strong>Safety note</strong>\\n          <p style=\\\"margin:8px 0 0 0;color:var(--muted);font-size:13px\\\">Practitioner guidance focuses on safety and aromatherapeutic use. Not a substitute for medical care. We discuss dilution, patch testing, pregnancy, and pet-safe practices during consultations.</p>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <h2 style=\\\"margin-top:0;color:#eafcff\\\">Bundles & purchases</h2>\\n        <p style=\\\"color:var(--muted)\\\">Select hybrid offerings that combine a session + tailored kit for at-home practice.</p>\\n        <div class=\\\"pricing-table\\\">\\n          <div class=\\\"card\\\">\\n            <h3>Starter Kit + Intro</h3>\\n            <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><div style=\\\"font-size:14px;color:var(--muted)\\\">Includes 5 essential oils + roller</div><div class=\\\"price\\\">$95</div></div>\\n            <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve</a></div>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <h3>Custom Blend Package</h3>\\n            <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><div style=\\\"font-size:14px;color:var(--muted)\\\">Session + 10ml bespoke blend</div><div class=\\\"price\\\">$170</div></div>\\n            <div style=\\\"margin-top:10px\\\"><a class=\\\"ghost\\\" href=\\\"book.html\\\">Book</a></div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;font-size:13px;color:var(--muted)\\\">\\n          Payment accepted by card. Reduced rates for repeat clients. Gift certificates available.\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:22px\\\">\\n      <h3 style=\\\"margin:0;color:#eafcff\\\">Comparative plans</h3>\\n      <p style=\\\"margin:8px 0 0 0;color:var(--muted)\\\">Short, medium, and extended options to fit different needs and budgets. All plans emphasize safety-first dilution and testing.</p>\\n\\n      <div class=\\\"grid\\\" style=\\\"margin-top:14px\\\">\\n        <div class=\\\"plan\\\">\\n          <h3>Short Series</h3>\\n          <div class=\\\"price\\\">$185</div>\\n          <p style=\\\"font-size:13px;color:var(--muted);margin-top:8px\\\">Three 25-minute check-ins over six weeks. Good for adjustment and troubleshooting.</p>\\n        </div>\\n        <div class=\\\"plan\\\">\\n          <h3>Standard</h3>\\n          <div class=\\\"price\\\">$320</div>\\n          <p style=\\\"font-size:13px;color:var(--muted);margin-top:8px\\\">One full consult + blend + two follow-ups. Ideal for tailored starts.</p>\\n        </div>\\n        <div class=\\\"plan\\\">\\n          <h3>Monthly Support</h3>\\n          <div class=\\\"price\\\">$95/mo</div>\\n          <p style=\\\"font-size:13px;color:var(--muted);margin-top:8px\\\">Ongoing care with brief check-ins and supply replenishment.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:20px\\\">\\n      <h3 style=\\\"margin:0;color:#eafcff\\\">Booking and small print</h3>\\n      <ul style=\\\"margin-top:10px;color:var(--muted);font-size:14px\\\">\\n        <li>&#8226; Appointments may be virtual or in-person; choose when booking.</li>\\n        <li>&#8226; Cancellation policy: 24-hour notice requested.</li>\\n        <li>&#8226; All consultations include safety screening and guidance on dilution, patch testing, pregnancy, and animals where relevant.</li>\\n      </ul>\\n      <div class=\\\"cta\\\">\\n        <a class=\\\"btn\\\" href=\\\"book.html\\\">Book a session</a>\\n        <a class=\\\"ghost\\\" href=\\\"contact.html\\\">Questions? Contact {{EMAIL}}</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — Serving {{CITY}}, {{STATE}} • Phone: {{PHONE}} • Email: {{EMAIL}}</div>\\n    <div style=\\\"margin-top:6px;font-size:12px;color:rgba(255,255,255,0.25)\\\">All guidance prioritizes safety. Not medical advice.</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071026;--glass:rgba(255,255,255,0.04);--accent:#b8f1d0;--muted:#bcd6cf;--card:rgba(255,255,255,0.03);font-family:Inter,ui-sans-serif,system-ui,Arial}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg),#04121b);color:var(--muted)}\\n    .wrap{max-width:980px;margin:36px auto;padding:20px}\\n    header{display:flex;align-items:center;justify-content:space-between;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:12px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .nav a{color:var(--muted);text-decoration:none;margin-left:12px}\\n    .hero{display:flex;gap:18px;align-items:center;margin-top:22px}\\n    .photo{width:140px;height:140px;border-radius:14px;background:linear-gradient(135deg,#083a2a,#0f2a1d);display:grid;place-items:center;color:var(--accent);font-size:22px}\\n    h1{margin:0;color:#effff4}\\n    .tag{color:var(--muted);margin-top:6px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:16px;border-radius:12px;border:1px solid rgba(255,255,255,0.03);margin-top:16px}\\n    .grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}\\n    .faq dt{font-weight:700;color:#e8fff7;margin-top:12px}\\n    .faq dd{margin:6px 0 0 0;color:var(--muted)}\\n    .cta{margin-top:18px}\\n    a.btn{background:linear-gradient(90deg,var(--accent),#9ef0c0);color:#052017;padding:10px 12px;border-radius:10px;text-decoration:none}\\n    .bg-orn{position:fixed;right:-80px;top:-40px;opacity:0.9;pointer-events:none}\\n    @media(max-width:800px){.hero{flex-direction:column;align-items:flex-start}.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- distinct decorative svg for about page -->\\n  <svg class=\\\"bg-orn\\\" width=\\\"420\\\" height=\\\"420\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <radialGradient id=\\\"gB\\\" cx=\\\"30%\\\" cy=\\\"30%\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#8ff0d2\\\" stop-opacity=\\\"0.24\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#053228\\\" stop-opacity=\\\"0.02\\\"/>\\n      </radialGradient>\\n    </defs>\\n    <circle cx=\\\"200\\\" cy=\\\"200\\\" r=\\\"180\\\" fill=\\\"url(#gB)\\\"/>\\n    <g fill=\\\"#b8f1d0\\\" opacity=\\\"0.06\\\">\\n      <rect x=\\\"40\\\" y=\\\"40\\\" width=\\\"120\\\" height=\\\"120\\\" rx=\\\"8\\\"/>\\n      <rect x=\\\"180\\\" y=\\\"140\\\" width=\\\"90\\\" height=\\\"90\\\" rx=\\\"10\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700;color:#eafff6\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"pricing.html\\\">Costs</a>\\n        <a href=\\\"book.html\\\" class=\\\"btn\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"photo\\\">{{PRACTITIONER_NAME}}</div>\\n      <div>\\n        <h1>Balancing scent with thoughtful care</h1>\\n        <div class=\\\"tag\\\">Clinical, careful aromatherapy for daily rituals — safety-forward and evidence-conscious.</div>\\n        <div style=\\\"margin-top:12px;color:var(--muted);max-width:640px\\\">I combine botanical knowledge with practical routines to help you use aromatics thoughtfully. Sessions emphasize screening, dilution, and documented responses so you can practice confidently at home.</div>\\n        <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Schedule a consultation</a></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\">\\n      <h3 style=\\\"margin:0;color:#eafff6\\\">A practitioner's approach</h3>\\n      <div style=\\\"margin-top:10px;color:var(--muted)\\\">My practice centers on three pillars: safety screening, clear documentation, and small, repeatable habits. I do not make health claims; rather, I offer aromatic options that clients can integrate into daily routines with appropriate precautions.</div>\\n\\n      <div class=\\\"grid\\\">\\n        <div>\\n          <h4 style=\\\"margin:8px 0;color:#eafff6\\\">Training & Credentials</h4>\\n          <ul style=\\\"color:var(--muted);margin:6px 0 0 12px\\\">\\n            <li>Certification in Clinical Aromatherapy</li>\\n            <li>Advanced safety & dilution coursework</li>\\n            <li>Continuing education in plant chemistry</li>\\n          </ul>\\n        </div>\\n        <div>\\n          <h4 style=\\\"margin:8px 0;color:#eafff6\\\">Community & Ethics</h4>\\n          <p style=\\\"color:var(--muted);margin:6px 0 0 0\\\">I maintain a policy of clear informed consent, full disclosure of limitations, and referrals to licensed healthcare when concerns are outside aromatherapy scope.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n      <h3 style=\\\"margin:0;color:#eafff6\\\">Testimonials</h3>\\n      <div style=\\\"margin-top:10px;color:var(--muted)\\\">\\n        \\\"Thoughtful and pragmatic guidance — I learned tiny habits I could keep.\\\" — A client in {{CITY}}\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n      <h3 style=\\\"margin:0;color:#eafff6\\\">FAQ — common safety topics</h3>\\n      <dl class=\\\"faq\\\">\\n        <dt>How do you recommend dilution?</dt>\\n        <dd>We use conservative dilution guidelines tailored to age and exposure. Typical topical dilutions start low (0.5–2.5% in a carrier) and are adjusted only with client consent.</dd>\\n\\n        <dt>What is a patch test?</dt>\\n        <dd>A patch test is a small, supervised application to skin using the intended dilution, observed for 24–48 hours to check for irritation or sensitivity.</dd>\\n\\n        <dt>Are blends safe for pets?</dt>\\n        <dd>Some essential oils are not pet-safe. We review your household and provide alternatives or avoidance strategies to minimize risk for animals.</dd>\\n\\n        <dt>Pregnancy and nursing?</dt>\\n        <dd>We take a precautionary stance. Certain oils are avoided in pregnancy; we discuss options and coordinate with healthcare providers when appropriate.</dd>\\n      </dl>\\n    </section>\\n\\n    <section style=\\\"margin-top:14px;display:flex;gap:12px;align-items:center\\\">\\n      <a class=\\\"btn\\\" href=\\\"book.html\\\">Book a safety-first session</a>\\n      <a href=\\\"contact.html\\\" style=\\\"color:var(--muted);text-decoration:none\\\">Contact: {{EMAIL}}</a>\\n    </section>\\n\\n    <footer style=\\\"margin-top:26px;color:rgba(255,255,255,0.3);font-size:13px\\\">{{BUSINESS_NAME}} — {{PRACTITIONER_NAME}} • Serving {{CITY}}, {{STATE}} • Phone: {{PHONE}}</footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#041224;--muted:#cfeef6;--card:rgba(255,255,255,0.03);--accent:#ffd6a5;font-family:system-ui,Segoe UI,Roboto,Arial}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg),#031421);color:var(--muted)}\\n    .container{max-width:920px;margin:28px auto;padding:18px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    header h2{margin:0;color:#f7fff9}\\n    .nav a{color:var(--muted);text-decoration:none;margin-left:12px}\\n    .panel{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.04);margin-top:18px}\\n    form{display:grid;grid-template-columns:1fr 320px;gap:18px}\\n    label{display:block;font-size:13px;margin-bottom:6px;color:#e9f7ff}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:var(--muted)}\\n    textarea{min-height:120px}\\n    .policies{font-size:13px;color:rgba(255,255,255,0.6)}\\n    .submit{background:linear-gradient(90deg,#ffd6a5,#ffc58f);color:#08202a;padding:10px;border-radius:10px;border:none;font-weight:700;cursor:pointer}\\n    .note{font-size:13px;color:var(--muted)}\\n    .summary{background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;border:1px solid rgba(255,255,255,0.03)}\\n    .bg-curve{position:fixed;left:-120px;bottom:-120px;opacity:0.9;pointer-events:none}\\n    @media(max-width:880px){form{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- booking page svg — unique motif -->\\n  <svg class=\\\"bg-curve\\\" width=\\\"520\\\" height=\\\"520\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"gC\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#ffd6a5\\\" stop-opacity=\\\"0.22\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#ffb4a2\\\" stop-opacity=\\\"0.06\\\"/></linearGradient>\\n    </defs>\\n    <path d=\\\"M420 520 C300 480 200 420 120 380 C40 340 0 260 0 160 C0 80 80 0 160 0 C260 0 340 60 460 120 Z\\\" fill=\\\"url(#gC)\\\"/>\\n  </svg>\\n\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div>\\n        <h2>Reserve a session — {{BUSINESS_NAME}}</h2>\\n        <div style=\\\"color:var(--muted);font-size:13px\\\">A short intake ensures we work within safe and practical guidelines.</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"pricing.html\\\">Costs</a>\\n        <a href=\\\"contact.html\\\">Help: {{EMAIL}}</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"panel\\\">\\n      <form action=\\\"/book\\\" method=\\\"post\\\" autocomplete=\\\"off\\\">\\n        <div>\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"Your name\\\" required />\\n\\n          <label for=\\\"email\\\" style=\\\"margin-top:12px\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@domain.com\\\" required />\\n\\n          <label for=\\\"phone\\\" style=\\\"margin-top:12px\\\">Phone</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"{{PHONE}}\\\" />\\n\\n          <label for=\\\"service\\\" style=\\\"margin-top:12px\\\">Choose a service</label>\\n          <select id=\\\"service\\\" name=\\\"service\\\">\\n            <option>Intro Consult — 30 min</option>\\n            <option>Personal Session — 60 min</option>\\n            <option>Follow-up — 25 min</option>\\n            <option>Blend design + kit</option>\\n          </select>\\n\\n          <label for=\\\"notes\\\" style=\\\"margin-top:12px\\\">Relevant notes (allergies, pets, pregnancy, medications)</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" placeholder=\\\"Share any safety-relevant information\\\"></textarea>\\n        </div>\\n\\n        <aside>\\n          <div class=\\\"summary\\\">\\n            <strong style=\\\"color:#fff\\\">Booking summary</strong>\\n            <div style=\\\"margin-top:10px\\\" class=\\\"note\\\">Select a time after you submit — you'll receive a scheduling link. Standard session durations and fees are shown on the Costs page.</div>\\n            <div style=\\\"margin-top:12px\\\">\\n              <label for=\\\"time\\\">Preferred days/times</label>\\n              <input id=\\\"time\\\" name=\\\"time\\\" type=\\\"text\\\" placeholder=\\\"Weekday mornings, Tuesdays, etc.\\\" />\\n            </div>\\n            <div style=\\\"margin-top:12px\\\">\\n              <label for=\\\"mode\\\">Format</label>\\n              <select id=\\\"mode\\\" name=\\\"mode\\\">\\n                <option>Remote (video)</option>\\n                <option>In-person</option>\\n              </select>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\" class=\\\"panel\\\">\\n            <strong style=\\\"color:#fff\\\">Policies</strong>\\n            <div style=\\\"margin-top:8px\\\" class=\\\"policies\\\">\\n              • Please provide any safety-relevant details (pregnancy, pets, meds).\\n              <br/>• Patch test recommended before topical use.\\n              <br/>• 24-hour cancellation appreciated.\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <button type=\\\"submit\\\" class=\\\"submit\\\">Request appointment</button>\\n          </div>\\n        </aside>\\n      </form>\\n    </section>\\n\\n    <section style=\\\"margin-top:16px\\\" class=\\\"panel\\\">\\n      <h3 style=\\\"margin:0;color:#fff\\\">Before your session</h3>\\n      <ul style=\\\"margin-top:8px;color:var(--muted);font-size:14px\\\">\\n        <li>&#8226; Note any sensitivities or pet exposure in the household.</li>\\n        <li>&#8226; If topical use is likely, be prepared to discuss dilution and patch testing.</li>\\n        <li>&#8226; We will not provide medical diagnoses. We will coordinate with healthcare providers if needed.</li>\\n      </ul>\\n    </section>\\n\\n    <footer style=\\\"margin-top:18px;color:rgba(255,255,255,0.34);font-size:13px\\\">Questions? Email {{EMAIL}} • Phone: {{PHONE}} • {{BUSINESS_NAME}} — Serving {{CITY}}, {{STATE}}</footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
