          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Rates — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:linear-gradient(135deg,rgba(216,231,255,0.15),rgba(236,255,243,0.08));--glass:rgba(255,255,255,0.06);--glass-2:rgba(255,255,255,0.1);--accent:#6aa6a7;--muted:#9ea6ad;--card-radius:16px}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:#0b1b1b;background:radial-gradient(1200px 600px at 10% 10%, rgba(106,166,167,0.08), transparent), radial-gradient(800px 400px at 90% 90%, rgba(120,160,200,0.05), transparent), #f6fbfb;}\\n    /* subtle, unique inline svg pattern sits under content */\\n    .bg-svg{position:fixed;inset:0;pointer-events:none;opacity:0.12}\\n    .nav{display:flex;gap:18px;align-items:center;padding:20px 28px;background:transparent}\\n    .brand{font-weight:700;color:#05313a}\\n    header .nav a{color:#05313a;text-decoration:none;padding:8px 12px;border-radius:10px}\\n    header .nav a[href$='pricing.html']{background:linear-gradient(90deg,rgba(106,166,167,0.12),rgba(106,166,167,0.06))}\\n    .container{max-width:1100px;margin:28px auto;padding:28px}\\n    .hero{backdrop-filter:blur(10px);background:linear-gradient(180deg,var(--glass),var(--glass-2));border-radius:18px;padding:28px;display:grid;grid-template-columns:1fr 330px;gap:20px;align-items:center}\\n    .hero h1{margin:0;font-size:28px;color:#02303a}\\n    .lead{color:var(--muted);margin-top:8px}\\n    .card{background:rgba(255,255,255,0.05);padding:18px;border-radius:14px;box-shadow:0 6px 18px rgba(11,27,27,0.06)}\\n    .pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:20px}\\n    .plan{padding:18px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border:1px solid rgba(255,255,255,0.04)}\\n    .plan h3{margin:0 0 6px 0}\\n    .price{font-size:20px;color:var(--accent);font-weight:700}\\n    .small{color:var(--muted);font-size:13px}\\n    ul.features{padding-left:18px;margin:10px 0}\\n    .faq{margin-top:22px}\\n    .faq details{background:rgba(255,255,255,0.03);margin-bottom:10px;padding:12px;border-radius:10px}\\n    .cta-row{display:flex;gap:12px;align-items:center;margin-top:18px}\\n    .btn{display:inline-block;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#4b9da0);color:white;text-decoration:none}\\n    .ghost{background:transparent;border:1px solid rgba(5,49,58,0.08);color:#05313a;padding:9px 12px}\\n    footer{margin-top:28px;padding:18px;color:var(--muted);font-size:13px}\\n    @media(max-width:860px){.hero{grid-template-columns:1fr;}.pricing-grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique inline svg pattern for this page -->\\n  <svg class='bg-svg' viewBox='0 0 1200 800' preserveAspectRatio='xMidYMid slice' xmlns='http://www.w3.org/2000/svg'>\\n    <defs>\\n      <linearGradient id='g1' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#d8e7ff'/>\\n        <stop offset='1' stop-color='#eafff6'/>\\n      </linearGradient>\\n      <pattern id='p1' width='80' height='80' patternUnits='userSpaceOnUse'>\\n        <rect width='80' height='80' fill='transparent'/>\\n        <circle cx='12' cy='12' r='2.6' fill='#6aa6a7'/>\\n        <path d='M0 60 L80 20' stroke='#cbe9e6' stroke-opacity='0.6' stroke-width='1'/>\\n      </pattern>\\n    </defs>\\n    <rect width='1200' height='800' fill='url(#p1)' opacity='0.75'/>\\n    <g transform='translate(200,100)'>\\n      <ellipse cx='400' cy='200' rx='380' ry='160' fill='url(#g1)' opacity='0.08'/>\\n    </g>\\n  </svg>\\n\\n  <header class='container'>\\n    <nav class='nav'>\\n      <span class='brand'>{{BUSINESS_NAME}}</span>\\n      <a href='index.html'>Home</a>\\n      <a href='services.html'>Offerings</a>\\n      <a href='blends.html'>Blends</a>\\n      <a href='shop.html'>Store</a>\\n      <a href='pricing.html' aria-current='page'>Rates</a>\\n      <a href='about.html'>Our Approach</a>\\n      <a href='book.html'>Reserve</a>\\n      <a href='contact.html'>Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class='container'>\\n    <section class='hero'>\\n      <div>\\n        <h1>Transparent, safety-forward pricing for aromatherapy sessions</h1>\\n        <p class='lead'>Calm, clinical clarity — pricing designed to be simple and supportive for clients in {{CITY}}, {{STATE}}.</p>\\n        <div class='card'>\\n          <p class='small'>Sessions are hybrid: in-person and digital options are available. If you have specific safety questions, please contact <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a> or call <a href='tel:{{PHONE}}'>{{PHONE}}</a>.</p>\\n          <div class='cta-row'>\\n            <a class='btn' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n            <a class='ghost' href='about.html'>Meet the practitioner</a>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class='card'>\\n          <strong>Quick booking</strong>\\n          <p class='small'>30–90 minute sessions; custom blends available.</p>\\n          <p style='margin:10px 0' class='price'>$85<span class='small'> starting</span></p>\\n          <a class='btn' href='book.html'>Reserve a time</a>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class='card' style='margin-top:20px'>\\n      <h2>Packages & session types</h2>\\n      <p class='small'>All sessions include a safety review, aroma preference session, and a tailored blend sample. No medical claims — focuses on comfort, relaxation, and scent education.</p>\\n\\n      <div class='pricing-grid'>\\n        <div class='plan'>\\n          <h3>Intro Consultation</h3>\\n          <p class='price'>$85</p>\\n          <p class='small'>30–45 minutes • ideal for new clients</p>\\n          <ul class='features'><li>Safety screening & preferences</li><li>Mini blend sample</li></ul>\\n        </div>\\n\\n        <div class='plan'>\\n          <h3>Full Aromatherapy Session</h3>\\n          <p class='price'>$160</p>\\n          <p class='small'>60–75 minutes • deep scent profiling</p>\\n          <ul class='features'><li>Comprehensive intake</li><li>Personalized blend & usage guide</li></ul>\\n        </div>\\n\\n        <div class='plan'>\\n          <h3>Follow-up Visit</h3>\\n          <p class='price'>$95</p>\\n          <p class='small'>30–45 minutes • refine blends</p>\\n          <ul class='features'><li>Adjustments, dilution guidance</li><li>Small refill blend</li></ul>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class='card' style='margin-top:18px'>\\n      <h2>How sessions are structured</h2>\\n      <ol>\\n        <li>Pre-session intake and safety review, including medications and sensitivities.</li>\\n        <li>Scent exploration: guided smelling of safe sample sets.</li>\\n        <li>Blend creation and dilution instructions for at-home use.</li>\\n        <li>Documentation and follow-up plan.</li>\\n      </ol>\\n    </section>\\n\\n    <section class='faq card' aria-label='FAQ'>\\n      <h2>Common questions</h2>\\n      <details open>\\n        <summary>How should I dilute essential oils?</summary>\\n        <p class='small'>Dilution depends on purpose, age, and skin sensitivity. Typical topical dilutions for adults are 1–3% for regular use; for children or sensitive skin, lower dilutions apply. We provide clear dilution guidance with every blend.</p>\\n      </details>\\n      <details>\\n        <summary>What is a patch test?</summary>\\n        <p class='small'>A patch test is applying a small amount of diluted blend to a discrete area of skin for 24 hours to check for irritation. We recommend patch testing new blends before regular topical use.</p>\\n      </details>\\n      <details>\\n        <summary>Are essential oils safe around pets?</summary>\\n        <p class='small'>Some oils can be irritating to pets. We avoid suggesting topical use of known risky oils for animals and provide guidance for diffusing safely (short intervals, leaving the room available to your pet). Always consult your veterinarian for pet-specific concerns.</p>\\n      </details>\\n      <details>\\n        <summary>Pregnancy and aromatherapy</summary>\\n        <p class='small'>Pregnancy involves special considerations. We use a safety-forward approach and will adapt or avoid certain oils. Always share pregnancy status during intake; we will not make medical claims.</p>\\n      </details>\\n    </section>\\n\\n    <section class='card' style='margin-top:18px'>\\n      <h2>Billing & refunds</h2>\\n      <p class='small'>Payments accepted by card and e-transfer. Cancellations with 48 hours notice are refunded minus a small processing fee. Packages may have non-refundable elements; details provided at booking.</p>\\n      <div style='margin-top:10px'>\\n        <a class='btn' href='book.html'>Book now</a>\\n        <a class='ghost' href='contact.html'>Questions? Email {{EMAIL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • Phone: <a href='tel:{{PHONE}}'>{{PHONE}}</a> • <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a></div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--glass:rgba(255,255,255,0.06);--accent:#7aa7a8;--muted:#8f9aa0}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;background:linear-gradient(180deg,#fbfff9,#f3fbff);color:#072226}\\n    .wrap{max-width:980px;margin:28px auto;padding:20px}\\n    .nav{display:flex;gap:12px;align-items:center;padding-bottom:6px}\\n    .nav a{color:#072226;text-decoration:none;padding:8px;border-radius:8px}\\n    .nav a[href$='about.html']{background:rgba(122,167,168,0.09)}\\n    header .brand{font-weight:700}\\n    .intro{display:flex;gap:18px;align-items:flex-start;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:20px;border-radius:14px;backdrop-filter:blur(8px)}\\n    .intro .col{flex:1}\\n    h1{margin:0 0 6px 0}\\n    .muted{color:var(--muted)}\\n    .section{margin-top:18px;padding:16px;border-radius:12px;background:rgba(255,255,255,0.03)}\\n    .cta{display:flex;gap:12px;margin-top:12px}\\n    .btn{background:linear-gradient(90deg,var(--accent),#5b9ea1);color:white;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    .svg-side{width:160px;height:140px}\\n    @media(max-width:760px){.intro{flex-direction:column}.svg-side{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <!-- different inline svg motif for this page -->\\n  <svg viewBox='0 0 600 160' xmlns='http://www.w3.org/2000/svg' style='position:fixed;right:10px;top:20px;opacity:0.08;pointer-events:none'>\\n    <defs>\\n      <linearGradient id='g2' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#cfeff0'/>\\n        <stop offset='1' stop-color='#eaf7ff'/>\\n      </linearGradient>\\n    </defs>\\n    <rect width='600' height='160' fill='url(#g2)' rx='20'/>\\n    <g fill='#7aa7a8'>\\n      <circle cx='60' cy='60' r='6'/>\\n      <circle cx='120' cy='30' r='3.5'/>\\n      <path d='M200 120 C240 40 360 40 400 120' fill='none' stroke='#7aa7a8' stroke-width='1.5' stroke-linecap='round' stroke-opacity='0.8'/>\\n    </g>\\n  </svg>\\n\\n  <div class='wrap'>\\n    <header>\\n      <nav class='nav'>\\n        <div class='brand'>{{BUSINESS_NAME}}</div>\\n        <a href='index.html'>Welcome</a>\\n        <a href='services.html'>What I offer</a>\\n        <a href='blends.html'>Blends</a>\\n        <a href='shop.html'>Shop</a>\\n        <a href='pricing.html'>Fees</a>\\n        <a href='about.html'>About</a>\\n        <a href='book.html'>Book</a>\\n      </nav>\\n    </header>\\n\\n    <section class='intro'>\\n      <div class='col'>\\n        <h1>Quiet expertise, practical aromatherapy</h1>\\n        <p class='muted'>Clinical care meets scent literacy. {{PRACTITIONER_NAME}} guides clients through safe, thoughtful use of essential oils — from diffusion practices to dilution and patch testing.</p>\\n        <div class='cta'>\\n          <a class='btn' href='book.html'>Schedule a consult</a>\\n          <a class='btn' href='contact.html' style='background:transparent;color:#072226;border:1px solid rgba(7,34,38,0.06)'>Contact</a>\\n        </div>\\n      </div>\\n\\n      <aside style='width:260px'>\\n        <div style='background:rgba(255,255,255,0.02);padding:14px;border-radius:12px'>\\n          <img class='svg-side' src='' alt='' aria-hidden='true'/>\\n          <h4 style='margin:8px 0 6px 0'>A hybrid practice</h4>\\n          <p class='muted' style='font-size:14px'>Appointments by video or in-person in {{CITY}}. Safety-first intake and resources are included with every session.</p>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class='section'>\\n      <h2>Philosophy & safety</h2>\\n      <p class='muted'>Our approach is evidence-aware and safety-forward. We do not make medical claims. Each blend and suggestion includes dilution, patch testing steps, and notes about age, pregnancy, and pets when relevant.</p>\\n      <ul>\\n        <li>Clear documentation with every consultation</li>\\n        <li>Blends designed for fragrance, comfort, and mindful use</li>\\n        <li>Emphasis on client education, storage, and safe application</li>\\n      </ul>\\n    </section>\\n\\n    <section class='section'>\\n      <h2>Meet {{PRACTITIONER_NAME}}</h2>\\n      <p class='muted'>With a background in plant chemistry study and client-centered practice, {{PRACTITIONER_NAME}} blends scent knowledge with pragmatic safety checks. Training includes aroma safety, dilution protocols, and client communication best practices.</p>\\n    </section>\\n\\n    <section class='section'>\\n      <h2>What to expect in your first visit</h2>\\n      <ol>\\n        <li>Intake & safety screening.</li>\\n        <li>Guided scent exploration to map preferences.</li>\\n        <li>Creation of an at-home safe blend and instructions.</li>\\n        <li>Paperwork with dilution and patch-test notes.</li>\\n      </ol>\\n      <p class='muted'>If you prefer a remote appointment, we provide a mailout sample kit and video-guided scent session.</p>\\n    </section>\\n\\n    <section class='section'>\\n      <h2>FAQ highlights</h2>\\n      <details><summary>Dilution best practices</summary><p class='muted'>We recommend adult dilutions around 1–3% for topical blends. Specifics depend on purpose and individual sensitivity.</p></details>\\n      <details><summary>Patch testing</summary><p class='muted'>Patch testing is recommended for all new topical blends prior to regular use.</p></details>\\n      <details><summary>Pets and essential oils</summary><p class='muted'>We provide pet-safe alternatives and diffusion guidance; consult your vet when in doubt.</p></details>\\n      <details><summary>Pregnancy considerations</summary><p class='muted'>We exercise added caution in pregnancy; full disclosure of status at booking is requested and will guide recommendations.</p></details>\\n    </section>\\n\\n    <footer style='margin-top:18px;color:var(--muted)'>\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a> • <a href='book.html'>Book an appointment</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#5aa39f;--muted:#7e8a8a}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#f8fff9,#f8fbff);color:#052729}\\n    .wrap{max-width:980px;margin:24px auto;padding:20px}\\n    .nav{display:flex;gap:10px;align-items:center}\\n    .nav a{color:#052729;text-decoration:none;padding:8px;border-radius:8px}\\n    .nav a[href$='book.html']{background:rgba(90,163,159,0.08)}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:18px;margin-top:18px}\\n    .card{background:rgba(255,255,255,0.02);padding:18px;border-radius:14px;backdrop-filter:blur(8px)}\\n    label{display:block;font-size:14px;margin-top:10px}\\n    input[type='text'],input[type='email'],select,textarea{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid rgba(5,41,41,0.06)}\\n    .btn{display:inline-block;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#4b9d99);color:white;text-decoration:none;margin-top:12px}\\n    .small{color:var(--muted);font-size:13px}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- page-specific decorative svg -->\\n  <svg viewBox='0 0 400 100' style='position:fixed;left:12px;bottom:12px;opacity:0.08;pointer-events:none' xmlns='http://www.w3.org/2000/svg'>\\n    <circle cx='80' cy='50' r='40' fill='#bfeeee' />\\n    <circle cx='220' cy='30' r='24' fill='#dff7f6' />\\n  </svg>\\n\\n  <div class='wrap'>\\n    <header>\\n      <nav class='nav'>\\n        <div class='brand'>{{BUSINESS_NAME}}</div>\\n        <a href='index.html'>Start</a>\\n        <a href='services.html'>Details</a>\\n        <a href='blends.html'>Blends</a>\\n        <a href='book.html'>Reserve</a>\\n        <a href='contact.html'>Help</a>\\n      </nav>\\n    </header>\\n\\n    <main class='grid'>\\n      <section class='card'>\\n        <h1>Reserve your aromatherapy session</h1>\\n        <p class='small'>Select a service below. We schedule hybrid appointments — choose in-person for {{CITY}} or virtual. If you need guidance, call <a href='tel:{{PHONE}}'>{{PHONE}}</a>.</p>\\n\\n        <form action='{{PRIMARY_CTA_URL}}' method='get' aria-label='Booking form'>\\n          <label for='name'>Full name</label>\\n          <input id='name' name='name' type='text' placeholder='Your name' required>\\n\\n          <label for='email'>Email</label>\\n          <input id='email' name='email' type='email' placeholder='you@domain.com' required>\\n\\n          <label for='service'>Service</label>\\n          <select id='service' name='service'>\\n            <option>Intro Consultation — 30–45m</option>\\n            <option>Full Aromatherapy Session — 60–75m</option>\\n            <option>Follow-up — 30–45m</option>\\n            <option>Sample Kit + Virtual Scent Session</option>\\n          </select>\\n\\n          <label for='pref'>Scent preferences / concerns</label>\\n          <textarea id='pref' name='preferences' rows='4' placeholder='Any sensitivities, pregnancy, pets, or fragrance likes/dislikes'></textarea>\\n\\n          <label for='date'>Preferred dates</label>\\n          <input id='date' name='date' type='text' placeholder='e.g., mornings, weekdays, Mar 28'>\\n\\n          <p class='small' style='margin-top:10px'>All bookings include a safety intake. If pregnant or managing major health concerns, please indicate that in the preferences so we can adapt or refer appropriately.</p>\\n\\n          <button class='btn' type='submit'>Book — {{PRIMARY_CTA_LABEL}}</button>\\n        </form>\\n\\n        <section style='margin-top:14px'>\\n          <h3 style='margin:0'>What happens next</h3>\\n          <ol class='small'>\\n            <li>You will receive a confirmation email with pre-visit intake.</li>\\n            <li>We will mail or bring sample vials if needed for a scent session.</li>\\n            <li>Documentation includes dilution and patch-test guidance.</li>\\n          </ol>\\n        </section>\\n      </section>\\n\\n      <aside class='card'>\\n        <h3>Quick schedule and pricing</h3>\\n        <p class='small'>Appointments are typically available weekdays; weekend times by request. See full pricing on the Rates page.</p>\\n        <div style='margin-top:12px'>\\n          <div style='margin-bottom:8px'>Intro Consultation — <strong>$85</strong></div>\\n          <div style='margin-bottom:8px'>Full Session — <strong>$160</strong></div>\\n          <div>Follow-up — <strong>$95</strong></div>\\n        </div>\\n\\n        <h4 style='margin-top:14px'>Safety checklist</h4>\\n        <ul class='small'>\\n          <li>Patch test guidance included</li>\\n          <li>Special pregnancy notes on intake</li>\\n          <li>Pet-safe diffusion advice available</li>\\n        </ul>\\n\\n        <div style='margin-top:12px'>\\n          <a class='btn' href='mailto:{{EMAIL}}'>Email {{PRACTITIONER_NAME}}</a>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <footer style='max-width:980px;margin:20px auto;padding:0 20px;color:var(--muted)'>\\n      <div>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}} • Phone <a href='tel:{{PHONE}}'>{{PHONE}}</a> • <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
