          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#fffaf6;--bg2:#f6fbff;--accent:#6aa84f;--muted:#6b6b6b;--card:#ffffff}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#222}\\n    body{background:linear-gradient(180deg,var(--bg1),var(--bg2));\\n          -webkit-font-smoothing:antialiased;line-height:1.45}\\n    header{position:relative;padding:28px 20px 10px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,#ffe6d9,#e8fff7);display:grid;place-items:center;box-shadow:0 6px 18px rgba(34,34,34,0.08)}\\n    .logo svg{width:36px;height:36px}\\n    .brand h1{font-size:16px;margin:0}\\n    .tag{font-size:12px;color:var(--muted)}\\n    nav a{margin-left:18px;text-decoration:none;color:#333;font-weight:600}\\n    nav a[href$=\\\"services.html\\\"]{color:var(--accent)}\\n    .container{max-width:1080px;margin:28px auto;padding:20px}\\n\\n    /* background pattern */\\n    .pattern-holder{position:fixed;inset:0;pointer-events:none;z-index:0;opacity:0.12}\\n    .pattern-svg{width:100%;height:100%}\\n\\n    .hero{display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:center;padding:28px;background:linear-gradient(180deg,rgba(255,255,255,0.6),transparent);border-radius:16px;box-shadow:0 8px 30px rgba(34,34,34,0.05);position:relative;z-index:1}\\n    .hero h2{margin:0 0 10px;font-size:28px;color:#163a2f}\\n    .hero p{margin:0;color:var(--muted)}\\n    .hero .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 20px rgba(20,20,20,0.04)}\\n    .cta-btn{display:inline-block;padding:10px 16px;background:linear-gradient(90deg,var(--accent),#4aa0d1);color:white;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:20px}\\n    .service{background:linear-gradient(180deg,#fff,#fbfbff);padding:18px;border-radius:12px;box-shadow:0 6px 14px rgba(34,34,34,0.04)}\\n    .service h3{margin:0 0 8px;font-size:16px}\\n    .muted{color:var(--muted);font-size:14px}\\n\\n    .section{margin-top:28px;padding:20px;background:rgba(255,255,255,0.8);border-radius:12px}\\n    .section h4{margin:0 0 12px;font-size:18px;color:#1e3d2f}\\n    .flex{display:flex;gap:16px;align-items:flex-start}\\n    .pill{background:#f3f7f1;padding:8px 10px;border-radius:999px;font-weight:700;color:#356038}\\n\\n    .faq dt{font-weight:700;margin-top:14px}\\n    .faq dd{margin:6px 0 0;color:var(--muted)}\\n\\n    footer{margin-top:30px;padding:20px;text-align:center;color:var(--muted);font-size:14px}\\n\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr 1fr}.container{padding:14px}}\\n    @media(max-width:520px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern-holder\\\" aria-hidden=\\\"true\\\">\\n    <svg class=\\\"pattern-svg\\\" viewBox=\\\"0 0 800 600\\\" preserveAspectRatio=\\\"xMidYMid slice\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#ffefd5\\\" />\\n          <stop offset=\\\"1\\\" stop-color=\\\"#e9fff4\\\" />\\n        </linearGradient>\\n        <pattern id=\\\"p1\\\" width=\\\"120\\\" height=\\\"120\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(18)\\\">\\n          <rect width=\\\"120\\\" height=\\\"120\\\" fill=\\\"url(#g1)\\\" />\\n          <g fill=\\\"none\\\" stroke=\\\"#dfeee6\\\" stroke-width=\\\"1.2\\\">\\n            <circle cx=\\\"20\\\" cy=\\\"20\\\" r=\\\"18\\\" opacity=\\\"0.6\\\"/>\\n            <circle cx=\\\"80\\\" cy=\\\"80\\\" r=\\\"14\\\" opacity=\\\"0.4\\\"/>\\n            <path d=\\\"M0 60 L120 60\\\" opacity=\\\"0.25\\\"/>\\n          </g>\\n        </pattern>\\n      </defs>\\n      <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\" />\\n    </svg>\\n  </div>\\n\\n  <header class=\\\"container\\\">\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\" aria-hidden=\\\"true\\\">\\n        <svg viewBox=\\\"0 0 48 48\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><rect width=\\\"48\\\" height=\\\"48\\\" rx=\\\"10\\\" fill=\\\"url(#lg)\\\"/><defs><linearGradient id=\\\"lg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#ffd\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#e8fff7\\\"/></linearGradient></defs><path d=\\\"M24 10c-6 0-10 4-10 9 0 6 10 19 10 19s10-13 10-19c0-5-4-9-10-9z\\\" fill=\\\"#7bbf9b\\\"/></svg>\\n      </div>\\n      <div>\\n        <h1>{{BUSINESS_NAME}}</h1>\\n        <div class=\\\"tag\\\">Gentle aromatherapy in {{CITY}}, {{STATE}} — {{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Boutique</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h2>Personalized sessions, membership rhythms</h2>\\n        <p>Our consultations and membership program emphasize safety, seasonal rhythm, and ritual — crafted to help you welcome calm, clarity, or gentle uplift without medical promises.</p>\\n        <div style=\\\"margin-top:14px\\\">\\n          <a class=\\\"cta-btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n      <aside class=\\\"card\\\">\\n        <strong>Membership model</strong>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Monthly blends, 20% artisan product discount, two seasonal check-ins. Cancel anytime. Learn more on Pricing.</p>\\n        <div style=\\\"margin-top:12px\\\"><span class=\\\"pill\\\">Safe · Small batches · Ethical</span></div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"section\\\" aria-labelledby=\\\"rituals\\\">\\n      <h4 id=\\\"rituals\\\">Rituals & how sessions flow</h4>\\n      <div class=\\\"flex\\\">\\n        <div style=\\\"flex:1\\\">\\n          <p class=\\\"muted\\\">Each session is a co-created ritual: consultation, scent profiling, blend selection, and at-home practice suggestions. No health claims are made — we focus on scent, sensation, and supportive coping strategies.</p>\\n        </div>\\n        <div style=\\\"width:220px\\\">\\n          <div class=\\\"pill\\\">60–75 minutes</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\" aria-labelledby=\\\"expect\\\">\\n      <h4 id=\\\"expect\\\">What to expect</h4>\\n      <div class=\\\"muted\\\">Expect a thoughtful intake about preferences, sensitivities, medications, pets, pregnancy status, and prior reactions. All blends include clear dilution guidance and patch-test recommendations. You will leave with a labeled blend and a simple ritual card.</div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h4>Our service menu</h4>\\n      <div class=\\\"grid\\\" role=\\\"list\\\">\\n        <article class=\\\"service\\\" role=\\\"listitem\\\">\\n          <h3>Intro Ritual — 75 min</h3>\\n          <div class=\\\"muted\\\">Consultation + scent profile + 5 ml take-home sample.</div>\\n        </article>\\n        <article class=\\\"service\\\" role=\\\"listitem\\\">\\n          <h3>Deep Scentwork — 90 min</h3>\\n          <div class=\\\"muted\\\">Extended explorations, multi-blend layering, and personalized ritual planning.</div>\\n        </article>\\n        <article class=\\\"service\\\" role=\\\"listitem\\\">\\n          <h3>Membership check-in</h3>\\n          <div class=\\\"muted\\\">30-minute seasonal tune-in for members; adjustments and refill options.</div>\\n        </article>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\" aria-labelledby=\\\"pricing\\\">\\n      <h4 id=\\\"pricing\\\">Pricing & membership note</h4>\\n      <p class=\\\"muted\\\">Stand-alone sessions and a tiered membership are available. Members receive product discounts and curated mini-blends. See Pricing page for full breakdown.</p>\\n    </section>\\n\\n    <section class=\\\"section\\\" aria-labelledby=\\\"faq\\\">\\n      <h4 id=\\\"faq\\\">Common questions</h4>\\n      <dl class=\\\"faq\\\">\\n        <dt>How do you handle dilution?</dt>\\n        <dd>We provide clearly labeled blends with suggested dilution ratios and safe carrier suggestions. For roll-ons we typically use 2–5% for adults; lower for sensitive users.</dd>\\n        <dt>Should I do a patch test?</dt>\\n        <dd>Yes — we recommend applying a small amount behind the ear or on the forearm for 24 hours before regular use.</dd>\\n        <dt>Are blends pet-safe?</dt>\\n        <dd>Essential oils can affect animals differently. We will flag blends that are not recommended around cats or small mammals. Always keep diffusers and applied oils away from pet-facing areas.</dd>\\n        <dt>Pregnancy and nursing?</dt>\\n        <dd>We follow conservative safety practices: many oils are avoided during pregnancy. Please share status during intake so we can tailor options.</dd>\\n      </dl>\\n    </section>\\n\\n    <section class=\\\"section\\\" aria-labelledby=\\\"booking\\\">\\n      <h4 id=\\\"booking\\\">Ready to begin?</h4>\\n      <p class=\\\"muted\\\">Book a discovery session or join the membership for ongoing seasonal blends.</p>\\n      <a class=\\\"cta-btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </section>\\n\\n    <footer>\\n      <div>Questions? Call {{PHONE}} • {{EMAIL}}</div>\\n      <div style=\\\"margin-top:6px\\\">Proudly serving {{CITY}}, {{STATE}} — Practitioner: {{PRACTITIONER_NAME}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Blends & Profiles — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f7fffb;--accent:#7a9a6e;--muted:#666}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;color:#122;background:var(--bg);-webkit-font-smoothing:antialiased}\\n    .wrap{max-width:1100px;margin:24px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:16px;text-decoration:none;color:#334}\\n    .nav a[href$=\\\"blends.html\\\"]{font-weight:700;color:var(--accent)}\\n\\n    .hero{background:linear-gradient(135deg,#fffdf7,#f2fff8);padding:24px;border-radius:12px;box-shadow:0 8px 30px rgba(17,24,20,0.04);display:flex;gap:18px}\\n    .hero h2{margin:0;color:#18402f}\\n    .hero p{margin:6px 0 0;color:var(--muted)}\\n\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .blend{background:white;padding:14px;border-radius:12px;box-shadow:0 6px 18px rgba(16,24,20,0.04);border:1px solid rgba(120,140,120,0.08)}\\n    .blend h3{margin:0 0 6px;font-size:16px}\\n    .notes{font-size:13px;color:var(--muted)}\\n    .support{margin-top:8px;font-weight:700;color:#2b5f3f;font-size:13px}\\n\\n    .safety{margin-top:18px;background:#fff;padding:12px;border-radius:10px;color:var(--muted)}\\n\\n    .faq dt{font-weight:700;margin-top:12px}\\n    .faq dd{margin:6px 0 0;color:var(--muted)}\\n\\n    footer{margin-top:20px;color:var(--muted);font-size:13px}\\n\\n    @media(max-width:920px){.grid{grid-template-columns:repeat(2,1fr)}}\\n    @media(max-width:560px){.grid{grid-template-columns:1fr}.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <h1 style=\\\"margin:0\\\">{{BUSINESS_NAME}} Blends</h1>\\n        <div style=\\\"color:var(--muted);font-size:13px\\\">A rotating collection of small-batch aromatics — crafted for safe, sensory support.</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"blends.html\\\">Profiles</a>\\n        <a href=\\\"shop.html\\\">Shop</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\" aria-labelledby=\\\"hero-title\\\">\\n      <div>\\n        <h2 id=\\\"hero-title\\\">Curated blends for everyday moments</h2>\\n        <p>We label top, middle, and base notes and include a clear \\\"supports\\\" line — no guarantees, only thoughtful scent intent and safety cues.</p>\\n      </div>\\n      <div style=\\\"min-width:260px;background:linear-gradient(180deg,#f9fff4,#fff7fb);padding:12px;border-radius:10px\\\">\\n        <strong>Tip</strong>\\n        <p style=\\\"margin:8px 0 0;color:var(--muted)\\\">Start with a patch test and follow recommended dilution. Keep blends away from pet-facing areas.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"grid\\\" role=\\\"list\\\">\\n        <!-- 10 blends -->\\n        <article class=\\\"blend\\\" role=\\\"listitem\\\">\\n          <h3>Morning Clarity</h3>\\n          <div class=\\\"notes\\\">Top: Lemon, Grapefruit; Middle: Rosemary; Base: Vetiver</div>\\n          <div class=\\\"support\\\">Aroma profile: bright · herbaceous · grounding — supports alertness and a clear start to your day.</div>\\n        </article>\\n\\n        <article class=\\\"blend\\\" role=\\\"listitem\\\">\\n          <h3>Evening Unwind</h3>\\n          <div class=\\\"notes\\\">Top: Sweet Orange; Middle: Lavender; Base: Benzoin</div>\\n          <div class=\\\"support\\\">Aroma profile: soft · floral · resinous — supports relaxation and gentle evening rituals.</div>\\n        </article>\\n\\n        <article class=\\\"blend\\\" role=\\\"listitem\\\">\\n          <h3>Focus Grove</h3>\\n          <div class=\\\"notes\\\">Top: Bergamot; Middle: Cedarwood; Base: Frankincense</div>\\n          <div class=\\\"support\\\">Aroma profile: bright · woody · warm — supports concentration and calm focus.</div>\\n        </article>\\n\\n        <article class=\\\"blend\\\" role=\\\"listitem\\\">\\n          <h3>Comfort Hearth</h3>\\n          <div class=\\\"notes\\\">Top: Mandarin; Middle: Cardamom; Base: Vanilla</div>\\n          <div class=\\\"support\\\">Aroma profile: sweet · spicy · cozy — supports comfort during quiet or reflective moments.</div>\\n        </article>\\n\\n        <article class=\\\"blend\\\" role=\\\"listitem\\\">\\n          <h3>Clear Breath</h3>\\n          <div class=\\\"notes\\\">Top: Eucalyptus; Middle: Rosemary; Base: Pine</div>\\n          <div class=\\\"support\\\">Aroma profile: crisp · camphorous · clean — supports open air sensation in a safe, diluted format.</div>\\n        </article>\\n\\n        <article class=\\\"blend\\\" role=\\\"listitem\\\">\\n          <h3>Serene Meadow</h3>\\n          <div class=\\\"notes\\\">Top: Geranium; Middle: Lavender; Base: Patchouli</div>\\n          <div class=\\\"support\\\">Aroma profile: floral · herbaceous · earthy — supports a sense of gentle serenity.</div>\\n        </article>\\n\\n        <article class=\\\"blend\\\" role=\\\"listitem\\\">\\n          <h3>Warm Amber</h3>\\n          <div class=\\\"notes\\\">Top: Bergamot; Middle: Clove; Base: Amber</div>\\n          <div class=\\\"support\\\">Aroma profile: spicy · resinous · warm — supports grounding rituals and cozy spaces.</div>\\n        </article>\\n\\n        <article class=\\\"blend\\\" role=\\\"listitem\\\">\\n          <h3>Green Pause</h3>\\n          <div class=\\\"notes\\\">Top: Litsea; Middle: Basil; Base: Oakmoss</div>\\n          <div class=\\\"support\\\">Aroma profile: fresh · green · slightly bitter — supports mindful pauses and micro-breaks.</div>\\n        </article>\\n\\n        <article class=\\\"blend\\\" role=\\\"listitem\\\">\\n          <h3>Night Silk</h3>\\n          <div class=\\\"notes\\\">Top: Roman Chamomile; Middle: Lavender; Base: Sandalwood</div>\\n          <div class=\\\"support\\\">Aroma profile: soft · soothing · woody — supports pre-sleep rituals when used conservatively.</div>\\n        </article>\\n\\n        <article class=\\\"blend\\\" role=\\\"listitem\\\">\\n          <h3>Citrus Lift</h3>\\n          <div class=\\\"notes\\\">Top: Grapefruit; Middle: Neroli; Base: Musk (plant-derived)</div>\\n          <div class=\\\"support\\\">Aroma profile: uplifting · floral-citrus — supports gentle mood uplift during daytime use.</div>\\n        </article>\\n\\n      </div>\\n\\n      <div class=\\\"safety\\\">\\n        <strong>Safety & usage notes</strong>\\n        <p class=\\\"muted\\\">All blends list top/middle/base notes, suggested dilution, and patch-test guidance. We avoid recommending use around young children or certain pets for some oils. If pregnant, nursing, or managing a medical condition, please consult a licensed health professional before use and inform us during intake.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h4 style=\\\"margin:0 0 8px\\\">FAQ</h4>\\n      <dl class=\\\"faq\\\">\\n        <dt>What dilution is used?</dt>\\n        <dd>Our ready-to-use products include recommended dilution ratios on the label. For adult topical roll-ons we typically keep between 1–5% depending on intention and sensitivity.</dd>\\n        <dt>How to patch test?</dt>\\n        <dd>Apply a small dot of diluted oil to an inner forearm or behind the ear. Wait 24 hours to check for irritation.</dd>\\n        <dt>Are your blends safe for pets?</dt>\\n        <dd>Some oils can affect pets differently. We advise not diffusing continuously in occupied pet spaces and will flag any blend not recommended around cats or small mammals.</dd>\\n        <dt>What about pregnancy?</dt>\\n        <dd>We take a conservative approach — many oils are avoided or reduced. Always disclose pregnancy or breastfeeding before use.</dd>\\n      </dl>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"margin-top:16px\\\">Prefer a personal recommendation? Email {{EMAIL}} or call {{PHONE}}. Proudly blended by {{PRACTITIONER_NAME}}.</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Boutique — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffaf9;--card:#ffffff;--accent:#5b8a64;--muted:#666}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#fff,#f3fff8);color:#163}\\n    .wrap{max-width:1100px;margin:20px auto;padding:18px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:14px;color:#345;text-decoration:none}\\n    .nav a[href$=\\\"shop.html\\\"]{font-weight:700;color:var(--accent)}\\n\\n    .hero{padding:18px;border-radius:12px;background:linear-gradient(90deg,#fffdf8,#f7fff7);display:flex;justify-content:space-between;align-items:center}\\n\\n    .products{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .card{background:var(--card);padding:14px;border-radius:12px;box-shadow:0 8px 26px rgba(14,20,12,0.05);border:1px solid rgba(90,120,90,0.06)}\\n    .card h3{margin:0 0 8px}\\n    .price{color:var(--accent);font-weight:800}\\n    .muted{color:var(--muted)}\\n    .shop-cta{display:inline-block;margin-top:10px;padding:8px 12px;background:linear-gradient(90deg,#6aa84f,#4aa0d1);color:white;border-radius:8px;text-decoration:none;font-weight:700}\\n\\n    .note{margin-top:16px;background:#fff;padding:12px;border-radius:10px;color:var(--muted)}\\n\\n    footer{margin-top:22px;color:var(--muted);font-size:13px}\\n\\n    @media(max-width:920px){.products{grid-template-columns:repeat(2,1fr)}}\\n    @media(max-width:580px){.products{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <h1 style=\\\"margin:0\\\">{{BUSINESS_NAME}} Boutique</h1>\\n        <div style=\\\"color:var(--muted);font-size:13px\\\">Small-batch blends, travel kits, and ritual tools — thoughtfully labeled and safety-forward.</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Sessions</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"shop.html\\\">Boutique</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\" aria-labelledby=\\\"shop-hero\\\">\\n      <div>\\n        <h2 id=\\\"shop-hero\\\">Shop curated essentials</h2>\\n        <p class=\\\"muted\\\">Each product includes dilution and patch-test instructions. Not a substitute for medical advice — safe aromatic support only.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"shop-cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"products\\\" aria-label=\\\"Products\\\">\\n      <article class=\\\"card\\\">\\n        <h3>Starter Ritual Kit</h3>\\n        <div class=\\\"muted\\\">Includes 3 x 5 ml blends, dilution card, and ritual guide.</div>\\n        <div style=\\\"margin-top:8px\\\" class=\\\"price\\\">$48</div>\\n        <a class=\\\"shop-cta\\\" href=\\\"shop.html#kit\\\">Add to cart</a>\\n      </article>\\n\\n      <article class=\\\"card\\\">\\n        <h3>Calm Roll-On (10 ml)</h3>\\n        <div class=\\\"muted\\\">Pre-diluted blend for pulse points — labeled dilution 2%.</div>\\n        <div style=\\\"margin-top:8px\\\" class=\\\"price\\\">$16</div>\\n        <a class=\\\"shop-cta\\\" href=\\\"shop.html#calm\\\">Add to cart</a>\\n      </article>\\n\\n      <article class=\\\"card\\\">\\n        <h3>Focus Roll-On (10 ml)</h3>\\n        <div class=\\\"muted\\\">Citrus and cedar profile — kept at conservative dilution for daytime use.</div>\\n        <div style=\\\"margin-top:8px\\\" class=\\\"price\\\">$16</div>\\n        <a class=\\\"shop-cta\\\" href=\\\"shop.html#focus\\\">Add to cart</a>\\n      </article>\\n\\n      <article class=\\\"card\\\">\\n        <h3>Diffuser — Ceramic</h3>\\n        <div class=\\\"muted\\\">Compact ultrasonic diffuser, timed settings, quiet operation.</div>\\n        <div style=\\\"margin-top:8px\\\" class=\\\"price\\\">$44</div>\\n        <a class=\\\"shop-cta\\\" href=\\\"shop.html#diff\\\">Add to cart</a>\\n      </article>\\n\\n      <article class=\\\"card\\\">\\n        <h3>Travel Roller Trio</h3>\\n        <div class=\\\"muted\\\">Three 5 ml travel-ready blends in a reusable pouch.</div>\\n        <div style=\\\"margin-top:8px\\\" class=\\\"price\\\">$34</div>\\n        <a class=\\\"shop-cta\\\" href=\\\"shop.html#trio\\\">Add to cart</a>\\n      </article>\\n\\n      <article class=\\\"card\\\">\\n        <h3>Seasonal Refill (5 ml)</h3>\\n        <div class=\\\"muted\\\">Monthly member refill; small-batch, labeled with dilution guidance.</div>\\n        <div style=\\\"margin-top:8px\\\" class=\\\"price\\\">$12</div>\\n        <a class=\\\"shop-cta\\\" href=\\\"shop.html#refill\\\">Add to cart</a>\\n      </article>\\n\\n    </section>\\n\\n    <section class=\\\"note\\\">\\n      <strong>Important safety reminders</strong>\\n      <p class=\\\"muted\\\">Always patch test new products. Keep roll-ons and diffusers out of reach of children and pets. If pregnant, nursing, or taking prescription medications, consult your healthcare provider before use and let us know so we can recommend safe options. Products are sold as aromatic supports and are not medical treatments.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h4 style=\\\"margin:0 0 8px\\\">Shipping & returns</h4>\\n      <div class=\\\"muted\\\">Domestic shipping typically ships in 2–4 business days. Returns accepted on unopened retail items within 14 days. Membership product exceptions may apply.</div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"margin-top:16px\\\">Questions? Email {{EMAIL}} or call {{PHONE}}. Practitioner: {{PRACTITIONER_NAME}}. Favorite blend: {{FAVORITE_BLEND}}.</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
