          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Offerings</title>\\n  <style>\\n    :root{--bg1:#0f1724;--bg2:#071026;--accent1:#9be3c2;--accent2:#ffd6a5;--muted:#cbd5e1;--card:#0b1720}\\n    *{box-sizing:border-box}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:var(--muted);background:linear-gradient(180deg,var(--bg1),var(--bg2));}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 40px;position:relative}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent1),#7bd3ff);display:grid;place-items:center;font-weight:700;color:#052023}\\n    nav a{color:rgba(255,255,255,0.85);text-decoration:none;margin-left:18px;font-weight:600}\\n    nav a:hover{text-decoration:underline}\\n    main{padding:40px;max-width:1100px;margin:0 auto}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;margin-top:18px}\\n    .hero .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:28px;border-radius:14px;box-shadow:0 6px 30px rgba(2,6,23,0.6)}\\n    h1{color:#fff;margin:0 0 6px;font-size:28px;letter-spacing:0.2px}\\n    p.lead{color:var(--muted);margin:0 0 12px}\\n    .muted-sm{color:#9fb3b1;font-size:14px}\\n    .pill{display:inline-block;padding:8px 12px;background:linear-gradient(90deg,rgba(155,227,194,0.12),rgba(255,214,165,0.06));border-radius:999px;color:var(--accent1);font-weight:700}\\n    .ritual-list{display:grid;gap:12px;margin-top:18px}\\n    .ritual{background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);padding:14px;border-radius:10px;border:1px solid rgba(255,255,255,0.03)}\\n    .two-col{display:grid;grid-template-columns:1fr 1fr;gap:18px}\\n    footer.small{padding:28px;text-align:center;color:#9fb3b1}\\n    /* product & pricing */\\n    .pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .price-card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .price{font-size:20px;color:var(--accent2);font-weight:700}\\n    .cta{display:inline-block;padding:12px 16px;background:linear-gradient(90deg,var(--accent1),var(--accent2));color:#052023;border-radius:10px;text-decoration:none;font-weight:700}\\n    .faq{margin-top:22px}\\n    details{background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);padding:12px;border-radius:10px;border:1px solid rgba(255,255,255,0.03);margin-bottom:10px}\\n    /* subtle pattern */\\n    .pattern{position:fixed;right:-120px;top:-80px;opacity:0.08;width:520px;height:520px;pointer-events:none}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.pricing-grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- inline SVG pattern (unique to services) -->\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#7be3c2\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#ffd6a5\\\"/></linearGradient>\\n      <pattern id=\\\"p1\\\" width=\\\"20\\\" height=\\\"20\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(22)\\\">\\n        <rect width=\\\"20\\\" height=\\\"20\\\" fill=\\\"rgba(255,255,255,0)\\\"/>\\n        <circle cx=\\\"4\\\" cy=\\\"4\\\" r=\\\"1.8\\\" fill=\\\"url(#g1)\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\"/>\\n    <g transform=\\\"translate(30,30) rotate(18)\\\">\\n      <path d=\\\"M10 10 C40 20, 60 40, 90 10\\\" stroke=\\\"url(#g1)\\\" stroke-width=\\\"0.8\\\" fill=\\\"none\\\" opacity=\\\"0.9\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:700;color:#fff\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"muted-sm\\\">A modern apothecary for calm — {{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Essence Sessions</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Apothecary</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"card\\\">\\n        <span class=\\\"pill\\\">Personalized Rituals</span>\\n        <h1>Guided aromatherapy sessions with {{PRACTITIONER_NAME}}</h1>\\n        <p class=\\\"lead\\\">We design gentle scent journeys at {{BUSINESS_NAME}} — no medical promises, only careful, sensory-led support for daily wellbeing.</p>\\n        <div class=\\\"ritual-list\\\">\\n          <div class=\\\"ritual\\\">\\n            <strong>Intake & Intention</strong>\\n            <div class=\\\"muted-sm\\\">A short conversation about scent history, sensitivities, and your intentions. Safety-first: we review dilution and patch-test protocol.</div>\\n          </div>\\n          <div class=\\\"ritual\\\">\\n            <strong>Custom Blend Creation</strong>\\n            <div class=\\\"muted-sm\\\">Hands-on mixing with clinical-grade carrier choices. Blends are created for aroma preference and situational support, not diagnosis.</div>\\n          </div>\\n          <div class=\\\"ritual\\\">\\n            <strong>Guided Inhalation Ritual</strong>\\n            <div class=\\\"muted-sm\\\">A calm 10–20 minute guided inhalation paired with breathwork. Soothing music, dim light, and grounding techniques included.</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <div style=\\\"display:flex;flex-direction:column;gap:14px\\\">\\n          <div>\\n            <div class=\\\"muted-sm\\\">Quick booking</div>\\n            <div style=\\\"font-weight:700;color:#fff\\\">30–90 minute formats</div>\\n          </div>\\n          <div>\\n            <div class=\\\"muted-sm\\\">Phone</div>\\n            <div>{{PHONE}}</div>\\n          </div>\\n          <div>\\n            <div class=\\\"muted-sm\\\">Email</div>\\n            <div>{{EMAIL}}</div>\\n          </div>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"two-col\\\" style=\\\"margin-top:24px\\\">\\n      <div class=\\\"card\\\">\\n        <h2 style=\\\"color:#fff;margin-top:0\\\">What a session feels like</h2>\\n        <p class=\\\"muted-sm\\\">A gentle blend of scent, breath, and attention. We'll always prioritize safety: allergens, pregnancy or pet concerns, and personal sensitivities are discussed.</p>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin:12px 0 6px;color:var(--accent1)\\\">What to expect</h3>\\n          <ul style=\\\"color:#9fb3b1;margin:0;padding-left:18px\\\">\\n            <li>Warm welcome and intake (5–10 minutes)</li>\\n            <li>Patch-test and dilution review before topical use</li>\\n            <li>Guided inhalation or roll-on application options</li>\\n            <li>Aftercare notes and scent care for home</li>\\n          </ul>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"color:var(--accent2);margin-top:0\\\">Scheduling</h3>\\n        <p class=\\\"muted-sm\\\">Online booking is best. Walk-ins considered by availability. If pregnant, nursing, or planning surgery, please notify us when booking.</p>\\n        <div class=\\\"pricing-grid\\\" style=\\\"margin-top:12px\\\">\\n          <div class=\\\"price-card\\\">\\n            <div style=\\\"font-weight:700\\\">Intro — 30 min</div>\\n            <div class=\\\"price\\\">$65</div>\\n            <div style=\\\"margin-top:8px;font-size:13px;color:#9fb3b1\\\">Quick intake & single-focus blend</div>\\n          </div>\\n          <div class=\\\"price-card\\\">\\n            <div style=\\\"font-weight:700\\\">Classic — 60 min</div>\\n            <div class=\\\"price\\\">$120</div>\\n            <div style=\\\"margin-top:8px;font-size:13px;color:#9fb3b1\\\">Custom blend + guided ritual</div>\\n          </div>\\n          <div class=\\\"price-card\\\">\\n            <div style=\\\"font-weight:700\\\">Ritual — 90 min</div>\\n            <div class=\\\"price\\\">$170</div>\\n            <div style=\\\"margin-top:8px;font-size:13px;color:#9fb3b1\\\">Extended session and home-care kit</div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3 style=\\\"color:#fff\\\">Frequently asked — safety first</h3>\\n      <details>\\n        <summary>How do you dilute essential oils?</summary>\\n        <div class=\\\"muted-sm\\\">We recommend conservative dilutions: typically 1–2% for adults for short-term topical use. We never advise home use at undiluted strengths. Specific dilution guidance provided in-session and on product labels.</div>\\n      </details>\\n      <details>\\n        <summary>What is a patch test?</summary>\\n        <div class=\\\"muted-sm\\\">A patch test is a small topical test on the inner forearm using diluted oil to check for skin sensitivity prior to broader topical use.</div>\\n      </details>\\n      <details>\\n        <summary>Are essential oils safe around pets?</summary>\\n        <div class=\\\"muted-sm\\\">Many oils can be irritating to animals. We provide guidance on pet-safe choices, ventilation, and avoidance strategies. If you have pets, tell us at booking.</div>\\n      </details>\\n      <details>\\n        <summary>What about pregnancy or nursing?</summary>\\n        <div class=\\\"muted-sm\\\">Certain oils are avoided in pregnancy and nursing. If you are pregnant, nursing, or seeking fertility support, please inform us before booking. We will adapt or decline topical/aromatherapy approaches as needed to prioritize safety.</div>\\n      </details>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;text-align:center\\\">\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a session with {{PRACTITIONER_NAME}}</a>\\n      <div style=\\\"margin-top:8px;color:#9fb3b1;font-size:13px\\\">Questions? Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:inherit\\\">{{EMAIL}}</a></div>\\n    </section>\\n\\n  </main>\\n\\n  <footer class=\\\"small\\\">© {{BUSINESS_NAME}} — A sensory practice in {{CITY}}, {{STATE}} · No medical claims, scent support only.</footer>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Blends & Notes</title>\\n  <style>\\n    :root{--bg:#071021;--card:#07151f;--accent:#c1ffd7;--muted:#bcd6cf}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#041021,#071021);color:var(--muted)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:24px 36px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,#8ef0c6,#ffd7a8);display:grid;place-items:center;font-weight:700;color:#052023}\\n    nav a{margin-left:14px;color:rgba(255,255,255,0.85);text-decoration:none}\\n    main{max-width:1100px;margin:20px auto;padding:18px}\\n    .hero{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:22px;border-radius:12px}\\n    h1{color:#fff;margin:0;font-size:26px}\\n    .intro{color:#9fb3b1}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:18px}\\n    .blend{background:linear-gradient(135deg,rgba(255,255,255,0.01),transparent);padding:14px;border-radius:10px;border:1px solid rgba(255,255,255,0.03)}\\n    .notes{font-size:13px;color:#bcd6cf}\\n    .support{font-size:13px;color:#ffd6a5;font-weight:700;margin-top:6px}\\n    .cta{display:inline-block;margin-top:14px;padding:10px 14px;background:linear-gradient(90deg,#8ef0c6,#ffd6a5);color:#052023;border-radius:10px;text-decoration:none;font-weight:700}\\n    .faq{margin-top:18px}\\n    details{background:transparent;padding:10px;border-radius:8px}\\n    .pattern{position:fixed;left:-120px;bottom:-100px;opacity:0.06;width:520px;height:520px}\\n    @media(max-width:860px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- inline SVG pattern (unique to blends) -->\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <radialGradient id=\\\"bgB\\\" cx=\\\"0.2\\\" cy=\\\"0.2\\\"><stop offset=\\\"0\\\" stop-color=\\\"#8ef0c6\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#ffd7a8\\\"/></radialGradient>\\n      <pattern id=\\\"dots\\\" width=\\\"16\\\" height=\\\"16\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"16\\\" height=\\\"16\\\" fill=\\\"transparent\\\"/>\\n        <circle cx=\\\"2\\\" cy=\\\"2\\\" r=\\\"1.6\\\" fill=\\\"url(#bgB)\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#dots)\\\"/>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">B</div>\\n      <div>\\n        <div style=\\\"font-weight:700;color:#fff\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:#9fb3b1\\\">Curated blends & aromatic notes</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Begin</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Our Blends</a>\\n      <a href=\\\"shop.html\\\">Apothecary</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <h1>Blends — crafted with care</h1>\\n      <p class=\\\"intro\\\">Below are artisan blends we use and offer. Each entry lists top / middle / base notes, an aroma profile, and safe-support language — not medical claims.</p>\\n    </section>\\n\\n    <section class=\\\"grid\\\" aria-label=\\\"blends-list\\\">\\n      <div class=\\\"blend\\\">\\n        <strong>1. Dawn Clarity</strong>\\n        <div class=\\\"notes\\\">Top: Bergamot, Lemon · Middle: Rosemary · Base: Cedarwood</div>\\n        <div class=\\\"support\\\">Aroma: bright, herbaceous, grounding. Supports morning focus and mental clarity rituals when used as inhalation.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>2. Moonlit Calm</strong>\\n        <div class=\\\"notes\\\">Top: Sweet Orange · Middle: Lavender · Base: Vetiver</div>\\n        <div class=\\\"support\\\">Aroma: soft citrus with floral and earthy anchors. Supports evening winding-down practices and relaxation-focused inhalation.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>3. Forest Hearth</strong>\\n        <div class=\\\"notes\\\">Top: Pine · Middle: Clove · Base: Patchouli</div>\\n        <div class=\\\"support\\\">Aroma: smoky-wooded and warm. Useful as atmosphere scent for grounding and centering rituals; avoid direct topical use on sensitive skin without patch testing.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>4. Citrus Lift</strong>\\n        <div class=\\\"notes\\\">Top: Grapefruit · Middle: Neroli · Base: Light Musks (carrier-modulated)</div>\\n        <div class=\\\"support\\\">Aroma: bright, floral-citrus. Intended for short inhalation bursts to refresh mood and bring lightness to a busy day.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>5. Gentle Resolve</strong>\\n        <div class=\\\"notes\\\">Top: Mandarin · Middle: Geranium · Base: Frankincense</div>\\n        <div class=\\\"support\\\">Aroma: rounded floral embed with resinous depth. Supports contemplative practices and focused breathing exercises.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>6. Meadow Walk</strong>\\n        <div class=\\\"notes\\\">Top: Neroli · Middle: Chamomile · Base: Ambrette</div>\\n        <div class=\\\"support\\\">Aroma: breezy and herbal. Designed for gentle inhalation and non-aggressive topical use after patch testing; suited to calm moments outdoors or at home.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>7. Quiet Strength</strong>\\n        <div class=\\\"notes\\\">Top: Black Pepper · Middle: Cardamom · Base: Sandalwood</div>\\n        <div class=\\\"support\\\">Aroma: spicy and woody. Used for centering rituals where a warm, steady presence is desired; keep away from eyes and mucous membranes.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>8. Night Meadow</strong>\\n        <div class=\\\"notes\\\">Top: Lavender · Middle: Marjoram · Base: Cedar</div>\\n        <div class=\\\"support\\\">Aroma: floral-herbal, quietly anchoring. Supports pre-sleep routines as an inhalation option; avoid excessive use around infants.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>9. Citrus Breeze</strong>\\n        <div class=\\\"notes\\\">Top: Lemon Verbena · Middle: Basil · Base: Cypress</div>\\n        <div class=\\\"support\\\">Aroma: crisp green-citrus. Useful for clearing a stuffy room and refreshing ritual spaces; always ventilate well when diffusing.</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3 style=\\\"color:#fff\\\">Safety notes & FAQs</h3>\\n      <details>\\n        <summary>Dilution and topical safety</summary>\\n        <div class=\\\"notes\\\">We use conservative dilution recommendations in-session and on product labels (commonly 1–2% for adults). Never use undiluted essential oils on skin. Seek practitioner guidance for special cases.</div>\\n      </details>\\n      <details>\\n        <summary>Patch test protocol</summary>\\n        <div class=\\\"notes\\\">Apply a small drop of diluted blend to the inner forearm, cover for 24 hours if possible, and monitor for redness, itching, or irritation before broader topical use.</div>\\n      </details>\\n      <details>\\n        <summary>Pets & essential oils</summary>\\n        <div class=\\\"notes\\\">Many oils can be harmful to pets. Keep diffusers in well-ventilated areas and avoid prolonged exposure. Inform us of household animals for tailored guidance.</div>\\n      </details>\\n      <details>\\n        <summary>Pregnancy, nursing, and children</summary>\\n        <div class=\\\"notes\\\">Some oils are avoided during pregnancy or with infants. Notify us at booking; we will adapt blends or recommend alternatives to keep your practice safety-first.</div>\\n      </details>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;text-align:center\\\">\\n      <a class=\\\"cta\\\" href=\\\"shop.html\\\">Explore products & order blends</a>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"text-align:center;color:#9fb3b1;padding:20px 0\\\">{{BUSINESS_NAME}} — blends are crafted for sensory support, not as medical treatment.</footer>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Apothecary</title>\\n  <style>\\n    :root{--bg:#04101a;--card:#071826;--accent:#ffd6a5;--accent2:#9be3c2;--muted:#cbdbe0}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,var(--bg),#021019);color:var(--muted)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 32px}\\n    .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,var(--accent2),var(--accent));display:grid;place-items:center;color:#052023;font-weight:800}\\n    nav a{margin-left:12px;color:rgba(255,255,255,0.88);text-decoration:none}\\n    main{max-width:1200px;margin:22px auto;padding:18px}\\n    .hero{display:flex;justify-content:space-between;align-items:center;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px}\\n    .shop-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .product{background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);padding:16px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .product h4{margin:4px 0;color:#fff}\\n    .price{color:var(--accent);font-weight:800}\\n    .buy{display:inline-block;margin-top:10px;padding:10px 12px;border-radius:10px;background:linear-gradient(90deg,var(--accent2),var(--accent));color:#052023;text-decoration:none;font-weight:700}\\n    .badge{display:inline-block;padding:6px 8px;border-radius:8px;background:rgba(255,255,255,0.03);font-size:13px;color:#9fb3b1}\\n    .faq{margin-top:20px}\\n    .pattern{position:fixed;right:-80px;bottom:-80px;opacity:0.06;width:420px;height:420px}\\n    @media(max-width:920px){.shop-grid{grid-template-columns:1fr}.hero{flex-direction:column;gap:10px}}\\n  </style>\\n</head>\\n<body>\\n  <!-- inline SVG pattern (unique to shop) -->\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"shopGrad\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#9be3c2\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#ffd6a5\\\"/></linearGradient>\\n      <pattern id=\\\"mesh\\\" width=\\\"12\\\" height=\\\"12\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"12\\\" height=\\\"12\\\" fill=\\\"transparent\\\"/>\\n        <path d=\\\"M0 6h12M6 0v12\\\" stroke=\\\"url(#shopGrad)\\\" stroke-width=\\\"0.6\\\" opacity=\\\"0.7\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#mesh)\\\"/>\\n  </svg>\\n\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">S</div>\\n      <div>\\n        <div style=\\\"font-weight:700;color:#fff\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:#9fb3b1\\\">Apothecary & retail offerings</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Sanctum</a>\\n      <a href=\\\"services.html\\\">Sessions</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Shop</a>\\n      <a href=\\\"contact.html\\\">Help</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h2 style=\\\"margin:0;color:#fff\\\">Carefully curated — shop</h2>\\n        <div style=\\\"color:#9fb3b1\\\">Browse kits, roll-ons, and diffusers. All product descriptions include safety guidance and suggested dilutions where applicable.</div>\\n      </div>\\n      <div style=\\\"text-align:right\\\">\\n        <div class=\\\"badge\\\">Free local pickup</div>\\n        <div style=\\\"color:#9fb3b1;font-size:13px;margin-top:8px\\\">Questions? Email {{EMAIL}} or call {{PHONE}}</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"shop-grid\\\" aria-label=\\\"products\\\">\\n      <article class=\\\"product\\\">\\n        <h4>Ritual Starter Kit</h4>\\n        <div style=\\\"color:#9fb3b1;font-size:13px\\\">Contains 3 x 5ml blends, carrier sample, and ritual card.</div>\\n        <div class=\\\"price\\\">$42</div>\\n        <div style=\\\"font-size:13px;color:#bcd6cf;margin-top:6px\\\">Best for newcomers seeking guided scent practice. Includes dilution guide. Not medical.</div>\\n        <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n      </article>\\n\\n      <article class=\\\"product\\\">\\n        <h4>Roll-on — Calm (10ml)</h4>\\n        <div style=\\\"color:#9fb3b1;font-size:13px\\\">Pre-diluted roll-on (2% adult dilution) with Lavender & Vetiver.</div>\\n        <div class=\\\"price\\\">$18</div>\\n        <div style=\\\"font-size:13px;color:#bcd6cf;margin-top:6px\\\">Patch-test recommended before topical use. Keep away from eyes and pets.</div>\\n        <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n      </article>\\n\\n      <article class=\\\"product\\\">\\n        <h4>Diffuser + Blend Set</h4>\\n        <div style=\\\"color:#9fb3b1;font-size:13px\\\">Ultrasonic diffuser with two 10ml blends for home atmosphere.</div>\\n        <div class=\\\"price\\\">$95</div>\\n        <div style=\\\"font-size:13px;color:#bcd6cf;margin-top:6px\\\">Use in well-ventilated areas; limit run-time if pets or infants are present.</div>\\n        <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n      </article>\\n\\n      <article class=\\\"product\\\">\\n        <h4>Portable Roll-on — Focus</h4>\\n        <div style=\\\"color:#9fb3b1;font-size:13px\\\">Cardamom, Lemon, Sandalwood. 1.5% dilution.</div>\\n        <div class=\\\"price\\\">$16</div>\\n        <div style=\\\"font-size:13px;color:#bcd6cf;margin-top:6px\\\">Apply to wrists only after patch-test. Avoid application on children under 2 without practitioner guidance.</div>\\n        <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n      </article>\\n\\n      <article class=\\\"product\\\">\\n        <h4>Mini Travel Kit</h4>\\n        <div style=\\\"color:#9fb3b1;font-size:13px\\\">Three 2ml blends in a recycled tin for on-the-go rituals.</div>\\n        <div class=\\\"price\\\">$28</div>\\n        <div style=\\\"font-size:13px;color:#bcd6cf;margin-top:6px\\\">Great for brief inhalation breaks. Not intended for ingestion or undiluted topical use.</div>\\n        <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n      </article>\\n\\n      <article class=\\\"product\\\">\\n        <h4>Signature Blend — {{FAVORITE_BLEND}}</h4>\\n        <div style=\\\"color:#9fb3b1;font-size:13px\\\">Custom practitioner's blend available in 10ml. Top/mid/base notes vary per batch.</div>\\n        <div class=\\\"price\\\">$24</div>\\n        <div style=\\\"font-size:13px;color:#bcd6cf;margin-top:6px\\\">Created for inhalation and careful topical use; discuss pregnancy or pet exposure with us before purchase.</div>\\n        <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n      </article>\\n\\n      <article class=\\\"product\\\">\\n        <h4>Refill Blend — Moonlit Calm (10ml)</h4>\\n        <div style=\\\"color:#9fb3b1;font-size:13px\\\">Lavender-forward refill for home diffusers (concentrated: dilute for topical use).</div>\\n        <div class=\\\"price\\\">$20</div>\\n        <div style=\\\"font-size:13px;color:#bcd6cf;margin-top:6px\\\">Label includes dilution advice. Keep out of reach of children and pets.</div>\\n        <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n      </article>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3 style=\\\"color:#fff\\\">Shop FAQs — safety and guidance</h3>\\n      <details>\\n        <summary>How should I dilute products for topical use?</summary>\\n        <div style=\\\"color:#bcd6cf\\\">Many shop products are sold pre-diluted. For concentrated oils, follow the included dilution card (commonly 1–2% for adults). If in doubt, consult with {{PRACTITIONER_NAME}}.</div>\\n      </details>\\n      <details>\\n        <summary>What is a patch test?</summary>\\n        <div style=\\\"color:#bcd6cf\\\">Apply a small amount of diluted product to the inner forearm and wait up to 24 hours for reaction. Discontinue if irritation occurs.</div>\\n      </details>\\n      <details>\\n        <summary>Are these products pet-safe?</summary>\\n        <div style=\\\"color:#bcd6cf\\\">Not necessarily. Check blend notes and avoid diffusing or applying products where pets cannot move away. Contact us for pet-safe recommendations.</div>\\n      </details>\\n      <details>\\n        <summary>Pregnancy & special populations</summary>\\n        <div style=\\\"color:#bcd6cf\\\">If pregnant, nursing, or buying for children, consult with your healthcare provider and notify us prior to purchase. Some oils are contraindicated during pregnancy.</div>\\n      </details>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px;text-align:center\\\">\\n      <a class=\\\"buy\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Contact us to arrange pickup or delivery</a>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"text-align:center;color:#9fb3b1;padding:18px 0\\\">{{BUSINESS_NAME}} — Retail items are for aromatic use and sensory support only. For questions: {{PHONE}} · {{EMAIL}}</footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
