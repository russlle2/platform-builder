          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Pricing — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{\\n      --bg:#fbf8f6;--ink:#21312b;--muted:#6b6b6b;--accent:#7aa27a;--card:#ffffff;--glass:rgba(255,255,255,0.6);\\n    }\\n    html,body{height:100%;margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial; color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:24px 28px}\\n    .brand{font-weight:700;letter-spacing:0.4px}\\n    nav a{margin-left:18px;color:var(--ink);text-decoration:none;font-weight:600}\\n    main{max-width:980px;margin:18px auto;padding:24px}\\n    .hero{display:grid;grid-template-columns:1fr;gap:18px;align-items:start}\\n    .intro{background:linear-gradient(180deg,rgba(122,162,122,0.06),transparent);padding:22px;border-radius:12px}\\n    h1{margin:0 0 8px 0;font-size:28px}\\n    p.lead{margin:0;color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .card{background:var(--card);border-radius:12px;padding:18px;box-shadow:0 6px 18px rgba(33,49,43,0.06)}\\n    .price{font-size:22px;font-weight:800;color:var(--accent)}\\n    .muted{color:var(--muted);font-size:14px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;background:var(--accent);color:white;border-radius:8px;text-decoration:none}\\n    .widget{margin-top:22px;padding:16px;border-radius:12px;background:linear-gradient(180deg,var(--glass),transparent);}\\n    label{display:block;font-size:13px;color:var(--muted);margin-top:10px}\\n    select,input[type=number]{width:100%;padding:8px;border-radius:8px;border:1px solid #e6e6e6;margin-top:6px}\\n    .output{white-space:pre-wrap;background:#fcfcfb;padding:12px;border-radius:8px;margin-top:12px;border:1px dashed #eee}\\n    .small{font-size:13px;color:var(--muted)}\\n\\n    /* pattern background using inline SVG dataURI */\\n    body::before{content:\\\"\\\";position:fixed;inset:0;z-index:-1;opacity:0.45;background-image:url('data:image/svg+xml;utf8,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"200\\\" height=\\\"200\\\" viewBox=\\\"0 0 200 200\\\"><defs><linearGradient id=\\\"g\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"%237aa27a\\\" stop-opacity=\\\"0.06\\\"/><stop offset=\\\"1\\\" stop-color=\\\"%2321312b\\\" stop-opacity=\\\"0.02\\\"/></linearGradient></defs><rect width=\\\"200\\\" height=\\\"200\\\" fill=\\\"%23fbf8f6\\\"/><g fill=\\\"none\\\" stroke=\\\"%237aa27a\\\" stroke-opacity=\\\"0.08\\\" stroke-width=\\\"1\\\"><path d=\\\"M0 40 Q40 0 80 40 T160 40 T200 40\\\"/><path d=\\\"M0 80 Q40 40 80 80 T160 80 T200 80\\\"/><path d=\\\"M0 120 Q40 80 80 120 T160 120 T200 120\\\"/></g></svg>');background-repeat:repeat}\\n\\n    footer{margin-top:28px;padding:22px;border-top:1px solid #f0f0f0;color:var(--muted);font-size:13px}\\n    .note{font-size:13px;color:var(--muted);margin-top:10px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Begin</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Market</a>\\n      <a href=\\\"pricing.html\\\">Investments</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"intro card\\\">\\n        <h1>Investments that ground your daily care</h1>\\n        <p class=\\\"lead\\\">Thoughtful sessions and crafted blends — options that meet you where you are. Choose a pace and a container for practice. Small commitments, lasting rituals that may support calm and clarity.</p>\\n      </div>\\n\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"card\\\">\\n          <div class=\\\"muted\\\">Essence Intro</div>\\n          <div class=\\\"price\\\">$95</div>\\n          <p class=\\\"muted\\\">A single 50–60 minute consultation and custom aroma plan. Best for curious first-timers.</p>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Start with a session</a>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <div class=\\\"muted\\\">Monthly Care</div>\\n          <div class=\\\"price\\\">$240 / mo</div>\\n          <p class=\\\"muted\\\">Three monthly 45-minute follow-ups with adjustments to blends and habits. For steady progress and ritualization.</p>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Arrange monthly support</a>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <div class=\\\"muted\\\">Atelier Series</div>\\n          <div class=\\\"price\\\">$420</div>\\n          <p class=\\\"muted\\\">Four-session package; includes two custom blend cards and a home-use plan. For folks wanting deeper integration.</p>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve a series</a>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card widget\\\">\\n        <h3 style=\\\"margin:0 0 6px 0\\\">Blend Builder — safe dilution guide</h3>\\n        <p class=\\\"small\\\">Choose a vibe. A friendly guide suggests oils and a dilution plan you can use at home. No medical claims; for aromatic support only.</p>\\n\\n        <label for=\\\"vibe\\\">Vibe</label>\\n        <select id=\\\"vibe\\\">\\n          <option value=\\\"calm\\\">Calm (soft unwind)</option>\\n          <option value=\\\"focus\\\">Focus (clear attention)</option>\\n          <option value=\\\"sleep\\\">Sleep (evening ease)</option>\\n          <option value=\\\"uplift\\\">Uplift (gentle cheer)</option>\\n          <option value=\\\"ground\\\">Ground (steadying)</option>\\n        </select>\\n\\n        <label for=\\\"volume\\\">Total bottle size (ml)</label>\\n        <select id=\\\"volume\\\"><option>10</option><option selected>30</option><option>50</option></select>\\n\\n        <label>Strength</label>\\n        <select id=\\\"strength\\\">\\n          <option value=\\\"0.5\\\">Low — 0.5% (sensitivity/pregnant)</option>\\n          <option value=\\\"1\\\">Gentle — 1%</option>\\n          <option value=\\\"2\\\" selected>Standard — 2% (adult topical typical)</option>\\n        </select>\\n\\n        <button id=\\\"build\\\" style=\\\"margin-top:12px;padding:8px 10px;border-radius:8px;background:var(--accent);color:#fff;border:none\\\">Make blend</button>\\n        <div id=\\\"blendResult\\\" class=\\\"output\\\" aria-live=\\\"polite\\\"></div>\\n        <div class=\\\"note\\\">Safety: patch test and dilute for pets and pregnancy. See FAQ on the About page for notes.</div>\\n      </div>\\n\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin-top:0\\\">How I frame pricing</h3>\\n      <p class=\\\"muted\\\">Investments are an invitation: each option includes guidance, notes for home practice, and a follow-up message. You can tailor duration and cadence; contact for bespoke plans.</p>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} — {{TAGLINE}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div style=\\\"margin-top:8px\\\" class=\\\"small\\\">Sessions held in {{CITY}}, {{STATE}}. All suggestions are non-medical and may support comfort; consult a medical professional for health conditions.</div>\\n    </footer>\\n  </main>\\n\\n  <script>\\n    (function(){\\n      const map = {\\n        calm:[\\\"Lavender\\\",\\\"Chamomile\\\",\\\"Sweet Marjoram\\\"],\\n        focus:[\\\"Rosemary\\\",\\\"Basil\\\",\\\"Lemon\\\"],\\n        sleep:[\\\"Lavender\\\",\\\"Vetiver\\\",\\\"Cedarwood\\\"],\\n        uplift:[\\\"Grapefruit\\\",\\\"Bergamot\\\",\\\"Sweet Orange\\\"],\\n        ground:[\\\"Patchouli\\\",\\\"Frankincense\\\",\\\"Black Pepper\\\"]\\n      };\\n      const build = document.getElementById('build');\\n      const out = document.getElementById('blendResult');\\n      build.addEventListener('click',()=>{\\n        const vibe = document.getElementById('vibe').value;\\n        const volume = Number(document.getElementById('volume').value);\\n        const strength = Number(document.getElementById('strength').value);\\n        const oils = map[vibe] || [];\\n        // drops per ml approx 20\\n        const dropsPerMl = 20;\\n        const totalDrops = Math.round((strength/100) * volume * dropsPerMl);\\n        const perOil = oils.length? Math.max(1, Math.round(totalDrops / oils.length)) : 0;\\n        let text = '';\\n        text += 'Blend — '+(vibe.charAt(0).toUpperCase()+vibe.slice(1))+'\\\\n';\\n        text += 'Bottle: '+volume+' ml · Strength: '+strength+'%\\\\n\\\\n';\\n        text += 'Suggested oils and approximate drops:\\\\n';\\n        oils.forEach(o=> text+= '- '+o+': ~'+perOil+' drops\\\\n');\\n        text += '\\\\nDilution guide (approx):\\\\n';\\n        text += '- Total aromatic drops for this bottle: '+totalDrops+' drops\\\\n';\\n        text += '- 1 ml ≈ 20 drops (varies)\\\\n';\\n        text += '\\\\nSafety notes:\\\\n';\\n        text += '- Patch test a small diluted area before wider use.\\\\n';\\n        text += \\\"- Avoid undiluted essential oils on skin; store away from children.\\\\n\\\";\\n        text += \\\"- For pregnancy, breastfeeding, or serious health conditions, consult a healthcare provider.\\\\n\\\";\\n        text += '- If you have pets: many oils may be strong for animals; use diffusely with ventilation and consult an aromatherapy vet resource.\\\\n';\\n        out.textContent = text;\\n      });\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffdfb;--ink:#1e2f2a;--muted:#6d6d6d;--accent:#8bb28b}\\n    html,body{margin:0;padding:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial; background:var(--bg);color:var(--ink)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 24px}\\n    .brand{font-weight:700}\\n    nav a{margin-left:16px;text-decoration:none;color:var(--ink);font-weight:600}\\n    main{max-width:900px;margin:20px auto;padding:20px}\\n    .hero{display:flex;gap:18px;align-items:flex-start}\\n    .bio{background:#fff;border-radius:12px;padding:18px;box-shadow:0 8px 24px rgba(30,47,42,0.06)}\\n    h1{margin:0 0 8px 0}\\n    p.lead{margin:0;color:var(--muted)}\\n    .columns{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:16px}\\n    .faq{background:#fff;padding:14px;border-radius:10px}\\n    details{margin-bottom:8px}\\n    summary{font-weight:700}\\n    .muted{color:var(--muted)}\\n    footer{margin-top:22px;color:var(--muted);font-size:13px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Begin</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Market</a>\\n      <a href=\\\"pricing.html\\\">Investments</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\" class=\\\"bio\\\">\\n        <h1>A craft of attention</h1>\\n        <p class=\\\"lead\\\">I work with scent as a way to invite quieter moments into your day. Sessions combine scent education, a listening conversation, and small, practical rituals you can bring home. My approach is gentle, safety-forward, and tailored to the needs you name.</p>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:12px\\\">Sessions and suggestions are non-medical. They may support relaxation, focus, or ritual. If you have health conditions, pregnancy, or questions about medication, check with your clinician before changing care.</p>\\n      </div>\\n\\n      <aside style=\\\"width:320px\\\">\\n        <div style=\\\"background:#fff;padding:16px;border-radius:12px;box-shadow:0 8px 20px rgba(30,47,42,0.04)\\\">\\n          <h3 style=\\\"margin-top:0\\\">Quick facts</h3>\\n          <div class=\\\"muted\\\">Practitioner: Certified in clinical aromatherapy and plant studies.</div>\\n          <div style=\\\"margin-top:8px\\\" class=\\\"muted\\\">Location: {{CITY}}, {{STATE}}</div>\\n          <div style=\\\"margin-top:10px\\\"><a href=\\\"book.html\\\" style=\\\"display:inline-block;padding:8px 10px;background:var(--accent);color:white;border-radius:8px;text-decoration:none\\\">Reserve a consultation</a></div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"columns\\\">\\n      <div>\\n        <h3>Philosophy</h3>\\n        <p class=\\\"muted\\\">Plant essences are tools for creating intention. In practice I combine education, sensory exercises, and a small set of at-home habits. Each plan is built to be simple enough to sustain and precise enough to be useful.</p>\\n\\n        <h3 style=\\\"margin-top:18px\\\">Process</h3>\\n        <ol class=\\\"muted\\\">\\n          <li>Begin: brief intake and goals</li>\\n          <li>Explore: scent sampling and notes</li>\\n          <li>Design: a home plan and a blend card</li>\\n          <li>Follow: adjustments and ongoing care</li>\\n        </ol>\\n\\n        <h3 style=\\\"margin-top:18px\\\">What to expect</h3>\\n        <p class=\\\"muted\\\">A session is conversational. You'll leave with clear next steps and a written summary. If you buy oils or blends, clear storage and dilution instructions accompany each selection.</p>\\n      </div>\\n\\n      <div>\\n        <div class=\\\"faq\\\">\\n          <h4 style=\\\"margin-top:0\\\">FAQ</h4>\\n          <details>\\n            <summary>What about dilution?</summary>\\n            <p class=\\\"muted\\\">Dilution depends on age, sensitivity, and intended use. Typical adult topical dilutions are 1–2% for daily use; lower (0.5%) for sensitivity and pregnancy. For small bottles: 1% of 30 ml ≈ 6 drops total. We always recommend starting low.</p>\\n          </details>\\n          <details>\\n            <summary>Do I need a patch test?</summary>\\n            <p class=\\\"muted\\\">Yes. Apply a small diluted amount to an inner forearm, wait 24 hours. If irritation occurs, discontinue. This is not a medical test but a simple safety step.</p>\\n          </details>\\n          <details>\\n            <summary>Pets and essential oils?</summary>\\n            <p class=\\\"muted\\\">Many essential oils affect animals differently. Use diffusers in well-ventilated areas, allow animals to leave the room, and avoid direct application on pets. For specific animals and oils consult a veterinarian experienced with aromatherapy.</p>\\n          </details>\\n          <details>\\n            <summary>Pregnancy and medications</summary>\\n            <p class=\\\"muted\\\">Some oils are not recommended in pregnancy or with certain medications. Please speak with your healthcare provider before using new aromatic preparations. Our guidance is informational, not medical.</p>\\n          </details>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px;background:#fff;padding:12px;border-radius:10px\\\">\\n          <h4 style=\\\"margin:4px 0\\\">A note on language</h4>\\n          <p class=\\\"muted\\\">I avoid promises. Words like \\\"may support\\\" and \\\"suggest\\\" reflect the subtle and individual nature of aromatic work.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f8fff5;--ink:#123026;--muted:#6a6a6a;--accent:#63a46b}\\n    html,body{margin:0;padding:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:var(--bg);color:var(--ink)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 24px}\\n    nav a{margin-left:14px;text-decoration:none;color:var(--ink);font-weight:600}\\n    main{max-width:980px;margin:18px auto;padding:20px}\\n    .panel{background:#fff;border-radius:12px;padding:16px;box-shadow:0 12px 30px rgba(18,48,38,0.06)}\\n    h1{margin:0 0 8px 0}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:18px;margin-top:16px}\\n    label{display:block;margin-top:10px;color:var(--muted);font-size:13px}\\n    input,select,textarea{width:100%;padding:8px;border-radius:8px;border:1px solid #eee;margin-top:6px}\\n    button{background:var(--accent);color:#fff;padding:10px 12px;border:none;border-radius:8px}\\n    .summary{background:#fcfff9;padding:12px;border-radius:8px;border:1px dashed #e8efe6;white-space:pre-wrap}\\n    .small{font-size:13px;color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Begin</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Market</a>\\n      <a href=\\\"pricing.html\\\">Investments</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"panel\\\">\\n      <h1>Reserve a time</h1>\\n      <p class=\\\"small\\\">Use the planner to shape a short plan, then complete the booking form. After booking you will receive a confirmation and a short intake questionnaire.</p>\\n\\n      <div class=\\\"grid\\\">\\n        <div>\\n          <h3 style=\\\"margin-top:0\\\">Session Planner</h3>\\n          <label for=\\\"goal\\\">Primary intention</label>\\n          <select id=\\\"goal\\\">\\n            <option value=\\\"calm\\\">Calm & ease</option>\\n            <option value=\\\"sleep\\\">Sleep support</option>\\n            <option value=\\\"focus\\\">Focus & clarity</option>\\n            <option value=\\\"ritual\\\">Daily ritual</option>\\n            <option value=\\\"blending\\\">Custom blend design</option>\\n          </select>\\n\\n          <label for=\\\"length\\\">Session length</label>\\n          <select id=\\\"length\\\"><option>30</option><option selected>60</option><option>90</option></select>\\n\\n          <label for=\\\"cadence\\\">Preferred cadence</label>\\n          <select id=\\\"cadence\\\"><option>One-off</option><option>Weekly</option><option>Monthly</option></select>\\n\\n          <label for=\\\"sensitivity\\\">Skin sensitivity</label>\\n          <select id=\\\"sensitivity\\\"><option>None</option><option>Mild</option><option>High</option></select>\\n\\n          <button id=\\\"planBtn\\\" style=\\\"margin-top:12px\\\">Create plan & copy text</button>\\n          <div id=\\\"planOut\\\" class=\\\"summary\\\" style=\\\"margin-top:12px\\\">Your plan will appear here.</div>\\n        </div>\\n\\n        <aside>\\n          <div style=\\\"margin-bottom:12px\\\" class=\\\"panel\\\">\\n            <h4 style=\\\"margin-top:0\\\">Quick booking</h4>\\n            <label>Name</label>\\n            <input id=\\\"name\\\" placeholder=\\\"Your name\\\">\\n            <label>Email</label>\\n            <input id=\\\"email\\\" placeholder=\\\"you@domain.com\\\">\\n            <label>Phone</label>\\n            <input id=\\\"phone\\\" placeholder=\\\"Optional\\\">\\n            <label>Notes</label>\\n            <textarea id=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Allergies, pregnancy, pets, etc.\\\"></textarea>\\n            <div style=\\\"margin-top:10px;display:flex;gap:8px\\\"><button id=\\\"bookNow\\\">Request this time</button><a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:inline-block;padding:10px;border-radius:8px;background:#f0f0f0;color:var(--ink);text-decoration:none\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n            <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">By requesting you will receive a follow-up to schedule and finalize the appointment.</div>\\n          </div>\\n\\n          <div class=\\\"panel\\\">\\n            <h4 style=\\\"margin-top:0\\\">Mini blend builder</h4>\\n            <label>Vibe</label>\\n            <select id=\\\"vibeMini\\\"><option value=\\\"calm\\\">Calm</option><option value=\\\"focus\\\">Focus</option><option value=\\\"sleep\\\">Sleep</option></select>\\n            <label>Bottle (ml)</label>\\n            <select id=\\\"volMini\\\"><option>10</option><option selected>30</option></select>\\n            <label>Strength</label>\\n            <select id=\\\"strMini\\\"><option value=\\\"0.5\\\">0.5%</option><option value=\\\"1\\\">1%</option><option value=\\\"2\\\" selected>2%</option></select>\\n            <button id=\\\"makeMini\\\" style=\\\"margin-top:10px\\\">Build mini blend</button>\\n            <div id=\\\"miniOut\\\" class=\\\"small\\\" style=\\\"margin-top:10px;background:#fbfff8;padding:10px;border-radius:8px\\\"></div>\\n          </div>\\n        </aside>\\n      </div>\\n\\n      <div style=\\\"margin-top:14px\\\" class=\\\"small\\\">All aromatic recommendations are educational and may support comfort. For pregnancy, medication, or serious health concerns consult your clinician. Patch testing is advised.</div>\\n    </div>\\n  </main>\\n\\n  <script>\\n    // Session Planner\\n    (function(){\\n      function buildPlan(){\\n        const goal = document.getElementById('goal').value;\\n        const length = document.getElementById('length').value;\\n        const cadence = document.getElementById('cadence').value;\\n        const sensitivity = document.getElementById('sensitivity').value;\\n        let lines = [];\\n        lines.push('Personal Session Plan');\\n        lines.push('Intention: '+goal.replace(/\\\\b\\\\w/g, c=>c.toUpperCase()));\\n        lines.push('Session length: '+length+' minutes');\\n        lines.push('Recommended cadence: '+cadence);\\n        lines.push('Skin sensitivity: '+sensitivity);\\n        lines.push('');\\n        lines.push('Home suggestions (examples):');\\n        if(goal==='calm'){\\n          lines.push('- Try a 3-minute inhale-focused ritual each evening with lavender or chamomile.');\\n          lines.push('- Diffuse gently for 15–20 minutes, keep rooms ventilated.');\\n        } else if(goal==='sleep'){\\n          lines.push('- Take 10 minutes before bed to smell a bedside roller (low dilution).');\\n          lines.push('- Keep sessions brief and consistent.');\\n        } else if(goal==='focus'){\\n          lines.push('- Brief morning scent anchor with citrus or rosemary.');\\n          lines.push('- Use during short work sprints.');\\n        } else if(goal==='ritual'){\\n          lines.push('- Build a 2-step ritual you can repeat daily: scent + breath.');\\n        } else {\\n          lines.push('- Schedule blend design with practitioner.');\\n        }\\n        if(sensitivity!=='None'){\\n          lines.push('');\\n          lines.push('Sensitivity note: Begin with 0.5–1% dilutions and patch test.');\\n        }\\n        return lines.join('\\\\n');\\n      }\\n\\n      const planBtn = document.getElementById('planBtn');\\n      const planOut = document.getElementById('planOut');\\n      planBtn.addEventListener('click',()=>{\\n        const text = buildPlan();\\n        planOut.textContent = text;\\n        // copy to clipboard\\n        navigator.clipboard && navigator.clipboard.writeText(text).then(()=>{\\n          planBtn.textContent = 'Plan copied';\\n          setTimeout(()=>planBtn.textContent = 'Create plan & copy text',1400);\\n        }).catch(()=>{\\n          planBtn.textContent = 'Copy failed';\\n          setTimeout(()=>planBtn.textContent = 'Create plan & copy text',1400);\\n        });\\n      });\\n\\n      // booking stub\\n      document.getElementById('bookNow').addEventListener('click',()=>{\\n        const name = document.getElementById('name').value || 'Unnamed';\\n        const email = document.getElementById('email').value || 'no-email';\\n        alert('Request received for '+name+'. Follow-up will be sent to '+email+'.');\\n      });\\n    })();\\n\\n    // Mini blend builder\\n    (function(){\\n      const map = {calm:['Lavender','Chamomile'],focus:['Rosemary','Lemon'],sleep:['Lavender','Vetiver']};\\n      document.getElementById('makeMini').addEventListener('click',()=>{\\n        const vibe = document.getElementById('vibeMini').value;\\n        const vol = Number(document.getElementById('volMini').value);\\n        const str = Number(document.getElementById('strMini').value);\\n        const oils = map[vibe]||[];\\n        const dropsPerMl = 20;\\n        const totalDrops = Math.round((str/100)*vol*dropsPerMl);\\n        const per = oils.length?Math.max(1, Math.round(totalDrops/oils.length)):0;\\n        let out = '';\\n        out += 'Blend: '+vibe.charAt(0).toUpperCase()+vibe.slice(1)+'\\\\n';\\n        out += 'Bottle: '+vol+' ml · Strength: '+str+'%\\\\n';\\n        out += 'Oils:\\\\n';\\n        oils.forEach(o=> out += '- '+o+': ~'+per+' drops\\\\n');\\n        out += '\\\\nNotes: Patch test; avoid direct application of neat oils; consult for pregnancy and pets.';\\n        document.getElementById('miniOut').textContent = out;\\n      });\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
