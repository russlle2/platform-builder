          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Clinical-feel aromatherapy sessions and ritual design from {{PRACTITIONER_NAME}} in {{CITY}}, {{STATE}}. Safety-first, personalized blends.\\\">\\n  <style>\\n    :root{--bg:#fbfbfc;--card:#ffffff;--muted:#6b7280;--accent:#6aa84f;--accent-2:#8ec5ff;--shadow:0 8px 20px rgba(16,24,40,0.08);--radius:14px;}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#0f1724;background:linear-gradient(180deg,var(--bg) 0%,#f5f7fa 100%);}\\n    a{color:inherit;text-decoration:none}\\n    header{position:sticky;top:0;backdrop-filter: blur(6px);background:linear-gradient(180deg,rgba(255,255,255,0.6),rgba(255,255,255,0.4));border-bottom:1px solid rgba(15,23,36,0.04)}\\n    .nav{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:18px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#b3e6a6);display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n    nav ul{display:flex;gap:18px;list-style:none;padding:0;margin:0;font-size:15px;color:var(--muted)}\\n    .hero{max-width:1100px;margin:28px auto;padding:34px;border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,0.9),rgba(250,252,255,0.9));box-shadow:var(--shadow);display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center}\\n    .hero h1{margin:0;font-size:26px;color:#07203a}\\n    .hero p{color:var(--muted);margin-top:10px}\\n    .cta{margin-top:18px}\\n    .btn{background:linear-gradient(90deg,var(--accent),#5cc06a);color:white;padding:10px 14px;border-radius:10px;border:0;cursor:pointer;font-weight:600}\\n    .muted-box{padding:18px;border-radius:12px;background:#f7fbf6;border:1px solid rgba(106,168,79,0.08)}\\n    .section{max-width:1100px;margin:24px auto;padding:24px;background:transparent}\\n    .grid-2{display:grid;grid-template-columns:1fr 360px;gap:22px}\\n    .card{background:var(--card);border-radius:12px;padding:16px;box-shadow:var(--shadow)}\\n    .list{display:flex;flex-direction:column;gap:12px}\\n    .schedule{display:flex;flex-direction:column;gap:8px}\\n    footer{max-width:1100px;margin:36px auto;padding:22px;color:var(--muted);font-size:14px;border-top:1px dashed rgba(15,23,36,0.04)}\\n    .small{font-size:13px;color:var(--muted)}\\n    /* SVG pattern background */\\n    .pattern-wrap{position:fixed;inset:0;pointer-events:none;opacity:0.08}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.grid-2{grid-template-columns:1fr}.nav{padding:12px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern-wrap\\\" aria-hidden>\\n    <!-- Unique SVG background pattern for services.html -->\\n    <svg width=\\\"100%\\\" height=\\\"100%\\\" preserveAspectRatio=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#c8f1d1\\\" />\\n          <stop offset=\\\"1\\\" stop-color=\\\"#e6f7ff\\\" />\\n        </linearGradient>\\n        <pattern id=\\\"p1\\\" width=\\\"120\\\" height=\\\"120\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(18)\\\">\\n          <rect width=\\\"120\\\" height=\\\"120\\\" fill=\\\"url(#g1)\\\"/>\\n          <circle cx=\\\"18\\\" cy=\\\"18\\\" r=\\\"6\\\" fill=\\\"#bfe6a8\\\" />\\n          <circle cx=\\\"60\\\" cy=\\\"60\\\" r=\\\"3\\\" fill=\\\"#8cc6ff\\\" />\\n          <rect x=\\\"90\\\" y=\\\"90\\\" width=\\\"18\\\" height=\\\"18\\\" rx=\\\"4\\\" fill=\\\"#d0f7de\\\" />\\n        </pattern>\\n      </defs>\\n      <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\" />\\n    </svg>\\n  </div>\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">A</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <ul>\\n          <li><a href=\\\"index.html\\\">Start</a></li>\\n          <li><a href=\\\"services.html\\\">Offerings</a></li>\\n          <li><a href=\\\"blends.html\\\">Blends</a></li>\\n          <li><a href=\\\"shop.html\\\">Boutique</a></li>\\n          <li><a href=\\\"pricing.html\\\">Rates</a></li>\\n          <li><a href=\\\"book.html\\\">Book VIP</a></li>\\n          <li><a href=\\\"contact.html\\\">Connect</a></li>\\n        </ul>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Intentional aromatherapy sessions in {{CITY}}</h1>\\n        <p>One-on-one consultations and guided blend sessions that center safety, clarity, and a purposeful ritual. Ideal for busy people who want approachable plant-based support — not medical claims.</p>\\n        <div class=\\\"cta\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n        <div style=\\\"margin-top:16px;color:var(--muted);font-size:14px\\\">Sessions led by {{PRACTITIONER_NAME}} — offering in-person and remote options. Phone: {{PHONE}}</div>\\n      </div>\\n      <aside class=\\\"muted-box\\\">\\n        <div style=\\\"font-weight:700\\\">Session snapshot</div>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Duration: 60–90 minutes · Personalized blend to take home · Safety guidance, dilution plan, and patch-test instruction.</div>\\n        <div style=\\\"margin-top:12px\\\">\\n          <div style=\\\"font-weight:600\\\">VIP Day option</div>\\n          <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Deep-dive design day — create an at-home ritual system and a seasonal blend set. Ask about {{FAVORITE_BLEND}} as an example.</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <div class=\\\"grid-2\\\">\\n        <div>\\n          <div class=\\\"card\\\">\\n            <h3 style=\\\"margin-top:0\\\">The ritual — how a session flows</h3>\\n            <p class=\\\"small\\\">We design a simple, repeatable ritual so aromatic practice fits your day. Each session follows a predictable, safety-forward sequence:</p>\\n            <div class=\\\"list\\\" style=\\\"margin-top:12px\\\">\\n              <div><strong>1. Intake</strong> — aromatic preferences, scent history, medications, pregnancy/pet exposure notes.</div>\\n              <div><strong>2. Sensory mapping</strong> — short smell test &nbsp;(no inhalation beyond comfort), identify evocative notes.</div>\\n              <div><strong>3. Blend design</strong> — choose top/middle/base notes, determine dilution and carrier.\\n              </div>\\n              <div><strong>4. Safety plan</strong> — patch testing, dilution instructions, storage/label guidance.</div>\\n              <div><strong>5. Ritual coaching</strong> — how to use diffusers, inhalers, roll-ons, and integrate into a daily pause.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"card\\\" style=\\\"margin-top:16px\\\">\\n            <h3 style=\\\"margin-top:0\\\">What to expect</h3>\\n            <p class=\\\"small\\\">Sessions are educational and experiential. Expect neutral, non-invasive guidance: no medical diagnosis, no replacement for healthcare. We emphasize gentle practices, clear dilution math, and pet/pregnancy considerations.</p>\\n            <ul style=\\\"margin-top:10px;color:var(--muted);font-size:14px\\\">\\n              <li>Personalized blend recipe (paper + digital)</li>\\n              <li>Sample to take home when available</li>\\n              <li>Plain-language safety checklist</li>\\n            </ul>\\n          </div>\\n\\n          <div class=\\\"card\\\" style=\\\"margin-top:16px\\\">\\n            <h3 style=\\\"margin-top:0\\\">Pricing snapshot</h3>\\n            <div style=\\\"display:flex;gap:12px;align-items:center;justify-content:space-between\\\">\\n              <div class=\\\"small\\\">Initial Session (60–90m)</div>\\n              <div style=\\\"font-weight:700\\\">See full pricing</div>\\n            </div>\\n            <div class=\\\"small\\\" style=\\\"margin-top:10px\\\">VIP Day available — single-day, custom design experience for an at-home aromatherapy program.</div>\\n            <div style=\\\"margin-top:12px\\\"><a href=\\\"pricing.html\\\" class=\\\"small\\\">View full rates &rarr;</a></div>\\n          </div>\\n        </div>\\n\\n        <aside>\\n          <div class=\\\"card\\\">\\n            <h4 style=\\\"margin-top:0\\\">Practical schedule</h4>\\n            <div class=\\\"schedule\\\" style=\\\"margin-top:8px\\\">\\n              <div><strong>Mon</strong> — 10:00, 13:30, 16:00</div>\\n              <div><strong>Wed</strong> — 09:00, 12:00, 15:30</div>\\n              <div><strong>Fri</strong> — 10:30, 14:00</div>\\n              <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Weekend openings by request for VIP Day design sessions.</div>\\n            </div>\\n            <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a session</a></div>\\n          </div>\\n\\n          <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n            <h4 style=\\\"margin-top:0\\\">Quick notes on safety</h4>\\n            <ul class=\\\"small\\\" style=\\\"margin-top:8px;color:var(--muted)\\\">\\n              <li>We do not make medical claims. Aromas may support relaxation or focus but are not medical treatments.</li>\\n              <li>All sessions include dilution and patch-test guidance.</li>\\n              <li>Animal-safe recommendations discussed when pets are present.</li>\\n            </ul>\\n          </div>\\n        </aside>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Frequently asked — safety & best practice</h3>\\n        <div style=\\\"display:grid;gap:10px;margin-top:12px\\\">\\n          <div>\\n            <strong>What dilution should I use?</strong>\\n            <div class=\\\"small\\\" style=\\\"margin-top:6px;color:var(--muted)\\\">Dilution depends on age, sensitivity, and application. Typical topical roll-ons range 1–5% essential oil in a carrier. We provide precise ml/percentage instructions in each session.</div>\\n          </div>\\n\\n          <div>\\n            <strong>Do I need to patch test?</strong>\\n            <div class=\\\"small\\\" style=\\\"margin-top:6px;color:var(--muted)\\\">Yes — we always recommend a small patch test on inner forearm for 24 hours before regular topical use.</div>\\n          </div>\\n\\n          <div>\\n            <strong>Are blends safe around pets?</strong>\\n            <div class=\\\"small\\\" style=\\\"margin-top:6px;color:var(--muted)\\\">Some oils can irritate or harm pets. We design pet-aware options and teach safe diffuser placement and ventilation. Always disclose household pets during intake.</div>\\n          </div>\\n\\n          <div>\\n            <strong>Pregnancy & breastfeeding</strong>\\n            <div class=\\\"small\\\" style=\\\"margin-top:6px;color:var(--muted)\\\">We take a safety-first approach. Certain oils are avoided in pregnancy and breastfeeding. Bring your care team questions and we'll advise with conservative, evidence-aware guidance.</div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap\\\">\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"small\\\">{{CITY}}, {{STATE}} · <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> · <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n      <div class=\\\"small\\\">Small-batch blends · Safety-first guidance · VIP day design</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Blends — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"A curated library of signature blends — top/middle/base notes and suggested ways to use them. Safety-forward aromatic guidance.\\\">\\n  <style>\\n    :root{--bg:#ffffff;--muted:#60707a;--card:#fff;--accent:#7ec8a4;--accent-2:#89b6ff;--radius:12px;--shadow:0 10px 30px rgba(8,15,20,0.06)}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;color:#09212e;background:linear-gradient(180deg,#fbffff,#f6fbff)}\\n    header{padding:18px 24px;border-bottom:1px solid rgba(0,0,0,0.04);background:rgba(255,255,255,0.6);backdrop-filter:blur(4px)}\\n    .nav{max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;align-items:center}\\n    .logo{font-weight:800;color:#0f1724}\\n    nav ul{display:flex;gap:14px;list-style:none;padding:0;margin:0;color:var(--muted);font-size:14px}\\n    main{max-width:1200px;margin:28px auto;padding:20px}\\n    .lead{display:flex;gap:20px;align-items:center;justify-content:space-between}\\n    h1{margin:0;font-size:26px}\\n    .lead p{margin:6px 0 0;color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:20px}\\n    .blend{background:var(--card);padding:16px;border-radius:var(--radius);box-shadow:var(--shadow);border:1px solid rgba(10,20,30,0.02)}\\n    .notes{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}\\n    .pill{background:linear-gradient(90deg,#fff,#f2fff6);border:1px solid rgba(126,200,164,0.15);padding:6px 8px;border-radius:999px;font-size:13px;color:#164133}\\n    .profile{font-size:14px;color:var(--muted);margin-top:8px}\\n    footer{max-width:1200px;margin:34px auto;padding:18px;color:var(--muted);font-size:13px}\\n    @media(max-width:980px){.grid{grid-template-columns:repeat(2,1fr)}.lead{flex-direction:column;align-items:flex-start}}\\n    @media(max-width:640px){.grid{grid-template-columns:1fr}}\\n    /* unique SVG pattern for blends page included inline */\\n    .pattern-top{height:140px;width:100%;display:block}\\n  </style>\\n</head>\\n<body>\\n  <!-- Decorative SVG band -->\\n  <svg class=\\\"pattern-top\\\" viewBox=\\\"0 0 1200 140\\\" preserveAspectRatio=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"bgrad\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#e8fff3\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#eef6ff\\\"/></linearGradient>\\n    </defs>\\n    <rect width=\\\"1200\\\" height=\\\"140\\\" fill=\\\"url(#bgrad)\\\"/>\\n    <g opacity=\\\"0.08\\\" fill=\\\"#92d7a9\\\">\\n      <circle cx=\\\"100\\\" cy=\\\"30\\\" r=\\\"14\\\"/>\\n      <circle cx=\\\"320\\\" cy=\\\"90\\\" r=\\\"10\\\"/>\\n      <rect x=\\\"540\\\" y=\\\"10\\\" width=\\\"24\\\" height=\\\"24\\\" rx=\\\"6\\\"/>\\n      <circle cx=\\\"820\\\" cy=\\\"40\\\" r=\\\"18\\\"/>\\n      <circle cx=\\\"1020\\\" cy=\\\"30\\\" r=\\\"8\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <ul>\\n          <li><a href=\\\"index.html\\\">Home</a></li>\\n          <li><a href=\\\"services.html\\\">Treatments</a></li>\\n          <li><a href=\\\"blends.html\\\">Our Blends</a></li>\\n          <li><a href=\\\"shop.html\\\">Shop</a></li>\\n          <li><a href=\\\"pricing.html\\\">Pricing</a></li>\\n          <li><a href=\\\"about.html\\\">Meet</a></li>\\n          <li><a href=\\\"book.html\\\">Reserve</a></li>\\n        </ul>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"lead\\\">\\n      <div>\\n        <h1>Signature blends — concise profiles</h1>\\n        <p>Each entry lists top/middle/base notes, an aroma profile, and a short note on what the blend may support when used thoughtfully.</p>\\n      </div>\\n      <div style=\\\"text-align:right;color:var(--muted)\\\">\\n        <div style=\\\"font-weight:700\\\">Practitioner: {{PRACTITIONER_NAME}}</div>\\n        <div class=\\\"small\\\">Ask about dilution and pet-safe options in your session</div>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"grid\\\" role=\\\"list\\\">\\n      <!-- Blend 1 -->\\n      <div class=\\\"blend\\\" role=\\\"listitem\\\">\\n        <div style=\\\"font-weight:700\\\">Morning Clarity</div>\\n        <div class=\\\"notes\\\"><span class=\\\"pill\\\">Top: Bergamot</span><span class=\\\"pill\\\">Middle: Rosemary</span><span class=\\\"pill\\\">Base: Cedarwood</span></div>\\n        <div class=\\\"profile\\\">A bright citrus-herb aroma with a warm, grounding finish.</div>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> brief ritual to encourage focus and a clear start to the day when used with mindful breathing.</div>\\n      </div>\\n\\n      <!-- Blend 2 -->\\n      <div class=\\\"blend\\\">\\n        <div style=\\\"font-weight:700\\\">Evening Wind-down</div>\\n        <div class=\\\"notes\\\"><span class=\\\"pill\\\">Top: Sweet Orange</span><span class=\\\"pill\\\">Middle: Lavender</span><span class=\\\"pill\\\">Base: Vetiver</span></div>\\n        <div class=\\\"profile\\\">Soft citrus and floral with an earthy base—gentle and settling.</div>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> a calm pre-bed ritual. Use low-strength diffuser settings and ventilate the room.</div>\\n      </div>\\n\\n      <!-- Blend 3 -->\\n      <div class=\\\"blend\\\">\\n        <div style=\\\"font-weight:700\\\">Focus Grove</div>\\n        <div class=\\\"notes\\\"><span class=\\\"pill\\\">Top: Peppermint</span><span class=\\\"pill\\\">Middle: Lemon Balm</span><span class=\\\"pill\\\">Base: Pine</span></div>\\n        <div class=\\\"profile\\\">Crisp, herbal-woodsy; refreshing and uplifting.</div>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> short bursts of attention work; avoid prolonged direct inhalation if sensitive.</div>\\n      </div>\\n\\n      <!-- Blend 4 -->\\n      <div class=\\\"blend\\\">\\n        <div style=\\\"font-weight:700\\\">Quiet Hearth</div>\\n        <div class=\\\"notes\\\"><span class=\\\"pill\\\">Top: Mandarin</span><span class=\\\"pill\\\">Middle: Chamomile</span><span class=\\\"pill\\\">Base: Sandalwood</span></div>\\n        <div class=\\\"profile\\\">Warm and soothing with a gentle sweetness.</div>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> an at-home pause that invites calm, used in small doses near seating areas.</div>\\n      </div>\\n\\n      <!-- Blend 5 -->\\n      <div class=\\\"blend\\\">\\n        <div style=\\\"font-weight:700\\\">Gentle Restore</div>\\n        <div class=\\\"notes\\\"><span class=\\\"pill\\\">Top: Litsea</span><span class=\\\"pill\\\">Middle: Geranium</span><span class=\\\"pill\\\">Base: Frankincense</span></div>\\n        <div class=\\\"profile\\\">Bright citrus opening, floral heart, resinous base—balanced and soft.</div>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> a reflective pause, gentle ritual for grounding after a busy day.</div>\\n      </div>\\n\\n      <!-- Blend 6 -->\\n      <div class=\\\"blend\\\">\\n        <div style=\\\"font-weight:700\\\">Cooling Pause</div>\\n        <div class=\\\"notes\\\"><span class=\\\"pill\\\">Top: Eucalyptus</span><span class=\\\"pill\\\">Middle: Tea Tree</span><span class=\\\"pill\\\">Base: Cypress</span></div>\\n        <div class=\\\"profile\\\">Crisp, camphorous-resinous; clear and brisk.</div>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> short diffuser bursts when you want a clarifying atmosphere; avoid near cats and small animals.</div>\\n      </div>\\n\\n      <!-- Blend 7 -->\\n      <div class=\\\"blend\\\">\\n        <div style=\\\"font-weight:700\\\">Sweet Respite</div>\\n        <div class=\\\"notes\\\"><span class=\\\"pill\\\">Top: Bergamot</span><span class=\\\"pill\\\">Middle: Ylang Ylang</span><span class=\\\"pill\\\">Base: Vanilla CO2</span></div>\\n        <div class=\\\"profile\\\">Soft floral-sweet, cozy and comforting.</div>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> creative pauses and moments of self-care; best at low dilution for topical use.</div>\\n      </div>\\n\\n      <!-- Blend 8 -->\\n      <div class=\\\"blend\\\">\\n        <div style=\\\"font-weight:700\\\">Urban Calm</div>\\n        <div class=\\\"notes\\\"><span class=\\\"pill\\\">Top: Grapefruit</span><span class=\\\"pill\\\">Middle: Clary Sage</span><span class=\\\"pill\\\">Base: Atlas Cedar</span></div>\\n        <div class=\\\"profile\\\">Zesty and mildly herbal with a woodsy anchor.</div>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> decompression after transit or a busy day; use in a well-ventilated area.</div>\\n      </div>\\n\\n      <!-- Blend 9 -->\\n      <div class=\\\"blend\\\">\\n        <div style=\\\"font-weight:700\\\">Quiet Focus</div>\\n        <div class=\\\"notes\\\"><span class=\\\"pill\\\">Top: Lemon</span><span class=\\\"pill\\\">Middle: Lavender</span><span class=\\\"pill\\\">Base: Atlas Cedar</span></div>\\n        <div class=\\\"profile\\\">Lively citrus with floral softness and subtle wood base.</div>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> desk rituals to nudge attention and steady the breath during work sprints.</div>\\n      </div>\\n\\n      <!-- Blend 10 -->\\n      <div class=\\\"blend\\\">\\n        <div style=\\\"font-weight:700\\\">Night Sentinel</div>\\n        <div class=\\\"notes\\\"><span class=\\\"pill\\\">Top: Lavender</span><span class=\\\"pill\\\">Middle: Marjoram</span><span class=\\\"pill\\\">Base: Balsam Fir</span></div>\\n        <div class=\\\"profile\\\">Herbal-floral with a deep evergreen finish.</div>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px;color:var(--muted)\\\"><strong>Supports:</strong> evening routines aimed at creating a cozy, restorative atmosphere; use conservative diffuser duration.</div>\\n      </div>\\n    </div>\\n\\n    <div style=\\\"margin-top:24px;color:var(--muted);font-size:13px\\\">Note: These blend notes are educational. Blends are tailored in sessions with dilution and pet/pregnancy-safe alternatives. For product inquiries, visit the <a href=\\\"shop.html\\\">shop</a>.</div>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:1200px;margin:0 auto;padding:22px;color:var(--muted);font-size:13px\\\">Contact {{PRACTITIONER_NAME}} · <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> · {{PHONE}} · {{CITY}}, {{STATE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Shop — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Browse our small-batch kits, roll-ons, and diffuser accessories. Items shown as UI examples; check product pages for dilution and safety details.\\\">\\n  <style>\\n    :root{--bg:#fbfdff;--card:#ffffff;--accent:#6aa84f;--muted:#51626a;--radius:14px;--shadow:0 12px 32px rgba(10,20,30,0.06)}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#ffffff,#f7fbff);color:#0b1a22}\\n    header{padding:16px 20px;border-bottom:1px solid rgba(10,20,30,0.04);background:rgba(255,255,255,0.7);backdrop-filter:blur(4px)}\\n    .container{max-width:1100px;margin:28px auto;padding:0 16px}\\n    .nav{display:flex;justify-content:space-between;align-items:center}\\n    nav ul{display:flex;gap:12px;list-style:none;padding:0;margin:0;color:var(--muted)}\\n    h1{margin:0;font-size:24px}\\n    .intro{color:var(--muted);margin-top:8px}\\n    .products{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:20px}\\n    .product{background:var(--card);border-radius:var(--radius);padding:16px;box-shadow:var(--shadow);border:1px solid rgba(10,20,30,0.03);display:flex;flex-direction:column}\\n    .img{height:120px;border-radius:12px;background:linear-gradient(135deg,#f0fff0,#eef6ff);display:flex;align-items:center;justify-content:center;color:#2b4a3a;font-weight:700}\\n    .name{font-weight:700;margin-top:12px}\\n    .meta{font-size:13px;color:var(--muted);margin-top:6px}\\n    .price{margin-top:auto;font-weight:800}\\n    .btn{background:linear-gradient(90deg,var(--accent),#59c06a);color:white;padding:8px 12px;border-radius:10px;border:0;cursor:pointer;margin-top:10px}\\n    .note{font-size:13px;color:var(--muted);margin-top:10px}\\n    footer{max-width:1100px;margin:36px auto;padding:14px;color:var(--muted);font-size:13px}\\n    @media(max-width:980px){.products{grid-template-columns:repeat(2,1fr)}}\\n    @media(max-width:640px){.products{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"container\\\">\\n      <div class=\\\"nav\\\">\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <nav>\\n          <ul>\\n            <li><a href=\\\"index.html\\\">Home</a></li>\\n            <li><a href=\\\"services.html\\\">Services</a></li>\\n            <li><a href=\\\"blends.html\\\">Aromas</a></li>\\n            <li><a href=\\\"shop.html\\\">Store</a></li>\\n            <li><a href=\\\"pricing.html\\\">Plans</a></li>\\n            <li><a href=\\\"about.html\\\">The Practitioner</a></li>\\n            <li><a href=\\\"book.html\\\">Schedule</a></li>\\n          </ul>\\n        </nav>\\n      </div>\\n    </div>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section>\\n      <h1>Shop — curated kits & roll-ons</h1>\\n      <div class=\\\"intro\\\">Small-run items made with traceable oils. Product imagery here is illustrative; each product card includes suggested uses and basic safety notes. For personalized blends, book a session.</div>\\n    </section>\\n\\n    <section class=\\\"products\\\" aria-live=\\\"polite\\\">\\n      <div class=\\\"product\\\">\\n        <div class=\\\"img\\\">Starter Kit</div>\\n        <div class=\\\"name\\\">Home Ritual Kit</div>\\n        <div class=\\\"meta\\\">Includes: 3 x 5ml blends, diffuser pad, recipe card</div>\\n        <div class=\\\"price\\\">$65</div>\\n        <button class=\\\"btn\\\">Add to cart</button>\\n        <div class=\\\"note\\\">Tip: Patch-test blends before topical use. See product details for dilution.</div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"img\\\">Roll-On</div>\\n        <div class=\\\"name\\\">Calm Pocket Roll-On</div>\\n        <div class=\\\"meta\\\">10ml roller with 2% dilution in jojoba</div>\\n        <div class=\\\"price\\\">$22</div>\\n        <button class=\\\"btn\\\">Add to cart</button>\\n        <div class=\\\"note\\\">Use a small amount on wrists or chest. Keep away from eyes and mucous membranes.</div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"img\\\">Diffuser</div>\\n        <div class=\\\"name\\\">Ceramic Mini Diffuser</div>\\n        <div class=\\\"meta\\\">USB powered, 6 hr intermittent setting</div>\\n        <div class=\\\"price\\\">$48</div>\\n        <button class=\\\"btn\\\">Add to cart</button>\\n        <div class=\\\"note\\\">Diffuse on low in the presence of pets; avoid oils that are known to be harmful to animals.</div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"img\\\">Roll-On</div>\\n        <div class=\\\"name\\\">Focus Roll-On</div>\\n        <div class=\\\"meta\\\">10ml, 3% dilution for topical use</div>\\n        <div class=\\\"price\\\">$22</div>\\n        <button class=\\\"btn\\\">Add to cart</button>\\n        <div class=\\\"note\\\">Not recommended for young children. Check ingredient list if pregnant.</div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"img\\\">Kit</div>\\n        <div class=\\\"name\\\">Travel Calm Trio</div>\\n        <div class=\\\"meta\\\">3 x 4ml blends in amber vials</div>\\n        <div class=\\\"price\\\">$39</div>\\n        <button class=\\\"btn\\\">Add to cart</button>\\n        <div class=\\\"note\\\">Fits in a carry-on. Includes simple diffusion pouch.</div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"img\\\">Accessory</div>\\n        <div class=\\\"name\\\">Diffuser Pads (6)</div>\\n        <div class=\\\"meta\\\">Unscented, washable pads</div>\\n        <div class=\\\"price\\\">$12</div>\\n        <button class=\\\"btn\\\">Add to cart</button>\\n        <div class=\\\"note\\\">Use to safely deliver short bursts of aroma in small spaces.</div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"img\\\">Bottle</div>\\n        <div class=\\\"name\\\">Empty Roller Set</div>\\n        <div class=\\\"meta\\\">4 × 10ml amber roll-on bottles</div>\\n        <div class=\\\"price\\\">$16</div>\\n        <button class=\\\"btn\\\">Add to cart</button>\\n        <div class=\\\"note\\\">Great for DIY blends. We'll teach dilution math in sessions.</div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"img\\\">Bundle</div>\\n        <div class=\\\"name\\\">Starter Blend Subscription</div>\\n        <div class=\\\"meta\\\">Monthly sample vial + notes</div>\\n        <div class=\\\"price\\\">$18 / month</div>\\n        <button class=\\\"btn\\\">Subscribe</button>\\n        <div class=\\\"note\\\">Cancel anytime. Each shipment includes safety guidance and patch-test reminders.</div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"img\\\">Gift</div>\\n        <div class=\\\"name\\\">Gift Card — 60</div>\\n        <div class=\\\"meta\\\">Redeemable for sessions or shop items</div>\\n        <div class=\\\"price\\\">$60</div>\\n        <button class=\\\"btn\\\">Buy gift card</button>\\n        <div class=\\\"note\\\">Digital delivery. Perfect for gifting a VIP Day.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;background:linear-gradient(90deg,#fff,#f7fff6);padding:14px;border-radius:12px;border:1px solid rgba(106,168,79,0.08)\\\">\\n      <strong>Shop safety quick-guide</strong>\\n      <div class=\\\"note\\\">We avoid making medical claims. Check product descriptions for dilution, patch-test instructions, pet and pregnancy notes. For personalized recommendations, book a session with {{PRACTITIONER_NAME}}.</div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"container\\\" style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap\\\">\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"small\\\" style=\\\"color:var(--muted)\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}}</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
