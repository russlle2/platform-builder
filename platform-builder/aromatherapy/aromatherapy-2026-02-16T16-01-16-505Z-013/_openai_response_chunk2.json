          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} — Sessions & Custom Aromas</title>\\n  <style>\\n    :root{--bg1:#f6fbf8;--accent:#6aa99f;--muted:#6b6b6b;--card:#ffffff;--glass:rgba(255,255,255,0.6)}\\n    *{box-sizing:border-box}\\n    body{font-family:Inter, system-ui, -apple-system, Segoe UI, Roboto, 'Helvetica Neue', Arial; margin:0; color:#223; background:linear-gradient(180deg,var(--bg1),#eef6f3);min-height:100vh}\\n    header{position:sticky;top:0;backdrop-filter: blur(6px);background:linear-gradient(180deg,rgba(255,255,255,0.6),rgba(255,255,255,0.4));border-bottom:1px solid rgba(0,0,0,0.04);display:flex;align-items:center;justify-content:space-between;padding:14px 22px}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#4aa385);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav a{margin-left:16px;color:#234;padding:6px 8px;border-radius:8px;text-decoration:none;font-size:15px}\\n    nav a.active{background:rgba(34,66,60,0.08)}\\n    main{padding:32px;max-width:1100px;margin:0 auto}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;margin-bottom:28px}\\n    .hero-card{background:var(--card);padding:28px;border-radius:14px;box-shadow:0 6px 18px rgba(18,50,40,0.06)}\\n    .kicker{color:var(--muted);font-weight:600;font-size:13px}\\n    h1{margin:6px 0 12px;font-size:28px;color:#10302c}\\n    p.lead{color:#345;line-height:1.5}\\n    .cta{display:inline-block;margin-top:14px;padding:12px 16px;background:linear-gradient(90deg,var(--accent),#4bb293);color:#fff;border-radius:10px;text-decoration:none;font-weight:700}\\n    .meta{font-size:13px;color:var(--muted);margin-top:8px}\\n    .aside .card{background:linear-gradient(180deg,rgba(106,169,159,0.06),rgba(255,255,255,0.6));padding:14px;border-radius:10px;margin-bottom:12px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:22px 0}\\n    .service{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 6px 16px rgba(16,32,24,0.04)}\\n    .service h3{margin:0 0 8px;font-size:16px}\\n    .process{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}\\n    .step{flex:1 1 160px;background:var(--glass);padding:12px;border-radius:10px;border:1px solid rgba(34,66,60,0.04)}\\n    .testimonial{background:linear-gradient(180deg,#fff,rgba(255,255,255,0.96));padding:14px;border-radius:12px;border-left:4px solid var(--accent)}\\n    .faq{margin-top:20px}\\n    .faq h4{margin:0 0 10px}\\n    .lead-magnet{display:flex;gap:10px;align-items:center;margin-top:18px}\\n    .lead-magnet input{padding:10px;border-radius:10px;border:1px solid rgba(16,32,24,0.08);width:100%}\\n    footer{padding:26px;text-align:center;color:var(--muted);font-size:14px}\\n    /* Decorative SVG pattern */\\n    .pattern{position:fixed;right:-120px;top:-80px;opacity:0.12;transform:rotate(18deg);pointer-events:none;width:540px;height:540px}\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;border-radius:0}.grid{grid-template-columns:repeat(2,1fr)}.hero{grid-template-columns:1fr}}\\n    @media (max-width:520px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- decorative inline SVG (unique subtle pattern for services) -->\\n  <svg class='pattern' viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n    <defs>\\n      <linearGradient id='gS' x1='0' x2='1'><stop offset='0' stop-color='%236aa99f'/><stop offset='1' stop-color='%234aa385'/></linearGradient>\\n      <pattern id='pS' width='20' height='20' patternUnits='userSpaceOnUse'>\\n        <rect width='20' height='20' fill='none'/>\\n        <circle cx='4' cy='4' r='2' fill='url(%23gS)'/>\\n      </pattern>\\n    </defs>\\n    <rect width='100%' height='100%' fill='url(%23pS)'/> \\n  </svg>\\n\\n  <header>\\n    <div class='brand'>\\n      <div class='logo'>A</div>\\n      <div>\\n        <div style='font-weight:700'>{{BUSINESS_NAME}}</div>\\n        <div style='font-size:12px;color:var(--muted)'>Aromatherapy & bespoke blends</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href='services.html' class='active'>Offerings</a>\\n      <a href='blends.html'>Blends</a>\\n      <a href='shop.html'>Shop</a>\\n      <a href='about.html'>About</a>\\n      <a href='book.html'>Book</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class='hero'>\\n      <div class='hero-card'>\\n        <div class='kicker'>Personalized aromatherapy</div>\\n        <h1>Bespoke sessions & blend design for calm, focus, and ritual</h1>\\n        <p class='lead'>I combine scent knowledge, safety-first dilution guidance, and practical rituals to create aroma support you can rely on. Sessions and custom blends avoid medical claims and focus on sensory wellbeing.</p>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n        <div class='meta'>Virtual and in-person appointments in {{CITY}}, {{STATE}} • Phone: {{PHONE}}</div>\\n\\n        <div style='margin-top:18px'>\\n          <strong>Available services</strong>\\n          <div class='grid' style='margin-top:10px'>\\n            <div class='service'>\\n              <h3>60-min Consultation</h3>\\n              <div class='muted'>Intake, preferences, safety notes, recommendations</div>\\n            </div>\\n            <div class='service'>\\n              <h3>Custom Blend (small)</h3>\\n              <div class='muted'>Personalized 10–15 mL roller or vial with use guidance</div>\\n            </div>\\n            <div class='service'>\\n              <h3>VIP Day</h3>\\n              <div class='muted'>Deep design session — immersive, focused work to create ritual kits</div>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside class='aside'>\\n        <div class='card'>\\n          <div style='font-weight:700'>Quick note on safety</div>\\n          <div style='font-size:13px;color:var(--muted);margin-top:8px'>All sessions include dilution tables and patch-test instructions. I prioritize botanical safety and avoid clinical claims.</div>\\n        </div>\\n        <div class='card'>\\n          <div style='font-weight:700'>Gift a session</div>\\n          <div style='font-size:13px;color:var(--muted);margin-top:8px'>E-gift vouchers available. Contact {{EMAIL}} for custom amounts.</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section>\\n      <h2 style='margin-top:6px'>How clients benefit — practical outcomes</h2>\\n      <div class='process'>\\n        <div class='step'>\\n          <strong>Clarify needs</strong>\\n          <div style='font-size:13px;color:var(--muted);margin-top:6px'>We map preferences, sensitivities, and goals (non-medical).</div>\\n        </div>\\n        <div class='step'>\\n          <strong>Design blends</strong>\\n          <div style='font-size:13px;color:var(--muted);margin-top:6px'>Top/mid/base note balance, aroma profile, and safe dilution.</div>\\n        </div>\\n        <div class='step'>\\n          <strong>Practice</strong>\\n          <div style='font-size:13px;color:var(--muted);margin-top:6px'>Rituals for home use, diffusing tips, and storage advice.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style='margin-top:22px'>\\n      <h2>What people say</h2>\\n      <div style='display:grid;gap:12px;margin-top:10px'>\\n        <div class='testimonial'>\\n          “I loved the blend they made — it's subtle and helps me set an evening routine. Clear safety guidance too.” — L.\\n        </div>\\n        <div class='testimonial'>\\n          “Practical, sensory-first work. Great for gifting.” — R.\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class='faq'>\\n      <h3>Common questions</h3>\\n      <div style='margin-top:10px'>\\n        <h4>How do you handle dilution?</h4>\\n        <div style='color:var(--muted)'>Dilution is calculated by weight/volume and provided with each custom blend. For topical use we give safe percentage ranges and instructions for caregivers when applicable.</div>\\n\\n        <h4 style='margin-top:12px'>Do I need a patch test?</h4>\\n        <div style='color:var(--muted)'>Yes — we recommend a small patch test for new blends, with step-by-step guidance included in your session notes.</div>\\n\\n        <h4 style='margin-top:12px'>Are essential oils safe for pets?</h4>\\n        <div style='color:var(--muted)'>Some oils can be irritating to animals. We discuss household pets during intake and provide pet-safe alternatives and diffusing practices.</div>\\n\\n        <h4 style='margin-top:12px'>Pregnancy and nursing notes</h4>\\n        <div style='color:var(--muted)'>Certain botanicals are contraindicated in pregnancy. If you are pregnant or breastfeeding, please mention this during booking so recommendations avoid restricted oils.</div>\\n      </div>\\n    </section>\\n\\n    <section style='margin-top:22px'>\\n      <div class='lead-magnet'>\\n        <div style='flex:1'>\\n          <strong>Free guide:</strong> A simple at-home blending checklist\\n          <div style='font-size:13px;color:var(--muted);margin-top:6px'>Subscribe for a printable one-page safety checklist and a sample gentle blend recipe.</div>\\n        </div>\\n        <form style='display:flex;gap:8px' onsubmit='event.preventDefault();alert(\\\"Thanks — check your inbox.\\\")'>\\n          <input aria-label='Email' placeholder='you@example.com' required>\\n          <button class='cta' type='submit'>Get the guide</button>\\n        </form>\\n      </div>\\n    </section>\\n\\n    <section style='margin-top:26px;text-align:center'>\\n      <a class='cta' href='{{PRIMARY_CTA_URL}}'>Schedule a session with {{PRACTITIONER_NAME}}</a>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — {{TAGLINE}} • {{CITY}}, {{STATE}} • {{PHONE}} • <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} — Aromatic Blends Library</title>\\n  <style>\\n    :root{--bg:#fcfffd;--accent:#8bbf9a;--muted:#51605a;--card:#ffffff}\\n    body{font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;margin:0;background:radial-gradient(circle at 10% 20%,#f0faf5,transparent),linear-gradient(180deg,#fbfff9,#f3faf7);color:#14332b}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 26px}\\n    .logo{display:flex;align-items:center;gap:12px}\\n    .logo div{width:44px;height:44px;border-radius:8px;background:linear-gradient(135deg,var(--accent),#66aa86);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav a{margin-left:14px;color:#184035;text-decoration:none}\\n    main{max-width:1100px;margin:0 auto;padding:18px}\\n    .intro{display:flex;gap:20px;align-items:center}\\n    h1{margin:0;font-size:28px}\\n    .sub{color:var(--muted);margin-top:6px}\\n    .library{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:18px}\\n    .blend{background:var(--card);padding:14px;border-radius:12px;box-shadow:0 8px 20px rgba(12,30,22,0.04)}\\n    .notes{font-size:13px;color:var(--muted);margin-top:6px}\\n    .profile{margin-top:8px;font-weight:600}\\n    .supports{font-size:13px;color:#2a5b4b;margin-top:8px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none}\\n    .pattern{position:fixed;left:-120px;bottom:-100px;opacity:0.12;transform:rotate(-22deg);width:520px;height:520px}\\n    .faq{margin-top:20px}\\n    @media (max-width:820px){.library{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique SVG pattern for blends page -->\\n  <svg class='pattern' viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n    <defs>\\n      <linearGradient id='gB' x1='0' x2='1'><stop offset='0' stop-color='%238bbf9a'/><stop offset='1' stop-color='%236fae84'/></linearGradient>\\n      <pattern id='pB' width='26' height='26' patternUnits='userSpaceOnUse'>\\n        <rect width='26' height='26' fill='none'/>\\n        <path d='M0 13h26' stroke='%230d3b2f' stroke-opacity='0.05' stroke-width='1'/>\\n        <circle cx='20' cy='6' r='2.5' fill='url(%23gB)'/>\\n      </pattern>\\n    </defs>\\n    <rect width='100%' height='100%' fill='url(%23pB)' />\\n  </svg>\\n\\n  <header>\\n    <div class='logo'><div>B</div><div style='font-weight:700'>{{BUSINESS_NAME}}</div></div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='blends.html' style='font-weight:700;margin-left:10px'>Aroma Library</a>\\n      <a href='book.html' style='margin-left:10px'>Book</a>\\n      <a href='shop.html' style='margin-left:10px'>Store</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class='intro'>\\n      <div>\\n        <h1>Curated blends — shelf-ready & practice-ready</h1>\\n        <div class='sub'>Each blend lists top/middle/base notes, an aroma profile, and gentle guidance on when you might reach for it. No medical claims — just sensory support.</div>\\n      </div>\\n      <div style='margin-left:auto'>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}'>Create custom blend</a>\\n      </div>\\n    </div>\\n\\n    <section class='library' aria-label='Blend library'>\\n      <!-- 10 blends (safe, descriptive, supports statements) -->\\n\\n      <div class='blend'>\\n        <div style='font-weight:700'>Cozy Evening</div>\\n        <div class='notes'><strong>Top:</strong> Sweet Orange • <strong>Middle:</strong> Lavender • <strong>Base:</strong> Cedarwood</div>\\n        <div class='profile'>Warm, gently sweet, grounding</div>\\n        <div class='supports'>Supports: settling the senses before rest and creating a calming ritual.</div>\\n      </div>\\n\\n      <div class='blend'>\\n        <div style='font-weight:700'>Morning Clarity</div>\\n        <div class='notes'><strong>Top:</strong> Grapefruit • <strong>Middle:</strong> Rosemary • <strong>Base:</strong> Vetiver (light)</div>\\n        <div class='profile'>Bright, herbaceous, focused</div>\\n        <div class='supports'>Supports: an uplifting aroma to help structure morning routines and promote alertness of the senses.</div>\\n      </div>\\n\\n      <div class='blend'>\\n        <div style='font-weight:700'>Clouds & Calm</div>\\n        <div class='notes'><strong>Top:</strong> Bergamot • <strong>Middle:</strong> Chamomile • <strong>Base:</strong> Atlas Cedar</div>\\n        <div class='profile'>Light citrus with floral-soft depth</div>\\n        <div class='supports'>Supports: a gentle mid-day reset and easing sensory tension in busy moments.</div>\\n      </div>\\n\\n      <div class='blend'>\\n        <div style='font-weight:700'>Forest Walk</div>\\n        <div class='notes'><strong>Top:</strong> Pine • <strong>Middle:</strong> Juniper • <strong>Base:</strong> Sandalwood</div>\\n        <div class='profile'>Fresh, resinous, woodsy</div>\\n        <div class='supports'>Supports: grounding and connection to an earthy atmosphere for mindful pauses.</div>\\n      </div>\\n\\n      <div class='blend'>\\n        <div style='font-weight:700'>Quiet Focus</div>\\n        <div class='notes'><strong>Top:</strong> Lemon • <strong>Middle:</strong> Basil • <strong>Base:</strong> Light Patchouli</div>\\n        <div class='profile'>Crisp-citrus with herbal clarity</div>\\n        <div class='supports'>Supports: approachable scent for short bursts of concentration and task work.</div>\\n      </div>\\n\\n      <div class='blend'>\\n        <div style='font-weight:700'>Restful Nest</div>\\n        <div class='notes'><strong>Top:</strong> Mandarin • <strong>Middle:</strong> Clary Sage • <strong>Base:</strong> Vanilla CO2</div>\\n        <div class='profile'>Soft, sweet, herbal-warm</div>\\n        <div class='supports'>Supports: creating a cosy atmosphere for winding down and evening ritual (non-medical).</div>\\n      </div>\\n\\n      <div class='blend'>\\n        <div style='font-weight:700'>Citrus Breeze</div>\\n        <div class='notes'><strong>Top:</strong> Lime • <strong>Middle:</strong> Neroli • <strong>Base:</strong> Amyris</div>\\n        <div class='profile'>Bright floral-citrus with a clean base</div>\\n        <div class='supports'>Supports: refreshing shared spaces and uplifting mood without overstimulation.</div>\\n      </div>\\n\\n      <div class='blend'>\\n        <div style='font-weight:700'>Grounded Ease</div>\\n        <div class='notes'><strong>Top:</strong> Cardamom • <strong>Middle:</strong> Lavender • <strong>Base:</strong> Benzoin</div>\\n        <div class='profile'>Spiced-floral with sweet resinous depth</div>\\n        <div class='supports'>Supports: anchoring and mindful breathing practices.</div>\\n      </div>\\n\\n      <div class='blend'>\\n        <div style='font-weight:700'>Fresh Linen</div>\\n        <div class='notes'><strong>Top:</strong> Eucalyptus • <strong>Middle:</strong> Lavender • <strong>Base:</strong> Light Cedar</div>\\n        <div class='profile'>Crisp, herbal-cool, clean</div>\\n        <div class='supports'>Supports: a refreshing atmosphere for chores or quiet reset moments.</div>\\n      </div>\\n\\n      <div class='blend'>\\n        <div style='font-weight:700'>Evening Cocoon</div>\\n        <div class='notes'><strong>Top:</strong> Marjoram • <strong>Middle:</strong> Ylang Ylang • <strong>Base:</strong> Benzoin</div>\\n        <div class='profile'>Floral, soft-spiced, balsamic</div>\\n        <div class='supports'>Supports: creating a soothing bedside ritual and gentle sensory buffer before sleep.</div>\\n      </div>\\n\\n    </section>\\n\\n    <section style='margin-top:20px'>\\n      <h2>Use & safety notes</h2>\\n      <p style='color:var(--muted)'>Every blend is provided with suggested dilutions for topical rollers and diffuser recipes. If you are pregnant, nursing, or have chronic conditions, please consult before use and mention these when booking so I can recommend alternatives.</p>\\n\\n      <div class='faq'>\\n        <h3>Quick FAQ</h3>\\n        <div style='margin-top:8px;color:var(--muted)'>\\n          <strong>Patch testing:</strong> Always recommended for new topical blends — instructions are included with purchase or custom orders.<br>\\n          <strong>Pets:</strong> Some oils are not suitable around animals; see pet-safe guidance and diffusing best-practices.<br>\\n          <strong>Labeling:</strong> Each bottle includes full ingredient lists and safe-usage notes.\\n        </div>\\n      </div>\\n\\n      <div style='margin-top:16px'>\\n        <a class='cta' href='{{PRIMARY_CTA_URL}}'>Request a custom version of a blend</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer style='padding:24px;text-align:center;color:var(--muted)'>\\n    <div>{{BUSINESS_NAME}} — curated blends by {{PRACTITIONER_NAME}} • Contact: {{EMAIL}} • {{PHONE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} Shop</title>\\n  <style>\\n    :root{--bg:#ffffff;--muted:#475047;--accent:#5da987;--card:#fcfffd}\\n    body{font-family:Inter, system-ui, -apple-system,'Segoe UI', Roboto, Arial;margin:0;background:linear-gradient(180deg,#f8fffb,#f0f7f3);color:#123}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:12px 20px}\\n    .logo{display:flex;gap:10px;align-items:center}\\n    .logo div{width:40px;height:40px;background:linear-gradient(135deg,var(--accent),#4aa385);border-radius:8px;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700}\\n    nav a{margin-left:12px;color:#19372f;text-decoration:none}\\n    main{max-width:1100px;margin:0 auto;padding:18px}\\n    .hero{display:flex;justify-content:space-between;align-items:center;padding:18px;background:linear-gradient(90deg,rgba(93,169,135,0.12),rgba(255,255,255,0.6));border-radius:12px}\\n    .hero h1{margin:0}\\n    .products{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .card{background:var(--card);padding:14px;border-radius:12px;box-shadow:0 10px 26px rgba(14,30,20,0.04);display:flex;flex-direction:column}\\n    .media{height:120px;border-radius:10px;background:linear-gradient(135deg,#eaf6ef,#f2fff7);display:flex;align-items:center;justify-content:center;color:var(--muted);font-weight:700}\\n    .price{margin-top:auto;font-weight:700;color:#14332b}\\n    .buy{margin-top:10px;padding:10px;border-radius:10px;background:var(--accent);color:#fff;text-decoration:none;display:inline-block}\\n    .muted{color:var(--muted);font-size:13px}\\n    .pattern{position:fixed;right:-140px;bottom:-80px;opacity:0.08;width:540px;height:540px}\\n    @media (max-width:900px){.products{grid-template-columns:repeat(2,1fr)}.hero{flex-direction:column;align-items:flex-start}}\\n    @media (max-width:520px){.products{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique SVG motif for shop -->\\n  <svg class='pattern' viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n    <defs>\\n      <linearGradient id='gSh' x1='0' x2='1'><stop offset='0' stop-color='%235da987'/><stop offset='1' stop-color='%234aa385'/></linearGradient>\\n      <pattern id='pSh' width='18' height='18' patternUnits='userSpaceOnUse'>\\n        <rect width='18' height='18' fill='none'/>\\n        <circle cx='9' cy='9' r='2.5' fill='url(%23gSh)' opacity='0.12'/>\\n      </pattern>\\n    </defs>\\n    <rect width='100%' height='100%' fill='url(%23pSh)'/>\\n  </svg>\\n\\n  <header>\\n    <div class='logo'><div>S</div><div style='font-weight:700'>{{BUSINESS_NAME}}</div></div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='services.html' style='margin-left:10px'>Services</a>\\n      <a href='blends.html' style='margin-left:10px'>Blends</a>\\n      <a href='contact.html' style='margin-left:10px'>Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class='hero'>\\n      <div>\\n        <h1>Shop — curated kits and ready blends</h1>\\n        <div class='muted'>Thoughtfully packaged — each product includes safety & dilution notes. No medical claims.</div>\\n      </div>\\n      <div>\\n        <a class='buy' href='{{PRIMARY_CTA_URL}}'>Checkout & custom orders</a>\\n      </div>\\n    </div>\\n\\n    <section class='products' aria-label='Products'>\\n      <div class='card'>\\n        <div class='media'>Starter Ritual Kit</div>\\n        <div style='margin-top:12px;font-weight:700'>Starter Ritual Kit (3 blends)</div>\\n        <div class='muted' style='margin-top:8px'>Includes three pre-diluted 10 mL rollers and a booklet with safe-use notes.</div>\\n        <div class='price'>$48</div>\\n        <a class='buy' href='{{PRIMARY_CTA_URL}}'>Buy kit</a>\\n      </div>\\n\\n      <div class='card'>\\n        <div class='media'>Roll-On — Cozy Evening</div>\\n        <div style='margin-top:12px;font-weight:700'>Cozy Evening Roller (10 mL)</div>\\n        <div class='muted' style='margin-top:8px'>Top: Sweet Orange / Mid: Lavender / Base: Cedarwood — pre-diluted to safe topical use.</div>\\n        <div class='price'>$16</div>\\n        <a class='buy' href='{{PRIMARY_CTA_URL}}'>Add to cart</a>\\n      </div>\\n\\n      <div class='card'>\\n        <div class='media'>Roll-On — Quiet Focus</div>\\n        <div style='margin-top:12px;font-weight:700'>Quiet Focus Roller (10 mL)</div>\\n        <div class='muted' style='margin-top:8px'>Lemon • Basil • Light Patchouli — crafted for short focus sessions; includes patch-test guide.</div>\\n        <div class='price'>$16</div>\\n        <a class='buy' href='{{PRIMARY_CTA_URL}}'>Add to cart</a>\\n      </div>\\n\\n      <div class='card'>\\n        <div class='media'>Mini Diffuser</div>\\n        <div style='margin-top:12px;font-weight:700'>USB Mini Diffuser</div>\\n        <div class='muted' style='margin-top:8px'>Portable diffuser with low-mist setting, suitable for small rooms and office desks.</div>\\n        <div class='price'>$34</div>\\n        <a class='buy' href='{{PRIMARY_CTA_URL}}'>Buy diffuser</a>\\n      </div>\\n\\n      <div class='card'>\\n        <div class='media'>Custom Blend Vial</div>\\n        <div style='margin-top:12px;font-weight:700'>Custom Blend — 15 mL</div>\\n        <div class='muted' style='margin-top:8px'>Order a tailored blend; includes dilution guidance and patch-test instructions. (Lead time applies.)</div>\\n        <div class='price'>$58</div>\\n        <a class='buy' href='book.html'>Request custom</a>\\n      </div>\\n\\n      <div class='card'>\\n        <div class='media'>Refill Oils</div>\\n        <div style='margin-top:12px;font-weight:700'>Single Oil Refills</div>\\n        <div class='muted' style='margin-top:8px'>Select popular oils in 10 mL sizes. All labeled with botanical names and safety notes.</div>\\n        <div class='price'>From $9</div>\\n        <a class='buy' href='{{PRIMARY_CTA_URL}}'>Shop oils</a>\\n      </div>\\n\\n    </section>\\n\\n    <section style='margin-top:20px'>\\n      <h2>Shop policies & safety</h2>\\n      <p class='muted'>Products ship with ingredient lists, suggested dilution for topical use, and patch-test instructions. If pregnant, nursing, or caring for pets, consult product notes and reach out for alternatives.</p>\\n\\n      <div style='margin-top:12px'>\\n        <a class='buy' href='contact.html'>Questions about safety?</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer style='padding:18px;text-align:center;color:var(--muted)'>\\n    <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • {{EMAIL}} • {{PHONE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
