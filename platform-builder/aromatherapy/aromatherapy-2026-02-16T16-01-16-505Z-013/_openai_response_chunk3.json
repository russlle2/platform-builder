          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Rates — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Transparent aromatherapy session rates and packages from {{PRACTITIONER_NAME}} in {{CITY}}, {{STATE}}. Safety-forward.\\\">\\n  <style>\\n    :root{--bg1:#fffaf6;--accent:#6a8e7f;--muted:#6b6b6b;--card:#ffffff;--glass:rgba(255,255,255,0.6);--shadow:0 6px 20px rgba(102,102,102,0.12);}    \\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial; color:#112;}\\n    header{position:sticky;top:0;background:linear-gradient(180deg,var(--glass),transparent);backdrop-filter:blur(6px);padding:14px 28px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(17,34,34,0.04)}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:48px;height:48px;display:grid;place-items:center;border-radius:10px;background:linear-gradient(135deg,var(--accent),#b2cbb9);box-shadow:var(--shadow);color:#fff;font-weight:700}\\n    nav a{margin:0 10px;color:#123; text-decoration:none;font-weight:600}\\n    nav a[href$=\\\"pricing.html\\\"]{color:var(--accent)}\\n    main{padding:40px 28px;max-width:1100px;margin:0 auto}\\n    .hero{display:grid;grid-template-columns:1fr 320px;gap:28px;align-items:center;margin-bottom:28px}\\n    .hero .kicker{color:var(--accent);font-weight:700;margin-bottom:8px}\\n    .hero h1{margin:0;font-size:28px}\\n    .hero p{color:var(--muted);margin-top:10px}\\n    .card{background:var(--card);border-radius:14px;padding:18px;box-shadow:var(--shadow)}\\n    .pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:18px}\\n    .plan{border-radius:12px;padding:18px;background:linear-gradient(180deg,#fff,#fbfbfb);border:1px solid rgba(17,34,34,0.04)}\\n    .plan h3{margin:6px 0}\\n    .price{font-size:22px;color:var(--accent);font-weight:800}\\n    .features{color:var(--muted);margin:10px 0 14px}\\n    .btn{display:inline-block;background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{margin-top:40px;padding:24px 0;color:var(--muted);font-size:14px}\\n    .testimonials{display:flex;gap:12px;margin-top:14px}\\n    .testimonials blockquote{background:linear-gradient(90deg,#fbfbfb,#fffaf8);padding:12px;border-radius:10px;font-size:14px;color:#333;margin:0;box-shadow:0 4px 18px rgba(17,34,34,0.05)}\\n    .faq dt{font-weight:700;margin-top:12px}\\n    .lead{display:flex;gap:16px;align-items:center;padding:14px;border-radius:12px;margin-top:18px;background:linear-gradient(90deg,#f7fff8,#ffffff);}\\n    /* SVG pattern background */\\n    body::before{content:'';position:fixed;inset:0;z-index:-1;background:radial-gradient(circle at 10% 10%, rgba(106,142,127,0.06), transparent 6%),linear-gradient(180deg,#fefcf8,#fffefc);mask-image:linear-gradient(#000 0%, rgba(0,0,0,0.8) 100%);}    \\n    @media(max-width:900px){.hero{grid-template-columns:1fr}.pricing-grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav aria-label=\\\"Primary\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Boutique</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <div class=\\\"kicker\\\">Transparent Pricing</div>\\n        <h1>Simple session rates, designed for clarity and safety</h1>\\n        <p>Choose a package that fits your time and attention. All sessions emphasize safe essential oil use — no medical claims, just botanical support for wellbeing when used responsibly.</p>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:16px\\\">\\n          <strong>Need a custom blend with session?</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Add a bespoke roll-on or a personal inhaler while we craft scent profiles guided by patch-test recommendations and dilution best practices.</div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Quick contact</div>\\n        <div style=\\\"margin-top:8px;font-weight:700\\\">{{PRACTITIONER_NAME}}</div>\\n        <div style=\\\"margin-top:6px;color:var(--muted)\\\">Phone: {{PHONE}}<br>Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:inline-block;margin-top:12px\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <div class=\\\"testimonials\\\" style=\\\"margin-top:12px\\\">\\n          <blockquote>\\\"Supportive guidance and clear safety advice — felt cared for.\\\" — L.\\n          </blockquote>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"card\\\">\\n      <h2 style=\\\"margin-top:0\\\">Choose your session</h2>\\n      <p style=\\\"color:var(--muted)\\\">Packages are per person and include a consultation, a single tailored blend recommendation, and post-session care notes.</p>\\n      <div class=\\\"pricing-grid\\\">\\n        <div class=\\\"plan\\\">\\n          <h3>Intro Session</h3>\\n          <div class=\\\"price\\\">$85 • 45 min</div>\\n          <div class=\\\"features\\\">Consultation, scent sampling, safety & dilution plan</div>\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book Intro</a>\\n        </div>\\n        <div class=\\\"plan\\\">\\n          <h3>Full Aromatherapy Session</h3>\\n          <div class=\\\"price\\\">$160 • 90 min</div>\\n          <div class=\\\"features\\\">Deeper aromatic assessment, custom blend, written guidance</div>\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve Full</a>\\n        </div>\\n        <div class=\\\"plan\\\">\\n          <h3>VIP Day (Intensive)</h3>\\n          <div style=\\\"font-size:12px;color:var(--muted);margin-bottom:6px\\\">(Best for professionals or multi-blend planning)</div>\\n          <div class=\\\"price\\\">$950 • 6 hrs</div>\\n          <div class=\\\"features\\\">Hands-on blending, kit prep, multi-client formulation coaching</div>\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Inquire VIP</a>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:16px;color:var(--muted);font-size:13px\\\">Payments accepted via credit, Venmo, or bank transfer. Travel rates apply for on-site sessions in {{CITY}}, {{STATE}}; please ask.</div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h2>Why these packages?</h2>\\n      <ul style=\\\"color:var(--muted)\\\">\\n        <li>Safety-first: consultation and dilution plan included with every session.</li>\\n        <li>Simple, repeatable blends you can make at home.</li>\\n        <li>Documentation: you leave with usage notes, storage guidance, and patch test instructions.</li>\\n      </ul>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h2>Frequently asked — session & safety</h2>\\n      <dl class=\\\"faq\\\">\\n        <dt>How should I dilute essential oils?</dt>\\n        <dd style=\\\"color:var(--muted)\\\">Dilution depends on age, skin sensitivity, and intended use. Typical adult topical dilutions are 1–3% for daily blends; counseling provided during the session. We never recommend undiluted skin use unless specifically guided for tiny test spots.\\n        </dd>\\n        <dt>What is a patch test?</dt>\\n        <dd style=\\\"color:var(--muted)\\\">A patch test involves applying a small diluted amount to the forearm and waiting 24–48 hours to check for irritation. We demonstrate and record results for your safety.\\n        </dd>\\n        <dt>Are essential oils safe around pets?</dt>\\n        <dd style=\\\"color:var(--muted)\\\">Some oils can be irritating to pets. We include pet-safe guidance and identify oils to avoid around cats and dogs; always consult your veterinarian if concerned.</dd>\\n        <dt>Pregnancy or breastfeeding?</dt>\\n        <dd style=\\\"color:var(--muted)\\\">We follow conservative, safety-first guidance for pregnancy and lactation. Certain oils are avoided or only used with medical clearance; we will modify recommendations accordingly.</dd>\\n      </dl>\\n    </section>\\n\\n    <section class=\\\"lead\\\" style=\\\"margin-top:18px\\\">\\n      <div style=\\\"flex:1\\\">\\n        <div style=\\\"font-weight:800\\\">Free Starter Guide</div>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">Download \\\"Aromatherapy Safety & Starter Guide\\\" — quick steps for dilution, storage, and at-home blending.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"#\\\">Download PDF</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;max-width:1100px;margin:18px auto 0\\\">\\n        <div>&copy; {{BUSINESS_NAME}} — {{PRACTITIONER_NAME}} • {{CITY}}, {{STATE}}</div>\\n        <div style=\\\"color:var(--muted)\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n      </div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{PRACTITIONER_NAME}} at {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Learn about {{PRACTITIONER_NAME}}'s approach to aromatherapy: safety-first, evidence-informed, and client-centered.\\\">\\n  <style>\\n    :root{--bg:#fff;--accent:#9c6b9c;--muted:#555;--panel:#fffefc}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Georgia, 'Times New Roman', serif;color:#1a1a1a;background:linear-gradient(180deg,#fffafc,#ffffff)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 28px;border-bottom:1px solid rgba(0,0,0,0.04)}\\n    .nav a{margin:0 10px;text-decoration:none;color:#222;font-weight:600}\\n    .nav a[href$=\\\"about.html\\\"]{color:var(--accent)}\\n    main{max-width:980px;margin:36px auto;padding:0 20px}\\n    .hero{padding:26px;border-radius:14px;background:linear-gradient(135deg,#fff6ff,#fff);display:flex;gap:20px;align-items:center}\\n    .avatar{min-width:112px;height:112px;border-radius:14px;background:linear-gradient(180deg,var(--accent),#cfa3cf);display:grid;place-items:center;color:#fff;font-weight:800}\\n    h1{margin:0 0 6px 0;font-family:Georgia, serif}\\n    p.lead{color:var(--muted);margin-top:6px}\\n    .sections{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    .panel{background:var(--panel);padding:16px;border-radius:12px;box-shadow:0 6px 20px rgba(0,0,0,0.04)}\\n    .meta{font-size:14px;color:var(--muted)}\\n    .skills{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}\\n    .chip{background:#fff;border:1px solid rgba(0,0,0,0.06);padding:6px 10px;border-radius:999px;font-weight:600;font-size:13px}\\n    .cta{margin-top:12px}\\n    .btn{background:var(--accent);color:#fff;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .faq dt{font-weight:700;margin-top:12px}\\n    /* unique light dotted svg accent */\\n    .accent-svg{position:absolute;right:20px;top:20px;opacity:0.06}\\n    @media(max-width:920px){.sections{grid-template-columns:1fr} .hero{flex-direction:column;align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div style=\\\"width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#9c6b9c,#e6d5e6);display:grid;place-items:center;color:#fff;font-weight:800\\\">{{PRACTITIONER_NAME.charAt(0)}}</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">What I Do</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Shop</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero panel\\\" style=\\\"position:relative;overflow:hidden\\\">\\n      <svg class=\\\"accent-svg\\\" width=\\\"220\\\" height=\\\"220\\\" viewBox=\\\"0 0 220 220\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n        <defs>\\n          <pattern id=\\\"dots\\\" width=\\\"12\\\" height=\\\"12\\\" patternUnits=\\\"userSpaceOnUse\\\"><circle cx=\\\"1\\\" cy=\\\"1\\\" r=\\\"1.2\\\" fill=\\\"#9c6b9c\\\"/></pattern>\\n        </defs>\\n        <rect width=\\\"220\\\" height=\\\"220\\\" fill=\\\"url(#dots)\\\" rx=\\\"16\\\"/>\\n      </svg>\\n      <div class=\\\"avatar\\\">{{PRACTITIONER_NAME.charAt(0)}}</div>\\n      <div>\\n        <h1>About {{PRACTITIONER_NAME}}</h1>\\n        <p class=\\\"lead\\\">I blend traditional botanical knowledge with modern safety practices. My work centers on guided scent experiences, practical at-home recipes, and clear instructions so you can use essential oils confidently.</p>\\n        <div class=\\\"meta\\\">Based in {{CITY}}, {{STATE}} • Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"sections\\\">\\n      <div>\\n        <section class=\\\"panel\\\">\\n          <h2>Philosophy & approach</h2>\\n          <p style=\\\"color:var(--muted)\\\">My approach is practical: I avoid sensational claims and focus on safety, sensation, and ritual. Every recommendation includes dilution guidance, storage tips, and patch-test instructions so you can integrate aromatherapy into daily life safely.</p>\\n\\n          <h3 style=\\\"margin-top:12px\\\">Background</h3>\\n          <p style=\\\"color:var(--muted)\\\">Years of workshop teaching, client consultations, and continuing education in aromatherapy safety inform my practice. I prioritize working with your medical providers when needed and always document safe usage plans.</p>\\n\\n          <h3 style=\\\"margin-top:12px\\\">What clients tell me</h3>\\n          <blockquote style=\\\"margin:0;padding:12px;border-radius:8px;background:linear-gradient(90deg,#fff,#fff7fb);color:#333\\\">\\\"Warm, knowledgeable, and safety-minded. I learned to blend with confidence.\\\" — A client</blockquote>\\n        </section>\\n\\n        <section class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h2>Credentials & training</h2>\\n          <ul style=\\\"color:var(--muted)\\\">\\n            <li>Certified aromatherapist (training & continuing education)</li>\\n            <li>Workshops in scent safety, dilution, and client-centered practice</li>\\n            <li>Practical experience with both beginners and small-business product formulators</li>\\n          </ul>\\n        </section>\\n\\n        <section class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h2>Frequently asked — safety topics</h2>\\n          <dl class=\\\"faq\\\">\\n            <dt>How do you keep sessions safe?</dt>\\n            <dd style=\\\"color:var(--muted)\\\">We begin with a full intake, discuss medications and sensitivities, and provide a conservative dilution plan. No medical promises are made; aromatherapy supports sensory experience and mindfulness when used responsibly.</dd>\\n            <dt>Can I bring my pet?</dt>\\n            <dd style=\\\"color:var(--muted)\\\">Pets should generally remain at home; certain oils are best kept away from animals. If you're unsure, we will plan pet-safe options during your consult.</dd>\\n            <dt>Pregnancy notes</dt>\\n            <dd style=\\\"color:var(--muted)\\\">I follow conservative guidance for pregnancy and lactation. Some oils are avoided; alternatives are offered.</dd>\\n          </dl>\\n        </section>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <h3>Practical benefits</h3>\\n          <div class=\\\"skills\\\">\\n            <div class=\\\"chip\\\">Safety-first</div>\\n            <div class=\\\"chip\\\">Dilution plans</div>\\n            <div class=\\\"chip\\\">At-home blends</div>\\n            <div class=\\\"chip\\\">Workshops</div>\\n          </div>\\n\\n          <div class=\\\"cta\\\">\\n            <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h3>Download — Quick Safety Sheet</h3>\\n          <p style=\\\"color:var(--muted)\\\">Sign up to receive a short safety checklist for home blending and storage.</p>\\n          <a class=\\\"btn\\\" href=\\\"#\\\">Get the checklist</a>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h3>Testimonials</h3>\\n          <blockquote style=\\\"margin:0;padding:8px;background:#fff; border-radius:8px\\\">\\\"Practical advice that I actually use.\\\" — R.</blockquote>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted);text-align:center\\\">© {{BUSINESS_NAME}} — {{PRACTITIONER_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a Session — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Reserve an aromatherapy session with {{PRACTITIONER_NAME}}. Fast online booking and VIP day options. Safety-first consultations.\\\">\\n  <style>\\n    :root{--bg:#fcfff8;--accent:#3b6b8f;--muted:#444}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;color:#0b1220;background:linear-gradient(180deg,var(--bg),#ffffff)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:12px 20px;border-bottom:1px solid rgba(11,18,32,0.04)}\\n    .brand{font-weight:800}\\n    nav a{margin:0 8px;text-decoration:none;color:#233}\\n    nav a[href$=\\\"book.html\\\"]{color:var(--accent);font-weight:700}\\n    main{max-width:980px;margin:28px auto;padding:0 20px}\\n    .split{display:grid;grid-template-columns:1fr 360px;gap:20px}\\n    .panel{background:#fff;padding:16px;border-radius:12px;box-shadow:0 8px 28px rgba(15,30,45,0.06)}\\n    h1{margin:0 0 6px 0}\\n    p.lead{color:var(--muted)}\\n    .steps{display:flex;flex-direction:column;gap:10px;margin-top:12px}\\n    .step{padding:10px;border-radius:8px;border:1px dashed rgba(11,18,32,0.06)}\\n    form label{display:block;margin-top:10px;font-size:13px}\\n    input,select,textarea{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid rgba(0,0,0,0.06)}\\n    .submit{margin-top:12px;background:var(--accent);color:#fff;padding:10px 12px;border-radius:8px;border:none;font-weight:700}\\n    .note{font-size:13px;color:var(--muted);margin-top:10px}\\n    .testimonial{margin-top:12px;padding:10px;border-radius:8px;background:linear-gradient(90deg,#f7fbff,#fff);}\\n    @media(max-width:920px){.split{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Welcome</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"split\\\">\\n      <section class=\\\"panel\\\">\\n        <h1>Reserve your appointment</h1>\\n        <p class=\\\"lead\\\">Book a consult with {{PRACTITIONER_NAME}}. Sessions emphasize scent exploration, practical blending, and clear safety instructions. We keep things simple and mindful.</p>\\n\\n        <div class=\\\"steps\\\">\\n          <div class=\\\"step\\\"><strong>1.</strong> Pick a session type (Intro, Full, VIP).</div>\\n          <div class=\\\"step\\\"><strong>2.</strong> Complete short intake and disclose sensitivities/medications.</div>\\n          <div class=\\\"step\\\"><strong>3.</strong> Receive a dilution and patch-test plan during the session.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\">\\n            <label for=\\\"service\\\">Session</label>\\n            <select id=\\\"service\\\" name=\\\"service\\\">\\n              <option>Intro Session — 45 min</option>\\n              <option>Full Aromatherapy Session — 90 min</option>\\n              <option>VIP Day — 6 hrs</option>\\n            </select>\\n\\n            <label for=\\\"name\\\">Full name</label>\\n            <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"Your name\\\" required />\\n\\n            <label for=\\\"email\\\">Email</label>\\n            <input id=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"you@example.com\\\" type=\\\"email\\\" required />\\n\\n            <label for=\\\"phone\\\">Phone</label>\\n            <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"Optional\\\" />\\n\\n            <label for=\\\"notes\\\">Brief notes (sensitivities, pregnancy, pets)</label>\\n            <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Any known sensitivities or concerns\\\"></textarea>\\n\\n            <button class=\\\"submit\\\" type=\\\"submit\\\">Continue to scheduling</button>\\n          </form>\\n\\n          <div class=\\\"note\\\">By booking you acknowledge that aromatherapy is offered as a wellness practice. We do not provide medical diagnoses or treatments. Please consult your healthcare provider for medical concerns.</div>\\n        </div>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <h3>Need immediate help booking?</h3>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">Call <strong>{{PHONE}}</strong> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>. For VIP Day inquiries, please include your goals and approximate dates.</div>\\n          <div style=\\\"margin-top:12px\\\">\\n            <a class=\\\"submit\\\" href=\\\"tel:{{PHONE}}\\\" style=\\\"background:#2b5f7f;display:inline-block;text-decoration:none;\\\">Call to book</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h4>Before your visit</h4>\\n          <ul style=\\\"color:var(--muted)\\\">\\n            <li>Note current medications and allergies.</li>\\n            <li>Bring any products you use regularly.</li>\\n            <li>Plan for a patch test after we create a blend — instructions provided.</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h4>Safety FAQs</h4>\\n          <div style=\\\"color:var(--muted);font-size:14px\\\">\\n            <strong>Dilution?</strong> Recommended per client; typically 1–3% for adults for regular topical blends.<br>\\n            <strong>Patch test?</strong> Yes — small diluted test area and 24–48 hour wait if skin-sensitive.<br>\\n            <strong>Pets?</strong> We provide pet-safe guidance and oils to avoid around cats & dogs.<br>\\n            <strong>Pregnancy?</strong> Conservative recommendations; several oils avoided unless cleared by provider.\\n          </div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h4>Sample testimonial</h4>\\n          <div class=\\\"testimonial\\\">\\\"Booking was straightforward and the practitioner walked me through safe use—super practical.\\\" — M.</div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h4>Lead magnet</h4>\\n          <p style=\\\"color:var(--muted)\\\">Reserve and receive the \\\"Home Blending Starter Pack\\\" PDF with dilution charts and label templates.</p>\\n          <a class=\\\"submit\\\" href=\\\"#\\\">Send me the pack</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer style=\\\"margin-top:20px;text-align:center;color:var(--muted)\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}} • {{BUSINESS_NAME}} — {{CITY}}, {{STATE}}</footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
