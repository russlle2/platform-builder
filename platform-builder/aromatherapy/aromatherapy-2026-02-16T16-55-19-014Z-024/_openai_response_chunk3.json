          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Membership — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"A gentle membership for ongoing aromatherapy routines and seasonal blends.\\\">\\n  <style>\\n    :root{--bg:#FFF7F2;--accent:#6b2d5b;--muted:#7b6f7a;--card:#fff;--glass:rgba(255,255,255,0.6)}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:#332a31;background:linear-gradient(120deg,var(--bg),#fff);}\\n    a{color:var(--accent);text-decoration:none}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 40px;background:transparent;position:relative;z-index:5}\\n    .brand{display:flex;align-items:center;gap:14px}\\n    .logo{width:54px;height:54px;border-radius:12px;background:linear-gradient(135deg,#ffd8e0,#f6e7ff);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent)}\\n    nav a{margin:0 10px;font-size:15px;color:var(--muted)}\\n    .wrap{max-width:1100px;margin:40px auto;padding:28px}\\n    /* diagonal split */\\n    .stage{position:relative;overflow:hidden;border-radius:14px;padding:48px;background:linear-gradient(180deg,rgba(255,255,255,0.85),rgba(255,250,248,0.9));box-shadow:0 10px 30px rgba(40,25,30,0.06)}\\n    .stage::before{content:\\\"\\\";position:absolute;inset:-30% -10% auto -10%;height:60%;background:linear-gradient(120deg,rgba(107,45,91,0.06),rgba(255,210,230,0));transform:skewY(-6deg);pointer-events:none}\\n    /* pattern */\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center}\\n    .lead{padding:20px}\\n    h1{font-size:28px;margin:0 0 12px;color:var(--accent)}\\n    p.lead{color:var(--muted);margin:0 0 18px}\\n    .cta{display:inline-block;padding:12px 18px;background:var(--accent);color:#fff;border-radius:10px}\\n    .aside{background:linear-gradient(180deg,#fff,#fff0);border-radius:12px;padding:18px;box-shadow:inset 0 -6px 20px rgba(107,45,91,0.03)}\\n    /* cards */\\n    .cards{display:flex;gap:16px;margin-top:18px}\\n    .card{background:var(--card);padding:16px;border-radius:12px;flex:1;box-shadow:0 6px 18px rgba(48,28,38,0.04);border:1px solid rgba(107,45,91,0.03)}\\n    .price{font-size:22px;color:var(--accent);font-weight:700}\\n    .muted{color:var(--muted);font-size:14px}\\n    /* micro habits */\\n    .micro{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px}\\n    .micro .pill{background:var(--glass);padding:10px 12px;border-radius:999px;font-size:13px;color:var(--accent);border:1px solid rgba(107,45,91,0.06)}\\n    footer{padding:28px 40px;color:var(--muted);font-size:14px}\\n    .faq{margin-top:16px}\\n    /* responsive */\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.aside{order:-1}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\"><div class=\\\"logo\\\">A</div><div><strong>{{BUSINESS_NAME}}</strong><div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div></div></div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Treatments</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Shop</a>\\n      <a href=\\\"about.html\\\">About</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"stage hero\\\" aria-labelledby=\\\"hero-label\\\">\\n      <div class=\\\"lead\\\">\\n        <h1 id=\\\"hero-label\\\">Membership for steady, seasonal routines</h1>\\n        <p class=\\\"lead\\\">Join a gentle circle of listeners: monthly blends, guided rituals, and practitioner access. Designed to support mood and ritual consistency — safety-first, supportive care, not medical advice.</p>\\n        <a class=\\\"cta\\\" href=\\\"#pricing\\\">Join the circle</a>\\n\\n        <div class=\\\"cards\\\" style=\\\"margin-top:22px\\\">\\n          <div class=\\\"card\\\">\\n            <div class=\\\"muted\\\">Monthly credits</div>\\n            <div class=\\\"price\\\">1–3 credits / month</div>\\n            <div class=\\\"muted\\\">Use for rolls, consultations, or blend refills.</div>\\n          </div>\\n          <div class=\\\"card\\\">\\n            <div class=\\\"muted\\\">Member-only blends</div>\\n            <div class=\\\"price\\\">New each season</div>\\n            <div class=\\\"muted\\\">Curated small-batch blends for members.</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"aside\\\">\\n        <h3 style=\\\"margin-top:0\\\">How it works</h3>\\n        <ol style=\\\"padding-left:18px;margin:8px 0;color:var(--muted)\\\">\\n          <li>Choose a tier</li>\\n          <li>Receive monthly ritual guidance</li>\\n          <li>Use credits for products or support</li>\\n        </ol>\\n        <div style=\\\"margin-top:10px\\\">\\n          <strong>Need help choosing?</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Try our quick diagnostic to match scents and moods.</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"stage\\\" id=\\\"diagnostic\\\" style=\\\"margin-top:20px\\\">\\n      <h2 style=\\\"margin:0 0 8px;color:var(--accent)\\\">A quick scent check — what suits you?</h2>\\n      <p class=\\\"muted\\\">Pick the words that call to you. No tests, just a way to tune into scent preferences and safety notes.</p>\\n      <form style=\\\"display:flex;gap:8px;flex-wrap:wrap;margin-top:12px\\\">\\n        <label class=\\\"pill\\\"><input type=\\\"checkbox\\\"> Calm</label>\\n        <label class=\\\"pill\\\"><input type=\\\"checkbox\\\"> Bright</label>\\n        <label class=\\\"pill\\\"><input type=\\\"checkbox\\\"> Earthy</label>\\n        <label class=\\\"pill\\\"><input type=\\\"checkbox\\\"> Floral</label>\\n        <label class=\\\"pill\\\"><input type=\\\"checkbox\\\"> Spicy</label>\\n        <button style=\\\"margin-left:auto;padding:10px 14px;border-radius:10px;background:var(--accent);color:#fff;border:0\\\">See suggestion</button>\\n      </form>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:12px\\\">Note: If pregnant, nursing, or with serious health concerns, consult your primary care provider before using concentrated essential oils. Patch test and correct dilution recommended.</p>\\n    </section>\\n\\n    <section class=\\\"stage\\\" id=\\\"plan\\\" style=\\\"margin-top:20px\\\">\\n      <h2 style=\\\"color:var(--accent)\\\">Plans shaped like seasonal rituals</h2>\\n      <p class=\\\"muted\\\">Memberships are month-to-month and focus on safe, small-batch aromatherapy. Each tier includes guidance on dilution, pet-safe options, and patch testing.</p>\\n      <div class=\\\"cards\\\" style=\\\"margin-top:14px\\\">\\n        <div class=\\\"card\\\">\\n          <div class=\\\"muted\\\">Seedling</div>\\n          <div class=\\\"price\\\">$12 / month</div>\\n          <div class=\\\"muted\\\">One roll-on or refill + member blend notes</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <div class=\\\"muted\\\">Garden</div>\\n          <div class=\\\"price\\\">$28 / month</div>\\n          <div class=\\\"muted\\\">3 credits, one consult per quarter, seasonal blend</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <div class=\\\"muted\\\">Grove</div>\\n          <div class=\\\"price\\\">$58 / month</div>\\n          <div class=\\\"muted\\\">6 credits, monthly mini-check-ins, priority booking</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"stage\\\" id=\\\"micro_habits\\\" style=\\\"margin-top:20px\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">Small rituals — big comfort</h3>\\n      <p class=\\\"muted\\\">Tiny, repeatable habits you can do in 2–5 minutes.</p>\\n      <div class=\\\"micro\\\">\\n        <div class=\\\"pill\\\">Roll to pulse points — 1–2 gentle swipes</div>\\n        <div class=\\\"pill\\\">Diffuse on a 15/45 rhythm (15 min on, 45 min off)</div>\\n        <div class=\\\"pill\\\">Hand inhale before bedtime</div>\\n        <div class=\\\"pill\\\">Add 1–2 drops to unscented carrier oil</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"stage\\\" id=\\\"pricing\\\" style=\\\"margin-top:20px\\\">\\n      <h2 style=\\\"color:var(--accent)\\\">Pricing &amp; what you get</h2>\\n      <p class=\\\"muted\\\">Membership is curated for safety and sustainability. All plans include dilution guidance, patch-test instructions, and basic pet/pregnancy notes where applicable.</p>\\n      <div class=\\\"cards\\\" style=\\\"margin-top:14px\\\">\\n        <div class=\\\"card\\\">\\n          <h4>Seedling</h4>\\n          <div class=\\\"price\\\">$12</div>\\n          <div class=\\\"muted\\\">1 credit • Roll-on or refill • Email support</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Start Seedling</a></div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h4>Garden</h4>\\n          <div class=\\\"price\\\">$28</div>\\n          <div class=\\\"muted\\\">3 credits • Quarterly consult • Seasonal blend</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Join Garden</a></div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h4>Grove</h4>\\n          <div class=\\\"price\\\">$58</div>\\n          <div class=\\\"muted\\\">6 credits • Monthly check-in • Priority booking</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Join Grove</a></div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"faq\\\" style=\\\"margin-top:12px\\\">\\n        <h4 style=\\\"margin:0;color:var(--accent)\\\">Safety highlights</h4>\\n        <ul style=\\\"color:var(--muted);margin-top:8px;padding-left:18px\\\">\\n          <li>Always dilute essential oils into a carrier. Typical dilution ranges are provided in member guides.</li>\\n          <li>Patch test new blends on a small area of skin 24–48 hours prior to use.</li>\\n          <li>Use care around pets — some oils are not pet-safe. We include pet-safe alternatives.</li>\\n          <li>If pregnant or nursing, consult your healthcare provider before use.</li>\\n        </ul>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"stage\\\" id=\\\"cta\\\" style=\\\"margin-top:20px;text-align:center\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">Ready to make scent a steady practice?</h3>\\n      <p class=\\\"muted\\\">Members receive seasonal blends and safety-forward guidance from {{PRACTITIONER_NAME}}.</p>\\n      <a class=\\\"cta\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      <div>Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#FCFFF5;--accent:#2a6b52;--muted:#556b63}\\n    body{margin:0;font-family:Georgia, 'Times New Roman', serif;background:linear-gradient(160deg,var(--bg),#fff);color:#223}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:26px 32px}\\n    .logo{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,#e8fff0,#ddffe8);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent)}\\n    nav a{margin-left:12px;color:var(--muted)}\\n    .container{max-width:1000px;margin:28px auto;padding:24px}\\n    .split{display:grid;grid-template-columns:1fr 320px;gap:22px;align-items:start}\\n    .panel{background:white;padding:20px;border-radius:12px;box-shadow:0 8px 30px rgba(39,49,45,0.04)}\\n    h1{margin:0;color:var(--accent)}\\n    .muted{color:var(--muted)}\\n    /* diagonal accent */\\n    .panel::after{content:'';position:absolute;right:-40px;top:10px;width:180px;height:60px;background:linear-gradient(120deg,rgba(42,107,82,0.06),transparent);transform:skewY(-8deg);pointer-events:none}\\n    .timeline{margin-top:12px;padding-left:18px;color:var(--muted)}\\n    .quote{font-style:italic;color:#445}\\n    .pill{display:inline-block;background:linear-gradient(90deg,#f0fff5,#fff);padding:8px 10px;border-radius:999px;border:1px solid rgba(42,107,82,0.06);color:var(--accent);margin:6px 6px 0 0}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\"><div class=\\\"logo\\\">A</div><div><strong>{{BUSINESS_NAME}}</strong><div style=\\\"font-size:12px;color:var(--muted)\\\">{{PRACTITIONER_NAME}}</div></div></div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Begin</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Aromas</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"split\\\">\\n      <div>\\n        <article class=\\\"panel\\\" style=\\\"position:relative\\\">\\n          <h1>Where scent meets gentle practice</h1>\\n          <p class=\\\"muted\\\">I create small rituals that fit into everyday life. My work is about listening — to scent, to stories, to how bodies respond. All guidance is safety-forward and not intended as medical advice.</p>\\n\\n          <h3 style=\\\"margin-top:14px\\\">My approach</h3>\\n          <p class=\\\"muted\\\">I blend clinical respect with a storyteller's touch: clear dilution instructions, patch-test prompts, and alternatives for households with children or pets. Expect conversational guidance and seasonal offerings that change with the months.</p>\\n\\n          <h3 style=\\\"margin-top:14px\\\">Practitioner story</h3>\\n          <p class=\\\"quote\\\">\\\"I've always been drawn to gardens and kitchens — places where scent quietly shapes memory.\\\"</p>\\n          <p class=\\\"muted\\\">{{PRACTITIONER_NAME}} trained in aromatherapy ethics and safe practice and has worked with hundreds of people to create supportive scent routines. Your comfort and safety come first.</p>\\n\\n          <div style=\\\"margin-top:14px\\\">\\n            <strong>Community notes</strong>\\n            <div class=\\\"timeline\\\">\\n              <div>• Workshops on safe dilution and patch testing</div>\\n              <div>• Member-only seasonal blends</div>\\n            </div>\\n          </div>\\n        </article>\\n\\n        <section class=\\\"panel\\\" style=\\\"margin-top:18px\\\">\\n          <h4 style=\\\"margin:0;color:var(--accent)\\\">Quick safety primer</h4>\\n          <ul style=\\\"color:var(--muted);margin-top:8px;padding-left:18px\\\">\\n            <li>Essential oils are concentrated — dilute before skin use.</li>\\n            <li>Patch test a small area before regular topical use.</li>\\n            <li>Some oils are not recommended around cats; members receive pet-safe lists.</li>\\n            <li>If pregnant or on medication, consult a healthcare provider.</li>\\n          </ul>\\n        </section>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <h4 style=\\\"margin-top:0\\\">Philosophy &amp; membership</h4>\\n          <p class=\\\"muted\\\">Membership centers safety and ritual continuity. Choose a plan for seasonal blends, credits, and gentle coaching.</p>\\n          <div style=\\\"margin-top:10px\\\"><a href=\\\"pricing.html\\\">See membership options</a></div>\\n\\n          <h4 style=\\\"margin-top:16px\\\">Small rituals</h4>\\n          <div>\\n            <span class=\\\"pill\\\">Evening inhale</span>\\n            <span class=\\\"pill\\\">Hand-rolled blends</span>\\n            <span class=\\\"pill\\\">Desktop diffuser pause</span>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:16px\\\">\\n          <h4 style=\\\"margin:0\\\">FAQ highlights</h4>\\n          <div style=\\\"color:var(--muted);margin-top:8px;font-size:14px\\\">\\n            <strong>Dilution:</strong> We provide dilution charts in member guides.<br>\\n            <strong>Patch test:</strong> Apply to inside forearm; wait 24–48 hours.<br>\\n            <strong>Pets:</strong> Avoid diffusing undiluted oils near cats; contact us for safe alternatives.\\n          </div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <div class=\\\"panel\\\">\\n        <h3 style=\\\"margin:0;color:var(--accent)\\\">Join the conversation</h3>\\n        <p class=\\\"muted\\\">If you'd like to know more about membership or custom blends, reach out. I reply warmly and with clear safety guidance.</p>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:10px\\\">Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>.</p>\\n        <div style=\\\"margin-top:12px\\\"><a href=\\\"book.html\\\">Book an intro session</a></div>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer style=\\\"padding:20px;text-align:center;color:var(--muted)\\\">\\n    <small>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></small>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#7a3b1f;--bg:#fffaf7;--muted:#6b5b56}\\n    body{margin:0;font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial;background:linear-gradient(180deg,var(--bg),#fff);color:#2b1f1a}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 30px}\\n    nav a{margin-left:12px;color:var(--muted)}\\n    .hero{max-width:980px;margin:22px auto;padding:22px}\\n    .card{background:white;padding:18px;border-radius:12px;box-shadow:0 10px 30px rgba(110,70,60,0.05)}\\n    h1{margin:0;color:var(--accent)}\\n    .muted{color:var(--muted)}\\n    form{display:grid;grid-template-columns:1fr 280px;gap:18px;margin-top:14px}\\n    label{display:block;margin-bottom:8px;font-size:14px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #eee}\\n    .btn{display:inline-block;padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;border:0}\\n    .info{font-size:13px;color:var(--muted);margin-top:8px}\\n    @media(max-width:880px){form{grid-template-columns:1fr} }\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\"><div style=\\\"width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#ffeedd,#fff)\\\"></div><div><strong>{{BUSINESS_NAME}}</strong><div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div></div></div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"pricing.html\\\">Plans</a>\\n      <a href=\\\"about.html\\\">About</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"hero\\\">\\n    <div class=\\\"card\\\">\\n      <h1>Book a session with {{PRACTITIONER_NAME}}</h1>\\n      <p class=\\\"muted\\\">Choose a consultation or a quick ritual refill. Sessions include scent safety guidance and personalized dilution notes. This is supportive aromatherapy and not a medical service.</p>\\n\\n      <form id=\\\"booking\\\">\\n        <div>\\n          <label for=\\\"name\\\">Your name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"Full name\\\" required>\\n\\n          <label for=\\\"email\\\" style=\\\"margin-top:10px\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n\\n          <label for=\\\"type\\\" style=\\\"margin-top:10px\\\">Appointment type</label>\\n          <select id=\\\"type\\\" name=\\\"type\\\">\\n            <option>Intro consultation — 30 min</option>\\n            <option>Full session — 60 min</option>\\n            <option>Blend refill &amp; ritual — 20 min</option>\\n          </select>\\n\\n          <label for=\\\"notes\\\" style=\\\"margin-top:10px\\\">Notes (sensitivities, pets, pregnancy)</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Tell me about any skin sensitivities, pets at home, or pregnancy/nursing status.\\\"></textarea>\\n        </div>\\n\\n        <aside>\\n          <div style=\\\"background:linear-gradient(180deg,#fff,#fff5f0);padding:14px;border-radius:10px\\\">\\n            <h4 style=\\\"margin:0 0 8px;color:var(--accent)\\\">Available times</h4>\\n            <div class=\\\"muted\\\">Select a preferred day and time in the confirmation email. Typical hours: Tue–Sat 9am–4pm {{STATE}} time.</div>\\n\\n            <div style=\\\"margin-top:12px\\\">\\n              <label for=\\\"membership\\\">Are you a member?</label>\\n              <select id=\\\"membership\\\" name=\\\"membership\\\">\\n                <option>Not yet</option>\\n                <option>Seedling</option>\\n                <option>Garden</option>\\n                <option>Grove</option>\\n              </select>\\n            </div>\\n\\n            <div style=\\\"margin-top:14px;text-align:center\\\">\\n              <button class=\\\"btn\\\" type=\\\"submit\\\">Request appointment</button>\\n            </div>\\n\\n            <p class=\\\"info\\\">By submitting, you agree to receive scheduling messages. For urgent health matters, contact a medical professional. I do not provide medical diagnoses.</p>\\n          </div>\\n        </aside>\\n      </form>\\n\\n      <div style=\\\"margin-top:14px;color:var(--muted)\\\">\\n        <h4 style=\\\"margin:6px 0\\\">Pre-appointment checklist</h4>\\n        <ul style=\\\"padding-left:18px;\\\">\\n          <li>Note any skin allergies or topical sensitivities.</li>\\n          <li>Mention if you're pregnant, nursing, or on medication.</li>\\n          <li>Tell us if there are pets in the home; we will suggest pet-safe blends.</li>\\n        </ul>\\n      </div>\\n\\n      <div style=\\\"margin-top:12px;color:var(--muted)\\\">\\n        <h4 style=\\\"margin:6px 0\\\">Cancellation & safety</h4>\\n        <p style=\\\"margin:0\\\">Please allow 48 hours for cancellations. All sessions include dilution and patch-test guidance. No medical claims are made; aromatherapy is a complementary practice.</p>\\n      </div>\\n    </div>\\n  </main>\\n\\n  <script>\\n    document.getElementById('booking').addEventListener('submit',function(e){\\n      e.preventDefault();\\n      alert('Thanks! A booking request was sent. {{PRIMARY_CTA_LABEL}}')\\n      // placeholder for real booking flow\\n    })\\n  </script>\\n\\n  <footer style=\\\"padding:18px;text-align:center;color:var(--muted)\\\">\\n    <small>Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></small>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
