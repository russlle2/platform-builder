          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f6fbfa;--card:#ffffff;--muted:#6b7a7a;--accent:linear-gradient(135deg,#8fd3c7 0%,#7ab8c8 100%);--glass:rgba(255,255,255,0.7);--accent-plain:#7ab8c8}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:#08303a;background:var(--bg);-webkit-font-smoothing:antialiased}\\n    .svg-bg{position:fixed;inset:0;pointer-events:none;opacity:0.22;mix-blend-mode:multiply}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 32px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:var(--accent-plain);display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n    nav a{color:#0a3338;text-decoration:none;margin:0 10px;font-weight:600}\\n    main{max-width:1100px;margin:28px auto;padding:20px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;background:linear-gradient(180deg,rgba(255,255,255,0.9),rgba(255,255,255,0.6));padding:28px;border-radius:14px;box-shadow:0 6px 30px rgba(6,22,23,0.06)}\\n    .hero h1{margin:0;font-size:28px;color:#042e31}\\n    .hero p{color:var(--muted);margin-top:10px}\\n    .pill{display:flex;flex-direction:column;gap:10px}\\n    .service-card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 3px 18px rgba(2,22,22,0.04)}\\n    .service-card h3{margin:0 0 6px 0}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:18px}\\n    .myth, .truth{padding:18px;border-radius:10px}\\n    .myth{background:linear-gradient(135deg,#fff3f0,#fff)}\\n    .truth{background:linear-gradient(135deg,#f0fff8,#fff)}\\n    .pillars{display:flex;gap:12px;margin-top:18px}\\n    .pillar{flex:1;padding:14px;border-radius:10px;background:var(--card);text-align:center}\\n    .case{margin-top:18px}\\n    .case .note{background:var(--card);padding:12px;border-radius:10px;margin-bottom:12px}\\n    .faq{margin-top:22px}\\n    .faq details{background:var(--card);padding:12px;border-radius:8px;margin-bottom:10px}\\n    .cta{margin-top:22px;display:flex;justify-content:space-between;align-items:center}\\n    .btn{background:var(--accent-plain);color:white;padding:12px 18px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{margin:40px 0 20px;color:var(--muted);font-size:13px;text-align:center}\\n    @media(max-width:800px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}.pillars{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <!-- inline SVG pattern unique to services page -->\\n  <svg class=\\\"svg-bg\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 800 600\\\" preserveAspectRatio=\\\"xMidYMid slice\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#e6fbf8\\\" />\\n        <stop offset=\\\"1\\\" stop-color=\\\"#eaf7ff\\\" />\\n      </linearGradient>\\n      <pattern id=\\\"dotgrid\\\" width=\\\"120\\\" height=\\\"120\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"120\\\" height=\\\"120\\\" fill=\\\"url(#g1)\\\" />\\n        <circle cx=\\\"10\\\" cy=\\\"10\\\" r=\\\"2\\\" fill=\\\"#c7e9e6\\\" />\\n        <circle cx=\\\"60\\\" cy=\\\"60\\\" r=\\\"2\\\" fill=\\\"#bfe4e0\\\" />\\n        <circle cx=\\\"110\\\" cy=\\\"110\\\" r=\\\"2\\\" fill=\\\"#d6efec\\\" />\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#dotgrid)\\\"/>\\n    <g opacity=\\\"0.6\\\">\\n      <ellipse cx=\\\"200\\\" cy=\\\"120\\\" rx=\\\"220\\\" ry=\\\"80\\\" fill=\\\"#bfeceb\\\" transform=\\\"rotate(-12 200 120)\\\" />\\n      <ellipse cx=\\\"600\\\" cy=\\\"480\\\" rx=\\\"300\\\" ry=\\\"120\\\" fill=\\\"#d7eef6\\\" transform=\\\"rotate(18 600 480)\\\" />\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Boutique</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Therapeutic aromatherapy services designed with safety and clarity in mind</h1>\\n        <p>Guided sessions, personalized blends, and practical protocols for everyday rituals — clinical attention, calm delivery. No medical promises; only supportive aromatic practice.</p>\\n        <div class=\\\"pill\\\">\\n          <div class=\\\"service-card\\\">\\n            <h3>Consultation & Protocol</h3>\\n            <p class=\\\"muted\\\">A 60–90 minute intake to build a tailored approach: scent history, sensitivities, and ritual planning.</p>\\n            <div style=\\\"margin-top:8px\\\"><strong>Format:</strong> virtual or in-person • hybrid model</div>\\n          </div>\\n          <div class=\\\"service-card\\\" style=\\\"margin-top:8px\\\">\\n            <h3>Custom Blend Design</h3>\\n            <p class=\\\"muted\\\">Blends crafted for safe topical use, diffusion, and ritual—paired with dilution guidance and storage notes.</p>\\n          </div>\\n        </div>\\n      </div>\\n      <aside>\\n        <div style=\\\"background:var(--card);padding:18px;border-radius:12px\\\">\\n          <h3 style=\\\"margin-top:0\\\">Book a session</h3>\\n          <p style=\\\"color:var(--muted)\\\">Starts with a conversation. {{PRACTITIONER_NAME}} blends clinical rigor with approachable care.</p>\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <div style=\\\"margin-top:12px;font-size:13px;color:var(--muted)\\\">Call: {{PHONE}} • {{EMAIL}}</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"grid\\\" style=\\\"margin-top:22px\\\">\\n      <div class=\\\"myth service-card\\\">\\n        <h4>Myth</h4>\\n        <p style=\\\"color:var(--muted)\\\">All essential oils are interchangeable and safe at any dose.</p>\\n      </div>\\n      <div class=\\\"truth service-card\\\">\\n        <h4>Truth</h4>\\n        <p style=\\\"color:var(--muted)\\\">Essential oils have distinct chemistry and require context-aware use: dilution, age, and co-exposures matter.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"pillars\\\">\\n      <div class=\\\"pillar\\\">\\n        <strong>Safety-first</strong>\\n        <p style=\\\"color:var(--muted);margin-top:8px\\\">Clear dilution guidelines, pregnancy and pet considerations, and patch testing protocol.</p>\\n      </div>\\n      <div class=\\\"pillar\\\">\\n        <strong>Evidence-aware</strong>\\n        <p style=\\\"color:var(--muted);margin-top:8px\\\">Practices shaped by phytochemistry, inhalation dynamics, and client context.</p>\\n      </div>\\n      <div class=\\\"pillar\\\">\\n        <strong>Ritual-friendly</strong>\\n        <p style=\\\"color:var(--muted);margin-top:8px\\\">Practical blends and steps that integrate into daily life without fuss.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"case\\\">\\n      <h3>Case notes & care narratives</h3>\\n      <div class=\\\"note\\\">\\n        <strong>Client: Evening routine design</strong>\\n        <p style=\\\"color:var(--muted)\\\">Intake identified light sensitivity and a history of skin reactivity. A low-dilution lavender-citrus roll-on and a linen spray were recommended with staged patch testing.</p>\\n      </div>\\n      <div class=\\\"note\\\">\\n        <strong>Client: Workspace clarity protocol</strong>\\n        <p style=\\\"color:var(--muted)\\\">A short inhaler blend using rosemary and lemon (small inhalation protocols) introduced for intermittent focus-support during long desk sessions.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3>Frequently asked questions</h3>\\n      <details>\\n        <summary>How should I dilute essential oils for topical use?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Dilution depends on age and sensitivity. Typical adult dilutions range from 1% (10 drops per 30ml) to 3% for short-term targeted use. Always follow practitioner guidance for children, elders, and specific conditions.</div>\\n      </details>\\n      <details>\\n        <summary>What is a patch test and why do I need one?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">A patch test applies a small diluted amount to the forearm and monitors for 24–48 hours. It helps identify skin reactions before broader use.</div>\\n      </details>\\n      <details>\\n        <summary>Are essential oils safe around pets?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Some oils can be irritating to animals. We provide pet-specific guidance and diffusion limits; when in doubt, keep pets away from diffusers and ventilate spaces.</div>\\n      </details>\\n      <details>\\n        <summary>What about pregnancy and breastfeeding?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Certain oils are best avoided or used only under practitioner supervision during pregnancy and breastfeeding. Safety-first planning is part of our intake process.</div>\\n      </details>\\n    </section>\\n\\n    <div class=\\\"cta\\\">\\n      <div>\\n        <h4 style=\\\"margin:0\\\">Ready to begin?</h4>\\n        <p style=\\\"color:var(--muted);margin:6px 0 0 0\\\">Schedule a consult to get a tailored plan that respects your health landscape.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start a Consultation</a>\\n      </div>\\n    </div>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}} • {{PHONE}} • {{EMAIL}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Blends — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfdfa;--card:#ffffff;--muted:#586969;--accent-1:#cbeef0;--accent-2:#e5f6f7}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;color:#042e31;background:var(--bg)}\\n    .svg-bg{position:fixed;inset:0;pointer-events:none;opacity:0.18}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 36px}\\n    .brand{font-weight:700}\\n    nav a{margin:0 10px;color:#083033;text-decoration:none}\\n    main{max-width:1100px;margin:28px auto;padding:20px}\\n    .intro{background:linear-gradient(180deg,#ffffff, #fbfffe);padding:18px;border-radius:12px}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:16px}\\n    .blend{background:var(--card);padding:14px;border-radius:10px;box-shadow:0 6px 20px rgba(2,18,18,0.04)}\\n    .blend h4{margin:0}\\n    .blend .notes{font-size:13px;color:var(--muted);margin-top:8px}\\n    .label{font-weight:700;color:#086063}\\n    .supports{margin-top:10px;font-size:13px;color:#214d4a}\\n    .disclosure{margin-top:18px;color:var(--muted);font-size:13px}\\n    .faq{margin-top:18px}\\n    .cta{display:flex;justify-content:space-between;align-items:center;margin-top:18px}\\n    .btn{background:#086063;color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    @media(max-width:850px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique svg pattern for blends -->\\n  <svg class=\\\"svg-bg\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 900 600\\\" preserveAspectRatio=\\\"xMidYMid slice\\\">\\n    <defs>\\n      <linearGradient id=\\\"bgG\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#f0fff9\\\" />\\n        <stop offset=\\\"1\\\" stop-color=\\\"#eef9ff\\\" />\\n      </linearGradient>\\n      <pattern id=\\\"wave\\\" width=\\\"240\\\" height=\\\"120\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"240\\\" height=\\\"120\\\" fill=\\\"url(#bgG)\\\" />\\n        <path d=\\\"M0 60 Q60 0 120 60 T240 60 V120 H0 Z\\\" fill=\\\"#dff6f3\\\" opacity=\\\"0.7\\\" />\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#wave)\\\" />\\n    <g opacity=\\\"0.5\\\">\\n      <circle cx=\\\"120\\\" cy=\\\"80\\\" r=\\\"80\\\" fill=\\\"#c7efe9\\\" />\\n      <circle cx=\\\"820\\\" cy=\\\"520\\\" r=\\\"160\\\" fill=\\\"#dff3f6\\\" />\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"shop.html\\\">Shop</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"intro\\\">\\n      <h1>Curated blends — transparent, safe, and ritual-ready</h1>\\n      <p style=\\\"color:var(--muted)\\\">Each blend lists top/middle/base notes, an aroma profile, and a suggested supportive use. These are not medical treatments; they are formulations for aromatherapy practices and daily rituals.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"grid\\\">\\n\\n        <div class=\\\"blend\\\">\\n          <h4>Quiet Eve</h4>\\n          <div class=\\\"notes\\\"><span class=\\\"label\\\">Top:</span> Sweet Orange • <span class=\\\"label\\\">Middle:</span> Lavender<br><span class=\\\"label\\\">Base:</span> Vetiver</div>\\n          <div class=\\\"notes\\\">Aroma: soft citrus with warm herbal depth</div>\\n          <div class=\\\"supports\\\">Supports: evening winding-down rituals and restful ambiance when used as a linen spray or low-dilution roll-on.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <h4>Citrus Clarity</h4>\\n          <div class=\\\"notes\\\"><span class=\\\"label\\\">Top:</span> Lemon • <span class=\\\"label\\\">Middle:</span> Rosemary<br><span class=\\\"label\\\">Base:</span> Atlas Cedar</div>\\n          <div class=\\\"notes\\\">Aroma: bright, herbaceous, grounding cedar undertone</div>\\n          <div class=\\\"supports\\\">Supports: focused workspace inhalation protocols (intermittent, short durations).</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <h4>Forest Ground</h4>\\n          <div class=\\\"notes\\\"><span class=\\\"label\\\">Top:</span> Bergamot • <span class=\\\"label\\\">Middle:</span> Pine<br><span class=\\\"label\\\">Base:</span> Sandalwood</div>\\n          <div class=\\\"notes\\\">Aroma: resinous, clean evergreen with soft sweetness</div>\\n          <div class=\\\"supports\\\">Supports: grounding rituals and contemplative inhalation sequences.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <h4>Gentle Cling</h4>\\n          <div class=\\\"notes\\\"><span class=\\\"label\\\">Top:</span> Mandarin • <span class=\\\"label\\\">Middle:</span> Geranium<br><span class=\\\"label\\\">Base:</span> Benzoin</div>\\n          <div class=\\\"notes\\\">Aroma: floral-citrus with warm balsamic base</div>\\n          <div class=\\\"supports\\\">Supports: hug-friendly personal roll-on for mood-lifting moments (low dilution recommended).</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <h4>Cool Respire (non-medical)</h4>\\n          <div class=\\\"notes\\\"><span class=\\\"label\\\">Top:</span> Eucalyptus (small amounts) • <span class=\\\"label\\\">Middle:</span> Lavender<br><span class=\\\"label\\\">Base:</span> Fractionated Coconut Oil (carrier)</div>\\n          <div class=\\\"notes\\\">Aroma: fresh camphoraceous note balanced by floral calm</div>\\n          <div class=\\\"supports\\\">Supports: transient inhalation for perceived comfort in stuffy spaces; use minimal amounts and keep away from children and pets.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <h4>Sunrise Ease</h4>\\n          <div class=\\\"notes\\\"><span class=\\\"label\\\">Top:</span> Grapefruit • <span class=\\\"label\\\">Middle:</span> Neroli<br><span class=\\\"label\\\">Base:</span> Amber</div>\\n          <div class=\\\"notes\\\">Aroma: bright citrus floral with warm amber grounding</div>\\n          <div class=\\\"supports\\\">Supports: morning ritual diffusion to frame a calm start to the day.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <h4>Mending Hearth</h4>\\n          <div class=\\\"notes\\\"><span class=\\\"label\\\">Top:</span> Clove (low) • <span class=\\\"label\\\">Middle:</span> Cinnamon Bark (low)<br><span class=\\\"label\\\">Base:</span> Sweet Orange</div>\\n          <div class=\\\"notes\\\">Aroma: cozy spice softened by sweet citrus; use conservative spice levels.</div>\\n          <div class=\\\"supports\\\">Supports: seasonal comfort blends for diffusion or short-room fragrance; not for topical use at high concentrations.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <h4>Clear Tide</h4>\\n          <div class=\\\"notes\\\"><span class=\\\"label\\\">Top:</span> Spearmint • <span class=\\\"label\\\">Middle:</span> Lavender<br><span class=\\\"label\\\">Base:</span> White Fir</div>\\n          <div class=\\\"notes\\\">Aroma: cool mint with floral and forest notes</div>\\n          <div class=\\\"supports\\\">Supports: situational inhaler to reduce sensory fatigue in long shifts; short, mindful inhalations only.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <h4>Evening Hearth</h4>\\n          <div class=\\\"notes\\\"><span class=\\\"label\\\">Top:</span> Sweet Marjoram • <span class=\\\"label\\\">Middle:</span> Lavender<br><span class=\\\"label\\\">Base:</span> Patchouli</div>\\n          <div class=\\\"notes\\\">Aroma: warm herbal with earthy base notes</div>\\n          <div class=\\\"supports\\\">Supports: supportive ritual for settling into evening practices; low topical dilution suggested.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <h4>Bright Pocket</h4>\\n          <div class=\\\"notes\\\"><span class=\\\"label\\\">Top:</span> Bergamot • <span class=\\\"label\\\">Middle:</span> Litsea Cubeba<br><span class=\\\"label\\\">Base:</span> Ambrette Seed</div>\\n          <div class=\\\"notes\\\">Aroma: effervescent citrus-lift with a powdery base</div>\\n          <div class=\\\"supports\\\">Supports: portable inhaler blend for brief pace resets and mood support.</div>\\n        </div>\\n\\n      </div>\\n\\n      <div class=\\\"disclosure\\\">All blends are formulated with safety considerations. See labeling for contraindications: pregnancy, pets, and pediatric guidance. Follow dilution and patch test instructions before topical application.</div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3 style=\\\"margin-top:18px\\\">Common questions about blends</h3>\\n      <details>\\n        <summary>How much of an essential oil is in a blend?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Each finished product includes a recommended dilution. For custom blends we typically specify 1%–3% for adults, and lower for sensitive individuals. Exact percentages are listed per product or provided in consultation.</div>\\n      </details>\\n      <details>\\n        <summary>Do I need to do a patch test?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Yes. Apply a small diluted amount on the inner forearm and observe for 24–48 hours. If irritation occurs, discontinue.</div>\\n      </details>\\n      <details>\\n        <summary>Are these blends pet-safe?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Not all blends are pet-friendly. Keep diffusers out of reach, ventilate rooms, and consult the specific product notes; we provide pet-specific guidance with purchases.</div>\\n      </details>\\n      <details>\\n        <summary>What about pregnancy?</summary>\\n        <div style=\\\"color:var(--muted);margin-top:8px\\\">Several oils are best avoided in pregnancy. We flag such oils and provide alternative formulations for pregnancy or breastfeeding clients.</div>\\n      </details>\\n    </section>\\n\\n    <div class=\\\"cta\\\">\\n      <div style=\\\"color:var(--muted)\\\">Prefer a tailored blend? Book a one-on-one blend design session with {{PRACTITIONER_NAME}}.</div>\\n      <a class=\\\"btn\\\" href=\\\"services.html\\\">Request a Custom Blend</a>\\n    </div>\\n\\n    <footer style=\\\"margin-top:28px;color:var(--muted);text-align:center\\\">© {{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • {{EMAIL}}</footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Boutique — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#ffffff;--muted:#5b6d6d;--card:#ffffff;--accent:#7ab8c8}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#fbfffe,#ffffff)}\\n    .svg-bg{position:fixed;inset:0;pointer-events:none;opacity:0.14}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 24px}\\n    nav a{margin:0 8px;color:#073033;text-decoration:none;font-weight:600}\\n    main{max-width:1100px;margin:28px auto;padding:20px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\\n    .product{background:var(--card);padding:16px;border-radius:12px;border:1px solid rgba(2,20,20,0.04)}\\n    .product h4{margin:0 0 8px 0}\\n    .meta{color:var(--muted);font-size:13px}\\n    .price{font-weight:800;color:#0b4d4b;margin-top:8px}\\n    .buy{margin-top:12px}\\n    .btn{background:var(--accent);color:white;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .info{margin-top:18px;color:var(--muted);font-size:13px}\\n    @media(max-width:1000px){.grid{grid-template-columns:repeat(2,1fr)}}\\n    @media(max-width:640px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- boutique svg pattern unique to shop page -->\\n  <svg class=\\\"svg-bg\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 1000 700\\\" preserveAspectRatio=\\\"xMidYMid slice\\\">\\n    <defs>\\n      <linearGradient id=\\\"s1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#f1fbfa\\\" />\\n        <stop offset=\\\"1\\\" stop-color=\\\"#eef8ff\\\" />\\n      </linearGradient>\\n      <pattern id=\\\"leaf\\\" width=\\\"160\\\" height=\\\"160\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"160\\\" height=\\\"160\\\" fill=\\\"url(#s1)\\\" />\\n        <path d=\\\"M10 140 C40 100 120 20 150 10\\\" stroke=\\\"#d9f0ef\\\" stroke-width=\\\"6\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#leaf)\\\" />\\n    <g opacity=\\\"0.45\\\">\\n      <ellipse cx=\\\"200\\\" cy=\\\"600\\\" rx=\\\"280\\\" ry=\\\"120\\\" fill=\\\"#dff2f0\\\" />\\n      <ellipse cx=\\\"800\\\" cy=\\\"80\\\" rx=\\\"220\\\" ry=\\\"80\\\" fill=\\\"#e6f7f5\\\" />\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Local</a>\\n      <a href=\\\"services.html\\\">Sessions</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section>\\n      <h1>Shop — thoughtfully packaged aromatherapy\\n      </h1>\\n      <p style=\\\"color:var(--muted)\\\">A curated selection: starter kits, roll-ons, and low-emission diffusers. All products include safety labeling and dilution guidance. No health claims are made about these items.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"grid\\\">\\n      <div class=\\\"product\\\">\\n        <h4>Starter Ritual Kit</h4>\\n        <div class=\\\"meta\\\">Includes: 10ml carrier, 3 sample-inspired single-blend vials, linen spray bottle, printed protocol card</div>\\n        <div class=\\\"price\\\">$48</div>\\n        <div class=\\\"buy\\\"><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <h4>Calm Pocket Roll-On (10ml)</h4>\\n        <div class=\\\"meta\\\">Low dilution roll-on with Lavender, Sweet Orange, and Fractionated Coconut Oil. Patch test recommended.</div>\\n        <div class=\\\"price\\\">$18</div>\\n        <div class=\\\"buy\\\"><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <h4>Focus Pocket Roll-On (10ml)</h4>\\n        <div class=\\\"meta\\\">Citrus-herbal blend in 2% dilution for adult use; keep away from young children and pets.</div>\\n        <div class=\\\"price\\\">$18</div>\\n        <div class=\\\"buy\\\"><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <h4>Diffuse: Minimal Mist Diffuser</h4>\\n        <div class=\\\"meta\\\">Ultrasonic low-noise diffuser. Timer settings and 120ml reservoir. Use recommended dilution for room diffusion and ventilate.</div>\\n        <div class=\\\"price\\\">$64</div>\\n        <div class=\\\"buy\\\"><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <h4>Travel Inhaler Set</h4>\\n        <div class=\\\"meta\\\">Three inhalers prefilled with micro-doses of blends: Bright Pocket, Quiet Eve, Clear Tide. Portable, personal inhalation only.</div>\\n        <div class=\\\"price\\\">$26</div>\\n        <div class=\\\"buy\\\"><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <h4>Seasonal Warmth Blend (15ml)</h4>\\n        <div class=\\\"meta\\\">Cozy spice-forward blend with clear labeling for dilution and topical cautions.</div>\\n        <div class=\\\"price\\\">$22</div>\\n        <div class=\\\"buy\\\"><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n      </div>\\n\\n    </section>\\n\\n    <section class=\\\"info\\\">\\n      <h3 style=\\\"margin-top:18px\\\">Safety & usage notes</h3>\\n      <ul style=\\\"color:var(--muted)\\\">\\n        <li>Dilution instructions included with each topical product. For adults, common dilutions are 1%–3% unless otherwise specified.</li>\\n        <li>Perform a patch test for topical products: apply a small amount to the inner forearm and monitor for 24–48 hours.</li>\\n        <li>Keep essential oils out of reach of children. Some oils can be harmful to pets; see product pages for pet guidance.</li>\\n        <li>Pregnant and breastfeeding clients should consult with the practitioner before using new oils.</li>\\n      </ul>\\n    </section>\\n\\n    <div style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div style=\\\"color:var(--muted)\\\">Prefer a custom kit? Book a design session to build a kit suited to your needs.</div>\\n      <a class=\\\"btn\\\" href=\\\"services.html\\\">Design a Kit</a>\\n    </div>\\n\\n    <footer style=\\\"margin-top:28px;color:var(--muted);text-align:center\\\">{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • {{EMAIL}}</footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
