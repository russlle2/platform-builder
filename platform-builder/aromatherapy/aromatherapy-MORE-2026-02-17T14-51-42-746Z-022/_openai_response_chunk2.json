          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Offerings — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Gentle scent programs and practical rituals that may support everyday calm. Safety-forward aromatherapy offerings.\\\" />\\n  <style>\\n    :root{--bg:#FBFAF7;--ink:#2b2b2b;--muted:#6b6b6b;--accent:#6b8a6f;--card:#ffffff;--glass:rgba(255,255,255,0.6)}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased}\\n    .pattern{background-image:url(\\\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200' viewBox='0 0 200 200'><defs><linearGradient id='g' x1='0' x2='1'><stop offset='0' stop-color='%236b8a6f' stop-opacity='0.08'/><stop offset='1' stop-color='%23b6d3b8' stop-opacity='0.04'/></linearGradient></defs><rect width='200' height='200' fill='url(%23g)'/><g fill='%236b8a6f' fill-opacity='0.06'><circle cx='20' cy='20' r='6'/><circle cx='100' cy='100' r='10'/><circle cx='180' cy='60' r='5'/><rect x='60' y='140' width='10' height='10' rx='2'/></g></svg>\\\");background-size:400px}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px;background:linear-gradient(180deg,rgba(255,255,255,0.9),transparent);position:sticky;top:0;backdrop-filter:blur(4px);z-index:30}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:44px;height:44;border-radius:8px;background:linear-gradient(135deg,var(--accent),#9fbf9c);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .hero{padding:48px 28px;display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    .card{background:var(--card);border-radius:12px;padding:22px;box-shadow:0 6px 22px rgba(20,30,20,0.05)}\\n    h1{margin:0 0 10px;font-size:28px}\\n    p.lead{margin:0 0 16px;color:var(--muted)}\\n    .cta{display:inline-block;padding:10px 16px;border-radius:8px;background:var(--accent);color:#fff;text-decoration:none;font-weight:700}\\n    .small{font-size:13px;color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;margin-top:18px}\\n    .package{padding:18px;border-radius:10px;background:linear-gradient(180deg,var(--glass),transparent);border:1px solid rgba(0,0,0,0.03)}\\n    .price{font-weight:800;font-size:18px;color:var(--ink)}\\n    footer{padding:24px 28px;color:var(--muted);font-size:13px}\\n    .micro{display:flex;flex-direction:column;gap:10px}\\n    .micro li{background:#fff;padding:10px;border-radius:8px}\\n    .testimonials{margin-top:18px;display:flex;gap:16px;align-items:center}\\n    .test-card{flex:1;padding:14px;border-radius:8px;background:linear-gradient(180deg,#fff, #fbfdf9);border:1px solid rgba(0,0,0,0.04)}\\n    .badges{display:flex;gap:10px;align-items:center}\\n    .badge{display:inline-flex;padding:8px;border-radius:8px;background:rgba(107,138,111,0.08);cursor:default}\\n    .tooltip{position:relative}\\n    .tooltip:hover::after{content:attr(data-tip);position:absolute;left:50%;transform:translateX(-50%);bottom:calc(100% + 8px);background:#222;color:#fff;padding:8px;border-radius:6px;font-size:12px;white-space:nowrap}\\n    .controls{display:flex;gap:8px;align-items:center}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.brand{gap:8px}}\\n  </style>\\n</head>\\n<body class=\\\"pattern\\\">\\n  <header class=\\\"card\\\">\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Formulas</a>\\n      <a href=\\\"shop.html\\\">Boutique</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <div class=\\\"card\\\">\\n          <h1>Thoughtful scent services that may support daily ease</h1>\\n          <p class=\\\"lead\\\">Work with a scent practitioner to build simple rituals and blends that fit your days. Sessions emphasize safety, dilution guidance, and practical tools to use at home.</p>\\n          <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n            <div class=\\\"small\\\">Or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n          </div>\\n\\n          <div class=\\\"grid\\\" style=\\\"margin-top:18px\\\">\\n            <div class=\\\"package\\\">\\n              <div style=\\\"font-weight:700\\\">Signature Guidance</div>\\n              <div class=\\\"small\\\">60 min virtual or in-person consult. Personalized ecost\\\\n-friendly blends and an at-home plan.</div>\\n              <div style=\\\"margin-top:12px\\\" class=\\\"price\\\">$120</div>\\n              <div style=\\\"margin-top:10px\\\" class=\\\"small\\\">Includes written dilution and patch-test guide.</div>\\n            </div>\\n            <div class=\\\"package\\\">\\n              <div style=\\\"font-weight:700\\\">Mini Reset</div>\\n              <div class=\\\"small\\\">30 min focused session for a specific routine or event.</div>\\n              <div style=\\\"margin-top:12px\\\" class=\\\"price\\\">$65</div>\\n            </div>\\n            <div class=\\\"package\\\">\\n              <div style=\\\"font-weight:700\\\">Care Kit Add-On</div>\\n              <div class=\\\"small\\\">Pre-blended vial set and ritual notes shipped to your door.</div>\\n              <div style=\\\"margin-top:12px\\\" class=\\\"price\\\">$48</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">A quick scent check (diagnostic)</h3>\\n          <p class=\\\"small\\\">Short intake to understand scent preferences, sensitivities, and household considerations (pets, pregnancy, skin sensitivity). This shapes safe suggestions you can try at home.</p>\\n          <ul style=\\\"margin:12px 0 0;padding-left:18px;color:var(--muted)\\\">\\n            <li>We use \\\"may support\\\" language — not medical claims.</li>\\n            <li>Every plan includes dilution ratios and patch testing steps.</li>\\n            <li>Recommendations take pets and pregnancy into account.</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h3 style=\\\"margin:0 0 10px\\\">Small practices you can try</h3>\\n          <ol class=\\\"micro\\\" style=\\\"margin:0;padding-left:18px\\\">\\n            <li><strong>Two-breath pause</strong> — a 2 inhale/2 exhale scent cue at transition points.</li>\\n            <li><strong>Shift bottle</strong> — a 5% roll-on to keep in a bag for moments you want gentle focus.</li>\\n            <li><strong>Evening veil</strong> — a diluted mist in the bedroom (avoid near infants and pets).</li>\\n          </ol>\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <div style=\\\"display:flex;flex-direction:column;gap:12px\\\">\\n          <div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Next step</div>\\n            <div style=\\\"font-weight:700;margin-top:6px\\\">Schedule a scent consult</div>\\n            <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">A single consult can leave you with a wearable formula and a short routine to try for 2 weeks.</div>\\n            <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve a session</a></div>\\n          </div>\\n\\n          <div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Proof gallery</div>\\n            <div class=\\\"testimonials\\\">\\n              <div class=\\\"test-card\\\" id=\\\"testimonial\\\">\\\"Short, practical guidance — I actually used it every day.\\\" <div style=\\\"font-size:12px;color:var(--muted);margin-top:8px\\\">— Nora, client</div></div>\\n              <div style=\\\"width:86px;display:flex;flex-direction:column;gap:8px;align-items:flex-end\\\">\\n                <div class=\\\"badges\\\">\\n                  <div class=\\\"badge tooltip\\\" data-tip=\\\"Local small-business award 2024\\\">🏆</div>\\n                  <div class=\\\"badge tooltip\\\" data-tip=\\\"Certified safety checklist applied\\\">✔️</div>\\n                </div>\\n                <div class=\\\"controls\\\">\\n                  <button id=\\\"prev\\\" style=\\\"padding:8px;border-radius:8px\\\">◀</button>\\n                  <button id=\\\"next\\\" style=\\\"padding:8px;border-radius:8px\\\">▶</button>\\n                </div>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Contact</div>\\n            <div style=\\\"font-weight:700;margin-top:6px\\\">Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n            <div class=\\\"small\\\">Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n          </div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"padding:18px 28px\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin:0 0 10px\\\">Pricing & framing</h3>\\n        <p class=\\\"small\\\">Pricing is listed per session. Craft items and kits are presented as add-ons when appropriate. Subscriptions are not required — think of each booking as a focused, practical meeting that leaves you with usable formulas.</p>\\n        <div style=\\\"margin-top:14px;display:flex;gap:12px;align-items:center\\\">\\n          <a href=\\\"shop.html\\\" class=\\\"cta\\\">Explore care kits</a>\\n          <div class=\\\"small\\\">or <a href=\\\"contact.html\\\">ask a question</a></div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"padding:18px 28px\\\">\\n      <div class=\\\"card\\\">\\n        <h3>Frequently asked safety notes</h3>\\n        <ul style=\\\"margin:12px 0 0;padding-left:18px;color:var(--muted)\\\">\\n          <li><strong>Dilution:</strong> We recommend carrier oils and dilution percentages appropriate for topical or aromatic use. Typical roll-ons are 3–5% for adults unless otherwise advised.</li>\\n          <li><strong>Patch test:</strong> Always perform a patch test on forearm skin when using a new blend; discontinue if irritation occurs.</li>\\n          <li><strong>Pets:</strong> Some essential oils can affect animals. Tell us about household pets so we can give pet-safe suggestions.</li>\\n          <li><strong>Pregnancy & nursing:</strong> If pregnant or nursing, consult your healthcare provider. We avoid certain botanicals and offer alternatives.</li>\\n        </ul>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px\\\">\\n      <div>&copy; <span id=\\\"year\\\"></span> {{BUSINESS_NAME}} — gentle, practical scent guidance</div>\\n      <div class=\\\"small\\\">Made with care in {{CITY}}, {{STATE}}</div>\\n    </div>\\n  </footer>\\n\\n  <script>\\n    (function(){\\n      document.getElementById('year').textContent=new Date().getFullYear();\\n      const testimonials=[\\n        {text:'\\\"Short, practical guidance — I actually used it every day.\\\" — Nora'},\\n        {text:'\\\"A clear plan and a small kit I could start the same week.\\\" — Amir'},\\n        {text:'\\\"Thoughtful about pets and kids — that mattered.\\\" — Lucia'}\\n      ];\\n      let idx=0, el=document.getElementById('testimonial');\\n      function show(){ el.textContent=testimonials[idx].text + (testimonials[idx].text.includes('—')? '':''); }\\n      function next(){ idx=(idx+1)%testimonials.length; show(); }\\n      function prev(){ idx=(idx-1+testimonials.length)%testimonials.length; show(); }\\n      document.getElementById('next').addEventListener('click',next);\\n      document.getElementById('prev').addEventListener('click',prev);\\n      show();\\n      setInterval(next,5000);\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Formulas — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Interactive aroma wheel and approachable formulas. Learn top, middle, and base notes and how to pair them safely.\\\" />\\n  <style>\\n    :root{--bg:#fff;--ink:#222;--muted:#6b6b6b;--accent:#7a9f7a;--card:#fcfff9}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;color:var(--ink);background:linear-gradient(180deg,#f7faf5, #ffffff)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 24px;background:transparent}\\n    .logo{width:42px;height:42;border-radius:10px;background:linear-gradient(135deg,var(--accent),#b4d6b4);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .wrap{max-width:1100px;margin:18px auto;padding:0 20px}\\n    .intro{display:flex;gap:18px;align-items:flex-start}\\n    .panel{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 8px 26px rgba(30,40,20,0.04)}\\n    .wheel{width:420px;height:420px;display:block;margin:6px auto}\\n    .note-info{padding:12px}\\n    .notes-list{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:14px}\\n    .notes-list div{background:#fff;padding:12px;border-radius:8px}\\n    .legend{font-size:12px;color:var(--muted)}\\n    .cta{display:inline-block;padding:10px 14px;border-radius:9px;background:var(--accent);color:#fff;text-decoration:none;font-weight:700}\\n    footer{padding:28px 20px;color:var(--muted);font-size:13px}\\n    @media(max-width:880px){.intro{flex-direction:column;align-items:center}.notes-list{grid-template-columns:1fr}.wheel{width:320px;height:320px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Formulas</a>\\n      <a href=\\\"shop.html\\\">Boutique</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"intro\\\">\\n      <div style=\\\"flex:1\\\">\\n        <div class=\\\"panel\\\">\\n          <h1 style=\\\"margin:0 0 8px\\\">A hands-on aroma wheel</h1>\\n          <p class=\\\"legend\\\">Hover or tap each segment to see a short description. A balanced blend often combines top, middle, and base notes. Tips show safe dilution and household considerations.</p>\\n          <div style=\\\"margin-top:12px\\\" id=\\\"selection\\\" class=\\\"note-info\\\">Hover a note to begin — we'll show examples and a quick safety tip.</div>\\n          <div style=\\\"margin-top:12px;display:flex;gap:8px\\\">\\n            <a class=\\\"cta\\\" href=\\\"book.html\\\">Book a formula session</a>\\n            <a href=\\\"shop.html\\\" style=\\\"margin-left:8px;color:var(--muted);text-decoration:underline\\\">Shop blends</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">Sample pairings</h3>\\n          <div class=\\\"notes-list\\\">\\n            <div><strong>Fresh Wake</strong><div class=\\\"legend\\\">Lemon (top) + Lavender (middle) + Vetiver (base). Use a 2–3% diffuser or 3% roll-on for adults.</div></div>\\n            <div><strong>Evening Ease</strong><div class=\\\"legend\\\">Sweet orange (top) + Roman chamomile (middle) + Sandalwood (base). Avoid near infants; consult for pregnancy-safe alternatives.</div></div>\\n            <div><strong>Focused Breath</strong><div class=\\\"legend\\\">Peppermint (top) + Rosemary (middle) + Cedarwood (base). Short inhalations suggested; patch-test before topical use.</div></div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside style=\\\"width:460px\\\">\\n        <div class=\\\"panel\\\" style=\\\"text-align:center\\\">\\n          <svg class=\\\"wheel\\\" viewBox=\\\"0 0 420 420\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" id=\\\"aromaWheel\\\">\\n            <defs>\\n              <linearGradient id=\\\"gTop\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#f9e7d2\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#ffd9b3\\\"/></linearGradient>\\n              <linearGradient id=\\\"gMid\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#e9f5e9\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#cfead0\\\"/></linearGradient>\\n              <linearGradient id=\\\"gBase\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#e8eef7\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#ccd9f0\\\"/></linearGradient>\\n            </defs>\\n            <g transform=\\\"translate(210,210)\\\">\\n              <!-- Top ring (outer) -->\\n              <g id=\\\"topRing\\\">\\n                <path data-note=\\\"Lemon\\\" d=\\\"M0,-200 A200,200 0 0,1 173.205,-100 L130,-75 A150,150 0 0,0 0,-150 Z\\\" fill=\\\"url(#gTop)\\\" stroke=\\\"#ffffff\\\" stroke-width=\\\"1\\\"></path>\\n                <path data-note=\\\"Bergamot\\\" d=\\\"M173.205,-100 A200,200 0 0,1 173.205,100 L130,75 A150,150 0 0,0 130,-75 Z\\\" fill=\\\"url(#gTop)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n                <path data-note=\\\"Peppermint\\\" d=\\\"M173.205,100 A200,200 0 0,1 0,200 L0,150 A150,150 0 0,0 130,75 Z\\\" fill=\\\"url(#gTop)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n                <path data-note=\\\"Grapefruit\\\" d=\\\"M0,200 A200,200 0 0,1 -173.205,100 L-130,75 A150,150 0 0,0 0,150 Z\\\" fill=\\\"url(#gTop)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n                <path data-note=\\\"Orange\\\" d=\\\"M-173.205,100 A200,200 0 0,1 -173.205,-100 L-130,-75 A150,150 0 0,0 -130,75 Z\\\" fill=\\\"url(#gTop)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n                <path data-note=\\\"Lime\\\" d=\\\"M-173.205,-100 A200,200 0 0,1 0,-200 L0,-150 A150,150 0 0,0 -130,-75 Z\\\" fill=\\\"url(#gTop)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n              </g>\\n              <!-- Middle ring -->\\n              <g id=\\\"midRing\\\">\\n                <path data-note=\\\"Lavender\\\" d=\\\"M0,-150 A150,150 0 0,1 103.5,-60 L77.6,-45 A100,100 0 0,0 0,-100 Z\\\" fill=\\\"url(#gMid)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n                <path data-note=\\\"Chamomile\\\" d=\\\"M103.5,-60 A150,150 0 0,1 103.5,60 L77.6,45 A100,100 0 0,0 77.6,-45 Z\\\" fill=\\\"url(#gMid)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n                <path data-note=\\\"Rosemary\\\" d=\\\"M103.5,60 A150,150 0 0,1 0,150 L0,100 A100,100 0 0,0 77.6,45 Z\\\" fill=\\\"url(#gMid)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n                <path data-note=\\\"Geranium\\\" d=\\\"M0,150 A150,150 0 0,1 -103.5,60 L-77.6,45 A100,100 0 0,0 0,100 Z\\\" fill=\\\"url(#gMid)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n                <path data-note=\\\"Ylang Ylang\\\" d=\\\"M-103.5,60 A150,150 0 0,1 -103.5,-60 L-77.6,-45 A100,100 0 0,0 -77.6,45 Z\\\" fill=\\\"url(#gMid)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n                <path data-note=\\\"Clary Sage\\\" d=\\\"M-103.5,-60 A150,150 0 0,1 0,-150 L0,-100 A100,100 0 0,0 -77.6,-45 Z\\\" fill=\\\"url(#gMid)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n              </g>\\n              <!-- Base ring -->\\n              <g id=\\\"baseRing\\\">\\n                <path data-note=\\\"Vetiver\\\" d=\\\"M0,-100 A100,100 0 0,1 69,-40 L51.8,-30 A50,50 0 0,0 0,-50 Z\\\" fill=\\\"url(#gBase)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n                <path data-note=\\\"Sandalwood\\\" d=\\\"M69,-40 A100,100 0 0,1 69,40 L51.8,30 A50,50 0 0,0 51.8,-30 Z\\\" fill=\\\"url(#gBase)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n                <path data-note=\\\"Cedarwood\\\" d=\\\"M69,40 A100,100 0 0,1 0,100 L0,50 A50,50 0 0,0 51.8,30 Z\\\" fill=\\\"url(#gBase)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n                <path data-note=\\\"Patchouli\\\" d=\\\"M0,100 A100,100 0 0,1 -69,40 L-51.8,30 A50,50 0 0,0 0,50 Z\\\" fill=\\\"url(#gBase)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n                <path data-note=\\\"Frankincense\\\" d=\\\"M-69,40 A100,100 0 0,1 -69,-40 L-51.8,-30 A50,50 0 0,0 -51.8,30 Z\\\" fill=\\\"url(#gBase)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n                <path data-note=\\\"Ambrette\\\" d=\\\"M-69,-40 A100,100 0 0,1 0,-100 L0,-50 A50,50 0 0,0 -51.8,-30 Z\\\" fill=\\\"url(#gBase)\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1\\\"></path>\\n              </g>\\n              <circle r=\\\"30\\\" fill=\\\"#fff\\\" stroke=\\\"#e6e6e6\\\"/>\\n              <text y=\\\"6\\\" text-anchor=\\\"middle\\\" style=\\\"font-size:12px;fill:#6b6b6b\\\">Aroma Wheel</text>\\n            </g>\\n          </svg>\\n\\n          <div class=\\\"legend\\\" style=\\\"margin-top:10px\\\">Tap a segment to pin the note; select one from each ring to see a suggested blend.</div>\\n          <div style=\\\"margin-top:10px;display:flex;gap:8px;justify-content:center\\\">\\n            <button id=\\\"clear\\\" style=\\\"padding:8px 10px;border-radius:8px\\\">Clear</button>\\n            <button id=\\\"recommend\\\" style=\\\"padding:8px 10px;border-radius:8px;background:var(--accent);color:#fff\\\">Recommend</button>\\n          </div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"panel\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">Selected notes</h3>\\n        <div id=\\\"chosen\\\" style=\\\"display:flex;gap:10px;flex-wrap:wrap\\\"></div>\\n        <div id=\\\"blendSuggestion\\\" style=\\\"margin-top:12px;color:var(--muted)\\\">Pick a top, middle, and base for a suggestion.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"panel\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">Safety reminders</h3>\\n        <ul style=\\\"color:var(--muted)\\\">\\n          <li>Always dilute essential oils; avoid strong undiluted skin contact.</li>\\n          <li>Perform a patch test before topical use and consult a provider if pregnant.</li>\\n          <li>Be mindful of pets; some oils may not be safe for animals.</li>\\n        </ul>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:1100px;margin:18px auto;padding:0 20px;color:var(--muted);font-size:13px\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>.</div>\\n  </footer>\\n\\n  <script>\\n    (function(){\\n      const wheel = document.getElementById('aromaWheel');\\n      const chosen = document.getElementById('chosen');\\n      const display = document.getElementById('selection');\\n      const blendOutput = document.getElementById('blendSuggestion');\\n      const picks = {top:null,middle:null,base:null};\\n\\n      function ringOf(el){\\n        const parent = el.parentNode;\\n        if(parent.id==='topRing') return 'top';\\n        if(parent.id==='midRing') return 'middle';\\n        if(parent.id==='baseRing') return 'base';\\n        return null;\\n      }\\n\\n      wheel.querySelectorAll('path').forEach(p=>{\\n        p.style.cursor='pointer';\\n        p.addEventListener('mouseenter',()=>{\\n          display.textContent = p.getAttribute('data-note') + ' — ' + tipFor(p.getAttribute('data-note'));\\n        });\\n        p.addEventListener('mouseleave',()=>{ display.textContent='Hover or tap each segment to see a short description.' });\\n        p.addEventListener('click',()=>{\\n          const note=p.getAttribute('data-note');\\n          const ring=ringOf(p);\\n          if(!ring) return;\\n          picks[ring]=note;\\n          refreshChosen();\\n        });\\n      });\\n\\n      function tipFor(n){\\n        const tips={\\n          'Lemon':'Citrus top note; phototoxicity possible — avoid fresh sun exposure on skin after topical use.',\\n          'Peppermint':'Stimulating top note; short inhalations recommended for focus.',\\n          'Lavender':'Versatile middle note; often tolerated well but patch test is wise.',\\n          'Chamomile':'Gentle middle note; good for sensitive skin blends but avoid if allergic to Asteraceae.',\\n          'Vetiver':'Grounding base note; slow to evaporate and anchors a formula.',\\n          'Sandalwood':'Warm base note; long-lasting, use in lower percentages for topical use.'\\n        };\\n        return tips[n] || 'A classic aromatic note; check dilution and home safety.';\\n      }\\n\\n      function refreshChosen(){\\n        chosen.innerHTML='';\\n        ['top','middle','base'].forEach(k=>{\\n          const v=picks[k];\\n          const el=document.createElement('div');\\n          el.style.padding='8px 12px'; el.style.background='#fff'; el.style.borderRadius='8px'; el.style.boxShadow='0 2px 8px rgba(0,0,0,0.04)';\\n          el.textContent=(k.charAt(0).toUpperCase()+k.slice(1))+': ' + (v||'—');\\n          chosen.appendChild(el);\\n        });\\n        updateBlendText();\\n      }\\n\\n      function updateBlendText(){\\n        if(picks.top && picks.middle && picks.base){\\n          blendOutput.textContent = `Suggested blend: ${picks.top} (top) + ${picks.middle} (middle) + ${picks.base} (base). Try 2–3 drops of top, 2 drops middle, 1–2 drops base per 10 ml carrier for a gentle 2–3% dilution. Patch test before topical use.`;\\n        } else {\\n          blendOutput.textContent = 'Pick one from each ring (top, middle, base) to receive a suggested dilution and a quick safety prompt.';\\n        }\\n      }\\n\\n      document.getElementById('clear').addEventListener('click',()=>{ picks.top=picks.middle=picks.base=null; refreshChosen(); });\\n      document.getElementById('recommend').addEventListener('click',()=>{\\n        if(!(picks.top && picks.middle && picks.base)){ alert('Please choose a top, middle, and base note first.'); return; }\\n        alert('Recommendation saved to a printable note. Use dilute blends responsibly; check pets/pregnancy notes.');\\n      });\\n\\n      refreshChosen();\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Boutique — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Care kits, roll-ons, and pre-blended vials that may support simple rituals. Safety guidance included with every item.\\\" />\\n  <style>\\n    :root{--bg:#f8faf6;--ink:#222;--muted:#6b6b6b;--accent:#6b8a6f}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;background:var(--bg);color:var(--ink)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 24px}\\n    .logo{width:42px;height:42;border-radius:10px;background:linear-gradient(135deg,var(--accent),#b6d3b8);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .wrap{max-width:1100px;margin:16px auto;padding:0 20px}\\n    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}\\n    .card{background:#fff;padding:14px;border-radius:12px;border:1px solid rgba(0,0,0,0.04)}\\n    .price{font-weight:800}\\n    .add{background:var(--accent);color:#fff;padding:8px 10px;border-radius:8px;border:none}\\n    .cart{position:fixed;right:18px;bottom:18px;background:var(--accent);color:#fff;padding:12px 16px;border-radius:12px;box-shadow:0 8px 30px rgba(50,70,50,0.14)}\\n    .badge-row{display:flex;gap:8px;margin-top:10px}\\n    .badge{padding:6px 8px;border-radius:8px;background:rgba(107,138,111,0.08);font-size:13px}\\n    .test-rotator{margin-top:18px;padding:12px;border-radius:10px;background:#fff;border:1px solid rgba(0,0,0,0.04)}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Formulas</a>\\n      <a href=\\\"shop.html\\\">Boutique</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section style=\\\"display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:12px\\\">\\n      <div>\\n        <h1 style=\\\"margin:0\\\">Boutique</h1>\\n        <div style=\\\"color:var(--muted);font-size:13px\\\">Care kits and ready blends intended for everyday use; safety notes included with each purchase.</div>\\n      </div>\\n      <div style=\\\"display:flex;gap:8px;align-items:center\\\">\\n        <a href=\\\"services.html\\\" style=\\\"text-decoration:underline;color:var(--muted)\\\">Need help choosing?</a>\\n        <a href=\\\"book.html\\\" style=\\\"background:var(--accent);color:#fff;padding:10px 12px;border-radius:10px;text-decoration:none\\\">Schedule a consult</a>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"grid\\\">\\n      <div class=\\\"card\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Daily Shift Roll-On</div>\\n            <div style=\\\"color:var(--muted);font-size:13px\\\">3% dilution in fractionated coconut oil. Handy pocket roll for brief scent cues.</div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <div class=\\\"price\\\">$22</div>\\n            <button class=\\\"add\\\" data-id=\\\"roll\\\">Add</button>\\n          </div>\\n        </div>\\n        <div class=\\\"badge-row\\\">\\n          <div class=\\\"badge\\\">Includes dilution card</div>\\n          <div class=\\\"badge\\\">Pet-safe option available</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Evening Mist</div>\\n            <div style=\\\"color:var(--muted);font-size:13px\\\">Light room mist in 50 ml bottle. Use sparingly and avoid spray near pets and infants.</div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <div class=\\\"price\\\">$28</div>\\n            <button class=\\\"add\\\" data-id=\\\"mist\\\">Add</button>\\n          </div>\\n        </div>\\n        <div class=\\\"badge-row\\\">\\n          <div class=\\\"badge\\\">Includes usage guide</div>\\n          <div class=\\\"badge tooltip\\\" data-tip=\\\"Avoid direct skin contact\\\">Safety note</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Starter Trio Kit</div>\\n            <div style=\\\"color:var(--muted);font-size:13px\\\">Three 2 ml vials: top, middle, base. Comes with patch-test instructions and simple rituals.</div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <div class=\\\"price\\\">$44</div>\\n            <button class=\\\"add\\\" data-id=\\\"trio\\\">Add</button>\\n          </div>\\n        </div>\\n        <div class=\\\"badge-row\\\">\\n          <div class=\\\"badge\\\">Gift-ready</div>\\n          <div class=\\\"badge\\\">Includes safety sheet</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Custom Mini Blend</div>\\n            <div style=\\\"color:var(--muted);font-size:13px\\\">Book a consult and add a 5 ml customized blend. Add to cart to request a consultation ID.</div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <div class=\\\"price\\\">$38</div>\\n            <button class=\\\"add\\\" data-id=\\\"custom\\\">Add</button>\\n          </div>\\n        </div>\\n        <div class=\\\"badge-row\\\">\\n          <div class=\\\"badge\\\">Personalized</div>\\n          <div class=\\\"badge\\\">Patch-test included</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"test-rotator\\\">\\n        <div id=\\\"testText\\\">\\\"Thoughtful notes I could actually use every morning.\\\" — Sara</div>\\n        <div style=\\\"margin-top:8px;display:flex;gap:8px;align-items:center\\\">\\n          <div class=\\\"badge tooltip\\\" data-tip=\\\"5-star local reviews\\\">Local reviews</div>\\n          <div class=\\\"badge tooltip\\\" data-tip=\\\"Listed with a small business directory\\\">Directory badge</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <div class=\\\"cart\\\" id=\\\"cart\\\">Cart: <span id=\\\"count\\\">0</span> • <button id=\\\"view\\\" style=\\\"border:none;background:transparent;color:#fff;text-decoration:underline;cursor:pointer\\\">View</button></div>\\n\\n  <div id=\\\"modal\\\" style=\\\"display:none;position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);background:#fff;padding:18px;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,0.2);z-index:60;min-width:280px\\\">\\n    <div style=\\\"font-weight:700\\\">Cart</div>\\n    <div id=\\\"items\\\" style=\\\"margin-top:10px\\\"></div>\\n    <div style=\\\"margin-top:12px;display:flex;gap:8px;justify-content:flex-end\\\">\\n      <button id=\\\"close\\\">Close</button>\\n      <a id=\\\"checkout\\\" href=\\\"pricing.html\\\" style=\\\"background:var(--accent);color:#fff;padding:8px 12px;border-radius:8px;text-decoration:none\\\">Proceed</a>\\n    </div>\\n  </div>\\n\\n  <script>\\n    (function(){\\n      const buttons=document.querySelectorAll('.add');\\n      const cart=[];\\n      const map={'roll':{name:'Daily Shift Roll-On',price:22},'mist':{name:'Evening Mist',price:28},'trio':{name:'Starter Trio Kit',price:44},'custom':{name:'Custom Mini Blend',price:38}};\\n      function update(){document.getElementById('count').textContent=cart.length}\\n      buttons.forEach(b=>b.addEventListener('click',()=>{\\n        const id=b.getAttribute('data-id'); cart.push(map[id]||{name:'Item',price:0}); update();\\n      }));\\n\\n      // simple testimonial rotator\\n      const tEl=document.getElementById('testText');\\n      const tests=['\\\"Thoughtful notes I could actually use every morning.\\\" — Sara','\\\"I appreciated the safety instructions for pets.\\\" — Omar','\\\"Clear dilution guidance made me comfortable using the roll-on.\\\" — Priya'];\\n      let ti=0; setInterval(()=>{ti=(ti+1)%tests.length; tEl.textContent=tests[ti];},4200);\\n\\n      // modal\\n      document.getElementById('view').addEventListener('click',()=>{\\n        const modal=document.getElementById('modal'); const items=document.getElementById('items'); items.innerHTML=''; cart.forEach((c,i)=>{ const d=document.createElement('div'); d.textContent=(i+1)+'. '+c.name+' — $'+c.price; items.appendChild(d); }); modal.style.display='block';\\n      });\\n      document.getElementById('close').addEventListener('click',()=>{document.getElementById('modal').style.display='none'});\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
