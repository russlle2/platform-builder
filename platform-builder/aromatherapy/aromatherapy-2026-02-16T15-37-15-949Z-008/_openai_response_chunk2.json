          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Offerings & Events</title>\\n  <style>\\n    :root{--bg1:#0f1724;--bg2:#071021;--accent:#c7a17a;--muted:#9aa5b1;--card:#0b1220}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;color:#e6eef6;background:linear-gradient(180deg,var(--bg1) 0%,var(--bg2) 100%);min-height:100vh}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 36px}\\n    nav a{color:rgba(230,238,246,0.9);text-decoration:none;margin:0 10px;font-size:14px;letter-spacing:0.6px}\\n    .brand{font-weight:600;color:var(--accent);font-size:18px}\\n    .svg-backdrop{position:fixed;right:-10vw;top:-8vh;width:80vw;height:80vh;opacity:0.12;pointer-events:none}\\n    .pattern{position:fixed;left:0;top:0;width:100%;height:100%;mix-blend-mode:overlay;opacity:0.06}\\n    main{max-width:1100px;margin:40px auto;padding:36px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center}\\n    .hero .lead{background:linear-gradient(180deg,rgba(255,255,255,0.03),rgba(255,255,255,0.01));padding:28px;border-radius:14px;box-shadow:0 6px 30px rgba(2,6,23,0.6)}\\n    h1{margin:0 0 10px;font-weight:700;color:#f6f9fb;letter-spacing:-0.02em}\\n    p.lead-intro{margin:0;color:var(--muted);line-height:1.6}\\n    .aside-card{background:linear-gradient(180deg,rgba(199,161,122,0.06),transparent);padding:22px;border-radius:12px;border:1px solid rgba(199,161,122,0.08)}\\n    .muted{color:var(--muted);font-size:13px}\\n    .btn{display:inline-block;margin-top:14px;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#d9bc96);color:#07101a;text-decoration:none;font-weight:600}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:26px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.04)}\\n    .small{font-size:13px;color:var(--muted)}\\n    .faq dt{font-weight:700;color:#f3f7fb;margin-top:12px}\\n    .faq dd{margin:6px 0 14px;color:var(--muted)}\\n    footer{padding:50px 36px;color:var(--muted);text-align:center}\\n    @media (max-width:880px){.hero{grid-template-columns:1fr}.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- decorative svg backdrop (hand-crafted, unique) -->\\n  <svg class=\\\"svg-backdrop\\\" viewBox=\\\"0 0 800 800\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#c7a17a\\\" stop-opacity=\\\"0.35\\\" />\\n        <stop offset=\\\"1\\\" stop-color=\\\"#6db3c8\\\" stop-opacity=\\\"0.18\\\" />\\n      </linearGradient>\\n      <filter id=\\\"blur\\\"><feGaussianBlur stdDeviation=\\\"40\\\" /></filter>\\n    </defs>\\n    <g filter=\\\"url(#blur)\\\">\\n      <ellipse cx=\\\"220\\\" cy=\\\"120\\\" rx=\\\"260\\\" ry=\\\"160\\\" fill=\\\"url(#g1)\\\" />\\n      <ellipse cx=\\\"560\\\" cy=\\\"420\\\" rx=\\\"240\\\" ry=\\\"180\\\" fill=\\\"#6fc3a7\\\" fill-opacity=\\\"0.06\\\" />\\n    </g>\\n    <g fill-opacity=\\\"0.04\\\" fill=\\\"#fff\\\">\\n      <circle cx=\\\"120\\\" cy=\\\"640\\\" r=\\\"80\\\" />\\n      <circle cx=\\\"700\\\" cy=\\\"100\\\" r=\\\"100\\\" />\\n    </g>\\n  </svg>\\n\\n  <!-- subtle pattern overlay -->\\n  <svg class=\\\"pattern\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 600 400\\\" preserveAspectRatio=\\\"none\\\">\\n    <defs>\\n      <pattern id=\\\"p\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"40\\\" height=\\\"40\\\" fill=\\\"none\\\"/>\\n        <path d=\\\"M0 20h40\\\" stroke=\\\"#ffffff\\\" stroke-opacity=\\\"0.03\\\" stroke-width=\\\"1\\\" />\\n        <path d=\\\"M20 0v40\\\" stroke=\\\"#ffffff\\\" stroke-opacity=\\\"0.02\\\" stroke-width=\\\"1\\\" />\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p)\\\" />\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Boutique</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"lead\\\">\\n        <h1>Gather. Inhale. Remember why your breath matters.</h1>\\n        <p class=\\\"lead-intro\\\">A seasonal series of group rituals and private consultations that use scent, slow attentiveness, and careful formulation. Each gathering is crafted to be safe, sensory, and refined — not medical advice.</p>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <div class=\\\"grid\\\">\\n          <div class=\\\"card\\\">\\n            <div class=\\\"small\\\">Event Format</div>\\n            <strong>Evening gatherings & private sessions</strong>\\n            <p class=\\\"small\\\">A blend of guided inhalation, scent teaching, and a short ritual to take home.</p>\\n          </div>\\n          <div class=\\\"card\\\">\\n            <div class=\\\"small\\\">Capacity</div>\\n            <strong>Intimate groups</strong>\\n            <p class=\\\"small\\\">Groups capped for attention and safety; small cohorts for richer practice.</p>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"aside-card\\\">\\n        <div class=\\\"small\\\">Upcoming series</div>\\n        <h3 style=\\\"margin:8px 0\\\">Rituals for quieting</h3>\\n        <p class=\\\"small\\\">A track of 4 evenings practiced weekly. Gentle instruction, curated blends, and a take-home roll-on.</p>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve a Seat</a></div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:34px\\\">\\n      <h2 style=\\\"color:#f4f9fc\\\">What to expect</h2>\\n      <p class=\\\"muted\\\">Sessions begin with a short orientation to safety, dilution and patch testing. We focus on aroma education and the ritual use of blends — always non-diagnostic, always client-led.</p>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:16px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Welcome & Safety</strong>\\n          <p class=\\\"small\\\">Brief check-in, notes on contraindications, and deliberate attention to pets, pregnancy, and medications.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Guided Scenting</strong>\\n          <p class=\\\"small\\\">Facilitated inhalations and sensory journaling; no claims to treat illness.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:32px\\\">\\n      <h2 style=\\\"color:#f4f9fc\\\">A typical ritual</h2>\\n      <ol class=\\\"muted\\\" style=\\\"line-height:1.7\\\">\\n        <li>Arrival & grounding — 10 minutes</li>\\n        <li>Presentation of blends & safety notes — 15 minutes</li>\\n        <li>Scented practice and shared silence — 25 minutes</li>\\n        <li>Closing & optional private consultation — 10 minutes</li>\\n      </ol>\\n    </section>\\n\\n    <section style=\\\"margin-top:32px\\\">\\n      <h2 style=\\\"color:#f4f9fc\\\">Schedule & booking</h2>\\n      <div class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Series: Quieting</strong>\\n          <p class=\\\"small\\\">Weekly on Thursdays, 6:30–7:30pm. Four sessions per series.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Private consult</strong>\\n          <p class=\\\"small\\\">By appointment: 45 minutes or 75 minutes. Formulation included.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\" style=\\\"margin-top:32px\\\">\\n      <h2 style=\\\"color:#f4f9fc\\\">Questions (safety-first)</h2>\\n      <dl>\\n        <dt>How is dilution handled?</dt>\\n        <dd>All topical blends are provided at safe dilution ranges and labeled. For group take-homes we use conservative dilutions and include clear instructions.</dd>\\n        <dt>What about a patch test?</dt>\\n        <dd>We recommend a 24-hour patch test for any topical product: apply a small amount to the forearm and observe. If irritation occurs, discontinue use.</dd>\\n        <dt>Are essential oils safe with pets?</dt>\\n        <dd>Some oils can be irritating to animals. We keep pets in mind and avoid direct application on animals. If you share space with pets, mention this during booking so we can adapt use.</dd>\\n        <dt>Pregnancy and nursing notes?</dt>\\n        <dd>Certain oils are best avoided during pregnancy and nursing. Please disclose pregnancy or nursing status at booking so we can recommend safe options or alternatives.</dd>\\n      </dl>\\n      <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">Services are educational and not a substitute for medical care.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:36px;padding:22px;border-radius:12px;background:linear-gradient(180deg,rgba(199,161,122,0.05),transparent)\\\">\\n      <h2 style=\\\"margin:0 0 8px;color:#f8fbfe\\\">Fees & deposits</h2>\\n      <p class=\\\"muted\\\">Series, drop-in and private session pricing vary. See the full fee page for details. A small deposit secures series enrollment.</p>\\n      <a class=\\\"btn\\\" href=\\\"pricing.html\\\" style=\\\"margin-top:10px;display:inline-block\\\">View Fees</a>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px;text-align:center\\\">\\n      <h3 style=\\\"color:#f8fbfe;margin-bottom:6px\\\">Ready to join a series?</h3>\\n      <p class=\\\"muted\\\">Reserve a place in the upcoming cohort or request a private consult with {{PRACTITIONER_NAME}}.</p>\\n      <a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve & Inquire</a>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}}</div>\\n    <div style=\\\"margin-top:8px\\\"><a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:inherit;text-decoration:none\\\">{{PHONE}}</a> · <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:inherit;text-decoration:none\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Signature Blends</title>\\n  <style>\\n    :root{--bg:#071021;--card:#081323;--accent:#bfa07a;--muted:#9db0bf}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,\\\"Segoe UI\\\",Roboto,Arial;background:radial-gradient(1200px 600px at 10% 10%,#0b2430 0%,var(--bg) 40%),var(--bg);color:#eaf4fb}\\n    header{display:flex;justify-content:space-between;padding:26px 34px;align-items:center}\\n    nav a{color:rgba(234,244,251,0.9);text-decoration:none;margin:0 10px;font-size:14px}\\n    .brand{font-weight:700;color:var(--accent)}\\n    main{max-width:1100px;margin:36px auto;padding:24px}\\n    .hero{padding:28px;border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border:1px solid rgba(255,255,255,0.04)}\\n    h1{margin:0 0 6px}\\n    .sub{color:var(--muted);margin:0}\\n\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .blend{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .notes{font-size:13px;color:var(--muted)}\\n    .profile{font-weight:700;margin-top:8px}\\n    .supports{margin-top:10px;color:var(--muted);font-size:13px}\\n    .cta-row{display:flex;justify-content:space-between;align-items:center;margin-top:18px}\\n    .small-btn{background:linear-gradient(90deg,var(--accent),#d6b98c);padding:8px 10px;border-radius:8px;color:#07101a;text-decoration:none;font-weight:600}\\n    footer{padding:40px;color:var(--muted);text-align:center}\\n    @media (max-width:980px){.grid{grid-template-columns:repeat(2,1fr)}}\\n    @media (max-width:680px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique hand-drawn svg pattern in-page -->\\n  <svg style=\\\"position:fixed;right:-12vw;bottom:-10vh;opacity:0.08;pointer-events:none\\\" width=\\\"700\\\" height=\\\"500\\\" viewBox=\\\"0 0 700 500\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"blendG\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#c7a17a\\\" stop-opacity=\\\"0.35\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#8ed0d0\\\" stop-opacity=\\\"0.16\\\"/></linearGradient>\\n    </defs>\\n    <path d=\\\"M40 400 C160 120 520 120 660 380 L660 500 L40 500 Z\\\" fill=\\\"url(#blendG)\\\" />\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Formulas</a>\\n      <a href=\\\"shop.html\\\">Shop</a>\\n      <a href=\\\"about.html\\\">About</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <h1>Curated blends — small collections for intentional use</h1>\\n      <p class=\\\"sub\\\">Each recipe lists top / middle / base notes and an aroma profile. Descriptions state how the scent can support presence and wellbeing — not medical claims.</p>\\n      <div class=\\\"cta-row\\\">\\n        <div class=\\\"notes\\\">Prepared with care by {{PRACTITIONER_NAME}} — always safety-minded.</div>\\n        <a class=\\\"small-btn\\\" href=\\\"book.html\\\">Request a custom blend</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"blend\\\">\\n          <div class=\\\"profile\\\">Dawn Clearing</div>\\n          <div class=\\\"notes\\\">Top: lemon, bergamot · Middle: rosemary · Base: cedarwood</div>\\n          <div class=\\\"supports\\\">A bright, herbaceous profile that supports alert focus and a fresh start to the day.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div class=\\\"profile\\\">Quiet Harbor</div>\\n          <div class=\\\"notes\\\">Top: lavender · Middle: clary sage · Base: vetiver</div>\\n          <div class=\\\"supports\\\">A soft floral-earth mix that supports gentle winding-down and mindful breathing.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div class=\\\"profile\\\">Citrus Memory</div>\\n          <div class=\\\"notes\\\">Top: sweet orange, petitgrain · Middle: neroli · Base: benzoin</div>\\n          <div class=\\\"supports\\\">Bright citrus uplift paired with comforting resin — supportive for lightening mood and presence.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div class=\\\"profile\\\">Forest Walk</div>\\n          <div class=\\\"notes\\\">Top: pine · Middle: eucalyptus · Base: sandalwood</div>\\n          <div class=\\\"supports\\\">A green, clean woodland aroma that supports deep inhalation and a sense of grounding.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div class=\\\"profile\\\">Warm Hearth</div>\\n          <div class=\\\"notes\\\">Top: ginger · Middle: cinnamon leaf · Base: clove</div>\\n          <div class=\\\"supports\\\">Spiced and warming; supportive for ritual use in colder months and contemplative evenings.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div class=\\\"profile\\\">Ocean Salt</div>\\n          <div class=\\\"notes\\\">Top: bergamot · Middle: lavender · Base: amber</div>\\n          <div class=\\\"supports\\\">A bracing yet soft profile meant to evoke open air and clarity of breath.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div class=\\\"profile\\\">Herbal Ledger</div>\\n          <div class=\\\"notes\\\">Top: basil · Middle: geranium · Base: patchouli</div>\\n          <div class=\\\"supports\\\">An herbal floral blend that supports focused ritual and subtle emotional steadiness.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div class=\\\"profile\\\">Moon Resin</div>\\n          <div class=\\\"notes\\\">Top: frankincense · Middle: myrrh · Base: labdanum</div>\\n          <div class=\\\"supports\\\">A resinous, meditative profile used for stillness and slow attention during ritual moments.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div class=\\\"profile\\\">Soft Meadow</div>\\n          <div class=\\\"notes\\\">Top: chamomile · Middle: ylang-ylang · Base: benzoin</div>\\n          <div class=\\\"supports\\\">Gentle floral with a soft balsamic base, supportive for quiet reflection and gentle inhalation.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div class=\\\"profile\\\">Spiced Orchard</div>\\n          <div class=\\\"notes\\\">Top: apple · Middle: clove · Base: cedar</div>\\n          <div class=\\\"supports\\\">A warm, approachable scent that supports cozy ritual and mindful presence.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div class=\\\"profile\\\">Green Return</div>\\n          <div class=\\\"notes\\\">Top: lemongrass · Middle: jasmine · Base: guaiac wood</div>\\n          <div class=\\\"supports\\\">A fresh, slightly floral aroma to refresh the senses and anchor attention.</div>\\n        </div>\\n\\n        <div class=\\\"blend\\\">\\n          <div class=\\\"profile\\\">Evening Ink</div>\\n          <div class=\\\"notes\\\">Top: bergamot · Middle: black pepper · Base: oud (lightly used)</div>\\n          <div class=\\\"supports\\\">A contemplative, slightly smoky-profile for short meditative practices; used sparingly.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:28px\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Formulation notes</h3>\\n      <p class=\\\"notes\\\">Blends are created with attention to dilution, irritant potential, and contraindications. If you are pregnant, nursing, or on medication, share this information before application so we can propose safe alternatives. These descriptions are aromatic and educational — not medical guidance.</p>\\n      <div style=\\\"margin-top:12px\\\"><a class=\\\"small-btn\\\" href=\\\"shop.html\\\">Buy a roll-on or kit</a></div>\\n    </section>\\n\\n    <section style=\\\"margin-top:26px\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Patch test reminder</h3>\\n      <p class=\\\"notes\\\">Always perform a patch test for topical use and avoid direct undiluted skin application. Keep products away from eyes and mucous membranes.</p>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} · Handcrafted blends by {{PRACTITIONER_NAME}}</div>\\n    <div style=\\\"margin-top:8px\\\" class=\\\"notes\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:inherit;text-decoration:none\\\">{{EMAIL}}</a> · {{PHONE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Boutique</title>\\n  <style>\\n    :root{--bg:#06121b;--panel:#0b1a25;--accent:#c9a874;--muted:#9fb0bd}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,\\\"Segoe UI\\\",Roboto,Arial;background:linear-gradient(180deg,var(--bg),#021018);color:#eaf6ff}\\n    header{display:flex;justify-content:space-between;padding:22px 28px;align-items:center}\\n    .brand{color:var(--accent);font-weight:700}\\n    nav a{color:rgba(234,246,255,0.9);text-decoration:none;margin:0 8px}\\n    main{max-width:1100px;margin:30px auto;padding:18px}\\n    .hero{padding:20px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border:1px solid rgba(255,255,255,0.03)}\\n    h1{margin:0}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:18px}\\n    .product{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:16px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .product h4{margin:6px 0}\\n    .price{color:var(--accent);font-weight:700}\\n    .buy{display:inline-block;margin-top:10px;padding:8px 10px;border-radius:8px;background:var(--accent);color:#07101a;text-decoration:none;font-weight:600}\\n    .meta{font-size:13px;color:var(--muted)}\\n    footer{padding:40px;text-align:center;color:var(--muted)}\\n    @media (max-width:980px){.grid{grid-template-columns:repeat(2,1fr)}}\\n    @media (max-width:640px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- small svg flourish (unique) -->\\n  <svg width=\\\"360\\\" height=\\\"160\\\" viewBox=\\\"0 0 360 160\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" style=\\\"position:fixed;left:-6vw;top:-4vh;opacity:0.06;pointer-events:none\\\">\\n    <defs><linearGradient id=\\\"f1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#c7a17a\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#8fd0d0\\\"/></linearGradient></defs>\\n    <rect x=\\\"0\\\" y=\\\"40\\\" width=\\\"360\\\" height=\\\"120\\\" rx=\\\"30\\\" fill=\\\"url(#f1)\\\" />\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Store</a>\\n      <a href=\\\"contact.html\\\">Hello</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <h1>Shop — curated kits, roll-ons & gentle diffusers</h1>\\n      <p class=\\\"meta\\\">A small collection intended for ritual use and mindful scenting. Not medical. Includes safety and dilution info with every product.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"product\\\">\\n          <div class=\\\"meta\\\">Kit · Intro</div>\\n          <h4>Ritual Starter Kit</h4>\\n          <div class=\\\"meta\\\">Includes: 3 x 5ml blends (sample dilutions), one roll-on, instruction card</div>\\n          <div class=\\\"price\\\">$48</div>\\n          <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n        </div>\\n\\n        <div class=\\\"product\\\">\\n          <div class=\\\"meta\\\">Roll-on · 10ml</div>\\n          <h4>{{FAVORITE_BLEND}} Roll-on</h4>\\n          <div class=\\\"meta\\\">Pre-diluted for topical use; includes patch test instructions.</div>\\n          <div class=\\\"price\\\">$22</div>\\n          <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n        </div>\\n\\n        <div class=\\\"product\\\">\\n          <div class=\\\"meta\\\">Diffuser · ceramic</div>\\n          <h4>Silent Mist Diffuser</h4>\\n          <div class=\\\"meta\\\">Electric diffuser for quiet rooms — low mist, timed cycles.</div>\\n          <div class=\\\"price\\\">$64</div>\\n          <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n        </div>\\n\\n        <div class=\\\"product\\\">\\n          <div class=\\\"meta\\\">Kit · Travel</div>\\n          <h4>Pocket Calm Trio</h4>\\n          <div class=\\\"meta\\\">Three 3ml roll-ons for travel: Dawn Clearing, Quiet Harbor, Citrus Memory.</div>\\n          <div class=\\\"price\\\">$34</div>\\n          <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n        </div>\\n\\n        <div class=\\\"product\\\">\\n          <div class=\\\"meta\\\">Roll-on · 10ml</div>\\n          <h4>Moon Resin Roll-on</h4>\\n          <div class=\\\"meta\\\">Light resinous formulation for short rituals; conservatively diluted.</div>\\n          <div class=\\\"price\\\">$24</div>\\n          <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n        </div>\\n\\n        <div class=\\\"product\\\">\\n          <div class=\\\"meta\\\">Accessory</div>\\n          <h4>Cotton Scent Cloths (set of 10)</h4>\\n          <div class=\\\"meta\\\">Pre-cut cloths for scent exercises and sampling.</div>\\n          <div class=\\\"price\\\">$12</div>\\n          <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n        </div>\\n\\n        <div class=\\\"product\\\">\\n          <div class=\\\"meta\\\">Diffuser · reed</div>\\n          <h4>Quiet Reed Diffuser</h4>\\n          <div class=\\\"meta\\\">Non-electric home diffuser; gentle diffusion for small rooms.</div>\\n          <div class=\\\"price\\\">$38</div>\\n          <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n        </div>\\n\\n        <div class=\\\"product\\\">\\n          <div class=\\\"meta\\\">Roll-on · 10ml</div>\\n          <h4>Forest Walk Roll-on</h4>\\n          <div class=\\\"meta\\\">Green-wood blend, conservatively diluted for topical ritual use.</div>\\n          <div class=\\\"price\\\">$22</div>\\n          <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n        </div>\\n\\n        <div class=\\\"product\\\">\\n          <div class=\\\"meta\\\">Gift</div>\\n          <h4>Gathering Gift Pack</h4>\\n          <div class=\\\"meta\\\">Starter Kit + a Reed Diffuser + gift wrap and note.</div>\\n          <div class=\\\"price\\\">$88</div>\\n          <a class=\\\"buy\\\" href=\\\"#\\\">Add to cart</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:24px;padding:16px;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);border:1px solid rgba(255,255,255,0.03)\\\">\\n      <h3 style=\\\"margin:0 0 6px\\\">Product safety notes</h3>\\n      <p class=\\\"meta\\\" style=\\\"margin:0\\\">All products include dilution guidance and patch test instructions. Keep away from eyes, mucous membranes and children. If pregnant or nursing, consult with the practitioner before topical use.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;text-align:center\\\">\\n      <a class=\\\"buy\\\" href=\\\"contact.html\\\">Questions about ingredients?</a>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — Small batch, studio-made · {{CITY}}, {{STATE}}</div>\\n    <div style=\\\"margin-top:8px\\\" class=\\\"meta\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:inherit;text-decoration:none\\\">{{EMAIL}}</a> · <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:inherit;text-decoration:none\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
