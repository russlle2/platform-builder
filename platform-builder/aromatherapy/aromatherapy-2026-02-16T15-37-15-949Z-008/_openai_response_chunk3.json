          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Offerings — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#F8FBF8;--accent:#6EA88A;--muted:#7A8B80;--card:#FFFFFF;--ink:#21302B}\\n    *{box-sizing:border-box}\\n    html,body{height:100%}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;line-height:1.45;color:var(--ink);background:linear-gradient(180deg,var(--bg),#F1F7F3);}\\n    header{position:relative;z-index:10;padding:28px 24px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:54px;height:54px;border-radius:12px;background:linear-gradient(135deg,rgba(110,168,138,0.12),rgba(110,168,138,0.06));display:grid;place-items:center;font-weight:700;color:var(--accent)}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 8px;font-weight:600}\\n    nav a.active{color:var(--ink)}\\n    .hero{padding:48px 24px 36px;max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    .lead{background:rgba(255,255,255,0.6);backdrop-filter:blur(6px);padding:34px;border-radius:14px;box-shadow:0 6px 20px rgba(32,40,36,0.06)}\\n    h1{margin:0 0 8px;font-size:28px;letter-spacing:-0.02em}\\n    p.tag{margin:0;color:var(--muted)}\\n    .aside{padding:22px;border-radius:12px;background:linear-gradient(180deg,#FFFFFF, #F7FFFA);box-shadow:0 8px 30px rgba(29,40,34,0.04)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}\\n    .card{background:var(--card);border-radius:12px;padding:18px;border:1px solid rgba(34,50,44,0.04)}\\n    .price{font-size:20px;font-weight:700;color:var(--accent)}\\n    .muted{color:var(--muted);font-size:13px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:var(--accent);color:white;text-decoration:none;font-weight:700}\\n    .pattern{position:fixed;inset:0;pointer-events:none;z-index:0;opacity:0.14}\\n    main{position:relative;z-index:5}\\n    section{max-width:1100px;margin:28px auto;padding:0 24px}\\n    .pricing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}\\n    .plan{padding:20px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.9),#FFF);border:1px solid rgba(34,50,44,0.04)}\\n    .plan h3{margin:0 0 6px}\\n    .features{margin:12px 0 0;padding:0;list-style:none}\\n    footer{padding:34px 24px;text-align:center;color:var(--muted);font-size:13px}\\n    .faq{display:grid;gap:12px}\\n    .faq-item{background:#fff;padding:14px;border-radius:10px;border:1px solid rgba(34,50,44,0.03)}\\n    form.booking{display:flex;flex-direction:column;gap:8px}\\n    input,select,textarea{padding:10px;border-radius:8px;border:1px solid #E6EDE8}\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:repeat(2,1fr)}.logo{width:46px;height:46px}}\\n  </style>\\n</head>\\n<body>\\n  <!-- soft SVG atmosphere unique to this page -->\\n  <svg class=\\\"pattern\\\" width=\\\"100%\\\" height=\\\"100%\\\" viewBox=\\\"0 0 800 600\\\" preserveAspectRatio=\\\"xMidYMid slice\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#F1FFF7\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#E6F8EE\\\"/></linearGradient>\\n      <filter id=\\\"blur\\\"><feGaussianBlur stdDeviation=\\\"24\\\"/></filter>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g1)\\\"/>\\n    <g filter=\\\"url(#blur)\\\" opacity=\\\"0.9\\\">\\n      <circle cx=\\\"120\\\" cy=\\\"80\\\" r=\\\"140\\\" fill=\\\"#A8E0C6\\\" opacity=\\\"0.12\\\"/>\\n      <circle cx=\\\"700\\\" cy=\\\"480\\\" r=\\\"220\\\" fill=\\\"#DFF3EA\\\" opacity=\\\"0.14\\\"/>\\n      <circle cx=\\\"420\\\" cy=\\\"220\\\" r=\\\"90\\\" fill=\\\"#C7EED9\\\" opacity=\\\"0.11\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav aria-label=\\\"primary\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Shop</a>\\n      <a href=\\\"pricing.html\\\" class=\\\"active\\\">Rates</a>\\n      <a href=\\\"about.html\\\">Story</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"hero\\\">\\n      <div class=\\\"lead\\\">\\n        <h1>Quiet circles — a series of guided aromatherapy sessions</h1>\\n        <p class=\\\"tag\\\">A seasonal events series with botanical blends, gentle ritual, and shared learning. Safety-first, scent-forward. No medical claims — only sensory care.</p>\\n        <div class=\\\"grid\\\" aria-hidden=\\\"false\\\">\\n          <div class=\\\"card\\\">\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Format</div>\\n            <div style=\\\"font-weight:700;margin-top:6px\\\">Hybrid — in-person &amp; online</div>\\n          </div>\\n          <div class=\\\"card\\\">\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Group size</div>\\n            <div style=\\\"font-weight:700;margin-top:6px\\\">6–12 participants</div>\\n          </div>\\n          <div class=\\\"card\\\">\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Duration</div>\\n            <div style=\\\"font-weight:700;margin-top:6px\\\">75 minutes per session</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"aside\\\">\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Next series</div>\\n        <div style=\\\"font-weight:700;margin-top:6px\\\">Spring Circle — 4 weeks</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Led by {{PRACTITIONER_NAME}} in {{CITY}}, {{STATE}}</div>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\" style=\\\"display:inline-block;margin-top:14px\\\">Reserve a place</a>\\n      </aside>\\n    </div>\\n\\n    <section aria-labelledby=\\\"plans\\\">\\n      <h2 id=\\\"plans\\\">Packages &amp; rates</h2>\\n      <p class=\\\"muted\\\">Choose the circle that fits your rhythm. All rates inclusive of materials and a small botanical sample. Prices shown in USD.</p>\\n      <div class=\\\"pricing-grid\\\" style=\\\"margin-top:16px\\\">\\n        <div class=\\\"plan\\\">\\n          <h3>Intro Ritual — single session</h3>\\n          <div class=\\\"price\\\">$45</div>\\n          <div class=\\\"muted\\\">A gentle entry: one guided session with take-home roll-on.</div>\\n          <ul class=\\\"features\\\">\\n            <li>75-minute guided experience</li>\\n            <li>Intro to safe dilution and patch testing</li>\\n            <li>Hand-blended 10ml roll-on</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"plan\\\">\\n          <h3>Seasonal Series — 4 sessions</h3>\\n          <div class=\\\"price\\\">$160</div>\\n          <div class=\\\"muted\\\">Deepen over a month; a cohesive, evolving exploration.</div>\\n          <ul class=\\\"features\\\">\\n            <li>Four 75-minute sessions</li>\\n            <li>One sample blend per session</li>\\n            <li>Materials &amp; notes included</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"plan\\\">\\n          <h3>Full Circle — membership</h3>\\n          <div class=\\\"price\\\">$420 / quarter</div>\\n          <div class=\\\"muted\\\">Unlimited access to local circles + member discounts.</div>\\n          <ul class=\\\"features\\\">\\n            <li>All seasonal circles included</li>\\n            <li>10% off private sessions &amp; products</li>\\n            <li>Priority booking</li>\\n          </ul>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section aria-labelledby=\\\"schedule\\\" style=\\\"margin-top:8px\\\">\\n      <h2 id=\\\"schedule\\\">Upcoming meetings</h2>\\n      <div style=\\\"display:grid;gap:12px;margin-top:12px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Spring Circle</strong>\\n          <div class=\\\"muted\\\">Apr 6 • Apr 13 • Apr 20 • Apr 27 — 6:30pm–7:45pm</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Weekend Sampler</strong>\\n          <div class=\\\"muted\\\">May 9 — Sat 10:30am–12:00pm (one-off)</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section aria-labelledby=\\\"faq\\\" style=\\\"margin-top:18px\\\">\\n      <h2 id=\\\"faq\\\">Questions &amp; safety notes</h2>\\n      <div class=\\\"faq\\\">\\n        <div class=\\\"faq-item\\\">\\n          <strong>Are these medical therapies?</strong>\\n          <div class=\\\"muted\\\">No. Sessions are sensory and educational. We do not diagnose or treat medical conditions.</div>\\n        </div>\\n        <div class=\\\"faq-item\\\">\\n          <strong>Dilution and patch tests</strong>\\n          <div class=\\\"muted\\\">All topical blends are prepared at safe dilutions. You will be shown how to perform a simple patch test prior to using a roll-on.</div>\\n        </div>\\n        <div class=\\\"faq-item\\\">\\n          <strong>Pets and essential oils</strong>\\n          <div class=\\\"muted\\\">We provide guidance for pet-safe use; many oils can affect animals. Keep blends out of reach and consult your veterinarian for specific concerns.</div>\\n        </div>\\n        <div class=\\\"faq-item\\\">\\n          <strong>Pregnancy and sensitive conditions</strong>\\n          <div class=\\\"muted\\\">Some oils are not recommended during pregnancy. If pregnant, breastfeeding, or managing a serious condition, please reach out before booking so we can discuss safety-first options.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:24px;padding-bottom:40px;text-align:center\\\">\\n      <a class=\\\"cta\\\" href=\\\"book.html\\\">Select your package &amp; book</a>\\n      <div style=\\\"margin-top:10px\\\" class=\\\"muted\\\">Questions? Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    &copy; <span id=\\\"year\\\">2026</span> {{BUSINESS_NAME}} — {{\"Safe aromatic practice, locally rooted.\"}}\\n  </footer>\\n</body>\\n</html>\"}  \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#FFFDF9;--accent:#8FBF9A;--muted:#6F7972;--ink:#172724}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto;line-height:1.5;color:var(--ink);background:linear-gradient(180deg,var(--bg),#F6FBF7)}\\n    header{padding:22px 20px;display:flex;align-items:center;justify-content:space-between}\\n    .logo{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,#E6F7EE,#F9FFFB);display:grid;place-items:center;color:var(--accent);font-weight:800}\\n    nav a{margin:0 8px;color:var(--muted);text-decoration:none}\\n    nav a.active{color:var(--ink);font-weight:700}\\n    .pattern{position:absolute;left:-10%;top:-6%;width:600px;height:600px;opacity:0.08;z-index:0}\\n    main{position:relative;z-index:2;max-width:980px;margin:12px auto;padding:0 20px}\\n    .hero{padding:34px;margin-top:6px;background:#fff;border-radius:14px;box-shadow:0 10px 30px rgba(23,39,34,0.04);display:flex;gap:18px}\\n    .hero .text{flex:1}\\n    h1{margin:0 0 6px;font-size:26px}\\n    .muted{color:var(--muted)}\\n    .ritual{margin-top:18px;background:linear-gradient(180deg,#FFFFFF,#FAFFFB);padding:18px;border-radius:12px}\\n    .what{display:grid;grid-template-columns:1fr 220px;gap:16px;margin-top:18px}\\n    .bio{background:#fff;padding:18px;border-radius:12px}\\n    .cta{display:inline-block;padding:9px 12px;border-radius:10px;background:var(--accent);color:white;text-decoration:none;font-weight:700}\\n    .faq{margin-top:18px;display:grid;gap:10px}\\n    .faq-item{background:#fff;padding:12px;border-radius:10px;border:1px solid rgba(23,39,34,0.03)}\\n    @media (max-width:760px){.what{grid-template-columns:1fr}.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique floral sweep for about -->\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 500 500\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <radialGradient id=\\\"rg\\\"><stop offset=\\\"0\\\" stop-color=\\\"#EAF9EE\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#F7FFF9\\\"/></radialGradient>\\n    </defs>\\n    <circle cx=\\\"80\\\" cy=\\\"100\\\" r=\\\"220\\\" fill=\\\"url(#rg)\\\" />\\n  </svg>\\n\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME.substring(0,1)}}</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Sessions</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Shop</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"about.html\\\" class=\\\"active\\\">Story</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"text\\\">\\n        <h1>We name the plants, then listen</h1>\\n        <p class=\\\"muted\\\">A quiet introduction to scented practice. I blend and teach with a safety-first hand—no cures promised, only careful craft and fragrant company.</p>\\n        <div style=\\\"margin-top:12px\\\">\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Join a circle</a>\\n        </div>\\n      </div>\\n      <div style=\\\"width:240px\\\">\\n        <div style=\\\"background:#fff;padding:14px;border-radius:12px;box-shadow:0 8px 24px rgba(21,33,29,0.04)\\\">\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">Lead practitioner</div>\\n          <div style=\\\"font-weight:700;margin-top:6px\\\">{{PRACTITIONER_NAME}}</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px;font-size:13px\\\">Certified aromatherapist (safety-focused) • Facilitator of group rituals.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"ritual\\\" aria-labelledby=\\\"ritual\\\">\\n      <h2 id=\\\"ritual\\\">A typical ritual</h2>\\n      <p class=\\\"muted\\\">Our gatherings move from gentle arrival to shared scent exploration. Each session includes a short grounding, a participatory blending moment, and optional take-home care. Expect simple prompts, soft music, and generous explanation of dilution and safe use.</p>\\n    </section>\\n\\n    <section class=\\\"what\\\" aria-labelledby=\\\"expectations\\\">\\n      <div class=\\\"bio\\\">\\n        <h3 id=\\\"expectations\\\">What to expect</h3>\\n        <ul class=\\\"muted\\\">\\n          <li>Clear guidance on patch testing and topical safety</li>\\n          <li>Discussion of scent profiles and botanical notes (top, middle, base)</li>\\n          <li>Hands-on blending with measured, labeled bottles</li>\\n        </ul>\\n      </div>\\n      <aside style=\\\"background:linear-gradient(180deg,#FFFFFF,#FBFFFB);padding:14px;border-radius:12px\\\">\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Bring</div>\\n        <div style=\\\"font-weight:700;margin-top:6px\\\">An open heart and any questions</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:10px\\\">If you have allergies, are pregnant, or have pets at home, please mention this before booking so we can prioritize safety.</div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"faq\\\" aria-labelledby=\\\"faq\\\">\\n      <h3 id=\\\"faq\\\">Safety &amp; common questions</h3>\\n      <div class=\\\"faq-item\\\">\\n        <strong>Dilution guidance</strong>\\n        <div class=\\\"muted\\\">I demonstrate recommended dilutions and provide labeled blends at safe concentrations for adults. Children and sensitive skin require further modifications—ask for guidance.</div>\\n      </div>\\n      <div class=\\\"faq-item\\\">\\n        <strong>Patch testing</strong>\\n        <div class=\\\"muted\\\">Before applying any new blend, we perform a small patch test. This is part of every hands-on session.</div>\\n      </div>\\n      <div class=\\\"faq-item\\\">\\n        <strong>Pets</strong>\\n        <div class=\\\"muted\\\">Some essential oils can be unpleasant or unsafe for animals. We cover pet-safe practices and storage so your blends remain companion-friendly.</div>\\n      </div>\\n      <div class=\\\"faq-item\\\">\\n        <strong>Pregnancy &amp; special conditions</strong>\\n        <div class=\\\"muted\\\">Certain oils are avoided in pregnancy. If pregnant or breastfeeding, please contact me ahead of booking to discuss safe alternatives.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;text-align:center\\\">\\n      <a class=\\\"cta\\\" href=\\\"pricing.html\\\">View packages</a>\\n      <div class=\\\"muted\\\" style=\\\"margin-top:10px\\\">Or call {{PHONE}} to talk through options.</div>\\n    </section>\\n  </main>\\n\\n  <footer style=\\\"text-align:center;padding:30px 20px;color:var(--muted)\\\">\\n    {{BUSINESS_NAME}} — Gentle scentwork in {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>\\n  </footer>\\n</body>\\n</html>\"}  \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Reserve a place — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#F7FFFB;--accent:#5DA274;--muted:#64746D;--ink:#14261F}\\n    body{margin:0;font-family:system-ui, -apple-system, Roboto, 'Helvetica Neue';background:linear-gradient(180deg,#FBFFF9,var(--bg));color:var(--ink)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 20px}\\n    nav a{margin:0 8px;color:var(--muted);text-decoration:none}\\n    nav a.active{color:var(--ink);font-weight:700}\\n    .pattern{position:fixed;right:-6%;bottom:-8%;width:520px;height:520px;opacity:0.1}\\n    main{max-width:980px;margin:18px auto;padding:0 20px}\\n    .hero{background:#fff;padding:22px;border-radius:12px;box-shadow:0 12px 30px rgba(15,28,24,0.04);display:flex;justify-content:space-between;gap:12px}\\n    .hero h1{margin:0;font-size:22px}\\n    .col{padding:12px}\\n    .panel{background:linear-gradient(180deg,#fff,#FBFFF9);padding:14px;border-radius:10px;border:1px solid rgba(20,38,31,0.03)}\\n    form{display:grid;gap:10px}\\n    input,select,textarea{padding:10px;border-radius:8px;border:1px solid #E6EEE8}\\n    .btn{background:var(--accent);color:white;padding:10px 12px;border-radius:10px;text-decoration:none;display:inline-block;font-weight:700}\\n    .avail{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}\\n    .slot{background:#fff;padding:10px;border-radius:10px;border:1px solid rgba(20,38,31,0.03)}\\n    .muted{color:var(--muted);font-size:13px}\\n    .summary{border-left:1px dashed rgba(20,38,31,0.06);padding-left:12px}\\n    @media (max-width:800px){.hero{flex-direction:column}.summary{border-left:none;padding-left:0}}\\n  </style>\\n</head>\\n<body>\\n  <!-- booking page swirl -->\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 600 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"lg2\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#E8FAF0\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#F6FFF8\\\"/></linearGradient>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#lg2)\\\"/>\\n    <g opacity=\\\"0.9\\\">\\n      <path d=\\\"M50 500 C150 380, 420 320, 560 420 L560 600 L0 600 Z\\\" fill=\\\"#DFF5E6\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div style=\\\"width:44px;height:44px;border-radius:10px;background:#fff;display:grid;place-items:center;font-weight:800;color:var(--accent)\\\">{{BUSINESS_NAME.substring(0,1)}}</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Reserve your place in the next circle</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Sessions</a>\\n      <a href=\\\"blends.html\\\">Essences</a>\\n      <a href=\\\"shop.html\\\">Shop</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\" class=\\\"active\\\">Reserve</a>\\n      <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"col\\\" style=\\\"flex:1\\\">\\n        <h1>Reserve a seat — Spring Circle</h1>\\n        <p class=\\\"muted\\\">Select a session time and package. You will receive materials and safety notes ahead of the first meeting. We prioritize gentle, clear instruction.</p>\\n\\n        <div style=\\\"margin-top:12px\\\" class=\\\"panel\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">Available times</h3>\\n          <div class=\\\"avail\\\">\\n            <div class=\\\"slot\\\"><strong>Apr 6 • 6:30pm</strong><div class=\\\"muted\\\">In-person • 12 slots</div></div>\\n            <div class=\\\"slot\\\"><strong>Apr 13 • 6:30pm</strong><div class=\\\"muted\\\">In-person • 12 slots</div></div>\\n            <div class=\\\"slot\\\"><strong>Apr 20 • 6:30pm</strong><div class=\\\"muted\\\">Online • 20 seats</div></div>\\n            <div class=\\\"slot\\\"><strong>Apr 27 • 6:30pm</strong><div class=\\\"muted\\\">In-person • 12 slots</div></div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px\\\" class=\\\"panel\\\">\\n          <h4 style=\\\"margin:0 0 6px\\\">Booking form</h4>\\n          <form class=\\\"booking\\\" action=\\\"/reserve\\\" method=\\\"post\\\" onsubmit=\\\"alert('This is a demo booking form — no data sent.');return false;\\\">\\n            <input name=\\\"name\\\" placeholder=\\\"Your name\\\" required />\\n            <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"Email (for confirmation)\\\" required />\\n            <select name=\\\"session\\\" required>\\n              <option value=\\\"Apr 6\\\">Apr 6 — 6:30pm</option>\\n              <option value=\\\"Apr 13\\\">Apr 13 — 6:30pm</option>\\n              <option value=\\\"Apr 20\\\">Apr 20 — 6:30pm (online)</option>\\n              <option value=\\\"Apr 27\\\">Apr 27 — 6:30pm</option>\\n            </select>\\n            <select name=\\\"package\\\">\\n              <option value=\\\"intro\\\">Intro Ritual — $45</option>\\n              <option value=\\\"series\\\">Seasonal Series — $160</option>\\n              <option value=\\\"membership\\\">Full Circle Membership — $420</option>\\n            </select>\\n            <textarea name=\\\"notes\\\" placeholder=\\\"Allergies, pregnancy, pets at home? (optional)\\\" rows=\\\"3\\\"></textarea>\\n            <div style=\\\"display:flex;gap:8px;align-items:center\\\">\\n              <button class=\\\"btn\\\" type=\\\"submit\\\">Confirm reservation</button>\\n              <a href=\\\"pricing.html\\\" style=\\\"text-decoration:none;color:var(--muted)\\\">See pricing</a>\\n            </div>\\n          </form>\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"col summary\\\" style=\\\"width:320px\\\">\\n        <div class=\\\"panel\\\">\\n          <h4 style=\\\"margin:0 0 6px\\\">Your selection</h4>\\n          <div class=\\\"muted\\\">Session</div>\\n          <div style=\\\"font-weight:700;margin-top:6px\\\">Spring Circle — Apr 6</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:10px\\\">Package</div>\\n          <div style=\\\"font-weight:700;margin-top:6px\\\">Seasonal Series — $160</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:12px\\\">Notes</div>\\n          <div class=\\\"muted\\\" style=\\\"font-size:13px;margin-top:6px\\\">All topical blends provided at recommended dilutions. Patch testing included.</div>\\n          <div style=\\\"margin-top:14px\\\">\\n            <a class=\\\"btn\\\" href=\\\"#\\\">Proceed to confirm</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h5 style=\\\"margin:0 0 6px\\\">Need help?</h5>\\n          <div class=\\\"muted\\\">Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>Safety notes</h3>\\n      <div class=\\\"panel\\\" style=\\\"margin-top:8px\\\">\\n        <p class=\\\"muted\\\">We take a conservative approach: recommended dilutions, patch testing, and guidance for pets and pregnancy. If you have specific health questions, please consult a healthcare professional. Our sessions are educational and sensory; they are not a substitute for medical advice.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;margin-bottom:40px\\\">\\n      <h3>Frequently asked</h3>\\n      <div class=\\\"panel\\\" style=\\\"margin-top:8px\\\">\\n        <strong>How do I prepare?</strong>\\n        <div class=\\\"muted\\\">Wear something comfortable. Avoid heavy perfumes so group scents remain clear. Bring any questions about allergies or pregnancy.</div>\\n        <hr style=\\\"border:none;border-top:1px dashed rgba(20,38,31,0.06);margin:12px 0\\\"/>\\n        <strong>Will there be take-home blends?</strong>\\n        <div class=\\\"muted\\\">Yes — small samples and roll-ons are included according to package.</div>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"text-align:center;padding:26px 20px;color:var(--muted)\\\">\\n    {{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>\\n  </footer>\\n</body>\\n</html>\"}  \nBUNDLE_END"
        }
