          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Rates — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Deep, safety-first aromatherapy intensives and session bundles by {{PRACTITIONER_NAME}}.\\\">\\n  <style>\\n    :root{--bg:#FBF7F2;--accent:#C87C3A;--accent-2:#7B4F2E;--muted:#7A6B5E;--card:#FFF6EF;--glass:rgba(255,255,255,0.6);} \\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial; color:var(--accent-2);background:linear-gradient(180deg,var(--bg),#F7EFE8);} \\n    header{position:relative;padding:36px 24px 10px;background:linear-gradient(180deg,rgba(200,124,58,0.06),transparent);}\\n    header .nav{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#E6B08B);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;box-shadow:0 6px 18px rgba(120,70,30,0.12)}\\n    nav a{color:var(--accent-2);text-decoration:none;font-weight:600;margin-left:12px}\\n    .hero{max-width:1100px;margin:22px auto;padding:36px;background:url('assets/img/pattern.svg'),linear-gradient(180deg,rgba(255,255,255,0.85),var(--glass));border-radius:14px;display:grid;grid-template-columns:1fr 340px;gap:20px;align-items:center}\\n    .hero h1{margin:0;font-size:28px;letter-spacing:-0.02em}\\n    .hero p.lead{margin:10px 0;color:var(--muted)}\\n    .hero .aside{background:linear-gradient(180deg,#FFF,#FFF6EF);padding:20px;border-radius:12px;box-shadow:0 8px 30px rgba(120,70,30,0.06)}\\n    .price-card{background:var(--card);padding:18px;border-radius:12px;margin-bottom:14px}\\n    .price-card h3{margin:0 0 8px 0}\\n    .price{font-size:22px;color:var(--accent);font-weight:700}\\n    .features{list-style:none;padding:0;margin:12px 0 0 0;color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:24px 0}\\n    .pkg{background:white;padding:18px;border-radius:12px;box-shadow:0 10px 30px rgba(120,70,30,0.06);border:1px solid rgba(123,79,46,0.06)}\\n    .pkg h4{margin:0 0 8px 0}\\n    .cta{display:inline-block;padding:10px 16px;background:var(--accent);color:white;border-radius:10px;text-decoration:none;font-weight:700}\\n    .muted{color:var(--muted);font-size:14px}\\n    section{max-width:1100px;margin:28px auto;padding:0 24px}\\n    .testimonials{display:flex;gap:16px;flex-wrap:wrap}\\n    .testi{background:linear-gradient(180deg,#FFF6EF,white);padding:14px;border-radius:10px;flex:1 1 320px;box-shadow:0 8px 22px rgba(120,70,30,0.04)}\\n    .process{display:flex;gap:12px;flex-wrap:wrap}\\n    .step{background:linear-gradient(180deg,#FFF,#FFF6EF);padding:14px;border-radius:10px;flex:1 1 180px}\\n    .faq{display:grid;grid-template-columns:1fr 1fr;gap:12px}\\n    .faq-item{background:white;padding:12px;border-radius:8px;box-shadow:0 6px 18px rgba(120,70,30,0.04)}\\n    .leadmag{display:flex;gap:12px;align-items:center;margin-top:12px}\\n    .leadmag input{flex:1;padding:10px;border-radius:8px;border:1px solid rgba(120,70,30,0.12)}\\n    footer{padding:20px;text-align:center;color:var(--muted);font-size:14px}\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}.faq{grid-template-columns:1fr}.testimonials{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div class=\\\"brand\\\"><div class=\\\"logo\\\">A</div><div><strong>{{BUSINESS_NAME}}</strong><div class=\\\"muted\\\">{{CITY}}, {{STATE}}</div></div></div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"shop.html\\\">Shop</a>\\n        <a href=\\\"pricing.html\\\">Rates</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\" aria-labelledby=\\\"pricing-head\\\">\\n      <div>\\n        <h1 id=\\\"pricing-head\\\">Intensive sessions & tailored packages — grounded aromatherapy</h1>\\n        <p class=\\\"lead\\\">Results-oriented, safety-first scent work designed with intention. Choose a single intensive or a shaped package to dive deep with {{PRACTITIONER_NAME}}.</p>\\n        <div class=\\\"muted\\\">All sessions include a safety review and personalised dilution guidance. Aromatherapy is supportive and not a substitute for medical care.</div>\\n        <div style=\\\"margin-top:18px\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n      <aside class=\\\"aside\\\" aria-label=\\\"Popular packages\\\">\\n        <div class=\\\"price-card\\\">\\n          <h3>Deep Aroma Intensive</h3>\\n          <div class=\\\"price\\\">$320 — 90 minutes</div>\\n          <div class=\\\"muted\\\">A focused, guided session with take-home blend and safety plan.</div>\\n        </div>\\n        <div class=\\\"price-card\\\">\\n          <h3>3-Session Support Bundle</h3>\\n          <div class=\\\"price\\\">$840 — save 12%</div>\\n          <div class=\\\"muted\\\">Best for a small series of focused integrations and refinements.</div>\\n        </div>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\" style=\\\"display:inline-block;margin-top:6px\\\">Book an Intensive</a>\\n      </aside>\\n    </section>\\n\\n    <section>\\n      <h2 style=\\\"margin-bottom:8px\\\">What clients notice (without medical promises)</h2>\\n      <p class=\\\"muted\\\">Clients often report clearer scent awareness, ritualized self-care, and practical strategies for integrating aromatics into daily routines. Sessions emphasize safety, especially dilution and pet/pregnancy guidance.</p>\\n      <div class=\\\"grid\\\" aria-hidden=\\\"false\\\">\\n        <div class=\\\"pkg\\\">\\n          <h4>One Intensive</h4>\\n          <p class=\\\"muted\\\">90-min deep session, bespoke blend, post-session care notes.</p>\\n        </div>\\n        <div class=\\\"pkg\\\">\\n          <h4>Bundle: 3 Sessions</h4>\\n          <p class=\\\"muted\\\">Series for exploration + refinement over 8–12 weeks.</p>\\n        </div>\\n        <div class=\\\"pkg\\\">\\n          <h4>At-Home Kit Add-On</h4>\\n          <p class=\\\"muted\\\">Custom roll-on + diffuser protocol (shipping extra).</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h2>How an intensive unfolds</h2>\\n      <div class=\\\"process\\\">\\n        <div class=\\\"step\\\"><strong>1. Intake & safety check</strong><div class=\\\"muted\\\">Review medications, pregnancy/pets, allergies, and scent history.</div></div>\\n        <div class=\\\"step\\\"><strong>2. Guided scent exploration</strong><div class=\\\"muted\\\">Discover top/middle/base notes that resonate within session safety limits.</div></div>\\n        <div class=\\\"step\\\"><strong>3. Blend crafting</strong><div class=\\\"muted\\\">Create a personalized, labeled blend with dilution and usage notes.</div></div>\\n        <div class=\\\"step\\\"><strong>4. Integration plan</strong><div class=\\\"muted\\\">Simple rituals, storage, and when to seek extra medical advice.</div></div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h2>Trusted by people who love scent</h2>\\n      <div class=\\\"testimonials\\\">\\n        <div class=\\\"testi\\\"><strong>\\\"Warm, grounding and clear.\\\"</strong><div class=\\\"muted\\\">\\\"The intensive helped me tune into what I actually enjoy — and the dilution plan made it safe at home.\\\" — L.</div></div>\\n        <div class=\\\"testi\\\"><strong>\\\"Thoughtful and safe.\\\"</strong><div class=\\\"muted\\\">\\\"I appreciated how safety around pregnancy and pets was discussed openly.\\\" — M.</div></div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h2>FAQ — session & safety basics</h2>\\n      <div class=\\\"faq\\\">\\n        <div class=\\\"faq-item\\\"><strong>How is dilution handled?</strong><div class=\\\"muted\\\">Dilution recommendations are provided for skin safety (commonly 1–3% for adults depending on use). Exact dilutions will be clear on your label.</div></div>\\n        <div class=\\\"faq-item\\\"><strong>Do I need a patch test?</strong><div class=\\\"muted\\\">Yes — a small patch test is recommended before regular topical use. We'll guide you through it during your session.</div></div>\\n        <div class=\\\"faq-item\\\"><strong>What about pets?</strong><div class=\\\"muted\\\">We prioritise pet safety. Certain oils are not suitable around animals; we'll tailor guidance and suggest pet-friendly approaches.</div></div>\\n        <div class=\\\"faq-item\\\"><strong>Pregnancy & nursing note</strong><div class=\\\"muted\\\">If pregnant or nursing, we proceed conservatively and may avoid certain chemotypes. Always consult your healthcare provider as well.</div></div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h2>Stay in the loop (free guide)</h2>\\n      <p class=\\\"muted\\\">Grab a short PDF: \\\"Safe Basics — Dilution, Patch Tests & Home Use\\\" and get a 10% code for a kit.</p>\\n      <form class=\\\"leadmag\\\" action=\\\"#\\\" method=\\\"POST\\\" aria-label=\\\"Sign up for guide\\\">\\n        <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Your email\\\" required>\\n        <button class=\\\"cta\\\" type=\\\"submit\\\">Send the Guide</button>\\n      </form>\\n    </section>\\n\\n    <section style=\\\"margin-bottom:36px\\\">\\n      <h2>Ready to book an intensive?</h2>\\n      <p class=\\\"muted\\\">Pick a deep session to receive a clear, safety-first plan and a personalized blend. Sessions are offered in-person and remotely.</p>\\n      <a class=\\\"cta\\\" href=\\\"book.html\\\">Book with {{PRACTITIONER_NAME}}</a>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — {{TAGLINE}}</div>\\n    <div class=\\\"muted\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"About {{PRACTITIONER_NAME}} — a safety-first aromatherapist blending craft and care.\\\">\\n  <style>\\n    :root{--bg:#FBF8F6;--accent:#B36A2F;--accent-2:#5B3A2A;--muted:#7D6A5E;--card:#FFF9F4}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--accent-2);background:linear-gradient(180deg,var(--bg),#F6EFE7)}\\n    header{padding:26px 20px}\\n    .nav{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#E9B888);display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n    nav a{color:var(--accent-2);text-decoration:none;margin-left:14px}\\n    .wrap{max-width:1100px;margin:0 auto;padding:20px}\\n    .hero{background:url('assets/img/pattern.svg'),linear-gradient(180deg,rgba(255,255,255,0.9),white);padding:28px;border-radius:14px;display:flex;gap:20px;align-items:center}\\n    .hero h1{margin:0;font-size:26px}\\n    .byline{color:var(--muted);margin-top:8px}\\n    .profile{display:grid;grid-template-columns:220px 1fr;gap:18px;margin-top:18px}\\n    .card{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 8px 26px rgba(91,58,42,0.06)}\\n    .quote{font-style:italic;color:var(--accent-2)}\\n    .list{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px}\\n    .chip{background:white;padding:8px 10px;border-radius:999px;border:1px solid rgba(123,79,46,0.06);font-weight:600}\\n    .faq{margin-top:20px}\\n    .lead{display:flex;gap:12px;align-items:center;margin-top:12px}\\n    .lead input{padding:10px;border-radius:8px;border:1px solid rgba(123,79,46,0.08)}\\n    footer{padding:20px;text-align:center;color:var(--muted);margin-top:36px}\\n    @media (max-width:880px){.profile{grid-template-columns:1fr}.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div class=\\\"brand\\\"><div class=\\\"logo\\\">A</div><div><strong>{{BUSINESS_NAME}}</strong><div class=\\\"byline\\\">Curated scent & careful craft</div></div></div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"blends.html\\\">Our Blends</a>\\n        <a href=\\\"shop.html\\\">Shop</a>\\n        <a href=\\\"pricing.html\\\">Rates</a>\\n        <a href=\\\"about.html\\\">Who I Am</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n        <a href=\\\"contact.html\\\">Say Hi</a>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1>Meet {{PRACTITIONER_NAME}}</h1>\\n        <p class=\\\"byline\\\">A playful, premium approach to scent that keeps safety at the centre. I combine craft, science-respect, and ritual to make aromatics useful and delightful.</p>\\n        <p style=\\\"margin-top:10px\\\" class=\\\"muted\\\">{{BUSINESS_NAME}} is based in {{CITY}}, {{STATE}} — offering in-person and virtual sessions.</p>\\n      </div>\\n      <aside style=\\\"width:260px\\\" class=\\\"card\\\">\\n        <div class=\\\"quote\\\">\\\"Scent is a small, daily practice that can brighten a routine — done with clarity and care.\\\"</div>\\n        <div style=\\\"margin-top:10px;color:var(--muted)\\\">Connect: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"profile\\\">\\n      <div class=\\\"card\\\">\\n        <h3>My approach</h3>\\n        <p class=\\\"muted\\\">I create blends that are intentionally simple, tested for safety, and labelled clearly. No grand medical promises — only practical support for daily rituals and sensory attunement.</p>\\n        <div class=\\\"list\\\">\\n          <div class=\\\"chip\\\">Safety-first</div>\\n          <div class=\\\"chip\\\">Plant respect</div>\\n          <div class=\\\"chip\\\">Dilution guidance</div>\\n          <div class=\\\"chip\\\">Pet-aware</div>\\n        </div>\\n      </div>\\n\\n      <div>\\n        <div class=\\\"card\\\">\\n          <h3>Background</h3>\\n          <p class=\\\"muted\\\">Years of study and hands-on crafting with a focus on chemistry awareness and ethical sourcing. My work is informed by aroma chemistry, safe practice, and client-centered ritual design.</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h3>Sessions & offerings</h3>\\n          <p class=\\\"muted\\\">From single intensives to series and at-home kits. Every service includes clear usage and storage instructions.</p>\\n          <a class=\\\"cta\\\" href=\\\"services.html\\\" style=\\\"display:inline-block;margin-top:10px;padding:8px 12px;background:var(--accent);color:white;border-radius:8px;text-decoration:none;font-weight:700\\\">Explore Services</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h3>Testimonials</h3>\\n      <div style=\\\"display:flex;gap:12px;flex-wrap:wrap;margin-top:10px\\\">\\n        <div style=\\\"flex:1 1 260px;background:#fff;padding:12px;border-radius:10px\\\">\\\"They mix scents like a thoughtful friend—warm and honest.\\\"<div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">— R.</div></div>\\n        <div style=\\\"flex:1 1 260px;background:#fff;padding:12px;border-radius:10px\\\">\\\"Clear instructions and a safe plan for using blends at home.\\\"<div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">— H.</div></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq card\\\" style=\\\"margin-top:18px;padding:16px\\\">\\n      <h3>Common questions</h3>\\n      <div style=\\\"margin-top:8px\\\">\\n        <strong>Are oils safe during pregnancy?</strong>\\n        <p class=\\\"muted\\\">We take a conservative approach. If pregnant or nursing, some oils are avoided; we provide alternatives and always advise consulting your healthcare provider.</p>\\n      </div>\\n      <div style=\\\"margin-top:8px\\\">\\n        <strong>Can I use blends around pets?</strong>\\n        <p class=\\\"muted\\\">Not all oils are animal-safe. We'll share pet-specific recommendations and non-topical options when needed.</p>\\n      </div>\\n      <div style=\\\"margin-top:8px\\\">\\n        <strong>Do you make custom blends?</strong>\\n        <p class=\\\"muted\\\">Yes — custom blends are part of intensives and bundles. Each comes with dilution percentages and storage tips.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h3>Get my short guide</h3>\\n      <p class=\\\"muted\\\">Subscribe for a friendly primer: \\\"Beginner's Safe Scenting\\\" and occasional notes on blends and specials.</p>\\n      <form class=\\\"lead\\\" action=\\\"#\\\" method=\\\"POST\\\">\\n        <input type=\\\"email\\\" placeholder=\\\"Your email\\\" required>\\n        <button class=\\\"cta\\\" style=\\\"border:none\\\">Send it</button>\\n      </form>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <a class=\\\"cta\\\" href=\\\"book.html\\\">Schedule a chat with {{PRACTITIONER_NAME}}</a>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — {{TAGLINE}} • {{CITY}}, {{STATE}}</div>\\n    <div class=\\\"muted\\\">Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a session — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Reserve a session with {{PRACTITIONER_NAME}} — safety-first aromatherapy sessions and intensives.\\\">\\n  <style>\\n    :root{--bg:#FFF8F2;--accent:#A65A2B;--accent-2:#4F2F23;--muted:#7A675A}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;background:linear-gradient(180deg,var(--bg),#F4ECE3);color:var(--accent-2)}\\n    header{padding:20px}\\n    .nav{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}\\n    .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#E7B287);display:flex;align-items:center;justify-content:center;color:white}\\n    nav a{margin-left:12px;text-decoration:none;color:var(--accent-2);font-weight:600}\\n    main{max-width:1100px;margin:18px auto;padding:0 20px}\\n    .hero{background:url('assets/img/pattern.svg'),linear-gradient(180deg,rgba(255,255,255,0.95),white);padding:22px;border-radius:14px}\\n    .hero h1{margin:0;font-size:26px}\\n    .muted{color:var(--muted)}\\n    .booking{display:grid;grid-template-columns:1fr 360px;gap:18px;margin-top:18px}\\n    .form{background:white;padding:16px;border-radius:12px;box-shadow:0 8px 28px rgba(80,48,30,0.06)}\\n    label{display:block;margin-top:10px;font-weight:600}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(120,70,30,0.08);margin-top:6px}\\n    .aside{background:linear-gradient(180deg,#FFF6EF,white);padding:16px;border-radius:12px}\\n    .steps{display:flex;flex-direction:column;gap:10px}\\n    .step{background:white;padding:10px;border-radius:8px}\\n    .cta{display:inline-block;padding:10px 14px;background:var(--accent);color:white;border-radius:10px;text-decoration:none;font-weight:700}\\n    .faq{margin-top:16px}\\n    footer{padding:18px;text-align:center;color:var(--muted);margin-top:20px}\\n    @media (max-width:880px){.booking{grid-template-columns:1fr}.aside{order:2}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"nav\\\">\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\"><div class=\\\"logo\\\">A</div><div><strong>{{BUSINESS_NAME}}</strong><div class=\\\"muted\\\">Book a session</div></div></div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"blends.html\\\">Blends to Try</a>\\n        <a href=\\\"shop.html\\\">Store</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <h1>Reserve your aromatherapy session</h1>\\n      <p class=\\\"muted\\\">Choose an intensive, a single consult, or a short series. Every booking includes a safety review, dilution notes, and a clear care plan.</p>\\n    </section>\\n\\n    <div class=\\\"booking\\\">\\n      <form class=\\\"form\\\" action=\\\"#\\\" method=\\\"POST\\\" aria-label=\\\"Booking form\\\">\\n        <h3>Book — tell me a bit</h3>\\n        <label for=\\\"name\\\">Full name</label>\\n        <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" required>\\n\\n        <label for=\\\"email\\\">Email</label>\\n        <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required>\\n\\n        <label for=\\\"phone\\\">Phone</label>\\n        <input id=\\\"phone\\\" name=\\\"phone\\\" type=\\\"tel\\\">\\n\\n        <label for=\\\"service\\\">Service</label>\\n        <select id=\\\"service\\\" name=\\\"service\\\" required>\\n          <option>Deep Aroma Intensive — 90 min</option>\\n          <option>Single Consult — 60 min</option>\\n          <option>3-Session Bundle</option>\\n        </select>\\n\\n        <label for=\\\"notes\\\">Notes (allergies, pregnancy, pets, goals)</label>\\n        <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Please mention pregnancy, pets in the home, any essential oil allergies, and what you'd like to focus on.\\\"></textarea>\\n\\n        <div style=\\\"margin-top:12px;display:flex;gap:10px;align-items:center\\\">\\n          <button class=\\\"cta\\\" type=\\\"submit\\\">Request Booking</button>\\n          <a href=\\\"mailto:{{EMAIL}}\\\" class=\\\"muted\\\">Email: {{EMAIL}}</a>\\n        </div>\\n\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">After you request, {{PRACTITIONER_NAME}} will follow up to confirm time, discuss safety, and share preparatory notes.</p>\\n      </form>\\n\\n      <aside class=\\\"aside\\\">\\n        <h4>How booking works</h4>\\n        <div class=\\\"steps\\\">\\n          <div class=\\\"step\\\"><strong>1.</strong> You request a slot and share safety notes (pregnancy/pets/allergies).</div>\\n          <div class=\\\"step\\\"><strong>2.</strong> We confirm and send a short intake form and payment options.</div>\\n          <div class=\\\"step\\\"><strong>3.</strong> Session occurs (in-person or virtual) with a labeled blend and a clear dilution plan.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <h4>Quick notes on safety</h4>\\n          <p class=\\\"muted\\\">No medical claims are made. All recommendations are supportive, not diagnostic. For pregnancy, certain oils may be avoided and we will discuss alternatives.</p>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <a class=\\\"cta\\\" href=\\\"pricing.html\\\">See Rates</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section class=\\\"faq\\\">\\n      <h3>Booking FAQs</h3>\\n      <div style=\\\"margin-top:8px\\\">\\n        <strong>Do you require a patch test?</strong>\\n        <p class=\\\"muted\\\">We recommend a patch test before consistent topical use. During the session we'll guide you through performing one safely.</p>\\n      </div>\\n\\n      <div style=\\\"margin-top:8px\\\">\\n        <strong>What if I have pets?</strong>\\n        <p class=\\\"muted\\\">Please mention pets in your notes. We'll offer pet-safe alternatives and advice on ventilation, placement, and which oils to avoid.</p>\\n      </div>\\n\\n      <div style=\\\"margin-top:8px\\\">\\n        <strong>Pregnancy & nursing guidance</strong>\\n        <p class=\\\"muted\\\">We proceed conservatively for pregnancy and nursing, avoiding certain essential oils and sharing non-topical options. Always consult your healthcare provider too.</p>\\n      </div>\\n\\n      <div style=\\\"margin-top:8px\\\">\\n        <strong>Cancellation & reschedules</strong>\\n        <p class=\\\"muted\\\">Please contact us 48 hours before to reschedule. Shorter notice may incur a fee depending on the package.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;background:linear-gradient(180deg,#FFF6EF,white);padding:14px;border-radius:10px\\\">\\n      <h3>Curious before you commit?</h3>\\n      <p class=\\\"muted\\\">Request a 15-minute complimentary call to see if an intensive is right for you.</p>\\n      <form style=\\\"display:flex;gap:8px;align-items:center\\\" action=\\\"#\\\" method=\\\"POST\\\">\\n        <input type=\\\"email\\\" placeholder=\\\"Email for call link\\\" required>\\n        <button class=\\\"cta\\\" type=\\\"submit\\\">Request Call</button>\\n      </form>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"muted\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    <div style=\\\"margin-top:6px\\\">© {{BUSINESS_NAME}}</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
