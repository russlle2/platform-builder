          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Plans — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Transparent packages for aromatherapy sessions and VIP days. Safety-first, custom blends, and practical aromatic solutions.\\\" />\\n  <style>\\n    :root{--bg1:#FFFBF6;--accent:#7ED957;--accent-dark:#5EA63E;--muted:#6B6B6B;--card:#FFFFFF;--glass:rgba(255,255,255,0.6);--shadow:0 8px 24px rgba(33,33,33,0.08)}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:#12222E;background:linear-gradient(180deg,#FFFDF8 0%,#F6FFF2 100%);}\\n    body{background-image:url('assets/img/pattern.svg');background-repeat:repeat;}\\n    .wrap{max-width:1100px;margin:28px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:54px;height:54px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#8EF3B0);display:grid;place-items:center;color:#0B3D1A;font-weight:700}\\n    nav a{margin-left:14px;color:#0B3D1A;text-decoration:none;font-weight:600;font-size:14px}\\n    nav a.cta{background:var(--accent);color:white;padding:10px 14px;border-radius:10px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;margin-bottom:28px}\\n    .hero .kicker{font-size:13px;color:var(--muted);text-transform:uppercase;letter-spacing:1px}\\n    .hero h1{margin:6px 0 12px;font-size:28px;color:#092427}\\n    .hero p{color:#234B44;line-height:1.45}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:var(--shadow);}\\n    .price{font-size:32px;font-weight:800;color:#092427}\\n    .features{margin-top:12px;color:#2F4F4A}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:22px 0}\\n    .plan{padding:18px;border-radius:12px;background:linear-gradient(180deg,#FFFFFF,#F7FFF3);border:1px solid rgba(94,166,62,0.06)}\\n    .plan h3{margin:0 0 8px}\\n    .plan ul{margin:8px 0 12px;padding-left:18px;color:#33544F}\\n    .plan .cta{display:inline-block;padding:10px 12px;border-radius:10px;background:var(--accent-dark);color:white;text-decoration:none}\\n    .muted{color:var(--muted);font-size:14px}\\n    .testimonials{display:flex;gap:12px;margin:18px 0}\\n    .bubble{background:linear-gradient(180deg,#FFFFFF,#F1FFF2);padding:12px;border-radius:12px;box-shadow:0 6px 18px rgba(20,60,40,0.06);flex:1}\\n    .process{display:flex;gap:12px;margin:18px 0}\\n    .step{flex:1;background:var(--glass);padding:12px;border-radius:10px}\\n    details{background:var(--card);padding:12px;border-radius:10px;margin-top:14px}\\n    .lead{display:flex;gap:12px;align-items:center;margin-top:18px}\\n    .lead input{flex:1;padding:12px;border-radius:10px;border:1px solid #e7e7e7}\\n    .lead button{background:var(--accent-dark);color:white;padding:12px 14px;border-radius:10px;border:none}\\n    footer{margin-top:28px;color:var(--muted);font-size:13px}\\n    @media (max-width:900px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}.wrap{padding:16px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">AR</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Work</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"shop.html\\\">Shop</a>\\n        <a href=\\\"pricing.html\\\" style=\\\"font-weight:800\\\">Plans</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"book.html\\\" class=\\\"cta\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <div class=\\\"kicker\\\">Investment & Packages</div>\\n        <h1>Clear pricing for focused aromatherapy — safety-first, bespoke blends</h1>\\n        <p>Choose from streamlined packages designed for practical results and a calm, guided experience. All sessions include safety review, dilution guidance, and a take-home blend recipe.</p>\\n\\n        <div class=\\\"card\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div class=\\\"muted\\\">Most comprehensive</div>\\n              <div class=\\\"price\\\">VIP Day — custom intensive</div>\\n            </div>\\n            <div style=\\\"text-align:right\\\">\\n              <div class=\\\"muted\\\">One-day deep dive</div>\\n              <a class=\\\"cta\\\" href=\\\"book.html\\\">Book VIP Day</a>\\n            </div>\\n          </div>\\n          <div class=\\\"features\\\">Includes consultation, two bespoke blends, safety notes, and implementation plan.</div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <div style=\\\"font-weight:700;margin-bottom:6px\\\">Quick comparison</div>\\n        <div class=\\\"grid\\\" style=\\\"grid-template-columns:1fr;\\\">\\n          <div style=\\\"display:flex;gap:10px;align-items:center;margin-bottom:8px\\\"><div style=\\\"width:10px;height:10px;background:#7ED957;border-radius:50%\\\"></div><div class=\\\"muted\\\">Single session — great for one targeted blend</div></div>\\n          <div style=\\\"display:flex;gap:10px;align-items:center;margin-bottom:8px\\\"><div style=\\\"width:10px;height:10px;background:#8EE4B9;border-radius:50%\\\"></div><div class=\\\"muted\\\">Starter pack — blend + 2-week check-in</div></div>\\n          <div style=\\\"display:flex;gap:10px;align-items:center\\\"><div style=\\\"width:10px;height:10px;background:#5EA63E;border-radius:50%\\\"></div><div class=\\\"muted\\\">VIP Day — full planning, toolkit & follow-up</div></div>\\n        </div>\\n        <div style=\\\"margin-top:10px\\\" class=\\\"muted\\\">All plans come with dilution guidance and patch test instructions.</div>\\n      </aside>\\n    </section>\\n\\n    <section>\\n      <div style=\\\"font-weight:700;margin-bottom:10px\\\">Package highlights</div>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"plan\\\">\\n          <h3>Single Session</h3>\\n          <div class=\\\"muted\\\">60 minutes</div>\\n          <ul>\\n            <li>Consultation & priorities</li>\\n            <li>One personalized roller or blend recipe</li>\\n            <li>Patch test + dilution plan</li>\\n          </ul>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve</a>\\n        </div>\\n        <div class=\\\"plan\\\">\\n          <h3>Starter Pack</h3>\\n          <div class=\\\"muted\\\">Session + 2-week follow-up</div>\\n          <ul>\\n            <li>Custom blend + how-to</li>\\n            <li>Usage & storage tips</li>\\n            <li>Email support</li>\\n          </ul>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Choose</a>\\n        </div>\\n        <div class=\\\"plan\\\">\\n          <h3>VIP Day</h3>\\n          <div class=\\\"muted\\\">Full-day immersion</div>\\n          <ul>\\n            <li>Deep consultation & lifestyle plan</li>\\n            <li>Two bespoke blends + sample kit</li>\\n            <li>Implementation guide & follow-up</li>\\n          </ul>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Book VIP Day</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <div style=\\\"font-weight:700;margin:18px 0 10px\\\">What clients notice</div>\\n      <div class=\\\"testimonials\\\">\\n        <div class=\\\"bubble\\\">\\\"Practical, grounded, and safe — I left with a simple, useful blend I actually used every day.\\\" — A.M.</div>\\n        <div class=\\\"bubble\\\">\\\"Clear instructions on patch testing and dilution made all the difference.\\\" — J.R.</div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <div style=\\\"font-weight:700;margin-top:12px\\\">How the booking & session flow</div>\\n      <div class=\\\"process\\\">\\n        <div class=\\\"step\\\"><strong>1.</strong> Pre-session intake & safety check (allergies, medications, pregnancy status, pets in the home).</div>\\n        <div class=\\\"step\\\"><strong>2.</strong> In-depth consultation, scent exploration, and blend creation.</div>\\n        <div class=\\\"step\\\"><strong>3.</strong> Clear take-home instructions: dilution ratios, patch test, storage, and an implementation plan.</div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <div style=\\\"font-weight:700;margin-top:12px\\\">FAQ — safety essentials</div>\\n      <details>\\n        <summary>What dilution should I use?</summary>\\n        <div class=\\\"muted\\\">Dilution depends on age, skin sensitivity, and intended use. Typical topical dilutions range from 0.5% (sensitive) to 5% (adult spot treatments). Your session includes a tailored dilution guide.</div>\\n      </details>\\n      <details>\\n        <summary>How do I do a patch test?</summary>\\n        <div class=\\\"muted\\\">Apply a small diluted amount to the inner forearm, cover for 24 hours, and watch for redness or irritation. If any reaction occurs, discontinue use and consult the session notes.</div>\\n      </details>\\n      <details>\\n        <summary>Are essential oils safe around pets?</summary>\\n        <div class=\\\"muted\\\">Some oils can affect pets. We take pet-safety seriously: we'll review any animals in your household and tailor blends and usage recommendations accordingly.</div>\\n      </details>\\n      <details>\\n        <summary>What about pregnancy?</summary>\\n        <div class=\\\"muted\\\">Pregnancy requires special precautions. If you are pregnant or breastfeeding we will adapt recommendations and avoid oils known to be contraindicated. No medical advice is given; we focus on safety and referral when needed.</div>\\n      </details>\\n    </section>\\n\\n    <section>\\n      <div style=\\\"font-weight:700;margin-top:18px\\\">Free resource — Blend Essentials Checklist</div>\\n      <div class=\\\"card\\\" style=\\\"display:flex;gap:12px;align-items:center\\\">\\n        <div style=\\\"flex:1\\\">Get a practical checklist for patch testing, safe dilutions, and storage tips.\\n        </div>\\n        <form class=\\\"lead\\\" onsubmit=\\\"event.preventDefault();alert('Thanks! We\\\\'ll send the checklist to the email provided.');\\\">\\n          <input aria-label=\\\"email\\\" placeholder=\\\"Your email\\\" required type=\\\"email\\\" />\\n          <button type=\\\"submit\\\">Send</button>\\n        </form>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px;text-align:center\\\">\\n      <div style=\\\"font-weight:800;font-size:18px;margin-bottom:8px\\\">Ready to book a focused session?</div>\\n      <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"cta\\\" style=\\\"padding:14px 22px;font-size:16px\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Prefer to talk? Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Meet the practitioner: a practical, safety-first approach to aromatherapy and bespoke blends.\\\" />\\n  <style>\\n    :root{--bg:#FFFDF8;--primary:#D6FFE0;--ink:#06363A;--accent:#6ED08E;--soft:#F6FFFA}\\n    html,body{margin:0;font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial;background:linear-gradient(180deg,#FFFDF8,#F9FFF6);color:var(--ink)}\\n    .site{max-width:1000px;margin:32px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:52px;height:52px;border-radius:12px;background:linear-gradient(135deg,#9DF0A5,#5EB976);display:grid;place-items:center;color:#02321A;font-weight:800}\\n    nav a{margin-left:12px;text-decoration:none;color:var(--ink);font-weight:600}\\n    nav a.secondary{color:#285A54}\\n    .hero{display:grid;grid-template-columns:1fr 320px;gap:20px;align-items:start;margin-bottom:20px}\\n    h1{margin:0 0 10px}\\n    .bio{background:var(--soft);padding:18px;border-radius:12px;box-shadow:0 10px 24px rgba(15,50,40,0.06)}\\n    .pill{display:inline-block;background:var(--primary);padding:8px 12px;border-radius:999px;font-weight:700}\\n    .quote{font-style:italic;color:#234B45}\\n    .grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}\\n    .box{background:white;padding:14px;border-radius:12px;box-shadow:0 6px 18px rgba(20,60,40,0.05)}\\n    details{margin-top:12px}\\n    .lead{margin-top:18px;background:linear-gradient(180deg,#FFFFFF,#F7FFF3);padding:12px;border-radius:12px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;background:#5EA63E;color:white;border-radius:10px;text-decoration:none}\\n    footer{margin-top:22px;color:#6B6B6B;font-size:13px}\\n    @media (max-width:900px){.hero{grid-template-columns:1fr};.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">AR</div>\\n        <div>\\n          <strong>{{BUSINESS_NAME}}</strong>\\n          <div style=\\\"font-size:12px;color:#3F6B64\\\">Practical aromatherapy for everyday life</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"shop.html\\\" class=\\\"secondary\\\">Boutique</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <div class=\\\"pill\\\">Meet the practitioner</div>\\n        <h1>{{PRACTITIONER_NAME}} — hands-on aromatherapy, safety-first</h1>\\n        <p class=\\\"bio\\\">I combine botanical knowledge with a practical lens: no mysticism, just clear, safe, and effective aromatic tools you can use at home. Sessions are individualized and include written safety guidance so you never have to guess dilution or patch-test techniques.</p>\\n\\n        <div class=\\\"grid\\\">\\n          <div class=\\\"box\\\">\\n            <strong>Roots</strong>\\n            <p class=\\\"muted\\\">Trained in clinical aromatic safety and years of client work focused on sustainable, low-waste practices.</p>\\n          </div>\\n          <div class=\\\"box\\\">\\n            <strong>Philosophy</strong>\\n            <p class=\\\"muted\\\">Practical rituals, measurable routines, and blends that fit the life you actually live.</p>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"box\\\">\\n          <div style=\\\"font-weight:700\\\">Why work this way?</div>\\n          <div class=\\\"quote\\\">\\\"Clear guidance wins over complicated theory every time.\\\"</div>\\n          <div style=\\\"margin-top:10px\\\"><a href=\\\"book.html\\\" class=\\\"cta\\\">Book a consult</a></div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section>\\n      <div style=\\\"font-weight:700\\\">Client stories</div>\\n      <div style=\\\"display:flex;gap:10px;margin-top:10px;flex-wrap:wrap\\\">\\n        <div class=\\\"box\\\" style=\\\"flex:1;min-width:220px\\\">\\\"Practical steps and a roller I actually used daily.\\\" — S.</div>\\n        <div class=\\\"box\\\" style=\\\"flex:1;min-width:220px\\\">\\\"Loved the pet-safety review and clear instructions.\\\" — K.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div style=\\\"font-weight:700\\\">Approach & what to expect</div>\\n      <ol style=\\\"margin-top:10px;color:#2F4F4A\\\">\\n        <li>Intake & safety review (medications, pregnancy, animals).</li>\\n        <li>Scent exploration with practical notes on use and dilution.</li>\\n        <li>Take-home recipe, patch test plan, and follow-up guidance.</li>\\n      </ol>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div style=\\\"font-weight:700\\\">Safety-first FAQ</div>\\n      <details>\\n        <summary>How is dilation explained?</summary>\\n        <div class=\\\"muted\\\">Dilution is provided as a percentage with examples (eg 1% = 6 drops in 30ml carrier). We always favor conservative dilutions unless otherwise agreed.</div>\\n      </details>\\n      <details>\\n        <summary>Do you recommend patch tests?</summary>\\n        <div class=\\\"muted\\\">Yes — every topical recommendation includes a patch test protocol and an alternative if you have sensitivities.</div>\\n      </details>\\n      <details>\\n        <summary>Will you consider my pet(s)?</summary>\\n        <div class=\\\"muted\\\">Yes. We ask about household animals and adapt blends and usage to reduce risk. We avoid strong, persistent diffusion when pets are present.</div>\\n      </details>\\n      <details>\\n        <summary>Pregnancy & essential oils</summary>\\n        <div class=\\\"muted\\\">Pregnancy involves modifications. We avoid oils commonly recommended against in pregnancy and provide clear, conservative options. This is safety guidance, not medical advice.</div>\\n      </details>\\n    </section>\\n\\n    <section class=\\\"lead\\\">\\n      <div style=\\\"font-weight:700\\\">Free Starter Pack</div>\\n      <p class=\\\"muted\\\">Download a concise starter guide — patch testing, carrier oils, and safe storage.</p>\\n      <form onsubmit=\\\"event.preventDefault();alert('Starter pack will be emailed to you once we set up the list.');\\\">\\n        <input placeholder=\\\"Your email\\\" required type=\\\"email\\\" style=\\\"padding:10px;border-radius:8px;border:1px solid #e7efe9;margin-right:8px\\\" />\\n        <button style=\\\"padding:10px 12px;border-radius:8px;background:#5EA63E;color:white;border:none\\\">Get it</button>\\n      </form>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;text-align:center\\\">\\n      <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"cta\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      <div style=\\\"margin-top:8px;color:#6B6B6B\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"margin-top:20px;color:#6B6B6B\\\">{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Book a Session — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Schedule a session or VIP day. Intake includes safety screening and personalized blend planning.\\\" />\\n  <style>\\n    :root{--bg:#F8FFF6;--card:#FFFFFF;--accent:#7ED957;--deep:#0E3F32;--muted:#546965}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial;background:linear-gradient(180deg,#F8FFF6,#F2FFF1);color:var(--deep)}\\n    .container{max-width:920px;margin:28px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,#9EF0A8,#5EB776);display:grid;place-items:center;color:#04321A;font-weight:800}\\n    nav a{margin-left:12px;text-decoration:none;color:var(--deep);font-weight:600}\\n    .hero{margin-top:18px;background:linear-gradient(180deg,#FFFFFF,#F7FFF3);padding:18px;border-radius:14px;box-shadow:0 10px 28px rgba(8,40,33,0.06)}\\n    .two{display:grid;grid-template-columns:1fr 360px;gap:18px;margin-top:14px}\\n    label{display:block;margin-top:10px;font-size:13px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #E6F2EA}\\n    button{background:var(--accent);color:white;padding:12px 16px;border-radius:10px;border:none;font-weight:700}\\n    .side{background:var(--card);padding:14px;border-radius:12px;box-shadow:0 6px 20px rgba(20,60,40,0.04)}\\n    .muted{color:var(--muted);font-size:14px}\\n    details{margin-top:12px}\\n    .faq{margin-top:16px}\\n    @media (max-width:900px){.two{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div class=\\\"logo\\\">AR</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">Schedule a session — straightforward booking with safety review</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <main class=\\\"hero\\\">\\n      <h1 style=\\\"margin:0\\\">Book a session or VIP Day</h1>\\n      <p class=\\\"muted\\\">Choose a focused option and complete the intake so we can keep your session safe and personalized.</p>\\n\\n      <div class=\\\"two\\\">\\n        <div>\\n          <form id=\\\"bookingForm\\\" onsubmit=\\\"handleSubmit(event)\\\">\\n            <label>Full name <input name=\\\"name\\\" required /></label>\\n            <label>Email <input name=\\\"email\\\" type=\\\"email\\\" required /></label>\\n            <label>Phone <input name=\\\"phone\\\" /></label>\\n\\n            <label>Service\\n              <select name=\\\"service\\\" required>\\n                <option value=\\\"Single Session\\\">Single Session — 60 min</option>\\n                <option value=\\\"Starter Pack\\\">Starter Pack — session + follow-up</option>\\n                <option value=\\\"VIP Day\\\">VIP Day — full-day intensive</option>\\n              </select>\\n            </label>\\n\\n            <label>Preferred dates (3 options)</label>\\n            <input name=\\\"dates\\\" placeholder=\\\"e.g. May 12, May 19, May 24\\\" />\\n\\n            <label>Household & safety notes</label>\\n            <textarea name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Allergies, pregnancy, pets, medications, sensitive skin\\\"></textarea>\\n\\n            <div style=\\\"margin-top:12px;display:flex;gap:8px;align-items:center\\\">\\n              <input type=\\\"checkbox\\\" id=\\\"consent\\\" required />\\n              <label for=\\\"consent\\\" class=\\\"muted\\\">I understand this is safety guidance and not medical advice.</label>\\n            </div>\\n\\n            <div style=\\\"margin-top:14px;display:flex;gap:12px\\\">\\n              <button type=\\\"submit\\\">Request booking</button>\\n              <a href=\\\"tel:{{PHONE}}\\\" style=\\\"padding:12px 14px;border-radius:10px;background:#F0FFF2;color:var(--deep);text-decoration:none\\\">Call to book</a>\\n            </div>\\n          </form>\\n\\n          <div class=\\\"faq\\\">\\n            <div style=\\\"font-weight:700\\\">Quick safety Qs</div>\\n            <details>\\n              <summary>Dilution guidance?</summary>\\n              <div class=\\\"muted\\\">You will receive a specific dilution plan. Typical topicals are 0.5–5% depending on use and sensitivity.</div>\\n            </details>\\n            <details>\\n              <summary>Patch test instructions</summary>\\n              <div class=\\\"muted\\\">Apply a small diluted sample to the inner forearm and observe for 24 hours. If irritation occurs, discontinue and contact us.</div>\\n            </details>\\n            <details>\\n              <summary>Pets & essential oils</summary>\\n              <div class=\\\"muted\\\">Tell us about any pets. We'll avoid or adapt diffusing recommendations when animals are present and select pet-safer options.</div>\\n            </details>\\n            <details>\\n              <summary>Pregnancy considerations</summary>\\n              <div class=\\\"muted\\\">Pregnancy requires conservative selections. We will avoid oils typically contraindicated and prioritize neutral, gentle options.</div>\\n            </details>\\n          </div>\\n        </div>\\n\\n        <aside class=\\\"side\\\">\\n          <div style=\\\"font-weight:700\\\">Before your session</div>\\n          <ul style=\\\"margin-top:8px;color:var(--muted)\\\">\\n            <li>Complete intake above with any health or pet notes.</li>\\n            <li>Avoid strong perfumes on the day.</li>\\n            <li>Have a list of current medications and supplements ready.</li>\\n          </ul>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <div style=\\\"font-weight:700\\\">Need help deciding?</div>\\n            <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n            <div style=\\\"margin-top:12px\\\">\\n              <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"cta\\\" style=\\\"display:inline-block;padding:10px 12px;background:var(--accent);color:white;border-radius:10px;text-decoration:none\\\">{{PRIMARY_CTA_LABEL}}</a>\\n            </div>\\n          </div>\\n        </aside>\\n      </div>\\n    </main>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted)\\\">\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n\\n  <script>\\n    function handleSubmit(e){\\n      e.preventDefault();\\n      const form = document.getElementById('bookingForm');\\n      const data = new FormData(form);\\n      // Lightweight client-side confirmation — replace with server call in production\\n      alert('Thanks, ' + (data.get('name')||'') + '! Booking request received. We\\\\'ll follow up at ' + (data.get('email')||'') + '.');\\n      form.reset();\\n    }\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
