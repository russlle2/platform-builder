          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Services — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f7efe7;--accent:#a76b3b;--muted:#6b6b6b;--card:#fff;--glass:rgba(255,255,255,0.6)}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:#2b2b2b;background:linear-gradient(180deg,#fbf6f0 0%,var(--bg) 100%);}\\n    body{background-image:url(\\\"assets/img/pattern.svg\\\");background-repeat:repeat;background-size:320px;}\\n    .wrap{max-width:1100px;margin:28px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:54px;height:54px;border-radius:10px;background:linear-gradient(135deg,#f0d9c3,#e1b690);box-shadow:0 6px 18px rgba(15,10,8,0.08);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent)}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none;font-size:15px}\\n    nav a:nth-child(2){color:var(--accent);font-weight:600}\\n    .hero{background:linear-gradient(180deg,rgba(167,107,59,0.06),transparent);padding:28px;border-radius:14px;display:grid;grid-template-columns:1fr 340px;gap:22px;align-items:center}\\n    .hero h1{margin:0;font-size:28px;color:#3b2b22}\\n    .hero p{margin:8px 0 0;color:var(--muted)}\\n    .cta{display:flex;gap:10px;margin-top:14px}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:8px;text-decoration:none}\\n    .mutebtn{background:transparent;border:1px solid #e0d6d0;padding:10px 12px;border-radius:8px;color:var(--muted)}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 8px 24px rgba(15,10,8,0.04)}\\n    .flow{display:flex;flex-direction:column;gap:16px}\\n    .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\\n    h3{margin:0;color:#3c2b20}\\n    small{color:var(--muted)}\\n    .faq dt{font-weight:700;margin-top:12px}\\n    footer{margin-top:18px;padding-top:18px;border-top:1px dashed #efe6de;color:var(--muted);display:flex;justify-content:space-between}\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.grid-3{grid-template-columns:1fr}}  \\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">A</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Welcome</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"blends.html\\\">My Blends</a>\\n        <a href=\\\"shop.html\\\">Store</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero card\\\">\\n      <div>\\n        <h1>Tailored aromatherapy sessions and ongoing support</h1>\\n        <p>Gentle, safety-first aromatic care for everyday balance. I guide mindful scent choices without making medical promises — just practical, sensory tools you can use at home.</p>\\n        <div class=\\\"cta\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a class=\\\"mutebtn\\\" href=\\\"book.html\\\">Book a consult</a>\\n        </div>\\n      </div>\\n      <aside class=\\\"card\\\" style=\\\"font-size:14px\\\">\\n        <strong>Quick details</strong>\\n        <p style=\\\"margin:8px 0 0\\\">In-person and virtual sessions • Custom blends • Membership for regular deliveries and discounts</p>\\n        <hr style=\\\"margin:12px 0;border:none;border-top:1px dashed #efe6de\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;font-size:13px;color:var(--muted)\\\"><span>{{CITY}}, {{STATE}}</span><span>Phone: {{PHONE}}</span></div>\\n      </aside>\\n    </section>\\n\\n    <main class=\\\"flow\\\" style=\\\"margin-top:18px\\\">\\n\\n      <section class=\\\"card\\\">\\n        <h3>How I work — a gentle framework</h3>\\n        <p style=\\\"color:var(--muted)\\\">Think of each consultation as a map-making session. We explore scent memories, sensitivity, lifestyle and safety considerations to design a practical plan that fits your home and habits.</p>\\n        <div class=\\\"grid-3\\\" style=\\\"margin-top:12px\\\">\\n          <div>\\n            <strong>Assess</strong>\\n            <p style=\\\"margin:6px 0;color:var(--muted)\\\">Brief intake, patch-test guidance, and scent sampling.</p>\\n          </div>\\n          <div>\\n            <strong>Create</strong>\\n            <p style=\\\"margin:6px 0;color:var(--muted)\\\">Custom blends or chosen ready formulations with clear dilution guidelines.</p>\\n          </div>\\n          <div>\\n            <strong>Support</strong>\\n            <p style=\\\"margin:6px 0;color:var(--muted)\\\">Follow-ups and membership options for rhythm and restock.</p>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"card\\\">\\n        <h3>Services & offerings</h3>\\n        <div style=\\\"display:flex;gap:12px;flex-wrap:wrap;margin-top:12px\\\">\\n          <div style=\\\"flex:1;min-width:240px\\\">\\n            <strong>Introductory session — 60 min</strong>\\n            <p style=\\\"color:var(--muted);margin:6px 0\\\">Intake, scent sampling, and an at-home plan with safe dilution notes. Ideal for new clients.</p>\\n          </div>\\n          <div style=\\\"flex:1;min-width:240px\\\">\\n            <strong>Custom blend session</strong>\\n            <p style=\\\"color:var(--muted);margin:6px 0\\\">Create a personalized roll-on or room blend, with labeling, storage and usage guidance.</p>\\n          </div>\\n          <div style=\\\"flex:1;min-width:240px\\\">\\n            <strong>Membership</strong>\\n            <p style=\\\"color:var(--muted);margin:6px 0\\\">Monthly deliveries, member-only blends, priority scheduling and product discounts.</p>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"card\\\">\\n        <h3>A short story — why I chose this work</h3>\\n        <p style=\\\"color:var(--muted)\\\">I started mixing scents for friends as a way to hold space during life’s small storms. Over time, I learned to pair intention with safety — thoughtful dilutions, clear labeling, and a calm practice. I bring that same warmth to every session.</p>\\n      </section>\\n\\n      <section class=\\\"card\\\">\\n        <h3>Frequently asked — safety & practical notes</h3>\\n        <dl class=\\\"faq\\\">\\n          <dt>How should I dilute essential oils?</dt>\\n          <dd style=\\\"color:var(--muted)\\\">I provide dilution guidelines per blend and per use-case. For topical use a common guidance is 1–3% for adults; children and sensitive people use lower dilutions. Always follow your practitioner's notes.</dd>\\n          <dt>Do I need a patch test?</dt>\\n          <dd style=\\\"color:var(--muted)\\\">Yes. We recommend a small patch test for topical blends: apply diluted product to a tiny area and wait 24 hours to check for reactions.</dd>\\n          <dt>What about pets and pregnancy?</dt>\\n          <dd style=\\\"color:var(--muted)\\\">Some oils are not recommended for pets or during pregnancy. We'll review safety considerations during intake and offer alternatives with milder profiles.</dd>\\n          <dt>Are these medical treatments?</dt>\\n          <dd style=\\\"color:var(--muted)\\\">No. Aromatherapy supports well-being through scent-based practices and is not a substitute for medical care.</dd>\\n        </dl>\\n      </section>\\n\\n      <section class=\\\"card\\\">\\n        <h3>What people say</h3>\\n        <div style=\\\"display:flex;gap:12px;flex-wrap:wrap\\\">\\n          <div style=\\\"flex:1;min-width:220px\\\">\\n            <blockquote style=\\\"margin:0;color:var(--muted)\\\">\\\"Her blends bring my kitchen to life — calming without being cloying.\\\" — J.\\n            </blockquote>\\n          </div>\\n          <div style=\\\"flex:1;min-width:220px\\\">\\n            <blockquote style=\\\"margin:0;color:var(--muted)\\\">\\\"I appreciate the clear safety tips and the thoughtful follow-up.\\\" — M.\\n            </blockquote>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"card\\\" style=\\\"text-align:center\\\">\\n        <h3>Ready to start?</h3>\\n        <p style=\\\"color:var(--muted)\\\">Book a session or join the membership for ongoing deliveries and guidance.</p>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div>© <strong>{{BUSINESS_NAME}}</strong> • {{PRACTITIONER_NAME}}</div>\\n      <div style=\\\"text-align:right\\\">Call: {{PHONE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Blends — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff6f0;--accent:#7b4f2f;--muted:#69584d}\\n    html,body{margin:0;padding:0;font-family:Georgia,serif;color:#34261f;background:var(--bg);}\\n    body{background-image:url(\\\"assets/img/pattern.svg\\\");background-repeat:repeat;background-size:280px}\\n    .wrap{max-width:1000px;margin:28px auto;padding:22px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    .brand{font-weight:700}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .hero{padding:22px;background:linear-gradient(180deg,rgba(123,79,47,0.06),transparent);border-radius:12px;margin-top:12px}\\n    .hero h1{margin:0;font-size:30px}\\n    .lead{color:var(--muted);margin-top:8px}\\n    .blends{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:16px}\\n    .blend{background:white;padding:14px;border-radius:10px;box-shadow:0 6px 18px rgba(60,40,30,0.06)}\\n    .notes{font-size:13px;color:var(--muted);margin-top:8px}\\n    .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}\\n    .chip{background:linear-gradient(90deg,#f6efe8,#fff);border-radius:999px;padding:6px 10px;font-size:12px;border:1px solid #efe0d6}\\n    .safety{font-size:13px;color:#5a4639;margin-top:12px}\\n    footer{margin-top:18px;color:var(--muted)}\\n    @media (max-width:760px){.blends{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}} — Blends</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Treatments</a>\\n        <a href=\\\"shop.html\\\">Shop</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <h1>Curated blends — crafted with intention</h1>\\n      <p class=\\\"lead\\\">Each blend is created with scent harmony and safety in mind. Below are ready-made blends you can request in sessions or buy as roll-ons and kits. No medical claims — just thoughtful sensory support.</p>\\n    </section>\\n\\n    <main>\\n      <section class=\\\"safety card\\\" style=\\\"background:#fff;padding:12px;border-radius:10px;margin-top:12px\\\">\\n        <strong>Safety reminder</strong>\\n        <p class=\\\"safety\\\">Always follow dilution instructions. Avoid applying concentrated oils directly to skin. Consult your practitioner for pregnancy, pet, or medical-sensitivity notes. Perform a patch test before regular topical use.</p>\\n      </section>\\n\\n      <section class=\\\"blends\\\">\\n\\n        <article class=\\\"blend\\\">\\n          <strong>Sunrise Calm</strong>\\n          <div class=\\\"notes\\\">Top: Sweet Orange, Bergamot • Middle: Lavender • Base: Cedarwood</div>\\n          <div class=\\\"chips\\\"><div class=\\\"chip\\\">Aroma: Bright & comforting</div><div class=\\\"chip\\\">Type: Uplifting</div></div>\\n          <p style=\\\"margin-top:10px;color:var(--muted)\\\">Supports gentle wakefulness and a peaceful morning ritual. Use as a diffuser blend at low concentrations for shared spaces.</p>\\n        </article>\\n\\n        <article class=\\\"blend\\\">\\n          <strong>Quiet Evening</strong>\\n          <div class=\\\"notes\\\">Top: Petitgrain • Middle: Roman Chamomile • Base: Vetiver</div>\\n          <div class=\\\"chips\\\"><div class=\\\"chip\\\">Aroma: Herbaceous, soft</div><div class=\\\"chip\\\">Type: Grounding</div></div>\\n          <p style=\\\"margin-top:10px;color:var(--muted)\\\">Supports relaxation and a calming bedtime routine. Diffuse briefly 30–60 minutes before sleep. Not a sleep cure; complements restful habits.</p>\\n        </article>\\n\\n        <article class=\\\"blend\\\">\\n          <strong>Focus Grove</strong>\\n          <div class=\\\"notes\\\">Top: Rosemary • Middle: Lemon • Base: Frankincense</div>\\n          <div class=\\\"chips\\\"><div class=\\\"chip\\\">Aroma: Crisp & resinous</div><div class=\\\"chip\\\">Type: Clarity</div></div>\\n          <p style=\\\"margin-top:10px;color:var(--muted)\\\">Supports concentration for short work sprints. Use sparingly and ventilate well. Avoid prolonged exposure for children and pets.</p>\\n        </article>\\n\\n        <article class=\\\"blend\\\">\\n          <strong>Warm Hearth</strong>\\n          <div class=\\\"notes\\\">Top: Sweet Orange • Middle: Cinnamon leaf (very low) • Base: Sandalwood</div>\\n          <div class=\\\"chips\\\"><div class=\\\"chip\\\">Aroma: Cozy & warm</div><div class=\\\"chip\\\">Type: Comforting</div></div>\\n          <p style=\\\"margin-top:10px;color:var(--muted)\\\">Supports companionable gatherings. Cinnamon leaf is used at low dilution only — check for sensitivities and avoid direct skin contact.</p>\\n        </article>\\n\\n        <article class=\\\"blend\\\">\\n          <strong>Mist of Meadow</strong>\\n          <div class=\\\"notes\\\">Top: Bergamot • Middle: Neroli • Base: Ambrette</div>\\n          <div class=\\\"chips\\\"><div class=\\\"chip\\\">Aroma: Floral & airy</div><div class=\\\"chip\\\">Type: Light, uplifting</div></div>\\n          <p style=\\\"margin-top:10px;color:var(--muted)\\\">Supports moments when you want a gentle, flower-like presence. Use in small diffuser doses for short intervals.</p>\\n        </article>\\n\\n        <article class=\\\"blend\\\">\\n          <strong>Quiet Strength</strong>\\n          <div class=\\\"notes\\\">Top: Black Pepper (tiny) • Middle: Geranium • Base: Patchouli</div>\\n          <div class=\\\"chips\\\"><div class=\\\"chip\\\">Aroma: Earthy & floral</div><div class=\\\"chip\\\">Type: Centering</div></div>\\n          <p style=\\\"margin-top:10px;color:var(--muted)\\\">Supports feeling steady in transitions. Pepper is included minimally; topical use only when fully diluted and patch-tested.</p>\\n        </article>\\n\\n        <article class=\\\"blend\\\">\\n          <strong>Breathe Easy (gentle)</strong>\\n          <div class=\\\"notes\\\">Top: Eucalyptus (low) • Middle: Lavender • Base: Myrrh</div>\\n          <div class=\\\"chips\\\"><div class=\\\"chip\\\">Aroma: Clean & resinous</div><div class=\\\"chip\\\">Type: Respiratory-friendly (mild)</div></div>\\n          <p style=\\\"margin-top:10px;color:var(--muted)\\\">Supports comfortable breathing when used with caution. Keep exposure brief and avoid around infants; consult practitioner for specific health concerns.</p>\\n        </article>\\n\\n        <article class=\\\"blend\\\">\\n          <strong>Gentle Bloom</strong>\\n          <div class=\\\"notes\\\">Top: Ylang Ylang (very low) • Middle: Rose otto (low) • Base: Jojoba carrier</div>\\n          <div class=\\\"chips\\\"><div class=\\\"chip\\\">Aroma: Soft floral</div><div class=\\\"chip\\\">Type: Soothing</div></div>\\n          <p style=\\\"margin-top:10px;color:var(--muted)\\\">Supports emotional ease and self-care rituals. Floral absolutes are used in low concentrations—ideal as a roll-on blend.</p>\\n        </article>\\n\\n      </section>\\n\\n      <section style=\\\"margin-top:18px\\\">\\n        <div style=\\\"background:white;padding:12px;border-radius:10px\\\">\\n          <h3 style=\\\"margin-top:0\\\">Need something tailored?</h3>\\n          <p style=\\\"color:var(--muted)\\\">I craft custom blends during a one-on-one session. Membership clients receive seasonal blends and priority restocks. Ask about dilution, storage, and pet-safe options during your consult.</p>\\n          <a href=\\\"services.html\\\" style=\\\"display:inline-block;margin-top:10px;padding:10px 12px;background:var(--accent);color:white;border-radius:8px;text-decoration:none\\\">Request a custom blend</a>\\n        </div>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <p style=\\\"color:var(--muted)\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}}. For pregnancy, pediatric or severe allergy concerns, please consult healthcare providers first.</p>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Shop — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fffaf6;--accent:#8a5a36;--muted:#6b594f}\\n    html,body{margin:0;padding:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;color:#2f231d;background:var(--bg)}\\n    body{background-image:url(\\\"assets/img/pattern.svg\\\");background-repeat:repeat;background-size:300px}\\n    .wrap{max-width:1100px;margin:26px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .hero{padding:18px;background:linear-gradient(180deg,rgba(138,90,54,0.06),transparent);border-radius:12px;margin-top:12px}\\n    .products{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .card{background:white;padding:14px;border-radius:12px;box-shadow:0 10px 30px rgba(40,28,20,0.06)}\\n    .price{font-weight:700;color:var(--accent);margin-top:8px}\\n    .cta{display:flex;gap:8px;margin-top:12px}\\n    .btn{padding:8px 10px;border-radius:8px;background:var(--accent);color:white;text-decoration:none}\\n    .secondary{padding:8px 10px;border-radius:8px;border:1px solid #efe3da;color:var(--muted);background:transparent;text-decoration:none}\\n    .faq{margin-top:18px;padding:12px;background:#fff;border-radius:10px}\\n    @media (max-width:980px){.products{grid-template-columns:repeat(2,1fr)}}\\n    @media (max-width:600px){.products{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}} • Shop</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"pricing.html\\\">Membership</a>\\n        <a href=\\\"contact.html\\\">Help</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <h1>Shop — curated kits, roll-ons & gentle diffusers</h1>\\n      <p style=\\\"color:var(--muted)\\\">Browse safe, ready-to-use products and gift sets. All products include straightforward dilution or usage guidance. If unsure, book a quick consult.</p>\\n    </section>\\n\\n    <main>\\n      <section class=\\\"products\\\">\\n\\n        <div class=\\\"card\\\">\\n          <strong>Starter Kit — The Home Ritual</strong>\\n          <div style=\\\"color:var(--muted);font-size:13px;margin-top:8px\\\">Includes three 10ml blends (morning, calm, sleep), dilution chart, and cotton storage bag.</div>\\n          <div class=\\\"price\\\">$48</div>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a><a class=\\\"secondary\\\" href=\\\"blends.html\\\">View blends</a></div>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <strong>Roll-On Trio</strong>\\n          <div style=\\\"color:var(--muted);font-size:13px;margin-top:8px\\\">Three pre-diluted roll-ons in glass bottles: Calm, Focus, Comfort. Labeled with dilution and patch-test reminder.</div>\\n          <div class=\\\"price\\\">$34</div>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a><a class=\\\"secondary\\\" href=\\\"book.html\\\">Request personalization</a></div>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <strong>Mini Ceramic Diffuser</strong>\\n          <div style=\\\"color:var(--muted);font-size:13px;margin-top:8px\\\">USB-powered gentle diffuser ideal for small rooms. Includes cleaning and safe-use tips for oils.</div>\\n          <div class=\\\"price\\\">$42</div>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a><a class=\\\"secondary\\\" href=\\\"#\\\">Shipping info</a></div>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <strong>Seasonal Blend — {{FAVORITE_BLEND}}</strong>\\n          <div style=\\\"color:var(--muted);font-size:13px;margin-top:8px\\\">Limited batch roll. See blend notes in product description. Sold as 10ml bottle with dilution guide.</div>\\n          <div class=\\\"price\\\">$22</div>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"#\\\"