          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'/>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'/>\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfbfa;--muted:#6b6b6b;--accent:#6a8b6c;--ink:#102012;--card:#fff;--glass:rgba(255,255,255,0.7)}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial;color:var(--ink);background:linear-gradient(180deg,#fbfbfa, #f2f5f0)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 28px;background:transparent}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:48px;height:48px;border-radius:9px;background:linear-gradient(135deg,var(--accent),#95b991);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none;font-size:15px}\\n    nav a[href$='about.html']{color:var(--ink);font-weight:600}\\n    main{max-width:1100px;margin:26px auto;padding:20px}\\n    .hero{display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:center;margin-bottom:18px}\\n    .hero .lead{background:var(--card);padding:28px;border-radius:12px;box-shadow:0 6px 20px rgba(16,32,16,0.06)}\\n    h1{margin:0 0 10px;font-size:28px}\\n    p.lead{margin:0;color:var(--muted);line-height:1.5}\\n    .svg-wrap{height:220px;background:linear-gradient(180deg,rgba(106,139,108,0.08),transparent);border-radius:12px;display:flex;align-items:center;justify-content:center}\\n    /* subtle pattern SVG block */\\n    .pattern-svg{width:88%;height:88%}\\n\\n    .pillars{display:flex;gap:14px;margin:22px 0}\\n    .pillar{flex:1;background:var(--card);padding:18px;border-radius:10px;box-shadow:0 6px 20px rgba(16,32,16,0.04)}\\n    .pillar h3{margin:0 0 8px;font-size:16px}\\n    .myth-truth{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:18px 0}\\n    .mt-card{background:var(--card);padding:16px;border-radius:10px}\\n    .mt-card h4{margin:0 0 8px;font-size:15px}\\n\\n    /* Proof gallery */\\n    .proof{display:grid;grid-template-columns:1fr 260px;gap:18px;align-items:start}\\n    .testimonial{background:var(--card);padding:20px;border-radius:12px;min-height:160px;position:relative;overflow:hidden}\\n    .testimonial p{margin:0;color:var(--muted);line-height:1.6}\\n    .t-author{margin-top:12px;font-weight:700}\\n    .t-source{font-size:13px;color:var(--muted)}\\n    .t-nav{position:absolute;bottom:14px;right:14px;display:flex;gap:8px}\\n    .t-nav button{background:transparent;border:1px solid rgba(0,0,0,0.06);padding:6px 8px;border-radius:8px;cursor:pointer}\\n\\n    .badges{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 6px 20px rgba(16,32,16,0.04)}\\n    .badge{display:flex;align-items:center;gap:10px;padding:8px;border-radius:8px;margin-bottom:10px;position:relative}\\n    .badge svg{width:36px;height:36px}\\n    .tooltip{position:absolute;left:110%;top:6px;background:#fff;padding:8px;border-radius:8px;box-shadow:0 6px 18px rgba(0,0,0,0.08);font-size:13px;display:none;width:180px}\\n    .badge:hover .tooltip{display:block}\\n\\n    .faq{margin:18px 0}\\n    .faq details{background:var(--card);padding:12px;border-radius:10px;margin-bottom:8px}\\n    .cta{display:flex;justify-content:space-between;align-items:center;margin-top:22px}\\n    .cta .box{background:linear-gradient(180deg,#fff,#f7fbf6);padding:18px;border-radius:10px}\\n    .btn{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    footer{margin:36px 0;text-align:center;color:var(--muted);font-size:13px}\\n\\n    @media(max-width:880px){\\n      .hero{grid-template-columns:1fr}\\n      .proof{grid-template-columns:1fr}\\n      nav{display:none}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class='brand'>\\n      <div class='logo'>AR</div>\\n      <div>\\n        <div style='font-weight:700'>{{BUSINESS_NAME}}</div>\\n        <div style='font-size:13px;color:var(--muted)'>Local aromatherapy with attention to safety</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='services.html'>Offerings</a>\\n      <a href='blends.html'>Blends</a>\\n      <a href='shop.html'>Boutique</a>\\n      <a href='pricing.html'>Plans</a>\\n      <a href='about.html'>About</a>\\n      <a href='book.html'>Book</a>\\n      <a href='contact.html'>Connect</a>\\n    </nav>\\n  </header>\\n  <main>\\n    <section class='hero'>\\n      <div class='lead'>\\n        <h1>How we work with scent — small, safe, and intentional</h1>\\n        <p class='lead'>We combine practical scent education with curated applications for groups and individuals. Sessions and events are formulated to be safety-first and may support moments of calm, clarity, or gentle reset. Every blend is tested and documented.</p>\\n        <div style='margin-top:14px;display:flex;gap:10px'>\\n          <a class='btn' href='book.html'>Reserve a time</a>\\n          <a href='contact.html' style='padding:10px 12px;border-radius:10px;border:1px solid #e6efe6;color:var(--accent);text-decoration:none;'>Ask about groups</a>\\n        </div>\\n      </div>\\n      <div class='svg-wrap'>\\n        <svg class='pattern-svg' viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n          <defs>\\n            <linearGradient id='g1' x1='0' x2='1'>\\n              <stop offset='0' stop-color='#eaf6ea'/>\\n              <stop offset='1' stop-color='#ffffff' />\\n            </linearGradient>\\n            <filter id='soft' x='-20%' y='-20%' width='140%' height='140%'>\\n              <feGaussianBlur stdDeviation='6' result='b' />\\n              <feBlend in='SourceGraphic' in2='b' />\\n            </filter>\\n          </defs>\\n          <rect width='100%' height='100%' fill='url(#g1)' rx='12' />\\n          <g fill='none' stroke='#9fc89f' stroke-opacity='0.9' stroke-width='2' filter='url(#soft)'>\\n            <path d='M20 140 C40 100, 80 100, 120 140' stroke-linecap='round'/>\\n            <path d='M40 60 C70 20, 130 20, 160 60'/>\\n            <circle cx='80' cy='90' r='18' fill='#d8f0d8' stroke='none' />\\n            <circle cx='140' cy='120' r='10' fill='#e9f5ea' stroke='none' />\\n          </g>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <section class='pillars'>\\n      <div class='pillar'>\\n        <h3>Scent Literacy</h3>\\n        <p style='color:var(--muted)'>We teach practical ways to read a blend — what notes will be felt, how dilution changes effect, and how to perform a patch test safely.</p>\\n      </div>\\n      <div class='pillar'>\\n        <h3>Formulation & Safety</h3>\\n        <p style='color:var(--muted)'>All blends are documented with dilution, intended context, and notes about pregnancy, medications, and pets where relevant.</p>\\n      </div>\\n      <div class='pillar'>\\n        <h3>Community Rhythm</h3>\\n        <p style='color:var(--muted)'>Group experiences and series are designed to be gently repeatable — short rituals that fit into a weekly rhythm rather than one-off spectacles.</p>\\n      </div>\\n    </section>\\n\\n    <section class='myth-truth'>\\n      <div class='mt-card'>\\n        <h4>Myth: All essential oils are safe at any amount</h4>\\n        <p style='color:var(--muted)'>Truth: Potency varies. We always note dilution and recommended exposure; less is often more when working with concentrated botanicals.</p>\\n      </div>\\n      <div class='mt-card'>\\n        <h4>Myth: Scent is either ‘good’ or ‘bad’ for mood</h4>\\n        <p style='color:var(--muted)'>Truth: Response is personal. We favor experiments that help you notice responses rather than universal promises.</p>\\n      </div>\\n    </section>\\n\\n    <section class='proof' aria-labelledby='proof-heading'>\\n      <div>\\n        <h2 id='proof-heading'>Proof Gallery</h2>\\n        <div class='testimonial' id='testimonial'>\\n          <p id='t-text'>Loading testimonial…</p>\\n          <div class='t-author' id='t-author'></div>\\n          <div class='t-source' id='t-source'></div>\\n          <div class='t-nav'>\\n            <button id='prev' aria-label='Previous'>‹</button>\\n            <button id='next' aria-label='Next'>›</button>\\n          </div>\\n        </div>\\n        <div style='margin-top:10px;color:var(--muted);font-size:13px'>Selected badges indicate training, partner organizations, and safety reviews.</div>\\n      </div>\\n      <aside class='badges' aria-hidden='false'>\\n        <div class='badge' data-tip='Certified clinical aromatherapy education' tabindex='0'>\\n          <svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><circle cx='12' cy='12' r='10' stroke='#6a8b6c' stroke-width='1.6'/><path d='M8 12l2 2 4-4' stroke='#6a8b6c' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'/></svg>\\n          <div>\\n            <div style='font-weight:700'>Certified Aromatherapist</div>\\n            <div style='font-size:13px;color:var(--muted)'>Training verified</div>\\n          </div>\\n          <div class='tooltip'>Completed certification through an established aromatherapy course; syllabus and hours available on request.</div>\\n        </div>\\n\\n        <div class='badge' data-tip='Safety-reviewed blends' tabindex='0'>\\n          <svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><rect x='3' y='6' width='18' height='12' rx='2' stroke='#95b991' stroke-width='1.6'/><path d='M8 10h8' stroke='#95b991' stroke-width='1.6'/></svg>\\n          <div>\\n            <div style='font-weight:700'>Safety Reviewed</div>\\n            <div style='font-size:13px;color:var(--muted)'>Dilution & use notes</div>\\n          </div>\\n          <div class='tooltip'>Each blend includes recommended dilution, patch test advice, and notes for pregnancy or pets when relevant.</div>\\n        </div>\\n\\n        <div class='badge' data-tip='Community partner organizations' tabindex='0'>\\n          <svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M12 6a4 4 0 110 8 4 4 0 010-8z' stroke='#7fa47d' stroke-width='1.6'/><path d='M4 18a8 6 0 0116 0' stroke='#7fa47d' stroke-width='1.6'/></svg>\\n          <div>\\n            <div style='font-weight:700'>Community Partners</div>\\n            <div style='font-size:13px;color:var(--muted)'>Local clinics & studios</div>\\n          </div>\\n          <div class='tooltip'>We partner with local studios for shared events and maintain community liability coverage for group work.</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class='faq'>\\n      <h3>Frequently asked safety questions</h3>\\n      <details>\\n        <summary>How should I do a patch test?</summary>\\n        <div style='color:var(--muted);margin-top:8px'>Dilute a drop of blend in at least 4–10 ml of carrier oil. Apply a small amount to the inner forearm and wait 24 hours for any reaction. Avoid if you see redness or itch.</div>\\n      </details>\\n      <details>\\n        <summary>What about dilution and concentrations?</summary>\\n        <div style='color:var(--muted);margin-top:8px'>We publish dilution for each context. Typical single-session topical use is often between 0.5%–3% depending on the application and participant profile.</div>\\n      </details>\\n      <details>\\n        <summary>Are essential oils safe around pets or pregnancy?</summary>\\n        <div style='color:var(--muted);margin-top:8px'>Some oils are contraindicated for pregnancy and some are risky for pets. We include explicit notes and ask clients to disclose pregnancy, nursing, and household pets before sessions.</div>\\n      </details>\\n      <details>\\n        <summary>Do you make clinical claims?</summary>\\n        <div style='color:var(--muted);margin-top:8px'>No medical claims are made. We describe how blends are intended to be used and what responses people commonly report; outcomes are individual and may vary.</div>\\n      </details>\\n    </section>\\n\\n    <section class='cta'>\\n      <div class='box'>\\n        <div style='font-weight:700'>Ready to try a guided session or host a small event?</div>\\n        <div style='margin-top:8px;color:var(--muted)'>Book a one-on-one, sign up for a short series, or inquire about bringing a scent session to your group.</div>\\n      </div>\\n      <div style='display:flex;flex-direction:column;gap:8px;align-items:flex-end'>\\n        <a class='btn' href='book.html'>{{PRIMARY_CTA_LABEL}}</a>\\n        <a href='contact.html' style='color:var(--muted);text-decoration:none'>Contact: {{EMAIL}}</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}} • <a href='tel:{{PHONE}}' style='color:var(--muted);text-decoration:none'>{{PHONE}}</a></div>\\n  </footer>\\n\\n  <script>\\n    (function(){\\n      const testimonials=[\\n        {text:'A calm guiding presence — I noticed simple shifts in my afternoon routine after the series.',author:'Leah M, educator',source:'Small group series'},\\n        {text:'Thoughtful dilution and clear safety notes; I felt confident trying a topical blend for the first time.',author:'Samir D, designer',source:'1:1 session'},\\n        {text:'Our studio hosted a scent workshop — attendees appreciated the concise format and clear takeaways.',author:'Quiet Room Studio',source:'Community event'}\\n      ];\\n      let idx=0;const tText=document.getElementById('t-text');const tAuthor=document.getElementById('t-author');const tSource=document.getElementById('t-source');\\n      function show(i){\\n        const item=testimonials[i];\\n        // fade effect\\n        const el=document.getElementById('testimonial');\\n        el.style.opacity=0;setTimeout(()=>{\\n          tText.textContent=item.text; tAuthor.textContent=item.author; tSource.textContent=item.source; el.style.opacity=1;\\n        },260);\\n      }\\n      document.getElementById('prev').addEventListener('click',()=>{idx=(idx-1+testimonials.length)%testimonials.length;show(idx);reset();});\\n      document.getElementById('next').addEventListener('click',()=>{idx=(idx+1)%testimonials.length;show(idx);reset();});\\n      let timer;function next(){idx=(idx+1)%testimonials.length;show(idx);} \\n      function reset(){clearInterval(timer);timer=setInterval(next,6000);} \\n      show(idx);reset();\\n      // badge tooltips accessible on focus\\n      document.querySelectorAll('.badge').forEach(b=>{b.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' ') {const tip=b.querySelector('.tooltip'); tip.style.display=(tip.style.display==='block')?'none':'block';}})});\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'/>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'/>\\n  <title>Plans & Pricing — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f7fbf7;--accent:#5f7f63;--muted:#6d6d6d;--card:#fff;--ink:#0f2010}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--bg);color:var(--ink)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 28px}\\n    .logo{font-weight:800;color:var(--accent)}\\n    nav a{margin:0 8px;color:var(--muted);text-decoration:none}\\n    main{max-width:1000px;margin:30px auto;padding:18px}\\n    .hero{background:linear-gradient(90deg,#ffffff, #f0f8f2);padding:20px;border-radius:12px;display:flex;justify-content:space-between;align-items:center}\\n    .hero h1{margin:0;font-size:22px}\\n    .toggle{display:flex;gap:8px;align-items:center}\\n    .switch{background:var(--card);padding:4px;border-radius:999px;border:1px solid rgba(0,0,0,0.06);display:flex}\\n    .switch button{background:transparent;border:0;padding:8px 12px;border-radius:999px;cursor:pointer}\\n    .switch button.active{background:var(--accent);color:#fff}\\n\\n    .plans{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .plan{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 8px 24px rgba(12,30,12,0.04)}\\n    .plan h3{margin:0 0 6px}\\n    .price{font-size:22px;font-weight:800;margin:8px 0}\\n    .per{font-size:13px;color:var(--muted)}\\n    .features{color:var(--muted);font-size:14px}\\n\\n    .compare{margin-top:16px;background:var(--card);padding:14px;border-radius:10px}\\n    .note{font-size:13px;color:var(--muted);margin-top:10px}\\n    .btn{display:inline-block;padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none}\\n\\n    @media(max-width:880px){.plans{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class='logo'>{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='services.html'>Services</a>\\n      <a href='pricing.html'>Pricing</a>\\n      <a href='book.html'>Book</a>\\n      <a href='contact.html'>Contact</a>\\n    </nav>\\n  </header>\\n  <main>\\n    <section class='hero'>\\n      <div>\\n        <h1>Flexible plans for sessions and events</h1>\\n        <div style='color:var(--muted)'>Choose monthly support or compact packages. Toggle to compare monthly rates with single-package pricing.</div>\\n      </div>\\n      <div class='toggle'>\\n        <div style='font-size:13px;color:var(--muted);margin-right:8px'>View:</div>\\n        <div class='switch' role='tablist' aria-label='Pricing scope'>\\n          <button id='btn-monthly' class='active' role='tab' aria-selected='true'>Monthly</button>\\n          <button id='btn-package' role='tab' aria-selected='false'>Package</button>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class='plans' aria-live='polite'>\\n      <div class='plan'>\\n        <h3>Ritual Starter</h3>\\n        <div class='price' data-monthly='22' data-package='65'>$<span class='num'>22</span></div>\\n        <div class='per'>Monthly support • or 3-session package</div>\\n        <div class='features'>\\n          <ul style='padding-left:18px;margin-top:10px;color:var(--muted)'>\\n            <li>Monthly sniff & guidance</li>\\n            <li>One small blend sample</li>\\n            <li>Email check-in</li>\\n          </ul>\\n        </div>\\n        <div style='margin-top:12px'><a class='btn' href='book.html'>Select</a></div>\\n      </div>\\n\\n      <div class='plan'>\\n        <h3>Scent Series</h3>\\n        <div class='price' data-monthly='48' data-package='135'>$<span class='num'>48</span></div>\\n        <div class='per'>Monthly series • or 6-session package</div>\\n        <div class='features'>\\n          <ul style='padding-left:18px;margin-top:10px;color:var(--muted)'>\\n            <li>Weekly sessions for a month</li>\\n            <li>Blends for home use</li>\\n            <li>Guided practice notes</li>\\n          </ul>\\n        </div>\\n        <div style='margin-top:12px'><a class='btn' href='book.html'>Select</a></div>\\n      </div>\\n\\n      <div class='plan'>\\n        <h3>Gathering Event</h3>\\n        <div class='price' data-monthly='80' data-package='240'>$<span class='num'>80</span></div>\\n        <div class='per'>Per event booking • or 3-event pack</div>\\n        <div class='features'>\\n          <ul style='padding-left:18px;margin-top:10px;color:var(--muted)'>\\n            <li>Up to 12 attendees</li>\\n            <li>Custom blend & handouts</li>\\n            <li>Pre-event consultation</li>\\n          </ul>\\n        </div>\\n        <div style='margin-top:12px'><a class='btn' href='contact.html'>Inquire</a></div>\\n      </div>\\n    </section>\\n\\n    <section class='compare'>\\n      <div style='display:flex;justify-content:space-between;align-items:center'>\\n        <div>\\n          <div style='font-weight:700'>Why two views?</div>\\n          <div class='note'>Monthly means recurring guided support; package shows the cost of a group of sessions bought up front. Toggle to see animated price numbers.</div>\\n        </div>\\n        <div style='text-align:right'>\\n          <div style='font-size:13px;color:var(--muted)'>Have questions?</div>\\n          <a class='btn' href='contact.html' style='margin-top:8px;display:inline-block'>Ask an adviser</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style='margin-top:14px;color:var(--muted);font-size:13px'>\\n      <strong>Note:</strong> All sessions include safety guidance. We avoid medical claims; outcomes vary. See the FAQ for dilution, patch test, pregnancy, and pet notes.\\n    </section>\\n\\n  </main>\\n  <script>\\n    (function(){\\n      const monthlyBtn=document.getElementById('btn-monthly');\\n      const packageBtn=document.getElementById('btn-package');\\n      const priceEls=document.querySelectorAll('.price');\\n      let mode='monthly';\\n      function animate(el,start,end,duration=550){\\n        const span=el.querySelector('.num');\\n        const startTime=performance.now();\\n        function step(now){\\n          const t=Math.min(1,(now-startTime)/duration);\\n          const val=Math.round(start+(end-start)*t);\\n          span.textContent=val;\\n          if(t<1) requestAnimationFrame(step);\\n        }\\n        requestAnimationFrame(step);\\n      }\\n      function setMode(m){\\n        mode=m;\\n        document.querySelectorAll('.switch button').forEach(b=>b.classList.remove('active'));\\n        if(m==='monthly'){monthlyBtn.classList.add('active');monthlyBtn.setAttribute('aria-selected','true');packageBtn.setAttribute('aria-selected','false');}\\n        else{packageBtn.classList.add('active');packageBtn.setAttribute('aria-selected','true');monthlyBtn.setAttribute('aria-selected','false');}\\n        priceEls.forEach(p=>{\\n          const start=Number(p.querySelector('.num').textContent)||0;\\n          const target=Number(p.getAttribute(m==='monthly'?'data-monthly':'data-package'))||0;\\n          animate(p,start,target);\\n        });\\n      }\\n      monthlyBtn.addEventListener('click',()=>setMode('monthly'));\\n      packageBtn.addEventListener('click',()=>setMode('package'));\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'/>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'/>\\n  <title>Book a Session — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#6b8e6b;--muted:#616161;--bg:#fff}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--bg);color:#102012}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:14px 22px;border-bottom:1px solid #eef5ee}\\n    nav a{margin:0 10px;color:var(--muted);text-decoration:none}\\n    main{max-width:920px;margin:28px auto;padding:18px}\\n    .lead{display:flex;gap:18px;align-items:center}\\n    .lead h1{margin:0;font-size:22px}\\n    .form-card{margin-top:18px;background:#fff;padding:18px;border-radius:12px;box-shadow:0 10px 30px rgba(10,30,10,0.04)}\\n    label{display:block;margin-top:12px;font-size:13px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6efe6;margin-top:6px}\\n    .row{display:flex;gap:12px}\\n    .row .col{flex:1}\\n    .btn{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;border:0;cursor:pointer}\\n    .micro{background:#f7fbf7;padding:12px;border-radius:10px;margin-top:12px}\\n    .confirmation{display:none;background:#eef8ee;padding:12px;border-radius:8px;margin-top:12px}\\n    @media(max-width:760px){.row{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style='font-weight:700'>{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href='index.html'>Welcome</a>\\n      <a href='services.html'>Workshops</a>\\n      <a href='blends.html'>Blends</a>\\n      <a href='book.html'>Book</a>\\n      <a href='contact.html'>Help</a>\\n    </nav>\\n  </header>\\n  <main>\\n    <div class='lead'>\\n      <div>\\n        <h1>Book a session or event</h1>\\n        <div style='color:var(--muted)'>Select the service that best fits your needs. If unsure, choose a short consult and we’ll recommend next steps.</div>\\n      </div>\\n      <div style='margin-left:auto;text-align:right'>\\n        <div style='font-size:13px;color:var(--muted)'>Need quick help?</div>\\n        <div style='font-weight:700'>{{PHONE}}</div>\\n      </div>\\n    </div>\\n\\n    <section class='form-card'>\\n      <form id='booking-form' action='#' onsubmit='return false;'>\\n        <label>Service</label>\\n        <select id='service' required>\\n          <option value='ritual'>Ritual Starter — short consult</option>\\n          <option value='series'>Scent Series — guided weeks</option>\\n          <option value='event'>Gathering Event — group booking</option>\\n        </select>\\n\\n        <div class='row'>\\n          <div class='col'>\\n            <label>Preferred date</label>\\n            <input id='date' type='date' required />\\n          </div>\\n          <div class='col'>\\n            <label>Preferred time</label>\\n            <input id='time' type='time' required />\\n          </div>\\n        </div>\\n\\n        <label>Your name</label>\\n        <input id='name' type='text' placeholder='Full name' required />\\n\\n        <label>Contact (email or phone)</label>\\n        <input id='contact' type='text' placeholder='you@example.com or 555-555-5555' required />\\n\\n        <label>Notes (allergies, pregnancy, pets, other)</label>\\n        <textarea id='notes' rows='4' placeholder='Please mention pregnancy, nursing, medications, or pets in household'></textarea>\\n\\n        <div style='margin-top:12px;display:flex;gap:12px;align-items:center'>\\n          <button class='btn' id='submit'>Request booking</button>\\n          <div style='font-size:13px;color:var(--muted)'>You will receive a confirmation with next steps.</div>\\n        </div>\\n\\n        <div class='confirmation' id='confirm'>\\n          Thanks — your request is received. We will contact you at the address provided to confirm details and discuss safety notes.\\n        </div>\\n      </form>\\n\\n      <div class='micro'>\\n        <strong>Compare cost</strong>\\n        <div style='margin-top:8px'>\\n          <label style='font-size:13px;color:var(--muted)'>View prices as</label>\\n          <div style='display:flex;gap:8px;margin-top:8px'>\\n            <button id='m1' class='mini active' style='padding:8px 10px;border-radius:8px;border:1px solid #e6efea;background:var(--accent);color:#fff;cursor:pointer'>Monthly</button>\\n            <button id='p1' class='mini' style='padding:8px 10px;border-radius:8px;border:1px solid #e6efea;background:transparent;cursor:pointer'>Package</button>\\n          </div>\\n        </div>\\n        <div style='display:flex;gap:12px;margin-top:12px'>\\n          <div style='flex:1;background:#fff;padding:10px;border-radius:8px'>\\n            <div style='font-size:13px;color:var(--muted)'>Ritual Starter</div>\\n            <div style='font-weight:800;margin-top:6px'>$<span id='price-ritual'>22</span></div>\\n          </div>\\n          <div style='flex:1;background:#fff;padding:10px;border-radius:8px'>\\n            <div style='font-size:13px;color:var(--muted)'>Scent Series</div>\\n            <div style='font-weight:800;margin-top:6px'>$<span id='price-series'>48</span></div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <div style='margin-top:12px;font-size:13px;color:var(--muted)'>We publish dilution and patch test recommendations with each booking. Please disclose pregnancy, nursing, medications, and household pets so we can advise on safe options.</div>\\n    </section>\\n\\n  </main>\\n\\n  <script>\\n    (function(){\\n      const form=document.getElementById('booking-form');\\n      const confirm=document.getElementById('confirm');\\n      form.addEventListener('submit',e=>{});\\n      document.getElementById('submit').addEventListener('click',function(ev){\\n        ev.preventDefault();\\n        // simple validation\\n        const name=document.getElementById('name').value.trim();\\n        const contact=document.getElementById('contact').value.trim();\\n        if(!name||!contact){alert('Please provide your name and contact.');return;}\\n        confirm.style.display='block';\\n        window.scrollTo({top:confirm.offsetTop-40,behavior:'smooth'});\\n      });\\n\\n      // micro comparator\\n      const ritual=document.getElementById('price-ritual');\\n      const series=document.getElementById('price-series');\\n      const monthly={ritual:22,series:48};\\n      const pack={ritual:65,series:135};\\n      function animateVal(el,start,end){\\n        const dur=450;const t0=performance.now();\\n        function frame(t){\\n          const p=Math.min(1,(t-t0)/dur); el.textContent=Math.round(start+(end-start)*p);\\n          if(p<1) requestAnimationFrame(frame);\\n        }\\n        requestAnimationFrame(frame);\\n      }\\n      document.getElementById('m1').addEventListener('click',function(){animateVal(ritual,Number(ritual.textContent),monthly.ritual);animateVal(series,Number(series.textContent),monthly.series);this.style.background='var(--accent)';this.style.color='#fff';document.getElementById('p1').style.background='transparent';document.getElementById('p1').style.color='inherit';});\\n      document.getElementById('p1').addEventListener('click',function(){animateVal(ritual,Number(ritual.textContent),pack.ritual);animateVal(series,Number(series.textContent),pack.series);this.style.background='var(--accent)';this.style.color='#fff';document.getElementById('m1').style.background='transparent';document.getElementById('m1').style.color='inherit';});\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
