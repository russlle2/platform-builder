          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investment & Offerings — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Transparent pricing for aromatic consultations, seasonal event series, and blends. Safety-forward aromatherapy services.\\\">\\n  <style>\\n    :root{--bg:#f6efe6;--card:#fff6f0;--accent:#a65b2a;--muted:#6b5a4a;--olive:#7b8a50;--glass:rgba(255,255,255,0.6);--radius:12px}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial;color:var(--muted);background:linear-gradient(180deg,#fbf6f0 0%,#f2e9de 100%);background-attachment:fixed}\\n    body{background-image:url('assets/img/pattern.svg');background-repeat:repeat;}\\n    .wrap{max-width:980px;margin:36px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px}\\n    nav a{margin:0 8px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .brand{display:flex;flex-direction:column}\\n    .brand .name{font-weight:700;color:var(--accent);font-size:18px}\\n    .hero{background:linear-gradient(135deg,rgba(166,91,42,0.06),rgba(123,138,80,0.04));padding:28px;border-radius:var(--radius);display:flex;gap:20px;align-items:center}\\n    .hero h1{margin:0;font-size:28px;color:var(--accent)}\\n    .hero p{margin:6px 0 0;color:var(--muted)}\\n    .cta{display:inline-block;padding:10px 16px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none;margin-top:10px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:20px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(106,86,66,0.06)}\\n    .price{font-size:20px;color:var(--olive);font-weight:700}\\n    .muted{color:#836b5a;font-size:14px}\\n    .tiers{display:flex;gap:14px;margin-top:12px}\\n    .tier{flex:1;padding:14px;border-radius:10px;background:linear-gradient(180deg,#fff 0%,#fff7f2 100%);border:1px solid rgba(120,90,60,0.06)}\\n    .tier h3{margin:0 0 6px;color:var(--accent)}\\n    ul{padding-left:18px;margin:8px 0}\\n    .faq dt{font-weight:700;margin-top:12px}\\n    .lead{display:flex;gap:10px;align-items:center;margin-top:14px}\\n    input[type=email]{flex:1;padding:10px;border-radius:8px;border:1px solid #e5d7cc}\\n    button{padding:10px 14px;border-radius:8px;border:0;background:var(--accent);color:#fff}\\n    footer{margin-top:26px;color:#8b7a6a;font-size:13px;text-align:center}\\n    /* small ornaments */\\n    .badge{background:var(--glass);padding:6px 10px;border-radius:999px;font-size:13px;color:var(--muted)}\\n    .note{font-size:13px;color:#7b6a5a}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <span class=\\\"name\\\">{{BUSINESS_NAME}}</span>\\n        <small class=\\\"note\\\">Seasonal scent gatherings & careful consultations</small>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Begin</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"blends.html\\\">Concoctions</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n        <a href=\\\"contact.html\\\">Reach</a>\\n      </nav>\\n    </header>\\n\\n    <!-- hero -->\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Clarity in price, calm in choice</h1>\\n        <p>A place to understand the investment for private sessions, group events, and blended kits — clear, kind, and safety-minded.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n      <div style=\\\"margin-left:auto;text-align:right\\\">\\n        <span class=\\\"badge\\\">Events series available</span>\\n        <div style=\\\"font-size:13px;color:#7b6a5a;margin-top:8px\\\">Hosted in {{CITY}}, {{STATE}}</div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"grid\\\">\\n      <div>\\n        <!-- benefits -->\\n        <section class=\\\"card\\\">\\n          <h2 style=\\\"margin-top:0;color:var(--accent)\\\">What your investment supports</h2>\\n          <p class=\\\"muted\\\">Thoughtful time, crafted blends, and clear safety guidance. No medical promises — just sensory care.</p>\\n          <ul>\\n            <li>Private Aromatherapy Consult — 60 minutes, overview & personalized suggestions</li>\\n            <li>Event Series Pass — seasonal workshops and guided scent explorations</li>\\n            <li>Blend Starter Kit — curated oils, carrier, and simple instructions</li>\\n          </ul>\\n        </section>\\n\\n        <!-- process -->\\n        <section class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h3 style=\\\"margin-top:0;color:var(--accent)\\\">How bookings and billing flow</h3>\\n          <ol style=\\\"margin:8px 0;padding-left:18px\\\">\\n            <li>Reserve a time via the booking page.</li>\\n            <li>Receive a confirmation with event details and safety notes.</li>\\n            <li>Pay securely online; refunds follow the policy in your confirmation.</li>\\n          </ol>\\n          <p class=\\\"note\\\">Events are limited by space to keep small-group dynamics safe and attentive.</p>\\n        </section>\\n\\n        <!-- faq -->\\n        <section class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h3 style=\\\"margin-top:0;color:var(--accent)\\\">Common questions</h3>\\n          <dl class=\\\"faq\\\">\\n            <dt>How are prices quoted?</dt>\\n            <dd>Fees are published per session or event. Full details appear before checkout so there are no surprises.</dd>\\n            <dt>What about dilution and safety?</dt>\\n            <dd>Guidance on dilution ratios and carrier use is included with consultations; we always recommend patch testing and conservative dilutions.</dd>\\n            <dt>Can pets attend events?</dt>\\n            <dd>Due to sensitivity and safety, pets are generally not allowed unless explicitly stated for an approved outdoor event.</dd>\\n            <dt>Pregnancy and essential oils?</dt>\\n            <dd>We avoid making medical claims. If you are pregnant, please consult your healthcare provider; we provide non-scented or pregnancy-safe options when requested.</dd>\\n          </dl>\\n        </section>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0;color:var(--accent)\\\">Price tiers</h3>\\n          <div class=\\\"tiers\\\">\\n            <div class=\\\"tier\\\">\\n              <h3>Intro Session</h3>\\n              <div class=\\\"price\\\">$95</div>\\n              <div class=\\\"muted\\\">60 min — includes basic blend suggestions</div>\\n            </div>\\n            <div class=\\\"tier\\\">\\n              <h3>Deep Scent</h3>\\n              <div class=\\\"price\\\">$165</div>\\n              <div class=\\\"muted\\\">90 min — includes personalized starter kit</div>\\n            </div>\\n          </div>\\n          <p class=\\\"note\\\" style=\\\"margin-top:10px\\\">Event series passes and group workshops are priced per series; ask for the seasonal schedule.</p>\\n        </div>\\n\\n        <!-- social proof -->\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h4 style=\\\"margin-top:0;color:var(--accent)\\\">Kind words</h4>\\n          <blockquote style=\\\"margin:0;font-style:italic;color:#6b5a4a\\\">\\\"A gentle, grounded experience — thoughtful and well-guided.\\\" — A. from {{CITY}}</blockquote>\\n        </div>\\n\\n        <!-- lead magnet -->\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h4 style=\\\"margin-top:0;color:var(--accent)\\\">Join the seasonal scent series</h4>\\n          <p class=\\\"muted\\\">A short email series leading into each seasonal workshop: recipes, safety tips, and a members-only early RSVP.</p>\\n          <form onsubmit=\\\"event.preventDefault();alert('Thanks — we\\\\'ll send details to ' + (this.email.value || 'your email') );\\\">\\n            <div class=\\\"lead\\\">\\n              <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"your email\\\" required>\\n              <button type=\\\"submit\\\">Notify me</button>\\n            </div>\\n          </form>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px;text-align:center\\\">\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve a place</a>\\n      <p class=\\\"note\\\" style=\\\"margin-top:8px\\\">Or call <strong>{{PHONE}}</strong> to ask about group rates and accommodations.</p>\\n    </section>\\n\\n    <footer>\\n      <small>{{BUSINESS_NAME}} — {{TAGLINE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></small>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Our Story — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"A short, poetic introduction to the practice and the practitioner. Grounded, safety-forward aromatherapy.\\\">\\n  <style>\\n    :root{--bg:#fffaf5;--accent:#8e4b2e;--soft:#c9b29a;--text:#5b463d}\\n    body{margin:0;font-family:Georgia,serif;color:var(--text);background:linear-gradient(180deg,var(--bg),#f3ebe1);background-image:url('assets/img/pattern.svg')}\\n    .container{max-width:920px;margin:36px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--text);text-decoration:none;margin-left:12px;font-weight:600}\\n    .hero{display:grid;grid-template-columns:1fr 280px;gap:20px;align-items:start;background:rgba(255,255,255,0.7);padding:20px;border-radius:14px}\\n    .hero h1{margin:0;color:var(--accent);font-family:inherit}\\n    .bio{line-height:1.6}\\n    .aside{background:#fff6f2;padding:14px;border-radius:12px}\\n    .social{display:flex;flex-direction:column;gap:8px;margin-top:12px}\\n    .quote{font-style:italic;color:#7b6356}\\n    .process{display:flex;gap:10px;margin-top:18px}\\n    .step{flex:1;padding:12px;background:linear-gradient(180deg,#fff6f0,#fffaf5);border-radius:10px}\\n    .faq dt{font-weight:700;margin-top:10px}\\n    .lead{margin-top:16px}\\n    button.cta{background:var(--accent);color:#fff;padding:10px 14px;border:0;border-radius:10px}\\n    footer{margin-top:28px;text-align:center;color:#7b6356}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div>\\n        <strong style=\\\"color:var(--accent)\\\">{{BUSINESS_NAME}}</strong>\\n        <div style=\\\"font-size:13px;color:#7b6356\\\">A gentle, measured practice — {{TAGLINE}}</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"pricing.html\\\">Fees</a>\\n        <a href=\\\"book.html\\\">Book a time</a>\\n      </nav>\\n    </header>\\n\\n    <!-- hero / story -->\\n    <section class=\\\"hero\\\" aria-labelledby=\\\"about-heading\\\">\\n      <div>\\n        <h1 id=\\\"about-heading\\\">Soft roots and careful craft</h1>\\n        <p class=\\\"bio\\\">I am {{PRACTITIONER_NAME}}. This practice began as a small study of scent and memory, and has grown into a seasonal circle of workshops and mindful consults. We prioritize safety: conservative dilutions, patch testing, and clear notes rather than promises.</p>\\n\\n        <!-- benefits (reordered) -->\\n        <div style=\\\"margin-top:14px\\\">\\n          <h3 style=\\\"margin:0;color:var(--accent)\\\">Why people come</h3>\\n          <ul>\\n            <li>To explore scent with intention — not as medicine, but as a ritual of presence.</li>\\n            <li>To learn safe blending basics and practical dilution.</li>\\n            <li>To join small seasonal events where the work is hands-on and limited in size.</li>\\n          </ul>\\n        </div>\\n\\n        <!-- lead magnet -->\\n        <div class=\\\"lead\\\">\\n          <form onsubmit=\\\"event.preventDefault();alert('Thanks — we\\\\'ll send the seasonal notes to ' + (this.email.value||'your email') );\\\">\\n            <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"Email for seasonal invites\\\" required style=\\\"padding:10px;border-radius:8px;border:1px solid #e7d8cf;width:60%\\\"> \\n            <button class=\\\"cta\\\" type=\\\"submit\\\">Join</button>\\n          </form>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"aside\\\">\\n        <h4 style=\\\"margin:0;color:var(--accent)\\\">A quick lens</h4>\\n        <p class=\\\"quote\\\">\\\"Scent as small daily ritual — deliberate, simple, safe.\\\"</p>\\n        <div class=\\\"social\\\">\\n          <small>Testimonials:</small>\\n          <div style=\\\"font-size:14px\\\">\\\"Attentive guidance and gentle techniques.\\\" — L.</div>\\n          <div style=\\\"font-size:14px\\\">\\\"A clear voice about safety — I appreciated the patch-test instruction.\\\" — R.</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <!-- process (different order) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">A simple process</h3>\\n      <div class=\\\"process\\\">\\n        <div class=\\\"step\\\"><strong>1</strong><div>Reserve a spot — private or event.</div></div>\\n        <div class=\\\"step\\\"><strong>2</strong><div>Fill a brief intake with sensitivities and preferences.</div></div>\\n        <div class=\\\"step\\\"><strong>3</strong><div>Attend with an open mind; receive written safety notes and blend instructions.</div></div>\\n      </div>\\n    </section>\\n\\n    <!-- faq (moved later) -->\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"color:var(--accent)\\\">Practicals & safety</h3>\\n      <dl class=\\\"faq\\\">\\n        <dt>What's a patch test?</dt>\\n        <dd>A small, controlled test to check for skin sensitivity; we provide clear steps so you can test safely at home.</dd>\\n\\n        <dt>How do you recommend dilution?</dt>\\n        <dd>We provide conservative dilution guidelines (commonly 1–3% for topical blends depending on age and sensitivity) and carrier suggestions; never apply undiluted essential oils to skin.</dd>\\n\\n        <dt>Are essential oils safe around pets?</dt>\\n        <dd>Some oils can affect animals. We advise keeping blends out of reach, avoiding direct application to pets, and opting for simple ventilation rather than continuous diffusing when animals are present.</dd>\\n\\n        <dt>Pregnancy considerations?</dt>\\n        <dd>We don\\\\'t offer medical advice. If pregnant, consult your healthcare professional; we can offer unscented or pregnancy-conscious options instead of certain oils.</dd>\\n      </dl>\\n    </section>\\n\\n    <footer>\\n      <small>{{PRACTITIONER_NAME}} — {{BUSINESS_NAME}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></small>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Reserve a Session — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Book private consultations or sign up for the next seasonal aromatherapy event series. Safety-first approach.\\\">\\n  <style>\\n    :root{--bg:#fff8f2;--accent:#6f3f24;--warm:#d9b89b;--ink:#523f37}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:var(--bg);color:var(--ink);background-image:url('assets/img/pattern.svg')}\\n    .shell{max-width:900px;margin:36px auto;padding:26px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:12px;text-decoration:none;color:var(--ink);font-weight:600}\\n    .hero{padding:18px;background:linear-gradient(180deg,#fff 0%,#fff6f2 100%);border-radius:12px;display:flex;justify-content:space-between;align-items:center}\\n    .hero h1{margin:0;color:var(--accent)}\\n    .booking{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    .form{background:#fff;padding:16px;border-radius:12px}\\n    label{display:block;margin-top:10px;font-weight:600}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #ecd9cd}\\n    button.primary{background:var(--accent);color:#fff;border:0;padding:10px 14px;border-radius:10px;margin-top:12px}\\n    .aside{background:rgba(255,255,255,0.9);padding:14px;border-radius:12px}\\n    .steps{display:flex;flex-direction:column;gap:8px}\\n    .step{padding:10px;border-radius:8px;background:#fff7f2;border:1px solid rgba(111,63,36,0.06)}\\n    .faq dt{font-weight:700;margin-top:10px}\\n    .social{margin-top:12px}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"shell\\\">\\n    <header>\\n      <div>\\n        <strong style=\\\"color:var(--accent)\\\">{{BUSINESS_NAME}}</strong>\\n        <div style=\\\"font-size:13px;color:#7b6356\\\">Reserve a private consult or join the event series</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"services.html\\\">Services</a>\\n        <a href=\\\"pricing.html\\\">Investments</a>\\n        <a href=\\\"about.html\\\">Story</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Reserve your time or a seat</h1>\\n        <p style=\\\"margin:6px 0 0;color:#6b584f\\\">Choose a private consultation or the next seasonal gathering. We keep groups small and instructions thorough.</p>\\n      </div>\\n      <div style=\\\"text-align:right\\\">\\n        <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent);text-decoration:none;font-weight:700\\\">Call to ask: {{PHONE}}</a>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"booking\\\">\\n      <main class=\\\"form\\\">\\n        <h3 style=\\\"margin-top:0;color:var(--accent)\\\">Booking form</h3>\\n        <form onsubmit=\\\"event.preventDefault();alert('Booked: ' + this.service.value + ' on ' + this.date.value + '. We will contact ' + this.email.value );\\\">\\n          <label for=\\\"service\\\">Choose a session</label>\\n          <select id=\\\"service\\\" name=\\\"service\\\" required>\\n            <option>Private Aromatherapy Consult — 60 min</option>\\n            <option>Deep Consult + Starter Kit — 90 min</option>\\n            <option>Seasonal Event Series — 4-part workshop pass</option>\\n            <option>Small Group Workshop — half-day</option>\\n          </select>\\n\\n          <label for=\\\"date\\\">Preferred date</label>\\n          <input id=\\\"date\\\" name=\\\"date\\\" type=\\\"date\\\" required>\\n\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" required>\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required>\\n\\n          <label for=\\\"notes\\\">Sensitivities & notes</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"3\\\" placeholder=\\\"Any allergies, pregnancy status, or scent sensitivities?\\\" ></textarea>\\n\\n          <div style=\\\"display:flex;gap:8px;align-items:center;margin-top:10px\\\">\\n            <input type=\\\"checkbox\\\" id=\\\"terms\\\" required>\\n            <label for=\\\"terms\\\" style=\\\"font-size:13px\\\">I understand this is aromatherapy and not medical care; I agree to follow dilution and patch-test guidance.</label>\\n          </div>\\n\\n          <button class=\\\"primary\\\" type=\\\"submit\\\">Request Booking</button>\\n        </form>\\n\\n        <!-- benefits (short) -->\\n        <div style=\\\"margin-top:14px\\\">\\n          <h4 style=\\\"margin:0;color:var(--accent)\\\">What to expect</h4>\\n          <ul>\\n            <li>Clear safety instructions and dilution guidance.</li>\\n            <li>Written notes and suggested blends; no medical claims.</li>\\n            <li>Small groups for events; limited seats for clarity and comfort.</li>\\n          </ul>\\n        </div>\\n      </main>\\n\\n      <aside class=\\\"aside\\\">\\n        <!-- process (compact) -->\\n        <h4 style=\\\"margin-top:0;color:var(--accent)\\\">Booking flow</h4>\\n        <div class=\\\"steps\\\">\\n          <div class=\\\"step\\\"><strong>Reserve</strong> — request a date and session type.</div>\\n          <div class=\\\"step\\\"><strong>Confirm</strong> — receive confirmation, safety notes, and payment link.</div>\\n          <div class=\\\"step\\\"><strong>Attend</strong> — arrive with questions; receive written blend notes and aftercare.</div>\\n        </div>\\n\\n        <!-- social proof -->\\n        <div class=\\\"social\\\">\\n          <h5 style=\\\"margin:12px 0 6px;color:var(--accent)\\\">Praise</h5>\\n          <div style=\\\"font-size:14px\\\">\\\"Careful guidance, and a pacing that felt safe and informative.\\\" — S.</div>\\n        </div>\\n\\n        <!-- faq (concise) -->\\n        <div style=\\\"margin-top:12px\\\">\\n          <h5 style=\\\"color:var(--accent)\\\">Quick FAQ</h5>\\n          <dl class=\\\"faq\\\">\\n            <dt>Do you require patch tests?</dt>\\n            <dd>We recommend them for any topical use; we provide simple instructions.</dd>\\n            <dt>Will there be strong scent in sessions?</dt>\\n            <dd>Sessions are intentionally moderate; we avoid overpowering diffusing and offer ventilation breaks.</dd>\\n            <dt>What about pregnancy?</dt>\\n            <dd>Please note pregnancy status in the intake; we will avoid certain oils and recommend consulting your provider.</dd>\\n          </dl>\\n        </div>\\n\\n        <!-- lead magnet CTA -->\\n        <div style=\\\"margin-top:12px\\\">\\n          <button onclick=\\\"alert('Thanks — we\\\\'ll send event invites to the email you provide.')\\\" class=\\\"primary\\\">Join the series waitlist</button>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer style=\\\"margin-top:18px;text-align:center;color:#7b6356\\\">\\n      <small>Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>. {{BUSINESS_NAME}} — {{TAGLINE}}</small>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
