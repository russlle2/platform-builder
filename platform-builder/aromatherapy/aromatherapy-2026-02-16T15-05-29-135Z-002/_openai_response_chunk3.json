          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Pricing — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#7aa986;--muted:#6b6b6b;--bg:#fbfbfb;--card:#ffffff;--glass:rgba(255,255,255,0.6);--shadow:0 6px 18px rgba(46,60,41,0.08);font-family:Inter,system-ui,Segoe UI,Helvetica,Arial,sans-serif}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg),#f1f7f2);color:#213;}\\n    /* Unique SVG pattern embedded as a data URL (also intended as assets/img/pattern.svg) */\\n    :root{--pattern:url(\\\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200' viewBox='0 0 200 200'><defs><linearGradient id='g' x1='0' x2='1'><stop offset='0' stop-color='%237aa986'/><stop offset='1' stop-color='%23cbead8'/></linearGradient><pattern id='p' width='40' height='40' patternUnits='userSpaceOnUse'><rect width='40' height='40' fill='rgba(255,255,255,0.02)'/><circle cx='10' cy='10' r='4' fill='rgba(0,0,0,0.04)'/><path d='M0 40 L40 0' stroke='%237aa986' stroke-opacity='0.06' stroke-width='1'/></pattern></defs><rect width='100%' height='100%' fill='url(%23p)'/><rect x='0' y='0' width='200' height='200' fill='url(%23g)' opacity='0.06'/></svg>\\\");}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px;background:var(--card);backdrop-filter:blur(6px);box-shadow:var(--shadow);position:sticky;top:0;z-index:30}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#cdeecd);display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n    nav a{margin-left:18px;color:#264; text-decoration:none;font-weight:600}\\n    .container{max-width:1100px;margin:34px auto;padding:28px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;background:var(--card);padding:28px;border-radius:12px;box-shadow:var(--shadow);background-image:var(--pattern)}\\n    .hero h1{margin:0;font-size:28px;color:#17341f}\\n    .hero p{color:var(--muted);margin-top:8px}\\n    .price-card{background:linear-gradient(180deg,rgba(255,255,255,0.9),var(--glass));padding:20px;border-radius:10px}\\n    .tier{display:flex;flex-direction:column;gap:10px;padding:16px;border-radius:10px;background:var(--card);box-shadow:0 6px 18px rgba(34,50,34,0.04)}\\n    .tiers{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-top:18px}\\n    .benefits{display:flex;flex-direction:column;gap:10px}\\n    .muted{color:var(--muted)}\\n    .social{display:flex;gap:10px;align-items:center}\\n    .avatar{width:44px;height:44px;border-radius:999px;background:#e9f7ef;display:inline-flex;align-items:center;justify-content:center;font-weight:700;color:#1b4}\\n    footer{padding:36px;text-align:center;color:var(--muted)}\\n    .faq{margin-top:22px;background:linear-gradient(180deg,#fff,#fbfffb);padding:18px;border-radius:10px}\\n    .lead{display:flex;gap:12px;align-items:center;margin-top:18px}\\n    input[type='email']{padding:12px;border-radius:8px;border:1px solid #e6efe6;flex:1}\\n    button.primary{background:var(--accent);border:none;color:white;padding:12px 16px;border-radius:8px;font-weight:700}\\n    .cta-row{display:flex;gap:12px;margin-top:16px}\\n    @media(max-width:900px){.hero{grid-template-columns:1fr;}.tiers{grid-template-columns:1fr}.container{padding:16px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Boutique</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <!-- HERO: Pricing container with a gentle safety-forward intro -->\\n    <section class=\\\"hero\\\" aria-label=\\\"Pricing\\\">\\n      <div>\\n        <h1>Transparent pricing for mindful aromatherapy</h1>\\n        <p class=\\\"muted\\\">Clear, safety-first sessions and curated blends. No medical claims — just thoughtful guidance, plant intelligence, and practical rituals you can use at home.</p>\\n\\n        <div class=\\\"benefits\\\" aria-hidden=\\\"false\\\">\\n          <div style=\\\"display:flex;gap:10px;align-items:center\\\"><svg width=\\\"18\\\" height=\\\"18\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"10\\\" stroke=\\\"#7aa986\\\" stroke-width=\\\"2\\\"/></svg><strong>One-hour VIP Day</strong> — a focused session for blend design and ritual planning.</div>\\n          <div style=\\\"display:flex;gap:10px;align-items:center\\\"><svg width=\\\"18\\\" height=\\\"18\\\" fill=\\\"#264\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M12 2 L22 8 L12 14 L2 8 Z\\\"/></svg><strong>Follow-up care</strong> — straightforward notes and safety reminders after every session.</div>\\n        </div>\\n\\n        <div class=\\\"cta-row\\\">\\n          <a class=\\\"primary\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a href=\\\"contact.html\\\" style=\\\"padding:12px 16px;border-radius:8px;background:transparent;border:1px solid #e2efe2;color:var(--muted);text-decoration:none\\\">Ask a question</a>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"price-card\\\" aria-label=\\\"Packages\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div>\\n            <div style=\\\"font-size:14px;color:var(--muted)\\\">Popular</div>\\n            <div style=\\\"font-weight:800;font-size:20px\\\">VIP Day — Custom Blend & Ritual</div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <div style=\\\"font-size:12px;color:var(--muted)\\\">From</div>\\n            <div style=\\\"font-weight:900;font-size:24px\\\">$650</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"tiers\\\">\\n          <div class=\\\"tier\\\">\\n            <div style=\\\"font-weight:700\\\">Mini Care Session</div>\\n            <div class=\\\"muted\\\">30 minutes • consultation & safety overview</div>\\n            <div style=\\\"margin-top:auto;font-weight:800\\\">$120</div>\\n          </div>\\n\\n          <div class=\\\"tier\\\">\\n            <div style=\\\"font-weight:700\\\">Therapeutic Blend Kit</div>\\n            <div class=\\\"muted\\\">Includes 6ml blends & notes</div>\\n            <div style=\\\"margin-top:auto;font-weight:800\\\">$85</div>\\n          </div>\\n\\n          <div class=\\\"tier\\\">\\n            <div style=\\\"font-weight:700\\\">VIP Day</div>\\n            <div class=\\\"muted\\\">3–4 hour deep design + follow-ups</div>\\n            <div style=\\\"margin-top:auto;font-weight:800\\\">$650</div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;font-size:13px;color:var(--muted)\\\">All packages include safety guidance, dilution charts, and simple usage notes. Subscriptions and product shipping available in {{CITY}}, {{STATE}}.</div>\\n      </aside>\\n    </section>\\n\\n    <!-- SOCIAL PROOF: short testimonials -->\\n    <section style=\\\"margin-top:18px;display:flex;gap:12px;align-items:center;justify-content:space-between\\\">\\n      <div class=\\\"social\\\">\\n        <div class=\\\"avatar\\\">JS</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">\\\"Practical and gentle\\\"</div>\\n          <div class=\\\"muted\\\">\\\"I loved the step-by-step guidance and the dilution chart made it easy to use blends safely.\\\" — J. S.</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"social\\\">\\n        <div class=\\\"avatar\\\">AM</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">\\\"Thoughtful sessions\\\"</div>\\n          <div class=\\\"muted\\\">\\\"A calming experience that left me confident to make blends at home.\\\" — A. M.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- BENEFITS: short bullets focused on safety and usability -->\\n    <section style=\\\"margin-top:22px;background:var(--card);padding:18px;border-radius:12px;box-shadow:var(--shadow)\\\">\\n      <h2 style=\\\"margin:0 0 8px 0\\\">What you get</h2>\\n      <ul class=\\\"muted\\\">\\n        <li>Personalized blend recipe with top/middle/base notes and aromatic profile.</li>\\n        <li>Clear dilution recommendations and patch-test guidance.</li>\\n        <li>Written notes and safe storage tips; non-medical wellbeing support.</li>\\n      </ul>\\n    </section>\\n\\n    <!-- FAQ: safety-first questions including dilution/patch/pets/pregnancy -->\\n    <section class=\\\"faq\\\" aria-label=\\\"FAQ\\\">\\n      <h3 style=\\\"margin-top:0\\\">Common questions</h3>\\n      <details>\\n        <summary>How should I dilute essential oils?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Dilution depends on age, skin sensitivity, and intended use. Typical topical dilutions range from 0.5% (children, sensitive skin) to 5% (adults, short-term use). Every session includes a personalized dilution plan. This is not medical advice.</div>\\n      </details>\\n\\n      <details>\\n        <summary>Do I need to do a patch test?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Yes — we recommend a small patch test on the forearm with your intended dilution for 24 hours. If irritation occurs, discontinue use. Patch testing info is included in every care note.</div>\\n      </details>\\n\\n      <details>\\n        <summary>Are essential oils safe for pets?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Some oils may be irritating to pets. We provide pet-safety guidance and list oils to avoid around cats and small mammals. Consult your veterinarian for medical concerns; our guidance is precautionary and safety-focused.</div>\\n      </details>\\n\\n      <details>\\n        <summary>What about pregnancy and breastfeeding?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Pregnancy and breastfeeding require special caution. We offer pregnancy-safe options and will avoid contraindicated oils, but this is not a substitute for medical care. Always share pregnancy status before a session.</div>\\n      </details>\\n    </section>\\n\\n    <!-- LEAD MAGNET: email capture for a dilution chart PDF -->\\n    <section style=\\\"margin-top:18px;display:flex;gap:12px;align-items:center;padding:16px;border-radius:12px;background:linear-gradient(180deg,#fff,#fbfffb);box-shadow:var(--shadow)\\\">\\n      <div style=\\\"flex:1\\\">\\n        <div style=\\\"font-weight:800\\\">Free: Home Dilution Chart</div>\\n        <div class=\\\"muted\\\">Get a printable dilution chart and patch-test checklist. Safety-first, simple language.</div>\\n      </div>\\n      <form style=\\\"display:flex;gap:8px;flex:1;max-width:520px\\\" onsubmit=\\\"event.preventDefault();alert('Thank you — we\\\\'ll email the chart.');\\\">\\n        <input type=\\\"email\\\" placeholder=\\\"Your email\\\" aria-label=\\\"Email\\\" required>\\n        <button class=\\\"primary\\\">Send me the chart</button>\\n      </form>\\n    </section>\\n\\n    <!-- CALL TO ACTION -->\\n    <section style=\\\"margin-top:22px;display:flex;gap:12px;align-items:center;justify-content:space-between\\\">\\n      <div>\\n        <div style=\\\"font-weight:800\\\">Ready to design your blend?</div>\\n        <div class=\\\"muted\\\">Book a VIP Day or a shorter consult. We keep sessions practical, safety-focused, and rooted in aromatic skill.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"primary\\\" href=\\\"book.html\\\">Book a session</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — {{PRACTITIONER_NAME}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    <small class=\\\"muted\\\">Serving {{CITY}}, {{STATE}} — All guidance is non-medical and safety-first.</small>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--brand:#7aa986;--ink:#203428;--muted:#6b6b6b;--card:#fff;--bg:#fbfdfb;font-family:Inter,Helvetica,Arial,sans-serif}\\n    body{margin:0;background:linear-gradient(180deg,#f7fcf8,#fbfbfb);color:var(--ink)}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 26px;background:var(--card);box-shadow:0 8px 26px rgba(23,52,31,0.05);position:sticky;top:0}\\n    .logo{width:50px;height:50px;border-radius:10px;background:linear-gradient(135deg,var(--brand),#d9efe0);display:flex;align-items:center;justify-content:center;color:white;font-weight:800}\\n    nav a{margin-left:16px;text-decoration:none;color:var(--muted)}\\n    .wrap{max-width:1000px;margin:32px auto;padding:18px}\\n    .lead{display:flex;gap:20px;align-items:center}\\n    .portrait{width:140px;height:140px;border-radius:14px;background:linear-gradient(180deg,#fff,#f6fff6);box-shadow:0 8px 18px rgba(20,60,30,0.06);display:flex;align-items:center;justify-content:center;font-weight:800}\\n    .who{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 10px 28px rgba(22,44,28,0.04)}\\n    .process{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}\\n    .step{background:linear-gradient(180deg,#fff,#fbfffb);padding:14px;border-radius:10px}\\n    .socials{display:flex;gap:8px;align-items:center;margin-top:8px}\\n    .blob{position:absolute;right:-120px;top:60px;width:320px;height:320px;opacity:0.08;filter:blur(18px)}\\n    .faq{margin-top:18px;background:var(--card);padding:16px;border-radius:12px}\\n    .leadmag{display:flex;gap:8px;margin-top:12px}\\n    @media(max-width:800px){.lead{flex-direction:column;align-items:flex-start}.process{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">{{PRACTITIONER_NAME?.slice(0,1) || 'A'}}</div>\\n      <div>\\n        <div style=\\\"font-weight:900\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"blends.html\\\">Our Blends</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Get in touch</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <!-- HERO: practitioner story emphasizing craft and safety -->\\n    <section class=\\\"who\\\" aria-label=\\\"About\\\">\\n      <div class=\\\"lead\\\">\\n        <div class=\\\"portrait\\\">{{PRACTITIONER_NAME?.split(' ').slice(0,1)[0] || 'P'}}</div>\\n        <div>\\n          <h1 style=\\\"margin:0\\\">Meet {{PRACTITIONER_NAME}}</h1>\\n          <p style=\\\"margin:6px 0;color:var(--muted)\\\">A practical aromatherapy practitioner focused on safe, usable blends and rituals you can rely on in everyday life.</p>\\n\\n          <div class=\\\"socials\\\">\\n            <div style=\\\"font-weight:700\\\">Safety-first practice</div>\\n            <div class=\\\"muted\\\">• Personalized dilution plans</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:12px;color:var(--muted);font-size:14px\\\">{{PRACTITIONER_NAME}} trained in aromatic formulation and botanical safety, combining botanical knowledge with a pragmatic approach. Sessions are non-medical and centered on wellbeing, not treatment.</div>\\n    </section>\\n\\n    <!-- PROCESS: how a client experience typically flows (different order than other pages) -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2>How we collaborate</h2>\\n      <div class=\\\"process\\\">\\n        <div class=\\\"step\\\">\\n          <strong>1 — Intake & priorities</strong>\\n          <div class=\\\"muted\\\">We start with a gentle intake to understand preferences, sensitivities, and safety constraints (pets, pregnancy, meds).</div>\\n        </div>\\n\\n        <div class=\\\"step\\\">\\n          <strong>2 — Blend design</strong>\\n          <div class=\\\"muted\\\">Top/middle/base notes are balanced for aroma and usability; dilution is tailored to your needs.</div>\\n        </div>\\n\\n        <div class=\\\"step\\\">\\n          <strong>3 — Safe use plan</strong>\\n          <div class=\\\"muted\\\">Written instructions for application, patch testing, and storage; alternatives for home diffusion and topical use.</div>\\n        </div>\\n\\n        <div class=\\\"step\\\">\\n          <strong>4 — Follow-up</strong>\\n          <div class=\\\"muted\\\">A short check-in to refine blends or answer questions; adjustments are part of the service.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- BENEFITS: quick points about outcomes but no medical claims -->\\n    <section style=\\\"margin-top:18px;display:flex;gap:12px\\\">\\n      <div style=\\\"flex:1;background:linear-gradient(180deg,#fff,#fbfffb);padding:14px;border-radius:10px;box-shadow:0 6px 18px rgba(20,44,28,0.04)\\\">\\n        <h3 style=\\\"margin-top:0\\\">What clients gain</h3>\\n        <ul class=\\\"muted\\\">\\n          <li>Confident, safe use of essential oils at home.</li>\\n          <li>Customized blend with clear, practical instructions.</li>\\n          <li>Resources: dilution charts, patch-test steps, and pet-safety notes.</li>\\n        </ul>\\n      </div>\\n\\n      <aside style=\\\"width:260px;background:var(--card);padding:12px;border-radius:10px;box-shadow:0 6px 16px rgba(20,44,28,0.03)\\\">\\n        <div style=\\\"font-weight:800\\\">Quick facts</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Sessions available in-person in {{CITY}} and remotely. Gift certificates and small-group workshops on request.</div>\\n      </aside>\\n    </section>\\n\\n    <!-- SOCIAL PROOF: client blurbs but different style/order -->\\n    <section style=\\\"margin-top:18px;display:flex;flex-direction:column;gap:10px\\\">\\n      <h3>Stories from clients</h3>\\n      <blockquote style=\\\"margin:0;padding:12px;border-left:4px solid var(--brand);background:#fff;border-radius:6px\\\">\\\"I appreciated the clear dilution instructions and the patience in testing scents. Practical tools to use daily.\\\" — L.</blockquote>\\n      <blockquote style=\\\"margin:0;padding:12px;border-left:4px solid #d9e9dd;background:#fff;border-radius:6px\\\">\\\"Thoughtful, safety-minded approach — great for a beginner like me.\\\" — R.</blockquote>\\n    </section>\\n\\n    <!-- FAQ: include required aromatherapy safety Qs -->\\n    <section class=\\\"faq\\\" aria-label=\\\"About FAQ\\\">\\n      <h4 style=\\\"margin-top:0\\\">Questions about practice & safety</h4>\\n      <details>\\n        <summary>Dilution guidance — how is it chosen?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Dilution is chosen based on age, skin sensitivity, and intended application. Recommended percentages are shared during the session and recorded for your use. If you're pregnant or nursing, dilutions are more conservative and certain oils are avoided.</div>\\n      </details>\\n\\n      <details>\\n        <summary>Patch testing instructions</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">We walk you through a standardized patch test to check for irritation. Patch testing on the forearm for 24 hours is the usual approach.</div>\\n      </details>\\n\\n      <details>\\n        <summary>Pet safety</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">We flag oils that can be problematic around cats and small animals and recommend safe diffusion practices and alternatives.</div>\\n      </details>\\n\\n      <details>\\n        <summary>Pregnancy & breastfeeding considerations</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Certain essential oils are avoided in pregnancy. We will provide pregnancy-safe alternatives and clear usage limits. This is precautionary guidance, not medical counsel.</div>\\n      </details>\\n    </section>\\n\\n    <!-- LEAD MAGNET: about page offers a short checklist -->\\n    <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center;padding:12px;background:linear-gradient(180deg,#fff,#f8fff8);border-radius:10px\\\">\\n      <div>\\n        <div style=\\\"font-weight:800\\\">Free checklist: Patch test & Home Safety</div>\\n        <div class=\\\"muted\\\">A handy one-page checklist for your first topical uses and diffusion best practices.</div>\\n      </div>\\n      <form onsubmit=\\\"event.preventDefault();alert('Checklist requested — thank you');\\\" class=\\\"leadmag\\\">\\n        <input type=\\\"email\\\" placeholder=\\\"Email\\\" required style=\\\"padding:10px;border-radius:8px;border:1px solid #e8efe8\\\">\\n        <button style=\\\"background:var(--brand);color:white;border:none;padding:10px 14px;border-radius:8px;font-weight:700\\\">Send</button>\\n      </form>\\n    </section>\\n\\n    <!-- CTA: personal invite different tone -->\\n    <section style=\\\"margin-top:18px;text-align:center\\\">\\n      <h3 style=\\\"margin:0\\\">Want a guided session?</h3>\\n      <p class=\\\"muted\\\">Book a short consult or reserve a VIP Day. I focus on simple, practical solutions built around your life.</p>\\n      <a href=\\\"book.html\\\" style=\\\"display:inline-block;margin-top:10px;background:var(--brand);color:white;padding:12px 18px;border-radius:10px;text-decoration:none\\\">Reserve a time</a>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"padding:28px;text-align:center;color:var(--muted)\\\">\\n    <div>{{BUSINESS_NAME}} • {{PRACTITIONER_NAME}}</div>\\n    <div><a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a Session — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--green:#7aa986;--bg:#f6fbf7;--muted:#637063;font-family:Inter,system-ui,Segoe UI,Helvetica,Arial}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg),#f1f7f2);color:#123}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 22px;background:#ffffff;border-bottom:1px solid #eef6ec}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .wrap{max-width:980px;margin:30px auto;padding:18px}\\n    .hero{background:linear-gradient(180deg,#fff,#f9fffa);padding:18px;border-radius:12px;display:flex;gap:20px;align-items:center;box-shadow:0 8px 24px rgba(18,52,36,0.04)}\\n    .steps{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:14px}\\n    .card{background:#fff;border-radius:10px;padding:14px;box-shadow:0 8px 20px rgba(16,40,30,0.04)}\\n    .form-row{display:flex;gap:8px}\\n    label{font-size:13px;color:var(--muted)}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e6efe6}\\n    button.primary{background:var(--green);color:#fff;border:none;padding:12px 14px;border-radius:8px;cursor:pointer}\\n    .faq{margin-top:16px}\\n    @media(max-width:900px){.steps{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n      <a href=\\\"about.html\\\">Who we are</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <!-- HERO: booking prompt -->\\n    <section class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1 style=\\\"margin:0\\\">Book a session with {{PRACTITIONER_NAME}}</h1>\\n        <p style=\\\"margin-top:8px;color:var(--muted)\\\">Choose a short consult or a VIP Day to design blends and routines. All sessions include safety guidance and follow-up notes.</p>\\n        <div style=\\\"margin-top:12px;display:flex;gap:8px\\\">\\n          <a href=\\\"#book-form\\\" class=\\\"primary\\\">Start booking</a>\\n          <a href=\\\"contact.html\\\" style=\\\"padding:12px 14px;border-radius:8px;border:1px solid #e6efe6;color:var(--muted);text-decoration:none\\\">Ask a question</a>\\n        </div>\\n      </div>\\n      <aside style=\\\"width:220px;text-align:center\\\">\\n        <div style=\\\"font-weight:800\\\">Need help?</div>\\n        <div class=\\\"muted\\\" style=\\\"font-size:13px;margin-top:6px\\\">Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </aside>\\n    </section>\\n\\n    <div class=\\\"steps\\\">\\n      <!-- PROCESS: booking steps in clear sequence -->\\n      <section>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">Booking steps</h3>\\n          <ol class=\\\"muted\\\">\\n            <li>Pick a session length (30min consult, 60min design, or VIP Day).</li>\\n            <li>Share preferences & safety notes (pregnancy, pets, meds).</li>\\n            <li>Receive confirmation, pre-visit safety checklist, and intake form.</li>\\n            <li>Session + written blend notes and dilution plan.</li>\\n          </ol>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0 0 8px 0\\\">Available sessions</h4>\\n          <div class=\\\"muted\\\">30-min Quick Consult — $120\\n          <br>60-min Design Session — $240\\n          <br>VIP Day (3–4 hours) — $650</div>\\n        </div>\\n\\n        <!-- SOCIAL PROOF -->\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <strong>Recent feedback</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">\\\"Clear, calm, and practical. The notes made follow-up easy.\\\" — M.</div>\\n        </div>\\n      </section>\\n\\n      <!-- BOOKING FORM (lead magnet + booking combined) -->\\n      <aside>\\n        <form id=\\\"book-form\\\" class=\\\"card\\\" onsubmit=\\\"event.preventDefault();alert('Booking request sent — we\\\\'ll follow up via email.');\\\">\\n          <h3 style=\\\"margin-top:0\\\">Request a booking</h3>\\n          <label>Name<input type=\\\"text\\\" name=\\\"name\\\" required></label>\\n          <label>Email<input type=\\\"email\\\" name=\\\"email\\\" required></label>\\n          <label>Phone (optional)<input type=\\\"text\\\" name=\\\"phone\\\"></label>\\n          <label>Session type\\n            <select name=\\\"session\\\">\\n              <option>30-min Quick Consult — $120</option>\\n              <option>60-min Design Session — $240</option>\\n              <option>VIP Day — $650</option>\\n            </select>\\n          </label>\\n\\n          <label>Any safety notes? (pets, pregnancy, sensitivities)\\n            <textarea name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"E.g., cat at home, sensitive skin, pregnant\\\" ></textarea>\\n          </label>\\n\\n          <div style=\\\"display:flex;gap:8px;margin-top:12px\\\">\\n            <button class=\\\"primary\\\" type=\\\"submit\\\">Request booking</button>\\n            <a href=\\\"pricing.html\\\" style=\\\"padding:10px 12px;border-radius:8px;border:1px solid #e6efe6;text-decoration:none;color:var(--muted);display:inline-flex;align-items:center\\\">View pricing</a>\\n          </div>\\n        </form>\\n\\n        <div style=\\\"margin-top:12px\\\" class=\\\"card\\\">\\n          <strong>Prep for your session</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">You will receive a short intake form and a safety checklist. Please let us know if you or household members have allergies, are pregnant, or have pets.</div>\\n        </div>\\n\\n      </aside>\\n    </div>\\n\\n    <!-- FAQ: keep short and safety-focused -->\\n    <section class=\\\"faq card\\\" style=\\\"margin-top:18px\\\">\\n      <h4 style=\\\"margin-top:0\\\">Booking FAQs</h4>\\n      <details>\\n        <summary>How do you handle pregnancy or breastfeeding?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Please indicate pregnancy or breastfeeding at booking. We provide pregnancy-safe alternatives and conservative dilutions. This is precautionary, not medical advice.</div>\\n      </details>\\n      <details>\\n        <summary>What about pets?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Tell us about household pets. We will advise on diffusion, avoidance of certain oils, and safe ventilation practices.</div>\\n      </details>\\n      <details>\\n        <summary>Why do you recommend patch testing?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Patch testing reduces the chance of topical irritation. We include patch-test instructions and appropriate dilutions with each blend.</div>\\n      </details>\\n    </section>\\n\\n    <!-- LEAD MAGNET: insert short downloadable appointment checklist -->\\n    <section style=\\\"margin-top:16px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <strong>Free checklist:</strong>\\n        <div class=\\\"muted\\\">Prep your home for a safe aromatherapy session — what to know and what to share.</div>\\n      </div>\\n      <form onsubmit=\\\"event.preventDefault();alert('Checklist will be emailed.');\\\" style=\\\"display:flex;gap:8px\\\">\\n        <input type=\\\"email\\\" placeholder=\\\"Email\\\" required style=\\\"padding:10px;border-radius:8px;border:1px solid #e6efe6\\\">\\n        <button class=\\\"primary\\\">Email checklist</button>\\n      </form>\\n    </section>\\n\\n    <!-- CTA: gentle prompt to use the primary CTA -->\\n    <section style=\\\"margin-top:18px;text-align:center\\\">\\n      <div style=\\\"font-weight:800\\\">Ready to make time for yourself?</div>\\n      <div class=\\\"muted\\\">Book a consult and receive a blend tailored to your practical needs — with safety notes included.</div>\\n      <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:inline-block;margin-top:10px;background:var(--green);color:#fff;padding:12px 16px;border-radius:8px;text-decoration:none\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"padding:22px;text-align:center;color:var(--muted)\\\">\\n    <div>{{BUSINESS_NAME}} — Serving {{CITY}}, {{STATE}}</div>\\n    <div>Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
