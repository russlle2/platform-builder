          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Plans & Pricing</title>\\n  <style>\\n    :root{--glass-bg:rgba(255,255,255,0.12);--glass-border:rgba(255,255,255,0.18);--accent:#6aa84f;--muted:#cfead0;--text:#0b2a23;--card:#ffffff22}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:var(--text);background:linear-gradient(180deg,#f3f9f5 0%,#eaf7f0 50%);-webkit-font-smoothing:antialiased}\\n    /* SVG background layer */\\n    .background-svg{position:fixed;inset:0;z-index:-1;opacity:0.55}\\n    .wrap{max-width:1100px;margin:48px auto;padding:36px;border-radius:16px;background:linear-gradient(135deg,rgba(255,255,255,0.35),rgba(255,255,255,0.08));box-shadow:0 8px 30px rgba(18,38,30,0.08);backdrop-filter:blur(8px);border:1px solid var(--glass-border)}\\n    header{display:flex;align-items:center;justify-content:space-between;gap:20px}\\n    .brand{display:flex;align-items:center;gap:14px}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#92c47d);display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n    nav a{margin-left:12px;color:var(--text);text-decoration:none;font-weight:600}\\n    main{display:grid;grid-template-columns:1fr 360px;gap:28px;margin-top:28px}\\n    .hero{padding:22px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.6),rgba(255,255,255,0.28));box-shadow:inset 0 1px 0 #fff8}\\n    h1{margin:0 0 8px 0;font-size:22px}\\n    p.lead{margin:0;color:#134226}\\n    .tiers{display:flex;flex-direction:column;gap:14px;margin-top:18px}\\n    .card{padding:18px;border-radius:12px;background:var(--card);border:1px solid rgba(255,255,255,0.12)}\\n    .tier-header{display:flex;align-items:center;justify-content:space-between}\\n    .price{font-size:20px;font-weight:700;color:#08341f}\\n    .features{margin-top:12px;color:#0a382a}\\n    .cta{display:inline-block;margin-top:14px;padding:10px 14px;background:linear-gradient(90deg,var(--accent),#86b86a);color:white;border-radius:10px;text-decoration:none;font-weight:700}\\n    aside .lead-magnet{padding:16px;border-radius:12px;background:linear-gradient(180deg,#ffffff55,#ffffff22);border:1px solid rgba(255,255,255,0.08)}\\n    .small{font-size:13px;color:#234b3b}\\n    footer{margin-top:22px;padding-top:10px;border-top:1px dashed rgba(0,0,0,0.05)}\\n    .testimonials{display:flex;flex-direction:column;gap:10px;margin-top:18px}\\n    .badge{display:inline-block;padding:6px 10px;border-radius:999px;background:#ffffff22;font-weight:700;color:#062d20}\\n    /* responsive */\\n    @media (max-width:900px){main{grid-template-columns:1fr;}\\n      .brand .logo{width:46px;height:46px}}\\n  </style>\\n</head>\\n<body>\\n  <!-- decorative SVG pattern (unique to this page) -->\\n  <svg class=\\\"background-svg\\\" viewBox=\\\"0 0 1200 600\\\" preserveAspectRatio=\\\"xMidYMid slice\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#e6f6ea\\\" stop-opacity=\\\"1\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#dff2e2\\\" stop-opacity=\\\"1\\\"/></linearGradient>\\n      <pattern id=\\\"p1\\\" width=\\\"120\\\" height=\\\"120\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"120\\\" height=\\\"120\\\" fill=\\\"url(#g1)\\\"/>\\n        <circle cx=\\\"20\\\" cy=\\\"20\\\" r=\\\"6\\\" fill=\\\"#cfead0\\\" opacity=\\\"0.7\\\"/>\\n        <circle cx=\\\"100\\\" cy=\\\"100\\\" r=\\\"10\\\" fill=\\\"#eaf7f0\\\" opacity=\\\"0.6\\\"/>\\n      </pattern>\\n      <filter id=\\\"soft\\\" x=\\\"-20%\\\" y=\\\"-20%\\\" width=\\\"140%\\\" height=\\\"140%\\\"><feGaussianBlur stdDeviation=\\\"32\\\"/></filter>\\n    </defs>\\n    <rect width=\\\"1200\\\" height=\\\"600\\\" fill=\\\"url(#p1)\\\"/>\\n    <g filter=\\\"url(#soft)\\\">\\n      <ellipse cx=\\\"300\\\" cy=\\\"220\\\" rx=\\\"260\\\" ry=\\\"120\\\" fill=\\\"#cfead0\\\" opacity=\\\"0.35\\\"/>\\n      <ellipse cx=\\\"900\\\" cy=\\\"380\\\" rx=\\\"320\\\" ry=\\\"140\\\" fill=\\\"#e6f6ea\\\" opacity=\\\"0.34\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">A</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted);margin-top:2px\\\">Subtle aromatherapy for calm routines</div>\\n        </div>\\n      </div>\\n      <nav aria-label=\\\"primary\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"shop.html\\\">Store</a>\\n        <a href=\\\"pricing.html\\\" style=\\\"opacity:0.9\\\">Plans</a>\\n        <a href=\\\"about.html\\\">Our Story</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"hero\\\">\\n        <h1>Transparent pricing for thoughtful aromatherapy sessions</h1>\\n        <p class=\\\"lead\\\">Flexible options to suit one-off exploration, short programs, or steady ritual support. All sessions emphasize safety, education, and non-medical wellbeing techniques.</p>\\n\\n        <div class=\\\"tiers\\\">\\n          <div class=\\\"card\\\">\\n            <div class=\\\"tier-header\\\">\\n              <div>\\n                <strong>Single Consultation</strong>\\n                <div class=\\\"small\\\">60 minutes — personalized session</div>\\n              </div>\\n              <div class=\\\"price\\\">$95</div>\\n            </div>\\n            <div class=\\\"features\\\">\\n              - Intake + scent exploration; recommendations for topical dilution and safe home use.<br>\\n              - Written notes and recommended blends.\\n            </div>\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a single session</a>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <div class=\\\"tier-header\\\">\\n              <div>\\n                <strong>3-Session Pathway</strong>\\n                <div class=\\\"small\\\">Bundles to support routine and learning</div>\\n              </div>\\n              <div class=\\\"price\\\">$260</div>\\n            </div>\\n            <div class=\\\"features\\\">\\n              - Three 45–60 min appointments; progressive adjustments; priority message support between sessions.\\n            </div>\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve the 3-session pathway</a>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <div class=\\\"tier-header\\\">\\n              <div>\\n                <strong>Monthly Ritual (Hybrid)</strong>\\n                <div class=\\\"small\\\">A subscription model for ongoing care</div>\\n              </div>\\n              <div class=\\\"price\\\">$45 / month</div>\\n            </div>\\n            <div class=\\\"features\\\">\\n              - Monthly 30-min check-in + a curated sample blend each quarter. Flexible cancel anytime.\\n            </div>\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start monthly ritual</a>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <div class=\\\"tier-header\\\">\\n              <div>\\n                <strong>Custom Blend Add-on</strong>\\n                <div class=\\\"small\\\">Hand-blended, labeled, and safety-checked</div>\\n              </div>\\n              <div class=\\\"price\\\">$38</div>\\n            </div>\\n            <div class=\\\"features\\\">\\n              - Up to a 10 mL roll-on or diluted dropper blend. Includes dilution guidance and usage notes.\\n            </div>\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Add a custom blend</a>\\n          </div>\\n        </div>\\n\\n        <footer class=\\\"small\\\">\\n          All offerings are educational and complementary care. Not a substitute for medical advice. Please consult a licensed healthcare professional for medical concerns. If you are pregnant, nursing, or under medical supervision, mention this at booking.\\n        </footer>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"lead-magnet\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <strong>Free guide:</strong>\\n            <span class=\\\"badge\\\">Quick Safety Checklist</span>\\n          </div>\\n          <p class=\\\"small\\\" style=\\\"margin-top:10px\\\">Sign up to receive a concise, safety-first aromatherapy checklist — dilution basics, patch testing steps, and simple storage tips.</p>\\n          <form method=\\\"post\\\" action=\\\"{{PRIMARY_CTA_URL}}/subscribe\\\" style=\\\"margin-top:10px;display:flex;gap:8px\\\">\\n            <input name=\\\"email\\\" type=\\\"email\\\" required placeholder=\\\"Email address\\\" style=\\\"flex:1;padding:10px;border-radius:8px;border:1px solid rgba(0,0,0,0.06)\\\" />\\n            <button class=\\\"cta\\\" style=\\\"padding:9px 12px;border-radius:8px\\\">Send</button>\\n          </form>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px;padding:12px\\\">\\n          <strong>Trusted by clients</strong>\\n          <div class=\\\"testimonials\\\">\\n            <div class=\\\"small\\\">“Practical, gentle, and clear — I learned how to use oils safely.” — A.M.</div>\\n            <div class=\\\"small\\\">“The monthly ritual keeps me grounded. Thoughtful guidance.” — R.S.</div>\\n          </div>\\n        </div>\\n      </aside>\\n    </main>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#fbfff9;--accent:#4aa479;--muted:#8fbf9a;--panel:rgba(255,255,255,0.16)}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,var(--bg1),#e9f7ef);color:#072b22}\\n    .container{max-width:980px;margin:36px auto;padding:28px;border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,0.65),rgba(255,255,255,0.28));backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,0.12)}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    .nav a{margin-left:12px;color:#073826;text-decoration:none;font-weight:600}\\n    .intro{display:flex;gap:22px;margin-top:18px}\\n    .bio{flex:1}\\n    .profile{width:220px;border-radius:12px;padding:16px;background:var(--panel);border:1px solid rgba(255,255,255,0.08)}\\n    .kpi{display:flex;gap:12px;margin-top:12px}\\n    .kpi div{padding:10px 12px;border-radius:10px;background:#ffffff22}\\n    h2{margin:0 0 8px 0}\\n    .process{margin-top:18px;display:grid;grid-template-columns:repeat(3,1fr);gap:12px}\\n    .step{padding:12px;border-radius:12px;background:#ffffff22;border:1px solid rgba(255,255,255,0.06)}\\n    .cta{display:inline-block;margin-top:16px;padding:10px 14px;background:linear-gradient(90deg,var(--accent),#79b07d);color:white;border-radius:10px;text-decoration:none}\\n    .faq{margin-top:18px;padding:14px;border-radius:10px;background:linear-gradient(180deg,#ffffff55,#ffffff22)}\\n    /* small screens */\\n    @media (max-width:800px){.intro{flex-direction:column}.process{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique SVG background for about page -->\\n  <svg viewBox=\\\"0 0 1000 600\\\" style=\\\"position:fixed;inset:0;z-index:-1;opacity:0.5\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"bggrad\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#f6fffb\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#e8f7ee\\\"/></linearGradient>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#bggrad)\\\"/>\\n    <g opacity=\\\"0.14\\\">\\n      <path d=\\\"M0 200 C150 100 350 100 500 200 C650 300 850 300 1000 200 L1000 600 L0 600 Z\\\" fill=\\\"#dff3e8\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,#63a86a,#8fcf8f);display:flex;align-items:center;justify-content:center;color:white;font-weight:800\\\">{{PRACTITIONER_NAME}}</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"services.html\\\">Therapies</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"pricing.html\\\">Plans</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"intro\\\">\\n      <div class=\\\"bio\\\">\\n        <h2>Meet your aromatherapy guide</h2>\\n        <p style=\\\"margin-top:6px\\\">Hello — I’m {{PRACTITIONER_NAME}}. I work with aroma in a safety-first, educational way to help people build gentle daily practices. My training includes certified coursework in clinical-grade aroma safety and botanical stewardship. My approach is evidence-informed without making medical claims.</p>\\n\\n        <div class=\\\"kpi\\\" aria-hidden=\\\"true\\\">\\n          <div>\\n            <div style=\\\"font-weight:800\\\">8+</div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">years practice</div>\\n          </div>\\n          <div>\\n            <div style=\\\"font-weight:800\\\">1200+</div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">sessions</div>\\n          </div>\\n        </div>\\n\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Schedule an intro</a>\\n      </div>\\n\\n      <aside class=\\\"profile\\\">\\n        <strong>Certified & careful</strong>\\n        <p style=\\\"font-size:13px;margin-top:8px\\\">Training in safety protocols, dilution guidelines, and client education. Emphasis on non-invasive, topical-friendly blends and diffuser recommendations.</p>\\n        <div style=\\\"margin-top:10px\\\"><strong>Location</strong><div style=\\\"font-size:13px;color:var(--muted)\\\">{{CITY}}, {{STATE}}</div></div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>How I work — a three-part practice</h3>\\n      <div class=\\\"process\\\">\\n        <div class=\\\"step\\\">\\n          <strong>1. Intake & Safety</strong>\\n          <div style=\\\"font-size:13px;margin-top:8px\\\">Discuss goals, sensitivities, medications, pregnancy, and household pets to ensure safe suggestions.</div>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <strong>2. Exploration</strong>\\n          <div style=\\\"font-size:13px;margin-top:8px\\\">Scent sampling, education on dilution and application, and at-home trial plans.</div>\\n        </div>\\n        <div class=\\\"step\\\">\\n          <strong>3. Support</strong>\\n          <div style=\\\"font-size:13px;margin-top:8px\\\">Follow-up adjustments and written usage guidance tailored to your needs.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h4 style=\\\"margin:0 0 8px 0\\\">Quick safety notes</h4>\\n      <ul style=\\\"margin:0;padding-left:18px\\\">\\n        <li style=\\\"margin-bottom:8px\\\"><strong>Dilution:</strong> I recommend dilution guidelines for topical blends based on age and sensitivity. Never apply undiluted essential oils to skin.</li>\\n        <li style=\\\"margin-bottom:8px\\\"><strong>Patch tests:</strong> A small skin patch test is advised before longer-term topical use.</li>\\n        <li style=\\\"margin-bottom:8px\\\"><strong>Pets:</strong> Some botanicals can affect animals. Tell me about household pets so I can make safe suggestions.</li>\\n        <li style=\\\"margin-bottom:8px\\\"><strong>Pregnancy & medical:</strong> If pregnant, nursing, or under medical care, we'll use extra caution and consult guidelines; this service does not replace medical advice.</li>\\n      </ul>\\n    </section>\\n\\n    <section style=\\\"margin-top:16px\\\">\\n      <h4>Partner organizations & reviews</h4>\\n      <p style=\\\"font-size:13px;color:var(--muted)\\\">Featured in local wellness newsletters; small-group workshops for clinical support staff. Testimonials available on request.</p>\\n    </section>\\n\\n    <footer style=\\\"margin-top:18px;font-size:13px;color:#254f3f\\\">Contact: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a session — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f5fbf7;--card:#ffffffaa;--accent:#389e6a;--muted:#6fae84}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,var(--bg),#eaf6ef);color:#083a2a}\\n    .shell{max-width:920px;margin:30px auto;padding:20px}\\n    .hero{display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,0.6);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.12)}\\n    .hero h1{margin:0;font-size:18px}\\n    .nav{margin-top:12px}\\n    .nav a{margin-right:10px;text-decoration:none;color:var(--muted);font-weight:700}\\n    .content{display:grid;grid-template-columns:1fr 360px;gap:18px;margin-top:18px}\\n    .booking-card{padding:18px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.65),rgba(255,255,255,0.28));backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,0.10)}\\n    label{display:block;margin-top:10px;font-weight:700}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(0,0,0,0.06);margin-top:6px}\\n    .btn{display:inline-block;padding:10px 14px;background:linear-gradient(90deg,var(--accent),#66b07f);color:white;border-radius:10px;text-decoration:none;margin-top:12px}\\n    .note{font-size:13px;color:#24583f;margin-top:10px}\\n    .aside{padding:14px;border-radius:12px;background:#ffffff22}\\n    .faq{margin-top:12px}\\n    .muted{font-size:13px;color:#2c6147}\\n    @media (max-width:880px){.content{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- booking page decorative motif (unique SVG) -->\\n  <svg viewBox=\\\"0 0 800 600\\\" style=\\\"position:fixed;inset:0;z-index:-1;opacity:0.45\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <radialGradient id=\\\"rg\\\" cx=\\\"30%\\\" cy=\\\"20%\\\"><stop offset=\\\"0\\\" stop-color=\\\"#e6fbef\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#dff3ea\\\"/></radialGradient>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#rg)\\\"/>\\n    <g opacity=\\\"0.18\\\">\\n      <circle cx=\\\"120\\\" cy=\\\"480\\\" r=\\\"220\\\" fill=\\\"#cfead0\\\"/>\\n      <circle cx=\\\"700\\\" cy=\\\"120\\\" r=\\\"140\\\" fill=\\\"#e9f7f0\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"shell\\\">\\n    <div class=\\\"hero\\\">\\n      <div>\\n        <h1>Schedule a session — practical guidance, gentle pace</h1>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Choose a format and tell us about your preferences. Sessions are education-forward and safety-conscious.</div>\\n      </div>\\n      <div style=\\\"text-align:right\\\">\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{CITY}}, {{STATE}}</div>\\n      </div>\\n    </div>\\n\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"pricing.html\\\">Plans</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n\\n    <div class=\\\"content\\\">\\n      <section class=\\\"booking-card\\\">\\n        <form method=\\\"post\\\" action=\\\"{{PRIMARY_CTA_URL}}/book\\\">\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"Your name\\\" required />\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@domain.com\\\" required />\\n\\n          <label for=\\\"phone\\\">Phone (optional)</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"{{PHONE}}\\\" />\\n\\n          <label for=\\\"format\\\">Preferred format</label>\\n          <select id=\\\"format\\\" name=\\\"format\\\">\\n            <option>In-person consultation</option>\\n            <option>Virtual video session</option>\\n            <option>Phone check-in</option>\\n          </select>\\n\\n          <label for=\\\"goal\\\">What would you like to focus on?</label>\\n          <textarea id=\\\"goal\\\" name=\\\"goal\\\" rows=\\\"4\\\" placeholder=\\\"e.g., evening relaxation, sleep-friendly blends, diffuser guidance\\\"></textarea>\\n\\n          <label for=\\\"notes\\\">Health & household notes</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"3\\\" placeholder=\\\"Allergies, pregnancy, medications, pets (please be specific)\\\"></textarea>\\n\\n          <div class=\\\"muted\\\">By booking you acknowledge this is an educational service and not medical treatment. If you are pregnant or under medical care, you will be asked about that so recommendations can be adjusted.</div>\\n\\n          <button class=\\\"btn\\\" type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n        </form>\\n\\n        <div class=\\\"note\\\">\\n          After booking, you will receive a short intake form and preparation notes. We will also include a brief guide on how to do a patch test at home and basic dilution charts.\\n        </div>\\n      </section>\\n\\n      <aside class=\\\"aside\\\">\\n        <strong>Before you arrive</strong>\\n        <ul style=\\\"padding-left:16px;margin-top:8px\\\">\\n          <li>Perform a patch test for any new topical blend.</li>\\n          <li>Note pets and their exposure — we will advise safer diffuser placement.</li>\\n          <li>If pregnant or nursing, mention this; some botanicals are avoided.</li>\\n        </ul>\\n\\n        <div class=\\\"faq\\\">\\n          <h4 style=\\\"margin:10px 0 6px 0\\\">FAQ — quick guidance</h4>\\n          <div style=\\\"font-size:13px\\\">\\n            <strong>Dilution:</strong> Typical adult topical dilutions range 1–3% for routine use; lower for sensitive individuals and children.<br/><br/>\\n            <strong>Patch test:</strong> Apply a small diluted sample to inner forearm and observe for 24 hours before broader use.<br/><br/>\\n            <strong>Pets:</strong> Keep diffusers elevated and rooms ventilated; inform us of species and size for tailored advice.<br/><br/>\\n            <strong>Pregnancy & medication:</strong> We will default to extra caution and avoid certain botanicals; always coordinate with your healthcare provider.\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <strong>Need immediate assistance?</strong>\\n          <div style=\\\"font-size:13px;margin-top:6px\\\">Call: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n          <div style=\\\"margin-top:6px\\\"><a class=\\\"btn\\\" href=\\\"mailto:{{EMAIL}}\\\">Email the practitioner</a></div>\\n        </div>\\n      </aside>\\n    </div>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
