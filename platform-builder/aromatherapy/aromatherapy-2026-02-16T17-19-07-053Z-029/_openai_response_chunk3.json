          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Pricing — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f1724;--glass:rgba(255,255,255,0.06);--accent:linear-gradient(135deg,#9be7ff 0%,#c39fff 100%);--muted:rgba(255,255,255,0.65);}    \\n    html,body{height:100%;margin:0;font-family:Inter,ui-sans-serif,system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;color:var(--muted);background:radial-gradient(1200px 600px at 10% 10%,rgba(67,56,202,0.12),transparent),radial-gradient(800px 400px at 90% 90%,rgba(3,218,198,0.06),transparent),var(--bg);background-attachment:fixed}\\n    body{display:flex;align-items:flex-start;justify-content:center;padding:32px}\\n    .wrap{width:100%;max-width:1100px}\\n    header{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:28px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:14px;background:var(--glass);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(2,6,23,0.6) inset}\\n    .logo svg{width:36px;height:36px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:14px;font-size:14px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border-radius:16px;padding:24px;box-shadow:0 6px 32px rgba(2,6,23,0.6);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.04)}\\n    .hero{display:grid;grid-template-columns:1fr 320px;gap:24px;margin-bottom:20px}\\n    h1{margin:0;color:#fff;font-size:28px}\\n    p.lead{margin:8px 0 0;color:var(--muted)}\\n    .tiers{display:flex;gap:18px;margin-top:18px}\\n    .tier{flex:1;padding:18px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.015),transparent);border:1px solid rgba(255,255,255,0.04)}\\n    .tier h3{margin:0 0 8px;color:#fff}\\n    .price{font-size:20px;color:#fff;margin:10px 0}\\n    .features{font-size:14px;color:var(--muted);line-height:1.5}\\n    .btn{display:inline-block;padding:10px 14px;border-radius:10px;background:var(--accent);color:#021023;text-decoration:none;font-weight:600;margin-top:12px}\\n    .muted-sm{font-size:13px;color:rgba(255,255,255,0.6)}\\n    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:18px}\\n    .faq dt{font-weight:700;color:#fff;margin-top:12px}\\n    .faq dd{margin:6px 0 12px;color:var(--muted);font-size:14px}\\n    footer{margin-top:22px;text-align:center;color:rgba(255,255,255,0.45);font-size:13px}\\n    /* subtle background pattern */\\n    .bg-pattern{position:fixed;inset:0;z-index:-1;opacity:0.12;background-image:url('/assets/img/pattern.svg');background-repeat:repeat}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.tiers{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"bg-pattern\\\" aria-hidden=\\\"true\\\"></div>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo card\\\"><svg viewBox=\\\"0 0 64 64\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><defs></defs><rect x=\\\"6\\\" y=\\\"6\\\" width=\\\"52\\\" height=\\\"52\\\" rx=\\\"10\\\" fill=\\\"url(#g)\\\" opacity=\\\"0.95\\\"/><g fill=\\\"#021023\\\" opacity=\\\"0.18\\\"><path d=\\\"M32 20c-6 0-10 5-10 12s4 12 10 12 10-5 10-12-4-12-10-12z\\\"/></g><defs><linearGradient id=\\\"g\\\" x1=\\\"0\\\" x2=\\\"1\\\" y1=\\\"0\\\" y2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#9be7ff\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#c39fff\\\"/></linearGradient></defs></svg></div>\\n        <div>\\n          <div style=\\\"color:#fff;font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Sessions</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"card hero\\\" aria-label=\\\"Pricing hero\\\">\\n      <div>\\n        <h1>Transparent pricing for thoughtful aromatherapy</h1>\\n        <p class=\\\"lead\\\">Choose the right way to work together — from starter kits to an immersive VIP Day that deep-dives into your needs. Safe, evidence-informed guidance for aromatic wellbeing practices (non-medical).</p>\\n        <div class=\\\"tiers\\\" role=\\\"list\\\">\\n          <div class=\\\"tier\\\" role=\\\"listitem\\\">\\n            <h3>Starter Consultation</h3>\\n            <div class=\\\"price\\\">$95 — 45 minutes</div>\\n            <div class=\\\"features\\\">A focused session to match blends to your lifestyle, patch-test guidance, and a simple at-home plan.</div>\\n            <a class=\\\"btn\\\" href=\\\"book.html?plan=starter\\\">Book starter</a>\\n          </div>\\n\\n          <div class=\\\"tier\\\" role=\\\"listitem\\\">\\n            <h3>Essential Plan</h3>\\n            <div class=\\\"price\\\">$295 — includes custom roll-on kit</div>\\n            <div class=\\\"features\\\">Personal blend formula, dilution chart, and a follow-up check-in. Ideal for building a safe routine.</div>\\n            <a class=\\\"btn\\\" href=\\\"book.html?plan=essential\\\">Reserve Essential</a>\\n          </div>\\n\\n          <div class=\\\"tier\\\" role=\\\"listitem\\\">\\n            <h3>VIP Day (single intensive)</h3>\\n            <div class=\\\"price\\\">$1,800 — 6 hours</div>\\n            <div class=\\\"features\\\">A dedicated day: lifestyle intake, sensory mapping, full blend creation, and a take-home bespoke kit. Fast, focused, and private.</div>\\n            <a class=\\\"btn\\\" href=\\\"book.html?plan=vip\\\">Book VIP Day</a>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\" style=\\\"align-self:start\\\">\\n        <div style=\\\"font-weight:700;color:#fff\\\">Why our VIP Day?</div>\\n        <p class=\\\"muted-sm\\\">In one day you'll co-create practical blends, learn safe dilution and storage, and leave with a clear at-home plan. The experience is structured — ideal if you want rapid progress without medical advice.</p>\\n        <div style=\\\"margin-top:12px\\\">\\n          <a class=\\\"btn\\\" href=\\\"book.html?plan=vip\\\">Schedule a VIP Day</a>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"color:#fff;margin:0\\\">Client stories</h2>\\n      <p class=\\\"muted-sm\\\">Real people, practical results — focused on lifestyle support, not cures.</p>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px\\\">\\n        <blockquote style=\\\"margin:0;padding:12px;border-radius:10px;background:rgba(255,255,255,0.02)\\\"><strong style=\\\"color:#fff\\\">\\\"A gentle, precise approach.\\\"</strong><div class=\\\"muted-sm\\\">— S., found a calming nightly routine</div></blockquote>\\n        <blockquote style=\\\"margin:0;padding:12px;border-radius:10px;background:rgba(255,255,255,0.02)\\\"><strong style=\\\"color:#fff\\\">\\\"I felt guided, safe, and informed.\\\"</strong><div class=\\\"muted-sm\\\">— RL, received a custom blend</div></blockquote>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"color:#fff;margin:0\\\">How pricing and process work</h2>\\n      <div class=\\\"grid-2\\\" style=\\\"margin-top:12px\\\">\\n        <div>\\n          <h3 style=\\\"color:#fff;margin-top:0\\\">Transparent steps</h3>\\n          <ol style=\\\"color:var(--muted);padding-left:18px\\\">\\n            <li>Choose a plan — Starter, Essential, or VIP Day.</li>\\n            <li>Complete the intake form after booking.</li>\\n            <li>Attend your session; receive blend files, dilution guidance, and care notes.</li>\\n            <li>Receive a follow-up summary and recommended products (non-medical).</li>\\n          </ol>\\n        </div>\\n        <div>\\n          <h3 style=\\\"color:#fff;margin-top:0\\\">What's included</h3>\\n          <ul style=\\\"color:var(--muted);padding-left:18px\\\">\\n            <li>Personalized blend recipes (top/mid/base notes).</li>\\n            <li>Clear dilution charts and safe-use tips.</li>\\n            <li>Patch test and pet-safety reminders.</li>\\n            <li>Storage and sourcing suggestions.</li>\\n          </ul>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"color:#fff;margin:0\\\">Frequently asked — pricing & safety</h2>\\n      <dl class=\\\"faq\\\" style=\\\"margin-top:12px\\\">\\n        <dt>Do prices include blends and materials?</dt>\\n        <dd>Starter consultations are session-only; Essential and VIP include a small take-home kit detailed on booking pages.</dd>\\n        <dt>What about dilution and patch tests?</dt>\\n        <dd>Every formula includes a dilution recommendation and a step-by-step patch-test. Always test on a small area and wait 24 hours for reactions.</dd>\\n        <dt>Are blends safe around pets?</dt>\\n        <dd>Many oils can affect pets. I provide pet-safety notes and alternatives; do not diffuse near animals without prior guidance.</dd>\\n        <dt>Pregnancy and sensitive populations?</dt>\\n        <dd>I avoid recommending oils contraindicated in pregnancy and will adapt blends for sensitive cases. Consult your healthcare provider for medical concerns.</dd>\\n      </dl>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px;display:flex;gap:12px;align-items:center;justify-content:space-between\\\">\\n      <div>\\n        <strong style=\\\"color:#fff\\\">Get the pricing guide + dilution chart</strong>\\n        <p class=\\\"muted-sm\\\">Download a free two-page guide covering dilution basics and safe-at-home practices.</p>\\n      </div>\\n      <form action=\\\"/lead\\\" method=\\\"post\\\" style=\\\"display:flex;gap:8px;align-items:center\\\">\\n        <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@domain.com\\\" style=\\\"padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.06);background:rgba(255,255,255,0.02);color:var(--muted)\\\" required>\\n        <button class=\\\"btn\\\">Send guide</button>\\n      </form>\\n    </section>\\n\\n    <footer>\\n      <div>{{PRACTITIONER_NAME}} — {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n      <div style=\\\"margin-top:8px;font-size:12px;color:rgba(255,255,255,0.35)\\\">Safe practice statement: information provided is educational and safety-focused, not medical advice.</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071026;--glass:rgba(255,255,255,0.04);--accent:linear-gradient(90deg,#ffd6a5,#ffd1f5);--muted:rgba(255,255,255,0.7)}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;color:var(--muted);background:linear-gradient(180deg,#061324 0%,#08172a 60%)}\\n    .container{max-width:980px;margin:28px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .nav a{color:var(--muted);text-decoration:none;margin-left:12px}\\n    .hero{display:flex;gap:18px;align-items:center;margin-top:18px}\\n    .glass{background:var(--glass);border-radius:14px;padding:18px;backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.03)}\\n    h1{color:#fff;margin:0}\\n    p{margin:10px 0;color:var(--muted)}\\n    .meta{font-size:13px;color:rgba(255,255,255,0.6)}\\n    .grid{display:grid;grid-template-columns:2fr 1fr;gap:14px;margin-top:18px}\\n    .cta{margin-top:14px}\\n    .btn{padding:10px 12px;border-radius:10px;background:var(--accent);color:#071026;text-decoration:none;font-weight:700}\\n    .process{margin-top:18px}\\n    .faq dt{font-weight:700;color:#fff;margin-top:12px}\\n    .faq dd{margin:6px 0 12px;color:var(--muted);font-size:14px}\\n    .bg{position:fixed;inset:0;z-index:-1;background-image:url('/assets/img/pattern.svg');opacity:0.08}\\n    @media(max-width:840px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"bg\\\" aria-hidden=\\\"true\\\"></div>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"width:58px;height:58px;border-radius:12px;background:linear-gradient(180deg,#9be7ff,#c39fff)\\\"></div>\\n        <div>\\n          <div style=\\\"color:#fff;font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div class=\\\"meta\\\">Practitioner-led aromatherapy — practical, safety-first guidance</div>\\n        </div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Overview</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"pricing.html\\\">Rates</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"hero\\\">\\n        <div class=\\\"glass\\\" style=\\\"flex:1\\\">\\n          <h1>Meet your aromatherapy guide</h1>\\n          <p>I’m {{PRACTITIONER_NAME}}. I combine scent literacy, evidence-aware safety practices, and client-centered listening to create blends you can realistically use at home. My approach avoids medical claims — instead, I offer supportive rituals, clear dilution guidance, and practical storage and patch testing instructions.</p>\\n          <p class=\\\"meta\\\">Based in {{CITY}}, {{STATE}} — offering remote and in-person VIP Days by appointment.</p>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Book a session</a></div>\\n        </div>\\n\\n        <aside class=\\\"glass\\\" style=\\\"width:320px\\\">\\n          <h3 style=\\\"color:#fff;margin:0\\\">Quick facts</h3>\\n          <ul style=\\\"color:var(--muted);padding-left:18px;margin-top:8px\\\">\\n            <li>Years practicing: 10+</li>\\n            <li>Specialties: calming routines, sleep-support rituals, scent layering</li>\\n            <li>Offer model: VIP Day for fast, deep work</li>\\n          </ul>\\n        </aside>\\n      </section>\\n\\n      <section class=\\\"glass process\\\">\\n        <h2 style=\\\"color:#fff;margin:0\\\">My process — a practical map</h2>\\n        <p class=\\\"meta\\\">Think of it as a sensory roadmap: we explore, we test, we leave with clear next steps.</p>\\n        <ol style=\\\"color:var(--muted);padding-left:18px\\\">\\n          <li>Intake: lifestyle, scent history, and safety flags (pets, pregnancy, allergies).</li>\\n          <li>Sensory session: gentle sampling of notes and preferences; no pressure.</li>\\n          <li>Formulation: co-create blends with explicit dilution and patch-test steps.</li>\\n          <li>Aftercare: written notes, storage advice, and a follow-up check-in.</li>\\n        </ol>\\n      </section>\\n\\n      <section class=\\\"glass\\\" style=\\\"margin-top:18px\\\">\\n        <h2 style=\\\"color:#fff;margin:0\\\">Benefits — what clients typically gain</h2>\\n        <div style=\\\"display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:12px\\\">\\n          <div style=\\\"padding:10px;background:rgba(255,255,255,0.02);border-radius:8px\\\"><strong style=\\\"color:#fff\\\">Clarity</strong><div class=\\\"meta\\\">Clear instructions on how and when to use blends</div></div>\\n          <div style=\\\"padding:10px;background:rgba(255,255,255,0.02);border-radius:8px\\\"><strong style=\\\"color:#fff\\\">Safety</strong><div class=\\\"meta\\\">Dilution, patch tests, and pet-aware guidance</div></div>\\n          <div style=\\\"padding:10px;background:rgba(255,255,255,0.02);border-radius:8px\\\"><strong style=\\\"color:#fff\\\">Simplicity</strong><div class=\\\"meta\\\">Easy-to-follow routines you can actually keep</div></div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"glass\\\" style=\\\"margin-top:18px\\\">\\n        <h2 style=\\\"color:#fff;margin:0\\\">Frequently asked (safety essentials)</h2>\\n        <dl class=\\\"faq\\\" style=\\\"margin-top:10px\\\">\\n          <dt>How do you handle dilution recommendations?</dt>\\n          <dd>I provide clear dilution charts with each formula and explain how to measure and label blends at home.</dd>\\n          <dt>What's your patch test approach?</dt>\\n          <dd>Patch tests are always recommended: apply a small amount diluted on the inner forearm and monitor for 24 hours.</dd>\\n          <dt>Are essential oils safe around pets?</dt>\\n          <dd>Some oils are not recommended near animals. I offer pet-friendly alternatives and use diffusion practices that minimize exposure.</dd>\\n          <dt>Can you work with pregnancy?</dt>\\n          <dd>I adapt recommendations for pregnancy and sensitive clients and avoid oils with known contraindications; I do not provide medical advice.</dd>\\n        </dl>\\n      </section>\\n\\n      <section class=\\\"glass\\\" style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <strong style=\\\"color:#fff\\\">Download my starter checklist</strong>\\n          <p class=\\\"meta\\\" style=\\\"margin:6px 0\\\">A practical checklist for safe storage, dilution, and first patch tests.</p>\\n        </div>\\n        <form action=\\\"/lead\\\" method=\\\"post\\\" style=\\\"display:flex;gap:8px\\\">\\n          <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"email@domain\\\" style=\\\"padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:var(--muted)\\\" required>\\n          <button class=\\\"btn\\\">Send checklist</button>\\n        </form>\\n      </section>\\n\\n    </main>\\n\\n    <footer style=\\\"margin-top:18px;color:rgba(255,255,255,0.45);font-size:13px\\\">\\n      <div>{{PRACTITIONER_NAME}} — {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n      <div style=\\\"margin-top:6px\\\">Offer model highlight: VIP Day intensive available — great for a one-day deep dive.</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071226;--glass:rgba(255,255,255,0.03);--accent:#8ef3d6;--muted:rgba(255,255,255,0.75)}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;color:var(--muted);background:linear-gradient(180deg,#05111a,#071226)}\\n    .wrap{max-width:920px;margin:28px auto;padding:20px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:12px}\\n    .banner{display:flex;gap:16px;align-items:center;margin-top:18px}\\n    .glass{background:var(--glass);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03);backdrop-filter:blur(6px)}\\n    h1{color:#fff;margin:0}\\n    .steps{display:flex;gap:12px;margin-top:12px}\\n    .step{flex:1;padding:12px;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent)}\\n    label{display:block;margin-top:10px;font-size:13px;color:var(--muted)}\\n    input,select,textarea{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:var(--muted)}\\n    .btn{padding:10px 14px;border-radius:10px;background:var(--accent);color:#021022;border:none;font-weight:700}\\n    .faq dt{font-weight:700;color:#fff;margin-top:12px}\\n    .faq dd{margin:6px 0 12px;color:var(--muted);font-size:14px}\\n    .bg{position:fixed;inset:0;z-index:-1;background-image:url('/assets/img/pattern.svg');opacity:0.06}\\n    @media(max-width:760px){.steps{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"bg\\\" aria-hidden=\\\"true\\\"></div>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"width:52px;height:52px;border-radius:10px;background:linear-gradient(90deg,#9be7ff,#c39fff)\\\"></div>\\n        <div>\\n          <div style=\\\"color:#fff;font-weight:700\\\">Reserve time with {{PRACTITIONER_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{BUSINESS_NAME}} — personalized aromatherapy, safety-first</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n      </nav>\\n    </header>\\n\\n    <main style=\\\"margin-top:18px\\\">\\n      <section class=\\\"glass banner\\\">\\n        <div style=\\\"flex:1\\\">\\n          <h1>Book a session</h1>\\n          <p style=\\\"margin:8px 0;color:var(--muted)\\\">Choose a session type below. After you book, you'll receive an intake form to complete essential safety and preference details.</p>\\n          <div style=\\\"margin-top:12px;font-size:13px;color:var(--muted)\\\">Offer spotlight: VIP Day — a single-day immersion to craft tailored blends and practical routines.</div>\\n        </div>\\n        <aside style=\\\"width:260px\\\">\\n          <div style=\\\"font-weight:700;color:#fff\\\">Need help?</div>\\n          <div style=\\\"font-size:13px;color:var(--muted);margin-top:8px\\\">Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n        </aside>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px;display:grid;grid-template-columns:1fr 380px;gap:14px\\\">\\n        <form class=\\\"glass\\\" style=\\\"padding:18px\\\" action=\\\"/book\\\" method=\\\"post\\\">\\n          <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n            <label style=\\\"font-weight:700;color:#fff\\\">Select plan</label>\\n            <select name=\\\"plan\\\" required>\\n              <option value=\\\"starter\\\">Starter Consultation — $95</option>\\n              <option value=\\\"essential\\\">Essential Plan — $295</option>\\n              <option value=\\\"vip\\\">VIP Day — $1,800</option>\\n            </select>\\n          </div>\\n\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"Your name\\\" required>\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@domain.com\\\" required>\\n\\n          <label for=\\\"phone\\\">Phone</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"Optional phone number\\\">\\n\\n          <label for=\\\"notes\\\">Anything to flag? (pets, pregnancy, allergies)</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Please note any pets in the home, pregnancy, or skin sensitivities\\\"></textarea>\\n\\n          <div style=\\\"display:flex;gap:8px;margin-top:12px;align-items:center\\\">\\n            <input id=\\\"agree\\\" name=\\\"agree\\\" type=\\\"checkbox\\\" required>\\n            <label for=\\\"agree\\\" style=\\\"font-size:13px;color:var(--muted)\\\">I understand this service provides educational aromatherapy guidance, not medical treatment.</label>\\n          </div>\\n\\n          <div style=\\\"margin-top:14px\\\">\\n            <button class=\\\"btn\\\" type=\\\"submit\\\">Request booking</button>\\n          </div>\\n        </form>\\n\\n        <aside class=\\\"glass\\\" style=\\\"padding:18px\\\">\\n          <h3 style=\\\"color:#fff;margin-top:0\\\">What happens after you book</h3>\\n          <ol style=\\\"color:var(--muted);padding-left:18px\\\">\\n            <li>You’ll receive an intake form covering safety flags and preferences.</li>\\n            <li>We confirm timing and steps for any patch tests or pet-safety adjustments.</li>\\n            <li>On the day: focused session, take-home notes, and dilution guidance.</li>\\n          </ol>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <strong style=\\\"color:#fff\\\">Need a tailored quote?</strong>\\n            <p style=\\\"color:var(--muted);margin:6px 0\\\">For custom group sessions or product orders, reach out directly.</p>\\n            <a class=\\\"btn\\\" href=\\\"contact.html\\\">Contact</a>\\n          </div>\\n        </aside>\\n      </section>\\n\\n      <section class=\\\"glass\\\" style=\\\"margin-top:14px\\\">\\n        <h2 style=\\\"color:#fff;margin:0\\\">Frequently asked — booking & safety</h2>\\n        <dl class=\\\"faq\\\" style=\\\"margin-top:10px\\\">\\n          <dt>How soon can I book a VIP Day?</dt>\\n          <dd>Availability varies; VIP Days are scheduled in advance. Choose the VIP option and add a preferred date in the notes — we’ll follow up with confirmation.</dd>\\n          <dt>Do you require a patch test before sessions?</dt>\\n          <dd>Patch testing is recommended for new topical blends. I will provide instructions and timing in your intake packet.</dd>\\n          <dt>What should I tell you about pets?</dt>\\n          <dd>Tell me species, size, and distance of their typical location during diffusion. I will recommend pet-safe practices and alternatives.</dd>\\n          <dt>Can you advise for pregnancy?</dt>\\n          <dd>I provide adapted, safety-forward suggestions for pregnancy and sensitive populations, but not medical advice.</dd>\\n        </dl>\\n      </section>\\n\\n      <section style=\\\"margin-top:12px;display:flex;gap:12px;align-items:center\\\">\\n        <div class=\\\"glass\\\" style=\\\"flex:1;padding:12px\\\">\\n          <strong style=\\\"color:#fff\\\">Prefer to talk?</strong>\\n          <p style=\\\"color:var(--muted);margin:8px 0\\\">Call or message to discuss which plan fits you best.</p>\\n          <div style=\\\"font-size:13px\\\"><a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n        </div>\\n        <div class=\\\"glass\\\" style=\\\"width:280px;padding:12px\\\">\\n          <strong style=\\\"color:#fff\\\">Quick lead magnet</strong>\\n          <p style=\\\"color:var(--muted);margin:8px 0\\\">Get a free printable dilution chart when you book today.</p>\\n          <form action=\\\"/lead\\\" method=\\\"post\\\" style=\\\"display:flex;gap:8px\\\">\\n            <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@domain.com\\\" required style=\\\"padding:8px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:var(--muted)\\\">\\n            <button class=\\\"btn\\\">Get chart</button>\\n          </form>\\n        </div>\\n      </section>\\n\\n    </main>\\n\\n    <footer style=\\\"margin-top:14px;color:rgba(255,255,255,0.45);font-size:13px;text-align:center\\\">\\n      <div>{{BUSINESS_NAME}} — safety-first aromatherapy. Not a substitute for medical advice.</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
