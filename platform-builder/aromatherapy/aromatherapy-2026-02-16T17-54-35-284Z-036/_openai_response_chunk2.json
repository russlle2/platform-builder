          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Offerings — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#F7F3EE;--bg2:#EEF6F4;--accent:#7AA99B;--muted:#6B6B6B;--card:#FFFFFF;--glass:rgba(255,255,255,0.6)}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; color:#1b1b1b;background:linear-gradient(180deg,var(--bg1),var(--bg2));}\\n    .wrap{max-width:980px;margin:36px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:64px;height:64px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),#A8C1B9);box-shadow:0 6px 18px rgba(122,169,155,0.12)}\\n    .brand h1{font-size:18px;margin:0}\\n    nav a{color:#163b36;text-decoration:none;margin-left:16px;font-size:14px}\\n    .hero{display:grid;grid-template-columns:1fr;gap:18px;margin-top:28px;padding:28px;border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,0.65),rgba(255,255,255,0.45));box-shadow:0 8px 30px rgba(20,20,20,0.05);position:relative;overflow:hidden}\\n    .hero h2{margin:0;font-size:28px;line-height:1.05}\\n    .hero p{margin:6px 0 0;color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:18px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(20,20,20,0.04)}\\n    .muted{color:var(--muted);font-size:14px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 16px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#9BC7B7);color:white;text-decoration:none}\\n    .list{margin:0;padding:0;list-style:none}\\n    .event{padding:12px;border-radius:10px;background:linear-gradient(180deg,rgba(250,250,250,0.9),rgba(255,255,255,0.6));display:flex;align-items:center;justify-content:space-between}\\n    .meta{color:var(--muted);font-size:13px}\\n    footer{margin-top:28px;padding-top:18px;border-top:1px dashed rgba(0,0,0,0.06);display:flex;justify-content:space-between;align-items:center}\\n    /* decorative SVG */\\n    .pattern{position:absolute;right:-40px;top:-40px;opacity:0.12;width:320px;height:320px;transform:rotate(12deg)}\\n    .testi{font-style:italic;color:#233;}\\n    @media(max-width:720px){.grid{grid-template-columns:1fr}.brand h1{font-size:16px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">\\n          <svg width=\\\"36\\\" height=\\\"36\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"10\\\" fill=\\\"#FFF\\\" opacity=\\\"0.12\\\"/><path d=\\\"M6 15c1.5-2 4-4 6-4s4.5 2 6 4\\\" stroke=\\\"#FFF\\\" stroke-opacity=\\\"0.9\\\" stroke-width=\\\"1.2\\\" stroke-linecap=\\\"round\\\"/></svg>\\n        </div>\\n        <div>\\n          <h1>{{BUSINESS_NAME}}</h1>\\n          <div class=\\\"muted\\\">A gentle practice in scent and presence</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"blends.html\\\">Blends & Notes</a>\\n        <a href=\\\"shop.html\\\">Apothecary</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n        <defs>\\n          <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n            <stop offset=\\\"0\\\" stop-color=\\\"#CFEFE1\\\"/>\\n            <stop offset=\\\"1\\\" stop-color=\\\"#F7F3EE\\\"/>\\n          </linearGradient>\\n          <pattern id=\\\"p1\\\" width=\\\"24\\\" height=\\\"24\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n            <rect width=\\\"24\\\" height=\\\"24\\\" fill=\\\"url(#g1)\\\"/>\\n            <path d=\\\"M0 12h24\\\" stroke=\\\"#A5C4B7\\\" stroke-width=\\\"0.6\\\" opacity=\\\"0.6\\\"/>\\n          </pattern>\\n        </defs>\\n        <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\" rx=\\\"24\\\"/>\\n      </svg>\\n      <div>\\n        <h2>Seasonal gatherings + small workshops</h2>\\n        <p>Events series for curious minds — inhale slowly, learn to blend with safety and care. Workshops, mini-retreats, and guided sessions shaped around rhythm and scent.</p>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n\\n      <div class=\\\"grid\\\" style=\\\"grid-template-columns:1fr 300px\\\">\\n        <div class=\\\"card\\\">\\n          <h3>How the series flows</h3>\\n          <p class=\\\"muted\\\">A clear framework for group learning, built on safety-first dilution, patch testing, and scent literacy.</p>\\n          <ol class=\\\"muted\\\" style=\\\"margin-top:8px;padding-left:18px\\\">\\n            <li>Orientation: safety, sourcing, dilution basics</li>\\n            <li>Exploration: aromatic families and mood notes</li>\\n            <li>Practice: hands-on blending in small pods</li>\\n            <li>Integration: take-home recipe + care notes</li>\\n          </ol>\\n        </div>\\n\\n        <div>\\n          <div class=\\\"card\\\" style=\\\"margin-bottom:12px\\\">\\n            <h4>Upcoming: Spring Series</h4>\\n            <div class=\\\"meta\\\">Four weekly sessions · Small cohort</div>\\n            <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">A seasonal arc focused on clarity and grounding. Each session is guided with safety reminders and optional activities.</p>\\n            <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve your place</a></div>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <h4>Private & community options</h4>\\n            <div class=\\\"muted\\\">One-on-one consultations · Group circles · Workplace mini-workshops</div>\\n            <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">I tailor each event with accessibility and scent sensitivity in mind. Let me know if you need scent-free seating.</p>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"card\\\">\\n          <h3>Signature workshops (events series)</h3>\\n          <ul class=\\\"list\\\" style=\\\"margin-top:12px\\\">\\n            <li class=\\\"event\\\"><div>\\n                <strong>Intro to Aromatics</strong>\\n                <div class=\\\"meta\\\">2 hours · Group · Foundations</div>\\n              </div>\\n              <div class=\\\"meta\\\">$45</div></li>\\n\\n            <li class=\\\"event\\\" style=\\\"margin-top:8px\\\"><div>\\n                <strong>Blending Lab: Personal Roller</strong>\\n                <div class=\\\"meta\\\">Hands-on · Bring a notebook</div>\\n              </div>\\n              <div class=\\\"meta\\\">$65</div></li>\\n\\n            <li class=\\\"event\\\" style=\\\"margin-top:8px\\\"><div>\\n                <strong>Seasonal Ritual Series</strong>\\n                <div class=\\\"meta\\\">4 sessions · Small cohort</div>\\n              </div>\\n              <div class=\\\"meta\\\">$220</div></li>\\n\\n            <li class=\\\"event\\\" style=\\\"margin-top:8px\\\"><div>\\n                <strong>Community Scent Circle</strong>\\n                <div class=\\\"meta\\\">Drop-in · 90 minutes</div>\\n              </div>\\n              <div class=\\\"meta\\\">$28</div></li>\\n\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <h3>Private Consultations</h3>\\n          <p class=\\\"muted\\\">A focused session for personal questions, blend creation, and practical guidance. Sessions include written dilution guidance and a take-home sample.</p>\\n          <div style=\\\"margin-top:12px\\\">\\n            <div class=\\\"meta\\\">60-minute consultation — $95</div>\\n            <div class=\\\"meta\\\" style=\\\"margin-top:6px\\\">30-minute follow-up — $45</div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3>Testimonials</h3>\\n      <p class=\\\"testi\\\">“A quiet, generous teacher — clear about safety and patient with questions. I left with a tiny bottle that still smells like home.” — M., {{CITY}}</p>\\n      <p class=\\\"testi\\\">“The workshop balanced craft and care. I appreciated the step-by-step dilution notes.” — R., {{STATE}}</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3>Practical notes</h3>\\n      <p class=\\\"muted\\\">All events emphasize safe dilution, patch testing, and clear guidance for pregnancy, medications, and pets. Sessions are educational and not medical in intent. If you have medical concerns, please consult a licensed professional.</p>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> · <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n      <div><a class=\\\"cta\\\" href=\\\"book.html\\\">Book a session</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Blends & Notes — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#FBFBFA;--ink:#10221F;--soft:#E9F3EF;--accent:#AAE0C9;--card:#FFFFFF}\\n    body{margin:0;font-family:Georgia, 'Times New Roman', serif;color:var(--ink);background:linear-gradient(180deg, #FBFBFA, #F2F6F4)}\\n    .container{max-width:980px;margin:30px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:14px;color:var(--ink);text-decoration:none;font-size:14px}\\n    h1{font-size:28px;margin:8px 0}\\n    .intro{color:#4d6a61;font-style:italic}\\n    .pattern-wrap{width:100%;height:120px;overflow:hidden;margin-top:18px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .blend{background:var(--card);padding:12px;border-radius:10px;box-shadow:0 6px 20px rgba(16,34,31,0.04)}\\n    .notes{font-size:13px;color:#44614F}\\n    .profile{margin-top:8px;color:#6B7E73;font-size:13px}\\n    .supports{margin-top:8px;background:linear-gradient(90deg,#F6FFF9,#EFF9F3);padding:8px;border-radius:8px;font-size:13px}\\n    .faq{margin-top:22px;background:linear-gradient(180deg,rgba(255,255,255,0.9),rgba(255,255,255,0.75));padding:14px;border-radius:10px}\\n    footer{margin-top:20px;display:flex;justify-content:space-between;align-items:center}\\n    @media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}\\n    @media(max-width:640px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div>\\n        <h1>Blends & aromatic sketches</h1>\\n        <div class=\\\"intro\\\">A small library of curated formulas — notes, profile, and gentle wording about what each blend supports. Always safety-first.</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"shop.html\\\">Shop</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"pattern-wrap\\\">\\n      <svg viewBox=\\\"0 0 600 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" preserveAspectRatio=\\\"none\\\">\\n        <defs>\\n          <linearGradient id=\\\"bg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#F0FBF6\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#FFF\\\"/></linearGradient>\\n          <pattern id=\\\"leaf\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n            <rect width=\\\"40\\\" height=\\\"40\\\" fill=\\\"transparent\\\"/>\\n            <path d=\\\"M4 28c6-8 20-12 28-10\\\" stroke=\\\"#D6EDDF\\\" stroke-width=\\\"1.2\\\" fill=\\\"none\\\"/>\\n          </pattern>\\n        </defs>\\n        <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#bg)\\\"/>\\n        <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#leaf)\\\" opacity=\\\"0.7\\\"/>\\n      </svg>\\n    </div>\\n\\n    <section class=\\\"grid\\\" aria-label=\\\"blend-list\\\">\\n      <div class=\\\"blend\\\">\\n        <strong>Morning Clarity</strong>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Lemon, Grapefruit · <strong>Middle:</strong> Rosemary · <strong>Base:</strong> Vetiver (light)</div>\\n        <div class=\\\"profile\\\">bright · uplifting · herbaceous</div>\\n        <div class=\\\"supports\\\">Supports gentle focus and a clear start to the day. Use diluted; avoid direct sun exposure after topical use.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Quiet Evening</strong>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Sweet Orange · <strong>Middle:</strong> Lavender · <strong>Base:</strong> Cedarwood</div>\\n        <div class=\\\"profile\\\">soft · calming · warm</div>\\n        <div class=\\\"supports\\\">Supports an evening routine that soothes and signals rest. Patch test before skin application.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Forest Walk</strong>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Pine · <strong>Middle:</strong> Juniper · <strong>Base:</strong> Cypress</div>\\n        <div class=\\\"profile\\\">green · resinous · grounding</div>\\n        <div class=\\\"supports\\\">Supports feelings of grounding and presence when diffused. Keep away from birds and small pets' breathing space.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Balance Rose</strong>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Geranium · <strong>Middle:</strong> Rose (trace) · <strong>Base:</strong> Benzoin (soft)</div>\\n        <div class=\\\"profile\\\">floral · gentle · sweet</div>\\n        <div class=\\\"supports\\\">Supports emotional warmth and self-care rituals. Use skin-safe carrier oils for topical blends; small % suggested for sensitive skin.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Meditation Fog</strong>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Frankincense · <strong>Middle:</strong> Myrrh · <strong>Base:</strong> Sandalwood</div>\\n        <div class=\\\"profile\\\">resonant · incense-like · contemplative</div>\\n        <div class=\\\"supports\\\">Supports mindful pauses and sitting practices when diffused mindfully. Avoid inhalation directly from bottle; keep ventilation balanced.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Citrus Breeze</strong>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Bergamot · <strong>Middle:</strong> Lime · <strong>Base:</strong> Petitgrain</div>\\n        <div class=\\\"profile\\\">fresh · sparkling · clean</div>\\n        <div class=\\\"supports\\\">Supports an uplifting, bright atmosphere. Bergamot is phototoxic — avoid skin exposure before sun.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Warm Hearth</strong>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Sweet Orange · <strong>Middle:</strong> Clove (light) · <strong>Base:</strong> Vanilla CO2</div>\\n        <div class=\\\"profile\\\">spiced · cozy · sweet</div>\\n        <div class=\\\"supports\\\">Supports cozy rituals and mindful evenings. Use lower ratios for children and sensitive adults; test first.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Herbal Respite</strong>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Chamomile Roman · <strong>Middle:</strong> Lavender · <strong>Base:</strong> Vetiver (small)</div>\\n        <div class=\\\"profile\\\">herbaceous · soft · restorative</div>\\n        <div class=\\\"supports\\\">Supports a calm domestic space and slow breaths. Keep blends labelled; store away from heat and light.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Evening Citrus</strong>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Mandarin · <strong>Middle:</strong> Neroli (trace) · <strong>Base:</strong> Sandalwood</div>\\n        <div class=\\\"profile\\\">gentle · sweet · grounding</div>\\n        <div class=\\\"supports\\\">Supports relaxed transitions at day's end. Neroli is precious — use sparingly for topical recipes.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <strong>Clear Breath (diffuse only)</strong>\\n        <div class=\\\"notes\\\"><strong>Top:</strong> Eucalyptus (limited) · <strong>Middle:</strong> Peppermint (small) · <strong>Base:</strong> Rosemary</div>\\n        <div class=\\\"profile\\\">fresh · penetrating · herbal</div>\\n        <div class=\\\"supports\\\">Supports an open, breezy room when diffused with care. Not recommended for infants, birds, or small pets; consult guidance for pregnant persons.</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3>Practical safety & FAQ</h3>\\n      <p><strong>Dilution:</strong> Typical topical dilution for adults is 1–3% for blends (6–18 drops per 30ml carrier). For children, elderly, and sensitive skin use lower dilutions. These are educational suggestions, not medical instructions.</p>\\n      <p><strong>Patch test:</strong> Apply a small diluted amount to inner forearm and wait 24 hours. If irritation occurs, discontinue use.</p>\\n      <p><strong>Pets:</strong> Many essential oils can affect pets — avoid direct application to animals and strongly ventilate diffused spaces; never leave diffusers running in small pet enclosures. Birds and reptiles are particularly sensitive.</p>\\n      <p><strong>Pregnancy & medication:</strong> Some oils are not advised during pregnancy or with certain medications. If pregnant, nursing, or taking medication, consult a qualified healthcare provider before topical or internal use.</p>\\n    </section>\\n\\n    <footer style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div class=\\\"muted\\\">Made with care by {{PRACTITIONER_NAME}} — safety first</div>\\n      <div><a href=\\\"shop.html\\\" style=\\\"text-decoration:none;background:#AEE9D1;padding:10px 14px;border-radius:8px;color:#063D36\\\">Browse the apothecary</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Apothecary — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#F8FFFB;--card:#FFFFFF;--accent:#79BFAF;--muted:#4D6B62}\\n    body{margin:0;font-family:Inter,system-ui,Arial;color:#10221F;background:radial-gradient(circle at 10% 10%, #F0F8F6 0%, #FBFFFD 40%)}\\n    .site{max-width:1100px;margin:28px auto;padding:22px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    .nav a{margin-left:12px;text-decoration:none;color:#123530}\\n    h1{margin:8px 0}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:20px}\\n    .product{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 10px 30px rgba(16,34,31,0.06);display:flex;flex-direction:column}\\n    .thumb{height:120px;border-radius:8px;background:linear-gradient(135deg,#E6F6F1,#FAFFF9);display:flex;align-items:center;justify-content:center;color:var(--muted);font-weight:700}\\n    .price{margin-top:auto;font-weight:700}\\n    .btn{display:inline-block;padding:8px 12px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#9BD7C3);color:#082; text-decoration:none}\\n    .note{font-size:13px;color:var(--muted)}\\n    .faq{margin-top:20px;padding:16px;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.9),rgba(255,255,255,0.7))}\\n    @media(max-width:980px){.grid{grid-template-columns:repeat(2,1fr)}}\\n    @media(max-width:640px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <header>\\n      <div>\\n        <h1>The Apothecary</h1>\\n        <div class=\\\"note\\\">A selection of kits, rollers, and diffusers — curated with safety notes and transparent sourcing.</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Workshops</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"grid\\\" aria-label=\\\"products\\\">\\n      <div class=\\\"product\\\">\\n        <div class=\\\"thumb\\\">Starter Kit</div>\\n        <h3>Starter Kit — Home Practice</h3>\\n        <div class=\\\"note\\\">A trio of gentle oils, carrier, and a guide card. Designed for careful beginners.</div>\\n        <div class=\\\"price\\\">$48</div>\\n        <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"thumb\\\">Roll-On: Sleep</div>\\n        <h3>Sleep Roll-On (10ml)</h3>\\n        <div class=\\\"note\\\">Lavender-forward, diluted in fractionated coconut oil. Topical support for bedtime rituals.</div>\\n        <div class=\\\"price\\\">$16</div>\\n        <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"thumb\\\">Roll-On: Calm</div>\\n        <h3>Calm Roller</h3>\\n        <div class=\\\"note\\\">Chamomile + sweet orange, low dilution. Patch test recommended for sensitive skin.</div>\\n        <div class=\\\"price\\\">$16</div>\\n        <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"thumb\\\">Ceramic</div>\\n        <h3>Ceramic Diffuser — Small</h3>\\n        <div class=\\\"note\\\">Elegant, whisper-quiet diffuser for bedrooms and small rooms. Use low intermittent cycles for sensitivity.</div>\\n        <div class=\\\"price\\\">$68</div>\\n        <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"thumb\\\">Travel Set</div>\\n        <h3>Travel Roller Set — 3x</h3>\\n        <div class=\\\"note\\\">Three pre-diluted rollers in a compact case — a thoughtful travel companion.</div>\\n        <div class=\\\"price\\\">$36</div>\\n        <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <div class=\\\"thumb\\\">Gift</div>\\n        <h3>Seasonal Gift Box</h3>\\n        <div class=\\\"note\\\">Curated seasonal pairings with usage notes and a tiny pouch. Great for giving with intention.</div>\\n        <div class=\\\"price\\\">$58</div>\\n        <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3>Safety & care — brief FAQ</h3>\\n      <p><strong>Dilution:</strong> All topical products are prepared at safe dilutions for adults. If you are pregnant, nursing, or have a health condition, check with a qualified clinician before use.</p>\\n      <p><strong>Patch test:</strong> Carry out a patch test for any topical product: apply a small amount to inner forearm and wait 24 hours for reaction.</p>\\n      <p><strong>Pets:</strong> Some oils are not safe for animals. Avoid direct application to animals and ensure diffusers are in well-ventilated areas; do not leave diffusers running continuously around birds or small pets.</p>\\n      <p><strong>Pregnancy & medication:</strong> Certain oils may be contraindicated during pregnancy or with specific medications. These products are educational and aromatic — they do not replace medical advice.</p>\\n    </section>\\n\\n    <footer style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div class=\\\"note\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n      <div><a class=\\\"btn\\\" href=\\\"book.html\\\">Book a blending session</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
