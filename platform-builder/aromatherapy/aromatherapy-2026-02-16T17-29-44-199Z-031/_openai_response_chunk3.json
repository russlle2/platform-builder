          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Pricing — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Transparent session and product pricing for aromatherapy services by {{PRACTITIONER_NAME}}. Safety-forward, personalized care.\\\">\\n  <style>\\n    :root{\\n      --bg1:#0f1724; --bg2:#0b1220; --glass: rgba(255,255,255,0.06); --accent: #7dd3fc; --muted: rgba(255,255,255,0.6); --card:#0b1320cc;\\n      --radius:14px; --glass-2: rgba(255,255,255,0.03);\\n      font-family: Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;\\n    }\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg1),var(--bg2));color:#e6eef8}\\n    /* inline svg pattern background */\\n    body::before{content:'';position:fixed;inset:0;z-index:0;opacity:0.12;pointer-events:none;background-image:url('data:image/svg+xml;utf8,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"600\\\" height=\\\"600\\\" viewBox=\\\"0 0 600 600\\\"><defs><linearGradient id=\\\"g\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"1\\\" y2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"%237dd3fc\\\" stop-opacity=\\\"0.18\\\"/><stop offset=\\\"1\\\" stop-color=\\\"%2300b4ff\\\" stop-opacity=\\\"0.08\\\"/></linearGradient></defs><rect width=\\\"600\\\" height=\\\"600\\\" fill=\\\"url(%23g)\\\"/><g fill=\\\"none\\\" stroke=\\\"rgba(255,255,255,0.06)\\\" stroke-width=\\\"1\\\"><path d=\\\"M0 80 C120 0 240 160 360 80 C480 0 600 160 600 80\\\"/><path d=\\\"M0 240 C120 160 240 320 360 240 C480 160 600 320 600 240\\\"/><path d=\\\"M0 400 C120 320 240 480 360 400 C480 320 600 480 600 400\\\"/></g></svg>');background-repeat:repeat;}\\n    .shell{position:relative;z-index:1;max-width:1100px;margin:48px auto;padding:28px}\\n    header{display:flex;align-items:center;gap:18px}\\n    .logo{display:flex;align-items:center;gap:12px}\\n    .mark{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,rgba(125,211,252,0.16),rgba(0,180,255,0.06));display:grid;place-items:center;border:1px solid rgba(255,255,255,0.04);backdrop-filter:blur(6px)}\\n    nav{margin-left:auto;display:flex;gap:14px;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px 12px;border-radius:10px;font-size:15px}\\n    nav a.primary{background:linear-gradient(90deg,rgba(125,211,252,0.12),rgba(0,180,255,0.06));color:#eafcff;border:1px solid rgba(125,211,252,0.12)}\\n    .hero{margin-top:28px;display:grid;grid-template-columns:1fr 320px;gap:22px}\\n    .card{background:linear-gradient(180deg,var(--glass),var(--glass-2));border-radius:var(--radius);padding:20px;border:1px solid rgba(255,255,255,0.04);box-shadow:0 6px 30px rgba(5,10,20,0.6)}\\n    h1{font-size:22px;margin:0;color:#e9fbff}\\n    p.lead{color:var(--muted);margin:8px 0 0}\\n    .price-list{display:flex;flex-direction:column;gap:12px;margin-top:18px}\\n    .plan{display:flex;justify-content:space-between;align-items:center;padding:14px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border:1px solid rgba(255,255,255,0.03)}\\n    .plan .meta{display:flex;flex-direction:column}\\n    .plan h3{margin:0;font-size:16px}\\n    .plan p{margin:4px 0 0;color:var(--muted);font-size:13px}\\n    .price{font-weight:700;color:#dff7ff}\\n    .cta-row{display:flex;gap:10px;margin-top:16px}\\n    button{background:linear-gradient(90deg,var(--accent),#66e0ff);border:0;padding:10px 14px;border-radius:10px;color:#002033;font-weight:600;cursor:pointer}\\n    .muted{color:var(--muted);font-size:13px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:20px}\\n    .small{padding:12px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);}\\n    footer{margin-top:36px;color:var(--muted);font-size:13px}\\n    .testimonials{margin-top:20px;display:flex;flex-direction:column;gap:12px}\\n    .t{padding:12px;border-radius:10px;background:linear-gradient(90deg,rgba(255,255,255,0.01),transparent);border:1px solid rgba(255,255,255,0.02)}\\n    .disclaimer{margin-top:10px;padding:10px;border-radius:10px;background:rgba(255,255,255,0.03);font-size:13px}\\n    /* responsive */\\n    @media (max-width:880px){.hero{grid-template-columns:1fr} .grid{grid-template-columns:1fr} nav{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"shell\\\">\\n    <header>\\n      <div class=\\\"logo\\\">\\n        <div class=\\\"mark\\\" aria-hidden>\\n          <svg width=\\\"22\\\" height=\\\"22\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><path d=\\\"M12 2C14.5 6 18 8 18 12.5C18 16 15.5 19 12 20C8.5 19 6 16 6 12.5C6 8 9.5 6 12 2Z\\\" fill=\\\"#7DD3FC\\\"/></svg>\\n        </div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"shop.html\\\">Store</a>\\n        <a href=\\\"pricing.html\\\" class=\\\"primary\\\">Pricing</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"card\\\">\\n        <h1>Transparent pricing for thoughtful aromatherapy</h1>\\n        <p class=\\\"lead\\\">Personalized sessions, handcrafted blends, and gradual-care plans. Safety-forward guidance and clear costs so you can plan care without surprises.</p>\\n\\n        <div class=\\\"price-list\\\">\\n          <div class=\\\"plan\\\">\\n            <div class=\\\"meta\\\">\\n              <h3>Introductory Consultation</h3>\\n              <p>45 minutes — intake, preferences, safety review</p>\\n            </div>\\n            <div class=\\\"price\\\">$95</div>\\n          </div>\\n\\n          <div class=\\\"plan\\\">\\n            <div class=\\\"meta\\\">\\n              <h3>Therapeutic Session</h3>\\n              <p>60 minutes — blend crafting, inhalation & topical guidance</p>\\n            </div>\\n            <div class=\\\"price\\\">$140</div>\\n          </div>\\n\\n          <div class=\\\"plan\\\">\\n            <div class=\\\"meta\\\">\\n              <h3>Follow-up (30m)</h3>\\n              <p>Brief review, dilution adjustments, product notes</p>\\n            </div>\\n            <div class=\\\"price\\\">$65</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"cta-row\\\">\\n          <a href=\\\"book.html\\\"><button aria-label=\\\"Book a session\\\">{ {PRIMARY_CTA_LABEL} }</button></a>\\n          <a href=\\\"contact.html\\\" style=\\\"align-self:center;color:var(--muted);text-decoration:none\\\">Questions? Call {{PHONE}}</a>\\n        </div>\\n\\n        <div class=\\\"disclaimer\\\">\\n          <strong>Safety note:</strong> Aromatherapy is complementary and wellness-focused. We do not diagnose or treat medical conditions. During intake we review medications, allergies, pregnancy, and pet exposure to create a safe plan.\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <div style=\\\"font-size:14px;font-weight:700\\\">Packages & Product credit</div>\\n        <p class=\\\"muted\\\">Hybrid model: combine sessions with curated products. Packages include appointment credit and product discounts.</p>\\n\\n        <div class=\\\"grid\\\">\\n          <div class=\\\"small\\\">\\n            <strong>Starter Pair</strong>\\n            <div class=\\\"muted\\\">2 sessions + 1 roll-on — $210</div>\\n          </div>\\n          <div class=\\\"small\\\">\\n            <strong>Self-Care Trio</strong>\\n            <div class=\\\"muted\\\">3 sessions + diffuser credit — $380</div>\\n          </div>\\n          <div class=\\\"small\\\">\\n            <strong>Seasonal Support</strong>\\n            <div class=\\\"muted\\\">Monthly plan — $95/month</div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px\\\">\\n          <div class=\\\"muted\\\">Payment options: card or invoice. Gift certificates available.</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\" class=\\\"card\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Pricing framework</h2>\\n      <p class=\\\"muted\\\">Our hybrid approach combines clinical intake and artisanal blends. Session fees reflect practitioner time, safety review, and follow-up guidance. Product pricing reflects small-batch sourcing and precise dilution.\\n      </p>\\n\\n      <div style=\\\"display:flex;gap:18px;margin-top:14px;flex-wrap:wrap\\\">\\n        <div style=\\\"flex:1;min-width:220px\\\" class=\\\"small\\\">\\n          <strong>Safety review</strong>\\n          <div class=\\\"muted\\\">Every new client receives a thorough intake and patch-test guidance to minimize risk.</div>\\n        </div>\\n        <div style=\\\"flex:1;min-width:220px\\\" class=\\\"small\\\">\\n          <strong>Customization</strong>\\n          <div class=\\\"muted\\\">Blends are tailored; some formulas require more time and specialized oils.</div>\\n        </div>\\n        <div style=\\\"flex:1;min-width:220px\\\" class=\\\"small\\\">\\n          <strong>Product sourcing</strong>\\n          <div class=\\\"muted\\\">We prioritize therapeutic-grade oils from audited suppliers; cost reflects traceability.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\" class=\\\"card\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Testimonials</h2>\\n      <div class=\\\"testimonials\\\">\\n        <div class=\\\"t\\\"><strong>J. in {{CITY}}</strong> — \\\"Subtle, thoughtful care. The blend I received felt grounded and never overpowering.\\\"</div>\\n        <div class=\\\"t\\\"><strong>R. in {{STATE}}</strong> — \\\"Clear instructions on dilution and patch-testing were reassuring.\\\"</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\" class=\\\"card\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Common pricing questions</h2>\\n      <p class=\\\"muted\\\"><strong>Do products incur extra fees?</strong> Yes — oils and roll-ons are priced individually. Session fees do not include retail items unless part of a package.</p>\\n      <p class=\\\"muted\\\"><strong>Do you accept insurance?</strong> Sessions are private-pay. Receipts may be provided for employer wellness programs where applicable.</p>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap\\\">\\n        <div>Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a> or call {{PHONE}}</div>\\n        <div style=\\\"text-align:right\\\">Made with care by {{PRACTITIONER_NAME}} — { {PRIMARY_CTA_LABEL} } <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">Book now</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Meet {{PRACTITIONER_NAME}}, clinical-minded aromatherapy practitioner serving {{CITY}}, {{STATE}}. Safety-first, evidence-aware practice.\\\">\\n  <style>\\n    :root{--bg:#071428;--glass:rgba(255,255,255,0.04);--accent:#9be7ff;--muted:rgba(255,255,255,0.6);--card:#07172a}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg),#041226);color:#eaf8ff;font-family:Inter,system-ui,Segoe UI,Roboto,Arial}\\n    body::after{content:'';position:fixed;inset:0;opacity:0.14;background-image:url('data:image/svg+xml;utf8,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"800\\\" height=\\\"400\\\" viewBox=\\\"0 0 800 400\\\"><defs><linearGradient id=\\\"g2\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"1\\\" y2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"%239be7ff\\\" stop-opacity=\\\"0.12\\\"/><stop offset=\\\"1\\\" stop-color=\\\"%2300b4ff\\\" stop-opacity=\\\"0.05\\\"/></linearGradient></defs><rect width=\\\"800\\\" height=\\\"400\\\" fill=\\\"url(%23g2)\\\"/><g fill=\\\"none\\\" stroke=\\\"rgba(255,255,255,0.04)\\\" stroke-width=\\\"0.9\\\"><circle cx=\\\"120\\\" cy=\\\"80\\\" r=\\\"40\\\"/><circle cx=\\\"320\\\" cy=\\\"220\\\" r=\\\"36\\\"/><circle cx=\\\"560\\\" cy=\\\"120\\\" r=\\\"52\\\"/></g></svg>');pointer-events:none}\\n    .wrap{max-width:980px;margin:44px auto;padding:22px;position:relative;z-index:1}\\n    header{display:flex;align-items:center;gap:12px}\\n    .brand{display:flex;gap:10px;align-items:center}\\n    .logo{width:46px;height:46px;border-radius:12px;background:linear-gradient(135deg,rgba(155,231,255,0.12),rgba(0,180,255,0.05));display:grid;place-items:center;border:1px solid rgba(255,255,255,0.04)}\\n    nav{margin-left:auto;display:flex;gap:12px}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px 10px;border-radius:9px}\\n    .panel{margin-top:20px;background:linear-gradient(180deg,var(--glass),rgba(255,255,255,0.02));padding:18px;border-radius:16px;border:1px solid rgba(255,255,255,0.04)}\\n    h1{margin:0;font-size:20px}\\n    .byline{color:var(--muted);margin-top:6px}\\n    .two{display:grid;grid-template-columns:1fr 340px;gap:18px;margin-top:18px}\\n    .bio p{color:var(--muted);line-height:1.6}\\n    .philosophy{background:linear-gradient(90deg,rgba(255,255,255,0.02),transparent);padding:12px;border-radius:12px}\\n    .list{margin-top:12px;display:flex;gap:10px;flex-wrap:wrap}\\n    .chip{background:rgba(255,255,255,0.03);padding:8px 10px;border-radius:999px;font-size:13px;border:1px solid rgba(255,255,255,0.02)}\\n    .quote{margin-top:14px;padding:12px;border-radius:10px;background:linear-gradient(90deg,rgba(155,231,255,0.04),transparent);font-style:italic}\\n    .cta{display:flex;gap:10px;margin-top:16px}\\n    button{background:linear-gradient(90deg,var(--accent),#66e0ff);border:0;padding:10px 12px;border-radius:10px;color:#002033;font-weight:600;cursor:pointer}\\n    .small{font-size:13px;color:var(--muted)}\\n    @media (max-width:880px){.two{grid-template-columns:1fr} nav{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\" aria-hidden>\\n          <svg width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><path d=\\\"M12 3c2.7 3.3 6 5 6 9.5 0 3.3-2.2 6-6 7-3.8-1-6-3.7-6-7C6 8.1 9.3 6.3 12 3z\\\" fill=\\\"#9BE7FF\\\"/></svg>\\n        </div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div class=\\\"small\\\">Clinical, calm, and bespoke aromatherapy</div>\\n        </div>\\n      </div>\\n\\n      <nav>\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"services.html\\\">Programs</a>\\n        <a href=\\\"pricing.html\\\">Rates</a>\\n        <a href=\\\"book.html\\\">Schedule</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"panel\\\">\\n      <h1>Meet {{PRACTITIONER_NAME}}</h1>\\n      <div class=\\\"byline\\\">Evidence-aware aromatherapy, emphasizing safety, consent, and practical application.</div>\\n\\n      <div class=\\\"two\\\">\\n        <div class=\\\"bio\\\">\\n          <p>With a practice rooted in careful intake and clear guidance, {{PRACTITIONER_NAME}} blends clinical curiosity with artisanal sourcing. Trained in plant chemistry and professional aromatherapy methods, the focus is on safe topical use, conservative dilutions, and meaningful inhalation practices.\\n          </p>\\n\\n          <p class=\\\"small\\\">This practice follows safety-first protocols: patch tests, pregnancy and medication reviews, and pet-conscious recommendations. No medical promises are made — sessions provide supportive, complementary approaches to sensory well-being.</p>\\n\\n          <div style=\\\"margin-top:10px\\\" class=\\\"list\\\">\\n            <div class=\\\"chip\\\">Intake & safety review</div>\\n            <div class=\\\"chip\\\">Custom blend formulation</div>\\n            <div class=\\\"chip\\\">Dilution and patch-test guidance</div>\\n            <div class=\\\"chip\\\">Home-use instructions</div>\\n          </div>\\n\\n          <div class=\\\"quote\\\">\\\"I aim to make scent practical and approachable — not overpowering. Small changes, mindful rituals.\\\"</div>\\n\\n          <div class=\\\"cta\\\">\\n            <a href=\\\"book.html\\\"><button>{ {PRIMARY_CTA_LABEL} }</button></a>\\n            <a href=\\\"contact.html\\\" style=\\\"color:var(--muted);align-self:center;text-decoration:none\\\">Reach out: {{EMAIL}}</a>\\n          </div>\\n        </div>\\n\\n        <aside>\\n          <div class=\\\"philosophy\\\">\\n            <strong>Practice framework</strong>\\n            <p class=\\\"small\\\" style=\\\"margin-top:6px\\\">Hybrid model: hands-on sessions plus take-home blends and remote check-ins. I prioritize conservative dilution rates and clear instructions for safe at-home use.</p>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\" class=\\\"philosophy\\\">\\n            <strong>Training & ethics</strong>\\n            <p class=\\\"small\\\">Complete training in aromatherapy studies, current safety guidelines, and ongoing continuing education. Client autonomy and informed consent are central.</p>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\" class=\\\"philosophy\\\">\\n            <strong>Location</strong>\\n            <p class=\\\"small\\\">Serving {{CITY}}, {{STATE}} by appointment. Virtual consultations available.</p>\\n          </div>\\n        </aside>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"panel\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">Stories & care model</h2>\\n      <p class=\\\"small\\\">Clients often seek a careful second opinion on scent use, non-intimidating blends, or simple at-home rituals. The hybrid offer model blends single sessions with product recommendations and follow-up touchpoints for gradual change.</p>\\n\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-wrap:wrap\\\">\\n        <div class=\\\"chip\\\">One-off consultations</div>\\n        <div class=\\\"chip\\\">Short package plans</div>\\n        <div class=\\\"chip\\\">Custom retail blends</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"panel\\\">\\n      <h2 style=\\\"margin:0 0 8px\\\">What to expect at your first visit</h2>\\n      <ul style=\\\"color:var(--muted);line-height:1.6\\\">\\n        <li>Comprehensive intake including allergies, medications, and pregnancy status where applicable.</li>\\n        <li>Discussion about your scent preferences and any pet exposure at home.</li>\\n        <li>Patch test guidance and conservative dilution suggestions.</li>\\n        <li>Written aftercare and practical home-use instructions.</li>\\n      </ul>\\n    </section>\\n\\n    <footer style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;color:var(--muted)\\\">\\n      <div>Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n      <div>Call <strong>{{PHONE}}</strong> — Serving {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a session — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Schedule a consultation or session with {{PRACTITIONER_NAME}}. Safety-first intake and clear booking steps.\\\">\\n  <style>\\n    :root{--bg:#021021;--glass:rgba(255,255,255,0.035);--accent:#8ee7ff;--muted:rgba(255,255,255,0.6)}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg),#00131f);color:#e9fbff;font-family:Inter,system-ui,Segoe UI,Roboto,Arial}\\n    body::before{content:'';position:fixed;inset:0;z-index:0;opacity:0.11;background-image:url('data:image/svg+xml;utf8,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"700\\\" height=\\\"700\\\" viewBox=\\\"0 0 700 700\\\"><defs><linearGradient id=\\\"g3\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"1\\\" y2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"%238ee7ff\\\" stop-opacity=\\\"0.12\\\"/><stop offset=\\\"1\\\" stop-color=\\\"%2300b4ff\\\" stop-opacity=\\\"0.04\\\"/></linearGradient></defs><rect width=\\\"700\\\" height=\\\"700\\\" fill=\\\"url(%23g3)\\\"/><g fill=\\\"none\\\" stroke=\\\"rgba(255,255,255,0.03)\\\" stroke-width=\\\"1\\\"><path d=\\\"M0 70 C140 0 280 140 420 70 C560 0 700 140 700 70\\\"/><path d=\\\"M0 350 C140 280 280 420 420 350 C560 280 700 420 700 350\\\"/></g></svg>');pointer-events:none}\\n    .container{max-width:980px;margin:40px auto;padding:20px;position:relative;z-index:1}\\n    header{display:flex;align-items:center;gap:12px}\\n    .mark{width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,rgba(142,231,255,0.12),rgba(0,180,255,0.06));display:grid;place-items:center}\\n    nav{margin-left:auto;display:flex;gap:12px}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px 10px;border-radius:8px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:16px;margin-top:18px}\\n    .card{background:linear-gradient(180deg,var(--glass),rgba(255,255,255,0.02));padding:16px;border-radius:14px;border:1px solid rgba(255,255,255,0.04)}\\n    label{display:block;font-size:13px;margin-bottom:6px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,0.06);background:transparent;color:inherit}\\n    button{background:linear-gradient(90deg,var(--accent),#66e0ff);border:0;padding:10px 12px;border-radius:10px;color:#002033;font-weight:700;cursor:pointer}\\n    .info{color:var(--muted);font-size:13px}\\n    .faq{margin-top:12px;display:flex;flex-direction:column;gap:8px}\\n    .faq .q{padding:10px;border-radius:10px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.02)}\\n    .safety{margin-top:12px;padding:10px;border-radius:10px;background:rgba(255,255,255,0.03);font-size:13px}\\n    @media (max-width:880px){.grid{grid-template-columns:1fr} nav{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;gap:10px;align-items:center\\\">\\n        <div class=\\\"mark\\\" aria-hidden>\\n          <svg width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><path d=\\\"M12 2C14.2 5 18 6.8 18 11c0 3.2-2.5 6-6 7-3.5-1-6-3.8-6-7C6 6.8 9.8 5 12 2z\\\" fill=\\\"#8EE7FF\\\"/></svg>\\n        </div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">Book — {{BUSINESS_NAME}}</div>\\n          <div class=\\\"info\\\">Schedule a session or virtual consult with {{PRACTITIONER_NAME}}</div>\\n        </div>\\n      </div>\\n\\n      <nav>\\n        <a href=\\\"index.html\\\">Overview</a>\\n        <a href=\\\"services.html\\\">Sessions</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <main class=\\\"grid\\\">\\n      <section>\\n        <div class=\\\"card\\\">\\n          <h2 style=\\\"margin:0 0 8px\\\">Reserve a session</h2>\\n          <p class=\\\"info\\\">Please complete intake thoughtfully. This helps me tailor a safe, effective plan and recommend appropriate dilutions. If you have immediate safety concerns, contact your healthcare provider.</p>\\n\\n          <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"POST\\\" style=\\\"margin-top:12px\\\">\\n            <label for=\\\"name\\\">Full name</label>\\n            <input id=\\\"name\\\" name=\\\"name\\\" required placeholder=\\\"Your name\\\">\\n\\n            <label for=\\\"email\\\">Email</label>\\n            <input id=\\\"email\\\" type=\\\"email\\\" name=\\\"email\\\" required placeholder=\\\"you@example.com\\\">\\n\\n            <label for=\\\"phone\\\">Phone</label>\\n            <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"Optional\\\">\\n\\n            <label for=\\\"service\\\">Select service</label>\\n            <select id=\\\"service\\\" name=\\\"service\\\">\\n              <option>Introductory Consultation — 45m</option>\\n              <option>Therapeutic Session — 60m</option>\\n              <option>Follow-up — 30m</option>\\n            </select>\\n\\n            <label for=\\\"notes\\\">Relevant notes (medications, pregnancy, pets, allergies)</label>\\n            <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Please note any medications, pregnancy status, pets in the home, or allergies.\\\"></textarea>\\n\\n            <div style=\\\"display:flex;align-items:center;gap:8px;margin-top:10px\\\">\\n              <input id=\\\"consent\\\" name=\\\"consent\\\" type=\\\"checkbox\\\" required>\\n              <label for=\\\"consent\\\" class=\\\"info\\\" style=\\\"margin:0\\\">I understand this is complementary aromatherapy; no medical promises are made. I consent to intake review and patch-test guidance.</label>\\n            </div>\\n\\n            <div style=\\\"margin-top:12px;display:flex;gap:8px\\\">\\n              <button type=\\\"submit\\\">{ {PRIMARY_CTA_LABEL} }</button>\\n              <a href=\\\"contact.html\\\" style=\\\"color:var(--muted);align-self:center;text-decoration:none\\\">Ask a question</a>\\n            </div>\\n          </form>\\n\\n          <div class=\\\"safety\\\">\\n            <strong>Safety highlights</strong>\\n            <ul style=\\\"margin:8px 0 0;color:var(--muted);line-height:1.6\\\">\\n              <li>All clients receive dilution guidance and patch-test instructions prior to topical use.</li>\\n              <li>Discuss pregnancy, breastfeeding, medication use, and pets during intake so that recommendations are conservative.</li>\\n              <li>We avoid clinical claims — aromatherapy is used to support personal sensory care and routines.</li>\\n            </ul>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\" class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">Session preparation</h3>\\n          <p class=\\\"info\\\">Wear comfortable clothing. If you are bringing an animal or have strong sensitivities at home, note this in your intake so we can plan low-impact exposure tests or virtual options.</p>\\n        </div>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">Quick availability</h3>\\n          <div class=\\\"info\\\">Weekdays: small blocks morning and afternoon. Weekend spots limited.</div>\\n          <div style=\\\"margin-top:10px;display:flex;flex-direction:column;gap:8px\\\">\\n            <div style=\\\"background:rgba(255,255,255,0.02);padding:10px;border-radius:10px\\\">Mon 10:00 — 14:00</div>\\n            <div style=\\\"background:rgba(255,255,255,0.02);padding:10px;border-radius:10px\\\">Wed 12:00 — 16:00</div>\\n            <div style=\\\"background:rgba(255,255,255,0.02);padding:10px;border-radius:10px\\\">Fri 9:00 — 12:00</div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\" class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">FAQ — safety essentials</h3>\\n          <div class=\\\"faq\\\">\\n            <div class=\\\"q\\\"><strong>Dilution:</strong> Use conservative dilutions. Typical topical dilutions range 1–3% unless otherwise advised after intake.</div>\\n            <div class=\\\"q\\\"><strong>Patch test:</strong> A small patch-test is recommended for new topical blends. Instructions will be provided before application.</div>\\n            <div class=\\\"q\\\"><strong>Pets:</strong> Inform us about pets at intake. Some essential oils can be irritating to animals; recommendations will avoid risky compounds and suggest safer practices.</div>\\n            <div class=\\\"q\\\"><strong>Pregnancy & breastfeeding:</strong> Several oils are contraindicated. Always disclose pregnancy or breastfeeding so that guidance is strictly conservative.</div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\" class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">Need help?</h3>\\n          <div class=\\\"info\\\">Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a> or call {{PHONE}} for booking support.</div>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <footer style=\\\"max-width:980px;margin:22px auto;color:var(--muted);text-align:center\\\">\\n      <div>By booking you agree to receive intake materials. For urgent medical issues, contact your healthcare provider. Serving {{CITY}}, {{STATE}}.</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
