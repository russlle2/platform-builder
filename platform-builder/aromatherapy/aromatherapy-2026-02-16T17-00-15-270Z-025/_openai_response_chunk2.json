          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Offerings</title>\\n  <style>\\n    :root{--accent:#7cb793;--muted:#6b6b6b;--bg1:#fbfdfb;--card:#ffffff}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#213023;background:linear-gradient(180deg,var(--bg1),#f7fbf7)}\\n    .wrap{max-width:980px;margin:36px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,#eaf6ef,var(--accent));display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(124,183,147,0.12)}\\n    .logo svg{width:36px;height:36px}\\n    nav a{margin-left:16px;color:#274834;text-decoration:none;font-weight:600}\\n    .hero{display:grid;grid-template-columns:1fr;gap:18px;background:rgba(255,255,255,0.6);padding:26px;border-radius:14px;box-shadow:0 8px 28px rgba(33,48,35,0.06)}\\n    .hero h1{margin:0;font-size:28px;color:#173822}\\n    .hero p{margin:0;color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:18px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 10px 30px rgba(33,48,35,0.04)}\\n    .muted{color:var(--muted);font-size:14px}\\n    .ritual-list{display:flex;flex-direction:column;gap:12px;margin-top:10px}\\n    .ritual{padding:12px;border-radius:10px;background:linear-gradient(180deg,#ffffff,#f6fff5);border:1px solid rgba(124,183,147,0.06)}\\n    .what{line-height:1.5}\\n    .schedule ul{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(2,1fr);gap:8px}\\n    .price-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-top:1px dashed rgba(33,48,35,0.04)}\\n    .cta{display:flex;gap:12px;margin-top:14px}\\n    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;text-decoration:none}\\n    footer{margin-top:26px;color:var(--muted);font-size:13px}\\n    /* inline SVG background */\\n    .bg-svg{position:fixed;right:-120px;top:-40px;opacity:0.12;pointer-events:none}\\n    details summary{cursor:pointer;font-weight:600}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"bg-svg\\\" width=\\\"420\\\" height=\\\"420\\\" viewBox=\\\"0 0 420 420\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#ecf9ef\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#dff3e8\\\"/></linearGradient>\\n      <pattern id=\\\"p1\\\" x=\\\"0\\\" y=\\\"0\\\" width=\\\"80\\\" height=\\\"80\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"80\\\" height=\\\"80\\\" fill=\\\"url(#g1)\\\"/>\\n        <circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"6\\\" fill=\\\"#e6fbef\\\"/>\\n        <path d=\\\"M0 40 L80 40\\\" stroke=\\\"#f0faf4\\\" stroke-width=\\\"1\\\" opacity=\\\"0.6\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"420\\\" height=\\\"420\\\" fill=\\\"url(#p1)\\\" rx=\\\"24\\\"/>\\n  </svg>\\n\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\" aria-hidden=\\\"true\\\">\\n          <svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><path d=\\\"M12 2c1.8 2.6 3.8 4 5.6 7 1.6 2.6 1.4 5.8-1 8.4-2.3 2.4-5.6 2.7-7.3 1.9C9 19.2 7.6 17 6 15.4 4.2 13.6 3 12 3 12S6.1 6.6 12 2z\\\" fill=\\\"#2d6b4b\\\"/></svg>\\n        </div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div class=\\\"muted\\\">A gentle practice of scent & story</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n        <a href=\\\"shop.html\\\">Shop</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero card\\\" id=\\\"hero\\\">\\n      <h1>Intentional sessions — simple rituals</h1>\\n      <p class=\\\"muted\\\">I guide members through approachable aromatherapy rituals that prioritize safety, scent literacy, and daily wellbeing practices. No promises of cures—only thoughtful scent support and self-care tools you can try at home.</p>\\n      <div class=\\\"cta\\\">\\n        <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"btn\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <a href=\\\"book.html\\\" style=\\\"padding:10px 14px;border-radius:10px;background:#fff;border:1px solid rgba(33,48,35,0.06);text-decoration:none;color:#274834\\\">Book a session</a>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"grid\\\">\\n      <main>\\n        <section class=\\\"card\\\" id=\\\"ritual\\\">\\n          <h2>Rituals we practice</h2>\\n          <p class=\\\"muted\\\">Each offering is framed as a short ritual with steps you can repeat at home. Safety notes included.</p>\\n          <div class=\\\"ritual-list\\\">\\n            <div class=\\\"ritual\\\">\\n              <strong>Daily Morning Calm</strong>\\n              <div class=\\\"muted\\\">3–5 min: inhale, journal one intention, diffuse a bright citrus blend.</div>\\n            </div>\\n            <div class=\\\"ritual\\\">\\n              <strong>Reset Pause</strong>\\n              <div class=\\\"muted\\\">2–4 deep breaths with a grounded woody roll-on applied to wrists or inhale-jar.</div>\\n            </div>\\n            <div class=\\\"ritual\\\">\\n              <strong>Evening Unwind</strong>\\n              <div class=\\\"muted\\\">A soothing foot-blend soak or pillow mist—light dilution and patch-test suggested.</div>\\n            </div>\\n          </div>\\n        </section>\\n\\n        <section class=\\\"card\\\" id=\\\"what_to_expect\\\" style=\\\"margin-top:16px\\\">\\n          <h3>What to expect in a session</h3>\\n          <p class=\\\"what muted\\\">Sessions are conversational and education-forward. I assess scent preferences, skin safety factors, and offer small, practical blends and rituals to test. I'll always recommend dilution ratios and patch-testing before topical use. No medical diagnoses or treatment recommendations are provided.</p>\\n        </section>\\n\\n        <section class=\\\"card\\\" id=\\\"schedule\\\" style=\\\"margin-top:16px\\\">\\n          <h3>Scheduling options</h3>\\n          <div class=\\\"schedule muted\\\">\\n            <ul>\\n              <li>30-min Discovery — quick scent profile & home ritual</li>\\n              <li>60-min Session — personalized blends + safety plan</li>\\n              <li>Membership — monthly check-ins + seasonal blend kit (members only)</li>\\n            </ul>\\n          </div>\\n        </section>\\n\\n        <section class=\\\"card\\\" id=\\\"pricing\\\" style=\\\"margin-top:16px\\\">\\n          <h3>Transparent pricing</h3>\\n          <div class=\\\"price-row\\\"><span>30-min Discovery</span><strong>$45</strong></div>\\n          <div class=\\\"price-row\\\"><span>60-min Personalized Session</span><strong>$95</strong></div>\\n          <div class=\\\"price-row\\\"><span>Monthly Membership</span><strong>$28 / month</strong></div>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:10px\\\">Membership includes a seasonal sample, monthly group ritual, and 10% store credit.</p>\\n        </section>\\n\\n        <section class=\\\"card\\\" id=\\\"faq\\\" style=\\\"margin-top:16px\\\">\\n          <h3>FAQ — safety first</h3>\\n          <details>\\n            <summary>How should I dilute essential oils?</summary>\\n            <div class=\\\"muted\\\">Topical dilution typically ranges from 1% (very gentle) to 3% for most adults. I recommend 0.5–1% for sensitive skin or new users. Always follow guidance given during your session.</div>\\n          </details>\\n          <details>\\n            <summary>Do I need to patch-test?</summary>\\n            <div class=\\\"muted\\\">Yes — a small patch-test on the inner forearm with your chosen dilution for 24 hours helps rule out irritation before wider use.</div>\\n          </details>\\n          <details>\\n            <summary>What about pets and pregnancy?</summary>\\n            <div class=\\\"muted\\\">Some oils are not appropriate around pets or during pregnancy. I provide specific safety guidance and alternatives in sessions. If you are pregnant, breastfeeding, or caring for animals, inform me so I can tailor recommendations.</div>\\n          </details>\\n        </section>\\n\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4>Quick Ritual</h4>\\n          <p class=\\\"muted\\\">Try a 3-minute anchor: inhale 3 times from cupped hands with a single-drop blend, write one line of gratitude, sip warm water.</p>\\n          <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve a spot</a></div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h4>Contact</h4>\\n          <p class=\\\"muted\\\">Questions? Call <strong>{{PHONE}}</strong> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></p>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section class=\\\"card\\\" id=\\\"final_cta\\\" style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <strong>Ready to learn your scent story?</strong>\\n        <div class=\\\"muted\\\">Small rituals, caring guidance, and safe practices — join our membership or schedule a session.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Blends & Notes</title>\\n  <style>\\n    :root{--leaf:#6aa77a;--deep:#123826;--soft:#fbfff9}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial;background:linear-gradient(180deg,#fcfff8,#f2fbf2);color:var(--deep)}\\n    .container{max-width:1100px;margin:36px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--deep);margin-left:14px;text-decoration:none}\\n    h1{margin:6px 0}\\n    .intro{background:rgba(107,166,124,0.06);padding:12px;border-radius:10px}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:18px}\\n    .blend{background:white;border-radius:12px;padding:14px;box-shadow:0 8px 20px rgba(18,56,38,0.04)}\\n    .notes{font-size:13px;color:#42594a;margin-top:6px}\\n    .profile{margin-top:8px;font-weight:600}\\n    .supports{font-size:13px;color:#6a6a6a;margin-top:8px}\\n    .cta{margin-top:18px}\\n    footer{margin-top:26px;color:#6b6b6b}\\n    /* unique svg pattern for this page */\\n    .sig{position:fixed;left:-90px;bottom:-60px;opacity:0.08}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"sig\\\" width=\\\"420\\\" height=\\\"420\\\" viewBox=\\\"0 0 420 420\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <radialGradient id=\\\"rg\\\" cx=\\\"30%\\\" cy=\\\"30%\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#eaf7ef\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#d9efe0\\\"/>\\n      </radialGradient>\\n      <pattern id=\\\"leafpat\\\" width=\\\"60\\\" height=\\\"60\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"60\\\" height=\\\"60\\\" fill=\\\"url(#rg)\\\"/>\\n        <path d=\\\"M8 42c6-14 26-18 40-10\\\" stroke=\\\"#e6faf0\\\" stroke-width=\\\"2\\\" fill=\\\"none\\\"/>\\n        <circle cx=\\\"50\\\" cy=\\\"10\\\" r=\\\"4\\\" fill=\\\"#f4fff6\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"420\\\" height=\\\"420\\\" fill=\\\"url(#leafpat)\\\" rx=\\\"20\\\"/>\\n  </svg>\\n\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"muted\\\">Curated seasonal blends</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Back</a>\\n        <a href=\\\"services.html\\\">Offerings</a>\\n        <a href=\\\"shop.html\\\">Boutique</a>\\n      </nav>\\n    </header>\\n\\n    <h1>Blends — tasting notes & gentle uses</h1>\\n    <div class=\\\"intro\\\">Below are 10 safe, non-medical blend descriptions with top/middle/base notes, overall aroma profile, and suggested \\\"supports\\\" language you can share with clients or use at home. Always patch-test and use advised dilution.</div>\\n\\n    <div class=\\\"grid\\\">\\n      <div class=\\\"blend\\\">\\n        <div class=\\\"profile\\\">Citrus Morning — Bright Wake</div>\\n        <div class=\\\"notes\\\">Top: Bergamot, Lemon · Middle: Sweet Orange · Base: Vetiver</div>\\n        <div class=\\\"supports\\\">Aroma profile: bright, uplifting citrus with an earthy anchor. Supports gentle energizing and focussed starts to the day.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <div class=\\\"profile\\\">Green Garden — Fresh & Herbal</div>\\n        <div class=\\\"notes\\\">Top: Basil · Middle: Rosemary, Geranium · Base: Cedarwood</div>\\n        <div class=\\\"supports\\\">Aroma profile: crisp herbal clarity. Supports a sense of grounded alertness during tasks.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <div class=\\\"profile\\\">Quiet Brook — Soft Floral Calm</div>\\n        <div class=\\\"notes\\\">Top: Neroli · Middle: Lavender · Base: Sandalwood</div>\\n        <div class=\\\"supports\\\">Aroma profile: tranquil floral woods. Supports gentle evening wind-down rituals.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <div class=\\\"profile\\\">Warm Hearth — Spiced Embrace</div>\\n        <div class=\\\"notes\\\">Top: Sweet Orange · Middle: Cinnamon Cassia (low %) · Base: Benzoin</div>\\n        <div class=\\\"supports\\\">Aroma profile: cozy spice and resin. Use low-cassia amounts; supports feelings of comfort and homey warmth.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <div class=\\\"profile\\\">Forest Walk — Earth & Resin</div>\\n        <div class=\\\"notes\\\">Top: Pine · Middle: Juniper · Base: Patchouli</div>\\n        <div class=\\\"supports\\\">Aroma profile: resinous, woodsy grounding. Supports centering and a nature-immersive scent experience.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <div class=\\\"profile\\\">Soft Lullaby — Gentle Night</div>\\n        <div class=\\\"notes\\\">Top: Chamomile · Middle: Lavender · Base: Sweet Marjoram</div>\\n        <div class=\\\"supports\\\">Aroma profile: subtle, floral-herbal ease. Supports pre-sleep rituals when used lightly and with attention to tolerance.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <div class=\\\"profile\\\">Citrus Grove — Clarity + Lift</div>\\n        <div class=\\\"notes\\\">Top: Grapefruit · Middle: Basil · Base: Cypress</div>\\n        <div class=\\\"supports\\\">Aroma profile: tart, uplifting with green facets. Supports mental clarity and a fresh atmosphere.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <div class=\\\"profile\\\">Moon Root — Deep Comfort</div>\\n        <div class=\\\"notes\\\">Top: Bergamot · Middle: Rosewood · Base: Vanilla absolute (or CO2)</div>\\n        <div class=\\\"supports\\\">Aroma profile: soft, balsamic with faint florals. Supports intimate ritual moments and contemplative pause.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <div class=\\\"profile\\\">Peppermint Lift — Cool Focus</div>\\n        <div class=\\\"notes\\\">Top: Peppermint (low %) · Middle: Spearmint · Base: Lime</div>\\n        <div class=\\\"supports\\\">Aroma profile: cooling, minty brightness. Supports short bursts of alertness—use small amounts and avoid around pets that are sensitive to menthols.</div>\\n      </div>\\n\\n      <div class=\\\"blend\\\">\\n        <div class=\\\"profile\\\">Evening Resin — Slow Down</div>\\n        <div class=\\\"notes\\\">Top: Petitgrain · Middle: Frankincense · Base: Myrrh (minimal)</div>\\n        <div class=\\\"supports\\\">Aroma profile: resinous, meditative. Supports contemplative breathing practices and quiet evenings when used sparingly.</div>\\n      </div>\\n\\n    </div>\\n\\n    <section style=\\\"margin-top:20px;background:#fff;padding:14px;border-radius:12px;box-shadow:0 12px 36px rgba(18,56,38,0.04)\\\">\\n      <h3>Blend safety reminders</h3>\\n      <p class=\\\"muted\\\">These are not medical treatments. I recommend patch-testing all blends, following dilution guidelines, and avoiding direct use around infants, young pets, or during pregnancy without professional clearance. In sessions I will adapt blends for individual sensitivities.</p>\\n    </section>\\n\\n    <div class=\\\"cta\\\">\\n      <a href=\\\"services.html\\\" style=\\\"padding:10px 14px;background:var(--leaf);color:#fff;border-radius:10px;text-decoration:none\\\">Explore sessions</a>\\n      <a href=\\\"shop.html\\\" style=\\\"padding:10px 14px;margin-left:8px;border-radius:10px;background:transparent;border:1px solid rgba(18,56,38,0.08);text-decoration:none;color:var(--deep)\\\">Shop sample kits</a>\\n    </div>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • Member favorite: {{FAVORITE_BLEND}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Boutique</title>\\n  <style>\\n    :root{--primary:#5caa86;--ink:#15372b;--card:#ffffff}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;background:linear-gradient(180deg,#f9fff9,#f0fbf0);color:var(--ink)}\\n    .site{max-width:1100px;margin:28px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:12px;text-decoration:none;color:var(--ink)}\\n    h1{margin:8px 0}\\n    .lead{color:#607b6c}\\n    .catalog{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .product{background:var(--card);padding:14px;border-radius:12px;box-shadow:0 12px 30px rgba(21,55,43,0.06);display:flex;flex-direction:column}\\n    .thumb{height:120px;border-radius:10px;background:linear-gradient(135deg,#ecfff2,#e6f8ea);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--primary)}\\n    .meta{margin-top:10px;flex:1}\\n    .meta h4{margin:0}\\n    .meta p{margin:6px 0;color:#6b6b6b;font-size:14px}\\n    .price{font-weight:700;margin-top:6px}\\n    .actions{display:flex;gap:8px;margin-top:10px}\\n    .btn{padding:8px 12px;border-radius:10px;text-decoration:none}\\n    .btn-buy{background:var(--primary);color:white}\\n    .btn-info{background:#fff;border:1px solid rgba(21,55,43,0.06)}\\n    .notes{font-size:13px;color:#6b6b6b;margin-top:12px}\\n    /* small svg accent */\\n    .accent{position:fixed;right:8px;bottom:8px;opacity:0.08}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"accent\\\" width=\\\"220\\\" height=\\\"220\\\" viewBox=\\\"0 0 220 220\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"acc\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#f0fff7\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#e6f6e9\\\"/></linearGradient>\\n    </defs>\\n    <rect width=\\\"220\\\" height=\\\"220\\\" fill=\\\"url(#acc)\\\" rx=\\\"20\\\"/>\\n    <g fill=\\\"#fff\\\" opacity=\\\"0.5\\\">\\n      <circle cx=\\\"40\\\" cy=\\\"40\\\" r=\\\"8\\\"/>\\n      <circle cx=\\\"120\\\" cy=\\\"80\\\" r=\\\"6\\\"/>\\n      <path d=\\\"M10 180 C40 130 80 170 140 140\\\" stroke=\\\"#f5fff8\\\" stroke-width=\\\"6\\\" fill=\\\"none\\\" opacity=\\\"0.6\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"site\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"lead\\\">Small-batch blends, mindful tools, and starter kits</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"services.html\\\">Sessions</a>\\n        <a href=\\\"blends.html\\\">Blends</a>\\n      </nav>\\n    </header>\\n\\n    <h1>Shop</h1>\\n    <p class=\\\"lead\\\">Products are presented for lifestyle and aromatic enjoyment. Safety guidance included with every order. No medical claims.</p>\\n\\n    <section style=\\\"margin-top:16px\\\">\\n      <div class=\\\"catalog\\\">\\n        <article class=\\\"product\\\">\\n          <div class=\\\"thumb\\\">Starter Kit</div>\\n          <div class=\\\"meta\\\">\\n            <h4>Seasonal Sample Kit</h4>\\n            <p>Four 2ml samples chosen for approachable daily rituals. Includes dilution cards and scent notes.</p>\\n            <div class=\\\"price\\\">$22</div>\\n            <div class=\\\"actions\\\">\\n              <a class=\\\"btn btn-buy\\\" href=\\\"#\\\">Add</a>\\n              <a class=\\\"btn btn-info\\\" href=\\\"#\\\">Details</a>\\n            </div>\\n          </div>\\n        </article>\\n\\n        <article class=\\\"product\\\">\\n          <div class=\\\"thumb\\\">Roll-On</div>\\n          <div class=\\\"meta\\\">\\n            <h4>Calm Pocket Roll-On (10ml)</h4>\\n            <p>Pre-diluted 2% roll-on with Lavender & Bergamot for gentle evening rituals.</p>\\n            <div class=\\\"price\\\">$18</div>\\n            <div class=\\\"actions\\\">\\n              <a class=\\\"btn btn-buy\\\" href=\\\"#\\\">Add</a>\\n              <a class=\\\"btn btn-info\\\" href=\\\"#\\\">Details</a>\\n            </div>\\n          </div>\\n        </article>\\n\\n        <article class=\\\"product\\\">\\n          <div class=\\\"thumb\\\">Diffuser</div>\\n          <div class=\\\"meta\\\">\\n            <h4>Compact Ultrasonic Diffuser</h4>\\n            <p>Small, quiet diffuser ideal for bedrooms and desks. Auto shut-off and soft LED glow.</p>\\n            <div class=\\\"price\\\">$45</div>\\n            <div class=\\\"actions\\\">\\n              <a class=\\\"btn btn-buy\\\" href=\\\"#\\\">Add</a>\\n              <a class=\\\"btn btn-info\\\" href=\\\"#\\\">Details</a>\\n            </div>\\n          </div>\\n        </article>\\n\\n        <article class=\\\"product\\\">\\n          <div class=\\\"thumb\\\">Roll-On</div>\\n          <div class=\\\"meta\\\">\\n            <h4>Focus Blend Roll-On (10ml)</h4>\\n            <p>Peppermint (low%), Lemon, and Basil in a jojoba base. Designed for short bursts of mental clarity.</p>\\n            <div class=\\\"price\\\">$18</div>\\n            <div class=\\\"actions\\\">\\n              <a class=\\\"btn btn-buy\\\" href=\\\"#\\\">Add</a>\\n              <a class=\\\"btn btn-info\\\" href=\\\"#\\\">Details</a>\\n            </div>\\n          </div>\\n        </article>\\n\\n        <article class=\\\"product\\\">\\n          <div class=\\\"thumb\\\">Bottle</div>\\n          <div class=\\\"meta\\\">\\n            <h4>House Blend — 10ml</h4>\\n            <p>Balanced citrus-floral blend that members love. Comes with safe-use card and suggested dilutions.</p>\\n            <div class=\\\"price\\\">$26</div>\\n            <div class=\\\"actions\\\">\\n              <a class=\\\"btn btn-buy\\\" href=\\\"#\\\">Add</a>\\n              <a class=\\\"btn btn-info\\\" href=\\\"#\\\">Details</a>\\n            </div>\\n          </div>\\n        </article>\\n\\n        <article class=\\\"product\\\">\\n          <div class=\\\"thumb\\\">Kit</div>\\n          <div class=\\\"meta\\\">\\n            <h4>Ritual Kit: Sleep</h4>\\n            <p>Pillow mist, roll-on, and bedtime dilution guide. All items labeled with safety guidance and patch-test reminders.</p>\\n            <div class=\\\"price\\\">$38</div>\\n            <div class=\\\"actions\\\">\\n              <a class=\\\"btn btn-buy\\\" href=\\\"#\\\">Add</a>\\n              <a class=\\\"btn btn-info\\\" href=\\\"#\\\">Details</a>\\n            </div>\\n          </div>\\n        </article>\\n\\n      </div>\\n\\n      <div class=\\\"notes\\\">Note: Ingredients and full safety guidelines are included with each product. Avoid certain essential oils for pregnant people, infants, and some pets; see FAQ or contact us for tailored advice.</div>\\n\\n      <div style=\\\"margin-top:16px\\\">\\n        <a class=\\\"btn btn-buy\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <a class=\\\"btn btn-info\\\" href=\\\"contact.html\\\">Ask about safety</a>\\n      </div>\\n\\n    </section>\\n\\n    <footer style=\\\"margin-top:22px;color:#6b6b6b\\\">\\n      <div>{{BUSINESS_NAME}} • {{PRACTITIONER_NAME}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
