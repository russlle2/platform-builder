          "text": "BUNDLE_START\n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Investments — {{BUSINESS_NAME}}</title>\\n  <meta name='description' content='Pricing and session options for aromatic ritual series and gatherings.'>\\n  <style>\\n    :root{\\n      --bg1:#f6f2ee;--accent:#7aa28a;--muted:#6b6b6b;--card:#fff;--glass:rgba(255,255,255,0.6);\\n      --radius:14px;--pad:20px;--max:980px;\\n    }\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial;color:#222;background:linear-gradient(180deg,var(--bg1),#fff);}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px calc(6vw);max-width:var(--max);margin:0 auto;}\\n    .brand{font-weight:700;letter-spacing:0.6px}\\n    nav a{color:#333;text-decoration:none;margin-left:18px;font-size:0.95rem}\\n    main{max-width:var(--max);margin:30px auto;padding:0 6vw}\\n    .hero{display:grid;grid-template-columns:1fr;gap:18px;align-items:center;padding:36px;border-radius:var(--radius);background:linear-gradient(135deg,rgba(122,162,138,0.06),rgba(170,210,190,0.04));box-shadow:0 6px 24px rgba(38,30,15,0.04);position:relative;overflow:hidden}\\n    /* subtle inline SVG pattern behind hero */\\n    .hero svg{position:absolute;right:-4vw;top:-6vh;width:60vw;height:160%;opacity:0.14}\\n    .hero h1{margin:0;font-size:2rem;color:var(--accent)}\\n    .hero p{margin:6px 0 0;color:var(--muted)}\\n\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 20px rgba(34,28,20,0.04)}\\n    .card h3{margin:0 0 6px;color:#153a2e}\\n    .price{font-size:1.6rem;font-weight:700;color:#0f2b20}\\n    .muted{color:var(--muted);font-size:0.92rem}\\n    .cta-row{display:flex;gap:12px;margin-top:12px}\\n    .btn{background:linear-gradient(180deg,var(--accent),#6b8f74);color:#fff;padding:10px 14px;border-radius:10px;border:none;cursor:pointer;text-decoration:none}\\n    .ghost{background:transparent;border:1px solid rgba(15,43,32,0.08);padding:10px 12px;border-radius:10px}\\n\\n    .faq{margin-top:28px}\\n    .faq h4{margin:0 0 12px}\\n    details{background:var(--glass);padding:12px;border-radius:10px;margin-bottom:10px}\\n    footer{max-width:var(--max);margin:36px auto 80px;padding:0 6vw;color:var(--muted);font-size:0.92rem}\\n\\n    @media (max-width:900px){.grid{grid-template-columns:1fr}.hero h1{font-size:1.6rem}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class='brand'>{{BUSINESS_NAME}} — Quiet Gatherings</div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='services.html'>Offerings</a>\\n      <a href='blends.html'>Blends</a>\\n      <a href='shop.html'>Shop</a>\\n      <a href='about.html'>About</a>\\n      <a href='book.html'>Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class='hero' aria-labelledby='pricing-hero'>\\n      <svg viewBox='0 0 800 800' preserveAspectRatio='xMidYMid meet' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n        <defs>\\n          <linearGradient id='g' x1='0' x2='1'><stop offset='0' stop-color='%237aa28a'/><stop offset='1' stop-color='%23e6f0e8' stop-opacity='0.4'/></linearGradient>\\n          <pattern id='p' width='60' height='60' patternUnits='userSpaceOnUse' patternTransform='rotate(12)'>\\n            <rect width='60' height='60' fill='transparent'/>\\n            <path d='M0 30 Q15 0 30 30 T60 30' stroke='%236ba38c' stroke-width='1' fill='none' opacity='0.45'/>\\n          </pattern>\\n        </defs>\\n        <rect width='100%' height='100%' fill='url(%23p)'/>\\n        <circle cx='130' cy='120' r='80' fill='url(%23g)' opacity='0.25'/>\\n      </svg>\\n\\n      <div>\\n        <h1 id='pricing-hero'>Seasonal Series & Private Rituals — clear price guide</h1>\\n        <p>Choose a gathering aligned with scent, space, and intention. All sessions emphasize safe topical practices; no health promises are made.</p>\\n      </div>\\n      <div style='text-align:right'>\\n        <div class='muted'>Questions?</div>\\n        <div style='margin-top:8px'><a class='btn' href='mailto:{{EMAIL}}'>Email {{PRACTITIONER_NAME}}</a></div>\\n      </div>\\n    </section>\\n\\n    <section class='grid' aria-label='pricing options'>\\n      <article class='card'>\\n        <h3>Gathering — Small Series</h3>\\n        <div class='price'>$180 / person</div>\\n        <p class='muted'>Three weekly 90‑minute sessions for groups up to 8. Shared ritual, guided scent exploration, and take‑home sample.</p>\\n        <div class='cta-row'>\\n          <a class='btn' href='book.html'>Reserve a Spot</a>\\n          <a class='ghost' href='contact.html'>Ask a Question</a>\\n        </div>\\n      </article>\\n\\n      <article class='card'>\\n        <h3>Private Ritual</h3>\\n        <div class='price'>$220</div>\\n        <p class='muted'>One-on-one 75‑minute session tailored to your olfactory preferences — includes a custom roll‑on at the end.</p>\\n        <div class='cta-row'>\\n          <a class='btn' href='book.html'>Book Private</a>\\n          <a class='ghost' href='services.html'>Session Details</a>\\n        </div>\\n      </article>\\n\\n      <article class='card'>\\n        <h3>Community Drop‑In</h3>\\n        <div class='price'>$35</div>\\n        <p class='muted'>An evening of shared scents and short rituals (60 minutes). Ideal for newcomers and curious neighbors.</p>\\n        <div class='cta-row'>\\n          <a class='btn' href='book.html'>Join Next</a>\\n          <a class='ghost' href='blends.html'>See Blends</a>\\n        </div>\\n      </article>\\n    </section>\\n\\n    <section class='card' style='margin-top:22px'>\\n      <h3 style='margin-top:0'>How pricing works</h3>\\n      <p class='muted'>All gatherings include a safety briefing, suggested dilution guidance for topical use, and a short handout for home practice. Travel fee may apply for offsite rituals in {{CITY}}, {{STATE}}.</p>\\n      <ul style='margin:12px 0 0 18px;color:var(--muted)'>\\n        <li>Deposit required at booking to hold group and private sessions.</li>\\n        <li>Group discounts available for organizations booking multiple people.</li>\\n        <li>Refund and rescheduling policy: contact at least 72 hours before an event for a credit.</li>\\n      </ul>\\n    </section>\\n\\n    <section class='faq' aria-labelledby='pricing-faq'>\\n      <h4 id='pricing-faq'>Common questions — safe practice first</h4>\\n      <details>\\n        <summary><strong>Dilution: what is recommended?</strong></summary>\\n        <p class='muted'>Suggested dilutions are included with each session. Typical adult topical dilutions range 1–3% for blends in roller bottles. For children or sensitive skin, lower dilutions are advised. Always perform a patch test prior to extended use.</p>\\n      </details>\\n      <details>\\n        <summary><strong>Do you do patch tests?</strong></summary>\\n        <p class='muted'>Yes. We guide a simple skin patch test during private sessions and recommend it for all new blends before regular topical use.</p>\\n      </details>\\n      <details>\\n        <summary><strong>What about pets?</strong></summary>\\n        <p class='muted'>Certain essential oils are not pet-friendly. We avoid diffuse-heavy use of known toxic oils in mixed settings and will advise pet-safe options. Inform us at booking if animals will be present.</p>\\n      </details>\\n      <details>\\n        <summary><strong>Pregnancy & nursing</strong></summary>\\n        <p class='muted'>If you are pregnant, planning pregnancy, or nursing, please mention this before booking. We will adapt blends and practices; sessions avoid strong topical or inhalation techniques contraindicated during pregnancy. This is guidance, not medical advice.</p>\\n      </details>\\n    </section>\\n\\n    <section style='margin-top:18px;display:flex;gap:12px;align-items:center'>\\n      <a class='btn' href='book.html' aria-label='Book a session'>{{PRIMARY_CTA_LABEL}}</a>\\n      <a class='ghost' href='contact.html'>Call {{PHONE}}</a>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} · {{TAGLINE}} · {{CITY}}, {{STATE}}</div>\\n    <div style='margin-top:6px'>Email: <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a> · Phone: {{PHONE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name='description' content='Meet {{PRACTITIONER_NAME}} and the philosophy behind our aromatherapy gatherings.'>\\n  <style>\\n    :root{--bg:#fff9f4;--ink:#21302a;--accent:#8aa998;--muted:#6b6b6b}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Georgia,serif;color:var(--ink);background:linear-gradient(180deg,var(--bg),#ffffff)}\\n    header{padding:18px 6vw;display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin-left:16px;color:var(--ink);text-decoration:none}\\n    main{max-width:920px;margin:18px auto;padding:0 6vw}\\n    .hero{padding:26px;border-radius:18px;background:linear-gradient(180deg,rgba(138,169,152,0.08),rgba(255,255,255,0.6));display:flex;gap:18px;align-items:center}\\n    .bio{flex:1}\\n    .bio h1{margin:0;font-family:Georgia,serif;font-size:1.8rem}\\n    .meta{color:var(--muted);margin-top:6px}\\n    .aside{width:220px;padding:14px;border-radius:12px;background:linear-gradient(180deg,#fff,#f8f4ef);box-shadow:0 8px 30px rgba(30,28,22,0.03)}\\n    .ribbon{padding:8px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#6ea17f);color:#fff;text-align:center;font-weight:600}\\n\\n    .poem{margin-top:22px;color:var(--muted);line-height:1.6;border-left:3px solid #e6efe7;padding-left:14px}\\n    .what{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:20px}\\n    .pill{background:#fff;padding:12px;border-radius:12px;box-shadow:0 6px 18px rgba(30,28,22,0.03)}\\n    .cta{margin-top:18px}\\n    .btn{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none}\\n\\n    /* small decorative SVG tucked at bottom */\\n    .pattern{width:100%;height:80px;margin-top:28px;opacity:0.16}\\n\\n    @media (max-width:780px){.what{grid-template-columns:1fr}.aside{display:none}.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style='font-weight:700'>{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href='index.html'>The Porch</a>\\n      <a href='services.html'>Sessions</a>\\n      <a href='pricing.html'>Invest</a>\\n      <a href='book.html'>Book</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class='hero' aria-labelledby='about-hero'>\\n      <div class='bio'>\\n        <h1 id='about-hero'>A quiet practice — meet {{PRACTITIONER_NAME}}</h1>\\n        <div class='meta'>Practitioner, ritual steward, and scent listener in {{CITY}}, {{STATE}}</div>\\n        <p class='poem'>\\n          I work with scent as compass and companion. Each blend is chosen to invite attention and calm — never a cure, always an invitation.\\n        </p>\\n        <div class='cta'>\\n          <a class='btn' href='book.html'>Book a Conversation</a>\\n        </div>\\n      </div>\\n\\n      <aside class='aside'>\\n        <div class='ribbon'>30+ Gatherings Curated</div>\\n        <div style='margin-top:10px;color:var(--muted)'>Sessions emphasize safety, gentle inhalation, and mindful topical use. Please disclose sensitivities when booking.</div>\\n      </aside>\\n    </section>\\n\\n    <section class='what' aria-label='what to expect and ritual'>\\n      <div class='pill'>\\n        <h4 style='margin-top:0'>Ritual & Setting</h4>\\n        <p class='muted'>Gatherings are 60–90 minutes. Expect a welcome, guided scent listening, simple breath-led pauses, and an artisan sample to take away.</p>\\n      </div>\\n      <div class='pill'>\\n        <h4 style='margin-top:0'>What to Expect</h4>\\n        <p class='muted'>Comfortable clothing, an open mind, and no prior knowledge required. Sessions are not medical treatment; they are sensory practices for presence.</p>\\n      </div>\\n    </section>\\n\\n    <section style='margin-top:18px'>\\n      <h3 style='margin-bottom:6px'>A few guiding promises</h3>\\n      <ul style='color:var(--muted)'>\\n        <li>Transparent sourcing: I share key safety notes for each oil used.</li>\\n        <li>Inclusivity: spaces are welcoming and paced for gentle participation.</li>\\n        <li>Respect for pets and pregnancy: adaptations are always made on request.</li>\\n      </ul>\\n    </section>\\n\\n    <svg class='pattern' viewBox='0 0 800 80' xmlns='http://www.w3.org/2000/svg' preserveAspectRatio='none' aria-hidden='true'>\\n      <defs>\\n        <linearGradient id='l2' x1='0' x2='1'><stop offset='0' stop-color='%238aa998'/><stop offset='1' stop-color='%23f1f7f2'/></linearGradient>\\n      </defs>\\n      <rect width='100%' height='100%' fill='url(%23l2)'/>\\n      <g fill='white' opacity='0.08'>\\n        <circle cx='64' cy='40' r='6'/>\\n        <circle cx='144' cy='30' r='8'/>\\n        <circle cx='240' cy='48' r='5'/>\\n        <circle cx='420' cy='22' r='7'/>\\n        <circle cx='680' cy='36' r='9'/>\\n      </g>\\n    </svg>\\n\\n    <section style='margin-top:12px'>\\n      <h3 style='margin-bottom:6px'>Where I came from</h3>\\n      <p class='muted'>A former garden‑tender, I learned the language of plants and translated that to scent. Training in blending and safety practice shapes every offering. My aim is to hold thoughtful containers for small groups and private clients.</p>\\n    </section>\\n\\n    <section style='margin-top:18px'>\\n      <h4 style='margin-bottom:8px'>Still curious?</h4>\\n      <a class='btn' href='contact.html'>Say Hello · {{EMAIL}}</a>\\n      <div style='margin-top:10px;color:var(--muted)'>Prefer to call? {{PHONE}}</div>\\n    </section>\\n\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <meta name='description' content='Reserve your place in a series, private ritual, or community evening.'>\\n  <style>\\n    :root{--bg:#fbfff9;--card:#fff;--accent:#7ea889;--muted:#6b6b6b}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial;background:linear-gradient(180deg,var(--bg),#fff);color:#162a23}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 6vw}\\n    nav a{margin-left:14px;text-decoration:none;color:#162a23}\\n\\n    main{max-width:940px;margin:18px auto;padding:0 6vw}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px}\\n    .form-card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 10px 26px rgba(18,20,18,0.04)}\\n    label{display:block;margin-top:12px;color:var(--muted);font-size:0.92rem}\\n    input,select,textarea{width:100%;padding:10px;margin-top:6px;border:1px solid #e7ebe6;border-radius:8px}\\n    .submit{margin-top:12px;background:linear-gradient(90deg,var(--accent),#6a9476);color:white;padding:10px 14px;border-radius:10px;border:none;cursor:pointer}\\n    .aside{padding:18px;border-radius:12px;background:linear-gradient(180deg,#ffffff,rgba(122,162,138,0.04));height:100%}\\n\\n    .schedule{margin-top:18px;display:flex;flex-direction:column;gap:8px}\\n    .slot{padding:10px;border-radius:10px;background:#fff;border:1px solid rgba(13,30,22,0.04);display:flex;justify-content:space-between;align-items:center}\\n    .note{font-size:0.9rem;color:var(--muted)}\\n\\n    @media (max-width:900px){.grid{grid-template-columns:1fr}};\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style='font-weight:700'>{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='pricing.html'>Prices</a>\\n      <a href='about.html'>About</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <h1 style='margin:0 0 8px'>Reserve your place</h1>\\n    <p style='color:var(--muted);margin-top:0'>Choose a gathering, a private ritual, or request a group booking. We'll follow up to confirm and collect a deposit.</p>\\n\\n    <div class='grid'>\\n      <section class='form-card' aria-labelledby='booking-form'>\\n        <h2 id='booking-form' style='margin-top:0'>Booking request</h2>\\n        <form id='booking' action='mailto:{{EMAIL}}' method='post' enctype='text/plain' onsubmit='return handleSubmit(event)'>\\n          <label for='name'>Name</label>\\n          <input id='name' name='name' required placeholder='Your full name'>\\n\\n          <label for='email'>Email</label>\\n          <input id='email' name='email' type='email' required placeholder='you@example.com'>\\n\\n          <label for='phone'>Phone (optional)</label>\\n          <input id='phone' name='phone' placeholder='(555) 555‑5555'>\\n\\n          <label for='type'>Session type</label>\\n          <select id='type' name='type'>\\n            <option>Community Drop‑In</option>\\n            <option>Small Series (3 sessions)</option>\\n            <option>Private Ritual</option>\\n            <option>Group Booking / Custom</option>\\n          </select>\\n\\n          <label for='date'>Preferred date / time</label>\\n          <input id='date' name='date' placeholder='e.g. Friday evening or April 12 morning'>\\n\\n          <label for='notes'>Notes: sensitivities, pregnancy, pets, or accessibility</label>\\n          <textarea id='notes' name='notes' rows='4' placeholder='Let me know anything important'></textarea>\\n\\n          <div style='display:flex;gap:10px;align-items:center;margin-top:12px'>\\n            <button class='submit' type='submit'>Request Booking</button>\\n            <a class='submit' style='background:transparent;color:var(--accent);border:1px solid rgba(122,162,138,0.18);text-decoration:none;padding:10px 12px;border-radius:8px' href='mailto:{{EMAIL}}'>Email Instead</a>\\n          </div>\\n\\n          <p class='note' style='margin-top:10px'>By requesting you acknowledge session policies and that aromatherapy is a sensory practice, not medical treatment.</p>\\n        </form>\\n      </section>\\n\\n      <aside class='aside'>\\n        <h3 style='margin-top:0'>Available times</h3>\\n        <div class='schedule' aria-label='sample schedule'>\\n          <div class='slot'><div>Monday evening</div><div class='note'>6:30–8:00 pm</div></div>\\n          <div class='slot'><div>Wednesday drop‑in</div><div class='note'>7:00–8:00 pm</div></div>\\n          <div class='slot'><div>Saturday small series</div><div class='note'>11:00–12:30 pm</div></div>\\n          <div class='slot'><div>Private rituals</div><div class='note'>By appointment</div></div>\\n        </div>\\n\\n        <h4 style='margin-top:18px'>Preparation & safety</h4>\\n        <p class='note'>Please arrive comfortably dressed. We will perform a short patch test for topical blends when appropriate. Mention pregnancy or medical conditions when you book — adaptations will be made. Pets: notify ahead if animals will be present.</p>\\n\\n        <div style='margin-top:14px'>\\n          <strong>Need help?</strong>\\n          <div style='margin-top:6px'><a href='contact.html' class='note'>Contact {{PRACTITIONER_NAME}}</a></div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style='margin-top:18px'>\\n      <h4 style='margin-bottom:8px'>Quick FAQ</h4>\\n      <div style='color:var(--muted)'>\\n        <strong>Dilution</strong>: Typical adult dilution references are provided for each session. Use lower concentrations for sensitive skin and children.\\n        <br><strong>Patch test</strong>: Recommended before applying new blends topically.\\n        <br><strong>Pets</strong>: Some oils are unsafe for animals; keep diffusers and roll-ons away from pets and ask for pet-safe options.\\n        <br><strong>Pregnancy</strong>: Tell us if you're pregnant or nursing; we will adapt blends and techniques. This is safety guidance, not medical advice.\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <script>\\n    function handleSubmit(e){\\n      // Minimal client-side validation and friendly alert.\\n      e.preventDefault();\\n      var f=document.getElementById('booking');\\n      if(!f.name.value || !f.email.value){\\n        alert('Please provide name and email to request a booking.');\\n        return false;\\n      }\\n      // Create a mailto with filled fields for convenience if mail client exists\\n      var subject='Booking request from '+encodeURIComponent(f.name.value);\\n      var body='Name: '+encodeURIComponent(f.name.value)+'%0AEmail: '+encodeURIComponent(f.email.value)+'%0APhone: '+encodeURIComponent(f.phone.value)+'%0AType: '+encodeURIComponent(f.type.value)+'%0APreferred: '+encodeURIComponent(f.date.value)+'%0ANotes: '+encodeURIComponent(f.notes.value);\\n      window.location.href='mailto:{{EMAIL}}?subject='+subject+'&body='+body;\\n      return false;\\n    }\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
  "parallel_tool_calls": true,
