          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Offerings — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{\\n      --bg:#0f1724; --muted:#9aa6b2; --accent:#b38fff; --glass:rgba(255,255,255,0.06);\\n      --card:#0b1420; --radius:14px; --max:980px;\\n    }\\n    html,body{height:100%;}\\n    body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,'Noto Sans',sans-serif;background:linear-gradient(180deg,#071022 0%, #081828 45%, #05121a 100%);color:#e6eef6;-webkit-font-smoothing:antialiased;}\\n    header{max-width:var(--max);margin:28px auto;display:flex;align-items:center;justify-content:space-between;padding:0 20px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#7fd3ff);display:flex;align-items:center;justify-content:center;color:#042233;font-weight:700;box-shadow:0 6px 18px rgba(11,20,32,0.6)}\\n    nav{display:flex;gap:12px;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px 12px;border-radius:10px;font-size:14px}\\n    nav a.highlight{background:linear-gradient(90deg,rgba(179,143,255,0.12),rgba(127,211,255,0.06));color:#fff}\\n    main{max-width:var(--max);margin:20px auto;padding:28px;background:linear-gradient(180deg, rgba(255,255,255,0.02), transparent);border-radius:18px;box-shadow:0 10px 30px rgba(4,10,16,0.6);position:relative;overflow:hidden}\\n    /* decorative SVG mask */\\n    .bg-veil{position:absolute;inset:0;opacity:0.14;mix-blend-mode:screen;pointer-events:none}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:26px;align-items:start}\\n    .hero-left{padding:24px}\\n    h1{margin:0 0 8px 0;font-size:36px;line-height:1.03;color:#fff}\\n    p.lead{margin:0 0 18px 0;color:var(--muted);font-size:15px}\\n    .meta{display:flex;gap:10px;align-items:center}\\n    .pill{background:var(--glass);padding:8px 12px;border-radius:999px;font-size:13px;color:var(--muted)}\\n    .hero-card{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(0,0,0,0.12));padding:18px;border-radius:14px}\\n    .person{display:flex;gap:12px;align-items:center}\\n    .avatar{width:52px;height:52px;border-radius:10px;background:linear-gradient(180deg,#fff, #dfe7ff);color:#062;display:flex;align-items:center;justify-content:center;font-weight:700}\\n    .cta{display:inline-block;margin-top:14px;padding:12px 16px;border-radius:12px;background:linear-gradient(90deg,var(--accent),#7fd3ff);color:#042233;text-decoration:none;font-weight:600}\\n    section{margin-top:22px}\\n    h2{font-size:18px;margin:0 0 8px 0}\\n    .columns{display:grid;grid-template-columns:1fr 1fr;gap:14px}\\n    .card{background:rgba(255,255,255,0.02);padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.02)}\\n    ul.fine{margin:8px 0 0 0;padding:0 0 0 18px;color:var(--muted)}\\n    .faq .q{font-weight:600;margin-bottom:6px}\\n    .footer-cta{display:flex;gap:12px;align-items:center;justify-content:space-between;margin-top:22px;padding:16px;background:linear-gradient(180deg, rgba(255,255,255,0.015), transparent);border-radius:12px}\\n    .secondary{color:var(--muted);font-size:14px}\\n    /* responsive */\\n    @media(max-width:880px){.hero{grid-template-columns:1fr}.columns{grid-template-columns:1fr}.brand .logo{width:44px;height:44px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">A</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\" class=\\\"highlight\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Boutique</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n  <main>\\n    <svg class=\\\"bg-veil\\\" viewBox=\\\"0 0 800 400\\\" preserveAspectRatio=\\\"none\\\" aria-hidden=\\\"true\\\">\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#8bdfff\\\" stop-opacity=\\\"0.14\\\"/>\\n          <stop offset=\\\"1\\\" stop-color=\\\"#cfa2ff\\\" stop-opacity=\\\"0.06\\\"/>\\n        </linearGradient>\\n        <filter id=\\\"blur\\\"><feGaussianBlur stdDeviation=\\\"20\\\"/></filter>\\n      </defs>\\n      <circle cx=\\\"720\\\" cy=\\\"60\\\" r=\\\"160\\\" fill=\\\"url(#g1)\\\" filter=\\\"url(#blur)\\\" />\\n      <rect x=\\\"-40\\\" y=\\\"-30\\\" width=\\\"420\\\" height=\\\"340\\\" rx=\\\"80\\\" fill=\\\"#7fd3ff\\\" opacity=\\\"0.04\\\"/>\\n    </svg>\\n\\n    <div class=\\\"hero\\\">\\n      <div class=\\\"hero-left\\\">\\n        <h1>Gathering space for scent-led gatherings</h1>\\n        <p class=\\\"lead\\\">Join gentle sessions rooted in scent, ritual, and safety. Evening circles and daytime miniature salons—crafted as a series of events to learn, blend, and breathe.</p>\\n        <div class=\\\"meta\\\">\\n          <span class=\\\"pill\\\">Events series • small groups</span>\\n          <span class=\\\"pill\\\">{{CITY}}, {{STATE}}</span>\\n        </div>\\n\\n        <section class=\\\"card ritual\\\">\\n          <h2>Rituals we guide</h2>\\n          <p class=\\\"secondary\\\">Minimal, repeatable sequences to center attention and attune to aroma—no claims, only careful practices.</p>\\n          <ul class=\\\"fine\\\">\\n            <li>Opening breath + intention setting</li>\\n            <li>Guided aroma exploration (safety notes included)</li>\\n            <li>Gentle blending demo and takeaway</li>\\n          </ul>\\n        </section>\\n\\n        <section class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h2>What to expect</h2>\\n          <p class=\\\"secondary\\\">Short education, hands-on blending in small batches, and care guidance—dilution and patch testing are taught in every event.</p>\\n        </section>\\n\\n      </div>\\n\\n      <aside class=\\\"hero-card\\\">\\n        <div class=\\\"person\\\">\\n          <div class=\\\"avatar\\\">{{PRACTITIONER_NAME}}</div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">{{PRACTITIONER_NAME}}</div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Aromatherapy practitioner • facilitator</div>\\n          </div>\\n        </div>\\n        <div style=\\\"margin-top:12px;color:var(--muted);font-size:13px\\\">Care-forward sessions blend learning with gentle ritual. Supplies provided. Bring any sensitivities to the initial intake.</div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </aside>\\n    </div>\\n\\n    <section class=\\\"columns\\\" aria-labelledby=\\\"schedule-title\\\">\\n      <div class=\\\"card\\\">\\n        <h2 id=\\\"schedule-title\\\">Upcoming gatherings</h2>\\n        <ul class=\\\"fine\\\">\\n          <li>Twilight Blend Circle — Monthly, second Thursday • 6:30–8:00pm</li>\\n          <li>Mini Blending Lab — Third Saturday • 10:00–11:30am</li>\\n          <li>Slow Aroma Practice — Sunday mornings • 9:30–10:30am</li>\\n        </ul>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <h2>Pricing & sessions</h2>\\n        <p class=\\\"secondary\\\">Series pricing and single-event options available. You will be guided through safe dilution ratios and packaging for takeaways.</p>\\n        <div style=\\\"margin-top:8px\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;margin-bottom:6px\\\"><strong>Single session</strong><span>$45</span></div>\\n          <div style=\\\"display:flex;justify-content:space-between\\\"><strong>3-class series</strong><span>$120</span></div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq card\\\" style=\\\"margin-top:18px\\\">\\n      <h2>Common questions</h2>\\n      <div style=\\\"margin-top:8px\\\">\\n        <div class=\\\"q\\\">How do you dilute oils during a session?</div>\\n        <div class=\\\"secondary\\\">We teach safe dilution ratios for topical use (e.g., 1–3% for adults in leave-on applications) and always provide carrier oils. Ratios are adapted for age, skin sensitivity, and the planned use. This is educational, not medical advice.</div>\\n      </div>\\n\\n      <div style=\\\"margin-top:12px\\\">\\n        <div class=\\\"q\\\">What about patch testing?</div>\\n        <div class=\\\"secondary\\\">A patch test is demonstrated and encouraged. We show steps: small mix, apply to inner forearm, observe 24 hours for irritation.</div>\\n      </div>\\n\\n      <div style=\\\"margin-top:12px\\\">\\n        <div class=\\\"q\\\">Pets in the home?</div>\\n        <div class=\\\"secondary\\\">We review species-safe practices; many essential oils can affect pets. Diffuse cautiously, avoid direct application, and ask about your pet before taking blends into shared spaces.</div>\\n      </div>\\n\\n      <div style=\\\"margin-top:12px\\\">\\n        <div class=\\\"q\\\">Pregnancy & nursing</div>\\n        <div class=\\\"secondary\\\">Certain oils are best avoided or used with caution during pregnancy and while nursing. We always provide guidance and recommend consultation with your care provider for any health concerns.</div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"footer-cta\\\">\\n      <div>\\n        <div style=\\\"font-weight:700\\\">Reserve a spot in the next circle</div>\\n        <div class=\\\"secondary\\\">Small groups. Emphasis on safety and simple ritual.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </div>\\n\\n  </main>\\n  <footer style=\\\"max-width:var(--max);margin:18px auto;padding:18px;text-align:center;color:var(--muted)\\\">\\n    <div>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Blends — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfbfe;--ink:#071022;--muted:#556270;--accent:#ffc3a0;--soft:#f5eefc}\\n    body{margin:0;font-family:Georgia,serif;background:linear-gradient(180deg,#f8fbfd 0%, #f3f7fa 100%);color:var(--ink)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 24px}\\n    .nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    .wrap{max-width:980px;margin:20px auto;padding:0 20px}\\n    .hero{padding:36px;background:radial-gradient(circle at 10% 10%, rgba(255,195,160,0.12), transparent),linear-gradient(180deg,#fff,#fbfbfd);border-radius:16px;box-shadow:0 8px 24px rgba(11,18,28,0.06)}\\n    h1{margin:0;font-family:inherit;font-size:28px}\\n    p.lead{margin:8px 0 0 0;color:var(--muted)}\\n    .intro-meta{display:flex;gap:10px;margin-top:12px}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:18px}\\n    .blend{background:var(--soft);padding:14px;border-radius:12px;border:1px solid rgba(7,16,34,0.04)}\\n    .blend h3{margin:0;font-size:16px}\\n    .notes{font-size:13px;color:var(--muted);margin:8px 0 0 0}\\n    .small{font-size:12px;color:var(--muted)}\\n    .badge{display:inline-block;padding:6px 8px;border-radius:999px;background:linear-gradient(90deg,#ffd4b3,#f0caff);font-weight:600}\\n    .faq{margin-top:18px;background:#fff;padding:14px;border-radius:12px}\\n    @media(max-width:700){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\" style=\\\"font-weight:700\\\">Blends</a>\\n      <a href=\\\"shop.html\\\">Shop</a>\\n      <a href=\\\"about.html\\\">About</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <h1>Pre-composed blends for safe, sensory moments</h1>\\n      <p class=\\\"lead\\\">Each blend lists top, middle, base notes, an aroma profile, and careful \\\"supports\\\" language. These are evocative tools for mindful use—no medical promises.</p>\\n      <div class=\\\"intro-meta\\\">\\n        <span class=\\\"badge\\\">Small-batch</span>\\n        <span class=\\\"small\\\">Always diluted and labeled with guidance</span>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:16px\\\">\\n      <h2 style=\\\"margin:0 0 8px 0\\\">Our library</h2>\\n      <div class=\\\"grid\\\">\\n\\n        <article class=\\\"blend\\\">\\n          <h3>Moonlit Calm</h3>\\n          <div class=\\\"notes\\\">Top: Bergamot, Lavender • Middle: Roman Chamomile • Base: Vetiver</div>\\n          <div class=\\\"small\\\">Aroma: soft citrus into floral-herbal earthiness</div>\\n          <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Supports gentle relaxation and evening ritual when used as directed; suitable for diffuser or diluted roll-on.</div>\\n        </article>\\n\\n        <article class=\\\"blend\\\">\\n          <h3>Quiet Grove</h3>\\n          <div class=\\\"notes\\\">Top: Sweet Orange • Middle: Cedarwood • Base: Patchouli</div>\\n          <div class=\\\"small\\\">Aroma: bright citrus settling into warm wood</div>\\n          <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Supports grounding and presence in shared spaces; avoid direct application for those with skin sensitivity.</div>\\n        </article>\\n\\n        <article class=\\\"blend\\\">\\n          <h3>Dawn Focus</h3>\\n          <div class=\\\"notes\\\">Top: Rosemary, Lemon • Middle: Basil • Base: Light musk accord</div>\\n          <div class=\\\"small\\\">Aroma: crisp herbal-citrus clarity</div>\\n          <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Supports attentive moments of study or gentle movement when diffused in short intervals; not intended as a therapeutic claim.</div>\\n        </article>\\n\\n        <article class=\\\"blend\\\">\\n          <h3>Salt & Cedar</h3>\\n          <div class=\\\"notes\\\">Top: Sea Spray accord • Middle: Juniper • Base: Cedar</div>\\n          <div class=\\\"small\\\">Aroma: airy marine into piney-wooded notes</div>\\n          <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Supports a sense of open calm in home spaces; keep away from curious pets and ventilate well.</div>\\n        </article>\\n\\n        <article class=\\\"blend\\\">\\n          <h3>Amber Hearth</h3>\\n          <div class=\\\"notes\\\">Top: Sweet Orange • Middle: Clove • Base: Amber resin</div>\\n          <div class=\\\"small\\\">Aroma: warm spice and resinous glow</div>\\n          <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Supports cozy, reflective evenings when used in moderation; avoid use near infants and consult for pregnancy questions.</div>\\n        </article>\\n\\n        <article class=\\\"blend\\\">\\n          <h3>Green Pause</h3>\\n          <div class=\\\"notes\\\">Top: Spearmint • Middle: Green Tea accord • Base: Oakmoss</div>\\n          <div class=\\\"small\\\">Aroma: bright leafy green with a cool edge</div>\\n          <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Supports a brief reset during the day; patch-test a diluted sample for topical use.</div>\\n        </article>\\n\\n        <article class=\\\"blend\\\">\\n          <h3>Evening Silk</h3>\\n          <div class=\\\"notes\\\">Top: Lavender • Middle: Neroli • Base: Sandalwood</div>\\n          <div class=\\\"small\\\">Aroma: floral-soft into creamy woods</div>\\n          <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Supports a quieting bedside ritual when diffused lightly; avoid concentrated topical application without guidance.</div>\\n        </article>\\n\\n        <article class=\\\"blend\\\">\\n          <h3>Citrus Meadow</h3>\\n          <div class=\\\"notes\\\">Top: Grapefruit, Lemon Verbena • Middle: Lavender • Base: Light cedar</div>\\n          <div class=\\\"small\\\">Aroma: bright and floral with a clean base</div>\\n          <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Supports uplift in shared spaces; keep away from cats and use short diffusion periods.</div>\\n        </article>\\n\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq\\\" aria-labelledby=\\\"faq-title\\\">\\n      <h3 id=\\\"faq-title\\\">Notes on safety (please read)</h3>\\n      <div style=\\\"margin-top:8px;color:var(--muted)\\\">\\n        <p style=\\\"margin:8px 0\\\">Dilution — We recommend specific carrier ratios for adult topical use (commonly 1–3% for leave-on). Lower percentages for sensitive skin and children; always follow the label provided with blends.</p>\\n        <p style=\\\"margin:8px 0\\\">Patch test — A patch test is simple: dilute as directed, apply a small amount to inner forearm, wait 24 hours. Discontinue if irritation occurs.</p>\\n        <p style=\\\"margin:8px 0\\\">Pets — Many essential oils can affect animals. We list caution notes and suggest consulting your veterinarian before using diffusers or topical products in homes with pets.</p>\\n        <p style=\\\"margin:8px 0\\\">Pregnancy & nursing — Some oils are contraindicated in pregnancy or best used only with professional guidance. We provide pregnancy notes and suggest discussing use with your healthcare provider.</p>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:14px;padding:10px 0;color:var(--muted)\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px\\\">\\n        <div>{{BUSINESS_NAME}} — handcrafted blends • {{CITY}}, {{STATE}}</div>\\n        <div><a href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a blending class</a></div>\\n      </div>\\n    </footer>\\n\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Boutique — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0b0f14;--card:#07101a;--accent:#7fffd4;--muted:#98a6ad}\\n    body{margin:0;font-family:Inter,system-ui,sans-serif;background:linear-gradient(180deg,#07101a 0%, #071827 60%);color:#e8f7f6}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 20px;max-width:980px;margin:0 auto}\\n    .logo{font-weight:800}\\n    nav a{color:var(--muted);margin-left:12px;text-decoration:none}\\n    .wrap{max-width:980px;margin:18px auto;padding:20px}\\n    .top-hero{display:flex;justify-content:space-between;gap:12px;align-items:center}\\n    h1{margin:0;font-size:24px}\\n    p.lead{margin:6px 0 0 0;color:var(--muted)}\\n    .products{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .product{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .product h3{margin:0 0 6px 0}\\n    .price{font-weight:700}\\n    .btn{display:inline-block;margin-top:10px;padding:8px 12px;border-radius:10px;background:var(--accent);color:#012;cursor:pointer;text-decoration:none}\\n    .note{font-size:12px;color:var(--muted);margin-top:8px}\\n    @media(max-width:980px){.products{grid-template-columns:repeat(2,1fr)}}\\n    @media(max-width:640px){.top-hero{flex-direction:column;align-items:flex-start}.products{grid-template-columns:1fr}}\\n  </style>\\head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Services</a>\\n      <a href=\\\"blends.html\\\">Blends</a>\\n      <a href=\\\"shop.html\\\" style=\\\"color:#fff;font-weight:700\\\">Boutique</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <div class=\\\"top-hero\\\">\\n      <div>\\n        <h1>Small-batch goods for slow rituals</h1>\\n        <p class=\\\"lead\\\">Kits, roll-ons, and gentle diffusers curated for mindful, safety-conscious use. Each product includes dilution guidance and labeling.</p>\\n      </div>\\n      <div style=\\\"text-align:right\\\">\\n        <div class=\\\"note\\\">Free local pickup in {{CITY}} • Shipping available</div>\\n        <a href=\\\"book.html\\\" class=\\\"btn\\\">Reserve a pickup</a>\\n      </div>\\n    </div>\\n\\n    <section class=\\\"products\\\" aria-label=\\\"Shop items\\\">\\n\\n      <div class=\\\"product\\\">\\n        <h3>Starter Blending Kit</h3>\\n        <div class=\\\"price\\\">$48</div>\\n        <div class=\\\"note\\\">Includes carrier oil, pipettes, amber vials, labels, and a dilution guide. Ideal for learning in class.</div>\\n        <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <h3>Travel Roller — Calm</h3>\\n        <div class=\\\"price\\\">$18</div>\\n        <div class=\\\"note\\\">Pre-diluted roll-on featuring {{FAVORITE_BLEND}} in 10 ml glass roller. Labeled with dilution and patch-test instructions.</div>\\n        <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <h3>Ceramic Diffuser — Mini</h3>\\n        <div class=\\\"price\\\">$34</div>\\n        <div class=\\\"note\\\">USB-powered, gentle mist. Designed for short cycles to reduce over-exposure. Keep away from pets and infants.</div>\\n        <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <h3>Ritual Roll-On Set (3)</h3>\\n        <div class=\\\"price\\\">$42</div>\\n        <div class=\\\"note\\\">Three 10 ml rolls: Evening Silk, Dawn Focus, and Quiet Grove. Each with clear use and safety notes.</div>\\n        <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <h3>Deluxe Ceremony Kit</h3>\\n        <div class=\\\"price\\\">$95</div>\\n        <div class=\\\"note\\\">Includes blends, diffuser, ceramic tray, matches, and an illustrated ritual card. For adults only; instructions included.</div>\\n        <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n      </div>\\n\\n      <div class=\\\"product\\\">\\n        <h3>Focus Roller — Pocket</h3>\\n        <div class=\\\"price\\\">$16</div>\\n        <div class=\\\"note\\\">Diluted blend for brief, situational use. Avoid extended diffusion or topical layering without testing.</div>\\n        <a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a>\\n      </div>\\n\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:14px;border-radius:12px\\\">\\n      <h2 style=\\\"margin:0\\\">Shopping notes & safety</h2>\\n      <div class=\\\"note\\\">All products include clear dilution guidance and patch-test recommendations. If you are pregnant, nursing, or have a chronic condition, consult your healthcare provider before topical or frequent inhalation use. Keep products out of reach of children and pets.</div>\\n    </section>\\n\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:18px\\\">\\n      <div style=\\\"color:var(--muted)\\\">{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n      <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </div>\\n\\n  </main>\\n\\n  <footer style=\\\"text-align:center;padding:18px;color:var(--muted)\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a> • Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted)\\\">{{PHONE}}</a></footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
