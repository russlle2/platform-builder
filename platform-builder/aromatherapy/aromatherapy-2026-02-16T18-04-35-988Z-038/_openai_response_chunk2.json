          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} — Offerings</title>\\n  <style>\\n    :root{--bg1:#f6fbf8;--bg2:#fffefb;--accent:#6f8a6e;--muted:#7b7b7b;--card:#ffffff}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial}\\n    .wrap{min-height:100%;display:flex;flex-direction:column;background:linear-gradient(180deg,var(--bg1),var(--bg2));color:#103218}\\n    header{position:relative;z-index:2;padding:28px 24px;display:flex;align-items:center;justify-content:space-between}\\n    nav a{color:var(--accent);text-decoration:none;margin:0 10px;font-weight:600}\\n    .brand{font-weight:700;letter-spacing:0.6px}\\n    .hero{position:relative;padding:48px 24px 36px;display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    .card{background:var(--card);border-radius:14px;box-shadow:0 6px 30px rgba(16,50,24,0.06);padding:22px}\\n    h1{margin:0 0 8px;font-size:28px}\\n    p.lead{margin:0;color:var(--muted)}\\n    .aside{align-self:start}\\n    .pattern{position:absolute;inset:0;pointer-events:none;opacity:0.12}\\n    .plan{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:18px}\\n    .plan .item{padding:14px;border-radius:10px;border:1px solid rgba(16,50,24,0.06);background:linear-gradient(180deg,#fff,#fbfffb)}\\n    .diagnostic{margin:22px 24px;padding:20px;border-radius:12px;background:linear-gradient(180deg,#ffffffcc,#f7fff9);box-shadow:0 3px 18px rgba(16,50,24,0.04)}\\n    .hsmall{font-weight:700;margin:0 0 6px}\\n    .micro{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px}\\n    .chip{background:#f3f8f4;padding:8px 12px;border-radius:999px;color:#2d4b33;font-weight:600;font-size:13px}\\n    .pricing{display:flex;gap:14px;padding:24px;margin:20px;border-radius:12px}\\n    .price-card{flex:1;padding:18px;border-radius:12px;background:linear-gradient(180deg,#ffffff,#f9fff9);border:1px solid rgba(16,50,24,0.06)}\\n    .cta{display:flex;gap:12px;align-items:center}\\n    .btn{background:linear-gradient(90deg,var(--accent),#4e6a55);color:#fff;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{margin-top:auto;padding:20px 24px;color:var(--muted);font-size:13px}\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.aside{order:2}}\\n  </style>\\n</head>\\n<body>\\n  <div class='wrap'>\\n    <svg class='pattern' viewBox='0 0 800 400' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>\\n      <defs>\\n        <linearGradient id='g1' x1='0' x2='1'>\\n          <stop offset='0' stop-color='#e9f7ee'/>\\n          <stop offset='1' stop-color='#f7fff9'/>\\n        </linearGradient>\\n        <pattern id='p1' x='0' y='0' width='80' height='80' patternUnits='userSpaceOnUse'>\\n          <rect width='80' height='80' fill='url(#g1)' />\\n          <path d='M0 80 L80 0' stroke='#e0efe0' stroke-width='1.5'/> \\n        </pattern>\\n      </defs>\\n      <rect width='100%' height='100%' fill='url(#p1)' />\\n    </svg>\\n\\n    <header>\\n      <div class='brand'>{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href='index.html'>Home</a>\\n        <a href='services.html'>Offerings</a>\\n        <a href='blends.html'>Blends</a>\\n        <a href='shop.html'>Shop</a>\\n        <a href='pricing.html'>Rates</a>\\n        <a href='about.html'>About</a>\\n        <a href='book.html'>Book</a>\\n        <a href='contact.html'>Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class='hero'>\\n      <div class='card'>\\n        <h1>Tailored Aromatherapy Sessions</h1>\\n        <p class='lead'>A gentle, safety-first approach to scenting your moments. We work with botanical essences to craft rituals for calm, focus, and restful evenings — without promises beyond comfort and care.</p>\\n\\n        <div class='plan' aria-label='Service plans'>\\n          <div class='item'>\\n            <div class='hsmall'>Intro Session — 45 min</div>\\n            <div class='muted'>Exploration, preferences, simple blend sampling.</div>\\n          </div>\\n          <div class='item'>\\n            <div class='hsmall'>Blending Workshop — 90 min</div>\\n            <div class='muted'>Hands-on creation of a take-home blend and education on safe use.</div>\\n          </div>\\n          <div class='item'>\\n            <div class='hsmall'>Series of Sessions</div>\\n            <div class='muted'>A short sequence to practice mindful scenting and home routines.</div>\\n          </div>\\n        </div>\\n\\n        <div class='diagnostic' style='margin-top:16px'>\\n          <div class='hsmall'>Begin with a quick scent check</div>\\n          <p style='margin:6px 0 0;color:var(--muted)'>List what you enjoy and any sensitivities. We emphasize patch tests, proper dilution, and pet-safe choices.</p>\\n          <div class='micro' style='margin-top:10px'>\\n            <div class='chip'>Patch test first</div>\\n            <div class='chip'>Dilution guidance</div>\\n            <div class='chip'>Pet & pregnancy notes</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside class='aside card'>\\n        <h3 style='margin-top:0'>Session snapshot</h3>\\n        <p style='color:var(--muted)'>A short consultation, scent profiling, and a 5–15ml custom blend available for purchase after your session.</p>\\n        <div style='margin-top:14px' class='cta'>\\n          <a class='btn' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n          <a href='contact.html' style='color:var(--accent);text-decoration:none;font-weight:700'>Ask a question</a>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class='diagnostic' style='margin:18px 24px'>\\n      <h3 class='hsmall'>How a session unfolds</h3>\\n      <ol style='margin:8px 0 0;padding-left:18px;color:var(--muted)'>\\n        <li>Discussion of intentions and sensitivities.</li>\\n        <li>Scent sampling: top, middle and base notes.</li>\\n        <li>Crafting a gentle blend with dilution safety.</li>\\n      </ol>\\n    </section>\\n\\n    <section style='margin:0 24px'>\\n      <div class='card'>\\n        <h3 style='margin-top:0'>Small daily rituals</h3>\\n        <p class='lead' style='margin:0 0 8px'>Simple, repeatable habits to bring scent into your day.</p>\\n        <div class='micro_habits' style='display:flex;flex-direction:column;gap:10px;margin-top:10px'>\\n          <div class='chip'>1–2 salty drops on a diffuser pad in the morning</div>\\n          <div class='chip'>Roll-on for wrists before meetings (10% dilution)</div>\\n          <div class='chip'>Evening inhalation from a tissue rather than direct application</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class='pricing' style='margin:18px 24px'>\\n      <div class='price-card'>\\n        <div style='font-size:14px;color:var(--muted)'>Single Session</div>\\n        <div style='font-weight:800;font-size:20px;margin-top:6px'>$80</div>\\n        <p style='color:var(--muted);margin-top:8px'>Includes consultation and a 5ml sample.</p>\\n      </div>\\n      <div class='price-card'>\\n        <div style='font-size:14px;color:var(--muted)'>Blending Workshop</div>\\n        <div style='font-weight:800;font-size:20px;margin-top:6px'>$150</div>\\n        <p style='color:var(--muted);margin-top:8px'>Hands-on class with a take-home 10ml blend.</p>\\n      </div>\\n    </section>\\n\\n    <section style='margin:0 24px 32px'>\\n      <div class='card'>\\n        <h3 style='margin-top:0'>Ready to begin?</h3>\\n        <p style='color:var(--muted)'>Book a session or send a note. Your safety and comfort guide every recommendation.</p>\\n        <div style='margin-top:12px' class='cta'>\\n          <a class='btn' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n          <a href='book.html' style='color:var(--accent);font-weight:700;margin-left:8px'>Schedule</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>{{PRACTITIONER_NAME}} — {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n      <div style='margin-top:6px'>Phone: {{PHONE}} • Email: <a href='mailto:{{EMAIL}}' style='color:var(--accent)'>{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} — Blends Gallery</title>\\n  <style>\\n    :root{--bg:#fffdfb;--ink:#173021;--muted:#6d6d6d;--accent:#7a967a}\\n    body{margin:0;font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial;background:var(--bg);color:var(--ink)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 22px}\\n    .logo{font-weight:800}\\n    nav a{margin-left:12px;text-decoration:none;color:var(--accent);font-weight:700}\\n    .banner{padding:30px 22px 18px;background:linear-gradient(180deg,#f9fff9,#fffefb);border-bottom:1px solid rgba(23,48,33,0.04);position:relative}\\n    .banner svg{position:absolute;right:18px;top:6px;opacity:0.12}\\n    h1{margin:0;font-size:26px}\\n    p.lead{margin:6px 0 0;color:var(--muted)}\\n    .container{padding:18px 22px 60px}\\n    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}\\n    .blend{background:#fff;border-radius:12px;padding:14px;border:1px solid rgba(23,48,33,0.04);box-shadow:0 6px 20px rgba(10,20,18,0.03)}\\n    .notes{font-size:13px;color:var(--muted);margin-top:8px}\\n    .supports{margin-top:10px;background:#f3faf3;padding:8px;border-radius:8px;font-weight:700;color:#2a5a36}\\n    .faq{margin-top:18px;padding:14px;background:linear-gradient(180deg,#fff,#fbfff7);border-radius:12px}\\n    .cta{margin-top:16px}\\n    .btn{background:linear-gradient(90deg,var(--accent),#5b7e5b);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:800}\\n    footer{padding:18px 22px;color:var(--muted);font-size:13px}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class='logo'>{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='services.html'>Offerings</a>\\n      <a href='blends.html'>Essences</a>\\n      <a href='shop.html'>Apothecary</a>\\n      <a href='contact.html'>Contact</a>\\n    </nav>\\n  </header>\\n\\n  <section class='banner'>\\n    <h1>Curated Blends</h1>\\n    <p class='lead'>A collection of artisan blends — notes listed as top, middle, base. Always follow dilution guidance and patch test; we avoid medical claims and focus on scent craft.</p>\\n    <svg width='160' height='80' viewBox='0 0 160 80' xmlns='http://www.w3.org/2000/svg'>\\n      <defs>\\n        <linearGradient id='bg' x1='0' x2='1'><stop offset='0' stop-color='#eaf7ec'/><stop offset='1' stop-color='#f7fff9'/></linearGradient>\\n      </defs>\\n      <rect width='160' height='80' fill='url(#bg)' rx='8' />\\n      <path d='M0 80 L160 0' stroke='#e0efe0' stroke-width='2' />\\n    </svg>\\n  </section>\\n\\n  <main class='container'>\\n    <section aria-label='Blends list'>\\n      <div class='grid'>\\n        <div class='blend'>\\n          <strong>1. Morning Clarity</strong>\\n          <div class='notes'>Top: Lemon, Grapefruit • Middle: Rosemary • Base: Vetiver</div>\\n          <div class='supports'>Aroma profile: bright, herbaceous. Supports focus and gentle uplift when used mindfully.</div>\\n        </div>\\n\\n        <div class='blend'>\\n          <strong>2. Evening Calm</strong>\\n          <div class='notes'>Top: Sweet Orange • Middle: Lavender • Base: Sandalwood</div>\\n          <div class='supports'>Aroma profile: soft, warm. Supports relaxation and a winding-down ritual.</div>\\n        </div>\\n\\n        <div class='blend'>\\n          <strong>3. Forest Walk</strong>\\n          <div class='notes'>Top: Pine • Middle: Juniper • Base: Cedarwood</div>\\n          <div class='supports'>Aroma profile: resinous, grounding. Supports a sense of outdoors and steadiness.</div>\\n        </div>\\n\\n        <div class='blend'>\\n          <strong>4. Citrus Breeze</strong>\\n          <div class='notes'>Top: Bergamot • Middle: Neroli • Base: Light Musk Accord</div>\\n          <div class='supports'>Aroma profile: bright floral-citrus. Supports gentle mood elevation.</div>\\n        </div>\\n\\n        <div class='blend'>\\n          <strong>5. Herbal Pause</strong>\\n          <div class='notes'>Top: Basil • Middle: Geranium • Base: Patchouli</div>\\n          <div class='supports'>Aroma profile: green, slightly spicy. Supports a mid-day reset and clarity.</div>\\n        </div>\\n\\n        <div class='blend'>\\n          <strong>6. Cozy Hearth</strong>\\n          <div class='notes'>Top: Cinnamon • Middle: Clove • Base: Vanilla</div>\\n          <div class='supports'>Aroma profile: warm, gourmand. Supports comfort and homely ambiance.</div>\\n        </div>\\n\\n        <div class='blend'>\\n          <strong>7. Quiet Mind</strong>\\n          <div class='notes'>Top: Frankincense • Middle: Lavender • Base: Myrrh</div>\\n          <div class='supports'>Aroma profile: incense-like, meditative. Supports contemplative practice and calm breathing.</div>\\n        </div>\\n\\n        <div class='blend'>\\n          <strong>8. Fresh Linen</strong>\\n          <div class='notes'>Top: Lemon Verbena • Middle: Green Tea • Base: White Musk Accord</div>\\n          <div class='supports'>Aroma profile: crisp, airy. Supports a refreshed, clean atmosphere.</div>\\n        </div>\\n\\n        <div class='blend'>\\n          <strong>9. Floral Evening</strong>\\n          <div class='notes'>Top: Ylang Ylang • Middle: Rose • Base: Sandalwood</div>\\n          <div class='supports'>Aroma profile: rich floral. Supports a comforting, gentle close to the day.</div>\\n        </div>\\n\\n        <div class='blend'>\\n          <strong>10. Mint Tonic</strong>\\n          <div class='notes'>Top: Peppermint • Middle: Spearmint • Base: Basil</div>\\n          <div class='supports'>Aroma profile: cool, crisp. Supports alertness when used in short, mindful bursts.</div>\\n        </div>\\n\\n      </div>\\n    </section>\\n\\n    <section class='faq' aria-label='FAQ'>\\n      <h3 style='margin:0 0 8px'>Safety & FAQ</h3>\\n      <div style='color:var(--muted)'>\\n        <strong>Dilution:</strong> Adhere to recommended dilutions (commonly 1–3% for topical blends) depending on age, sensitivity and intended use.\\n        <br><strong>Patch test:</strong> Always patch test a new blend on a small area of skin and wait 24 hours for reactions.\\n        <br><strong>Pets:</strong> Some essential oils are not pet-safe. Inform your practitioner if you share space with animals for tailored recommendations.\\n        <br><strong>Pregnancy:</strong> Certain oils are contraindicated in pregnancy. Please disclose pregnancy or breastfeeding before sessions.\\n      </div>\\n    </section>\\n\\n    <div style='margin-top:18px' class='cta'>\\n      <a class='btn' href='book.html'>Book a Blending Session</a>\\n      <a href='shop.html' style='margin-left:12px;color:var(--accent);font-weight:700'>Explore products</a>\\n    </div>\\n  </main>\\n\\n  <footer>\\n    <div style='padding:0 22px'>\\n      <div>{{PRACTITIONER_NAME}} • {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n      <div style='margin-top:6px'>Contact: {{PHONE}} • <a href='mailto:{{EMAIL}}' style='color:var(--accent)'>{{EMAIL}}</a></div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>{{BUSINESS_NAME}} — Shop</title>\\n  <style>\\n    :root{--bg:#fcfff9;--card:#ffffff;--accent:#6f8a6e;--muted:#6b6b6b}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;background:var(--bg);color:#0f2b1f}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 20px}\\n    nav a{margin-left:12px;color:var(--accent);text-decoration:none;font-weight:700}\\n    .mast{padding:22px 20px 8px;background:linear-gradient(180deg,#fbfff9,#fff);border-bottom:1px solid rgba(15,43,31,0.04)}\\n    .intro{display:flex;align-items:center;justify-content:space-between}\\n    h1{margin:0;font-size:24px}\\n    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;padding:18px 20px}\\n    .product{background:var(--card);padding:14px;border-radius:12px;border:1px solid rgba(15,43,31,0.04);box-shadow:0 8px 26px rgba(10,20,18,0.04)}\\n    .price{font-weight:800;margin-top:8px}\\n    .meta{color:var(--muted);font-size:13px;margin-top:6px}\\n    .buy{margin-top:10px}\\n    .btn{background:linear-gradient(90deg,var(--accent),#556e5a);color:white;padding:9px 12px;border-radius:10px;text-decoration:none;font-weight:800}\\n    .notice{padding:12px;margin:18px 20px;border-radius:12px;background:#f6fff6;color:#2c6033}\\n    .faq{margin:18px 20px;padding:14px;border-radius:12px;background:linear-gradient(180deg,#fff,#fbfff7)}\\n    footer{padding:20px;font-size:13px;color:var(--muted)}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style='font-weight:800'>{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href='index.html'>Home</a>\\n      <a href='services.html'>Sessions</a>\\n      <a href='blends.html'>Blends</a>\\n      <a href='shop.html'>Apothecary</a>\\n      <a href='about.html'>About</a>\\n      <a href='contact.html'>Contact</a>\\n    </nav>\\n  </header>\\n\\n  <section class='mast'>\\n    <div class='intro'>\\n      <div>\\n        <h1>Shop — curated essentials</h1>\\n        <p style='margin:6px 0;color:var(--muted)'>A small selection of kits, roll-ons and diffusers. All items ship with basic safety instructions. No medical claims — for aromatic enjoyment and ritual use.</p>\\n      </div>\\n      <div style='text-align:right'>\\n        <a class='btn' href='book.html'>Book a session</a>\\n      </div>\\n    </div>\\n  </section>\\n\\n  <main>\\n    <div class='grid'>\\n      <div class='product'>\\n        <strong>Starter Blend Kit</strong>\\n        <div class='meta'>Includes 5 samples (2ml each), dilution guide, and cotton pads.</div>\\n        <div class='price'>$34</div>\\n        <div class='buy'><a class='btn' href='cart.html'>Add to cart</a></div>\\n      </div>\\n\\n      <div class='product'>\\n        <strong>Focus Roll-On (10ml)</strong>\\n        <div class='meta'>Pre-diluted 5% in fractionated coconut oil. Patch test recommended.</div>\\n        <div class='price'>$18</div>\\n        <div class='buy'><a class='btn' href='cart.html'>Add to cart</a></div>\\n      </div>\\n\\n      <div class='product'>\\n        <strong>Sleep Roll-On (10ml)</strong>\\n        <div class='meta'>Gentle floral-citrus blend for bedtime rituals.</div>\\n        <div class='price'>$18</div>\\n        <div class='buy'><a class='btn' href='cart.html'>Add to cart</a></div>\\n      </div>\\n\\n      <div class='product'>\\n        <strong>Mini Ultrasonic Diffuser</strong>\\n        <div class='meta'>Quiet, 120ml, soft LED. Use recommended dilutions for essential oils.</div>\\n        <div class='price'>$42</div>\\n        <div class='buy'><a class='btn' href='cart.html'>Add to cart</a></div>\\n      </div>\\n\\n      <div class='product'>\\n        <strong>Travel Roller Duo</strong>\\n        <div class='meta'>Two 5ml roll-ons in a slim case — an energizer and a calm blend.</div>\\n        <div class='price'>$28</div>\\n        <div class='buy'><a class='btn' href='cart.html'>Add to cart</a></div>\\n      </div>\\n\\n      <div class='product'>\\n        <strong>House Mist — 100ml</strong>\\n        <div class='meta'>Light room mist in a water base. Avoid direct skin contact; keep away from pets' faces.</div>\\n        <div class='price'>$22</div>\\n        <div class='buy'><a class='btn' href='cart.html'>Add to cart</a></div>\\n      </div>\\n\\n    </div>\\n\\n    <div class='notice' style='margin:18px 20px'>\\n      Safety note: Always follow dilution guidance. Perform a patch test for topical products. Some oils are not recommended for pets or during pregnancy — disclose these conditions before use.\\n    </div>\\n\\n    <section class='faq' style='margin:0 20px 30px'>\\n      <h3 style='margin:0 0 8px'>FAQ</h3>\\n      <div style='color:var(--muted)'>\\n        <strong>Dilution:</strong> We recommend 1–3% for most adults on skin; children and elders typically need lower dilutions.\\n        <br><strong>Patch test:</strong> Apply a small amount of diluted product behind the ear or on the inner arm and wait 24 hours.\\n        <br><strong>Pets:</strong> Avoid using certain oils (e.g., tea tree, eucalyptus) around cats and small mammals. Consult us if you have pets.\\n        <br><strong>Pregnancy & breastfeeding:</strong> Some oils are contraindicated. Please tell us if you are pregnant, trying to conceive, or breastfeeding.\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — {{PRACTITIONER_NAME}} • {{CITY}}, {{STATE}}</div>\\n    <div style='margin-top:6px'>Phone: {{PHONE}} • Email: <a href='mailto:{{EMAIL}}' style='color:var(--accent)'>{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
