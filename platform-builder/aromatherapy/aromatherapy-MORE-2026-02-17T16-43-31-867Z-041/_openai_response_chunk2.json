          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Offerings — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--glass-bg:rgba(255,255,255,0.08);--accent:#8AA7A1;--muted:#cbd5d1;--glass-border:rgba(255,255,255,0.12)}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#f7fbfc;background:linear-gradient(180deg,#0f1720 0%,#071018 100%),url('assets/img/pattern.svg');-webkit-font-smoothing:antialiased}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 28px}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 10px;font-weight:600}\\n    .glass{background:var(--glass-bg);border:1px solid var(--glass-border);backdrop-filter:blur(8px);border-radius:12px;padding:22px}\\n    .container{max-width:1060px;margin:28px auto;padding:0 20px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:20px;align-items:center}\\n    .hero h1{font-size:28px;margin:0 0 8px;color:#eaf7f6}\\n    .hero p{color:var(--muted);margin:0 0 14px}\\n    .cta{display:inline-block;padding:12px 18px;border-radius:10px;background:linear-gradient(135deg,#9dd2c7,#6faea2);color:#042022;text-decoration:none;font-weight:700}\\n    .proof{margin-top:18px}\\n    .proof .viewer{height:120px;display:flex;align-items:center;justify-content:center;background:linear-gradient(90deg,rgba(255,255,255,0.02),rgba(255,255,255,0.00));border-radius:10px;padding:12px;position:relative}\\n    .proof .author{position:absolute;right:12px;bottom:8px;color:var(--muted);font-size:13px}\\n    .badges{display:flex;gap:10px;margin-top:12px}\\n    .badge{position:relative;padding:8px 10px;border-radius:10px;background:rgba(255,255,255,0.02);display:inline-flex;align-items:center;gap:8px;cursor:default}\\n    .badge svg{width:20px;height:20px}\\n    .badge .tip{position:absolute;bottom:calc(100% + 10px);left:50%;transform:translateX(-50%);background:#07292a;color:#e6faf9;padding:8px;border-radius:8px;font-size:13px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .18s}\\n    .badge:hover .tip{opacity:1}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:20px}\\n    .benefit{padding:14px;border-radius:10px}\\n    .process{display:flex;gap:12px;margin-top:18px}\\n    .step{flex:1;padding:12px;border-radius:10px}\\n    .faq{margin-top:22px}\\n    footer{margin:40px 0 80px;color:var(--muted);text-align:center}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}.hero p{margin-bottom:16px}}\\n  </style>\\n</head>\\n<body>\\n  <header class='container'>\\n    <div style='display:flex;align-items:center;gap:14px'>\\n      <div style='width:50px;height:50px;border-radius:12px;background:linear-gradient(135deg,#113033,#0b2224);display:flex;align-items:center;justify-content:center;color:#9fe0d5;font-weight:800'>A</div>\\n      <nav aria-label='Primary'>\\n        <a href='index.html'>Nest</a>\\n        <a href='services.html' style='color:#eaf7f6'>Offerings</a>\\n        <a href='blends.html'>Elixirs</a>\\n        <a href='shop.html'>Boutique</a>\\n        <a href='pricing.html'>Rates</a>\\n        <a href='about.html'>Story</a>\\n        <a href='book.html'>Reserve</a>\\n        <a href='contact.html'>Reach</a>\\n      </nav>\\n    </div>\\n    <div style='display:flex;gap:12px;align-items:center'>\\n      <a href='{{PRIMARY_CTA_URL}}' class='cta'>{{PRIMARY_CTA_LABEL}}</a>\\n    </div>\\n  </header>\\n\\n  <main class='container'>\\n    <section class='hero glass'>\\n      <div>\\n        <h1>Deep-scent consultations crafted to guide intention</h1>\\n        <p>Sessions combine scent literacy, safety-first blending, and ritual design. Scents may support calm, focus, and grounded moments when used thoughtfully.</p>\\n        <div style='display:flex;gap:10px;align-items:center'>\\n          <a class='cta' href='{{PRIMARY_CTA_URL}}'>Begin a session</a>\\n          <a href='book.html' style='color:var(--muted);text-decoration:none;font-weight:700'>Schedule a discovery</a>\\n        </div>\\n        <div class='proof'>\\n          <div class='viewer glass' id='testimonial-view'>\\n            <div id='testimonial-text' style='max-width:74%'>\\\"A careful, sensory practice that fits my rhythm.\\\"</div>\\n            <div class='author' id='testimonial-author'>— River, {{CITY}}</div>\\n          </div>\\n          <div class='badges' id='credibles'>\\n            <div class='badge' data-tip='20+ years collective practice'>\\n              <svg viewBox='0 0 24 24' fill='none' aria-hidden='true'><circle cx='12' cy='12' r='9' stroke='#a7d8d1' stroke-width='1.4'/><path d='M9 12l2 2 4-4' stroke='#a7d8d1' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'/></svg>\\n              <div style='font-size:13px;color:var(--muted)'>Practitioner</div>\\n              <div class='tip'>20+ years collective practice</div>\\n            </div>\\n            <div class='badge' data-tip='Safety-first dilution & testing'>\\n              <svg viewBox='0 0 24 24' fill='none' aria-hidden='true'><rect x='3' y='3' width='18' height='18' rx='4' stroke='#cfeee9' stroke-width='1.2'/><path d='M8 12h8' stroke='#cfeee9' stroke-width='1.6' stroke-linecap='round'/></svg>\\n              <div style='font-size:13px;color:var(--muted)'>Safety</div>\\n              <div class='tip'>Safety-first dilution & testing</div>\\n            </div>\\n            <div class='badge' data-tip='Community workshops held monthly'>\\n              <svg viewBox='0 0 24 24' fill='none' aria-hidden='true'><path d='M12 6v6l4 2' stroke='#bfe8df' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>\\n              <div style='font-size:13px;color:var(--muted)'>Community</div>\\n              <div class='tip'>Community workshops held monthly</div>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n      <aside class='glass' style='height:260px;display:flex;flex-direction:column;justify-content:center;gap:10px'>\\n        <strong style='color:#eaf7f6'>Quarterly Intensive</strong>\\n        <div style='color:var(--muted)'>A focused pathway of three extended sessions for scent literacy and ritual design — supportive and safety-focused.</div>\\n        <div style='margin-top:10px;display:flex;gap:8px'>\\n          <a href='book.html' class='cta'>Reserve an intensive</a>\\n          <a href='pricing.html' style='color:var(--muted);text-decoration:none;font-weight:700'>View rates</a>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class='grid'>\\n      <div class='benefit glass'>\\n        <h3 style='margin-top:0;color:#dff7f3'>Curated learning</h3>\\n        <p style='color:var(--muted)'>Understand scent families and how aroma profiles blend into practical rituals.</p>\\n      </div>\\n      <div class='benefit glass'>\\n        <h3 style='margin-top:0;color:#dff7f3'>Ritual design</h3>\\n        <p style='color:var(--muted)'>Create small, repeatable scent practices tailored to your days and boundaries.</p>\\n      </div>\\n      <div class='benefit glass'>\\n        <h3 style='margin-top:0;color:#dff7f3'>Safety tools</h3>\\n        <p style='color:var(--muted)'>Clear guidance on dilution, patch tests, and pet-safe choices so you can use scents with confidence.</p>\\n      </div>\\n    </section>\\n\\n    <section class='process'>\\n      <div class='step glass'>\\n        <strong>1 • Connect</strong>\\n        <p style='color:var(--muted)'>A short intake to map needs and preferences.</p>\\n      </div>\\n      <div class='step glass'>\\n        <strong>2 • Co-create</strong>\\n        <p style='color:var(--muted)'>We blend and test with a safety lens; no medical claims, only supportive language.</p>\\n      </div>\\n      <div class='step glass'>\\n        <strong>3 • Practice</strong>\\n        <p style='color:var(--muted)'>Simple rituals and dilution recipes to take home.</p>\\n      </div>\\n    </section>\\n\\n    <section class='faq glass'>\\n      <h3 style='margin-top:0;color:#dff7f3'>Questions & safety notes</h3>\\n      <details style='color:var(--muted);margin:10px 0'><summary style='cursor:pointer;font-weight:700'>Are these medical treatments?</summary>\\n        <div style='margin-top:8px'>Sessions focus on scent education and ritual; aromatics may support wellbeing but are not medical interventions.</div>\\n      </details>\\n      <details style='color:var(--muted);margin:10px 0'><summary style='cursor:pointer;font-weight:700'>Will we use carrier oils and instructions?</summary>\\n        <div style='margin-top:8px'>Yes. Dilution is provided with clear ratios and written guidance so you can re-create blends safely at home.</div>\\n      </details>\\n      <details style='color:var(--muted);margin:10px 0'><summary style='cursor:pointer;font-weight:700'>Patch testing & pregnancy/pets</summary>\\n        <div style='margin-top:8px'>Patch testing is recommended. I provide alternative notes for pregnancy and pet households; please disclose so we can adapt blends safely.</div>\\n      </details>\\n    </section>\\n\\n    <section style='margin-top:18px' class='glass'>\\n      <div style='display:flex;justify-content:space-between;align-items:center'>\\n        <div>\\n          <h3 style='margin:0;color:#dff7f3'>Ready to begin?</h3>\\n          <p style='margin:6px 0;color:var(--muted)'>Book a conversation to explore options and safety needs.</p>\\n        </div>\\n        <div style='display:flex;gap:10px'>\\n          <a class='cta' href='book.html'>Reserve a consultation</a>\\n          <a href='contact.html' style='color:var(--muted);text-decoration:none;font-weight:700'>Contact us</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n  </main>\\n  <footer>\\n    <div class='container'>\\n      <small>Questions? Call <a href='tel:{{PHONE}}' style='color:var(--muted)'>{{PHONE}}</a> or email <a href='mailto:{{EMAIL}}' style='color:var(--muted)'>{{EMAIL}}</a></small>\\n    </div>\\n  </footer>\\n\\n  <script>\\n    // rotating testimonials\\n    (function(){\\n      const list=[\\n        {text:'\\\"Gentle guidance and clear recipes — I use my blends weekly.\\\"',author:'— Mara, client'},\\n        {text:'\\\"A calm, thoughtful practice that fit into my schedule.\\\"',author:'— Jonah, practitioner'},\\n        {text:'\\\"Safety-first and beautifully simple to keep.\\\"',author:'— S. from {{CITY}}'}\\n      ];\\n      let i=0;\\n      const tText=document.getElementById('testimonial-text');\\n      const tAuthor=document.getElementById('testimonial-author');\\n      setInterval(()=>{\\n        i=(i+1)%list.length;\\n        tText.textContent=list[i].text;\\n        tAuthor.textContent=list[i].author;\\n      },4200);\\n    })();\\n\\n    // accessible tooltips already handled via CSS reveal on hover\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Elixirs & Aroma Wheel — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#b8e6db;--muted:#c7dcd8;--glass:rgba(255,255,255,0.06)}\\n    html,body{margin:0;height:100%;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#071018,#051017),url('assets/img/pattern.svg');color:#e8fbfa}\\n    .container{max-width:1100px;margin:28px auto;padding:0 20px}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:16px 0}\\n    nav a{color:var(--muted);margin:0 10px;text-decoration:none}\\n    .glass{background:var(--glass);border-radius:12px;padding:18px;border:1px solid rgba(255,255,255,0.06);backdrop-filter:blur(6px)}\\n    .hero{display:flex;gap:18px;align-items:center}\\n    .hero h1{margin:0;font-size:26px}\\n    .sub{color:var(--muted)}\\n    .wheel-wrap{display:flex;gap:18px;align-items:center;margin-top:18px}\\n    .wheel{width:320px;height:320px;display:grid;place-items:center}\\n    .notes{width:100%;max-width:520px}\\n    .note-box{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:12px;border-radius:10px}\\n    .note-list{display:flex;flex-direction:column;gap:8px;margin-top:8px}\\n    .note-item{padding:8px;border-radius:8px;background:rgba(0,0,0,0.2);cursor:pointer}\\n    .note-item:hover{background:rgba(255,255,255,0.02)}\\n    .legend{margin-top:12px;color:var(--muted)}\\n    .cta{margin-top:12px;display:inline-block;padding:10px 14px;border-radius:9px;background:linear-gradient(135deg,#9dd2c7,#6faea2);color:#042022;font-weight:700;text-decoration:none}\\n    @media(max-width:880px){.wheel-wrap{flex-direction:column;align-items:center}.notes{width:100%}}\\n  </style>\\n</head>\\n<body>\\n  <div class='container'>\\n    <header>\\n      <div style='display:flex;align-items:center;gap:12px'>\\n        <div style='width:44px;height:44px;border-radius:10px;background:#0a2222;display:flex;align-items:center;justify-content:center;color:#bfeee7;font-weight:800'>E</div>\\n        <nav aria-label='Main'>\\n          <a href='index.html'>Nest</a>\\n          <a href='services.html'>Offerings</a>\\n          <a href='blends.html' style='color:#e8fbfa'>Elixirs</a>\\n          <a href='shop.html'>Boutique</a>\\n          <a href='pricing.html'>Rates</a>\\n        </nav>\\n      </div>\\n      <div>\\n        <a href='book.html' class='cta'>Book a blending</a>\\n      </div>\\n    </header>\\n\\n    <main>\\n      <section class='hero'>\\n        <div>\\n          <h1>Explore the aroma wheel</h1>\\n          <p class='sub'>Hover or tap the sectors to reveal notes and gentle uses. No therapeutic promises — scents may support calm and focus when used mindfully.</p>\\n        </div>\\n      </section>\\n\\n      <section class='wheel-wrap'>\\n        <div class='wheel glass' aria-hidden='false'>\\n          <!-- SVG wheel with three interactive sectors -->\\n          <svg id='aroma-wheel' viewBox='0 0 300 300' width='320' height='320' role='img' aria-label='Aroma wheel with top, middle, and base notes'>\\n            <defs>\\n              <linearGradient id='g1' x1='0' x2='1'>\\n                <stop offset='0' stop-color='#dff7f3'/>\\n                <stop offset='1' stop-color='#9fe0d5'/>\\n              </linearGradient>\\n              <filter id='soft' x='-20%' y='-20%' width='140%' height='140%'>\\n                <feDropShadow dx='0' dy='6' stdDeviation='10' flood-color='#000' flood-opacity='0.18'/>\\n              </filter>\\n            </defs>\\n            <g transform='translate(150,150)'>\\n              <path id='sector-top' d='M0 0 L0 -140 A140 140 0 0 1 121 -81 z' fill='url(#g1)' stroke='rgba(255,255,255,0.06)' stroke-width='1'/>\\n              <path id='sector-mid' d='M0 0 L121 -81 A140 140 0 0 1 121 81 z' fill='rgba(160,232,215,0.12)' stroke='rgba(255,255,255,0.06)' stroke-width='1'/>\\n              <path id='sector-base' d='M0 0 L121 81 A140 140 0 0 1 0 140 z' fill='rgba(102,170,160,0.08)' stroke='rgba(255,255,255,0.06)' stroke-width='1'/>\\n              <circle r='60' fill='rgba(0,0,0,0.25)' />\\n              <text x='0' y='-18' text-anchor='middle' fill='#f2fdfb' font-size='12'>Top notes</text>\\n              <text x='0' y='0' text-anchor='middle' fill='#f2fdfb' font-size='12'>Middle notes</text>\\n              <text x='0' y='18' text-anchor='middle' fill='#f2fdfb' font-size='12'>Base notes</text>\\n            </g>\\n          </svg>\\n        </div>\\n\\n        <aside class='notes'>\\n          <div class='note-box'>\\n            <h4 style='margin:0;color:#e8fbfa'>Selected note</h4>\\n            <div id='note-title' style='margin-top:8px;font-weight:700;color:#bfeee7'>Hover a sector</div>\\n            <p id='note-desc' class='sub' style='margin-top:6px'>Notes are ways to describe scent characters; they may support a chosen mood when blended and diluted safely.</p>\\n\\n            <div class='note-list' id='note-list' aria-live='polite'>\\n              <!-- dynamic note items -->\\n            </div>\\n\\n            <div class='legend'>\\n              <small>Tap items to pin details. All blends include dilution guidance and a patch test reminder.</small>\\n            </div>\\n          </div>\\n\\n          <a href='book.html' class='cta'>Create a custom elixir</a>\\n        </aside>\\n      </section>\\n\\n      <section style='margin-top:18px'>\\n        <div class='glass' style='padding:12px'>\\n          <h4 style='margin:0;color:#dff7f3'>Notes palette</h4>\\n          <p class='sub' style='margin-top:8px'>Top, middle and base labels help frame how aromas evolve; we use them as guidelines rather than rules.</p>\\n        </div>\\n      </section>\\n\\n      <section style='margin-top:16px' class='glass'>\\n        <h4 style='margin:0;color:#dff7f3'>A few blends to consider</h4>\\n        <div style='display:flex;gap:12px;margin-top:10px;flex-wrap:wrap'>\\n          <div class='glass' style='padding:10px;border-radius:10px;min-width:220px'>\\n            <strong style='color:#e8fbfa'>Morning Clarity</strong>\\n            <div class='sub' style='margin-top:6px'>Bright top notes with soft herbs; may support alertness when inhaled briefly.</div>\\n          </div>\\n          <div class='glass' style='padding:10px;border-radius:10px;min-width:220px'>\\n            <strong style='color:#e8fbfa'>Evening Ground</strong>\\n            <div class='sub' style='margin-top:6px'>Warm base notes to anchor a simple bedside ritual.</div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section style='margin-top:16px' class='glass'>\\n        <h4 style='margin:0;color:#dff7f3'>Safety & FAQ</h4>\\n        <details style='color:var(--muted);margin-top:8px'><summary style='cursor:pointer;font-weight:700'>Why patch testing?</summary>\\n          <div style='margin-top:8px'>Patch tests reduce the chance of local skin reactions. We provide a step-by-step for home testing.</div>\\n        </details>\\n        <details style='color:var(--muted);margin-top:8px'><summary style='cursor:pointer;font-weight:700'>Pregnancy & pets</summary>\\n          <div style='margin-top:8px'>We adapt blends and suggest alternatives if you are pregnant or have sensitive pets; always disclose during intake.</div>\\n        </details>\\n      </section>\\n\\n    </main>\\n\\n    <footer style='margin-top:30px;color:var(--muted);text-align:center'>\\n      <small>Questions? Email <a href='mailto:{{EMAIL}}' style='color:var(--muted)'>{{EMAIL}}</a> or call <a href='tel:{{PHONE}}' style='color:var(--muted)'>{{PHONE}}</a></small>\\n    </footer>\\n  </div>\\n\\n  <script>\\n    // Aroma wheel interaction\\n    (function(){\\n      const sectors={\\n        'sector-top':{title:'Top notes',desc:'Crisp, volatile scents that are noticed first. Examples: citrus, light herbs. Often perceived as bright.' ,notes:['Bergamot','Grapefruit','Lemongrass','Peppermint']},\\n        'sector-mid':{title:'Middle notes',desc:'Heart of the blend: floral, green, or spicy tones that unfold after the top notes.',notes:['Lavender','Geranium','Clary Sage','Rosemary']},\\n        'sector-base':{title:'Base notes',desc:'Heavier, longer-lasting aromas that ground a blend: woods, resins, musks (non-animalic).',notes:['Cedarwood','Vetiver','Frankincense','Patchouli']}\\n      };\\n      const noteTitle=document.getElementById('note-title');\\n      const noteDesc=document.getElementById('note-desc');\\n      const noteList=document.getElementById('note-list');\\n\\n      function show(key){\\n        const data=sectors[key];\\n        noteTitle.textContent=data.title;\\n        noteDesc.textContent=data.desc + ' They may support an intended mood when used safely.';\\n        noteList.innerHTML='';\\n        data.notes.forEach(n=>{\\n          const el=document.createElement('div');\\n          el.className='note-item';\\n          el.tabIndex=0;\\n          el.textContent=n;\\n          el.onclick=()=>{navigator.clipboard?.writeText(n);el.style.outline='2px solid rgba(160,232,215,0.18)';};\\n          noteList.appendChild(el);\\n        });\\n      }\\n\\n      ['sector-top','sector-mid','sector-base'].forEach(id=>{\\n        const el=document.getElementById(id);\\n        el.addEventListener('mouseenter',()=>show(id));\\n        el.addEventListener('focus',()=>show(id));\\n        el.addEventListener('touchstart',()=>show(id));\\n      });\\n\\n      // initialize\\n      show('sector-top');\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Boutique — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--muted:#cbd7d4;--accent:#9fdccc}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#071018,#031316),url('assets/img/pattern.svg');color:#eaf7f6}\\n    .container{max-width:1100px;margin:28px auto;padding:0 20px}\\n    header{display:flex;align-items:center;justify-content:space-between;padding-bottom:12px}\\n    nav a{color:var(--muted);margin:0 8px;text-decoration:none}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}\\n    .prod{background:rgba(255,255,255,0.03);padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.04)}\\n    .prod h4{margin:0 0 8px}\\n    .price{font-weight:800;color:#dff7f3}\\n    .buy{display:inline-block;margin-top:10px;padding:8px 12px;border-radius:8px;background:linear-gradient(135deg,#9dd2c7,#6faea2);color:#042022;text-decoration:none;font-weight:700}\\n    .faq{margin-top:18px}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}}    \\n  </style>\\n</head>\\n<body>\\n  <div class='container'>\\n    <header>\\n      <div style='display:flex;align-items:center;gap:12px'>\\n        <div style='width:44px;height:44px;border-radius:10px;background:#072a29;display:flex;align-items:center;justify-content:center;color:#bfeee7;font-weight:800'>B</div>\\n        <nav aria-label='Shop nav'>\\n          <a href='index.html'>Nest</a>\\n          <a href='services.html'>Offerings</a>\\n          <a href='blends.html'>Elixirs</a>\\n          <a href='shop.html' style='color:#eaf7f6'>Boutique</a>\\n          <a href='about.html'>Story</a>\\n        </nav>\\n      </div>\\n      <div>\\n        <a href='book.html' class='buy'>Get a blend</a>\\n      </div>\\n    </header>\\n\\n    <main>\\n      <section class='glass' style='padding:18px'>\\n        <h2 style='margin:0;color:#dff7f3'>Boutique</h2>\\n        <p style='color:var(--muted);margin-top:8px'>Hand-blended small-batch elixirs and starter sets. Each product includes dilution recommendations and a patch test card.</p>\\n      </section>\\n\\n      <section style='margin-top:14px'>\\n        <div class='grid'>\\n          <div class='prod glass'>\\n            <h4>Daylight Mist — 30ml</h4>\\n            <div style='color:var(--muted)'>Citrus-forward spritz for a bright, liftful moment. Includes dilution notes.</div>\\n            <div class='price'>$28</div>\\n            <a class='buy' href='#' data-sku='daylight'>Add to cart</a>\\n          </div>\\n          <div class='prod glass'>\\n            <h4>Evening Tincture — 15ml</h4>\\n            <div style='color:var(--muted)'>Warm base notes for a short bedside ritual. Comes with carrier oil suggestions.</div>\\n            <div class='price'>$36</div>\\n            <a class='buy' href='#' data-sku='evening'>Add to cart</a>\\n          </div>\\n          <div class='prod glass'>\\n            <h4>Starter Ritual Kit</h4>\\n            <div style='color:var(--muted)'>Three mini blends, dilution guide, and patch test strips. A gentle way to begin scent practice.</div>\\n            <div class='price'>$62</div>\\n            <a class='buy' href='#' data-sku='kit'>Add to cart</a>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section class='glass' style='margin-top:16px;padding:12px'>\\n        <h4 style='margin:0;color:#dff7f3'>Proof & care</h4>\\n        <p style='color:var(--muted);margin-top:8px'>Care instructions and safety reminders appear with each item. We rotate brief customer notes below.</p>\\n        <div id='mini-proof' style='margin-top:12px;display:flex;gap:12px;align-items:center'>\\n          <div style='flex:1;color:var(--muted)' id='mini-text'>\\\"Beautifully labeled and easy to use.\\\" — P.</div>\\n          <div style='display:flex;gap:8px'>\\n            <div class='badge' title='Verified small-batch'>SM</div>\\n            <div class='badge' title='Safety-first blends'>SF</div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section class='faq'>\\n        <div class='glass' style='padding:12px'>\\n          <h4 style='margin:0;color:#dff7f3'>FAQ — Safety notes</h4>\\n          <details style='color:var(--muted);margin-top:8px'><summary style='cursor:pointer;font-weight:700'>How should I dilute?</summary>\\n            <div style='margin-top:8px'>Each product lists a starting dilution ratio; we recommend a small patch test and adjusting to sensitivity. Not for internal use.</div>\\n          </details>\\n          <details style='color:var(--muted);margin-top:8px'><summary style='cursor:pointer;font-weight:700'>Patch test guidance</summary>\\n            <div style='margin-top:8px'>Apply a small drop diluted in carrier oil to inner forearm and wait 24 hours. Discontinue if irritation occurs.</div>\\n          </details>\\n          <details style='color:var(--muted);margin-top:8px'><summary style='cursor:pointer;font-weight:700'>Pets & pregnancy</summary>\\n            <div style='margin-top:8px'>We provide pet- and pregnancy-aware notes where applicable; consult when ordering so we can advise safely.</div>\\n          </details>\\n        </div>\\n      </section>\\n\\n    </main>\\n\\n    <footer style='margin-top:24px;color:var(--muted);text-align:center'>\\n      <small>Made with care in {{CITY}}, {{STATE}} • <a href='mailto:{{EMAIL}}' style='color:var(--muted)'>{{EMAIL}}</a></small>\\n    </footer>\\n  </div>\\n\\n  <script>\\n    // lightweight cart simulation and rotating mini-proof\\n    (function(){\\n      document.querySelectorAll('.buy').forEach(btn=>{\\n        btn.addEventListener('click',e=>{\\n          e.preventDefault();\\n          const sku=btn.dataset.sku||'item';\\n          alert('Added to cart: '+sku+\\\". Review dilution & patch test guidance at checkout.\\\");\\n        });\\n      });\\n\\n      const notes=['\\\"Loved the kit, clear instructions.\\\" — A','\\\"Nice aromas and careful labeling.\\\" — T','\\\"High quality and thoughtful.\\\" — R'];\\n      let k=0; const el=document.getElementById('mini-text');\\n      setInterval(()=>{k=(k+1)%notes.length;el.textContent=notes[k];},3800);\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
