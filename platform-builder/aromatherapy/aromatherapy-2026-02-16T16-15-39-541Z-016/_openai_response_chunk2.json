          "text": "BUNDLE_START\n{\"path\":\"services.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n<title>{{BUSINESS_NAME}} — Offerings</title>\\n<style>\\n:root{\\n  --bg1:#0f1724;\\n  --accent:#b38fff;\\n  --accent2:#7ee7c4;\\n  --card:#0b1220;\\n  --muted:#9aa4b2;\\n  --glass:rgba(255,255,255,0.04);\\n}\\nhtml,body{height:100%;}\\nbody{\\n  margin:0;\\n  font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;\\n  color:#e6eef6;\\n  background:\\n    radial-gradient(1200px 600px at 10% 10%, rgba(179,143,255,0.08), transparent 10%),\\n    radial-gradient(800px 400px at 90% 90%, rgba(126,231,196,0.06), transparent 12%),\\n    url(\\\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='400'><defs><pattern id='p' width='40' height='40' patternUnits='userSpaceOnUse'><circle cx='6' cy='6' r='2' fill='%23b38fff' opacity='0.12'/><circle cx='34' cy='34' r='2' fill='%237ee7c4' opacity='0.08'/></pattern></defs><rect width='100%' height='100%' fill='url(%23p)' opacity='0.6'/></svg>\\\");\\n  background-blend-mode:screen,screen,normal;\\n  background-color:var(--bg1);\\n  -webkit-font-smoothing:antialiased;\\n  -moz-osx-font-smoothing:grayscale;\\n  line-height:1.45;\\n}\\n.container{max-width:1100px;margin:28px auto;padding:28px;}\\n.nav{display:flex;justify-content:space-between;align-items:center;gap:16px;}\\n.brand{display:flex;flex-direction:column;}\\n.brand h1{margin:0;font-size:20px;letter-spacing:0.6px;}\\n.brand p{margin:0;font-size:12px;color:var(--muted);}\\n.nav a{color:inherit;text-decoration:none;padding:8px 12px;border-radius:10px;}\\n.nav .links a{opacity:0.9}\\n.hero{display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:center;margin-top:28px;}\\n.hero .lead{background:linear-gradient(180deg,rgba(255,255,255,0.03),transparent);padding:26px;border-radius:14px;box-shadow:inset 0 1px 0 rgba(255,255,255,0.02);} \\nh2{margin:0 0 8px 0;font-size:28px;}\\n.lead p{margin:0;color:var(--muted);} \\n.cta{margin-top:16px;}\\n.button{display:inline-block;padding:12px 18px;background:linear-gradient(90deg,var(--accent),var(--accent2));color:#07101a;border-radius:12px;font-weight:700;text-decoration:none;}\\n.side-card{background:var(--card);padding:20px;border-radius:12px;box-shadow:0 6px 18px rgba(2,6,23,0.6);} \\n.section{margin-top:28px;}\\n.grid{display:grid;gap:16px;}\\n.framework{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}\\n.card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03);} \\n.offers{display:flex;gap:12px;flex-wrap:wrap;}\\n.offer{min-width:220px;}\\n.pricing-teaser{display:flex;gap:12px;align-items:center;}\\n.testimonials{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;}\\n.test{padding:16px;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);border:1px solid rgba(255,255,255,0.02);} \\n.small{font-size:13px;color:var(--muted);} \\n.footer{margin-top:32px;padding:18px;border-radius:12px;background:linear-gradient(180deg,rgba(0,0,0,0.2),transparent);text-align:center;} \\n@media (max-width:900px){.hero{grid-template-columns:1fr;}.framework{grid-template-columns:1fr;}.testimonials{grid-template-columns:1fr;}}\\n</style>\\n</head>\\n<body>\\n<div class=\\\"container\\\">\\n  <nav class=\\\"nav\\\" aria-label=\\\"Main navigation\\\">\\n    <div class=\\\"brand\\\"><h1>{{BUSINESS_NAME}}</h1><p>{{TAGLINE}}</p></div>\\n    <div class=\\\"links\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Offerings</a>\\n      <a href=\\\"blends.html\\\">Blends Lab</a>\\n      <a href=\\\"shop.html\\\">Boutique</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </div>\\n  </nav>\\n\\n  <header class=\\\"hero\\\" role=\\\"banner\\\">\\n    <div class=\\\"lead\\\">\\n      <h2>Personalized Aromatherapy Sessions</h2>\\n      <p class=\\\"small\\\">Guided scent sessions that focus on sensory balance, ritual, and gentle self-care. Sessions are safety-first and tailored to your preferences.</p>\\n      <div class=\\\"cta\\\">\\n        <a class=\\\"button\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </div>\\n    <aside class=\\\"side-card\\\">\\n      <h3>Session Snapshot</h3>\\n      <p class=\\\"small\\\">60–90 minute one-on-one sessions. Assessment, aroma exploration, custom blend to take home (retail add-on available).</p>\\n      <div style=\\\"margin-top:12px;\\\">\\n        <strong>Practitioner</strong><div class=\\\"small\\\">{{PRACTITIONER_NAME}}</div>\\n      </div>\\n      <div style=\\\"margin-top:12px;\\\"><strong>Location</strong><div class=\\\"small\\\">{{CITY}}, {{STATE}}</div></div>\\n      <div style=\\\"margin-top:12px;\\\"><strong>Contact</strong><div class=\\\"small\\\">{{PHONE}} • {{EMAIL}}</div></div>\\n      <div style=\\\"margin-top:12px;\\\"><a class=\\\"button\\\" href=\\\"book.html\\\">Book a session</a></div>\\n    </aside>\\n  </header>\\n\\n  <section class=\\\"section story\\\">\\n    <div class=\\\"card\\\">\\n      <h3>A little about the practice</h3>\\n      <p class=\\\"small\\\">We blend traditional aromatic wisdom with contemporary safety best practices. Every consultation begins with questions about sensitivities, medications, pregnancy, and pet exposure to ensure blends are safe and appropriate.</p>\\n    </div>\\n  </section>\\n\\n  <section class=\\\"section framework\\\">\\n    <div class=\\\"card\\\">\\n      <h4>1. Intake</h4>\\n      <p class=\\\"small\\\">Gentle conversation to learn scent history, allergies, and preferences. Patch-test guidance included.</p>\\n    </div>\\n    <div class=\\\"card\\\">\\n      <h4>2. Exploration</h4>\\n      <p class=\\\"small\\\">Smelling station with single-note samples: top, heart, base. We observe preferences and tolerance.</p>\\n    </div>\\n    <div class=\\\"card\\\">\\n      <h4>3. Ritual</h4>\\n      <p class=\\\"small\\\">A tailored at-home ritual and safe dilution instructions for topical use. Non-medical supportive language is used throughout.</p>\\n    </div>\\n  </section>\\n\\n  <section class=\\\"section offers\\\">\\n    <div class=\\\"offer card\\\">\\n      <h4>Custom Blend — Starter</h4>\\n      <p class=\\\"small\\\">5 ml roll-on, curated to your preferences. Retail add-on option available during sessions.</p>\\n    </div>\\n    <div class=\\\"offer card\\\">\\n      <h4>Deep Aroma Session</h4>\\n      <p class=\\\"small\\\">90-minute immersive experience with guided inhalation and bespoke diffuse protocols.</p>\\n    </div>\\n    <div class=\\\"offer card\\\">\\n      <h4>Virtual Consultation</h4>\\n      <p class=\\\"small\\\">Video-based scent guidance and DIY blend formulas. Includes dilution chart and patch test instructions.</p>\\n    </div>\\n  </section>\\n\\n  <section class=\\\"section\\\">\\n    <div class=\\\"card pricing-teaser\\\">\\n      <div>\\n        <h4>Pricing & Packages</h4>\\n        <p class=\\\"small\\\">Transparent pricing is available on the Pricing page. Retail items and blends are sold as an add-on to sessions or separately in the Boutique.</p>\\n      </div>\\n      <div style=\\\"margin-left:auto;\\\"><a class=\\\"button\\\" href=\\\"pricing.html\\\">See pricing</a></div>\\n    </div>\\n  </section>\\n\\n  <section class=\\\"section testimonials\\\">\\n    <div class=\\\"test\\\">\\n      <strong>”Calming and precise.”</strong>\\n      <p class=\\\"small\\\">\\\"The session felt like a map; I left with a simple ritual that's become my evening anchor.\\\" — S.</p>\\n    </div>\\n    <div class=\\\"test\\\">\\n      <strong>”Thoughtful and safe.”</strong>\\n      <p class=\\\"small\\\">\\\"Clear guidance on dilution and a lovely custom roll-on that I use for focus.\\\" — M.</p>\\n    </div>\\n  </section>\\n\\n  <section class=\\\"section card\\\">\\n    <h3>Safety-first notes</h3>\\n    <p class=\\\"small\\\">Aromatherapy here is complementary and non-diagnostic. We avoid medical claims and prioritize safe dilution, patch testing, and considerations for pregnancy and pets. Always consult your healthcare provider for medical concerns.</p>\\n  </section>\\n\\n  <footer class=\\\"footer\\\">\\n    <div class=\\\"small\\\">Ready to begin a scent ritual? <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"button\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n    <div class=\\\"small\\\" style=\\\"margin-top:8px;\\\">{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • {{PHONE}}</div>\\n  </footer>\\n</div>\\n</body>\\n</html>\"} \n{\"path\":\"blends.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n<title>{{BUSINESS_NAME}} — Blends Lab</title>\\n<style>\\n:root{--bg:#07101a;--card:#08131a;--accent:#ffd7a8;--accent2:#9be7ff;--muted:#9fb0bd}\\nbody{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:#eaf6f9;background:linear-gradient(180deg,#05202b 0%,#071822 60%);-webkit-font-smoothing:antialiased}\\n.container{max-width:1100px;margin:28px auto;padding:28px}\\n.header{display:flex;justify-content:space-between;align-items:center}\\n.brand{display:flex;flex-direction:column}\\n.brand h1{margin:0;font-size:20px}\\n.brand p{margin:0;font-size:12px;color:var(--muted)}\\n.nav a{color:inherit;text-decoration:none;margin-left:12px;padding:8px;border-radius:8px}\\n.hero{margin-top:22px;padding:20px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);display:flex;align-items:center;gap:16px}\\n.hero svg{width:88px;height:88px;border-radius:12px;flex-shrink:0}\\nh2{margin:0;font-size:24px}\\n.lead{color:var(--muted)}\\n.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:18px}\\n.blend{background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.02)}\\n.blend h4{margin:0 0 6px 0}\\n.notes{font-size:13px;color:var(--muted);margin:6px 0}\\n.kv{display:flex;gap:10px;flex-wrap:wrap}\\n.chips{background:rgba(255,255,255,0.03);padding:6px 8px;border-radius:999px;font-size:12px}\\n.faq{margin-top:18px;background:linear-gradient(180deg,rgba(0,0,0,0.2),transparent);padding:14px;border-radius:12px}\\n.q{margin:8px 0}\\n.cta{margin-top:18px;text-align:center}\\n.button{display:inline-block;padding:10px 16px;background:linear-gradient(90deg,var(--accent),var(--accent2));color:#07101a;border-radius:10px;font-weight:700;text-decoration:none}\\n@media(max-width:800px){.grid{grid-template-columns:1fr}}\\n</style>\\n</head>\\n<body>\\n<div class=\\\"container\\\">\\n  <header class=\\\"header\\\">\\n    <div class=\\\"brand\\\"><h1>{{BUSINESS_NAME}}</h1><p>{{TAGLINE}}</p></div>\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Sessions</a>\\n      <a href=\\\"shop.html\\\">Boutique</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <section class=\\\"hero\\\">\\n    <svg viewBox=\\\"0 0 100 100\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><defs><linearGradient id=\\\"g\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#ffd7a8\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#9be7ff\\\"/></linearGradient></defs><rect width=\\\"100\\\" height=\\\"100\\\" rx=\\\"12\\\" fill=\\\"url(#g)\\\" opacity=\\\"0.12\\\"/></svg>\\n    <div>\\n      <h2>Blends Lab</h2>\\n      <p class=\\\"lead\\\">A curated collection of pre-formulated blends. Each description lists top / middle / base notes, an aroma profile, and a non-medical “supports” statement for everyday self-care.</p>\\n    </div>\\n  </section>\\n\\n  <section class=\\\"grid\\\" aria-label=\\\"blends list\\\">\\n\\n    <div class=\\\"blend\\\">\\n      <h4>Tranquil Evening</h4>\\n      <div class=\\\"notes\\\"><strong>Profile:</strong> Soft floral, warm resin</div>\\n      <div class=\\\"kv\\\"><div class=\\\"chips\\\">Top: Bergamot</div><div class=\\\"chips\\\">Middle: Lavender</div><div class=\\\"chips\\\">Base: Benzoin</div></div>\\n      <p class=\\\"small\\\">Aroma: gentle, hush-like. Supports restful evenings and a calming bedtime ritual when used safely.</p>\\n    </div>\\n\\n    <div class=\\\"blend\\\">\\n      <h4>Focus Spark</h4>\\n      <div class=\\\"notes\\\"><strong>Profile:</strong> Bright herbal-citrus</div>\\n      <div class=\\\"kv\\\"><div class=\\\"chips\\\">Top: Lemon</div><div class=\\\"chips\\\">Middle: Rosemary</div><div class=\\\"chips\\\">Base: Vetiver</div></div>\\n      <p class=\\\"small\\\">Aroma: clear and energizing. Supports short bouts of concentrated work and ritual pauses.</p>\\n    </div>\\n\\n    <div class=\\\"blend\\\">\\n      <h4>Morning Dew</h4>\\n      <div class=\\\"notes\\\"><strong>Profile:</strong> Fresh green-floral</div>\\n      <div class=\\\"kv\\\"><div class=\\\"chips\\\">Top: Grapefruit</div><div class=\\\"chips\\\">Middle: Neroli</div><div class=\\\"chips\\\">Base: Cedarwood</div></div>\\n      <p class=\\\"small\\\">Aroma: bright and awakening. Supports gentle morning routines and mood lifting in small doses.</p>\\n    </div>\\n\\n    <div class=\\\"blend\\\">\\n      <h4>Forest Walk</h4>\\n      <div class=\\\"notes\\\"><strong>Profile:</strong> Earthy conifer</div>\\n      <div class=\\\"kv\\\"><div class=\\\"chips\\\">Top: Pine</div><div class=\\\"chips\\\">Middle: Cypress</div><div class=\\\"chips\\\">Base: Patchouli</div></div>\\n      <p class=\\\"small\\\">Aroma: grounding and cool. Supports moments of centering and presence.</p>\\n    </div>\\n\\n    <div class=\\\"blend\\\">\\n      <h4>Citrus Clarity</h4>\\n      <div class=\\\"notes\\\"><strong>Profile:</strong> Zesty clean</div>\\n      <div class=\\\"kv\\\"><div class=\\\"chips\\\">Top: Orange</div><div class=\\\"chips\\\">Middle: Lemon Verbena</div><div class=\\\"chips\\\">Base: Ambrette</div></div>\\n      <p class=\\\"small\\\">Aroma: uplifting and crisp. Supports short focus rituals and an energetic atmosphere.</p>\\n    </div>\\n\\n    <div class=\\\"blend\\\">\\n      <h4>Sleep Whisper</h4>\\n      <div class=\\\"notes\\\"><strong>Profile:</strong> Floral-woody hush</div>\\n      <div class=\\\"kv\\\"><div class=\\\"chips\\\">Top: Sweet Marjoram</div><div class=\\\"chips\\\">Middle: Roman Chamomile</div><div class=\\\"chips\\\">Base: Sandalwood</div></div>\\n      <p class=\\\"small\\\">Aroma: soft and cocooning. Supports bedtime routines when used according to dilution guidance.</p>\\n    </div>\\n\\n    <div class=\\\"blend\\\">\\n      <h4>Uplift Breeze</h4>\\n      <div class=\\\"notes\\\"><strong>Profile:</strong> Spring floral-citrus</div>\\n      <div class=\\\"kv\\\"><div class=\\\"chips\\\">Top: Bergamot</div><div class=\\\"chips\\\">Middle: Jasmine</div><div class=\\\"chips\\\">Base: Musk accord</div></div>\\n      <p class=\\\"small\\\">Aroma: bright and breezy. Supports lightness in the home and ritual refreshers.</p>\\n    </div>\\n\\n    <div class=\\\"blend\\\">\\n      <h4>Grounding Resin</h4>\\n      <div class=\\\"notes\\\"><strong>Profile:</strong> Warm resinous earth</div>\\n      <div class=\\\"kv\\\"><div class=\\\"chips\\\">Top: Black Pepper</div><div class=\\\"chips\\\">Middle: Frankincense</div><div class=\\\"chips\\\">Base: Myrrh</div></div>\\n      <p class=\\\"small\\\">Aroma: sacred and deep. Supports contemplative practices and stability cues.</p>\\n    </div>\\n\\n    <div class=\\\"blend\\\">\\n      <h4>Warm Embrace</h4>\\n      <div class=\\\"notes\\\"><strong>Profile:</strong> Spiced floral</div>\\n      <div class=\\\"kv\\\"><div class=\\\"chips\\\">Top: Cardamom</div><div class=\\\"chips\\\">Middle: Rose</div><div class=\\\"chips\\\">Base: Vanilla</div></div>\\n      <p class=\\\"small\\\">Aroma: cozy and intimate. Supports self-care rituals and ceremonial moments.</p>\\n    </div>\\n\\n    <div class=\\\"blend\\\">\\n      <h4>Clean Linen</h4>\\n      <div class=\\\"notes\\\"><strong>Profile:</strong> Soft ozonic-cotton</div>\\n      <div class=\\\"kv\\\"><div class=\\\"chips\\\">Top: Litsea</div><div class=\\\"chips\\\">Middle: Lavender</div><div class=\\\"chips\\\">Base: Musk accord</div></div>\\n      <p class=\\\"small\\\">Aroma: airy and comforting. Supports freshening spaces and gentle routines.</p>\\n    </div>\\n\\n  </section>\\n\\n  <section class=\\\"faq\\\" aria-label=\\\"Blends FAQ\\\">\\n    <h3>FAQ — Safety & Use</h3>\\n    <div class=\\\"q\\\"><strong>Dilution:</strong> Please follow dilution charts provided with each product. For topical application, 1–3% is common for adults; always reference practitioner guidance for individual circumstances.</div>\\n    <div class=\\\"q\\\"><strong>Patch test:</strong> Patch testing is recommended before topical use. Apply diluted product to a small area of skin and wait 24 hours to check for sensitivity.</div>\\n    <div class=\\\"q\\\"><strong>Pets:</strong> Some essential oils can be harmful to pets. Inform us of any animal exposures during consultations so we can recommend pet-safe options and diffusion practices.</div>\\n    <div class=\\\"q\\\"><strong>Pregnancy & nursing:</strong> Certain oils are not recommended during pregnancy and breastfeeding. Consult your healthcare provider and inform the practitioner during intake.</div>\\n  </section>\\n\\n  <div class=\\\"cta\\\">\\n    <a class=\\\"button\\\" href=\\\"shop.html\\\">Explore the Boutique</a>\\n    <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">If you want a bespoke version of a blend, book a session to create a tailored formula and receive dilution guidance.</p>\\n  </div>\\n\\n  <footer style=\\\"margin-top:22px;color:var(--muted);font-size:13px;text-align:center\\\">{{BUSINESS_NAME}} • Bespoke blends sold as part of sessions or separately in the Boutique • {{EMAIL}}</footer>\\n</div>\\n</body>\\n</html>\"} \n{\"path\":\"shop.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n<title>{{BUSINESS_NAME}} — Boutique</title>\\n<style>\\n:root{--bg:#08121a;--muted:#9fb0bd;--card:#0b1620;--accent1:#ffd7a8;--accent2:#9be7ff}\\n*{box-sizing:border-box}\\nbody{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:#e9f6fb;background:linear-gradient(180deg,#041018 0%,#071822 70%);-webkit-font-smoothing:antialiased}\\n.container{max-width:1100px;margin:28px auto;padding:28px}\\n.header{display:flex;justify-content:space-between;align-items:center}\\n.brand h1{margin:0;font-size:20px}\\n.brand p{margin:0;font-size:12px;color:var(--muted)}\\n.nav a{color:inherit;text-decoration:none;margin-left:12px;padding:8px;border-radius:8px}\\n.hero{margin-top:20px;padding:18px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);display:flex;justify-content:space-between;align-items:center}\\n.hero .lead{max-width:760px}\\n.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n.product{background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.02);display:flex;flex-direction:column;gap:10px}\\n.product h4{margin:0}\\n.price{font-weight:700}\\n.btn{display:inline-block;padding:10px 12px;border-radius:8px;background:linear-gradient(90deg,var(--accent1),var(--accent2));color:#07101a;text-decoration:none;font-weight:700}\\n.note{font-size:13px;color:var(--muted)}\\n@media(max-width:1000px){.grid{grid-template-columns:repeat(2,1fr)}}\\n@media(max-width:700px){.grid{grid-template-columns:1fr}}\\n</style>\\n</head>\\n<body>\\n<div class=\\\"container\\\">\\n  <header class=\\\"header\\\">\\n    <div class=\\\"brand\\\"><h1>{{BUSINESS_NAME}}</h1><p>{{TAGLINE}}</p></div>\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"services.html\\\">Sessions</a>\\n      <a href=\\\"blends.html\\\">Lab</a>\\n      <a href=\\\"contact.html\\\">Reach out</a>\\n    </nav>\\n  </header>\\n\\n  <section class=\\\"hero\\\">\\n    <div class=\\\"lead\\\">\\n      <h2>Boutique</h2>\\n      <p class=\\\"note\\\">Small-batch roll-ons, kits, and tasteful diffusers. Products are sold as retail add-ons or separately. Safety information and dilution guidance accompany each topical product.</p>\\n    </div>\\n    <div style=\\\"text-align:right\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Book & Buy</a></div>\\n  </section>\\n\\n  <section class=\\\"grid\\\" aria-label=\\\"shop products\\\">\\n\\n    <div class=\\\"product\\\">\\n      <h4>Starter Ritual Kit</h4>\\n      <div class=\\\"note\\\">Includes diffuser pouch, travel roller, and guide.</div>\\n      <div class=\\\"price\\\">$48</div>\\n      <div><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n    </div>\\n\\n    <div class=\\\"product\\\">\\n      <h4>Calm Roll-On — 5 ml</h4>\\n      <div class=\\\"note\\\">Pre-diluted roll-on inspired by Tranquil Evening. Safe for targeted topical use per instructions.</div>\\n      <div class=\\\"price\\\">$18</div>\\n      <div><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n    </div>\\n\\n    <div class=\\\"product\\\">\\n      <h4>Focus Roll-On — 5 ml</h4>\\n      <div class=\\\"note\\\">A compact roll for desk rituals. Includes patch-test recommendation.</div>\\n      <div class=\\\"price\\\">$18</div>\\n      <div><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n    </div>\\n\\n    <div class=\\\"product\\\">\\n      <h4>Sleep Mister — 60 ml</h4>\\n      <div class=\\\"note\\\">Room mist for linens and sleep routines. Use in well-ventilated spaces and follow label guidance.</div>\\n      <div class=\\\"price\\\">$26</div>\\n      <div><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n    </div>\\n\\n    <div class=\\\"product\\\">\\n      <h4>Ultrasonic Diffuser — Ceramic</h4>\\n      <div class=\\\"note\\\">Stylish diffuser for small to medium rooms. Includes diffuse-time recommendations.</div>\\n      <div class=\\\"price\\\">$64</div>\\n      <div><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n    </div>\\n\\n    <div class=\\\"product\\\">\\n      <h4>Travel Roller Trio</h4>\\n      <div class=\\\"note\\\">Three 5 ml roll-ons in a compact case. Mix and match blends in-session for custom trio boxes.</div>\\n      <div class=\\\"price\\\">$42</div>\\n      <div><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n    </div>\\n\\n    <div class=\\\"product\\\">\\n      <h4>Seasonal Blend — 15 ml</h4>\\n      <div class=\\\"note\\\">Limited release. Aroma profile varies by season. Check label for safety notes.</div>\\n      <div class=\\\"price\\\">$22</div>\\n      <div><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n    </div>\\n\\n    <div class=\\\"product\\\">\\n      <h4>Mini Gift Set</h4>\\n      <div class=\\\"note\\\">Small sampler kit—perfect for thoughtful gifting. Comes with usage guidance card.</div>\\n      <div class=\\\"price\\\">$34</div>\\n      <div><a class=\\\"btn\\\" href=\\\"#\\\">Add to cart</a></div>\\n    </div>\\n\\n    <div class=\\\"product\\\">\\n      <h4>Custom Blend Voucher (in-session)</h4>\\n      <div class=\\\"note\\\">Redeemable for a custom blend during a one-on-one session. Retail add-on available.</div>\\n      <div class=\\\"price\\\">$30</div>\\n      <div><a class=\\\"btn\\\" href=\\\"book.html\\\">Purchase & Book</a></div>\\n    </div>\\n\\n  </section>\\n\\n  <section style=\\\"margin-top:18px;padding:14px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent)\\\">\\n    <h4>Safety & Returns</h4>\\n    <p class=\\\"note\\\">All products include safety guidance: dilution charts, patch test recommendations, and pet/pregnancy notes where applicable. Non-medical support language only. Returns accepted within 14 days for unopened items—contact {{EMAIL}} for details.</p>\\n  </section>\\n\\n  <footer style=\\\"margin-top:22px;color:var(--muted);text-align:center;font-size:13px\\\">Questions? Call {{PHONE}} or email {{EMAIL}} • {{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</footer>\\n</div>\\n</body>\\n</html>\"} \nBUNDLE_END"
