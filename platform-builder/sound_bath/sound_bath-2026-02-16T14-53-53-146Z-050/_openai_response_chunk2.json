          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Sound Bath Events — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#0f1724;--bg2:#071023;--accent:#D4B8FF;--muted:#9aa4b2;--panel:#0b1220}\\n    *{box-sizing:border-box}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:#e6eef8;background:linear-gradient(180deg,var(--bg1),var(--bg2));-webkit-font-smoothing:antialiased}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px;background:linear-gradient(90deg,rgba(255,255,255,0.02),transparent);backdrop-filter:blur(6px);position:sticky;top:0;z-index:40}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#1a2a4a,#2a1a44);display:flex;align-items:center;justify-content:center;color:var(--accent);font-weight:700}\\n    nav a{color:#cfe6ff;text-decoration:none;margin:0 10px;font-size:14px}\\n    nav a.active{color:var(--accent);font-weight:600}\\n    main{max-width:1100px;margin:36px auto;padding:28px}\\n    /* decorative panel */\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:stretch}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border-radius:14px;padding:24px;box-shadow:0 8px 30px rgba(5,8,15,0.6);border:1px solid rgba(255,255,255,0.03)}\\n    h1{margin:0 0 8px;font-size:28px;color:#fff}\\n    p.lead{color:var(--muted);margin:0 0 14px}\\n    .pill{display:inline-block;padding:8px 12px;border-radius:999px;background:linear-gradient(90deg,rgba(212,184,255,0.12),rgba(212,184,255,0.06));color:var(--accent);font-weight:600;font-size:13px}\\n    .next-event{background:linear-gradient(180deg,#071226,rgba(7,16,36,0.6));padding:18px;border-radius:12px;color:#dbefff}\\n    .calendar-list{margin-top:12px;display:flex;flex-direction:column;gap:8px}\\n    .date-item{display:flex;justify-content:space-between;padding:10px;border-radius:10px;background:rgba(255,255,255,0.02);align-items:center}\\n    ul.flow{padding-left:18px;color:var(--muted);line-height:1.6}\\n    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px}\\n    .micro{display:flex;flex-direction:column;gap:8px}\\n    footer{margin-top:28px;padding-top:18px;border-top:1px solid rgba(255,255,255,0.03);display:flex;justify-content:space-between;align-items:center;color:var(--muted)}\\n    .cta{display:inline-block;padding:12px 18px;border-radius:10px;background:linear-gradient(90deg, #a98bff, #6bd3ff);color:#04243a;font-weight:700;text-decoration:none}\\n    /* responsive */\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.card{padding:18px}.logo{width:40px;height:40px}}\\n    /* patterned background using external SVG */\\n    body::before{content:\\\"\\\";position:fixed;inset:0;z-index:-1;background-image:url('assets/img/pattern.svg');opacity:0.12;background-repeat:repeat;mix-blend-mode:overlay}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">SB</div>\\n      <div>\\n        <div style=\\\"font-weight:700;color:#fff\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{CITY}}, {{STATE}} • Sound immersion</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Gatherings</a>\\n      <a class=\\\"active\\\" href=\\\"events.html\\\">Next Sound</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <!-- HERO (centered on experience) -->\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"card\\\">\\n        <span class=\\\"pill\\\">Live Sound Bath</span>\\n        <h1>Slow down. Sink in. Resonate together.</h1>\\n        <p class=\\\"lead\\\">An intimate, sensory-led sound ceremony combining rich overtones and subtle touch to support deep rest and clarity. Each event is curated to be both restful and elevated.</p>\\n\\n        <div style=\\\"margin-top:16px;display:flex;gap:12px;align-items:center\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <div style=\\\"color:var(--muted)\\\">or call <strong style=\\\"color:#fff\\\">{{PHONE}}</strong></div>\\n        </div>\\n\\n        <hr style=\\\"margin:18px 0;border:none;border-top:1px solid rgba(255,255,255,0.03)\\\">\\n\\n        <h3 style=\\\"color:#fff;margin:0 0 8px\\\">What to expect (flow)</h3>\\n        <ul class=\\\"flow\\\">\\n          <li>Welcome & grounding (10–12 min) — gentle breathwork to settle in.</li>\\n          <li>Resonant soundscape (45–60 min) — layered instruments guide a slow wave of vibration.</li>\\n          <li>Soft reorientation (8–12 min) — gradual return with tea and space to journal.</li>\\n        </ul>\\n\\n        <div style=\\\"margin-top:14px;color:var(--muted);font-size:13px\\\">Instruments featured this event: crystal bowls, planet gong, wind chimes and soft electronics — carefully layered for a spacious, tactile field.</div>\\n\\n      </div>\\n\\n      <aside class=\\\"card next-event\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Next event</div>\\n            <div style=\\\"font-weight:700;font-size:18px;margin-top:6px\\\">{{NEXT_EVENT_DATE}}</div>\\n            <div style=\\\"font-size:13px;color:var(--muted);margin-top:6px\\\">Hosted at {{VENUE_NAME}} • Doors 18:30 • Begins 19:00</div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve Spot</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"calendar-list\\\">\\n          <div class=\\\"date-item\\\"><div>Mar 7 — Evening Immersion</div><div style=\\\"color:var(--accent)\\\">Limited</div></div>\\n          <div class=\\\"date-item\\\"><div>Apr 4 — Full Moon Field</div><div style=\\\"color:var(--muted)\\\">Open</div></div>\\n          <div class=\\\"date-item\\\"><div>May 9 — Morning Reset</div><div style=\\\"color:var(--muted)\\\">Open</div></div>\\n        </div>\\n\\n        <hr style=\\\"margin:12px 0;border:none;border-top:1px solid rgba(255,255,255,0.03)\\\">\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">\\n          What to bring: cozy layers, a yoga mat or cushion, eye cover or blanket, water. We provide bolsters and extra blankets on request.\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <!-- DIAGNOSTIC (quick self-check) -->\\n    <section style=\\\"margin-top:22px\\\" class=\\\"card\\\">\\n      <h2 style=\\\"margin:0 0 6px\\\">Is this session right for you?</h2>\\n      <p class=\\\"lead\\\">A quick practical guide to help you choose — this is gentle, low-impact sound work designed for relaxation and nervous-system regulation.</p>\\n      <div class=\\\"grid-2\\\" style=\\\"margin-top:12px\\\">\\n        <div>\\n          <h4 style=\\\"margin:0 0 6px\\\">Good fit if you:</h4>\\n          <ul style=\\\"color:var(--muted)\\\">\\n            <li>Want to rest without guided therapy</li>\\n            <li>Crave sensory calm and deep breathing</li>\\n            <li>Enjoy shared, quiet ceremony</li>\\n          </ul>\\n        </div>\\n        <div>\\n          <h4 style=\\\"margin:0 0 6px\\\">Contraindications & safety</h4>\\n          <p style=\\\"color:var(--muted);margin:0\\\">If you have epilepsy, are pregnant in the first trimester, have a heart pacemaker, or are currently experiencing severe psychiatric symptoms, please consult your healthcare provider and notify the facilitator before booking.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- MICRO HABITS -->\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card micro\\\">\\n      <h3 style=\\\"margin:0\\\">Micro-habits to prepare</h3>\\n      <div style=\\\"color:var(--muted)\\\">Small practices you can do before arrival to deepen the experience.</div>\\n      <div style=\\\"display:flex;gap:12px;flex-wrap:wrap;margin-top:10px\\\">\\n        <div style=\\\"background:rgba(255,255,255,0.02);padding:10px;border-radius:10px;font-size:13px\\\">Hydrate well — avoid heavy meals within an hour</div>\\n        <div style=\\\"background:rgba(255,255,255,0.02);padding:10px;border-radius:10px;font-size:13px\\\">Wear breathable layers and non-restrictive clothes</div>\\n        <div style=\\\"background:rgba(255,255,255,0.02);padding:10px;border-radius:10px;font-size:13px\\\">Journal one intention or thing to release</div>\\n      </div>\\n    </section>\\n\\n    <!-- PLAN (logistics & accessibility) -->\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 6px\\\">Plan & Logistics</h3>\\n      <p style=\\\"color:var(--muted);margin:0\\\">Arrive 15 minutes early for check-in. Sessions last ~75 minutes. Street parking and bike racks at {{VENUE_NAME}}. Quiet space with dim lighting and low fragrance policy.</p>\\n    </section>\\n\\n    <!-- PRICING (compact) -->\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 6px\\\">Rates</h3>\\n      <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n        <div style=\\\"font-weight:700;font-size:20px\\\">$35</div>\\n        <div style=\\\"color:var(--muted)\\\">General admission — concessions available</div>\\n      </div>\\n      <div style=\\\"margin-top:8px;color:var(--muted);font-size:13px\\\">Arrive rested; refunds up to 48 hours prior. For group bookings see Private Sessions.</div>\\n    </section>\\n\\n    <!-- CTA -->\\n    <footer>\\n      <div>\\n        <div style=\\\"font-weight:700;color:#fff\\\">Still unsure?</div>\\n        <div style=\\\"color:var(--muted);font-size:13px\\\">Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a> for personalized guidance.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve Your Spot</a>\\n      </div>\\n    </footer>\\n\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Private Sessions — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#041022;--panel:#071427;--muted:#9fb1c7;--gold:#FFDDAA}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial;background:radial-gradient(1200px 600px at 10% 10%,rgba(150,120,255,0.06),transparent),radial-gradient(1000px 500px at 90% 90%,rgba(100,200,255,0.04),transparent),var(--bg);color:#e9f6ff}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 26px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent)}\\n    .logo{font-weight:700;background:linear-gradient(90deg,#2b1a4b,#0b3b48);padding:10px;border-radius:10px}\\n    nav a{color:var(--muted);margin:0 10px;text-decoration:none}\\n    main{max-width:1000px;margin:28px auto;padding:0 22px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:18px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border-radius:12px;padding:20px;border:1px solid rgba(255,255,255,0.03)}\\n    h1{margin:0 0 8px;font-size:26px}\\n    p.lead{color:var(--muted);margin:0}\\n    .service{border-radius:10px;padding:12px;background:rgba(255,255,255,0.01);margin-bottom:10px}\\n    .fee{font-weight:700}\\n    .micro{display:flex;gap:10px;flex-direction:column}\\n    .cta{display:inline-block;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,#ffddaa,#bfa6ff);color:#02233a;font-weight:700;text-decoration:none}\\n    footer{margin-top:20px;color:var(--muted);font-size:13px}\\n    body::before{content:\\\"\\\";position:fixed;inset:0;z-index:-1;background-image:url('assets/img/pattern.svg');opacity:0.08;background-repeat:repeat}\\n    @media (max-width:900px){.grid{grid-template-columns:1fr}.card{padding:16px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n      <div style=\\\"color:var(--muted);font-size:13px\\\">Private Sound • Tailored sessions</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Events</a>\\n      <a class=\\\"active\\\" href=\\\"private-sessions.html\\\">Private Options</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"grid\\\">\\n      <section class=\\\"card\\\">\\n        <h1>Private sound experiences — curated for you</h1>\\n        <p class=\\\"lead\\\">One-to-one attention, couples ceremonies, and corporate sessions designed to elevate rest, creativity, and team cohesion. Each session is a crafted arc of intention, vibration, and gentle re-entry.</p>\\n\\n        <hr style=\\\"margin:14px 0;border:none;border-top:1px solid rgba(255,255,255,0.03)\\\">\\n\\n        <h3 style=\\\"margin:6px 0\\\">Session flow (typical)</h3>\\n        <ol style=\\\"color:var(--muted);line-height:1.6\\\">\\n          <li>Consultation & intention-setting (10–20 min)</li>\\n          <li>Arrangements & settling (5–10 min)</li>\\n          <li>Immersive soundscape (40–60 min) — tailored dynamics and instrument mix</li>\\n          <li>Integration & aftercare (10–15 min) — suggestions and resources</li>\\n        </ol>\\n\\n        <h3 style=\\\"margin-top:12px\\\">Instruments we might use</h3>\\n        <div style=\\\"color:var(--muted)\\\">Tuning forks, koshi chimes, monochord and subtle planetary bowls — chosen to suit the intention and space.</div>\\n\\n        <h3 style=\\\"margin-top:12px\\\">What to bring & prep</h3>\\n        <div style=\\\"color:var(--muted)\\\">Loose clothing, a personal blanket if you prefer, and any props that help you feel supported. We provide bolsters and mats on request. For in-home or corporate bookings we can bring all necessary setup.</div>\\n\\n        <h3 style=\\\"margin-top:12px\\\">Contraindications</h3>\\n        <div style=\\\"color:var(--muted)\\\">Please notify us if participants have implants, heart conditions, are pregnant, have severe psychiatric conditions, or are sensitive to strong sound; sessions can be adapted.</div>\\n\\n      </section>\\n\\n      <aside class=\\\"card\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Facilitator</div>\\n            <div style=\\\"font-weight:700\\\">{{FACILITATOR_NAME}}</div>\\n            <div style=\\\"font-size:12px;color:var(--muted);margin-top:6px\\\">Available for in-studio and off-site bookings.</div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book Consultation</a>\\n          </div>\\n        </div>\\n\\n        <hr style=\\\"margin:12px 0;border:none;border-top:1px solid rgba(255,255,255,0.03)\\\">\\n\\n        <div style=\\\"margin-top:8px\\\">\\n          <div class=\\\"service\\\"><div style=\\\"display:flex;justify-content:space-between\\\"><div>1:1 Private Session</div><div class=\\\"fee\\\">$160</div></div><div style=\\\"color:var(--muted);font-size:13px;margin-top:6px\\\">Individual attention with personalized sound palette and follow-up notes.</div></div>\\n          <div class=\\\"service\\\"><div style=\\\"display:flex;justify-content:space-between\\\"><div>Couples Ceremony</div><div class=\\\"fee\\\">$260</div></div><div style=\\\"color:var(--muted);font-size:13px;margin-top:6px\\\">Designed to deepen connection and shared presence.</div></div>\\n          <div class=\\\"service\\\"><div style=\\\"display:flex;justify-content:space-between\\\"><div>Corporate Wellness</div><div class=\\\"fee\\\">From $520</div></div><div style=\\\"color:var(--muted);font-size:13px;margin-top:6px\\\">Short workshops or full group immersions — scalable and travel-ready.</div></div>\\n        </div>\\n\\n        <hr style=\\\"margin:12px 0;border:none;border-top:1px solid rgba(255,255,255,0.03)\\\">\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Custom packages, travel fees, and multi-session programs available on request. Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--gold);text-decoration:none\\\">{{EMAIL}}</a>.</div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card micro\\\">\\n      <h3 style=\\\"margin:0\\\">Micro-habits for private sessions</h3>\\n      <div style=\\\"color:var(--muted)\\\">Tiny shifts to make your session feel deeper and more sustainable.</div>\\n      <div style=\\\"display:flex;gap:10px;margin-top:10px;flex-wrap:wrap\\\">\\n        <div style=\\\"background:rgba(255,255,255,0.01);padding:10px;border-radius:8px;font-size:13px\\\">Set a 30-minute buffer before the session — avoid screens.</div>\\n        <div style=\\\"background:rgba(255,255,255,0.01);padding:10px;border-radius:8px;font-size:13px\\\">Plan a light, grounding meal afterward.</div>\\n        <div style=\\\"background:rgba(255,255,255,0.01);padding:10px;border-radius:8px;font-size:13px\\\">Bring an intention rather than expectations.</div>\\n      </div>\\n    </section>\\n\\n    <footer class=\\\"card\\\" style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <div style=\\\"font-weight:700\\\">Ready to design your session?</div>\\n        <div style=\\\"color:var(--muted);font-size:13px\\\">We’ll start with a short consult to align goals and logistics.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Schedule a Consult</a>\\n      </div>\\n    </footer>\\n\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Rates & Packages — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bgA:#061025;--panel:#081428;--accent:#9be7ff;--muted:#9fb3c7}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,Arial;background:linear-gradient(180deg,var(--bgA),#021024);color:#eaf8ff}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 24px}\\n    .logo{font-weight:800;padding:8px 12px;border-radius:8px;background:linear-gradient(90deg,#11203a,#2b1a4b)}\\n    nav a{color:var(--muted);margin-left:14px;text-decoration:none}\\n    main{max-width:1000px;margin:28px auto;padding:0 20px}\\n    .hero{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:22px;border-radius:12px}\\n    h1{margin:0 0 6px}\\n    p.lead{color:var(--muted)}\\n    .pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px}\\n    .plan{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .plan h3{margin:0 0 6px}\\n    .rate{font-size:20px;font-weight:800;color:var(--accent)}\\n    .features{color:var(--muted);margin-top:8px}\\n    .cta{display:inline-block;padding:10px 12px;border-radius:10px;background:linear-gradient(90deg,#89f7ff,#8b7bff);color:#012532;font-weight:800;text-decoration:none}\\n    .disclaimer{font-size:13px;color:var(--muted);margin-top:12px}\\n    footer{margin-top:20px;color:var(--muted);display:flex;justify-content:space-between}\\n    body::before{content:\\\"\\\";position:fixed;inset:0;z-index:-1;background-image:url('assets/img/pattern.svg');opacity:0.06;background-repeat:repeat}\\n    @media (max-width:880px){.pricing-grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n      <div style=\\\"color:var(--muted);font-size:13px\\\">Clear pricing for intentional sound work</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Overview</a>\\n      <a href=\\\"events.html\\\">Gatherings</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a class=\\\"active\\\" href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <h1>Transparent rates, thoughtful value</h1>\\n      <p class=\\\"lead\\\">We price to make deep relaxation accessible while supporting high-quality, curated facilitation and travel-ready setups for private events.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:16px\\\">\\n      <div class=\\\"pricing-grid\\\">\\n        <div class=\\\"plan\\\">\\n          <h3>Drop-in Group</h3>\\n          <div class=\\\"rate\\\">$35</div>\\n          <div class=\\\"features\\\">Includes shared sound bath (75 min). Bolsters and mats available onsite. Casual refunds up to 48 hours.</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Book a Seat</a></div>\\n        </div>\\n\\n        <div class=\\\"plan\\\">\\n          <h3>1:1 Private</h3>\\n          <div class=\\\"rate\\\">$160</div>\\n          <div class=\\\"features\\\">Tailored session (60–75 min). Pre-session consult and post-session integration tips. Instruments often used: singing bowls, tuning forks, kalimba for subtle melodic support.</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"private-sessions.html\\\">Request Private</a></div>\\n        </div>\\n\\n        <div class=\\\"plan\\\">\\n          <h3>Corporate & Group</h3>\\n          <div class=\\\"rate\\\">From $520</div>\\n          <div class=\\\"features\\\">On-site group experiences, workshops, and wellbeing days. Price varies by travel, headcount, and duration. Instrument palette adaptable: monochord, gongs, chimes, and soft electronics for larger rooms.</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"contact.html\\\">Get a Quote</a></div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card\\\" style=\\\"margin-top:14px;padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)\\\">\\n        <h4 style=\\\"margin:0 0 8px\\\">Packages & memberships</h4>\\n        <div style=\\\"color:var(--muted)\\\">Multi-session packages and monthly memberships available for regular participants — email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a> for details. Discounts for students and healthcare workers on request.</div>\\n      </div>\\n\\n      <div style=\\\"margin-top:14px\\\" class=\\\"card\\\">\\n        <h4 style=\\\"margin:0 0 8px\\\">Safety note & contraindications</h4>\\n        <p class=\\\"disclaimer\\\">Sound exposure is generally safe. Please consult before booking if you have epilepsy, a heart pacemaker, are in early pregnancy, or experience intense psychiatric symptoms. We adapt sessions; participant safety is primary.</p>\\n      </div>\\n\\n    </section>\\n\\n    <footer>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">Questions?</div>\\n        <div style=\\\"color:var(--muted);font-size:13px\\\">Call <strong style=\\\"color:#fff\\\">{{PHONE}}</strong> or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a></div>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Book Now</a>\\n      </div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
