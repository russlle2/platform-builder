          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f1113;--card:#0f1720;--muted:#9aa6b2;--accent1:#8be3d6;--accent2:#7f8cff}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:#e6eef3;background:linear-gradient(180deg,var(--bg),#071019);}\\n    .wrap{max-width:900px;margin:48px auto;padding:40px;border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);box-shadow:0 6px 30px rgba(2,6,14,0.6);position:relative;overflow:hidden}\\n    header{display:flex;align-items:center;gap:18px;margin-bottom:28px}\\n    .mark{width:68px;height:68px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--accent1),var(--accent2));box-shadow:0 6px 20px rgba(127,140,255,0.12);font-weight:700;color:#071019}\\n    h1{font-size:clamp(20px,3.6vw,32px);margin:0}\\n    p.lead{color:var(--muted);margin:6px 0 0;font-size:14px}\\n    nav{display:flex;gap:14px;margin-top:18px}\\n    nav a{color:rgba(230,238,243,0.85);text-decoration:none;padding:8px 12px;border-radius:10px;font-size:13px}\\n    nav a:hover{background:rgba(255,255,255,0.02)}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:28px;margin-top:20px}\\n    .card{background:rgba(255,255,255,0.02);padding:20px;border-radius:12px}\\n    .small{font-size:13px;color:var(--muted)}\\n    .bio{line-height:1.6;color:#dfeef6}\\n    ul.instruments{list-style:none;padding:0;margin:12px 0 0;display:flex;flex-wrap:wrap;gap:8px}\\n    ul.instruments li{background:linear-gradient(90deg,rgba(255,255,255,0.02),transparent);padding:8px 10px;border-radius:8px;font-size:13px;color:var(--muted)}\\n    .cta{display:inline-block;margin-top:12px;background:linear-gradient(90deg,var(--accent1),var(--accent2));color:#071019;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:600}\\n    footer.note{margin-top:22px;color:var(--muted);font-size:13px}\\n    /* subtle SVG wave */\\n    .pattern{position:absolute;inset:0;pointer-events:none;opacity:0.12}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr;}.wrap{margin:24px;padding:20px}.mark{width:54px;height:54px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <svg class=\\\"pattern\\\" viewBox=\\\"0 0 800 600\\\" preserveAspectRatio=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#8be3d6\\\" stop-opacity=\\\"0.18\\\"/>\\n          <stop offset=\\\"1\\\" stop-color=\\\"#7f8cff\\\" stop-opacity=\\\"0.16\\\"/>\\n        </linearGradient>\\n        <filter id=\\\"blur\\\"><feGaussianBlur stdDeviation=\\\"30\\\"/></filter>\\n      </defs>\\n      <g filter=\\\"url(#blur)\\\">\\n        <ellipse cx=\\\"200\\\" cy=\\\"120\\\" rx=\\\"220\\\" ry=\\\"80\\\" fill=\\\"url(#g1)\\\" />\\n        <ellipse cx=\\\"620\\\" cy=\\\"420\\\" rx=\\\"260\\\" ry=\\\"90\\\" fill=\\\"#7f8cff\\\" opacity=\\\"0.06\\\" />\\n      </g>\\n      <path d=\\\"M0 480 C120 380 220 420 400 360 C580 300 700 360 800 300 L800 600 L0 600 Z\\\" fill=\\\"#071019\\\" opacity=\\\"0.6\\\"/>\\n    </svg>\\n\\n    <header>\\n      <div class=\\\"mark\\\">SB</div>\\n      <div>\\n        <h1>About {{BUSINESS_NAME}}</h1>\\n        <p class=\\\"lead\\\">A deliberate stillness: {{TAGLINE}}</p>\\n        <nav>\\n          <a href=\\\"index.html\\\">Gather</a>\\n          <a href=\\\"events.html\\\">Offerings</a>\\n          <a href=\\\"book.html\\\">Reserve</a>\\n          <a href=\\\"contact.html\\\">Reach</a>\\n        </nav>\\n      </div>\\n    </header>\\n\\n    <div class=\\\"grid\\\">\\n      <main>\\n        <section class=\\\"card\\\">\\n          <h2 style=\\\"margin:0 0 8px\\\">Our approach</h2>\\n          <p class=\\\"bio\\\">We hold sound as a subtle architecture. In each session the field is shaped with intention — vibration becomes a map, and the body is invited to read it. Sessions are crafted for spaciousness, with attention to breath, rest and safety. Facilitated by {{FACILITATOR_NAME}}, our gatherings blend ritual and gentle technique to support relaxation, nervous-system regulation and creative clarity.</p>\\n        </section>\\n\\n        <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">The flow of a typical gathering</h3>\\n          <ol class=\\\"small\\\" style=\\\"padding-left:18px;margin:0;color:var(--muted);line-height:1.7\\\">\\n            <li>Arrival, soft tea & grounding (10–15 min)</li>\\n            <li>Short orientation & intention setting (5–10 min)</li>\\n            <li>Guided breath & progressive rest (8–10 min)</li>\\n            <li>Main sound immersion: layered bowls & resonant textures (30–40 min)</li>\\n            <li>Gentle return and integration (10–12 min)</li>\\n          </ol>\\n          <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">Every event includes time for quiet after the sound so you can settle before moving on.</p>\\n        </section>\\n\\n        <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">Instruments we favor</h3>\\n          <p class=\\\"small\\\">An evolving palette — each set is chosen for timbral balance and depth.</p>\\n          <ul class=\\\"instruments\\\">\\n            <li>Crystal singing bowls</li>\\n            <li>Gong (soft, bowed textures)</li>\\n            <li>Tuning forks</li>\\n            <li>Monochord</li>\\n            <li>Wind chimes</li>\\n          </ul>\\n        </section>\\n\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Practical — what to bring</h4>\\n          <p class=\\\"small\\\">Comfort matters. Bring: a yoga mat or blanket, a pillow, socks, and a light cover. We provide mats and bolsters on request.</p>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Safety & contraindications</h4>\\n          <p class=\\\"small\\\">Sound immersion is gentle but not suitable for everyone. Please consult us before attending if you are pregnant, have a recent head injury, seizures, are sensitive to sustained vibration, or have implanted medical devices. Our sessions are not a substitute for medical care.</p>\\n          <p class=\\\"small\\\">Questions? Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent1);text-decoration:none\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent1);text-decoration:none\\\">{{EMAIL}}</a>.</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Location</h4>\\n          <p class=\\\"small\\\">Sessions are held at <strong>{{VENUE_NAME}}</strong>, {{CITY}}, {{STATE}}. Arrive 10 minutes early to settle.</p>\\n        </div>\\n\\n      </aside>\\n    </div>\\n\\n    <footer class=\\\"note\\\">Facilitation by {{FACILITATOR_NAME}} • To reserve a spot, <a href=\\\"book.html\\\" style=\\\"color:var(--accent2);text-decoration:none\\\">book here</a>.</footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>FAQ — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#061016;--panel:#0b1320;--muted:#9fb2bd;--accent:#7f8cff}\\n    body{margin:0;background:radial-gradient(circle at 10% 10%,#08232b 0%,var(--bg) 40%),linear-gradient(180deg,#061018,#031018);font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;color:#e7f3fb}\\n    .site{max-width:920px;margin:40px auto;padding:28px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:12px;position:relative;overflow:hidden}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    header h1{font-size:22px;margin:0}\\n    header nav a{color:rgba(231,243,251,0.9);text-decoration:none;margin-left:12px;font-size:14px}\\n    .hero{display:flex;gap:18px;margin-top:16px}\\n    .hero .lead{flex:1;color:var(--muted);line-height:1.6}\\n    .panel{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:10px}\\n    .q{margin:0 0 12px}\\n    .q h3{margin:0;font-size:15px}\\n    .a{color:var(--muted);margin:6px 0 12px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    .contact{font-size:13px;color:var(--muted)}\\n    .pattern{position:absolute;right:-80px;top:-60px;opacity:0.08}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <svg class=\\\"pattern\\\" width=\\\"420\\\" height=\\\"420\\\" viewBox=\\\"0 0 420 420\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"pg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#7f8cff\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#8be3d6\\\"/></linearGradient>\\n      </defs>\\n      <circle cx=\\\"210\\\" cy=\\\"210\\\" r=\\\"160\\\" fill=\\\"url(#pg)\\\" />\\n      <g fill=\\\"#071019\\\" opacity=\\\"0.14\\\"><circle cx=\\\"190\\\" cy=\\\"190\\\" r=\\\"120\\\"/><circle cx=\\\"230\\\" cy=\\\"230\\\" r=\\\"120\\\"/></g>\\n    </svg>\\n\\n    <header>\\n      <h1>Questions & answers — {{BUSINESS_NAME}}</h1>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Events</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"hero\\\">\\n      <div class=\\\"lead\\\">\\n        <p style=\\\"margin:0;color:var(--muted)\\\">Below are the common queries that come as people choose to experience a sound bath. If yours isn't listed, reach out — we reply personally.</p>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"grid\\\">\\n      <main>\\n        <section class=\\\"panel\\\">\\n          <div class=\\\"q\\\">\\n            <h3>What should I bring?</h3>\\n            <p class=\\\"a\\\">Comfort items: a mat or blanket, pillow, cozy socks, and a light shawl. We have some mats; request one when you book. Hydration is encouraged before and after sessions.</p>\\n          </div>\\n\\n          <div class=\\\"q\\\">\\n            <h3>How long is a typical session?</h3>\\n            <p class=\\\"a\\\">Group events run roughly 65–75 minutes including settling and integration. Private sessions vary by package — see booking options.</p>\\n          </div>\\n\\n          <div class=\\\"q\\\">\\n            <h3>Is it safe?</h3>\\n            <p class=\\\"a\\\">Generally yes. Contraindications include recent head trauma, pregnancy in early stages without clearance, photosensitive epilepsy, and implanted medical electronics. If unsure, consult your healthcare provider; contact us first for guidance.</p>\\n          </div>\\n\\n          <div class=\\\"q\\\">\\n            <h3>Do I need prior experience?</h3>\\n            <p class=\\\"a\\\">No. The work is accessible: lie back, breathe, and be held by sound. Facilitated cues guide you through the session.</p>\\n          </div>\\n\\n          <div class=\\\"q\\\">\\n            <h3>What instruments are used?</h3>\\n            <p class=\\\"a\\\">We curate a textured sound environment. Typical instruments include crystal bowls, a soft gong, monochord, and bowed instruments. Each event has a unique palette.</p>\\n          </div>\\n\\n          <div class=\\\"q\\\">\\n            <h3>Will I fall asleep?</h3>\\n            <p class=\\\"a\\\">Many do sleep; some have profound restful awareness without sleep. Both responses are welcomed and integrated.</p>\\n          </div>\\n\\n        </section>\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"panel contact\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Before you attend</h4>\\n          <p style=\\\"margin:0 0 8px;color:var(--muted)\\\">Avoid heavy meals right before the session. If you use hearing aids or have concerns about vibration, contact us so we can adapt the experience.</p>\\n          <h4 style=\\\"margin:12px 0 6px\\\">Pricing & booking</h4>\\n          <p style=\\\"margin:0;color:var(--muted)\\\">See general rates on the pricing page or reserve directly: <a href=\\\"book.html\\\" style=\\\"color:var(--accent);text-decoration:none\\\">Reserve a space</a>.</p>\\n          <h4 style=\\\"margin:12px 0 6px\\\">Contact</h4>\\n          <p style=\\\"margin:0;color:var(--muted)\\\">Phone: <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{PHONE}}</a><br>Email: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a></p>\\n          <p style=\\\"margin-top:10px;color:var(--muted);font-size:13px\\\">We host in {{CITY}}, {{STATE}}. For private bookings, see private-sessions.html.</p>\\n        </div>\\n      </aside>\\n    </div>\\n\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#041018;--card:#071422;--muted:#9cc7c0;--accent:#8be3d6}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;color:#eaf7f4;background:linear-gradient(180deg,var(--bg),#021016);}\\n    .container{max-width:860px;margin:36px auto;padding:28px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:12px;position:relative}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    nav a{color:rgba(234,247,244,0.88);text-decoration:none;margin-left:12px;font-size:13px}\\n    h1{margin:6px 0 0;font-size:22px}\\n    .sub{color:var(--muted);font-size:14px;margin-top:8px}\\n    .split{display:grid;grid-template-columns:1fr 300px;gap:18px;margin-top:18px}\\n    .card{background:rgba(255,255,255,0.02);padding:16px;border-radius:10px}\\n    .pkg{display:flex;flex-direction:column;gap:10px}\\n    .pkg button{background:linear-gradient(90deg,var(--accent),#7f8cff);border:none;color:#021016;padding:10px;border-radius:10px;font-weight:700;cursor:pointer}\\n    label{display:block;margin-top:10px;font-size:13px;color:var(--muted)}\\n    input,select,textarea{margin-top:6px;padding:10px;border-radius:8px;border:none;background:#081620;color:#eaf7f4;width:100%;box-sizing:border-box}\\n    .note{font-size:12px;color:var(--muted);margin-top:8px}\\n    .cta{display:inline-block;margin-top:12px;background:linear-gradient(90deg,var(--accent),#7f8cff);color:#021016;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .pattern{position:absolute;left:-80px;top:-40px;opacity:0.08}\\n    @media(max-width:880px){.split{grid-template-columns:1fr}.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <svg class=\\\"pattern\\\" width=\\\"360\\\" height=\\\"360\\\" viewBox=\\\"0 0 360 360\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"b1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#8be3d6\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#7f8cff\\\"/></linearGradient>\\n        <filter id=\\\"g2\\\"><feTurbulence baseFrequency=\\\"0.6\\\" numOctaves=\\\"1\\\" result=\\\"noise\\\"/><feColorMatrix type=\\\"saturate\\\" values=\\\"0\\\"/></filter>\\n      </defs>\\n      <rect width=\\\"360\\\" height=\\\"360\\\" rx=\\\"20\\\" fill=\\\"url(#b1)\\\" opacity=\\\"0.12\\\"/>\\n      <g opacity=\\\"0.06\\\"><path d=\\\"M0 180 C80 120 140 220 360 120 L360 360 L0 360 Z\\\" fill=\\\"#071019\\\"/></g>\\n    </svg>\\n\\n    <header>\\n      <div>\\n        <h1>Reserve a place</h1>\\n        <div class=\\\"sub\\\">Choose a group session, private package, or request a tailored experience.</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Events</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"split\\\">\\n      <main>\\n        <section class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">Next available</h3>\\n          <p class=\\\"note\\\">Upcoming group gathering: <strong>{{NEXT_EVENT_DATE}}</strong>. Reserve now to hold your spot.</p>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <h4 style=\\\"margin:0 0 8px\\\">Private sessions — options</h4>\\n            <div class=\\\"pkg\\\">\\n              <div class=\\\"card\\\" style=\\\"background:rgba(255,255,255,0.01);padding:12px\\\">\\n                <strong>1:1 Private Session</strong>\\n                <div class=\\\"note\\\">A focused one-to-one, 60 or 90 minutes. Personalized sound prescription.</div>\\n                <button type=\\\"button\\\">Book 60 min</button>\\n              </div>\\n              <div class=\\\"card\\\" style=\\\"background:rgba(255,255,255,0.01);padding:12px\\\">\\n                <strong>Couples / Shared</strong>\\n                <div class=\\\"note\\\">Shared restorative session for two, gentle and intimate.</div>\\n                <button type=\\\"button\\\">Enquire</button>\\n              </div>\\n              <div class=\\\"card\\\" style=\\\"background:rgba(255,255,255,0.01);padding:12px\\\">\\n                <strong>Corporate wellness</strong>\\n                <div class=\\\"note\\\">Tailored group offerings for teams: in-person facilitation or hybrid.</div>\\n                <button type=\\\"button\\\">Contact us</button>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:14px\\\" class=\\\"card\\\">\\n            <h4 style=\\\"margin:0 0 8px\\\">Flow — what to expect</h4>\\n            <ol class=\\\"note\\\" style=\\\"padding-left:18px;margin:0;line-height:1.6;color:var(--muted)\\\">\\n              <li>Arrival & gentle orientation (10 min)</li>\\n              <li>Guided breathing & rest (8–12 min)</li>\\n              <li>Main sonic immersion: layered instruments (25–45 min)</li>\\n              <li>Return, time to integrate and hydrate (10 min)</li>\\n            </ol>\\n            <p class=\\\"note\\\">Bring layers and anything that supports comfort; avoid heavy fragrances.</p>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\" class=\\\"card\\\">\\n            <h4 style=\\\"margin:0 0 8px\\\">Contraindications & safety</h4>\\n            <p class=\\\"note\\\">If you have a pacemaker, are pregnant, have a recent concussion, seizures, or are sensitive to sustained vibration, contact us before booking. We prioritize safety and can adapt where possible.</p>\\n          </div>\\n        </section>\\n\\n        <section style=\\\"margin-top:12px\\\" class=\\\"card\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">What to bring</h4>\\n          <ul class=\\\"note\\\" style=\\\"padding-left:18px;margin:0;line-height:1.6;color:var(--muted)\\\">\\n            <li>Yoga mat or blanket</li>\\n            <li>Pillow or bolster</li>\\n            <li>Warm socks and a shawl/cover</li>\\n            <li>Water bottle</li>\\n          </ul>\\n        </section>\\n\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Reserve now</h4>\\n          <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\">\\n            <label>Name<input name=\\\"name\\\" required></label>\\n            <label>Email<input name=\\\"email\\\" type=\\\"email\\\" required></label>\\n            <label>Phone<input name=\\\"phone\\\" type=\\\"tel\\\"></label>\\n            <label>Type of booking\\n              <select name=\\\"type\\\">\\n                <option>Group event</option>\\n                <option>1:1 private session</option>\\n                <option>Couples</option>\\n                <option>Corporate</option>\\n              </select>\\n            </label>\\n            <label>Preferred date / notes\\n              <textarea name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"If booking private, add details\\\"></textarea>\\n            </label>\\n\\n            <p class=\\\"note\\\">By submitting you confirm you have read the safety guidelines and agree to our cancellation policy below.</p>\\n\\n            <button class=\\\"cta\\\" type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n          </form>\\n\\n          <div style=\\\"margin-top:12px\\\" class=\\\"note\\\">\\n            <strong>Cancellation</strong>: Please notify us 72 hours in advance for a full refund. Late cancellations may incur a fee. For private bookings, contact us directly.<br>\\n            Questions: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Location & logistics</h4>\\n          <p class=\\\"note\\\">Sessions held at {{VENUE_NAME}}, {{CITY}}. Please arrive 10 minutes early to settle so we begin on time.</p>\\n        </div>\\n\\n      </aside>\\n    </div>\\n\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
