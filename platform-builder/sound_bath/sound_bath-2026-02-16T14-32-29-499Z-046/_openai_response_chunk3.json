          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0b0710;--card:#0f1220;--accent:#a27cff;--muted:#bfc8de;--glass:rgba(255,255,255,0.04)}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue';background:radial-gradient(1200px 600px at 10% 10%, rgba(162,124,255,0.08), transparent), linear-gradient(180deg,#05030a 0%, #0e0814 100%);color:var(--muted);}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:28px 34px;background:linear-gradient(90deg,rgba(255,255,255,0.02),transparent);backdrop-filter: blur(6px);}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:54px;height:54px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#5be7ff);display:grid;place-items:center;color:#0b0710;font-weight:800;font-size:18px}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 12px;font-weight:600}\\n    nav a.cta{background:linear-gradient(90deg,var(--accent),#5be7ff);padding:10px 14px;border-radius:10px;color:#07040a}\\n    main{max-width:1100px;margin:36px auto;padding:28px;border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);box-shadow:0 6px 30px rgba(2,2,10,0.6);}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    h1{margin:0;color:#fff;font-size:34px;letter-spacing:0.2px}\\n    p.lead{color:rgba(255,255,255,0.85);margin-top:10px}\\n    .panel{background:var(--card);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .ribbon{display:flex;gap:10px;align-items:center;font-weight:700}\\n    .ribbon .dot{width:10px;height:10px;border-radius:50%;background:var(--accent);box-shadow:0 0 14px rgba(162,124,255,0.22)}\\n    .columns{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:20px}\\n    .bio{line-height:1.6;color:var(--muted)}\\n    .instruments{display:flex;flex-direction:column;gap:8px;margin-top:12px}\\n    .chip{display:inline-block;background:var(--glass);padding:8px 12px;border-radius:999px;font-weight:700;color:#e9e7ff}\\n    footer{display:flex;justify-content:space-between;padding:24px 34px;color:rgba(255,255,255,0.6)}\\n    .pattern{position:fixed;inset:0;opacity:0.06;pointer-events:none;background-image:url('/assets/img/pattern.svg');background-repeat:repeat;mix-blend-mode:color-dodge}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr}.columns{grid-template-columns:1fr}.panel{padding:14px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern\\\" aria-hidden=\\\"true\\\"></div>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">SB</div>\\n      <div>\\n        <div style=\\\"font-weight:800;color:#fff\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"/index.html\\\">Gatherings</a>\\n      <a href=\\\"/events.html\\\">Upcoming</a>\\n      <a href=\\\"/pricing.html\\\">Rates</a>\\n      <a href=\\\"/about.html\\\">Our Story</a>\\n      <a href=\\\"/contact.html\\\" class=\\\"cta\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <div class=\\\"ribbon\\\"><span class=\\\"dot\\\"></span>premium sound baths — small groups</div>\\n        <h1>We craft gentle sound journeys for deep rest.</h1>\\n        <p class=\\\"lead\\\">A curated offering of tone, silence, and guided breath. Sessions are intentionally small, sensory-forward, and designed to leave you restored — a modern ritual with ancient instruments.</p>\\n        <div style=\\\"margin-top:18px;display:flex;gap:12px\\\">\\n          <a href=\\\"/book.html\\\" class=\\\"cta\\\" style=\\\"padding:12px 16px;border-radius:12px;text-decoration:none\\\">Book a Seat</a>\\n          <a href=\\\"/events.html\\\" style=\\\"padding:12px 16px;border-radius:12px;background:transparent;border:1px solid rgba(255,255,255,0.04);text-decoration:none;color:var(--muted)\\\">See Events</a>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"panel\\\">\\n        <div style=\\\"font-size:13px;color:var(--muted);\\\">Next gathering</div>\\n        <div style=\\\"font-weight:800;color:#fff;margin-top:8px\\\">{{NEXT_EVENT_DATE}}</div>\\n        <div style=\\\"margin-top:12px;color:var(--muted);font-size:13px\\\">Intimate setting at {{VENUE_NAME}} in {{CITY}}, {{STATE}}. Doors open 20 minutes beforehand for grounding tea and settling in.</div>\\n      </aside>\\n    </section>\\n\\n    <div class=\\\"columns\\\">\\n      <article>\\n        <div class=\\\"panel\\\">\\n          <h2 style=\\\"color:white;margin:0\\\">How the ritual unfolds</h2>\\n          <p class=\\\"bio\\\" style=\\\"margin-top:12px\\\">We begin with a brief grounding — a guided breath and intention-setting. The sound journey moves slowly: sustained crystal bowls, a gentle monochord drone, and chiming textures weave into long spaces of silence. The facilitator fades and returns, shaping dynamics to invite nervous system downshift. After the soundscape we allow a soft return with quiet tea and optional sharing.</p>\\n          <h3 style=\\\"color:#fff;margin-top:14px\\\">Session flow</h3>\\n          <ol style=\\\"color:var(--muted);line-height:1.8\\\">\\n            <li>Arrival &amp; welcome (grounding tea)</li>\\n            <li>Brief intention &amp; breath practice</li>\\n            <li>Sound immersion (45–60 minutes)</li>\\n            <li>Silent integration (5–10 minutes)</li>\\n            <li>Gentle closing &amp; optional sharing</li>\\n          </ol>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:16px\\\">\\n          <h3 style=\\\"color:#fff;margin:0\\\">What to bring</h3>\\n          <ul style=\\\"color:var(--muted);margin-top:12px;line-height:1.8\\\">\\n            <li>Yoga mat, blanket, pillow for comfort</li>\\n            <li>Eye mask or scarf to block light</li>\\n            <li>Water bottle; we provide herbal tea</li>\\n            <li>Wear layered, comfortable clothing</li>\\n          </ul>\\n          <p style=\\\"margin-top:12px;color:#f0e6ff;font-size:13px\\\"><strong>Contraindications:</strong> If you have a pacemaker, recent surgery, are pregnant in your first trimester, or have epilepsy triggered by rhythmic sound, please consult your physician and contact us before booking.</p>\\n        </div>\\n      </article>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <h3 style=\\\"margin:0;color:#fff\\\">Meet the facilitator</h3>\\n          <p style=\\\"color:var(--muted);margin-top:12px\\\">{{FACILITATOR_NAME}} combines somatic training with deep listening. Sessions draw on vibration therapy and contemplative techniques to support nervous system regulation.</p>\\n          <div style=\\\"margin-top:14px\\\">\\n            <div class=\\\"chip\\\">Crystal bowls</div>\\n            <div class=\\\"chip\\\" style=\\\"margin-left:8px\\\">Monochord</div>\\n            <div class=\\\"chip\\\" style=\\\"margin-left:8px\\\">Chimes</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:16px\\\">\\n          <h4 style=\\\"color:#fff;margin:0\\\">Private and corporate</h4>\\n          <p style=\\\"color:var(--muted);margin-top:10px\\\">We offer 1:1 sessions and bespoke sound baths for retreats, teams, and couples. See our private offerings page for options and pricing.</p>\\n          <a href=\\\"/private-sessions.html\\\" style=\\\"display:inline-block;margin-top:12px;padding:10px 12px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#5be7ff);color:#07040a;text-decoration:none;font-weight:700\\\">Explore Private</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n  </main>\\n  <footer>\\n    <div>&copy; {{BUSINESS_NAME}} — offering restorative sound in {{CITY}}, {{STATE}}</div>\\n    <div>Questions? <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>FAQ — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#080617;--card:#0f1630;--accent:#6ee7d2;--muted:#d0d8ee}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto; background:linear-gradient(180deg,#050313 0%,#071027 100%);color:var(--muted)}\\n    .wrap{max-width:980px;margin:36px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}\\n    header a{color:var(--muted);text-decoration:none;margin-left:14px}\\n    h1{color:#fff;margin:6px 0}\\n    .intro{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:18px}\\n    .panel{background:rgba(255,255,255,0.02);padding:18px;border-radius:12px}\\n    details{background:transparent;padding:12px;border-radius:10px;margin-bottom:10px;border:1px solid rgba(255,255,255,0.03)}\\n    summary{font-weight:700;cursor:pointer;color:#fff}\\n    p,li{color:var(--muted)}\\n    .aside{position:sticky;top:28px}\\n    .note{padding:12px;border-radius:10px;background:linear-gradient(90deg,rgba(110,231,210,0.06),transparent);border:1px solid rgba(110,231,210,0.06);color:var(--muted)}\\n    .pattern{position:fixed;inset:0;opacity:0.05;pointer-events:none;background-image:url('/assets/img/pattern.svg');background-repeat:repeat}\\n    @media(max-width:920px){.grid{grid-template-columns:1fr}.aside{position:relative}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern\\\" aria-hidden=\\\"true\\\"></div>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <a href=\\\"/index.html\\\" style=\\\"font-weight:800;color:white\\\">{{BUSINESS_NAME}}</a>\\n        <span style=\\\"color:var(--muted);margin-left:8px\\\">— questions answered</span>\\n      </div>\\n      <nav>\\n        <a href=\\\"/events.html\\\">Events</a>\\n        <a href=\\\"/book.html\\\">Reserve</a>\\n        <a href=\\\"/contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"intro\\\">\\n      <h1>Common questions about our sound offerings</h1>\\n      <p style=\\\"margin-top:8px\\\">Short, clear answers for a calm booking experience. If you don't see your question, reach out at <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</p>\\n    </section>\\n\\n    <div class=\\\"grid\\\">\\n      <main>\\n        <div class=\\\"panel\\\">\\n          <details open>\\n            <summary>What does a typical session feel like?</summary>\\n            <p style=\\\"margin-top:8px\\\">Expect a spacious, slow-moving sound field. This session leans into metallic resonance: tuned gongs, Koshi chimes, and tuning forks create layering of tones and microharmonics. You'll lie comfortably as sound pulses and long sustains encourage breath lengthening and softening of the nervous system.</p>\\n          </details>\\n\\n          <details>\\n            <summary>How should I prepare and what should I bring?</summary>\\n            <p style=\\\"margin-top:8px\\\">Bring a yoga mat, a few blankets, a neck pillow, and an eye covering. We recommend layers since temperature preferences vary. Avoid heavy meals right before. Hydrate beforehand and plan for a gentle return to activity after the session.</p>\\n          </details>\\n\\n          <details>\\n            <summary>Are sound baths safe for everyone?</summary>\\n            <p style=\\\"margin-top:8px\\\"><strong>Contraindications:</strong> If you use a pacemaker, have a history of photosensitive epilepsy, are in early pregnancy, or recently had major surgery, please consult your doctor and contact us before booking. Some participants with severe tinnitus or Meniere's disease should approach carefully — we can modify exposure.</p>\\n          </details>\\n\\n          <details>\\n            <summary>What if I fall asleep?</summary>\\n            <p style=\\\"margin-top:8px\\\">Sleeping is a sign your system relaxed — it's welcome. We design sequences to be non-invasive so those who sleep still benefit from auditory entrainment and integration afterward.</p>\\n          </details>\\n\\n          <details>\\n            <summary>Do you accept walk-ins?</summary>\\n            <p style=\\\"margin-top:8px\\\">We maintain intimate capacities. Walk-ins are rare; we recommend reserving online. If space allows we may offer last-minute openings 15 minutes before start.</p>\\n          </details>\\n\\n          <details>\\n            <summary>Can I request a private or corporate session?</summary>\\n            <p style=\\\"margin-top:8px\\\">Yes. We offer 1:1 sessions, couple's baths, and workplace sound rituals. Pricing varies with travel and customization. Use the contact page for a tailored quote.</p>\\n          </details>\\n\\n          <details>\\n            <summary>What about accessibility?</summary>\\n            <p style=\\\"margin-top:8px\\\">Our venues aim to be accessible. Please note mobility needs in your booking so we can reserve a suitable space. If stairs are involved we will arrange assistance where possible.</p>\\n          </details>\\n\\n          <details>\\n            <summary>How far in advance should I arrive?</summary>\\n            <p style=\\\"margin-top:8px\\\">Arrive 15–20 minutes early to settle, enjoy tea, and set your intention. Late arrivals may not be admitted once the sound begins to minimize disruption to others.</p>\\n          </details>\\n\\n          <details>\\n            <summary>How do refunds and cancellations work?</summary>\\n            <p style=\\\"margin-top:8px\\\">Full refunds are available up to 72 hours before the event. Cancellations inside 72 hours may be offered a credit. Please see our pricing page for full policy details or contact us directly.</p>\\n          </details>\\n\\n          <details>\\n            <summary>What instruments do you use?</summary>\\n            <p style=\\\"margin-top:8px\\\">Our instrument palette rotates. Typical selections include tuning forks, a deep gong, Koshi chimes, and Himalayan singing bowls. Each facilitator curates texture to support the intention of the gathering.</p>\\n          </details>\\n        </div>\\n      </main>\\n\\n      <aside class=\\\"aside\\\">\\n        <div class=\\\"note panel\\\">\\n          <h4 style=\\\"margin:0;color:#fff\\\">Quick guidance</h4>\\n          <ul style=\\\"margin-top:10px;color:var(--muted)\\\">\\n            <li>Wear layered, comfortable clothing</li>\\n            <li>We provide tea and basic mats on request</li>\\n            <li>Ask about private sessions for groups or team wellness</li>\\n          </ul>\\n          <div style=\\\"margin-top:12px\\\">\\n            <a href=\\\"/book.html\\\" style=\\\"display:inline-block;padding:10px 12px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#8bd6ff);color:#041024;text-decoration:none;font-weight:700\\\">Reserve Now</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0;color:#fff\\\">Contact</h4>\\n          <p style=\\\"margin-top:10px;color:var(--muted)\\\">Questions? Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a> or <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a>.</p>\\n        </div>\\n      </aside>\\n    </div>\\n\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book a Session — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#04101a;--panel:#0b1322;--accent:#ffd36b;--muted:#e6f0ff}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto;background:linear-gradient(180deg,#02030b 0%,#071627 100%);color:var(--muted)}\\n    .wrap{max-width:920px;margin:36px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    header a{color:var(--muted);text-decoration:none;margin-left:14px}\\n    h1{color:#fff;margin:6px 0}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:20px}\\n    form{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:14px}\\n    label{display:block;font-weight:700;margin-top:12px;color:#fff}\\n    input,select,textarea{width:100%;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:var(--muted);margin-top:6px}\\n    .addons{display:flex;flex-direction:column;gap:8px;margin-top:12px}\\n    .btn{display:inline-block;padding:12px 14px;border-radius:12px;background:linear-gradient(90deg,var(--accent),#ff9b6b);color:#071020;font-weight:800;text-decoration:none;margin-top:14px}\\n    .panel{background:rgba(255,255,255,0.02);padding:16px;border-radius:12px}\\n    .pattern{position:fixed;inset:0;opacity:0.05;pointer-events:none;background-image:url('/assets/img/pattern.svg');background-repeat:repeat}\\n    .small{font-size:13px;color:var(--muted)}\\n    @media(max-width:920px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern\\\" aria-hidden=\\\"true\\\"></div>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <a href=\\\"/index.html\\\" style=\\\"font-weight:800;color:white\\\">{{BUSINESS_NAME}}</a>\\n        <span style=\\\"color:var(--muted);margin-left:8px\\\">— reserve your place</span>\\n      </div>\\n      <nav>\\n        <a href=\\\"/events.html\\\">Events</a>\\n        <a href=\\\"/pricing.html\\\">Pricing</a>\\n      </nav>\\n    </header>\\n\\n    <h1>Book a session</h1>\\n    <p class=\\\"small\\\">Select an option below. For group and corporate requests, choose \\\"Private\\\" and we'll follow up to arrange logistics.</p>\\n\\n    <div class=\\\"grid\\\">\\n      <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" onsubmit=\\\"return validateForm();\\\">\\n        <label for=\\\"type\\\">Session type</label>\\n        <select id=\\\"type\\\" name=\\\"type\\\" required>\\n          <option value=\\\"group\\\">Group Sound Bath (shared)</option>\\n          <option value=\\\"private\\\">Private 1:1</option>\\n          <option value=\\\"couple\\\">Couples</option>\\n          <option value=\\\"corporate\\\">Corporate / Team</option>\\n        </select>\\n\\n        <label for=\\\"date\\\">Preferred date</label>\\n        <input id=\\\"date\\\" name=\\\"date\\\" type=\\\"date\\\" value=\\\"{{NEXT_EVENT_DATE}}\\\" required>\\n\\n        <label for=\\\"attendees\\\">Number of attendees</label>\\n        <input id=\\\"attendees\\\" name=\\\"attendees\\\" type=\\\"number\\\" min=\\\"1\\\" max=\\\"50\\\" value=\\\"1\\\">\\n\\n        <label for=\\\"name\\\">Your name</label>\\n        <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"First &amp; last\\\" required>\\n\\n        <label for=\\\"email\\\">Email</label>\\n        <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n\\n        <label for=\\\"phone\\\">Phone (optional)</label>\\n        <input id=\\\"phone\\\" name=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"{{PHONE}}\\\">\\n\\n        <div class=\\\"addons\\\">\\n          <label class=\\\"small\\\" style=\\\"font-weight:800\\\">Add-ons</label>\\n          <label style=\\\"font-weight:600\\\"><input type=\\\"checkbox\\\" name=\\\"addon_crystal\\\" value=\\\"crystal_kit\\\"> Retail: travel crystal kit (+$28)</label>\\n          <label style=\\\"font-weight:600\\\"><input type=\\\"checkbox\\\" name=\\\"addon_mats\\\" value=\\\"mats\\\"> Rent: premium mat &amp; blanket (+$12 per person)</label>\\n        </div>\\n\\n        <label for=\\\"notes\\\">Any notes or contraindications to share?</label>\\n        <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Please tell us about pregnancy, pacemaker, epilepsy, or anything else.\\\"></textarea>\\n\\n        <label style=\\\"margin-top:12px\\\"><input type=\\\"checkbox\\\" name=\\\"agree\\\" id=\\\"agree\\\" required> I acknowledge the contraindications and will notify the facilitator of any relevant medical condition.</label>\\n\\n        <button type=\\\"submit\\\" class=\\\"btn\\\">Complete Reservation</button>\\n        <p class=\\\"small\\\" style=\\\"margin-top:10px\\\">Payments are handled securely after we confirm capacity. You will receive a confirmation email at <strong>{{EMAIL}}</strong> with arrival details.</p>\\n      </form>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <h3 style=\\\"margin:0;color:#fff\\\">On the day</h3>\\n          <p style=\\\"margin-top:10px;color:var(--muted)\\\">Arrive 15–20 minutes early to settle. We suggest soft layers, a mat or blanket, and an eye cover. Light refreshments provided.</p>\\n          <div style=\\\"margin-top:12px\\\">\\n            <strong style=\\\"color:#fff\\\">Instruments this season</strong>\\n            <ul style=\\\"color:var(--muted);margin-top:8px\\\">\\n              <li>Crystal singing bowls</li>\\n              <li>Deep gong strokes</li>\\n              <li>Chiming textures</li>\\n            </ul>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0;color:#fff\\\">Need help?</h4>\\n          <p style=\\\"margin-top:10px;color:var(--muted)\\\">Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a>.</p>\\n        </div>\\n      </aside>\\n    </div>\\n  </div>\\n\\n  <script>\\n    function validateForm(){\\n      var agree = document.getElementById('agree');\\n      if(!agree.checked){\\n        alert('Please acknowledge contraindications before booking.');\\n        return false;\\n      }\\n      return true;\\n    }\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
