          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>About | {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#7f5af0;--muted:#f7f6fb;--ink:#1f1f25;--card:#ffffff}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial;background:linear-gradient(180deg,var(--muted),#fff 40%);color:var(--ink);-webkit-font-smoothing:antialiased}\\n    header{position:sticky;top:0;background:rgba(255,255,255,0.6);backdrop-filter:blur(6px);border-bottom:1px solid rgba(0,0,0,0.04)}\\n    .nav{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:14px}\\n    .brand{display:flex;align-items:center;gap:12px;font-weight:700}\\n    .brand .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#f472b6);display:grid;place-items:center;color:#fff;font-size:18px}\\n    nav a{margin-left:18px;color:var(--ink);text-decoration:none;font-weight:600;opacity:0.9}\\n    .hero{max-width:1100px;margin:36px auto 18px;padding:40px 24px;display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.9),#fff);border-radius:14px;padding:28px;box-shadow:0 8px 30px rgba(31,31,37,0.06)}\\n    h1{margin:0 0 12px;font-size:28px;line-height:1.05}\\n    p.lead{margin:0;color:#51515a}\\n    .aside .pattern{width:100%;height:220px;border-radius:10px;overflow:hidden;background:linear-gradient(135deg,rgba(127,90,240,0.15),rgba(244,114,182,0.08));display:flex;flex-direction:column;justify-content:center;align-items:center}\\n    .aside .cta{margin-top:14px}\\n    .kicker{font-size:12px;text-transform:uppercase;color:#6b6b75;letter-spacing:0.12em}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}\\n    .benefit{padding:18px;border-radius:10px;background:var(--card);box-shadow:0 6px 18px rgba(31,31,37,0.04)}\\n    .small{font-size:13px;color:#666}\\n    .testimonial{padding:16px;border-radius:10px;background:linear-gradient(180deg,#fff,#fbf9ff);border:1px solid rgba(127,90,240,0.06)}\\n    .leadmag{display:flex;gap:12px;align-items:center;margin-top:22px}\\n    .leadmag input{flex:1;padding:12px;border-radius:10px;border:1px solid #eee}\\n    .btn{background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{max-width:1100px;margin:40px auto;padding:18px;text-align:center;color:#7b7b88}\\n    /* floating SVG background */\\n    .bg-svg{position:fixed;right:-120px;top:-80px;width:620px;opacity:0.14;filter:blur(10px);pointer-events:none}\\n    @media(max-width:900px){.hero{grid-template-columns:1fr;padding:20px}.grid{grid-template-columns:1fr 1fr}.bg-svg{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class='bg-svg' viewBox='0 0 800 600' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n    <defs>\\n      <linearGradient id='g1' x1='0' x2='1'>\\n        <stop offset='0' stop-color='#7f5af0'/>\\n        <stop offset='1' stop-color='#f472b6'/>\\n      </linearGradient>\\n      <pattern id='p1' width='40' height='40' patternUnits='userSpaceOnUse' patternTransform='rotate(25)'>\\n        <rect width='20' height='40' fill='rgba(255,255,255,0.06)' />\\n      </pattern>\\n    </defs>\\n    <rect width='800' height='600' fill='url(#g1)' rx='60'/>\\n    <rect width='800' height='600' fill='url(#p1)' rx='60' />\\n  </svg>\\n\\n  <header>\\n    <div class='nav'>\\n      <div class='brand'>\\n        <div class='logo'>SB</div>\\n        <div>\\n          <div style='font-size:14px'>{{BUSINESS_NAME}}</div>\\n          <div style='font-size:12px;color:#6b6b75'>{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href='index.html'>Home</a>\\n        <a href='events.html'>Gatherings</a>\\n        <a href='private-sessions.html'>Private</a>\\n        <a href='pricing.html'>Pricing</a>\\n        <a href='about.html' style='opacity:1;text-decoration:underline'>Our Story</a>\\n        <a href='book.html' class='btn' style='margin-left:18px;padding:8px 12px'>{{PRIMARY_CTA_LABEL}}</a>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main>\\n    <section class='hero'>\\n      <div class='card'>\\n        <div class='kicker'>The practice</div>\\n        <h1>We craft listening as a pathway to rest</h1>\\n        <p class='lead'>At {{BUSINESS_NAME}} we design slow, sensory sound baths that feel like an aesthetic inhale. Sessions blend resonant crystal bowls and tuning forks with quiet intention for a premium, restorative experience.</p>\\n        <div class='grid' aria-hidden='false'>\\n          <div class='benefit'>\\n            <strong>Curated sonic palette</strong>\\n            <div class='small'>A thoughtful mix of crystal bowls, harmonic tuning forks, and soft chimes tuned to support nervous system regulation.</div>\\n          </div>\\n          <div class='benefit'>\\n            <strong>Membership first</strong>\\n            <div class='small'>Priority reservations, member-only circles, and credits that make regular sound baths simple.</div>\\n          </div>\\n          <div class='benefit'>\\n            <strong>Safe, premium space</strong>\\n            <div class='small'>Comfortable mats, blankets, and acoustically treated rooms at {{VENUE_NAME}} in {{CITY}}, {{STATE}}.</div>\\n          </div>\\n        </div>\\n        <div style='display:flex;gap:12px;margin-top:18px;align-items:center'>\\n          <a class='btn' href='{{PRIMARY_CTA_URL}}'>{{PRIMARY_CTA_LABEL}}</a>\\n          <a style='font-weight:700;color:var(--accent);text-decoration:none' href='events.html'>See upcoming circles</a>\\n        </div>\\n      </div>\\n\\n      <aside class='card aside'>\\n        <div class='pattern'>\\n          <svg viewBox='0 0 200 120' xmlns='http://www.w3.org/2000/svg' width='100%' height='100%'>\\n            <defs>\\n              <linearGradient id='lg' x1='0' x2='1'>\\n                <stop offset='0' stop-color='#7f5af0' stop-opacity='0.9' />\\n                <stop offset='1' stop-color='#f472b6' stop-opacity='0.85' />\\n              </linearGradient>\\n            </defs>\\n            <rect x='0' y='0' width='200' height='120' rx='12' fill='url(#lg)' />\\n            <g fill='rgba(255,255,255,0.9)' opacity='0.9' transform='translate(12,18)'>\\n              <ellipse cx='36' cy='20' rx='26' ry='8' />\\n              <ellipse cx='132' cy='48' rx='48' ry='12' />\\n              <ellipse cx='88' cy='88' rx='70' ry='10' />\\n            </g>\\n          </svg>\\n        </div>\\n        <div style='margin-top:12px'>\\n          <div style='font-weight:700'>Upcoming Member Perk</div>\\n          <div class='small' style='margin-top:6px'>Members receive a welcome recording after their first session and early access to retreats.</div>\\n          <div class='leadmag'>\\n            <input placeholder='Email to receive a welcome guide' aria-label='email' />\\n            <a class='btn' href='#'>Join list</a>\\n          </div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style='max-width:1100px;margin:14px auto;padding:22px'>\\n      <div class='card'>\\n        <h2 style='margin-top:0'>How a session feels — the flow</h2>\\n        <p class='small'>Sessions are intentionally paced to hold safety and depth. Below is a distilled flow that we use as a frame.</p>\\n        <ol style='margin-top:12px'>\\n          <li style='margin-bottom:8px'><strong>Arrival & settling</strong> — gentle tea, set an intention, ground with breathwork.</li>\\n          <li style='margin-bottom:8px'><strong>Sound immersion</strong> — layered bowls and tuning forks create evolving textures to invite nervous system downshift.</li>\\n          <li style='margin-bottom:8px'><strong>Silent resonance</strong> — periods of silence help integrate sensations.</li>\\n          <li><strong>Closing</strong> — guided return, soft journaling prompts, tea and time to reorient.</li>\\n        </ol>\\n        <p class='small' style='margin-top:12px'>Instruments used here include crystal singing bowls and harmonic tuning forks, chosen for their clarity and overtones.</p>\\n      </div>\\n\\n      <div style='display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px'>\\n        <div class='card'>\\n          <h3 style='margin-top:0'>Testimonials</h3>\\n          <div style='display:grid;gap:12px'>\\n            <div class='testimonial'>\\n              <div style='font-weight:700'>\\\"I slept like I hadn't in months.\\\"</div>\\n              <div class='small'>— member, via email</div>\\n            </div>\\n            <div class='testimonial'>\\n              <div style='font-weight:700'>\\\"The room itself becomes a balm.\\\"</div>\\n              <div class='small'>— workshop attendee</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <aside class='card'>\\n          <h4 style='margin-top:0'>Quick facts</h4>\\n          <div class='small'>What to bring: a yoga mat or pad, a blanket, an eye pillow or light scarf, and water.</div>\\n          <div class='small' style='margin-top:8px'>Contraindications: please avoid if you have untreated seizures, recent head injuries, or are under medical instruction to avoid vibrational therapies. Always check with your healthcare provider and notify the facilitator if you are pregnant or have implants sensitive to sound.</div>\\n        </aside>\\n      </div>\\n    </section>\\n\\n    <section style='max-width:1100px;margin:18px auto;padding:22px'>\\n      <div class='card'>\\n        <h3 style='margin-top:0'>Membership & offers</h3>\\n        <p class='small'>Our membership model rewards regular practice. Members get priority booking, discounted private sessions, and exclusive recordings.</p>\\n        <div style='display:flex;gap:12px;margin-top:12px'>\\n          <a class='btn' href='pricing.html'>View membership</a>\\n          <a style='background:#fff;border:1px solid rgba(127,90,240,0.12);padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:700;color:var(--accent)' href='contact.html'>Contact us</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} &middot; {{CITY}}, {{STATE}} &middot; <a href='tel:{{PHONE}}'>{{PHONE}}</a> &middot; <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a></div>\\n    <div style='margin-top:8px;font-size:13px;color:#9b9ba6'>Facilitated by {{FACILITATOR_NAME}} • Space provided by {{VENUE_NAME}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>FAQ | {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfbfe;--accent:#ff6b6b;--ink:#222;--muted:#6b6b75}\\n    body{margin:0;font-family:Georgia,serif;background:var(--bg);color:var(--ink)}\\n    header{background:linear-gradient(180deg,rgba(255,255,255,0.9),transparent);padding:12px 20px;position:sticky;top:0;border-bottom:1px solid rgba(0,0,0,0.04)}\\n    .nav{max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;align-items:center}\\n    .nav a{margin-left:16px;text-decoration:none;color:var(--ink);font-weight:600}\\n    .hero{max-width:1000px;margin:28px auto;padding:28px;background:#fff;border-radius:12px;box-shadow:0 10px 30px rgba(17,17,23,0.05)}\\n    h1{margin:0 0 8px;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}\\n    .intro{color:var(--muted);margin-bottom:12px}\\n    .faq-list{display:grid;grid-template-columns:1fr 360px;gap:18px}\\n    .questions{background:linear-gradient(180deg,#fff,#fff);padding:18px;border-radius:10px}\\n    details{margin-bottom:10px;background:linear-gradient(90deg,rgba(255,255,255,0.9),#fff);padding:12px;border-radius:8px}\\n    summary{font-weight:700;cursor:pointer}\\n    .aside{padding:16px;border-radius:10px;background:linear-gradient(180deg,#fff,#fff)}\\n    .muted{color:var(--muted);font-size:13px}\\n    .cta{display:flex;gap:10px;margin-top:12px}\\n    .btn-primary{background:var(--accent);color:#fff;padding:10px 12px;border-radius:8px;text-decoration:none;font-weight:800}\\n    .btn-ghost{border:1px solid rgba(0,0,0,0.06);padding:10px 12px;border-radius:8px;text-decoration:none}\\n    footer{max-width:1100px;margin:28px auto;text-align:center;color:#888}\\n    @media(max-width:900px){.faq-list{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class='nav'>\\n      <div style='font-weight:800'>{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href='index.html'>Home</a>\\n        <a href='events.html'>Next Circles</a>\\n        <a href='private-sessions.html'>Sessions</a>\\n        <a href='pricing.html'>Plans</a>\\n        <a href='faq.html' style='text-decoration:underline'>FAQ</a>\\n        <a class='btn-primary' href='book.html'>Reserve</a>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main style='max-width:1100px;margin:26px auto;padding:0 20px'>\\n    <section class='hero'>\\n      <h1>Questions and gentle answers</h1>\\n      <p class='intro'>Below we collect the most common curiosities about attending a sound bath with us, plus membership and safety notes for new listeners.</p>\\n\\n      <div class='faq-list' aria-live='polite'>\\n        <div class='questions'>\\n          <details open>\\n            <summary>What should I bring?</summary>\\n            <div class='muted' style='margin-top:8px'>Bring a yoga mat or comfortable sleeping pad, a soft blanket, an eye pillow or scarf, and a bottle of water. If you prefer a cushion for your neck, bring that too. We provide extra blankets and mats on request.</div>\\n          </details>\\n\\n          <details>\\n            <summary>Who should avoid sound baths or check with a clinician?</summary>\\n            <div class='muted' style='margin-top:8px'>Contraindications: untreated seizure disorder, recent cranial surgery, or implanted cardiac devices that could be affected by strong vibrations. If you are pregnant, have severe tinnitus, or are on medical advice regarding sensory therapies, please consult your provider first and tell the facilitator before the session.</div>\\n          </details>\\n\\n          <details>\\n            <summary>What is the typical flow of a group session?</summary>\\n            <div class='muted' style='margin-top:8px'>Our circles usually begin with a brief grounding and intention-setting, followed by 35–55 minutes of layered sound. We use instruments like gongs, soft chimes, and oceanic bowls to create sustained textures. Periods of silence are interspersed to let resonance settle. The closing includes gentle reorientation and tea.</div>\\n          </details>\\n\\n          <details>\\n            <summary>How loud are the instruments?</summary>\\n            <div class='muted' style='margin-top:8px'>We prioritize therapeutic volume levels. Expect immersive sound that can be felt more than it is painfully loud. If at any point you need less intensity, raise your hand or move toward the edge of the room.</div>\\n          </details>\\n\\n          <details>\\n            <summary>Do I need any experience?</summary>\\n            <div class='muted' style='margin-top:8px'>No. Beginners and seasoned practitioners alike are welcome. Sessions are guided to meet a range of needs; you are invited simply to listen and rest.</div>\\n          </details>\\n\\n          <details>\\n            <summary>How does membership work?</summary>\\n            <div class='muted' style='margin-top:8px'>Membership provides recurring credits for sessions, priority booking, and monthly member-only mini-circles. Members also receive a welcome audio and discounted private sessions.</div>\\n          </details>\\n\\n          <details>\\n            <summary>Do you offer private or corporate sessions?</summary>\\n            <div class='muted' style='margin-top:8px'>Yes. We offer 1:1 private sessions, couple sessions for shared restoration, and corporate or team workshops tailored to workplace wellbeing. See the private sessions page for details.</div>\\n          </details>\\n\\n        </div>\\n\\n        <aside class='aside'>\\n          <h4 style='margin-top:0'>Practical notes</h4>\\n          <div class='muted'>A typical session is 75 minutes. Doors close 10 minutes after start to honor the interior decline. We recommend arriving 15 minutes early for check-in and tea.</div>\\n\\n          <div style='margin-top:12px'>\\n            <strong style='display:block'>Next event</strong>\\n            <div class='muted' style='margin-top:6px'>Our next circle is on {{NEXT_EVENT_DATE}}. Book early — member spots fill fast.</div>\\n          </div>\\n\\n          <div class='cta'>\\n            <a class='btn-primary' href='book.html'>Reserve</a>\\n            <a class='btn-ghost' href='contact.html'>Ask a question</a>\\n          </div>\\n        </aside>\\n      </div>\\n\\n      <div style='display:flex;gap:12px;margin-top:18px;align-items:center'>\\n        <svg width='40' height='40' viewBox='0 0 100 100' aria-hidden='true' style='border-radius:8px;background:linear-gradient(180deg,#fff,rgba(255,107,107,0.05))'>\\n          <circle cx='50' cy='50' r='36' fill='none' stroke='#ffd6d6' stroke-width='8'/>\\n        </svg>\\n        <div>\\n          <div style='font-weight:800'>Still curious?</div>\\n          <div class='muted' style='margin-top:6px'>Message us at <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a> or call <a href='tel:{{PHONE}}'>{{PHONE}}</a>.</div>\\n        </div>\\n      </div>\\n\\n    </section>\\n\\n    <section style='max-width:1100px;margin:20px auto;padding:0 20px'>\\n      <div style='display:grid;grid-template-columns:1fr 1fr;gap:16px'>\\n        <div style='background:#fff;padding:18px;border-radius:12px'>\\n          <h4 style='margin-top:0'>Safety and accessibility</h4>\\n          <p class='muted'>Our space at {{VENUE_NAME}} is wheelchair accessible on the ground floor. If you need additional accommodations, email {{EMAIL}} ahead of time and we will do our best to prepare the room for your comfort.</p>\\n        </div>\\n        <div style='background:#fff;padding:18px;border-radius:12px'>\\n          <h4 style='margin-top:0'>Instrument variety</h4>\\n          <p class='muted'>We rotate instruments thoughtfully. Recent waves have included gongs, handpan-like monochord textures, and wind chimes to offer a varied sonic landscape.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style='max-width:1100px;margin:20px auto;padding:0 20px'>\\n      <div style='background:linear-gradient(180deg,#fff,#fcfbff);padding:18px;border-radius:12px;display:flex;justify-content:space-between;align-items:center'>\\n        <div>\\n          <div style='font-weight:800'>Get a free guide to sound meditation</div>\\n          <div class='muted' style='margin-top:6px'>Sign up and receive our audio primer on easing into resonance at home.</div>\\n        </div>\\n        <form action='{{PRIMARY_CTA_URL}}' method='post' style='display:flex;gap:8px'>\\n          <input name='email' placeholder='Email address' aria-label='email' style='padding:10px;border-radius:8px;border:1px solid #eee' />\\n          <button class='btn-primary' style='border:none'>Send</button>\\n        </form>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style='max-width:1100px;margin:20px auto;text-align:center;color:#9b9aa8'>© {{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Book a Session | {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fff;--accent:#0ea5a4;--ink:#112;--muted:#6c6c76}\\n    body{margin:0;font-family:Inter,ui-sans-serif,system-ui,Segoe UI,Roboto,Helvetica,Arial;background:linear-gradient(180deg,#fbfbff,#fff);color:var(--ink)}\\n    .wrap{max-width:1000px;margin:28px auto;padding:22px}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:10px 0}\\n    header a{margin-left:12px;text-decoration:none;color:var(--ink);font-weight:700}\\n    h1{margin:0 0 6px}\\n    .lead{color:var(--muted);margin-bottom:12px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:18px}\\n    form{background:#fff;padding:18px;border-radius:12px;box-shadow:0 10px 30px rgba(17,17,23,0.06)}\\n    label{display:block;font-weight:700;margin-top:12px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #eee;margin-top:6px}\\n    .submit{margin-top:14px;background:var(--accent);color:#fff;padding:10px 12px;border-radius:8px;border:none;font-weight:800}\\n    .aside{background:linear-gradient(180deg,#fff,#fbfffe);padding:18px;border-radius:12px}\\n    .note{font-size:13px;color:var(--muted)}\\n    .flow{display:flex;flex-direction:column;gap:8px;margin-top:12px}\\n    .instrument{padding:10px;border-radius:10px;background:#fff;border:1px solid rgba(14,165,164,0.06)}\\n    footer{margin-top:28px;text-align:center;color:#9b9aa8}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class='wrap'>\\n    <header>\\n      <div style='font-weight:900'>{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href='index.html'>Start</a>\\n        <a href='events.html'>Calendar</a>\\n        <a href='private-sessions.html'>Private</a>\\n        <a href='pricing.html'>Plans</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <h1>Reserve your spot</h1>\\n      <p class='lead'>Choose a group circle or private session. Membership credits can be applied at checkout for recurring access.</p>\\n\\n      <div class='grid'>\\n        <form action='{{PRIMARY_CTA_URL}}' method='post' aria-label='booking form'>\\n          <label for='type'>Session type</label>\\n          <select id='type' name='type'>\\n            <option value='group'>Group sound bath</option>\\n            <option value='private'>1:1 private session</option>\\n            <option value='couple'>Couple session</option>\\n            <option value='corporate'>Corporate / team workshop</option>\\n          </select>\\n\\n          <label for='date'>Preferred date</label>\\n          <input id='date' name='date' type='date' required />\\n\\n          <label for='time'>Preferred time</label>\\n          <select id='time' name='time'>\\n            <option>Evening circle 6:30pm</option>\\n            <option>Afternoon 2:00pm</option>\\n            <option>Morning 10:30am</option>\\n          </select>\\n\\n          <label for='name'>Your full name</label>\\n          <input id='name' name='name' placeholder='Jane Doe' required />\\n\\n          <label for='email'>Email</label>\\n          <input id='email' name='email' type='email' placeholder='you@domain.com' required />\\n\\n          <label for='notes'>Notes, accessibility needs, or contra-indications</label>\\n          <textarea id='notes' name='notes' rows='4' placeholder='Let us know about hearing devices, seizures, pregnancy, or anything else we should consider'></textarea>\\n\\n          <label style='margin-top:12px'><input type='checkbox' name='member' /> I am a member and want to apply credits</label>\\n\\n          <button class='submit' type='submit'>Book now</button>\\n        </form>\\n\\n        <aside class='aside'>\\n          <div style='display:flex;justify-content:space-between;align-items:center'>\\n            <div>\\n              <div style='font-weight:800'>What to bring</div>\\n              <div class='note' style='margin-top:6px'>A mat or pad, a warm blanket, and an eye pillow. Loose, comfortable clothing is best.</div>\\n            </div>\\n            <svg width='56' height='56' viewBox='0 0 100 100' aria-hidden='true'>\\n              <defs>\\n                <linearGradient id='bG' x1='0' x2='1'>\\n                  <stop offset='0' stop-color='#0ea5a4' />\\n                  <stop offset='1' stop-color='#34d399' />\\n                </linearGradient>\\n              </defs>\\n              <rect width='100' height='100' rx='18' fill='url(#bG)' opacity='0.14'/>\\n              <path d='M20 60c18-30 60-34 64 0' stroke='#0ea5a4' stroke-width='6' fill='none' stroke-linecap='round'/>\\n            </svg>\\n          </div>\\n\\n          <div style='margin-top:12px'>\\n            <strong style='display:block'>Contraindications</strong>\\n            <div class='note' style='margin-top:6px'>If you have a history of seizures, recent head trauma, or hardware that may be sensitive to vibrations, contact your physician first and tell us before booking. Pregnant people should consult their care provider.</div>\\n          </div>\\n\\n          <div style='margin-top:12px'>\\n            <strong style='display:block'>Session flow</strong>\\n            <div class='flow'>\\n              <div class='instrument'><strong>Arrival</strong> — 10–15 minutes for check-in and settling.</div>\\n              <div class='instrument'><strong>Main immersion</strong> — 40–60 minutes layered sound using a field of instruments like a monochord, planet bowls, and soft percussion.</div>\\n              <div class='instrument'><strong>Integration</strong> — 10–15 minutes of gentle return and tea.</div>\\n            </div>\\n          </div>\\n\\n          <div style='margin-top:12px'>\\n            <strong style='display:block'>Private sessions</strong>\\n            <div class='note' style='margin-top:6px'>1:1 sessions are tailored to navigate trauma-sensitive approaches and therapeutic aims. Couple and corporate offerings can be customized on request.</div>\\n          </div>\\n\\n          <div style='margin-top:14px;display:flex;gap:10px'>\\n            <a class='submit' href='{{PRIMARY_CTA_URL}}' style='display:inline-block;text-align:center;text-decoration:none'>Confirm</a>\\n            <a style='padding:10px;border-radius:8px;background:#fff;border:1px solid rgba(0,0,0,0.06);text-decoration:none;color:var(--muted)' href='events.html'>See schedule</a>\\n          </div>\\n        </aside>\\n      </div>\\n\\n      <section style='margin-top:18px;background:#fff;padding:16px;border-radius:12px'>\\n        <h3 style='margin-top:0'>Instruments you may hear</h3>\\n        <p class='note'>We rotate instruments to shape different textures. Recent sessions emphasized the monochord for deep harmonic drones, oceanic steel tongue drums, and crystal bowls to add shimmering overtones. Each facilitator curates with intention.</p>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div class='note'>Questions? Call <a href='tel:{{PHONE}}'>{{PHONE}}</a> or email <a href='mailto:{{EMAIL}}'>{{EMAIL}}</a>. Facilitated by {{FACILITATOR_NAME}} at {{VENUE_NAME}}.</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
