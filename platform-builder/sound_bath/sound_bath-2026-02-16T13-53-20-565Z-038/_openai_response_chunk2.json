          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Gatherings — {{BUSINESS_NAME}} Sound Baths</title>\\n  <style>\\n    :root{\\n      --bg1:#0f1720; --bg2:#071226; --accent:#c7f0e8; --muted:#9aa9b2; --card:#0b1220;\\n      --glass:rgba(255,255,255,0.04); --glass-2:rgba(255,255,255,0.02);\\n      --radius:14px; --maxw:980px;\\n      font-family:Inter, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;\\n    }\\n    *{box-sizing:border-box}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg1),var(--bg2));color:#e6f8f5}\\n    .pattern{position:fixed;inset:0;z-index:-1;opacity:0.12}\\n    header{max-width:var(--maxw);margin:28px auto 12px;padding:18px 22px;display:flex;align-items:center;gap:18px}\\n    .logo{display:flex;flex-direction:column}\\n    .brand{font-weight:700;letter-spacing:0.6px}\\n    nav{margin-left:auto;display:flex;gap:14px;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px 12px;border-radius:10px}\\n    nav a:hover{background:var(--glass);color:var(--accent)}\\n\\n    main{max-width:var(--maxw);margin:18px auto;padding:26px;border-radius:18px;background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));backdrop-filter: blur(6px)}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:26px;align-items:center}\\n    .hero h1{margin:0;font-size:clamp(22px,4.8vw,40px);line-height:1.02;color:#eafff8}\\n    .subtitle{color:var(--muted);margin-top:8px}\\n    .cta{margin-top:18px}\\n    .button{display:inline-block;padding:12px 18px;border-radius:12px;background:linear-gradient(90deg,#9fead8,#6fdacc);color:#043139;text-decoration:none;font-weight:700}\\n    .panel{background:linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.00));padding:18px;border-radius:14px;border:1px solid rgba(255,255,255,0.03)}\\n\\n    section{margin-top:24px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:22px}\\n    .flow-list{display:flex;flex-direction:column;gap:10px}\\n    .flow-item{padding:12px;border-radius:12px;background:var(--glass-2);border:1px solid rgba(255,255,255,0.02)}\\n    .small{font-size:13px;color:var(--muted)}\\n\\n    .calendar{display:flex;flex-direction:column;gap:10px}\\n    .event-card{display:flex;justify-content:space-between;align-items:center;padding:14px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);border:1px solid rgba(255,255,255,0.03)}\\n    .event-card .meta{color:var(--muted);font-size:14px}\\n    .pill{background:rgba(167,235,226,0.08);color:var(--accent);padding:8px 12px;border-radius:999px;font-weight:700}\\n\\n    footer{max-width:var(--maxw);margin:28px auto;padding:18px;color:var(--muted);font-size:13px}\\n    .zx{display:flex;gap:10px;flex-wrap:wrap}\\n\\n    /* responsive */\\n    @media (max-width:900px){.hero{grid-template-columns:1fr} .grid{grid-template-columns:1fr} nav{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique inline SVG pattern for this page (assets/img/pattern.svg equivalent) -->\\n  <svg class=\\\"pattern\\\" width=\\\"100%\\\" height=\\\"100%\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" preserveAspectRatio=\\\"none\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#3ad5c6\\\" stop-opacity=\\\"0.16\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#5bd7e0\\\" stop-opacity=\\\"0.04\\\"/></linearGradient>\\n      <pattern id=\\\"p1\\\" width=\\\"200\\\" height=\\\"200\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"200\\\" height=\\\"200\\\" fill=\\\"url(#g1)\\\" />\\n        <circle cx=\\\"30\\\" cy=\\\"30\\\" r=\\\"2.6\\\" fill=\\\"#e8fff7\\\" opacity=\\\"0.5\\\" />\\n        <circle cx=\\\"90\\\" cy=\\\"140\\\" r=\\\"1.8\\\" fill=\\\"#e8fff7\\\" opacity=\\\"0.35\\\" />\\n        <rect x=\\\"0\\\" y=\\\"100\\\" width=\\\"200\\\" height=\\\"2\\\" fill=\\\"#ffffff\\\" opacity=\\\"0.02\\\" />\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\"/>\\n    <g transform=\\\"translate(60,140) rotate(-12)\\\" fill=\\\"#6fe3d5\\\" opacity=\\\"0.06\\\">\\n      <ellipse rx=\\\"420\\\" ry=\\\"120\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"logo\\\">\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"small\\\">Soothing sessions in {{CITY}}, {{STATE}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Gatherings</a>\\n      <a href=\\\"private-sessions.html\\\">Sessions</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"about.html\\\">Our Story</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Evening sound bath gatherings — surrender into resonance</h1>\\n        <div class=\\\"subtitle\\\">A premium sensory immersion using carefully tuned instruments to guide you toward calm. Next gathering: <strong>{{NEXT_EVENT_DATE}}</strong>.</div>\\n        <div class=\\\"cta\\\">\\n          <a class=\\\"button\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n        <div class=\\\"panel\\\" style=\\\"margin-top:18px\\\">\\n          <strong class=\\\"small\\\">What to expect</strong>\\n          <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">We weave crystal bowls, chimes, a gentle monocord and a low drum tone into a 75-minute session. Each gathering blends guided breathwork, a 45–50 minute sound immersion, and a soft re-entry.</p>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"panel\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Next event</div>\\n            <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">{{NEXT_EVENT_DATE}} — {{VENUE_NAME}}</div>\\n          </div>\\n          <div class=\\\"pill\\\">In-person</div>\\n        </div>\\n        <div style=\\\"margin-top:12px\\\" class=\\\"small\\\">Limited mats available; reserve early to secure your spot. Held at {{VENUE_NAME}} in {{CITY}}.</div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"grid\\\">\\n      <div>\\n        <h2 style=\\\"margin-top:0\\\">Flow of the evening</h2>\\n        <div class=\\\"flow-list\\\">\\n          <div class=\\\"flow-item\\\"><strong>Arrival & settling (10–12 min)</strong><div class=\\\"small\\\">Soft lighting, intention setting, gentle breath guidance.</div></div>\\n          <div class=\\\"flow-item\\\"><strong>Guided centering (8–10 min)</strong><div class=\\\"small\\\">Progressive relaxation to open the body to sound.</div></div>\\n          <div class=\\\"flow-item\\\"><strong>Sound immersion (45–50 min)</strong><div class=\\\"small\\\">Layered crystal bowls, chimes, monocord and frame drum for a moving sonic landscape.</div></div>\\n          <div class=\\\"flow-item\\\"><strong>Gradual re-entry (5–8 min)</strong><div class=\\\"small\\\">Pause, gentle movement, and a whispered close to return slowly.</div></div>\\n        </div>\\n\\n        <h3 style=\\\"margin-top:18px\\\">What to bring</h3>\\n        <ul class=\\\"small\\\">\\n          <li>Yoga mat or blanket, eye mask, pillow for head support</li>\\n          <li>Socks and a light shawl or sweater — rooms are often cool</li>\\n          <li>Water bottle for after the session</li>\\n        </ul>\\n\\n        <h3 style=\\\"margin-top:14px\\\">Contraindications (please read)</h3>\\n        <p class=\\\"small\\\">If you are pregnant, have epilepsy, severe cardiovascular conditions, an implanted pacemaker, or are recovering from major surgery, consult your physician before attending. If you have concerns, email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}}.</p>\\n\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <h4 style=\\\"margin:0 0 8px 0\\\">Upcoming dates</h4>\\n          <div class=\\\"calendar\\\">\\n            <div class=\\\"event-card\\\"><div><strong>{{NEXT_EVENT_DATE}}</strong><div class=\\\"meta\\\">Sound bath + guided breathwork</div></div><div class=\\\"pill\\\">Reserve</div></div>\\n            <div class=\\\"event-card\\\"><div><strong>2026-03-06 • Fri</strong><div class=\\\"meta\\\">Full spectrum soundscape — crystal bowls + chime harp</div></div><div class=\\\"pill\\\">Tickets</div></div>\\n            <div class=\\\"event-card\\\"><div><strong>2026-03-20 • Sat</strong><div class=\\\"meta\\\">Lunar evening — low gong undertones</div></div><div class=\\\"pill\\\">RSVP</div></div>\\n            <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Please bring your own mat where possible. We provide a limited number of blankets on request.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0 0 8px 0\\\">Instruments you'll hear</h4>\\n          <ul class=\\\"small\\\" style=\\\"margin:0;padding-left:16px\\\">\\n            <li>Crystal singing bowls tuned to solfeggio tones</li>\\n            <li>Monochord drone and bowed tibetan-style bowls</li>\\n            <li>Hand chimes & gentle frame drum</li>\\n          </ul>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section>\\n      <h2>Why attend</h2>\\n      <p class=\\\"small\\\">Our gatherings are an accessible, premium way to step away from daily stimulus. The sound becomes a tactile guide that supports nervous system regulation, deep rest, and mindful presence.</p>\\n      <div style=\\\"margin-top:12px\\\">\\n        <a class=\\\"button\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve my spot</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"zx\\\">\\n      <div>{{BUSINESS_NAME}} — {{TAGLINE}}</div>\\n      <div>Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n      <div>© {{BUSINESS_NAME}}</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Sessions — Private Sound Experiences | {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071421;--card:#08121a;--accent:#ffd7e1;--muted:#9fb2b7;--glass:rgba(255,255,255,0.03);--radius:12px;--maxw:980px}\\n    *{box-sizing:border-box}body{margin:0;background:radial-gradient(1200px 600px at 10% 10%, #0b2b2f33, transparent), linear-gradient(180deg,var(--bg),#021018);font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto;color:#f3fffc}\\n    .svg-bg{position:fixed;inset:0;z-index:-1;opacity:0.09}\\n    header{max-width:var(--maxw);margin:26px auto;padding:18px 22px;display:flex;align-items:center}\\n    .brand{font-weight:800}\\n    nav{margin-left:auto;display:flex;gap:12px}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px;border-radius:10px}\\n    nav a:hover{color:var(--accent)}\\n    main{max-width:var(--maxw);margin:22px auto;padding:22px;background:linear-gradient(180deg, rgba(255,255,255,0.01), transparent);border-radius:16px}\\n\\n    .hero{padding:18px;display:flex;gap:18px;align-items:center}\\n    .hero .left{flex:1}\\n    .hero h1{margin:0;font-size:clamp(20px,4vw,36px)}\\n    .panel{background:var(--card);padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.02)}\\n    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:16px}\\n    .card{padding:14px;border-radius:12px;background:linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.00));border:1px solid rgba(255,255,255,0.02)}\\n    .muted{color:var(--muted);font-size:14px}\\n    .price{font-weight:800;color:var(--accent);margin-top:8px}\\n    .btn{display:inline-block;padding:10px 12px;border-radius:10px;background:#ffffff10;color:var(--accent);text-decoration:none;font-weight:700}\\n\\n    @media (max-width:900px){.cards{grid-template-columns:1fr} nav{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <!-- Unique SVG pattern (private-sessions) -->\\n  <svg class=\\\"svg-bg\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" preserveAspectRatio=\\\"none\\\">\\n    <defs>\\n      <linearGradient id=\\\"pg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#ffd7e1\\\" stop-opacity=\\\"0.08\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#b7f7ee\\\" stop-opacity=\\\"0.02\\\"/></linearGradient>\\n      <pattern id=\\\"p2\\\" width=\\\"260\\\" height=\\\"160\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"260\\\" height=\\\"160\\\" fill=\\\"url(#pg)\\\" />\\n        <path d=\\\"M0 80 Q30 30 60 80 T120 80 T180 80 T240 80\\\" stroke=\\\"#ffffff\\\" stroke-opacity=\\\"0.03\\\" fill=\\\"none\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p2)\\\"/>\\n  </svg>\\n\\n  <header>\\n    <div>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"muted\\\">Personalized sound therapy in {{CITY}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Back</a>\\n      <a href=\\\"events.html\\\">Gatherings</a>\\n      <a href=\\\"private-sessions.html\\\">One-to-One</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero panel\\\">\\n      <div class=\\\"left\\\">\\n        <h1>Private sound sessions — crafted for you</h1>\\n        <p class=\\\"muted\\\">Intensive, attentive sessions designed for nervous system regulation, focused healing, and deep rest. Choose one-to-one, couples, or corporate offerings.</p>\\n        <div style=\\\"margin-top:12px\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a private session</a>\\n        </div>\\n      </div>\\n      <aside style=\\\"width:320px\\\">\\n        <div class=\\\"panel\\\">\\n          <div style=\\\"font-weight:700\\\">Facilitator</div>\\n          <div class=\\\"muted\\\">{{FACILITATOR_NAME}} — trained in somatic listening and sound therapy</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2 style=\\\"margin-bottom:6px\\\">Session formats</h2>\\n      <div class=\\\"cards\\\">\\n        <div class=\\\"card\\\">\\n          <strong>1:1 Intensive</strong>\\n          <div class=\\\"muted\\\">A focused 75–90 minute session tailored to personal needs: sleep, trauma-informed calming, or performance reset.</div>\\n          <div class=\\\"price\\\">From $149</div>\\n          <div style=\\\"margin-top:8px\\\" class=\\\"muted\\\">Instruments: tuning forks, crystal bowls, monochord.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Couples Harmony</strong>\\n          <div class=\\\"muted\\\">Shared experience for partners to synchronize nervous systems and deepen presence together.</div>\\n          <div class=\\\"price\\\">From $249</div>\\n          <div style=\\\"margin-top:8px\\\" class=\\\"muted\\\">Instruments: gong undertone, koshi chimes, bowed monochord.</div>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Corporate Wellness</strong>\\n          <div class=\\\"muted\\\">Short sound meditations (20–40 min) for teams, or an in-depth 60–90 minute workshop focused on stress reset.</div>\\n          <div class=\\\"price\\\">Custom pricing</div>\\n          <div style=\\\"margin-top:8px\\\" class=\\\"muted\\\">Instruments: crystal bowls, chimes, subtle vocal toning.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"panel\\\">\\n      <h3 style=\\\"margin-top:0\\\">How a private session unfolds</h3>\\n      <ol class=\\\"muted\\\" style=\\\"margin:0 0 0 18px\\\">\\n        <li>Intake & alignment — 10–15 minutes to set intention and note preferences/contraindications.</li>\\n        <li>Breath and grounding — short somatic practice to meet your present state.</li>\\n        <li>Main immersion — 50–60 minutes of tailored sound including tuning forks and bowed strings to sculpt the field.</li>\\n        <li>Integration & aftercare — 10–15 minutes with hydration and gentle movement prompts.</li>\\n      </ol>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:12px\\\">Contraindications: Please inform us if you have photosensitive epilepsy, recent surgery, pregnancy, heart conditions, or implanted medical devices. If in doubt, consult your doctor.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>What to bring</h3>\\n      <p class=\\\"muted\\\">A mat or blanket, pillow, eye-cover, and comfortable layers. We provide bolsters on request for 1:1 sessions.</p>\\n      <div style=\\\"margin-top:10px\\\">\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule a private session</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"max-width:var(--maxw);margin:18px auto;padding:14px;color:var(--muted)\\\">\\n    <div>{{BUSINESS_NAME}} • {{TAGLINE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Investment & Rates — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#07121a;--card:#0b161b;--accent:#86ffd9;--muted:#9db8b3;--maxw:980px}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto;background:linear-gradient(180deg,#041018,#071827);color:#ecfffb}\\n    .bg-svg{position:fixed;inset:0;z-index:-1;opacity:0.08}\\n    header{max-width:var(--maxw);margin:26px auto;padding:16px 20px;display:flex;align-items:center}\\n    .brand{font-weight:800}\\n    nav{margin-left:auto;display:flex;gap:12px}\\n    nav a{color:var(--muted);text-decoration:none}\\n    main{max-width:var(--maxw);margin:22px auto;padding:20px;background:linear-gradient(180deg, rgba(255,255,255,0.01), transparent);border-radius:14px}\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .tier{background:linear-gradient(180deg, rgba(255,255,255,0.01), transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.02)}\\n    .price{font-size:20px;color:var(--accent);font-weight:800}\\n    .muted{color:var(--muted)}\\n    .cta{margin-top:14px}\\n    .btn{display:inline-block;padding:10px 12px;border-radius:12px;background:linear-gradient(90deg,#6ef0d8,#9ef1df);color:#042f30;text-decoration:none;font-weight:700}\\n    .tiny{font-size:13px}\\n    footer{max-width:var(--maxw);margin:32px auto;color:var(--muted);font-size:13px}\\n    @media (max-width:900px){.tiers{grid-template-columns:1fr} nav{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <!-- Unique SVG pattern for pricing page -->\\n  <svg class=\\\"bg-svg\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" preserveAspectRatio=\\\"none\\\">\\n    <defs>\\n      <radialGradient id=\\\"rg\\\" cx=\\\"0.2\\\" cy=\\\"0.2\\\"><stop offset=\\\"0\\\" stop-color=\\\"#86ffd9\\\" stop-opacity=\\\"0.12\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#3fcbb0\\\" stop-opacity=\\\"0.02\\\"/></radialGradient>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#rg)\\\"/>\\n    <g fill=\\\"#ffffff\\\" opacity=\\\"0.02\\\">\\n      <rect x=\\\"60\\\" y=\\\"140\\\" width=\\\"360\\\" height=\\\"2\\\" />\\n      <rect x=\\\"420\\\" y=\\\"340\\\" width=\\\"600\\\" height=\\\"2\\\" />\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Main</a>\\n      <a href=\\\"events.html\\\">Gather</a>\\n      <a href=\\\"private-sessions.html\\\">Sessions</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section>\\n      <h1 style=\\\"margin:0\\\">Investment</h1>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Transparent pricing for sound baths and private offerings. We recommend selecting what best supports your intention — rest, reset, or deep work.</p>\\n    </section>\\n\\n    <section class=\\\"tiers\\\">\\n      <div class=\\\"tier\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div><strong>Drop-in Group</strong><div class=\\\"tiny muted\\\">Single sound bath gathering</div></div>\\n          <div class=\\\"price\\\">$35</div>\\n        </div>\\n        <p class=\\\"muted tiny\\\" style=\\\"margin-top:10px\\\">75 minutes. Includes guided centering and a 45–50 minute sound immersion. Instruments vary per event — crystal bowls, chimes, light gong textures.</p>\\n        <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a spot</a></div>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div><strong>Series — 4 sessions</strong><div class=\\\"tiny muted\\\">Recommended for deeper nervous system change</div></div>\\n          <div class=\\\"price\\\">$120</div>\\n        </div>\\n        <p class=\\\"muted tiny\\\" style=\\\"margin-top:10px\\\">Four curated gatherings across lunar cycles. Instruments include crystal bowls, tuning forks, and a chorus of soft chimes to scaffold progressive relaxation.</p>\\n        <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve series</a></div>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div><strong>Private 1:1 Intensive</strong><div class=\\\"tiny muted\\\">Tailored, longer session</div></div>\\n          <div class=\\\"price\\\">From $149</div>\\n        </div>\\n        <p class=\\\"muted tiny\\\" style=\\\"margin-top:10px\\\">75–90 minutes, bespoke sound palette: tuning forks, bowed monochord, subtle vocal toning. Includes intake and aftercare guidance.</p>\\n        <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Request booking</a></div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin-bottom:8px\\\">Add-ons & group options</h3>\\n      <ul class=\\\"muted tiny\\\">\\n        <li>Couples session upgrade — +$80 (shared experience)</li>\\n        <li>Corporate or private group workshops — custom pricing</li>\\n        <li>On-site travel surcharge applies for venues outside {{CITY}} area</li>\\n      </ul>\\n\\n      <h4 style=\\\"margin-top:12px\\\">A note on contraindications</h4>\\n      <p class=\\\"muted tiny\\\">Sound is powerful. Guests with epilepsy, recent surgery, serious cardiovascular conditions, pregnancy, or implanted medical devices should consult their provider and disclose on booking. We can modify offerings for comfort and safety.</p>\\n\\n      <h4 style=\\\"margin-top:12px\\\">What to bring</h4>\\n      <p class=\\\"muted tiny\\\">Mat or blanket, eye covering, pillow, and water bottle. Arrive 10 minutes early for check-in. Need a loaner blanket? Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;display:flex;gap:12px;align-items:center;justify-content:space-between\\\">\\n      <div>\\n        <strong>Ready to book?</strong>\\n        <div class=\\\"muted tiny\\\">Spaces fill quickly for evening gatherings and weekend private sessions.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Secure your session</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"max-width:var(--maxw);margin:24px auto;color:var(--muted);font-size:13px\\\">Questions? Contact <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}} • {{BUSINESS_NAME}} — {{TAGLINE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
