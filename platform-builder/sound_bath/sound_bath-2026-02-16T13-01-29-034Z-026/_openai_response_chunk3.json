          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name='description' content='An earthy, sensory approach to sound bathing led by {{FACILITATOR_NAME}} in {{CITY}}, {{STATE}}.'>\\n  <style>\\n    :root{--bg1:#f6efe6;--bg2:#efe6d9;--accent:#8a5a3c;--muted:#6b584a;--sage:#7a9b76;--ivory:#fffaf6}\\n    *{box-sizing:border-box;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg1),var(--bg2));color:var(--muted);}\\n    header{position:sticky;top:0;background:rgba(255,250,245,0.85);backdrop-filter:saturate(120%) blur(6px);border-bottom:1px solid rgba(138,90,60,0.06);}\\n    .wrap{max-width:1000px;margin:0 auto;padding:28px 20px}\\n    nav{display:flex;align-items:center;justify-content:space-between;gap:12px}\\n    .brand{font-weight:700;color:var(--accent)}\\n    .navlinks{display:flex;gap:14px;align-items:center}\\n    .navlinks a{color:var(--muted);text-decoration:none;padding:8px;border-radius:8px}\\n    .navlinks a.cta{background:linear-gradient(90deg,#8a5a3c,#7a9b76);color:var(--ivory)}\\n    .hero{display:grid;grid-template-columns:1fr;gap:20px;background:linear-gradient(180deg,rgba(138,90,60,0.06),transparent);padding:36px;border-radius:14px;margin-top:18px;align-items:center}\\n    .hero .eyebrow{color:var(--sage);font-weight:600}\\n    .hero h1{margin:6px 0;font-size:clamp(24px,4vw,36px);color:#4b2f21}\\n    .hero p{margin:0;color:#5b463a}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:22px;margin-top:18px}\\n    .card{background:rgba(255,250,246,0.9);padding:18px;border-radius:12px;border:1px solid rgba(122,155,118,0.06)}\\n    .pattern{width:100%;height:120px;display:block}\\n    .pillars{display:flex;flex-direction:column;gap:12px}\\n    .pillar{display:flex;gap:12px;align-items:flex-start}\\n    .dot{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#f2e9de,#efe1d0);display:flex;align-items:center;justify-content:center;color:var(--accent);font-weight:700}\\n    footer{margin-top:28px;padding:28px 0;color:#6b584a;text-align:center;font-size:14px}\\n    .muted{color:#877567;font-size:14px}\\n    .cta-row{display:flex;gap:12px;margin-top:12px}\\n    .button{padding:10px 14px;border-radius:10px;border:none;background:var(--accent);color:#fff;text-decoration:none}\\n    .ghost{background:transparent;border:1px solid rgba(107,88,74,0.12);color:var(--muted);padding:10px 12px;border-radius:10px}\\n    details{background:transparent}\\n    @media(min-width:880px){.hero{grid-template-columns:1fr 360px}.grid{grid-template-columns:1fr 360px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class='wrap'>\\n      <nav>\\n        <div class='brand'>{{BUSINESS_NAME}}</div>\\n        <div class='navlinks'>\\n          <a href='index.html'>Gather</a>\\n          <a href='events.html'>Calendar</a>\\n          <a href='private-sessions.html'>Private</a>\\n          <a href='pricing.html'>Rates</a>\\n          <a href='about.html' class='cta'>About</a>\\n          <a href='contact.html'>Contact</a>\\n        </div>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main class='wrap'>\\n    <section class='hero'>\\n      <div>\\n        <div class='eyebrow'>A quiet field for listening</div>\\n        <h1>About our gatherings and craft</h1>\\n        <p>We hold time for deep, sensory restoration. {{FACILITATOR_NAME}} blends intention, sound, and slow ritual to create an intimate, premium sound bath in {{CITY}}, {{STATE}} — a place to unfold and let resonance carry you.</p>\\n        <div class='cta-row'>\\n          <a class='button' href='book.html'>{{PRIMARY_CTA_LABEL}}</a>\\n          <a class='ghost' href='events.html'>See upcoming dates</a>\\n        </div>\\n      </div>\\n      <div class='card'>\\n        <svg class='pattern' viewBox='0 0 600 120' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg' role='img' aria-hidden='true'>\\n          <defs>\\n            <linearGradient id='g' x1='0' x2='1'>\\n              <stop offset='0' stop-color='#efe1d0' />\\n              <stop offset='1' stop-color='#f6efe6' />\\n            </linearGradient>\\n            <pattern id='p' width='80' height='80' patternUnits='userSpaceOnUse'>\\n              <rect width='80' height='80' fill='url(#g)' />\\n              <path d='M0 60 C20 40 60 40 80 60' stroke='#e7d5c3' stroke-width='2' fill='none' />\\n              <circle cx='16' cy='24' r='4' fill='#8a5a3c'/>\\n            </pattern>\\n          </defs>\\n          <rect width='100%' height='100%' fill='url(#p)'/>\\n        </svg>\\n        <div style='margin-top:10px'>\\n          <strong>Our studio</strong>\\n          <p class='muted' style='margin-top:6px'>Sessions are hosted at {{VENUE_NAME}} in {{CITY}}. Soft lighting, layered cushions, and natural materials set the scene.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <div class='grid'>\\n      <section class='card'>\\n        <h3>Myth vs. Truth — A gentle unravelling</h3>\\n        <div style='margin-top:10px'>\\n          <details open>\\n            <summary style='font-weight:600;cursor:pointer'>Myth: Sound baths are only about relaxation.</summary>\\n            <p class='muted'>Truth: They can be restorative, somatic, and catalytic — a ceremony for nervous system regulation and subtle transformation.</p>\\n          </details>\\n          <details>\\n            <summary style='font-weight:600;cursor:pointer'>Myth: You must meditate perfectly to benefit.</summary>\\n            <p class='muted'>Truth: Ease of presence is enough. The sound holds you whether you rest, drift, or fall asleep.</p>\\n          </details>\\n          <details>\\n            <summary style='font-weight:600;cursor:pointer'>Myth: All sessions use the same instruments.</summary>\\n            <p class='muted'>Truth: We choose textures intentionally — crystal bowls shimmer, a gentle gong rounds the architecture, and hand-played chimes map light through silence.</p>\\n          </details>\\n        </div>\\n      </section>\\n\\n      <aside class='card'>\\n        <h4>Quick notes</h4>\\n        <p class='muted'>Bring what supports your comfort: a small pillow, a cozy blanket, and an open curiosity. We provide mats, bolsters, and ear-friendly curation.</p>\\n        <p style='margin-top:10px'><strong>Contact</strong><br><a href='mailto:{{EMAIL}}' style='color:var(--accent);text-decoration:none'>{{EMAIL}}</a><br>{{PHONE}}</p>\\n      </aside>\\n    </div>\\n\\n    <section class='card' style='margin-top:18px'>\\n      <h3>Pillars of our practice</h3>\\n      <div class='pillars' style='margin-top:12px'>\\n        <div class='pillar'><div class='dot'>1</div><div><strong>Intention</strong><div class='muted'>We invite clear intention-setting at the session's opening — simple, poetic prompts that orient the field.</div></div></div>\\n        <div class='pillar'><div class='dot'>2</div><div><strong>Safety</strong><div class='muted'>A modest group size, sensitive facilitation, and accessible positions keep the experience tender and held.</div></div></div>\\n        <div class='pillar'><div class='dot'>3</div><div><strong>Craft</strong><div class='muted'>Sound is chosen like color on a canvas: gong for breadth, crystal bowls for luminosity, and selected harmonic tools for nuance.</div></div></div>\\n      </div>\\n    </section>\\n\\n    <section class='card' style='margin-top:18px'>\\n      <h3>Case notes — How a session unfolds</h3>\\n      <p class='muted' style='margin-top:8px'>A typical group sound bath follows a quiet, repeating architecture that allows bodies to settle and resonance to weave.</p>\\n      <ol style='margin-top:8px' class='muted'>\\n        <li>Arrival & grounding: soft tea, short orientation, gentle breathwork.</li>\\n        <li>Opening tone & intention: a single hum to set the communal pulse.</li>\\n        <li>Layered sound journey: instruments breathe in patterns — harmonics, shimmer, and a slow deep gong wash.</li>\\n        <li>Closure & integration: a bell, soft touchstones, and time to journal or share quietly.</li>\\n      </ol>\\n      <p class='muted' style='margin-top:10px'><strong>Typical instruments here:</strong> crystal singing bowls, a small gong, hand chimes and soft rattle. (Each event's texture is curated.)</p>\\n    </section>\\n\\n    <section class='card' style='margin-top:18px'>\\n      <h3>Frequently noted concerns</h3>\\n      <p class='muted'>If you have questions about your body, medications, or a recent surgery, consult your healthcare provider first. We offer modifications and always encourage participants to rest or leave the room if needed.</p>\\n    </section>\\n\\n    <section class='card' style='margin-top:18px'>\\n      <h3>Ready to share a room of listening?</h3>\\n      <p class='muted'>Reserve a place for the next gathering — small circles, careful acoustics, a shared hush.</p>\\n      <div class='cta-row'>\\n        <a class='button' href='book.html'>Reserve a spot</a>\\n        <a class='ghost' href='events.html'>View calendar</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} · {{CITY}}, {{STATE}} · <a href='mailto:{{EMAIL}}' style='color:inherit;text-decoration:underline'>{{EMAIL}}</a></div>\\n      <div style='margin-top:6px' class='muted'>Facilitated by {{FACILITATOR_NAME}}. Small groups. Attentive curation.</div>\\n    </footer>\\n  </main>\\n\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Questions — {{BUSINESS_NAME}}</title>\\n  <meta name='description' content='Answers about attending, accessibility, and safety for sound baths run by {{FACILITATOR_NAME}}.'>\\n  <style>\\n    :root{--bg:#fbf7f2;--grain:#d9c9b7;--accent:#7a9b76;--deep:#4f352b}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto;color:var(--deep);background:linear-gradient(180deg,var(--bg),#fff);} \\n    .wrap{max-width:860px;margin:0 auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .brand{font-weight:700;color:var(--deep)}\\n    .nav{display:flex;gap:12px}\\n    .nav a{color:var(--deep);text-decoration:none;padding:8px;border-radius:8px}\\n    .nav a[href='faq.html']{background:linear-gradient(90deg,var(--accent),#8a5a3c);color:#fff}\\n    .hero{margin-top:18px;padding:20px;border-radius:12px;background:linear-gradient(180deg,#fff,#f8f3ee);display:flex;gap:18px;align-items:center}\\n    .hero svg{width:120px;height:80px}\\n    h1{margin:0 0 6px 0}\\n    .intro{color:#6b584a}\\n    .faq-list{margin-top:18px}\\n    details{background:#fff;padding:14px;border-radius:10px;margin-bottom:10px;border:1px solid rgba(122,155,118,0.06)}\\n    summary{font-weight:600;cursor:pointer}\\n    .muted{color:#7a6559}\\n    .note{background:linear-gradient(90deg,#fff7f0,#f7f3ef);padding:12px;border-radius:10px;border:1px solid #f0e3d6}\\n    .cta{margin-top:14px}\\n    .button{display:inline-block;background:var(--deep);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none}\\n  </style>\\n</head>\\n<body>\\n  <div class='wrap'>\\n    <header>\\n      <div class='brand'>{{BUSINESS_NAME}}</div>\\n      <nav class='nav'>\\n        <a href='index.html'>Home</a>\\n        <a href='events.html'>Events</a>\\n        <a href='book.html'>Reserve</a>\\n        <a href='contact.html'>Get in touch</a>\\n      </nav>\\n    </header>\\n\\n    <section class='hero'>\\n      <svg viewBox='0 0 200 120' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>\\n        <defs>\\n          <linearGradient id='lg' x1='0' x2='1'><stop offset='0' stop-color='#efe6d9'/><stop offset='1' stop-color='#f6efe6'/></linearGradient>\\n          <pattern id='wave' width='60' height='60' patternUnits='userSpaceOnUse'>\\n            <rect width='60' height='60' fill='url(#lg)' />\\n            <path d='M0 40 C20 20 40 20 60 40' stroke='#d8c7b4' stroke-width='2' fill='none' />\\n          </pattern>\\n        </defs>\\n        <rect width='100%' height='100%' fill='url(#wave)' rx='8' />\\n      </svg>\\n      <div>\\n        <h1>Questions answered</h1>\\n        <p class='intro'>Practical notes for a calm arrival. Below: what to bring, how a session flows, and safety guidance.</p>\\n      </div>\\n    </section>\\n\\n    <main>\\n      <section class='faq-list'>\\n        <details open>\\n          <summary>What should I bring?</summary>\\n          <div class='muted' style='margin-top:8px'>Come in comfortable clothing. We recommend: a yoga mat or blanket, a small cushion or neck pillow, and a cozy blanket to stay warm during stillness. Optional: eye mask, a water bottle, and a journal for notes afterwards.</div>\\n        </details>\\n\\n        <details>\\n          <summary>How long is a session and what is the flow?</summary>\\n          <div class='muted' style='margin-top:8px'>Sessions typically run 75–90 minutes. The flow:\\n            <ol class='muted' style='margin-top:8px'>\\n              <li>Arrival, settling, and brief intention-setting.</li>\\n              <li>Short breath or grounding exercise to anchor the nervous system.</li>\\n              <li>Main sound journey: layered textures, gradual build and release (instruments tuned for comfort).</li>\\n              <li>Soft reorientation and a moment for integration with tea or quiet reflection.</li>\\n            </ol>\\n          </div>\\n        </details>\\n\\n        <details>\\n          <summary>Are sound baths safe? Contraindications?</summary>\\n          <div class='muted' style='margin-top:8px'>For most people this is gentle, non-invasive work. However, please take special care if any of the following apply: epilepsy, implanted medical devices (e.g., pacemaker), recent surgery, pregnancy (first trimester caution), severe psychiatric diagnoses, or current substance intoxication. If you have inner ear conditions or are on medications that affect blood pressure or sensory processing, consult your healthcare provider. When in doubt, email <a href='mailto:{{EMAIL}}' style='color:var(--accent)'>{{EMAIL}}</a> before booking.</div>\\n        </details>\\n\\n        <details>\\n          <summary>Do I need experience?</summary>\\n          <div class='muted' style='margin-top:8px'>No. We welcome first-timers and regulars alike. There is no right way to receive sound. You may sit, lie down, or rest with your eyes open or closed.</div>\\n        </details>\\n\\n        <details>\\n          <summary>What instruments are used?</summary>\\n          <div class='muted' style='margin-top:8px'>Our textures are curated for each gathering. Instruments commonly woven together include: tuning forks for precise tones, hand chimes for bright punctuation, and a monochord for long harmonic drones — each chosen to create a layered, warm field of sound.</div>\\n        </details>\\n\\n        <details>\\n          <summary>How do you accommodate sensory needs or mobility differences?</summary>\\n          <div class='muted' style='margin-top:8px'>We keep accessibility in mind: chairs are available, floor cushioning can be adjusted, and volume is moderated. Please note any needs when you book or email {{EMAIL}} ahead of time.</div>\\n        </details>\\n\\n        <details>\\n          <summary>Refunds, cancellations, and late arrival policy</summary>\\n          <div class='muted' style='margin-top:8px'>Reservations can be rescheduled up to 72 hours prior for a full transfer. Within 72 hours we cannot guarantee transfers. Late arrivals are accommodated at the facilitator's discretion to preserve the field for others.</div>\\n        </details>\\n      </section>\\n\\n      <section style='margin-top:18px' class='note'>\\n        <strong>Short disclaimer</strong>\\n        <p class='muted' style='margin-top:8px'>This practice is supportive and complementary. It is not a substitute for medical or psychiatric care. If you have serious health concerns, please consult a licensed professional before attending.</p>\\n      </section>\\n\\n      <section class='cta' style='margin-top:18px'>\\n        <a class='button' href='book.html'>Reserve for the next event</a>\\n        <p class='muted' style='margin-top:8px'>Prefer to ask something privately? Email <a href='mailto:{{EMAIL}}' style='color:var(--accent)'>{{EMAIL}}</a> or call {{PHONE}}.</p>\\n      </section>\\n    </main>\\n\\n    <footer style='margin-top:28px;text-align:center;color:#7a6559'>\\n      <div>{{BUSINESS_NAME}} &middot; Facilitated by {{FACILITATOR_NAME}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang='en'>\\n<head>\\n  <meta charset='utf-8'>\\n  <meta name='viewport' content='width=device-width,initial-scale=1'>\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <meta name='description' content='Reserve your place for the next sound bath with {{FACILITATOR_NAME}}. Small circles, offered at {{VENUE_NAME}}.'>\\n  <style>\\n    :root{--bg:#fff8f3;--earth:#7a5a44;--leaf:#7a9b76;--ink:#44312a}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto;color:var(--ink);background:linear-gradient(180deg,#fff,#fff8f3)}\\n    .wrap{max-width:900px;margin:0 auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .brand{font-weight:700;color:var(--earth)}\\n    .nav a{margin-left:12px;text-decoration:none;color:var(--ink)}\\n    .hero{margin-top:18px;background:linear-gradient(180deg,#ffffff,#fcf7f2);padding:22px;border-radius:12px;border:1px solid rgba(122,155,118,0.06)}\\n    h1{margin:0;font-size:26px}\\n    p.muted{color:#7a6559}\\n    .cols{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:18px}\\n    .card{background:#fff;padding:16px;border-radius:12px;border:1px solid rgba(120,100,86,0.06)}\\n    label{display:block;margin-top:10px;font-weight:600}\\n    input,select,textarea{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid #e6ddd4}\\n    .button{background:var(--earth);color:#fff;padding:10px 14px;border-radius:10px;border:none;text-decoration:none;display:inline-block}\\n    .small{font-size:13px;color:#6b584a}\\n    .flow{margin-top:12px}\\n    ul{margin:6px 0 0 18px;color:#6b584a}\\n    .warning{background:linear-gradient(90deg,#fff4f0,#fff8f5);padding:12px;border-radius:10px;border:1px solid #f0d7cc;margin-top:12px}\\n    @media(max-width:880px){.cols{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class='wrap'>\\n    <header>\\n      <div class='brand'>{{BUSINESS_NAME}}</div>\\n      <nav class='nav'>\\n        <a href='index.html'>Home</a>\\n        <a href='events.html'>Events</a>\\n        <a href='faq.html'>Help</a>\\n      </nav>\\n    </header>\\n\\n    <section class='hero'>\\n      <h1>Reserve a place — next group session</h1>\\n      <p class='muted'>Secure your seat for the series. The next gathering is on <strong>{{NEXT_EVENT_DATE}}</strong> at {{VENUE_NAME}}. Capacity is limited to keep the field small and held.</p>\\n    </section>\\n\\n    <div class='cols'>\\n      <main>\\n        <section class='card'>\\n          <h3>Booking details</h3>\\n          <form id='bookForm' action='{{PRIMARY_CTA_URL}}' method='post'>\\n            <label for='name'>Full name</label>\\n            <input id='name' name='name' placeholder='Your name' required>\\n\\n            <label for='email'>Email</label>\\n            <input id='email' name='email' type='email' placeholder='you@example.com' required>\\n\\n            <label for='phone'>Phone (optional)</label>\\n            <input id='phone' name='phone' placeholder='Optional'>\\n\\n            <label for='ticket'>Ticket type</label>\\n            <select id='ticket' name='ticket'>\\n              <option value='standard'>General admission — single event</option>\\n              <option value='series'>Series pass — 4 gatherings</option>\\n              <option value='sliding'>Sliding scale — limited</option>\\n            </select>\\n\\n            <label for='notes'>Accessibility or health notes</label>\\n            <textarea id='notes' name='notes' rows='4' placeholder='Let us know mobility needs, sensory preferences, or questions'></textarea>\\n\\n            <div style='margin-top:12px'>\\n              <button class='button' type='submit'>{{PRIMARY_CTA_LABEL}}</button>\\n              <a class='small' href='mailto:{{EMAIL}}' style='margin-left:12px;color:var(--earth)'>Ask a question</a>\\n            </div>\\n            <p class='small' style='margin-top:10px'>By booking you agree to the scheduling and refund policy. If you need help, call {{PHONE}}.</p>\\n          </form>\\n        </section>\\n\\n        <section class='card' style='margin-top:14px'>\\n          <h4 class='small'>What to bring</h4>\\n          <ul class='small'>\\n            <li>Comfortable layers and a warm blanket.</li>\\n            <li>A small bolster or neck pillow if you like extra support.</li>\\n            <li>Water to sip afterward.</li>\\n          </ul>\\n\\n          <div class='flow'>\\n            <h4 class='small'>Session flow</h4>\\n            <p class='small'>We begin with a short centering and intention-setting, move through 45–60 minutes of layered sound, and finish with a gentle reorientation. You are free to rest or leave as needed.</p>\\n          </div>\\n\\n          <div class='warning'>\\n            <strong>Contraindications</strong>\\n            <p class='small' style='margin-top:8px'>If you have epilepsy, implanted devices, are in the first trimester of pregnancy, have recent surgery, or significant psychiatric conditions, please consult your provider before attending. Email <a href='mailto:{{EMAIL}}' style='color:var(--earth)'>{{EMAIL}}</a> for guidance.</p>\\n          </div>\\n        </section>\\n      </main>\\n\\n      <aside>\\n        <div class='card'>\\n          <h4>Private offerings</h4>\\n          <p class='small'>We also offer 1:1 immersion, couple sessions, and tailored corporate sound breaks. See the private page for details.</p>\\n          <a class='button' href='private-sessions.html' style='display:inline-block;margin-top:10px'>Inquire</a>\\n        </div>\\n\\n        <div class='card' style='margin-top:12px'>\\n          <h4>Sound palette for this series</h4>\\n          <p class='small' style='margin-top:8px'>For the upcoming series we will favor: crystal bowls for clarity, bowed monochord for luminous motion, and soft chime textures for points of arrival.</p>\\n        </div>\\n\\n        <div class='card' style='margin-top:12px'>\\n          <h4>Need to reschedule?</h4>\\n          <p class='small' style='margin-top:8px'>Transfers are available up to 72 hours before the start. Within 72 hours, contact us at <a href='mailto:{{EMAIL}}' style='color:var(--earth)'>{{EMAIL}}</a> and we will do our best to assist.</p>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer style='margin-top:18px;text-align:center;color:#7a6559'>\\n      <div>{{BUSINESS_NAME}} — {{VENUE_NAME}}, {{CITY}}, {{STATE}} · {{PHONE}}</div>\\n    </footer>\\n  </div>\\n  <script>\\n    (function(){\\n      var form=document.getElementById('bookForm');\\n      form.addEventListener('submit',function(e){\\n        // lightweight capture; allow default post but show a gentle confirmation before navigating away\\n        var btn = form.querySelector('button[type=\\\"submit\\\"]');\\n        btn.disabled=true;btn.textContent='Confirming...';\\n      });\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
  "parallel_tool_calls": true,
  "presence_penalty": 0,
  "previous_response_id": null,
