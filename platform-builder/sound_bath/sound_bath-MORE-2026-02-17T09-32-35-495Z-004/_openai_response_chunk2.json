          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Gatherings — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfbfc;--card:#ffffff;--muted:#556;--accent:#6b8cff;--accent-2:#8ad3c7;--glass:rgba(255,255,255,0.7);--shadow:0 6px 20px rgba(30,35,40,0.08);font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg),#f4f7fa);color:var(--muted);}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px;background:transparent}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:10px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}\\n    nav a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600}\\n    .hero{display:grid;grid-template-columns:1fr 380px;gap:28px;padding:36px 28px 12px}\\n    .hero-card{background:var(--card);padding:26px;border-radius:14px;box-shadow:var(--shadow)}\\n    h1{margin:0 0 8px;font-size:22px;color:#24314a}\\n    p.lead{margin:0 0 16px;color:#42506a}\\n    .next-event{border-radius:12px;padding:18px;background:linear-gradient(180deg,#fff, #f8fbff);display:flex;flex-direction:column;gap:8px}\\n    .meta{font-size:13px;color:#6b7280}\\n    .cta{display:inline-block;background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .calendar{margin-top:18px;display:flex;flex-direction:column;gap:10px}\\n    .cal-row{display:flex;justify-content:space-between;padding:12px;border-radius:10px;background:linear-gradient(180deg,#fff,#fbfdff);align-items:center}\\n    .cal-date{font-weight:700;color:#233149}\\n    .cal-title{font-size:14px;color:#36475f}\\n    .proof{margin-top:22px;padding:16px;border-radius:12px;background:linear-gradient(180deg,#fff,#f9fbff)}\\n    .testimonial{min-height:72px}\\n    .badges{display:flex;gap:10px;margin-top:12px}\\n    .badge{background:linear-gradient(90deg,#fff,#f6fbff);padding:8px 10px;border-radius:8px;border:1px solid rgba(34,48,78,0.04);font-size:13px;cursor:default;position:relative}\\n    .tooltip{position:absolute;left:50%;transform:translateX(-50%);bottom:calc(100% + 8px);white-space:nowrap;background:#101827;color:#fff;font-size:12px;padding:8px 10px;border-radius:8px;display:none}\\n    .badge:hover .tooltip{display:block}\\n    footer{padding:26px;border-top:1px solid rgba(30,40,60,0.04);display:flex;justify-content:space-between;align-items:center}\\n\\n    /* decorative pattern */\\n    .pattern-wrap{position:fixed;right:0;top:0;bottom:0;width:320px;opacity:0.06;pointer-events:none}\\n    svg#decor{height:100%;width:100%}\\n\\n    /* responsive */\\n    @media (max-width:900px){.hero{grid-template-columns:1fr;padding:20px}.pattern-wrap{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern-wrap\\\" aria-hidden>\\n    <svg id=\\\"decor\\\" viewBox=\\\"0 0 200 800\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#8ad3c7\\\" />\\n          <stop offset=\\\"1\\\" stop-color=\\\"#6b8cff\\\" />\\n        </linearGradient>\\n        <pattern id=\\\"p1\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n          <rect width=\\\"40\\\" height=\\\"40\\\" fill=\\\"transparent\\\" />\\n          <path d=\\\"M0 20 Q10 8 20 20 T40 20\\\" stroke=\\\"url(#g1)\\\" stroke-width=\\\"1.6\\\" fill=\\\"none\\\" opacity=\\\"0.28\\\"/>\\n        </pattern>\\n      </defs>\\n      <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\" />\\n    </svg>\\n  </div>\\n\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">SB</div>\\n      <div>\\n        <div style=\\\"font-weight:800;color:#22314a\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:#6b7280\\\">Clinical, clear sound gatherings</div>\\n      </div>\\n    </div>\\n    <nav aria-label=\\\"Main navigation\\\">\\n      <a href=\\\"index.html\\\">Welcome</a>\\n      <a href=\\\"events.html\\\">Gatherings</a>\\n      <a href=\\\"private-sessions.html\\\">Solo Offerings</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"about.html\\\">Origins</a>\\n      <a href=\\\"faq.html\\\">FAQ</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <h1>Upcoming sound gatherings near {{CITY}}, {{STATE}}</h1>\\n        <p class=\\\"lead\\\">Small-group sessions with sustained, measured tones designed to support rest, nervous-system regulation, and gentle reflection. Open to all abilities; bring a mat and an intention.</p>\\n\\n        <div class=\\\"proof\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <strong style=\\\"color:#24314a\\\">Community reflections</strong>\\n            <small style=\\\"color:#93a0b3\\\">Real voices. Rotating.</small>\\n          </div>\\n          <div class=\\\"testimonial\\\" id=\\\"testimonial\\\">\\\"A calm template for evenings now—deeply settling and clear.\\\" — R.</div>\\n          <div class=\\\"badges\\\">\\n            <div class=\\\"badge\\\" tabindex=\\\"0\\\">Verified attendee\\n              <span class=\\\"tooltip\\\">Recorded check-ins from prior participants (anonymous)</span>\\n            </div>\\n            <div class=\\\"badge\\\" tabindex=\\\"0\\\">Clinically informed\\n              <span class=\\\"tooltip\\\">Practitioner experience in trauma-informed rhythm</span>\\n            </div>\\n            <div class=\\\"badge\\\" tabindex=\\\"0\\\">Small groups\\n              <span class=\\\"tooltip\\\">Max 18 people to ensure spaciousness</span>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:18px;display:flex;gap:10px\\\">\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Save my seat</a>\\n          <a style=\\\"padding:10px 14px;border-radius:10px;background:transparent;border:1px solid rgba(34,48,78,0.06);text-decoration:none;color:var(--muted);font-weight:700\\\" href=\\\"contact.html\\\">Ask a question</a>\\n        </div>\\n\\n        <div style=\\\"margin-top:18px;font-size:13px;color:#6b7280\\\">Contraindications: Sound work is relaxing for most people, but may be inappropriate for those with uncontrolled epilepsy, recent serious head injury, or sensitivity to strong vibrations. Contact {{EMAIL}} or {{PHONE}} for guidance before booking.</div>\\n\\n      </div>\\n\\n      <aside class=\\\"hero-card\\\">\\n        <div class=\\\"next-event\\\">\\n          <div class=\\\"meta\\\">Next Gathering</div>\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div class=\\\"cal-date\\\">Sat, Mar 6 • 6:00–7:20 PM</div>\\n              <div class=\\\"cal-title\\\">Evening Rest: long-form bowls • {{CITY}} location</div>\\n              <div class=\\\"meta\\\">Limited seating • Doors at 5:45 PM</div>\\n            </div>\\n            <div>\\n              <a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve</a>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"calendar\\\">\\n          <div class=\\\"cal-row\\\"><div><div class=\\\"cal-date\\\">Mar 13</div><div class=\\\"cal-title\\\">Midweek Reset • 7:00 PM</div></div><a class=\\\"cta\\\" href=\\\"book.html\\\" style=\\\"padding:8px 10px\\\">RSVP</a></div>\\n          <div class=\\\"cal-row\\\"><div><div class=\\\"cal-date\\\">Mar 20</div><div class=\\\"cal-title\\\">Sound & Breath • 6:30 PM</div></div><a class=\\\"cta\\\" href=\\\"book.html\\\" style=\\\"padding:8px 10px\\\">RSVP</a></div>\\n          <div class=\\\"cal-row\\\"><div><div class=\\\"cal-date\\\">Mar 28</div><div class=\\\"cal-title\\\">Full Moon Resonance • 8:00 PM</div></div><a class=\\\"cta\\\" href=\\\"book.html\\\" style=\\\"padding:8px 10px\\\">RSVP</a></div>\\n        </div>\\n\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"max-width:980px;margin:18px auto;padding:0 28px\\\">\\n      <div class=\\\"hero-card\\\">\\n        <h2 style=\\\"margin-top:0;color:#24314a\\\">How gatherings are structured</h2>\\n        <p style=\\\"color:#42506a\\\">Sessions begin with a grounded check-in, move through sustained tone work and guided rest, and close with an invitation to slow movement. Invitations are clinical and accessible: no required participation beyond presence.</p>\\n        <ul style=\\\"color:#5b6b7f\\\">\\n          <li>Doors open 15 minutes early to settle and orient.</li>\\n          <li>Sessions last 70–80 minutes; there is time for quiet integration.</li>\\n          <li>Minimum supplies: mat, blanket, eye covering.</li>\\n        </ul>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"font-size:13px;color:#6b7280\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}}</div>\\n    <div style=\\\"font-size:13px;color:#93a0b3\\\">© <span id=\\\"yr\\\"></span> {{BUSINESS_NAME}}</div>\\n  </footer>\\n\\n  <script>\\n    // year\\n    document.getElementById('yr').textContent = new Date().getFullYear();\\n\\n    // Testimonial rotator\\n    (function(){\\n      const items = [\\n        '\\\"A calm template for evenings now—deeply settling and clear.\\\" — R.',\\n        '\\\"Precise and steady tones, I left feeling levelheaded.\\\" — A.',\\n        '\\\"The structure made it easy to arrive and slow down.\\\" — M.',\\n        '\\\"Thoughtful pace and small circle; felt safe and restorative.\\\" — J.'\\n      ];\\n      let i=0; const el=document.getElementById('testimonial');\\n      function show(){ el.style.opacity=0; setTimeout(()=>{ el.textContent = items[i]; el.style.opacity=1; i=(i+1)%items.length; },300); }\\n      setInterval(show,4200);\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Solo Offerings — Private Sessions • {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#fbfcfe;--card:#fff;--muted:#263248;--accent:#6b8cff;--accent-2:#8ad3c7;--glass:rgba(255,255,255,0.75);font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial}\\n    body{margin:0;background:linear-gradient(180deg,#fbfcfe,#f6fbff);color:var(--muted)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 26px}\\n    .logo{display:flex;gap:12px;align-items:center}\\n    .logo .box{width:48px;height:48px;border-radius:8px;background:linear-gradient(135deg,var(--accent-2),var(--accent));color:white;display:flex;align-items:center;justify-content:center;font-weight:800}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none;font-weight:700}\\n    main{max-width:980px;margin:20px auto;padding:0 18px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:20px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(33,40,56,0.06)}\\n    h1{margin:0 0 8px;color:#22314a}\\n    .muted{color:#556575}\\n    .sessions{display:flex;flex-direction:column;gap:12px;margin-top:12px}\\n    .session-row{display:flex;justify-content:space-between;align-items:center;padding:12px;border-radius:10px;background:linear-gradient(180deg,#fff,#fbfdff)}\\n    .pill{background:#eef6ff;padding:6px 10px;border-radius:999px;color:#2b4aa1;font-weight:700}\\n    .badges{display:flex;gap:10px;margin-top:12px}\\n    .cred{padding:8px;border-radius:10px;background:linear-gradient(90deg,#fff,#f6fbff);font-size:13px;position:relative}\\n    .cred .tip{position:absolute;left:50%;transform:translateX(-50%);bottom:calc(100% + 8px);background:#0f1724;color:#fff;padding:8px;border-radius:8px;font-size:12px;display:none}\\n    .cred:hover .tip{display:block}\\n    .note{font-size:13px;color:#6b7280;margin-top:10px}\\n    footer{padding:18px 26px;color:#93a0b3}\\n\\n    @media (max-width:880px){.grid{grid-template-columns:1fr}.logo .box{width:44px;height:44px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\"><div class=\\\"box\\\">SB</div><div><div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div><div style=\\\"font-size:13px;color:#6b7280\\\">Private, focused sessions</div></div></div>\\n    <nav aria-label=\\\"site\\\">\\n      <a href=\\\"index.html\\\">Welcome</a>\\n      <a href=\\\"events.html\\\">Gatherings</a>\\n      <a href=\\\"private-sessions.html\\\">Solo Offerings</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"grid\\\">\\n      <div class=\\\"card\\\">\\n        <h1>Private Sessions</h1>\\n        <p class=\\\"muted\\\">One-on-one sessions tailored to regulation and short-term recalibration. Sessions combine focused sound protocols with clinically minded guidance.</p>\\n\\n        <div class=\\\"sessions\\\">\\n          <div class=\\\"session-row\\\">\\n            <div>\\n              <div style=\\\"font-weight:700;color:#24314a\\\">Intake + 60-minute session</div>\\n              <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Includes brief intake and tailored sound protocol</div>\\n            </div>\\n            <div style=\\\"text-align:right\\\"><div class=\\\"pill\\\">60 min</div><a href=\\\"book.html\\\" class=\\\"pill\\\" style=\\\"margin-left:8px;background:var(--accent);color:#fff\\\">Book</a></div>\\n          </div>\\n\\n          <div class=\\\"session-row\\\">\\n            <div>\\n              <div style=\\\"font-weight:700;color:#24314a\\\">Extended 90-minute session</div>\\n              <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Deeper integration with movement and dialogue</div>\\n            </div>\\n            <div style=\\\"text-align:right\\\"><div class=\\\"pill\\\">90 min</div><a href=\\\"book.html\\\" class=\\\"pill\\\" style=\\\"margin-left:8px;background:var(--accent);color:#fff\\\">Book</a></div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px\\\">\\n          <strong style=\\\"color:#24314a\\\">Clinical note</strong>\\n          <div class=\\\"note\\\">Private sessions are not a substitute for emergency mental-health services. If you are in crisis, contact local emergency services or your provider. Contraindications include uncontrolled epilepsy or recent traumatic brain injury; please consult before scheduling.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:16px\\\">\\n          <a href=\\\"contact.html\\\" style=\\\"text-decoration:none;padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;font-weight:700\\\">Schedule a private session</a>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <strong style=\\\"display:block;color:#24314a\\\">Proof Gallery & Credentials</strong>\\n        <div style=\\\"margin-top:10px;color:#556575\\\">Short excerpts from private-session feedback and professional affiliations.</div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <div style=\\\"background:#fff;padding:12px;border-radius:10px;min-height:72px\\\" id=\\\"pv\\\">\\\"A precise, anchored approach—exactly what I needed to feel present again.\\\" — S.</div>\\n        </div>\\n\\n        <div class=\\\"badges\\\" style=\\\"margin-top:12px\\\">\\n          <div class=\\\"cred\\\">Licensed Practitioner\\n            <div class=\\\"tip\\\">Clinical license and continuing education in trauma-informed care</div>\\n          </div>\\n          <div class=\\\"cred\\\">20+ years practice\\n            <div class=\\\"tip\\\">Two decades of somatic and sound work across community and clinic</div>\\n          </div>\\n          <div class=\\\"cred\\\">Peer-reviewed programs\\n            <div class=\\\"tip\\\">Contributing faculty for community mental-health trainings</div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;font-size:13px;color:#6b7280\\\">Testimonials rotate to show breadth of feedback; badges include short tooltips on hover for verification.</div>\\n\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"max-width:980px;margin:18px auto;padding:0 18px\\\">\\n      <div class=\\\"card\\\">\\n        <h2 style=\\\"margin-top:0;color:#24314a\\\">How a private session unfolds</h2>\\n        <ol style=\\\"color:#5b6b7f\\\">\\n          <li>Brief intake to set goals and screen for contraindications.</li>\\n          <li>Focused sound protocol tailored to regulation capacity.</li>\\n          <li>Integration and practical strategies for home use.</li>\\n        </ol>\\n        <div style=\\\"margin-top:12px;color:#6b7280\\\">You will receive a concise home-plan after longer sessions if desired.</div>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"padding:18px 26px;color:#93a0b3\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n  </footer>\\n\\n  <script>\\n    // Simple rotator for proof gallery\\n    (function(){\\n      const items = [\\n        '\\\"A precise, anchored approach—exactly what I needed to feel present again.\\\" — S.',\\n        '\\\"Clear protocol, gentle delivery, and useful takeaways.\\\" — L.',\\n        '\\\"Professional, calm, and adaptably paced.\\\" — H.'\\n      ];\\n      let idx=0;const el=document.getElementById('pv');\\n      setInterval(()=>{ el.style.opacity=0; setTimeout(()=>{ el.textContent=items[idx]; el.style.opacity=1; idx=(idx+1)%items.length; },300); },3800);\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investment — Plans & Packages • {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#f7fbfc;--card:#fff;--muted:#23314a;--accent:#6b8cff;--accent-2:#8ad3c7;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial}\\n    body{margin:0;background:var(--bg);color:var(--muted)}\\n    header{display:flex;justify-content:space-between;padding:18px 24px}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none;font-weight:700}\\n    main{max-width:980px;margin:22px auto;padding:0 18px}\\n    .hero{background:linear-gradient(180deg,#fff,#fbfdff);padding:22px;border-radius:12px;box-shadow:0 8px 20px rgba(20,30,60,0.04)}\\n    h1{margin:0 0 6px}\\n    .muted{color:#54657a}\\n    .toggle{display:inline-flex;background:#eef5ff;border-radius:999px;padding:6px;border:1px solid rgba(34,48,78,0.04);gap:6px;margin-top:12px}\\n    .toggle button{background:transparent;border:0;padding:8px 12px;border-radius:999px;font-weight:700;cursor:pointer}\\n    .toggle button.active{background:var(--accent);color:#fff}\\n    .plans{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .plan{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(33,40,56,0.05);text-align:center}\\n    .price{font-size:26px;color:#24314a;font-weight:800}\\n    .note{font-size:13px;color:#6b7280;margin-top:8px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;background:var(--accent);color:#fff;border-radius:10px;text-decoration:none;font-weight:800}\\n\\n    @media(max-width:920px){.plans{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Welcome</a>\\n      <a href=\\\"events.html\\\">Gatherings</a>\\n      <a href=\\\"private-sessions.html\\\">Solo Offerings</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <h1>Plans and single-session packages</h1>\\n      <div class=\\\"muted\\\">Choice depending on frequency: occasional single sessions, condensed packages, or a modest monthly plan for regular access.</div>\\n\\n      <div style=\\\"margin-top:16px\\\">\\n        <div style=\\\"font-size:13px;color:#556575\\\">Compare pricing</div>\\n        <div class=\\\"toggle\\\" role=\\\"tablist\\\" aria-label=\\\"Pricing toggle\\\">\\n          <button id=\\\"monthlyBtn\\\" class=\\\"active\\\">Monthly</button>\\n          <button id=\\\"packageBtn\\\">Package</button>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"plans\\\" id=\\\"plans\\\">\\n        <div class=\\\"plan\\\">\\n          <div style=\\\"font-weight:700\\\">Starter</div>\\n          <div class=\\\"price\\\" data-month=\\\"35\\\" data-package=\\\"150\\\">$35</div>\\n          <div class=\\\"note\\\">Single shorter session or drop-in rate. Package: 5 sessions.</div>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Book Starter</a>\\n        </div>\\n\\n        <div class=\\\"plan\\\">\\n          <div style=\\\"font-weight:700\\\">Regular</div>\\n          <div class=\\\"price\\\" data-month=\\\"95\\\" data-package=\\\"420\\\">$95</div>\\n          <div class=\\\"note\\\">Monthly access to one gathering + member scheduling window. Package: 5 sessions with priority booking.</div>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Choose Regular</a>\\n        </div>\\n\\n        <div class=\\\"plan\\\">\\n          <div style=\\\"font-weight:700\\\">Focused Package</div>\\n          <div class=\\\"price\\\" data-month=\\\"180\\\" data-package=\\\"820\\\">$180</div>\\n          <div class=\\\"note\\\">For ongoing private work or concentrated series. Package: 10 sessions.</div>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Select Package</a>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:12px;font-size:13px;color:#6b7280\\\">All rates are introductory and subject to change. For sliding-scale options, contact <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</div>\\n\\n      <div style=\\\"margin-top:10px;color:#556575\\\">Contraindications: If you have epilepsy, recent concussion, or are pregnant and uncertain, please consult with us at {{PHONE}} or {{EMAIL}} before booking.</div>\\n\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div style=\\\"max-width:980px;margin:0 auto;padding:0 18px\\\">\\n        <div style=\\\"background:#fff;padding:18px;border-radius:12px;box-shadow:0 6px 16px rgba(30,40,60,0.04)\\\">\\n          <h3 style=\\\"margin-top:0\\\">Pricing notes</h3>\\n          <p style=\\\"color:#556575\\\">The toggle above switches between an ongoing monthly framing and an upfront package framing. Numbers animate to reflect the chosen model; packages show the total for a block of sessions.</p>\\n          <ul style=\\\"color:#5b6b7f\\\">\\n            <li>Monthly plans offer consistent access and a flexible cancellation window.</li>\\n            <li>Packages are prepaid blocks for committed work and include scheduling priority.</li>\\n            <li>Private sessions are scheduled separately and billed as indicated above.</li>\\n          </ul>\\n        </div>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"padding:18px 24px;color:#93a0b3\\\">Questions about a plan? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}}</footer>\\n\\n  <script>\\n    // Pricing comparator with animated numbers\\n    (function(){\\n      const monthlyBtn=document.getElementById('monthlyBtn');\\n      const packageBtn=document.getElementById('packageBtn');\\n      const prices=document.querySelectorAll('.price');\\n      let mode='month';\\n\\n      function animate(el, start, end, duration=700){\\n        const startTime = performance.now();\\n        function step(now){\\n          const t = Math.min(1,(now-startTime)/duration);\\n          const val = Math.round(start + (end-start)*t);\\n          el.textContent = '$' + val;\\n          if(t<1) requestAnimationFrame(step);\\n        }\\n        requestAnimationFrame(step);\\n      }\\n\\n      function setMode(m){\\n        mode=m;\\n        monthlyBtn.classList.toggle('active', mode==='month');\\n        packageBtn.classList.toggle('active', mode==='package');\\n        prices.forEach(p=>{\\n          const target = mode==='month' ? Number(p.getAttribute('data-month')) : Number(p.getAttribute('data-package'));\\n          const current = Number(p.textContent.replace(/[^0-9]/g,'')) || 0;\\n          animate(p,current,target);\\n        });\\n      }\\n\\n      monthlyBtn.addEventListener('click',()=>setMode('month'));\\n      packageBtn.addEventListener('click',()=>setMode('package'));\\n\\n      // init\\n      setMode('month');\\n    })();\\n  </script>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
