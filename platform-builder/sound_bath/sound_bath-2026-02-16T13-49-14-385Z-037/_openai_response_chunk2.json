          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Soothing Gatherings — Events | {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#08060a;--ink:#f6f3f7;--muted:#bfb6c6;--accent:#a58cff;--glass:rgba(255,255,255,0.06)}\\n    *{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,\\\"Noto Sans\\\",sans-serif;background:linear-gradient(180deg,var(--bg),#0b0710 60%);color:var(--ink);line-height:1.5}\\n    header{position:sticky;top:0;backdrop-filter:blur(6px);background:linear-gradient(180deg,rgba(8,6,10,0.65),transparent);z-index:30;padding:14px 28px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#c9b6ff44,#6fb3ff22);display:grid;place-items:center;font-weight:700;color:var(--ink)}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:15px}\\n    nav a.active{color:var(--ink);font-weight:600}\\n    .wrap{max-width:1100px;margin:36px auto;padding:36px}\\n    .hero{display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:stretch}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:14px;padding:26px;box-shadow:0 8px 30px rgba(5,3,10,0.6);border:1px solid rgba(255,255,255,0.03)}\\n    h1{margin:0 0 10px;font-size:32px;letter-spacing:-0.4px}\\n    p.lead{color:var(--muted);margin:0 0 18px}\\n    .next{background:linear-gradient(90deg,var(--accent),#6fd3ff);padding:18px;border-radius:12px;color:#0b0710;font-weight:700}\\n    .calendar{margin-top:14px;display:flex;flex-direction:column;gap:10px}\\n    .evt{display:flex;justify-content:space-between;align-items:center;padding:12px;border-radius:10px;background:var(--glass)}\\n    .evt small{color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:20px}\\n    ul{margin:0;padding-left:18px;color:var(--muted)}\\n    .pillars{display:flex;gap:12px;flex-wrap:wrap}\\n    .pill{background:linear-gradient(180deg,rgba(165,140,255,0.08),transparent);padding:12px;border-radius:10px;color:var(--ink);min-width:150px}\\n    .case{margin-top:18px;padding:14px;border-radius:10px;background:linear-gradient(180deg,#ffffff05,transparent);color:var(--muted)}\\n    footer.cta{margin-top:28px;background:linear-gradient(90deg,#2a1633,rgba(165,140,255,0.06));padding:18px;border-radius:12px;display:flex;justify-content:space-between;align-items:center}\\n    a.btn{background:var(--accent);color:#07040b;padding:12px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    /* decorative SVG layer */\\n    .bg-svg{position:fixed;right:-10%;top:-8%;width:60vmax;height:60vmax;opacity:0.12;filter:blur(18px);pointer-events:none}\\n    .faq{margin-top:20px}\\n    details{background:var(--glass);padding:12px;border-radius:10px;margin-bottom:8px}\\n    @media(max-width:900px){.hero{grid-template-columns:1fr;}.bg-svg{display:none}.wrap{padding:18px}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 600 600\\\" preserveAspectRatio=\\\"xMidYMid slice\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#bba4ff\\\" />\\n        <stop offset=\\\"1\\\" stop-color=\\\"#79e0ff\\\" />\\n      </linearGradient>\\n      <pattern id=\\\"pt\\\" width=\\\"80\\\" height=\\\"80\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(25)\\\">\\n        <rect width=\\\"80\\\" height=\\\"80\\\" fill=\\\"none\\\" />\\n        <circle cx=\\\"10\\\" cy=\\\"10\\\" r=\\\"3\\\" fill=\\\"url(#g1)\\\" />\\n        <circle cx=\\\"50\\\" cy=\\\"50\\\" r=\\\"2\\\" fill=\\\"#fff\\\" opacity=\\\"0.6\\\" />\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#pt)\\\" />\\n  </svg>\\n  <header>\\n    <div class=\\\"brand\\\"><div class=\\\"logo\\\">SB</div><div>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n    </div></div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\" class=\\\"active\\\">Gatherings</a>\\n      <a href=\\\"private-sessions.html\\\">Private Offerings</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"about.html\\\">About</a>\\n    </nav>\\n  </header>\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero card\\\" aria-labelledby=\\\"h-main\\\">\\n      <div>\\n        <h1 id=\\\"h-main\\\">Public Sound Baths & Community Gatherings</h1>\\n        <p class=\\\"lead\\\">An evening of layered resonance — held in gentle darkness, guided breathing, and immersive sound. Ideal for both first-timers and returning listeners.</p>\\n        <div class=\\\"pillars\\\">\\n          <div class=\\\"pill\\\">Sensory-first</div>\\n          <div class=\\\"pill\\\">Curated journey</div>\\n          <div class=\\\"pill\\\">Accessible comfort</div>\\n        </div>\\n        <div class=\\\"grid\\\">\\n          <div>\\n            <h3 style=\\\"margin-top:10px\\\">What to expect</h3>\\n            <ul>\\n              <li>Arrival & grounding: soft tea and settling</li>\\n              <li>Guided breathwork and intention setting</li>\\n              <li>Main soundscape (45–60 mins) with gentle transition</li>\\n              <li>Soft re-emergence and optional sharing circle</li>\\n            </ul>\\n          </div>\\n          <div>\\n            <h3 style=\\\"margin-top:10px\\\">Contraindications</h3>\\n            <p style=\\\"color:var(--muted)\\\">High-volume gongs or vibrations may not suit those with recent head injury, pregnancy past first trimester without prior clearance, implanted medical devices, or uncontrolled seizures. Please contact us: {{EMAIL}} for personalized guidance.</p>\\n          </div>\\n        </div>\\n      </div>\\n      <aside class=\\\"card\\\" style=\\\"align-self:start\\\">\\n        <div class=\\\"next\\\">Next event: <div style=\\\"font-size:18px;margin-top:6px\\\">{{NEXT_EVENT_DATE}}</div></div>\\n        <div class=\\\"calendar\\\">\\n          <div class=\\\"evt\\\"><div><strong>Sat • Feb</strong><div style=\\\"font-size:12px;color:var(--muted)\\\">Community Sound Bath — {{VENUE_NAME}}</div></div><small>7:00pm — 8:30pm</small></div>\\n          <div class=\\\"evt\\\"><div><strong>Sun • Mar</strong><div style=\\\"font-size:12px;color:var(--muted)\\\">Midday Reset — {{VENUE_NAME}}</div></div><small>11:00am — 12:15pm</small></div>\\n          <div class=\\\"evt\\\"><div><strong>Fri • Apr</strong><div style=\\\"font-size:12px;color:var(--muted)\\\">New Moon Sound Journey</div></div><small>8:00pm — 9:30pm</small></div>\\n        </div>\\n        <div style=\\\"margin-top:14px\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"card\\\" aria-labelledby=\\\"myth\\\">\\n      <h2 id=\\\"myth\\\">Myths & Realities — Quick Notes</h2>\\n      <div style=\\\"display:flex;gap:12px;margin-top:10px\\\">\\n        <div style=\\\"flex:1\\\"><strong>Myth:</strong><p class=\\\"lead\\\" style=\\\"margin-top:6px;color:var(--muted)\\\">Sound baths are just background noise or \\\"sleepy music.\\\"</p></div>\\n        <div style=\\\"flex:1\\\"><strong>Truth:</strong><p class=\\\"lead\\\" style=\\\"margin-top:6px;color:var(--muted)\\\">They are intentional sonic environments designed to guide nervous system regulation and foster deep inward attention.</p></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" aria-labelledby=\\\"instruments\\\" style=\\\"margin-top:18px\\\">\\n      <h2 id=\\\"instruments\\\">Instruments & Textures</h2>\\n      <p class=\\\"lead\\\" style=\\\"margin-top:6px\\\">For public gatherings we blend crystalline tones with metallic resonance to create both clarity and body.</p>\\n      <ul>\\n        <li>Crystal singing bowls (harmonic overtones)</li>\\n        <li>Tibetan singing bowls (warm sustain)</li>\\n        <li>Soft chimes & ocean drum for transitional textures</li>\\n      </ul>\\n      <div class=\\\"case\\\">\\\"I arrived scattered and left wrapped in something like clarity.\\\" — Community attendee</div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n      <h2>Flow — How an evening moves</h2>\\n      <ol style=\\\"color:var(--muted)\\\">\\n        <li>Welcome & orientation (10–15 mins)</li>\\n        <li>Breathwork + intention (10 mins)</li>\\n        <li>Layered soundscape (45–60 mins)</li>\\n        <li>Soft landing & sharing (10–15 mins)</li>\\n      </ol>\\n      <p style=\\\"color:var(--muted);margin-top:8px\\\"><strong>What to bring:</strong> yoga mat or cushion, blanket for coverage, eye mask or scarf, water bottle. Optional: small bolster.</p>\\n    </section>\\n\\n    <section class=\\\"card faq\\\" aria-labelledby=\\\"faq\\\">\\n      <h2 id=\\\"faq\\\">FAQs</h2>\\n      <details>\\n        <summary>Do I need experience?</summary>\\n        <div style=\\\"padding-top:8px;color:var(--muted)\\\">No. Sessions are accessible; we guide you through settling practices and how to use props for comfort.</div>\\n      </details>\\n      <details>\\n        <summary>Are sessions loud?</summary>\\n        <div style=\\\"padding-top:8px;color:var(--muted)\\\">Volume is curated. Expect rich resonance but not the kind of sustained high volume; we prioritize comfort and safety.</div>\\n      </details>\\n      <details>\\n        <summary>How early should I arrive?</summary>\\n        <div style=\\\"padding-top:8px;color:var(--muted)\\\">Arrive 15–20 minutes early to settle, sign in, and choose a comfortable spot.</div>\\n      </details>\\n    </section>\\n\\n    <footer class=\\\"cta card\\\">\\n      <div>\\n        <div style=\\\"font-weight:700\\\">Reserve your spot in our next soundscape</div>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">Spaces are intentionally limited to preserve the immersive quality.</div>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a seat</a>\\n      </div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"}  \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Private Sessions — Tailored Sound | {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#061018;--ink:#f8f7fb;--muted:#c9c6d4;--accent:#ffd1a8}\\n    body{margin:0;background:radial-gradient(circle at 10% 10%,#0f1b2b,transparent 30%),linear-gradient(180deg,#041021,#061018);color:var(--ink);font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 28px;position:sticky;top:0;background:linear-gradient(180deg,rgba(4,6,12,0.6),transparent)}\\n    .logo{display:flex;gap:10px;align-items:center}\\n    nav a{margin-left:16px;color:var(--muted);text-decoration:none}\\n    nav a:nth-child(2){color:var(--ink);font-weight:600}\\n    main{max-width:1000px;margin:28px auto;padding:20px}\\n    .ribbon{display:flex;gap:18px;align-items:center}\\n    .lead-card{background:linear-gradient(180deg,rgba(255,210,168,0.06),transparent);padding:20px;border-radius:12px;border:1px solid rgba(255,210,168,0.06)}\\n    h1{margin:0;font-size:30px}\\n    .options{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .opt{background:linear-gradient(180deg,#ffffff06,transparent);padding:16px;border-radius:12px}\\n    .price{font-weight:700;color:var(--accent);margin-top:10px}\\n    .flow{margin-top:12px;color:var(--muted)}\\n    .faq{margin-top:18px}\\n    details{background:rgba(255,255,255,0.03);padding:12px;border-radius:10px;margin-bottom:10px}\\n    .svg-banner{width:100%;height:160px;border-radius:10px;overflow:hidden;margin-top:14px}\\n    @media(max-width:880px){.options{grid-template-columns:1fr}.ribbon{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\"><div style=\\\"width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,#ffd1a8,#ffa6d1);display:grid;place-items:center;font-weight:800;color:#081018\\\">{{FACILITATOR_NAME}}</div>\\n      <div style=\\\"font-size:14px\\\">Private Sessions — {{CITY}}, {{STATE}}</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"events.html\\\">Events</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n    </nav>\\n  </header>\\n  <main>\\n    <section class=\\\"lead-card\\\">\\n      <h1>Personalized Sound — 1:1, Couples & Corporate</h1>\\n      <p style=\\\"color:var(--muted)\\\">Bespoke sessions shaped for nervous system support, team clarity, or intimate shared listening. Sessions are led by {{FACILITATOR_NAME}} and can take place at {{VENUE_NAME}} or your chosen space.</p>\\n      <div class=\\\"svg-banner\\\">\\n        <svg viewBox=\\\"0 0 800 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n          <defs>\\n            <linearGradient id=\\\"lg2\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#ffd1a8\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#a58cff\\\"/></linearGradient>\\n            <pattern id=\\\"diag\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(30)\\\">\\n              <rect width=\\\"40\\\" height=\\\"40\\\" fill=\\\"none\\\"/>\\n              <path d=\\\"M0 20 L40 20\\\" stroke=\\\"#ffffff11\\\" stroke-width=\\\"2\\\"/>\\n            </pattern>\\n          </defs>\\n          <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#diag)\\\"/>\\n          <g opacity=\\\"0.9\\\">\\n            <circle cx=\\\"100\\\" cy=\\\"90\\\" r=\\\"70\\\" fill=\\\"url(#lg2)\\\" opacity=\\\"0.22\\\"/>\\n            <circle cx=\\\"380\\\" cy=\\\"120\\\" r=\\\"110\\\" fill=\\\"#6fffd622\\\" opacity=\\\"0.14\\\"/>\\n          </g>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div style=\\\"display:flex;gap:12px;align-items:center;justify-content:space-between\\\">\\n        <h2 style=\\\"margin:0\\\">Offerings</h2>\\n        <div style=\\\"color:var(--muted)\\\">Flexible lengths and travel options available</div>\\n      </div>\\n      <div class=\\\"options\\\">\\n        <div class=\\\"opt\\\">\\n          <h3>1:1 Deep Session</h3>\\n          <div class=\\\"price\\\">90 mins • starting rate</div>\\n          <p class=\\\"flow\\\">A private, attuned journey with personalized sound prescription. Great for sleep reset, trauma-informed regulation, or creative resets.</p>\\n        </div>\\n        <div class=\\\"opt\\\">\\n          <h3>Couples & Shared</h3>\\n          <div class=\\\"price\\\">75 mins • shared experience</div>\\n          <p class=\\\"flow\\\">A co-regulation experience for two: intentional listening exercises combined with synchronized soundscapes to foster connection.</p>\\n        </div>\\n        <div class=\\\"opt\\\">\\n          <h3>Corporate & Team</h3>\\n          <div class=\\\"price\\\">Custom duration • on-site</div>\\n          <p class=\\\"flow\\\">Short practices for clarity and reboot, or immersive half-day resets for teams. Includes light facilitation and optional intention sessions.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"lead-card\\\">\\n      <h2>Instruments used (private)</h2>\\n      <p style=\\\"color:var(--muted)\\\">We choose a palette tailored to the client and context — more intimate instruments are used in 1:1 to avoid overpowering vibrations.</p>\\n      <ul>\\n        <li>Tuning forks (precise pitch work)</li>\\n        <li>Monochord (gentle harmonic drone)</li>\\n        <li>Soft handpan textures & kelp chimes</li>\\n      </ul>\\n      <div style=\\\"color:var(--muted);margin-top:8px\\\">Contraindications and safety: please disclose implants, pregnancy status, or vestibular concerns before booking. For medical questions contact {{EMAIL}}.</div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"lead-card\\\">\\n      <h2>Session Flow (1:1)</h2>\\n      <ol style=\\\"color:var(--muted)\\\">\\n        <li>Intake conversation and settling (10–15m)</li>\\n        <li>Intentional breath sequence and posture guidance (5–10m)</li>\\n        <li>Layered sound application tailored to needs (40–60m)</li>\\n        <li>Slow re-entry and aftercare recommendations (10m)</li>\\n      </ol>\\n      <p style=\\\"color:var(--muted)\\\"><strong>What to bring:</strong> anything that helps you be comfortable — mat, blanket, pillow, eye-covering, water. Dress warmly.</p>\\n    </section>\\n\\n    <section class=\\\"faq\\\" style=\\\"margin-top:18px\\\">\\n      <h2>Private FAQs & Notes</h2>\\n      <details>\\n        <summary>Can you come to our office?</summary>\\n        <div style=\\\"padding-top:8px;color:var(--muted)\\\">Yes. Travel fees may apply. We bring minimal staging and ask for a quiet room with dim lighting.</div>\\n      </details>\\n      <details>\\n        <summary>Is this appropriate for team-building?</summary>\\n        <div style=\\\"padding-top:8px;color:var(--muted)\\\">Absolutely. Many teams use brief sound practices to reset attention or to close retreats. We can include guided reflection prompts.</div>\\n      </details>\\n      <details>\\n        <summary>How do I prep my space?</summary>\\n        <div style=\\\"padding-top:8px;color:var(--muted)\\\">A carpeted room or soft flooring helps. Minimal fluorescent lights, comfortable temperature, and a quiet buffer before/after are ideal.</div>\\n      </details>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px;display:flex;justify-content:space-between;gap:12px\\\">\\n      <div style=\\\"flex:1\\\" class=\\\"lead-card\\\">\\n        <strong>Book a consultation</strong>\\n        <p style=\\\"color:var(--muted);margin-top:8px\\\">We always start with a short consult to align goals and logistics. Answer a few questions and we'll follow up.</p>\\n      </div>\\n      <div style=\\\"width:240px\\\" class=\\\"lead-card\\\">\\n        <div style=\\\"font-weight:700\\\">Ready?</div>\\n        <a style=\\\"display:inline-block;margin-top:10px;padding:10px 12px;background:var(--accent);color:#081018;border-radius:8px;text-decoration:none;font-weight:700\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Request a booking</a>\\n      </div>\\n    </section>\\n  </main>\\n</body>\\n</html>\"}  \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Rates & Packages | {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#051015;--card:#08131a;--text:#eef0f5;--muted:#9aa3b3;--brand:#9be7ff}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg),#04060a);color:var(--text);font-family:Inter,system-ui,Segoe UI,Roboto,Arial}\\n    header{padding:16px 24px;display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);margin-left:12px;text-decoration:none}\\n    .container{max-width:980px;margin:28px auto;padding:20px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .tier{background:linear-gradient(90deg,#0b1116,#08131a);padding:14px;border-radius:10px;margin-bottom:12px}\\n    .price{font-size:18px;color:var(--brand);font-weight:700}\\n    ul{color:var(--muted)}\\n    .note{font-size:13px;color:var(--muted)}\\n    .svg-orn{position:relative;height:140px;margin-bottom:12px}\\n    footer{margin-top:18px;padding:14px;border-radius:10px;background:linear-gradient(90deg,#07121822,#07081711)}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}.svg-orn{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Schedule</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n  <main class=\\\"container\\\">\\n    <div class=\\\"grid\\\">\\n      <section>\\n        <div class=\\\"card\\\">\\n          <div class=\\\"svg-orn\\\">\\n            <svg viewBox=\\\"0 0 900 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" preserveAspectRatio=\\\"xMidYMid slice\\\">\\n              <defs>\\n                <linearGradient id=\\\"pg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#9be7ff\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#a58cff\\\"/></linearGradient>\\n              </defs>\\n              <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"900\\\" height=\\\"200\\\" fill=\\\"url(#pg)\\\" opacity=\\\"0.06\\\"/>\\n              <g fill=\\\"#ffffff20\\\">\\n                <circle cx=\\\"120\\\" cy=\\\"80\\\" r=\\\"60\\\" />\\n                <circle cx=\\\"420\\\" cy=\\\"120\\\" r=\\\"88\\\" />\\n                <circle cx=\\\"760\\\" cy=\\\"50\\\" r=\\\"40\\\" />\\n              </g>\\n            </svg>\\n          </div>\\n          <h2>Public Events — Per-person pricing</h2>\\n          <div class=\\\"tier\\\">\\n            <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n              <div>\\n                <div style=\\\"font-weight:700\\\">Standard Gathering</div>\\n                <div class=\\\"note\\\">90 mins • group setting</div>\\n              </div>\\n              <div class=\\\"price\\\">$35 — $50</div>\\n            </div>\\n            <div style=\\\"margin-top:8px;color:var(--muted)\\\">Sliding scale and community spots available. Booking closes 24 hours before event.</div>\\n          </div>\\n\\n          <div class=\\\"tier\\\">\\n            <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n              <div>\\n                <div style=\\\"font-weight:700\\\">Mini Reset (Midday)</div>\\n                <div class=\\\"note\\\">60 mins • gentle sound</div>\\n              </div>\\n              <div class=\\\"price\\\">$25</div>\\n            </div>\\n            <div style=\\\"margin-top:8px;color:var(--muted)\\\">Great for office groups or compact schedules.</div>\\n          </div>\\n\\n          <h3 style=\\\"margin-top:12px\\\">Private Session Rates</h3>\\n          <div class=\\\"tier\\\">\\n            <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n              <div><strong>1:1 Deep Session</strong><div class=\\\"note\\\">90 mins, includes consult</div></div>\\n              <div class=\\\"price\\\">$160</div>\\n            </div>\\n            <div style=\\\"margin-top:8px;color:var(--muted)\\\">Add-ons: travel, extended time, recording of guided elements (by request).</div>\\n          </div>\\n          <div class=\\\"tier\\\">\\n            <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n              <div><strong>Couples</strong><div class=\\\"note\\\">75 mins</div></div>\\n              <div class=\\\"price\\\">$220</div>\\n            </div>\\n          </div>\\n          <div class=\\\"tier\\\">\\n            <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n              <div><strong>Corporate / Group</strong><div class=\\\"note\\\">Custom, contact for quote</div></div>\\n              <div class=\\\"price\\\">Starts at $450</div>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\" class=\\\"note\\\">Deposit of 30% required for private bookings. Cancellations within 48 hours forfeit deposit except for emergency exceptions. For bespoke proposals, email {{EMAIL}} or call {{PHONE}}.</div>\\n\\n        </div>\\n      </section>\\n\\n      <aside class=\\\"card\\\">\\n        <h3>Why our pricing?</h3>\\n        <p class=\\\"note\\\">We keep groups intentionally small and invest in high-quality instruments and acoustic tuning. Pricing supports space rental, facilitator time, and careful curation.</p>\\n\\n        <h3 style=\\\"margin-top:12px\\\">Instrument palette (pricing page)</h3>\\n        <ul>\\n          <li>Singing bowls (varied alloys)</li>\\n          <li>Gong accents for slow crescendos</li>\\n          <li>Rainstick & kalimba for texture</li>\\n        </ul>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <a style=\\\"display:inline-block;padding:10px 12px;background:var(--brand);color:#041018;border-radius:8px;text-decoration:none;font-weight:700\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start your booking</a>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;font-size:13px;color:var(--muted)\\\">\\n          <strong>Accessibility & accommodations:</strong> Please let us know in advance about mobility needs, sensory sensitivities, or other accommodations so we can prepare the space.\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer style=\\\"margin-top:20px\\\" class=\\\"card\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <div style=\\\"font-weight:700\\\">Still curious?</div>\\n          <div class=\\\"note\\\">We offer a short discovery call to tailor a package to your needs. Book a call or send a note to {{EMAIL}}.</div>\\n        </div>\\n        <div>\\n          <a style=\\\"padding:10px 12px;background:#a58cff;color:#041018;border-radius:8px;text-decoration:none;font-weight:700\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Contact & Book</a>\\n        </div>\\n      </div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"}  \nBUNDLE_END"
        }
