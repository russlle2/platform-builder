          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#7B61FF;--muted:#F3F3FF;--text:#222;--glass:rgba(255,255,255,0.06);--card:#ffffff11}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:var(--text);background:linear-gradient(180deg,#0f0b1a 0%,#1a1026 60%);min-height:100vh;}\\n    a{color:inherit;text-decoration:none}\\n    header{position:relative;z-index:20}\\n    nav{display:flex;gap:18px;align-items:center;padding:28px 32px}\\n    .logo{font-weight:700;color:#fff;letter-spacing:0.6px}\\n    .nav-links{margin-left:auto;display:flex;gap:14px}\\n    .nav-links a{color:#e9e8ff;padding:10px 12px;border-radius:8px;font-size:14px}\\n    .nav-links a:hover{background:#ffffff0f}\\n\\n    /* split diagonal hero */\\n    .hero{position:relative;overflow:hidden;display:grid;grid-template-columns:1fr 540px;align-items:center;gap:24px;padding:64px 64px 40px}\\n    .hero .left{color:#fff;max-width:680px}\\n    .eyebrow{display:inline-block;background:linear-gradient(90deg,var(--accent),#FF7AB6);padding:6px 10px;border-radius:999px;font-weight:600;font-size:13px}\\n    h1{font-size:44px;line-height:1.02;margin:18px 0 12px}\\n    p.lead{opacity:0.94;font-size:18px;margin:0 0 24px}\\n    .cta-row{display:flex;gap:14px;align-items:center}\\n    .btn-primary{background:linear-gradient(90deg,var(--accent),#FF7AB6);color:#fff;padding:12px 18px;border-radius:12px;font-weight:700}\\n    .btn-ghost{border:1px solid rgba(255,255,255,0.08);padding:10px 14px;border-radius:10px;color:#fff}\\n\\n    /* diagonal panel */\\n    .hero .panel{position:relative;background:linear-gradient(180deg,rgba(255,255,255,0.03),rgba(255,255,255,0.01));backdrop-filter:blur(6px);padding:30px;border-radius:16px;height:420px;display:flex;flex-direction:column;justify-content:center;align-items:center}\\n    .split-diag{position:absolute;right:-10%;top:-10%;width:80%;height:120%;transform:skewX(-12deg);background:linear-gradient(160deg,rgba(123,97,255,0.18),rgba(255,122,182,0.07));filter:blur(26px);}\\n\\n    /* pillars */\\n    .pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding:48px 64px}\\n    .pillar{background:var(--card);padding:20px;border-radius:12px;color:#fff;border:1px solid rgba(255,255,255,0.04)}\\n    .pillar h3{margin:0 0 8px;font-size:16px}\\n    .pillar p{margin:0;opacity:0.9;font-size:14px}\\n\\n    /* myth vs truth */\\n    .myth-truth{display:flex;gap:18px;padding:36px 64px;align-items:stretch}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:22px;border-radius:12px;color:#fff;width:50%;border:1px solid rgba(255,255,255,0.035)}\\n    .card h4{margin:0 0 10px}\\n\\n    /* case notes */\\n    .case-notes{padding:36px 64px;display:flex;flex-direction:column;gap:14px}\\n    .note{background:linear-gradient(90deg,#ffffff09,#00000007);padding:18px;border-radius:12px;color:#fff;border:1px solid rgba(255,255,255,0.03)}\\n\\n    footer{padding:36px 64px;color:#ddd}\\n\\n    /* decorative SVG */\\n    .pattern{position:absolute;inset:0;opacity:0.12;mix-blend-mode:screen}\\n\\n    @media (max-width:980px){.hero{grid-template-columns:1fr;padding:36px 20px}.pillars{grid-template-columns:1fr}.myth-truth{flex-direction:column}.nav-links{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 800 600\\\" preserveAspectRatio=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#7B61FF\\\" stop-opacity=\\\"0.6\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#FF7AB6\\\" stop-opacity=\\\"0.4\\\"/></linearGradient>\\n      <pattern id=\\\"dots\\\" width=\\\"24\\\" height=\\\"24\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <circle cx=\\\"3\\\" cy=\\\"3\\\" r=\\\"1.4\\\" fill=\\\"#fff\\\" fill-opacity=\\\"0.06\\\"/>\\n        <circle cx=\\\"15\\\" cy=\\\"15\\\" r=\\\"1.4\\\" fill=\\\"#fff\\\" fill-opacity=\\\"0.03\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g1)\\\"/>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#dots)\\\"/>\\n    <g fill=\\\"#ffffff\\\" fill-opacity=\\\"0.02\\\">\\n      <circle cx=\\\"120\\\" cy=\\\"80\\\" r=\\\"120\\\"/>\\n      <circle cx=\\\"720\\\" cy=\\\"520\\\" r=\\\"180\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <nav>\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"nav-links\\\">\\n        <a href=\\\"index.html\\\">Gather</a>\\n        <a href=\\\"events.html\\\">Upcoming</a>\\n        <a href=\\\"private-sessions.html\\\">Sessions</a>\\n        <a href=\\\"pricing.html\\\">Invest</a>\\n        <a href=\\\"about.html\\\">Us</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </div>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"left\\\">\\n        <span class=\\\"eyebrow\\\">Immersive Sound</span>\\n        <h1>Crafted sound baths for deep rest — in {{CITY}}, {{STATE}}</h1>\\n        <p class=\\\"lead\\\">We design luminous sonic blankets with crystalline bowls, chimes, and harmonic strings. A premium sensory experience aimed at easing the nervous system and opening quiet spaces inside.</p>\\n        <div class=\\\"cta-row\\\">\\n          <a class=\\\"btn-primary\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a class=\\\"btn-ghost\\\" href=\\\"events.html\\\">See events</a>\\n        </div>\\n      </div>\\n      <div class=\\\"panel\\\" role=\\\"img\\\" aria-label=\\\"split diagonal visual\\\">\\n        <div class=\\\"split-diag\\\" aria-hidden=\\\"true\\\"></div>\\n        <svg width=\\\"120\\\" height=\\\"120\\\" viewBox=\\\"0 0 120 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" style=\\\"filter:drop-shadow(0 8px 24px rgba(0,0,0,0.4));\\\">\\n          <defs>\\n            <radialGradient id=\\\"r1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#fff\\\" stop-opacity=\\\"0.9\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#fff\\\" stop-opacity=\\\"0.02\\\"/></radialGradient>\\n          </defs>\\n          <circle cx=\\\"60\\\" cy=\\\"60\\\" r=\\\"42\\\" fill=\\\"url(#r1)\\\"/>\\n        </svg>\\n        <div style=\\\"margin-top:18px;color:#eef0ff;text-align:center;max-width:360px\\\">Sessions are intentionally limited — we focus on presence, comfort and curated resonance. Led by {{FACILITATOR_NAME}} at {{VENUE_NAME}}.</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"pillars\\\" aria-labelledby=\\\"pillars-heading\\\">\\n      <h2 id=\\\"pillars-heading\\\" style=\\\"grid-column:1/-1;color:#fff;margin:0 0 8px\\\">The pillars of our offering</h2>\\n      <div class=\\\"pillar\\\">\\n        <h3>Precision</h3>\\n        <p>Every tone is tuned, every pause intentional — we sculpt sound like light, to invite rest and release.</p>\\n      </div>\\n      <div class=\\\"pillar\\\">\\n        <h3>Sensory Curating</h3>\\n        <p>Soft lighting, plush mats, and tactile layers pair with instruments — tuning forks, chimes, and crystal bowls — for calm that’s palpable.</p>\\n      </div>\\n      <div class=\\\"pillar\\\">\\n        <h3>Care-forward Practice</h3>\\n        <p>Intake, accessibility adaptations, and a clear contraindications policy make our space safe for diverse bodies and needs.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"myth-truth\\\" aria-labelledby=\\\"myth-title\\\">\\n      <div class=\\\"card\\\">\\n        <h4 id=\\\"myth-title\\\">Myth</h4>\\n        <p>Sound baths are just background noise — or a one-size ritual that works the same for everyone.</p>\\n      </div>\\n      <div class=\\\"card\\\">\\n        <h4>Truth</h4>\\n        <p>They’re carefully-sequenced sonic journeys. We use different instruments (gongs, tuning forks, monochord) and pacing to support individual nervous systems and to invite deep rest.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"case-notes\\\">\\n      <h2 style=\\\"color:#fff;margin:0\\\">Notes from participants</h2>\\n      <div class=\\\"note\\\">\\\"I wept softly — then slept like I hadn’t in months. The tones felt like an inner tide.\\\" — A.</div>\\n      <div class=\\\"note\\\">\\\"The facilitation was attentive and discreet; adjustments made room for my knee brace and sensitivity.\\\" — M.</div>\\n    </section>\\n\\n    <section style=\\\"padding:36px 64px;color:#fff\\\">\\n      <h3>How sessions flow</h3>\\n      <ol style=\\\"margin:10px 0 0;padding-left:18px;line-height:1.6\\\">\\n        <li>Welcome + intake (5–10m) — a quiet check-in to note anything we should adapt.</li>\\n        <li>Settling phase with soft chimes and breath cues (10m).</li>\\n        <li>Main sound tapestry — crystal bowls, gong swells, and harmonic drones (30–40m).</li>\\n        <li>Return & integration — grounding tones, gentle movement, & tea (5–10m).</li>\\n      </ol>\\n    </section>\\n\\n    <section style=\\\"padding:24px 64px;display:flex;gap:18px;align-items:center\\\">\\n      <div style=\\\"flex:1;color:#fff\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">What to bring</h3>\\n        <ul style=\\\"margin:0;padding-left:20px;color:#e6e3ff\\\">\\n          <li>Comfortable layers and a light blanket</li>\\n          <li>Socks and any personal props (eye pillows, small cushions)</li>\\n          <li>Your curiosity — we provide mats & bolsters</li>\\n        </ul>\\n      </div>\\n      <div style=\\\"width:320px\\\">\\n        <a class=\\\"btn-primary\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book an experience</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>&copy; <strong>{{BUSINESS_NAME}}</strong> — {{CITY}}, {{STATE}}</div>\\n      <div><a href=\\\"contact.html\\\">Contact</a> &nbsp;•&nbsp; <a href=\\\"book.html\\\">Reserve</a></div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>FAQ — {{BUSINESS_NAME}}</title>\\n  <style>\\n    body{margin:0;background:radial-gradient(ellipse at top left,#0b0612 0%, #140d20 60%);color:#f2f2fb;font-family:Inter,system-ui,Arial;padding-bottom:80px}\\n    header{padding:22px 28px;display:flex;align-items:center}\\n    .logo{font-weight:700;color:#fff}\\n    nav{margin-left:auto}\\n    nav a{color:#d9d7ff;margin-left:14px}\\n    .hero{padding:48px 28px 12px;display:flex;gap:20px;align-items:center}\\n    .hero .title{max-width:820px}\\n    h1{margin:0;font-size:36px}\\n    p.lead{margin:8px 0 0;opacity:0.9}\\n\\n    .faq-grid{display:grid;grid-template-columns:1fr 360px;gap:20px;padding:20px 28px}\\n    .faq-list{background:linear-gradient(180deg,#ffffff06,#00000005);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    details{margin-bottom:12px;background:rgba(255,255,255,0.02);padding:14px;border-radius:10px}\\n    summary{font-weight:600;cursor:pointer}\\n    .aside{position:relative;border-radius:12px;padding:18px;background:linear-gradient(180deg,#1a0f2a,#12081a);border:1px solid rgba(255,255,255,0.03)}\\n\\n    .pill{display:inline-block;background:#ffffff08;padding:8px 10px;border-radius:999px;margin-top:10px}\\n    .cta{margin-top:18px}\\n\\n    footer{padding:28px;color:#cfcff8}\\n    @media(max-width:900px){.faq-grid{grid-template-columns:1fr}.nav{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Events</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Reach</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"title\\\">\\n        <h1>Questions you might hum</h1>\\n        <p class=\\\"lead\\\">Quick, clear answers about what happens in our baths, who should pause, and how to arrive so your experience is tender and luxurious.</p>\\n      </div>\\n      <div style=\\\"margin-left:auto;text-align:right\\\">\\n        <div class=\\\"pill\\\">Small groups • Intentional pace</div>\\n        <div style=\\\"font-size:13px;opacity:0.9;margin-top:8px\\\">Facilitator: {{FACILITATOR_NAME}}</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq-grid\\\">\\n      <div class=\\\"faq-list\\\" aria-label=\\\"FAQ list\\\">\\n        <details open>\\n          <summary>What is a sound bath & what will I feel?</summary>\\n          <p>It\\u2019s a guided, sonic session where we layer instruments such as tuning forks, chimes, and the monochord to support nervous-system downshift. People report relaxation, tingling, altered time perception, tears, and relief. Experiences vary each time.</p>\\n        </details>\\n\\n        <details>\\n          <summary>How long does a session run and what is the flow?</summary>\\n          <p>Typical small-group sessions run ~60 minutes: a brief intake (5-10m), gentle settling with breath and chime cues (10m), a main sound journey (35-40m), then soft grounding and optional tea (5-10m).</p>\\n        </details>\\n\\n        <details>\\n          <summary>What to bring?</summary>\\n          <p>Please bring: warm layers, socks, a favorite small blanket or eye pillow (if you have one). We provide mats, bolsters, and props, but personal items can make the experience cozier.</p>\\n        </details>\\n\\n        <details>\\n          <summary>Are there contraindications?</summary>\\n          <p>Yes. If you are pregnant in the first trimester, have uncontrolled epilepsy, recent surgery, a pacemaker, or are currently in acute psychiatric crisis, please consult your provider and our team before booking. Sound can be intense; we adapt practice but prioritize safety.</p>\\n        </details>\\n\\n        <details>\\n          <summary>Can I attend with injuries or mobility needs?</summary>\\n          <p>Absolutely. Tell us during intake so we can provide chairs, adjusted mat setups, or a shorter listening position. Accessibility is part of our care model.</p>\\n        </details>\\n\\n        <details>\\n          <summary>What instruments do you use?</summary>\\n          <p>We rotate instruments: crystal bowls, soft gongs, percussion chimes, and tuned singing bowls. Each session has its own palette curated for intention and resonance.</p>\\n        </details>\\n\\n        <details>\\n          <summary>Do you accept private or corporate bookings?</summary>\\n          <p>Yes. We offer private 1:1 sessions, couples, and workplace sound workshops designed to be restorative and brief. See Private Sessions for details.</p>\\n        </details>\\n      </div>\\n\\n      <aside class=\\\"aside\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">Before you arrive</h3>\\n        <p style=\\\"margin:0 0 10px\\\">Plan to turn phones off or to silent. Hydrate lightly; avoid heavy meals. Wear comfortable, layered clothing. If you\\u2019re traveling, arrive 10-15 minutes early.</p>\\n        <div class=\\\"cta\\\"><a style=\\\"background:linear-gradient(90deg,#7B61FF,#FF7AB6);padding:10px 14px;border-radius:10px;color:#fff;font-weight:700;text-decoration:none\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve your spot</a></div>\\n        <hr style=\\\"border:none;height:1px;background:#ffffff06;margin:12px 0;border-radius:2px\\\">\\n        <div style=\\\"font-size:13px;opacity:0.9\\\">Need a quick consult? Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"padding:20px 28px;max-width:900px;margin:0 auto\\\">\\n      <h3 style=\\\"margin-top:18px\\\">A note on sensory intensity</h3>\\n      <p style=\\\"opacity:0.95\\\">We intentionally craft crescendos and still points. If loud textures or low-frequency vibrations bother you, reach out before booking so we can tailor a gentler palette (more chimes, fewer gong swells).</p>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"padding:18px 28px;display:flex;justify-content:space-between;align-items:center;opacity:0.9\\\">\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n      <div><a href=\\\"book.html\\\">Book</a> &nbsp;•&nbsp; <a href=\\\"contact.html\\\">Contact</a></div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0d0713;--card:#121023}\\n    body{margin:0;background:linear-gradient(180deg,#0d0713,#120821);font-family:Inter,system-ui,Arial;color:#fff}\\n    header{display:flex;align-items:center;padding:18px 24px}\\n    .logo{font-weight:700}\\n    nav{margin-left:auto}\\n    nav a{color:#dcd9ff;margin-left:12px}\\n\\n    .wrap{max-width:980px;margin:28px auto;padding:24px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:20px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:20px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    h1{margin:0 0 8px}\\n    p.lead{margin:0 0 12px;opacity:0.95}\\n\\n    label{display:block;margin-top:10px;font-size:13px;opacity:0.95}\\n    input,select,textarea{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid #ffffff11;background:#00000040;color:#fff}\\n    textarea{min-height:92px}\\n    .row{display:flex;gap:8px}\\n    .small{flex:1}\\n    .btn{display:inline-block;margin-top:12px;padding:12px 14px;background:linear-gradient(90deg,#7B61FF,#FF7AB6);border-radius:10px;color:#fff;font-weight:700}\\n    .note{font-size:13px;opacity:0.85;margin-top:12px}\\n    .muted{opacity:0.8;font-size:13px}\\n    @media(max-width:920px){.grid{grid-template-columns:1fr}}  \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Events</a>\\n      <a href=\\\"private-sessions.html\\\">Sessions</a>\\n      <a href=\\\"faq.html\\\">FAQ</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <div class=\\\"grid\\\">\\n      <div>\\n        <div class=\\\"card\\\">\\n          <h1>Reserve a session</h1>\\n          <p class=\\\"lead\\\">Choose from group events or private intensives. If you need recommendations, leave the details in the notes and we\\u2019ll help pair you with the right format.</p>\\n\\n          <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"POST\\\">\\n            <label for=\\\"type\\\">Session type</label>\\n            <select id=\\\"type\\\" name=\\\"type\\\" required>\\n              <option value=\\\"group\\\">Group Sound Bath (60m)</option>\\n              <option value=\\\"private\\\">Private 1:1</option>\\n              <option value=\\\"couples\\\">Couples</option>\\n              <option value=\\\"corporate\\\">Corporate / Workshop</option>\\n            </select>\\n\\n            <div class=\\\"row\\\">\\n              <div class=\\\"small\\\">\\n                <label for=\\\"name\\\">Full name</label>\\n                <input id=\\\"name\\\" name=\\\"name\\\" required />\\n              </div>\\n              <div style=\\\"width:140px\\\">\\n                <label for=\\\"phone\\\">Phone</label>\\n                <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"{{PHONE}}\\\" />\\n              </div>\\n            </div>\\n\\n            <label for=\\\"email\\\">Email</label>\\n            <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required placeholder=\\\"{{EMAIL}}\\\" />\\n\\n            <label for=\\\"date\\\">Preferred date</label>\\n            <input id=\\\"date\\\" name=\\\"date\\\" type=\\\"date\\\" placeholder=\\\"{{NEXT_EVENT_DATE}}\\\" />\\n\\n            <label for=\\\"notes\\\">Notes / accessibility requests</label>\\n            <textarea id=\\\"notes\\\" name=\\\"notes\\\" placeholder=\\\"Mat, knee support, low-frequency sensitivity, etc.\\\"></textarea>\\n\\n            <div style=\\\"display:flex;gap:10px;align-items:center;margin-top:12px\\\">\\n              <button class=\\\"btn\\\" type=\\\"submit\\\">Confirm reservation</button>\\n              <a href=\\\"contact.html\\\" style=\\\"color:#dcd9ff;align-self:center\\\">Questions?</a>\\n            </div>\\n\\n            <p class=\\\"note\\\">By reserving you agree to our cancellation policy. Private sessions can be tailored for 1:1, couples, or corporate groups; mention your preference above.</p>\\n          </form>\\n        </div>\\n\\n        <div style=\\\"height:18px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0\\\">How a booking unfolds</h3>\\n          <ol style=\\\"margin:10px 0 0;padding-left:18px;color:#eae6ff\\\">\\n            <li>We confirm availability & intake via email.</li>\\n            <li>If adaptations are requested, we refine the sonic palette (e.g., more tuning forks, fewer gong swells).</li>\\n            <li>Arrive 10 minutes before start to settle. We provide mats, bolsters, and optional eye pillows.</li>\\n          </ol>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">Important health guidance</h3>\\n          <p class=\\\"muted\\\">Contraindications: If you are pregnant (first trimester), have a pacemaker, uncontrolled epilepsy, or recent surgery, please consult your provider and contact us before booking. If you are in acute psychiatric crisis, please prioritize clinical support.</p>\\n\\n          <h4 style=\\\"margin-top:12px\\\">What to bring</h4>\\n          <ul style=\\\"margin:6px 0 0;padding-left:18px;color:#eae6ff\\\">\\n            <li>Comfortable clothes and layered blankets</li>\\n            <li>Personal props (eye pillow, scarf, or small cushion)</li>\\n            <li>Water bottle</li>\\n          </ul>\\n\\n          <h4 style=\\\"margin-top:12px\\\">Instruments you might hear</h4>\\n          <p class=\\\"muted\\\">Each session differs. Expect a curated blend such as crystal bowls, a soft gong, and tuned singing bowls — chosen to support the intention of the evening.</p>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve now</a>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"height:16px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Policies & logistics</h4>\\n          <p class=\\\"muted\\\">Check-in opens 15 minutes prior. For cancellations please notify at least 48 hours in advance to receive a credit. Last-minute cancellations may be refunded at our discretion.</p>\\n          <p style=\\\"margin-top:10px;opacity:0.95\\\">Questions? Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</p>\\n        </div>\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <footer style=\\\"padding:18px 24px;color:#dcd9ff;display:flex;justify-content:space-between;align-items:center\\\">\\n    <div>&copy; {{BUSINESS_NAME}}</div>\\n    <div><a href=\\\"privacy.html\\\">Privacy</a> &nbsp;•&nbsp; <a href=\\\"contact.html\\\">Contact</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
