          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Gatherings & Events</title>\\n  <meta name=\\\"description\\\" content=\\\"A sequence of sound bath gatherings blending resonance and rest. Next event: {{NEXT_EVENT_DATE}}.\\\">\\n  <style>\\n    :root{--bg1:#0f1724;--bg2:#071021;--accent:#e7c9ff;--muted:#94a3b8;--card:#0b1320}\\n    *{box-sizing:border-box}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;color:#e6eef8;background:linear-gradient(180deg,var(--bg1),var(--bg2));-webkit-font-smoothing:antialiased}\\n    a{color:var(--accent);text-decoration:none}\\n    .wrap{max-width:980px;margin:48px auto;padding:32px}\\n    nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}\\n    .brand{font-weight:700;letter-spacing:0.6px}\\n    .navlinks{display:flex;gap:18px;font-size:14px;color:var(--muted)}\\n    header.hero{display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:start;margin-bottom:34px}\\n    .panel{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border:1px solid rgba(255,255,255,0.04);padding:26px;border-radius:14px;backdrop-filter:blur(6px)}\\n    .title{font-size:28px;margin:0 0 8px;color:#fff}\\n    .subtitle{color:var(--muted);margin:0 0 18px}\\n    .next{background:linear-gradient(90deg,#7b61ff33,#00d4ff22);padding:12px;border-radius:10px;border:1px solid rgba(255,255,255,0.03);display:flex;justify-content:space-between;align-items:center}\\n    .calendar{margin-top:18px}\\n    .event-item{display:flex;justify-content:space-between;padding:12px;border-radius:8px;background:rgba(255,255,255,0.015);margin-bottom:10px}\\n    .small{font-size:13px;color:var(--muted)}\\n    .social-proof{display:flex;gap:12px;align-items:center;margin:18px 0}\\n    .avatars{display:flex;gap:8px}\\n    .avatar{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#5eead4,#60a5fa);display:flex;align-items:center;justify-content:center;color:#04203a;font-weight:700}\\n    .benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:20px 0}\\n    .benefit{padding:14px;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);border:1px solid rgba(255,255,255,0.03)}\\n    .process{margin:22px 0}\\n    .step{display:flex;gap:12px;align-items:flex-start;margin-bottom:12px}\\n    .step .num{width:36px;height:36px;border-radius:8px;background:#0a1220;display:flex;align-items:center;justify-content:center;color:var(--accent);font-weight:700}\\n    .faq{margin:22px 0}\\n    .lead{display:flex;gap:12px;align-items:center;padding:18px;border-radius:12px;background:linear-gradient(90deg,#0b1220,rgba(124,58,237,0.06));border:1px solid rgba(124,58,237,0.12)}\\n    .cta{display:flex;gap:12px;margin-top:18px}\\n    .btn{padding:12px 16px;border-radius:10px;border:none;background:var(--accent);color:#071021;font-weight:700}\\n    .ghost{padding:12px 16px;border-radius:10px;background:transparent;border:1px solid rgba(255,255,255,0.06);color:var(--accent)}\\n    footer{margin:40px 0;color:var(--muted);font-size:13px}\\n    /* floating svg background */\\n    .bg-svg{position:fixed;inset:0;pointer-events:none;opacity:0.12}\\n    @media(max-width:880px){header.hero{grid-template-columns:1fr;}\\n      .benefits{grid-template-columns:1fr}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 1200 800\\\" preserveAspectRatio=\\\"xMidYMid slice\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#7b61ff\\\" stop-opacity=\\\"0.25\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#00d4ff\\\" stop-opacity=\\\"0.18\\\"/></linearGradient>\\n      <pattern id=\\\"p\\\" width=\\\"120\\\" height=\\\"120\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(20)\\\">\\n        <rect width=\\\"60\\\" height=\\\"60\\\" fill=\\\"#0f1724\\\"/>\\n        <circle cx=\\\"30\\\" cy=\\\"30\\\" r=\\\"10\\\" fill=\\\"#7b61ff\\\" fill-opacity=\\\"0.06\\\"/>\\n      </pattern>\\n      <filter id=\\\"blur\\\"><feGaussianBlur stdDeviation=\\\"30\\\"/></filter>\\n    </defs>\\n    <rect width=\\\"1200\\\" height=\\\"800\\\" fill=\\\"url(#p)\\\"/>\\n    <g filter=\\\"url(#blur)\\\">\\n      <ellipse cx=\\\"920\\\" cy=\\\"180\\\" rx=\\\"420\\\" ry=\\\"220\\\" fill=\\\"url(#g1)\\\"/>\\n      <ellipse cx=\\\"240\\\" cy=\\\"620\\\" rx=\\\"360\\\" ry=\\\"180\\\" fill=\\\"#5eead4\\\" fill-opacity=\\\"0.02\\\"/>\\n    </g>\\n  </svg>\\n  <div class=\\\"wrap\\\">\\n    <nav>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"navlinks\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Gatherings</a>\\n        <a href=\\\"private-sessions.html\\\">Private</a>\\n        <a href=\\\"pricing.html\\\">Invest</a>\\n      </div>\\n    </nav>\\n\\n    <header class=\\\"hero\\\">\\n      <div class=\\\"panel\\\">\\n        <h1 class=\\\"title\\\">An evening of held sound — public sound baths</h1>\\n        <p class=\\\"subtitle\\\">Join a curated series where tone and breath create space for gentle change. We hold silence in good company.</p>\\n        <div class=\\\"social-proof\\\">\\n          <div class=\\\"avatars\\\">\\n            <div class=\\\"avatar\\\">A</div>\\n            <div class=\\\"avatar\\\">M</div>\\n            <div class=\\\"avatar\\\">S</div>\\n          </div>\\n          <div class=\\\"small\\\">Rated 4.9 — community of seekers across {{CITY}}, {{STATE}}</div>\\n        </div>\\n        <div class=\\\"benefits\\\">\\n          <div class=\\\"benefit\\\"><strong>Deep rest</strong><div class=\\\"small\\\">Resonance helps nervous system regulation and restorative sleep.</div></div>\\n          <div class=\\\"benefit\\\"><strong>Centering</strong><div class=\\\"small\\\">A simple practice: show up, lie down, receive.</div></div>\\n          <div class=\\\"benefit\\\"><strong>Shared ritual</strong><div class=\\\"small\\\">Be seen by sound; leave with calm that lasts days.</div></div>\\n        </div>\\n\\n        <div class=\\\"process\\\">\\n          <div class=\\\"step\\\"><div class=\\\"num\\\">1</div><div><strong>Arrive</strong><div class=\\\"small\\\">Settle; tea and soft light.</div></div></div>\\n          <div class=\\\"step\\\"><div class=\\\"num\\\">2</div><div><strong>Set intention</strong><div class=\\\"small\\\">A brief guided centering to tune in.</div></div></div>\\n          <div class=\\\"step\\\"><div class=\\\"num\\\">3</div><div><strong>Sound journey</strong><div class=\\\"small\\\">Crystal bowls, gong, chimes weave a layered field.</div></div></div>\\n          <div class=\\\"step\\\"><div class=\\\"num\\\">4</div><div><strong>Return</strong><div class=\\\"small\\\">Slow emergence; water served; reflections invited.</div></div></div>\\n        </div>\\n\\n        <div class=\\\"faq\\\">\\n          <details>\\n            <summary class=\\\"small\\\">What to bring</summary>\\n            <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Yoga mat, blanket, pillow, eye mask. Dress warmly. We provide bolsters on request.</div>\\n          </details>\\n          <details style=\\\"margin-top:8px\\\">\\n            <summary class=\\\"small\\\">Contraindications</summary>\\n            <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Not recommended if you have photosensitive epilepsy, severe cardiovascular conditions, or are within 24 hours of stimulant medication without clinician approval. Always consult your healthcare provider.</div>\\n          </details>\\n        </div>\\n\\n        <div class=\\\"lead\\\">\\n          <div style=\\\"flex:1\\\">\\n            <strong>Next: {{NEXT_EVENT_DATE}}</strong>\\n            <div class=\\\"small\\\">Hosted at {{VENUE_NAME}} — doors open 30 minutes before.</div>\\n          </div>\\n          <div style=\\\"display:flex;flex-direction:column;gap:8px\\\">\\n            <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n            <a class=\\\"ghost\\\" href=\\\"contact.html\\\">Questions? Call {{PHONE}}</a>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"panel\\\">\\n        <div class=\\\"next\\\">\\n          <div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Upcoming gathering</div>\\n            <div style=\\\"font-weight:700\\\">{{NEXT_EVENT_DATE}}</div>\\n            <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">A curated sound field: crystal bowls, gong, wind chimes.</div>\\n          </div>\\n          <div style=\\\"text-align:right\\\"><div class=\\\"small\\\">{{CITY}}, {{STATE}}</div><div style=\\\"margin-top:6px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve</a></div></div>\\n        </div>\\n\\n        <div class=\\\"calendar\\\" aria-hidden=\\\"false\\\">\\n          <div class=\\\"event-item\\\"><div><strong>Feb 28</strong><div class=\\\"small\\\">Full-spectrum sound journey</div></div><div class=\\\"small\\\">Sold out</div></div>\\n          <div class=\\\"event-item\\\"><div><strong>Mar 14</strong><div class=\\\"small\\\">Lunar sound bath</div></div><div class=\\\"small\\\">Open</div></div>\\n          <div class=\\\"event-item\\\"><div><strong>Apr 4</strong><div class=\\\"small\\\">Morning restorative session</div></div><div class=\\\"small\\\">Tickets</div></div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;font-size:13px;color:var(--muted)\\\">\\n          Instruments: crystal singing bowls, gong, tuned chimes. Each gathering varies.\\n        </div>\\n      </aside>\\n    </header>\\n\\n    <section>\\n      <h3 style=\\\"margin:0 0 8px;color:#fff\\\">A short note on craft</h3>\\n      <p class=\\\"small\\\">Every gathering is composed like a short movement: introduction, unfolding resonance, soft peak, and reverent return. Sound is our scaffolding; breath is yours.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h3 style=\\\"color:#fff;margin:0 0 8px\\\">Frequently asked</h3>\\n      <div class=\\\"panel\\\" style=\\\"margin-top:10px\\\">\\n        <strong>Is prior experience required?</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">No. These events are accessible. Lay down, soften, receive.</div>\\n        <hr style=\\\"border:none;border-top:1px solid rgba(255,255,255,0.03);margin:12px 0\\\">\\n        <strong>How long does it last?</strong>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Typically 75–90 minutes including arrival and gentle return.</div>\\n      </div>\\n    </section>\\n\\n    <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:28px\\\">\\n      <div>\\n        <div class=\\\"small\\\">Ready to join the next sound field?</div>\\n        <div style=\\\"font-weight:700\\\">{{VENUE_NAME}} — limited mats available.</div>\\n      </div>\\n      <div class=\\\"cta\\\">\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <a class=\\\"ghost\\\" href=\\\"pricing.html\\\">See rates</a>\\n      </div>\\n    </div>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Private Sessions</title>\\n  <meta name=\\\"description\\\" content=\\\"1:1, couples, and corporate sound sessions tailored to your needs. Facilitation by {{FACILITATOR_NAME}}.\\\">\\n  <style>\\n    :root{--bg:#071022;--panel:#071826;--accent:#ffd6a5;--muted:#9fb4c9}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto;color:#eaf6ff;background:radial-gradient(1200px 600px at 10% 10%,rgba(255,214,165,0.04),transparent),var(--bg)}\\n    .container{max-width:920px;margin:48px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .logo{font-weight:700}\\n    .links{display:flex;gap:14px;color:var(--muted)}\\n    .panel{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .hero-grid{display:grid;grid-template-columns:1fr 300px;gap:20px;margin-top:18px}\\n    h1{margin:0 0 8px}\\n    .lead{color:var(--muted)}\\n    .offerings{margin-top:16px}\\n    .card{padding:14px;border-radius:10px;margin-bottom:12px;background:linear-gradient(90deg,rgba(255,214,165,0.03),transparent);border:1px solid rgba(255,214,165,0.04)}\\n    .flow{margin-top:12px}\\n    .flow li{margin-bottom:8px}\\n    .faq{margin-top:18px}\\n    .cta{display:flex;gap:10px;margin-top:12px}\\n    .btn{background:var(--accent);border-radius:10px;padding:10px 12px;color:#04121a;font-weight:700}\\n    .muted{color:var(--muted);font-size:14px}\\n    footer{margin-top:34px;color:var(--muted);font-size:13px}\\n    .svg-bg{position:fixed;right:0;bottom:0;opacity:0.08;pointer-events:none}\\n    @media(max-width:840px){.hero-grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"svg-bg\\\" width=\\\"420\\\" height=\\\"420\\\" viewBox=\\\"0 0 420 420\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"lg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#ffb4a2\\\" stop-opacity=\\\"0.18\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#ffd6a5\\\" stop-opacity=\\\"0.08\\\"/></linearGradient>\\n    </defs>\\n    <g>\\n      <circle cx=\\\"200\\\" cy=\\\"200\\\" r=\\\"160\\\" fill=\\\"url(#lg)\\\"/>\\n      <g transform=\\\"translate(60,60)\\\" fill=\\\"#071826\\\" opacity=\\\"0.06\\\">\\n        <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"60\\\" height=\\\"60\\\" rx=\\\"8\\\"/>\\n        <rect x=\\\"80\\\" y=\\\"40\\\" width=\\\"60\\\" height=\\\"60\\\" rx=\\\"8\\\"/>\\n      </g>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"links\\\"><a href=\\\"index.html\\\">Home</a><a href=\\\"events.html\\\">Gatherings</a><a href=\\\"pricing.html\\\">Rates</a></div>\\n    </header>\\n\\n    <section class=\\\"hero-grid\\\">\\n      <div>\\n        <div class=\\\"panel\\\">\\n          <h1>Private sound sessions</h1>\\n          <p class=\\\"lead\\\">Tailored resonance for individuals, couples, and teams — a held container for intention, healing, or deep rest.</p>\\n\\n          <div class=\\\"offerings\\\">\\n            <div class=\\\"card\\\">\\n              <strong>1:1 session</strong>\\n              <div class=\\\"muted\\\">A focused 75–90 minute session. Intention-setting, personalized sound field, and reflective closure.</div>\\n            </div>\\n            <div class=\\\"card\\\">\\n              <strong>Couples</strong>\\n              <div class=\\\"muted\\\">Shared experience designed to synchronize breath, calm the nervous system, and deepen presence together.</div>\\n            </div>\\n            <div class=\\\"card\\\">\\n              <strong>Corporate & retreats</strong>\\n              <div class=\\\"muted\\\">Short sessions or keynote soundings for groups, workshops, and retreat days. Scaled to your space.</div>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <strong>Instruments on rotation</strong>\\n            <div class=\\\"muted\\\">Tuning forks, monochord, koshi chimes — selection matched to intent.</div>\\n          </div>\\n\\n          <div style=\\\"margin-top:14px\\\">\\n            <strong>Contraindications</strong>\\n            <div class=\\\"muted\\\">If you use a pacemaker, have recent surgery, are pregnant without medical clearance, or are photosensitive, please consult your physician before booking.</div>\\n          </div>\\n\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\" class=\\\"panel\\\">\\n          <strong>What to bring</strong>\\n          <ul class=\\\"muted\\\" style=\\\"margin-top:8px;padding-left:18px\\\">\\n            <li>Mat or yoga mat</li>\\n            <li>Blanket and pillow</li>\\n            <li>Water bottle</li>\\n          </ul>\\n        </div>\\n\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div class=\\\"muted\\\">Facilitator</div>\\n              <div style=\\\"font-weight:700\\\">{{FACILITATOR_NAME}}</div>\\n            </div>\\n            <div style=\\\"text-align:right\\\">\\n              <div class=\\\"muted\\\">Private bookings</div>\\n              <div style=\\\"margin-top:8px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Request session</a></div>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\" class=\\\"muted\\\">Flow for private work:</div>\\n          <ol class=\\\"flow muted\\\" style=\\\"margin-top:8px;padding-left:18px\\\">\\n            <li>Brief intake (5–10 minutes)</li>\\n            <li>Intention-setting and breath alignment</li>\\n            <li>Targeted sound field (35–60 minutes)</li>\\n            <li>Gentle emergence and aftercare guidance</li>\\n          </ol>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <strong>Pricing snapshot</strong>\\n            <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Starting at $145 for 1:1. See full rates on the Rates page.</div>\\n          </div>\\n\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\" class=\\\"panel\\\">\\n          <strong>Why private?</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Focused attention means the sound supports your specific nervous system and intention. The arc of the session is crafted for you.</div>\\n          <div class=\\\"cta\\\" style=\\\"margin-top:12px\\\">\\n            <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n            <a class=\\\"ghost\\\" href=\\\"contact.html\\\" style=\\\"color:var(--muted);border:1px solid rgba(255,255,255,0.03);padding:10px 12px;border-radius:10px;text-decoration:none\\\">Contact</a>\\n          </div>\\n        </div>\\n\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"faq\\\">\\n      <h3 style=\\\"margin:6px 0\\\">Questions people often ask</h3>\\n      <div class=\\\"panel\\\" style=\\\"margin-top:10px\\\">\\n        <strong>Can a session be remote?</strong>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">We offer guided sound and emboldened ritual for people in-person. For remote accompaniment, inquire about custom pricing and format.</div>\\n        <hr style=\\\"border:none;border-top:1px solid rgba(255,255,255,0.03);margin:12px 0\\\">\\n        <strong>Do you travel for corporate bookings?</strong>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Yes, within a reasonable distance. Travel fees may apply.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"panel\\\">\\n      <strong>Lead magnet</strong>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Receive a short audio primer: \\\"5 minutes to arrive\\\" — a guided breath and bell to steady the system. Sign up and we’ll send it to {{EMAIL}}.</p>\\n      <div style=\\\"margin-top:10px\\\">\\n        <form action=\\\"/subscribe\\\" method=\\\"post\\\">\\n          <input name=\\\"email\\\" placeholder=\\\"Email\\\" style=\\\"padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);width:60%\\\"> <button class=\\\"btn\\\" type=\\\"submit\\\">Send</button>\\n        </form>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Rates & Packages</title>\\n  <meta name=\\\"description\\\" content=\\\"Packages for sound baths, private sessions, and corporate offerings. Transparent pricing for calm by design.\\\">\\n  <style>\\n    :root{--bg:#081019;--card:#0c1724;--accent:#9be7ff;--warm:#ffd6a5;--muted:#93a7bb}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,\\\"Segoe UI\\\",Roboto;color:#eaf7ff;background:linear-gradient(180deg,#03102a 0%,#071021 100%)}\\n    .container{max-width:980px;margin:48px auto;padding:26px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);margin-left:14px}\\n    h1{margin:12px 0 4px}\\n    .subtitle{color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:18px}\\n    .pkg{background:linear-gradient(180deg,rgba(155,231,255,0.02),transparent);padding:18px;border-radius:12px;border:1px solid rgba(155,231,255,0.04)}\\n    .price{font-weight:800;color:var(--accent);font-size:22px}\\n    .muted{color:var(--muted)}\\n    .note{margin-top:12px;padding:12px;border-radius:10px;background:linear-gradient(90deg,rgba(255,214,165,0.03),transparent);border:1px solid rgba(255,214,165,0.04)}\\n    .cta{margin-top:16px}\\n    .btn{background:var(--warm);color:#042029;padding:10px 12px;border-radius:10px;border:none;font-weight:700}\\n    .svgline{width:100%;height:120px;margin-top:22px;display:block}\\n    footer{margin-top:40px;color:var(--muted)}\\n    @media(max-width:920px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <nav><a href=\\\"index.html\\\">Home</a><a href=\\\"events.html\\\">Events</a><a href=\\\"private-sessions.html\\\">Private</a></nav>\\n      </div>\\n      <div style=\\\"text-align:right\\\">\\n        <div class=\\\"muted\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        <div style=\\\"margin-top:8px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Book now</a></div>\\n      </div>\\n    </header>\\n\\n    <main>\\n      <h1>Rates & packages</h1>\\n      <div class=\\\"subtitle\\\">Clear pricing so you can choose what best supports your rest. Contact for custom or corporate work.</div>\\n\\n      <section style=\\\"margin-top:18px\\\" class=\\\"grid\\\">\\n        <div class=\\\"pkg\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Public Gatherings</div>\\n              <div class=\\\"muted\\\" style=\\\"margin-top:4px\\\">Shared sound baths at {{VENUE_NAME}}</div>\\n            </div>\\n            <div class=\\\"price\\\">$35–$55</div>\\n          </div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:10px\\\">Includes full access, mat space, and short intention-setting. Sliding scale available for community seats.</div>\\n        </div>\\n\\n        <div class=\\\"pkg\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Private 1:1</div>\\n              <div class=\\\"muted\\\" style=\\\"margin-top:4px\\\">Personal session with facilitated sound.</div>\\n            </div>\\n            <div class=\\\"price\\\">From $145</div>\\n          </div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:10px\\\">Deep, focused work using tuning forks, monochord, and curated bowls. Includes pre-session intake.</div>\\n        </div>\\n\\n        <div class=\\\"pkg\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Couples & small groups</div>\\n              <div class=\\\"muted\\\" style=\\\"margin-top:4px\\\">Shared sessions for two or more.</div>\\n            </div>\\n            <div class=\\\"price\\\">$220–$380</div>\\n          </div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:10px\\\">Tools may include koshi chimes, crystal bowls, and breath guidance designed to harmonize the field.</div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"grid\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"pkg\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><div><div style=\\\"font-weight:700\\\">Corporate & Retreats</div><div class=\\\"muted\\\" style=\\\"margin-top:4px\\\">Short sessions, soundscapes, and keynote experiences.</div></div><div class=\\\"price\\\">Quote</div></div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:10px\\\">We design offerings for group flow, focusing on nervous system regulation and collective rest.</div>\\n        </div>\\n\\n        <div class=\\\"pkg\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><div><div style=\\\"font-weight:700\\\">Series Pass</div><div class=\\\"muted\\\" style=\\\"margin-top:4px\\\">6-session pass for regular practice.</div></div><div class=\\\"price\\\">$270</div></div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:10px\\\">Reserve your place across multiple gatherings; best for steady results.</div>\\n        </div>\\n\\n        <div class=\\\"pkg\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><div><div style=\\\"font-weight:700\\\">Donation/Community</div><div class=\\\"muted\\\" style=\\\"margin-top:4px\\\">Concessions available by request.</div></div><div class=\\\"price\\\">Varies</div></div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:10px\\\">We hold seats for those who cannot pay full price — email to inquire.</div>\\n        </div>\\n      </section>\\n\\n      <div class=\\\"note\\\">\\n        <strong>Flow & safety</strong>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Sessions typically follow: welcome + intake, sound field, slow emergence. If you have heart conditions, pregnancy, or implanted devices, please consult your clinician before attending.</div>\\n      </div>\\n\\n      <svg class=\\\"svgline\\\" viewBox=\\\"0 0 900 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" preserveAspectRatio=\\\"none\\\">\\n        <defs>\\n          <linearGradient id=\\\"lg2\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#9be7ff\\\" stop-opacity=\\\"0.18\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#ffd6a5\\\" stop-opacity=\\\"0.12\\\"/></linearGradient>\\n        </defs>\\n        <path d=\\\"M0 80 C200 0 400 160 900 40\\\" stroke=\\\"url(#lg2)\\\" stroke-width=\\\"18\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/>\\n      </svg>\\n\\n      <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap\\\">\\n        <div style=\\\"flex:1;min-width:220px\\\" class=\\\"panel\\\">\\n          <strong>Small gift — arrive sooner</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Book a private 1:1 and receive a brief recording to steady your system before arrival.</div>\\n        </div>\\n        <div style=\\\"min-width:220px;text-align:right\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px\\\">\\n        <h3 style=\\\"margin:6px 0\\\">Quick FAQs</h3>\\n        <div class=\\\"panel\\\" style=\\\"margin-top:10px\\\">\\n          <strong>Can I request specific instruments?</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Yes — when possible we’ll honor preferences. Typical instruments include crystal bowls, monocord, and tuning forks but we choose what best serves the session.\\n          </div>\\n          <hr style=\\\"border:none;border-top:1px solid rgba(255,255,255,0.03);margin:12px 0\\\">\\n          <strong>Payment & cancellation</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Full payment required to hold private bookings. Cancellations within 48 hours may be subject to a fee.</div>\\n        </div>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
