          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Gatherings & Events</title>\\n  <style>\\n    :root{--bg1:#0f1724;--bg2:#0b1220;--accent:#b88cff;--muted:#aeb8c3;--glass:rgba(255,255,255,0.06)}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;color:#eef2ff;background:linear-gradient(180deg,var(--bg1),var(--bg2));-webkit-font-smoothing:antialiased}\\n    .site{min-height:100vh;display:flex;flex-direction:column}\\n    header{position:relative;z-index:5;padding:20px 28px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,#8f6cff,#5be7d8);display:flex;align-items:center;justify-content:center;color:#071027;font-weight:700;box-shadow:0 6px 30px rgba(0,0,0,0.5)}\\n    nav{display:flex;gap:12px;align-items:center}\\n    nav a{color:rgba(255,255,255,0.9);text-decoration:none;padding:8px 12px;border-radius:10px;font-weight:600}\\n    nav a[href$=\\\"events.html\\\"]{background:linear-gradient(90deg,rgba(184,140,255,0.14),rgba(91,231,216,0.06));backdrop-filter:blur(6px)}\\n    main{flex:1}\\n    /* hero */\\n    .hero{position:relative;padding:54px 28px 36px;display:grid;grid-template-columns:1fr 420px;gap:28px;align-items:start}\\n    .hero .panel{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:18px;padding:28px;box-shadow:inset 0 1px 0 rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.03)}\\n    .hero h1{margin:0 0 8px;font-size:30px;line-height:1.05;color:#fff}\\n    .hero p.lead{margin:0 0 18px;color:var(--muted);max-width:54ch}\\n    .tag{display:inline-block;padding:8px 12px;background:linear-gradient(90deg,var(--accent),#5be7d8);color:#041021;border-radius:999px;font-weight:700}\\n    .next-card{padding:18px;border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border:1px solid rgba(255,255,255,0.03)}\\n    .calendar{margin-top:16px;display:flex;flex-direction:column;gap:10px}\\n    .cal-item{display:flex;justify-content:space-between;gap:12px;padding:12px;background:var(--glass);border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .muted{color:var(--muted);font-size:14px}\\n    /* sections */\\n    section{padding:30px 28px;border-top:1px solid rgba(255,255,255,0.02)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .pillars .item{display:flex;gap:12px;align-items:flex-start}\\n    .icon{width:42px;height:42px;border-radius:10px;background:linear-gradient(135deg,#6ea6ff,#9e79ff);display:flex;align-items:center;justify-content:center;color:#041021;font-weight:700}\\n    .faq .q{font-weight:700}\\n    footer{padding:36px 28px;color:var(--muted);font-size:14px}\\n    .cta{display:flex;gap:14px;align-items:center}\\n    .btn{padding:12px 18px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#5be7d8);color:#041021;font-weight:800;text-decoration:none}\\n    .muted-2{color:rgba(255,255,255,0.6)}\\n    /* svg backdrop */\\n    .bg-svg{position:absolute;inset:0;z-index:0;pointer-events:none;opacity:0.22}\\n    @media(max-width:980px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr 1fr}.brand .logo{width:48px;height:48px}}\\n    @media(max-width:640px){.grid{grid-template-columns:1fr}.hero{padding:30px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">SB</div>\\n        <div>\\n          <div style=\\\"font-weight:800;color:#fff\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav aria-label=\\\"site navigation\\\">\\n        <a href=\\\"index.html\\\">Gatherings</a>\\n        <a href=\\\"events.html\\\">Upcoming</a>\\n        <a href=\\\"private-sessions.html\\\">Private Sessions</a>\\n        <a href=\\\"pricing.html\\\">Rates</a>\\n        <a href=\\\"about.html\\\">Our Story</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <div class=\\\"hero\\\">\\n        <div class=\\\"panel\\\">\\n          <span class=\\\"tag\\\">Sound Bath · Live</span>\\n          <h1>Restore through curated resonance — group sound baths in {{CITY}}, {{STATE}}</h1>\\n          <p class=\\\"lead\\\">Join a guided, sensory-rich sound journey blending crystal bowls, chimes and gong textures. These events are designed for deep relaxation, nervous system regulation and subtle somatic release.</p>\\n          <div style=\\\"display:flex;gap:12px;align-items:center;margin-top:12px\\\">\\n            <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n            <a class=\\\"muted-2\\\" href=\\\"about.html\\\">Meet the facilitator</a>\\n          </div>\\n          <section style=\\\"margin-top:22px\\\">\\n            <h3 style=\\\"color:#fff;margin:0 0 8px\\\">What to bring</h3>\\n            <p class=\\\"muted\\\">Yoga mat or floor blanket, pillow, water, light layers, your curiosity. We provide bolsters, blankets and eye covers on request.</p>\\n          </section>\\n        </div>\\n\\n        <aside class=\\\"next-card\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div class=\\\"muted\\\">Next event</div>\\n              <div style=\\\"font-weight:800;font-size:18px;margin-top:6px\\\">{{NEXT_EVENT_DATE}}</div>\\n            </div>\\n            <div style=\\\"text-align:right\\\">\\n              <div class=\\\"muted\\\">Venue</div>\\n              <div style=\\\"font-weight:700\\\">{{VENUE_NAME}}</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"calendar\\\">\\n            <div class=\\\"cal-item\\\">\\n              <div>\\n                <div style=\\\"font-weight:700\\\">{{NEXT_EVENT_DATE}} — Evening Sound Bath</div>\\n                <div class=\\\"muted\\\">Doors 6:15pm · Begins 6:45pm</div>\\n              </div>\\n              <div style=\\\"align-self:center\\\">\\n                <a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve</a>\\n              </div>\\n            </div>\\n            <div class=\\\"cal-item\\\">\\n              <div>\\n                <div style=\\\"font-weight:700\\\">2026-03-08 — Midday Sound Bath</div>\\n                <div class=\\\"muted\\\">Intention: Grounding</div>\\n              </div>\\n              <div style=\\\"align-self:center\\\"><a href=\\\"events.html\\\" style=\\\"color:#cbd5e1;text-decoration:none\\\">Details</a></div>\\n            </div>\\n            <div class=\\\"cal-item\\\">\\n              <div>\\n                <div style=\\\"font-weight:700\\\">2026-04-12 — New Moon Ceremony</div>\\n                <div class=\\\"muted\\\">Limited seating</div>\\n              </div>\\n              <div style=\\\"align-self:center\\\"><a href=\\\"book.html\\\" class=\\\"btn\\\">Book</a></div>\\n            </div>\\n          </div>\\n        </aside>\\n\\n        <svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 800 600\\\" preserveAspectRatio=\\\"xMidYMid slice\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n          <defs>\\n            <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#6f5bff\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#56ecd6\\\"/></linearGradient>\\n            <filter id=\\\"f1\\\" x=\\\"-50%\\\" y=\\\"-50%\\\" width=\\\"200%\\\" height=\\\"200%\\\"><feGaussianBlur stdDeviation=\\\"32\\\" result=\\\"b\\\"/></filter>\\n          </defs>\\n          <g filter=\\\"url(#f1)\\\" opacity=\\\"0.9\\\">\\n            <circle cx=\\\"120\\\" cy=\\\"80\\\" r=\\\"140\\\" fill=\\\"url(#g1)\\\"/>\\n            <ellipse cx=\\\"680\\\" cy=\\\"440\\\" rx=\\\"220\\\" ry=\\\"120\\\" fill=\\\"#7cc7ff\\\" opacity=\\\"0.18\\\"/>\\n            <path d=\\\"M400 0 C460 120 600 120 760 0 L760 600 L0 600 L0 0 Z\\\" fill=\\\"#a88cff\\\" opacity=\\\"0.06\\\"/>\\n          </g>\\n        </svg>\\n      </div>\\n\\n      <section id=\\\"myth_vs_truth\\\">\\n        <h2 style=\\\"margin-top:0;color:#fff\\\">Myths & reality: what a sound bath actually is</h2>\\n        <div style=\\\"display:flex;gap:18px;flex-wrap:wrap;margin-top:12px\\\">\\n          <div style=\\\"flex:1;min-width:260px\\\" class=\\\"card\\\">\\n            <div style=\\\"font-weight:800\\\">Myth: It’s just ambient vibes</div>\\n            <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Reality: A carefully paced ritual designed by a practitioner to guide breath, sensation and attention — sound is the vehicle, intention is the map.</div>\\n          </div>\\n          <div style=\\\"flex:1;min-width:260px\\\" class=\\\"card\\\">\\n            <div style=\\\"font-weight:800\\\">Myth: You have to be spiritual</div>\\n            <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Reality: Sound baths are accessible: many attend for stress relief, improved sleep patterns, and nervous-system regulation without any spiritual commitment.</div>\\n          </div>\\n          <div style=\\\"flex:1;min-width:260px\\\" class=\\\"card\\\">\\n            <div style=\\\"font-weight:800\\\">Myth: It’s dangerous if you have conditions</div>\\n            <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Reality: Contraindications exist — see disclaimer below — but most people participate safely when they communicate medical needs in advance.</div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section id=\\\"pillars\\\" class=\\\"pillars\\\">\\n        <h2 style=\\\"color:#fff\\\">Three pillars of our events</h2>\\n        <div style=\\\"display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:14px\\\">\\n          <div class=\\\"card\\\">\\n            <div class=\\\"item\\\"><div class=\\\"icon\\\">S</div><div>\\n              <div style=\\\"font-weight:800\\\">Sensory Design</div>\\n              <div class=\\\"muted\\\">Deliberate layering of timbre and silence for depth and clarity.</div>\\n            </div></div>\\n          </div>\\n          <div class=\\\"card\\\">\\n            <div class=\\\"item\\\"><div class=\\\"icon\\\">G</div><div>\\n              <div style=\\\"font-weight:800\\\">Gentle Guidance</div>\\n              <div class=\\\"muted\\\">Verbal cues, breathwork and moments of stillness to support integration.</div>\\n            </div></div>\\n          </div>\\n          <div class=\\\"card\\\">\\n            <div class=\\\"item\\\"><div class=\\\"icon\\\">C</div><div>\\n              <div style=\\\"font-weight:800\\\">Comfort First</div>\\n              <div class=\\\"muted\\\">Accessible seating, adjustable temperature, and optional eye coverings.</div>\\n            </div></div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section id=\\\"case_notes\\\">\\n        <h2 style=\\\"color:#fff\\\">Flow: what you can expect</h2>\\n        <ol class=\\\"muted\\\" style=\\\"margin-top:12px\\\">\\n          <li>Arrival & settling (10–15 min): gentle arrival music, orientation and space for questions.</li>\\n          <li>Opening: an intention setting and breath practice to anchor the nervous system.</li>\\n          <li>Sound journey (35–50 min): layered instruments — crystal singing bowls, wind chimes and a resonant gong for a closing swell — with interludes of silence.</li>\\n          <li>Closure (10 min): guided return, light movement and a cup of water to ground.</li>\\n        </ol>\\n\\n        <div style=\\\"margin-top:12px\\\" class=\\\"card\\\">\\n          <div style=\\\"font-weight:800\\\">Contraindications & safety</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Please consult with your medical provider if you have epilepsy, recent surgery, implanted medical devices, are pregnant under medical complication, or have PTSD triggered by intense sound. Notify the facilitator of any cardiovascular, neurological, or auditory condition before attending.</div>\\n        </div>\\n      </section>\\n\\n      <section id=\\\"faq\\\" class=\\\"faq\\\">\\n        <h2 style=\\\"color:#fff\\\">Common questions</h2>\\n        <div style=\\\"margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:12px\\\">\\n          <div class=\\\"card\\\">\\n            <div class=\\\"q\\\">How long is a session?</div>\\n            <div class=\\\"muted\\\">Typically 60–75 minutes total; the sound portion is around 40–55 minutes depending on the evening.</div>\\n          </div>\\n          <div class=\\\"card\\\">\\n            <div class=\\\"q\\\">Do I need experience?</div>\\n            <div class=\\\"muted\\\">No. Sessions are beginner-friendly and nondogmatic.</div>\\n          </div>\\n          <div class=\\\"card\\\">\\n            <div class=\\\"q\\\">Are there refreshments?</div>\\n            <div class=\\\"muted\\\">Filtered water is available; light tea after select events.</div>\\n          </div>\\n          <div class=\\\"card\\\">\\n            <div class=\\\"q\\\">Can I leave early?</div>\\n            <div class=\\\"muted\\\">Yes — please try to exit quietly to preserve the soundscape for others.</div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section id=\\\"cta\\\" style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px\\\">\\n        <div>\\n          <h3 style=\\\"color:#fff;margin:0\\\">Ready to join the next gathering?</h3>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Reserve a space for an evening of restorative sound.</div>\\n        </div>\\n        <div class=\\\"cta\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a href=\\\"contact.html\\\" style=\\\"color:var(--muted);text-decoration:none\\\">Questions? Contact us</a>\\n        </div>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px\\\">\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div class=\\\"muted\\\">{{VENUE_NAME}} · {{CITY}}, {{STATE}}</div>\\n        </div>\\n        <div class=\\\"muted\\\">Call: {{PHONE}} · Email: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:inherit\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Private Sessions</title>\\n  <style>\\n    :root{--bgA:#071125;--bgB:#0b1830;--accent:#ffd6a5;--muted:#c7d2e0}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system,\\\"Segoe UI\\\",Roboto,Arial;color:#f5f7fb;background:linear-gradient(180deg,var(--bgA),var(--bgB))}\\n    .wrap{max-width:1100px;margin:0 auto;padding:24px}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 0}\\n    .logo{display:flex;align-items:center;gap:12px}\\n    .logo .mark{width:46px;height:46px;border-radius:10px;background:linear-gradient(90deg,#ffd6a5,#ffa5d6);display:flex;align-items:center;justify-content:center;font-weight:800;color:#081028}\\n    nav{display:flex;gap:10px}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px 10px;border-radius:8px}\\n    nav a[href$=\\\"private-sessions.html\\\"]{background:rgba(255,214,165,0.08);color:#fff}\\n    main{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:16px;padding:22px;border:1px solid rgba(255,255,255,0.03)}\\n    .hero{display:flex;gap:18px;align-items:center}\\n    .hero .left{flex:1}\\n    h1{margin:0;color:#fff;font-size:26px}\\n    .sub{color:var(--muted);margin-top:8px}\\n    .services{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-top:18px}\\n    .service{background:rgba(255,255,255,0.02);padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .service h4{margin:0 0 6px}\\n    .small{font-size:13px;color:var(--muted)}\\n    .badge{display:inline-block;padding:6px 10px;background:linear-gradient(90deg,#ffd6a5,#ffb3c6);border-radius:999px;color:#041028;font-weight:800}\\n    .flow{margin-top:16px}\\n    .row{display:flex;gap:12px}\\n    .note{background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;border:1px solid rgba(255,255,255,0.03);color:var(--muted)}\\n    .cta{margin-top:18px;display:flex;gap:12px}\\n    .btn{background:linear-gradient(90deg,#ffd6a5,#ffb3c6);padding:12px 16px;border-radius:10px;color:#081028;font-weight:800;text-decoration:none}\\n    footer{margin-top:26px;color:var(--muted);font-size:13px}\\n    /* decorative svg */\\n    .svg-wrap{position:absolute;right:8px;top:8px;opacity:0.14;pointer-events:none}\\n    @media(max-width:880px){.services{grid-template-columns:1fr}.hero{flex-direction:column;align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"logo\\\">\\n        <div class=\\\"mark\\\">{{BUSINESS_NAME}}</div>\\n        <div>\\n          <div style=\\\"font-weight:800;color:#fff\\\">Private Offerings</div>\\n          <div class=\\\"small\\\">Custom sound sessions for individuals & groups</div>\\n        </div>\\n      </div>\\n      <nav aria-label=\\\"private navigation\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Gatherings</a>\\n        <a href=\\\"private-sessions.html\\\">Private</a>\\n        <a href=\\\"pricing.html\\\">Invest</a>\\n        <a href=\\\"contact.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <div class=\\\"hero\\\">\\n        <div class=\\\"left\\\">\\n          <h1>One-on-one & group sessions tailored to your needs</h1>\\n          <div class=\\\"sub\\\">Intimate sessions in our studio or at your space — focused on integration, performance support, and team wellbeing.</div>\\n\\n          <div class=\\\"flow\\\">\\n            <div style=\\\"font-weight:800;color:#fff\\\">Session flow</div>\\n            <ol class=\\\"small\\\" style=\\\"margin-top:8px\\\">\\n              <li>Consultation & intention setting (10–15 min)</li>\\n              <li>Sound experience: tuned instruments selected for purpose (30–60 min)</li>\\n              <li>Integration: gentle conversation, grounding practices and takeaways (10 min)</li>\\n            </ol>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"width:320px\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-bottom:10px\\\">\\n            <div class=\\\"badge\\\">By appointment</div>\\n            <div class=\\\"small\\\">Flexible times · Private space</div>\\n          </div>\\n\\n          <div class=\\\"note\\\">\\n            <div style=\\\"font-weight:800;color:#fff\\\">Safety first</div>\\n            <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Please notify us of any medical implants, pregnancy complications, recent surgeries, or auditory sensitivity before booking.</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <section style=\\\"margin-top:18px\\\">\\n        <h2 style=\\\"color:#fff\\\">Session types</h2>\\n        <div class=\\\"services\\\">\\n          <div class=\\\"service\\\">\\n            <h4>1:1 Deep Session</h4>\\n            <div class=\\\"small\\\">Personalized sound journey using tuning forks, a single crystal bowl and breath dialogue set to your specific nervous-system needs.</div>\\n            <div style=\\\"margin-top:10px;font-weight:800\\\">Best for: sleep issues, acute stress, personal growth</div>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h4>Couples / Dyad</h4>\\n            <div class=\\\"small\\\">Partnered sessions that combine shared intention, harmonics, and monochord textures to foster connection and attunement.</div>\\n            <div style=\\\"margin-top:10px;font-weight:800\\\">Best for: relationship recalibration, ceremony</div>\\n          </div>\\n          <div class=\\\"service\\\">\\n            <h4>Corporate & Team Wellbeing</h4>\\n            <div class=\\\"small\\\">Shorter formats with guided soundscapes and breathwork using Tibetan bowls, koshi chimes and light percussion to reset groups.</div>\\n            <div style=\\\"margin-top:10px;font-weight:800\\\">Best for: retreats, offsites, burnout prevention</div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px;display:flex;gap:16px;flex-wrap:wrap\\\">\\n        <div style=\\\"flex:1;min-width:320px;background:rgba(255,255,255,0.02);padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)\\\">\\n          <div style=\\\"font-weight:800;color:#fff\\\">What to bring</div>\\n          <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">A favourite blanket, water, and any props that make you comfortable. For on-site team events, we bring portable mats and cushions.</div>\\n        </div>\\n\\n        <div style=\\\"flex:1;min-width:220px;background:rgba(255,255,255,0.02);padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)\\\">\\n          <div style=\\\"font-weight:800;color:#fff\\\">Instruments we might use</div>\\n          <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Tuning forks, monochord, ocean drum, and gentle singing bowls chosen to match therapeutic goals.</div>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px\\\">\\n        <h2 style=\\\"color:#fff\\\">Case notes & customization</h2>\\n        <div class=\\\"row\\\" style=\\\"margin-top:10px\\\">\\n          <div style=\\\"flex:1\\\" class=\\\"note\\\">\\n            <div style=\\\"font-weight:800\\\">Intake</div>\\n            <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">We collect a short intake to customize frequency choices and pacing. Sessions adapt in real time based on physiological cues.</div>\\n          </div>\\n          <div style=\\\"flex:1\\\" class=\\\"note\\\">\\n            <div style=\\\"font-weight:800\\\">Follow-up</div>\\n            <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Optional short check-ins and recommendations for home practices and retail items to extend benefits.</div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <div style=\\\"font-weight:800;color:#fff\\\">Book a private session</div>\\n          <div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Choose a 1:1, couples session or inquire about corporate rates.</div>\\n        </div>\\n        <div>\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:18px\\\">\\n        <div class=\\\"small\\\">Facilitator: {{FACILITATOR_NAME}}</div>\\n        <div class=\\\"small\\\">Email: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:inherit\\\">{{EMAIL}}</a> · Phone: {{PHONE}}</div>\\n      </div>\\n    </footer>\\n\\n    <svg class=\\\"svg-wrap\\\" width=\\\"240\\\" height=\\\"240\\\" viewBox=\\\"0 0 240 240\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <radialGradient id=\\\"rg\\\" cx=\\\"30%\\\" cy=\\\"30%\\\">\\n          <stop offset=\\\"0%\\\" stop-color=\\\"#ffd6a5\\\"/>\\n          <stop offset=\\\"100%\\\" stop-color=\\\"#ffb3c6\\\" stop-opacity=\\\"0\\\"/>\\n        </radialGradient>\\n      </defs>\\n      <circle cx=\\\"120\\\" cy=\\\"120\\\" r=\\\"80\\\" fill=\\\"url(#rg)\\\" />\\n      <g opacity=\\\"0.6\\\" fill=\\\"#ffd6a5\\\">\\n        <rect x=\\\"20\\\" y=\\\"10\\\" width=\\\"10\\\" height=\\\"200\\\" rx=\\\"4\\\"/>\\n        <rect x=\\\"210\\\" y=\\\"10\\\" width=\\\"10\\\" height=\\\"200\\\" rx=\\\"4\\\"/>\\n      </g>\\n    </svg>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Rates & Add-ons</title>\\n  <style>\\n    :root{--bg:#07111b;--panel:#071826;--accent:#86f3ff;--muted:#9fb0c8}\\n    body{margin:0;background:radial-gradient(circle at 10% 10%,#0f2840 0%,var(--bg) 40%,#041423 100%);font-family:Inter,system-ui,Arial;color:#ecf6ff}\\n    .container{max-width:980px;margin:0 auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:12px;padding:8px 10px;border-radius:8px}\\n    nav a[href$=\\\"pricing.html\\\"]{background:rgba(134,243,255,0.06);color:#eaffff}\\n    h1{margin:16px 0 6px}\\n    .intro{color:var(--muted)}\\n    .pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .plan{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:16px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .price{font-weight:800;font-size:22px;color:var(--accent)}\\n    .small{color:var(--muted);font-size:14px}\\n    .addon{display:flex;justify-content:space-between;align-items:center;padding:10px;margin-top:10px;background:rgba(255,255,255,0.02);border-radius:10px}\\n    .cta{margin-top:18px}\\n    .btn{background:linear-gradient(90deg,#86f3ff,#a5b8ff);padding:10px 14px;border-radius:10px;color:#021628;font-weight:800;text-decoration:none}\\n    .disclaimer{margin-top:12px;color:var(--muted);font-size:13px}\\n    .svg-accent{width:100%;height:120px;margin-top:18px;opacity:0.14}\\n    @media(max-width:880px){.pricing-grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"small\\\">Tuned offerings + retail add-ons</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Sessions</a>\\n        <a href=\\\"private-sessions.html\\\">Private</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <h1>Transparent pricing for gatherings & sessions</h1>\\n      <div class=\\\"intro\\\">We offer small-group event tickets, private sessions and curated retail items. Add-ons are available for checkout with private bookings.</div>\\n\\n      <div class=\\\"pricing-grid\\\">\\n        <div class=\\\"plan\\\">\\n          <div style=\\\"font-weight:800\\\">Group Session — Standard</div>\\n          <div class=\\\"price\\\">$28</div>\\n          <div class=\\\"small\\\">Per person · 60–75 min · Shared mats and cushions provided</div>\\n          <div class=\\\"addon\\\">\\n            <div class=\\\"small\\\">Priority seating</div>\\n            <div class=\\\"small\\\">+$8</div>\\n          </div>\\n          <div class=\\\"addon\\\">\\n            <div class=\\\"small\\\">Eye covering (cloth)</div>\\n            <div class=\\\"small\\\">+$3</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"plan\\\">\\n          <div style=\\\"font-weight:800\\\">Private 1:1 Intensive</div>\\n          <div class=\\\"price\\\">$160</div>\\n          <div class=\\\"small\\\">60 min · Custom frequencies with tuning forks & crystal bowl</div>\\n          <div class=\\\"addon\\\">\\n            <div class=\\\"small\\\">Extended 90 min</div>\\n            <div class=\\\"small\\\">+$45</div>\\n          </div>\\n          <div class=\\\"addon\\\">\\n            <div class=\\\"small\\\">Recorded takeaway (audio)</div>\\n            <div class=\\\"small\\\">+$35</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"plan\\\">\\n          <div style=\\\"font-weight:800\\\">Couples & Dyads</div>\\n          <div class=\\\"price\\\">$220</div>\\n          <div class=\\\"small\\\">75 min · Shared session with monochord and bowls</div>\\n          <div class=\\\"addon\\\">\\n            <div class=\\\"small\\\">Ritual kit (candles + herbs)</div>\\n            <div class=\\\"small\\\">+$30</div>\\n          </div>\\n          <div class=\\\"addon\\\">\\n            <div class=\\\"small\\\">Venue add-on (off-site)</div>\\n            <div class=\\\"small\\\">+$65</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <section style=\\\"margin-top:20px\\\">\\n        <h3 style=\\\"margin:0;color:#fff\\\">Corporate & Day-rates</h3>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Half-day workshops and on-site resets available. Typical format: 45min sound reset + intentional pause + Q&amp;A. Pricing depends on travel and group size.</div>\\n        <div style=\\\"margin-top:12px;background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;border:1px solid rgba(255,255,255,0.03)\\\">\\n          <div style=\\\"font-weight:800\\\">Sample: Team Reset (30 ppl)</div>\\n          <div class=\\\"small\\\">Starting at $1200 including travel and materials.</div>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:16px\\\">\\n        <h3 style=\\\"margin:0;color:#fff\\\">Retail & recommended add-ons</h3>\\n        <div style=\\\"display:flex;flex-wrap:wrap;gap:10px;margin-top:10px\\\">\\n          <div style=\\\"min-width:220px\\\" class=\\\"note\\\">\\n            <div style=\\\"font-weight:800\\\">Crystal Singing Bowl — small</div>\\n            <div class=\\\"small\\\">Hand-tuned instrument for home practice. Price varies by tone and craftsmanship.</div>\\n          </div>\\n          <div style=\\\"min-width:220px\\\" class=\\\"note\\\">\\n            <div style=\\\"font-weight:800\\\">Tuning Fork Set</div>\\n            <div class=\\\"small\\\">Pair for alignment and microtonal work. Durable aluminium set with carrying case.</div>\\n          </div>\\n          <div style=\\\"min-width:220px\\\" class=\\\"note\\\">\\n            <div style=\\\"font-weight:800\\\">Koshi Chimes</div>\\n            <div class=\\\"small\\\">Portable breath-friendly chimes for home grounding exercises.</div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <div class=\\\"cta\\\">\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book & Add-ons</a>\\n        <div style=\\\"margin-left:12px;color:var(--muted);display:flex;align-items:center\\\">Need a custom quote? <a href=\\\"contact.html\\\" style=\\\"margin-left:8px;color:#fff;text-decoration:none\\\">Get in touch</a></div>\\n      </div>\\n\\n      <div class=\\\"disclaimer\\\">Contraindications: If you have implanted medical devices, are pregnant with complications, have epilepsy or auditory hypersensitivity, please consult a medical professional and contact us before booking. We also offer quiet/modulated sessions on request.</div>\\n\\n      <svg class=\\\"svg-accent\\\" viewBox=\\\"0 0 800 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n        <defs>\\n          <linearGradient id=\\\"pg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#86f3ff\\\" stop-opacity=\\\"0.7\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#a5b8ff\\\" stop-opacity=\\\"0.3\\\"/></linearGradient>\\n        </defs>\\n        <path d=\\\"M0 60 Q120 10 240 60 T480 60 T720 60 T960 60\\\" stroke=\\\"url(#pg)\\\" stroke-width=\\\"6\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\" opacity=\\\"0.9\\\"/>\\n        <g fill=\\\"#86f3ff\\\" opacity=\\\"0.12\\\">\\n          <circle cx=\\\"120\\\" cy=\\\"20\\\" r=\\\"28\\\"/>\\n          <circle cx=\\\"520\\\" cy=\\\"80\\\" r=\\\"36\\\"/>\\n          <circle cx=\\\"760\\\" cy=\\\"40\\\" r=\\\"22\\\"/>\\n        </g>\\n      </svg>\\n\\n    </main>\\n\\n    <footer style=\\\"margin-top:20px;color:var(--muted)\\\">\\n      <div>{{BUSINESS_NAME}} · {{VENUE_NAME}} · {{CITY}}, {{STATE}} · {{PHONE}}</div>\\n      <div style=\\\"margin-top:6px\\\">Email: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:inherit\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
