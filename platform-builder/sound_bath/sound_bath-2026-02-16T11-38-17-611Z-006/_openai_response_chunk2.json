          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Upcoming Sound Baths — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Warm, sensory sound baths in {{CITY}}, {{STATE}} — discover the next event and our calendar of gatherings.\\\">\\n  <style>\\n    :root{--bg:#f6efe8;--earth:#6b4f3b;--sand:#e8d8c8;--leaf:#7aa37a;--accent:#b77b4b;--muted:#7d6a5a}\\n    *{box-sizing:border-box}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--earth);background:linear-gradient(180deg,var(--bg),#fff);}\\n    header{position:sticky;top:0;z-index:40;background:linear-gradient(180deg,rgba(255,255,255,0.6),rgba(255,255,255,0.4));backdrop-filter:blur(6px);border-bottom:1px solid rgba(107,79,59,0.06)}\\n    .wrap{max-width:1100px;margin:0 auto;padding:24px}\\n    nav{display:flex;gap:18px;align-items:center}\\n    nav a{color:var(--earth);text-decoration:none;font-weight:600}\\n    .brand{font-weight:800;color:var(--earth)}\\n    .cta{margin-left:auto;padding:8px 14px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#e7995a);color:white;text-decoration:none;font-weight:700}\\n\\n    /* Background SVG container */\\n    .bg-anch{position:fixed;inset:0;z-index:-1;opacity:0.18}\\n    .bg-anch svg{width:100%;height:100%;display:block}\\n\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;padding:56px 0}\\n    .hero h1{font-size:34px;margin:0 0 10px;color:var(--earth)}\\n    .lead{color:var(--muted);line-height:1.5}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.9),rgba(250,244,240,0.9));border-radius:14px;padding:20px;box-shadow:0 6px 22px rgba(107,79,59,0.06)}\\n    .next{font-weight:800;color:var(--leaf);font-size:16px}\\n    .calendar{margin-top:12px;display:flex;flex-direction:column;gap:8px}\\n    .cal-item{display:flex;justify-content:space-between;align-items:center;padding:10px;border-radius:10px;background:rgba(122,163,122,0.06)}\\n\\n    section{padding:46px 0;border-top:1px solid rgba(107,79,59,0.04)}\\n    h2{margin:0 0 10px;font-size:22px}\\n    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}\\n    .pill{background:linear-gradient(180deg,#fff, #fbf7f5);padding:16px;border-radius:12px}\\n    .muted{color:var(--muted)}\\n\\n    footer{padding:36px 0;text-align:center;color:var(--muted)}\\n    .small{font-size:13px}\\n\\n    /* Responsive */\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.cta{margin-left:12px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"bg-anch\\\" aria-hidden=\\\"true\\\">\\n    <!-- unique SVG background pattern for this page: warm earthy waves + orbs -->\\n    <svg viewBox=\\\"0 0 1200 800\\\" preserveAspectRatio=\\\"xMidYMid slice\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#f4e7dd\\\"/>\\n          <stop offset=\\\"1\\\" stop-color=\\\"#fff8f2\\\"/>\\n        </linearGradient>\\n        <radialGradient id=\\\"orb\\\" cx=\\\"30%\\\" cy=\\\"20%\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#f2d9c7\\\" stop-opacity=\\\"0.8\\\"/>\\n          <stop offset=\\\"1\\\" stop-color=\\\"#f2d9c7\\\" stop-opacity=\\\"0\\\"/>\\n        </radialGradient>\\n      </defs>\\n      <rect width=\\\"1200\\\" height=\\\"800\\\" fill=\\\"url(#g1)\\\"/>\\n      <g fill=\\\"url(#orb)\\\">\\n        <circle cx=\\\"200\\\" cy=\\\"120\\\" r=\\\"160\\\" />\\n        <circle cx=\\\"980\\\" cy=\\\"640\\\" r=\\\"220\\\" />\\n      </g>\\n      <g fill-opacity=\\\"0.06\\\" fill=\\\"#6b4f3b\\\">\\n        <path d=\\\"M0 480 C220 420 380 540 600 480 C820 420 980 540 1200 480 L1200 800 L0 800 Z\\\" />\\n      </g>\\n    </svg>\\n  </div>\\n\\n  <header>\\n    <div class=\\\"wrap\\\" style=\\\"display:flex;align-items:center;gap:18px\\\">\\n      <a class=\\\"brand\\\" href=\\\"index.html\\\">{{BUSINESS_NAME}}</a>\\n      <nav style=\\\"flex:1\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Upcoming</a>\\n        <a href=\\\"private-sessions.html\\\">Sessions</a>\\n        <a href=\\\"pricing.html\\\">Rates</a>\\n        <a href=\\\"about.html\\\">About</a>\\n      </nav>\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </div>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Gather. Breathe. Surrender to sound.</h1>\\n        <p class=\\\"lead\\\">A sensory, premium sound bath experience in {{CITY}}. We weave textured tones and gentle resonance to guide deep rest and nervous system recalibration.</p>\\n        <div style=\\\"display:flex;gap:12px;margin-top:18px;align-items:center\\\">\\n          <div class=\\\"card\\\">\\n            <div class=\\\"next\\\">Next event</div>\\n            <div style=\\\"font-weight:800;margin-top:6px\\\">{{NEXT_EVENT_DATE}}</div>\\n            <div class=\\\"small muted\\\" style=\\\"margin-top:8px\\\">at {{VENUE_NAME}} • doors 6:30pm • sound begins 7:00pm</div>\\n            <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve a Place</a></div>\\n          </div>\\n          <div class=\\\"card\\\" style=\\\"width:220px\\\">\\n            <div style=\\\"font-weight:700\\\">Featured instruments</div>\\n            <ul class=\\\"muted\\\" style=\\\"margin:8px 0 0;padding-left:18px\\\">\\n              <li>Crystal singing bowls</li>\\n              <li>Large gong washes</li>\\n              <li>Wind chimes & textural layers</li>\\n            </ul>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <div style=\\\"font-weight:700\\\">Calendar — upcoming gatherings</div>\\n        <div class=\\\"calendar\\\">\\n          <div class=\\\"cal-item\\\"><div>Sat, {{NEXT_EVENT_DATE}}</div><div class=\\\"muted\\\">Open seating</div></div>\\n          <div class=\\\"cal-item\\\"><div>Sat, 2026-03-14</div><div class=\\\"muted\\\">Tickets available</div></div>\\n          <div class=\\\"cal-item\\\"><div>Sun, 2026-04-05</div><div class=\\\"muted\\\">Intimate circle</div></div>\\n          <div class=\\\"cal-item\\\"><div>Sat, 2026-05-09</div><div class=\\\"muted\\\">Full moon evening</div></div>\\n        </div>\\n        <div style=\\\"margin-top:12px\\\" class=\\\"small muted\\\">Doors usually open 30 minutes before. Arrive early to settle in.</div>\\n      </aside>\\n    </section>\\n\\n    <section id=\\\"myth-truth\\\">\\n      <h2>Myth vs. Truth</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"pill\\\">\\n          <strong>Myth:</strong> Sound baths are like loud concerts.\\n          <p class=\\\"muted\\\">Truth: Our gatherings are curated, low-volume soundscapes designed for inward listening and safety.</p>\\n        </div>\\n        <div class=\\\"pill\\\">\\n          <strong>Myth:</strong> You must meditate perfectly.\\n          <p class=\\\"muted\\\">Truth: No experience required. The sound carries you — resting, daydreaming, or sleeping is all welcomed.</p>\\n        </div>\\n        <div class=\\\"pill\\\">\\n          <strong>Myth:</strong> Results happen instantly.\\n          <p class=\\\"muted\\\">Truth: Many feel immediate calm; deeper integration often arrives over days. Consistency helps.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"flow\\\">\\n      <h2>What to expect — the flow</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"pill\\\">\\n          <strong>Arrival & settling</strong>\\n          <p class=\\\"muted\\\">We greet you, guide gentle grounding, and offer a short centering breath practice so bodies arrive as they are.</p>\\n        </div>\\n        <div class=\\\"pill\\\">\\n          <strong>Sound immersion</strong>\\n          <p class=\\\"muted\\\">An hour of layered tones — bowls, gong washes, chimes — moving through frequency that soothes the nervous system.</p>\\n        </div>\\n        <div class=\\\"pill\\\">\\n          <strong>Return & integration</strong>\\n          <p class=\\\"muted\\\">We close slowly: a soft bell, time to journal or sip herbal tea, and a brief check-in for any questions.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"prep\\\">\\n      <h2>Practical — what to bring & health note</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"pill\\\">\\n          <strong>What to bring</strong>\\n          <ul class=\\\"muted\\\" style=\\\"margin:8px 0 0;padding-left:18px\\\">\\n            <li>Yoga mat, blanket, and cosy pillows</li>\\n            <li>Layered clothing, eye mask, water bottle</li>\\n            <li>Optional: small bolsters or neck support</li>\\n          </ul>\\n        </div>\\n        <div class=\\\"pill\\\">\\n          <strong>Contraindications</strong>\\n          <p class=\\\"muted\\\">If you are pregnant, have a pacemaker, recent surgery, or severe uncontrolled epilepsy, please consult your physician and contact us before booking. Sound can intensify sensations; we provide alternatives on request.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"case-notes\\\">\\n      <h2>Case notes & responses</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"pill\\\">\\n          <strong>Inner recalibration</strong>\\n          <p class=\\\"muted\\\">Participants often report slowed breathing, vivid imagery, and a softening of chronic tension after a single session.</p>\\n        </div>\\n        <div class=\\\"pill\\\">\\n          <strong>Sleep improvement</strong>\\n          <p class=\\\"muted\\\">Several attendees note deeper sleep over the following nights — not guaranteed, but a frequent pattern.</p>\\n        </div>\\n        <div class=\\\"pill\\\">\\n          <strong>Group coherence</strong>\\n          <p class=\\\"muted\\\">Shared silence and resonance create a gentle social reset: less reactivity, more calm connection.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"faq\\\">\\n      <h2>Frequently asked</h2>\\n      <div class=\\\"grid\\\">\\n        <div class=\\\"pill\\\"><strong>Do I need experience?</strong><p class=\\\"muted\\\">No. We design the space for beginners and seasoned listeners alike.</p></div>\\n        <div class=\\\"pill\\\"><strong>Can I sleep?</strong><p class=\\\"muted\\\">Yes — resting is part of the practice. You can leave quietly when ready.</p></div>\\n        <div class=\\\"pill\\\"><strong>Are recordings available?</strong><p class=\\\"muted\\\">Live presence is central. We occasionally offer recorded short meditations for home practice.</p></div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"cta\\\" style=\\\"text-align:center;padding-bottom:80px;\\\">\\n      <div style=\\\"display:inline-block;background:linear-gradient(180deg,#fff, #fff9f6);padding:26px;border-radius:16px;box-shadow:0 8px 30px rgba(107,79,59,0.06)\\\">\\n        <div style=\\\"font-size:20px;font-weight:800;margin-bottom:6px\\\">Reserve your mat for {{NEXT_EVENT_DATE}}</div>\\n        <div class=\\\"muted small\\\" style=\\\"margin-bottom:14px\\\">Limited seating to maintain an intimate, premium experience.</div>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"wrap\\\">\\n      <div style=\\\"display:flex;justify-content:center;gap:18px;align-items:center\\\">\\n        <div class=\\\"small\\\">{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n        <div class=\\\"small\\\">Call: {{PHONE}} • Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n      <div style=\\\"margin-top:10px\\\" class=\\\"muted small\\\">Facilitated by {{FACILITATOR_NAME}} at {{VENUE_NAME}}</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"}   \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Private Sessions — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"One-on-one, couples, and corporate sound sessions — bespoke experiences for deep rest and team reset in {{CITY}}.\\\">\\n  <style>\\n    :root{--bg:#f7f3ee;--deep:#563a2a;--gold:#d9b28a;--soft:#f1e8e2;--accent:#7fb093}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;color:var(--deep);background:linear-gradient(180deg,var(--bg),#fff)}\\n    .wrap{max-width:1000px;margin:0 auto;padding:28px}\\n    header{display:flex;align-items:center;gap:16px;padding:14px 0}\\n    a{color:var(--deep);text-decoration:none}\\n    .nav a{margin-right:14px;font-weight:600}\\n    .bookbtn{margin-left:auto;padding:8px 12px;border-radius:10px;background:var(--accent);color:#fff}\\n\\n    .hero{display:flex;gap:22px;align-items:center;padding:34px 0}\\n    .hero .left{flex:1}\\n    .hero h1{margin:0;font-size:30px}\\n    .sub{color:#6e5b50}\\n\\n    .services{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-top:22px}\\n    .service{background:linear-gradient(180deg,#fff,#fffaf6);padding:16px;border-radius:12px;box-shadow:0 6px 18px rgba(86,58,42,0.06)}\\n\\n    section{border-top:1px solid rgba(86,58,42,0.04);padding:34px 0}\\n    h2{margin:0 0 12px}\\n\\n    .note{background:linear-gradient(90deg,rgba(127,176,147,0.06),rgba(217,178,138,0.04));padding:12px;border-radius:10px}\\n\\n    footer{padding:26px 0;color:#6e5b50}\\n\\n    @media (max-width:860px){.services{grid-template-columns:1fr}.hero{flex-direction:column}.bookbtn{margin-left:0}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique SVG pattern: vertical leaf motifs + circles -->\\n  <div style=\\\"position:fixed;inset:0;z-index:-1;opacity:0.14\\\">\\n    <svg viewBox=\\\"0 0 800 1000\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"lg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#fbf7f3\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#fff\\\"/></linearGradient>\\n      </defs>\\n      <rect width=\\\"800\\\" height=\\\"1000\\\" fill=\\\"url(#lg)\\\"/>\\n      <g fill=\\\"#7fb093\\\" fill-opacity=\\\"0.06\\\">\\n        <ellipse cx=\\\"120\\\" cy=\\\"300\\\" rx=\\\"240\\\" ry=\\\"90\\\"/>\\n        <ellipse cx=\\\"680\\\" cy=\\\"760\\\" rx=\\\"200\\\" ry=\\\"70\\\"/>\\n      </g>\\n      <g fill=\\\"#d9b28a\\\" fill-opacity=\\\"0.03\\\">\\n        <circle cx=\\\"400\\\" cy=\\\"120\\\" r=\\\"120\\\"/>\\n      </g>\\n    </svg>\\n  </div>\\n\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <a href=\\\"index.html\\\" style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</a>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Events</a>\\n        <a href=\\\"private-sessions.html\\\">Sessions</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n      </nav>\\n      <a class=\\\"bookbtn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"left\\\">\\n        <h1>Private sound sessions — tailored for you</h1>\\n        <p class=\\\"sub\\\">Intensive, premium sound work in a private setting. Choose 1:1, couples, or corporate formats for focused restoration.</p>\\n\\n        <div style=\\\"margin-top:12px;color:#6e5b50\\\">Led by {{FACILITATOR_NAME}} — we design each session to your needs: trauma-informed, nervous-system aware, and luxuriously gentle.</div>\\n      </div>\\n\\n      <div style=\\\"width:320px;background:linear-gradient(180deg,#fff,#fffaf6);padding:16px;border-radius:12px;box-shadow:0 8px 26px rgba(0,0,0,0.04)\\\">\\n        <div style=\\\"font-weight:800\\\">Session highlights</div>\\n        <ul style=\\\"margin:10px 0 0;padding-left:18px;color:#6e5b50\\\">\\n          <li>Custom intention setting</li>\\n          <li>Focused sound palette & physical attunement</li>\\n          <li>Post-session integration guidance</li>\\n        </ul>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"bookbtn\\\" href=\\\"book.html\\\">Book a private</a></div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h2>Formats we offer</h2>\\n      <div class=\\\"services\\\">\\n        <div class=\\\"service\\\">\\n          <strong>1:1 Sessions</strong>\\n          <p class=\\\"muted\\\">Deep individualized sessions, 60–90 minutes. We tune frequency and pacing to your nervous system.</p>\\n          <div style=\\\"margin-top:8px;color:#6e5b50\\\">Instruments commonly used: tuning forks, monochord, soft breath-driven drones.</div>\\n        </div>\\n        <div class=\\\"service\\\">\\n          <strong>Couples & small groups</strong>\\n          <p class=\\\"muted\\\">Shared intention work for relational attunement and restorative listening. 60–75 minutes.</p>\\n          <div style=\\\"margin-top:8px;color:#6e5b50\\\">Instruments often: responsive tuning forks, handpan harmonics, subtle voice harmonies.</div>\\n        </div>\\n        <div class=\\\"service\\\">\\n          <strong>Corporate & team sessions</strong>\\n          <p class=\\\"muted\\\">Brief resets for teams: 20–40 minutes, tailored to workplace rhythm and accessibility needs.</p>\\n          <div style=\\\"margin-top:8px;color:#6e5b50\\\">We emphasize safety, quietude, and measurable relaxation outcomes.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h2>Flow & sensory notes</h2>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:14px\\\">\\n        <div class=\\\"note\\\">\\n          <strong>Session flow</strong>\\n          <ol class=\\\"muted\\\" style=\\\"margin:8px 0 0;padding-left:18px\\\">\\n            <li>Arrival & quick intake to set intention</li>\\n            <li>Short grounding practice and positioning</li>\\n            <li>Targeted sound work (resonant layers & focused tones)</li>\\n            <li>Gentle re-emergence and aftercare guidance</li>\\n          </ol>\\n        </div>\\n        <div class=\\\"note\\\">\\n          <strong>What to bring</strong>\\n          <p class=\\\"muted\\\">Mat or comfortable cushion, layers for warmth, any props that support your neck or knees. We provide a blanket on request.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h2>Health & safety</h2>\\n      <p class=\\\"muted\\\">Contraindications: If you have a pacemaker, active psychiatric crisis, or recent major surgery, please consult your doctor and let us know in advance. We can adapt sessions — lower volume, more distance, or entirely vibrational alternatives — to accommodate safety concerns.</p>\\n    </section>\\n\\n    <section id=\\\"case-notes\\\">\\n      <h2>Selected notes from private work</h2>\\n      <div style=\\\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-top:10px\\\">\\n        <div class=\\\"service\\\"><strong>Trauma-informed pacing</strong><p class=\\\"muted\\\">One client reported feeling \\\"contained and safe\\\" while accessing somatic release across three sessions.</p></div>\\n        <div class=\\\"service\\\"><strong>Couples attunement</strong><p class=\\\"muted\\\">Partners shared improved sleep and clearer communication after a single couples session focused on breath and sonic resonance.</p></div>\\n        <div class=\\\"service\\\"><strong>Team reset</strong><p class=\\\"muted\\\">Corporate groups note reduced reactivity and faster return to baseline following a 30-minute group shift.</p></div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"faq\\\">\\n      <h2>Common questions</h2>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:12px\\\">\\n        <div class=\\\"pill\\\" style=\\\"background:none;padding:0\\\">\\n          <strong>Can you come to our space?</strong>\\n          <p class=\\\"muted\\\">Yes — mobile sessions available within {{CITY}}. Travel fees may apply.</p>\\n        </div>\\n        <div class=\\\"pill\\\" style=\\\"background:none;padding:0\\\">\\n          <strong>How to prepare?</strong>\\n          <p class=\\\"muted\\\">Rest, hydrate, and avoid heavy meals immediately before session if possible.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"text-align:center;padding:36px 0\\\">\\n      <h2>Ready to design your session?</h2>\\n      <p class=\\\"muted\\\">Contact us for a consult — we co-create the experience to your intention and context.</p>\\n      <a class=\\\"bookbtn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Request a Consultation</a>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap\\\">\\n        <div class=\\\"muted small\\\">{{BUSINESS_NAME}} • Facilitator: {{FACILITATOR_NAME}}</div>\\n        <div class=\\\"muted small\\\">Contact: {{PHONE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"}   \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Rates & Packages — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Transparent pricing for group events, drop-ins, and private sound sessions. Premium, sensory-led experiences in {{CITY}}.\\\">\\n  <style>\\n    :root{--bg:#fff8f4;--brown:#5a3f32;--terra:#c78b5a;--sage:#9bb89a;--muted:#7b6a60}\\n    body{margin:0;font-family:Georgia,serif;color:var(--brown);background:linear-gradient(180deg,var(--bg),#fff)}\\n    .wrap{max-width:980px;margin:0 auto;padding:30px}\\n    header{display:flex;gap:18px;align-items:center}\\n    nav a{margin-right:12px;color:var(--brown);font-weight:700}\\n    .book{margin-left:auto;padding:8px 12px;background:var(--terra);color:white;border-radius:8px}\\n\\n    .hero{padding:26px 0}\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .tier{background:linear-gradient(180deg,#fff,#fffaf6);padding:18px;border-radius:12px;border:1px solid rgba(0,0,0,0.04)}\\n    .price{font-size:22px;font-weight:800;color:var(--terra)}\\n    .muted{color:var(--muted)}\\n\\n    section{border-top:1px solid rgba(90,63,50,0.04);padding:28px 0}\\n    .small{font-size:13px;color:var(--muted)}\\n\\n    @media (max-width:920px){.tiers{grid-template-columns:1fr}} \\n  </style>\\n</head>\\n<body>\\n  <!-- SVG pattern: concentric rings and subtle stripes for premium texture -->\\n  <div style=\\\"position:fixed;inset:0;z-index:-1;opacity:0.13\\\">\\n    <svg viewBox=\\\"0 0 1400 900\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"pg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#fff8f4\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#fffefc\\\"/></linearGradient>\\n      </defs>\\n      <rect width=\\\"1400\\\" height=\\\"900\\\" fill=\\\"url(#pg)\\\"/>\\n      <g fill=\\\"#c78b5a\\\" fill-opacity=\\\"0.04\\\">\\n        <circle cx=\\\"200\\\" cy=\\\"200\\\" r=\\\"180\\\"/>\\n        <circle cx=\\\"1100\\\" cy=\\\"700\\\" r=\\\"260\\\"/>\\n      </g>\\n      <g fill=\\\"#9bb89a\\\" fill-opacity=\\\"0.03\\\">\\n        <rect x=\\\"0\\\" y=\\\"820\\\" width=\\\"1400\\\" height=\\\"40\\\"/>\\n      </g>\\n    </svg>\\n  </div>\\n\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <a href=\\\"index.html\\\" style=\\\"font-weight:900\\\">{{BUSINESS_NAME}}</a>\\n      <nav>\\n        <a href=\\\"events.html\\\">Gatherings</a>\\n        <a href=\\\"private-sessions.html\\\">Sessions</a>\\n        <a href=\\\"about.html\\\">Our Approach</a>\\n      </nav>\\n      <a class=\\\"book\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <h1>Rates & Packages</h1>\\n      <p class=\\\"muted\\\">We offer transparent pricing with options for drop-ins, memberships, and bespoke private work. Prices reflect small group sizes and a premium, sensory-led offering.</p>\\n    </section>\\n\\n    <section>\\n      <h2>Offerings</h2>\\n      <div class=\\\"tiers\\\">\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"font-weight:700\\\">Single group drop-in</div>\\n          <div class=\\\"price\\\">$35</div>\\n          <div class=\\\"small muted\\\">One evening sound bath (approx. 75 minutes). Includes set-up and light guidance.</div>\\n          <div style=\\\"margin-top:10px\\\"><a href=\\\"book.html\\\">Book single</a></div>\\n        </div>\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"font-weight:700\\\">Monthly membership</div>\\n          <div class=\\\"price\\\">$95 / month</div>\\n          <div class=\\\"small muted\\\">Two group sessions per month plus early access to special events and a recorded tone practice.</div>\\n          <div style=\\\"margin-top:10px\\\"><a href=\\\"contact.html\\\">Join waitlist</a></div>\\n        </div>\\n        <div class=\\\"tier\\\">\\n          <div style=\\\"font-weight:700\\\">Private session (1:1)</div>\\n          <div class=\\\"price\\\">From $160</div>\\n          <div class=\\\"small muted\\\">60–90 minute bespoke sessions. Travel or venue fees applied for off-site bookings.</div>\\n          <div style=\\\"margin-top:10px\\\"><a href=\\\"private-sessions.html\\\">Request consult</a></div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h2>What's included & sound profile</h2>\\n      <p class=\\\"muted\\\">Every session includes intentional holding, a curated instrument palette, and time for integration. For groups we commonly blend:</p>\\n      <ul class=\\\"muted\\\" style=\\\"padding-left:18px\\\">\\n        <li>Bronze singing bowls and light harmonic layers</li>\\n        <li>Soft tuning fork interventions for targeted release</li>\\n        <li>Long-form drones and textural shimmers</li>\\n      </ul>\\n      <p class=\\\"small\\\">Note: instrument combinations vary by offering to provide distinct sonic experiences.</p>\\n    </section>\\n\\n    <section>\\n      <h2>Payment & policy</h2>\\n      <div class=\\\"muted\\\">\\n        <p>We accept card and bank transfers. Cancellations: group ticket refunds up to 48 hours before start. Private session cancellations require 72 hours notice for full refund.</p>\\n        <p class=\\\"small\\\">For corporate bookings, a deposit is required to secure date. Custom proposals available on request.</p>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h2>Contraindications & care</h2>\\n      <p class=\\\"muted\\\">If you have a pacemaker, are in a fragile medical state, or are pregnant, please consult a physician and tell us before booking. We design lower-intensity alternatives or distance-based practices when necessary.</p>\\n    </section>\\n\\n    <section style=\\\"text-align:center;padding:40px 0\\\">\\n      <div style=\\\"display:inline-block;padding:18px;border-radius:12px;background:linear-gradient(180deg,#fff,#fff8f2);box-shadow:0 8px 22px rgba(0,0,0,0.04)\\\">\\n        <div style=\\\"font-weight:800;margin-bottom:6px\\\">Questions about a package?</div>\\n        <div class=\\\"muted small\\\" style=\\\"margin-bottom:10px\\\">Contact us to tailor a plan for your group or private work.</div>\\n        <a style=\\\"background:var(--terra);color:white;padding:8px 12px;border-radius:8px;text-decoration:none;font-weight:700\\\" href=\\\"contact.html\\\">Get in touch</a>\\n      </div>\\n    </section>\\n\\n    <footer class=\\\"small\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap\\\">\\n        <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n        <div>Phone: {{PHONE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"}   \nBUNDLE_END"
        }
      ],
