          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Events — {{BUSINESS_NAME}} • Sound Baths</title>\\n  <style>\\n    :root{--bg1:#0f1722;--bg2:#122430;--accent:#ffd8b5;--muted:#9aa6b2;--glass:rgba(255,255,255,0.06);--card:rgba(255,255,255,0.03)}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,\\\"Segoe UI\\\",Roboto,'Helvetica Neue',Arial;color:#e6eef6;background:linear-gradient(180deg,var(--bg1),var(--bg2));-webkit-font-smoothing:antialiased}\\n    .site{min-height:100vh;position:relative;overflow-x:hidden}\\n    /* decorative SVG layer */\\n    .svg-bg{position:absolute;inset:0;pointer-events:none;opacity:0.42;mix-blend-mode:overlay}\\n    nav{display:flex;gap:18px;align-items:center;padding:26px 36px;position:relative;z-index:5}\\n    .brand{display:flex;align-items:center;gap:12px;color:var(--accent);font-weight:700}\\n    .brand .dot{width:14px;height:14px;border-radius:50%;background:radial-gradient(circle at 30% 30%,#fff7e6,#ffd8b5 40%,transparent 60%);box-shadow:0 6px 18px rgba(255,216,181,0.14)}\\n    .navlinks{margin-left:auto;display:flex;gap:18px}\\n    .navlinks a{color:rgba(230,238,246,0.9);text-decoration:none;padding:8px 12px;border-radius:8px;font-size:14px}\\n    .navlinks a.cta{background:linear-gradient(90deg,#ffb57a,#ffd8b5);color:#102026;font-weight:600}\\n\\n    .hero{padding:56px 36px 28px;display:grid;grid-template-columns:1fr 420px;gap:28px;align-items:start}\\n    .hero-card{background:linear-gradient(180deg,rgba(255,255,255,0.03),transparent);border-radius:16px;padding:28px;backdrop-filter:blur(6px);box-shadow:0 6px 30px rgba(6,12,20,0.45);border:1px solid rgba(255,255,255,0.03)}\\n    .kicker{color:var(--accent);font-weight:700;letter-spacing:1px}\\n    h1{color:#fff;margin:10px 0 6px;font-size:34px}\\n    p.lead{color:var(--muted);margin:0 0 16px}\\n    .next{display:flex;align-items:center;gap:12px;margin-top:12px}\\n    .bubble{background:var(--glass);padding:10px 14px;border-radius:12px;color:#fff;font-weight:600}\\n\\n    .calendar{background:transparent;margin-top:20px;border-radius:12px;padding:12px;display:grid;gap:8px}\\n    .event-item{display:flex;justify-content:space-between;align-items:center;padding:10px;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border:1px solid rgba(255,255,255,0.02)}\\n    .event-item .meta{color:var(--muted);font-size:13px}\\n    .event-item .price{color:var(--accent);font-weight:700}\\n\\n    .content{padding:0 36px 64px}\\n    .grid-2{display:grid;grid-template-columns:1fr 380px;gap:28px;margin-top:28px}\\n\\n    .card{background:var(--card);padding:20px;border-radius:14px;border:1px solid rgba(255,255,255,0.02)}\\n    .testimonials{display:flex;flex-direction:column;gap:12px}\\n    .pill{display:inline-block;padding:6px 10px;background:rgba(255,255,255,0.02);border-radius:999px;color:var(--accent);font-weight:600}\\n\\n    .benefits ul{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:10px}\\n    .benefit{background:linear-gradient(90deg,rgba(255,255,255,0.02),transparent);padding:12px;border-radius:10px}\\n\\n    .process ol{margin:0;padding-left:18px;color:var(--muted)}\\n    .what{margin-top:12px;color:var(--muted);font-size:14px}\\n    .disclaimer{font-size:13px;color:#ffdfdf;background:linear-gradient(90deg,rgba(255,120,120,0.04),transparent);padding:10px;border-radius:8px;margin-top:12px}\\n\\n    .leadmag{display:flex;flex-direction:column;gap:10px}\\n    .form-row{display:flex;gap:8px}\\n    input[type=email]{flex:1;padding:12px;border-radius:10px;border:1px solid rgba(255,255,255,0.06);background:transparent;color:#fff}\\n    button{padding:12px 16px;border-radius:10px;border:0;background:linear-gradient(90deg,#ffb57a,#ffd8b5);color:#102026;font-weight:700}\\n\\n    footer{padding:28px 36px;color:var(--muted);display:flex;justify-content:space-between;align-items:center}\\n    a.foot-cta{background:transparent;border:1px solid rgba(255,255,255,0.04);padding:10px 14px;border-radius:10px;color:var(--accent);text-decoration:none}\\n\\n    /* small screens */\\n    @media(max-width:900px){\\n      .hero{grid-template-columns:1fr;}\\n      .grid-2{grid-template-columns:1fr}\\n      .navlinks{display:none}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <!-- decorative inline SVG pattern -->\\n    <svg class=\\\"svg-bg\\\" viewBox=\\\"0 0 1200 800\\\" preserveAspectRatio=\\\"xMidYMid slice\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\" y1=\\\"0\\\" y2=\\\"1\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#18303b\\\" stop-opacity=\\\"0.8\\\"/>\\n          <stop offset=\\\"1\\\" stop-color=\\\"#0b1620\\\" stop-opacity=\\\"0.6\\\"/>\\n        </linearGradient>\\n        <pattern id=\\\"p1\\\" width=\\\"140\\\" height=\\\"140\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(18)\\\">\\n          <rect width=\\\"70\\\" height=\\\"140\\\" fill=\\\"rgba(255,255,255,0.01)\\\"/>\\n          <circle cx=\\\"10\\\" cy=\\\"10\\\" r=\\\"3\\\" fill=\\\"rgba(255,216,181,0.05)\\\"/>\\n          <circle cx=\\\"120\\\" cy=\\\"100\\\" r=\\\"2.5\\\" fill=\\\"rgba(255,255,255,0.02)\\\"/>\\n        </pattern>\\n        <filter id=\\\"grain\\\"><feTurbulence baseFrequency=\\\"0.8\\\" numOctaves=\\\"1\\\" stitchTiles=\\\"stitch\\\"/><feColorMatrix type=\\\"saturate\\\" values=\\\"0\\\"/></filter>\\n      </defs>\\n      <rect width=\\\"1200\\\" height=\\\"800\\\" fill=\\\"url(#g1)\\\"/>\\n      <rect width=\\\"1200\\\" height=\\\"800\\\" fill=\\\"url(#p1)\\\" opacity=\\\"0.45\\\"/>\\n      <g fill=\\\"none\\\" stroke=\\\"rgba(255,216,181,0.035)\\\" stroke-width=\\\"1\\\">\\n        <path d=\\\"M0 700 C300 500 900 900 1200 700\\\"/>\\n        <path d=\\\"M0 600 C400 350 800 850 1200 600\\\"/>\\n      </g>\\n    </svg>\\n\\n    <nav>\\n      <div class=\\\"brand\\\"><span class=\\\"dot\\\"></span><div>{{BUSINESS_NAME}}</div></div>\\n      <div class=\\\"navlinks\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\" class=\\\"cta\\\">Gatherings</a>\\n        <a href=\\\"private-sessions.html\\\">Sessions</a>\\n        <a href=\\\"pricing.html\\\">Rates</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </div>\\n    </nav>\\n\\n    <header class=\\\"hero\\\" role=\\\"banner\\\">\\n      <div class=\\\"hero-card\\\">\\n        <div class=\\\"kicker\\\">Sound & Stillness</div>\\n        <h1>Community sound baths — drift, restore, arrive</h1>\\n        <p class=\\\"lead\\\">A curated immersive experience blending resonant instruments and guided rest to cultivate deep relaxation and clearer focus. Settle into blankets, breathe, and let the waves of sound do the work.</p>\\n        <div class=\\\"next\\\">\\n          <div class=\\\"bubble\\\">Next event</div>\\n          <div style=\\\"color:#fff;font-weight:700\\\">{{NEXT_EVENT_DATE}}</div>\\n        </div>\\n        <div class=\\\"calendar card\\\" aria-label=\\\"upcoming events\\\">\\n          <div class=\\\"event-item\\\">\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Monthly Sound Bath — Full Session</div>\\n              <div class=\\\"meta\\\">Evening circle • 75 minutes • {{VENUE_NAME}} • {{CITY}}, {{STATE}}</div>\\n            </div>\\n            <div style=\\\"text-align:right\\\">\\n              <div class=\\\"price\\\">$35</div>\\n              <a href=\\\"book.html\\\" style=\\\"display:inline-block;margin-top:8px;background:var(--accent);color:#082226;padding:8px 10px;border-radius:8px;text-decoration:none;font-weight:700\\\">Reserve</a>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"event-item\\\">\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Sound & Breath — Morning Mini</div>\\n              <div class=\\\"meta\\\">45 min • Gentle start • Light movement</div>\\n            </div>\\n            <div class=\\\"meta\\\">$20</div>\\n          </div>\\n\\n          <div class=\\\"event-item\\\">\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Full Moon Restorative</div>\\n              <div class=\\\"meta\\\">90 min • Ritual seating • Deep resonance</div>\\n            </div>\\n            <div class=\\\"meta\\\">$45</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\" style=\\\"height:100%\\\">\\n        <div style=\\\"display:flex;flex-direction:column;gap:12px\\\">\\n          <div style=\\\"font-weight:700;color:#fff\\\">What to expect</div>\\n          <div class=\\\"what\\\">Arrive 10–15 minutes early to settle. Bring a yoga mat, blanket, pillow, and water. Wear comfy layers; we provide eye masks upon request.</div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <div style=\\\"font-weight:700;color:#fff;margin-bottom:6px\\\">Instruments you'll hear</div>\\n            <div style=\\\"color:var(--muted)\\\">Crystal singing bowls, wind chimes, gong embers — layered to wash and ripple through the room.</div>\\n          </div>\\n\\n          <div style=\\\"margin-top:14px\\\">\\n            <a href=\\\"book.html\\\" class=\\\"pill\\\">Join the circle</a>\\n            <a href=\\\"contact.html\\\" style=\\\"margin-left:8px;color:var(--muted);text-decoration:none\\\">Ask a question</a>\\n          </div>\\n        </div>\\n      </aside>\\n    </header>\\n\\n    <main class=\\\"content\\\">\\n      <div class=\\\"grid-2\\\">\\n        <section class=\\\"card benefits\\\">\\n          <h3 style=\\\"color:#fff\\\">How it helps</h3>\\n          <p class=\\\"lead\\\" style=\\\"margin-top:6px;color:var(--muted)\\\">Multi-sensory resonance supports nervous system regulation and encourages embodied rest.</p>\\n          <ul style=\\\"margin-top:12px\\\">\\n            <li class=\\\"benefit\\\">Improved sleep and slower heart rate</li>\\n            <li class=\\\"benefit\\\">Reduced stress markers and softened tension</li>\\n            <li class=\\\"benefit\\\">Heightened body awareness and mental clarity</li>\\n            <li class=\\\"benefit\\\">Community-held space for reflection and letting go</li>\\n          </ul>\\n        </section>\\n\\n        <aside class=\\\"card\\\">\\n          <h4 style=\\\"color:#fff;margin:0 0 8px\\\">Testimonials</h4>\\n          <div class=\\\"testimonials\\\">\\n            <blockquote style=\\\"color:var(--muted)\\\">\\\"I left feeling like I slept for eight hours in one sitting.\\\" — A.\\n            </blockquote>\\n            <blockquote style=\\\"color:var(--muted)\\\">\\\"The waves of sound shifted something gentle and stubborn inside.\\\" — M.</blockquote>\\n          </div>\\n        </aside>\\n      </div>\\n\\n      <section class=\\\"card process\\\" style=\\\"margin-top:20px\\\">\\n        <h3 style=\\\"color:#fff\\\">Session flow</h3>\\n        <ol style=\\\"margin-top:8px\\\">\\n          <li>Welcome & gentle intention setting (5–10 min)</li>\\n          <li>Short guided breath to ground the body (5 min)</li>\\n          <li>Sound immersion — layered instruments and guided cues (45–60 min)</li>\\n          <li>Soft re-entry: light movement, tea, shared space (10–15 min)</li>\\n        </ol>\\n\\n        <div class=\\\"disclaimer\\\" role=\\\"note\\\">Contraindications: If you are pregnant, have a history of seizures, uncontrolled epilepsy, or a pacemaker/implant, consult your physician before attending. Sound can affect vestibular sensitivity—sit near the room edge if concerned.</div>\\n      </section>\\n\\n      <section style=\\\"margin-top:20px\\\" class=\\\"card faq\\\">\\n        <h3 style=\\\"color:#fff\\\">Quick FAQs</h3>\\n        <details style=\\\"margin-top:10px;color:var(--muted)\\\"><summary style=\\\"cursor:pointer\\\">Do I need experience?</summary><div style=\\\"margin-top:8px\\\">No. People from all backgrounds attend — we offer simple cues and gentle guidance to help you settle in.</div></details>\\n        <details style=\\\"margin-top:8px;color:var(--muted)\\\"><summary style=\\\"cursor:pointer\\\">Can I bring a friend?</summary><div style=\\\"margin-top:8px\\\">Yes — bring a companion, or book private sessions for shared experiences.</div></details>\\n      </section>\\n\\n      <section style=\\\"margin-top:20px\\\" class=\\\"card leadmag\\\">\\n        <h3 style=\\\"color:#fff\\\">Join the mailing list — receive a free 8-minute audio grounding</h3>\\n        <p style=\\\"color:var(--muted);margin:0\\\">Enter your email for event updates, seasonal series, and occasional sound meditations.</p>\\n        <form action=\\\"\\\" onsubmit=\\\"event.preventDefault();alert('Thanks — we will send the grounding.');\\\" style=\\\"margin-top:10px;display:flex;gap:8px\\\">\\n          <input type=\\\"email\\\" placeholder=\\\"you@domain.com\\\" aria-label=\\\"email\\\" required>\\n          <button type=\\\"submit\\\">Send the grounding</button>\\n        </form>\\n      </section>\\n    </main>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a></div>\\n      <div>\\n        <a href=\\\"book.html\\\" class=\\\"foot-cta\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Private Sessions — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071018;--panel:#0e2630;--accent:#e9d6b8;--muted:#9fb0b7}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;color:#eaf6f9;background:linear-gradient(180deg,var(--bg),#071827);-webkit-font-smoothing:antialiased}\\n    header{padding:22px 30px;display:flex;align-items:center;gap:18px}\\n    .logo{font-weight:800;color:var(--accent)}\\n    .links{margin-left:auto;display:flex;gap:12px}\\n    .links a{color:var(--muted);text-decoration:none;padding:8px 10px;border-radius:8px}\\n    .links a.primary{background:linear-gradient(90deg,#ffd8b5,#ffcf9b);color:#072122;font-weight:700}\\n\\n    .hero{padding:28px 30px 20px;display:grid;grid-template-columns:1fr 320px;gap:20px}\\n    .hero .intro{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:20px;border-radius:12px}\\n    h1{margin:0 0 10px}\\n    .offerings{display:flex;flex-direction:column;gap:12px;margin-top:12px}\\n    .offer{background:linear-gradient(90deg,rgba(255,255,255,0.02),transparent);padding:12px;border-radius:10px;display:flex;justify-content:space-between;align-items:center}\\n    .small{color:var(--muted);font-size:13px}\\n\\n    main{padding:0 30px 60px}\\n    .cols{display:grid;grid-template-columns:1fr 360px;gap:20px;margin-top:22px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px}\\n    .types{display:grid;gap:12px}\\n\\n    .price{font-weight:800;color:var(--accent)}\\n    .cta{display:inline-block;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,#ffd8b5,#ffb57a);color:#072122;text-decoration:none;font-weight:700}\\n\\n    .faq summary{cursor:pointer}\\n    .notice{font-size:13px;color:#ffdede;background:linear-gradient(90deg,rgba(255,120,120,0.04),transparent);padding:10px;border-radius:8px}\\n\\n    @media(max-width:900px){.hero{grid-template-columns:1fr}.cols{grid-template-columns:1fr}.links{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav class=\\\"links\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Gatherings</a>\\n      <a href=\\\"private-sessions.html\\\" class=\\\"primary\\\">Private</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n    </nav>\\n  </header>\\n\\n  <section class=\\\"hero\\\">\\n    <div class=\\\"intro\\\">\\n      <h1>Private sound sessions — personalized resonance</h1>\\n      <p class=\\\"small\\\">Tailored experiences for individuals, couples, and teams. We bring intention, silence, and rich harmonic textures to support rest, creativity, and group cohesion.</p>\\n\\n      <div class=\\\"offerings\\\">\\n        <div class=\\\"offer\\\">\\n          <div>\\n            <div style=\\\"font-weight:700\\\">1:1 — Deep Listening</div>\\n            <div class=\\\"small\\\">60–90 minutes • Focused therapeutic format</div>\\n          </div>\\n          <div class=\\\"price\\\">from $120</div>\\n        </div>\\n\\n        <div class=\\\"offer\\\">\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Couples — Shared Resonance</div>\\n            <div class=\\\"small\\\">60 minutes • Partner-centered cues</div>\\n          </div>\\n          <div class=\\\"price\\\">from $180</div>\\n        </div>\\n\\n        <div class=\\\"offer\\\">\\n          <div>\\n            <div style=\\\"font-weight:700\\\">Corporate & Groups</div>\\n            <div class=\\\"small\\\">Wellness sessions for teams, retreats, or events</div>\\n          </div>\\n          <div class=\\\"price\\\">custom</div>\\n        </div>\\n      </div>\\n    </div>\\n\\n    <aside class=\\\"card\\\">\\n      <h4 style=\\\"margin:0 0 8px\\\">Quick notes</h4>\\n      <div class=\\\"small\\\">Sessions can be hosted at your venue or our studio. We bring blankets and mats on request; travel fee may apply for corporate bookings.</div>\\n      <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a private</a></div>\\n    </aside>\\n  </section>\\n\\n  <main>\\n    <div class=\\\"cols\\\">\\n      <section class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Formats & flow</h3>\\n        <p class=\\\"small\\\">Each private session is curated to the client’s threshold and intention. Below are common frames — we adapt on the day.</p>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:8px 0\\\">1:1 Session</h4>\\n          <ol>\\n            <li class=\\\"small\\\">Intake & intention (5–10 min)</li>\\n            <li class=\\\"small\\\">Guided centering and conscious breath (5 min)</li>\\n            <li class=\\\"small\\\">Sound immersion with targeted instruments (40–60 min)</li>\\n            <li class=\\\"small\\\">Gentle re-entry and reflections (5–10 min)</li>\\n          </ol>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:8px 0\\\">Couples & Pairs</h4>\\n          <p class=\\\"small\\\">Shared soundbeds and alternating focus points — a connective listening container that supports communication and presence.</p>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:8px 0\\\">Corporate & Team</h4>\\n          <p class=\\\"small\\\">We design short rituals (20–40 min) for onboarding into a creative flow or debriefing after intensive work. Includes brief facilitation and a grounding audio for the team.</p>\\n        </div>\\n\\n        <div class=\\\"notice\\\" style=\\\"margin-top:12px\\\">Contraindications: If you have a pacemaker, a history of epilepsy, or are pregnant, please consult with a physician before booking. Some instruments may produce low-frequency vibrations—inform the facilitator of any sensitivity.</div>\\n      </section>\\n\\n      <aside class=\\\"card\\\">\\n        <h4 style=\\\"margin-top:0\\\">Instruments & sonic palette</h4>\\n        <ul style=\\\"color:var(--muted);padding-left:16px\\\">\\n          <li>Hz-tuned singing bowls (quartz & ceramic)</li>\\n          <li>Tuning forks for targeted somatic points</li>\\n          <li>Monochord strings for continuous harmonic drone</li>\\n          <li>Soft chimes for breath and punctuation</li>\\n        </ul>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:6px 0\\\">What to bring</h4>\\n          <p class=\\\"small\\\">A yoga mat or soft surface, a blanket, a water bottle, and if you like, a scarf or eye cushion. Wear comfortable layers.</p>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px\\\">\\n          <h4 style=\\\"margin:6px 0\\\">Lead facilitator</h4>\\n          <div class=\\\"small\\\">{{FACILITATOR_NAME}} — certified sound practitioner and somatic guide.</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Request a session</a></div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:20px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin-top:0\\\">Group bookings & corporate wellness</h3>\\n      <p class=\\\"small\\\">We design bespoke programs for retreats, conference breakouts, and executive wellbeing. Pricing scales by group size and travel requirements. Reach out via <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a> for a tailored proposal.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\" class=\\\"card faq\\\">\\n      <h3 style=\\\"margin-top:0\\\">FAQs — Private offerings</h3>\\n      <details style=\\\"margin-top:10px;color:var(--muted)\\\"><summary>How far in advance should I book?</summary><div style=\\\"margin-top:8px\\\">For private 1:1s, 1–2 weeks is ideal. Corporate requests benefit from 4+ weeks for planning.</div></details>\\n      <details style=\\\"margin-top:8px;color:var(--muted)\\\"><summary>Can you travel to our site?</summary><div style=\\\"margin-top:8px\\\">Yes. Travel and setup fees apply; we bring compact, studio-grade instruments and soft furnishings as needed.</div></details>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin-top:0\\\">Reserve a consult</h3>\\n      <p class=\\\"small\\\">Start with a short planning call to define intentions and logistics. We'll recommend a format and instruments that best support your goals.</p>\\n      <form onsubmit=\\\"event.preventDefault();alert('Thanks — we will contact you to arrange a consult.');\\\">\\n        <input name=\\\"name\\\" placeholder=\\\"Your name\\\" style=\\\"width:100%;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);margin-bottom:8px;background:transparent;color:#fff\\\">\\n        <input name=\\\"email\\\" placeholder=\\\"Email\\\" style=\\\"width:100%;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);margin-bottom:8px;background:transparent;color:#fff\\\">\\n        <button type=\\\"submit\\\" style=\\\"padding:10px 14px;border-radius:8px;background:linear-gradient(90deg,#ffd8b5,#ffcf9b);border:0;color:#072122;font-weight:700\\\">Request consult</button>\\n      </form>\\n    </section>\\n  </main>\\n\\n  <footer style=\\\"padding:18px 30px;color:var(--muted);display:flex;justify-content:space-between;align-items:center\\\">\\n    <div>{{BUSINESS_NAME}} — private sessions • {{CITY}}, {{STATE}}</div>\\n    <div><a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Rates & Add-ons — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bgA:#071021;--card:#0d2330;--accent:#ffd9b2;--muted:#9fb0bb}\\n    body{margin:0;font-family:Inter,system-ui,Roboto,Arial;color:#eaf6fb;background:linear-gradient(180deg,var(--bgA),#071424)}\\n    header{display:flex;align-items:center;gap:12px;padding:20px 28px}\\n    header .logo{font-weight:800;color:var(--accent)}\\n    nav{margin-left:auto}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:10px}\\n\\n    .hero{padding:28px 28px 6px}\\n    h1{margin:0;color:#fff}\\n    .sub{color:var(--muted);margin-top:8px}\\n\\n    main{padding:20px 28px 56px}\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\\n    .tier{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.02)}\\n    .tier h3{margin:0 0 8px}\\n    .price{font-size:20px;font-weight:800;color:var(--accent)}\\n\\n    .addon{margin-top:12px;padding:12px;background:rgba(255,255,255,0.02);border-radius:10px}\\n    .note{font-size:13px;color:#ffdede;background:linear-gradient(90deg,rgba(255,120,120,0.04),transparent);padding:10px;border-radius:8px;margin-top:12px}\\n\\n    .compare{margin-top:20px}\\n    table{width:100%;border-collapse:collapse;color:var(--muted)}\\n    td,th{padding:12px;border-bottom:1px solid rgba(255,255,255,0.03)}\\n\\n    footer{padding:20px 28px;color:var(--muted);display:flex;justify-content:space-between}\\n\\n    @media(max-width:1000px){.tiers{grid-template-columns:1fr}} \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Events</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <section class=\\\"hero\\\">\\n    <h1>Rates, passes & retail</h1>\\n    <p class=\\\"sub\\\">Clear pricing and optional retail add-ons so you can deepen your practice between sessions.</p>\\n  </section>\\n\\n  <main>\\n    <section class=\\\"tiers\\\">\\n      <div class=\\\"tier\\\">\\n        <h3>Drop-in</h3>\\n        <div class=\\\"price\\\">$35</div>\\n        <p class=\\\"sub\\\">Single community session. Great for first-timers and occasional rest.</p>\\n        <div style=\\\"margin-top:10px\\\"><a href=\\\"book.html\\\" style=\\\"background:linear-gradient(90deg,#ffd8b5,#ffb57a);padding:8px 12px;border-radius:8px;color:#072122;text-decoration:none;font-weight:700\\\">Reserve</a></div>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <h3>Series — 4 classes</h3>\\n        <div class=\\\"price\\\">$120</div>\\n        <p class=\\\"sub\\\">A small series for consistency and deeper nervous system change.</p>\\n        <div style=\\\"margin-top:10px\\\"><a href=\\\"book.html\\\" style=\\\"background:linear-gradient(90deg,#ffd8b5,#ffb57a);padding:8px 12px;border-radius:8px;color:#072122;text-decoration:none;font-weight:700\\\">Enroll</a></div>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <h3>Private 1:1</h3>\\n        <div class=\\\"price\\\">from $120</div>\\n        <p class=\\\"sub\\\">Tailored deep-listening session. See private sessions for formats and add-ons.</p>\\n        <div style=\\\"margin-top:10px\\\"><a href=\\\"private-sessions.html\\\" style=\\\"background:linear-gradient(90deg,#ffd8b5,#ffb57a);padding:8px 12px;border-radius:8px;color:#072122;text-decoration:none;font-weight:700\\\">Inquire</a></div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"color:#fff\\\">Add-ons & retail</h3>\\n      <div class=\\\"addon\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><div style=\\\"font-weight:700\\\">Handmade eye pillows</div><div class=\\\"price\\\">$18</div></div>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">Organic flax & lavender — a small aid for deeper rest during practice.</div>\\n      </div>\\n\\n      <div class=\\\"addon\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><div style=\\\"font-weight:700\\\">Travel-sized tuning fork set</div><div class=\\\"price\\\">$45</div></div>\\n        <div style=\\\"color:var(--muted);margin-top:6px\\\">Two forks tuned for balancing breath and somatic points — useful for daily micro-practices.</div>\\n      </div>\\n\\n      <div class=\\\"note\\\">All retail purchases are final. Session cancellations with less than 48 hours notice are subject to a 50% fee. For group bookings and retreats, custom invoicing is available.</div>\\n    </section>\\n\\n    <section class=\\\"compare card\\\" style=\\\"margin-top:18px;padding:18px;border-radius:12px\\\">\\n      <h3 style=\\\"margin-top:0;color:#fff\\\">What's included</h3>\\n      <table aria-label=\\\"comparison table\\\">\\n        <thead>\\n          <tr><th></th><th style=\\\"text-align:left\\\">Drop-in</th><th style=\\\"text-align:left\\\">Series</th><th style=\\\"text-align:left\\\">Private</th></tr>\\n        </thead>\\n        <tbody>\\n          <tr><td>Length</td><td>60–75 min</td><td>60–75 min</td><td>60–90 min</td></tr>\\n          <tr><td>Guided intention</td><td>✓</td><td>✓</td><td>✓ (tailored)</td></tr>\\n          <tr><td>Take-home audio</td><td></td><td>✓</td><td>✓</td></tr>\\n          <tr><td>Retail discount</td><td></td><td>5%</td><td>10%</td></tr>\\n        </tbody>\\n      </table>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin-top:0;color:#fff\\\">Practical — what to bring & accessibility</h3>\\n      <p class=\\\"sub\\\">Bring a mat, a blanket, and an eye pillow if you have one. We keep a few extras, but personal items are more comfortable. Most venues are accessible; contact us if you need assistance with seating or entry.</p>\\n      <div class=\\\"note\\\" style=\\\"margin-top:12px\\\">Contraindications reminder: consult your healthcare provider if you have a pacemaker, epilepsy, or are pregnant. Low-frequency instruments may be felt physically; let your facilitator know about sensitivities.</div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin-top:0;color:#fff\\\">Questions about pricing?</h3>\\n      <p class=\\\"sub\\\">Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{PHONE}}</a> — we’re happy to walk through options and build a package that fits your needs.</p>\\n      <div style=\\\"margin-top:12px\\\"><a href=\\\"book.html\\\" style=\\\"background:linear-gradient(90deg,#ffd8b5,#ffb57a);padding:10px 14px;border-radius:8px;color:#072122;text-decoration:none;font-weight:700\\\">Book now</a></div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"padding:12px 28px;color:var(--muted)\\\">{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n    <div style=\\\"padding:12px 28px;color:var(--muted)\\\"><a href=\\\"index.html\\\" style=\\\"color:var(--muted);text-decoration:none\\\">Back to home</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
