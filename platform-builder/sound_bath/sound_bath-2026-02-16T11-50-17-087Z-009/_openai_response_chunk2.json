          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Gatherings &amp; Events — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0b0f12;--card:#0f1720;--muted:#9aa6af;--accent:#8ad0d6;--glass:rgba(255,255,255,0.04);font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg),#071017 60%);color:#e6eef2}\\n    .viewport{min-height:100vh;display:flex;flex-direction:column}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 28px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);backdrop-filter:blur(6px)}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,#0f2130,#132833);display:grid;place-items:center;box-shadow:0 4px 18px rgba(0,0,0,0.6)}\\n    .logo svg{width:34px;height:34px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:15px}\\n    nav a:hover{color:var(--accent)}\\n    .hero{display:grid;grid-template-columns:1fr 420px;gap:28px;padding:42px 28px 28px}\\n\\n    /* decorative SVG backdrop */\\n    .bg-svg{position:fixed;right:-8vw;top:-6vh;width:70vw;height:120vh;opacity:0.12;pointer-events:none}\\n\\n    .intro{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:34px;border-radius:12px;box-shadow:0 8px 30px rgba(2,8,23,0.6)}\\n    h1{margin:0 0 8px;color:#e9fbff;font-weight:600;letter-spacing:-0.4px}\\n    p.lead{margin:0;color:var(--muted);line-height:1.6}\\n    .panel{background:var(--card);padding:18px;border-radius:10px;margin-top:18px}\\n    .next{display:flex;justify-content:space-between;align-items:center}\\n    .next .when{font-weight:600;color:#dff7fb}\\n    .calendar{margin-top:14px;display:grid;grid-template-columns:repeat(2,1fr);gap:10px}\\n    .cal-item{background:var(--glass);padding:10px;border-radius:8px;font-size:14px;color:var(--muted);display:flex;justify-content:space-between}\\n    footer{padding:28px;text-align:center;color:var(--muted);font-size:13px}\\n\\n    /* modules */\\n    .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:22px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:10px}\\n    .pillars li{margin:10px 0;color:var(--muted)}\\n    .truths{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:18px}\\n    .truths .item{background:var(--glass);padding:14px;border-radius:8px}\\n    .cta-row{display:flex;gap:12px;margin-top:18px}\\n    .btn{background:linear-gradient(90deg,var(--accent),#6fc5cc);color:#042022;padding:12px 16px;border-radius:10px;text-decoration:none;font-weight:600}\\n    .ghost{border:1px solid rgba(255,255,255,0.06);padding:12px 16px;border-radius:10px;color:var(--muted);text-decoration:none}\\n    .faq{margin-top:18px}\\n    .faq dt{font-weight:600;margin-top:12px}\\n    .faq dd{margin:6px 0 12px;color:var(--muted)}\\n    .case{margin-top:18px;display:grid;grid-template-columns:1fr 1fr;gap:10px}\\n    .case .note{background:rgba(255,255,255,0.02);padding:12px;border-radius:8px;color:var(--muted)}\\n\\n    @media(max-width:980px){.hero{grid-template-columns:1fr;padding:22px}.calendar{grid-template-columns:1fr}.grid-3{grid-template-columns:1fr}.case{grid-template-columns:1fr 1fr}}\\n    @media(max-width:560px){.hero{grid-template-columns:1fr}.brand{gap:8px}.logo{width:40px;height:40px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"viewport\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\" aria-hidden=\\\"true\\\">\\n          <svg viewBox=\\\"0 0 48 48\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n            <defs>\\n              <radialGradient id=\\\"g1\\\" cx=\\\"0.5\\\" cy=\\\"0.5\\\" r=\\\"0.6\\\"><stop offset=\\\"0%\\\" stop-color=\\\"#a8f0ef\\\"/><stop offset=\\\"100%\\\" stop-color=\\\"#3a7f86\\\"/></radialGradient>\\n            </defs>\\n            <rect width=\\\"48\\\" height=\\\"48\\\" rx=\\\"10\\\" fill=\\\"#07131a\\\"/>\\n            <circle cx=\\\"24\\\" cy=\\\"20\\\" r=\\\"12\\\" fill=\\\"url(#g1)\\\" opacity=\\\"0.95\\\"/>\\n          </svg>\\n        </div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Events</a>\\n        <a href=\\\"private-sessions.html\\\">Sessions</a>\\n        <a href=\\\"pricing.html\\\">Rates</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </nav>\\n    </header>\\n\\n    <!-- decorative svg pattern -->\\n    <svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 800 1200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" preserveAspectRatio=\\\"xMidYMid slice\\\">\\n      <defs>\\n        <linearGradient id=\\\"lg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#0b2730\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#07303a\\\"/></linearGradient>\\n        <filter id=\\\"blur\\\"><feGaussianBlur stdDeviation=\\\"50\\\"/></filter>\\n      </defs>\\n      <g filter=\\\"url(#blur)\\\">\\n        <circle cx=\\\"620\\\" cy=\\\"180\\\" r=\\\"260\\\" fill=\\\"url(#lg)\\\"/>\\n        <g opacity=\\\"0.8\\\" fill=\\\"#79d5d9\\\">\\n          <path d=\\\"M120 900c60-120 260-160 380-80s240 190 360 120\\\" stroke=\\\"#79d5d9\\\" stroke-width=\\\"1\\\" fill=\\\"none\\\"/>\\n        </g>\\n      </g>\\n    </svg>\\n\\n    <main>\\n      <section class=\\\"hero\\\">\\n        <div class=\\\"intro\\\">\\n          <h1>Gathering in sound — intentional, sensorily curated</h1>\\n          <p class=\\\"lead\\\">Join a carefully guided sound bath in {{CITY}}, {{STATE}}. The session balances slow, grounding tones with subtle dynamic swells to open nervous-system regulation. Our group gatherings are designed for sensory safety and deep rest.</p>\\n\\n          <div class=\\\"panel\\\">\\n            <div class=\\\"next\\\">\\n              <div>\\n                <div style=\\\"font-size:13px;color:var(--muted)\\\">Next event</div>\\n                <div class=\\\"when\\\">{{NEXT_EVENT_DATE}} • {{VENUE_NAME}}</div>\\n              </div>\\n              <div style=\\\"text-align:right\\\">\\n                <div style=\\\"font-size:13px;color:var(--muted)\\\">Capacity</div>\\n                <div style=\\\"font-weight:600;color:#dff7fb\\\">18 spots</div>\\n              </div>\\n            </div>\\n\\n            <div class=\\\"calendar\\\" aria-hidden=\\\"false\\\">\\n              <div class=\\\"cal-item\\\"><span>Mar 12</span><span>Evening Bath</span></div>\\n              <div class=\\\"cal-item\\\"><span>Apr 02</span><span>Full Moon</span></div>\\n              <div class=\\\"cal-item\\\"><span>Apr 24</span><span>Rest &amp; Reset</span></div>\\n              <div class=\\\"cal-item\\\"><span>May 06</span><span>Community Sound</span></div>\\n            </div>\\n\\n            <div class=\\\"cta-row\\\">\\n              <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n              <a class=\\\"ghost\\\" href=\\\"book.html\\\">Reserve a spot</a>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <aside>\\n          <div class=\\\"panel\\\">\\n            <h3 style=\\\"margin:0 0 8px\\\">Session snapshot</h3>\\n            <div style=\\\"color:var(--muted);font-size:14px\\\">Arrive 15 minutes early. 75 minute sound journey: 10 min settling, 50 min immersive resonance, 15 min gentle re-orientation and integration.</div>\\n\\n            <ul class=\\\"pillars\\\" style=\\\"margin-top:12px;list-style:none;padding:0\\\">\\n              <li><strong>Sensory-first</strong> — layers of texture and silence to guide nervous system down.</li>\\n              <li><strong>Curated instrumentation</strong> — curated selection of bowls, gong and chimes tuned to intention.</li>\\n              <li><strong>Gentle structure</strong> — soft openings and clear closing to keep transitions safe.</li>\\n            </ul>\\n          </div>\\n\\n          <div class=\\\"panel\\\" style=\\\"margin-top:16px\\\">\\n            <h4 style=\\\"margin:0 0 8px\\\">Instruments on this evening</h4>\\n            <div style=\\\"color:var(--muted)\\\">A tapestry of crystal singing bowls, a deep gong for body resonance, and delicate chimes for micro-attunement.</div>\\n          </div>\\n        </aside>\\n      </section>\\n\\n      <section style=\\\"padding:0 28px 28px\\\">\\n        <div class=\\\"card\\\">\\n          <h2 style=\\\"margin-top:0\\\">Common myths &amp; measured truths</h2>\\n          <div class=\\\"truths\\\">\\n            <div class=\\\"item\\\">\\n              <strong>Myth:</strong> Sound baths are just about pleasant noise.\\n              <div style=\\\"color:var(--muted);margin-top:6px\\\">Truth: They are intentional somatic practices using frequency, silence, and pacing to shift nervous system states.</div>\\n            </div>\\n            <div class=\\\"item\\\">\\n              <strong>Myth:</strong> You must meditate perfectly to benefit.\\n              <div style=\\\"color:var(--muted);margin-top:6px\\\">Truth: Benefits arise from relaxed attention and physiological resonance, not from performance.</div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"grid-3\\\">\\n          <div class=\\\"card\\\">\\n            <h3 style=\\\"margin:0 0 8px\\\">What to bring</h3>\\n            <ul style=\\\"color:var(--muted);margin:0;padding-left:18px\\\">\\n              <li>Yoga mat or futon</li>\\n              <li>Blanket &amp; small cushion</li>\\n              <li>Light eye cover (optional)</li>\\n            </ul>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <h3 style=\\\"margin:0 0 8px\\\">Contraindications &amp; safety</h3>\\n            <p style=\\\"color:var(--muted);margin:0\\\">If you are pregnant, have uncontrolled seizures, a cardiac device, or are undergoing intense psychiatric treatment, consult your clinician before attending. Not a substitute for medical care.</p>\\n          </div>\\n\\n          <div class=\\\"card\\\">\\n            <h3 style=\\\"margin:0 0 8px\\\">The flow</h3>\\n            <ol style=\\\"color:var(--muted);margin:0;padding-left:18px\\\">\\n              <li>Arrival &amp; grounding.</li>\\n              <li>Breathwork and intention setting (soft, guided).</li>\\n              <li>Immersive soundscape (primary) — progressive layers and rests.</li>\\n              <li>Slow reorientation and sharing (optional).</li>\\n            </ol>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"case\\\">\\n          <div class=\\\"note\\\">\\n            <strong>Case note:</strong>\\n            <div style=\\\"color:var(--muted);margin-top:6px\\\">Participant A reported decreased heart-rate variability during loud gong moments and improved sleep for three nights after attending twice.</div>\\n          </div>\\n          <div class=\\\"note\\\">\\n            <strong>Case note:</strong>\\n            <div style=\\\"color:var(--muted);margin-top:6px\\\">A small group returned for a workplace lunchtime reset and reported sustained focus for the afternoon.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"faq\\\">\\n          <h3 style=\\\"margin:18px 0 6px\\\">Frequently asked</h3>\\n          <dl>\\n            <dt>Do I need experience?</dt>\\n            <dd>No. Come curious. The session is accessible to newcomers and seasoned listeners.</dd>\\n            <dt>Is it loud?</dt>\\n            <dd>Sound is calibrated for comfort; there are deliberate soft passages and crescendos that are held in service of regulation, not startle.</dd>\\n            <dt>How long is each session?</dt>\\n            <dd>About 75 minutes total including brief arrival and integration.</dd>\\n          </dl>\\n        </div>\\n\\n        <div style=\\\"margin-top:18px\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a space</a>\\n          <a class=\\\"ghost\\\" href=\\\"about.html\\\">Meet the facilitator</a>\\n        </div>\\n      </section>\\n    </main>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} — quiet, intentional gatherings in {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Private Sessions — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#07121a;--panel:#0e1a20;--soft:#bfeff2;--muted:#9fb0b6;--primary:#7dd2cf;font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Arial}\\n    body{margin:0;background:radial-gradient(800px 400px at 10% 10%,rgba(125,210,207,0.06),transparent),linear-gradient(180deg,#041018,#06171b);color:#e9fbff}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 24px}\\n    .nav a{margin-left:16px;color:var(--muted);text-decoration:none}\\n    .nav a:hover{color:var(--primary)}\\n    .wrap{max-width:980px;margin:20px auto;padding:0 18px}\\n\\n    .hero{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:28px;border-radius:12px;display:flex;gap:18px}\\n    .hero .left{flex:1}\\n    .hero h1{margin:0 0 6px}\\n    .hero p{margin:0;color:var(--muted)}\\n    .aside{width:320px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:10px}\\n\\n    .offers{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px}\\n    .offer{background:var(--panel);padding:16px;border-radius:10px}\\n    .offer h4{margin:0 0 8px}\\n    .flow{margin-top:12px;color:var(--muted)}\\n\\n    .faq{margin-top:18px;background:rgba(255,255,255,0.02);padding:16px;border-radius:10px}\\n    .btn{display:inline-block;padding:10px 14px;border-radius:9px;background:linear-gradient(90deg,var(--primary),#5fb8b5);color:#012022;text-decoration:none;font-weight:700}\\n    .muted{color:var(--muted)}\\n\\n    /* small decorative pattern */\\n    .svg-deco{position:absolute;left:-6%;top:40%;opacity:0.08;width:40vw;height:60vh;pointer-events:none}\\n\\n    @media(max-width:860px){.hero{flex-direction:column}.aside{width:100%}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div style=\\\"width:44px;height:44px;border-radius:8px;background:linear-gradient(135deg,#06333a,#11333a)\\\"></div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">Calm, clinical attention to sonic detail</div>\\n      </div>\\n    </div>\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Gatherings</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <svg class=\\\"svg-deco\\\" viewBox=\\\"0 0 500 800\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"g2\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0%\\\" stop-color=\\\"#6fe0db\\\"/><stop offset=\\\"100%\\\" stop-color=\\\"#2f99a0\\\"/></linearGradient>\\n    </defs>\\n    <g fill=\\\"url(#g2)\\\">\\n      <ellipse cx=\\\"120\\\" cy=\\\"380\\\" rx=\\\"220\\\" ry=\\\"120\\\" />\\n      <rect x=\\\"60\\\" y=\\\"120\\\" width=\\\"300\\\" height=\\\"60\\\" rx=\\\"30\\\"/>\\n    </g>\\n  </svg>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"left\\\">\\n        <h1>Private sound work — tailored for one or a few</h1>\\n        <p class=\\\"muted\\\">Hybrid offerings for individuals, couples, and teams. Sessions are calibrated to your needs: restorative, performance recovery, or workplace resilience.</p>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Inquire / Book</a>\\n          <a href=\\\"about.html\\\" style=\\\"margin-left:12px;color:var(--muted);text-decoration:none\\\">Who guides</a>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"aside\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">Why private?</h3>\\n        <div class=\\\"muted\\\">Focused rhythm and volume control, intentional instruments positioned for individual somatic feedback, and tailored integration notes for home practice.</div>\\n        <div style=\\\"margin-top:12px;font-size:13px;color:var(--muted)\\\"><strong>Typical length:</strong> 60–90 minutes.</div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"offers\\\">\\n      <div class=\\\"offer\\\">\\n        <h4>1:1 - Individual session</h4>\\n        <div class=\\\"muted\\\">Personal assessment followed by a focused sound journey. Includes post-session notes and a brief integration plan.</div>\\n        <div class=\\\"flow\\\">\\n          <strong>Instruments:</strong> tuning forks for micro-frequency, a warm monochord drone, and handpan accents for tactile resonance.\\n        </div>\\n      </div>\\n\\n      <div class=\\\"offer\\\">\\n        <h4>Couples &amp; small-group</h4>\\n        <div class=\\\"muted\\\">Shared intention work with paired listening exercises and relational attunement protocols.</div>\\n        <div class=\\\"flow\\\"><strong>Instruments:</strong> two sets of Tibetan bowls, soft chimes for call-and-response, and a single crystal bowl for shared focus.</div>\\n      </div>\\n\\n      <div class=\\\"offer\\\">\\n        <h4>Corporate / team</h4>\\n        <div class=\\\"muted\\\">Short-format resets or longer immersion for leadership retreats. We consult on environment and timing.</div>\\n        <div class=\\\"flow\\\"><strong>Instruments:</strong> tuned gongs for clearing, lap harps for ambient wash, and subtle tuning forks to shape attention.</div>\\n      </div>\\n\\n      <div class=\\\"offer\\\">\\n        <h4>Add-ons</h4>\\n        <div class=\\\"muted\\\">Integration email, recorded grounding track, or a guided breathwork primer can be included with private bookings.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;display:grid;grid-template-columns:1fr 320px;gap:18px\\\">\\n      <div>\\n        <div class=\\\"faq\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">Safety notes &amp; practical guidance</h3>\\n          <p class=\\\"muted\\\" style=\\\"margin:0 0 10px\\\">Please disclose medical implants, epilepsy history, or pregnancy during booking. We will adapt or recommend alternatives when needed.</p>\\n          <dl>\\n            <dt style=\\\"margin-top:8px\\\">What to bring</dt>\\n            <dd class=\\\"muted\\\">Comfy clothing, a water bottle, yoga mat, and any personal props that support comfort.</dd>\\n            <dt style=\\\"margin-top:8px\\\">Contraindications</dt>\\n            <dd class=\\\"muted\\\">Unstable cardiovascular conditions, recent head injuries, or conditions where loud transients are contraindicated require medical clearance.</dd>\\n            <dt style=\\\"margin-top:8px\\\">Session flow</dt>\\n            <dd class=\\\"muted\\\">Assessment (10–15m) → sound immersion (40–60m) → gentle return &amp; written notes (10–15m).</dd>\\n          </dl>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;color:var(--muted)\\\">\\n          <strong>Case note:</strong> A client with chronic shoulder tension reported increased range of motion and reduced pain after three private sessions that sequenced tuning-fork protocols with monochord resonance.\\n        </div>\\n      </div>\\n\\n      <aside style=\\\"background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:16px;border-radius:10px\\\">\\n        <h4 style=\\\"margin:0 0 8px\\\">Book &amp; logistics</h4>\\n        <div style=\\\"color:var(--muted);font-size:14px\\\">Sessions held at {{VENUE_NAME}} or virtually. Travel charges apply for off-site corporate events.</div>\\n        <div style=\\\"margin-top:12px\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Request a quote</a>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Questions people ask</h3>\\n      <div style=\\\"color:var(--muted)\\\">\\n        <strong>Will this help with insomnia?</strong>\\n        <div style=\\\"margin-top:6px\\\">Many clients report improved sleep for several nights after a session; individual responses vary and are contextual. A short series may provide more durable change.</div>\\n      </div>\\n    </section>\\n\\n    <div style=\\\"margin-top:18px\\\">\\n      <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start a private booking</a>\\n      <a href=\\\"contact.html\\\" style=\\\"margin-left:12px;color:var(--muted);text-decoration:none\\\">Questions? Email {{EMAIL}}</a>\\n    </div>\\n\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Rates &amp; Packages — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#021015;--muted:#9fb0b6;--accent:#86d2cf;--card:#0b1a1d;font-family:Inter,system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Arial}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg1),#04191b);color:#eafafb}\\n    .container{max-width:980px;margin:28px auto;padding:0 18px}\\n    header{display:flex;justify-content:space-between;align-items:center;padding-bottom:18px}\\n    header a{color:var(--muted);text-decoration:none;margin-left:12px}\\n\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px}\\n    .pricing{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px}\\n    .tier{background:rgba(255,255,255,0.02);padding:16px;border-radius:10px;margin-bottom:12px}\\n    .tier h3{margin:0 0 6px}\\n    .muted{color:var(--muted)}\\n    .cta{margin-top:12px}\\n    .btn{background:linear-gradient(90deg,var(--accent),#5fc2ba);padding:10px 14px;border-radius:9px;color:#022022;text-decoration:none;font-weight:700}\\n\\n    /* small ornamental svg */\\n    .orn{position:absolute;right:6%;top:14%;opacity:0.06;width:320px;height:320px;pointer-events:none}\\n\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}.orn{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"orn\\\" viewBox=\\\"0 0 300 300\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <radialGradient id=\\\"rg3\\\"><stop offset=\\\"0%\\\" stop-color=\\\"#87e7de\\\"/><stop offset=\\\"100%\\\" stop-color=\\\"#2b8f90\\\"/></radialGradient>\\n    </defs>\\n    <g fill=\\\"url(#rg3)\\\">\\n      <circle cx=\\\"80\\\" cy=\\\"80\\\" r=\\\"70\\\"/>\\n      <path d=\\\"M40 220c40-80 160-100 220-60v140H40z\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Transparent rates for group and tailored work</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Events</a>\\n        <a href=\\\"private-sessions.html\\\">Session Types</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <main class=\\\"grid\\\">\\n      <section class=\\\"pricing\\\">\\n        <h2 style=\\\"margin-top:0\\\">Offerings &amp; pricing</h2>\\n        <p class=\\\"muted\\\">Hybrid model: community baths run regularly and private sessions by appointment. All prices are starting rates; final quotes depend on location, group size, and add-ons.</p>\\n\\n        <div class=\\\"tier\\\">\\n          <h3>Drop-in group session</h3>\\n          <div style=\\\"font-weight:700\\\">$35 / per person</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">75-minute guided sound bath. Instruments may include crystal bowls, shruti box, and wind chimes depending on the evening's design.</div>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <h3>Series (5 classes)</h3>\\n          <div style=\\\"font-weight:700\\\">$160 — save 10%</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Progressive curriculum for nervous system regulation and embodied listening.</div>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <h3>Private 60-minute</h3>\\n          <div style=\\\"font-weight:700\\\">From $220</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Individualized session. Instrumentation commonly uses tuning forks, monochord, and handpan to create focused resonance.</div>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <h3>Corporate half-day</h3>\\n          <div style=\\\"font-weight:700\\\">From $1,100</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Consultation + sound immersion. Includes travel and basic equipment setup. Larger events priced on request.</div>\\n        </div>\\n\\n        <div class=\\\"muted\\\" style=\\\"margin-top:10px\\\">Booking includes a brief intake form to screen for contraindications. Refund and rescheduling policies available at booking.</div>\\n\\n        <div class=\\\"cta\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book or request a quote</a>\\n          <a href=\\\"contact.html\\\" style=\\\"margin-left:10px;color:var(--muted);text-decoration:none\\\">Questions? {{EMAIL}}</a>\\n        </div>\\n      </section>\\n\\n      <aside style=\\\"background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:16px;border-radius:12px\\\">\\n        <h4 style=\\\"margin:0 0 8px\\\">Quick notes</h4>\\n        <ul style=\\\"color:var(--muted);padding-left:18px;margin:0\\\">\\n          <li>Small classes capped at 18 to preserve acoustic integrity.</li>\\n          <li>Private sessions include post-session notes and simple home practices.</li>\\n          <li>Discounts for block bookings and community partners; ask for details.</li>\\n        </ul>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <h5 style=\\\"margin:0 0 6px\\\">What to expect</h5>\\n          <div class=\\\"muted\\\">A calm intake, an immersive sound field tailored to your needs, and a slow, intentional return to wakefulness.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <h5 style=\\\"margin:0 0 6px\\\">Contraindications</h5>\\n          <div class=\\\"muted\\\">If you have a pacemaker, uncontrolled seizures, or are in active psychiatric crisis, please consult your clinician before booking.</div>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <footer style=\\\"margin-top:22px;color:var(--muted);font-size:13px\\\">Questions? Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a></footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
