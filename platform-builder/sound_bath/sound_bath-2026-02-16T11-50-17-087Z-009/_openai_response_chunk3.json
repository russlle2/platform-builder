          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"About {{BUSINESS_NAME}} — clinical, sensory sound baths in {{CITY}}, {{STATE}}.\\\">\\n  <style>\\n    :root{--bg:#0f1720;--card:#07101a;--muted:#9aa8b3;--accent:#88e0d0;--glass:rgba(255,255,255,0.04);--radius:14px}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#e6f7f5;background:linear-gradient(180deg,#081018 0%,#071422 60%)}\\n    header{position:relative;padding:36px 28px;display:flex;align-items:center;justify-content:space-between;z-index:10}\\n    .brand{display:flex;align-items:center;gap:14px}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#6fcadf);display:flex;align-items:center;justify-content:center;color:#032026;font-weight:700;box-shadow:0 6px 18px rgba(12,20,30,0.6)}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:14px}\\n    .hero{padding:36px;border-radius:18px;margin:22px;position:relative;overflow:hidden;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));backdrop-filter:blur(6px);box-shadow:inset 0 1px 0 rgba(255,255,255,0.02)}\\n    .hero-grid{display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:center}\\n    .hero h1{margin:0;font-size:34px;color:#eafffb}\\n    .hero p{color:var(--muted);margin-top:10px;line-height:1.5}\\n    .panel{background:var(--card);padding:20px;border-radius:12px;color:#cfeeea}\\n    .meta{font-size:13px;color:var(--muted)}\\n    .pillars{display:flex;gap:16px;margin:22px}\\n    .pillar{flex:1;padding:20px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);box-shadow:0 4px 18px rgba(2,8,12,0.6)}\\n    .grid-case{display:grid;grid-template-columns:1fr 320px;gap:20px;margin:22px}\\n    footer{padding:28px;color:var(--muted);text-align:center}\\n    button.cta{background:linear-gradient(90deg,var(--accent),#5bbfde);border:0;padding:12px 18px;border-radius:12px;color:#032026;font-weight:600}\\n    /* subtle SVG mask for visual richness */\\n    .pattern{position:absolute;right:-10%;top:-8%;opacity:0.14;filter:blur(20px);transform:rotate(12deg)}\\n    .note{font-size:13px;color:var(--muted)}\\n    @media(max-width:880px){.hero-grid{grid-template-columns:1fr}.grid-case{grid-template-columns:1fr}.pillars{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">SB</div>\\n      <div>\\n        <div style=\\\"font-weight:700;color:#dff7f1\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Sessions</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <!-- hero -->\\n    <section class=\\\"hero\\\" aria-labelledby=\\\"about-hero\\\">\\n      <svg class=\\\"pattern\\\" width=\\\"520\\\" height=\\\"520\\\" viewBox=\\\"0 0 520 520\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n        <defs>\\n          <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#88e0d0\\\" stop-opacity=\\\"0.9\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#6fcadf\\\" stop-opacity=\\\"0.6\\\"/></linearGradient>\\n          <filter id=\\\"f1\\\" x=\\\"-20%\\\" y=\\\"-20%\\\" width=\\\"140%\\\" height=\\\"140%\\\"><feTurbulence baseFrequency=\\\"0.6\\\" numOctaves=\\\"2\\\" stitchTiles=\\\"stitch\\\" result=\\\"t\\\"/><feDisplacementMap in=\\\"SourceGraphic\\\" in2=\\\"t\\\" scale=\\\"18\\\"/></filter>\\n        </defs>\\n        <circle cx=\\\"260\\\" cy=\\\"260\\\" r=\\\"220\\\" fill=\\\"url(#g1)\\\" filter=\\\"url(#f1)\\\"/>\\n      </svg>\\n      <div class=\\\"hero-grid\\\">\\n        <div>\\n          <h1 id=\\\"about-hero\\\">A clinical, curated approach to sound therapy</h1>\\n          <p>We design sensory sound bath experiences that balance evidence-informed structure with luxurious, slow immersion. Facilitated by {{FACILITATOR_NAME}} at {{VENUE_NAME}} in {{CITY}}, {{STATE}}.</p>\\n          <div style=\\\"margin-top:16px;display:flex;gap:12px;align-items:center\\\">\\n            <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n            <div class=\\\"meta\\\">Next session: <strong style=\\\"color:#eafffb\\\">{{NEXT_EVENT_DATE}}</strong></div>\\n          </div>\\n        </div>\\n        <aside class=\\\"panel\\\">\\n          <div class=\\\"meta\\\">What we use</div>\\n          <ul style=\\\"margin:8px 0 0 18px;color:#d7fbf4\\\">\\n            <li>Crystal singing bowls — sustained harmonic fields</li>\\n            <li>Wind chimes — high-frequency punctuation</li>\\n            <li>Monochord — long resonant drones</li>\\n          </ul>\\n        </aside>\\n      </div>\\n    </section>\\n\\n    <!-- pillars -->\\n    <section class=\\\"pillars\\\" aria-labelledby=\\\"ethos\\\">\\n      <div class=\\\"pillar\\\">\\n        <h3 id=\\\"ethos\\\">Clinical clarity</h3>\\n        <p class=\\\"note\\\">Sessions follow a structured timeline: arrival & grounding, calibrated soundscape, guided rest, gentle reorientation. Each element is chosen for measurable sensory impact.</p>\\n      </div>\\n      <div class=\\\"pillar\\\">\\n        <h3>Premium environment</h3>\\n        <p class=\\\"note\\\">Temperature, cushioning, and lighting are tuned for comfort. Materials and layout prioritize safety and ease for resting participants.</p>\\n      </div>\\n      <div class=\\\"pillar\\\">\\n        <h3>Evidence-forward facilitation</h3>\\n        <p class=\\\"note\\\">Techniques are informed by somatic practice and contemporary research on multisensory modulation and autonomic balance.</p>\\n      </div>\\n    </section>\\n\\n    <!-- myth_vs_truth -->\\n    <section class=\\\"grid-case\\\" aria-labelledby=\\\"mythies\\\">\\n      <div class=\\\"panel\\\">\\n        <h3 id=\\\"mythies\\\">Myths vs. Measured Effects</h3>\\n        <p class=\\\"note\\\">Myth: Sound baths are vague and unpredictable. Truth: Our sessions are reproducible and follow a flow that supports parasympathetic activation — breath, progressive exposure to harmonic spectra, and slow re-emergence.</p>\\n        <ul style=\\\"margin-top:12px;color:#dff7f1\\\">\\n          <li>Reduced self-reported stress in follow-up checks.</li>\\n          <li>Clear, repeatable session architecture for participant safety.</li>\\n        </ul>\\n      </div>\\n      <aside class=\\\"panel\\\">\\n        <h4>Notable case notes</h4>\\n        <p class=\\\"note\\\">Working with small cohorts (8–16) at {{VENUE_NAME}}, we monitor comfort and provide post-session check-ins. We keep detailed notes for continuity of care.</p>\\n      </aside>\\n    </section>\\n\\n    <!-- case_notes -->\\n    <section style=\\\"margin:22px;border-radius:12px;padding:20px;background:var(--glass)\\\">\\n      <h3>Illustrative case notes</h3>\\n      <div style=\\\"display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:12px\\\">\\n        <div class=\\\"panel\\\">\\n          <strong>Case A — Restorative cohort</strong>\\n          <p class=\\\"note\\\">Facilitation adjusted to reduce high-frequency content; participants reported deeper body awareness and fewer mid-session arousals.</p>\\n        </div>\\n        <div class=\\\"panel\\\">\\n          <strong>Case B — Cortical calm</strong>\\n          <p class=\\\"note\\\">Inclusion of monochord layers produced longer periods of low-intensity alpha-like calm during guided rest.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- faq -->\\n    <section style=\\\"margin:22px;padding:20px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent)\\\" aria-labelledby=\\\"about-faq\\\">\\n      <h3 id=\\\"about-faq\\\">Common questions</h3>\\n      <details style=\\\"margin-top:10px;color:var(--muted)\\\"><summary style=\\\"cursor:pointer;color:#eafffb\\\">Who attends?</summary>\\n        <p class=\\\"note\\\">Adults seeking a sensory, meditative session — novices to experienced practitioners. We keep capacity limited for intimacy.</p></details>\\n      <details style=\\\"margin-top:8px;color:var(--muted)\\\"><summary style=\\\"cursor:pointer;color:#eafffb\\\">Is it therapeutic?</summary>\\n        <p class=\\\"note\\\">We provide a supportive, structured experience but do not diagnose or replace medical care. We may recommend adjunct providers when appropriate.</p></details>\\n    </section>\\n\\n    <!-- cta -->\\n    <section style=\\\"margin:22px;display:flex;justify-content:space-between;align-items:center;gap:12px;\\\">\\n      <div>\\n        <h3 style=\\\"margin:0;color:#eafffb\\\">Ready to reserve a space?</h3>\\n        <p class=\\\"note\\\">Book a session or inquire about private facilitation for tailored group work.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"font-weight:600;color:#dff7f1\\\">{{BUSINESS_NAME}}</div>\\n    <div class=\\\"note\\\">Questions: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a> • Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted)\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Help & FAQ — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Frequently asked questions and practical guidance for {{BUSINESS_NAME}} sound baths.\\\">\\n  <style>\\n    :root{--bg:#08121a;--panel:#071522;--muted:#9db0b8;--accent:#8fe1c9}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:radial-gradient(1200px 500px at 10% 10%,#08202a 0%,#041018 40%,#020814 100%);color:#eaf9f6}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:22px}\\n    .logo{background:linear-gradient(135deg,var(--accent),#6ec1d6);padding:10px 12px;border-radius:10px;font-weight:700;color:#042426}\\n    nav a{color:var(--muted);margin-left:16px;text-decoration:none;font-size:14px}\\n    .wrap{max-width:980px;margin:18px auto;padding:18px}\\n    .hero{padding:22px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent)}\\n    .faq-grid{display:grid;grid-template-columns:2fr 320px;gap:18px;margin-top:18px}\\n    .panel{background:var(--panel);padding:16px;border-radius:12px}\\n    details{background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;margin-bottom:8px}\\n    summary{cursor:pointer;font-weight:600}\\n    .tiny{font-size:13px;color:var(--muted)}\\n    .svg-anchor{position:absolute;left:-120px;top:40px;opacity:0.08}\\n    button.contact{background:none;border:1px solid rgba(255,255,255,0.06);padding:8px 12px;border-radius:10px;color:var(--muted)}\\n    @media(max-width:880px){.faq-grid{grid-template-columns:1fr}.svg-anchor{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"tiny\\\">Sound baths with a measured, sensory focus</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Upcoming</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <!-- hero -->\\n    <section class=\\\"hero\\\">\\n      <h1 style=\\\"margin:0;color:#eafffb\\\">Questions answered — practical guidance</h1>\\n      <p class=\\\"tiny\\\" style=\\\"margin-top:8px\\\">Clinical calm, clear policies. If you have anything not covered here, contact us.</p>\\n    </section>\\n\\n    <div class=\\\"faq-grid\\\">\\n      <div>\\n        <!-- faq section (prominent) -->\\n        <section aria-labelledby=\\\"faq-main\\\" style=\\\"margin-top:12px\\\">\\n          <h2 id=\\\"faq-main\\\">Frequently asked</h2>\\n\\n          <details>\\n            <summary>How long is a typical session?</summary>\\n            <div class=\\\"tiny\\\">Arrival and grounding 15 min • Sound immersion 45–55 min • Gentle reorientation 10–15 min. We recommend allowing 20 extra minutes for arrival and check-in.</div>\\n          </details>\\n\\n          <details>\\n            <summary>What should I bring?</summary>\\n            <div class=\\\"tiny\\\">Bring a yoga mat, a blanket, a pillow or bolster for support, and an eye mask if you prefer darkness. We provide extra blankets and cushions on request.</div>\\n          </details>\\n\\n          <details>\\n            <summary>Are there contraindications?</summary>\\n            <div class=\\\"tiny\\\">If you have a history of epilepsy, recent head trauma, severe psychiatric conditions, or are pregnant with specific concerns, please consult your clinician first and inform the facilitator. High-volume gongs are adjusted as needed.</div>\\n          </details>\\n\\n          <details>\\n            <summary>Do I need experience?</summary>\\n            <div class=\\\"tiny\\\">No. Sessions are guided and accessible to first-timers. The environment is paced to support restful engagement regardless of prior practice.</div>\\n          </details>\\n\\n          <details>\\n            <summary>Can I go to sleep?</summary>\\n            <div class=\\\"tiny\\\">Yes. Many participants nap. Facilitators monitor the group and reorient slowly to ensure calm transitions.</div>\\n          </details>\\n\\n        </section>\\n\\n        <!-- myth_vs_truth (paired here) -->\\n        <section style=\\\"margin-top:18px\\\">\\n          <h3>Clarifying misconception</h3>\\n          <p class=\\\"tiny\\\">Myth: \\\"All sound baths are the same.\\\" Truth: Intention, instrument palette, pacing and environment create distinct outcomes. We blend clinical pacing with premium materials for reproducibility.</p>\\n        </section>\\n      </div>\\n\\n      <aside class=\\\"panel\\\">\\n        <!-- pillars (aside) -->\\n        <h4 style=\\\"margin-top:0\\\">Core pillars</h4>\\n        <ul class=\\\"tiny\\\" style=\\\"margin-left:16px\\\">\\n          <li>Predictable session architecture</li>\\n          <li>Sensorily curated environment</li>\\n          <li>Facilitation with attention to safety</li>\\n        </ul>\\n\\n        <!-- case_notes compact -->\\n        <div style=\\\"margin-top:12px\\\">\\n          <h5 style=\\\"margin:0\\\">Case highlight</h5>\\n          <div class=\\\"tiny\\\" style=\\\"margin-top:6px\\\">A corporate workshop where brief-guided grounding reduced reported acute stress markers; participants appreciated the clear pacing and time for integration.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;display:flex;gap:8px;flex-direction:column\\\">\\n          <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">Email us</a>\\n          <a class=\\\"contact\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a spot</a>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;color:var(--muted)\\\">\\n          <strong>Instruments we may use</strong>\\n          <div class=\\\"tiny\\\" style=\\\"margin-top:6px\\\">Gong • Tuning forks • Handpan</div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <!-- cta (different flavor) -->\\n    <section style=\\\"margin-top:20px;display:flex;justify-content:space-between;align-items:center;gap:12px\\\">\\n      <div>\\n        <h3 style=\\\"margin:0\\\">Still unsure?</h3>\\n        <p class=\\\"tiny\\\" style=\\\"margin:6px 0 0\\\">We offer a brief phone consult to tailor a session or answer safety questions.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"contact\\\" href=\\\"tel:{{PHONE}}\\\">Call {{PHONE}}</a>\\n        <a style=\\\"margin-left:8px\\\" class=\\\"contact\\\" href=\\\"mailto:{{EMAIL}}\\\">Email</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"padding:18px;text-align:center;color:var(--muted)\\\">\\n    <div>{{BUSINESS_NAME}} — {{TAGLINE}}</div>\\n    <div style=\\\"margin-top:6px\\\">{{VENUE_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"book.html\\\" style=\\\"color:var(--muted)\\\">Reserve</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Reserve your place at {{BUSINESS_NAME}} — sensory sound baths in {{CITY}}, {{STATE}}.\\\">\\n  <style>\\n    :root{--bg:#041018;--card:#092028;--muted:#9ec3bd;--accent:#7fe0c6}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:linear-gradient(180deg,#06151a 0%,#031016 100%);color:#e9fbf6}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px}\\n    .logo{background:linear-gradient(135deg,var(--accent),#5bbfde);padding:8px 10px;border-radius:10px;color:#042426;font-weight:700}\\n    nav a{margin-left:14px;color:var(--muted);text-decoration:none}\\n    .container{max-width:980px;margin:18px auto;padding:18px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:20px}\\n    .panel{background:var(--card);padding:18px;border-radius:12px}\\n    h1{margin:0 0 8px 0}\\n    .tiny{color:var(--muted);font-size:14px}\\n    form{display:flex;flex-direction:column;gap:12px}\\n    input,select,textarea{background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.04);padding:10px;border-radius:10px;color:#e6fbf8}\\n    button.primary{background:linear-gradient(90deg,var(--accent),#6fd0dc);border:0;padding:12px;border-radius:12px;color:#042426;font-weight:700}\\n    .note{font-size:13px;color:var(--muted)}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"note\\\">Reserve your sensory session</div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Upcoming</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"faq.html\\\">Help</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <!-- hero -->\\n    <section class=\\\"panel\\\" style=\\\"margin-bottom:18px\\\">\\n      <h1>Reserve a session</h1>\\n      <p class=\\\"tiny\\\">Choose a group session or inquire about private facilitation. Please read the guidelines below before booking.</p>\\n    </section>\\n\\n    <div class=\\\"grid\\\">\\n      <div>\\n        <!-- pillars (booking-focused) -->\\n        <section class=\\\"panel\\\">\\n          <h3 style=\\\"margin-top:0\\\">Flow & what to expect</h3>\\n          <ol class=\\\"note\\\" style=\\\"margin-top:8px 0 0 18px\\\">\\n            <li>Arrival & intake (10–20 min): brief health check & comfort setup.</li>\\n            <li>Grounding (10–15 min): gentle breathing cues & orientation.</li>\\n            <li>Sound immersion (40–60 min): layered instruments for sustained resonance.</li>\\n            <li>Guided reorientation (10 min): slow return, hydration suggestion, post-session notes.</li>\\n          </ol>\\n\\n          <h4 style=\\\"margin-top:12px\\\">What to bring</h4>\\n          <ul class=\\\"note\\\" style=\\\"margin-left:18px;margin-top:8px\\\">\\n            <li>Yoga mat or padded surface</li>\\n            <li>Blanket, pillow, eye mask</li>\\n            <li>Water bottle — no heavy meals immediately beforehand</li>\\n          </ul>\\n\\n          <h4 style=\\\"margin-top:12px\\\">Contraindications & safety</h4>\\n          <p class=\\\"note\\\">If you have epilepsy, recent head injury, severe psychiatric conditions, are pregnant with complications, or use devices that are sensitive to vibration (e.g., certain implants), please consult your clinician and contact us prior to booking. We can often adapt volume and instrument selection.</p>\\n        </section>\\n\\n        <!-- myth_vs_truth (booking variant) -->\\n        <section class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h4>Myth vs. Practice</h4>\\n          <p class=\\\"note\\\">Myth: louder is better. Practice: calibrated amplitude and spectral balance produce deeper relaxation with fewer startle responses.</p>\\n        </section>\\n\\n        <!-- case_notes (booking) -->\\n        <section class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h4>Recent note</h4>\\n          <p class=\\\"note\\\">We adjusted low-frequency content for a cohort with vestibular sensitivity; no adverse reactions and high ratings for comfort.</p>\\n        </section>\\n      </div>\\n\\n      <aside>\\n        <!-- booking form + faq compact -->\\n        <div class=\\\"panel\\\">\\n          <h3 style=\\\"margin-top:0\\\">Book now</h3>\\n          <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\">\\n            <label class=\\\"note\\\">Name</label>\\n            <input name=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"Your full name\\\" required>\\n            <label class=\\\"note\\\">Email</label>\\n            <input name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n            <label class=\\\"note\\\">Phone</label>\\n            <input name=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"Optional\\\">\\n            <label class=\\\"note\\\">Select session</label>\\n            <select name=\\\"session\\\">\\n              <option>Next group session — {{NEXT_EVENT_DATE}}</option>\\n              <option>Private 1:1 — request time</option>\\n              <option>Couples session — request time</option>\\n            </select>\\n            <label class=\\\"note\\\">Notes / contraindications</label>\\n            <textarea name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Please share any medical notes we should know.\\\"></textarea>\\n            <div class=\\\"note\\\">By booking you confirm you have read the safety note and understand this is a sensory support service, not a substitute for medical care.</div>\\n            <button class=\\\"primary\\\" type=\\\"submit\\\" style=\\\"margin-top:8px\\\">Reserve</button>\\n          </form>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin-top:0\\\">Quick FAQ</h4>\\n          <div class=\\\"note\\\">Arrive 15 minutes early for check-in. We provide extra blankets. Refunds processed per the rates policy.</div>\\n          <div style=\\\"margin-top:10px\\\">\\n            <strong class=\\\"note\\\">Instruments for typical groups</strong>\\n            <div class=\\\"note\\\" style=\\\"margin-top:6px\\\">Tibetan singing bowls • Koshi chimes • Bass gong</div>\\n          </div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <!-- final cta -->\\n    <section style=\\\"margin-top:18px;display:flex;justify-content:space-between;align-items:center\\\">\\n      <div>\\n        <h3 style=\\\"margin:0\\\">Need a tailored session?</h3>\\n        <p class=\\\"note\\\" style=\\\"margin-top:6px\\\">We offer hybrid options for corporate, couples, and 1:1 facilitation — reach out to plan.</p>\\n      </div>\\n      <div>\\n        <a href=\\\"private-sessions.html\\\" style=\\\"background:transparent;border:1px solid rgba(255,255,255,0.06);padding:10px;border-radius:10px;color:var(--muted);text-decoration:none\\\">Private & corporate</a>\\n        <a href=\\\"tel:{{PHONE}}\\\" style=\\\"margin-left:8px;display:inline-block;background:linear-gradient(90deg,var(--accent),#6fd0dc);padding:10px;border-radius:10px;color:#042426;text-decoration:none\\\">Call to consult</a>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"padding:18px;text-align:center;color:var(--muted)\\\">\\n    <div>{{BUSINESS_NAME}} • {{VENUE_NAME}} • {{CITY}}, {{STATE}}</div>\\n    <div style=\\\"margin-top:6px\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted)\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
