          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n<title>About — {{BUSINESS_NAME}}</title>\\n<style>\\n:root{--bg:#0f1720;--card:#0b1220;--accent:#a7f3d0;--muted:#cbd5e1;--glass:rgba(255,255,255,0.04)}\\nhtml,body{height:100%}\\nbody{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--muted);background:linear-gradient(180deg,#071224 0%,#021018 100%), url('assets/img/pattern.svg');background-size:cover;line-height:1.5}\\n.container{max-width:900px;margin:48px auto;padding:32px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:14px;box-shadow:0 6px 30px rgba(2,6,23,.6)}\\nnav{display:flex;gap:18px;flex-wrap:wrap;align-items:center;margin-bottom:18px}\\nnav a{color:var(--muted);text-decoration:none;padding:6px 10px;border-radius:8px}\\nnav a.active{background:linear-gradient(90deg,rgba(167,243,208,0.08),transparent);color:var(--accent)}\\n.hero{padding:28px 6px}\\nh1{margin:0 0 8px;font-weight:600;color:#e6f7f0;font-size:28px}\\n.lead{color:#cfeee3;margin:0 0 18px}\\n.section{margin:28px 0;padding:18px;background:var(--glass);border-radius:12px}\\n.small{font-size:14px;color:#bcd9cf}\\n.ritual p{margin:8px 0}\\n.list{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-top:12px}\\n.card{padding:12px;background:rgba(255,255,255,0.02);border-radius:10px}\\n.cta{display:inline-block;margin-top:16px;padding:12px 18px;background:linear-gradient(90deg,#86efac,#4ade80);color:#022;border-radius:12px;text-decoration:none;font-weight:600}\\n.footer{margin-top:20px;font-size:13px;color:#98b8ae}\\n</style>\\n</head>\\n<body>\\n<div class=\\\"container\\\">\\n<nav>\\n<a href=\\\"index.html\\\">Home</a>\\n<a href=\\\"events.html\\\">Gatherings</a>\\n<a href=\\\"private-sessions.html\\\">Private</a>\\n<a href=\\\"pricing.html\\\">Invest</a>\\n<a href=\\\"about.html\\\" class=\\\"active\\\">Story</a>\\n<a href=\\\"faq.html\\\">Questions</a>\\n<a href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n</nav>\\n<header class=\\\"hero\\\">\\n<h1>We hold space with sound</h1>\\n<p class=\\\"lead\\\">A deliberate pause — curated resonance that opens the senses. {{BUSINESS_NAME}} blends ritual and physics to guide you into restorative quiet.</p>\\n</header>\\n\\n<section class=\\\"section ritual\\\" aria-labelledby=\\\"ritual-heading\\\">\\n<h2 id=\\\"ritual-heading\\\" style=\\\"color:#dff6ee;margin:0 0 8px\\\">The ritual</h2>\\n<p class=\\\"small\\\">Each gathering is an invitation. We begin seated, breathe together, and move into a guided drift.</p>\\n<p>Our sessions are structured: settling breathwork, attunement (short intention), a 40–50 minute soundscape, and gentle re-integration. Instruments are chosen to shape deep, layered harmonics — crystal singing bowls and chimes weave high overtone shimmer while a soft monochord underpins long, warm sustain.</p>\\n<div class=\\\"list\\\">\\n<div class=\\\"card\\\"><strong>Opening</strong><div class=\\\"small\\\">Grounding breath + intention</div></div>\\n<div class=\\\"card\\\"><strong>Soundscape</strong><div class=\\\"small\\\">Immersive bowl & stringed resonance</div></div>\\n<div class=\\\"card\\\"><strong>Return</strong><div class=\\\"small\\\">Guided awakening and share</div></div>\\n</div>\\n</section>\\n\\n<section class=\\\"section\\\" aria-labelledby=\\\"expect-heading\\\">\\n<h2 id=\\\"expect-heading\\\" style=\\\"color:#dff6ee;margin:0 0 8px\\\">What to expect</h2>\\n<p class=\\\"small\\\">Sensory. Gentle. Premium — minimal light, layered tones, comfortable cushioning.</p>\\n<ul>\\n<li>Arrive 15 minutes early to settle.</li>\\n<li>Wear soft layers; we provide mats, blankets, and bolsters.</li>\\n<li>Sessions are candle-calm and cellphone-free; phones in airplane mode please.</li>\\n</ul>\\n<p class=\\\"small\\\">What to bring: a small pillow for your head if you prefer, an eye mask, and an open posture. Hydration is encouraged before and after.</p>\\n</section>\\n\\n<section class=\\\"section\\\" aria-labelledby=\\\"safety-heading\\\">\\n<h2 id=\\\"safety-heading\\\" style=\\\"color:#dff6ee;margin:0 0 8px\\\">Contraindications & safety</h2>\\n<p class=\\\"small\\\">Sound is powerful; please consult before attending if you are pregnant, have an implanted medical device (e.g., pacemaker), are on seizure risk medications, or have severe anxiety triggered by loud vibration. If in doubt, email {{EMAIL}} or call {{PHONE}}.</p>\\n</section>\\n\\n<a class=\\\"cta\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n\\n<footer class=\\\"footer\\\">\\n<p>{{BUSINESS_NAME}} — {{VENUE_NAME}} in {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent)\\\">{{EMAIL}}</a> • {{PHONE}}</p>\\n</footer>\\n</div>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n<title>FAQ — {{BUSINESS_NAME}}</title>\\n<style>\\n:root{--bg:#071421;--muted:#cfeee3;--accent:#9be7d6}\\nhtml,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;color:var(--muted);background:radial-gradient(circle at 10% 10%,#081221 0%,#02121a 60%), url('assets/img/pattern.svg');background-size:300px 300px}\\n.container{max-width:880px;margin:40px auto;padding:28px;background:rgba(255,255,255,0.02);border-radius:14px}\\nnav{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:16px}\\nnav a{color:var(--muted);text-decoration:none}\\nnav a.active{color:var(--accent)}\\nh1{margin:0;font-size:26px;color:#ecfff9}\\n.section{margin-top:18px;padding:16px;background:rgba(255,255,255,0.02);border-radius:10px}\\n.q{margin:10px 0}\\n.q h3{margin:0 0 6px;font-size:16px;color:#e6fff6}\\n.q p{margin:0;color:#bfeee4}\\n.small{font-size:13px;color:#9fcbbf}\\n.cta{display:inline-block;margin-top:14px;padding:10px 14px;background:linear-gradient(90deg,#7ee7c3,#4fd6a8);color:#022;border-radius:10px;text-decoration:none}\\n</style>\\n</head>\\n<body>\\n<div class=\\\"container\\\">\\n<nav>\\n<a href=\\\"index.html\\\">Start</a>\\n<a href=\\\"events.html\\\" class=\\\"active\\\">Events</a>\\n<a href=\\\"private-sessions.html\\\">Sessions</a>\\n<a href=\\\"pricing.html\\\">Rates</a>\\n<a href=\\\"about.html\\\">About</a>\\n<a href=\\\"faq.html\\\">Questions</a>\\n<a href=\\\"book.html\\\">Reserve</a>\\n</nav>\\n\\n<header>\\n<h1>Common questions, gently answered</h1>\\n<p class=\\\"small\\\">Short, clear guidance to prepare you for the experience.</p>\\n</header>\\n\\n<section class=\\\"section\\\">\\n<div class=\\\"q\\\">\\n<h3>What should I bring?</h3>\\n<p>Comfortable clothing, a water bottle, and optionally a light blanket or eye pillow. We provide mats, bolsters, and ear-friendly blankets.</p>\\n</div>\\n\\n<div class=\\\"q\\\">\\n<h3>Is it safe if I'm pregnant or have implants?</h3>\\n<p>We recommend consulting your healthcare provider. If you have an implanted device (pacemaker, neurostimulator), please contact us before attending. Pregnant attendees may prefer private sessions tailored to safety and comfort.</p>\\n</div>\\n\\n<div class=\\\"q\\\">\\n<h3>Who benefits from a sound bath?</h3>\\n<p>Beginners to long-time practitioners. People seeking stress relief, deep rest, or an embodied listening practice. If you have a history of trauma or seizure, please read contraindications and reach out.</p>\\n</div>\\n\\n<div class=\\\"q\\\">\\n<h3>What instruments do you use?</h3>\\n<p>We rotate instruments. Typical textures include gong, tuning forks, and crystal bowls blended with soft chime accents for high shimmer.</p>\\n</div>\\n\\n<div class=\\\"q\\\">\\n<h3>How loud are sessions?</h3>\\n<p>Sessions are curated to be enveloping but not overpowering. We control dynamics and monitor the room — let the facilitator know if you need adjustments.</p>\\n</div>\\n\\n<div class=\\\"q\\\">\\n<h3>Where should I park and arrive?</h3>\\n<p>Arrive 10–20 minutes early to sign in. Parking details are included in your confirmation. Late arrival may be allowed but you may miss the opening breath and attunement.</p>\\n</div>\\n\\n<div class=\\\"q\\\">\\n<h3>Cancellation and refunds</h3>\\n<p>Individual event tickets are refundable up to 72 hours before the event. Private sessions require a 48-hour notice for full refund. See full policy on the booking page.</p>\\n</div>\\n\\n<div class=\\\"q\\\">\\n<h3>Can I book a private session for my team?</h3>\\n<p>Yes. We offer 1:1, couples, and corporate offerings with tailored sound designs and seating. Contact <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent)\\\">{{EMAIL}}</a> for custom proposals.</p>\\n</div>\\n\\n</section>\\n\\n<a class=\\\"cta\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n\\n<footer style=\\\"margin-top:18px;font-size:13px;color:#9fbfac\\\">\\n<p>{{BUSINESS_NAME}} • {{VENUE_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent)\\\">{{EMAIL}}</a></p>\\n</footer>\\n</div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n<title>Book — {{BUSINESS_NAME}}</title>\\n<style>\\n:root{--bg:#08121a;--muted:#d6f7ee;--accent:#8ee3c9}\\nhtml,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;color:var(--muted);background:linear-gradient(180deg,#05121a,#011018), url('assets/img/pattern.svg');background-size:contain}\\n.container{max-width:920px;margin:36px auto;padding:26px;background:rgba(255,255,255,0.02);border-radius:12px}\\nnav{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:14px}\\nnav a{color:var(--muted);text-decoration:none}\\nnav a.active{color:var(--accent)}\\nheader h1{margin:0;font-size:26px;color:#eafff6}\\n.grid{display:grid;grid-template-columns:1fr 380px;gap:18px;margin-top:14px}\\n.form{padding:14px;background:rgba(255,255,255,0.02);border-radius:10px}\\n.summary{padding:14px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);border-radius:10px}\\nlabel{display:block;font-size:13px;margin-top:10px;color:#cfeee3}\\ninput,select,textarea{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:var(--muted)}\\nbutton{margin-top:12px;padding:12px;border-radius:10px;border:none;background:linear-gradient(90deg,#7ef0c7,#49caa0);color:#022;font-weight:700}\\n.small{font-size:13px;color:#9fcbbf}\\n.note{font-size:13px;color:#bfeee4;margin-top:8px}\\n</style>\\n</head>\\n<body>\\n<div class=\\\"container\\\">\\n<nav>\\n<a href=\\\"index.html\\\">Home</a>\\n<a href=\\\"events.html\\\">Calendar</a>\\n<a href=\\\"private-sessions.html\\\">Sessions</a>\\n<a href=\\\"pricing.html\\\">Pricing</a>\\n<a href=\\\"about.html\\\">Our Story</a>\\n<a href=\\\"faq.html\\\">FAQ</a>\\n<a href=\\\"book.html\\\" class=\\\"active\\\">Reserve</a>\\n</nav>\\n\\n<header>\\n<h1>Reserve your place</h1>\\n<p class=\\\"small\\\">Select a session type and time. For recurring series or company bookings, email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent)\\\">{{EMAIL}}</a>.</p>\\n</header>\\n\\n<div class=\\\"grid\\\">\\n<form class=\\\"form\\\" method=\\\"post\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\">\\n<label>Full name\\n<input name=\\\"name\\\" type=\\\"text\\\" required placeholder=\\\"Your name\\\">\\n</label>\\n<label>Email\\n<input name=\\\"email\\\" type=\\\"email\\\" required placeholder=\\\"you@domain.com\\\">\\n</label>\\n<label>Phone\\n<input name=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"{{PHONE}}\\\">\\n</label>\\n<label>Session type\\n<select name=\\\"type\\\" required>\\n<option value=\\\"group\\\">Group Sound Bath — drop-in</option>\\n<option value=\\\"private\\\">Private 1:1</option>\\n<option value=\\\"couples\\\">Couples</option>\\n<option value=\\\"corporate\\\">Corporate / Team</option>\\n</select>\\n</label>\\n<label>Preferred date\\n<input name=\\\"date\\\" type=\\\"date\\\" required min=\\\"\\\">\\n</label>\\n<label>Notes\\n<textarea name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Any accessibility needs or questions\\\"></textarea>\\n</label>\\n<label style=\\\"display:block;margin-top:12px\\\"><input type=\\\"checkbox\\\" name=\\\"ack\\\" required> I have read the contraindications and understand the safety notes.</label>\\n<button type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n<p class=\\\"note\\\">Bookings require a small deposit. By submitting you agree to our cancellation policy: full refund 72 hours before group events, 48 hours for private sessions.</p>\\n</form>\\n\\n<aside class=\\\"summary\\\">\\n<h3 style=\\\"margin:0 0 8px;color:#e9fff7\\\">Quick details</h3>\\n<p class=\\\"small\\\">Next event: <strong style=\\\"color:#dff6ee\\\">{{NEXT_EVENT_DATE}}</strong></p>\\n<p class=\\\"small\\\">Typical instruments: singing bowls, chimes, soft gong textures — arranged for a warm immersive field.</p>\\n<p class=\\\"small\\\">What to bring: cushion or small pillow, eye mask, layered clothes, water.</p>\\n<h4 style=\\\"margin-top:12px;color:#e6fff6\\\">Pricing snapshot</h4>\\n<ul class=\\\"small\\\">\\n<li>Group drop-in — {{PRIMARY_CTA_LABEL}} at events page for ticket link</li>\\n<li>Private 1:1 — starts at $120</li>\\n<li>Couples — starts at $180</li>\\n<li>Corporate & group bookings — custom</li>\\n</ul>\\n<p class=\\\"small\\\">For bespoke proposals, reply to confirmation or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent)\\\">{{EMAIL}}</a>.</p>\\n</aside>\\n</div>\\n\\n<footer style=\\\"margin-top:18px;font-size:13px;color:#9fbfac\\\">\\n<p>{{BUSINESS_NAME}} • {{VENUE_NAME}} • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent)\\\">{{PHONE}}</a></p>\\n</footer>\\n</div>\\n</body>\\n</html>\"} \nBUNDLE_END"
