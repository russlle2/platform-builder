          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Events — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#0f1724;--bg2:#0b1020;--accent:#8be9c7;--accent2:#7dd3fc;--muted:#98a8b9;--card:#0b1220}\\n    *{box-sizing:border-box}\\n    html,body{height:100%}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;color:#e6eef6;background:linear-gradient(180deg,var(--bg1),var(--bg2));-webkit-font-smoothing:antialiased}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px;background:linear-gradient(90deg,rgba(255,255,255,0.02),transparent);backdrop-filter:blur(6px)}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:52px;height:52px;border-radius:12px;background:linear-gradient(135deg,var(--accent),var(--accent2));display:flex;align-items:center;justify-content:center;font-weight:700;color:#052027}\\n    nav a{color:#dff6ff;text-decoration:none;margin-left:18px;font-weight:600}\\n    nav a:hover{opacity:0.9}\\n    .cta{background:linear-gradient(90deg,var(--accent),var(--accent2));color:#052027;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700;margin-left:14px}\\n    main{padding:36px;max-width:1100px;margin:28px auto}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:16px;padding:22px;color:#d9f7ee;box-shadow:0 8px 30px rgba(2,6,23,0.6)}\\n    h1{font-size:36px;margin:0 0 8px;letter-spacing:-0.5px}\\n    p.lead{color:var(--muted);margin:0 0 14px}\\n    .next-event{background:linear-gradient(180deg,rgba(139,233,199,0.06),transparent);border:1px solid rgba(139,233,199,0.08);padding:16px;border-radius:12px}\\n    .pill{display:inline-block;background:rgba(125,211,252,0.08);padding:6px 10px;border-radius:999px;font-weight:700;color:var(--accent2);font-size:13px}\\n    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:18px}\\n    ul.events{list-style:none;padding:0;margin:0}\\n    li.event{padding:12px;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}\\n    .meta{color:var(--muted);font-size:13px}\\n    .instruments{font-weight:700;color:#c6ffe5}\\n    footer{margin-top:38px;color:var(--muted);font-size:13px;text-align:center}\\n    .ripple{position:absolute;right:-120px;top:40px;opacity:0.12}\\n    /* responsive */\\n    @media (max-width:920px){.hero{grid-template-columns:1fr;}.ripple{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">SB</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{CITY}}, {{STATE}} • Sound baths & immersive sessions</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"/\\\">Home</a>\\n      <a href=\\\"/events.html\\\">Gatherings</a>\\n      <a href=\\\"/private-sessions.html\\\">Sessions</a>\\n      <a href=\\\"/pricing.html\\\">Rates</a>\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n  <main>\\n    <div class=\\\"hero\\\">\\n      <section class=\\\"card\\\">\\n        <div class=\\\"pill\\\">Upcoming • Next</div>\\n        <h1>Open Sound Bath Series</h1>\\n        <p class=\\\"lead\\\">A carefully crafted group immersion combining resonance, breathwork, and silence to guide nervous system regulation. Short lead, clinical tone, premium experience.</p>\\n        <div style=\\\"display:flex;gap:12px;margin-top:12px\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve a spot</a>\\n          <a style=\\\"padding:10px 12px;border-radius:10px;background:transparent;border:1px solid rgba(255,255,255,0.04);color:var(--muted);text-decoration:none;font-weight:700\\\" href=\\\"/faq.html\\\">Learn more</a>\\n        </div>\\n        <div style=\\\"margin-top:18px;font-size:14px;color:var(--muted)\\\">\\n          <strong>Next event:</strong> <span style=\\\"color:#dff6ff\\\">{{NEXT_EVENT_DATE}}</span>\\n        </div>\\n        <div class=\\\"grid\\\">\\n          <div>\\n            <h4 style=\\\"margin:12px 0 6px\\\">What to expect</h4>\\n            <p style=\\\"color:var(--muted);margin:0;font-size:14px\\\">Arrive early to settle; 90 minutes including 20 minutes of gentle opening instruction, 55 minutes of immersive sound, and a calm 15-minute integration with tea/space for notes.</p>\\n          </div>\\n          <div>\\n            <h4 style=\\\"margin:12px 0 6px\\\">Instruments</h4>\\n            <div class=\\\"instruments\\\">Crystal bowls • Chimes • Tuning forks • Monochord</div>\\n            <p style=\\\"color:var(--muted);margin-top:8px;font-size:13px\\\">Each session features layered harmonic textures tuned to somatic resonance.</p>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <aside class=\\\"card next-event\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div>\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Next group</div>\\n            <div style=\\\"font-weight:800;font-size:18px;margin-top:4px\\\">{{NEXT_EVENT_DATE}}</div>\\n            <div style=\\\"margin-top:6px;color:var(--muted);font-size:13px\\\">{{VENUE_NAME}} — Doors open 30 min prior</div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <div style=\\\"font-weight:800;color:var(--accent);\\\">$40</div>\\n            <div style=\\\"color:var(--muted);font-size:13px\\\">Limited seating</div>\\n          </div>\\n        </div>\\n\\n        <hr style=\\\"border:none;border-top:1px solid rgba(255,255,255,0.03);margin:12px 0\\\">\\n        <div style=\\\"font-weight:700;margin-bottom:8px;color:#c6ffe5\\\">Upcoming calendar</div>\\n        <ul class=\\\"events\\\">\\n          <li class=\\\"event\\\"><div><strong>Mar 12</strong><div class=\\\"meta\\\">Evening bath • 7:00pm</div></div><div style=\\\"font-weight:700;color:var(--accent2)\\\">$40</div></li>\\n          <li class=\\\"event\\\"><div><strong>Apr 02</strong><div class=\\\"meta\\\">Sound & Rest • 10:30am</div></div><div style=\\\"font-weight:700;color:var(--accent2)\\\">$45</div></li>\\n          <li class=\\\"event\\\"><div><strong>Apr 25</strong><div class=\\\"meta\\\">Lunar Listening • 8:00pm</div></div><div style=\\\"font-weight:700;color:var(--accent2)\\\">$48</div></li>\\n          <li class=\\\"event\\\"><div><strong>May 08</strong><div class=\\\"meta\\\">Guided Breath + Sound • 6:30pm</div></div><div style=\\\"font-weight:700;color:var(--accent2)\\\">$42</div></li>\\n        </ul>\\n\\n        <div style=\\\"margin-top:14px;font-size:13px;color:var(--muted)\\\">\\n          <strong>Contraindications:</strong> Not recommended during early pregnancy, for uncontrolled epilepsy, or within 24 hours of certain medical procedures. If you have a pacemaker or implanted device please consult your physician before attending.\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:22px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Practical — What to bring</h3>\\n      <p style=\\\"color:var(--muted);margin:0 0 12px\\\">Small list for a premium sensory experience: soft blanket, pillow for neck support, socks, water bottle, eye mask if desired. A limited number of bolsters are available on site.</p>\\n\\n      <h4 style=\\\"margin-top:14px\\\">Flow of an evening</h4>\\n      <ol style=\\\"color:var(--muted);margin:10px 0 0 18px\\\">\\n        <li>Check-in & grounding (15–20 min) with orientation and breath guidance.</li>\\n        <li>Gradual tuning + warm-up including pendulum chimes and tuning forks.</li>\\n        <li>Deep immersion (approx. 55 min) — sustained bowls, gentle gong strokes, and harmonic overlays.</li>\\n        <li>Soft return, silent pause, guided integration and optional tea (10–20 min).</li>\\n      </ol>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Frequently asked in brief</h3>\\n      <p style=\\\"color:var(--muted);margin:0 0 8px\\\"><strong>Is this meditation?</strong> It shares elements with meditation and body-centered therapy but is non-directive and somatic-first.</p>\\n      <p style=\\\"color:var(--muted);margin:0\\\">We keep groups small and the tone clinical, calm, and attentive to ensure accessibility for first-timers and regulars alike.</p>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"opacity:0.8\\\">Questions? Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent2);text-decoration:none\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent2);text-decoration:none\\\">{{EMAIL}}</a></div>\\n      <div style=\\\"margin-top:8px\\\">© {{BUSINESS_NAME}} • Serving {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </main>\\n\\n  <!-- Decorative SVG ripple -->\\n  <svg class=\\\"ripple\\\" width=\\\"420\\\" height=\\\"420\\\" viewBox=\\\"0 0 420 420\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <radialGradient id=\\\"g1\\\" cx=\\\"0.5\\\" cy=\\\"0.4\\\">\\n        <stop offset=\\\"0%\\\" stop-color=\\\"#8be9c7\\\" stop-opacity=\\\"0.28\\\" />\\n        <stop offset=\\\"100%\\\" stop-color=\\\"#7dd3fc\\\" stop-opacity=\\\"0.02\\\" />\\n      </radialGradient>\\n    </defs>\\n    <circle cx=\\\"210\\\" cy=\\\"210\\\" r=\\\"170\\\" fill=\\\"url(#g1)\\\"/>\\n    <g opacity=\\\"0.6\\\">\\n      <path d=\\\"M50 200 C100 60, 320 60, 370 200\\\" stroke=\\\"#8be9c7\\\" stroke-opacity=\\\"0.06\\\" stroke-width=\\\"36\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/>\\n      <path d=\\\"M30 240 C120 380, 300 380, 390 240\\\" stroke=\\\"#7dd3fc\\\" stroke-opacity=\\\"0.04\\\" stroke-width=\\\"42\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/>\\n    </g>\\n  </svg>\\n</body>\\n</html>\"} \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Private Sessions — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071227;--card:#071829;--accent:#ffd6a5;--accent2:#c7f9cc;--muted:#9fb3c8}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;color:#f7fbff;background:linear-gradient(180deg,var(--bg),#031026);-webkit-font-smoothing:antialiased}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:18px 26px}\\n    .logo{width:48px;height:48px;background:linear-gradient(135deg,var(--accent),#ff8fa3);border-radius:12px;display:flex;align-items:center;justify-content:center;font-weight:800;color:#08121b}\\n    nav a{margin-left:16px;color:#e9f6ff;text-decoration:none;font-weight:600}\\n    .primary{background:linear-gradient(90deg,var(--accent2),#b4f1ff);padding:9px 12px;border-radius:10px;color:#022; font-weight:800;text-decoration:none}\\n    main{max-width:1000px;margin:26px auto;padding:20px}\\n    .hero{padding:26px;border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);display:flex;gap:18px;align-items:center}\\n    h1{margin:0;font-size:30px}\\n    .muted{color:var(--muted)}\\n    .columns{display:grid;grid-template-columns:1fr 340px;gap:18px;margin-top:18px}\\n    .card{background:#071829;padding:18px;border-radius:12px;color:#eaf8f0}\\n    .offer{border-radius:10px;padding:12px;background:linear-gradient(90deg,rgba(199,249,204,0.03),transparent);margin-bottom:12px}\\n    .small{font-size:13px;color:var(--muted)}\\n    ul{padding-left:18px}\\n    .instrument-list{color:#dff7e9;font-weight:700}\\n    footer{margin-top:22px;color:var(--muted);text-align:center}\\n    @media (max-width:900px){.columns{grid-template-columns:1fr}.hero{flex-direction:column;align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">PS</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"small\\\">Private sound experiences by {{FACILITATOR_NAME}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"/\\\">Overview</a>\\n      <a href=\\\"/events.html\\\">Events</a>\\n      <a href=\\\"/private-sessions.html\\\">Private</a>\\n      <a href=\\\"/contact.html\\\">Contact</a>\\n      <a class=\\\"primary\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1>Private & small-group sound sessions</h1>\\n        <p class=\\\"muted\\\">Curated one-hour to two-hour formats for individuals, couples, and teams. A hybrid offering: clinical attention with sensory depth.</p>\\n      </div>\\n      <div style=\\\"width:320px;text-align:right\\\">\\n        <div style=\\\"background:linear-gradient(90deg,var(--accent),#ffb4c0);padding:10px;border-radius:10px;color:#051019;font-weight:800\\\">Tailored to your needs</div>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Sessions hosted at {{VENUE_NAME}} or private location.</div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"columns\\\">\\n      <div>\\n        <section class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0\\\">1:1 Individual Sessions</h3>\\n          <p class=\\\"small\\\">Deeply personalized session including intake, 50–70 minute sound immersion, and 15-minute integration. Ideal for nervous-system regulation, rest, and focused transitions.</p>\\n          <div style=\\\"margin-top:12px\\\" class=\\\"offer\\\">\\n            <div style=\\\"font-weight:800\\\">Typical flow</div>\\n            <ol class=\\\"small\\\">\\n              <li>Intake & intention setting (10–15m)</li>\\n              <li>Sound immersion (50–70m) with responsive playing</li>\\n              <li>Slow return + notes and aftercare (10–15m)</li>\\n            </ol>\\n          </div>\\n\\n          <h4>Instruments in rotation</h4>\\n          <div class=\\\"instrument-list\\\">Gong • Singing bowls (metal) • Koshi chimes</div>\\n\\n          <h4 style=\\\"margin-top:12px\\\">Contraindications & safety</h4>\\n          <p class=\\\"small\\\">Not advised for uncontrolled epilepsy, recent surgeries, or for those with certain implants. If pregnant or on medication that affects sensory processing, consult your physician first.</p>\\n\\n        </section>\\n\\n        <section class=\\\"card\\\" style=\\\"margin-top:16px\\\">\\n          <h3>Couples & shared sessions</h3>\\n          <p class=\\\"small\\\">Designed to support relational attunement. Sessions emphasize breath-syncing, mirrored pauses, and a shared sonic field. Includes a brief collaborative check-in.</p>\\n          <div style=\\\"margin-top:8px\\\" class=\\\"offer\\\">\\n            <div style=\\\"font-weight:800\\\">Goals</div>\\n            <ul class=\\\"small\\\">\\n              <li>Co-regulation</li>\\n              <li>Shared somatic awareness</li>\\n              <li>Guided integration practices</li>\\n            </ul>\\n          </div>\\n          <h4>Instruments</h4>\\n          <div class=\\\"instrument-list\\\">Crystal bowls • Tuning forks • Soft hand drum</div>\\n        </section>\\n\\n        <section class=\\\"card\\\" style=\\\"margin-top:16px\\\">\\n          <h3>Corporate & team sound experiences</h3>\\n          <p class=\\\"small\\\">Short-form interventions for teams (30–60 minutes) to support focus, collective rest, and reset between demanding work cycles. We provide a brief evidence-minded intro, the sonic intervention, and practical takeaways.</p>\\n\\n          <h4>Suitable for</h4>\\n          <ul class=\\\"small\\\">\\n            <li>Leadership retreats</li>\\n            <li>Deep work days</li>\\n            <li>Wellness allowances / team benefits</li>\\n          </ul>\\n\\n          <h4>Instruments</h4>\\n          <div class=\\\"instrument-list\\\">Monochord • Crystal singing bowls • Light chimes</div>\\n        </section>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Booking essentials</h4>\\n          <p class=\\\"small\\\">Sessions can be hosted at {{VENUE_NAME}} or your requested space. Typical lengths: 60–120 minutes. We travel within {{CITY}} and neighboring areas; travel fees may apply.</p>\\n          <div style=\\\"margin-top:10px\\\">\\n            <div style=\\\"font-weight:800;color:var(--accent2)\\\">Booking</div>\\n            <div class=\\\"small\\\">To request a booking, contact <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent2);text-decoration:none\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent2);text-decoration:none\\\">{{PHONE}}</a>.</div>\\n          </div>\\n\\n          <hr style=\\\"border:none;border-top:1px solid rgba(255,255,255,0.03);margin:12px 0\\\">\\n\\n          <h5 style=\\\"margin:0 0 8px\\\">What to bring</h5>\\n          <ul class=\\\"small\\\">\\n            <li>Comfortable clothing</li>\\n            <li>Blanket & pillow</li>\\n            <li>Hydration</li>\\n            <li>Any medical considerations noted during intake</li>\\n          </ul>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"primary\\\">Request a session</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n          <h5 style=\\\"margin:0 0 8px\\\">Accessibility & privacy</h5>\\n          <p class=\\\"small\\\">Sessions are private by default. We can adapt lighting and volume levels for sensory needs. Please disclose major health details at booking.</p>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer>\\n      <div class=\\\"small\\\">Facilitated by {{FACILITATOR_NAME}} • Contact: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent2);text-decoration:none\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </main>\\n\\n  <!-- Subtle decorative SVG -->\\n  <svg width=\\\"0\\\" height=\\\"0\\\" style=\\\"position:absolute;left:-9999px\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <pattern id=\\\"ps-pattern\\\" x=\\\"0\\\" y=\\\"0\\\" width=\\\"60\\\" height=\\\"60\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"60\\\" height=\\\"60\\\" fill=\\\"none\\\"></rect>\\n        <circle cx=\\\"30\\\" cy=\\\"30\\\" r=\\\"10\\\" fill=\\\"#0f2a3a\\\" fill-opacity=\\\"0.06\\\"></circle>\\n        <path d=\\\"M0 60 L60 0\\\" stroke=\\\"#ffb4c0\\\" stroke-opacity=\\\"0.02\\\" stroke-width=\\\"2\\\"/>\\n      </pattern>\\n    </defs>\\n  </svg>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Pricing & Packages — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071033;--card:#071628;--accent:#b7e4ff;--accent2:#ffd6a5;--muted:#9bb7c9}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,var(--bg),#02101b);color:#f0fbff}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 24px}\\n    .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,var(--accent2),#ff9fb1);display:flex;align-items:center;justify-content:center;font-weight:800;color:#04121a}\\n    nav a{margin-left:14px;color:#e6f7ff;text-decoration:none}\\n    main{max-width:980px;margin:28px auto;padding:18px}\\n    .hero{padding:20px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);display:flex;align-items:center;justify-content:space-between}\\n    h1{margin:0;font-size:30px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);padding:16px;border-radius:12px}\\n    .price{font-weight:900;font-size:22px;color:var(--accent2)}\\n    .muted{color:var(--muted)}\\n    .fine{font-size:13px;color:var(--muted);margin-top:10px}\\n    footer{margin-top:20px;color:var(--muted);text-align:center}\\n    @media (max-width:900px){.grid{grid-template-columns:1fr}.hero{flex-direction:column;align-items:flex-start}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div class=\\\"logo\\\">PR</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">Transparent rates • Hybrid offerings</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"/\\\">Home</a>\\n      <a href=\\\"/events.html\\\">Schedule</a>\\n      <a href=\\\"/private-sessions.html\\\">Private</a>\\n      <a href=\\\"/book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Packages & session fees</h1>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Clear pricing to support good decision-making. A hybrid model: class rates for groups, customized quotes for private work.</p>\\n      </div>\\n      <div style=\\\"text-align:right\\\">\\n        <div style=\\\"font-weight:800;color:var(--accent)\\\">Flexible payment options</div>\\n        <div class=\\\"muted\\\" style=\\\"font-size:13px;margin-top:6px\\\">Sliding scale and small group discounts available</div>\\n      </div>\\n    </section>\\n\\n    <div class=\\\"grid\\\" style=\\\"margin-top:18px\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">Open Group Drop-in</h3>\\n        <div class=\\\"price\\\">$35–$50</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Typical length: 75–90 minutes\\n        </div>\\n        <div class=\\\"fine\\\">Includes guided orientation, immersive sound, and integration time. Concessions available — contact for a reduced rate.</div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">1:1 Private Session</h3>\\n        <div class=\\\"price\\\">$120 (60m) • $200 (120m)</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Personal intake + tailored sound field. Travel fees for off-site sessions may apply.</div>\\n        <div class=\\\"fine\\\">Recommended for individualized therapeutic intention. Payment plans available on request.</div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">Couples / Shared</h3>\\n        <div class=\\\"price\\\">$160 (75–90m)</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Includes shared intake and integrative practices. Can be adapted for small groups.</div>\\n        <div class=\\\"fine\\\">Ideal for relational re-tuning; please indicate special needs when booking.</div>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"grid\\\" style=\\\"margin-top:14px\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">Corporate / Team Rates</h3>\\n        <div class=\\\"price\\\">From $450 per session</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Short interventions (30–60m) or full retreats. Quote based on headcount & travel.</div>\\n        <div class=\\\"fine\\\">Includes a concise evidence-minded briefing and takeaway exercises for teams.</div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">Small-group booking (private)</h3>\\n        <div class=\\\"price\\\">$250–$400</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Pricing varies by group size (6–18 people). Includes set-up and breakdown time.</div>\\n        <div class=\\\"fine\\\">Customizable: add beverages or extended integration time for an additional fee.</div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">Add-ons & extras</h3>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Private travel, extra facilitator, extended integration, or sensory accommodations billed separately.</div>\\n        <div class=\\\"fine\\\" style=\\\"margin-top:8px\\\">All prices subject to change; final quote provided on booking confirmation.</div>\\n      </div>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Policies & important notes</h3>\\n      <ul class=\\\"muted\\\">\\n        <li>Cancellation: 72-hour notice for full refund. Within 72 hours: credit only.</li>\\n        <li>Deposit: Private bookings require a non-refundable deposit to secure date.</li>\\n        <li>Health safety: Disclose any implants, pregnancy, or recent surgical procedures before booking.</li>\\n      </ul>\\n\\n      <h4 style=\\\"margin-top:12px\\\">Contraindications</h4>\\n      <p class=\\\"muted\\\">Not suitable for individuals with uncontrolled epilepsy, active acute psychiatric crisis, or those advised by their physician to avoid sustained acoustic exposure. If you have a pacemaker or implanted neurostimulator, confirm safety with your clinician and inform us prior to session.</p>\\n\\n      <h4 style=\\\"margin-top:12px\\\">What to bring</h4>\\n      <p class=\\\"muted\\\">Comfortable layered clothing, a blanket, pillow or bolster, water bottle, and any assistive items you require. We provide a limited supply of mats and bolsters.</p>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">Questions about pricing or need a custom quote? Contact <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{PHONE}}</a>.</div>\\n      <div style=\\\"margin-top:8px;color:var(--muted)\\\">Serving {{CITY}}, {{STATE}} • Facilitator: {{FACILITATOR_NAME}}</div>\\n    </footer>\\n  </main>\\n\\n  <!-- Background SVG pattern reference; unique asset expected at assets/img/pattern.svg -->\\n  <svg width=\\\"0\\\" height=\\\"0\\\" aria-hidden=\\\"true\\\" style=\\\"position:absolute;left:-9999px\\\">\\n    <defs>\\n      <pattern id=\\\"pricing-pattern\\\" width=\\\"80\\\" height=\\\"80\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"80\\\" height=\\\"80\\\" fill=\\\"#001322\\\" />\\n        <circle cx=\\\"40\\\" cy=\\\"40\\\" r=\\\"6\\\" fill=\\\"#07385a\\\" fill-opacity=\\\"0.12\\\" />\\n        <path d=\\\"M0 80 L80 0\\\" stroke=\\\"#ffd6a5\\\" stroke-opacity=\\\"0.03\\\" stroke-width=\\\"2\\\" />\\n      </pattern>\\n    </defs>\\n  </svg>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
