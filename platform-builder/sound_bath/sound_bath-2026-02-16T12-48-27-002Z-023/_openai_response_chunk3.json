          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#0f1724;--bg2:#071028;--accent:#8be9c6;--muted:#9aa6b2;--card:#0b1220}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:var(--accent);background:linear-gradient(180deg,var(--bg1),var(--bg2));}\\n    .wrap{max-width:980px;margin:36px auto;padding:28px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));box-shadow:0 6px 30px rgba(2,6,23,0.6);border-radius:14px;position:relative;overflow:hidden}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-weight:600}\\n    .brand{font-weight:800;color:#e6fff4}\\n    .hero{display:flex;gap:24px;align-items:center;margin-top:18px}\\n    .hero .left{flex:1}\\n    h1{margin:0;font-size:28px;color:#e8fff7}\\n    p.lead{color:var(--muted);margin-top:10px;line-height:1.5}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03);margin-top:18px}\\n    .pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px}\\n    .pillar{background:linear-gradient(180deg,rgba(139,233,198,0.04),transparent);padding:14px;border-radius:10px;color:#dffcf0}\\n    .myth{display:flex;gap:14px;align-items:flex-start;margin-top:18px}\\n    .myth .left{flex:1}\\n    .case{margin-top:18px}\\n    footer{display:flex;justify-content:space-between;align-items:center;margin-top:22px;color:var(--muted);font-size:13px}\\n    .cta{background:linear-gradient(90deg,#00d2a0,#6bf0c8);color:#012117;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    /* decorative svg overlay */\\n    .pattern{position:absolute;right:-120px;top:-60px;opacity:0.12}\\n    @media(max-width:700px){.pillars{grid-template-columns:1fr}.hero{flex-direction:column}.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <svg class=\\\"pattern\\\" width=\\\"520\\\" height=\\\"520\\\" viewBox=\\\"0 0 520 520\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n      <defs>\\n        <radialGradient id=\\\"gA\\\" cx=\\\"0.5\\\" cy=\\\"0.5\\\" r=\\\"0.7\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#9ff4df\\\" stop-opacity=\\\"0.18\\\" />\\n          <stop offset=\\\"1\\\" stop-color=\\\"#43bfa1\\\" stop-opacity=\\\"0.02\\\" />\\n        </radialGradient>\\n      </defs>\\n      <rect width=\\\"520\\\" height=\\\"520\\\" rx=\\\"52\\\" fill=\\\"url(#gA)\\\" />\\n      <g fill=\\\"#7EEBD0\\\" fill-opacity=\\\"0.06\\\">\\n        <circle cx=\\\"120\\\" cy=\\\"90\\\" r=\\\"86\\\" />\\n        <circle cx=\\\"260\\\" cy=\\\"310\\\" r=\\\"130\\\" />\\n        <circle cx=\\\"420\\\" cy=\\\"160\\\" r=\\\"64\\\" />\\n      </g>\\n      <g stroke=\\\"#7EEBD0\\\" stroke-opacity=\\\"0.04\\\" stroke-width=\\\"1\\\">\\n        <path d=\\\"M40 420c60-80 180-80 260-30\\\"/>\\n        <path d=\\\"M80 100c100 40 160 0 300 40\\\"/>\\n      </g>\\n    </svg>\\n\\n    <header>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Sanctuary</a>\\n        <a href=\\\"events.html\\\">Gatherings</a>\\n        <a href=\\\"private-sessions.html\\\">Private</a>\\n        <a href=\\\"pricing.html\\\">Rates</a>\\n        <a href=\\\"faq.html\\\">Help</a>\\n        <a href=\\\"book.html\\\" class=\\\"cta\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\" aria-label=\\\"About hero\\\">\\n      <div class=\\\"left\\\">\\n        <h1>Our Resonant Story</h1>\\n        <p class=\\\"lead\\\">We design sound baths that act like a finely tuned ritual — clinical in safety, playful in spirit. Founded to blend evidence-informed methods with immersive sonic textures, {{BUSINESS_NAME}} brings professional facilitation and premium instrumentation to {{CITY}}, {{STATE}}.</p>\\n        <div class=\\\"card\\\">\\n          <strong>Lead facilitator:</strong> {{FACILITATOR_NAME}} — certified in somatic-focused soundwork and trauma-informed group care.\\n        </div>\\n      </div>\\n      <div class=\\\"right\\\" style=\\\"width:240px\\\">\\n        <svg width=\\\"240\\\" height=\\\"240\\\" viewBox=\\\"0 0 240 240\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n          <defs>\\n            <linearGradient id=\\\"lg1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#00d2a0\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#6bf0c8\\\"/></linearGradient>\\n          </defs>\\n          <rect width=\\\"240\\\" height=\\\"240\\\" rx=\\\"18\\\" fill=\\\"url(#lg1)\\\" opacity=\\\"0.08\\\"/>\\n          <g fill=\\\"none\\\" stroke=\\\"#bff6e6\\\" stroke-opacity=\\\"0.12\\\" stroke-width=\\\"3\\\">\\n            <circle cx=\\\"120\\\" cy=\\\"120\\\" r=\\\"66\\\"/>\\n            <circle cx=\\\"120\\\" cy=\\\"120\\\" r=\\\"42\\\"/>\\n            <path d=\\\"M120 54v-6\\\"/>\\n            <path d=\\\"M120 186v6\\\"/>\\n          </g>\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card\\\" style=\\\"margin-top:20px\\\">\\n      <h2 style=\\\"margin:0;color:#eafff4\\\">Core Pillars</h2>\\n      <div class=\\\"pillars\\\">\\n        <div class=\\\"pillar\\\"><strong>Safety-first facilitation</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Clear intake, safe cueing, adaptable positions.</div>\\n        </div>\\n        <div class=\\\"pillar\\\"><strong>Sonic fidelity</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Premium instruments, careful tuning and spatial placement.</div>\\n        </div>\\n        <div class=\\\"pillar\\\"><strong>Evidence-minded</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">Techniques that support autonomic down-regulation and interoception.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card myth\\\" aria-label=\\\"Myths\\\">\\n      <div class=\\\"left\\\">\\n        <h3 style=\\\"margin-top:0;color:#dffcf0\\\">Myths vs. What’s Real</h3>\\n        <p style=\\\"color:var(--muted)\\\"><strong>Myth:</strong> Sound baths are vague and unstructured.<br/><strong>Reality:</strong> Sessions follow an intentional flow — intake, guided settling, layered soundscape, reorientation — designed to support nervous system regulation.</p>\\n      </div>\\n      <div class=\\\"right\\\" style=\\\"width:240px\\\">\\n        <svg width=\\\"240\\\" height=\\\"140\\\" viewBox=\\\"0 0 240 140\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n          <g fill=\\\"#8be9c6\\\" fill-opacity=\\\"0.06\\\"><rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"240\\\" height=\\\"140\\\" rx=\\\"12\\\"/></g>\\n          <path d=\\\"M10 120c40-40 120-60 220-30\\\" stroke=\\\"#8be9c6\\\" stroke-opacity=\\\"0.12\\\" stroke-width=\\\"4\\\" fill=\\\"none\\\"/>\\n          <circle cx=\\\"60\\\" cy=\\\"40\\\" r=\\\"18\\\" fill=\\\"#8be9c6\\\" fill-opacity=\\\"0.08\\\" />\\n        </svg>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"card case\\\" aria-label=\\\"case notes\\\">\\n      <h3 style=\\\"margin:0;color:#eafff4\\\">Case Notes — Typical Group Flow</h3>\\n      <ol style=\\\"color:var(--muted);margin-top:8px\\\">\\n        <li>Brief check-in & consent (5–8 min).</li>\\n        <li>Guided breath/body awareness and settling (8–12 min).</li>\\n        <li>Layered sound set: crystal bowls, chimes, light gong, harmonic overtone work (25–35 min).</li>\\n        <li>Gradual tapering, grounding practices and optional sharing (10–15 min).</li>\\n      </ol>\\n      <p style=\\\"color:var(--muted);margin-top:8px\\\"><strong>Note:</strong> We adapt each element to the group. If you need an acute accommodation (mobility, noise tolerance), contact us at {{EMAIL}} prior to arrival.</p>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n      <div>\\n        <a href=\\\"contact.html\\\" style=\\\"color:var(--muted);margin-right:12px\\\">Connect</a>\\n        <a href=\\\"book.html\\\" class=\\\"cta\\\">Book a Spot</a>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>FAQ — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#04101a;--panel:#071826;--accent:#a4ffdf;--muted:#9fb0bb}\\n    body{margin:0;background:radial-gradient(1200px 600px at 10% 10%,#063042 0%,transparent 20%),linear-gradient(180deg,var(--bg),#02060a);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:var(--accent)}\\n    .container{max-width:980px;margin:32px auto;padding:26px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:14px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:16px}\\n    h1{margin:8px 0 0 0}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    .faq-list{background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);padding:16px;border-radius:10px}\\n    details{background:rgba(255,255,255,0.02);padding:12px;border-radius:8px;margin-bottom:10px}\\n    summary{cursor:pointer;font-weight:700;color:#e9fff7}\\n    .side{background:linear-gradient(180deg,#06242e 0%,#02141b 100%);padding:16px;border-radius:10px;color:var(--muted)}\\n    .muted{color:var(--muted)}\\n    .btn{display:inline-block;margin-top:12px;background:linear-gradient(90deg,#69e6c6,#06b583);color:#002219;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .svg-deco{position:absolute;left:-40px;top:-40px;opacity:0.08}\\n    @media(max-width:860px){.grid{grid-template-columns:1fr;}.svg-deco{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <svg class=\\\"svg-deco\\\" width=\\\"300\\\" height=\\\"300\\\" viewBox=\\\"0 0 300 300\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n      <defs>\\n        <linearGradient id=\\\"f1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#8ff3dc\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#37b38f\\\"/></linearGradient>\\n      </defs>\\n      <rect width=\\\"300\\\" height=\\\"300\\\" rx=\\\"30\\\" fill=\\\"url(#f1)\\\" opacity=\\\"0.06\\\"/>\\n      <g fill=\\\"#8ff3dc\\\" fill-opacity=\\\"0.04\\\"><path d=\\\"M40 240c60-80 160-100 240-40\\\"/></g>\\n    </svg>\\n\\n    <header>\\n      <div style=\\\"display:flex;flex-direction:column\\\">\\n        <div style=\\\"font-weight:800;color:#eafff4\\\">{{BUSINESS_NAME}}</div>\\n        <nav style=\\\"margin-top:6px\\\">\\n          <a href=\\\"index.html\\\">Home</a>\\n          <a href=\\\"events.html\\\">Events</a>\\n          <a href=\\\"private-sessions.html\\\">Sessions</a>\\n          <a href=\\\"about.html\\\">Who we are</a>\\n          <a href=\\\"book.html\\\" style=\\\"margin-left:12px;color:var(--muted)\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </nav>\\n      </div>\\n      <div style=\\\"text-align:right\\\">\\n        <div style=\\\"color:var(--muted)\\\">Questions? Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{PHONE}}</a></div>\\n        <a href=\\\"contact.html\\\" class=\\\"btn\\\">Contact</a>\\n      </div>\\n    </header>\\n\\n    <main class=\\\"grid\\\">\\n      <section class=\\\"faq-list\\\">\\n        <h1 style=\\\"margin:0;color:#e9fff7\\\">Questions We Hear Often</h1>\\n\\n        <details>\\n          <summary>What should I bring to a sound bath?</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">A yoga mat or cushioned pad, a blanket for warmth, a small pillow for neck support, and optionally an eye mask. We provide limited bolsters and blankets but recommend bringing your own for hygienic comfort.</div>\\n        </details>\\n\\n        <details>\\n          <summary>Is a sound bath the same as meditation?</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">They overlap. A sound bath uses intentional sound layers to support meditative states; facilitation includes guided settling and reorientation, not just passive listening.</div>\\n        </details>\\n\\n        <details>\\n          <summary>Who should avoid attending?</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\"><strong>Contraindications:</strong> If you are pregnant (first consult your provider), have a history of epilepsy, photosensitive conditions, or are currently experiencing uncontrolled psychiatric crises, please consult with your clinician before attending. If you have implanted medical devices sensitive to vibration, contact us beforehand at {{EMAIL}}.</div>\\n        </details>\\n\\n        <details>\\n          <summary>How loud will it be?</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Volumes are intentional and monitored. We use instruments like gongs, tuning forks and soft crystal bowls — dynamic but never unsafe. You can request a lower placement in the room for reduced exposure.</div>\\n        </details>\\n\\n        <details>\\n          <summary>What happens if I feel emotional or overwhelmed?</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Facilitators are trained to support grounding. We pause the sound, offer verbal guidance and create space for regulated breath. If you need further assistance, we provide local resource referrals upon request.</div>\\n        </details>\\n\\n        <details>\\n          <summary>Can I record or take photos?</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">To preserve the collective container, recording and photography are not permitted unless pre-arranged for accessibility reasons.</div>\\n        </details>\\n\\n      </section>\\n\\n      <aside class=\\\"side\\\">\\n        <h3 style=\\\"margin-top:0;color:#e9fff7\\\">Session Flow Snapshot</h3>\\n        <ol style=\\\"color:var(--muted);margin-top:8px\\\">\\n          <li>Check-in & brief intake (5 min)</li>\\n          <li>Guided settling (10 min)</li>\\n          <li>Soundset with layered instruments — gong, tuning forks, chimes (30–40 min)</li>\\n          <li>Slow reorientation & optional sharing (10 min)</li>\\n        </ol>\\n\\n        <h4 style=\\\"margin-top:12px;color:#e9fff7\\\">Preparing</h4>\\n        <p class=\\\"muted\\\">Wear comfortable clothing, avoid heavy meals within an hour of the session, and refrain from intense exercise immediately beforehand.</p>\\n\\n        <h4 style=\\\"margin-top:12px;color:#e9fff7\\\">Still unsure?</h4>\\n        <p class=\\\"muted\\\">Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent)\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--accent)\\\">{{PHONE}}</a>.</p>\\n        <a href=\\\"book.html\\\" class=\\\"btn\\\">Reserve</a>\\n      </aside>\\n\\n    </main>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted);display:flex;justify-content:space-between\\\">\\n      <div>&copy; {{BUSINESS_NAME}}</div>\\n      <div>Venue: {{VENUE_NAME}} • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#04121a;--card:#06232a;--accent:#b8ffea;--muted:#9fb0bb}\\n    body{margin:0;background:linear-gradient(180deg,#02121a,#001017);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,\\\"Helvetica Neue\\\",Arial;color:var(--accent)}\\n    .shell{max-width:940px;margin:28px auto;padding:22px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:14px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:12px}\\n    h1{margin:8px 0}\\n    .grid{display:grid;grid-template-columns:1fr 340px;gap:18px;margin-top:18px}\\n    .panel{background:var(--card);padding:16px;border-radius:10px}\\n    label{display:block;color:var(--muted);font-size:13px;margin-top:10px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.03);background:transparent;color:var(--accent);margin-top:6px}\\n    .submit{margin-top:14px;background:linear-gradient(90deg,#7bf0d2,#0ea67f);color:#02211a;padding:12px 16px;border-radius:10px;border:none;font-weight:800;cursor:pointer}\\n    .note{font-size:13px;color:var(--muted);margin-top:10px}\\n    .svg-top{position:absolute;right:30px;top:-30px;opacity:0.08}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr;padding-bottom:14px}.svg-top{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"shell\\\">\\n    <svg class=\\\"svg-top\\\" width=\\\"220\\\" height=\\\"220\\\" viewBox=\\\"0 0 220 220\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n      <defs>\\n        <radialGradient id=\\\"b1\\\" cx=\\\"0.5\\\" cy=\\\"0.5\\\" r=\\\"0.6\\\"><stop offset=\\\"0\\\" stop-color=\\\"#9ff6e1\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#3fb08a\\\" stop-opacity=\\\"0.02\\\"/></radialGradient>\\n      </defs>\\n      <rect width=\\\"220\\\" height=\\\"220\\\" rx=\\\"30\\\" fill=\\\"url(#b1)\\\"/>\\n      <g fill=\\\"#9ff6e1\\\" fill-opacity=\\\"0.04\\\"><path d=\\\"M20 180c60-90 150-100 200-40\\\"/></g>\\n    </svg>\\n\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:800;color:#eafff4\\\">{{BUSINESS_NAME}}</div>\\n        <nav style=\\\"margin-top:6px\\\">\\n          <a href=\\\"index.html\\\">Overview</a>\\n          <a href=\\\"events.html\\\">Next</a>\\n          <a href=\\\"faq.html\\\">FAQ</a>\\n          <a href=\\\"contact.html\\\">Reach</a>\\n        </nav>\\n      </div>\\n      <div style=\\\"text-align:right;color:var(--muted)\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent)\\\">{{EMAIL}}</a></div>\\n    </header>\\n\\n    <main class=\\\"grid\\\">\\n      <section>\\n        <h1 style=\\\"margin:0;color:#e8fff6\\\">Reserve Your Session</h1>\\n        <p class=\\\"note\\\">Secure a spot for our next group sound bath or book a private format. Select an option below and complete the reservation form. Payment and confirmation details are sent to {{EMAIL}}.</p>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:14px\\\">\\n          <h3 style=\\\"margin:0;color:#eafff4\\\">Session Flow — what to expect</h3>\\n          <ol style=\\\"color:var(--muted);margin-top:8px\\\">\\n            <li>Welcome & intake (5–10 min)</li>\\n            <li>Grounding and guided breathwork (8–12 min)</li>\\n            <li>Main soundscape (25–40 min) — instruments may include singing bowls, monochord, light gong and harmonic chimes</li>\\n            <li>Slow tapering, grounding, optional check-out (10–15 min)</li>\\n          </ol>\\n          <p class=\\\"note\\\">We maintain an enclosed, low-stimulus environment and moderate sound levels to be accessible to as many participants as possible.</p>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h3 style=\\\"margin:0;color:#eafff4\\\">Private & Specialty Formats</h3>\\n          <ul style=\\\"color:var(--muted);margin-top:8px\\\">\\n            <li><strong>1:1 session</strong> — personalized pacing and targeted somatic support (45–75 min).</li>\\n            <li><strong>Couples</strong> — shared sound container with relational cues and guided co-regulation (60 min).</li>\\n            <li><strong>Corporate / team</strong> — brief group offerings focused on stress resilience and team grounding (30–45 min).</li>\\n          </ul>\\n          <p class=\\\"note\\\">For private bookings, include preferred dates and group size in the notes below.</p>\\n        </div>\\n\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <h3 style=\\\"margin:0;color:#eafff4\\\">Book Now</h3>\\n          <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" style=\\\"margin-top:10px\\\">\\n            <label for=\\\"type\\\">Type of booking</label>\\n            <select id=\\\"type\\\" name=\\\"type\\\">\\n              <option>Next group event</option>\\n              <option>1:1 private</option>\\n              <option>Couples</option>\\n              <option>Corporate / Team</option>\\n            </select>\\n            <label for=\\\"name\\\">Your full name</label>\\n            <input id=\\\"name\\\" name=\\\"name\\\" required placeholder=\\\"Jane Doe\\\" />\\n            <label for=\\\"email\\\">Email</label>\\n            <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required placeholder=\\\"you@example.com\\\" />\\n            <label for=\\\"phone\\\">Phone (optional)</label>\\n            <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"{{PHONE}}\\\" />\\n            <label for=\\\"notes\\\">Notes / accessibility requests</label>\\n            <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Mobility needs, sensory accommodations, private booking details...\\\"></textarea>\\n            <div class=\\\"note\\\">Please declare any medical implants, pregnancy, or seizure history in the notes or contact us directly at {{EMAIL}} before booking.</div>\\n            <button type=\\\"submit\\\" class=\\\"submit\\\">Confirm & Continue</button>\\n          </form>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0;color:#eafff4\\\">What to bring</h4>\\n          <ul style=\\\"color:var(--muted);margin-top:8px\\\">\\n            <li>Mat or cushioned pad</li>\\n            <li>Blanket and small pillow</li>\\n            <li>Water bottle for after the session</li>\\n          </ul>\\n          <div class=\\\"note\\\">Avoid heavy meals within an hour prior. Arrive 10–12 minutes early for check-in.</div>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:12px\\\">\\n          <h4 style=\\\"margin:0;color:#eafff4\\\">Safety & Contraindications</h4>\\n          <p class=\\\"muted\\\">Sound work is generally gentle, but if you have photosensitive epilepsy, implanted devices that are vibration-sensitive, uncontrolled psychiatric conditions, or are pregnant and require specific clearance, please consult your clinician and notify us at {{EMAIL}} prior to attending.</p>\\n        </div>\\n\\n      </aside>\\n\\n    </main>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted);display:flex;justify-content:space-between\\\">\\n      <div>Venue: {{VENUE_NAME}} • {{CITY}}, {{STATE}}</div>\\n      <div><a href=\\\"faq.html\\\" style=\\\"color:var(--accent);text-decoration:none\\\">Need help?</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
