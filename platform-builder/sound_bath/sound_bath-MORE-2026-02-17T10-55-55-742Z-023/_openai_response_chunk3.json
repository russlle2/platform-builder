          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"About {{BUSINESS_NAME}} — community sound gatherings and membership offerings\\\">\\n  <style>\\n    :root{--bg:#0f1216;--card:#0c0f12;--muted:#9aa3a8;--accent:#9ad7d1;--glass:rgba(255,255,255,0.03)}\\n    *{box-sizing:border-box;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,#071018 0%,#0f1216 60%);color:#e7eef0}\\n    a{color:var(--accent);text-decoration:none}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px}\\n    nav a{margin:0 12px;font-size:14px;color:#cde9e4}\\n    .brand{font-weight:700;letter-spacing:0.6px}\\n    .hero{padding:48px 28px 28px;display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:start}\\n    .hero h1{margin:0 0 12px;font-size:28px}\\n    .hero p{margin:0 0 16px;color:var(--muted);max-width:70ch}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;box-shadow:0 6px 24px rgba(2,6,8,0.6)}\\n    .pattern{width:100%;height:120px;border-radius:10px;overflow:hidden;margin-bottom:12px}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}\\n    .testimonial-shell{display:flex;gap:12px;align-items:center}\\n    .avatar{width:56px;height:56px;border-radius:10px;background:linear-gradient(135deg,#122a2b,#06343a);display:flex;align-items:center;justify-content:center;font-weight:700;color:#bfe9e3}\\n    .quote{font-size:14px;color:#dff6f2}\\n    .badges{display:flex;gap:10px;margin-top:8px}\\n    .badge{background:var(--glass);padding:8px 10px;border-radius:8px;font-size:12px;color:var(--muted);position:relative}\\n    .badge[data-tooltip]:hover::after{content:attr(data-tooltip);position:absolute;left:50%;transform:translateX(-50%);bottom:calc(100% + 8px);background:#061012;padding:8px;border-radius:6px;color:#d9f4f0;font-size:12px;white-space:nowrap}\\n    .muted{color:var(--muted);font-size:13px}\\n    footer{padding:24px 28px;border-top:1px solid rgba(255,255,255,0.03);display:flex;justify-content:space-between;align-items:center}\\n    .cta{background:linear-gradient(90deg,#8fe0d8,#73c8c0);color:#022;padding:10px 14px;border-radius:10px;font-weight:700}\\n    /* small */\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:1fr}}  \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Gatherings</a>\\n      <a href=\\\"private-sessions.html\\\">Close Work</a>\\n      <a href=\\\"pricing.html\\\">Memberships</a>\\n      <a href=\\\"about.html\\\">Story</a>\\n      <a href=\\\"faq.html\\\">Help</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>We shape time with sound — a membership for steady presence</h1>\\n        <p>{{TAGLINE}}. Our gatherings fold simple acoustics into an approachable practice that lives beside your day, not away from it. Memberships emphasize continuity: a short, reliable frame to track recalibration over weeks.</p>\\n\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 8px\\\">What members get</h3>\\n          <ul style=\\\"margin:0 0 12px;color:var(--muted);padding-left:18px;line-height:1.6\\\">\\n            <li>Priority booking and member-only evening sessions</li>\\n            <li>Discounted private session time and micro-lessons</li>\\n            <li>Gentle progress notes and at-home prompts</li>\\n          </ul>\\n          <a class=\\\"cta\\\" href=\\\"pricing.html\\\">See membership plans</a>\\n        </div>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <div class=\\\"pattern\\\" role=\\\"img\\\" aria-label=\\\"decorative pattern\\\">\\n            <svg width=\\\"100%\\\" height=\\\"100%\\\" viewBox=\\\"0 0 600 120\\\" preserveAspectRatio=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n              <defs>\\n                <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n                  <stop offset=\\\"0\\\" stop-color=\\\"#05242a\\\" stop-opacity=\\\"1\\\"/>\\n                  <stop offset=\\\"1\\\" stop-color=\\\"#09323a\\\" stop-opacity=\\\"0.2\\\"/>\\n                </linearGradient>\\n              </defs>\\n              <rect width=\\\"600\\\" height=\\\"120\\\" fill=\\\"url(#g1)\\\" />\\n              <g fill=\\\"none\\\" stroke=\\\"#08383b\\\" stroke-width=\\\"1\\\" opacity=\\\"0.9\\\">\\n                <path d=\\\"M0 80 C120 40 240 120 360 60 C480 0 600 60 600 60\\\"/>\\n                <path d=\\\"M0 40 C100 60 220 0 360 40 C480 80 600 20 600 20\\\" stroke-opacity=\\\"0.6\\\"/>\\n              </g>\\n            </svg>\\n          </div>\\n\\n          <div style=\\\"display:flex;flex-direction:column;gap:10px\\\">\\n            <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n              <div>\\n                <div style=\\\"font-weight:700\\\">Next gathering</div>\\n                <div class=\\\"muted\\\">Every other Friday • 7:00 PM</div>\\n              </div>\\n              <div><a href=\\\"events.html\\\" style=\\\"background:#07292b;color:#bff0ea;padding:8px 10px;border-radius:8px\\\">See calendar</a></div>\\n            </div>\\n\\n            <div class=\\\"badges\\\" aria-hidden=\\\"false\\\">\\n              <div class=\\\"badge\\\" data-tooltip=\\\"Local clinic partnership — shared referral network\\\">Clinic Partner</div>\\n              <div class=\\\"badge\\\" data-tooltip=\\\"Featured in a regional wellness journal\\\">Regional Press</div>\\n              <div class=\\\"badge\\\" data-tooltip=\\\"Teachers and facilitators reviewed by peers\\\">Practitioner Network</div>\\n            </div>\\n          </div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"padding:22px 28px\\\">\\n      <div class=\\\"card\\\" style=\\\"padding:18px\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">Proof Gallery</h3>\\n        <p class=\\\"muted\\\" style=\\\"margin:0 0 12px\\\">A rotating selection of short reflections and the marks that matter to us.</p>\\n\\n        <div id=\\\"proof\\\" style=\\\"display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap\\\">\\n          <div class=\\\"testimonial-shell card\\\" style=\\\"flex:1;min-width:260px\\\">\\n            <div class=\\\"avatar\\\" id=\\\"t-avatar\\\">A</div>\\n            <div>\\n              <div id=\\\"t-quote\\\" class=\\\"quote\\\">\\\"A calm that arrives without effort — I left with a clearer plan for the week.\\\"</div>\\n              <div class=\\\"muted\\\" id=\\\"t-author\\\">— Ana, designer</div>\\n              <div class=\\\"badges\\\" style=\\\"margin-top:8px\\\">\\n                <div class=\\\"badge\\\" data-tooltip=\\\"Independent review — participant feedback\\\">Participant Rated</div>\\n                <div class=\\\"badge\\\" data-tooltip=\\\"Verified workshop host in our region\\\">Host Verified</div>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"card\\\" style=\\\"flex:0 0 220px;padding:12px\\\">\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Why we keep rotating</div>\\n            <div style=\\\"margin-top:8px;color:#dff6f2\\\">We curate short testimonials and credible partners to build a steady measure of trust — not spectacle. Hover badges for context.</div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"padding:22px 28px\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">A careful note on safety</h3>\\n        <p class=\\\"muted\\\" style=\\\"margin:0 0 12px\\\">Sound sessions are gentle but not suitable for everyone. Please consult with a medical practitioner before participating if you have: recent cranial surgery, pre-existing seizure disorder, uncontrolled hypertension, severe psychiatric conditions, or pregnancy complications. If you use medical implants or are under medication affecting consciousness, check with your clinician first. Our facilitators will always offer quieter options and seating on request.</p>\\n        <a href=\\\"faq.html\\\" style=\\\"color:var(--accent)\\\">Full contraindications and guidance</a>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"muted\\\">Contact: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Join a session</a></div>\\n  </footer>\\n\\n  <script>\\n    // Rotating testimonials for Proof Gallery\\n    (function(){\\n      const items = [\\n        {a:'L',q:'\\\"Left the room with a planning rhythm I didn\\\\'t expect — short and remarkably useful.\\\",',n:'— L. (teacher)'} ,\\n        {a:'M',q:'\\\"Concrete relief; my sleep shifted that evening and things felt simpler.\\\",',n:'— M. (therapist)'} ,\\n        {a:'R',q:'\\\"A steady, no-nonsense space for showing up. I keep coming for the continuity.\\\",',n:'— R. (developer)'}\\n      ];\\n      let i=0;const avatar=document.getElementById('t-avatar');const quote=document.getElementById('t-quote');const author=document.getElementById('t-author');\\n      function rotate(){\\n        const it=items[i%items.length];\\n        avatar.textContent=it.a;quote.textContent=it.q.replace(/,$/,'.');author.textContent=it.n;i++;\\n      }\\n      rotate();setInterval(rotate,4200);\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>FAQ — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071115;--muted:#9fb3b0;--accent:#7fd7cf}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:#e7f2f1}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 22px}\\n    nav a{margin:0 10px;color:#bfeee7}\\n    main{padding:20px}\\n    .panel{background:rgba(255,255,255,0.02);padding:16px;border-radius:12px;margin-bottom:14px}\\n    h1{margin:0 0 6px}\\n    details{background:rgba(255,255,255,0.01);padding:14px;border-radius:10px}\\n    summary{font-weight:700;cursor:pointer}\\n    .muted{color:var(--muted);font-size:14px}\\n    .proof{display:flex;gap:12px;align-items:center;margin-top:12px}\\n    .proof .badge{background:#0b1a1b;padding:8px 10px;border-radius:8px;color:var(--muted)}\\n    .tooltip{position:relative}\\n    .tooltip:hover::after{content:attr(data-tip);position:absolute;left:50%;transform:translateX(-50%);bottom:calc(100% + 8px);background:#062022;padding:8px;border-radius:6px;color:#dff6f0;white-space:nowrap}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Gatherings</a>\\n      <a href=\\\"pricing.html\\\">Plans</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Reach us</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"panel\\\">\\n      <h1>Common questions</h1>\\n      <p class=\\\"muted\\\">Short answers that help you decide quickly. Prefer to speak? <a href=\\\"tel:{{PHONE}}\\\">Call {{PHONE}}</a>.</p>\\n    </section>\\n\\n    <section class=\\\"panel\\\">\\n      <details open>\\n        <summary>What should I expect at a group session?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">A guided sequence of layered sounds and quiet intervals. Sessions are structured to keep participants safe and grounded; facilitators offer seating options and volume adjustments. Average length depends on format; see events for specific times.</div>\\n      </details>\\n    </section>\\n\\n    <section class=\\\"panel\\\">\\n      <details>\\n        <summary>Can I attend if I have medical concerns?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Short answer: consult your provider. Sound can interact with certain conditions. If you have epilepsy, recent head surgery, unstable cardiovascular conditions, or are pregnant with complications, please get medical sign-off. We list contraindications clearly on booking and will offer quieter or private options for people who need them.</div>\\n      </details>\\n    </section>\\n\\n    <section class=\\\"panel\\\">\\n      <details>\\n        <summary>How does membership work?</summary>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Monthly plans provide recurring credits, priority booking, and a lower per-session rate for both group and private work. No long-term lock-ins beyond a monthly cancellation window. See the Plans page for tiered pricing and what each credit covers.</div>\\n      </details>\\n    </section>\\n\\n    <section class=\\\"panel\\\">\\n      <h3 style=\\\"margin:0 0 10px\\\">Proof Gallery</h3>\\n      <div class=\\\"proof\\\">\\n        <div style=\\\"flex:1\\\">\\n          <div style=\\\"font-weight:700\\\">Participant reflections</div>\\n          <div class=\\\"muted\\\" id=\\\"faq-quote\\\" style=\\\"margin-top:6px\\\">\\\"A small, reliable practice that helped me keep a calmer week.\\\"</div>\\n        </div>\\n        <div style=\\\"display:flex;flex-direction:column;gap:8px\\\">\\n          <div class=\\\"badge tooltip\\\" data-tip=\\\"Local wellness feature\\\">Local Press</div>\\n          <div class=\\\"badge tooltip\\\" data-tip=\\\"Community referral network\\\">Clinic Link</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"panel\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Contact & bookings</h3>\\n      <p class=\\\"muted\\\">For membership, private sessions, or accessibility requests contact <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>. To reserve a spot right away, use the Reserve page.</p>\\n      <a href=\\\"book.html\\\" style=\\\"display:inline-block;margin-top:8px;padding:10px 12px;background:linear-gradient(90deg,#7fd7cf,#56bfb6);color:#052; border-radius:8px;font-weight:700\\\">Reserve now</a>\\n    </section>\\n  </main>\\n\\n  <script>\\n    // Small rotation for the FAQ testimonial line\\n    (function(){\\n      const quotes=[\\n        '\\\"Leaves a useful quiet: not dramatic, just better focus.\\\"',\\n        '\\\"I can track the difference in my evenings after a month.\\\"',\\n        '\\\"Dependable sessions and clear guidance — membership has value.\\\"'\\n      ];\\n      const el=document.getElementById('faq-quote');let i=0;\\n      setInterval(()=>{el.textContent=quotes[i%quotes.length];i++;},3800);\\n    })();\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071219;--card:#07171a;--muted:#9fc8c3;--accent:#86e1d7}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:linear-gradient(180deg,#041017 0%,#071219 100%);color:#e8f7f4}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 22px}\\n    nav a{margin:0 10px;color:#c9f0eb}\\n    main{padding:20px;display:grid;grid-template-columns:1fr 360px;gap:18px}\\n    .card{background:rgba(255,255,255,0.02);padding:16px;border-radius:12px}\\n    .muted{color:var(--muted)}\\n    label{display:block;margin:10px 0 6px;font-weight:700}\\n    input,select{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.03);background:transparent;color:inherit}\\n    .mixer{display:flex;gap:8px;margin-top:8px}\\n    .mix-btn{flex:1;padding:10px;border-radius:8px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.03);cursor:pointer}\\n    .mix-btn.active{background:linear-gradient(90deg,#84dacb,#56bdb1);color:#022}\\n    .reco{margin-top:12px;padding:10px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);border-radius:8px}\\n    .price{font-weight:800;color:var(--accent);font-size:20px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 12px;background:linear-gradient(90deg,#7fd7cf,#56bfb6);color:#042;border-radius:8px;font-weight:700}\\n    @media(max-width:980px){main{grid-template-columns:1fr}} \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Gatherings</a>\\n      <a href=\\\"pricing.html\\\">Plans</a>\\n      <a href=\\\"about.html\\\">Story</a>\\n      <a href=\\\"faq.html\\\">Help</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section>\\n      <div class=\\\"card\\\">\\n        <h2 style=\\\"margin:0 0 10px\\\">Reserve a spot</h2>\\n        <p class=\\\"muted\\\" style=\\\"margin:0 0 12px\\\">Choose a session and the sound emphasis that suits you. Our mixer will tune the recommendation and price estimate.</p>\\n\\n        <form id=\\\"book-form\\\" onsubmit=\\\"return false;\\\">\\n          <label for=\\\"session\\\">Session</label>\\n          <select id=\\\"session\\\">\\n            <option value=\\\"drift\\\">Drift Session — 45 min</option>\\n            <option value=\\\"core\\\">Core Resonance — 70 min</option>\\n            <option value=\\\"spectrum\\\">Full Spectrum — 95 min</option>\\n          </select>\\n\\n          <label for=\\\"date\\\">Date</label>\\n          <input id=\\\"date\\\" type=\\\"date\\\" required />\\n\\n          <label>Sound emphasis</label>\\n          <div class=\\\"mixer\\\" role=\\\"radiogroup\\\" aria-label=\\\"sound preference mixer\\\">\\n            <button type=\\\"button\\\" class=\\\"mix-btn\\\" data-level=\\\"gentle\\\">Gentle</button>\\n            <button type=\\\"button\\\" class=\\\"mix-btn\\\" data-level=\\\"steady\\\">Steady</button>\\n            <button type=\\\"button\\\" class=\\\"mix-btn\\\" data-level=\\\"intense\\\">Full</button>\\n          </div>\\n\\n          <div id=\\\"recommendations\\\" class=\\\"reco\\\">\\n            <div style=\\\"font-size:13px;color:var(--muted)\\\">Recommendation</div>\\n            <div id=\\\"reco-title\\\" style=\\\"font-weight:800;margin-top:6px\\\">Drift Session</div>\\n            <div id=\\\"reco-desc\\\" class=\\\"muted\\\" style=\\\"margin-top:6px\\\">A short, cushioned session for settling and light recalibration.</div>\\n            <div style=\\\"margin-top:8px\\\">Estimated price <span class=\\\"price\\\" id=\\\"reco-price\\\">$25</span></div>\\n          </div>\\n\\n          <div style=\\\"display:flex;gap:10px;align-items:center;margin-top:12px\\\">\\n            <button id=\\\"confirm\\\" class=\\\"cta\\\">Hold my seat</button>\\n            <div class=\\\"muted\\\">Or <a href=\\\"contact.html\\\">call us</a> to reserve by phone</div>\\n          </div>\\n        </form>\\n      </div>\\n\\n      <div style=\\\"margin-top:12px\\\" class=\\\"card\\\">\\n        <h3 style=\\\"margin:0 0 8px\\\">Membership perks</h3>\\n        <p class=\\\"muted\\\" style=\\\"margin:0 0 8px\\\">Members save on per-session cost. Select the \\\"Membership\\\" checkbox in the next step to apply savings and priority booking.</p>\\n        <label style=\\\"display:flex;align-items:center;gap:10px;margin-top:10px\\\"><input id=\\\"is-member\\\" type=\\\"checkbox\\\" /> I am a member</label>\\n      </div>\\n    </section>\\n\\n    <aside>\\n      <div class=\\\"card\\\">\\n        <h4 style=\\\"margin:0 0 8px\\\">Upcoming — next event</h4>\\n        <div class=\\\"muted\\\">Friday • 7:00 PM • Sound field — focused layers</div>\\n        <div style=\\\"margin-top:12px\\\">\\n          <div style=\\\"font-weight:700\\\">Calendar</div>\\n          <ul class=\\\"muted\\\" style=\\\"padding-left:18px;margin:8px 0 0\\\">\\n            <li>02/20 • Community evening</li>\\n            <li>03/06 • Members night</li>\\n            <li>03/20 • Deep field practice</li>\\n          </ul>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:12px\\\" class=\\\"card\\\">\\n        <h4 style=\\\"margin:0 0 8px\\\">Quick trust signals</h4>\\n        <div style=\\\"display:flex;gap:10px;flex-wrap:wrap\\\">\\n          <div class=\\\"muted\\\" style=\\\"background:rgba(255,255,255,0.02);padding:8px;border-radius:8px\\\">Member-backed</div>\\n          <div class=\\\"muted\\\" style=\\\"background:rgba(255,255,255,0.02);padding:8px;border-radius:8px\\\">Clinic referrals</div>\\n          <div class=\\\"muted\\\" style=\\\"background:rgba(255,255,255,0.02);padding:8px;border-radius:8px\\\">Accessibility seating</div>\\n        </div>\\n      </div>\\n    </aside>\\n  </main>\\n\\n  <footer style=\\\"padding:18px 22px;border-top:1px solid rgba(255,255,255,0.03)\\\">\\n    <div class=\\\"muted\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </footer>\\n\\n  <script>\\n    // Mixer logic: change recommendation and price\\n    (function(){\\n  