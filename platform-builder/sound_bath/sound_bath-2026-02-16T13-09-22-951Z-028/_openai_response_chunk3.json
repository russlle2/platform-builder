          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--earth:#7a4a2b;--sand:#f4e9df;--moss:#586a50;--accent:#d9b58b;--ink:#2b2b2b}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial; color:var(--ink);background:linear-gradient(180deg,var(--sand),#fff);}\\n    .wrap{min-height:100vh;display:flex;flex-direction:column}\\n    header{position:relative;padding:28px 32px;background:linear-gradient(180deg,rgba(122,74,43,0.06),transparent);display:flex;align-items:center;justify-content:space-between}\\n    nav a{color:var(--earth);text-decoration:none;margin:0 10px;font-weight:600}\\n    .brand{display:flex;flex-direction:column}\\n    .brand .name{font-size:18px;font-weight:700;color:var(--earth)}\\n    .brand .tag{font-size:12px;color:#7f6a59}\\n    main{flex:1;padding:40px 32px;position:relative;overflow:hidden}\\n    /* decorative svg sits behind content */\\n    .bg-svg{position:absolute;right:-120px;top:-40px;width:680px;height:680px;opacity:0.12;transform:rotate(12deg);pointer-events:none}\\n    .hero{max-width:780px;margin:36px 0 28px}\\n    .kicker{font-size:13px;color:var(--moss);letter-spacing:1px;text-transform:uppercase}\\n    h1{font-size:34px;margin:8px 0 12px;color:var(--earth)}\\n    p.lead{color:#5b4a3f;font-size:16px;line-height:1.6}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:28px;margin-top:24px}\\n    .card{background:linear-gradient(180deg,#fff,#fbf7f4);padding:20px;border-radius:12px;box-shadow:0 6px 18px rgba(42,30,20,0.06)}\\n    .pillars li{margin:12px 0;font-weight:600;color:var(--earth)}\\n    .case-notes{font-style:italic;color:#5b4a3f}\\n    .faq-short{margin-top:18px}\\n    footer{padding:28px 32px;background:linear-gradient(0deg,rgba(217,181,139,0.06),transparent);display:flex;align-items:center;justify-content:space-between}\\n    .cta{background:linear-gradient(90deg,var(--earth),#a66a3f);color:white;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    @media (max-width:880px){.grid{grid-template-columns:1fr}.bg-svg{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"name\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"tag\\\">A sensorial offering — {{TAGLINE}}</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Offerings</a>\\n        <a href=\\\"private-sessions.html\\\">Sessions</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <!-- decorative svg pattern -->\\n      <svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 600 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n        <defs>\\n          <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n            <stop offset=\\\"0\\\" stop-color=\\\"#d9b58b\\\" />\\n            <stop offset=\\\"1\\\" stop-color=\\\"#7a4a2b\\\" />\\n          </linearGradient>\\n          <pattern id=\\\"p1\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n            <rect width=\\\"40\\\" height=\\\"40\\\" fill=\\\"transparent\\\" />\\n            <path d=\\\"M0 20 L20 0 L40 20 L20 40 Z\\\" fill=\\\"url(#g1)\\\" opacity=\\\"0.06\\\"/>\\n          </pattern>\\n        </defs>\\n        <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\" />\\n      </svg>\\n\\n      <section class=\\\"hero\\\" id=\\\"hero\\\">\\n        <div class=\\\"kicker\\\">Gathering / Quiet</div>\\n        <h1>We hold a field for sound to do the work</h1>\\n        <p class=\\\"lead\\\">{{BUSINESS_NAME}} creates slow, sensory gatherings — crafted sound baths that feel like a warm tide. Each session is guided, ceremonial, and held in intentional silence between notes. We blend instruments, breath, and light to invite ease.</p>\\n      </section>\\n\\n      <div class=\\\"grid\\\">\\n        <div>\\n          <section class=\\\"card\\\" id=\\\"pillars\\\">\\n            <h2 style=\\\"margin:0 0 8px;color:var(--moss)\\\">Core Principles</h2>\\n            <ul class=\\\"pillars\\\">\\n              <li>Presence: a room curated for inward attention</li>\\n              <li>Resonance: instruments tuned to invite physical listening</li>\\n              <li>Accessibility: gentle guidance for every body</li>\\n            </ul>\\n            <p style=\\\"margin-top:12px;color:#6b5b4f\\\">Instruments often include crystal bowls, chimes and a subtle monochord — selected to layer harmonics without overwhelming the breath.</p>\\n          </section>\\n\\n          <section class=\\\"card\\\" style=\\\"margin-top:18px\\\" id=\\\"case_notes\\\">\\n            <h3 style=\\\"margin:0 0 8px;color:var(--earth)\\\">Case Notes — a quiet ledger</h3>\\n            <p class=\\\"case-notes\\\">\\\"After three sessions I slept through the night without waking.\\\" — participant, seasonal series</p>\\n            <p class=\\\"case-notes\\\">\\\"A gentle reset for my shoulders and a new awareness in my chest.\\\" — local yoga teacher</p>\\n          </section>\\n        </div>\\n\\n        <aside class=\\\"card\\\">\\n          <h3 style=\\\"margin-top:0;color:var(--earth)\\\">Facilitator & space</h3>\\n          <p style=\\\"margin:6px 0 10px\\\">Sessions facilitated by {{FACILITATOR_NAME}} at {{VENUE_NAME}} — a small, curated room in {{CITY}}, {{STATE}}.</p>\\n\\n          <h4 style=\\\"margin:12px 0 8px;color:var(--moss)\\\">Short FAQ</h4>\\n          <div class=\\\"faq-short\\\">\\n            <strong>How long?</strong>\\n            <div style=\\\"margin-bottom:8px\\\">Typical group baths are 60–90 minutes.</div>\\n            <strong>Bring?</strong>\\n            <div>Yoga mat, blanket, and an open sense of curiosity.</div>\\n          </div>\\n        </aside>\\n      </div>\\n\\n      <section class=\\\"card\\\" id=\\\"myth_vs_truth\\\" style=\\\"margin-top:26px\\\">\\n        <h3 style=\\\"margin:0 0 8px;color:var(--earth)\\\">Myths & truths</h3>\\n        <ul style=\\\"margin:0;padding-left:18px;color:#6b5b4f\\\">\\n          <li><strong>Myth:</strong> \\\"Sound baths are mystical ceremonies only.\\\" <br/><strong>Truth:</strong> They're simple practices of attentive listening — accessible to anyone.</li>\\n          <li><strong>Myth:</strong> \\\"You must do anything special.\\\" <br/><strong>Truth:</strong> Comfortable rest and presence are all that's needed.</li>\\n        </ul>\\n      </section>\\n\\n      <section class=\\\"card\\\" id=\\\"faq\\\" style=\\\"margin-top:18px\\\">\\n        <h3 style=\\\"margin:0 0 8px;color:var(--moss)\\\">Questions we often hear</h3>\\n        <details style=\\\"margin:8px 0\\\"><summary>Is this meditation?</summary><div style=\\\"margin-top:8px;color:#5b4a3f\\\">It can include meditative qualities — guided breathing and invitation to attention — but we focus on listening to vibration rather than strict technique.</div></details>\\n        <details style=\\\"margin:8px 0\\\"><summary>Can I fall asleep?</summary><div style=\\\"margin-top:8px;color:#5b4a3f\\\">Yes — and that is perfectly fine. The field supports restorative rest.</div></details>\\n      </section>\\n\\n      <section id=\\\"cta\\\" style=\\\"margin-top:22px;text-align:center\\\">\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <p style=\\\"margin-top:10px;color:#6b5b4f\\\">Questions? Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--earth);text-decoration:none\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--earth);text-decoration:none\\\">{{EMAIL}}</a></p>\\n      </section>\\n    </main>\\n\\n    <footer>\\n      <div style=\\\"font-size:13px;color:#7f6a59\\\">© {{BUSINESS_NAME}} — {{CITY}}, {{STATE}}</div>\\n      <div style=\\\"font-size:13px;color:#7f6a59\\\">Small gatherings • Seasonal series</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>FAQ — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--soil:#6b4f3a;--cream:#fbf6f0;--sage:#637154;--warm:#d9b58b}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto; color:var(--soil);background:linear-gradient(180deg,var(--cream),#fff)}\\n    header{padding:18px 24px;display:flex;justify-content:space-between;align-items:center}\\n    nav a{margin:0 10px;color:var(--soil);text-decoration:none}\\n    main{padding:24px;max-width:980px;margin:0 auto}\\n    .hero{padding:20px;background:radial-gradient(circle at 10% 10%,rgba(217,181,139,0.12),transparent);border-radius:12px}\\n    h1{margin:0 0 8px;color:var(--soil)}\\n    p.lead{margin:0;color:#6b5b4f}\\n    .faq-list{margin-top:18px}\\n    .q{background:#fff;border-left:4px solid var(--warm);padding:14px;border-radius:10px;margin-bottom:12px}\\n    .muted{color:#7e6a5b;font-size:14px}\\n    .what-to-bring{display:flex;gap:12px;flex-wrap:wrap;margin-top:10px}\\n    .chip{background:#fff;padding:8px 12px;border-radius:999px;box-shadow:0 4px 10px rgba(104,80,64,0.06)}\\n    .disclaimer{background:#fffbe8;border-left:4px solid #d9b58b;padding:14px;border-radius:8px;margin-top:12px}\\n    footer{margin-top:28px;padding:18px;text-align:center;color:#8a7361}\\n    /* background svg pattern anchor */\\n    .pattern{position:fixed;left:-60px;bottom:-60px;opacity:0.08;width:520px;height:520px;pointer-events:none}\\n    @media (max-width:720px){.pattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div><strong style=\\\"color:var(--soil)\\\">{{BUSINESS_NAME}}</strong></div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Gatherings</a>\\n      <a href=\\\"events.html\\\">Calendar</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Say Hello</a>\\n    </nav>\\n  </header>\\n\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 600 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"lg2\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#586a50\\\" /><stop offset=\\\"1\\\" stop-color=\\\"#7a4a2b\\\" /></linearGradient>\\n      <pattern id=\\\"p2\\\" width=\\\"60\\\" height=\\\"60\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"60\\\" height=\\\"60\\\" fill=\\\"transparent\\\" />\\n        <circle cx=\\\"30\\\" cy=\\\"30\\\" r=\\\"14\\\" fill=\\\"url(#lg2)\\\" opacity=\\\"0.06\\\" />\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p2)\\\" />\\n  </svg>\\n\\n  <main>\\n    <section class=\\\"hero\\\" id=\\\"hero\\\">\\n      <h1>Questions, softened</h1>\\n      <p class=\\\"lead\\\">Practical answers for curious listeners. We favor clarity and gentle guidance — below is what most guests ask before arriving.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" id=\\\"myth_vs_truth\\\">\\n      <div class=\\\"q\\\">\\n        <strong>Do I need experience with meditation?</strong>\\n        <div class=\\\"muted\\\">No. Sessions are accessible. We offer brief guidance and the music carries much of the invitation.</div>\\n      </div>\\n      <div class=\\\"q\\\">\\n        <strong>What instruments do you use?</strong>\\n        <div class=\\\"muted\\\">A carefully chosen palette: Tibetan bowls, a mellow gong, and harmonic tuning forks often appear. Each event varies to keep texture alive.</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"faq-list\\\" id=\\\"faq\\\">\\n      <div class=\\\"q\\\">\\n        <strong>How long is a typical group sound bath?</strong>\\n        <div class=\\\"muted\\\">Generally 60–90 minutes. We begin with an orientation and close with a short grounding period.</div>\\n      </div>\\n\\n      <div class=\\\"q\\\">\\n        <strong>What to bring?</strong>\\n        <div class=\\\"what-to-bring\\\">\\n          <div class=\\\"chip\\\">Yoga mat or cushion</div>\\n          <div class=\\\"chip\\\">Blanket</div>\\n          <div class=\\\"chip\\\">Water bottle</div>\\n          <div class=\\\"chip\\\">Eye pillow (optional)</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"q\\\">\\n        <strong>Contraindications & safety</strong>\\n        <div class=\\\"disclaimer\\\">Please consult your healthcare provider if you are pregnant in the first trimester, have a history of seizures, uncontrolled psychiatric conditions, or recent head trauma. Sound can be intense — disclose implants, pacemakers, or recent surgeries when booking.</div>\\n      </div>\\n\\n      <div class=\\\"q\\\">\\n        <strong>Can I attend if I’m sensitive to loud sound?</strong>\\n        <div class=\\\"muted\\\">Yes. Facilitators aim for a mid-range dynamic and will avoid sudden volume spikes. If you are concerned, request a front-row or quieter positioning when booking.</div>\\n      </div>\\n\\n      <div class=\\\"q\\\">\\n        <strong>Is the space accessible?</strong>\\n        <div class=\\\"muted\\\">Our venue is on one level with a short ramp. If you need additional accommodations, email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\" id=\\\"pillars\\\">\\n      <h3 style=\\\"margin-bottom:8px;color:var(--soil)\\\">How a session flows</h3>\\n      <ol style=\\\"color:#6b5b4f\\\">\\n        <li>Arrival & gentle orientation (10 min)</li>\\n        <li>Guided breathing + settling (5–10 min)</li>\\n        <li>Main sound field — layered instruments (40–60 min)</li>\\n        <li>Slow return & sharing space (5–10 min)</li>\\n      </ol>\\n      <p style=\\\"margin-top:8px;color:#6b5b4f\\\">Expect long tones, harmonic washes, and moments of near-silence that let the body resonate.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\" id=\\\"cta\\\">\\n      <p class=\\\"muted\\\">Ready to reserve a spot? Our next gathering is <strong>{{NEXT_EVENT_DATE}}</strong>.</p>\\n      <p><a style=\\\"display:inline-block;padding:10px 14px;background:linear-gradient(90deg,var(--soil),#8a5b3f);color:white;border-radius:10px;text-decoration:none;font-weight:700\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a></p>\\n      <p class=\\\"muted\\\">Questions? Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or write <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></p>\\n    </section>\\n\\n    <footer>\\n      <small>Facilitated by {{FACILITATOR_NAME}} — {{VENUE_NAME}} — {{CITY}}, {{STATE}}</small>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--brown:#6b3f2a;--soft:#f7efe6;--gold:#d9b58b;--forest:#4b644b}\\n    body{margin:0;font-family:Georgia,serif;background:linear-gradient(180deg,var(--soft),#fff);color:var(--brown)}\\n    header{display:flex;justify-content:space-between;padding:18px 24px;border-bottom:1px solid rgba(107,63,42,0.06)}\\n    nav a{margin-left:14px;color:var(--forest);text-decoration:none;font-weight:600}\\n    main{max-width:900px;margin:30px auto;padding:20px}\\n    .intro{background:linear-gradient(90deg,rgba(107,63,42,0.03),transparent);padding:18px;border-radius:12px}\\n    h1{margin:0 0 6px}\\n    .flow{display:flex;gap:18px;margin-top:18px}\\n    .flow .step{flex:1;background:#fff;padding:14px;border-radius:10px;box-shadow:0 8px 20px rgba(80,60,45,0.06)}\\n    .what{margin-top:16px}\\n    .btn{display:inline-block;background:linear-gradient(90deg,var(--brown),#8a543b);color:white;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .form{margin-top:16px;background:#fff;padding:14px;border-radius:10px}\\n    label{display:block;margin-top:8px;font-weight:600}\\n    input,select,textarea{width:100%;padding:10px;margin-top:6px;border:1px solid #eee;border-radius:8px}\\n    .note{font-size:13px;color:#6d5a51;margin-top:10px}\\n    .pattern{position:absolute;left:0;top:0;width:220px;height:220px;opacity:0.07;pointer-events:none}\\n    footer{margin-top:26px;text-align:center;color:#8a7361}\\n    @media (max-width:800px){.flow{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div><strong>{{BUSINESS_NAME}}</strong></div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Next Events</a>\\n      <a href=\\\"faq.html\\\">FAQs</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 200 200\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden=\\\"true\\\">\\n    <defs>\\n      <linearGradient id=\\\"g3\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#d9b58b\\\" /><stop offset=\\\"1\\\" stop-color=\\\"#4b644b\\\" /></linearGradient>\\n      <pattern id=\\\"p3\\\" width=\\\"28\\\" height=\\\"28\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"28\\\" height=\\\"28\\\" fill=\\\"transparent\\\" />\\n        <path d=\\\"M0 14 L14 0 L28 14 L14 28 Z\\\" fill=\\\"url(#g3)\\\" opacity=\\\"0.06\\\" />\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p3)\\\" />\\n  </svg>\\n\\n  <main>\\n    <section class=\\\"intro\\\" id=\\\"hero\\\">\\n      <h1>Reserve your place</h1>\\n      <p style=\\\"margin:6px 0 0;color:#6d5a51\\\">Select a session and prepare with intention. We keep groups small to honor quiet and clarity.</p>\\n    </section>\\n\\n    <section class=\\\"flow\\\" id=\\\"pillars\\\">\\n      <div class=\\\"step\\\">\\n        <strong>Arrival</strong>\\n        <div class=\\\"note\\\">Check-in, settle your mat, and find your place. Soft lighting lets the body relax before sound begins.</div>\\n      </div>\\n      <div class=\\\"step\\\">\\n        <strong>Practice</strong>\\n        <div class=\\\"note\\\">Guided breathing → layered instruments (crystal bowls, chimes, bowed monocord) → field of sound.</div>\\n      </div>\\n      <div class=\\\"step\\\">\\n        <strong>Return</strong>\\n        <div class=\\\"note\\\">We close with silence and a brief grounding; time to journal or share quietly.</div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"what\\\" id=\\\"what_to_bring\\\">\\n      <h3 style=\\\"margin-bottom:8px;color:var(--brown)\\\">What to bring</h3>\\n      <ul style=\\\"color:#6d5a51\\\">\\n        <li>Yoga mat or thick blanket (cushion if preferred)</li>\\n        <li>Extra blanket — layering keeps you warm in stillness</li>\\n        <li>Water bottle and optional eye pillow</li>\\n        <li>Earplugs if you prefer a very muted field</li>\\n      </ul>\\n    </section>\\n\\n    <section class=\\\"form\\\" id=\\\"booking_form\\\">\\n      <h3 style=\\\"margin-top:0\\\">Book</h3>\\n      <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"get\\\">\\n        <label for=\\\"event\\\">Choose session</label>\\n        <select id=\\\"event\\\" name=\\\"event\\\">\\n          <option>Group Sound Bath — {{NEXT_EVENT_DATE}}</option>\\n          <option>Evening Series — Weeknight Series</option>\\n          <option>Private 1:1 — request a time</option>\\n        </select>\\n\\n        <label for=\\\"name\\\">Your name</label>\\n        <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"Full name\\\" required />\\n\\n        <label for=\\\"email\\\">Email</label>\\n        <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required />\\n\\n        <label for=\\\"notes\\\">Notes / accessibility needs</label>\\n        <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Let us know about mobility, sensitivity, or health notes.\\\"></textarea>\\n\\n        <p class=\\\"note\\\">A reminder: if you are pregnant, have cardiovascular implants, epilepsy, or recent cranial surgery, consult your provider and tell us before booking.</p>\\n\\n        <p style=\\\"margin-top:12px\\\"><button class=\\\"btn\\\" type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button></p>\\n      </form>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" id=\\\"myth_vs_truth\\\">\\n      <h4 style=\\\"margin:0 0 8px;color:var(--forest)\\\">A note on sound</h4>\\n      <p class=\\\"note\\\">We layer instruments such as gongs, tuning forks, and soft crystal bowls. Each event varies the palette so returning guests find new textures. The field is intentionally curated — loud moments are measured, and facilitators adapt to group needs.</p>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" id=\\\"cta\\\">\\n      <p class=\\\"note\\\">If you'd prefer private work — 1:1 sessions, couples, or corporate presence work — select the private option above or email us at <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</p>\\n      <p><a class=\\\"btn\\\" href=\\\"mailto:{{EMAIL}}?subject=Private%20Session%20Inquiry\\\">Private Sessions</a></p>\\n    </section>\\n\\n    <footer>\\n      <small>{{BUSINESS_NAME}} • {{VENUE_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></small>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
  ],
  "parallel_tool_calls": true,
  "presence_penalty": 0,
  "previous_response_id": null,
