          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#0f1720;--muted:#9aa8b4;--accent:#7dd3fc;--card:#071022;--glass:rgba(255,255,255,0.04);--radius:14px;font-family:Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial}\\n    *{box-sizing:border-box}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg, #071428 0%, #06101a 60%);color:#e6f0f6}\\n    .wrap{max-width:1100px;margin:36px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between;gap:18px}\\n    .brand{display:flex;align-items:center;gap:14px}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#6ee7b7);display:flex;align-items:center;justify-content:center;font-weight:700;color:#04202a}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:15px}\\n    nav a:hover{color:#fff}\\n\\n    /* Background SVG panel */\\n    .bg-svg{position:fixed;inset:0;z-index:0;opacity:0.12;pointer-events:none}\\n    .content{position:relative;z-index:2}\\n    .hero{display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:center;margin-top:22px}\\n    .panel{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));border-radius:var(--radius);padding:28px;box-shadow:0 6px 30px rgba(2,6,23,0.6);border:1px solid rgba(255,255,255,0.03)}\\n    h1{margin:0 0 8px 0;font-size:30px;letter-spacing:-0.4px}\\n    p.lead{color:var(--muted);margin:0 0 18px 0;line-height:1.6}\\n    .meta{font-size:14px;color:var(--muted);display:flex;gap:10px;align-items:center}\\n    .pill{padding:8px 12px;background:linear-gradient(90deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));border-radius:999px;border:1px solid rgba(255,255,255,0.02)}\\n\\n    /* Sections */\\n    section{margin-top:22px}\\n    .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.02)}\\n    h3{margin:0 0 8px 0}\\n    ul{margin:8px 0 0 18px;color:var(--muted)}\\n    .muted{color:var(--muted);font-size:14px}\\n    footer{margin-top:28px;padding:18px;border-radius:12px;background:linear-gradient(180deg, rgba(255,255,255,0.01), transparent);text-align:center;color:var(--muted);font-size:14px}\\n\\n    .cta{display:inline-block;margin-top:8px;padding:10px 16px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#6ee7b7);color:#04202a;font-weight:600;text-decoration:none}\\n\\n    .case-note{background:linear-gradient(90deg, rgba(125,211,252,0.06), rgba(110,231,183,0.03));padding:16px;border-radius:12px;border:1px solid rgba(125,211,252,0.06)}\\n\\n    /* small screens */\\n    @media (max-width:880px){.hero{grid-template-columns:1fr;}.grid-3{grid-template-columns:1fr}.brand{gap:10px}.logo{width:48px;height:48px}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"bg-svg\\\" width=\\\"100%\\\" height=\\\"100%\\\" viewBox=\\\"0 0 1200 800\\\" preserveAspectRatio=\\\"xMidYMid slice\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#0ea5e9\\\" stop-opacity=\\\"0.18\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#34d399\\\" stop-opacity=\\\"0.08\\\"/>\\n      </linearGradient>\\n      <filter id=\\\"blur\\\"><feGaussianBlur stdDeviation=\\\"30\\\"/></filter>\\n    </defs>\\n    <g filter=\\\"url(#blur)\\\">\\n      <circle cx=\\\"160\\\" cy=\\\"120\\\" r=\\\"180\\\" fill=\\\"url(#g1)\\\"/>\\n      <circle cx=\\\"980\\\" cy=\\\"640\\\" r=\\\"240\\\" fill=\\\"#0ea5e9\\\" fill-opacity=\\\"0.05\\\"/>\\n      <g fill-opacity=\\\"0.06\\\" fill=\\\"#fff\\\">\\n        <rect x=\\\"300\\\" y=\\\"400\\\" width=\\\"700\\\" height=\\\"12\\\" rx=\\\"6\\\" transform=\\\"rotate(-12 650 406)\\\"/>\\n        <rect x=\\\"20\\\" y=\\\"600\\\" width=\\\"420\\\" height=\\\"10\\\" rx=\\\"5\\\" transform=\\\"rotate(8 230 605)\\\"/>\\n      </g>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"wrap content\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">SB</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Intentionally crafted sound experiences</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Gatherings</a>\\n        <a href=\\\"private-sessions.html\\\">Private</a>\\n        <a href=\\\"pricing.html\\\">Rates</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"hero\\\">\\n      <div class=\\\"panel\\\">\\n        <h1>About our sound practice</h1>\\n        <p class=\\\"lead\\\">At {{BUSINESS_NAME}} we blend acoustic precision with embodied rest—an invitation to settle into the felt textures of sound and breath. Our approach is clinical yet warm: we design sessions that are safe, accessible, and deeply resonant.</p>\\n        <div class=\\\"meta\\\">\\n          <div class=\\\"pill\\\">Facilitator: {{FACILITATOR_NAME}}</div>\\n          <div class=\\\"pill\\\">City: {{CITY}}, {{STATE}}</div>\\n        </div>\\n\\n        <section style=\\\"margin-top:18px\\\">\\n          <h3>How a session supports you</h3>\\n          <p class=\\\"muted\\\">We combine intentional resonance, paced breathwork cues, and post-session integration to help nervous system regulation, improved sleep, and clarity.</p>\\n        </section>\\n\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <h3>Quick facts</h3>\\n          <div style=\\\"display:flex;flex-direction:column;gap:8px;margin-top:10px\\\">\\n            <div class=\\\"pill\\\">Session formats: Group • 1:1 • Corporate</div>\\n            <div class=\\\"pill\\\">Typical length: 60 — 90 minutes</div>\\n            <div class=\\\"pill\\\">Venue: {{VENUE_NAME}}</div>\\n          </div>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section>\\n      <h3>Foundational pillars</h3>\\n      <div class=\\\"grid-3\\\">\\n        <div class=\\\"card\\\">\\n          <h4>Precision</h4>\\n          <p class=\\\"muted\\\">Sound is tuned, instruments are cleansed, and transitions are mapped so the journey is intentional not accidental.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h4>Safety</h4>\\n          <p class=\\\"muted\\\">Clinical intake and contraindication screening ensure sessions are supportive for neurodiverse and medically complex participants.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <h4>Integration</h4>\\n          <p class=\\\"muted\\\">We include grounding cues and simple tools to bring the benefits into daily life after the sound journey.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h3>Case notes & outcomes</h3>\\n      <div class=\\\"case-note\\\">\\n        <strong>Note:</strong> A 6-week cohort reported lowered nocturnal awakenings and improved subjective sleep quality. Participants described increased somatic ease following sessions that combined crystal bowls and tuning forks with guided body awareness.\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h3>Common myths vs. measured truth</h3>\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:12px\\\">\\n        <div class=\\\"card\\\">\\n          <strong>Myth</strong>\\n          <p class=\\\"muted\\\">Sound baths are passive — you just lie there and hope for magic.</p>\\n        </div>\\n        <div class=\\\"card\\\">\\n          <strong>Truth</strong>\\n          <p class=\\\"muted\\\">Sessions are guided somatic experiences: breath, orientation, and sensory anchors are woven with sound to create measurable shifts.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <h3>Logistics — what to bring</h3>\\n      <ul>\\n        <li>Yoga mat or crossover mat</li>\\n        <li>Blanket and 1–2 pillows for support</li>\\n        <li>Eye-covering (sleep mask) if desired</li>\\n        <li>Bottle of water and light socks</li>\\n      </ul>\\n      <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Contraindications: If you have a history of severe psychiatric episodes, uncontrolled epilepsy, or are in the first trimester of pregnancy, please consult your physician and contact us at {{EMAIL}} before booking.</p>\\n    </section>\\n\\n    <section>\\n      <h3>Session flow (typical)</h3>\\n      <ol class=\\\"muted\\\">\\n        <li>Arrival & intake (15 min): orientation and safety check.</li>\\n        <li>Grounding (10 min): breathwork and somatic scanning.</li>\\n        <li>Sound journey (35–45 min): layers of crystal bowls, chimes, and tuning forks that map to breath and body cues.</li>\\n        <li>Integration (10–15 min): gentle return, water, and journaling prompts.</li>\\n      </ol>\\n    </section>\\n\\n    <section>\\n      <h3>Still have questions?</h3>\\n      <p class=\\\"muted\\\">Call us at <strong>{{PHONE}}</strong> or email <strong>{{EMAIL}}</strong>. For bookings, proceed to the reservation page.</p>\\n      <a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve a session</a>\\n    </section>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} — {{TAGLINE}} • Facilitator: {{FACILITATOR_NAME}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>FAQ — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#04121a;--muted:#9fb3bd;--accent:#82e9d8;--card:#071726;font-family:Inter,system-ui,Segoe UI,Roboto}\\n    body{margin:0;background:radial-gradient(1200px 600px at 10% 10%, rgba(130,233,216,0.06), transparent), linear-gradient(180deg,#04202a 0%, #031521 100%);color:#e9fbfb}\\n    .container{max-width:980px;margin:32px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .logo{font-weight:700;padding:8px 12px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#60f2c9);color:#012226}\\n    nav a{margin-left:16px;color:var(--muted);text-decoration:none}\\n    h1{margin:18px 0 4px}\\n    p.lead{color:var(--muted);margin-top:0}\\n    .faq-list{margin-top:18px;display:grid;gap:12px}\\n    .qa{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));padding:16px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .q{font-weight:600}\\n    .a{color:var(--muted);margin-top:8px}\\n    .small{font-size:13px;color:#98b8bd}\\n    .cta{display:inline-block;margin-top:14px;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,#7dd3fc,#60f2c9);color:#03313a;text-decoration:none;font-weight:700}\\n    .note{margin-top:12px;color:#a8d7d0}\\n    footer{margin-top:30px;color:var(--muted);font-size:13px}\\n\\n    /* pattern svg */\\n    .svg-wrap{position:fixed;right:0;top:0;transform:translate(14%, -6%);opacity:0.08;pointer-events:none}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"svg-wrap\\\" aria-hidden>\\n    <svg width=\\\"420\\\" height=\\\"420\\\" viewBox=\\\"0 0 420 420\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"fg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#7dd3fc\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#60f2c9\\\"/></linearGradient>\\n      </defs>\\n      <g fill=\\\"url(#fg)\\\">\\n        <circle cx=\\\"60\\\" cy=\\\"60\\\" r=\\\"80\\\"/>\\n        <rect x=\\\"220\\\" y=\\\"200\\\" width=\\\"150\\\" height=\\\"16\\\" rx=\\\"8\\\"/>\\n        <circle cx=\\\"330\\\" cy=\\\"320\\\" r=\\\"60\\\"/>\\n      </g>\\n    </svg>\\n  </div>\\n\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n        <div class=\\\"logo\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"color:var(--muted)\\\">Trusted sound + guided practice</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"events.html\\\">Events</a>\\n        <a href=\\\"private-sessions.html\\\">Sessions</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <h1>Frequently asked — clear answers</h1>\\n      <p class=\\\"lead\\\">Below are concise, practical answers to common questions about our sound baths and private sessions.</p>\\n\\n      <div class=\\\"faq-list\\\">\\n        <div class=\\\"qa\\\">\\n          <div class=\\\"q\\\">What instruments are used and how are they chosen?</div>\\n          <div class=\\\"a\\\">We select instruments to support a spectrum of vibrations: Himalayan crystal bowls, gong for low-frequency swells, and Koshi chimes for delicate high overtones. Instrument choices are intentional and vary by session theme.</div>\\n        </div>\\n\\n        <div class=\\\"qa\\\">\\n          <div class=\\\"q\\\">How should I prepare? What to bring?</div>\\n          <div class=\\\"a\\\">Bring a mat, a warm blanket, additional bolsters or pillows for comfort, and an eye covering if you prefer. Avoid heavy meals immediately beforehand. Hydrate lightly.</div>\\n        </div>\\n\\n        <div class=\\\"qa\\\">\\n          <div class=\\\"q\\\">Who should avoid sound baths?</div>\\n          <div class=\\\"a\\\">Contraindications include recent traumatic episodes, uncontrolled seizures, and some implants sensitive to vibration. If pregnant (first trimester especially), or if you have cardiovascular concerns, please consult your healthcare provider and contact us before booking: {{EMAIL}}.</div>\\n        </div>\\n\\n        <div class=\\\"qa\\\">\\n          <div class=\\\"q\\\">What happens during a group session?</div>\\n          <div class=\\\"a\\\">Flow: brief intake → guided settling with breathwork → layered sound journey using tuning forks, monophonic drones, and bowls → gentle reorientation and integration. Expect to be guided throughout; you are never left without cues.</div>\\n        </div>\\n\\n        <div class=\\\"qa\\\">\\n          <div class=\\\"q\\\">Are sessions therapeutic or medical treatment?</div>\\n          <div class=\\\"a\\\">Our work is somatic and wellness-oriented; it is not a substitute for medical or psychiatric treatment. We offer supportive practices that may complement care but do not diagnose or treat medical conditions.</div>\\n        </div>\\n\\n        <div class=\\\"qa\\\">\\n          <div class=\\\"q\\\">Can I book a private or corporate offering?</div>\\n          <div class=\\\"a\\\">Yes. We provide 1:1 therapeutic-style sessions, couples sound baths, and tailored corporate resilience workshops. See private-sessions.html for formats and corporate packages.</div>\\n        </div>\\n\\n        <div class=\\\"qa\\\">\\n          <div class=\\\"q\\\">How do you ensure safety for neurodiverse participants?</div>\\n          <div class=\\\"a\\\">We include pre-session intake, adjustable volume levels, and offer quiet corners. Facilitators are trained to provide predictable structure and clear cues for transitions.</div>\\n        </div>\\n      </div>\\n\\n      <div style=\\\"margin-top:18px;padding:14px;border-radius:12px;background:linear-gradient(90deg, rgba(130,233,216,0.03), rgba(125,211,252,0.02));border:1px solid rgba(130,233,216,0.04)\\\">\\n        <div class=\\\"small\\\">Still not sure? Call <strong>{{PHONE}}</strong> or book a short consult via the reservation page. For next events, check events.html — upcoming: {{NEXT_EVENT_DATE}}.</div>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Book a consult</a>\\n      </div>\\n\\n      <section style=\\\"margin-top:20px\\\">\\n        <h2 style=\\\"margin:0 0 8px 0\\\">Short intake checklist</h2>\\n        <ul class=\\\"small\\\">\\n          <li>Medications that lower seizure threshold (disclose on intake).</li>\\n          <li>Recent head injury or concussion — inform facilitator.</li>\\n          <li>Photophobia or sensitivity to vibrations — we can accommodate reduced intensity.</li>\\n        </ul>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div class=\\\"small\\\">{{BUSINESS_NAME}} • {{TAGLINE}} • Email: {{EMAIL}} • {Facilities: {{VENUE_NAME}}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Reserve — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#021018;--muted:#a6c7c3;--accent1:#8be5ff;--accent2:#7af5d1;font-family:Inter,system-ui,Segoe UI,Roboto}\\n    body{margin:0;background:linear-gradient(180deg,#021018 0%, #071a1c 70%);color:#eaffff}\\n    .page{max-width:920px;margin:30px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .brand{font-weight:800}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    main{display:grid;grid-template-columns:1fr 360px;gap:18px;margin-top:18px}\\n    .panel{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    label{display:block;font-size:13px;margin-top:12px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:rgba(255,255,255,0.01);color:#e8fbfb}\\n    .btn{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,var(--accent1),var(--accent2));color:#042022;font-weight:700;text-decoration:none}\\n    .note{color:var(--muted);font-size:13px;margin-top:8px}\\n    .instruments{display:flex;flex-direction:column;gap:8px;margin-top:10px}\\n    .instr{padding:10px;border-radius:8px;background:rgba(255,255,255,0.01);border:1px solid rgba(255,255,255,0.02)}\\n    .small{font-size:13px;color:var(--muted)}\\n    .svg-bg{position:fixed;left:0;bottom:0;opacity:0.08;pointer-events:none}\\n\\n    @media (max-width:980px){main{grid-template-columns:1fr}.svg-bg{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"svg-bg\\\" width=\\\"360\\\" height=\\\"360\\\" viewBox=\\\"0 0 360 360\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"bgG\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#8be5ff\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#7af5d1\\\"/></linearGradient>\\n      <filter id=\\\"gblur\\\"><feGaussianBlur stdDeviation=\\\"24\\\"/></filter>\\n    </defs>\\n    <g filter=\\\"url(#gblur)\\\">\\n      <ellipse cx=\\\"90\\\" cy=\\\"260\\\" rx=\\\"160\\\" ry=\\\"60\\\" fill=\\\"url(#bgG)\\\"/>\\n      <circle cx=\\\"240\\\" cy=\\\"80\\\" r=\\\"90\\\" fill=\\\"#8be5ff\\\" fill-opacity=\\\"0.06\\\"/>\\n    </g>\\n  </svg>\\n\\n  <div class=\\\"page\\\">\\n    <header>\\n      <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Upcoming</a>\\n        <a href=\\\"faq.html\\\">FAQ</a>\\n        <a href=\\\"contact.html\\\">Reach</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"panel\\\">\\n        <h2>Reserve your place</h2>\\n        <p class=\\\"note\\\">Select your format and preferred time. For special accommodations, call {{PHONE}} or email {{EMAIL}}.</p>\\n\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" style=\\\"margin-top:10px\\\">\\n          <label for=\\\"format\\\">Format</label>\\n          <select id=\\\"format\\\" name=\\\"format\\\">\\n            <option>Group sound bath (60–75 min)</option>\\n            <option>1:1 therapeutic session (60 min)</option>\\n            <option>Couples session (75 min)</option>\\n            <option>Corporate well-being workshop (custom)</option>\\n          </select>\\n\\n          <label for=\\\"date\\\">Preferred date</label>\\n          <input id=\\\"date\\\" name=\\\"date\\\" type=\\\"date\\\" placeholder=\\\"YYYY-MM-DD\\\">\\n\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" required>\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required>\\n\\n          <label for=\\\"notes\\\">Notes / contraindications</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Please tell us about medications, seizures, pregnancy, implants, or recent major health events.\\\"></textarea>\\n\\n          <div style=\\\"display:flex;gap:10px;align-items:center;margin-top:12px\\\">\\n            <input type=\\\"checkbox\\\" id=\\\"agree\\\" name=\\\"agree\\\" required>\\n            <label for=\\\"agree\\\" class=\\\"small\\\">I acknowledge the contraindications and agree to contact {{EMAIL}} with questions.</label>\\n          </div>\\n\\n          <button class=\\\"btn\\\" type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n        </form>\\n\\n        <div style=\\\"margin-top:14px\\\" class=\\\"small\\\">\\n          For corporate or multi-session bookings email <strong>{{EMAIL}}</strong> or call <strong>{{PHONE}}</strong>. Turnaround for confirmations: 24–48 hours.\\n        </div>\\n      </section>\\n\\n      <aside class=\\\"panel\\\">\\n        <h3>Practice & what to expect</h3>\\n        <p class=\\\"small\\\">Sessions are curated sensory journeys focused on nervous system regulation. Expect a clear progression and opportunities to opt-out at any moment.</p>\\n\\n        <h4 style=\\\"margin-top:12px\\\">Featured instruments</h4>\\n        <div class=\\\"instruments\\\">\\n          <div class=\\\"instr\\\">Monochord — sustained drone and sympathetic resonance.</div>\\n          <div class=\\\"instr\\\">Gong — low frequency waves and long decay.</div>\\n          <div class=\\\"instr\\\">Crystal singing bowls — harmonically rich overtone fields.</div>\\n          <div class=\\\"instr\\\">Tuning forks — targeted entrainment points.</div>\\n        </div>\\n\\n        <h4 style=\\\"margin-top:12px\\\">Flow snapshot</h4>\\n        <ol class=\\\"small\\\">\\n          <li>Arrival & short intake (10–15 min)</li>\\n          <li>Guided settling: breath + posture (8–10 min)</li>\\n          <li>Sound fabric: 30–45 min</li>\\n          <li>Return + suggestions for integration (10 min)</li>\\n        </ol>\\n\\n        <div style=\\\"margin-top:12px;padding:10px;border-radius:10px;background:rgba(255,255,255,0.01);border:1px solid rgba(255,255,255,0.02)\\\" class=\\\"small\\\">\\n          Contraindications: seizures, recent untreated trauma, and certain implants — please disclose in the notes field or contact us prior to booking.\\n        </div>\\n\\n      </aside>\\n    </main>\\n\\n    <footer style=\\\"margin-top:18px;text-align:center;color:var(--muted)\\\">\\n      <div>{{BUSINESS_NAME}} • {{TAGLINE}} • {{VENUE_NAME}} • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
