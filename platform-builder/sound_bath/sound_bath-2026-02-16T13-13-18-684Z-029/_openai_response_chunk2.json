          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<title>Gatherings — {{BUSINESS_NAME}}</title>\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n<style>\\n:root{--bg:#0f1720;--card:#0b1220;--accent:#b79cff;--muted:#9aa4b2;--glass:rgba(255,255,255,0.04)}\\n*{box-sizing:border-box}\\nhtml,body{height:100%}\\nbody{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:#e6eef8;background:linear-gradient(180deg,#071018 0%,#08131b 60%);-webkit-font-smoothing:antialiased}\\n.header{display:flex;justify-content:space-between;align-items:center;padding:20px 32px}\\n.brand{display:flex;align-items:center;gap:12px}\\n.brand .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#2b1a4b,#0c2b3a);display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n.nav{display:flex;gap:18px}\\n.nav a{color:rgba(230,238,248,0.86);text-decoration:none;padding:8px 10px;border-radius:8px;font-size:15px}\\n.nav a:hover{background:rgba(255,255,255,0.03)}\\n.container{max-width:1100px;margin:28px auto;padding:28px;border-radius:14px;background:linear-gradient(180deg, rgba(255,255,255,0.02), transparent);box-shadow:0 8px 30px rgba(2,6,23,0.6)}\\n.hero{display:grid;grid-template-columns:1fr 360px;gap:24px;align-items:center}\\n.hero .intro{padding:28px}\\n.kicker{color:var(--accent);font-weight:600;letter-spacing:0.6px}\\n.h1{font-size:34px;color:#fff;margin:8px 0 12px}\\n.lead{color:var(--muted);line-height:1.6}\\n.card{background:var(--card);padding:18px;border-radius:12px;color:#dbe9ff}\\n.next-box{display:flex;flex-direction:column;gap:10px}\\n.next-box .date{font-weight:700;font-size:18px}\\n.small{color:var(--muted);font-size:13px}\\n.calendar{margin-top:14px}\\n.calendar ul{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:10px}\\n.calendar li{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:10px;border-radius:8px}\\n.section{margin-top:20px}\\n.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px}\\n.flow .step{background:var(--glass);padding:12px;border-radius:10px;color:#eaf4ff}\\n.cta{display:inline-block;margin-top:12px;background:linear-gradient(90deg,var(--accent),#7bd3ff);color:#041022;padding:12px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n.footer{margin-top:22px;padding:18px;border-top:1px solid rgba(255,255,255,0.03);display:flex;justify-content:space-between;align-items:center}\\n.fineprint{font-size:13px;color:var(--muted)}\\n/* decorative SVG background */\\n.bg-svg{position:fixed;right:-120px;top:-80px;opacity:0.12;width:600px;height:600px;pointer-events:none}\\n@media(max-width:880px){.hero{grid-template-columns:1fr;}.calendar ul{grid-template-columns:1fr}.bg-svg{display:none}}\\n</style>\\n</head>\\n<body>\\n<header class=\\\"header\\\">\\n<div class=\\\"brand\\\"><div class=\\\"logo\\\">SB</div><div style=\\\"color:#e6eef8;font-weight:700\\\">{{BUSINESS_NAME}}</div></div>\\n<nav class=\\\"nav\\\">\\n<a href=\\\"index.html\\\">Home</a>\\n<a href=\\\"events.html\\\" style=\\\"background:rgba(255,255,255,0.03);border-radius:8px\\\">Gatherings</a>\\n<a href=\\\"private-sessions.html\\\">Private</a>\\n<a href=\\\"pricing.html\\\">Pricing</a>\\n<a href=\\\"about.html\\\">About</a>\\n<a href=\\\"contact.html\\\">Connect</a>\\n</nav>\\n</header>\\n<svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 600 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n<defs>\\n<linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#9b7cff\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#7bd3ff\\\"/></linearGradient>\\n</defs>\\n<g transform=\\\"rotate(25 300 300)\\\"><rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"600\\\" height=\\\"600\\\" rx=\\\"40\\\" fill=\\\"url(#g1)\\\"/></g>\\n<g fill=\\\"rgba(255,255,255,0.05)\\\">\\n<circle cx=\\\"120\\\" cy=\\\"120\\\" r=\\\"40\\\"/>\\n<circle cx=\\\"200\\\" cy=\\\"80\\\" r=\\\"24\\\"/>\\n</g>\\n</svg>\\n<main class=\\\"container\\\">\\n<section class=\\\"hero\\\">\\n<div class=\\\"intro\\\">\\n<div class=\\\"kicker\\\">Immersive gatherings</div>\\n<h1 class=\\\"h1\\\">Evening sound baths — a premium communal reset</h1>\\n<p class=\\\"lead\\\">Join a curated group session where layered resonance restores clarity. We use crystal bowls, gentle chimes and tuning forks to sculpt a sound field that supports deep rest and subtle nervous system regulation.</p>\\n<a class=\\\"cta\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n</div>\\n<aside class=\\\"card next-box\\\">\\n<div class=\\\"small\\\">Next event</div>\\n<div class=\\\"date\\\">{{NEXT_EVENT_DATE}}</div>\\n<div class=\\\"small\\\">Venue: {{VENUE_NAME}} — {{CITY}}, {{STATE}}</div>\\n<div class=\\\"calendar\\\">\\n<div class=\\\"small\\\">Upcoming calendar</div>\\n<ul>\\n<li><strong>Mar 6</strong> — Sound Bath + Tea</li>\\n<li><strong>Mar 20</strong> — New Moon Gathering</li>\\n<li><strong>Apr 3</strong> — Silence + Sound</li>\\n<li><strong>Apr 17</strong> — Deep Release</li>\\n</ul>\\n</div>\\n</aside>\\n</section>\\n<section class=\\\"section flow\\\">\\n<h2 style=\\\"color:#fff;margin:0 0 10px\\\">The evening flow</h2>\\n<div class=\\\"grid-2\\\">\\n<div class=\\\"card\\\">\\n<div class=\\\"step\\\"><strong>Arrival (15 min)</strong> — settle in, choose your blanket and bolster. We offer a short breathing cue to land in the body.</div>\\n<div class=\\\"step\\\" style=\\\"margin-top:8px\\\"><strong>Sound immersion (45–55 min)</strong> — layered bowls and tuning forks weave slow textures. Volume and dynamics are intentionally gentle, intentionally expansive.</div>\\n</div>\\n<div class=\\\"card\\\">\\n<div class=\\\"step\\\"><strong>Integration (10–15 min)</strong> — we close with soft chimes, a few grounding tones, and time for tea and reflection.</div>\\n<div class=\\\"step\\\" style=\\\"margin-top:8px\\\"><strong>Departure</strong> — facilitators will offer brief aftercare and optional one-on-one notes.</div>\\n</div>\\n</div>\\n</section>\\n<section class=\\\"section\\\">\\n<h3 style=\\\"color:#fff\\\">What to bring</h3>\\n<div class=\\\"card small\\\">Comfort is central: bring a yoga mat or blanket, a pillow or bolster, a light blanket for covering, and a water bottle. We provide mats/props on request for a premium experience.</div>\\n</section>\\n<section class=\\\"section\\\">\\n<h3 style=\\\"color:#fff\\\">Contraindications & safety</h3>\\n<div class=\\\"card small\\\">Sound baths are gentle but can be intense for people with seizure disorders, certain heart devices, or extreme sensitivity to sound. If you are pregnant, have a recent surgery, epilepsy, or use a pacemaker/ICD, consult your healthcare provider first. Please notify the facilitator upon arrival.</div>\\n</section>\\n<section class=\\\"section\\\">\\n<h3 style=\\\"color:#fff\\\">Quick FAQs</h3>\\n<div class=\\\"card small\\\">\\n<strong>How early should I arrive?</strong> Arrive 15–20 minutes early to settle.\\n<br/><br/>\\n<strong>Is it meditation?</strong> It's a somatic sound experience — not guided meditation, though it often supports meditative states.\\n</div>\\n</section>\\n<footer class=\\\"footer\\\">\\n<div class=\\\"fineprint\\\">Questions? Call {{PHONE}} or email {{EMAIL}}</div>\\n<a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve a spot</a>\\n</footer>\\n</main>\\n</body>\\n</html>\"} \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<title>Private Sessions — {{BUSINESS_NAME}}</title>\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n<style>\\n:root{--bg:#08121a;--panel:#071421;--gold:#ffd6a6;--muted:#b7c4d7}\\n*{box-sizing:border-box}\\nbody{margin:0;font-family:Segoe UI, Roboto, 'Helvetica Neue', Arial;background:linear-gradient(180deg,#07121a,#021018);color:#eaf4ff}\\n.header{display:flex;justify-content:space-between;align-items:center;padding:18px 26px}\\n.brand{font-weight:700}\\nnav a{margin-left:14px;color:rgba(234,244,255,0.9);text-decoration:none}\\n.wrap{max-width:980px;margin:24px auto;padding:22px}\\n.hero{padding:22px;border-radius:12px;background:radial-gradient(800px 200px at 10% 10%, rgba(255,214,166,0.06), transparent), linear-gradient(180deg, rgba(255,255,255,0.02), transparent)}\\n.h1{font-size:30px;margin:0 0 8px}\\n.lead{color:var(--muted)}\\n.types{display:flex;gap:12px;margin-top:18px}\\n.type{flex:1;background:var(--panel);padding:14px;border-radius:10px}\\n.type h4{margin:0 0 8px}\\n.small{color:var(--muted);font-size:14px}\\n.note{margin-top:12px;padding:12px;border-radius:8px;background:rgba(255,255,255,0.02)}\\n.instruments{display:flex;gap:10px;margin-top:12px}\\n.instrument{flex:1;padding:10px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);border-radius:8px}\\n.fine{font-size:13px;color:var(--muted);margin-top:16px}\\n.cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:8px;background:linear-gradient(90deg,#ffd6a6,#c4a7ff);color:#041321;font-weight:700;text-decoration:none}\\n.footer{margin-top:20px;padding-top:18px;border-top:1px solid rgba(255,255,255,0.03);display:flex;justify-content:space-between}\\n/* decorative pattern inline */\\n.pattern{position:fixed;left:-100px;bottom:-80px;opacity:0.08;width:480px;height:480px}\\n@media(max-width:820px){.types{flex-direction:column}}\\n</style>\\n</head>\\n<body>\\n<header class=\\\"header\\\">\\n<div class=\\\"brand\\\">{{BUSINESS_NAME}} — Private</div>\\n<nav>\\n<a href=\\\"index.html\\\">Studio</a>\\n<a href=\\\"private-sessions.html\\\" style=\\\"text-decoration:underline\\\">Sessions</a>\\n<a href=\\\"pricing.html\\\">Rates</a>\\n<a href=\\\"faq.html\\\">FAQ</a>\\n<a href=\\\"contact.html\\\">Contact</a>\\n</nav>\\n</header>\\n<svg class=\\\"pattern\\\" viewBox=\\\"0 0 480 480\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n<defs><linearGradient id=\\\"pg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#ffd6a6\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#c4a7ff\\\"/></linearGradient></defs>\\n<g fill=\\\"url(#pg)\\\">\\n<rect x=\\\"40\\\" y=\\\"40\\\" width=\\\"120\\\" height=\\\"120\\\" rx=\\\"12\\\"/>\\n<rect x=\\\"200\\\" y=\\\"100\\\" width=\\\"200\\\" height=\\\"80\\\" rx=\\\"10\\\"/>\\n</g>\\n</svg>\\n<main class=\\\"wrap\\\">\\n<section class=\\\"hero\\\">\\n<h1 class=\\\"h1\\\">Private sound sessions — tailored resonance</h1>\\n<p class=\\\"lead\\\">One-on-one attention or intimate shared sessions designed to address nervous system tone, relaxation, and focused restoration. Sessions are held in our quiet studio or can be offered at your chosen location for corporate or special events.</p>\\n</section>\\n<section class=\\\"section types\\\">\\n<div class=\\\"type\\\">\\n<h4>1:1 deep session</h4>\\n<div class=\\\"small\\\">60–90 minutes. A personalized sequence to meet your current needs — restorative, restorative-with-tonework, or integrative coaching add-on.</div>\\n<div class=\\\"note\\\"><strong>Typical instruments:</strong> gong, monochord, subtle voice layers.</div>\\n</div>\\n<div class=\\\"type\\\">\\n<h4>Couples & small groups</h4>\\n<div class=\\\"small\\\">Shared sessions for partners or friends. Adjusted sequencing to hold relational field and safety.</div>\\n<div class=\\\"note\\\"><strong>Typical instruments:</strong> harp-like monochord, soft bowls, hand chimes.</div>\\n</div>\\n<div class=\\\"type\\\">\\n<h4>Corporate & events</h4>\\n<div class=\\\"small\\\">Larger room sessions or sound lounges for retreats and offsite experiences. We build a sensory brief to match tone and timing.</div>\\n<div class=\\\"note\\\"><strong>Typical instruments:</strong> standing gongs, bowed bowls, warm drone elements.</div>\\n</div>\\n</section>\\n<section class=\\\"section\\\">\\n<h3 style=\\\"margin:16px 0 8px\\\">Session flow</h3>\\n<div class=\\\"card\\\" style=\\\"padding:12px;background:rgba(255,255,255,0.02);border-radius:10px\\\">\\n<p class=\\\"small\\\">A private session usually follows: arrival & intention (5–10 min), short intake, tuned soundwork (40–70 min) using specific instruments to meet your nervous system, closing tones and practical integration, and a brief debrief.</p>\\n</div>\\n</section>\\n<section class=\\\"section\\\">\\n<h3 style=\\\"margin:16px 0 8px\\\">What to bring & accessibility</h3>\\n<div class=\\\"card\\\" style=\\\"padding:12px;background:rgba(255,255,255,0.02);border-radius:10px\\\">\\n<p class=\\\"small\\\">Bring a blanket, pillow, water, and anything that makes you comfortable. If you have mobility needs or require floor to chair adjustments, tell us when booking and we will prepare the space.</p>\\n</div>\\n</section>\\n<section class=\\\"section\\\">\\n<h3 style=\\\"margin:16px 0 8px\\\">Contraindications</h3>\\n<div class=\\\"small\\\">Private sessions can be more intense. Please disclose pregnancies, seizures, recent surgeries, or implanted devices (pacemakers/ICDs). We may adapt or decline certain modalities for safety.</div>\\n</section>\\n<section class=\\\"section instruments\\\">\\n<div class=\\\"instrument\\\">\\n<strong>Why these instruments?</strong>\\n<p class=\\\"small\\\">We select tools to sculpt vibration: the gong for broad-spectrum waves, monochord for long, harmonic sustains, and gentle vocal harmonics to anchor presence.</p>\\n</div>\\n<div class=\\\"instrument\\\">\\n<strong>Customization</strong>\\n<p class=\\\"small\\\">Each session is curated: louder or softer, short-form or long-form according to your current nervous system cues.</p>\\n</div>\\n</section>\\n<section class=\\\"section\\\">\\n<h3 style=\\\"margin:16px 0 8px\\\">Book a private day</h3>\\n<p class=\\\"small\\\">Most clients book a VIP day for extended integration; in-studio or off-site options available. Facilitator: {{FACILITATOR_NAME}}.</p>\\n<a class=\\\"cta\\\" href=\\\"book.html\\\">Request a private</a>\\n<div class=\\\"fine\\\">Questions? Email {{EMAIL}} or phone {{PHONE}}</div>\\n</section>\\n<footer class=\\\"footer\\\">\\n<div class=\\\"small\\\">Located at {{VENUE_NAME}}, {{CITY}}, {{STATE}}</div>\\n<div class=\\\"small\\\">Need details before booking? See <a href=\\\"faq.html\\\" style=\\\"color:#ffd6a6;text-decoration:none\\\">FAQ</a></div>\\n</footer>\\n</main>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<title>Rates & Packages — {{BUSINESS_NAME}}</title>\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n<style>\\n:root{--bg:#041018;--card:#061621;--accent:#7ad3ff;--muted:#9fb0c6}\\nbody{margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto;background:linear-gradient(180deg,#021018,#041018);color:#e7f5ff}\\n.header{display:flex;justify-content:space-between;align-items:center;padding:18px 26px}\\n.header a{color:#e7f5ff;text-decoration:none;margin-left:12px}\\n.container{max-width:1000px;margin:26px auto;padding:22px}\\n.hero{padding:18px;border-radius:12px;background:linear-gradient(90deg,rgba(122,211,255,0.04),transparent)}\\n.h1{font-size:28px;margin:0 0 8px}\\n.grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:16px}\\n.tier{background:var(--card);padding:16px;border-radius:10px}\\n.tier h3{margin:0 0 6px}\\n.price{font-size:22px;margin:6px 0;color:var(--accent)}\\n.small{color:var(--muted)}\\n.list{margin-top:12px}\\n.cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,#7ad3ff,#b19aff);color:#02101a;font-weight:700;text-decoration:none}\\n.note{margin-top:14px;padding:12px;border-radius:8px;background:rgba(255,255,255,0.02);color:var(--muted)}\\n.footer{margin-top:20px;padding-top:18px;border-top:1px solid rgba(255,255,255,0.03);display:flex;justify-content:space-between}\\n@media(max-width:900px){.grid{grid-template-columns:1fr}}\\n</style>\\n</head>\\n<body>\\n<header class=\\\"header\\\">\\n<div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}} — Rates</div>\\n<nav><a href=\\\"events.html\\\">Back to Gatherings</a><a href=\\\"private-sessions.html\\\">Private</a><a href=\\\"book.html\\\">Book</a></nav>\\n</header>\\n<main class=\\\"container\\\">\\n<section class=\\\"hero\\\">\\n<h1 class=\\\"h1\\\">Transparent rates for deliberate rest</h1>\\n<p class=\\\"small\\\">Choose from single drop-ins, curated passes, or bespoke private work. Pricing reflects thoughtful facilitation, premium props, and small-group capacity.</p>\\n</section>\\n<section class=\\\"grid\\\">\\n<div class=\\\"tier\\\">\\n<h3>Drop-in</h3>\\n<div class=\\\"price\\\">$38</div>\\n<div class=\\\"small\\\">Per person for a scheduled group sound bath</div>\\n<div class=\\\"list small\\\">\\n• Access to mats/props on request\\n<br/>• Tea + optional debrief\\n</div>\\n<a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve</a>\\n</div>\\n<div class=\\\"tier\\\">\\n<h3>Pass — 5 classes</h3>\\n<div class=\\\"price\\\">$170</div>\\n<div class=\\\"small\\\">Save on regular practice; transferable within close circle.</div>\\n<div class=\\\"list small\\\">\\n• Priority booking\\n<br/>• Guest credit for one visit\\n</div>\\n<a class=\\\"cta\\\" href=\\\"book.html\\\">Purchase</a>\\n</div>\\n<div class=\\\"tier\\\">\\n<h3>Private 60 min</h3>\\n<div class=\\\"price\\\">$160</div>\\n<div class=\\\"small\\\">In-studio one-on-one session</div>\\n<div class=\\\"list small\\\">\\n• Tailored instrument selection\\n<br/>• Post-session notes\\n</div>\\n<a class=\\\"cta\\\" href=\\\"book.html\\\">Inquire</a>\\n</div>\\n</section>\\n<section class=\\\"section\\\" style=\\\"margin-top:18px\\\">\\n<h3 style=\\\"margin:0 0 8px\\\">Corporate & Event pricing</h3>\\n<div class=\\\"tier\\\" style=\\\"display:block\\\">\\n<div class=\\\"small\\\">Half-day workshops and team integrations are priced per brief: typical starting rate $950 for on-site facilitation (travel and gear included within a 30-mile radius). Custom quotes for retreats and multi-day VIP days.</div>\\n<div class=\\\"note\\\">Audio palette for events often includes singing bowls, koshi bells and light shakers tailored for communal resonance.</div>\\n</div>\\n</section>\\n<section class=\\\"section\\\" style=\\\"margin-top:18px\\\">\\n<h3 style=\\\"margin:0 0 8px\\\">Policies & notes</h3>\\n<div class=\\\"note\\\">All bookings require a 48-hour cancellation policy. Private sessions and day rates may require deposit. Please notify us of medical conditions listed on our FAQ before booking.</div>\\n</section>\\n<footer class=\\\"footer\\\">\\n<div class=\\\"small\\\">Questions? {{EMAIL}} • {{PHONE}}</div>\\n<a class=\\\"cta\\\" href=\\\"book.html\\\">Book a session</a>\\n</footer>\\n</main>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
