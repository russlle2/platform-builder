          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About • {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"About {{BUSINESS_NAME}} — a sensory, premium sound bathing experience in {{CITY}}, {{STATE}}. Learn our approach, pillars, and impact.\\\">\\n  <style>\\n    :root{--bg:#0f1020;--card:#0f1724;--muted:#9aa7b2;--accent1:#8ee3d3;--accent2:#7b6cff;--glass:rgba(255,255,255,0.04);--radius:14px;font-family:Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial}\\n    *{box-sizing:border-box}\\n    html,body{height:100%}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg),#081021 60%);color:#e6eef6;line-height:1.45}\\n    header{position:relative;padding:28px 24px;display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;align-items:center;gap:14px}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--accent1),var(--accent2));display:grid;place-items:center;font-weight:700;color:#041017}\\n    nav{display:flex;gap:12px;align-items:center}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px 12px;border-radius:10px;font-weight:600}\\n    nav a.active,nav a:hover{background:var(--glass);color:#fff}\\n    main{max-width:1100px;margin:20px auto;padding:34px;border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);box-shadow:0 8px 40px rgba(3,6,11,0.6)}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center}\\n    .hero h1{margin:0;font-size:28px;letter-spacing:-0.02em}\\n    .hero p.lead{color:var(--muted);margin-top:12px}\\n    .panel{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:18px;border-radius:14px}\\n    .stats{display:flex;gap:12px;margin-top:14px}\\n    .stat{background:rgba(255,255,255,0.02);padding:10px;border-radius:10px;text-align:center;min-width:86px}\\n    .pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:22px}\\n    .pillar{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:16px;border-radius:12px}\\n    .case-notes{margin-top:22px;display:flex;flex-direction:column;gap:12px}\\n    .case{padding:14px;border-radius:12px;background:linear-gradient(90deg,rgba(123,108,255,0.06),rgba(142,227,211,0.03));border:1px solid rgba(255,255,255,0.02)}\\n    footer{display:flex;justify-content:space-between;align-items:center;padding:18px;margin-top:18px;border-radius:12px;background:linear-gradient(90deg,rgba(255,255,255,0.015),transparent)}\\n    .cta{display:inline-flex;gap:10px;align-items:center}\\n    .btn{background:linear-gradient(90deg,var(--accent1),var(--accent2));color:#041017;padding:10px 14px;border-radius:12px;text-decoration:none;font-weight:700}\\n    .muted{color:var(--muted);font-size:14px}\\n    /* decorative SVG behind content */\\n    .bg-svg{position:fixed;inset:0;pointer-events:none;opacity:0.16}\\n    @media(max-width:880px){.hero{grid-template-columns:1fr;}.pillars{grid-template-columns:1fr}.brand .logo{width:44px;height:44px}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique inline SVG pattern (organic ripple, about page) -->\\n  <svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 1200 800\\\" preserveAspectRatio=\\\"xMidYMid slice\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"gA\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#8ee3d3\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#7b6cff\\\"/></linearGradient>\\n      <pattern id=\\\"pA\\\" width=\\\"300\\\" height=\\\"200\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(12)\\\">\\n        <rect width=\\\"300\\\" height=\\\"200\\\" fill=\\\"rgba(255,255,255,0)\\\"/>\\n        <circle cx=\\\"40\\\" cy=\\\"60\\\" r=\\\"24\\\" fill=\\\"rgba(255,255,255,0.02)\\\"/>\\n        <circle cx=\\\"120\\\" cy=\\\"140\\\" r=\\\"18\\\" fill=\\\"rgba(255,255,255,0.015)\\\"/>\\n        <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"300\\\" height=\\\"200\\\" fill=\\\"url(#gA)\\\" opacity=\\\"0.02\\\"/>\\n      </pattern>\\n      <filter id=\\\"blurA\\\"><feGaussianBlur stdDeviation=\\\"28\\\"/></filter>\\n    </defs>\\n    <rect width=\\\"1200\\\" height=\\\"800\\\" fill=\\\"url(#pA)\\\"/>\\n    <g filter=\\\"url(#blurA)\\\">\\n      <ellipse cx=\\\"200\\\" cy=\\\"120\\\" rx=\\\"320\\\" ry=\\\"70\\\" fill=\\\"#7b6cff\\\" opacity=\\\"0.08\\\"/>\\n      <ellipse cx=\\\"980\\\" cy=\\\"600\\\" rx=\\\"420\\\" ry=\\\"120\\\" fill=\\\"#8ee3d3\\\" opacity=\\\"0.06\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">SB</div>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Gather</a>\\n      <a href=\\\"events.html\\\">Upcoming</a>\\n      <a href=\\\"private-sessions.html\\\">1:1 &amp; Teams</a>\\n      <a href=\\\"pricing.html\\\">Invest</a>\\n      <a href=\\\"about.html\\\" class=\\\"active\\\">Our Atelier</a>\\n      <a href=\\\"faq.html\\\">Q&amp;A</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>About the practice — intentional sound, curated for rest</h1>\\n        <p class=\\\"lead\\\">We design sound baths that respect ritual, safety, and the nervous system. {{FACILITATOR_NAME}} blends clinical attention with sensory craft to create immersive group experiences.</p>\\n        <div class=\\\"stats\\\">\\n          <div class=\\\"stat\\\"><div style=\\\"font-size:18px;font-weight:700\\\">10+</div><div class=\\\"muted\\\">Years shaping sound</div></div>\\n          <div class=\\\"stat\\\"><div style=\\\"font-size:18px;font-weight:700\\\">600+</div><div class=\\\"muted\\\">Participants served</div></div>\\n          <div class=\\\"stat\\\"><div style=\\\"font-size:18px;font-weight:700\\\">VIP day</div><div class=\\\"muted\\\">Private sensory design</div></div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"panel\\\">\\n        <strong>Our signature focus</strong>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Precision of tone, intentional pacing, and an environment that supports deep nervous system regulation. Sessions use a curated palette of instruments chosen for timbral clarity and tactile resonance.</p>\\n        <div style=\\\"margin-top:12px;display:flex;gap:8px;flex-wrap:wrap\\\">\\n          <span style=\\\"background:rgba(255,255,255,0.03);padding:6px 10px;border-radius:999px;font-weight:700\\\">Crystal bowls</span>\\n          <span style=\\\"background:rgba(255,255,255,0.03);padding:6px 10px;border-radius:999px;font-weight:700\\\">Tuning forks</span>\\n          <span style=\\\"background:rgba(255,255,255,0.03);padding:6px 10px;border-radius:999px;font-weight:700\\\">Monochord</span>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"pillars\\\">\\n      <div class=\\\"pillar\\\">\\n        <h3 style=\\\"margin:0\\\">Calibration</h3>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">We begin with a short, simple intake to understand individual sensitivities and set safe volume and frequency ranges.</p>\\n      </div>\\n      <div class=\\\"pillar\\\">\\n        <h3 style=\\\"margin:0\\\">Architecture</h3>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Sessions are scaffolded: arrival, guided grounding, the sound journey, and integrative closure — each phase intentional.</p>\\n      </div>\\n      <div class=\\\"pillar\\\">\\n        <h3 style=\\\"margin:0\\\">Care</h3>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Accessibility, clear contraindications, and a culture of consent are woven into every gathering.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"case-notes\\\">\\n      <div class=\\\"case\\\">\\n        <strong>Corporate retreat — resiliency reset</strong>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">A two-hour offering designed to lower stress markers and sharpen group cohesion. Follow-up check-ins showed improved calm and focus among attendees.</p>\\n      </div>\\n      <div class=\\\"case\\\">\\n        <strong>Community circle — integrative series</strong>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">A six-week cohort that combined breathwork, sound, and journaling. Participants reported deeper sleep and reduced anxiety scores.</p>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>\\n        <div style=\\\"font-weight:800\\\">Meet {{FACILITATOR_NAME}}</div>\\n        <div class=\\\"muted\\\">Facilitator, sonic designer and host — trained in somatic modalities and acoustic craft.</div>\\n      </div>\\n      <div class=\\\"cta\\\">\\n        <a class=\\\"btn\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        <div class=\\\"muted\\\">Or call <a class=\\\"muted\\\" href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n      </div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>FAQ • {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Frequently asked questions — what to bring, contraindications, how sessions flow, and what to expect from {{BUSINESS_NAME}} sound baths.\\\">\\n  <style>\\n    :root{--bg:#071024;--card:#08122a;--accent:#7b6cff;--muted:#a8b7c2;font-family:Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto}\\n    *{box-sizing:border-box}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg),#051423);color:#eaf6ff}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:22px}\\n    .logo{display:flex;gap:12px;align-items:center}\\n    .logo div{width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,#8ee3d3,#7b6cff);display:grid;place-items:center;color:#041017;font-weight:700}\\n    nav{display:flex;gap:10px}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px 12px;border-radius:10px}\\n    nav a:hover{background:rgba(255,255,255,0.02);color:#fff}\\n    main{max-width:980px;margin:18px auto;padding:20px}\\n    h1{margin:6px 0 12px;font-size:26px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px}\\n    .faq-list{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:16px;border-radius:12px}\\n    details{background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;margin-bottom:10px}\\n    summary{font-weight:700;cursor:pointer}\\n    .side{position:sticky;top:24px;height:fit-content;background:linear-gradient(180deg,rgba(123,108,255,0.04),transparent);padding:14px;border-radius:12px}\\n    .badge{display:inline-block;background:rgba(255,255,255,0.03);padding:6px 10px;border-radius:999px;margin-bottom:10px}\\n    .muted{color:var(--muted)}\\n    .btn{display:inline-block;background:linear-gradient(90deg,#8ee3d3,#7b6cff);color:#041017;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:800}\\n    .svg-bg{position:fixed;left:0;bottom:0;opacity:0.12;width:60vw;height:60vh;pointer-events:none}\\n    @media(max-width:900px){.grid{grid-template-columns:1fr}.svg-bg{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique inline SVG (FAQ ripple: delicate lattice) -->\\n  <svg class=\\\"svg-bg\\\" viewBox=\\\"0 0 800 800\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"gF\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#7b6cff\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#8ee3d3\\\"/></linearGradient>\\n    </defs>\\n    <g fill=\\\"url(#gF)\\\">\\n      <path d=\\\"M0 600 C150 520 250 680 420 640 C630 590 720 740 800 700 L800 800 L0 800 Z\\\" opacity=\\\"0.06\\\"/>\\n      <circle cx=\\\"640\\\" cy=\\\"140\\\" r=\\\"120\\\" opacity=\\\"0.05\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"logo\\\"><div>SB</div><div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div></div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Events</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <h1>Questions we commonly get</h1>\\n    <div class=\\\"grid\\\">\\n      <div class=\\\"faq-list\\\">\\n        <details open>\\n          <summary>What should I bring?</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Bring a yoga mat or soft padding, a blanket, a small pillow for head support, water, and any personal eye covering (sleep mask). Layered clothing is best — rooms can cool during the latter part of the session.</div>\\n        </details>\\n\\n        <details>\\n          <summary>Are there contraindications?</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Yes. Please notify us if you are pregnant, have a history of seizures, severe cardiovascular conditions, or recent head/neck injuries. If you have implanted medical devices (e.g., pacemaker), consult your healthcare provider before attending. We maintain low-to-moderate volumes and provide alternatives when necessary.</div>\\n        </details>\\n\\n        <details>\\n          <summary>How long is a typical session and what is the flow?</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Most group sessions run 75–90 minutes. Typical flow: arrival &amp; intake (10–15 min), guided grounding (10 min), the sound journey with layered instruments (40–55 min), gentle emergence and journaling (10 min). We close with optional sharing.</div>\\n        </details>\\n\\n        <details>\\n          <summary>Can I fall asleep? Will that affect the benefit?</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Falling asleep is common and part of the restorative process. Even if you drift in and out, the body benefits from the regulated sound and pacing.</div>\\n        </details>\\n\\n        <details>\\n          <summary>What instruments do you use?</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">We rotate our palette intentionally: crystal singing bowls, silk gongs, koshi chimes, monochord, and selected tuning forks for close-field work. Each session uses a combination tailored to the intention.</div>\\n        </details>\\n\\n        <details>\\n          <summary>How do private bookings differ?</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Private options include 1:1 sessions, couples, small groups, and corporate offerings. VIP day engagements involve bespoke sonic design, space consultation, and an extended session length with follow-up guidance.</div>\\n        </details>\\n\\n        <details>\\n          <summary>What is your cancellation policy?</summary>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Please review the policy on the booking page or contact us. For private and VIP bookings, a deposit is typically required and nonrefundable within a specific window.</div>\\n        </details>\\n      </div>\\n\\n      <aside class=\\\"side\\\">\\n        <div class=\\\"badge\\\">Ask us in advance</div>\\n        <div class=\\\"muted\\\">If you have specific sensitivities (sound aversion, hyperacusis, vestibular concerns), email <a class=\\\"muted\\\" href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a class=\\\"muted\\\" href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>. We can adapt the room and instrument placements.</div>\\n        <div style=\\\"margin-top:14px\\\">\\n          <a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve a space</a>\\n        </div>\\n        <div style=\\\"margin-top:12px;color:var(--muted);font-size:13px\\\">Sessions hosted at {{VENUE_NAME}} in {{CITY}}, {{STATE}}. For private events, we travel on request.</div>\\n      </aside>\\n    </div>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book • {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Reserve a spot or book a private sound bath with {{BUSINESS_NAME}}. What to bring, contraindications, session flow, and VIP day options.\\\">\\n  <style>\\n    :root{--bg:#071018;--panel:#081526;--muted:#a7bcc8;--accent1:#7b6cff;--accent2:#8ee3d3;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto}\\n    *{box-sizing:border-box}\\n    body{margin:0;background:linear-gradient(180deg,#041122,var(--bg));color:#e8f7ff}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,var(--accent2),var(--accent1));display:grid;place-items:center;color:#041017;font-weight:800}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:8px;padding:8px;border-radius:8px}\\n    nav a:hover{background:rgba(255,255,255,0.02);color:#fff}\\n    main{max-width:1100px;margin:20px auto;padding:20px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:18px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:14px}\\n    h1{margin-top:0}\\n    .option{display:flex;justify-content:space-between;align-items:center;padding:12px;border-radius:10px;background:rgba(255,255,255,0.02);margin-bottom:10px}\\n    .btn{background:linear-gradient(90deg,var(--accent2),var(--accent1));color:#041017;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:800}\\n    .muted{color:var(--muted)}\\n    .flow{display:flex;flex-direction:column;gap:8px;margin-top:12px}\\n    .flow .step{background:rgba(255,255,255,0.01);padding:10px;border-radius:10px}\\n    .disclaimer{font-size:13px;color:#ffdbdb;background:rgba(255,90,90,0.05);padding:10px;border-radius:10px;margin-top:12px}\\n    .svg-top{position:fixed;right:0;top:0;width:44vw;height:44vh;opacity:0.12;pointer-events:none}\\n    @media(max-width:960px){.grid{grid-template-columns:1fr}.svg-top{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <!-- booking page SVG: concentric rings + dots (unique) -->\\n  <svg class=\\\"svg-top\\\" viewBox=\\\"0 0 800 800\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <radialGradient id=\\\"gB\\\" cx=\\\"50%\\\" cy=\\\"30%\\\"><stop offset=\\\"0\\\" stop-color=\\\"#8ee3d3\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#7b6cff\\\"/></radialGradient>\\n    </defs>\\n    <g fill=\\\"url(#gB)\\\">\\n      <circle cx=\\\"680\\\" cy=\\\"120\\\" r=\\\"96\\\" opacity=\\\"0.06\\\"/>\\n      <circle cx=\\\"620\\\" cy=\\\"80\\\" r=\\\"40\\\" opacity=\\\"0.08\\\"/>\\n      <circle cx=\\\"720\\\" cy=\\\"200\\\" r=\\\"140\\\" opacity=\\\"0.03\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\"><div class=\\\"logo\\\">SB</div><div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div></div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Main</a>\\n      <a href=\\\"events.html\\\">Calendar</a>\\n      <a href=\\\"faq.html\\\">Help</a>\\n      <a href=\\\"contact.html\\\">Reach</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"grid\\\">\\n      <section>\\n        <div class=\\\"card\\\">\\n          <h1>Book a session</h1>\\n          <p class=\\\"muted\\\">Choose a public seat, private session, or enquire about our VIP day design for corporate or deeply bespoke offerings.</p>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <div class=\\\"option\\\">\\n              <div>\\n                <div style=\\\"font-weight:800\\\">Public sound bath</div>\\n                <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Shared group session — 75–90 minutes</div>\\n              </div>\\n              <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book seat</a>\\n            </div>\\n\\n            <div class=\\\"option\\\">\\n              <div>\\n                <div style=\\\"font-weight:800\\\">Private session</div>\\n                <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">1:1, couples, or small group — tailored space &amp; instrument palette</div>\\n              </div>\\n              <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Request</a>\\n            </div>\\n\\n            <div class=\\\"option\\\">\\n              <div>\\n                <div style=\\\"font-weight:800\\\">VIP Day — immersive</div>\\n                <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Full-day design: consultation, space tuning, and an extended sound journey for leaders or teams</div>\\n              </div>\\n              <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Inquire</a>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:16px\\\">\\n            <h3 style=\\\"margin:0\\\">Session flow</h3>\\n            <div class=\\\"flow\\\">\\n              <div class=\\\"step\\\"><strong>Arrival &amp; intake</strong> — a brief check-in to set comfort and volume preferences.</div>\\n              <div class=\\\"step\\\"><strong>Grounding</strong> — guided breath and gentle movement to prepare the body.</div>\\n              <div class=\\\"step\\\"><strong>Sound journey</strong> — a 40–55 minute curated arc using layered instruments tuned to the session intention.</div>\\n              <div class=\\\"step\\\"><strong>Return &amp; integration</strong> — slow reorientation, shared notes, and practical suggestions to carry the experience home.</div>\\n            </div>\\n          </div>\\n\\n          <div style=\\\"margin-top:16px\\\">\\n            <h3 style=\\\"margin:0\\\">What to bring</h3>\\n            <ul class=\\\"muted\\\" style=\\\"margin-top:8px\\\">\\n              <li>Mat or soft pad</li>\\n              <li>Blanket and a small pillow</li>\\n              <li>Water bottle</li>\\n              <li>Optional: eye covering, earplugs if you are sensitive</li>\\n            </ul>\\n          </div>\\n\\n          <div style=\\\"margin-top:16px\\\">\\n            <h3 style=\\\"margin:0\\\">Contraindications &amp; safety</h3>\\n            <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Please notify us in advance if you are pregnant, have a seizure disorder, recent head/neck injury, or implanted medical devices. For certain conditions we offer modified placements, reduced volume, or alternative practices. If in doubt, consult your healthcare provider.</div>\\n            <div class=\\\"disclaimer\\\">Not medical advice. Attendance is at your discretion; by booking you confirm awareness of the above. For private/VIP bookings, specific waivers may apply.</div>\\n          </div>\\n\\n          <div style=\\\"margin-top:16px\\\">\\n            <h3 style=\\\"margin:0\\\">Instruments and approach</h3>\\n            <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">We compose each session with care. Typical instruments for private bookings might include: chimes, bowed monochord, Himalayan bowls, and low-register gongs — placed to modulate near-field and far-field perception.</p>\\n          </div>\\n\\n        </div>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0\\\">Reserve now</h3>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Small groups fill quickly. For private or corporate bookings, reach out to schedule a consultation.</p>\\n          <div style=\\\"margin-top:12px;display:flex;flex-direction:column;gap:8px\\\">\\n            <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n            <a class=\\\"btn\\\" href=\\\"mailto:{{EMAIL}}\\\" style=\\\"background:transparent;border:1px solid rgba(255,255,255,0.04);color:var(--muted);font-weight:700;text-decoration:none\\\">Email us</a>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\" class=\\\"muted\\\">Questions? Call <a class=\\\"muted\\\" href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or email <a class=\\\"muted\\\" href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <strong style=\\\"display:block\\\">Location</strong>\\n            <div class=\\\"muted\\\">Sessions hosted at {{VENUE_NAME}}, {{CITY}}, {{STATE}}. Mobile setups are available for off-site private bookings.</div>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px;\\\">\\n            <strong style=\\\"display:block\\\">Next steps</strong>\\n            <div class=\\\"muted\\\">After booking you'll receive a confirmation with arrival instructions, parking, and what to bring. For VIP day inquiries we schedule a pre-session phone consultation.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <strong style=\\\"display:block\\\">Short checklist</strong>\\n          <ul class=\\\"muted\\\" style=\\\"margin-top:8px\\\">\\n            <li>Layered clothing</li>\\n            <li>Hydration</li>\\n            <li>Plan 15 extra minutes for arrival</li>\\n            <li>Notify us of any implants or recent injury</li>\\n          </ul>\\n        </div>\\n\\n      </aside>\\n    </div>\\n  </main>\\n\\n  <footer style=\\\"padding:18px;text-align:center;color:var(--muted)\\\">Questions? Call <a class=\\\"muted\\\" href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or <a class=\\\"muted\\\" href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
