          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Live Sound Baths</title>\\n  <style>\\n    :root{--glass-bg:rgba(255,255,255,0.08);--glass-border:rgba(255,255,255,0.12);--accent:rgba(173, 120, 255, 0.9);--muted:#e9eef8;--glass-radius:16px}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,\\\"Segoe UI\\\",Roboto,'Helvetica Neue',Arial;color:var(--muted);background:#070617;}\\n    /* unique SVG backdrop sits behind everything */\\n    .pattern-wrap{position:fixed;inset:0;z-index:-1;opacity:0.9}\\n    header{backdrop-filter:blur(8px);background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-bottom:1px solid var(--glass-border);display:flex;align-items:center;gap:18px;padding:18px 28px}\\n    header a{color:var(--muted);text-decoration:none;padding:8px 12px;border-radius:10px}\\n    header a.active{background:linear-gradient(90deg,rgba(173,120,255,0.12),rgba(120,200,255,0.06));box-shadow:0 6px 20px rgba(120,80,200,0.06)}\\n    .container{max-width:1100px;margin:28px auto;padding:0 20px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:26px;align-items:center}\\n    .card{background:var(--glass-bg);border:1px solid var(--glass-border);padding:28px;border-radius:var(--glass-radius);box-shadow:0 8px 30px rgba(2,6,23,0.6)}\\n    h1{margin:0;font-size:28px;color:white}\\n    p.lead{color:#d7dff0;margin-top:10px;line-height:1.5}\\n    .next-event{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(173,120,255,0.02));padding:18px;border-radius:12px}\\n    .calendar{margin-top:14px;display:flex;flex-direction:column;gap:8px}\\n    .evt{display:flex;justify-content:space-between;padding:10px 12px;border-radius:10px;background:linear-gradient(90deg,rgba(255,255,255,0.01),transparent)}\\n    .meta{font-size:13px;color:#bfc9e8}\\n    .what{display:flex;gap:14px;flex-wrap:wrap;margin-top:18px}\\n    .pill{background:rgba(255,255,255,0.03);padding:8px 12px;border-radius:999px;font-size:13px}\\n    .section{margin-top:26px}\\n    ul{margin:8px 0 0 18px}\\n    .cta{display:inline-block;margin-top:14px;padding:12px 18px;background:linear-gradient(90deg,var(--accent),#66d6ff);color:#061022;border-radius:12px;text-decoration:none;font-weight:600}\\n    footer{margin:48px 0 80px;color:#9fa9d9;text-align:center}\\n    .testimonials{display:grid;grid-template-columns:1fr 1fr;gap:14px}\\n    .t{padding:14px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:12px}\\n    @media (max-width:900px){.hero{grid-template-columns:1fr}.testimonials{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- Inline SVG pattern unique to this page (crystal-spray motif) -->\\n  <svg class=\\\"pattern-wrap\\\" aria-hidden=\\\"true\\\" height=\\\"100%\\\" width=\\\"100%\\\" preserveAspectRatio=\\\"none\\\">\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0%\\\" stop-color=\\\"#32174a\\\" stop-opacity=\\\"1\\\" />\\n        <stop offset=\\\"100%\\\" stop-color=\\\"#05102b\\\" stop-opacity=\\\"1\\\" />\\n      </linearGradient>\\n      <radialGradient id=\\\"r1\\\">\\n        <stop offset=\\\"0%\\\" stop-color=\\\"#b988ff\\\" stop-opacity=\\\"0.18\\\"/>\\n        <stop offset=\\\"70%\\\" stop-color=\\\"#66d6ff\\\" stop-opacity=\\\"0.04\\\"/>\\n      </radialGradient>\\n      <pattern id=\\\"pcrystals\\\" width=\\\"240\\\" height=\\\"240\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"240\\\" height=\\\"240\\\" fill=\\\"url(#g1)\\\" />\\n        <g fill=\\\"url(#r1)\\\" transform=\\\"rotate(12 120 120)\\\">\\n          <circle cx=\\\"40\\\" cy=\\\"40\\\" r=\\\"28\\\" />\\n          <circle cx=\\\"200\\\" cy=\\\"90\\\" r=\\\"18\\\" />\\n          <circle cx=\\\"160\\\" cy=\\\"190\\\" r=\\\"22\\\" />\\n          <circle cx=\\\"70\\\" cy=\\\"150\\\" r=\\\"12\\\" />\\n        </g>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#pcrystals)\\\" />\\n    <!-- soft spectral bands -->\\n    <g opacity=\\\"0.06\\\">\\n      <ellipse cx=\\\"18%\\\" cy=\\\"10%\\\" rx=\\\"40%\\\" ry=\\\"20%\\\" fill=\\\"#b27cff\\\"/>\\n      <ellipse cx=\\\"85%\\\" cy=\\\"80%\\\" rx=\\\"55%\\\" ry=\\\"30%\\\" fill=\\\"#4fe0ff\\\"/>\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div style=\\\"font-weight:700;color:white\\\">{{BUSINESS_NAME}}</div>\\n    <nav style=\\\"margin-left:8px;display:flex;gap:6px;align-items:center\\\">\\n      <a href=\\\"index.html\\\">Gather</a>\\n      <a href=\\\"events.html\\\" class=\\\"active\\\">Live &amp; Upcoming</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"pricing.html\\\">Investment</a>\\n      <a href=\\\"about.html\\\">Our Story</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n    <div style=\\\"margin-left:auto;font-size:14px;color:#cbd8ff\\\">{{CITY}}, {{STATE}}</div>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"card\\\">\\n        <h1>Sound baths — live group experiences</h1>\\n        <p class=\\\"lead\\\">A guided, sensory journey that blends sustained tones, subtle harmonics, and gentle silence to help you down-regulate and rest. Sessions emphasize spaciousness, breath, and deep listening.</p>\\n\\n        <div class=\\\"section\\\">\\n          <h3 style=\\\"margin:0;color:#dfe8ff\\\">Next event</h3>\\n          <div class=\\\"next-event\\\" style=\\\"margin-top:10px\\\">\\n            <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n              <div>\\n                <div style=\\\"font-weight:700;color:white\\\">Evening Sound Bath — Community Gathering</div>\\n                <div class=\\\"meta\\\">at {{VENUE_NAME}} • Doors 7:00pm, starts 7:30pm</div>\\n              </div>\\n              <div style=\\\"text-align:right\\\">\\n                <div style=\\\"font-size:18px;font-weight:800;color:white\\\">{{NEXT_EVENT_DATE}}</div>\\n                <div class=\\\"meta\\\">Reserve your spot</div>\\n              </div>\\n            </div>\\n            <div class=\\\"calendar\\\">\\n              <div class=\\\"evt\\\"><div>Sat • {{NEXT_EVENT_DATE}}</div><div class=\\\"meta\\\">Limited seating</div></div>\\n              <div class=\\\"evt\\\"><div>Monthly • Next: {{NEXT_EVENT_DATE}}</div><div class=\\\"meta\\\">Series pass available</div></div>\\n              <div class=\\\"evt\\\"><div>Drop-in sessions</div><div class=\\\"meta\\\">Walk-in allowed if space</div></div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"section\\\">\\n          <h4 style=\\\"margin:0;color:#e6edff\\\">What to bring</h4>\\n          <div class=\\\"what\\\">\\n            <div class=\\\"pill\\\">Yoga mat or thick blanket</div>\\n            <div class=\\\"pill\\\">Light pillow/bolster</div>\\n            <div class=\\\"pill\\\">Water bottle</div>\\n            <div class=\\\"pill\\\">Eye mask (optional)</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"section\\\">\\n          <h4 style=\\\"margin:0;color:#e6edff\\\">Contraindications &amp; accessibility</h4>\\n          <p class=\\\"meta\\\" style=\\\"margin-top:8px\\\">If you are pregnant, have a pacemaker, uncontrolled epilepsy, or recent head injury, please consult a care provider before attending. Loud gongs may be used in select moments; we always offer quieter seating and advance notice.</p>\\n        </div>\\n\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <div style=\\\"font-weight:700;color:white\\\">Session flow — what to expect</div>\\n        <ul style=\\\"margin-top:10px;color:#cfd9ff\\\">\\n          <li><strong>Welcome & settling:</strong> Intentions, gentle breathwork (8–10 min)</li>\\n          <li><strong>Sound journey:</strong> Layered tones and resonance (35–45 min)</li>\\n          <li><strong>Integration:</strong> Silence, soft tea, closing conversation (10–15 min)</li>\\n        </ul>\\n\\n        <div style=\\\"margin-top:18px\\\">\\n          <div style=\\\"font-weight:700;color:white\\\">Lead facilitator</div>\\n          <div class=\\\"meta\\\">{{FACILITATOR_NAME}}</div>\\n        </div>\\n\\n        <div class=\\\"section\\\" style=\\\"margin-top:18px\\\">\\n          <h4 style=\\\"margin:0;color:#e6edff\\\">Instruments for this gathering</h4>\\n          <ul class=\\\"meta\\\" style=\\\"margin-top:8px\\\">\\n            <li>Crystal singing bowls (harmonic overtones)</li>\\n            <li>Tuning forks for focused frequency work</li>\\n            <li>Koshi chimes for gentle transitions</li>\\n          </ul>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"section card\\\">\\n      <h3 style=\\\"margin-top:0;color:white\\\">Why attend — a short story</h3>\\n      <p class=\\\"lead\\\">Sound alters the felt sense of time. In our gatherings people report deeper sleep, eased tension, and a clearer mind. We design each live event to feel like an intentional pause from the rush—a curated hour of slow listening and restorative resonance.</p>\\n    </section>\\n\\n    <section class=\\\"section card\\\">\\n      <h3 style=\\\"margin-top:0;color:white\\\">Community calendar</h3>\\n      <p class=\\\"meta\\\">Reserve early — seats are intentionally limited to preserve sound quality and intimacy.</p>\\n      <div style=\\\"margin-top:12px;display:flex;flex-direction:column;gap:10px\\\">\\n        <div class=\\\"evt\\\"><div>Sun • 2026-03-07</div><div class=\\\"meta\\\">Late afternoon — restorative</div></div>\\n        <div class=\\\"evt\\\"><div>Fri • 2026-03-27</div><div class=\\\"meta\\\">Full-spectrum sonic journey</div></div>\\n        <div class=\\\"evt\\\"><div>Sat • 2026-04-10</div><div class=\\\"meta\\\">Guided integration circle</div></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0;color:white\\\">Testimonials</h3>\\n        <div class=\\\"testimonials\\\" style=\\\"margin-top:12px\\\">\\n          <div class=\\\"t\\\">\\\"The depth of stillness I experienced surprised me. I slept like a baby.\\\" — A.</div>\\n          <div class=\\\"t\\\">\\\"A refined, intentional space—beautifully led.\\\" — M.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section card\\\">\\n      <h3 style=\\\"margin-top:0;color:white\\\">Plan your visit</h3>\\n      <p class=\\\"meta\\\">Questions? Call <a style=\\\"color:#cfe6ff;text-decoration:none\\\" href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or email <a style=\\\"color:#cfe6ff;text-decoration:none\\\" href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</p>\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve a seat</a>\\n    </section>\\n\\n    <footer>\\n      <div>{{VENUE_NAME}} — {{CITY}}, {{STATE}} • Facilitated by {{FACILITATOR_NAME}}</div>\\n      <div style=\\\"margin-top:8px\\\">© <span id=\\\"year\\\">2026</span> {{BUSINESS_NAME}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Private Sessions</title>\\n  <style>\\n    :root{--glass-bg:rgba(255,255,255,0.06);--glass-border:rgba(255,255,255,0.10);--accent:#66d6ff;--muted:#e6f0ff}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial;background:#051026;color:var(--muted)}\\n    header{display:flex;align-items:center;padding:18px 24px;gap:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);backdrop-filter:blur(6px);border-bottom:1px solid var(--glass-border)}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px 10px;border-radius:8px}\\n    nav a.active{background:linear-gradient(90deg,rgba(102,214,255,0.08),rgba(173,120,255,0.04))}\\n    .wrap{max-width:1100px;margin:26px auto;padding:0 20px}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:20px}\\n    .card{background:var(--glass-bg);border:1px solid var(--glass-border);padding:22px;border-radius:14px}\\n    h1{margin:0;color:#ffffff}\\n    .muted{color:#bcd6ff}\\n    .service{margin-top:12px;padding:12px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent)}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;background:var(--accent);color:#02101a;border-radius:12px;text-decoration:none;font-weight:700}\\n    ul{margin:8px 0 0 18px}\\n    .flow{font-size:14px;color:#cfe8ff}\\n    footer{margin:36px 0 80px;text-align:center;color:#9fb8e9}\\n    @media (max-width:900px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- unique SVG motif for private-sessions: gong ripple pattern -->\\n  <svg style=\\\"position:fixed;inset:0;z-index:-1;opacity:0.75\\\" aria-hidden=\\\"true\\\" width=\\\"100%\\\" height=\\\"100%\\\">\\n    <defs>\\n      <linearGradient id=\\\"gp\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0%\\\" stop-color=\\\"#071226\\\" />\\n        <stop offset=\\\"100%\\\" stop-color=\\\"#02111f\\\" />\\n      </linearGradient>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#gp)\\\" />\\n    <g fill-opacity=\\\"0.06\\\" stroke=\\\"#8fd8ff\\\" stroke-width=\\\"1.5\\\">\\n      <circle cx=\\\"20%\\\" cy=\\\"30%\\\" r=\\\"220\\\" />\\n      <circle cx=\\\"20%\\\" cy=\\\"30%\\\" r=\\\"320\\\" />\\n      <circle cx=\\\"20%\\\" cy=\\\"30%\\\" r=\\\"420\\\" />\\n    </g>\\n    <g fill-opacity=\\\"0.04\\\" stroke=\\\"#cfa0ff\\\" stroke-width=\\\"1\\\">\\n      <circle cx=\\\"78%\\\" cy=\\\"70%\\\" r=\\\"180\\\" />\\n      <circle cx=\\\"78%\\\" cy=\\\"70%\\\" r=\\\"300\\\" />\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div style=\\\"font-weight:800;color:white\\\">{{BUSINESS_NAME}}</div>\\n    <nav style=\\\"margin-left:14px;display:flex;gap:6px;align-items:center\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Events</a>\\n      <a href=\\\"private-sessions.html\\\" class=\\\"active\\\">Privates</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n    <div style=\\\"margin-left:auto;color:#bcd6ff\\\">{{CITY}}, {{STATE}}</div>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"grid\\\">\\n      <div>\\n        <div class=\\\"card\\\">\\n          <h1>Private sessions — tailored sound work</h1>\\n          <p class=\\\"muted\\\">Intimate, intentional sessions for individuals, couples, and teams. We sculpt sound to support rest, clarity, and focused embodiment.</p>\\n\\n          <div class=\\\"section\\\" style=\\\"margin-top:16px\\\">\\n            <h3 style=\\\"margin:0;color:#f6fbff\\\">Options we offer</h3>\\n            <div class=\\\"service\\\">\\n              <div style=\\\"font-weight:700\\\">1:1 session — 60 or 90 minutes</div>\\n              <div class=\\\"muted\\\">Deep listening tailored to the nervous system. Ideal for personal integration or acute stress release.</div>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <div style=\\\"font-weight:700\\\">Couples session</div>\\n              <div class=\\\"muted\\\">Shared, resonant experience designed to create ease and relational attunement.</div>\\n            </div>\\n            <div class=\\\"service\\\">\\n              <div style=\\\"font-weight:700\\\">Corporate & team offerings</div>\\n              <div class=\\\"muted\\\">Short in-office sound resets or full half-day restorative workshops for teams.</div>\\n            </div>\\n          </div>\\n\\n          <div class=\\\"section\\\" style=\\\"margin-top:14px\\\">\\n            <h4 style=\\\"margin:0;color:#eaf4ff\\\">Flow of a private session</h4>\\n            <p class=\\\"flow\\\">We begin with a brief intake, then a tailored sonic arc (25–60 min) weaving sustained instruments, subtle percussion, and tuned resonance; closing includes gentle grounding and takeaways.</p>\\n          </div>\\n\\n          <div class=\\\"section\\\" style=\\\"margin-top:12px\\\">\\n            <h4 style=\\\"margin:0;color:#eaf4ff\\\">What to bring</h4>\\n            <ul class=\\\"muted\\\">\\n              <li>Comfortable clothing</li>\\n              <li>Blanket or mat for lying down</li>\\n              <li>Any mobility supports (bolster, chair)</li>\\n            </ul>\\n          </div>\\n\\n          <div class=\\\"section\\\" style=\\\"margin-top:12px\\\">\\n            <h4 style=\\\"margin:0;color:#eaf4ff\\\">Contraindications</h4>\\n            <p class=\\\"muted\\\">If you have a pacemaker, recent surgery, or severe psychiatric conditions, please contact us before booking. High-volume instruments are adjustable on request.</p>\\n          </div>\\n\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Start a private inquiry</a>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:18px\\\">\\n          <h3 style=\\\"margin:0;color:white\\\">Why private?</h3>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">One-to-one work lets us customize frequency, duration, and physical supports. We treat each session like a focused VIP day for your nervous system—intensive, restorative, and clear.</p>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <div style=\\\"font-weight:700;color:white\\\">Session spotlight</div>\\n        <p class=\\\"muted\\\">Samples of instruments we may use, chosen per session:</p>\\n        <ul style=\\\"margin-top:10px;color:#dfeeff\\\">\\n          <li>Large gong for deep-spectrum immersion</li>\\n          <li>Monochord for steady harmonic foundation</li>\\n          <li>Tibetan bowls for complex overtones</li>\\n          <li>Koshi &amp; bell textures for transitions</li>\\n        </ul>\\n\\n        <div style=\\\"margin-top:16px\\\">\\n          <div style=\\\"font-weight:700;color:white\\\">Package idea — VIP Day</div>\\n          <p class=\\\"muted\\\">Full morning or afternoon session: intake, extended sound immersion, integration coaching, and follow-up resources. Designed for deep reset and measurable change.</p>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Inquire about VIP Day</a>\\n        </div>\\n\\n        <div style=\\\"margin-top:18px\\\">\\n          <div style=\\\"font-weight:700;color:white\\\">Facilitator</div>\\n          <div class=\\\"muted\\\">{{FACILITATOR_NAME}}</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin:0;color:white\\\">Testimonials from private clients</h3>\\n        <div style=\\\"margin-top:12px;color:#dfeaff\\\">\\n          \\\"A single session rebalanced my sleep and focus for weeks.\\\" — R.\\n        </div>\\n        <div style=\\\"margin-top:10px;color:#dfeaff\\\">\\n          \\\"The VIP day changed our leadership retreat—calm and creativity increased.\\\" — L., HR Director\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>Ready to plan a private experience? Email <a style=\\\"color:#bfe8ff;text-decoration:none\\\" href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a style=\\\"color:#bfe8ff;text-decoration:none\\\" href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>.</div>\\n      <div style=\\\"margin-top:8px\\\">© 2026 {{BUSINESS_NAME}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Pricing & Packages</title>\\n  <style>\\n    :root{--bg1:#071226;--card:rgba(255,255,255,0.04);--border:rgba(255,255,255,0.08);--accent1:#b988ff;--accent2:#66d6ff}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg1),#021020);font-family:Inter,system-ui,Roboto,Arial;color:#dbeaff}\\n    header{display:flex;align-items:center;gap:12px;padding:18px 26px;border-bottom:1px solid var(--border);backdrop-filter:blur(6px)}\\n    header a{color:#dbeaff;text-decoration:none}\\n    header a.active{font-weight:700}\\n    .wrap{max-width:1000px;margin:26px auto;padding:0 20px}\\n    h1{margin:0;color:white}\\n    .intro{background:var(--card);border:1px solid var(--border);padding:18px;border-radius:12px}\\n    .plans{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-top:18px}\\n    .plan{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px;border:1px solid var(--border)}\\n    .price{font-weight:800;font-size:22px;color:#fff;margin-top:6px}\\n    .features{margin-top:10px;color:#cfe8ff}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,var(--accent1),var(--accent2));color:#021022;text-decoration:none;font-weight:700}\\n    .disclaimer{font-size:13px;color:#b8c9ea;margin-top:12px}\\n    footer{margin:40px 0 80px;text-align:center;color:#9fb8e9}\\n    @media (max-width:900px){.plans{grid-template-columns:1fr}}    \\n  </style>\\n</head>\\n<body>\\n  <!-- pricing page SVG — harp-grid pattern for warmth -->\\n  <svg style=\\\"position:fixed;inset:0;z-index:-1;opacity:0.7\\\" aria-hidden=\\\"true\\\" width=\\\"100%\\\" height=\\\"100%\\\">\\n    <defs>\\n      <linearGradient id=\\\"pg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0%\\\" stop-color=\\\"#031024\\\"/><stop offset=\\\"100%\\\" stop-color=\\\"#071428\\\"/></linearGradient>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#pg)\\\" />\\n    <g stroke=\\\"#8ed6ff\\\" stroke-opacity=\\\"0.06\\\" stroke-width=\\\"1\\\">\\n      <path d=\\\"M0 150 Q250 50 500 150 T1000 150\\\" fill=\\\"none\\\" />\\n      <path d=\\\"M0 300 Q250 200 500 300 T1000 300\\\" fill=\\\"none\\\" />\\n    </g>\\n  </svg>\\n\\n  <header>\\n    <div style=\\\"font-weight:800;color:white\\\">{{BUSINESS_NAME}}</div>\\n    <nav style=\\\"margin-left:12px;display:flex;gap:8px;align-items:center\\\">\\n      <a href=\\\"index.html\\\">Overview</a>\\n      <a href=\\\"events.html\\\">Gatherings</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"pricing.html\\\" class=\\\"active\\\">Pricing</a>\\n      <a href=\\\"faq.html\\\">FAQ</a>\\n    </nav>\\n    <div style=\\\"margin-left:auto;color:#cfe8ff\\\">Questions? <a style=\\\"color:#bfe8ff;text-decoration:none\\\" href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"intro\\\">\\n      <h1>Packages &amp; Rates</h1>\\n      <p style=\\\"margin-top:8px;color:#cfe8ff\\\">Clear, simple pricing for groups and private offerings. We design packages to support sustained change—short reset, series commitment, or an immersive VIP Day.</p>\\n    </section>\\n\\n    <section class=\\\"plans\\\">\\n      <div class=\\\"plan\\\">\\n        <div style=\\\"font-weight:700\\\">Drop-in group</div>\\n        <div class=\\\"price\\\">$30 — single event</div>\\n        <div class=\\\"features\\\">\\n          <ul>\\n            <li>One live sound bath (75 minutes)</li>\\n            <li>Blanket space; tea during integration</li>\\n            <li>Ideal for first-timers</li>\\n          </ul>\\n        </div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a spot</a>\\n      </div>\\n\\n      <div class=\\\"plan\\\">\\n        <div style=\\\"font-weight:700\\\">Series pass</div>\\n        <div class=\\\"price\\\">$110 — 4 sessions</div>\\n        <div class=\\\"features\\\">\\n          <ul>\\n            <li>Four group sessions (save 8%)</li>\\n            <li>Priority booking and recording access</li>\\n            <li>Best for ongoing regulation</li>\\n          </ul>\\n        </div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Get the pass</a>\\n      </div>\\n\\n      <div class=\\\"plan\\\">\\n        <div style=\\\"font-weight:700\\\">Private 90-minute</div>\\n        <div class=\\\"price\\\">$220 — single private</div>\\n        <div class=\\\"features\\\">\\n          <ul>\\n            <li>One-to-one or couples session</li>\\n            <li>Tailored instrument selection and intake</li>\\n            <li>Includes follow-up resources</li>\\n          </ul>\\n        </div>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Request a booking</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"plan\\\" style=\\\"border-left:4px solid var(--accent1);\\\">\\n        <div style=\\\"font-weight:800\\\">VIP Day — immersive offering</div>\\n        <div class=\\\"price\\\">From $1200 — custom</div>\\n        <div class=\\\"features\\\" style=\\\"margin-top:8px;color:#dff4ff\\\">\\n          <ul>\\n            <li>Half- or full-day immersive (intake, long-form sound, integration)</li>\\n            <li>Professional facilitation + bespoke sound design</li>\\n            <li>On-site or remote planning; follow-up materials</li>\\n          </ul>\\n        </div>\\n        <p class=\\\"disclaimer\\\">VIP Day is our deep work offer—ideal for leadership retreats, creative teams, and sustained individual transformation. Pricing varies by scope.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Plan a VIP Day</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin-top:0;color:white\\\">Included instruments (examples)</h3>\\n      <p class=\\\"muted\\\">We curate a palette per session. Example textures below; your session will be tailored.</p>\\n      <ul style=\\\"margin-top:10px;color:#dff4ff\\\">\\n        <li>Handpan for warm, rounded tones</li>\\n        <li>Tuning forks for focused energetic points</li>\\n        <li>Koshi chimes and gentle rattles for transitions</li>\\n      </ul>\\n\\n      <div class=\\\"disclaimer\\\">Note: If you have medical implants, pacemakers, or are pregnant, please consult with your provider and inform us before booking. Loud instruments may be adjusted or omitted by request.</div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin-top:0;color:white\\\">Payment, cancellation, and logistics</h3>\\n      <ul style=\\\"margin-top:8px;color:#cfe8ff\\\">\\n        <li>Payment is required to reserve most sessions and packages.</li>\\n        <li>Cancel or reschedule 48+ hours in advance for a full refund.</li>\\n        <li>For VIP Days, a deposit is required; full T&Cs are sent on inquiry.</li>\\n      </ul>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin-top:0;color:white\\\">Ready to book?</h3>\\n      <p style=\\\"color:#cfe8ff\\\">Start with a quick conversation. We'll recommend the right format—drop-in, series, private, or a VIP Day tailored to your goals.</p>\\n      <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </section>\\n\\n    <footer>\\n      <div>Questions? Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:#bfe8ff;text-decoration:none\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#bfe8ff;text-decoration:none\\\">{{EMAIL}}</a>.</div>\\n      <div style=\\\"margin-top:8px\\\">© 2026 {{BUSINESS_NAME}} — Sessions hosted in {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
