          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Events — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Group sound baths, guided by {{FACILITATOR_NAME}} — immersive, sensory, premium experiences in {{CITY}}, {{STATE}}\\\">\\n  <style>\\n    :root{--glass:#ffffff22;--glass-2:#ffffff14;--accent:#8ee7e1;--muted:#dfeff0;--bg1:linear-gradient(135deg,#0f172a 0%,#06202a 100%);}html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#e6f7f7;background:var(--bg1);-webkit-font-smoothing:antialiased}\\n    .wrap{max-width:1100px;margin:48px auto;padding:32px;position:relative}\\n    nav{display:flex;gap:18px;align-items:center;justify-content:space-between}\\n    nav .links{display:flex;gap:12px}\\n    a{color:var(--muted);text-decoration:none;padding:10px;border-radius:10px}\\n    a.primary{background:linear-gradient(90deg,var(--accent),#6bd6ff);color:#022;backdrop-filter:blur(6px);font-weight:700}\\n    header.card{background:linear-gradient(180deg,rgba(255,255,255,0.04),rgba(255,255,255,0.02));border-radius:16px;padding:28px;box-shadow:0 10px 30px rgba(2,8,23,0.6);display:grid;grid-template-columns:1fr 340px;gap:24px;align-items:center}\\n    h1{margin:0 0 8px 0;font-size:28px;color:#e9ffff}\\n    p.lead{margin:0;color:#cdeeee}\\n    .card-side{backdrop-filter:blur(8px);background:var(--glass-2);padding:18px;border-radius:12px}\\n    .meta{display:flex;flex-direction:column;gap:8px}\\n    .meta div{font-size:14px;color:#bfeff0}\\n    .btn{display:inline-block;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,#9feee8,#7bd6ff);color:#033;margin-top:8px;font-weight:700}\\n    section{margin-top:28px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:20px}\\n    .glass{background:var(--glass);backdrop-filter:blur(6px);padding:18px;border-radius:14px}\\n    ul.check{list-style:none;padding:0;margin:0}ul.check li{padding:8px 0;border-bottom:1px dashed rgba(255,255,255,0.04);color:#d8f8f8}\\n    .calendar{display:flex;flex-direction:column;gap:8px}\\n    .event-item{padding:12px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border:1px solid rgba(255,255,255,0.03)}\\n    .testimonial{font-style:italic;color:#d5f7f7}\\n    footer{margin-top:40px;text-align:center;color:#9feaf0}\\n    /* SVG background */\\n    .bg-svg{position:absolute;left:0;top:0;right:0;height:260px;pointer-events:none;opacity:0.22}\\n    /* responsive */\\n    @media(max-width:880px){header.card{grid-template-columns:1fr} .grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <nav>\\n      <div style=\\\"display:flex;align-items:center;gap:14px\\\">\\n        <div style=\\\"width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#88f4ea,#6bbbe7);display:flex;align-items:center;justify-content:center;font-weight:800;color:#022\\\">SB</div>\\n        <div style=\\\"color:#dff7f7;font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      </div>\\n      <div class=\\\"links\\\">\\n        <a href=\\\"index.html\\\">Welcome</a>\\n        <a href=\\\"events.html\\\" class=\\\"primary\\\">Gatherings</a>\\n        <a href=\\\"private-sessions.html\\\">Private</a>\\n        <a href=\\\"pricing.html\\\">Rates</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n        <a href=\\\"contact.html\\\">Connect</a>\\n      </div>\\n    </nav>\\n\\n    <svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 1200 200\\\" preserveAspectRatio=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#6be6e0\\\" stop-opacity=\\\"0.14\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#6b9fff\\\" stop-opacity=\\\"0.06\\\"/></linearGradient>\\n        <pattern id=\\\"p1\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n          <rect width=\\\"40\\\" height=\\\"40\\\" fill=\\\"transparent\\\"/>\\n          <circle cx=\\\"6\\\" cy=\\\"6\\\" r=\\\"1.5\\\" fill=\\\"#9feff1\\\" opacity=\\\"0.6\\\" />\\n        </pattern>\\n      </defs>\\n      <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"1200\\\" height=\\\"200\\\" fill=\\\"url(#g1)\\\" />\\n      <path d=\\\"M0 120 Q300 20 600 120 T1200 120 V200 H0 Z\\\" fill=\\\"url(#p1)\\\" opacity=\\\"0.6\\\"/>\\n    </svg>\\n\\n    <header class=\\\"card\\\">\\n      <div>\\n        <h1>Live Sound Baths & Community Nights</h1>\\n        <p class=\\\"lead\\\">A sensory, premium evening of sound & deep rest with {{FACILITATOR_NAME}}. Bring a mat — we provide a curated sonic palette to guide you into silence.</p>\\n        <div style=\\\"margin-top:14px\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a style=\\\"margin-left:10px;color:#cfeffe\\\" href=\\\"book.html\\\">Reserve a seat</a>\\n        </div>\\n      </div>\\n      <aside class=\\\"card-side\\\">\\n        <div class=\\\"meta\\\">\\n          <div><strong>Next event</strong></div>\\n          <div style=\\\"font-weight:700;color:#eaffff\\\">{{NEXT_EVENT_DATE}}</div>\\n          <div>Venue: {{VENUE_NAME}} — {{CITY}}, {{STATE}}</div>\\n          <div style=\\\"margin-top:8px\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Save my spot</a></div>\\n        </div>\\n      </aside>\\n    </header>\\n\\n    <section class=\\\"grid\\\">\\n      <main>\\n        <div class=\\\"glass\\\">\\n          <h2 style=\\\"margin-top:0\\\">What to expect — an evening flow</h2>\\n          <p style=\\\"color:#cfeff0\\\">We design each gathering like a curated sound tapestry. The flow is simple and intentional:</p>\\n          <ul class=\\\"check\\\">\\n            <li><strong>Arrival & grounding:</strong> gentle breathwork and settling (10–15 min)</li>\\n            <li><strong>Guided sound journey:</strong> layered instruments move from subtle to immersive (45–60 min)</li>\\n            <li><strong>Reintegration:</strong> soft chimes, silence, tea & integration time (10–20 min)</li>\\n          </ul>\\n\\n          <h3 style=\\\"margin-top:18px\\\">Instruments you may hear</h3>\\n          <p class=\\\"lead\\\" style=\\\"margin-bottom:6px\\\">A shifting, tactile palette — tuned to body and room acoustics:</p>\\n          <ul class=\\\"check\\\">\\n            <li>Crystal singing bowls (harmonic overtones)</li>\\n            <li>Planetary gong (deep resonance)</li>\\n            <li>Wind chimes & gentle percussion</li>\\n            <li>Tuning forks for focused tones</li>\\n          </ul>\\n\\n          <h3 style=\\\"margin-top:18px\\\">Sensory guidance</h3>\\n          <p>Expect gentle invitations to surrender: we prioritize low lighting, breathable ventilation, and soft textures. This is curated for sensory safety and premium comfort.</p>\\n        </div>\\n\\n        <div class=\\\"glass\\\" style=\\\"margin-top:18px\\\">\\n          <h2>Tickets & calendar</h2>\\n          <p style=\\\"color:#cfeff0\\\">Upcoming gatherings — reserve early (limited capacity)</p>\\n          <div class=\\\"calendar\\\">\\n            <div class=\\\"event-item\\\"><strong>{{NEXT_EVENT_DATE}}</strong> — Group Sound Bath • Doors 6:30pm • {{VENUE_NAME}}</div>\\n            <div class=\\\"event-item\\\">2026-03-14 — New Moon Ritual • Doors 6:30pm • {{VENUE_NAME}}</div>\\n            <div class=\\\"event-item\\\">2026-04-11 — Full Moon Bath • Doors 7:00pm • {{VENUE_NAME}}</div>\\n            <div class=\\\"event-item\\\">2026-05-09 — Rest & Reset • Doors 6:00pm • {{VENUE_NAME}}</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"glass\\\" style=\\\"margin-top:18px\\\">\\n          <h2>Social proof</h2>\\n          <blockquote class=\\\"testimonial\\\">\\\"A level of sound I hadn't experienced — the tones felt alive. I left lighter.\\\" — Aileen, attendee</blockquote>\\n          <blockquote class=\\\"testimonial\\\" style=\\\"margin-top:8px\\\">\\\"Impeccable pacing and attention to comfort. The room felt like a soft instrument.\\\" — Marcus P.</blockquote>\\n        </div>\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"glass\\\">\\n          <h3>What to bring</h3>\\n          <ul class=\\\"check\\\">\\n            <li>Yoga mat or blanket to lie on</li>\\n            <li>Small pillow for head support</li>\\n            <li>Warm layer to stay comfortable</li>\\n            <li>Optional eye mask / earbuds for arrival</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"glass\\\" style=\\\"margin-top:16px\\\">\\n          <h3>Health & safety</h3>\\n          <p style=\\\"color:#cfeff0\\\">Contraindications: not recommended if you are pregnant without prior clearance, have severe epilepsy, uncontrolled cardiovascular conditions, or are recovering from recent surgery. If you have medical implants like pacemakers, consult your clinician before attending.</p>\\n        </div>\\n\\n        <div class=\\\"glass\\\" style=\\\"margin-top:16px\\\">\\n          <h3>Ready to join?</h3>\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <p style=\\\"font-size:13px;margin-top:8px;color:#cde\\\">Questions? Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or <a href=\\\"mailto:{{EMAIL}}\\\">email</a>.</p>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section>\\n      <div class=\\\"glass\\\">\\n        <h2 style=\\\"margin-top:0\\\">FAQ — quick answers</h2>\\n        <details style=\\\"margin-top:10px\\\"><summary style=\\\"cursor:pointer;color:#eaffff\\\">Do I need experience?</summary><div style=\\\"padding-top:8px;color:#cfeff0\\\">No. Sessions are accessible to beginners and experienced listeners alike. We'll guide you through breath and posture.</div></details>\\n        <details style=\\\"margin-top:8px\\\"><summary style=\\\"cursor:pointer;color:#eaffff\\\">Can I bring friends?</summary><div style=\\\"padding-top:8px;color:#cfeff0\\\">Yes. Buy seats individually — we hold limited tickets to preserve the acoustics.</div></details>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <div class=\\\"glass\\\">\\n        <h2>Join our list</h2>\\n        <p class=\\\"lead\\\">Receive event announcements and early access to ticket drops — one quality email per month.</p>\\n        <form action=\\\"#\\\" onsubmit=\\\"alert('Thanks — we\\\\'ll follow up via email.');return false;\\\">\\n          <input type=\\\"email\\\" name=\\\"email\\\" placeholder=\\\"your@email.com\\\" style=\\\"width:60%;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.06);background:transparent;color:#eaf8f7\\\" required>\\n          <button class=\\\"btn\\\" style=\\\"margin-left:8px\\\">Join</button>\\n        </form>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <p>Curated sound experiences by {{BUSINESS_NAME}} • <a href=\\\"contact.html\\\">Contact</a> • <a href=\\\"privacy.html\\\">Privacy</a></p>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Private Sessions — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"1:1, couples & corporate sound bath sessions — tailored, sensory-focused experiences in {{CITY}}, {{STATE}}\\\">\\n  <style>\\n    :root{--bg:linear-gradient(180deg,#05151a,#07222a);--glass:rgba(255,255,255,0.03);--accent:#9ef0e8}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;color:#e8fbfb;background:var(--bg)}\\n    .container{max-width:1000px;margin:48px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    nav a{color:#bfeeea;margin-left:12px;text-decoration:none}\\n    .hero{background:linear-gradient(180deg,rgba(255,255,255,0.03),transparent);padding:26px;border-radius:14px;backdrop-filter:blur(6px)}\\n    h1{margin:0;color:#eaffff}\\n    .sub{color:#cfeff0}\\n    .columns{display:grid;grid-template-columns:1fr 360px;gap:20px;margin-top:20px}\\n    .panel{background:var(--glass);padding:16px;border-radius:12px}\\n    .list{list-style:none;padding:0;margin:0}\\n    .list li{padding:10px 0;border-bottom:1px dashed rgba(255,255,255,0.03)}\\n    .cta{display:inline-block;padding:10px 14px;background:linear-gradient(90deg,#7fe6df,#8ecaff);color:#022;border-radius:10px;text-decoration:none;font-weight:700}\\n    .note{font-size:13px;color:#cfe}\\n    .flow{margin-top:12px}\\n    /* responsive */\\n    @media(max-width:900px){.columns{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#8ef2e4,#6fbdf0);display:flex;align-items:center;justify-content:center;font-weight:800;color:#023\\\">SB</div>\\n        <div style=\\\"color:#eaffff;font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Events</a>\\n        <a href=\\\"private-sessions.html\\\" class=\\\"\\\">Sessions</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"contact.html\\\">Reach out</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <h1>Private Sound Sessions — bespoke & focused</h1>\\n      <p class=\\\"sub\\\">Tailored sonic care for individuals, couples, and teams. Premium sensory design, delivered with clinical attention and thoughtful pacing.</p>\\n      <div style=\\\"margin-top:12px\\\">\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a consultation</a>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"columns\\\">\\n      <main>\\n        <div class=\\\"panel\\\">\\n          <h2 style=\\\"margin-top:0\\\">Offerings</h2>\\n          <ul class=\\\"list\\\">\\n            <li><strong>1:1 Therapeutic Session</strong> — Deeply personalized sound journey focused on relaxation, sleep reset, or stress regulation. Typical 60–90 minutes.</li>\\n            <li><strong>Couples Session</strong> — Shared sound field for connection and co-regulation; gentle guidance for shared breathing and listening.</li>\\n            <li><strong>Corporate & Team</strong> — Onsite or in-studio sessions focused on workplace rest, alignment, and creative reset (half-day and full-day options).</li>\\n          </ul>\\n\\n          <h3 style=\\\"margin-top:12px\\\">Instruments & textures</h3>\\n          <p class=\\\"note\\\">We choose instruments to meet session goals; examples include:</p>\\n          <ul class=\\\"list\\\">\\n            <li>Monochord for sustained harmonic foundation</li>\\n            <li>Crystal singing bowls for bright overtone clarity</li>\\n            <li>Tuning forks for somatic tuning and point work</li>\\n            <li>Handpan and soft percussion for rhythmic touch</li>\\n          </ul>\\n\\n          <h3 style=\\\"margin-top:12px\\\">Session flow (typical)</h3>\\n          <ol class=\\\"flow\\\">\\n            <li>Intake & intention setting (10–20 min)</li>\\n            <li>Gentle preparation — breath & posture (5–10 min)</li>\\n            <li>Main sound immersion (40–70 min) — dynamic layers tailored to your body</li>\\n            <li>Slow return, journaling, and practical aftercare (10–15 min)</li>\\n          </ol>\\n\\n          <h3 style=\\\"margin-top:12px\\\">What to bring</h3>\\n          <ul class=\\\"list\\\">\\n            <li>Comfortable clothing</li>\\n            <li>Personal blanket or pillow (we provide extras)</li>\\n            <li>Medical notes if you have specific concerns</li>\\n          </ul>\\n\\n          <p class=\\\"note\\\" style=\\\"margin-top:8px\\\">Contraindications: please notify us if you are pregnant, have active seizures, implantable devices, or acute injuries. Sessions can be adapted but safety is primary.</p>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:14px\\\">\\n          <h2>VIP Day — immersive private offering</h2>\\n          <p class=\\\"note\\\">A full-day VIP Day is a curated restorative experience: intake, extended sound therapy, movement or breathwork session, and a tailored integration plan. Ideal for artists, leaders, or anyone seeking deep recalibration.</p>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\" style=\\\"margin-top:10px;display:inline-block\\\">Inquire about VIP Day</a>\\n        </div>\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <h3>Quick booking</h3>\\n          <p class=\\\"note\\\">Sessions scheduled by appointment. Typical windows: mornings and evenings during weekdays; weekend blocks for VIP Day or couples.</p>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Request a date</a>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:14px\\\">\\n          <h3>Private session testimonials</h3>\\n          <p class=\\\"note\\\">\\\"An exceptional 1:1 — the tuning forks unlocked a clarity I hadn't felt in months.\\\" — Lea</p>\\n          <p class=\\\"note\\\">\\\"Our team left calmer and surprisingly aligned after the on-site reset.\\\" — R. Chen, Product</p>\\n        </div>\\n\\n        <div class=\\\"panel\\\" style=\\\"margin-top:14px\\\">\\n          <h3>Safety & accessibility</h3>\\n          <p class=\\\"note\\\">We accommodate mobility needs and provide clear pre-session guidance. If you have pacemakers or are undergoing psychiatric treatment, consult us ahead of booking.</p>\\n          <p style=\\\"margin-top:8px;color:#cfe\\\"><a href=\\\"contact.html\\\">Contact us</a> • <a href=\\\"{{PRIMARY_CTA_URL}}\\\">Schedule</a></p>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:20px\\\">\\n      <div class=\\\"panel\\\">\\n        <h2 style=\\\"margin-top:0\\\">FAQ — private work</h2>\\n        <details style=\\\"margin-top:8px\\\"><summary style=\\\"cursor:pointer\\\">Can sessions be recorded?</summary><div style=\\\"padding-top:8px;color:#cfe\\\">Recordings are rare and require clear consent; we sometimes provide short field recordings for integration.</div></details>\\n        <details style=\\\"margin-top:8px\\\"><summary style=\\\"cursor:pointer\\\">Can I combine sound therapy with other modalities?</summary><div style=\\\"padding-top:8px;color:#cfe\\\">Yes — many clients combine massage, craniosacral, or breathwork. We coordinate care with your practitioner when requested.</div></details>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:22px;color:#bfe\\\">\\n      <p>{{BUSINESS_NAME}} — premium sound care in {{CITY}}, {{STATE}} • <a href=\\\"contact.html\\\">Get in touch</a></p>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Pricing — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Transparent rates for group and private sound baths. Packages for individuals, couples, corporate, and VIP Day options.\\\">\\n  <style>\\n    :root{--bg:linear-gradient(160deg,#03131a,#07313a);--card:#ffffff12;--accent:#7feae0}\\n    html,body{margin:0;height:100%;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;color:#eafdfc;background:var(--bg)}\\n    .site{max-width:1000px;margin:44px auto;padding:24px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    nav a{color:#bfeef0;margin-left:12px}\\n    .hero{padding:20px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.03),transparent)}\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .tier{background:var(--card);padding:16px;border-radius:12px;border:1px solid rgba(255,255,255,0.04)}\\n    .tier h3{margin:0;color:#eaffff}\\n    .price{font-size:20px;font-weight:800;color:#022;background:linear-gradient(90deg,#9ff0df,#7dd0ff);display:inline-block;padding:6px 10px;border-radius:8px;margin-top:8px}\\n    .small{font-size:13px;color:#cfe}\\n    .cta{display:inline-block;padding:8px 12px;border-radius:10px;background:linear-gradient(90deg,#7fe7df,#8fbfff);color:#022;text-decoration:none;font-weight:700;margin-top:12px}\\n    /* responsive */\\n    @media(max-width:1000px){.tiers{grid-template-columns:1fr}} \\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <header>\\n      <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n        <div style=\\\"width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,#8ef1e6,#6fbcf2);display:flex;align-items:center;justify-content:center;font-weight:800;color:#023\\\">SB</div>\\n        <div style=\\\"color:#eaffff;font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"events.html\\\">Gatherings</a>\\n        <a href=\\\"private-sessions.html\\\">Private</a>\\n        <a href=\\\"pricing.html\\\" class=\\\"\\\">Fees</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <h1 style=\\\"margin:0\\\">Clear pricing for mindful sound</h1>\\n      <p class=\\\"small\\\" style=\\\"margin-top:6px\\\">Transparent packages for group events, private sessions, couples, corporate offerings, and the VIP Day experience.</p>\\n    </section>\\n\\n    <section class=\\\"tiers\\\">\\n      <div class=\\\"tier\\\">\\n        <h3>Group Drop-In</h3>\\n        <div class=\\\"price\\\">Starting at $35</div>\\n        <p class=\\\"small\\\">Per seat for community sound baths (discounts for early bird). Capacity limited to preserve acoustics.</p>\\n        <a class=\\\"cta\\\" href=\\\"events.html\\\">See calendar</a>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <h3>Private 1:1 Session</h3>\\n        <div class=\\\"price\\\">From $160</div>\\n        <p class=\\\"small\\\">60–90 minute bespoke sessions. Includes intake and aftercare notes.</p>\\n        <a class=\\\"cta\\\" href=\\\"private-sessions.html\\\">Book a session</a>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <h3>Couples & Shared</h3>\\n        <div class=\\\"price\\\">From $280</div>\\n        <p class=\\\"small\\\">Shared sound field designed to support connection and co-regulation. 75–90 minutes typical.</p>\\n        <a class=\\\"cta\\\" href=\\\"private-sessions.html\\\">Inquire</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:14px\\\">\\n        <div style=\\\"background:rgba(255,255,255,0.03);padding:16px;border-radius:12px\\\">\\n          <h3 style=\\\"margin-top:0\\\">Corporate & Team</h3>\\n          <p class=\\\"small\\\">Half-day and full-day packages available. Options include multiple sound sessions, group integration activities, and a short talk on team resilience. Pricing varies by travel and venue.</p>\\n          <p class=\\\"small\\\"><strong>Example:</strong> half-day onsite reset from $1200 (up to 20 people).</p>\\n        </div>\\n\\n        <div style=\\\"background:rgba(255,255,255,0.03);padding:16px;border-radius:12px\\\">\\n          <h3 style=\\\"margin-top:0\\\">VIP Day</h3>\\n          <p class=\\\"small\\\">A curated, full-day immersion with intake, extended sonic work, breath & movement pairing, and a written integration plan. Ideal for leadership retreats, artists, and teams seeking deep rest. Price on request.</p>\\n          <a class=\\\"cta\\\" href=\\\"contact.html\\\">Request VIP pricing</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div style=\\\"background:rgba(255,255,255,0.03);padding:16px;border-radius:12px\\\">\\n        <h3 style=\\\"margin-top:0\\\">What to bring & safety</h3>\\n        <p class=\\\"small\\\">Bring a mat/blanket and a pillow. For private sessions, bring any medical notes that might help us adapt the experience. Contraindications: pregnancy (consult first), epilepsy, recent major surgery, or implantable devices like pacemakers — please contact us before booking.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div style=\\\"background:rgba(255,255,255,0.03);padding:16px;border-radius:12px\\\">\\n        <h3 style=\\\"margin-top:0\\\">Booking process (simple)</h3>\\n        <ol class=\\\"small\\\">\\n          <li>Reach out via the booking form with preferred dates.</li>\\n          <li>We confirm availability and goals; payment details are shared.</li>\\n          <li>Receive pre-session guidance and arrival notes.</li>\\n        </ol>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">Start booking</a>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div style=\\\"background:rgba(255,255,255,0.03);padding:16px;border-radius:12px\\\">\\n        <h3 style=\\\"margin-top:0\\\">Still have questions?</h3>\\n        <p class=\\\"small\\\">Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>. We're happy to recommend a session type based on your goals.</p>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:18px;color:#bfe\\\">\\n      <p>{{BUSINESS_NAME}} • Premium sound experiences • <a href=\\\"contact.html\\\">Contact</a></p>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
