          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--glass-bg: rgba(255,255,255,0.06);--glass-border: rgba(255,255,255,0.14);--accent: linear-gradient(135deg,#8be8ff 0%,#bfa2ff 100%);--muted:#cfd8e3}\\n    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial; color: #eaf2ff;background: radial-gradient(1200px 600px at 10% 10%, rgba(139,232,255,0.06), transparent), radial-gradient(1000px 500px at 90% 90%, rgba(191,162,255,0.05), transparent);}\\n    .stage{min-height:100vh;display:flex;flex-direction:column;align-items:center;gap:28px;padding:48px 20px;position:relative;overflow:hidden}\\n    /* inline decorative SVG: unique to this page */\\n    .bg-svg{position:absolute;inset:-10% -10% auto auto;width:60%;height:60%;opacity:0.12;filter:blur(24px);}\\n    header{width:100%;max-width:1100px;display:flex;justify-content:space-between;align-items:center;padding:12px 18px}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:56px;height:56px;border-radius:12px;background:var(--accent);box-shadow:0 6px 20px rgba(66,50,124,0.12);display:flex;align-items:center;justify-content:center;font-weight:700;color:#07203a}\\n    nav a{color:var(--muted);text-decoration:none;margin:0 12px;font-size:15px}\\n    nav a.primary{background:transparent;border:1px solid var(--glass-border);padding:8px 14px;border-radius:12px;color:#fff}\\n    main{width:100%;max-width:1100px;display:grid;grid-template-columns:1fr 420px;gap:28px;align-items:start}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border-radius:18px;padding:28px;border:1px solid var(--glass-border);backdrop-filter: blur(10px);box-shadow:0 8px 30px rgba(7,32,58,0.18)}\\n    h1{margin:0 0 8px 0;font-size:32px;letter-spacing:-0.4px}\\n    p.lead{color:#dbeafc;margin:8px 0 20px}\\n    .benefits{display:flex;flex-direction:column;gap:12px}\\n    .benefit{display:flex;gap:12px;align-items:flex-start}\\n    .dot{width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,#c7fbff, #e8d8ff);display:flex;align-items:center;justify-content:center;font-weight:700;color:#07203a}\\n    .meta{color:#bcd1e8;font-size:14px}\\n    aside{position:relative}\\n    .facil{display:flex;gap:16px;align-items:center}\\n    .avatar{width:76px;height:76px;border-radius:16px;background:linear-gradient(135deg,#f6fbff,#eef0ff);display:flex;align-items:center;justify-content:center;font-weight:700;color:#07203a}\\n    .cta{display:flex;gap:8px;margin-top:18px}\\n    .btn{background:var(--accent);padding:12px 16px;border-radius:12px;color:#041428;text-decoration:none;font-weight:600}\\n    .muted{font-size:13px;color:var(--muted)}\\n    .what{margin-top:16px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);padding:14px;border-radius:12px;border:1px dashed rgba(255,255,255,0.04)}\\n    footer{width:100%;max-width:1100px;color:var(--muted);font-size:13px;padding:18px}\\n    @media (max-width:980px){main{grid-template-columns:1fr}aside{order:2}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"stage\\\">\\n    <svg class=\\\"bg-svg\\\" viewBox=\\\"0 0 800 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" preserveAspectRatio=\\\"none\\\">\\n      <defs>\\n        <linearGradient id=\\\"gA\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#8be8ff\\\" stop-opacity=\\\"0.9\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#bfa2ff\\\" stop-opacity=\\\"0.9\\\"/></linearGradient>\\n        <filter id=\\\"f1\\\" x=\\\"-50%\\\" y=\\\"-50%\\\" width=\\\"200%\\\" height=\\\"200%\\\"><feGaussianBlur stdDeviation=\\\"40\\\"/></filter>\\n      </defs>\\n      <g filter=\\\"url(#f1)\\\">\\n        <ellipse cx=\\\"220\\\" cy=\\\"160\\\" rx=\\\"260\\\" ry=\\\"120\\\" fill=\\\"url(#gA)\\\"/>\\n        <path d=\\\"M540 420c80-60 160-20 200-80 40-60-30-120-120-80-90 40-210 180-320 220\\\" stroke=\\\"#bfa2ff\\\" stroke-opacity=\\\"0.5\\\" fill=\\\"none\\\" stroke-width=\\\"8\\\"/>\\n      </g>\\n    </svg>\\n\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">SB</div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Sanctuary</a>\\n        <a href=\\\"events.html\\\">Gatherings</a>\\n        <a href=\\\"private-sessions.html\\\">Private Sessions</a>\\n        <a class=\\\"primary\\\" href=\\\"book.html\\\">Reserve</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"card\\\">\\n        <h1>We craft intentional sound experiences</h1>\\n        <p class=\\\"lead\\\">A sensory, premium approach to group immersions and private sound therapy led by {{FACILITATOR_NAME}} — rooted in safety, ritual, and refined acoustics.</p>\\n\\n        <div class=\\\"benefits\\\">\\n          <div class=\\\"benefit\\\"><div class=\\\"dot\\\">01</div><div><strong>Deep resonance that relaxes</strong><div class=\\\"meta\\\">Layered instruments create a moving field to quiet the nervous system.</div></div></div>\\n          <div class=\\\"benefit\\\"><div class=\\\"dot\\\">02</div><div><strong>Curated, intimate settings</strong><div class=\\\"meta\\\">Small circles, premium linens, and herbal scent rituals so every seat feels sacred.</div></div></div>\\n          <div class=\\\"benefit\\\"><div class=\\\"dot\\\">03</div><div><strong>Evidence-informed facilitation</strong><div class=\\\"meta\\\">We balance tradition and safety — clear intake, contraindication screening, and post-session guidance.</div></div></div>\\n        </div>\\n\\n        <div style=\\\"margin-top:18px;border-top:1px dashed rgba(255,255,255,0.04);padding-top:18px;color:var(--muted)\\\">\\n          <strong>Signature instruments:</strong>\\n          <div class=\\\"meta\\\">hand-tuned crystal bowls, harmonic chimes, and the warm sustained tone of the monochord — each chosen for clarity and sustain.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:18px;display:flex;gap:12px;align-items:center\\\">\\n          <a class=\\\"btn\\\" href=\\\"book.html\\\">Book a VIP Day</a>\\n          <a class=\\\"muted\\\" href=\\\"events.html\\\">See next gatherings</a>\\n        </div>\\n      </section>\\n\\n      <aside class=\\\"card\\\">\\n        <div class=\\\"facil\\\">\\n          <div class=\\\"avatar\\\">{{FACILITATOR_NAME.split(' ')[0][0]}}</div>\\n          <div>\\n            <div style=\\\"font-weight:700\\\">{{FACILITATOR_NAME}}</div>\\n            <div class=\\\"muted\\\">Lead facilitator & sound designer</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"what\\\">\\n          <strong>What to bring</strong>\\n          <ul class=\\\"meta\\\" style=\\\"margin:8px 0 0 18px\\\">\\n            <li>Comfortable layers and a small pillow or bolster</li>\\n            <li>Reusable water bottle</li>\\n            <li>Optional: eye mask or light blanket for warmth</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"what\\\">\\n          <strong>Contraindications & safety</strong>\\n          <div class=\\\"meta\\\" style=\\\"margin-top:6px\\\">If you are pregnant, have pacemakers, are recovering from surgery, have uncontrolled epilepsy, or serious cardiovascular conditions, please consult your physician and inform us prior to booking.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px\\\">\\n          <div class=\\\"muted\\\">Curious?</div>\\n          <div style=\\\"font-weight:600;margin-top:6px\\\">Explore our process, or reserve a private VIP session tailored to your needs.</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"btn\\\" href=\\\"contact.html\\\">Get in touch</a></div>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px\\\">\\n        <div>{{BUSINESS_NAME}} • Serving {{CITY}}, {{STATE}}</div>\\n        <div style=\\\"text-align:right\\\">Call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:#dbeafc;text-decoration:none\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#dbeafc\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>FAQ — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--pane: rgba(255,255,255,0.04);--glass-border: rgba(255,255,255,0.12);--accent:#c7fbff}\\n    body{margin:0;font-family:Inter,system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial;background:linear-gradient(180deg,#021226 0%, #07162a 100%);color:#eef7ff}\\n    .wrap{max-width:980px;margin:36px auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}\\n    .nav a{color:#bcd1e8;text-decoration:none;margin-left:14px}\\n    .panel{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:22px;border-radius:14px;border:1px solid var(--glass-border);backdrop-filter: blur(8px)}\\n    h1{margin:0;font-size:28px}\\n    .intro{color:#cfe9ff;margin-top:8px}\\n    .grid{display:grid;grid-template-columns:1fr 300px;gap:18px;margin-top:18px}\\n    .faq-list{display:flex;flex-direction:column;gap:10px}\\n    .q{background:var(--pane);padding:12px;border-radius:10px;cursor:pointer;border:1px solid rgba(255,255,255,0.02)}\\n    .q strong{display:block}\\n    .a{display:none;padding:10px 12px;color:#cde8ff;font-size:14px}\\n    .show{display:block}\\n    .sidebar{padding:14px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);border:1px dashed rgba(255,255,255,0.03)}\\n    .pill{display:inline-block;padding:8px 12px;border-radius:999px;background:linear-gradient(90deg,#e8faff, #efe6ff);color:#041428;font-weight:700}\\n    @media (max-width:900px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:#b6d9ff\\\">Questions & safety notes — clear answers for a calm booking experience</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Next Event</a>\\n        <a href=\\\"book.html\\\">Reserve Now</a>\\n      </nav>\\n    </header>\\n\\n    <main class=\\\"grid\\\">\\n      <section class=\\\"panel\\\">\\n        <h1>Frequently asked — sound bath logistics & safety</h1>\\n        <p class=\\\"intro\\\">Concise, practical guidance about what happens during a session, how to prepare, and medical considerations. If you need personalized guidance, reach out before booking.</p>\\n\\n        <div class=\\\"faq-list\\\" id=\\\"faqs\\\">\\n          <div class=\\\"q\\\" data-id=\\\"q1\\\"><strong>What should I bring?</strong>\\n            <div class=\\\"a\\\">Comfortable clothes, a yoga mat or blanket if you prefer your own, an eye mask, and a water bottle. For extended private sessions bring a small journal. We provide bolsters and blankets but space is limited for personal props.</div>\\n          </div>\\n\\n          <div class=\\\"q\\\" data-id=\\\"q2\\\"><strong>Are there contraindications?</strong>\\n            <div class=\\\"a\\\">Yes — please do not attend without consulting us if you have: a pacemaker or implanted electronic device, uncontrolled epilepsy, recent surgery, pregnancy in the first trimester without physician sign-off, or any condition where loud vibrational exposure is a risk. We ask all attendees to fill a brief intake form prior to arrival.</div>\\n          </div>\\n\\n          <div class=\\\"q\\\" data-id=\\\"q3\\\"><strong>What instruments do you use?</strong>\\n            <div class=\\\"a\\\">Our palette varies by event; common instruments include tuned gongs, precision tuning forks, and bronze/metal chimes, combined with breath-led silence. Each session is engineered for clarity and safety — instruments are positioned to avoid direct contact with implanted devices.</div>\\n          </div>\\n\\n          <div class=\\\"q\\\" data-id=\\\"q4\\\"><strong>What is the typical flow of a session?</strong>\\n            <div class=\\\"a\\\">We begin with a short welcome and grounding (10 minutes), an intake/adjustment period, a 40–55 minute immersion using layered live instruments, and a slow return with tea and integration pointers. For VIP/private days the immersion is longer and includes a pre-session consultation.</div>\\n          </div>\\n\\n          <div class=\\\"q\\\" data-id=\\\"q5\\\"><strong>Can I fall asleep?</strong>\\n            <div class=\\\"a\\\">Yes. Falling into a restorative sleep is common and part of the restorative benefit. You’ll be guided to reorient gently after the sound concludes; allow time to transition before driving.</div>\\n          </div>\\n\\n          <div class=\\\"q\\\" data-id=\\\"q6\\\"><strong>Are recordings available?</strong>\\n            <div class=\\\"a\\\">We do not typically record live baths due to acoustics and privacy, but we offer curated audio for post-session integration for VIP clients and repeat attendees.</div>\\n          </div>\\n\\n          <div class=\\\"q\\\" data-id=\\\"q7\\\"><strong>What about accessibility?</strong>\\n            <div class=\\\"a\\\">Our venue is accessible; please let us know any mobility needs when booking so we can reserve an optimal spot. Chairs are available for those who cannot recline on the floor.</div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <aside class=\\\"sidebar\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div>\\n            <div class=\\\"pill\\\">Quick Notes</div>\\n            <div style=\\\"margin-top:8px;color:#bcd8f5\\\">Next event: <strong>{{NEXT_EVENT_DATE}}</strong></div>\\n          </div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px;color:#cfe8ff;font-size:14px\\\">\\n          <strong>Private sessions</strong>\\n          <div style=\\\"margin-top:8px;color:#bcd8f5\\\">We offer 1:1, couple immersions, and corporate sound experiences tailored to intention and outcomes. See our booking page for VIP Day details.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px\\\">\\n          <a href=\\\"book.html\\\" style=\\\"display:inline-block;background:linear-gradient(90deg,#e8faff,#efe6ff);color:#041428;padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:700\\\">Reserve a spot</a>\\n        </div>\\n      </aside>\\n    </main>\\n\\n    <footer style=\\\"margin-top:22px;color:#bcd1e8;font-size:13px\\\">If any health concerns exist please contact us at <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#dbeafc;text-decoration:none\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:#dbeafc\\\">{{PHONE}}</a>.</footer>\\n  </div>\\n\\n  <script>\\n    document.querySelectorAll('.q').forEach(el => el.addEventListener('click', ()=>{\\n      const ans = el.querySelector('.a');\\n      const open = ans.classList.contains('show');\\n      document.querySelectorAll('.a').forEach(a=>a.classList.remove('show'));\\n      if(!open) ans.classList.add('show');\\n    }));\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--glass: rgba(255,255,255,0.04);--accent1:#ffd6a5;--accent2:#c7fbff}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial;background:linear-gradient(180deg,#06111a 0%, #071427 100%);color:#f0fbff}\\n    .frame{max-width:980px;margin:28px auto;padding:26px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    header a{color:#cfeaff;text-decoration:none;margin-left:14px}\\n    .hero{margin-top:18px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:22px;border-radius:14px;border:1px solid rgba(255,255,255,0.06);display:flex;gap:18px;align-items:center}\\n    .hero h1{margin:0;font-size:24px}\\n    .lead{color:#cddff3}\\n    .split{display:grid;grid-template-columns:1fr 420px;gap:18px;margin-top:18px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.04)}\\n    label{display:block;font-size:13px;margin-bottom:6px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,0.04);background:rgba(7,20,30,0.4);color:#eaf6ff;margin-bottom:12px}\\n    .row{display:flex;gap:10px}\\n    .btn{background:linear-gradient(90deg,var(--accent2),#efe6ff);color:#041428;padding:12px 14px;border-radius:12px;border:none;font-weight:700;cursor:pointer}\\n    .muted{color:#cfe9ff;font-size:13px}\\n    .itinerary{margin-top:12px}\\n    .it-step{display:flex;gap:12px;align-items:flex-start;margin-bottom:10px}\\n    .badge{width:42px;height:42px;border-radius:10px;background:linear-gradient(90deg,#ffd6a5,#ffe6f0);display:flex;align-items:center;justify-content:center;font-weight:700;color:#041428}\\n    @media (max-width:920px){.split{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"frame\\\">\\n    <header>\\n      <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"about.html\\\">About</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <div class=\\\"hero\\\">\\n      <div>\\n        <h1>Reserve a VIP Day or Private Session</h1>\\n        <div class=\\\"lead\\\">Tailored sound design for individual restoration, couples, or curated corporate sessions — book a focused VIP Day with deep planning and follow-up.</div>\\n      </div>\\n      <div style=\\\"margin-left:auto;text-align:right\\\">\\n        <div class=\\\"muted\\\">Prefer to speak with us?</div>\\n        <div style=\\\"font-weight:700;margin-top:6px\\\"><a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:#ffe9d6;text-decoration:none\\\">{{PHONE}}</a></div>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"split\\\">\\n      <section class=\\\"card\\\">\\n        <h2 style=\\\"margin-top:0\\\">VIP Day — immersive, intentional</h2>\\n        <div class=\\\"muted\\\">One focused day for transformation: consultation, tailored sound immersion, and integration support.</div>\\n\\n        <div class=\\\"itinerary\\\">\\n          <div class=\\\"it-step\\\"><div class=\\\"badge\\\">A</div><div><strong>Pre-day consultation</strong><div class=\\\"muted\\\">Clarity call to align intentions and screening for contraindications.</div></div></div>\\n          <div class=\\\"it-step\\\"><div class=\\\"badge\\\">B</div><div><strong>Session & sound design</strong><div class=\\\"muted\\\">A long-form immersion (60–90+ minutes) using crystal bowls and precision tuning forks with intentional pauses for integration.</div></div></div>\\n          <div class=\\\"it-step\\\"><div class=\\\"badge\\\">C</div><div><strong>Integration & takeaways</strong><div class=\\\"muted\\\">Notes, curated post-session audio, and a short follow-up to support ongoing practice.</div></div></div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <strong>What to bring</strong>\\n          <ul class=\\\"muted\\\" style=\\\"margin-top:8px;margin-left:18px\\\">\\n            <li>Comfortable clothing, two-layered blankets, personal cushion</li>\\n            <li>Any relevant medical info or medication list</li>\\n            <li>Optional: journal and pen for integration notes</li>\\n          </ul>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <strong>Contraindications</strong>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">If you have an implanted electronic device (pacemaker), active seizures, or are in high-risk pregnancy, inform us before booking. We will guide whether an adapted session is safer.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px;display:flex;gap:10px\\\">\\n          <a href=\\\"mailto:{{EMAIL}}?subject=VIP%20Day%20Inquiry\\\" class=\\\"btn\\\">Request VIP Day</a>\\n          <a href=\\\"events.html\\\" class=\\\"muted\\\" style=\\\"align-self:center;text-decoration:none\\\">See group events</a>\\n        </div>\\n      </section>\\n\\n      <aside class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Book now</h3>\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\">\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" placeholder=\\\"Your name\\\" required />\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@domain.com\\\" required />\\n          <label for=\\\"phone\\\">Phone</label>\\n          <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"Optional phone\\\" />\\n\\n          <label for=\\\"type\\\">Session type</label>\\n          <select id=\\\"type\\\" name=\\\"type\\\">\\n            <option>VIP Day (full consult + immersion)</option>\\n            <option>Private 1:1</option>\\n            <option>Couples</option>\\n            <option>Corporate / Team</option>\\n          </select>\\n\\n          <label for=\\\"date\\\">Preferred date</label>\\n          <input id=\\\"date\\\" name=\\\"date\\\" type=\\\"date\\\" value=\\\"{{NEXT_EVENT_DATE}}\\\" />\\n\\n          <label for=\\\"notes\\\">Notes / Contraindications</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Let us know about medical conditions, pregnancy, implants, or sensory needs\\\"></textarea>\\n\\n          <div style=\\\"display:flex;gap:8px;margin-top:8px\\\">\\n            <button class=\\\"btn\\\" type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n            <a class=\\\"muted\\\" href=\\\"faq.html\\\" style=\\\"align-self:center;text-decoration:none\\\">Need help?</a>\\n          </div>\\n        </form>\\n\\n        <div style=\\\"margin-top:14px;font-size:13px;color:#cfe9ff\\\">\\n          <strong>Instruments on offer</strong>\\n          <div style=\\\"margin-top:6px\\\">We tailor the sonic palette — crystal singing bowls, soft gongs, and melodic chimes are commonly blended. Instrument choice is tuned to your intention and physical safety.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px;font-size:13px;color:#bcd8f5\\\">A confirmation and preparatory guide are sent after booking. For urgent scheduling, call {{PHONE}}.</div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px;padding:18px;border-radius:12px;border:1px dashed rgba(255,255,255,0.04);background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent)\\\">\\n      <h3 style=\\\"margin:0 0 8px 0\\\">Lead magnet — integration guide</h3>\\n      <div class=\\\"muted\\\">When you reserve a VIP Day we provide a concise digital guide: a 7-step practice for integrating sound work into daily life. Enter your email on the booking form to receive it with your confirmation.</div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:18px;color:#bcd1e8;font-size:13px\\\">Questions? Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#dbeafc;text-decoration:none\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:#dbeafc\\\">{{PHONE}}</a>.</footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
