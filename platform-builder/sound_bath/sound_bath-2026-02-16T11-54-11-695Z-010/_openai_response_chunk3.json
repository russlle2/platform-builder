          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#0f1724;--bg2:#08121a;--accent:#8be9d1;--muted:#9aa7b2;--card:#0b1320}\\n    *{box-sizing:border-box}\\n    html,body{height:100%}\\n    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#e6f3f2;background:linear-gradient(180deg,var(--bg1),var(--bg2));-webkit-font-smoothing:antialiased}\\n    header{position:fixed;left:0;right:0;top:0;display:flex;align-items:center;justify-content:space-between;padding:18px 28px;backdrop-filter:blur(6px);z-index:20}\\n    .brand{display:flex;align-items:center;gap:12px;color:var(--accent);font-weight:700}\\n    .nav{display:flex;gap:14px}\\n    .nav a{color:#d8eef0;text-decoration:none;padding:8px 12px;border-radius:8px;font-size:14px}\\n    .nav a:hover{background:rgba(139,233,209,0.07)}\\n    main{padding-top:96px}\\n    .hero{min-height:44vh;display:grid;place-items:center;padding:48px 20px;position:relative;overflow:hidden}\\n    .hero-inner{max-width:1100px;width:100%;display:grid;grid-template-columns:1fr 420px;gap:28px;align-items:center}\\n    .hero-card{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:28px;border-radius:16px;box-shadow:0 6px 30px rgba(3,12,20,0.6);backdrop-filter:blur(8px)}\\n    h1{margin:0;color:#e8fff9;font-size:28px}\\n    p.lead{color:var(--muted);margin:14px 0 0;font-size:15px;line-height:1.5}\\n    .fac{font-size:14px;color:#bfeee0;margin-top:12px}\\n    .cta{margin-top:18px;display:flex;gap:10px}\\n    .btn{background:var(--accent);color:#042427;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .ghost{color:#cfeee8;border:1px solid rgba(255,255,255,0.04);padding:10px 12px;border-radius:10px;text-decoration:none}\\n    .pattern{position:absolute;inset:0;opacity:0.12}\\n    section{max-width:1100px;margin:28px auto;padding:24px}\\n    .flow{display:grid;grid-template-columns:1fr 320px;gap:24px}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.015),transparent);padding:20px;border-radius:12px;color:#cfeee8}\\n    .muted{color:var(--muted);font-size:14px}\\n    .bio{display:flex;gap:16px;align-items:center}\\n    .avatar{width:84px;height:84px;border-radius:12px;flex-shrink:0;background:linear-gradient(135deg,#155e63,#0b4b52);display:grid;place-items:center;font-weight:700;color:#e6fbf6}\\n    ul.ritual{padding-left:18px}\\n    footer{padding:28px 20px;color:var(--muted);text-align:center;font-size:13px}\\n    @media (max-width:900px){.hero-inner{grid-template-columns:1fr}.flow{grid-template-columns:1fr}.nav{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\"><svg width=\\\"36\\\" height=\\\"36\\\" viewBox=\\\"0 0 36 36\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><defs><linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#8be9d1\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#7bd3f2\\\"/></linearGradient></defs><rect width=\\\"36\\\" height=\\\"36\\\" rx=\\\"8\\\" fill=\\\"url(#g1)\\\"/></svg><div>{{BUSINESS_NAME}}</div></div>\\n    <nav class=\\\"nav\\\">\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Gatherings</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"about.html\\\">About</a>\\n      <a href=\\\"faq.html\\\">Q&A</a>\\n      <a class=\\\"btn\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"hero\\\">\\n      <svg class=\\\"pattern\\\" viewBox=\\\"0 0 600 400\\\" preserveAspectRatio=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n        <defs>\\n          <linearGradient id=\\\"lgA\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#08303a\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#061827\\\"/></linearGradient>\\n          <pattern id=\\\"p1\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(18)\\\">\\n            <rect width=\\\"40\\\" height=\\\"40\\\" fill=\\\"transparent\\\" />\\n            <circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"3\\\" fill=\\\"#07363a\\\" />\\n            <circle cx=\\\"28\\\" cy=\\\"28\\\" r=\\\"2\\\" fill=\\\"#04464b\\\" />\\n          </pattern>\\n        </defs>\\n        <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#lgA)\\\" />\\n        <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\" opacity=\\\"0.28\\\" />\\n        <g transform=\\\"translate(420,20) rotate(12)\\\">\\n          <ellipse cx=\\\"0\\\" cy=\\\"0\\\" rx=\\\"220\\\" ry=\\\"120\\\" fill=\\\"#0a4250\\\" opacity=\\\"0.12\\\"/>\\n        </g>\\n      </svg>\\n\\n      <div class=\\\"hero-inner\\\">\\n        <div class=\\\"hero-card\\\">\\n          <h1>We hold space for sound — subtle, intentional, restorative</h1>\\n          <p class=\\\"lead\\\">At {{BUSINESS_NAME}} we design sensory sound baths that feel like a clinical retreat: focused, warm, and grounded in somatic safety. Sessions blend tuned instruments and intentional silence to invite deep relaxation.</p>\\n          <div class=\\\"fac\\\">Facilitated by {{FACILITATOR_NAME}} · Small groups · Premium sonic linens</div>\\n          <div class=\\\"cta\\\">\\n            <a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve a spot</a>\\n            <a class=\\\"ghost\\\" href=\\\"events.html\\\">View upcoming</a>\\n          </div>\\n        </div>\\n\\n        <aside class=\\\"card\\\">\\n          <div class=\\\"bio\\\">\\n            <div class=\\\"avatar\\\">{{FACILITATOR_NAME.split(' ')[0][0]}}</div>\\n            <div>\\n              <div style=\\\"font-weight:700\\\">{{FACILITATOR_NAME}}</div>\\n              <div class=\\\"muted\\\">Sound therapist · Somatic coach</div>\\n            </div>\\n          </div>\\n          <hr style=\\\"border:none;height:1px;background:rgba(255,255,255,0.03);margin:14px 0\\\">\\n          <div style=\\\"font-size:14px;color:#cfeee8\\\">Our approach is clinical-modern: curated instruments, intentional cues, and a clear flow so you arrive open and leave resourced. We favor instruments that create stable, harmonic fields: crystal bowls, monochord, gongs, tuned chimes — each session varies.</div>\\n        </aside>\\n      </div>\\n    </div>\\n\\n    <section aria-labelledby=\\\"ritual\\\">\\n      <h2 id=\\\"ritual\\\" style=\\\"color:#e8fff9\\\">Ritual & structure</h2>\\n      <div class=\\\"flow\\\">\\n        <div class=\\\"card\\\">\\n          <p class=\\\"muted\\\">Sessions follow a steady architecture that balances guidance and spaciousness.</p>\\n          <ol class=\\\"ritual\\\" style=\\\"margin-top:12px\\\">\\n            <li><strong>Arrival & Settling</strong> — Gentle orientation, breathing cues, and alignment with the room.</li>\\n            <li><strong>Grounding</strong> — Low-frequency tones to anchor the nervous system.</li>\\n            <li><strong>Sonic Wave</strong> — Layered instruments (this event: crystal bowls + tuning forks + chime textures).</li>\\n            <li><strong>Stillness</strong> — Intentional silence and personal integration.</li>\\n            <li><strong>Return</strong> — Soft re-entry, tea, and optional check-in.</li>\\n          </ol>\\n        </div>\\n\\n        <div class=\\\"card\\\">\\n          <div style=\\\"font-weight:700\\\">What to bring</div>\\n          <ul style=\\\"margin-top:10px;color:#d9f7f0\\\">\\n            <li>Comfortable layers and socks</li>\\n            <li>A yoga mat and blanket for extra cushioning</li>\\n            <li>An eye pillow or scarf for darkness</li>\\n            <li>Water bottle (hydration encouraged)</li>\\n          </ul>\\n          <div style=\\\"margin-top:12px\\\" class=\\\"muted\\\">We provide mats, blankets, and eye pillows upon request — please note any allergies when you book.</div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section aria-labelledby=\\\"safety\\\">\\n      <h2 id=\\\"safety\\\" style=\\\"color:#e8fff9\\\">Safety, contraindications & accessibility</h2>\\n      <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n        <p class=\\\"muted\\\">Sound baths are safe for most, but we make clear, clinical recommendations to ensure inclusivity and wellbeing.</p>\\n        <ul style=\\\"margin-top:12px;color:#d9f7f0\\\">\\n          <li><strong>Contraindications:</strong> If you have epilepsy, uncontrolled psychiatric conditions, or recent head trauma, consult your healthcare provider before attending.</li>\\n          <li><strong>Pregnancy:</strong> Gentle sound is usually okay; inform the facilitator so we can adapt volume & proximity.</li>\\n          <li><strong>Medical Devices:</strong> If you have pacemakers or sensitive implants, let us know; some instruments emit frequencies that may interfere.</li>\\n        </ul>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:10px\\\">If in doubt, contact us at {{EMAIL}} or call {{PHONE}} for a pre-session consult.</p>\\n      </div>\\n    </section>\\n\\n    <section aria-labelledby=\\\"cta\\\">\\n      <h2 id=\\\"cta\\\" style=\\\"color:#e8fff9\\\">Ready to experience a focused sound bath?</h2>\\n      <div class=\\\"card\\\" style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:12px\\\">\\n        <div>\\n          <div style=\\\"font-weight:700\\\">Private days · Group gatherings · Retreat direction</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Our VIP Day offer compresses private consultation, bespoke sound design, and one-on-one facilitation into an extended session.</div>\\n        </div>\\n        <div style=\\\"display:flex;gap:10px\\\">\\n          <a class=\\\"btn\\\" href=\\\"book.html\\\">Book a VIP Day</a>\\n          <a class=\\\"ghost\\\" href=\\\"contact.html\\\">Contact us</a>\\n        </div>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}}</div>\\n    <div style=\\\"margin-top:8px\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#9feee0;text-decoration:none\\\">{{EMAIL}}</a> · {{PHONE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>FAQ — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071116;--card:#0d1a1d;--accent:#6fe6d6;--muted:#9bb0b4}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,var(--bg),#031018);color:#e6fbf7}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:14px 24px;position:sticky;top:0;background:linear-gradient(180deg,rgba(0,0,0,0.35),transparent);backdrop-filter:blur(6px);z-index:10}\\n    .brand{font-weight:700;color:var(--accent)}\\n    nav a{color:#cfeee8;text-decoration:none;margin-left:12px}\\n    main{max-width:1050px;margin:36px auto;padding:20px}\\n    .hero{padding:26px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);display:flex;gap:18px;align-items:center}\\n    .hero svg{width:120px;height:80px;border-radius:10px}\\n    h1{margin:0 0 6px 0}\\n    p.lead{color:var(--muted);margin:0}\\n    .grid{display:grid;grid-template-columns:1fr 360px;gap:20px;margin-top:22px}\\n    .faq-list{display:flex;flex-direction:column;gap:12px}\\n    .qa{background:var(--card);padding:16px;border-radius:10px}\\n    .q{font-weight:700}\\n    .a{color:var(--muted);margin-top:6px;font-size:14px}\\n    aside.card{background:linear-gradient(180deg,rgba(255,255,255,0.015),transparent);padding:16px;border-radius:10px;color:#dff8f1}\\n    .muted{color:var(--muted)}\\n    footer{padding:20px;text-align:center;color:var(--muted);font-size:13px;margin-top:30px}\\n    @media (max-width:920px){.grid{grid-template-columns:1fr}} \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Nest</a>\\n      <a href=\\\"events.html\\\">Upcoming</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n      <a href=\\\"contact.html\\\">Reach</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"hero\\\">\\n      <div>\\n        <h1>Questions answered — practical, clear, and sensory-forward</h1>\\n        <p class=\\\"lead\\\">Below are the most common queries about attending a sound bath at {{BUSINESS_NAME}}. If you don't find your question, reach out at {{EMAIL}}.</p>\\n      </div>\\n      <svg viewBox=\\\"0 0 200 120\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n        <defs>\\n          <linearGradient id=\\\"g2\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#094044\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#05313a\\\"/></linearGradient>\\n        </defs>\\n        <rect width=\\\"200\\\" height=\\\"120\\\" rx=\\\"8\\\" fill=\\\"url(#g2)\\\" />\\n        <g fill=\\\"#0fe3c7\\\" opacity=\\\"0.08\\\">\\n          <circle cx=\\\"36\\\" cy=\\\"36\\\" r=\\\"34\\\" />\\n          <circle cx=\\\"164\\\" cy=\\\"84\\\" r=\\\"26\\\" />\\n        </g>\\n      </svg>\\n    </div>\\n\\n    <div class=\\\"grid\\\">\\n      <div>\\n        <div class=\\\"faq-list\\\">\\n          <div class=\\\"qa\\\">\\n            <div class=\\\"q\\\">What should I bring to a sound bath?</div>\\n            <div class=\\\"a\\\">Comfortable clothing, a mat, extra blanket, and an eye pillow/scarf are ideal. We provide limited mats and pillows; reserve ahead if you need ours. Hydration before and after is recommended.</div>\\n          </div>\\n\\n          <div class=\\\"qa\\\">\\n            <div class=\\\"q\\\">Is it loud? Can I sleep?</div>\\n            <div class=\\\"a\\\">Sessions are intentionally calibrated and rarely painful. Some instruments (gongs or large metal bowls) can produce high decibel peaks; the facilitator modulates volume. Napping is common and welcomed — we guide a peaceful return to wakefulness.</div>\\n          </div>\\n\\n          <div class=\\\"qa\\\">\\n            <div class=\\\"q\\\">Who should not attend?</div>\\n            <div class=\\\"a\\\">Contraindications include uncontrolled seizures, recent cranial surgery, or unstable psychiatric conditions. If you have implanted medical devices (e.g., pacemaker), discuss with us before booking. Pregnant guests should notify the facilitator for adaptations.</div>\\n          </div>\\n\\n          <div class=\\\"qa\\\">\\n            <div class=\\\"q\\\">What instruments are used?</div>\\n            <div class=\\\"a\\\">We rotate instruments to shape distinct soundscapes. Recent offerings include crystal singing bowls, tuned chimes, a monochord drone, and a gentle gong bloom. Private sessions often include tuning forks for precise somatic work.</div>\\n          </div>\\n\\n          <div class=\\\"qa\\\">\\n            <div class=\\\"q\\\">How long is a typical session?</div>\\n            <div class=\\\"a\\\">Community baths are 75–90 minutes (arrival + ritual + 45–60 minute sound field + integration). Private sessions vary with VIP offerings extending to half- or full-day formats.</div>\\n          </div>\\n\\n          <div class=\\\"qa\\\">\\n            <div class=\\\"q\\\">Can I bring a partner or book a private session?</div>\\n            <div class=\\\"a\\\">Yes. We offer 1:1, couples, and corporate/private group sessions customized for intention and size. Visit the Private page or email {{EMAIL}} to coordinate logistics and pricing.</div>\\n          </div>\\n\\n          <div class=\\\"qa\\\">\\n            <div class=\\\"q\\\">Are refunds available?</div>\\n            <div class=\\\"a\\\">Refund and transfer policies are outlined on the booking page. Typically, transfers are accommodated up to 72 hours before an event; exceptions are handled case-by-case for medical reasons.</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <div style=\\\"font-weight:700\\\">Quick notes</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">If you are sensitive to sound or vibration, tell the facilitator at arrival — we can reposition you, lower volume, or adjust instrument selection. Our space is wheelchair accessible; notify us ahead of time for particular needs.</div>\\n        <hr style=\\\"border:none;height:1px;background:rgba(255,255,255,0.03);margin:12px 0\\\">\\n        <div style=\\\"font-weight:700\\\">Still have a question?</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#9feee0;text-decoration:none\\\">{{EMAIL}}</a>. For event-specific inquiries mention the event date.</div>\\n        <div style=\\\"margin-top:12px\\\"><a href=\\\"book.html\\\" class=\\\"btn\\\" style=\\\"display:inline-block;background:var(--accent);padding:10px 12px;border-radius:8px;color:#022323;text-decoration:none;font-weight:700\\\">Book a session</a></div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2 style=\\\"margin:0 0 10px 0\\\">Clinical guidance</h2>\\n      <div class=\\\"qa\\\" style=\\\"background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent)\\\">\\n        <div class=\\\"q\\\">How do you structure trauma-informed soundwork?</div>\\n        <div class=\\\"a\\\">We use predictable cues, give control to participants (ability to leave or signal pause), and avoid surprise ascents in volume. Our facilitators are trained to support physiological regulation and to offer grounding practices pre- and post-sound field. If you wish a deeper screening call before attending, we are available.</div>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div>{{BUSINESS_NAME}} — Curated sound + somatic clarity</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#021214;--card:#082529;--accent:#6fe6d6;--brand:#0fe3c7}\\n    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,var(--bg),#001215);color:#e6fbf7}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:14px 22px;position:sticky;top:0;background:rgba(0,0,0,0.35);backdrop-filter:blur(6px);z-index:10}\\n    .brand{font-weight:700;color:var(--brand)}\\n    nav a{color:#cfeee8;text-decoration:none;margin-left:12px}\\n    main{max-width:980px;margin:34px auto;padding:20px}\\n    .grid{display:grid;grid-template-columns:1fr 340px;gap:20px}\\n    .form{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:12px}\\n    label{display:block;font-size:13px;margin-top:12px;color:#cfeee8}\\n    input,select,textarea{width:100%;padding:10px;margin-top:6px;border-radius:8px;background:#021615;border:1px solid rgba(255,255,255,0.02);color:#dff8f1}\\n    .row{display:flex;gap:10px}\\n    .btn{display:inline-block;background:var(--accent);color:#072626;padding:10px 12px;border-radius:10px;text-decoration:none;border:none;font-weight:700;margin-top:14px}\\n    .side{background:linear-gradient(180deg,rgba(255,255,255,0.015),transparent);padding:18px;border-radius:12px}\\n    .muted{color:#9fb6b2;font-size:14px}\\n    .pricing{display:flex;flex-direction:column;gap:10px;margin-top:12px}\\n    .pkg{background:#062222;padding:12px;border-radius:10px;color:#dff8f1}\\n    .small{font-size:13px;color:#9fb6b2}\\n    footer{margin-top:28px;text-align:center;color:#9fb6b2}\\n    @media (max-width:920px){.grid{grid-template-columns:1fr}} \\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">{{BUSINESS_NAME}}</div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Events</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"faq.html\\\">FAQ</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div style=\\\"margin-bottom:18px\\\">\\n      <h1 style=\\\"margin:0 0 6px 0\\\">Reserve your place</h1>\\n      <p class=\\\"muted\\\" style=\\\"margin:0\\\">Secure a seat at an upcoming sound bath or request a private VIP Day. We confirm bookings by phone or email.</p>\\n    </div>\\n\\n    <div class=\\\"grid\\\">\\n      <div class=\\\"form\\\" aria-labelledby=\\\"booking-form\\\">\\n        <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"POST\\\">\\n          <input type=\\\"hidden\\\" name=\\\"source\\\" value=\\\"web-booking\\\">\\n          <label for=\\\"type\\\">Type of booking</label>\\n          <select id=\\\"type\\\" name=\\\"type\\\">\\n            <option>Community event</option>\\n            <option>1:1 private</option>\\n            <option>Couples session</option>\\n            <option>Corporate / group</option>\\n            <option>VIP Day</option>\\n          </select>\\n\\n          <div class=\\\"row\\\">\\n            <div style=\\\"flex:1\\\">\\n              <label for=\\\"fullName\\\">Full name</label>\\n              <input id=\\\"fullName\\\" name=\\\"fullName\\\" placeholder=\\\"Your name\\\" required />\\n            </div>\\n            <div style=\\\"width:150px\\\">\\n              <label for=\\\"phone\\\">Phone</label>\\n              <input id=\\\"phone\\\" name=\\\"phone\\\" placeholder=\\\"{{PHONE}}\\\" />\\n            </div>\\n          </div>\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@mail.com\\\" required />\\n\\n          <label for=\\\"date\\\">Preferred date</label>\\n          <input id=\\\"date\\\" name=\\\"date\\\" type=\\\"date\\\" value=\\\"{{NEXT_EVENT_DATE}}\\\" />\\n\\n          <label for=\\\"guests\\\">Number of guests</label>\\n          <input id=\\\"guests\\\" name=\\\"guests\\\" type=\\\"number\\\" min=\\\"1\\\" value=\\\"1\\\" />\\n\\n          <label for=\\\"notes\\\">Notes / Contraindications</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Please tell us about pregnancy, implanted devices, epilepsy, or anything else we should know.\\\"></textarea>\\n\\n          <div style=\\\"display:flex;align-items:center;gap:12px;margin-top:14px\\\">\\n            <button type=\\\"submit\\\" class=\\\"btn\\\">Confirm booking</button>\\n            <a href=\\\"contact.html\\\" class=\\\"small\\\" style=\\\"color:#9feee0;text-decoration:none\\\">Need a consult first?</a>\\n          </div>\\n\\n          <div class=\\\"small muted\\\" style=\\\"margin-top:10px\\\">By booking you acknowledge our safety guidelines and refund policy. We will contact you within 48 hours to finalize details.</div>\\n        </form>\\n      </div>\\n\\n      <aside class=\\\"side\\\">\\n        <div style=\\\"font-weight:700\\\">Packages & rates</div>\\n        <div class=\\\"pricing\\\">\\n          <div class=\\\"pkg\\\">\\n            <div style=\\\"font-weight:700\\\">Community drop-in</div>\\n            <div class=\\\"small\\\">$35 — includes mats & blankets on request. Group size limited to keep the field intimate.</div>\\n          </div>\\n\\n          <div class=\\\"pkg\\\">\\n            <div style=\\\"font-weight:700\\\">1:1 private session</div>\\n            <div class=\\\"small\\\">$140 — 60 minutes tailored to somatic goals and sound alignment. Includes pre-session consult.</div>\\n          </div>\\n\\n          <div class=\\\"pkg\\\">\\n            <div style=\\\"font-weight:700\\\">VIP Day</div>\\n            <div class=\\\"small\\\">From $950 — Full-day immersion: private sound design, integration coaching, and a bespoke instrument suite (monochord, crystal bowls, tuning forks).</div>\\n          </div>\\n        </div>\\n\\n        <hr style=\\\"border:none;height:1px;background:rgba(255,255,255,0.03);margin:12px 0\\\">\\n\\n        <div style=\\\"font-weight:700\\\">How bookings are confirmed</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">We hold provisional space for 48 hours pending payment. For corporate or VIP bookings we require a written agreement and 30% deposit.</div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <div style=\\\"font-weight:700\\\">Location</div>\\n          <div class=\\\"muted\\\">Sessions typically take place at {{VENUE_NAME}} in {{CITY}}. Private bookings can be arranged on-site or at your venue.</div>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <a class=\\\"btn\\\" href=\\\"mailto:{{EMAIL}}\\\" style=\\\"display:inline-block\\\">Email to hold space</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <h2 style=\\\"margin:0 0 10px 0\\\">Day-of guidance</h2>\\n      <div class=\\\"form\\\" style=\\\"padding:14px\\\">\\n        <div class=\\\"muted\\\">Arrive 15–20 minutes early for orientation. If you need bolstering (extra blankets, props), indicate this in the booking notes. For private sessions we offer a short pre-sound interview to set intentions and review contraindications.</div>\\n      </div>\\n    </section>\\n  </main>\\n\\n  <footer>\\n    <div class=\\\"muted\\\">Questions? Call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#9feee0;text-decoration:none\\\">{{EMAIL}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
