'epilepsy').checked;\\n      var recent = document.getElementById('recent').checked;\\n      if(pacemaker || epilepsy || recent){\\n        var warn = 'We noticed a potential contraindication. Please include details in your message and we will contact you to adapt the session or recommend alternatives.';\\n        if(!confirm(warn + '\\\\n\\\\nContinue and send inquiry?')){return;}\\n      }\\n\\n      // assemble mailto as fallback (pre-fills email for manual sending)\\n      var name = encodeURIComponent(document.getElementById('name').value || '');\\n      var email = encodeURIComponent(document.getElementById('email').value || '');\\n      var phone = encodeURIComponent(document.getElementById('phone').value || '');\\n      var session = encodeURIComponent(document.getElementById('session').value || '');\\n      var date = encodeURIComponent(document.getElementById('date').value || '');\\n      var message = encodeURIComponent(document.getElementById('message').value || '');\\n      var body = 'Name: ' + name + '\\\\nEmail: ' + email + '\\\\nPhone: ' + phone + '\\\\nSession: ' + session + '\\\\nPreferred date: ' + date + '\\\\n\\\\n' + 'Notes: ' + message;\\n      var mail = 'mailto:{{EMAIL}}?subject=' + encodeURIComponent('[Inquiry] ' + session + ' — ' + name) + '&body=' + body;\\n\\n      // For VIP days we typically follow up with a scheduling link; open mailto and show a confirmation message\\n      window.open(mail, '_blank');\\n      alert('Thanks — an email window has opened to send your inquiry. We will reply within 48 hours.');\\n      this.reset();\\n    });\\n  </script>\\n</body>\\n</html>\"} \n{\"path\":\"README.md\",\"content\":\"Project: sound_bath\\nSlug: sound_bath-2026-02-16T12-52-26-228Z-024\\nSeed: 2607187760\\nLayout family: bold_playful\\nVoice: practical_guide\\nOffer model: vip_day\\n\\nOverview:\\nThis bundle contains the contact page (contact.html) and this README. The contact page is designed for a premium, sensory-focused sound bath b