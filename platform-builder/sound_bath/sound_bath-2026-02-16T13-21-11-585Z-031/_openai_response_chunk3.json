          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>{{BUSINESS_NAME}} — About our Sound Ritual</title>\\n  <style>\\n    :root{--bg:#0f1720;--card:#0b1220;--muted:#9aa4ac;--accent:#8fd3c7;--accent2:#5b9ad6;--glass: rgba(255,255,255,0.04);font-family:Inter, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg) 10%, #071026 100%);color:#e6eef6}\\n    body{line-height:1.5;-webkit-font-smoothing:antialiased}\\n    .page{max-width:980px;margin:40px auto;padding:28px}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:56px;height:56px;display:grid;place-items:center;border-radius:12px;background:linear-gradient(135deg,var(--accent) 0%,var(--accent2) 100%);box-shadow:0 6px 24px rgba(11,18,32,0.6)}\\n    .logo svg{width:34px;height:34px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:14px}\\n    nav a:hover{color:#fff}\\n\\n    .hero{display:grid;grid-template-columns:1fr;gap:18px;padding:28px;border-radius:14px;background:linear-gradient(180deg, rgba(255,255,255,0.02), transparent);box-shadow:inset 0 1px 0 rgba(255,255,255,0.02)}\\n    .hero-inner{display:flex;gap:22px;align-items:center}\\n    .hero .title{font-size:24px;font-weight:600;color:#fff}\\n    .subtitle{color:var(--muted);font-size:15px}\\n    .cta{background:linear-gradient(90deg,var(--accent) 0%,var(--accent2) 100%);padding:10px 14px;border-radius:10px;color:#05222b;text-decoration:none;font-weight:600}\\n\\n    .columns{display:grid;grid-template-columns:1fr 320px;gap:22px;margin-top:22px}\\n    .card{background:var(--card);padding:20px;border-radius:12px;box-shadow:0 6px 30px rgba(2,6,23,0.6)}\\n    h2{margin:0 0 12px 0;color:#fff}\\n    p{margin:0 0 12px;color:var(--muted)}\\n    ul{margin:12px 0 12px 18px;color:var(--muted)}\\n    .muted{color:var(--muted);font-size:13px}\\n\\n    footer{margin-top:28px;color:var(--muted);font-size:13px}\\n\\n    /* subtle pattern */\\n    .pattern{position:absolute;inset:0;pointer-events:none;opacity:0.06;background-image:url('assets/img/pattern.svg');background-size:420px}\\n\\n    /* responsive */\\n    @media (max-width:880px){.columns{grid-template-columns:1fr}.page{margin:18px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern\\\" aria-hidden=\\\"true\\\"></div>\\n  <div class=\\\"page\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\" aria-hidden=\\\"true\\\">\\n          <!-- meditative ripple monogram -->\\n          <svg viewBox=\\\"0 0 64 64\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n            <rect width=\\\"64\\\" height=\\\"64\\\" rx=\\\"12\\\" fill=\\\"white\\\" opacity=\\\"0.06\\\"/>\\n            <g transform=\\\"translate(6 6)\\\" stroke=\\\"#042d31\\\" stroke-opacity=\\\"0.6\\\">\\n              <circle cx=\\\"26\\\" cy=\\\"26\\\" r=\\\"18\\\" fill=\\\"url(#g)\\\"/>\\n            </g>\\n            <defs>\\n              <linearGradient id=\\\"g\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n                <stop offset=\\\"0\\\" stop-color=\\\"#8fd3c7\\\"/>\\n                <stop offset=\\\"1\\\" stop-color=\\\"#5b9ad6\\\"/>\\n              </linearGradient>\\n            </defs>\\n          </svg>\\n        </div>\\n        <div>\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div class=\\\"muted\\\">A restful space for intentional listening</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Gather</a>\\n        <a href=\\\"events.html\\\">Upcoming</a>\\n        <a href=\\\"private-sessions.html\\\">1:1 & Private</a>\\n        <a href=\\\"pricing.html\\\">Contribute</a>\\n        <a href=\\\"about.html\\\">About</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero card\\\">\\n      <div class=\\\"hero-inner\\\">\\n        <div>\\n          <div class=\\\"title\\\">We craft sound to return you to the present.</div>\\n          <div class=\\\"subtitle\\\">Small, intentionally held sound baths and a membership for regular practice — restorative, sensory, and curated for comfort.</div>\\n        </div>\\n        <div style=\\\"margin-left:auto\\\">\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"columns\\\">\\n        <div>\\n          <h2>Our practice — a modern ritual</h2>\\n          <p>At the heart of our gatherings is a slow arc: settling, immersion, and gentle return. We combine harmonic instruments and breath cues so the sound supports internal attention without overwhelm. Sessions are led with attention to safety, scent-free atmosphere, and dim, comforting light.</p>\\n\\n          <h2 style=\\\"margin-top:18px\\\">How a session flows</h2>\\n          <ul>\\n            <li>Arrival & soft seating (10–15 minutes) — a guided centering.</li>\\n            <li>Main soundscape (30–45 minutes) — layered textures with crystal bowls and chimes, a bowed monochord, and subtle tuning forks for resonance.</li>\\n            <li>Rest & integration (10–15 minutes) — quiet, with optional journaling prompts.</li>\\n            <li>Closing circle — gentle cues to re-orient and share if desired.</li>\\n          </ul>\\n\\n          <h2 style=\\\"margin-top:18px\\\">What to bring</h2>\\n          <ul>\\n            <li>A blanket and pillow for comfort (we provide a limited supply on request).</li>\\n            <li>An eye-cover or sleep mask to deepen the experience.</li>\\n            <li>Water and any personal props that help you settle.</li>\\n          </ul>\\n\\n          <p class=\\\"muted\\\">If you have implanted medical devices, are pregnant, or have a history of seizure, please consult with your healthcare provider and contact us before attending. Our sessions are low-volume but include low-frequency energy; we will always adapt for safety and comfort.</p>\\n        </div>\\n\\n        <aside class=\\\"card\\\">\\n          <h2>Membership & Access</h2>\\n          <p>Members enjoy priority booking, sliding scale events, and an ongoing series of monthly rituals. Memberships are tailored to encourage regular practice and community — ideal for anyone seeking a steady, sensory practice.</p>\\n          <p><strong>Perks:</strong></p>\\n          <ul>\\n            <li>Two included drops per month</li>\\n            <li>10% off private sessions</li>\\n            <li>Member-only sound explorations</li>\\n          </ul>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"display:inline-block;margin-top:12px\\\">Join the Circle</a>\\n\\n          <hr style=\\\"border:none;height:1px;background:rgba(255,255,255,0.03);margin:16px 0\\\" />\\n\\n          <h3 style=\\\"margin:0 0 10px 0\\\">Meet the facilitator</h3>\\n          <p class=\\\"muted\\\">{{FACILITATOR_NAME}} blends somatic listening, breathwork, and a patient musical touch to create spacious, empathic sound fields. Trained in therapeutic accompaniment and acoustic instrument crafting.</p>\\n\\n          <p style=\\\"margin-top:10px\\\" class=\\\"muted\\\">Venue: {{VENUE_NAME}} • {{CITY}}, {{STATE}}</p>\\n        </aside>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>Questions? Call <strong>{{PHONE}}</strong> or email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:underline\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>FAQ • {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#07121a;--card:#081220;--muted:#9fb0bf;--accent:#b0e6d8;--glass:rgba(255,255,255,0.03);font-family:Georgia, 'Times New Roman', serif}\\n    body{margin:0;background:linear-gradient(180deg,#061219 0%,#071526 100%);color:#eaf4f2}\\n    .wrap{max-width:920px;margin:28px auto;padding:22px}\\n    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}\\n    .nav{font-size:14px}\\n    .nav a{color:var(--muted);text-decoration:none;margin-left:16px}\\n    .hero{padding:26px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);box-shadow:0 8px 30px rgba(2,6,23,0.6)}\\n    h1{margin:0 0 6px 0;font-size:22px}\\n    p.lead{color:var(--muted);margin:0 0 12px 0}\\n\\n    .faq-grid{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:16px}\\n    .panel{background:var(--card);padding:18px;border-radius:12px}\\n    .q{font-weight:700;color:#fff;margin:14px 0 6px}\\n    .a{color:var(--muted);margin:0 0 8px}\\n\\n    .aside{padding:16px;border-radius:12px;background:linear-gradient(90deg,rgba(176,230,216,0.04),transparent)}\\n    .aside h3{margin:0 0 8px 0}\\n    .pill{display:inline-block;padding:8px 10px;border-radius:999px;background:rgba(255,255,255,0.03);color:var(--muted);font-size:13px;margin-top:10px}\\n\\n    .pattern{position:fixed;right:0;top:0;height:100vh;width:420px;opacity:0.05;background-image:url('assets/img/pattern.svg');background-size:contain;pointer-events:none}\\n\\n    @media (max-width:880px){.faq-grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern\\\" aria-hidden=\\\"true\\\"></div>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"color:var(--muted);font-size:13px\\\">Curated sound gatherings • membership offered</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Next</a>\\n        <a href=\\\"book.html\\\">Reserve</a>\\n        <a href=\\\"about.html\\\">Team</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero panel\\\">\\n      <h1>Common Questions, answered with care</h1>\\n      <p class=\\\"lead\\\">Sensitive, premium sound events — our answers help you arrive prepared and comfortable. If something's not here, contact us at <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:inherit\\\">{{EMAIL}}</a>.</p>\\n\\n      <div class=\\\"faq-grid\\\">\\n        <div>\\n          <div class=\\\"q\\\">Are these sessions loud?</div>\\n          <div class=\\\"a\\\">No. Our work emphasizes texture, harmonic layering, and low-frequency presence without startling volume. Instruments include gongs, tuning forks, and a bowed monochord for deep, resonant tones tuned to support the body’s natural rhythms.</div>\\n\\n          <div class=\\\"q\\\">How early should I arrive?</div>\\n          <div class=\\\"a\\\">Please arrive 10–15 minutes before the published start time to settle into a cushion and complete any brief intake. Doors close a few minutes into the session to preserve the group field.</div>\\n\\n          <div class=\\\"q\\\">What should I bring?</div>\\n          <div class=\\\"a\\\">Bring a blanket, pillow, and an eye cover if you prefer darkness. We supply a limited number of mats and blankets on request; please note availability when booking.</div>\\n\\n          <div class=\\\"q\\\">Do you accommodate pregnancy or medical devices?</div>\\n          <div class=\\\"a\\\">We include a contraindications consult for anyone pregnant, with implanted medical devices, severe tinnitus, or a history of seizures. Please email us ahead of time; we will suggest adaptations or private alternatives.</div>\\n\\n          <div class=\\\"q\\\">Refunds and cancellations?</div>\\n          <div class=\\\"a\\\">Cancellations more than 72 hours before event receive a full refund. Within 72 hours, we offer credit toward another session. Membership credits and policies vary — see booking or contact us.</div>\\n\\n          <div class=\\\"q\\\">What if I'm sensitive to sound?</div>\\n          <div class=\\\"a\\\">We offer a seat toward the back and can lower certain sources. Let the facilitator know upon arrival. Earplugs are welcome and often useful for people who prefer softened textures.</div>\\n        </div>\\n\\n        <aside class=\\\"aside\\\">\\n          <h3>Quick notes</h3>\\n          <div class=\\\"pill\\\">Next event: {{NEXT_EVENT_DATE}}</div>\\n          <p style=\\\"margin-top:12px;color:var(--muted)\\\">Membership holders have priority booking and a short intro call with {{FACILITATOR_NAME}}. Members are also offered occasional sound experiments and small-group sessions.</p>\\n\\n          <h3 style=\\\"margin-top:14px\\\">Safety & health</h3>\\n          <p class=\\\"muted\\\">This is not a replacement for medical care. Inform us of any conditions you think may be relevant. We will adapt practice to minimize risk. If in doubt, consult your provider.</p>\\n\\n          <h3 style=\\\"margin-top:14px\\\">Need help booking?</h3>\\n          <p class=\\\"muted\\\">Call <strong>{{PHONE}}</strong> or <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:inherit\\\">email us</a>. For group and corporate requests see Private Sessions.</p>\\n        </aside>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted);font-size:13px\\\">If you prefer to speak, we're happy to guide you through membership and private options — {{PHONE}}.</footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Reserve • {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#07121a;--panel:#081726;--muted:#91a6b1;--accent:#7fe2cf;--accent2:#6aa7e3;font-family:Inter, system-ui, -apple-system, 'Segoe UI'}\\n    body{margin:0;background:linear-gradient(180deg,#03121a 0%,#071726 100%);color:#e8f6f5}\\n    .shell{max-width:960px;margin:26px auto;padding:22px}\\n    header{display:flex;align-items:center;justify-content:space-between}\\n    .nav a{color:var(--muted);text-decoration:none;margin-left:16px}\\n\\n    .booking{display:grid;grid-template-columns:1fr 380px;gap:18px;margin-top:18px}\\n    .card{background:var(--panel);padding:18px;border-radius:12px}\\n    h1{margin:0 0 8px 0}\\n    label{display:block;margin-top:12px;color:var(--muted);font-size:14px}\\n    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:rgba(255,255,255,0.02);color:#eaf7f6}\\n    .btn{display:inline-block;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,var(--accent),var(--accent2));color:#042a2f;font-weight:700;text-decoration:none;margin-top:12px}\\n    .muted{color:var(--muted);font-size:13px}\\n\\n    .pattern{position:fixed;left:0;bottom:0;width:360px;height:360px;opacity:0.06;background-image:url('assets/img/pattern.svg');background-size:cover;pointer-events:none}\\n\\n    @media (max-width:880px){.booking{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern\\\" aria-hidden=\\\"true\\\"></div>\\n  <div class=\\\"shell\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">Reserve • {{BUSINESS_NAME}}</div>\\n        <div class=\\\"muted\\\">Memberships, single events, and bespoke bookings</div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Back</a>\\n        <a href=\\\"events.html\\\">Events</a>\\n        <a href=\\\"private-sessions.html\\\">Private</a>\\n        <a href=\\\"faq.html\\\">FAQ</a>\\n      </nav>\\n    </header>\\n\\n    <main class=\\\"booking\\\">\\n      <section class=\\\"card\\\">\\n        <h1>Reserve your spot</h1>\\n        <p class=\\\"muted\\\">Select a date, tell us if it’s your first time, and choose a membership option if you'd like ongoing access.</p>\\n\\n        <form method=\\\"post\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\">\\n          <label for=\\\"type\\\">Booking Type</label>\\n          <select id=\\\"type\\\" name=\\\"type\\\">\\n            <option value=\\\"drop\\\">Drop-in (single event)</option>\\n            <option value=\\\"membership\\\">Monthly Membership</option>\\n            <option value=\\\"private\\\">Private Session (1:1 / Couples / Corporate)</option>\\n          </select>\\n\\n          <label for=\\\"date\\\">Preferred date</label>\\n          <input id=\\\"date\\\" name=\\\"date\\\" placeholder=\\\"YYYY-MM-DD\\\" />\\n\\n          <label for=\\\"name\\\">Full name</label>\\n          <input id=\\\"name\\\" name=\\\"name\\\" required />\\n\\n          <label for=\\\"email\\\">Email</label>\\n          <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required />\\n\\n          <label for=\\\"notes\\\">Notes & Accessibility</label>\\n          <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Tell us about mobility needs, sensitivities, or preferences\\\"></textarea>\\n\\n          <label for=\\\"promo\\\">Promo code / membership</label>\\n          <input id=\\\"promo\\\" name=\\\"promo\\\" />\\n\\n          <div style=\\\"margin-top:10px\\\" class=\\\"muted\\\">By reserving you acknowledge the contraindications listed on our FAQ. If pregnant, have implants, severe tinnitus, or are recovering from surgery, please contact us before booking.</div>\\n\\n          <button class=\\\"btn\\\" type=\\\"submit\\\">Reserve Spot</button>\\n        </form>\\n\\n        <hr style=\\\"border:none;height:1px;background:rgba(255,255,255,0.03);margin:18px 0\\\" />\\n\\n        <h3 style=\\\"margin:0 0 8px 0\\\">Private session requests</h3>\\n        <p class=\\\"muted\\\">For 1:1, couple, or corporate requests, choose \\\"Private Session\\\" above and include preferred dates in the notes. We respond within 48 hours with availability and tailored pricing.</p>\\n\\n        <p style=\\\"margin-top:12px\\\" class=\\\"muted\\\">Questions? Call <strong>{{PHONE}}</strong> or <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:inherit\\\">email</a>.</p>\\n      </section>\\n\\n      <aside class=\\\"card\\\">\\n        <h2>Booking snapshot</h2>\\n        <p class=\\\"muted\\\">Quick details to guide your decision.</p>\\n\\n        <h3 style=\\\"margin-top:12px\\\">Typical durations</h3>\\n        <ul class=\\\"muted\\\">\\n          <li>Drop-in group ritual — 60–75 minutes</li>\\n          <li>Private 1:1 — 60 minutes (customizable)</li>\\n          <li>Couples — 75 minutes</li>\\n        </ul>\\n\\n        <h3 style=\\\"margin-top:12px\\\">Sample instruments</h3>\\n        <p class=\\\"muted\\\">Sessions are curated from a rotating palette: crystal singing bowls, chimes, kalimba, and gentle bowed instruments. Private bookings can request specific instrument focuses.</p>\\n\\n        <h3 style=\\\"margin-top:12px\\\">Pricing overview</h3>\\n        <p class=\\\"muted\\\">Drop-in pricing, membership tiers, and private rates are available on our Pricing page. Memberships grant booking priority and discounts on private sessions.</p>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <a class=\\\"btn\\\" href=\\\"pricing.html\\\">See Pricing</a>\\n        </div>\\n\\n        <hr style=\\\"border:none;height:1px;background:rgba(255,255,255,0.03);margin:16px 0\\\" />\\n        <p class=\\\"muted\\\"><strong>Location:</strong> {{VENUE_NAME}}, {{CITY}}, {{STATE}}</p>\\n        <p class=\\\"muted\\\">Please arrive 10–15 minutes early to settle. Doors close shortly after the start to preserve a held field for the group.</p>\\n      </aside>\\n    </main>\\n\\n    <footer style=\\\"margin-top:18px;color:var(--muted);font-size:13px\\\">If you need assistance booking multiple seats or a corporate event, contact us at {{EMAIL}} or call {{PHONE}}.</footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
