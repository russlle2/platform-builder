          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#6F4EF0;--muted:#5B6B6F;--bg1:linear-gradient(180deg,#0f1724 0%,#071021 100%);--glass:rgba(255,255,255,0.06)}\\n    *{box-sizing:border-box}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto;line-height:1.45;color:#e6eef8;background:var(--bg1);min-height:100vh}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 28px;background:linear-gradient(90deg,rgba(255,255,255,0.02),transparent);backdrop-filter:blur(6px)}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:46px;height:46px;background:radial-gradient(circle at 30% 30%,#9dd3ff,transparent 20%),radial-gradient(circle at 70% 70%,#ffd9f7,transparent 20%),var(--accent);border-radius:12px;box-shadow:0 6px 18px rgba(111,78,240,0.22)}\\n    nav a{color:#cfe7ff;text-decoration:none;margin-left:18px;font-weight:600;font-size:14px}\\n    .cta-small{background:transparent;border:1px solid rgba(255,255,255,0.08);padding:8px 12px;border-radius:10px;color:#e9f4ff}\\n    .wrap{max-width:1100px;margin:36px auto;padding:28px}\\n    .hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    .hero-card{background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:28px;border-radius:14px;border:1px solid rgba(255,255,255,0.03);box-shadow:0 10px 30px rgba(0,0,0,0.45)}\\n    .kicker{color:#cfe7ff;font-weight:700;letter-spacing:0.06em}\\n    h1{margin:12px 0 8px;color:white;font-size:34px}\\n    p.lead{color:var(--muted);margin:0 0 18px}\\n    .meta{display:flex;gap:12px;margin-top:14px}\\n    .pill{background:var(--glass);padding:8px 12px;border-radius:999px;color:#dfefff;font-weight:600}\\n    aside .card{background:linear-gradient(180deg,rgba(255,255,255,0.01),rgba(255,255,255,0.02));padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .section{margin-top:28px}\\n    .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\\n    .benefit{padding:18px;background:rgba(255,255,255,0.02);border-radius:12px}\\n    .process{display:flex;flex-direction:column;gap:12px}\\n    .step{display:flex;gap:12px;align-items:flex-start}\\n    .num{background:linear-gradient(180deg,var(--accent),#9b7cf3);width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:white;font-weight:700}\\n    footer{margin:48px 0 18px;color:#9fb3c9;text-align:center;font-size:13px}\\n    .testimonial{border-left:3px solid rgba(255,255,255,0.04);padding-left:12px;color:#d6ebff}\\n    a.primary{background:linear-gradient(90deg,var(--accent),#8bd3ff);padding:12px 18px;border-radius:12px;color:#04203a;font-weight:800;text-decoration:none}\\n    .pattern{position:fixed;inset:0;z-index:-1;opacity:0.18;background-image:url('/assets/img/pattern.svg');background-repeat:repeat}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern\\\" aria-hidden></div>\\n  <header>\\n    <div class=\\\"brand\\\"><div class=\\\"logo\\\" aria-hidden></div><div style=\\\"color:#dff7ff;font-weight:700\\\">{{BUSINESS_NAME}}</div></div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Gatherings</a>\\n      <a href=\\\"private-sessions.html\\\">Sessions</a>\\n      <a class=\\\"cta-small\\\" href=\\\"pricing.html\\\">Invest</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"hero-card\\\">\\n        <div class=\\\"kicker\\\">About the Practice</div>\\n        <h1>Designing a space for attuned listening</h1>\\n        <p class=\\\"lead\\\">At {{BUSINESS_NAME}} we fuse a clinical calm with sensory craft to guide premium sound baths and restorative sessions. Our facilitation is evidence-informed, attentive, and seasonally tuned.</p>\\n        <div class=\\\"meta\\\">\\n          <div class=\\\"pill\\\">Facilitator: {{FACILITATOR_NAME}}</div>\\n          <div class=\\\"pill\\\">Hybrid model — in-person &amp; remote</div>\\n        </div>\\n\\n        <div class=\\\"section\\\">\\n          <h3 style=\\\"color:#dff7ff\\\">Our sonic vocabulary</h3>\\n          <p style=\\\"color:var(--muted)\\\">We select instruments to sculpt space: crystal singing bowls, koshi chimes, bowed monochord and hand-held tuning forks. Choices are intentional to create long, harmonically-rich textures that support breath and attention.</p>\\n        </div>\\n\\n        <div class=\\\"section\\\">\\n          <h3 style=\\\"color:#dff7ff\\\">How a group session feels</h3>\\n          <div class=\\\"process\\\">\\n            <div class=\\\"step\\\"><div class=\\\"num\\\">1</div><div><strong>Arrival & settling</strong><div style=\\\"color:var(--muted)\\\">Soft lighting, cushioned mats, brief orientation and an invitation to set intention.</div></div></div>\\n            <div class=\\\"step\\\"><div class=\\\"num\\\">2</div><div><strong>Listening arc</strong><div style=\\\"color:var(--muted)\\\">Layered timbres build and release — a 45–60 minute sound landscape that supports physiological downshift.</div></div></div>\\n            <div class=\\\"step\\\"><div class=\\\"num\\\">3</div><div><strong>Reintegration</strong><div style=\\\"color:var(--muted)\\\">Gentle reawakening with space for journaling or sharing; practical suggestions to extend benefits at home.</div></div></div>\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0;color:#e9fbff\\\">Curated for clarity</h4>\\n          <p style=\\\"color:var(--muted);margin-top:8px\\\">Sessions are crafted to regulate the nervous system. Expect intentional tempo, harmonic overlap, and pockets of silence as part of the therapeutic field.</p>\\n\\n          <div style=\\\"margin-top:12px\\\"><strong style=\\\"color:#dff7ff\\\">Next group offering</strong><div style=\\\"color:var(--muted);margin-top:6px\\\">See events to reserve a place — intimate capacity to preserve a premium experience.</div></div>\\n          <div style=\\\"margin-top:16px\\\"><a class=\\\"primary\\\" href=\\\"events.html\\\">View upcoming</a></div>\\n        </div>\\n\\n        <div style=\\\"height:18px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0;color:#e9fbff\\\">What we value</h4>\\n          <ul style=\\\"color:var(--muted);margin-top:10px;padding-left:18px\\\">\\n            <li>Safety & consent</li>\\n            <li>Accessible facilitation</li>\\n            <li>Evidence-minded orchestration</li>\\n          </ul>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h3 style=\\\"color:#dff7ff\\\">Stories & social proof</h3>\\n      <div class=\\\"grid-3\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"benefit testimonial\\\"><strong>\\\"Deeply settling\\\"</strong><div style=\\\"color:var(--muted);margin-top:8px\\\">\\\"I left feeling clearer and more present than I have in months.\\\" — A. (attendee)</div></div>\\n        <div class=\\\"benefit testimonial\\\"><strong>\\\"Skilful facilitation\\\"</strong><div style=\\\"color:var(--muted);margin-top:8px\\\">\\\"The sequencing felt thoughtful and grounding.\\\" — M. (return participant)</div></div>\\n        <div class=\\\"benefit testimonial\\\"><strong>\\\"Professional care\\\"</strong><div style=\\\"color:var(--muted);margin-top:8px\\\">\\\"Accessible instructions and safe container — perfect for first-timers.\\\" — J. (newcomer)</div></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h3 style=\\\"color:#dff7ff\\\">Private facilitation</h3>\\n      <p style=\\\"color:var(--muted)\\\">1:1, couples, and bespoke corporate sessions are available. We design each encounter to the needs of the group or individual using a diagnostic intake and outcome-oriented pacing.</p>\\n      <div style=\\\"margin-top:12px\\\"><a class=\\\"primary\\\" href=\\\"private-sessions.html\\\">Explore private options</a></div>\\n    </section>\\n\\n    <section class=\\\"section\\\">\\n      <h3 style=\\\"color:#dff7ff\\\">Subscribe — brief research notes & events</h3>\\n      <form style=\\\"display:flex;gap:8px;margin-top:10px;max-width:520px\\\">\\n        <input aria-label=\\\"Email\\\" placeholder=\\\"you@domain.com\\\" style=\\\"flex:1;padding:12px;border-radius:10px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:#dff7ff\\\">\\n        <button class=\\\"primary\\\" type=\\\"button\\\">Join</button>\\n      </form>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div>Questions? <a href=\\\"contact.html\\\">Contact us</a> • Call {{PHONE}}</div>\\n    <div style=\\\"margin-top:8px\\\">© {{BUSINESS_NAME}} — {{CITY}}, {{STATE}}</div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>FAQ — {{BUSINESS_NAME}}</title>\\n  <style>\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto;background:linear-gradient(180deg,#041021 0%,#081526 100%);color:#eaf6ff}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 28px}\\n    .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#8ad3ff,#a57cf5)}\\n    nav a{color:#cfe7ff;margin-left:16px;text-decoration:none}\\n    .wrap{max-width:1000px;margin:28px auto;padding:20px}\\n    h1{margin:6px 0 12px}\\n    .card{background:rgba(255,255,255,0.02);border-radius:12px;padding:18px;border:1px solid rgba(255,255,255,0.03)}\\n    .qa{display:grid;grid-template-columns:1fr 380px;gap:20px}\\n    .list{padding:0;margin:0;list-style:none}\\n    .q{margin:0 0 14px}\\n    .question{font-weight:700;color:#e6fbff}\\n    .answer{color:#bcdff5;margin-top:6px}\\n    .aside .card{background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent)}\\n    .pill{display:inline-block;padding:8px 12px;border-radius:999px;background:rgba(255,255,255,0.03);color:#dff7ff}\\n    .muted{color:#9fb3c9}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,#6F4EF0,#7bd3ff);color:#042035;font-weight:800;text-decoration:none}\\n    .pattern{position:fixed;inset:0;z-index:-1;opacity:0.12;background-image:url('/assets/img/pattern.svg');background-size:260px}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern\\\" aria-hidden></div>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\"><div class=\\\"logo\\\" aria-hidden></div><div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div></div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Start</a>\\n      <a href=\\\"events.html\\\">Events</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"pricing.html\\\">Fees</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <h1>Frequently Asked — practical answers</h1>\\n    <p class=\\\"muted\\\">Clinical clarity, quick answers. If you don’t see what you need, email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</p>\\n\\n    <div class=\\\"qa\\\" style=\\\"margin-top:18px\\\">\\n      <div>\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 10px\\\">General questions</h3>\\n\\n          <div class=\\\"q\\\">\\n            <div class=\\\"question\\\">What should I expect in a sound bath?</div>\\n            <div class=\\\"answer\\\">A guided listening experience: arrival, short orientation, a 45–60 minute sound field with gradual build and release, and a gentle re-entry. Expect lowered breath rate and an expanded felt sense of resonance rather than loud music.</div>\\n          </div>\\n\\n          <div class=\\\"q\\\">\\n            <div class=\\\"question\\\">What instruments do you use?</div>\\n            <div class=\\\"answer\\\">For group work we often combine crystal singing bowls, gong undertones, and rainstick textures to create layered, enveloping soundscapes — chosen to support resonance and sustained listening.</div>\\n          </div>\\n\\n          <div class=\\\"q\\\">\\n            <div class=\\\"question\\\">I’m new — can I attend?</div>\\n            <div class=\\\"answer\\\">Yes. Sessions are accessible to first-timers. We provide clear orientation, options for seated or reclined positioning, and staff support for sensory sensitivities.</div>\\n          </div>\\n\\n        </div>\\n\\n        <div style=\\\"height:18px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h3 style=\\\"margin:0 0 10px\\\">Practical details</h3>\\n\\n          <div class=\\\"q\\\">\\n            <div class=\\\"question\\\">What to bring?</div>\\n            <div class=\\\"answer\\\">A yoga mat or soft blanket, two pillows (one for under your knees), a light wrap, and optional earplugs if you prefer a gentler experience. We provide bolsters and extra blankets when possible.</div>\\n          </div>\\n\\n          <div class=\\\"q\\\">\\n            <div class=\\\"question\\\">Contraindications — what should I tell you?</div>\\n            <div class=\\\"answer\\\">If you are pregnant, have a pacemaker or other implanted medical device, recent head trauma, severe psychiatric conditions, or active seizures, please consult your physician and disclose during intake. Sound can be intense; we adapt when needed.</div>\\n          </div>\\n\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"aside\\\">\\n        <div class=\\\"card\\\">\\n          <div class=\\\"pill\\\">Need immediate help?</div>\\n          <div style=\\\"margin-top:10px;color:#bcdff5\\\">Call us: {{PHONE}}</div>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve a private session</a></div>\\n        </div>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div class=\\\"card\\\">\\n          <h4 style=\\\"margin:0;color:#eaf6ff\\\">More health notes</h4>\\n          <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">People sensitive to loud, low-frequency sound may experience dizziness or nausea. We recommend arriving rested and hydrated. Notify staff of any hearing devices or implants.</p>\\n        </div>\\n\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:20px\\\" class=\\\"card\\\">\\n      <h3 style=\\\"margin:0 0 8px\\\">Technical questions</h3>\\n      <div style=\\\"color:#bcdff5\\\">Sessions are delivered live in a curated acoustic space. Remote participants receive a modified mix optimized for headphones: clear harmonics, careful EQ, and less tactile low-end to avoid discomfort.</div>\\n    </section>\\n\\n  </main>\\n\\n  <footer style=\\\"text-align:center;padding:20px;color:#9fb3c9\\\">Questions not answered? Email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • © {{BUSINESS_NAME}}</footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:linear-gradient(180deg,#071627 0%,#02141a 100%);--accent:#7bd3ff}\\n    body{margin:0;font-family:Inter,system-ui,Arial;color:#eaf8ff;background:var(--bg1)}\\n    .container{max-width:980px;margin:32px auto;padding:20px}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:12px 0}\\n    .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#8ad3ff,#7c8df5)}\\n    nav a{color:#cfe7ff;margin-left:14px;text-decoration:none}\\n    .hero{display:flex;gap:22px;align-items:center}\\n    h1{margin:6px 0;font-size:30px}\\n    .sub{color:#bfe8ff}\\n    .panel{background:rgba(255,255,255,0.02);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    .flow{display:flex;flex-direction:column;gap:10px;margin-top:12px}\\n    .flow div{background:rgba(255,255,255,0.01);padding:12px;border-radius:10px}\\n    label{display:block;font-weight:700;margin-top:10px}\\n    input,select,textarea{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:#eaf8ff}\\n    button.book{margin-top:12px;background:linear-gradient(90deg,#7bd3ff,#9b7cf3);padding:12px 16px;border-radius:12px;border:none;font-weight:800;color:#042035}\\n    .note{color:#bcdff5;font-size:13px;margin-top:8px}\\n    .pattern{position:fixed;inset:0;z-index:-1;opacity:0.14;background-image:url('/assets/img/pattern.svg');background-size:200px}\\n    .small{font-size:13px;color:#9fb3c9}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern\\\" aria-hidden></div>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <div style=\\\"display:flex;gap:12px;align-items:center\\\"><div class=\\\"logo\\\" aria-hidden></div><div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div></div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Root</a>\\n        <a href=\\\"events.html\\\">Upcoming</a>\\n        <a href=\\\"private-sessions.html\\\">1:1 &amp; Groups</a>\\n        <a href=\\\"pricing.html\\\">Costs</a>\\n      </nav>\\n    </header>\\n\\n    <section class=\\\"hero\\\">\\n      <div style=\\\"flex:1\\\">\\n        <h1>Reserve your session</h1>\\n        <div class=\\\"sub\\\">Flexible bookings for group drops and private facilitation. Choose an offering and we'll confirm details.</div>\\n      </div>\\n      <div style=\\\"width:320px\\\" class=\\\"panel\\\">\\n        <div style=\\\"font-weight:700\\\">Quick options</div>\\n        <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Group drop-in (45–60 min) • Private 1:1 (60 min) • Couples (75 min) • Corporate wellness</div>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"book\\\" href=\\\"events.html\\\">See next event</a></div>\\n      </div>\\n    </section>\\n\\n    <div style=\\\"height:18px\\\"></div>\\n\\n    <div style=\\\"display:grid;grid-template-columns:1fr 360px;gap:20px\\\">\\n      <div>\\n        <div class=\\\"panel\\\">\\n          <h3 style=\\\"margin:0 0 6px\\\">Book a private or group session</h3>\\n          <form id=\\\"booking\\\" method=\\\"post\\\" action=\\\"{{PRIMARY_CTA_URL}}\\\">\\n            <label>Type of booking</label>\\n            <select name=\\\"type\\\">\\n              <option>Private 1:1 (60 min)</option>\\n              <option>Couples (75 min)</option>\\n              <option>Corporate sound session (custom)</option>\\n            </select>\\n\\n            <label>Preferred date</label>\\n            <input type=\\\"date\\\" name=\\\"date\\\" placeholder=\\\"Select date\\\">\\n\\n            <label>Contact phone or email</label>\\n            <input name=\\\"contact\\\" placeholder=\\\"Phone or email\\\">\\n\\n            <label>Notes — health, accessibility, goals</label>\\n            <textarea name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"E.g., pregnancy, implants, hearing devices, mobility\\\"></textarea>\\n\\n            <div class=\\\"note\\\">We will follow up to confirm details and intake questions. Our hybrid model allows remote or in-person delivery.</div>\\n\\n            <button class=\\\"book\\\" type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n          </form>\\n        </div>\\n\\n        <div style=\\\"height:14px\\\"></div>\\n\\n        <div class=\\\"panel\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">What to bring</h4>\\n          <ul style=\\\"color:#d7f3ff;margin-top:8px\\\">\\n            <li>Mat or blanket and an extra throw</li>\\n            <li>Pillow(s) for head and knees</li>\\n            <li>Layered clothing (rooms are meditative-warm)</li>\\n            <li>Optional: journal and pen</li>\\n          </ul>\\n\\n          <h4 style=\\\"margin-top:12px\\\">Contraindications & safety</h4>\\n          <p class=\\\"small\\\">Please inform us if you have a pacemaker or other implanted device, are pregnant, have recent head injury, epilepsy, or severe psychiatric conditions. Sound can produce physiological effects; we accommodate and adapt sessions for safety.</p>\\n        </div>\\n\\n        <div style=\\\"height:14px\\\"></div>\\n\\n        <div class=\\\"panel\\\">\\n          <h4 style=\\\"margin:0 0 8px\\\">Session flow (what will happen)</h4>\\n          <div class=\\\"flow\\\">\\n            <div><strong>Check-in</strong> — brief intake to set intention and note accommodations.</div>\\n            <div><strong>Settling</strong> — guided breath and body awareness to orient to the field.</div>\\n            <div><strong>Sound arc</strong> — instruments such as tuning forks, bowed monochord, and chimes are layered over 45–75 minutes depending on format.</div>\\n            <div><strong>Closure</strong> — soft returns to baseline and suggestions for integration.</div>\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n      <aside>\\n        <div class=\\\"panel\\\">\\n          <h4 style=\\\"margin:0\\\">Pricing & deposits</h4>\\n          <div style=\\\"color:#bfe8ff;margin-top:8px\\\">A non-refundable deposit secures timeslots for private services. See full pricing at <a href=\\\"pricing.html\\\">Pricing</a>.</div>\\n          <div style=\\\"margin-top:12px\\\"><strong>Questions?</strong><div class=\\\"small\\\" style=\\\"margin-top:6px\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • {{PHONE}}</div></div>\\n        </div>\\n\\n        <div style=\\\"height:12px\\\"></div>\\n\\n        <div class=\\\"panel\\\">\\n          <h4 style=\\\"margin:0\\\">Instruments we might use</h4>\\n          <ul style=\\\"color:#d7f3ff;margin-top:8px\\\">\\n            <li>Tuning forks for precise harmonic touch</li>\\n            <li>Bowed monochord for continuous resonance</li>\\n            <li>Hand chimes and soft percussive textures</li>\\n          </ul>\\n          <div class=\\\"small\\\" style=\\\"margin-top:8px\\\">Each instrument is chosen to support the session goal and participant needs.</div>\\n        </div>\\n\\n      </aside>\\n    </div>\\n\\n    <div style=\\\"height:18px\\\"></div>\\n\\n    <div class=\\\"small\\\" style=\\\"text-align:center;color:#9fb3c9\\\">By booking you agree to our intake process. If you need immediate assistance, call {{PHONE}}.</div>\\n\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
