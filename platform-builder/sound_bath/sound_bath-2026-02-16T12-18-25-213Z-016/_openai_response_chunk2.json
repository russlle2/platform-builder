          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — Gatherings & Events</title>\\n  <meta name=\\\"description\\\" content=\\\"Luxurious sensory sound baths in {{CITY}}, {{STATE}} — group events, seasonal rituals, and community gatherings.\\\">\\n  <style>\\n    :root{--bg:#0f1724;--muted:#9aa7b2;--accent:#9be7e0;--card:#0b1220;--glass:rgba(255,255,255,0.04);--radius:14px}\\n    *{box-sizing:border-box}\\n    html,body{height:100%}\\n    body{margin:0;font-family:Inter,ui-sans-serif,segoe ui,system-ui,-apple-system,\\\"Helvetica Neue\\\",Arial;line-height:1.45;color:#e6f6f5;background:linear-gradient(180deg,#071021 0%,#081826 60%);overflow-y:auto}\\n    /* playful bold layout */\\n    header{position:sticky;top:0;backdrop-filter:blur(6px);background:linear-gradient(90deg,rgba(3,6,10,0.6),rgba(3,6,10,0.3));border-bottom:1px solid rgba(255,255,255,0.03);z-index:30}\\n    .wrap{max-width:1100px;margin:0 auto;padding:28px}\\n    nav{display:flex;align-items:center;justify-content:space-between}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:54px;height:54px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#7fe0c4);display:flex;align-items:center;justify-content:center;font-weight:700;color:#052226}\\n    .brand h1{font-size:16px;margin:0;color:#e6fbfa}\\n    .brand p{margin:0;font-size:12px;color:var(--muted)}\\n    .navlinks{display:flex;gap:14px;align-items:center}\\n    .navlinks a{color:var(--muted);text-decoration:none;padding:8px 12px;border-radius:10px}\\n    .navlinks a.active{background:var(--glass);color:var(--accent);font-weight:600}\\n    .cta-btn{background:linear-gradient(90deg,#6ef0da,#5ed0ff);padding:10px 14px;border-radius:12px;color:#012; font-weight:700;text-decoration:none}\\n\\n    /* hero */\\n    .hero{position:relative;padding:64px 0 40px}\\n    .hero-grid{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:26px;border-radius:18px;border:1px solid rgba(255,255,255,0.02)}\\n    h2{margin:0 0 10px 0;color:#e9fffc}\\n    p.lead{color:var(--muted);margin:0 0 18px}\\n\\n    /* pattern svgs */\\n    .bg-svg{position:absolute;inset:0;pointer-events:none;opacity:0.18}\\n\\n    /* calendar */\\n    .calendar-list{list-style:none;padding:0;margin:12px 0 0;display:flex;flex-direction:column;gap:8px}\\n    .event-item{display:flex;justify-content:space-between;align-items:center;padding:12px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);border:1px solid rgba(255,255,255,0.02)}\\n    .date{font-weight:700;color:var(--accent)}\\n\\n    section{margin:28px 0}\\n    .two-col{display:grid;grid-template-columns:1fr 320px;gap:22px}\\n    .pillars{display:flex;flex-direction:column;gap:12px}\\n    .pillar{padding:14px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);border:1px solid rgba(255,255,255,0.02)}\\n\\n    .faq{display:grid;grid-template-columns:1fr 1fr;gap:12px}\\n    .faq-item{background:var(--card);padding:12px;border-radius:10px;color:var(--muted)}\\n\\n    footer{padding:30px 0;color:var(--muted);font-size:13px}\\n\\n    @media(max-width:880px){.hero-grid{grid-template-columns:1fr;}.two-col{grid-template-columns:1fr}.navlinks{display:none}.wrap{padding:18px}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"wrap\\\">\\n      <nav>\\n        <div class=\\\"brand\\\">\\n          <div class=\\\"logo\\\">SB</div>\\n          <div>\\n            <h1>{{BUSINESS_NAME}}</h1>\\n            <p>{{TAGLINE}}</p>\\n          </div>\\n        </div>\\n        <div class=\\\"navlinks\\\">\\n          <a href=\\\"index.html\\\">Home</a>\\n          <a href=\\\"events.html\\\" class=\\\"active\\\">Gatherings</a>\\n          <a href=\\\"private-sessions.html\\\">Private</a>\\n          <a href=\\\"pricing.html\\\">Rates</a>\\n          <a href=\\\"contact.html\\\">Connect</a>\\n          <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"cta-btn\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </nav>\\n    </div>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <div class=\\\"hero\\\">\\n      <!-- unique svg pattern -->\\n      <svg class=\\\"bg-svg\\\" width=\\\"100%\\\" height=\\\"100%\\\" viewBox=\\\"0 0 1200 600\\\" preserveAspectRatio=\\\"xMidYMid slice\\\">\\n        <defs>\\n          <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#07414a\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#08202b\\\"/></linearGradient>\\n        </defs>\\n        <rect width=\\\"1200\\\" height=\\\"600\\\" fill=\\\"url(#g1)\\\" />\\n        <g fill=\\\"none\\\" stroke=\\\"#38e0d6\\\" stroke-opacity=\\\"0.06\\\" stroke-width=\\\"3\\\">\\n          <path d=\\\"M0 480 C200 420,300 520,600 380 S1000 220,1200 350\\\"/>\\n          <circle cx=\\\"200\\\" cy=\\\"120\\\" r=\\\"80\\\" stroke-opacity=\\\"0.03\\\"/>\\n        </g>\\n      </svg>\\n\\n      <div class=\\\"hero-grid\\\">\\n        <div class=\\\"card\\\">\\n          <h2>Group Sound Baths — Join the Next Resonance</h2>\\n          <p class=\\\"lead\\\">A sensory-forward, premium experience guided by {{FACILITATOR_NAME}}. Expect immersive harmonic layering to ease the nervous system and invite deep rest.</p>\\n\\n          <h3 style=\\\"color:#cffeef\\\">Next event</h3>\\n          <p style=\\\"margin:6px 0 18px;color:var(--muted)\\\">Our next communal session is on <strong style=\\\"color:var(--accent)\\\">{{NEXT_EVENT_DATE}}</strong> at {{VENUE_NAME}} in {{CITY}}, {{STATE}}.</p>\\n\\n          <div>\\n            <a href=\\\"book.html\\\" class=\\\"cta-btn\\\">Reserve a Space</a>\\n          </div>\\n        </div>\\n\\n        <aside class=\\\"card\\\">\\n          <h3 style=\\\"color:#cffeef;margin-top:0\\\">Upcoming schedule</h3>\\n          <ul class=\\\"calendar-list\\\">\\n            <li class=\\\"event-item\\\"><div><strong>Moonrise Sound Bath</strong><div class=\\\"muted\\\">Intention: release</div></div><div class=\\\"date\\\">Mar 3</div></li>\\n            <li class=\\\"event-item\\\"><div><strong>Sunday Deep Rest</strong><div class=\\\"muted\\\">Intention: restore</div></div><div class=\\\"date\\\">Mar 14</div></li>\\n            <li class=\\\"event-item\\\"><div><strong>Equinox Ceremony</strong><div class=\\\"muted\\\">Intention: renew</div></div><div class=\\\"date\\\">Mar 21</div></li>\\n            <li class=\\\"event-item\\\"><div><strong>Full Tone Immersion</strong><div class=\\\"muted\\\">Intention: expand</div></div><div class=\\\"date\\\">Apr 5</div></li>\\n          </ul>\\n        </aside>\\n      </div>\\n    </div>\\n\\n    <section id=\\\"myth_vs_truth\\\">\\n      <div class=\\\"two-col\\\">\\n        <div class=\\\"card\\\">\\n          <h2>Common myths, clinical clarifications</h2>\\n          <div style=\\\"display:grid;gap:10px;margin-top:12px\\\">\\n            <div style=\\\"display:flex;gap:10px;align-items:flex-start\\\"><strong style=\\\"color:#ffdede\\\">Myth:</strong><div class=\\\"muted\\\">Sound baths are just background music.</div></div>\\n            <div style=\\\"display:flex;gap:10px;align-items:flex-start\\\"><strong style=\\\"color:#c8ffd6\\\">Truth:</strong><div class=\\\"muted\\\">They are curated vibrational sessions with intentional timbre, tempo, and spatial arrangement to influence physiology.</div></div>\\n\\n            <div style=\\\"display:flex;gap:10px;align-items:flex-start\\\"><strong style=\\\"color:#ffdede\\\">Myth:</strong><div class=\\\"muted\\\">Anyone can lead with a playlist.</div></div>\\n            <div style=\\\"display:flex;gap:10px;align-items:flex-start\\\"><strong style=\\\"color:#c8ffd6\\\">Truth:</strong><div class=\\\"muted\\\">Facilitation blends sonic technique, somatic awareness, and safety — especially for group work.</div></div>\\n          </div>\\n        </div>\\n\\n        <aside class=\\\"card\\\">\\n          <h3 style=\\\"color:#cffeef\\\">Quick logistics</h3>\\n          <p class=\\\"muted\\\">Doors open 25 minutes before starting. Arrive early to set your space. Sessions run 75–90 minutes with a period of guided settling, sustained listening, and gentle reorientation.</p>\\n        </aside>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"pillars\\\">\\n      <h2>Foundational pillars</h2>\\n      <div class=\\\"pillars\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"pillar\\\"><strong>Somatic safety</strong><div class=\\\"muted\\\">Layered cues and paced transitions to support nervous system regulation.</div></div>\\n        <div class=\\\"pillar\\\"><strong>Acoustic intentionality</strong><div class=\\\"muted\\\">Instruments tuned and positioned to sculpt a three-dimensional sound field.</div></div>\\n        <div class=\\\"pillar\\\"><strong>Luxurious simplicity</strong><div class=\\\"muted\\\">Minimal light, rich textures, and curated scents when appropriate.</div></div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"case_notes\\\">\\n      <h2>Session flow & what to expect</h2>\\n      <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n        <p class=\\\"muted\\\">Each gathering is a sequence: an opening check-in and intentions (10–15 min), progressive soundscape (45–60 min), and a soft return with guidance and tea (10–15 min). Facilitator-led cues assist re-integration.</p>\\n\\n        <h3 style=\\\"margin-top:14px;color:#cffeef\\\">Instruments on this cycle</h3>\\n        <ul class=\\\"muted\\\">\\n          <li>Crystal bowls (Harmonic tuning)</li>\\n          <li>Chimes for spatial highlights</li>\\n          <li>Tuning forks for targeted resonance</li>\\n        </ul>\\n\\n        <h3 style=\\\"margin-top:14px;color:#cffeef\\\">What to bring</h3>\\n        <ul class=\\\"muted\\\">\\n          <li>Yoga mat, blanket, eye-cover (or we provide a limited supply)</li>\\n          <li>Water bottle and comfortable layers</li>\\n        </ul>\\n\\n        <h3 style=\\\"margin-top:14px;color:#ffdede\\\">Contraindications & safety note</h3>\\n        <p class=\\\"muted\\\">If you are pregnant, have uncontrolled epilepsy, are on photosensitive medication, or have serious cardiovascular concerns, consult your clinician before attending. High-volume gongs may not be suitable for those with certain implants. Reach out at {{EMAIL}} for guidance.</p>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"faq\\\">\\n      <h2>Frequently asked (briefly)</h2>\\n      <div class=\\\"faq\\\" style=\\\"margin-top:12px\\\">\\n        <div class=\\\"faq-item\\\"><strong>Do I need experience?</strong><div class=\\\"muted\\\">No. Sessions are accessible to beginners; instructions are verbal and supportive.</div></div>\\n        <div class=\\\"faq-item\\\"><strong>Can I fall asleep?</strong><div class=\\\"muted\\\">Yes — falling into sleep is a normal response. The facilitator will provide a gentle return phase.</div></div>\\n        <div class=\\\"faq-item\\\"><strong>Are props provided?</strong><div class=\\\"muted\\\">We have a small supply; bring your own for certainty.</div></div>\\n        <div class=\\\"faq-item\\\"><strong>How should I book?</strong><div class=\\\"muted\\\">Reserve via the booking link or call {{PHONE}} for group reservations.</div></div>\\n      </div>\\n    </section>\\n\\n    <section id=\\\"cta\\\">\\n      <div class=\\\"card\\\" style=\\\"display:flex;justify-content:space-between;align-items:center;gap:16px\\\">\\n        <div>\\n          <h2 style=\\\"margin:0\\\">Ready to attend?</h2>\\n          <p class=\\\"muted\\\" style=\\\"margin:6px 0 0\\\">Spaces are intentionally limited to preserve the sonic environment. Reserve your place now.</p>\\n        </div>\\n        <div>\\n          <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"cta-btn\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px\\\">\\n        <div>{{BUSINESS_NAME}} — {{CITY}}, {{STATE}} | <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a> | {{PHONE}}</div>\\n        <div>Facilitated by {{FACILITATOR_NAME}} • Venue: {{VENUE_NAME}}</div>\\n      </div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Private Sessions — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"One-on-one, couples, and corporate sound work tailored to teams and intimate healing. Premium, sensory-focused sessions in {{CITY}}.\\\">\\n  <style>\\n    :root{--bg:#fffdfc;--ink:#042328;--muted:#547378;--accent:#ffd37a;--glass:rgba(4,35,40,0.04);--card:#f7f9f9}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Georgia,serif;color:var(--ink);background:linear-gradient(180deg,#fbfffe 0%,#f2fbfa 100%)}\\n    .wrap{max-width:1000px;margin:0 auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 0}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:50px;height:50px;border-radius:10px;background:linear-gradient(135deg,#ffd37a,#ffb57a);display:flex;align-items:center;justify-content:center;font-weight:800;color:#052226}\\n    .nav{display:flex;gap:12px}\\n    .nav a{color:var(--muted);text-decoration:none;padding:8px;border-radius:10px}\\n    .nav a.active{background:var(--card);color:var(--ink);font-weight:700}\\n    .primary{background:#042328;color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none}\\n\\n    .hero{display:flex;gap:22px;align-items:center;margin-top:18px}\\n    .hero .intro{flex:1}\\n    h1{margin:0;font-size:28px}\\n    p.lead{margin:8px 0;color:var(--muted)}\\n\\n    .bg-orn{position:absolute;right:-80px;top:40px;opacity:0.12}\\n\\n    .sessions{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:18px}\\n    .session-card{background:linear-gradient(180deg,#ffffff,#f7fbfa);padding:16px;border-radius:14px;border:1px solid rgba(4,35,40,0.04)}\\n    .session-card h3{margin:0 0 6px}\\n    .muted{color:var(--muted)}\\n\\n    .info{display:flex;gap:18px;margin-top:18px}\\n    .info .panel{flex:1;background:var(--card);padding:16px;border-radius:12px}\\n\\n    .faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}\\n    .faq-item{background:#fff;padding:12px;border-radius:10px;border:1px solid rgba(4,35,40,0.03)}\\n\\n    footer{margin-top:28px;color:var(--muted)}\\n\\n    @media(max-width:880px){.sessions{grid-template-columns:1fr}.hero{flex-direction:column}.bg-orn{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">PS</div>\\n        <div>\\n          <strong>{{BUSINESS_NAME}}</strong>\\n          <div class=\\\"muted\\\">Tailored sonic sessions</div>\\n        </div>\\n      </div>\\n      <nav class=\\\"nav\\\">\\n        <a href=\\\"index.html\\\">Studio</a>\\n        <a href=\\\"private-sessions.html\\\" class=\\\"active\\\">Sessions</a>\\n        <a href=\\\"events.html\\\">Gather</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <div class=\\\"hero\\\">\\n        <div class=\\\"intro\\\">\\n          <h1>Private sound work — clinically grounded, luxuriously delivered</h1>\\n          <p class=\\\"lead\\\">Hybrid offerings that blend therapeutic principles with sensory design. Choose a private format that fits your intention: 1:1, couples, or corporate team sessions.</p>\\n        </div>\\n        <div>\\n          <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"primary\\\">Book a consultation</a>\\n        </div>\\n      </div>\\n\\n      <!-- unique decorative svg -->\\n      <svg class=\\\"bg-orn\\\" width=\\\"220\\\" height=\\\"220\\\" viewBox=\\\"0 0 220 220\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n        <defs>\\n          <linearGradient id=\\\"o1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#ffd37a\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#ffa07a\\\"/></linearGradient>\\n        </defs>\\n        <circle cx=\\\"110\\\" cy=\\\"110\\\" r=\\\"90\\\" fill=\\\"url(#o1)\\\" />\\n        <g fill=\\\"#fff\\\" opacity=\\\"0.06\\\"><circle cx=\\\"110\\\" cy=\\\"60\\\" r=\\\"8\\\"/><circle cx=\\\"60\\\" cy=\\\"140\\\" r=\\\"6\\\"/></g>\\n      </svg>\\n\\n      <section class=\\\"sessions\\\" id=\\\"packages\\\">\\n        <div class=\\\"session-card\\\">\\n          <h3>1:1 Deep Work</h3>\\n          <p class=\\\"muted\\\">A private, focused session for personal integration and nervous system regulation (60–90 min).</p>\\n          <p><strong>Instruments:</strong> gong tones, monochord, tuned bowls</p>\\n          <p><a href=\\\"book.html\\\">Request a time</a></p>\\n        </div>\\n        <div class=\\\"session-card\\\">\\n          <h3>Couples & Dyads</h3>\\n          <p class=\\\"muted\\\">Partnered sound practices to enhance attunement and connected breathing (75–90 min).</p>\\n          <p><strong>Instruments:</strong> crystal bowls, chimes, vocal toning</p>\\n          <p><a href=\\\"book.html\\\">Reserve for two</a></p>\\n        </div>\\n        <div class=\\\"session-card\\\">\\n          <h3>Corporate & Teams</h3>\\n          <p class=\\\"muted\\\">Short-format sessions for teams (30–50 min) focusing on clarity, stress reduction, and reset.</p>\\n          <p><strong>Instruments:</strong> tuning forks, handpans (or portable set)</p>\\n          <p><a href=\\\"contact.html\\\">Inquire for a quote</a></p>\\n        </div>\\n      </section>\\n\\n      <section id=\\\"myth_vs_truth\\\">\\n        <h2 style=\\\"margin-top:20px\\\">What private work actually does</h2>\\n        <div class=\\\"info\\\">\\n          <div class=\\\"panel\\\">\\n            <h4 style=\\\"margin:0\\\">Clinical clarity</h4>\\n            <p class=\\\"muted\\\">Sessions are paced with physiological markers in mind — breath, heart-rate cues, and somatic anchoring to avoid overstimulation.</p>\\n          </div>\\n          <div class=\\\"panel\\\">\\n            <h4 style=\\\"margin:0\\\">Curated sensory field</h4>\\n            <p class=\\\"muted\\\">Sound is mixed intentionally; intensity and frequency content are matched to the goal: clarity, grounding, or expanded attention.</p>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section id=\\\"pillars\\\">\\n        <h2 style=\\\"margin-top:20px\\\">Core pillars</h2>\\n        <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-wrap:wrap\\\">\\n          <div style=\\\"background:#fff;padding:12px;border-radius:10px;flex:1;min-width:200px\\\"><strong>Confidentiality</strong><div class=\\\"muted\\\">Sessions are private and held with professional presence.</div></div>\\n          <div style=\\\"background:#fff;padding:12px;border-radius:10px;flex:1;min-width:200px\\\"><strong>Customization</strong><div class=\\\"muted\\\">Tools and tempo are adapted to client needs.</div></div>\\n          <div style=\\\"background:#fff;padding:12px;border-radius:10px;flex:1;min-width:200px\\\"><strong>Integration</strong><div class=\\\"muted\\\">Homework and somatic practices as desired.</div></div>\\n        </div>\\n      </section>\\n\\n      <section id=\\\"case_notes\\\">\\n        <h2 style=\\\"margin-top:20px\\\">Typical private session flow</h2>\\n        <div style=\\\"background:#fff;padding:14px;border-radius:12px;margin-top:12px\\\">\\n          <ol class=\\\"muted\\\">\\n            <li>Intake & intention setting (5–10 min)</li>\\n            <li>Settling breath and attunement (5–10 min)</li>\\n            <li>Designed sound sequence (30–60 min)</li>\\n            <li>Slow reorientation, integration notes (10 min)</li>\\n          </ol>\\n\\n          <h4 style=\\\"margin-top:12px\\\">Bring / beforehand</h4>\\n          <p class=\\\"muted\\\">Comfortable clothing, any supportive cushions, and an openness to guided breathwork. Notify us of implants, pregnancy, or anxiety related to loud sound.</p>\\n\\n          <h4 style=\\\"margin-top:12px;color:#ff9b9b\\\">Contraindications</h4>\\n          <p class=\\\"muted\\\">Private work may be contraindicated for untreated severe psychiatric conditions, certain implants, or recent head trauma. Contact {{EMAIL}} to discuss suitability.</p>\\n        </div>\\n      </section>\\n\\n      <section id=\\\"faq\\\">\\n        <h2 style=\\\"margin-top:20px\\\">Short FAQs</h2>\\n        <div class=\\\"faq-grid\\\">\\n          <div class=\\\"faq-item\\\"><strong>How is this different from therapy?</strong><div class=\\\"muted\\\">This is experiential somatic sound work and does not replace psychotherapy; it can complement therapeutic care.</div></div>\\n          <div class=\\\"faq-item\\\"><strong>Can we record?</strong><div class=\\\"muted\\\">We recommend presence; recordings are at the facilitator's discretion.</div></div>\\n          <div class=\\\"faq-item\\\"><strong>Travel for corporate?</strong><div class=\\\"muted\\\">Yes — rates depend on logistics. We bring portable instrument sets tailored for office spaces.</div></div>\\n          <div class=\\\"faq-item\\\"><strong>Rescheduling policy?</strong><div class=\\\"muted\\\">Please notify 48 hours in advance to avoid a fee.</div></div>\\n        </div>\\n      </section>\\n\\n      <section id=\\\"cta\\\" style=\\\"margin-top:20px\\\">\\n        <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n          <div style=\\\"flex:1\\\">\\n            <h3 style=\\\"margin:0\\\">Start a private plan</h3>\\n            <p class=\\\"muted\\\" style=\\\"margin:6px 0 0\\\">Book an introductory consult to align on goals and format.</p>\\n          </div>\\n          <div>\\n            <a href=\\\"{{PRIMARY_CTA_URL}}\\\" class=\\\"primary\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <footer>\\n        <p class=\\\"muted\\\">Contact: {{EMAIL}} • Phone: {{PHONE}} • {{BUSINESS_NAME}} — Facilitator: {{FACILITATOR_NAME}}</p>\\n      </footer>\\n    </main>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Fees & Packages — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Transparent pricing for group events, private sessions, and special packages. Sensory-first, premium offerings.\\\">\\n  <style>\\n    :root{--bg:#081219;--card:#07141a;--muted:#9bb0b5;--accent:#7ad1ff}\\n    *{box-sizing:border-box}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Arial;color:#e8fbfb;background:linear-gradient(180deg,#061018 0%,#08161d 100%)}\\n    .wrap{max-width:1100px;margin:0 auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,#7ad1ff,#7ef4db);display:flex;align-items:center;justify-content:center;font-weight:800;color:#021}\\n    nav{display:flex;gap:12px}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px;border-radius:8px}\\n    nav a.active{background:rgba(255,255,255,0.03);color:var(--accent);font-weight:700}\\n\\n    .hero{margin-top:20px}\\n    h1{margin:0;color:#eafefe}\\n    p.lead{color:var(--muted)}\\n\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}\\n    .tier{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:18px;border-radius:14px;border:1px solid rgba(255,255,255,0.02)}\\n    .price{font-size:22px;color:var(--accent);font-weight:800}\\n    .muted{color:var(--muted)}\\n\\n    .details{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    .faq{background:var(--card);padding:14px;border-radius:12px}\\n    .note{background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;margin-top:10px;color:var(--muted)}\\n\\n    footer{margin-top:30px;color:var(--muted)}\\n\\n    @media(max-width:900px){.tiers{grid-template-columns:1fr}.details{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n        <div class=\\\"logo\\\">PR</div>\\n        <div>\\n          <strong>{{BUSINESS_NAME}}</strong>\\n          <div class=\\\"muted\\\">Transparent packages</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Main</a>\\n        <a href=\\\"events.html\\\">Events</a>\\n        <a href=\\\"private-sessions.html\\\">Private Sessions</a>\\n        <a href=\\\"pricing.html\\\" class=\\\"active\\\">Fees</a>\\n        <a href=\\\"book.html\\\">Book</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"hero\\\">\\n        <h1>Simple, sensory pricing</h1>\\n        <p class=\\\"lead\\\">Hybrid offerings — pick a single session, a block, or a subscription credit plan. Each tier includes a pre-session intake and post-session notes where relevant.</p>\\n      </section>\\n\\n      <section class=\\\"tiers\\\" id=\\\"pricing-tiers\\\">\\n        <div class=\\\"tier\\\">\\n          <h3>Community Drop-In</h3>\\n          <div class=\\\"price\\\">$30 — single</div>\\n          <p class=\\\"muted\\\">Access to scheduled group events. Limited seating — arrive early.</p>\\n          <ul class=\\\"muted\\\">\\n            <li>75–90 min group session</li>\\n            <li>Basic props available</li>\\n            <li>Check-in: 10 min</li>\\n          </ul>\\n          <div style=\\\"margin-top:12px\\\"><a href=\\\"events.html\\\" style=\\\"color:var(--accent);text-decoration:none\\\">See schedule</a></div>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <h3>Private Single</h3>\\n          <div class=\\\"price\\\">$180 — 60 min</div>\\n          <p class=\\\"muted\\\">Private 1:1 session — focused, clinical-somatic design with a follow-up integration note.</p>\\n          <ul class=\\\"muted\\\">\\n            <li>Intake + 60 min sound work</li>\\n            <li>Post-session integration email</li>\\n          </ul>\\n          <div style=\\\"margin-top:12px\\\"><a href=\\\"private-sessions.html\\\" style=\\\"color:var(--accent);text-decoration:none\\\">Book private</a></div>\\n        </div>\\n\\n        <div class=\\\"tier\\\">\\n          <h3>Mini Team Reset</h3>\\n          <div class=\\\"price\\\">$450 — 45 min</div>\\n          <p class=\\\"muted\\\">Onsite or virtual team session for up to 20 people — targeted stress regulation and focus reset.</p>\\n          <ul class=\\\"muted\\\">\\n            <li>Portable instruments (tuning forks, handpan)</li>\\n            <li>Short intake for goals</li>\\n          </ul>\\n          <div style=\\\"margin-top:12px\\\"><a href=\\\"contact.html\\\" style=\\\"color:var(--accent);text-decoration:none\\\">Request quote</a></div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"details\\\">\\n        <div>\\n          <h2 style=\\\"color:#eafefe\\\">Packages & credits</h2>\\n          <p class=\\\"muted\\\">Save with a block: 5 private sessions for $800 (save $100). Subscriptions available for monthly members — contact us for custom agreements.</p>\\n\\n          <div class=\\\"note\\\">\\n            <strong>What to bring</strong>\\n            <p class=\\\"muted\\\">Comfort items like blankets and cushions, and any personal ear protection if you prefer lower volume. We advise avoiding heavy meals immediately prior.</p>\\n          </div>\\n\\n          <div class=\\\"note\\\" style=\\\"margin-top:10px\\\">\\n            <strong>Contraindications</strong>\\n            <p class=\\\"muted\\\">Pregnancy (consult), pacemakers/implants (contact us), photosensitive conditions (inform facilitator). The facilitator will adapt when needed.</p>\\n          </div>\\n\\n          <div style=\\\"margin-top:12px\\\">\\n            <a href=\\\"{{PRIMARY_CTA_URL}}\\\" style=\\\"background:linear-gradient(90deg,var(--accent),#7fffd4);padding:10px 14px;border-radius:12px;color:#021;text-decoration:none;font-weight:700\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          </div>\\n        </div>\\n\\n        <aside class=\\\"faq\\\">\\n          <h4 style=\\\"margin:0 0 8px 0;color:var(--accent)\\\">Quick FAQs</h4>\\n          <div class=\\\"muted\\\"><strong>Cancellation?</strong> 48-hour policy for full refunds.</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\"><strong>Gift certificates?</strong> Available — contact {{EMAIL}}.</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\"><strong>Group discounts?</strong> Available for bookings of 6+ people.</div>\\n          <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\"><strong>Is tax included?</strong> Local tax may apply; final invoice will reflect it.</div>\\n        </aside>\\n      </section>\\n\\n      <section id=\\\"case_notes\\\" style=\\\"margin-top:18px\\\">\\n        <h2 style=\\\"color:#eafefe\\\">Flow summary — how sessions are structured</h2>\\n        <p class=\\\"muted\\\">Sessions combine an initial intake, a paced sound sequence, and a guided return. Instrument selection varies: this pricing cycle highlights crystal singing bowls, gongs for spaciousness, and targeted tuning forks for precise somatic work.</p>\\n      </section>\\n\\n      <section id=\\\"faq\\\" style=\\\"margin-top:18px\\\">\\n        <h2 style=\\\"color:#eafefe\\\">More questions?</h2>\\n        <p class=\\\"muted\\\">Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--accent);text-decoration:none\\\">{{EMAIL}}</a> or call {{PHONE}} for custom packages or corporate contracts.</p>\\n      </section>\\n\\n      <footer>\\n        <p class=\\\"muted\\\">{{BUSINESS_NAME}} • Facilitator: {{FACILITATOR_NAME}} • Venue: {{VENUE_NAME}} • {{CITY}}, {{STATE}}</p>\\n      </footer>\\n    </main>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
