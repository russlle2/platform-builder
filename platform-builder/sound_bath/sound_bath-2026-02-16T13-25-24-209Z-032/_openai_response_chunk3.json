          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>About — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--glass:#ffffff22;--glass-2:#ffffff14;--accent:#6ee7b7;--muted:#cbd5e1;--bg1:linear-gradient(135deg,#0f172a 0%,#08203a 100%);}html,body{height:100%;margin:0;font-family:Inter,system-ui,Segoe UI,Arial;background:var(--bg1);color:#e6eef6}\\n    .page{min-height:100vh;display:flex;flex-direction:column;background-image:url('assets/img/pattern.svg');background-repeat:repeat;background-size:240px}\\n    nav{display:flex;gap:18px;align-items:center;padding:22px 34px}\\n    nav a{color:rgba(230,238,246,0.9);text-decoration:none;padding:8px 12px;border-radius:10px}\\n    nav a:hover{background:var(--glass-2);backdrop-filter:blur(6px)}\\n    .container{max-width:980px;margin:28px auto;padding:28px;background:linear-gradient(180deg,rgba(255,255,255,0.03),rgba(255,255,255,0.02));border-radius:18px;box-shadow:0 6px 40px rgba(2,6,23,0.65);border:1px solid rgba(255,255,255,0.05);backdrop-filter:blur(10px)}\\n    .hero{display:flex;gap:24px;align-items:center}\\n    .badge{padding:6px 12px;background:linear-gradient(90deg,var(--accent),#8dd3ff);border-radius:999px;color:#042029;font-weight:600;font-size:13px}\\n    h1{margin:6px 0 4px;font-weight:700;color:#e9f6f3}\\n    p.lead{color:var(--muted);margin:0 0 18px}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-top:18px}\\n    .card{background:var(--glass);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.04)}\\n    .strip{padding:12px;border-radius:10px;background:linear-gradient(90deg,rgba(110,231,183,0.06),rgba(141,211,255,0.04));border:1px solid rgba(110,231,183,0.06);font-size:14px;color:#eafaf4}\\n    dl{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:12px 0}\\n    dt{color:#cfece2;font-weight:600}dd{color:var(--muted);margin:0}\\n    ul{padding-left:18px;color:var(--muted)}\\n    footer{margin-top:22px;padding:18px;text-align:center;color:rgba(230,238,246,0.6);font-size:13px}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 16px;background:linear-gradient(90deg,var(--accent),#8dd3ff);color:#012; font-weight:700;border-radius:10px;text-decoration:none}\\n    .facilitator{display:flex;gap:12px;align-items:center}\\n    .avatar{width:64px;height:64px;border-radius:12px;background:linear-gradient(180deg,#fff1,#eef);border:1px solid rgba(255,255,255,0.06)}\\n    .small{font-size:13px;color:var(--muted)}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}.container{margin:16px}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"page\\\">\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Gatherings</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"about.html\\\" aria-current=\\\"page\\\">About</a>\\n      <a href=\\\"faq.html\\\">Help</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n\\n    <main class=\\\"container\\\" role=\\\"main\\\">\\n      <div class=\\\"hero\\\">\\n        <div style=\\\"flex:1\\\">\\n          <div class=\\\"badge\\\">Sonic Care</div>\\n          <h1>We design slow, intentional sound experiences</h1>\\n          <p class=\\\"lead\\\">At {{BUSINESS_NAME}} we frame sound as a service for the nervous system — precise, sensory, and exquisitely curated for calm.</p>\\n          <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n        </div>\\n        <div style=\\\"width:240px;text-align:right\\\">\\n          <div class=\\\"strip\\\">Next circle: {{NEXT_EVENT_DATE}}</div>\\n          <div class=\\\"small\\\" style=\\\"margin-top:12px\\\">Venue: {{VENUE_NAME}} • {{CITY}}, {{STATE}}</div>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"grid\\\">\\n        <section>\\n          <div class=\\\"card\\\">\\n            <h3>Our approach — clinical calm, sensory luxury</h3>\\n            <p class=\\\"small\\\">We blend therapeutic awareness with a premium aesthetic: warm lighting, tactile blankets, and a carefully balanced sonic palette. Sessions move from guided settling to immersive resonance and gentle reintegration.</p>\\n\\n            <h4 style=\\\"margin-top:14px\\\">Instruments you might hear</h4>\\n            <ul>\\n              <li>Crystal singing bowls tuned to harmonic intervals</li>\\n              <li>Wind chimes & Himalayan bowls for shimmering overtones</li>\\n              <li>Subtle tuning forks for focal frequencies</li>\\n            </ul>\\n\\n            <h4 style=\\\"margin-top:14px\\\">The flow — what a session feels like</h4>\\n            <p class=\\\"small\\\">We begin with orientation and breathwork (10–12 min), move into a sustained soundscape (35–45 min) with live modulation, and close with a soft integration and journaling moment. Facilitated pauses allow participants to adjust temperature, posture, and attention.</p>\\n          </div>\\n\\n          <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n            <h4>Facilitation</h4>\\n            <div class=\\\"facilitator\\\">\\n              <div class=\\\"avatar\\\" aria-hidden=\\\"true\\\"></div>\\n              <div>\\n                <div style=\\\"font-weight:700\\\">{{FACILITATOR_NAME}}</div>\\n                <div class=\\\"small\\\">Lead facilitator, trauma-aware sound practitioner</div>\\n                <div class=\\\"small\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a></div>\\n              </div>\\n            </div>\\n          </div>\\n        </section>\\n\\n        <aside>\\n          <div class=\\\"card\\\">\\n            <h4>What to bring</h4>\\n            <ul>\\n              <li>Yoga mat and thick blanket for comfort</li>\\n              <li>Pillow or bolster for neck support</li>\\n              <li>Water bottle; arrive hydrated</li>\\n            </ul>\\n            <h4 style=\\\"margin-top:12px\\\">Contraindications & safety</h4>\\n            <p class=\\\"small\\\">If you have a history of epilepsy, pacemaker, severe tinnitus, or are pregnant, please consult your physician and email us before booking. Intense vibrational experiences can affect certain medical devices.</p>\\n            <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Book a place</a></div>\\n          </div>\\n\\n          <div class=\\\"card\\\" style=\\\"margin-top:14px\\\">\\n            <h4>Private & Hybrid</h4>\\n            <p class=\\\"small\\\">We offer small-group in-person ceremonies and remote, guided sessions with curated sound layers for home listening — ask about our hybrid packages.</p>\\n            <dl>\\n              <dt>Phone</dt><dd>{{PHONE}}</dd>\\n              <dt>Email</dt><dd>{{EMAIL}}</dd>\\n            </dl>\\n          </div>\\n        </aside>\\n      </div>\\n\\n      <footer>\\n        <div>{{BUSINESS_NAME}} • A refined sensory practice • {{CITY}}, {{STATE}}</div>\\n      </footer>\\n    </main>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>FAQ — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071029;--glass:#ffffff15;--accent:#7bd389;--muted:#bcd6e9}\\n    body{margin:0;background:radial-gradient(1200px 600px at 10% 10%,#05213b 0%,#041022 40%,#02060c 100%),url('assets/img/pattern.svg');color:#e6f1fb;font-family:Inter,system-ui,Segoe UI,Arial}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 28px}\\n    nav a{color:rgba(230,241,250,0.9);text-decoration:none;margin-right:14px;padding:8px;border-radius:10px}\\n    nav a:hover{background:var(--glass);backdrop-filter:blur(6px)}\\n    .wrap{max-width:980px;margin:18px auto;padding:26px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border-radius:14px;border:1px solid rgba(255,255,255,0.03);backdrop-filter:blur(8px)}\\n    h1{margin:0 0 6px}\\n    p.lead{color:var(--muted);margin-top:4px}\\n    .faq{margin-top:18px}\\n    details{background:var(--glass);padding:14px;border-radius:10px;margin-bottom:10px;border-left:4px solid rgba(123,211,137,0.18)}\\n    summary{font-weight:700;cursor:pointer}\\n    .muted{color:var(--muted)}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px}\\n    .card{padding:14px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border-radius:10px;border:1px solid rgba(255,255,255,0.03)}\\n    .cta{display:inline-block;margin-top:12px;padding:10px 14px;background:linear-gradient(90deg,var(--accent),#8dd3ff);color:#022;border-radius:10px;text-decoration:none;font-weight:700}\\n    footer{margin-top:18px;text-align:center;color:rgba(230,241,250,0.6);padding:12px}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:18px\\\">\\n      <a href=\\\"index.html\\\" style=\\\"font-weight:700;color:#eaf7f0\\\">{{BUSINESS_NAME}}</a>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Events</a>\\n        <a href=\\\"private-sessions.html\\\">1:1 & Groups</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n        <a href=\\\"about.html\\\">About</a>\\n      </nav>\\n    </div>\\n    <div style=\\\"text-align:right\\\">\\n      <div class=\\\"muted\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted)\\\">{{EMAIL}}</a> • {{PHONE}}</div>\\n    </div>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <h1>Common questions — clear expectations</h1>\\n    <p class=\\\"lead\\\">Concise answers to help you prepare. If you don’t see your question, reach out at <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</p>\\n\\n    <div class=\\\"grid\\\">\\n      <section class=\\\"faq\\\">\\n        <details open>\\n          <summary>What is a sound bath and how long does it last?</summary>\\n          <div class=\\\"muted\\\">A sound bath is a guided session where live instruments create enveloping resonance to support relaxation. Typical group circles run 60–75 minutes: 10–15 minutes to settle, 35–45 minutes immersive sound, and 10–15 minutes for gentle wake and reflection.</div>\\n        </details>\\n\\n        <details>\\n          <summary>How should I prepare?</summary>\\n          <div class=\\\"muted\\\">\\n            Arrive rested, hydrate, and wear layered comfortable clothing. Bring your mat, blanket, and anything to block light if you prefer. Keep jewelry minimal. We recommend minimal caffeine beforehand.\\n          </div>\\n        </details>\\n\\n        <details>\\n          <summary>Are sound baths safe? Any contraindications?</summary>\\n          <div class=\\\"muted\\\">Most people find them restorative. However, please do not attend without consent from a medical provider if you have epilepsy, a pacemaker or other implantable medical device, severe psychiatric conditions, or are in your first trimester of pregnancy without approval. If you have tinnitus, inform the facilitator; we can adapt the experience.</div>\\n        </details>\\n\\n        <details>\\n          <summary>What instruments will be used?</summary>\\n          <div class=\\\"muted\\\">We rotate ensembles to keep the palette fresh. Common instruments include: a gong for deep harmonic wash, singing bowls (crystal or metal) for sustaining overtones, and a monochord for subtle drone. Each event’s lineup is posted on the event page.</div>\\n        </details>\\n\\n        <details>\\n          <summary>Can I bring my phone? Will I be recorded?</summary>\\n          <div class=\\\"muted\\\">We request phones be silenced and stored away to preserve the container. Sessions are not recorded unless explicitly stated; any recordings for remote participants are offered as optional, guided audio files.</div>\\n        </details>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4>Preparation checklist</h4>\\n          <ul class=\\\"muted\\\">\\n            <li>Mat, blanket, pillow</li>\\n            <li>Loose, warm layers</li>\\n            <li>Water bottle</li>\\n            <li>Any mobility aids you need</li>\\n          </ul>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve your spot</a>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4>Booking & cancellations</h4>\\n          <p class=\\\"muted\\\">Full details at the booking flow. Generally, cancellations 72+ hours receive refunds; within 72 hours we offer a credit toward future sessions.</p>\\n          <div style=\\\"margin-top:8px\\\"><strong>Phone</strong><div class=\\\"muted\\\">{{PHONE}}</div></div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4>Quick note on hybrid sessions</h4>\\n          <p class=\\\"muted\\\">Remote participants receive a high-fidelity audio mix and a short orientation to optimize their home set-up. Ask about our hybrid tech kit.</p>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>Still uncertain?</h3>\\n      <p class=\\\"muted\\\">Email us at <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call {{PHONE}}. We will help you choose a gathering or private session suited to your needs.</p>\\n      <a class=\\\"cta\\\" href=\\\"contact.html\\\">Get in touch</a>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"muted\\\" style=\\\"margin-top:18px\\\">© {{BUSINESS_NAME}} • Excellence in therapeutic sound • {{CITY}}, {{STATE}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--accent:#6ee7b7;--glass:rgba(255,255,255,0.04);--muted:#bcd6e9}\\n    body{margin:0;font-family:Inter,system-ui,Segoe UI,Arial;background:linear-gradient(180deg,#071029 0%,#02101a 100%),url('assets/img/pattern.svg');color:#e9f8f4}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 26px}\\n    nav a{color:rgba(235,248,244,0.95);text-decoration:none;margin-right:12px;padding:8px;border-radius:10px}\\n    .wrap{max-width:980px;margin:18px auto;padding:22px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));border-radius:14px;border:1px solid rgba(255,255,255,0.04);backdrop-filter:blur(10px)}\\n    h1{margin-top:0}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px}\\n    .card{background:var(--glass);padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    label{display:block;margin-top:10px;font-weight:700}\\n    input,select,textarea{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid rgba(255,255,255,0.06);background:#071722;color:#e9fbf6}\\n    .btn{margin-top:12px;padding:10px 14px;background:linear-gradient(90deg,var(--accent),#8dd3ff);color:#022;border-radius:10px;border:none;font-weight:800}\\n    .alt{background:transparent;color:var(--muted);border:1px solid rgba(255,255,255,0.03)}\\n    .muted{color:var(--muted)}\\n    .note{font-size:13px;color:var(--muted);margin-top:8px}\\n    footer{margin-top:16px;text-align:center;color:rgba(230,241,250,0.6);padding:12px}\\n    @media(max-width:880px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:16px\\\">\\n      <a href=\\\"index.html\\\" style=\\\"font-weight:800;color:#e9fbf6\\\">{{BUSINESS_NAME}}</a>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Calendar</a>\\n        <a href=\\\"private-sessions.html\\\">Sessions</a>\\n        <a href=\\\"pricing.html\\\">Pricing</a>\\n      </nav>\\n    </div>\\n    <div style=\\\"text-align:right\\\">\\n      <a href=\\\"contact.html\\\" class=\\\"alt\\\">Contact</a>\\n    </div>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <h1>Reserve your experience</h1>\\n    <p class=\\\"muted\\\">Select a date and package. We offer in-person circles, private 1:1 sessions, and hybrid recordings for remote participants.</p>\\n\\n    <div class=\\\"grid\\\">\\n      <section>\\n        <div class=\\\"card\\\">\\n          <form action=\\\"{{PRIMARY_CTA_URL}}\\\" method=\\\"post\\\" autocomplete=\\\"on\\\">\\n            <label for=\\\"type\\\">Session type</label>\\n            <select id=\\\"type\\\" name=\\\"type\\\" required>\\n              <option value=\\\"group\\\">Group Sound Bath — Circle</option>\\n              <option value=\\\"private\\\">Private 1:1 — Tailored</option>\\n              <option value=\\\"couples\\\">Couples — Shared Field</option>\\n              <option value=\\\"corporate\\\">Corporate & Events</option>\\n              <option value=\\\"hybrid\\\">Hybrid (Remote + In-person)</option>\\n            </select>\\n\\n            <label for=\\\"date\\\">Preferred date</label>\\n            <input id=\\\"date\\\" name=\\\"preferred_date\\\" type=\\\"date\\\" min=\\\"2026-02-16\\\" value=\\\"{{NEXT_EVENT_DATE}}\\\" required>\\n\\n            <label for=\\\"name\\\">Full name</label>\\n            <input id=\\\"name\\\" name=\\\"name\\\" type=\\\"text\\\" placeholder=\\\"Your name\\\" required>\\n\\n            <label for=\\\"email\\\">Email</label>\\n            <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" placeholder=\\\"you@example.com\\\" required>\\n\\n            <label for=\\\"phone\\\">Phone</label>\\n            <input id=\\\"phone\\\" name=\\\"phone\\\" type=\\\"tel\\\" placeholder=\\\"Optional\\\">\\n\\n            <label for=\\\"notes\\\">Accessibility needs or notes</label>\\n            <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Any medical considerations or mobility needs\\\"></textarea>\\n\\n            <div class=\\\"note\\\">By submitting, you confirm that you have read the contraindications and agree to our policies. If you have a medical device, epilepsy, or are pregnant, contact us before booking: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</div>\\n\\n            <button class=\\\"btn\\\" type=\\\"submit\\\">Request booking</button>\\n          </form>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4>How the session unfolds</h4>\\n          <p class=\\\"muted\\\">We open with breath and orientation, progress into layered sound (bowls, chimes, overtone instruments), and finish with soft reentry. Private sessions allow deeper tuning and targeted frequency work with instruments such as the monochord and tuning forks.</p>\\n        </div>\\n      </section>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h4>Packages</h4>\\n          <div class=\\\"muted\\\">\\n            <strong>Group Circle</strong> — $35 / person • shared, guided immersion\\n            <br><strong>Private 1:1</strong> — $150 / 60min • individualized session\\n            <br><strong>Couples</strong> — $220 / 75min • shared field\\n            <br><strong>Corporate</strong> — custom pricing, requests welcomed\\n            <br><strong>Hybrid</strong> — inquire for mixed delivery & recording\\n          </div>\\n\\n          <h4 style=\\\"margin-top:12px\\\">What to bring</h4>\\n          <ul class=\\\"muted\\\">\\n            <li>Mat + blanket + eye pillow</li>\\n            <li>Earplugs available on request</li>\\n            <li>Medication & devices as needed</li>\\n          </ul>\\n          <div style=\\\"margin-top:10px\\\"><a class=\\\"btn\\\" href=\\\"pricing.html\\\">See detailed rates</a></div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h4>Contact & urgent changes</h4>\\n          <p class=\\\"muted\\\">For same-day cancellations or accessibility questions, call {{PHONE}} or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</p>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <h3>Need help choosing?</h3>\\n      <p class=\\\"muted\\\">If you are unsure which format suits you — group, private, or hybrid — we provide short consultations. Book a 15-minute call and we will recommend the best container for your needs.</p>\\n      <a class=\\\"btn\\\" href=\\\"contact.html\\\">Request consultation</a>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">Questions? {{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • {{PHONE}} • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
      "role": "assistant"
    }
