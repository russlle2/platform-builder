          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Group Sound Baths — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--glass-bg: rgba(255,255,255,0.08);--glass-border: rgba(255,255,255,0.12);--accent: #9BE7FF;--muted:#DDE9F2;--maxw:1100px}\\n    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#eef6fb;background:linear-gradient(160deg,#071226 0%,#063046 45%,#031b2a 100%);-webkit-font-smoothing:antialiased}\\n    .page{min-height:100vh;display:flex;flex-direction:column;align-items:center;padding:36px}\\n    header{width:100%;max-width:var(--maxw);display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-weight:600}\\n    .brand{display:flex;flex-direction:column}\\n    .brand .name{color:var(--accent);font-weight:700}\\n    .glass{backdrop-filter:blur(8px);background:linear-gradient(180deg,rgba(255,255,255,0.04),rgba(255,255,255,0.02));border:1px solid var(--glass-border);border-radius:14px;padding:22px;color:#e9f7ff}\\n    .hero{width:100%;max-width:var(--maxw);display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:center;margin-bottom:26px}\\n    .hero .lead{font-size:clamp(18px,2.6vw,22px);line-height:1.5;color:#eaf8ff}\\n    .hero h1{margin:0;font-size:clamp(26px,4vw,44px);letter-spacing:-0.02em;color:#dff9ff}\\n    .card{padding:18px;border-radius:12px}\\n    .aside .next{font-size:14px;color:#bfefff;margin-bottom:8px}\\n    .btn{display:inline-block;padding:12px 18px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#7EE0C3);color:#04202a;font-weight:700;text-decoration:none}\\n    section{width:100%;max-width:var(--maxw);margin:18px 0}\\n    h2{margin:0 0 12px 0;color:#d9f7ff}\\n    p{margin:0 0 12px 0;color:#cfeefb}\\n    ul{margin:8px 0 12px 20px;color:#cfeefb}\\n    .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}\\n    .testimonial{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);padding:14px;border-radius:10px;border:1px solid rgba(255,255,255,0.03)}\\n    footer{width:100%;max-width:var(--maxw);margin-top:36px;color:#a9dff0}\\n    /* SVG pattern as background */\\n    .pattern{position:fixed;right:-120px;top:-80px;width:640px;height:640px;opacity:0.12;pointer-events:none}\\n    @media (max-width:900px){.hero{grid-template-columns:1fr;}.grid-3{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 600 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#9BE7FF\\\" stop-opacity=\\\"0.28\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#7EE0C3\\\" stop-opacity=\\\"0.08\\\"/>\\n      </linearGradient>\\n      <pattern id=\\\"p1\\\" width=\\\"60\\\" height=\\\"60\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(25)\\\">\\n        <rect width=\\\"60\\\" height=\\\"60\\\" fill=\\\"transparent\\\"/>\\n        <circle cx=\\\"30\\\" cy=\\\"30\\\" r=\\\"2.5\\\" fill=\\\"#c9f6ff\\\" opacity=\\\"0.9\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g1)\\\"/>\\n    <rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\" opacity=\\\"0.9\\\"/>\\n  </svg>\\n\\n  <div class=\\\"page\\\">\\n    <header class=\\\"glass\\\">\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"name\\\">{{BUSINESS_NAME}}</div>\\n        <div class=\\\"tagline\\\">Clinical calm sound baths — restorative group experiences</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Gatherings</a>\\n        <a href=\\\"private-sessions.html\\\">Private</a>\\n        <a href=\\\"pricing.html\\\">Rates</a>\\n      </nav>\\n    </header>\\n\\n    <main>\\n      <section class=\\\"hero\\\">\\n        <div class=\\\"glass card\\\">\\n          <h1>Group Sound Bath — Next communal immersion</h1>\\n          <p class=\\\"lead\\\">A guided, sensory sound journey that combines harmonic resonance, deep breathing, and intentional stillness to help rest, reset, and restore. Sessions are hybrid — join in person or online.</p>\\n          <div style=\\\"margin-top:12px\\\">\\n            <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n            <a style=\\\"margin-left:12px;color:#bfefff;text-decoration:none;font-weight:600\\\" href=\\\"book.html\\\">Reserve a seat</a>\\n          </div>\\n        </div>\\n        <aside class=\\\"glass card aside\\\">\\n          <div class=\\\"next\\\">Next event</div>\\n          <div style=\\\"font-weight:700;color:#eaffff\\\">{{NEXT_EVENT_DATE}}</div>\\n          <div style=\\\"margin-top:12px;font-size:13px;color:#cfeefb\\\">Venue: {{VENUE_NAME}} • {{CITY}}, {{STATE}}</div>\\n          <div style=\\\"margin-top:14px\\\">\\n            <a class=\\\"btn\\\" href=\\\"book.html\\\">Book for {{NEXT_EVENT_DATE}}</a>\\n          </div>\\n        </aside>\\n      </section>\\n\\n      <section class=\\\"glass card\\\">\\n        <h2>Why attend a group sound bath?</h2>\\n        <p>Our sessions are created with a clinical calm approach: measured pacing, clear safety guidance, and sensory cues that emphasize grounding. Expect a premium, low-stimulus environment with carefully curated instruments.</p>\\n        <ul>\\n          <li>Shared resonance amplifies perceived depth of relaxation.</li>\\n          <li>Facilitated integration time after the journey.</li>\\n          <li>Hybrid access: attend in the studio or join by live stream.</li>\\n        </ul>\\n      </section>\\n\\n      <section class=\\\"glass card\\\">\\n        <h2>Session flow — what to expect</h2>\\n        <ol style=\\\"color:#cfeefb;margin-left:20px\\\">\\n          <li>Arrival & settle (10–15 min): check-in, temperature, and brief orientation.</li>\\n          <li>Grounding practices (5–10 min): breathwork and micro-body scan.</li>\\n          <li>Main sound journey (40–50 min): layering of instruments with intentional crescendos and rests.</li>\\n          <li>Integration & journaling (10–15 min): quiet reflection and optional sharing.</li>\\n        </ol>\\n      </section>\\n\\n      <section class=\\\"glass card\\\">\\n        <h2>Instruments in this group series</h2>\\n        <p>Each event highlights a curated palette. For the upcoming gatherings we feature crystal singing bowls, bronze gong, and Himalayan chimes — balanced for clarity and warmth.</p>\\n      </section>\\n\\n      <section class=\\\"glass card\\\">\\n        <h2>Calendar & upcoming dates</h2>\\n        <div class=\\\"grid-3\\\">\\n          <div class=\\\"card\\\" style=\\\"background:transparent\\\">\\n            <strong style=\\\"display:block;color:#e9fbff\\\">{{NEXT_EVENT_DATE}}</strong>\\n            <div style=\\\"font-size:13px;color:#cfeefb\\\">6:30–8:00pm • In-person & online</div>\\n          </div>\\n          <div class=\\\"card\\\" style=\\\"background:transparent\\\">\\n            <strong style=\\\"display:block;color:#e9fbff\\\">2026-03-14</strong>\\n            <div style=\\\"font-size:13px;color:#cfeefb\\\">Full-spectrum harmonic bath with subtle gong layering</div>\\n          </div>\\n          <div class=\\\"card\\\" style=\\\"background:transparent\\\">\\n            <strong style=\\\"display:block;color:#e9fbff\\\">2026-04-11</strong>\\n            <div style=\\\"font-size:13px;color:#cfeefb\\\">Seasonal slow-wave immersion</div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"glass card\\\">\\n        <h2>Practicals — what to bring</h2>\\n        <ul>\\n          <li>Yoga mat, blanket, pillow or bolster for support.</li>\\n          <li>Water bottle; comfortable layered clothing.</li>\\n          <li>Optional eye mask and light journal for notes after the session.</li>\\n        </ul>\\n        <p style=\\\"font-size:13px;color:#bfefff\\\">Contraindications: If you are pregnant, have uncontrolled hypertension, recent surgery, implanted electronic medical devices (e.g., pacemakers), or are under seizure risk, please consult with a clinician and inform the facilitator prior to attending.</p>\\n      </section>\\n\\n      <section class=\\\"glass card\\\">\\n        <h2>Testimonials</h2>\\n        <div class=\\\"grid-3\\\">\\n          <div class=\\\"testimonial\\\">\\\"Beautifully paced and deeply restorative. I left calm but alert.\\\" — L.F.</div>\\n          <div class=\\\"testimonial\\\">\\\"The hybrid stream was clear; felt connected despite being remote.\\\" — R.G.</div>\\n          <div class=\\\"testimonial\\\">\\\"Professional, warm, and clinically informed facilitation.\\\" — S.P.</div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"glass card\\\">\\n        <h2>Reserve your place</h2>\\n        <p>Spaces are limited to preserve the intimate, sensory focus. We recommend booking early.</p>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Register now for {{NEXT_EVENT_DATE}}</a>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:#cfeefb;text-decoration:none\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#cfeefb;text-decoration:none\\\">{{EMAIL}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Private Sound Sessions — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--glass-bg:rgba(255,255,255,0.05);--accent:#C6FFF1;--muted:#CFEFF6;--maxw:1100px}\\n    html,body{height:100%;margin:0;background:radial-gradient(ellipse at 20% 10%,#062B3A 0%, #031A24 40%, #01101a 100%);color:#eaf9ff;font-family:system-ui,Segoe UI,Roboto,Arial}\\n    .wrap{padding:36px;display:flex;flex-direction:column;align-items:center}\\n    header{width:100%;max-width:var(--maxw);display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:16px}\\n    .glass{background:linear-gradient(180deg,rgba(255,255,255,0.03),rgba(255,255,255,0.02));backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,0.06);padding:18px;border-radius:12px}\\n    .hero{width:100%;max-width:var(--maxw);display:flex;gap:20px;align-items:center;margin-bottom:18px}\\n    .hero h1{margin:0;color:#DFFCF6}\\n    .columns{display:grid;grid-template-columns:1fr 360px;gap:18px}\\n    .offer-list{display:flex;flex-direction:column;gap:12px}\\n    .offer{padding:12px;border-radius:10px;background:transparent;border:1px solid rgba(255,255,255,0.03)}\\n    .small{font-size:13px;color:#cfeefb}\\n    .cta{margin-top:12px}\\n    .btn{background:linear-gradient(90deg,var(--accent),#8DE4FF);color:#042127;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .pattern{position:fixed;left:-140px;bottom:-80px;width:520px;height:520px;opacity:0.1;pointer-events:none}\\n    @media (max-width:900px){.columns{grid-template-columns:1fr}.hero{flex-direction:column}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 600 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g2\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#C6FFF1\\\" stop-opacity=\\\"0.2\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#9BD9FF\\\" stop-opacity=\\\"0.06\\\"/>\\n      </linearGradient>\\n      <pattern id=\\\"p2\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(-20)\\\">\\n        <rect width=\\\"40\\\" height=\\\"40\\\" fill=\\\"transparent\\\"/>\\n        <path d=\\\"M0 20h40\\\" stroke=\\\"#bff7ee\\\" stroke-opacity=\\\"0.14\\\" stroke-width=\\\"1\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g2)\\\"/>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p2)\\\" opacity=\\\"0.9\\\"/>\\n  </svg>\\n\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div>\\n        <div style=\\\"color:var(--accent);font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"color:#cfeefb;font-size:13px\\\">Private sessions — tailored restorative sound</div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Events</a>\\n        <a href=\\\"pricing.html\\\">Tariffs</a>\\n        <a href=\\\"contact.html\\\">Contact</a>\\n      </nav>\\n    </header>\\n\\n    <main style=\\\"width:100%;max-width:var(--maxw)\\\">\\n      <section class=\\\"hero glass\\\">\\n        <div>\\n          <h1>Private Sound Work — 1:1, Couples, Corporate</h1>\\n          <p class=\\\"small\\\">Clinical calm facilitation for focused outcomes: deep relaxation, team resilience, and personalized therapeutic attention. Sessions can be held on-site, at {{VENUE_NAME}}, or remotely through our hybrid connection.</p>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Request private session</a></div>\\n        </div>\\n        <aside style=\\\"width:320px\\\" class=\\\"glass\\\">\\n          <div style=\\\"font-weight:700;color:#eaffff\\\">Facilitator</div>\\n          <div style=\\\"margin-top:8px;color:#cfeefb\\\">{{FACILITATOR_NAME}}</div>\\n          <div style=\\\"margin-top:12px\\\"><a style=\\\"color:#bfefff;text-decoration:none\\\" href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n        </aside>\\n      </section>\\n\\n      <section class=\\\"glass\\\" style=\\\"margin-top:18px\\\">\\n        <h2>Offerings</h2>\\n        <div class=\\\"offer-list\\\">\\n          <div class=\\\"offer\\\">\\n            <strong>1:1 therapeutic sound session</strong>\\n            <div class=\\\"small\\\">Personalized pacing, focused harmonic support with tuning forks and a monochord. Ideal for sleep reset and nervous system regulation.</div>\\n          </div>\\n          <div class=\\\"offer\\\">\\n            <strong>Couples restorative immersion</strong>\\n            <div class=\\\"small\\\">Designed to cultivate attunement and shared presence using paired singing bowls and gentle chimes.</div>\\n          </div>\\n          <div class=\\\"offer\\\">\\n            <strong>Corporate & team resilience</strong>\\n            <div class=\\\"small\\\">Short-form group sessions (30–45 min) focused on shared breath, grounding, and clear actionable takeaways to reduce stress and improve focus.</div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"glass\\\" style=\\\"margin-top:18px\\\">\\n        <h2>Session structure</h2>\\n        <p class=\\\"small\\\">Private sessions are intentionally modular. Below is a typical order which we adapt to client needs:</p>\\n        <ul>\\n          <li>Intake & intention setting (5–10 min).</li>\\n          <li>Grounding (breath + gentle movement, 5–7 min).</li>\\n          <li>Main sound work (20–60 min depending on booking): we feature tuning forks, monochord, bronze bowls — instruments selected to support your goals.</li>\\n          <li>Integration and aftercare guidance (10 min).</li>\\n        </ul>\\n      </section>\\n\\n      <section class=\\\"glass\\\" style=\\\"margin-top:18px\\\">\\n        <h2>What to bring & safety</h2>\\n        <p class=\\\"small\\\">Bring a mat, blanket, and anything that supports comfort. Contraindications include pregnancy in the first trimester without clearance, uncontrolled cardiovascular conditions, and active seizure disorders. Please disclose implants or devices and any ongoing psychiatric care prior to session.</p>\\n      </section>\\n\\n      <section class=\\\"glass\\\" style=\\\"margin-top:18px\\\">\\n        <h2>Instruments highlighted for private work</h2>\\n        <p class=\\\"small\\\">For one-on-one work we emphasize tuning forks, a deep wooden monochord, and hand-held chimes to enable precise somatic attunement.</p>\\n      </section>\\n\\n      <section class=\\\"glass\\\" style=\\\"margin-top:18px\\\">\\n        <h2>Client stories</h2>\\n        <div style=\\\"display:flex;gap:12px;flex-wrap:wrap\\\">\\n          <div class=\\\"testimonial\\\" style=\\\"padding:12px;border-radius:10px\\\">\\\"I regained steady sleep within a week after a single targeted session.\\\" — A.M.</div>\\n          <div class=\\\"testimonial\\\" style=\\\"padding:12px;border-radius:10px\\\">\\\"Our team left with practical breathing cues and noticeably calmer energy.\\\" — Q.T., HR Lead</div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"glass\\\" style=\\\"margin-top:18px\\\">\\n        <h2>How to book</h2>\\n        <p class=\\\"small\\\">Use the request form to share your goals, preferred format (in-person / online), and available dates. We'll respond within 48 hours to confirm and plan the session.</p>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Request a private session</a>\\n      </section>\\n\\n    </main>\\n\\n    <footer style=\\\"width:100%;max-width:var(--maxw);margin-top:18px;color:#aeeff2\\\">\\n      <div>{{BUSINESS_NAME}} • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#cfeefb\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:#cfeefb\\\">{{PHONE}}</a></div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Rates & Packages — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg1:#041722;--glass:rgba(255,255,255,0.04);--accent:#A8FFF9;--muted:#BEEFF6;--maxw:1000px}\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg1),#021219);color:#e7fbff;font-family:Inter,system-ui,Arial}\\n    .container{padding:40px;display:flex;flex-direction:column;align-items:center}\\n    header{width:100%;max-width:var(--maxw);display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}\\n    nav a{color:var(--muted);text-decoration:none;margin-left:14px}\\n    .glass{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border:1px solid rgba(255,255,255,0.05);padding:18px;border-radius:12px}\\n    .pack-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:14px}\\n    .pack{padding:18px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);border:1px solid rgba(255,255,255,0.03)}\\n    .price{font-size:20px;color:#eaffff;font-weight:800}\\n    .muted{color:#cfeefb}\\n    .cta{margin-top:12px}\\n    .btn{background:linear-gradient(90deg,var(--accent),#7EE0C3);color:#052428;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .pattern{position:fixed;right:20px;bottom:20px;width:420px;height:420px;opacity:0.08;pointer-events:none}\\n    @media (max-width:900px){.pack-grid{grid-template-columns:1fr}.header-actions{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"pattern\\\" viewBox=\\\"0 0 600 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"g3\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#A8FFF9\\\" stop-opacity=\\\"0.16\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#9BD7FF\\\" stop-opacity=\\\"0.06\\\"/>\\n      </linearGradient>\\n      <pattern id=\\\"p3\\\" width=\\\"80\\\" height=\\\"80\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"80\\\" height=\\\"80\\\" fill=\\\"transparent\\\"/>\\n        <path d=\\\"M0 40 L80 40\\\" stroke=\\\"#bff7ee\\\" stroke-opacity=\\\"0.12\\\" stroke-width=\\\"1\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#g3)\\\"/>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p3)\\\" opacity=\\\"0.9\\\"/>\\n  </svg>\\n\\n  <div class=\\\"container\\\">\\n    <header class=\\\"glass\\\" style=\\\"width:100%;max-width:var(--maxw)\\\">\\n      <div style=\\\"font-weight:700;color:var(--accent)\\\">{{BUSINESS_NAME}}</div>\\n      <div class=\\\"header-actions\\\">\\n        <nav>\\n          <a href=\\\"index.html\\\">Overview</a>\\n          <a href=\\\"events.html\\\">Sessions</a>\\n          <a href=\\\"private-sessions.html\\\">Private</a>\\n        </nav>\\n      </div>\\n    </header>\\n\\n    <main style=\\\"width:100%;max-width:var(--maxw)\\\">\\n      <section class=\\\"glass\\\">\\n        <h1 style=\\\"margin:0;color:#eaffff\\\">Investment & packages</h1>\\n        <p class=\\\"muted\\\">Transparent pricing for group and private offerings. Hybrid availability (in-studio and live remote) is indicated on each package.</p>\\n      </section>\\n\\n      <section class=\\\"pack-grid\\\">\\n        <div class=\\\"pack glass\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Community session (drop-in)</div>\\n              <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Group sound bath — hybrid</div>\\n            </div>\\n            <div class=\\\"price\\\">$35</div>\\n          </div>\\n          <p class=\\\"muted\\\">Single admission. Online stream available; recorded takeaways sent to attendees.</p>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"book.html\\\">Book a seat</a></div>\\n        </div>\\n\\n        <div class=\\\"pack glass\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Course — four sessions</div>\\n              <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Series package; recommended for deeper nervous system regulation</div>\\n            </div>\\n            <div class=\\\"price\\\">$120</div>\\n          </div>\\n          <p class=\\\"muted\\\">Includes short between-session support email and priority booking for private sessions.</p>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Reserve package</a></div>\\n        </div>\\n\\n        <div class=\\\"pack glass\\\">\\n          <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n            <div>\\n              <div style=\\\"font-weight:700\\\">Private 60 min (1:1)</div>\\n              <div class=\\\"muted\\\" style=\\\"font-size:13px\\\">Tailored session — in-studio or remote</div>\\n            </div>\\n            <div class=\\\"price\\\">$160</div>\\n          </div>\\n          <p class=\\\"muted\\\">Focused work with instruments such as tuning forks and a wooden monochord, plus intake and integration guidance.</p>\\n          <div class=\\\"cta\\\"><a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Request private</a></div>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"glass\\\" style=\\\"margin-top:16px\\\">\\n        <h2 style=\\\"margin:0\\\">Short-form & corporate</h2>\\n        <p class=\\\"muted\\\">Team resilience sessions (30–45 min) are priced per group. Contact for custom quotes and half-day workshop rates.</p>\\n      </section>\\n\\n      <section class=\\\"glass\\\" style=\\\"margin-top:16px;display:flex;gap:12px;flex-wrap:wrap\\\">\\n        <div style=\\\"flex:1;min-width:260px\\\">\\n          <h3 style=\\\"margin:0\\\">Included in all private bookings</h3>\\n          <ul class=\\\"muted\\\">\\n            <li>Pre-session intake and goals alignment.</li>\\n            <li>Aftercare notes and practical breathing cues.</li>\\n            <li>Option for hybrid connection and high-fidelity stream.</li>\\n          </ul>\\n        </div>\\n        <div style=\\\"flex:1;min-width:260px\\\">\\n          <h3 style=\\\"margin:0\\\">Safety & contraindications</h3>\\n          <p class=\\\"muted\\\">Please advise if pregnant, have implanted medical devices, are under psychiatric care, or have seizure history. We will adapt sessions or decline when clinically necessary for safety.</p>\\n        </div>\\n      </section>\\n\\n      <section class=\\\"glass\\\" style=\\\"margin-top:16px\\\">\\n        <h2 style=\\\"margin:0\\\">Instrument focus — curated palette</h2>\\n        <p class=\\\"muted\\\">Pricing emphasizes the curated sound palette. For example, private sessions commonly use tuning forks, mono-string instruments, and softly struck bowls to create a precise, low-frequency support field.</p>\\n      </section>\\n\\n      <section class=\\\"glass\\\" style=\\\"margin-top:16px\\\">\\n        <h2 style=\\\"margin:0\\\">Questions or custom requests?</h2>\\n        <p class=\\\"muted\\\">Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#cfeefb;text-decoration:none\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:#cfeefb;text-decoration:none\\\">{{PHONE}}</a>. For corporate or site visits, please include expected headcount and desired outcomes.</p>\\n        <a class=\\\"btn\\\" href=\\\"contact.html\\\" style=\\\"margin-top:10px;display:inline-block\\\">Contact us</a>\\n      </section>\\n\\n    </main>\\n\\n    <footer style=\\\"width:100%;max-width:var(--maxw);margin-top:18px;color:#bfeeff\\\">\\n      <div>{{BUSINESS_NAME}} • {{CITY}}, {{STATE}} • {{PRIMARY_CTA_LABEL}}</div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
