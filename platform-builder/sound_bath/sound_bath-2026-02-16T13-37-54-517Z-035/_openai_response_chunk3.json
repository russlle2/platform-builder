          "text": "BUNDLE_START\n{\"path\":\"about.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>{{BUSINESS_NAME}} — About</title>\\n  <meta name=\\\"description\\\" content=\\\"Playful, premium sound experiences in {{CITY}}, {{STATE}} — meet the facilitator and learn our approach.\\\">\\n  <style>\\n    :root{\\n      --bg1:#f6efe6; --bg2:#efe6da; --accent:#6b4f3b; --muted:#7a6b61; --card:#fffaf4; --glass: rgba(255,255,255,0.6);\\n      --maxw:980px; --radius:14px; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;\\n    }\\n    *{box-sizing:border-box}\\n    body{margin:0; background:linear-gradient(135deg,var(--bg1),var(--bg2)); color:var(--accent);}\\n    header{position:relative; padding:28px 18px; display:flex; align-items:center; justify-content:space-between; max-width:var(--maxw); margin:0 auto}\\n    .brand{display:flex; gap:12px; align-items:center}\\n    .logo{width:56px; height:56px; border-radius:12px; background:linear-gradient(180deg,#fffefc, #f1e6db); display:flex; align-items:center; justify-content:center; box-shadow:0 6px 20px rgba(107,79,59,0.12); font-weight:700}\\n    nav a{color:var(--muted); text-decoration:none; margin-left:14px; font-size:15px}\\n    main{max-width:var(--maxw); margin:20px auto; padding:36px}\\n\\n    /* hero */\\n    .hero{display:grid; grid-template-columns:1fr 360px; gap:28px; align-items:center}\\n    .heroCard{background:linear-gradient(180deg,var(--card),#fffefb); padding:28px; border-radius:var(--radius); box-shadow:0 10px 40px rgba(106,85,65,0.08)}\\n    h1{margin:0 0 8px 0; font-size:28px; color:var(--accent)}\\n    .lede{color:var(--muted); margin:0 0 16px}\\n    .cta{display:inline-block; background:linear-gradient(90deg,#b07a52,#6b4f3b); color:white; padding:12px 18px; border-radius:10px; text-decoration:none}\\n\\n    /* SVG backdrop */\\n    .patternWrap{position:absolute; right:6%; top:8%; width:420px; height:320px; pointer-events:none; opacity:0.14}\\n    .story{margin-top:22px; display:grid; gap:18px}\\n    .pill{display:inline-block; background:var(--glass); padding:8px 12px; border-radius:999px; font-weight:600; font-size:13px; color:var(--accent)}\\n    .flow{display:flex; gap:12px; flex-wrap:wrap}\\n    .flow .step{background:#fff; padding:12px 14px; border-radius:10px; box-shadow:0 6px 18px rgba(107,79,59,0.06); color:var(--muted)}\\n\\n    .fac{display:flex; gap:16px; align-items:center; margin-top:8px}\\n    .avatar{width:80px; height:80px; border-radius:12px; background:linear-gradient(180deg,#fff,#efe3d7); display:flex; align-items:center; justify-content:center; font-weight:700; color:var(--accent)}\\n\\n    footer{max-width:var(--maxw); margin:40px auto; padding:20px 36px; color:var(--muted)}\\n\\n    @media (max-width:880px){\\n      .hero{grid-template-columns:1fr;}\\n      .patternWrap{display:none}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">SB</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Gatherings</a>\\n      <a href=\\\"events.html\\\">Calendar</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <div class=\\\"hero\\\">\\n      <div class=\\\"heroCard\\\">\\n        <div class=\\\"pill\\\">About — Sensory Immersion</div>\\n        <h1>We craft sound journeys that feel like sunlight through cedar</h1>\\n        <p class=\\\"lede\\\">A playful, premium approach to intensive sound bathing — small groups, curated instruments, spacious breathing room. Facilitated by {{FACILITATOR_NAME}} at {{VENUE_NAME}} in {{CITY}}, {{STATE}}.</p>\\n        <a class=\\\"cta\\\" href=\\\"book.html\\\">{{PRIMARY_CTA_LABEL}}</a>\\n\\n        <div class=\\\"story\\\">\\n          <div>\\n            <strong style=\\\"color:var(--accent)\\\">Our philosophy</strong>\\n            <p style=\\\"margin:6px 0 0;color:var(--muted)\\\">We weave resonance, silence and intentional pacing into an experience that supports deep nervous system downshift. Think of it as an intensive tune-up for mind and body.</p>\\n          </div>\\n\\n          <div>\\n            <strong style=\\\"color:var(--accent)\\\">Typical flow</strong>\\n            <div class=\\\"flow\\\" aria-hidden>\\n              <div class=\\\"step\\\">Arrival + grounding (10–15m)</div>\\n              <div class=\\\"step\\\">Breath & intention (5–10m)</div>\\n              <div class=\\\"step\\\">Sound immersion (40–60m)</div>\\n              <div class=\\\"step\\\">Gentle reintegration & tea (10–15m)</div>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <aside style=\\\"position:relative\\\">\\n        <div class=\\\"heroCard\\\" style=\\\"padding:20px\\\">\\n          <strong style=\\\"display:block;color:var(--accent)\\\">Meet the facilitator</strong>\\n          <div class=\\\"fac\\\">\\n            <div class=\\\"avatar\\\">{{FACILITATOR_NAME}}</div>\\n            <div>\\n              <div style=\\\"font-weight:700\\\">{{FACILITATOR_NAME}}</div>\\n              <div style=\\\"color:var(--muted);font-size:13px;margin-top:6px\\\">Certified sound healer, somatic coach & cup-of-tea enthusiast. Specializes in personalized, intensive sessions and small-group ceremonies.</div>\\n            </div>\\n          </div>\\n\\n          <hr style=\\\"border:none;border-top:1px solid #efe7dd;margin:14px 0\\\">\\n\\n          <strong style=\\\"color:var(--accent)\\\">Instruments featured</strong>\\n          <p style=\\\"color:var(--muted);margin:6px 0 0\\\">Crystal bowls, monochord, chimes — curated per session for tonal clarity and subtle harmonics.</p>\\n\\n          <div style=\\\"margin-top:14px\\\">\\n            <a class=\\\"cta\\\" href=\\\"private-sessions.html\\\" style=\\\"display:inline-block\\\">Inquire private</a>\\n          </div>\\n        </div>\\n\\n        <svg class=\\\"patternWrap\\\" viewBox=\\\"0 0 600 420\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n          <defs>\\n            <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n              <stop offset=\\\"0\\\" stop-color=\\\"#d9c7b6\\\" />\\n              <stop offset=\\\"1\\\" stop-color=\\\"#f3e9df\\\" />\\n            </linearGradient>\\n          </defs>\\n          <rect rx=\\\"20\\\" width=\\\"600\\\" height=\\\"420\\\" fill=\\\"url(#g1)\\\" />\\n          <g fill=\\\"#fff\\\" opacity=\\\"0.22\\\">\\n            <circle cx=\\\"110\\\" cy=\\\"60\\\" r=\\\"46\\\" />\\n            <circle cx=\\\"480\\\" cy=\\\"160\\\" r=\\\"72\\\" />\\n            <circle cx=\\\"360\\\" cy=\\\"320\\\" r=\\\"36\\\" />\\n          </g>\\n        </svg>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:28px\\\">\\n      <div style=\\\"background:linear-gradient(180deg,#fff,#fffaf6); padding:18px; border-radius:12px; box-shadow:0 12px 30px rgba(107,79,59,0.05)\\\">\\n        <h3 style=\\\"margin:0;color:var(--accent)\\\">What to bring</h3>\\n        <ul style=\\\"margin:10px 0 0;color:var(--muted)\\\">\\n          <li>Yoga mat or thick blanket, cushion for neck support</li>\\n          <li>Blanket for warmth — sessions create gentle body temperature shifts</li>\\n          <li>Water bottle; avoid heavy meals 60–90 minutes before</li>\\n        </ul>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div style=\\\"background:#fffaf4; padding:14px; border-radius:12px\\\">\\n        <strong style=\\\"color:var(--accent)\\\">Contraindications & safety</strong>\\n        <p style=\\\"color:var(--muted); margin:8px 0 0\\\">If you are pregnant, have epilepsy, uncontrolled high blood pressure, recent surgery, or are under treatment for a serious cardiac condition, please consult your physician and notify us before booking. Intensive sound can be strong; we adapt where needed.</p>\\n      </div>\\n    </section>\\n\\n  </main>\\n\\n  <footer>\\n    <div style=\\\"display:flex; justify-content:space-between; align-items:center; max-width:var(--maxw); margin:0 auto\\\">\\n      <div style=\\\"color:var(--muted)\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n      <div style=\\\"color:var(--muted)\\\">&copy; {{BUSINESS_NAME}}</div>\\n    </div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"faq.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>FAQ — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Frequently asked questions about our intensive sound baths — flow, accessibility, instruments and booking details.\\\">\\n  <style>\\n    :root{--bg:#f7efe6; --accent:#6b4f3b; --muted:#7a6b61; --card:#fffaf4; font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;}\\n    body{margin:0;background:radial-gradient(circle at 10% 10%, #fbf6ef, #f3e9df 40%, var(--bg)); color:var(--accent)}\\n    header{padding:18px 20px; display:flex; justify-content:space-between; align-items:center}\\n    nav a{margin-left:12px;color:var(--muted);text-decoration:none}\\n    main{max-width:980px;margin:6px auto;padding:24px}\\n    h1{margin:4px 0 16px;font-size:26px}\\n    .grid{display:grid; grid-template-columns:1fr 320px; gap:22px}\\n    .qa{background:var(--card); padding:18px; border-radius:12px; box-shadow:0 10px 30px rgba(107,79,59,0.06)}\\n    .faqItem{border-bottom:1px dashed #efe3d9;padding:12px 0}\\n    .question{font-weight:700}\\n    .answer{color:var(--muted); margin-top:6px}\\n    .aside{padding:18px;background:linear-gradient(180deg,#fff,#fffaf6);border-radius:12px}\\n    .micro{margin-top:14px;background:#fffaf4;padding:12px;border-radius:10px}\\n    footer{max-width:980px;margin:28px auto;color:var(--muted);padding:0 24px}\\n    .svgTop{position:absolute; left:6px; top:70px; opacity:0.1}\\n\\n    @media (max-width:880px){.grid{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div style=\\\"width:46px;height:46px;border-radius:10px;background:#fff;padding:8px;display:flex;align-items:center;justify-content:center;font-weight:700\\\">SB</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Next Events</a>\\n      <a href=\\\"book.html\\\">Reserve</a>\\n      <a href=\\\"contact.html\\\">Hello</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <h1>Questions people ask before their first intensive</h1>\\n\\n    <div class=\\\"grid\\\">\\n      <div class=\\\"qa\\\">\\n        <div class=\\\"faqItem\\\">\\n          <div class=\\\"question\\\">How long is a session and what happens?</div>\\n          <div class=\\\"answer\\\">Typical group intensives are 75–90 minutes. We begin with arrival, gentle breathwork and an intention-setting moment, move through the sound immersion featuring tuned instruments, and finish with a slow reintegration and optional tea. Expect low lights, comfortable repose and spacious timing.</div>\\n        </div>\\n\\n        <div class=\\\"faqItem\\\">\\n          <div class=\\\"question\\\">What should I bring and wear?</div>\\n          <div class=\\\"answer\\\">Bring a yoga mat or thick blanket, a small pillow for neck support, and an extra blanket for warmth. Dress in comfortable layers. Avoid heavy perfumes.</div>\\n        </div>\\n\\n        <div class=\\\"faqItem\\\">\\n          <div class=\\\"question\\\">Are there contraindications?</div>\\n          <div class=\\\"answer\\\">If you have epilepsy, are in the first trimester of pregnancy, have a pacemaker, recent surgery, or are under treatment for severe cardiac conditions, please consult your doctor and let us know before attending. We can adapt many things but safety-first is our policy.</div>\\n        </div>\\n\\n        <div class=\\\"faqItem\\\">\\n          <div class=\\\"question\\\">Are recordings allowed?</div>\\n          <div class=\\\"answer\\\">To preserve the group field and intimacy of the work we ask that you do not record during immersive segments. Phone-free experiences are best.</div>\\n        </div>\\n\\n        <div class=\\\"faqItem\\\">\\n          <div class=\\\"question\\\">Do you accept walk-ins?</div>\\n          <div class=\\\"answer\\\">Most intensives have limited seating. We recommend booking in advance. For last-minute availability call {{PHONE}}.</div>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"aside\\\">\\n        <strong style=\\\"color:var(--accent)\\\">Quick logistics</strong>\\n        <p style=\\\"color:var(--muted);margin:8px 0\\\">Location: {{VENUE_NAME}} — cozy, accessible with limited street parking. Sessions usually begin on time to preserve the container.</p>\\n\\n        <div class=\\\"micro\\\">\\n          <strong>Three tiny habits (micro practices)</strong>\\n          <ol style=\\\"margin:8px 0 0;color:var(--muted)\\\">\\n            <li>Two-minute evening breath count to downshift.</li>\\n            <li>Warm drink and five minutes of silence before bed.</li>\\n            <li>Gentle neck rolls in the morning to release tension.</li>\\n          </ol>\\n        </div>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <strong style=\\\"color:var(--accent)\\\">Instruments you'll likely hear</strong>\\n          <p style=\\\"color:var(--muted);margin:6px 0 0\\\">Gong, tuning forks, and delicate bells — selection varies to meet the energetic shape of the room.</p>\\n        </div>\\n\\n        <div style=\\\"margin-top:14px\\\">\\n          <a href=\\\"book.html\\\" style=\\\"background:#6b4f3b;color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none\\\">Reserve a seat</a>\\n        </div>\\n\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px;background:linear-gradient(180deg,#fff,#fffaf6);padding:14px;border-radius:12px\\\">\\n      <strong style=\\\"color:var(--accent)\\\">Accessibility & quiet</strong>\\n      <p style=\\\"color:var(--muted);margin:8px 0\\\">We aim to make our offerings accessible; please contact us ahead of booking so we can prepare a comfortable setup. If you need to leave during a session, we’ll provide a soft re-entry to the field afterward.</p>\\n    </section>\\n\\n  </main>\\n\\n  <svg class=\\\"svgTop\\\" width=\\\"220\\\" height=\\\"220\\\" viewBox=\\\"0 0 220 220\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <radialGradient id=\\\"rg\\\" cx=\\\"30%\\\" cy=\\\"30%\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#d9c7b6\\\" />\\n        <stop offset=\\\"1\\\" stop-color=\\\"#f3e9df\\\" />\\n      </radialGradient>\\n    </defs>\\n    <rect width=\\\"220\\\" height=\\\"220\\\" rx=\\\"26\\\" fill=\\\"url(#rg)\\\" />\\n    <g fill=\\\"#fff\\\" opacity=\\\"0.12\\\">\\n      <circle cx=\\\"40\\\" cy=\\\"40\\\" r=\\\"22\\\" />\\n      <circle cx=\\\"170\\\" cy=\\\"100\\\" r=\\\"46\\\" />\\n    </g>\\n  </svg>\\n\\n  <footer>\\n    <div style=\\\"max-width:980px;margin:18px auto;padding:0 24px;color:var(--muted)\\\">Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \n{\"path\":\"book.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Book — {{BUSINESS_NAME}}</title>\\n  <meta name=\\\"description\\\" content=\\\"Reserve your spot for an intensive sound bath session. Choose group or private, pick a date, and tell us about any needs or contraindications.\\\">\\n  <style>\\n    :root{--bg:#f3e9df; --deep:#5a3f31; --muted:#7a6b61; --card:#fffaf6; font-family: 'Helvetica Neue', Arial, system-ui;}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg),#f6efe6); color:var(--deep)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:16px 20px}\\n    nav a{color:var(--muted);margin-left:12px;text-decoration:none}\\n    main{max-width:980px;margin:18px auto;padding:22px}\\n    h1{margin:0 0 10px}\\n    .split{display:grid;grid-template-columns:1fr 380px;gap:20px}\\n    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 10px 30px rgba(90,63,49,0.06)}\\n    label{display:block;font-weight:700;margin-top:10px}\\n    input, select, textarea{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid #efe3d9}\\n    .btn{display:inline-block;background:linear-gradient(90deg,#b07a52,#6b4f3b);color:white;padding:12px 16px;border-radius:10px;text-decoration:none;margin-top:12px}\\n    .note{color:var(--muted);font-size:14px;margin-top:8px}\\n    .price{font-weight:700;color:var(--deep);font-size:18px}\\n    .pattern{position:absolute; right:12px; top:80px; opacity:0.08}\\n\\n    @media (max-width:880px){.split{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n      <div style=\\\"width:46px;height:46px;border-radius:10px;background:#fff;display:flex;align-items:center;justify-content:center;font-weight:700\\\">SB</div>\\n      <div>\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Events</a>\\n      <a href=\\\"about.html\\\">Our Story</a>\\n      <a href=\\\"faq.html\\\">FAQ</a>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <h1>Reserve your intensive</h1>\\n    <p style=\\\"color:var(--muted);margin-top:6px\\\">Choose group or private. If you're booking for a special need (pregnancy, mobility, intensive work), note it below — we customize the container.</p>\\n\\n    <div class=\\\"split\\\">\\n      <form class=\\\"card\\\" id=\\\"bookingForm\\\" onsubmit=\\\"return submitForm()\\\">\\n        <label for=\\\"type\\\">Session type</label>\\n        <select id=\\\"type\\\" name=\\\"type\\\" required>\\n          <option value=\\\"group\\\">Group Intensive (limited seating)</option>\\n          <option value=\\\"private\\\">1:1 Private Intensive</option>\\n          <option value=\\\"couples\\\">Couples - Shared 1:1</option>\\n          <option value=\\\"corporate\\\">Corporate / Team Reset</option>\\n        </select>\\n\\n        <label for=\\\"date\\\">Preferred date</label>\\n        <input id=\\\"date\\\" name=\\\"date\\\" placeholder=\\\"e.g. {{NEXT_EVENT_DATE}} or MM/DD/YYYY\\\" required />\\n\\n        <label for=\\\"name\\\">Full name</label>\\n        <input id=\\\"name\\\" name=\\\"name\\\" required />\\n\\n        <label for=\\\"email\\\">Email</label>\\n        <input id=\\\"email\\\" name=\\\"email\\\" type=\\\"email\\\" required />\\n\\n        <label for=\\\"phone\\\">Phone</label>\\n        <input id=\\\"phone\\\" name=\\\"phone\\\" required />\\n\\n        <label for=\\\"notes\\\">Notes / Contraindications</label>\\n        <textarea id=\\\"notes\\\" name=\\\"notes\\\" rows=\\\"4\\\" placeholder=\\\"Let us know about medical conditions, pregnancy, recent surgery, pacemaker, or anything else\\\"></textarea>\\n\\n        <div style=\\\"display:flex;gap:10px;align-items:center;margin-top:12px\\\">\\n          <input id=\\\"agree\\\" type=\\\"checkbox\\\" required />\\n          <label for=\\\"agree\\\" style=\\\"margin:0\\\">I confirm I have read the contraindications and general policies.</label>\\n        </div>\\n\\n        <button class=\\\"btn\\\" type=\\\"submit\\\">{{PRIMARY_CTA_LABEL}}</button>\\n\\n        <p class=\\\"note\\\">We will reply within 24 hours to confirm availability and request payment. For urgent booking call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a>.</p>\\n      </form>\\n\\n      <aside class=\\\"card\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div>\\n            <div style=\\\"color:var(--muted);font-size:13px\\\">Next event</div>\\n            <div style=\\\"font-weight:700;margin-top:6px\\\">{{NEXT_EVENT_DATE}}</div>\\n          </div>\\n          <div style=\\\"text-align:right\\\">\\n            <div style=\\\"color:var(--muted);font-size:13px\\\">Starting at</div>\\n            <div class=\\\"price\\\">$65 — group</div>\\n          </div>\\n        </div>\\n\\n        <hr style=\\\"border:none;border-top:1px solid #efe3d9;margin:12px 0\\\">\\n\\n        <strong style=\\\"color:var(--deep)\\\">What to expect</strong>\\n        <p style=\\\"color:var(--muted);margin-top:8px\\\">A calm room, guided arrival, intentional breathwork, and a 40–60 minute sound immersion. We'll finish with soft re-entry and time to share. Private sessions are longer and tailored.</p>\\n\\n        <strong style=\\\"display:block;margin-top:10px;color:var(--deep)\\\">Example instruments</strong>\\n        <p style=\\\"color:var(--muted);margin-top:6px\\\">Tuning forks, crystal bowls, and a warm gong for lower harmonics — instrument set adapts for the request.</p>\\n\\n        <strong style=\\\"display:block;margin-top:10px;color:var(--deep)\\\">Cancellation policy</strong>\\n        <p style=\\\"color:var(--muted);margin-top:6px\\\">Full refund up to 72 hours before. Within 72 hours we offer a credit toward another session.</p>\\n\\n        <div style=\\\"margin-top:12px\\\">\\n          <a href=\\\"contact.html\\\" style=\\\"color:var(--deep);text-decoration:underline\\\">Questions? Reach out</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n      <strong style=\\\"color:var(--deep)\\\">Safety note — must-read</strong>\\n      <p style=\\\"color:var(--muted);margin-top:8px\\\">If you are pregnant, have epilepsy, a pacemaker, or have undergone recent surgery, please consult your medical provider before attending. Notify us in the booking notes so we can adapt the session. We do not diagnose — we provide a supportive container.</p>\\n    </section>\\n\\n  </main>\\n\\n  <svg class=\\\"pattern\\\" width=\\\"260\\\" height=\\\"300\\\" viewBox=\\\"0 0 260 300\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" aria-hidden>\\n    <defs>\\n      <linearGradient id=\\\"lg2\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n        <stop offset=\\\"0\\\" stop-color=\\\"#e9d7c6\\\"/>\\n        <stop offset=\\\"1\\\" stop-color=\\\"#f6efe6\\\"/>\\n      </linearGradient>\\n    </defs>\\n    <rect width=\\\"260\\\" height=\\\"300\\\" rx=\\\"24\\\" fill=\\\"url(#lg2)\\\" />\\n    <g fill=\\\"#fff\\\" opacity=\\\"0.12\\\">\\n      <ellipse cx=\\\"60\\\" cy=\\\"50\\\" rx=\\\"40\\\" ry=\\\"24\\\" />\\n      <ellipse cx=\\\"180\\\" cy=\\\"170\\\" rx=\\\"70\\\" ry=\\\"36\\\" />\\n      <circle cx=\\\"210\\\" cy=\\\"40\\\" r=\\\"22\\\" />\\n    </g>\\n  </svg>\\n\\n  <script>\\n    function submitForm(){\\n      var f=document.getElementById('bookingForm');\\n      var type=f.type.value; var date=f.date.value; var name=f.name.value; var email=f.email.value;\\n      if(!date||!name||!email){ alert('Please complete required fields.'); return false; }\\n      // Simulate submission — in real site this would POST to server\\n      alert('Thanks '+name+\\\"! We'll confirm your \\\"+type+\\\" booking for \\\"+date+\\\" via email shortly.\\\");\\n      f.reset(); return false;\\n    }\\n  </script>\\n\\n  <footer style=\\\"max-width:980px;margin:22px auto;padding:0 22px;color:var(--muted)\\\">\\n    <div>Contact: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n  </footer>\\n</body>\\n</html>\"} \nBUNDLE_END"
