          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Gatherings — {{BUSINESS_NAME}} Sound Baths</title>\\n  <style>\\n    :root{\\n      --bg1:#F5EFE6; /* warm sand */\\n      --bg2:#E8D6C2; /* beige */\\n      --accent:#7A5230; /* clay */\\n      --muted:#6A6A6A;\\n      --card:#FFF8F3;\\n      --glass:rgba(255,255,255,0.6);\\n      --radius:16px;\\n      font-family: -apple-system, BlinkMacSystemFont, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;\\n    }\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg1),var(--bg2));color:var(--accent);}\\n    .site{min-height:100vh;display:flex;flex-direction:column;}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:28px 32px}\\n    .brand{display:flex;align-items:center;gap:16px}\\n    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,#B88A64,#E6D3C0);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;box-shadow:0 6px 18px rgba(122,82,48,0.12)}\\n    nav a{margin-left:18px;text-decoration:none;color:var(--accent);font-weight:600}\\n\\n    /* Hero */\\n    .hero{position:relative;padding:48px 32px 64px;display:grid;grid-template-columns:1fr 420px;gap:32px;align-items:center}\\n    .hero-card{background:var(--card);border-radius:var(--radius);padding:32px;box-shadow:0 8px 30px rgba(109,73,47,0.08);backdrop-filter:blur(6px)}\\n    h1{margin:0;font-size:40px;line-height:1.02}\\n    p.lead{color:var(--muted);margin-top:12px}\\n    .cta{display:inline-block;margin-top:18px;padding:12px 18px;border-radius:10px;background:linear-gradient(90deg,var(--accent),#A46B45);color:white;text-decoration:none;font-weight:700}\\n\\n    /* calendar */\\n    .calendar{background:linear-gradient(180deg,rgba(255,255,255,0.6),rgba(255,255,255,0.8));border-radius:12px;padding:18px}\\n    .next{font-size:14px;color:#8A5A3B;font-weight:700}\\n    .next-date{font-size:26px;margin-top:8px}\\n    .list{margin-top:12px}\\n    .list li{padding:10px 0;border-bottom:1px dashed rgba(122,82,48,0.12);color:var(--muted)}\\n\\n    /* sections */\\n    section{padding:36px 32px}\\n    .wrap{max-width:1100px;margin:0 auto}\\n    .grid{display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:start}\\n    .card{background:var(--glass);padding:20px;border-radius:12px}\\n    .pill{display:inline-block;padding:6px 10px;border-radius:999px;background:#F0E2D7;color:#7A5230;font-weight:700;margin-right:8px}\\n\\n    ul.habit{display:flex;flex-direction:column;gap:10px;padding-left:18px}\\n    footer{padding:28px 32px;color:var(--muted)}\\n\\n    /* SVG pattern overlay */\\n    .pattern{position:absolute;right:0;top:0;bottom:0;width:420px;pointer-events:none;opacity:0.14}\\n\\n    @media(max-width:880px){\\n      .hero{grid-template-columns:1fr;}\\n      .grid{grid-template-columns:1fr}\\n      .pattern{display:none}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"site\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">SB</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Nest</a>\\n        <a href=\\\"events.html\\\">Gatherings</a>\\n        <a href=\\\"private-sessions.html\\\">Private</a>\\n        <a href=\\\"pricing.html\\\">Fees</a>\\n        <a href=\\\"about.html\\\">Our Story</a>\\n      </nav>\\n    </header>\\n\\n    <!-- HERO -->\\n    <main class=\\\"hero wrap\\\">\\n      <div class=\\\"hero-card\\\">\\n        <span class=\\\"pill\\\">Upcoming</span>\\n        <h1>Sound Bath Gatherings — communal rest reimagined</h1>\\n        <p class=\\\"lead\\\">A 75-minute immersive session with layered harmonics, intentional silence and a warming, earthy atmosphere. We blend tone and breath to guide you into slow, restorative nervous system states.</p>\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n\\n        <section style=\\\"margin-top:20px\\\">\\n          <h3 style=\\\"margin:0\\\">What to bring</h3>\\n          <p style=\\\"color:var(--muted);margin-top:8px\\\">A yoga mat or blanket, a cozy blanket for warmth, an eye pillow if you prefer, and water. Wear layers for comfort.</p>\\n        </section>\\n\\n        <section style=\\\"margin-top:16px\\\">\\n          <h3 style=\\\"margin:0\\\">Contraindications</h3>\\n          <p style=\\\"color:var(--muted);margin-top:8px;font-size:14px\\\">Not suitable for those advised to avoid vibrational therapies, with acute psychiatric crises, or certain cardiac implants. Contact <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> for specifics.</p>\\n        </section>\\n      </div>\\n\\n      <aside class=\\\"calendar\\\">\\n        <div class=\\\"next\\\">Next Event</div>\\n        <div class=\\\"next-date\\\">{{NEXT_EVENT_DATE}}</div>\\n        <div style=\\\"font-size:13px;color:var(--muted);margin-top:6px\\\">{{VENUE_NAME}} • {{CITY}}, {{STATE}}</div>\\n        <ul class=\\\"list\\\" style=\\\"margin-top:12px\\\">\\n          <li><strong>Mar 05</strong> • Equinox Evening — 6:30pm</li>\\n          <li><strong>Mar 19</strong> • Full Tone Flow — 10:30am</li>\\n          <li><strong>Apr 02</strong> • Weekend Calm — 4:00pm</li>\\n          <li><strong>Apr 16</strong> • Evening Reset — 7:00pm</li>\\n        </ul>\\n        <div style=\\\"margin-top:12px\\\">\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve a seat</a>\\n        </div>\\n      </aside>\\n\\n      <svg class=\\\"pattern\\\" viewBox=\\\"0 0 400 800\\\" preserveAspectRatio=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n        <defs>\\n          <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#E6D3C0\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#B88A64\\\"/></linearGradient>\\n          <pattern id=\\\"p1\\\" width=\\\"80\\\" height=\\\"80\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(12)\\\">\\n            <rect width=\\\"80\\\" height=\\\"80\\\" fill=\\\"url(#g1)\\\"/>\\n            <path d=\\\"M0 60 C20 40 60 20 80 0\\\" stroke=\\\"#CFA58A\\\" stroke-opacity=\\\"0.18\\\" stroke-width=\\\"6\\\" fill=\\\"none\\\"/>\\n            <circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"4\\\" fill=\\\"#A46B45\\\" fill-opacity=\\\"0.14\\\"/>\\n          </pattern>\\n        </defs>\\n        <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p1)\\\"/>\\n      </svg>\\n    </main>\\n\\n    <!-- DIAGNOSTIC -->\\n    <section class=\\\"wrap\\\">\\n      <div class=\\\"grid\\\">\\n        <div>\\n          <h2>Why you might come</h2>\\n          <p style=\\\"color:var(--muted)\\\">People come when they crave a deep nervous-system reset, an evening without screens, or a gentle container for grief and creativity. Typical outcomes: clearer sleep, softened tension, and expanded breath.</p>\\n\\n          <div style=\\\"display:flex;gap:12px;margin-top:18px\\\">\\n            <div class=\\\"card\\\">\\n              <strong>Signs you’ll benefit</strong>\\n              <ul style=\\\"margin:8px 0 0 18px;color:var(--muted)\\\">\\n                <li>Restless nights or fragmented sleep</li>\\n                <li>Sustained tension in neck/shoulders</li>\\n                <li>Difficulty switching off from work</li>\\n              </ul>\\n            </div>\\n            <div class=\\\"card\\\">\\n              <strong>Not right for</strong>\\n              <ul style=\\\"margin:8px 0 0 18px;color:var(--muted)\\\">\\n                <li>Severe claustrophobia in shared rooms</li>\\n                <li>Unmanaged psychiatric emergencies</li>\\n              </ul>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <aside>\\n          <div class=\\\"card\\\">\\n            <h4 style=\\\"margin-top:0\\\">Instruments on this series</h4>\\n            <p style=\\\"color:var(--muted);margin-top:8px\\\">Crystal bowls, koshi chimes, bowed gong, and subtle tuning forks woven with breath cues — a tonal palette designed for full-body resonance.</p>\\n          </div>\\n        </aside>\\n      </div>\\n    </section>\\n\\n    <!-- PLAN -->\\n    <section class=\\\"wrap\\\" style=\\\"background:linear-gradient(180deg,transparent,rgba(255,250,246,0.6));border-top:1px solid rgba(122,82,48,0.06)\\\">\\n      <h2 style=\\\"margin-top:0\\\">Session Flow — what happens</h2>\\n      <div class=\\\"grid\\\">\\n        <div>\\n          <ol style=\\\"color:var(--muted);line-height:1.8\\\">\\n            <li>Arrival & gentle seating — 10 minutes (soft grounding prompts)</li>\\n            <li>Short breath practice — 8 minutes to anchor</li>\\n            <li>Main sound offering — 45 minutes of layered bowls, gong wash, and chimes</li>\\n            <li>Return & integration — sustained quiet, then soft talkback — 12 minutes</li>\\n          </ol>\\n          <p style=\\\"color:var(--muted);margin-top:12px\\\">We pace the sound intentionally: sustained tones give tissues time to attune, and silence between layers allows the nervous system to reorganize.</p>\\n        </div>\\n\\n        <aside>\\n          <div class=\\\"card\\\">\\n            <h4 style=\\\"margin-top:0\\\">Accessibility & format</h4>\\n            <p style=\\\"color:var(--muted);margin-top:8px\\\">Mats and blocks available on request. Rooms kept dim and temperature-moderate. If you need a seat instead of floor, notify us when you book.</p>\\n          </div>\\n        </aside>\\n      </div>\\n    </section>\\n\\n    <!-- MICRO HABITS -->\\n    <section class=\\\"wrap\\\">\\n      <h2>Micro practices to take home</h2>\\n      <div style=\\\"display:flex;gap:12px;margin-top:12px;flex-wrap:wrap\\\">\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:240px\\\">\\n          <strong>2-minute breath reset</strong>\\n          <p style=\\\"color:var(--muted)\\\">4-count inhale, 6-count exhale, repeat four times. Anchor with hand on belly.</p>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"flex:1;min-width:240px\\\">\\n          <strong>Sound-scan</strong>\\n          <p style=\\\"color:var(--muted)\\\">Hum once, listen for internal echoes, then breathe into the area that springs to attention.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- PRICING TEASER -->\\n    <section class=\\\"wrap\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap\\\">\\n        <div>\\n          <h3 style=\\\"margin:0\\\">Attend a gathering</h3>\\n          <p style=\\\"color:var(--muted);margin-top:8px\\\">Drop-in seats and small group passes available — see full rates on the Rates page.</p>\\n        </div>\\n        <div>\\n          <a class=\\\"cta\\\" href=\\\"pricing.html\\\">See rates</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- CTA FOOTER -->\\n    <section class=\\\"wrap\\\" style=\\\"padding-bottom:56px\\\">\\n      <div class=\\\"card\\\" style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n        <div>\\n          <strong>Ready to rest in harmonic company?</strong>\\n          <div style=\\\"color:var(--muted);margin-top:6px\\\">Reserve your spot — small group sizes to keep the field intimate.</div>\\n        </div>\\n        <div>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Book a seat</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"wrap\\\" style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap\\\">\\n        <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"color:var(--muted)\\\">Questions? <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Private Sessions — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{\\n      --bgA:#F3EFE8; --bgB:#E1CFBB; --accent:#5D3F26; --soft:#9F7C60; --muted:#655148; --card:#FFFDF9; --radius:14px;\\n      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;\\n    }\\n    body{margin:0;background:linear-gradient(180deg,var(--bgA),var(--bgB));color:var(--accent)}\\n    .wrap{max-width:1100px;margin:0 auto;padding:28px}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:20px 28px}\\n    .brand{display:flex;align-items:center;gap:14px}\\n    .logo{width:52px;height:52px;border-radius:10px;background:linear-gradient(135deg,#C9A07F,#EDE1D6);display:flex;align-items:center;justify-content:center;color:#3E2A20;font-weight:800}\\n    nav a{margin-left:14px;text-decoration:none;color:var(--muted);font-weight:700}\\n\\n    .hero{display:flex;gap:20px;align-items:center;padding:18px 0}\\n    .hero .left{flex:1}\\n    h1{margin:6px 0;font-size:34px}\\n    .sub{color:var(--muted)}\\n    .cta{display:inline-block;padding:10px 16px;background:var(--accent);color:white;border-radius:10px;text-decoration:none;font-weight:700}\\n\\n    .columns{display:grid;grid-template-columns:1fr 320px;gap:20px}\\n    .card{background:var(--card);padding:18px;border-radius:var(--radius);box-shadow:0 10px 30px rgba(93,63,38,0.06)}\\n    .option{margin-bottom:12px}\\n    .pill{background:#F0E5DB;padding:6px 10px;border-radius:999px;color:var(--soft);font-weight:800}\\n\\n    .micro{display:flex;gap:12px;flex-wrap:wrap}\\n    .micro .card{flex:1;min-width:220px}\\n\\n    footer{padding:20px 28px;color:var(--muted)}\\n\\n    /* unique inline pattern */\\n    .bgpattern{position:absolute;left:0;top:72px;bottom:0;width:280px;opacity:0.12;pointer-events:none}\\n\\n    @media(max-width:880px){.columns{grid-template-columns:1fr}.bgpattern{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <div style=\\\"position:relative;min-height:100vh;\\\">\\n    <svg class=\\\"bgpattern\\\" viewBox=\\\"0 0 200 800\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"g2\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#EDE1D6\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#C9A07F\\\"/></linearGradient>\\n        <pattern id=\\\"p2\\\" width=\\\"100\\\" height=\\\"100\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n          <rect width=\\\"100\\\" height=\\\"100\\\" fill=\\\"url(#g2)\\\"/>\\n          <path d=\\\"M10 90 Q50 10 90 90\\\" stroke=\\\"#A97B56\\\" stroke-width=\\\"8\\\" stroke-opacity=\\\"0.14\\\" fill=\\\"none\\\"/>\\n          <circle cx=\\\"70\\\" cy=\\\"30\\\" r=\\\"6\\\" fill=\\\"#D5B79A\\\" fill-opacity=\\\"0.16\\\"/>\\n        </pattern>\\n      </defs>\\n      <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p2)\\\"/>\\n    </svg>\\n\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">PS</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">Private offerings with {{FACILITATOR_NAME}}</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Home</a>\\n        <a href=\\\"events.html\\\">Events</a>\\n        <a href=\\\"private-sessions.html\\\">1:1 & Groups</a>\\n        <a href=\\\"pricing.html\\\">Rates</a>\\n      </nav>\\n    </header>\\n\\n    <main class=\\\"wrap\\\">\\n      <!-- HERO -->\\n      <div class=\\\"hero\\\">\\n        <div class=\\\"left\\\">\\n          <span class=\\\"pill\\\">Private</span>\\n          <h1>One-to-one sessions & curated experiences</h1>\\n          <p class=\\\"sub\\\">Deeper, personalized sound work: focused intention, bespoke instrument combinations, and integration guidance tailored to your life.</p>\\n          <a class=\\\"cta\\\" href=\\\"book.html\\\">Book a private</a>\\n        </div>\\n        <div style=\\\"width:320px\\\" class=\\\"card\\\">\\n          <strong>Location</strong>\\n          <div style=\\\"color:var(--muted);margin-top:8px\\\">In-studio at {{VENUE_NAME}} or on-site consults for corporate bookings in {{CITY}}, {{STATE}}.</div>\\n        </div>\\n      </div>\\n\\n      <!-- DIAGNOSTIC -->\\n      <section class=\\\"columns\\\" style=\\\"margin-top:18px\\\">\\n        <div>\\n          <h2>Which private is right for you?</h2>\\n          <p style=\\\"color:var(--muted)\\\">We meet you where you are: somatic recalibration, targeted pain relief, or hosted sound for group cohesion.</p>\\n\\n          <div style=\\\"margin-top:14px\\\">\\n            <div class=\\\"card option\\\">\\n              <h3 style=\\\"margin:0\\\">1:1 Healing Session — 60–90m</h3>\\n              <p style=\\\"color:var(--muted);margin-top:8px\\\">Individual intake, resonant mapping with a monochord and crystal bowl duet, followed by bespoke tone sequences. You’ll get tailored micro-practices and a short integration plan to continue at home.</p>\\n            </div>\\n\\n            <div class=\\\"card option\\\">\\n              <h3 style=\\\"margin:0\\\">Couples & Partner Work — 75m</h3>\\n              <p style=\\\"color:var(--muted);margin-top:8px\\\">Shared field-building to cultivate presence and collective breathwork. Instruments like chimes and tuned handpans make relational listening practical and delicious.</p>\\n            </div>\\n\\n            <div class=\\\"card option\\\">\\n              <h3 style=\\\"margin:0\\\">Corporate & Team — 90m</h3>\\n              <p style=\\\"color:var(--muted);margin-top:8px\\\">A facilitated session that blends sound with micro-break practices and a short debrief focused on focus & resilience. Great for leadership retreats and reset days.</p>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <aside>\\n          <div class=\\\"card\\\">\\n            <h4 style=\\\"margin-top:0\\\">What to bring</h4>\\n            <p style=\\\"color:var(--muted);margin-top:8px\\\">Loose clothing, any personal props that aid rest, and openness to lie or sit. We provide bolsters, blankets, and mats.</p>\\n            <h4 style=\\\"margin-top:10px\\\">Contraindications</h4>\\n            <p style=\\\"color:var(--muted);margin-top:6px;font-size:14px\\\">Private sessions are adaptable. If you have implants or a history of seizures, please consult your physician and inform us before booking.</p>\\n          </div>\\n        </aside>\\n      </section>\\n\\n      <!-- PLAN (order varied) -->\\n      <section style=\\\"margin-top:18px\\\">\\n        <div class=\\\"card\\\">\\n          <h2 style=\\\"margin-top:0\\\">Typical Private Session Flow</h2>\\n          <p style=\\\"color:var(--muted)\\\">Each offering is unique, but here’s a common rhythm:</p>\\n          <ol style=\\\"color:var(--muted);line-height:1.8\\\">\\n            <li>Check-in & breath mapping — 10–15m</li>\\n            <li>Focused tone offering — 30–50m using a curated orchestration</li>\\n            <li>Quiet integration & journaling — 5–10m</li>\\n            <li>Aftercare suggestions and micro-habits — 5m</li>\\n          </ol>\\n        </div>\\n      </section>\\n\\n      <!-- MICRO_HABITS -->\\n      <section style=\\\"margin-top:18px\\\">\\n        <h2>Short practices you’ll keep</h2>\\n        <div class=\\\"micro\\\">\\n          <div class=\\\"card\\\">\\n            <strong>Evening settling</strong>\\n            <p style=\\\"color:var(--muted)\\\">Two minutes of slow hums to dissolve jaw and neck tension. Great before sleep.</p>\\n          </div>\\n          <div class=\\\"card\\\">\\n            <strong>Desk reset</strong>\\n            <p style=\\\"color:var(--muted)\\\">Three shoulder rolls and a 30-second neck scan with a single tuning fork hum to re-center mid-day.</p>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <!-- PRICING SUMMARY -->\\n      <section style=\\\"margin-top:18px\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap\\\">\\n          <div class=\\\"card\\\" style=\\\"flex:1;min-width:260px\\\">\\n            <h4 style=\\\"margin-top:0\\\">1:1 Sessions</h4>\\n            <p style=\\\"color:var(--muted)\\\">60 min • 90 min options — includes email follow-up.</p>\\n            <div style=\\\"margin-top:8px\\\"><strong>See full fee schedule on the Rates page.</strong></div>\\n          </div>\\n          <div class=\\\"card\\\" style=\\\"width:320px\\\">\\n            <h4 style=\\\"margin-top:0\\\">Couples & Corporate</h4>\\n            <p style=\\\"color:var(--muted)\\\">Custom pricing based on number of participants and travel. Get a tailored quote.</p>\\n            <a class=\\\"cta\\\" href=\\\"pricing.html\\\">Request rates</a>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <!-- CTA -->\\n      <section style=\\\"margin-top:20px\\\">\\n        <div class=\\\"card\\\" style=\\\"display:flex;justify-content:space-between;align-items:center\\\">\\n          <div>\\n            <strong>Book a focused session with {{FACILITATOR_NAME}}</strong>\\n            <div style=\\\"color:var(--muted);margin-top:8px\\\">Choose in-studio or on-site for private groups.</div>\\n          </div>\\n          <div>\\n            <a class=\\\"cta\\\" href=\\\"book.html\\\">Start booking</a>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <footer style=\\\"margin-top:28px\\\">\\n        <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap\\\">\\n          <div style=\\\"font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"color:var(--muted)\\\">Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n        </div>\\n      </footer>\\n    </main>\\n  </div>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n  <title>Rates & Packages — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#F7F3EE;--primary:#7B4F34;--muted:#6B5A53;--card:#FFFDFB;--accent:#AA7A58;--radius:16px;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial}\\n    body{margin:0;background:linear-gradient(180deg,var(--bg),#EFE4D5);color:var(--primary)}\\n    .wrap{max-width:1100px;margin:0 auto;padding:34px}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:12px 0}\\n    .brand{display:flex;align-items:center;gap:12px}\\n    .logo{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,#D9B79C,#F6EDE5);display:flex;align-items:center;justify-content:center;font-weight:800}\\n    nav a{margin-left:14px;text-decoration:none;color:var(--muted)}\\n\\n    .hero{display:flex;gap:20px;align-items:center;padding:18px 0}\\n    h1{margin:0;font-size:34px}\\n    .sub{color:var(--muted)}\\n\\n    .plans{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}\\n    .plan{background:var(--card);border-radius:var(--radius);padding:20px;box-shadow:0 12px 30px rgba(122,82,48,0.06)}\\n    .price{font-size:22px;color:var(--primary);font-weight:800}\\n    .note{color:var(--muted);font-size:13px}\\n\\n    .cta{display:inline-block;padding:10px 14px;border-radius:10px;background:var(--primary);color:#fff;text-decoration:none;font-weight:700}\\n\\n    /* subtle svg */\\n    .toppattern{width:100%;height:72px;opacity:0.12}\\n\\n    @media(max-width:980px){.plans{grid-template-columns:1fr} .logo{display:none}}\\n  </style>\\n</head>\\n<body>\\n  <svg class=\\\"toppattern\\\" viewBox=\\\"0 0 1200 72\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n    <defs>\\n      <linearGradient id=\\\"gp\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#F6EDE5\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#D9B79C\\\"/></linearGradient>\\n      <pattern id=\\\"pp\\\" width=\\\"240\\\" height=\\\"72\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n        <rect width=\\\"240\\\" height=\\\"72\\\" fill=\\\"url(#gp)\\\"/>\\n        <path d=\\\"M0 36 C60 0 120 72 180 36 C240 0 300 72 360 36\\\" stroke=\\\"#CFA58A\\\" stroke-width=\\\"8\\\" stroke-opacity=\\\"0.14\\\" fill=\\\"none\\\"/>\\n      </pattern>\\n    </defs>\\n    <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#pp)\\\"/>\\n  </svg>\\n\\n  <div class=\\\"wrap\\\">\\n    <header>\\n      <div class=\\\"brand\\\">\\n        <div class=\\\"logo\\\">PR</div>\\n        <div>\\n          <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n          <div style=\\\"font-size:12px;color:var(--muted)\\\">Transparent pricing for restorative sessions</div>\\n        </div>\\n      </div>\\n      <nav>\\n        <a href=\\\"index.html\\\">Start</a>\\n        <a href=\\\"private-sessions.html\\\">Sessions</a>\\n        <a href=\\\"events.html\\\">Gatherings</a>\\n        <a href=\\\"about.html\\\">About</a>\\n      </nav>\\n    </header>\\n\\n    <!-- HERO -->\\n    <div class=\\\"hero\\\">\\n      <div>\\n        <h1>Rates & Packages</h1>\\n        <p class=\\\"sub\\\">Simple, honest pricing: drop-in options, multi-pass savings, and bespoke packages for private work.</p>\\n      </div>\\n      <div style=\\\"margin-left:auto;align-self:start\\\">\\n        <a class=\\\"cta\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </div>\\n\\n    <!-- DIAGNOSTIC (varied order) -->\\n    <section style=\\\"margin-top:12px\\\">\\n      <h2>Choose with clarity</h2>\\n      <p class=\\\"note\\\">If you’re unsure, start with a single public gathering to feel the field; move into private work for deeper change.</p>\\n    </section>\\n\\n    <!-- PRICING PLANS -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"plans\\\">\\n        <div class=\\\"plan\\\">\\n          <h3 style=\\\"margin-top:0\\\">Drop-in Gathering</h3>\\n          <div class=\\\"price\\\">$35</div>\\n          <div class=\\\"note\\\" style=\\\"margin-top:8px\\\">Single session ticket. Includes mat space and a short follow-up email.</div>\\n          <ul style=\\\"margin-top:12px;color:var(--muted)\\\">\\n            <li>75-minute group sound bath</li>\\n            <li>Small-group capacity</li>\\n            <li>Bring your mat/blanket</li>\\n          </ul>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Reserve</a></div>\\n        </div>\\n\\n        <div class=\\\"plan\\\">\\n          <h3 style=\\\"margin-top:0\\\">5-Pack Pass</h3>\\n          <div class=\\\"price\\\">$160</div>\\n          <div class=\\\"note\\\">Save when you commit to regular practice.</div>\\n          <ul style=\\\"margin-top:12px;color:var(--muted)\\\">\\n            <li>Five group sessions</li>\\n            <li>Shareable with a friend</li>\\n            <li>Valid for 6 months</li>\\n          </ul>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"book.html\\\">Buy pass</a></div>\\n        </div>\\n\\n        <div class=\\\"plan\\\">\\n          <h3 style=\\\"margin-top:0\\\">Private Session (1:1)</h3>\\n          <div class=\\\"price\\\">From $140</div>\\n          <div class=\\\"note\\\">60–90 minute bespoke session with intake and follow-up.</div>\\n          <ul style=\\\"margin-top:12px;color:var(--muted)\\\">\\n            <li>Monochord + tuned percussion</li>\\n            <li>Custom micro-habit plan</li>\\n            <li>On-site option for groups (quote)</li>\\n          </ul>\\n          <div style=\\\"margin-top:12px\\\"><a class=\\\"cta\\\" href=\\\"booking.html\\\">Request</a></div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- PLAN DETAILS -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2>Packages & customization</h2>\\n      <div style=\\\"display:flex;gap:12px;flex-wrap:wrap;margin-top:10px\\\">\\n        <div class=\\\"plan\\\" style=\\\"flex:1;min-width:260px\\\">\\n          <h4 style=\\\"margin-top:0\\\">Couples & Partner Work</h4>\\n          <p class=\\\"note\\\">75–90 minutes. From $240. Includes paired listening exercises and shared integration plan.</p>\\n        </div>\\n        <div class=\\\"plan\\\" style=\\\"flex:1;min-width:260px\\\">\\n          <h4 style=\\\"margin-top:0\\\">Corporate & Retreats</h4>\\n          <p class=\\\"note\\\">Custom pricing. Travel and setup fees may apply. Programs include sound offering + short facilitated practices to embed learning.</p>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- MICRO HABITS -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <h2>Included with private sessions</h2>\\n      <ul style=\\\"color:var(--muted)\\\">\\n        <li>Short written aftercare and two micro-habits tailored to your session.</li>\\n        <li>Audio snippet on request (extra fee) to support home practice.</li>\\n      </ul>\\n    </section>\\n\\n    <!-- CTA -->\\n    <section style=\\\"margin-top:18px\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap\\\">\\n        <div>\\n          <strong>Have a special request?</strong>\\n          <div class=\\\"note\\\" style=\\\"margin-top:6px\\\">We price bespoke offerings for groups and corporate events. Reach out with event size and goals.</div>\\n        </div>\\n        <div>\\n          <a class=\\\"cta\\\" href=\\\"contact.html\\\">Contact us</a>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <footer style=\\\"margin-top:28px;color:var(--muted)\\\">\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap\\\">\\n        <div style=\\\"font-weight:800\\\">{{BUSINESS_NAME}}</div>\\n        <div>Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
