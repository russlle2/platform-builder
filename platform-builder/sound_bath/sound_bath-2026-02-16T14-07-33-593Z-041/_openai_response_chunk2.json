          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Gatherings — {{BUSINESS_NAME}} • Sound Bath Events</title>\\n  <meta name=\\\"description\\\" content=\\\"Sensorial sound bath gatherings in {{CITY}}, {{STATE}} — layered with crystal bowls, gong, chimes, and tuning forks. Next event: {{NEXT_EVENT_DATE}}.\\\">\\n  <style>\\n    :root{\\n      --bg1:#f6efe6;--bg2:#efe6d9;--accent:#b26a3b;--muted:#7b6b5a;--card:#fffdf9;--glass:rgba(255,255,255,0.6);\\n      --radius:14px;--max:1100px;--frame:18px;--shadow:0 8px 30px rgba(43,39,33,0.08);\\n      font-family: \\\"Inter\\\", system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial;\\n    }\\n    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg1),var(--bg2));color:#3d352b}\\n    .wrap{max-width:var(--max);margin:48px auto;padding:28px;border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,0.6),rgba(255,250,244,0.6));box-shadow:var(--shadow);position:relative;overflow:hidden}\\n    /* embedded svg pattern sits behind content */\\n    .pattern{position:absolute;inset:0;opacity:0.28;mix-blend-mode:multiply;pointer-events:none}\\n    nav{display:flex;gap:14px;align-items:center;margin-bottom:22px}\\n    nav a{color:var(--muted);text-decoration:none;padding:8px 12px;border-radius:10px;font-weight:600}\\n    nav a.cta{background:linear-gradient(90deg,rgba(178,106,59,0.14),rgba(178,106,59,0.06));color:var(--accent)}\\n    header.hero{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\\n    .lead{padding:22px;background:var(--card);border-radius:var(--radius);box-shadow:0 6px 22px rgba(46,34,23,0.05)}\\n    h1{margin:0 0 8px 0;font-size:28px;letter-spacing:-0.02em}\\n    .tagline{color:var(--muted);margin-bottom:12px}\\n    .meta{display:flex;flex-direction:column;gap:6px;color:#6a5848;font-size:14px}\\n    .next-card{background:linear-gradient(180deg,#fffaf6,#fff7f0);border-radius:12px;padding:18px;text-align:left}\\n    .next-card h3{margin:0;color:var(--accent)}\\n    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:20px}\\n    section.card{background:var(--card);padding:18px;border-radius:12px}\\n    .flow dt{font-weight:700;margin-top:10px}\\n    .flow dd{margin:6px 0 0 0;color:#5c4d41}\\n    .what-to-bring ul{margin:6px 0 0 16px}\\n    .small{font-size:13px;color:#8b7a6b}\\n    .cta-row{display:flex;gap:10px;align-items:center;margin-top:18px}\\n    .btn{background:var(--accent);color:#fff;padding:12px 16px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .btn.ghost{background:transparent;border:1px solid rgba(66,54,42,0.08);color:var(--muted)}\\n    footer{margin-top:28px;color:var(--muted);font-size:13px}\\n    @media (max-width:880px){header.hero{grid-template-columns:1fr;}\\n      .grid{grid-template-columns:1fr}\\n      nav{flex-wrap:wrap}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"wrap\\\">\\n    <svg class=\\\"pattern\\\" viewBox=\\\"0 0 800 800\\\" preserveAspectRatio=\\\"xMidYMid slice\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"g\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#f7efe2\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#efe7d9\\\"/></linearGradient>\\n        <pattern id=\\\"p\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\" patternTransform=\\\"rotate(12)\\\">\\n          <rect width=\\\"40\\\" height=\\\"40\\\" fill=\\\"url(#g)\\\" />\\n          <circle cx=\\\"6\\\" cy=\\\"6\\\" r=\\\"1.6\\\" fill=\\\"#d9b89a\\\" opacity=\\\"0.65\\\" />\\n          <circle cx=\\\"26\\\" cy=\\\"26\\\" r=\\\"1.4\\\" fill=\\\"#cfa47f\\\" opacity=\\\"0.58\\\" />\\n        </pattern>\\n      </defs>\\n      <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#p)\\\" />\\n      <g fill=\\\"#fff\\\" opacity=\\\"0.04\\\">\\n        <circle cx=\\\"120\\\" cy=\\\"620\\\" r=\\\"220\\\" />\\n        <circle cx=\\\"700\\\" cy=\\\"100\\\" r=\\\"160\\\" />\\n      </g>\\n    </svg>\\n\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\" class=\\\"cta\\\">Gatherings</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"pricing.html\\\">Rates</a>\\n      <a href=\\\"about.html\\\">Story</a>\\n      <a href=\\\"contact.html\\\">Connect</a>\\n    </nav>\\n\\n    <header class=\\\"hero\\\">\\n      <div class=\\\"lead\\\">\\n        <h1>Community Sound Baths — slow, warm, centered</h1>\\n        <div class=\\\"tagline\\\">An evening of layered resonance and guided breath — held at {{VENUE_NAME}} in {{CITY}}.</div>\\n        <div class=\\\"meta\\\">\\n          <div>Facilitator: {{FACILITATOR_NAME}}</div>\\n          <div>Atmosphere: intimate • candle-lit • 60–75 min</div>\\n          <div class=\\\"small\\\">Instruments vary by session — expect crystal bowls, gong, chimes, and tuning forks.</div>\\n        </div>\\n        <div class=\\\"cta-row\\\">\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <a class=\\\"btn ghost\\\" href=\\\"book.html\\\">Reserve a spot</a>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"next-card\\\">\\n        <h3>Next event</h3>\\n        <p class=\\\"small\\\">{{NEXT_EVENT_DATE}} — doors 6:30pm, sound begins 7:00pm</p>\\n        <p class=\\\"small\\\">Location: {{VENUE_NAME}}, {{CITY}}, {{STATE}}</p>\\n        <div style=\\\"margin-top:12px;display:flex;gap:8px\\\">\\n          <a class=\\\"btn\\\" href=\\\"book.html\\\">Book seat</a>\\n          <a class=\\\"btn ghost\\\" href=\\\"#calendar\\\">Full schedule</a>\\n        </div>\\n      </aside>\\n    </header>\\n\\n    <main style=\\\"margin-top:18px\\\">\\n      <section class=\\\"grid\\\">\\n        <section class=\\\"card\\\">\\n          <h2>How an evening unfolds</h2>\\n          <dl class=\\\"flow\\\">\\n            <dt>Arrival & ground</dt>\\n            <dd>We welcome you with a short centering and intention-setting — soft tea available.</dd>\\n            <dt>Guided breath & gentle movement</dt>\\n            <dd>Simple breathwork and gentle stretches create receptive space for listening.</dd>\\n            <dt>The sound immersion</dt>\\n            <dd>Layered instruments build a sound field: polished crystal bowls, sustained gong tones, delicate chimes and harmonic tuning forks.\\n            The journey moves from a cradle of textures toward a broad, immersive wash and a gentle return.</dd>\\n            <dt>Return & integration</dt>\\n            <dd>We close with silence and a short sharing, time to rest before leaving.</dd>\\n          </dl>\\n        </section>\\n\\n        <section class=\\\"card what-to-bring\\\">\\n          <h2>What to bring</h2>\\n          <ul>\\n            <li>Yoga mat or meditation cushion</li>\\n            <li>Blanket and sweater (rooms are kept cool)</li>\\n            <li>Reusable water bottle</li>\\n            <li>Optional: eye mask or scarf</li>\\n          </ul>\\n          <p class=\\\"small\\\" style=\\\"margin-top:10px\\\">We provide bolsters on request. Please arrive 10–15 minutes early to settle in.</p>\\n        </section>\\n\\n        <section class=\\\"card\\\">\\n          <h2>Contraindications & safety</h2>\\n          <p class=\\\"small\\\">Sound baths are safe for most people, but not recommended during the first trimester of pregnancy, for people with epilepsy, or those with certain acute psychiatric conditions. If you have a pacemaker or other implanted electronic device, consult your healthcare provider before attending. Contact us at {{EMAIL}} for questions.</p>\\n        </section>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n        <h2 id=\\\"calendar\\\">Upcoming calendar</h2>\\n        <p class=\\\"small\\\">A seasonal series of gatherings — we rotate instrument focus and pacing so each visit feels distinct.</p>\\n        <ul style=\\\"margin-top:12px;color:#5b4c3f\\\">\\n          <li><strong>{{NEXT_EVENT_DATE}}</strong> — Evening Sound Bath (crystal bowls + chimes)</li>\\n          <li>2026-03-07 — Deep Gong Wave (gong + low tuning fork drones)</li>\\n          <li>2026-03-21 — Spring Resonance (monochord + crystal bowls)</li>\\n          <li>2026-04-04 — Gentle Tones (tuning forks, chimes, and soft bowls)</li>\\n        </ul>\\n        <div style=\\\"margin-top:14px\\\" class=\\\"small\\\">Tickets: pay-what-you-can sliding scale, early-bird discounts available. Group blocks available on request.</div>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n        <h2>A note on instruments</h2>\\n        <p class=\\\"small\\\">Each event is an interplay of acoustics: shimmering crystal bowls, resonant gong washes, bright chimes, and precisely-tuned forks. For certain evenings we introduce a monochord for a continuous harmonic bed.</p>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px;display:flex;gap:12px\\\" class=\\\"card\\\">\\n        <div style=\\\"flex:1\\\">\\n          <h3>Pricing snapshot</h3>\\n          <p class=\\\"small\\\">Suggested: $25–45. Student and low-income passes available. See full rates on the Rates page.</p>\\n        </div>\\n        <div style=\\\"width:220px\\\">\\n          <a class=\\\"btn\\\" href=\\\"pricing.html\\\">See rates</a>\\n        </div>\\n      </section>\\n\\n    </main>\\n\\n    <footer>\\n      <div style=\\\"display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap\\\">\\n        <div>Questions? <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a></div>\\n        <div class=\\\"small\\\">© {{BUSINESS_NAME}} — held at {{VENUE_NAME}} in {{CITY}}, {{STATE}}</div>\\n      </div>\\n    </footer>\\n  </div>\\n</body>\\n</html>\"}  \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Private Sessions — {{BUSINESS_NAME}} • 1:1, Couples, Corporate</title>\\n  <meta name=\\\"description\\\" content=\\\"Private sound sessions: one-to-one, couples, and corporate experiences. Tailored flows using monochord, crystal bowls, and tuning forks.\\\">\\n  <style>\\n    :root{--warm:#b66e43;--sand:#efe7db;--wood:#6a5136;--paper:#fffaf6}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;background:linear-gradient(180deg,#fbf6f0,#f1e9df);color:#3f332b}\\n    .container{max-width:980px;margin:48px auto;padding:26px;background:var(--paper);border-radius:16px;box-shadow:0 10px 30px rgba(59,44,32,0.06);position:relative}\\n    .svgbg{position:absolute;inset:0;opacity:0.18;pointer-events:none}\\n    header{display:flex;justify-content:space-between;align-items:center;gap:16px}\\n    header h1{margin:0;font-size:26px}\\n    nav{margin-top:12px;display:flex;gap:10px}\\n    nav a{color:var(--wood);text-decoration:none;padding:8px;border-radius:8px}\\n    .intro{display:flex;gap:18px;margin-top:18px}\\n    .card{background:#fff;padding:16px;border-radius:12px;box-shadow:0 6px 18px rgba(60,44,30,0.04)}\\n    .tiers{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}\\n    .tier h3{margin:0 0 6px 0}\\n    .muted{color:#887466;font-size:14px}\\n    .btn{display:inline-block;background:var(--warm);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .small{font-size:13px;color:#7b6656}\\n    @media (max-width:740px){.intro{flex-direction:column}.tiers{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <svg class=\\\"svgbg\\\" viewBox=\\\"0 0 900 600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n      <defs>\\n        <linearGradient id=\\\"bg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#fff8f2\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#efe7db\\\"/></linearGradient>\\n        <pattern id=\\\"stripe\\\" width=\\\"24\\\" height=\\\"24\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n          <rect width=\\\"24\\\" height=\\\"24\\\" fill=\\\"url(#bg)\\\" />\\n          <path d=\\\"M0 24 L24 0\\\" stroke=\\\"#e6d2be\\\" stroke-width=\\\"2\\\" opacity=\\\"0.5\\\"/>\\n        </pattern>\\n      </defs>\\n      <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#stripe)\\\" />\\n    </svg>\\n\\n    <nav>\\n      <a href=\\\"index.html\\\">Gather</a>\\n      <a href=\\\"events.html\\\">Events</a>\\n      <a href=\\\"private-sessions.html\\\" style=\\\"font-weight:700\\\">Private</a>\\n      <a href=\\\"pricing.html\\\">Pricing</a>\\n      <a href=\\\"contact.html\\\">Contact</a>\\n    </nav>\\n\\n    <header>\\n      <h1>Private sound offerings</h1>\\n      <div style=\\\"text-align:right\\\">\\n        <div class=\\\"muted\\\">Sessions tailored in {{CITY}}, {{STATE}}</div>\\n        <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n      </div>\\n    </header>\\n\\n    <main style=\\\"margin-top:18px\\\">\\n      <section class=\\\"intro\\\">\\n        <div style=\\\"flex:2\\\" class=\\\"card\\\">\\n          <h2>Personal, tuned, attentive</h2>\\n          <p class=\\\"small\\\">Private sessions let us sculpt a sound field for your needs — deeper restorative work, couple's attunement, or team-focused mindful breaks. Each session blends instruments intentionally: for 1:1 we favor deep crystal bowls and tuning forks; for couples we arrange harmonic interplay with chimes and bowls; for corporate we offer a concise, grounding sequence with monochord and bowls.</p>\\n\\n          <h3 style=\\\"margin-top:12px\\\">Flow (typical)</h3>\\n          <ol style=\\\"color:#5d4a3d;margin-top:6px\\\">\\n            <li>Intake & intention (10–15 min)</li>\\n            <li>Gentle centering; breath and posture (5–10 min)</li>\\n            <li>Sound immersion (30–55 min) — dynamic layering, space for embodiment</li>\\n            <li>Soft return & brief integration (10 min)</li>\\n          </ol>\\n\\n          <p class=\\\"small\\\" style=\\\"margin-top:10px\\\">We adapt length and intensity to comfort and goals. If you have specific sensitivities (e.g., noise sensitivity, devices), mention them when booking.</p>\\n        </div>\\n\\n        <aside style=\\\"flex:1\\\" class=\\\"card\\\">\\n          <h3>What to bring</h3>\\n          <ul class=\\\"small\\\" style=\\\"margin-top:6px\\\">\\n            <li>Comfortable clothes</li>\\n            <li>Mat & blanket for longer sessions</li>\\n            <li>List of intentions or questions (optional)</li>\\n          </ul>\\n          <h3 style=\\\"margin-top:12px\\\">Contraindications</h3>\\n          <p class=\\\"small\\\">Not recommended for those with epilepsy or acute psychiatric crises; consult your physician for implanted devices. For bespoke questions: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></p>\\n        </aside>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n        <h2>Session types</h2>\\n        <div class=\\\"tiers\\\">\\n          <div class=\\\"tier\\\">\\n            <h3>1:1 Session</h3>\\n            <p class=\\\"small\\\">A focused session for personal restoration. Instruments: deep crystal bowls, tuning forks, and occasional gong wash. 60–90 min.</p>\\n            <p style=\\\"margin-top:8px;\\\"><strong>Outcome:</strong> personalized grounding and integration plan.</p>\\n          </div>\\n          <div class=\\\"tier\\\">\\n            <h3>Couples & paired</h3>\\n            <p class=\\\"small\\\">Shared resonance to cultivate presence and listening. Instruments: paired crystal bowls, chimes, and harmonic overlaps. 60–75 min.</p>\\n            <p style=\\\"margin-top:8px\\\"><strong>Outcome:</strong> co-regulation and slowed communication space.</p>\\n          </div>\\n          <div class=\\\"tier\\\">\\n            <h3>Corporate & team</h3>\\n            <p class=\\\"small\\\">Short, restorative sessions designed for work settings — 30–45 minutes. Instruments: monochord and selective bowls to lower stress and sharpen focus.</p>\\n            <p style=\\\"margin-top:8px\\\"><strong>Outcome:</strong> reset and clearer attention for collaborative work.</p>\\n          </div>\\n          <div class=\\\"tier\\\">\\n            <h3>Series & retreats</h3>\\n            <p class=\\\"small\\\">Multi-session packages for deep integration. We design a progression of instruments and pacing across visits.</p>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px;display:flex;gap:12px\\\">\\n        <div class=\\\"card\\\" style=\\\"flex:1\\\">\\n          <h3>Booking & logistics</h3>\\n          <p class=\\\"small\\\">Sessions can be hosted at {{VENUE_NAME}} or in-home for an additional travel fee. We supply bowls, forks, chimes, and soft bolsters. Sound levels are moderated for comfort.</p>\\n          <p class=\\\"small\\\">Lead time: typically 1–3 weeks depending on availability. For corporate inquiries, request a proposal at {{EMAIL}}.</p>\\n        </div>\\n        <div class=\\\"card\\\" style=\\\"width:220px\\\">\\n          <h3>Ready to schedule?</h3>\\n          <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          <p class=\\\"small\\\" style=\\\"margin-top:8px\\\">Or email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> with preferred dates.</p>\\n        </div>\\n      </section>\\n\\n      <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n        <h3>Instrument note</h3>\\n        <p class=\\\"small\\\">For private work we sometimes integrate a tuned monochord for continuous harmonic support, bright chimes for relational sessions, or gentle gong entrances when deeper release is appropriate. Each selection supports the therapeutic aim of the session.</p>\\n      </section>\\n\\n    </main>\\n\\n    <footer style=\\\"margin-top:18px\\\" class=\\\"small\\\">Questions? Call <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> or write <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>. © {{BUSINESS_NAME}}</footer>\\n  </div>\\n</body>\\n</html>\"}  \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Rates — {{BUSINESS_NAME}} • Sound Bath Pricing</title>\\n  <meta name=\\\"description\\\" content=\\\"Transparent pricing for community gatherings, private sessions, and corporate packages. Sliding scale and memberships available.\\\">\\n  <style>\\n    :root{--earth:#a66a3e;--soft:#f6eee6;--ink:#423328}\\n    html,body{margin:0;padding:0;height:100%;font-family:Inter,system-ui,Arial;background:linear-gradient(180deg,#fbf8f5,#f3ebe0);color:var(--ink)}\\n    .sheet{max-width:980px;margin:40px auto;padding:28px;background:#fff;border-radius:16px;box-shadow:0 10px 30px rgba(60,44,32,0.05)}\\n    header{display:flex;justify-content:space-between;align-items:center}\\n    nav{margin-top:12px;display:flex;gap:10px}\\n    nav a{color:#866a55;text-decoration:none}\\n    .grid{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:18px}\\n    .pricing{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}\\n    .card{background:linear-gradient(180deg,#fff,#fff7f1);padding:16px;border-radius:12px;border:1px solid rgba(165,106,62,0.06)}\\n    .card h3{margin:0 0 6px 0}\\n    .price{font-size:22px;color:var(--earth);font-weight:800}\\n    .muted{color:#8b7a6b}\\n    .btn{background:var(--earth);color:#fff;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}\\n    .micro{margin-top:12px;background:#fff6ee;padding:12px;border-radius:10px}\\n    .small{font-size:13px;color:#7b6656}\\n    @media (max-width:900px){.grid{grid-template-columns:1fr}.pricing{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"sheet\\\">\\n    <nav>\\n      <a href=\\\"index.html\\\">Home</a>\\n      <a href=\\\"events.html\\\">Sessions</a>\\n      <a href=\\\"private-sessions.html\\\">Private</a>\\n      <a href=\\\"pricing.html\\\" style=\\\"font-weight:700\\\">Rates</a>\\n      <a href=\\\"book.html\\\">Book</a>\\n    </nav>\\n\\n    <header>\\n      <h1>Rates & offerings</h1>\\n      <div class=\\\"small\\\">Clear, seasonal pricing. Ask about sliding scale.</div>\\n    </header>\\n\\n    <div class=\\\"grid\\\">\\n      <main>\\n        <section style=\\\"margin-top:12px\\\">\\n          <h2 style=\\\"margin:0 0 8px 0\\\">Community gatherings</h2>\\n          <div class=\\\"pricing\\\" role=\\\"list\\\">\\n            <div class=\\\"card\\\">\\n              <h3>Standard Seat</h3>\\n              <div class=\\\"price\\\">$35</div>\\n              <p class=\\\"small\\\">One evening sound bath (60–75 min). Doors open 30 minutes prior for settling.</p>\\n              <p class=\\\"muted\\\">Pay-what-you-can options: $25 / $35 / $45</p>\\n              <a class=\\\"btn\\\" href=\\\"book.html\\\">Reserve</a>\\n            </div>\\n\\n            <div class=\\\"card\\\">\\n              <h3>Early Bird</h3>\\n              <div class=\\\"price\\\">$28</div>\\n              <p class=\\\"small\\\">Available until 7 days before the event. Limited quantity.</p>\\n              <a class=\\\"btn\\\" href=\\\"book.html\\\">Book</a>\\n            </div>\\n\\n            <div class=\\\"card\\\">\\n              <h3>Subscription</h3>\\n              <div class=\\\"price\\\">$95 / mo</div>\\n              <p class=\\\"small\\\">Attend up to 3 gatherings per month. Best for steady practice and savings.</p>\\n              <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Join</a>\\n            </div>\\n          </div>\\n        </section>\\n\\n        <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n          <h2 style=\\\"margin:0 0 8px 0\\\">Private sessions & packages</h2>\\n          <div style=\\\"display:flex;gap:10px;flex-wrap:wrap\\\">\\n            <div style=\\\"flex:1;min-width:220px;padding:12px;background:#fff;border-radius:10px\\\">\\n              <h3 style=\\\"margin:0\\\">1:1 — 60 min</h3>\\n              <div class=\\\"price\\\">$140</div>\\n              <p class=\\\"small\\\">Customized session: deep crystal bowls and tuning forks. Add travel fee for in-home visits.</p>\\n            </div>\\n\\n            <div style=\\\"flex:1;min-width:220px;padding:12px;background:#fff;border-radius:10px\\\">\\n              <h3 style=\\\"margin:0\\\">Couples — 75 min</h3>\\n              <div class=\\\"price\\\">$220</div>\\n              <p class=\\\"small\\\">Paired attunement with chimes and paired bowls. Ideal for ceremony or integration work.</p>\\n            </div>\\n\\n            <div style=\\\"flex:1;min-width:220px;padding:12px;background:#fff;border-radius:10px\\\">\\n              <h3 style=\\\"margin:0\\\">Corporate — 30–45 min</h3>\\n              <div class=\\\"price\\\">From $450</div>\\n              <p class=\\\"small\\\">On-site mindful resets using monochord and select bowls. Travel and group size affect pricing.</p>\\n            </div>\\n          </div>\\n          <p class=\\\"small\\\" style=\\\"margin-top:10px\\\">Packages and series discounts available. Contact <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a> for proposals.</p>\\n        </section>\\n\\n        <section style=\\\"margin-top:18px\\\" class=\\\"card\\\">\\n          <h2 style=\\\"margin:0 0 8px 0\\\">A la carte & add-ons</h2>\\n          <ul class=\\\"small\\\" style=\\\"margin:6px 0 0 18px\\\">\\n            <li>Additional 30 minutes to private session — $60</li>\\n            <li>Travel fee (in-home) — varies by distance</li>\\n            <li>Group blocks & weekend retreat pricing — by proposal</li>\\n          </ul>\\n        </section>\\n\\n      </main>\\n\\n      <aside>\\n        <div class=\\\"card\\\">\\n          <h3>Micro-habits for resonance</h3>\\n          <div class=\\\"micro\\\">\\n            <p class=\\\"small\\\"><strong>Daily 2-minute reset:</strong> Sit quietly, take six slow breaths (4s inhale, 6s exhale), listen to the subtle hum around you.</p>\\n            <p class=\\\"small\\\" style=\\\"margin-top:8px\\\"><strong>Evening warming:</strong> Place one hand on your heart for 60 seconds and hum for 20s — notice vibration and soften the jaw.</p>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h3>Health & safety</h3>\\n          <p class=\\\"small\\\">Not suitable for recent head trauma or acute psychiatric conditions. If pregnant or with implanted devices, consult a medical professional. For concerns, email <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a>.</p>\\n        </div>\\n\\n        <div class=\\\"card\\\" style=\\\"margin-top:12px\\\">\\n          <h3>Need a custom quote?</h3>\\n          <p class=\\\"small\\\">For retreats, multi-session packages, or corporate events contact us with dates and goals.</p>\\n          <a class=\\\"btn\\\" href=\\\"mailto:{{EMAIL}}\\\">Request quote</a>\\n        </div>\\n      </aside>\\n    </div>\\n\\n    <footer style=\\\"margin-top:18px\\\" class=\\\"small\\\">Booking: <a href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a> • Phone: <a href=\\\"tel:{{PHONE}}\\\">{{PHONE}}</a> • Email: <a href=\\\"mailto:{{EMAIL}}\\\">{{EMAIL}}</a></footer>\\n  </div>\\n</body>\\n</html>\"}  \nBUNDLE_END"
        }
      ],
