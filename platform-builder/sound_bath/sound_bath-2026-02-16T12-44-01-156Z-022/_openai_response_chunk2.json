          "text": "BUNDLE_START\n{\"path\":\"events.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Gatherings — {{BUSINESS_NAME}} Sound Bath Events</title>\\n  <style>\\n    :root{--bg:#0f1020;--card:#0f1724;--accent:#a58eff;--muted:#9aa3b2;--glass:rgba(255,255,255,0.04);--gold:linear-gradient(90deg,#ffd6a5,#ff9aa2);}    \\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:#eaf0ff;background:radial-gradient(circle at 10% 10%, rgba(165,142,255,0.08), transparent 10%),var(--bg);}\\n    header{display:flex;align-items:center;justify-content:space-between;padding:20px 32px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);backdrop-filter: blur(6px);position:sticky;top:0;z-index:10;border-bottom:1px solid rgba(255,255,255,0.03)}\\n    .brand{display:flex;gap:14px;align-items:center}\\n    .logo{width:48px;height:48px;flex:0 0 48px;border-radius:10px;background:conic-gradient(from 180deg at 50% 50%, #7b61ff, #ffa5d6 60%, #66ffd9);box-shadow:0 6px 20px rgba(102,255,217,0.06);display:grid;place-items:center;color:#071122;font-weight:700}\\n    nav a{color:#cfe1ff;text-decoration:none;margin:0 10px;font-size:14px}\\n    nav a:hover{color:#fff}\\n    .container{max-width:1100px;margin:36px auto;padding:0 20px}\\n\\n    /* SVG backdrop */\\n    .pattern-wrap{position:fixed;inset:0;pointer-events:none;opacity:0.12}\\n    .hero{display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:stretch}\\n    .card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-radius:14px;padding:22px;border:1px solid rgba(255,255,255,0.03);box-shadow:0 8px 30px rgba(6,8,21,0.6)}\\n    h1{margin:0;color:#fff;font-size:28px;letter-spacing:-0.4px}\\n    p.lead{color:var(--muted);margin-top:8px}\\n    .meta{margin-top:14px;color:#e6eaf6}\\n    .next{background:linear-gradient(90deg,rgba(165,142,255,0.14),rgba(255,154,162,0.06));padding:12px;border-radius:10px;border:1px solid rgba(165,142,255,0.06)}\\n\\n    .calendar{margin-top:18px;display:grid;gap:10px}\\n    .event-pill{display:flex;justify-content:space-between;align-items:center;padding:10px;border-radius:10px;background:var(--glass);border:1px solid rgba(255,255,255,0.03)}\\n    .muted{color:var(--muted);font-size:13px}\\n    .btn{display:inline-block;padding:10px 14px;border-radius:10px;background:var(--accent);color:#081023;text-decoration:none;font-weight:600}\\n\\n    section{margin-top:28px}\\n    .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\\n    .pill{padding:14px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);border:1px solid rgba(255,255,255,0.03)}\\n    footer{margin:60px 0 120px;color:var(--muted);text-align:center}\\n\\n    /* responsive */\\n    @media (max-width:900px){\\n      .hero{grid-template-columns:1fr;}\\n      .grid-3{grid-template-columns:1fr}\\n    }\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"pattern-wrap\\\" aria-hidden>\\n    <!-- Unique svg pattern for events page -->\\n    <svg width=\\\"100%\\\" height=\\\"100%\\\" viewBox=\\\"0 0 800 600\\\" preserveAspectRatio=\\\"xMidYMid slice\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" style=\\\"opacity:0.85;filter:blur(18px)\\\">\\n      <defs>\\n        <linearGradient id=\\\"g1\\\" x1=\\\"0\\\" x2=\\\"1\\\">\\n          <stop offset=\\\"0\\\" stop-color=\\\"#8f72ff\\\" stop-opacity=\\\"0.35\\\"/>\\n          <stop offset=\\\"1\\\" stop-color=\\\"#ffd6a5\\\" stop-opacity=\\\"0.12\\\"/>\\n        </linearGradient>\\n        <pattern id=\\\"p1\\\" width=\\\"40\\\" height=\\\"40\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n          <circle cx=\\\"6\\\" cy=\\\"6\\\" r=\\\"1.5\\\" fill=\\\"#fff\\\" opacity=\\\"0.06\\\"></circle>\\n        </pattern>\\n      </defs>\\n      <rect x=\\\"-20\\\" y=\\\"-40\\\" width=\\\"1000\\\" height=\\\"700\\\" fill=\\\"url(#g1)\\\"></rect>\\n      <g transform=\\\"translate(80,40) rotate(-12)\\\">\\n        <path d=\\\"M0 200 C 140 40 260 260 420 120 C 580 -20 720 200 900 80 L900 700 L0 700 Z\\\" fill=\\\"url(#p1)\\\"></path>\\n        <path d=\\\"M0 220 C 140 80 260 280 420 140 C 580 0 720 220 900 100 L900 700 L0 700 Z\\\" fill=\\\"#7b61ff\\\" opacity=\\\"0.055\\\"></path>\\n      </g>\\n    </svg>\\n  </div>\\n\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">SB</div>\\n      <div>\\n        <div style=\\\"font-weight:700;color:#fff\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">{{TAGLINE}}</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"/index.html\\\">Home</a>\\n      <a href=\\\"/events.html\\\">Gatherings</a>\\n      <a href=\\\"/private-sessions.html\\\">Sessions</a>\\n      <a href=\\\"/pricing.html\\\">Pricing</a>\\n      <a href=\\\"/book.html\\\">Reserve</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"container\\\">\\n    <section class=\\\"hero\\\">\\n      <div class=\\\"card\\\">\\n        <h1>Evenings of sound & slow light</h1>\\n        <p class=\\\"lead\\\">A curated, sensory sound bath for deep rest — hosted in {{CITY}}, {{STATE}} by {{FACILITATOR_NAME}}. Premium cushions and scent included.</p>\\n        <div class=\\\"meta\\\">\\n          <div style=\\\"display:flex;gap:12px;align-items:center\\\">\\n            <div class=\\\"next\\\">\\n              <div style=\\\"font-size:13px;color:var(--muted)\\\">Next event</div>\\n              <div style=\\\"font-weight:700;margin-top:6px\\\">{{NEXT_EVENT_DATE}}</div>\\n            </div>\\n            <a class=\\\"btn\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">{{PRIMARY_CTA_LABEL}}</a>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"calendar\\\">\\n          <div class=\\\"event-pill\\\"><div><strong>Sunset Sound Bath</strong><div class=\\\"muted\\\">Fri • Feb 20 • 6:30–8:00pm</div></div><div><a class=\\\"btn\\\" href=\\\"/book.html\\\">Reserve</a></div></div>\\n          <div class=\\\"event-pill\\\"><div><strong>Full Moon Immersion</strong><div class=\\\"muted\\\">Sat • Mar 7 • 7:00–8:30pm</div></div><div class=\\\"muted\\\">12 seats</div></div>\\n          <div class=\\\"event-pill\\\"><div><strong>Community Morning</strong><div class=\\\"muted\\\">Sun • Mar 22 • 9:30–10:45am</div></div><div class=\\\"muted\\\">Pay-what-you-can</div></div>\\n        </div>\\n\\n      </div>\\n\\n      <aside class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">What to expect</h3>\\n        <p class=\\\"muted\\\">A gentle entrance, layered sound journey, then soft re-emergence. Comfortable mats and blankets available.</p>\\n        <ul style=\\\"color:var(--muted);padding-left:18px;margin-top:8px\\\">\\n          <li>Arrival & settling (10–15 min)</li>\\n          <li>Guided breath & intention (5–10 min)</li>\\n          <li>Sound immersion (35–50 min)</li>\\n          <li>Graceful transition & tea (10–15 min)</li>\\n        </ul>\\n        <div style=\\\"margin-top:14px\\\">\\n          <div class=\\\"muted\\\">Instruments on the night</div>\\n          <div style=\\\"font-weight:700;margin-top:6px\\\">Crystal bowls • Soft chimes • Monochord</div>\\n        </div>\\n      </aside>\\n    </section>\\n\\n    <section>\\n      <div class=\\\"card\\\">\\n        <h2 style=\\\"margin-top:0\\\">Myths & clarity — the sound bath explained</h2>\\n        <div style=\\\"display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:14px\\\">\\n          <div>\\n            <h4>Myth</h4>\\n            <p class=\\\"muted\\\">Sound baths are just music you lie to. They’re loud and chaotic.</p>\\n          </div>\\n          <div>\\n            <h4>Truth</h4>\\n            <p class=\\\"muted\\\">These are carefully held, sensory environments using tuned instruments to invite parasympathetic rest. Volume is intentional, not intrusive.</p>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"grid-3\\\">\\n      <div class=\\\"pill\\\">\\n        <h4>How to prepare</h4>\\n        <p class=\\\"muted\\\">Wear layers, bring an eye cover if you prefer. We provide mats, but personal mats are welcome.</p>\\n      </div>\\n      <div class=\\\"pill\\\">\\n        <h4>What to bring</h4>\\n        <p class=\\\"muted\\\">Light blanket, water bottle, phone on airplane mode, personal pillow for neck support.</p>\\n      </div>\\n      <div class=\\\"pill\\\">\\n        <h4>Contraindications</h4>\\n        <p class=\\\"muted\\\">If you are pregnant, have a pacemaker, recent surgeries, epilepsy, or severe psychiatric conditions please consult with your care provider and notify us before booking.</p>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">Notes from recent gatherings</h3>\\n        <div style=\\\"margin-top:8px;color:var(--muted)\\\">\\n          \\\"A gentle, cinematic rest — I slept better for days.\\\" — attendee review<br>\\n          \\\"A premium sensory evening, the cushions make all the difference.\\\" — attendee review\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section>\\n      <div class=\\\"card\\\">\\n        <h3 style=\\\"margin-top:0\\\">FAQ — quick answers</h3>\\n        <details style=\\\"margin-top:8px;color:var(--muted)\\\"><summary style=\\\"cursor:pointer\\\">How long is a typical event?</summary><div style=\\\"padding-top:8px\\\">Around 75–90 minutes including settling and post-session tea.</div></details>\\n        <details style=\\\"margin-top:8px;color:var(--muted)\\\"><summary style=\\\"cursor:pointer\\\">Are mats provided?</summary><div style=\\\"padding-top:8px\\\">Yes — we offer premium mats, bolsters, and blankets. You may bring your own.</div></details>\\n        <details style=\\\"margin-top:8px;color:var(--muted)\\\"><summary style=\\\"cursor:pointer\\\">Can I record?</summary><div style=\\\"padding-top:8px\\\">Out of respect for others, recording is discouraged. Photography is not allowed during immersion.</div></details>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"display:flex;gap:18px;align-items:center;justify-content:space-between\\\">\\n      <div>\\n        <h3 style=\\\"margin:0\\\">Reserve your spot</h3>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Small groups, intimate settings — book early.</p>\\n      </div>\\n      <div>\\n        <a class=\\\"btn\\\" href=\\\"/book.html\\\">Book for {{NEXT_EVENT_DATE}}</a>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div>{{VENUE_NAME}} — {{CITY}}, {{STATE}} • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{PHONE}}</a> • <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--muted);text-decoration:none\\\">{{EMAIL}}</a></div>\\n      <div style=\\\"margin-top:8px\\\" class=\\\"muted\\\">© {{BUSINESS_NAME}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"private-sessions.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Private Sessions — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#071023;--panel:#0b1320;--accent:#66ffd9;--soft:#b9e6ff;--muted:#9fb0c4}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;color:#e8f6ff;background:linear-gradient(180deg,#061018 0%, #081227 60%)}\\n    header{display:flex;justify-content:space-between;align-items:center;padding:18px 26px;background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border-bottom:1px solid rgba(255,255,255,0.02)}\\n    .logo{width:44px;height:44px;border-radius:8px;background:linear-gradient(135deg,#6be7d9,#7f6bff);display:grid;place-items:center;font-weight:800}\\n    nav a{color:var(--soft);text-decoration:none;margin-left:14px;font-size:14px}\\n\\n    .wrap{max-width:1000px;margin:34px auto;padding:0 20px}\\n    .intro{display:grid;grid-template-columns:1fr 360px;gap:20px}\\n    .panel{background:rgba(255,255,255,0.02);padding:20px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    h1{color:#fff;margin:0;font-size:26px}\\n    .muted{color:var(--muted)}\\n\\n    .list{display:grid;gap:12px;margin-top:14px}\\n    .offer{padding:12px;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);border:1px solid rgba(255,255,255,0.03)}\\n\\n    .flow{margin-top:14px}\\n    .cta-row{display:flex;gap:12px;align-items:center;margin-top:16px}\\n    .primary{background:linear-gradient(90deg,#66ffd9,#7b61ff);padding:10px 14px;border-radius:10px;color:#04121a;text-decoration:none;font-weight:700}\\n\\n    footer{margin:64px 0 120px;color:var(--muted);text-align:center}\\n\\n    @media(max-width:900px){.intro{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- Inline decorative svg pattern unique to private sessions -->\\n  <svg width=\\\"0\\\" height=\\\"0\\\" style=\\\"position:absolute;left:-9999px;\\\">\\n    <defs>\\n      <linearGradient id=\\\"psg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#66ffd9\\\" stop-opacity=\\\"0.14\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#7b61ff\\\" stop-opacity=\\\"0.12\\\"/></linearGradient>\\n      <pattern id=\\\"psdot\\\" width=\\\"30\\\" height=\\\"30\\\" patternUnits=\\\"userSpaceOnUse\\\"><rect width=\\\"30\\\" height=\\\"30\\\" fill=\\\"transparent\\\"/><circle cx=\\\"4\\\" cy=\\\"4\\\" r=\\\"1.6\\\" fill=\\\"#fff\\\" opacity=\\\"0.04\\\"/></pattern>\\n    </defs>\\n  </svg>\\n\\n  <header>\\n    <div style=\\\"display:flex;align-items:center;gap:12px\\\">\\n      <div class=\\\"logo\\\">SB</div>\\n      <div>\\n        <div style=\\\"color:#fff;font-weight:700\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">Private sound work & bespoke journeys</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"/index.html\\\">Home</a>\\n      <a href=\\\"/events.html\\\">Events</a>\\n      <a href=\\\"/private-sessions.html\\\">Sessions</a>\\n      <a href=\\\"/pricing.html\\\">Investments</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"intro\\\">\\n      <div class=\\\"panel\\\">\\n        <h1>Private sound sessions — tailored presence</h1>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">1:1, couples, and corporate offerings designed to restore clarity and calm. Held in-studio or at your chosen space.</p>\\n\\n        <div class=\\\"list\\\">\\n          <div class=\\\"offer\\\">\\n            <strong>1:1 — Deep Immersion</strong>\\n            <div class=\\\"muted\\\">90 minutes. Personalized sound layering, intention setting, and integration time.</div>\\n          </div>\\n          <div class=\\\"offer\\\">\\n            <strong>Couples — Shared Grounding</strong>\\n            <div class=\\\"muted\\\">75 minutes. A guided, co-creative session for partners seeking shared calm.</div>\\n          </div>\\n          <div class=\\\"offer\\\">\\n            <strong>Corporate — Team Reset</strong>\\n            <div class=\\\"muted\\\">45–60 minute group resets to reduce stress and enhance focus; scalable for meeting rooms.</div>\\n          </div>\\n        </div>\\n\\n        <div class=\\\"flow\\\">\\n          <h4 style=\\\"margin-bottom:6px\\\">Session flow</h4>\\n          <ol class=\\\"muted\\\">\\n            <li>Brief intake & intention setting (5–10m)</li>\\n            <li>Supported lying or seated alignment (5m)</li>\\n            <li>Sound journey tailored to needs (30–60m)</li>\\n            <li>Gentle return & reflections (10m)</li>\\n          </ol>\\n        </div>\\n\\n        <div class=\\\"cta-row\\\">\\n          <a class=\\\"primary\\\" href=\\\"{{PRIMARY_CTA_URL}}\\\">Book a private session</a>\\n          <a style=\\\"color:var(--muted);text-decoration:none\\\" href=\\\"/pricing.html\\\">See rates</a>\\n        </div>\\n      </div>\\n\\n      <aside class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0\\\">What we bring</h3>\\n        <p class=\\\"muted\\\">We travel with a curated kit tuned for private work.</p>\\n        <div style=\\\"margin-top:10px;font-weight:700\\\">Tuning forks • Monochord • Large bowl • Harp chimes</div>\\n\\n        <h4 style=\\\"margin-top:14px\\\">What to bring</h4>\\n        <p class=\\\"muted\\\">Favorite blanket or cushion, any personal supports for comfort, comfortable clothing.</p>\\n\\n        <h4 style=\\\"margin-top:14px\\\">Contraindications</h4>\\n        <p class=\\\"muted\\\">Please inform us of pregnancy, implanted devices, recent surgery, or mental health conditions. We adapt where appropriate.</p>\\n      </aside>\\n    </section>\\n\\n    <section style=\\\"margin-top:26px;display:grid;grid-template-columns:1fr 1fr;gap:18px\\\">\\n      <div class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0\\\">Case notes — recent private work</h3>\\n        <p class=\\\"muted\\\">\\\"Our team left the meeting room more focused and present. Soft, subtle, and professional.\\\" — corporate client</p>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:8px\\\">\\\"A profoundly held one-on-one. I felt safe and listened to.\\\" — private client</p>\\n      </div>\\n\\n      <div class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0\\\">FAQ</h3>\\n        <details style=\\\"margin-top:8px;color:var(--muted)\\\"><summary style=\\\"cursor:pointer\\\">Do you travel?</summary><div style=\\\"padding-top:8px\\\">Yes — travel fees may apply for off-site sessions. We adapt our kit to the room.</div></details>\\n        <details style=\\\"margin-top:8px;color:var(--muted)\\\"><summary style=\\\"cursor:pointer\\\">Can I request specific instruments?</summary><div style=\\\"padding-top:8px\\\">Absolutely — we often co-design the sonic palette to meet therapeutic or ceremony needs.</div></details>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <div class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0\\\">Booking & logistics</h3>\\n        <p class=\\\"muted\\\">Sessions are by appointment. A 50% deposit secures your booking. Please arrive 10 minutes early to settle in.</p>\\n        <div style=\\\"margin-top:12px\\\"><a class=\\\"primary\\\" href=\\\"/book.html\\\">Request a date</a></div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">For bespoke packages or corporate inquiries contact <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:var(--soft);text-decoration:none\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:var(--soft);text-decoration:none\\\">{{PHONE}}</a></div>\\n      <div style=\\\"margin-top:8px\\\" class=\\\"muted\\\">© {{BUSINESS_NAME}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \n{\"path\":\"pricing.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\\n  <title>Investments — {{BUSINESS_NAME}}</title>\\n  <style>\\n    :root{--bg:#081226;--panel:#0d1b2a;--accent:#ffa5d6;--muted:#adbacb}\\n    html,body{height:100%;margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;color:#e9f2ff;background:linear-gradient(180deg,#05121b 0%,#071431 70%)}\\n    header{padding:16px 26px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,0.02)}\\n    .brand{display:flex;gap:12px;align-items:center}\\n    .logo{width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,#ffb6d6,#7b61ff);display:grid;place-items:center}\\n    nav a{color:#e6f3ff;text-decoration:none;margin-left:14px}\\n\\n    .wrap{max-width:1000px;margin:36px auto;padding:0 20px}\\n    .hero{display:flex;justify-content:space-between;align-items:center}\\n    .panel{background:rgba(255,255,255,0.02);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03)}\\n    h1{color:#fff;margin:0}\\n    .muted{color:var(--muted)}\\n\\n    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:20px}\\n    .tier{padding:16px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);border:1px solid rgba(255,255,255,0.03)}\\n    .price{font-size:20px;font-weight:800;color:#fff}\\n    .small{font-size:13px;color:var(--muted)}\\n\\n    .addons{margin-top:18px}\\n    footer{margin:60px 0 120px;color:var(--muted);text-align:center}\\n\\n    @media(max-width:900px){.tiers{grid-template-columns:1fr}}\\n  </style>\\n</head>\\n<body>\\n  <!-- Unique decorative svg gradient for pricing -->\\n  <svg width=\\\"0\\\" height=\\\"0\\\" style=\\\"position:absolute;left:-9999px;\\\">\\n    <defs>\\n      <linearGradient id=\\\"prg\\\" x1=\\\"0\\\" x2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#ff9aa2\\\" stop-opacity=\\\"0.12\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#7b61ff\\\" stop-opacity=\\\"0.12\\\"/></linearGradient>\\n    </defs>\\n  </svg>\\n\\n  <header>\\n    <div class=\\\"brand\\\">\\n      <div class=\\\"logo\\\">SB</div>\\n      <div>\\n        <div style=\\\"font-weight:700;color:#fff\\\">{{BUSINESS_NAME}}</div>\\n        <div style=\\\"font-size:12px;color:var(--muted)\\\">Transparent rates & thoughtful add-ons</div>\\n      </div>\\n    </div>\\n    <nav>\\n      <a href=\\\"/index.html\\\">Studio</a>\\n      <a href=\\\"/events.html\\\">Gather</a>\\n      <a href=\\\"/private-sessions.html\\\">Privates</a>\\n      <a href=\\\"/faq.html\\\">Help</a>\\n    </nav>\\n  </header>\\n\\n  <main class=\\\"wrap\\\">\\n    <section class=\\\"hero\\\">\\n      <div>\\n        <h1>Offerings & rates</h1>\\n        <p class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Packages designed to suit individuals, small groups, and workplace wellbeing.</p>\\n      </div>\\n      <div class=\\\"panel\\\">\\n        <div style=\\\"font-weight:700\\\">Questions?</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:6px\\\">Email <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#fff;text-decoration:none\\\">{{EMAIL}}</a> or call <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:#fff;text-decoration:none\\\">{{PHONE}}</a></div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"tiers\\\">\\n      <div class=\\\"tier\\\">\\n        <div class=\\\"small\\\">Group Event (per session)</div>\\n        <div class=\\\"price\\\">$45–$90</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Community to small-group rates. Includes mats & entry amenities. Travel fee may apply for off-site venues.</div>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <div class=\\\"small\\\">Private 1:1</div>\\n        <div class=\\\"price\\\">$150 — $220</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">90-minute personalized immersion. Includes pre-session intake and post-integration suggestions.</div>\\n      </div>\\n\\n      <div class=\\\"tier\\\">\\n        <div class=\\\"small\\\">Couples & Duo</div>\\n        <div class=\\\"price\\\">$240</div>\\n        <div class=\\\"muted\\\" style=\\\"margin-top:8px\\\">Shared session for two people, available in-studio or on location.</div>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px\\\">\\n      <div class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0\\\">Corporate & on-site</h3>\\n        <p class=\\\"muted\\\">Packages scale with headcount. Typical rate: $350 for up to 20 participants for a 45–60 minute reset (travel not included). We provide calming setups and short integration guides for HR/staff.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"addons\\\">\\n      <div class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0\\\">Retail add-ons & extras</h3>\\n        <p class=\\\"muted\\\">Bring home a small piece of the evening: crystal singing bowl miniatures, locally blended ritual tea, or guided audio recordings.</p>\\n        <ul class=\\\"muted\\\" style=\\\"padding-left:18px;margin-top:8px\\\">\\n          <li>Mini crystal bowl — $55</li>\\n          <li>Guided 30-min integration recording — $18</li>\\n          <li>Travel setup (on-site) — variable</li>\\n        </ul>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:18px;display:grid;grid-template-columns:1fr 1fr;gap:18px\\\">\\n      <div class=\\\"panel\\\">\\n        <h4 style=\\\"margin-top:0\\\">Session flow & clarity</h4>\\n        <p class=\\\"muted\\\">Sessions begin with intention, proceed into the sound field, and end with a gentle reconnection period. We tailor duration and instruments to the client’s needs.</p>\\n        <div style=\\\"margin-top:10px;font-weight:700\\\">Instruments often used: Gong • Crystal singing bowls • Tuning forks</div>\\n      </div>\\n\\n      <div class=\\\"panel\\\">\\n        <h4 style=\\\"margin-top:0\\\">Policy & contraindications</h4>\\n        <p class=\\\"muted\\\">A 50% deposit is required on booking. Deposits are refundable up to 72 hours before the session. Please notify us of pregnancy, implanted devices, recent surgery, epilepsy, or severe psychiatric conditions.</p>\\n      </div>\\n    </section>\\n\\n    <section style=\\\"margin-top:22px\\\">\\n      <div class=\\\"panel\\\">\\n        <h3 style=\\\"margin-top:0\\\">Still unsure?</h3>\\n        <p class=\\\"muted\\\">If you’d like a custom proposal for an ongoing workplace series or wedding/restoration day, contact us with the event size and desired length.</p>\\n        <div style=\\\"margin-top:12px\\\"><a href=\\\"/book.html\\\" style=\\\"background:var(--accent);padding:10px 14px;border-radius:10px;color:#071226;text-decoration:none;font-weight:700\\\">Request a quote</a></div>\\n      </div>\\n    </section>\\n\\n    <footer>\\n      <div class=\\\"muted\\\">Questions or bespoke requests? <a href=\\\"mailto:{{EMAIL}}\\\" style=\\\"color:#fff;text-decoration:none\\\">{{EMAIL}}</a> • <a href=\\\"tel:{{PHONE}}\\\" style=\\\"color:#fff;text-decoration:none\\\">{{PHONE}}</a></div>\\n      <div style=\\\"margin-top:8px\\\" class=\\\"muted\\\">© {{BUSINESS_NAME}}</div>\\n    </footer>\\n  </main>\\n</body>\\n</html>\"} \nBUNDLE_END"
        }
      ],
