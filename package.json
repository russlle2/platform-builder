{
  "name": "platform-builder-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @platform-builder/generator-app dev",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm --filter @platform-builder/generator-app exec tsc --noEmit && pnpm exec tsc --noEmit -p netlify/functions/tsconfig.json",
    "test": "pnpm -r --if-present test && node apps/generator-app/scripts/upload-templates-to-blobs.test.mjs",
    "test:e2e": "pnpm --filter @platform-builder/generator-app exec playwright test",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "node scripts/clean.mjs",
    "generator:dev": "pnpm --filter @platform-builder/generator-app dev",
    "generator:build": "pnpm --filter @platform-builder/generator-app build",
    "client:build": "pnpm --filter @platform-builder/client-template build",
    "create-client": "node infrastructure/scripts/create-client-site.js",
    "sync-content": "node infrastructure/scripts/sync-content.js",
    "optimize-images": "node infrastructure/scripts/optimize-images.js",
    "templates:legacy": "pnpm --filter @platform/template-factory exec tsx src/legacy/cli.ts"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.3.2",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=22.0.0 <25",
    "npm": ">=9.0.0"
  }
}
